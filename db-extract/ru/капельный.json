                                                "example_id": "dedbaa04-cb4d-47f5-970a-ae7559872591",
                                                "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                                "text": "His drip is looking fine, especially the Supreme t-shirt."
                                            },
                                            {
                                                "example_id": "49df4d5d-8a5d-412b-b00b-94aa896db10e",
                                                "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                                "text": "Hailey decided to show off her drip with a soft, white fluff jacket […]"
                                            },
