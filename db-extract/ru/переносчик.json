                "senses": [
                    {
                        "sense_id": "6372bd7a-1ecb-3c46-800c-b2a4dee63091",
                        "entry_id": "b103466b-841b-3710-85bd-09c8c94ffe7f",
                        "glosses": [
                            "carrier, transferrer, transporter (a person, creature, or thing that carries something from one place to another)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "286cbbfd-cd5f-4d49-ad27-e1cd951cbae2",
                                "sense_id": "6372bd7a-1ecb-3c46-800c-b2a4dee63091",
                                "text": "Пчёлы — перено́счики пыльцы́.",
                                "translation": "Bees serve as pollen carriers.",
                                "english": "Bees serve as pollen carriers."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f8bdb65-e2a5-3292-8414-60a95c1784f4",
                        "entry_id": "b103466b-841b-3710-85bd-09c8c94ffe7f",
                        "glosses": [
                            "vector (carrier of a disease-causing agent)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d33fadd1-e05e-3fc5-8801-0b8ecc211b79",
                        "entry_id": "b103466b-841b-3710-85bd-09c8c94ffe7f",
                        "glosses": [
                            "informer, intelligencer"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf9a934-f24f-45b7-b92a-a4b262f9fd31",
                                "sense_id": "d33fadd1-e05e-3fc5-8801-0b8ecc211b79",
                                "text": "А! у вас все шпио́ны, перено́счики! ― Не изво́льте обижа́ть, Васи́лий Петро́вич, ― заговори́ли де́вки прису́тствовавшие в де́вичьей, ― у нас никаки́х шпио́нов нет.",
                                "translation": "“Ah! All of you are spies and informers!” “Pray do not insult us, Vasily Petrovich”, the girls in the maids’ room spoke up, “we don’t have any spies here.”",
                                "english": "“Ah! All of you are spies and informers!” “Pray do not insult us, Vasily Petrovich”, the girls in the maids’ room spoke up, “we don’t have any spies here.”"
                            }
                        ]
                    }
                ],
