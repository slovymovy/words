{
    "word_family": [
        "water",
        "watery",
        "wateriness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b2defb1-ee45-39de-9b60-8606cd348242",
                    "sense_definition": "Soaked or saturated with water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soaked",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain left the garden <w>waterlogged</w> and impossible to walk through.",
                            "target_lang_translations": {
                                "cs": "Kvůli silnému dešti byla zahrada <w>podmáčená</w> a nebylo možné jí projít."
                            }
                        },
                        {
                            "text": "We had to abandon the <w>waterlogged</w> tent after the storm flooded the campsite.",
                            "target_lang_translations": {
                                "cs": "Poté, co bouře zaplavila kemp, jsme museli opustit <w>promáčený</w> stan."
                            }
                        }
                    ],
                    "synonyms": [
                        "drenched",
                        "saturated",
                        "sodden",
                        "wet"
                    ],
                    "common_phrases": [
                        "waterlogged ground",
                        "waterlogged soil"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zcela nasáklý vodou, podmáčený nebo promáčený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "podmáčený",
                                "target_lang_sense_clarification": "zejména o půdě nebo terénu"
                            },
                            {
                                "target_lang_word": "promáčený",
                                "target_lang_sense_clarification": "o předmětech nebo oblečení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4df317be-09e8-30cd-9a75-81df2b7291fb",
                    "sense_definition": "In danger of sinking due to excess water inside a vessel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "soaked",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew struggled to keep the <w>waterlogged</w> boat afloat until help arrived.",
                            "target_lang_translations": {
                                "cs": "Posádka se snažila udržet <w>zaplavenou</w> loď na hladině, dokud nedorazila pomoc."
                            }
                        },
                        {
                            "text": "A <w>waterlogged</w> ship is extremely difficult to steer in rough seas.",
                            "target_lang_translations": {
                                "cs": "Loď <w>nabraná vodou</w> se na rozbouřeném moři ovládá nesmírně obtížně."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waterlogged boat",
                        "waterlogged vessel"
                    ],
                    "target_lang_definitions": {
                        "cs": "Plný vody, hrozící potopením (o lodi nebo plavidle)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nabraný vodou",
                                "target_lang_sense_clarification": "o plavidle, které je těžké kvůli vniklé vodě"
                            },
                            {
                                "target_lang_word": "zaplavený",
                                "target_lang_sense_clarification": "o lodi, do které vnikla voda"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}