                ],
                "senses": [
                    {
                        "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                        "entry_id": "b4812575-e549-35ce-b6cc-19d0e8e129cd",
                        "glosses": [
                            "kleiner, meist vergrößerter, Teil aus einer Land- oder Seekarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3561c4f4-3321-43dc-a49c-52b2beab0479",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "Aus dem freiem Kartenmaterial von OpenStreetMap kann man beliebige Kartenausschnitte exportieren."
                            },
                            {
                                "example_id": "597999d2-a513-4526-9035-8f7db9a8e80d",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Die Karte kann über die openstreetmap.org-Webseite aufgerufen werden. Dort ist es möglich, die Karte zu betrachten, den Kartenausschnitt zu vergrößern und zu verkleinern und ihn rund um die Welt zu verschieben.“"
                            },
                            {
                                "example_id": "7c381c45-7949-4fd4-9374-2daa8de143f1",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Zschäpe setzt ihre Brille auf, um die an eine Wand projektierten, vergrößerten Kartenausschnitte besser erkennen zu können.“"
                            },
                            {
                                "example_id": "bef4fdfb-a173-49d5-8eaf-542c1681f63f",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Der Benutzer legt fest, welcher Kartenausschnitt und welche Wetterinformationen angezeigt werden sollen.“"
                            },
                            {
                                "example_id": "733e10c5-f16a-4735-bc49-f47ea57d9927",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Per Bluetooth überträgt die Software auf dem Hauptrechner sowohl den aktiven Kartenausschnitt als auch die Navigationsdaten an einen Pocket-PC.“"
                            },
                            {
                                "example_id": "5103c0f1-c89c-461e-96cd-4b7dd4845153",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Nicht fehlen darf zuletzt die Nennung des Seitentitels, des Maßstabs und des Kartennetzentwurfs (Projektion) der Karte, in diesem Beispiel nicht ausgeführt, da nur ein Kartenausschnitt gezeigt wird.“"
                            },
                            {
                                "example_id": "5994520f-420b-4922-b4a3-a9c214052a6b",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Um die Genauigkeit der Daten zu verbessern wird jeder Kartenausschnitt — jeweils etwa 16 Hektar — von fünf bis zehn Nutzern überprüft.“"
                            },
                            {
                                "example_id": "97da5a59-8063-456b-8769-c9b08b36a4fb",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Ein Mann stellt ein kleines Beton-Häuschen auf einen leeren Tisch. Plötzlich erscheint auf der Tischfläche um das Häuschen ein digitaler Kartenausschnitt. Der Mann dreht an einem Knopf und der Kartenausschnitt verändert sich.“"
                            },
                            {
                                "example_id": "dbb3d3fa-c451-47e5-bdbb-cbb0ad2749a5",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Dass das Faltblatt auch einen Kartenausschnitt von «swisstopo» bietet, dem Bundesamt für Landestopografie, versteht sich von selbst.“"
                            },
                            {
                                "example_id": "9ccd09e2-6dac-49cf-b5f0-3cdfba9b5b58",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Noch besser und verständlicher als eine Ausgabe der geografischen Koordinaten als Dezimalzahl ist ein Einbinden von Kartenausschnitten in Ihre Webseite.“"
                            },
                            {
                                "example_id": "5e8af3d7-7431-4bc9-ac7b-28e1b8b2192d",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "„Diese Karten decken im streng geometrischen Raster aus Zeilen und Spalten die ganze Fläche der Schweiz ab, ohne dabei im Kartenausschnitt eine Rücksicht auf Gebirgsregionen oder eine verwaltungstechnische Einteilung zu nehmen.“"
                            },
                            {
                                "example_id": "5872532b-93d6-45c1-b2ac-cfe0002d12e7",
                                "sense_id": "769a2bec-f71d-32d6-af96-fd432067721f",
                                "text": "[Wikipedia:] „Der Lsjbot schreibt nicht über alles; er hat seine Lieblingsthemen. Ortsartikel zum Beispiel. Das Computerprogramm pickt sich etwa eine der 13.000 kleinen Gemeinden in Deutschland heraus, legt einen Text mit ein paar rudimentären Informationen an und setzt noch einen passenden Kartenausschnitt dazu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
