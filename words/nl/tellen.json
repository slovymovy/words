                        },
                        {
                            "text": "Mijn kleine broertje leert net om tot twintig te <w>tellen</w>.",
                            "target_lang_translations": {
                                "ru": "Мой младший брат только учится <w>считать</w> до двадцати.",
                                "en": "My little brother is just learning to <w>count</w> to twenty.",
                                "de": "Mein kleiner Bruder lernt gerade, bis zwanzig zu <w>zählen</w>.",
                                "pl": "Mój młodszy braciszek właśnie uczy się <w>liczyć</w> do dwudziestu.",
                                "fr": "Mon petit frère apprend tout juste à <w>compter</w> jusqu'à vingt.",
