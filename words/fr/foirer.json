                {
                    "sense_id": "97235e9c-5b90-3fcc-a12d-c465fbcc2ae0",
                    "sense_definition": "Tourner dans le vide sans serrer, en parlant d'une vis ou d'un boulon dont le filetage est détérioré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne visse pas trop fort, sinon tu risques de faire <w>foirer</w> le pas de vis.",
                            "target_lang_translations": {
                                "en": "Don't screw it in too hard, or you risk <w>stripping</w> the screw thread.",
                                "ru": "Не закручивай слишком сильно, а то рискуешь <w>сорвать</w> резьбу.",
                                "de": "Dreh die Schraube nicht so fest ein, sonst riskierst du, das Gewinde <w>auszuleiern</w>.",
                                "es": "No atornilles demasiado fuerte, o corres el riesgo de <w>estropear</w> la rosca del tornillo.",
                                "zh": "别拧得太用力，否则螺纹可能会<w>滑丝</w>。"
                            }
                        },
                        {
                            "text": "Ce vieux boulon métallique <w>foire</w> et n'arrive plus à retenir solidement la charpente.",
                            "target_lang_translations": {
                                "en": "This old metal bolt <w>slips</w> and can no longer hold the roof frame firmly.",
                                "ru": "Этот старый металлический болт <w>проскальзывает</w> и больше не может надёжно удерживать стропила.",
                                "de": "Dieser alte Metallbolzen <w>dreht</w> nur noch <w>durch</w> und kann den Dachstuhl nicht mehr sicher halten.",
                                "es": "Este viejo perno metálico <w>patina</w> y ya no consigue sujetar con firmeza la estructura del tejado.",
                                "zh": "这根旧金属螺栓<w>空转</w>，已经无法牢牢固定屋架了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vis qui foire",
                        "faire foirer"
                    ],
                    "target_lang_definitions": {
                        "en": "To turn without gripping because the screw thread is damaged.",
                        "ru": "Прокручиваться вхолостую, не затягиваясь, о винте или болте с испорченной резьбой.",
                        "de": "Ohne zu greifen leer laufen, weil das Gewinde beschädigt ist.",
                        "es": "Girar en vacío sin apretar, porque la rosca del tornillo está dañada.",
                        "zh": "螺丝或螺栓的螺纹损坏后空转，无法拧紧。"
                    },
