{
    "word_family": [
        "trip",
        "trippy",
        "tripping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ffe0b45-fdb4-3ae7-84b4-3a644b18ba3d",
                    "sense_definition": "A person who goes on a short journey or excursion, often for pleasure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seaside town was crowded with every <w>tripper</w> arriving on the morning train.",
                            "target_lang_translations": {
                                "ru": "Приморский городок был переполнен каждым <w>отдыхающим</w>, прибывшим на утреннем поезде."
                            }
                        },
                        {
                            "text": "As a frequent day <w>tripper</w>, she knew all the best local spots for a quick lunch.",
                            "target_lang_translations": {
                                "ru": "Как заядлый <w>экскурсант</w> одного дня, она знала все лучшие местные места для быстрого обеда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "day tripper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, совершающий короткую поездку или экскурсию, часто ради удовольствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экскурсант",
                                "target_lang_sense_clarification": "участник экскурсии"
                            },
                            {
                                "target_lang_word": "турист",
                                "target_lang_sense_clarification": "человек в короткой поездке"
                            },
                            {
                                "target_lang_word": "отдыхающий",
                                "target_lang_sense_clarification": "приехавший на отдых на день"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70de1372-aad3-34d0-a959-da0919e62fff",
                    "sense_definition": "A person who accidentally catches their foot on something and stumbles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The uneven pavement made him a frequent <w>tripper</w> during his evening walks.",
                            "target_lang_translations": {
                                "ru": "Из-за неровного тротуара он часто <w>спотыкался</w> во время вечерних прогулок."
                            }
                        },
                        {
                            "text": "Most <w>trippers</w> and fallers tend to land forward when they lose their balance.",
                            "target_lang_translations": {
                                "ru": "Большинство <w>споткнувшихся</w> и падающих обычно приземляются вперед, когда теряют равновесие."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который случайно зацепился ногой за что-то и споткнулся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "споткнувшийся",
                                "target_lang_sense_clarification": "тот, кто зацепился ногой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0ac1720-e705-300c-baa9-04c419ab589a",
                    "sense_definition": "A person who is currently under the influence of a hallucinogenic drug.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drug_culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced <w>tripper</w> sat quietly in the corner of the room during the experiment.",
                            "target_lang_translations": {
                                "ru": "Опытный <w>трипующий</w> тихо сидел в углу комнаты во время эксперимента."
                            }
                        },
                        {
                            "text": "Medical staff were trained to handle a <w>tripper</w> who might become anxious or confused.",
                            "target_lang_translations": {
                                "ru": "Медицинский персонал был обучен работе с <w>человеком под кайфом</w>, который мог стать тревожным или растерянным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in the context of recreational drug use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся под воздействием галлюциногенных наркотиков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трипующий",
                                "target_lang_sense_clarification": "сленг, под воздействием ПАВ"
                            },
                            {
                                "target_lang_word": "наркоман",
                                "target_lang_sense_clarification": "в контексте употребления галлюциногенов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1477d1c7-61a3-324d-abb6-8a765ad90bdd",
                    "sense_definition": "A synonym of <w>tripman</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occupations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old records mentioned a <w>tripper</w> who worked on the river barges.",
                            "target_lang_translations": {
                                "ru": "В старых записях упоминался <w>барочник</w>, работавший на речных судах."
                            }
                        },
                        {
                            "text": "He found employment as a <w>tripper</w> during the busy shipping season.",
                            "target_lang_translations": {
                                "ru": "Он нашел работу <w>речником</w> в разгар судоходного сезона."
                            }
                        }
                    ],
                    "synonyms": [
                        "tripman"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "specific to certain maritime or regional occupations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Синоним слова tripman (работник на речных судах или баржах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барочник",
                                "target_lang_sense_clarification": "работник на барже"
                            },
                            {
                                "target_lang_word": "речник",
                                "target_lang_sense_clarification": "работник речного флота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5472ca17-389e-342d-b6aa-ea73aa873042",
                    "sense_definition": "A slang term for the sexually transmitted infection gonorrhea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained the risks of contracting the <w>tripper</w> without proper protection.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил риски заражения <w>триппером</w> без надлежащей защиты."
                            }
                        },
                        {
                            "text": "In some older urban circles, they still used the term <w>tripper</w> to refer to the infection.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых городских кругах до сих пор использовали термин <w>триппер</w> для обозначения инфекции."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal and potentially offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название инфекции, передающейся половым путем — гонореи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "триппер",
                                "target_lang_sense_clarification": "просторечное название гонореи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}