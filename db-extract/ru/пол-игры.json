                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ec3c0c1-ce8b-4cc1-a5cd-da2028e76c5b",
                                                "sense_id": "01a30db9-d337-3916-bcbe-dc272ed65099",
                                                "text": "a half truth"
                                            },
                                            {
                                                "example_id": "55414aa4-2656-407c-88d3-6ee199e37cb7",
                                                "sense_id": "01a30db9-d337-3916-bcbe-dc272ed65099",
                                                "text": "Assumed from thence a half-consent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53b5721-2dad-300f-973a-b75a7089dd7e",
                                        "entry_id": "46ad90de-9e36-3150-a3d6-020512a41b37",
                                        "glosses": [
                                            "Having one parent (rather than two) in common."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ced230f-2b1d-47d0-8df8-2566b84f0981",
                                                "sense_id": "e53b5721-2dad-300f-973a-b75a7089dd7e",
                                                "text": "A half brother or half sister"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e50b3321-f97c-3b9d-bc25-b6539221cf01",
                                        "entry_id": "46ad90de-9e36-3150-a3d6-020512a41b37",
                                        "glosses": [
                                            "Related through one common grandparent or ancestor rather than two."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f76740-aacf-4a33-bb4b-5712a893f9d6",
                                                "sense_id": "e50b3321-f97c-3b9d-bc25-b6539221cf01",
