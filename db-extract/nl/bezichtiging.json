                                        "sense_id": "7a6ebf59-d6ed-354e-8f2d-11cd3f5813db",
                                        "entry_id": "128f5f9a-4d82-34e2-8f77-f24372236400",
                                        "glosses": [
                                            "An instance of viewing something."
                                        ],
                                        "tags": [],
