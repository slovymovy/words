                ],
                "senses": [
                    {
                        "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                        "entry_id": "7cdf84b8-e71a-32d1-92ef-deb4c8524808",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c89741e-ae8f-4fa9-bbf0-08b3641058cc",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Köhl kommt, geht der Herr Köhl.“"
                            },
                            {
                                "example_id": "1153a8f1-14b7-47da-a579-214514531911",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Köhl kommt und geht."
                            },
                            {
                                "example_id": "42164bed-bf77-43a0-8f7a-844494e419ba",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Köhls kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b3cb827c-5d8d-4115-a357-92acbde75a3a",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Frau Köhl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "660e1492-c6a8-4842-b1a4-d04f1b55d131",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Herr Köhl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8217d1b0-c80b-4086-9225-936bc5f2e534",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Die Köhls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8f2efe3d-392f-47ef-af13-6d3e1de52588",
                                "sense_id": "c05dc561-b8d7-36be-a3b9-132572ce2649",
                                "text": "Der Köhl trägt nie die Schals, die die Köhl ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
