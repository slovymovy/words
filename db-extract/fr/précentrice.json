                        "entry_id": "1c3489fa-6be3-3627-a4c2-63d7f33efc51",
                        "glosses": [
                            "Première chantresse d’une congrégation."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "dd09ad91-6c74-4217-96af-01593920f343",
                                "sense_id": "3dec1405-88d4-3741-8596-02e45d764552",
                                "text": "L’abbesse, sans faire de réponse, appela sa précentrice, et la pria de faire venir sa nièce. La précentrice s’inclina avec respect et se retira."
                            },
                            {
                                "example_id": "a38c3190-3fe4-42b0-a5a9-ca98aa338530",
                                "sense_id": "3dec1405-88d4-3741-8596-02e45d764552",
                                "text": "L’abbesse, Ermessinde de Cadoëne, demanda aux religieuses, prieuresse, sous-prieuresse, sacristaine, précentrice, sous-maîtresse de chant, infirmière, l’autorisation de poursuivre en justice les débiteurs des arrérages échus."
                            }
                        ]
                    }
