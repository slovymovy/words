                ],
                "senses": [
                    {
                        "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                        "entry_id": "f1503db2-4e08-3936-96b3-9a42353b3aaa",
                        "glosses": [
                            "Wort, das eine besonders milde, freundliche Form der Schelte darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9be7fc8b-68a1-467c-a043-674220592be1",
                                "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                                "text": "Neckwort kommt im Untertitel des Schimpfwörterbuchs von Pfeiffer vor."
                            },
                            {
                                "example_id": "de66a6c1-e98c-457e-b430-53fc34b811c1",
                                "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                                "text": "Ein Wort wie „Trödelheini“ kann, in freundlichem Ton gesprochen, als Neckwort verwendet werden."
                            },
                            {
                                "example_id": "e268ae0f-3af6-4ddd-a78e-c452ead47bf2",
                                "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                                "text": "Neckwörter unterscheiden sich von schärferen Formen des Tadels vor allem durch den Ton, in dem sie geäußert werden."
                            },
                            {
                                "example_id": "87725dda-7bc5-4595-9145-9e893d6844a1",
                                "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                                "text": "„Es war mehr ein Neckwort, das nun erst das eigentliche Schimpfen auslöste.“"
                            },
                            {
                                "example_id": "ec79681d-a657-40c0-8d3d-d52aaa46fed5",
                                "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                                "text": "„Gollingdiab ist ein Neckwort für die slowakischen Bauernknechte, die dem Gerichte den Galgen, worauf einer ihrer Landsleute sollte gehenkt werden, gestohlen haben.“"
                            },
                            {
                                "example_id": "60f721ea-86af-41e3-9fdc-621abea1e8b3",
                                "sense_id": "c59e51b8-1e7c-3005-b8ce-0a87875dc442",
                                "text": "„Von dem Tage an fand man Pauna außerordentlich bleich; kein Lächeln flog mehr um die Lippen, die sonst so leicht sich spöttisch verzogen, und keine rasche Antwort verkürzte das Neckwort, das ihr nachgeschickt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
