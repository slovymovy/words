                            {
                                "target_lang_word": "со́бственность",
                                "target_lang_sense_clarification": "то, что принадлежит кому-либо на правах владения"
                            },
                            {
                                "target_lang_word": "скарб",
                                "target_lang_sense_clarification": "разг. домашние вещи, пожитки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "财产",
                                "target_lang_sense_clarification": "指拥有的财物"
                            },
                            {
                                "target_lang_word": "所有物",
                                "target_lang_sense_clarification": "指属于某人的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "519a3d94-447e-3d0e-891b-26bb8b023115",
                    "sense_definition": "The state of having, owning, or controlling something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ownership_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect was found in <w>possession</w> of stolen goods.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый был уличен во <w>владении</w> краденым имуществом.",
                                "zh": "嫌疑人被发现<w>持有</w>赃物。"
                            }
                        },
                        {
                            "text": "Once the contract is signed, the house will be in your <w>possession</w>.",
                            "target_lang_translations": {
                                "ru": "Как только контракт будет подписан, дом перейдет в ваше <w>владение</w>.",
                                "zh": "合同一签，这栋房子就归你<w>占有</w>了。"
                            }
                        }
