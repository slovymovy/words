                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "707f4bb9-9c25-307a-b964-ef16e56b99c4",
                                        "entry_id": "de3860bd-5286-3f24-9316-d4d9c762c291",
                                        "glosses": [
                                            "auf einen Ort oder eine Sache zeigend"
                                        ],
                                        "tags": [
                                            "interrogativ; einen direkten oder indirekten Fragesatz einleitend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e21563f4-cf0b-4e26-b2d2-9779af591f58",
                                                "sense_id": "707f4bb9-9c25-307a-b964-ef16e56b99c4",
                                                "text": "Wonach steht dir heute der Sinn? Worauf hast du Lust?"
                                            },
                                            {
                                                "example_id": "53549086-1cef-4a9a-98f2-42cf0dcbb0b5",
                                                "sense_id": "707f4bb9-9c25-307a-b964-ef16e56b99c4",
                                                "text": "Ich weiß nicht, wonach Klaus den ganzen Tag gesucht hat."
                                            },
                                            {
                                                "example_id": "23f4bdf7-694d-4c41-a140-df1566b3f69f",
                                                "sense_id": "707f4bb9-9c25-307a-b964-ef16e56b99c4",
                                                "text": "„Die Lagerstätte, ..., wonach das kanadische Unternehmen eigentlich gesucht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d98bc64d-3e8e-34e9-a13b-d8784f2d7651",
                                        "entry_id": "de3860bd-5286-3f24-9316-d4d9c762c291",
                                        "glosses": [
                                            "auf einen Wortlaut verweisend"
                                        ],
                                        "tags": [
                                            "relativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb02945b-4367-4d5d-9fab-78d024146b4a",
                                                "sense_id": "d98bc64d-3e8e-34e9-a13b-d8784f2d7651",
                                                "text": "Das Bundesfinanzministerium bestätigte einen SZ-Bericht, wonach im Dezember die Steuern und andere Quellen unerwartet ergiebig sprudelten."
                                            },
                                            {
                                                "example_id": "02476847-99a2-4312-aca3-e95c66b0dff9",
                                                "sense_id": "d98bc64d-3e8e-34e9-a13b-d8784f2d7651",
                                                "text": "„Das EU-Parlament hat für eine Regelung gestimmt, wonach unverkaufte Kleidung nicht mehr vernichtet werden darf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d2809d2-27d5-4118-a86b-751c8fb13001",
                        "source_entry_id": "e0c0af20-29fe-36e7-afb9-a67ff61ff28e",
                        "source_sense_id": "c4123f61-a477-393d-8c2f-42365bf58d76",
