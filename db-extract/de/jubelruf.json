                "senses": [
                    {
                        "sense_id": "87b31da9-2449-39a1-8580-62997915f0f1",
                        "entry_id": "5f73b4f8-ae6e-310d-95f2-7c15705b8d73",
                        "glosses": [
                            "Ruf, der Freude über etwas ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c76ae96-cb55-4a92-88ac-3f882e8b88f3",
                                "sense_id": "87b31da9-2449-39a1-8580-62997915f0f1",
                                "text": "„Unentwegt wird sie von Applaus unterbrochen, es gibt Jubelrufe.“"
                            },
                            {
                                "example_id": "a1f2ccf3-12ae-47c4-be9d-d7d57c86b11a",
                                "sense_id": "87b31da9-2449-39a1-8580-62997915f0f1",
                                "text": "„Wo immer sich Napoleon zeigte, empfingen ihn die Soldaten mit Jubelrufen.“"
                            },
                            {
                                "example_id": "770e4a2e-b59d-435e-987d-f483058fe309",
                                "sense_id": "87b31da9-2449-39a1-8580-62997915f0f1",
                                "text": "„Das war ein neuer Regieeinfall; die liebe Mama stieß bei diesem Anblick in ihrer Freude einen Jubelruf aus, und die Zuckerbäckerin glänzte vor Stolz, daß sie vier volle Stunden lang den Platz der Contessa eingenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
