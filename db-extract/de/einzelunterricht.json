                ],
                "senses": [
                    {
                        "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                        "entry_id": "b831244b-ece6-3e2e-b6a4-abd1733780f3",
                        "glosses": [
                            "Unterricht, das heißt die Weitergabe von Wissen, Information und Fähigkeiten, für einen einzigen Schüler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f577bc-bddf-46a3-8d5f-55914328fa53",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "An der Musikschule wird Gitarre sowohl im Einzel- als auch im Gruppenunterricht angeboten."
                            },
                            {
                                "example_id": "52036ab6-ca0c-4911-a648-42ee0146079b",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "Im Einzelunterricht lernt man eine Sprache am schnellsten."
                            },
                            {
                                "example_id": "8c1aca9a-e71f-4b9f-b714-9b656bf2a096",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "„[…] die Schüler [bekamen] achtwöchigen Einzelunterricht in grundlegenden Mathe-Kenntnissen.“"
                            },
                            {
                                "example_id": "c3a7f1ec-4cf7-4fb2-a617-ff915c6d3c2b",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "„Meditieren können wir lernen - in einem Kurs, im Einzelunterricht, aber auch im Internet per Podcast oder Meditations-App.“"
                            },
                            {
                                "example_id": "cf4cd869-219b-4a68-b2b3-2700dcab5af0",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "„Seit Jahresanfang erhält Jeremie täglich zwei Stunden Einzelunterricht in einem regionalen Bildungszentrum.“"
                            },
                            {
                                "example_id": "bde26461-0b91-46ae-b734-9c629834da9f",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "„María Konráðsdóttir: »Es gibt viele Kinder, die so anfangen wie ich: in einem Blasorchester. Da bekommt jeder meistens 45-60 Minuten Einzelunterricht und hat dann zweimal in der Woche Blasorchesterprobe.«“"
                            },
                            {
                                "example_id": "377e5457-8ef1-4b7d-9b69-2f06661d592e",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "[Coronapandemie:] „[…] Prof. Georg Arzberger unterrichtet im Fach Klarinette. Er muss den Einzelunterricht mit seinen Studierenden derzeit per Video-Übertragung realisieren […].“"
                            },
                            {
                                "example_id": "7cd5ec74-121b-4c26-aaf1-6978c2a23c28",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "[Coronapandemie:] „Doch gerade an Musikhochschulen können Videokonferenzen den persönlichen Einzelunterricht kaum ersetzen.“"
                            },
                            {
                                "example_id": "a3f1e036-f772-4115-9786-9867b7a2740a",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "[Coronapandemie:] Der Einzelunterricht an den Musikschulen kann ab dem 11. Mai wieder stattfinden."
                            },
                            {
                                "example_id": "7c769365-7649-49f9-aa02-aaeb0d1492fa",
                                "sense_id": "7c137182-548c-3c73-afeb-6b503c4e8a9d",
                                "text": "„[…] eine Überarbeitung der Prüfungsordnung sieht ab Sommer für die Jahrgangsstufen 7 bis 10 […] mehr Einzelunterricht in Biologie, Chemie und Physik vor - mit Einzelnoten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
