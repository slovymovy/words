                "senses": [
                    {
                        "sense_id": "bce89fbe-bc9d-3655-b8c0-d2aa9466b53b",
                        "entry_id": "06dff7d6-ef0f-3a5c-951d-ffe50342f723",
                        "glosses": [
                            "индейский язык, распространенный в ряде стран Южной Америки, один из двух государственных языков Парагвая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83d4480-b02b-4452-a7ac-d76e8cf4fc20",
                                "sense_id": "bce89fbe-bc9d-3655-b8c0-d2aa9466b53b",
                                "text": "На гуарани говорят более 7 миллионов человек."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95a60649-746e-49ad-ac6c-ec480468723f",
                        "source_entry_id": "06dff7d6-ef0f-3a5c-951d-ffe50342f723",
                        "source_sense_id": "bce89fbe-bc9d-3655-b8c0-d2aa9466b53b",
                        "target_lang_word": "guaraní",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guaraní",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2a2873e4-6002-3f9d-aa55-a682dc7a15d0",
                                        "entry_id": "3c18713b-bbd7-32ad-84ad-25d039eca452",
                                        "glosses": [
                                            "Propio de, relativo o perteneciente a cierto pueblo nativo sudamericano, originario de la región amazónica, y cuyos descendientes hoy habitan el Paraguay, el Oriente boliviano, el NE de Argentina y el S de Brasil. Eran cazadores-recolectores transhumantes antes de su evangelización, sobre todo por la Compañía de Jesús."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba87efbd-4719-4d95-b0ab-4c765a7e123c",
                                                "sense_id": "2a2873e4-6002-3f9d-aa55-a682dc7a15d0",
                                                "text": "En su compañía llevó dos mil guaranís, guerreros escogidos y certeros en la dirección de la flecha."
                                            },
                                            {
                                                "example_id": "bf5fcc13-e846-4edf-8122-0cd9576bde86",
                                                "sense_id": "2a2873e4-6002-3f9d-aa55-a682dc7a15d0",
                                                "text": "Los grupos indígenas guaraníes que existen en la actualidad ocupan distintos territorios que exceden los límites de la frontera paraguaya."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "guaraní",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6434d343-69ab-34f1-8863-652f8bafe1ed",
