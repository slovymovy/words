                ],
                "senses": [
                    {
                        "sense_id": "e8566d4a-d9ff-34dc-8990-6b30d4c3d5df",
                        "entry_id": "10cac335-65e0-3140-a764-e2e7ec66411e",
                        "glosses": [
                            "A tree (Vitellaria paradoxa) indigenous to Africa, occurring in Mali, Cameroon, Congo, Côte d'Ivoire, Ghana, Guinea, Togo, Nigeria, Senegal, Sudan, Burkina Faso and Uganda."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73cd78cc-75e9-4d62-a95d-1c753e703306",
                                "sense_id": "e8566d4a-d9ff-34dc-8990-6b30d4c3d5df",
                                "text": "The people were every where employed in collecting the fruit of the Shea trees, from which they prepare the vegetable butter mentioned in former parts of this work. […] They are not planted by the natives, but are found growing naturally in the woods; and, in clearing wood land for cultivation, every tree is cut down but the Shea."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d199f4a-57da-3fcc-94ee-21d39005eb28",
                        "entry_id": "10cac335-65e0-3140-a764-e2e7ec66411e",
                        "glosses": [
                            "The fruit of this tree, having a thin, tart, nutritious pulp that surrounds a relatively large, oil-rich seed."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ee6cdc7-eb08-4b2f-a2f3-3cbd9cf47743",
                        "source_entry_id": "10cac335-65e0-3140-a764-e2e7ec66411e",
                        "source_sense_description": "tree",
                        "target_lang_word": "Sheaboom",
