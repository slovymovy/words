                "senses": [
                    {
                        "sense_id": "42914f48-c58b-3874-8a75-2a73f8a9b0c4",
                        "entry_id": "cc438eb0-a262-3753-a25f-adb76586deb7",
                        "glosses": [
                            "trein die uitsluitend is bestemd om goederen te vervoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ecfb1a9-dabc-48b5-9115-727927e0a32c",
                                "sense_id": "42914f48-c58b-3874-8a75-2a73f8a9b0c4",
                                "text": "Een goederentrein was ontspoord."
                            },
                            {
                                "example_id": "9bef3be3-650d-4274-a06f-7612bc25a1fb",
                                "sense_id": "42914f48-c58b-3874-8a75-2a73f8a9b0c4",
                                "text": "Uren en uren trok ik door het uitgestorven landschap toen ik plotseling een hele tijd moest wachten om een spoorlijn over te steken waar juist een lange goederentrein met een slakkengang langskwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "595e8946-27b6-444f-9614-c64259cafa98",
                        "source_entry_id": "cc438eb0-a262-3753-a25f-adb76586deb7",
                        "source_sense_id": "42914f48-c58b-3874-8a75-2a73f8a9b0c4",
                        "source_sense_description": "trein die uitsluitend is bestemd om goederen te vervoeren",
                        "target_lang_word": "Güterzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Güterzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "620c96e8-b780-397f-8b27-0e9da20736b0",
                                        "entry_id": "d156c394-3f52-3424-8511-a5ed1cd5d562",
                                        "glosses": [
                                            "Eisenbahnzug zum Transport von Gütern aller Art (und nicht Personen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9567bb-1416-4053-bb44-1dab455439d2",
                                                "sense_id": "620c96e8-b780-397f-8b27-0e9da20736b0",
                                                "text": "Durch Göttingen fahren jeden Tag viele Güterzüge."
                                            },
                                            {
                                                "example_id": "6ea8ef6c-1829-4ec4-b7e2-095375d5158a",
                                                "sense_id": "620c96e8-b780-397f-8b27-0e9da20736b0",
                                                "text": "„Ein langer Güterzug der Canadian Pacific gleitet neben der Straße her.“"
                                            },
                                            {
                                                "example_id": "8ab81841-c581-4d1a-9329-03adf328ee29",
                                                "sense_id": "620c96e8-b780-397f-8b27-0e9da20736b0",
                                                "text": "„Seit dem Sommer 1945 passieren unaufhörlich Güterzüge die schlesischen Bahnhöfe.“"
                                            },
                                            {
                                                "example_id": "005517cd-7e3f-484f-ac00-f52d55c8b75c",
                                                "sense_id": "620c96e8-b780-397f-8b27-0e9da20736b0",
                                                "text": "„Im ersten Waggon des Güterzugs, gleich hinter dem Tender, liegt ein Mensch auf Stroh.“"
                                            },
                                            {
                                                "example_id": "aec0e9a6-420a-44f7-9b43-5aa14b2b4cab",
                                                "sense_id": "620c96e8-b780-397f-8b27-0e9da20736b0",
                                                "text": "„Leere Güterzüge kamen uns entgegen, die vielleicht Holz und Munition vorgebracht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1b92f55-50d0-4598-a652-936dd51fba29",
                        "source_entry_id": "cc438eb0-a262-3753-a25f-adb76586deb7",
                        "source_sense_id": "42914f48-c58b-3874-8a75-2a73f8a9b0c4",
