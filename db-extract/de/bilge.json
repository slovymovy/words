                    {
                        "sense_id": "ad116fbc-5209-3cf3-ad8e-be20900ae449",
                        "entry_id": "390e31b7-c7cc-3b2a-9bbc-7208e43bcbf0",
                        "glosses": [
                            "tiefster Punkt eines Schiffes im Kielraum, in dem der Ballast zur Stabilisierung des Schiffes verstaut war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3712f1-87c4-4a52-b244-2a339d5a7b24",
                                "sense_id": "ad116fbc-5209-3cf3-ad8e-be20900ae449",
                                "text": "Schwitz-, Spritz- und Abwasser sammeln sich in der Bilge."
                            },
                            {
                                "example_id": "7297462a-697e-4e1f-bd5f-c88d1469e4a9",
                                "sense_id": "ad116fbc-5209-3cf3-ad8e-be20900ae449",
                                "text": "In der Bilge sammeln sich Wasser- und Ölreste, das sogenannte Bilgenwasser."
                            },
                            {
                                "example_id": "c87e907f-5f9d-4bcc-ab89-7e3ad231b60d",
                                "sense_id": "ad116fbc-5209-3cf3-ad8e-be20900ae449",
                                "text": "„Durch das Turmluk, das Sprachrohr und auch den Dieselluftmast war ins Boot tonnenweise Wasser eingedrungen, das nun bedrohlich in der Bilge unter unseren Füßen schwappte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
