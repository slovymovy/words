                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour financer ses études à l'université, ce jeune homme <w>cumule</w> deux emplois."
                        },
                        {
                            "text": "La loi interdit désormais aux parlementaires de <w>cumuler</w> plusieurs mandats importants."
                        }
                    ],
                    "common_phrases": [
                        "cumuler des emplois",
                        "cumuler des mandats",
                        "cumuler les casquettes"
                    ]
                },
                {
                    "sense_id": "fb8a1c7b-4add-3abd-b5e7-77b5e43e09e8",
                    "sense_definition": "Totaliser, rassembler ou acquérir une quantité croissante au fil du temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle chanson <w>cumule</w> déjà des millions d'écoutes sur Internet."
                        },
                        {
                            "text": "Avec chaque achat en magasin, les clients <w>cumulent</w> des points de fidélité."
                        }
                    ],
                    "synonyms": [
