                "senses": [
                    {
                        "sense_id": "4d5cf6ef-d8f6-3300-8416-377f863b0a11",
                        "entry_id": "88c5c3d3-01a6-37f9-8e34-1a5d4c20ddd5",
                        "glosses": [
                            "Colored mostly red, bay, or black, with flecks of white or grey especially on the flanks."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fe89f4e3-21ef-4fe0-8438-abbaa93c5b25",
                                "sense_id": "4d5cf6ef-d8f6-3300-8416-377f863b0a11",
                                "text": "There are other mixt kind of colours, such as the Rubican; which is when a black or sorrel Horse hath white Hairs here and there scattered upon his Body, but especially upon his Flanks."
                            },
                            {
                                "example_id": "60dc2a29-ffd4-4916-92cb-7d5adc80c369",
                                "sense_id": "4d5cf6ef-d8f6-3300-8416-377f863b0a11",
                                "text": "The grayish and the flea-bitten differ from the rubican, in that the white hairs which form these markings are sufficiently numerous to change, locally, the nature of the base of the coat."
                            },
                            {
                                "example_id": "07897ad6-fae1-4847-8804-09838ee791b5",
                                "sense_id": "4d5cf6ef-d8f6-3300-8416-377f863b0a11",
                                "text": "When both parents are brown, foals may be of any colour, also gray if one parent is rubican. The majority of foals, however, will likewise be brown."
                            }
                        ]
                    }
                ],
