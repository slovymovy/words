                                "sense_id": "a5c97fd3-bf06-3ea4-aecc-5c94b70c8b6c",
                                "text": "Maart is een goede tijd om een rotstuin aan te leggen."
                            },
                            {
                                "example_id": "3db737ab-d1ce-4a51-b1d4-68f98c06d727",
                                "sense_id": "a5c97fd3-bf06-3ea4-aecc-5c94b70c8b6c",
                                "text": "De tuin heeft ondanks de vijver, rotstuin en borders genoeg gras voor een potje voetbal."
                            }
                        ]
                    }
