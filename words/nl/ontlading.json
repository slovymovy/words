{
    "word_family": [
        "ontladen",
        "lading",
        "laden"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fc4a6f2-6588-3c0c-bfb9-2f387e4ed3d9",
                    "sense_definition": "Het plotseling wegvallen of uiten van opgebouwde spanning of emotie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele_ontlading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het horen van het goede nieuws was er een enorme <w>ontlading</w> van vreugde in de kamer.",
                            "target_lang_translations": {
                                "en": "After hearing the good news, there was an enormous <w>release</w> of joy in the room."
                            }
                        },
                        {
                            "text": "Huilen kan soms zorgen voor een emotionele <w>ontlading</w> na een stressvolle periode.",
                            "target_lang_translations": {
                                "en": "Crying can sometimes provide an emotional <w>release</w> after a stressful period."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontspanning",
                        "uitbarsting",
                        "opluchting"
                    ],
                    "antonyms": [
                        "spanning",
                        "stress"
                    ],
                    "common_phrases": [
                        "emotionele ontlading",
                        "een enorme ontlading"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden release or expression of built-up tension or emotion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "of tension or emotion"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "of built-up feelings"
                            },
                            {
                                "target_lang_word": "outburst",
                                "target_lang_sense_clarification": "sudden expression of emotion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10015683-9bc8-3802-b027-dea00cfa621c",
                    "sense_definition": "Het wegvloeien of overspringen van elektrische lading.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysische_ontlading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bliksem is een spectaculaire elektrische <w>ontlading</w> in de atmosfeer.",
                            "target_lang_translations": {
                                "en": "Lightning is a spectacular electrical <w>discharge</w> in the atmosphere."
                            }
                        },
                        {
                            "text": "Bij een plotselinge <w>ontlading</w> van statische elektriciteit kun je een schokje voelen.",
                            "target_lang_translations": {
                                "en": "With a sudden <w>discharge</w> of static electricity, you can feel a small shock."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroomstoot"
                    ],
                    "antonyms": [
                        "oplading"
                    ],
                    "common_phrases": [
                        "elektrische ontlading",
                        "plotselinge ontlading"
                    ],
                    "target_lang_definitions": {
                        "en": "The flow or release of electric charge."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "electrical"
                            },
                            {
                                "target_lang_word": "electric discharge",
                                "target_lang_sense_clarification": "flow of electricity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11b1c79f-4195-34f2-ad83-498afd0622f9",
                    "sense_definition": "Het wegnemen van een lading of vracht; het proces van <w>ontladen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lossen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ontlading</w> van het vrachtschip nam de hele middag in beslag.",
                            "target_lang_translations": {
                                "en": "The <w>unloading</w> of the cargo ship took up the entire afternoon."
                            }
                        },
                        {
                            "text": "Tijdens de <w>ontlading</w> van de goederen moet de veiligheid streng bewaakt worden.",
                            "target_lang_translations": {
                                "en": "During the <w>unloading</w> of the goods, safety must be strictly monitored."
                            }
                        }
                    ],
                    "synonyms": [
                        "lossing",
                        "ontlading"
                    ],
                    "antonyms": [
                        "lading",
                        "belading"
                    ],
                    "common_phrases": [
                        "ontlading van goederen"
                    ],
                    "target_lang_definitions": {
                        "en": "The removal of a load or cargo; the process of unloading."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unloading",
                                "target_lang_sense_clarification": "of cargo or goods"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "of a ship or cargo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}