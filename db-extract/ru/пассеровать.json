                "senses": [
                    {
                        "sense_id": "361ac2a7-0d9f-3d9c-8625-708642fe69f5",
                        "entry_id": "26876f8b-8f1d-3c09-938d-8e5bd4af08ee",
                        "glosses": [
                            "кулин. обжаривать (обжарить) в небольшом количестве масла или жира на умеренном огне до мягкого состояния (муку, овощи, коренья)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af546886-0974-4f6f-85bd-ec527af75d49",
                                "sense_id": "361ac2a7-0d9f-3d9c-8625-708642fe69f5",
                                "text": "Мелко нарезанный лук пассеруете на сливочном масле, добавляете огурцы, томатную пасту, специи и все вместе припускаете на сковородке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbdb369c-63b9-4169-bcec-28aa06c2638e",
                        "source_entry_id": "26876f8b-8f1d-3c09-938d-8e5bd4af08ee",
                        "source_sense_id": "361ac2a7-0d9f-3d9c-8625-708642fe69f5",
                        "target_lang_word": "brown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c2f7775-c1ff-360f-a07a-b5ec28cf8553",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "A colour like that of chocolate or coffee."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e24e91-38c4-4fb2-b850-977870be7da4",
                                                "sense_id": "6c2f7775-c1ff-360f-a07a-b5ec28cf8553",
                                                "text": "The browns and greens in this painting give it a nice woodsy feel."
                                            },
                                            {
                                                "example_id": "9cc486ef-babe-4656-b7a8-9d4983ba90f5",
                                                "sense_id": "6c2f7775-c1ff-360f-a07a-b5ec28cf8553",
                                                "text": "He wore brown jeans for his birthday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7535b56a-b729-3590-94eb-4db504de6981",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "One of the colour balls used in snooker, with a value of 4 points."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1631e581-dc1b-3e2a-a070-5299335e2d42",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "Black tar heroin."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "860dd779-72e1-3ce9-af13-53c98d194958",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "A copper coin."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "452c149d-9f47-43f0-85ff-2f64ba467a0e",
                                                "sense_id": "860dd779-72e1-3ce9-af13-53c98d194958",
                                                "text": "“To save a journey up the town, / A razor lent here for a brown: / But if you think the price too high, / I beg you won’t the razor try.”"
                                            },
                                            {
                                                "example_id": "fa77824a-59c4-4228-9aec-b56cc7bc32c1",
                                                "sense_id": "860dd779-72e1-3ce9-af13-53c98d194958",
                                                "text": "I know there are many persons — some who are themselves poor — who 'never turn a beggar from their door,' but always give them a few browns (halfpence) or some scran (broken victuals)."
                                            },
                                            {
                                                "example_id": "8d153d1d-6427-45d7-b2f8-9680587e8698",
                                                "sense_id": "860dd779-72e1-3ce9-af13-53c98d194958",
                                                "text": "\"We've not had any breakfast,—won't you toss us down a brown?\"—\nThat's what they call a penny in the streets of London Town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b9859c3-1536-3938-b713-8953b6ebd7e6",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "A brown horse or other animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa939672-38c8-47d7-a87b-6d01adf59a83",
                                                "sense_id": "4b9859c3-1536-3938-b713-8953b6ebd7e6",
                                                "text": "[…] browns are the soberest, bays are the worst tempered, and chestnuts are the most foolish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2b2f27e-2ca7-3c69-b444-a646bd75e2b9",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "A person of mostly Latin American (or Latino), Middle Eastern/North African, South Asian, and sometimes Southeast Asian, Pacific Islander, or rarely Native American descent; a brown-skinned person; someone of mulatto, or biracial appearance."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "ethnic",
                                            "informal",
                                            "slur",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4038276-18fa-4788-a7df-0121eb5d00cf",
                                                "sense_id": "f2b2f27e-2ca7-3c69-b444-a646bd75e2b9",
                                                "text": "Many browns and blacks are immigrants — some of whom have not yet become naturalized citizens of the United States."
                                            },
                                            {
                                                "example_id": "2c1021dd-3d9f-4812-8f6d-0f60c503ec41",
                                                "sense_id": "f2b2f27e-2ca7-3c69-b444-a646bd75e2b9",
                                                "text": "For example, a Brown Asian Caucus emerged at the inaugural National Conference on Asian American Mental Health in 1972 – where Filipinos were joined by Pacific Islanders who also felt marginalized as part of the Asian American/ Pacific Islander (AAPI) umbrella group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c505160-5bf8-3b61-a157-5e78e60d6028",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of subfamily Satyrinae (formerly the family Satyridae), such as those of the genera Heteronympha and Melanitis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1407817b-0eb4-37ec-bbb3-1edf474a858f",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "A brown trout (Salmo trutta)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c1b824-12d5-374a-afc2-0eb21e63c8b2",
                                        "entry_id": "05f754fb-937d-3fb8-986d-e8a1403fb4ee",
                                        "glosses": [
                                            "A mass of birds or animals that may be indiscriminately fired at."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06ca349-193b-46c0-9e3e-64a053a99a45",
                                                "sense_id": "f9c1b824-12d5-374a-afc2-0eb21e63c8b2",
                                                "text": "The temptation to have a shot into the brown was great. There was not a head there which was not a big one and the one by himself was not too easy a shot since it is always difficult to shoot when lying in soft snow."
                                            },
                                            {
                                                "example_id": "2cd2bf6c-e946-45b2-ad2d-48fcc90090bf",
                                                "sense_id": "f9c1b824-12d5-374a-afc2-0eb21e63c8b2",
                                                "text": "My anger mounted at this, I opened the courtyard door and raised my musket to fire into the brown; I had loaded it with small shot, and if it had gone off that would have been the death of us and the ruin of all of us in the house."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa9ec8b-41c7-388a-aaca-cea6f76ea686",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Having a brown colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c58d64f1-c8fa-4e7a-82a4-e969aa3968b5",
                                                "sense_id": "6fa9ec8b-41c7-388a-aaca-cea6f76ea686",
                                                "text": "But none of those brown dwarfs were speeding along on a trajectory that would carry them out of the galaxy like “runaway” hypervelocity stars observed by astronomers in the last two decades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a609088-6f24-3144-8ae4-3e4b535335ac",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Gloomy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d22f5d7-b0d3-3ff1-a7ad-754fbb4b2b1b",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Of or relating to any of various ethnic groups having dark pigmentation of the skin.",
                                            "Latino/Latin American"
                                        ],
                                        "tags": [
                                            "US",
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09965be-33e6-4a86-861d-0fb67e3da3c0",
                                                "sense_id": "3d22f5d7-b0d3-3ff1-a7ad-754fbb4b2b1b",
                                                "text": "Reminds me of the time they asked me and a group of other Latino, predominantly Mexican, friends for our passports when we tried to go to their [expletive] party a little over a year ago.[…]\nThe saddest part is that I don’t think they understand why it’s insulting to ask a brown person for a passport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2134b1-222f-3674-a34d-8b740210e97e",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Of or relating to any of various ethnic groups having dark pigmentation of the skin.",
                                            "of color."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f67b0f6-e7cb-3a92-add7-888579d78a7f",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Of or relating to any of various ethnic groups having dark pigmentation of the skin.",
                                            "South Asian or sometimes Middle Eastern or North African"
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c28231-0d96-44ef-bdb9-2345fafe4b2c",
                                                "sense_id": "6f67b0f6-e7cb-3a92-add7-888579d78a7f",
                                                "text": "I think they sort of realized like, oh, we have Aasif who is a Muslim, an American, brown person, you know, who can sit on that fence between cultures and sort of talk about what it is--what this is from the perspective of being an insider and an outsider at the same time.[…]\nI think there is in the sort of South Asian, you know, psyche, a kind of adoration of Western ideals and culture that was sort of implanted into us by the British, you know, and this idea that everything that is Western is superior and better than what we have and what India--you know, what is true to our own culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bf525d-5047-3347-800e-4babdad4d968",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Of or relating to any of various ethnic groups having dark pigmentation of the skin.",
                                            "Southeast Asian, Pacific Islander, or sometimes Native American"
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233f1a04-0230-40e8-805f-995a6bab9d99",
                                                "sense_id": "c6bf525d-5047-3347-800e-4babdad4d968",
                                                "text": "I came to deeply embrace anti-racism in slow, sustained increments.\nTo do so, I had to embrace my own identity as a Brown person -- and understand my own complicity in white supremacy.[…]\nI had grown up in an entire Southeast Asian culture that had largely been groomed, indoctrinated and brainwashed into white-centered thinking over some 450 years of colonization by our Western overlords: Spain for almost 400 years, and then the United States of America for nearly 50 years more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639f2c78-ffe3-3e91-9d96-478943100019",
                                        "entry_id": "68ed6402-b575-3e18-a128-dc922ae57988",
                                        "glosses": [
                                            "Not green (environmentally irresponsible); anti-green (against environmental protection)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb7bcb8-6d25-4cc6-941a-314532a9b49a",
                                                "sense_id": "639f2c78-ffe3-3e91-9d96-478943100019",
                                                "text": "Near-synonyms: nongreen, antigreen"
                                            },
                                            {
                                                "example_id": "23d82a91-f5a4-43da-a611-943495e0e3dc",
                                                "sense_id": "639f2c78-ffe3-3e91-9d96-478943100019",
                                                "text": "Tesco and Sainsbury, two of Britain’s biggest retailers, are locked in a fierce battle to prove who is greener. Even BSkyB, the British satellite outpost of the distinctly brown Murdoch empire, has declared itself “carbon-neutral.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brown",
                                "target_lang_code": "en",
