                "senses": [
                    {
                        "sense_id": "d2436f84-02bd-33c9-b0a1-0c75b40cc550",
                        "entry_id": "5bb3743b-b9a4-3c03-af21-4895e870c475",
                        "glosses": [
                            "waarvan de bladeren minder oppervlak hebben dan verwante soorten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc3e6374-3dd8-4b19-8e7f-7b71c1b44d5d",
                                "sense_id": "d2436f84-02bd-33c9-b0a1-0c75b40cc550",
                                "text": "Vooral de kleinbladige linden (Tilia cordata), die overal in de stad in rijen in het gras staan aangeplant, ogen allesbehalve florissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d6745a6-9f09-3709-b541-1f6571d2c639",
                        "entry_id": "5bb3743b-b9a4-3c03-af21-4895e870c475",
                        "glosses": [
                            "met bladeren die weinig oppervlak hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4a1fc5-80ab-4f6d-9c02-8abfd3373fb1",
                                "sense_id": "3d6745a6-9f09-3709-b541-1f6571d2c639",
                                "text": "Het bevat een kleinbladig en zeer mooi klavertje dat heel kort blijft en daardoor nauwelijks maaiafval oplevert."
                            },
                            {
                                "example_id": "f6104773-c2f4-4318-b01b-02a4a5937f9c",
                                "sense_id": "3d6745a6-9f09-3709-b541-1f6571d2c639",
                                "text": "De gerookte tonijn verliest de smaakstrijd met de dillerijke mesclun (gemengde, kleinbladige sla) en het garnituur van olijven en kappertjes."
                            }
                        ]
                    }
