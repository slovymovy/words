                                "target_senses": [
                                    {
                                        "sense_id": "df4544bc-2056-399e-a67c-b5e14bc334a5",
                                        "entry_id": "13344f67-cf55-311c-a5a2-758bcbd89417",
                                        "glosses": [
                                            "Money stored for illegal or dishonest purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc7a727-83f5-429d-90d1-d7840ab430ef",
                                                "sense_id": "df4544bc-2056-399e-a67c-b5e14bc334a5",
                                                "text": "He is said to have used his party’s slush fund to buy votes in the election."
                                            },
                                            {
                                                "example_id": "08472029-6af8-42c1-8889-3643cb75003d",
                                                "sense_id": "df4544bc-2056-399e-a67c-b5e14bc334a5",
                                                "text": "7: CERN bestows slush fund on the LHC. Take all pennies from the CERN space."
                                            },
                                            {
                                                "example_id": "44d1f1e3-bc1d-46b6-a954-a2d7e1076e8c",
                                                "sense_id": "df4544bc-2056-399e-a67c-b5e14bc334a5",
                                                "text": "To do this, [the Lord Mayor] has at his disposal a multibillion-pound slush fund for use in lobbying the UK government and governments around the world to bring in laws that are friendly to banks and multinational companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8653e8d-c5de-30f3-a363-5c650c3e26d6",
                                        "entry_id": "13344f67-cf55-311c-a5a2-758bcbd89417",
                                        "glosses": [
                                            "Money that has not been hypothecated or dedicated to a particular purpose, or which is used for a different purpose than originally intended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4883245-1942-4f2d-8ba8-596de16198d7",
                                                "sense_id": "e8653e8d-c5de-30f3-a363-5c650c3e26d6",
                                                "text": "A slush fund is a sum of money that is set aside as a reserve. In accounting, a slush fund is a general ledger account of commingled funds that does not have a designated purpose. In more sinister cases, a slush fund may be used as a \"black fund,\" which is unaccounted for and kept off the books."
                                            }
                                        ]
                                    }
                                ]
