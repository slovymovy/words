                                            "form-of",
                                            "imperative",
                                            "present",
                                            "singular"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62b3d704-ca61-467d-9955-8d234ada5fb0",
                        "source_entry_id": "39717472-cdb7-32a6-a250-c285c0f4e712",
                        "source_sense_id": "3f6d4388-3994-3572-be28-24ee70993010",
                        "source_sense_description": "stylish, high-toned, upscale",
                        "target_lang_word": "exklusiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exklusiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b5adc3-c9ca-3a81-9b89-54aaf8ffd9fe",
                                        "entry_id": "35ce4f26-3499-3a36-9b8a-b86331fd7dfc",
                                        "glosses": [
                                            "von besonders hohem Prestige oder Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2896f438-fbba-4d8b-877e-699f52edbef7",
                                                "sense_id": "b3b5adc3-c9ca-3a81-9b89-54aaf8ffd9fe",
                                                "text": "Das Publikum dieser Veranstaltung war sehr exklusiv."
                                            },
                                            {
                                                "example_id": "14a41329-8f59-4f90-b655-71f439a698e2",
                                                "sense_id": "b3b5adc3-c9ca-3a81-9b89-54aaf8ffd9fe",
                                                "text": "Sie trug einen sehr exklusiven Schmuck."
                                            },
                                            {
                                                "example_id": "d451d7a9-fe6c-4932-b92f-2e5a80485d1e",
                                                "sense_id": "b3b5adc3-c9ca-3a81-9b89-54aaf8ffd9fe",
                                                "text": "„Hier zählen auch Symbole - und da ist der Abstieg aus dem exklusiven Kreis der besten Schuldner der Erde ein Menetekel.“"
                                            },
                                            {
                                                "example_id": "9315999c-eb80-413c-9b30-791f76f1c12e",
                                                "sense_id": "b3b5adc3-c9ca-3a81-9b89-54aaf8ffd9fe",
                                                "text": "„Die Abteilung „Meissen individuell“ erfüllt exklusivste Wünsche von Millionären weltweit (z.B. Hund als Großplastik, Meissen-Wandgemälde).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6eb8df49-a99f-373a-a0d6-b82cdc839c6a",
                                        "entry_id": "35ce4f26-3499-3a36-9b8a-b86331fd7dfc",
                                        "glosses": [
                                            "nur für einen bestimmten Kreis zugänglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a89cee-ba02-4d1d-b97a-899c2ac980f0",
                                                "sense_id": "6eb8df49-a99f-373a-a0d6-b82cdc839c6a",
                                                "text": "Die Zeitschrift hatte die exklusiven Rechte daran erworben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ca47605-a003-49b1-bbbe-f225dd0f2dfd",
