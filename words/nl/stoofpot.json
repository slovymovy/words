{
    "word_family": [
        "stoven",
        "stoof",
        "stoofschotel",
        "stoofvlees"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0bed8316-d8f8-3f4f-9ad4-9116c4983596",
                    "sense_definition": "Een gerecht dat langzaam is gaargestoofd, vaak bestaande uit vlees, vis of groenten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gerecht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter maken we vaak een heerlijke <w>stoofpot</w> met rundvlees en wortels.",
                            "target_lang_translations": {
                                "en": "In winter, we often make a delicious beef and carrot <w>stew</w>."
                            }
                        },
                        {
                            "text": "Zij serveerde een vegetarische <w>stoofpot</w> met pompoen en kikkererwten.",
                            "target_lang_translations": {
                                "en": "She served a vegetarian <w>stew</w> with pumpkin and chickpeas."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoofschotel",
                        "stoofgerecht"
                    ],
                    "common_phrases": [
                        "een heerlijke stoofpot",
                        "vegetarische stoofpot"
                    ],
                    "target_lang_definitions": {
                        "en": "A dish that is slowly simmered, often consisting of meat, fish, or vegetables."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stew",
                                "target_lang_sense_clarification": "a dish of meat and vegetables cooked slowly in liquid"
                            },
                            {
                                "target_lang_word": "casserole",
                                "target_lang_sense_clarification": "a food mixture cooked slowly in a covered pot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6779081-dc39-39e3-80f2-9799e8db0a35",
                    "sense_definition": "Een pan of pot die speciaal is ontworpen voor het bereiden van stoofgerechten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kookgerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kocht een zware gietijzeren <w>stoofpot</w> om vlees langzaam in te garen.",
                            "target_lang_translations": {
                                "en": "She bought a heavy cast-iron <w>stewpot</w> to slow-cook meat."
                            }
                        },
                        {
                            "text": "Verwarm de <w>stoofpot</w> langzaam op een laag vuur.",
                            "target_lang_translations": {
                                "en": "Heat the <w>pot</w> slowly over low heat."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoofpan"
                    ],
                    "common_phrases": [
                        "gietijzeren stoofpot"
                    ],
                    "target_lang_definitions": {
                        "en": "A pot or pan specifically designed for preparing stews and slow-cooked dishes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stewpot",
                                "target_lang_sense_clarification": "a pot used for cooking stews"
                            },
                            {
                                "target_lang_word": "casserole dish",
                                "target_lang_sense_clarification": "a large, deep pan used for baking and slow cooking"
                            },
                            {
                                "target_lang_word": "Dutch oven",
                                "target_lang_sense_clarification": "a heavy, thick-walled cooking pot with a tight-fitting lid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}