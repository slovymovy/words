                "senses": [
                    {
                        "sense_id": "ba0083a6-8fca-33db-a2be-9203e268c3f2",
                        "entry_id": "2112985b-e5dd-34f5-a9d4-b5ca72029ab6",
                        "glosses": [
                            "Wurzel eines Baumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4c0ba6-5c49-408f-9190-bc78d0e4bbb4",
                                "sense_id": "ba0083a6-8fca-33db-a2be-9203e268c3f2",
                                "text": "„Ich sprang auf, um hinterherzujagen, stolperte aber über eine Baumwurzel und landete der Länge nach auf dem Bauch.“"
                            },
                            {
                                "example_id": "fbb14934-2c83-4435-bd51-0de99da663b3",
                                "sense_id": "ba0083a6-8fca-33db-a2be-9203e268c3f2",
                                "text": "„Der Palmendieb bewohnt Löcher in Korallenfelsen oder unter Baumwurzeln.“"
                            },
                            {
                                "example_id": "9ae02bff-be37-477e-bc81-a32ebe38a235",
                                "sense_id": "ba0083a6-8fca-33db-a2be-9203e268c3f2",
                                "text": "„Die Hundemangusten, Bdeogale, leben unter Baumwurzeln in den Trockenwäldern Afrikas.“"
                            },
                            {
                                "example_id": "6d866038-2bba-4e92-b3c9-b68a4e652629",
                                "sense_id": "ba0083a6-8fca-33db-a2be-9203e268c3f2",
                                "text": "„Zu den Singzikaden gehört die bis 4 cm lange, schwarz und rot gezeichnete Siebzehnjährige Zikade, Tibicen septemdecim, Nordamerikas, deren Larve an Baumwurzeln saugt und 17 Jahre zur Entwicklung benötigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
