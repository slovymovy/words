                        "sense_id": "23c06c48-0a92-3cc6-96ba-dfb6fe8122be",
                        "entry_id": "fa34ca7b-a8a1-3666-b2ed-524ee7b05fbc",
                        "glosses": [
                            "Artwork created unofficially by fans of a media work and based on that work."
                        ],
                        "tags": [
                            "slang",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "bda9068b-d7ed-4030-9e55-d57e8839a7b9",
                                "sense_id": "23c06c48-0a92-3cc6-96ba-dfb6fe8122be",
                                "text": "The same genres have inspired fanart as well."
                            },
                            {
                                "example_id": "ee92e27d-6f4d-44a2-819d-d1c22ee42173",
                                "sense_id": "23c06c48-0a92-3cc6-96ba-dfb6fe8122be",
                                "text": "Aarinfantasy's Web site offers several areas for fans to give back—whether this is sharing fanart in the Member's Gallery or offering support, discussion or interaction in the general forums."
                            }
                        ]
                    }
                ],
                "translations": [
