                "senses": [
                    {
                        "sense_id": "23d2e15f-7799-3b87-9b2d-367721ad077b",
                        "entry_id": "07cf1ba6-7d83-3f8e-a8e6-f267145071dd",
                        "glosses": [
                            "ungeordneter Ablauf oder Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0cea1f-2d65-4890-9c14-9840fb22feca",
                                "sense_id": "23d2e15f-7799-3b87-9b2d-367721ad077b",
                                "text": "„Wir sollten im Tanz einander gegenüberzustehen kommen und nach der Musik mit diesen Äpfeln ein Ballspiel aufführen. Und dies hatten wir nun wochenlang eingeübt, so sicher wie die besten Bombardiere. – Sollte nun dies beste Kunststück durchfallen? – Wir rafften schnell die Äpfel auf und stellten uns in Ordnung auf. Die Rohrpfeife wollte nun die Zwischenmusik überspringen und die Musik zum Ballspiel einleiten oder aufpfeifen. Aber die Geigen verstanden das nicht und kamen ihm nicht nach, sie blieben auf dem alten Satz; es gab ein Charivari.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06a58b4f-2afe-3e6a-87fc-008fde406aff",
                        "entry_id": "07cf1ba6-7d83-3f8e-a8e6-f267145071dd",
                        "glosses": [
                            "gleichzeitiges und ungeordnetes Spielen verschiedener Instrumente"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8cb61e92-2e82-4811-9479-d71ef503eeac",
                                "sense_id": "06a58b4f-2afe-3e6a-87fc-008fde406aff",
                                "text": "„Schließlich diente Charivari seit der Zeit des Barock abendländischen Komponisten als Stilmittel, um Unordnung und Schreckliches zu charakterisieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ee53eb03-c278-3001-84bf-a3c8984be6ab",
                        "entry_id": "07cf1ba6-7d83-3f8e-a8e6-f267145071dd",
                        "glosses": [
                            "Polterabend bei einer Wiederverheiratung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5da676-eb78-4297-97b0-8621eff7d1dd",
                                "sense_id": "ee53eb03-c278-3001-84bf-a3c8984be6ab",
                                "text": "„Charivari ist der Krach, den man zur Heirat und besonders zur Wiederverheiratung eines Witwers oder einer Witwe macht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e93a31c7-9826-320b-b699-b28b02738492",
                        "entry_id": "07cf1ba6-7d83-3f8e-a8e6-f267145071dd",
                        "glosses": [
                            "französischer Kartoffelsalat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b4d561-2bb3-4555-998d-12ae438dcffa",
                                "sense_id": "e93a31c7-9826-320b-b699-b28b02738492",
                                "text": "„Eine besondere Variante des Kartoffelsalats ist der Charivari, ein französischer Kartoffelsalat. Dieser wird mit Äpfeln, Birnen und Champignons verfeinert, ebenso werden Rote Bete und Salzgurken hinzu gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "db3d6e2d-1372-398d-a3db-d33e44ac0884",
                        "entry_id": "07cf1ba6-7d83-3f8e-a8e6-f267145071dd",
                        "glosses": [
                            "Schmuckkette am Trachtenanzug"
                        ],
                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "2772ff2e-64d1-4c55-860a-0d7b5f121c96",
                                "sense_id": "db3d6e2d-1372-398d-a3db-d33e44ac0884",
                                "text": "„In diesem Fall wird das Charivari vor dem Hosenlatz der Lederhose getragen. Es handelte sich um eine silberne Kette, an der diverse Schmuckstücke (Silbermünzen, Tierzähne, Kristalle und ähnliches) befestigt sind.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
