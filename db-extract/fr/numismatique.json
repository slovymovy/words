                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb1edcc-bfd3-3f9e-b6fd-5a6b42f09838",
                                        "entry_id": "e7121051-9131-3d29-bfdb-08f634f87cc6",
                                        "glosses": [
                                            "wissenschaftliche Beschäftigung mit Geld und seiner Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d95cd1-9de5-4ef0-8408-e36d301e90f5",
                                                "sense_id": "cfb1edcc-bfd3-3f9e-b6fd-5a6b42f09838",
                                                "text": "Das wichtigste Objekt der Numismatik ist die Münze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "819c29b8-7255-3a4e-b4a8-02904ab80551",
