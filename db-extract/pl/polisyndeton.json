                "translations": [
                    {
                        "translation_id": "980d0c7b-db37-4298-8adf-2ce4e3d16651",
                        "source_entry_id": "25157458-a60c-3770-9e3e-68c5e9213296",
                        "source_sense_id": "990f9198-0bf0-334c-9c44-39cdf09802f8",
                        "target_lang_word": "polysyndeton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polysyndeton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "016098c1-36ff-38c4-9eb0-0b68174cb690",
                                        "entry_id": "cf2d0fe2-49cf-3736-8aea-560907fa0dae",
                                        "glosses": [
                                            "The use of many conjunctions to achieve an overwhelming effect in a sentence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "580c2898-2c5e-47c4-8a5f-ae8eacec6d26",
                                                "sense_id": "016098c1-36ff-38c4-9eb0-0b68174cb690",
                                                "text": "In Polysyndeton conjunctions flow,\nAnd every word its copulative will shew."
                                            },
                                            {
                                                "example_id": "3e7d3f63-6f17-43fe-bec7-103167907504",
                                                "sense_id": "016098c1-36ff-38c4-9eb0-0b68174cb690",
                                                "text": "[Hemingway] often employs a variety of polysyndeton—a frequent use of conjunctions, most notably “and”—linking elements in a sentence together in a way that implies all parts are of equal importance, while in fact one unit of the series may be much more significant than the others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e750be3-0297-41d7-afe4-18c00fa5a085",
                        "source_entry_id": "25157458-a60c-3770-9e3e-68c5e9213296",
                        "source_sense_id": "990f9198-0bf0-334c-9c44-39cdf09802f8",
                        "target_lang_word": "polisíndeton",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polisíndeton",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d1d0094a-8a2d-3223-a7fb-5921fdbe9b48",
                                        "entry_id": "3fe53822-165c-3c0e-9418-396dfbedbb78",
                                        "glosses": [
                                            "Figura que consiste en emplear repetidamente las conjunciones para enfatizar la expresión de los conceptos."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1b9282-bc72-49f7-a986-0e6fb726fe7b",
                                                "sense_id": "d1d0094a-8a2d-3223-a7fb-5921fdbe9b48",
                                                "text": "Y sueña. Y ama. Y vibra. Y es hija del sol"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5c86bc-3d70-4458-8db7-cfb9696a93e5",
                        "source_entry_id": "25157458-a60c-3770-9e3e-68c5e9213296",
                        "source_sense_id": "990f9198-0bf0-334c-9c44-39cdf09802f8",
                        "target_lang_word": "Polysyndeton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polysyndeton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a4bd58-7c22-3ab2-97f9-e6bc9c59f75e",
                                        "entry_id": "ad312aaf-64bb-31b4-bb0d-8f341a4be73b",
                                        "glosses": [
                                            "eine rhetorische Figur, mit der Wort- oder Satzteile durch die Wiederholung einer Konjunktion verbunden werden; Beispiel: „Sie hat gespart und hat gesonnen // Und Flachs gekauft und nachts gewacht“ (Adelbert von Chamisso, Die alte Waschfrau)"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4c9b4c-e0bf-4772-bd2b-8ee1d383cd00",
                                                "sense_id": "e0a4bd58-7c22-3ab2-97f9-e6bc9c59f75e",
                                                "text": "„Das Polysyndeton bremst den Affekt und verlangsamt das Tempo von Rede oder Text.“"
                                            }
                                        ],
