                {
                    "sense_id": "fbda2039-7583-333d-b74c-a8a1dde8da67",
                    "sense_definition": "Не организованный официально, осуществляемый самостоятельно, без путёвок (об отдыхе, туризме).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tourism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили поехать на море «<диким>» способом, с палатками.",
                            "target_lang_translations": {
                                "en": "We decided to go to the sea in a '<wild>' way, with tents.",
                                "es": "Decidimos ir al mar «<por libre>», con tiendas de campaña.",
                                "fr": "Nous avons décidé d'aller à la mer en mode « <sauvage> », avec des tentes."
                            }
                        },
                        {
                            "text": "На этом берегу есть отличный <дикий> пляж, где мало людей.",
                            "target_lang_translations": {
                                "en": "There is an excellent <wild> beach on this shore where there are few people.",
                                "es": "En esta costa hay una excelente playa <virgen> donde hay poca gente.",
                                "fr": "Sur cette côte, il y a une excellente plage <sauvage> où il y a peu de monde."
                            }
                        }
                    ],
                    "common_phrases": [
                        "дикий пляж",
                        "дикий отдых",
                        "дикие туристы"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not officially organized, carried out independently, without travel packages (of recreation, tourism).",
                        "es": "No organizado de forma oficial, realizado de manera independiente y por cuenta propia (dicho del turismo o el descanso).",
                        "fr": "Non organisé officiellement, réalisé de façon indépendante, sans agence (pour les vacances, le tourisme)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "unorganized tourism"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "por libre",
                                "target_lang_sense_clarification": "turismo independiente"
                            },
                            {
                                "target_lang_word": "virgen",
                                "target_lang_sense_clarification": "playa o lugar no urbanizado"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sauvage",
                                "target_lang_sense_clarification": "non officiel, indépendant"
                            }
                        ]
                    }
