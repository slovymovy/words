    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37520f5c-a608-3298-9d2d-2b0e5553d16a",
                    "sense_definition": "The beginning or initial stage of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beginning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He understood from the <w>outset</w> that the project would be very difficult.",
                            "target_lang_translations": {
                                "ru": "Он с самого <w>начала</w> понимал, что проект будет очень сложным."
                            }
                        },
                        {
                            "text": "The team decided to play aggressively from the <w>outset</w> of the match.",
                            "target_lang_translations": {
                                "ru": "Команда решила играть агрессивно с самого <w>начала</w> матча."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginning",
                        "start",
                        "commencement"
                    ],
                    "antonyms": [
                        "end",
                        "conclusion"
                    ],
                    "common_phrases": [
                        "from the outset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начало или исходный этап чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нача́ло",
                                "target_lang_sense_clarification": "первый, ранний момент или период существования чего-либо"
                            },
                            {
                                "target_lang_word": "исходная точка",
                                "target_lang_sense_clarification": "первая, отправная точка процесса или события"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72cb78ec-9b55-3769-b67e-2b3c1731ce1c",
                    "sense_definition": "To cause a design element to extend around the outside of something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect chose to <w>outset</w> the frame to create a more dynamic facade.",
                            "target_lang_translations": {
                                "ru": "Архитектор решил <w>вынести</w> раму за контур, чтобы создать более динамичный фасад."
                            }
                        },
                        {
                            "text": "You should <w>outset</w> the border to ensure it does not overlap the main text.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>сместить</w> границу наружу, чтобы она не перекрывала основной текст."
                            }
                        }
                    ],
                    "antonyms": [
                        "inset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выносить элемент дизайна за пределы основной границы или контура."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносить за контур",
                                "target_lang_sense_clarification": "архитектурный или дизайнерский термин для выступающего элемента"
                            },
                            {
                                "target_lang_word": "смещать наружу",
                                "target_lang_sense_clarification": "действие по увеличению отступа элемента за пределы основной формы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
