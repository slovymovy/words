                    {
                        "sense_id": "1d31ae72-c713-3749-a896-c128ca929b64",
                        "entry_id": "0feebc03-8e2b-3df3-a5d4-8321d4bd4382",
                        "glosses": [
                            "Féminin singulier de aucun."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e0de9fba-c500-4f95-afef-d3244483aab9",
                                "sense_id": "1d31ae72-c713-3749-a896-c128ca929b64",
                                "text": "Il ne se privait d'ailleurs d’aucune des distractions que Paris offre aux gens qui roulent sur l'or, et il était arrivé à ce moment psychologique où l'ambition vient aux capitalistes."
                            },
                            {
                                "example_id": "3aedc32c-35bb-407b-82b3-f954a904319f",
                                "sense_id": "1d31ae72-c713-3749-a896-c128ca929b64",
                                "text": "Il distingua des pages blanches, sans aucune écriture, et se demanda par quel caprice du souvenir, il les revoyait à l’état vierge et non emplies de ses pattes de mouches."
                            }
                        ]
                    }
                ],
