        "fr-extract.jsonl": [
            {
                "entry_id": "fd3f4384-464c-3425-9be4-6d1ed2c1ca59",
                "word": "morganatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e93fb5d-925c-48d6-bd9f-297e06c93ba0",
                        "entry_id": "fd3f4384-464c-3425-9be4-6d1ed2c1ca59",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "morganatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa1a4014-1ac4-35a0-b622-9b072f8fad65",
                        "entry_id": "fd3f4384-464c-3425-9be4-6d1ed2c1ca59",
                        "glosses": [
                            "Relatif à l’union d’une personne de rang supérieur avec une personne de rang inférieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e009bfc8-3255-4fd2-83da-0e2ceb2728cc",
                                "sense_id": "fa1a4014-1ac4-35a0-b622-9b072f8fad65",
                                "text": "On veut voir l’idée de construire le Trianon de Marbre en faveur de la morganatique épouse."
                            },
                            {
                                "example_id": "d9e37fdf-a7b6-4ba1-a3a7-a5347fab76d3",
                                "sense_id": "fa1a4014-1ac4-35a0-b622-9b072f8fad65",
                                "text": "On dit dans le même sens une « épouse morganatique »."
                            },
                            {
                                "example_id": "5fc93bdc-d4a6-4068-9925-5bb852e4be86",
                                "sense_id": "fa1a4014-1ac4-35a0-b622-9b072f8fad65",
                                "text": "Il y avait eu une époque dont on se souvenait encore mais dont il était préférable de ne pas parler, où le mariage morganatique du roi Frédéric avait tenu les dames éloignées de la Cour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "978080f5-9724-4543-9ac8-7494072c1d3a",
                        "source_entry_id": "fd3f4384-464c-3425-9be4-6d1ed2c1ca59",
                        "source_sense_id": "fa1a4014-1ac4-35a0-b622-9b072f8fad65",
                        "source_sense_description": "Pour un mariage avec une personne de rang inférieur avec moins de droits pour cette dernière",
                        "target_lang_word": "morganatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morganatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                        "entry_id": "b5ef420b-b2b1-3670-9452-3ba090998268",
                                        "glosses": [
                                            "Designating a marriage (or the wife involved) between a man of higher rank and a woman of lower rank, often having various legal repercussions (typically that such a wife has no claim on the husband's possessions or title). It was not an aspect of English law, but was common in other royal houses, especially in Germany."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c2457fa-c736-4663-b34d-1d39151c0f35",
                                                "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                                "text": "Francis Ferdinand's marriage was a morganatic alliance, and in consequence of a declaration which he made when contracting it, his children do not inherit his rights to the Austrian crown."
                                            },
                                            {
                                                "example_id": "edcbbb98-8561-4af2-83e5-a295ac171abe",
                                                "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                                "text": "we have this day repudiated our former spouse and have bestowed our royal hand upon the princess Selene, the splendour of the night. (The former morganatic spouse of Bloom is hastily removed in the Black Maria.)"
                                            },
                                            {
                                                "example_id": "0a943f6e-53df-4cc3-addd-cdb6bfb7d96b",
                                                "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                                "text": "Because of her noble birth, she bitterly resented her position as a morganatic wife."
                                            },
                                            {
                                                "example_id": "ab9e1790-6602-4c81-9f47-1be688f7d417",
                                                "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                                "text": "Louis's association with the pious widow, Madame de Maintenon (with whom he contracted a morganatic marriage in 1684) had led to a new tone of piety, even prudery, at court."
                                            },
                                            {
                                                "example_id": "c5139b37-08ff-4bc3-a999-5646051ec2ef",
                                                "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                                "text": "This will not be a morganatic marriage—one where titles are not passed to any children—the prince and Mrs Parker Bowles being beyond the usual age of procreation and so unlikely to have new heirs to complicate matters."
                                            },
                                            {
                                                "example_id": "07821d43-46e7-4896-8494-4f9c0c7747c8",
                                                "sense_id": "d80270ad-3a91-3dd9-9b01-3efd3d56c408",
                                                "text": "After her death, he arranged a morganatic marriage with Anna in 1757, which made him even more vulnerable to charges of sexual impropriety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
