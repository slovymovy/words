                ],
                "senses": [
                    {
                        "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                        "entry_id": "49fd0222-93cc-364b-909f-79a7b2f4025e",
                        "glosses": [
                            "Textilien, die für das Bett verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9034edd6-259a-44ba-b6a3-c9794647a816",
                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                "text": "Meine Bettwäsche wird wöchentlich gewechselt."
                            },
                            {
                                "example_id": "90919857-1bca-48db-bdc5-fa2603e33350",
                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                "text": "„Ein Witz von einem Zimmer, in dem ein Einzelbett stand, bezogen mit Bettwäsche, die von einem so irrealen Weiß war, dass sie staunte.“"
                            },
                            {
                                "example_id": "04f598fd-da7a-4174-a384-2cbbbd99036a",
                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                "text": "„Wenig später stand Marie auf, küßte mich im Dunkeln und zog die Bettwäsche ab.“"
                            },
                            {
                                "example_id": "7fea68bf-85eb-4ed0-b762-4ed6339550f5",
                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                "text": "„Als sie weg war, öffnete sie sofort den Kleiderschrank und versteckte das Jäckchen hinter einm Stapel Bettwäsche, wo es keiner sehen konnte.“"
                            },
                            {
                                "example_id": "926ab1ec-7ab1-4220-8316-e9406e591cd6",
                                "sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
                                "text": "„Zierkissen, Bettwäsche und Vorhänge waren mit Wasser vollgesogen, in zwei von Mamas Zeitschriften war die Druckerschwärze ausgelaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
