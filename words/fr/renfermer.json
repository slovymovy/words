                        "renfermer des secrets"
                    ]
                },
                {
                    "sense_id": "7a7ac1ba-7df9-3df7-b088-e45672d67e95",
                    "sense_definition": "S'isoler du monde extérieur ou refuser d'exprimer ses sentiments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis cette dispute, il a tendance à se <w>renfermer</w> dans un mutisme inquiétant."
                        },
                        {
                            "text": "Elle préfère parler de ses problèmes plutôt que de se <w>renfermer</w> sur elle-même."
                        }
                    ],
                    "synonyms": [
                        "s'isoler",
                        "se replier",
                        "se murer"
                    ],
                    "antonyms": [
                        "s'ouvrir"
                    ],
                    "common_phrases": [
                        "se renfermer sur soi",
                        "se renfermer dans le silence",
                        "se renfermer en soi-même"
                    ]
                },
                {
                    "sense_id": "829fca66-f447-33ac-8476-2fb0d0f8b957",
                    "sense_definition": "Mettre de nouveau quelqu'un ou quelque chose dans un lieu fermé ou sous clé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "enfermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa courte tentative d'évasion, les gardiens ont aussitôt <w>renfermé</w> le détenu."
                        },
                        {
                            "text": "Le fermier a <w>renfermé</w> les bêtes dans l'étable avant l'orage."
                        }
                    ],
                    "synonyms": [
