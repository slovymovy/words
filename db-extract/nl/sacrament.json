                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                        "entry_id": "c57f11a9-51af-3c5a-84f9-92247af9d2b0",
                        "glosses": [
                            "ritueel of teken in de christelijke kerk, door Jezus ingesteld, waardoor Gods genade wordt doorgegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "703b82d2-dde4-4064-8e49-9b6a58d40eac",
                                "sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                                "text": "In de Katholieke Kerk zijn er zeven sacramenten: het doopsel, de biecht, de communie, het vormsel, de priesterwijding, het huwelijk en de ziekenzalving."
                            },
                            {
                                "example_id": "1246f5f5-9e86-4854-9caa-7937cc1782bf",
                                "sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                                "text": "\"De Sacramenten zijn werkzame tekenen van de genade, ingesteld door Christus en toevertrouwd aan de Kerk, waardoor ons het goddelijk leven verleend wordt.\" (Catechismus van de Katholieke Kerk, punt 1131)"
                            },
                            {
                                "example_id": "2ac62552-21a1-4425-9845-ab8091e0df61",
                                "sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                                "text": "\"De Sacramenten zijn heilige zichtbare waartekenen en zegelen, van God ingezet, opdat Hij ons door het gebruik daarvan de belofte des Evangelies des te beter te verstaan geve en verzegele;\" (Heidelbergse Catechismus (van de Hervormde Kerk), punt 66)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4067bca0-9086-4ed6-8b51-57b6124b2d5f",
                        "source_entry_id": "c57f11a9-51af-3c5a-84f9-92247af9d2b0",
                        "source_sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                        "source_sense_description": "plechtige gebeurtenis in de katholieke kerk",
                        "target_lang_word": "Sakrament",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakrament",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af24bad3-b17b-398b-bd4d-b4636872a227",
                                        "entry_id": "21acb96d-f9d9-3288-82cb-ff4b7ebe2a81",
                                        "glosses": [
                                            "rituelle Handlung, die die unsichtbare Gnade Gottes wahrnehmbar übermittelt"
                                        ],
                                        "tags": [
                                            "christliche Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c01a66e4-1473-46ce-a4e5-f7e6fe6a0432",
                                                "sense_id": "af24bad3-b17b-398b-bd4d-b4636872a227",
                                                "text": "Er empfing das Sakrament der Taufe."
                                            },
                                            {
                                                "example_id": "a577f4b4-21fb-48db-bafb-1ea10747fbb6",
                                                "sense_id": "af24bad3-b17b-398b-bd4d-b4636872a227",
                                                "text": "„Und die heilige Kommunion empfangen zu dürfen oder das allerhochwürdigste Sakrament des Altars zu geniessen, wie Agrafena Iwanowna mit kindlich-frommer Wortspielfreude sagte, erschien ihr als ein so überirdisches Glück, dass es ihr war, als könne sie diesen seligen und gesegneten Sonntag gar nicht erleben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1d07c184-7803-3c5b-974f-88163951b309",
                                        "entry_id": "21acb96d-f9d9-3288-82cb-ff4b7ebe2a81",
                                        "glosses": [
                                            "Gegenstand, der zur Erteilung eines Sakramentes^([1]) benutzt wird"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe78d44b-0c56-4488-b4d2-4fbc1f8a4911",
                                                "sense_id": "1d07c184-7803-3c5b-974f-88163951b309",
                                                "text": "Der Ministrant trug die Sakramente."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0357488d-7b8c-392d-833a-e8597997c271",
                                        "entry_id": "21acb96d-f9d9-3288-82cb-ff4b7ebe2a81",
                                        "glosses": [
                                            "Fluchwort"
                                        ],
                                        "tags": [
                                            "oberdeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "383667eb-e8db-4a1f-a5c8-fc22aebccea6",
                                                "sense_id": "0357488d-7b8c-392d-833a-e8597997c271",
                                                "text": "Ja, Himmel Herrgott Sakrament nochmal! Kannst du denn nie was richtig machen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8230614c-dd9d-44cd-a41e-408985d9875f",
                        "source_entry_id": "c57f11a9-51af-3c5a-84f9-92247af9d2b0",
                        "source_sense_id": "0e080d58-413e-35b6-a2c3-1b2de0149ae7",
                        "source_sense_description": "plechtige gebeurtenis in de katholieke kerk",
                        "target_lang_word": "sacrament",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacrament",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90fab236-98ae-30ba-8109-b23d4cd6af06",
                                        "entry_id": "3a0ea4dd-ff2b-3db8-96bf-605a704eaa8d",
                                        "glosses": [
                                            "A sacred act and the attendant ceremony, considered (theology) an outward sign of divine grace, instituted by Jesus Christ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461f4892-eafb-4989-b1e1-e09dd0e706a4",
                                                "sense_id": "90fab236-98ae-30ba-8109-b23d4cd6af06",
                                                "text": "Priest: I'm sorry, it's Duncan Dirk Dick. I've just done it. / Father: Well, undo it. / Priest: Undo it? / Father: Yes. / Priest: This is a holy sacrament of the Church, not a bleeding hotel reservation. You can't just undo it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "209968a7-78c4-3130-870e-0a2d468f3ede",
                                        "entry_id": "3a0ea4dd-ff2b-3db8-96bf-605a704eaa8d",
                                        "glosses": [
                                            "The Eucharist."
                                        ],
                                        "tags": [
                                            "in particular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53a69dbe-69ca-3bb2-bd00-ef40b71a668d",
                                        "entry_id": "3a0ea4dd-ff2b-3db8-96bf-605a704eaa8d",
                                        "glosses": [
                                            "The consecrated Eucharist (especially the bread)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fa2670a-b024-3ea0-83e0-aaad844d7b64",
                                        "entry_id": "3a0ea4dd-ff2b-3db8-96bf-605a704eaa8d",
                                        "glosses": [
                                            "Anything regarded as possessing a sacred character or mysterious significance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41698d4e-6e37-4dd3-8d39-9d2df0010939",
                                                "sense_id": "3fa2670a-b024-3ea0-83e0-aaad844d7b64",
                                                "text": "God ſometimes ſent a light of fire, and pillar of a cloud, and the brightneſſe of an Angel, and the luſtre of a ſtar, and the ſacrament of a rainbovve to guide his people thorovv their portion of ſorrovvs, and to lead them through troubles to reſt: […]"
                                            },
                                            {
                                                "example_id": "3f8ab232-ccae-4fba-8220-37d3c1d0e157",
                                                "sense_id": "3fa2670a-b024-3ea0-83e0-aaad844d7b64",
                                                "text": "The dots are easy to connect, because they’re so close together, and because they’re the entry and exit wounds inflicted on US society by the subculture whose sacrament is the gun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a29028-7ceb-39b8-8175-556cf6ff5317",
                                        "entry_id": "3a0ea4dd-ff2b-3db8-96bf-605a704eaa8d",
                                        "glosses": [
                                            "The oath of allegiance taken by soldiers in Ancient Rome; hence, any sacred ceremony used to impress an obligation; a solemn oath-taking; an oath."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68f129c-76f9-42c6-9867-42ef6a81f799",
                                                "sense_id": "77a29028-7ceb-39b8-8175-556cf6ff5317",
                                                "text": "I'll take the sacrament on 't."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacrament",
                                "target_lang_code": "en",
