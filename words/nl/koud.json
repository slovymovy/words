                    "semantic_group_id": "idiomatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kwam van een <w>koude</w> kermis thuis toen hij de slechte uitslag zag.",
                            "target_lang_translations": {
