                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0c8806-a243-4e11-a603-f5f69357fbda",
                                "sense_id": "c73df73f-fa55-3cd8-8679-e6e1bfbcda0b",
                                "text": "„Schokoladengenuss ohne schlechtes Gewissen: Wer beim Einkauf von Kakao-Produkten auf fair produzierte Ware achtet, kann helfen, die Lebensverhältnisse von Kakao-Bauern zu verbessern.“"
                            },
                            {
                                "example_id": "c6f4da17-92a3-41c2-9f00-8090156ec30c",
                                "sense_id": "c73df73f-fa55-3cd8-8679-e6e1bfbcda0b",
                                "text": "„Die neueste Kreation aus dem Hause Naturata sorgt mit ihrem hohen Kakaoanteil von 90 Prozent für einen ganz besonderen Schokoladengenuss.“"
                            },
                            {
                                "example_id": "a751d763-73c0-47cc-99ec-763b327754fb",
                                "sense_id": "c73df73f-fa55-3cd8-8679-e6e1bfbcda0b",
                                "text": "„Schokoladengenuss wird meist dann zum Problem, wenn der Hund heimlich und unkontrolliert herumliegende Schokolade nascht.“"
                            },
                            {
                                "example_id": "e0ee7cfc-b5d9-4ec9-a275-4c708525b9bd",
                                "sense_id": "c73df73f-fa55-3cd8-8679-e6e1bfbcda0b",
                                "text": "„Allerdings hat das individuelle Angebot auch seinen Preis: Mindestens vier bis auch schon mal zehn Euro zahlt der Kunde für den eigens zusammengestellten Schokoladengenuss.“"
                            }
                        ],
