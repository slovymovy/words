                        "entry_id": "c7d986b0-7194-3eb6-8393-3cda5d78b0a5",
                        "glosses": [
                            "Betrachtung der Luftröhren in der Lunge (Bronchien) mit einem dazu entwickelten Gerät, dem Bronchoskop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eea181b9-1484-4f67-b954-a1dcf1b835b3",
                                "sense_id": "2cf0a287-a66d-3032-b3b5-38dd70695d33",
                                "text": "Eine starre Bronchoskopie wird nur unter Vollnarkose durchgeführt."
                            },
                            {
                                "example_id": "dd2b3455-ef62-4683-98de-d6603806f55e",
                                "sense_id": "2cf0a287-a66d-3032-b3b5-38dd70695d33",
                                "text": "„Die flexible fiberoptische Bronchoskopie ist im Konsens mit anderen Verfahren als bettseitige intensivmedizinische Arbeitsmethode fachübergreifend etabliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
