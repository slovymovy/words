                ],
                "senses": [
                    {
                        "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                        "entry_id": "af32aca9-31d5-3993-b7ed-acb3f1d80640",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88442119-d3dc-488c-8387-345093dc48e6",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Frau Völler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "225de913-535b-4232-b7c2-67fc39a5d9bc",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Herr Völler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ccaf696d-8f64-4251-9679-1ecee483d8b6",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Die Völlers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a10a81e1-6d49-41ca-95bd-3f7178b8c59f",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Der Völler trägt nie die Schals, die die Völler ihm strickt."
                            },
                            {
                                "example_id": "8d8435f2-688d-4725-808e-1b041e76a590",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Völler kommt, geht der Herr Völler.“"
                            },
                            {
                                "example_id": "46bf7890-9421-4f54-8da3-73be602a462f",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Völler kommt und geht."
                            },
                            {
                                "example_id": "4d3d7130-fb6f-4ae8-b8da-bc0722ea160a",
                                "sense_id": "9f62ec98-1e02-3cfb-b826-ce10d8ef97b3",
                                "text": "Völlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
