                    },
                    {
                        "translation_id": "67cb85c1-06d8-4b09-82c0-ae54a05810ff",
                        "source_entry_id": "b5be47c6-fcf8-3cc4-afdf-617e7c002aef",
                        "source_sense_id": "d9efa1cd-1954-3b82-b531-98836c833296",
                        "target_lang_word": "saindoux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saindoux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffbd9170-676e-3e47-b769-809b2eb2db74",
                                        "entry_id": "a915c9cc-09a0-301d-949f-37de47f2115e",
                                        "glosses": [
                                            "Graisse de porc fondue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463a35a7-b65d-45ef-9c98-53e4db83132f",
                                                "sense_id": "ffbd9170-676e-3e47-b769-809b2eb2db74",
                                                "text": "Ma foi, puisque je me suis dérangée, dit la Sarriette, donnez-moi une livre de saindoux… Moi, j’adore les pommes de terre frites."
                                            },
                                            {
                                                "example_id": "a9b5ff6b-2365-40fa-be48-8b585257b38f",
                                                "sense_id": "ffbd9170-676e-3e47-b769-809b2eb2db74",
                                                "text": "Pour compléter le triste tableau de notre séjour à Lourdes, nous constations que la basilique, en saindoux évidemment, achetée le matin même chez le charcutier, avait fondu sous l’effet du soleil, et imbibé de graisse le renard et le chapeau de ma mère qui se trouvaient dessous."
                                            },
                                            {
                                                "example_id": "0522c52d-98a1-41ec-959f-56d3190d43d9",
                                                "sense_id": "ffbd9170-676e-3e47-b769-809b2eb2db74",
                                                "text": "Les « chons » permettent de faire de bonnes quiches et les pots de saindoux de conserver des saucisses, des morceaux de volailles pour tout l’été."
                                            },
                                            {
                                                "example_id": "fb189d68-7e80-4a77-b91c-4a62f418c72d",
                                                "sense_id": "ffbd9170-676e-3e47-b769-809b2eb2db74",
                                                "text": "Laissez refroidir doucement en compressant, puis ajoutez quelques cuillerées de saindoux de façon que le couvercle baigne et que le saindoux lute votre terrine."
                                            },
                                            {
                                                "example_id": "75f93a7a-3c47-4801-9b57-d8891c26b602",
                                                "sense_id": "ffbd9170-676e-3e47-b769-809b2eb2db74",
                                                "text": "Elle déjeuna à peine, juste une tartine de saindoux avec une tasse de café au lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
