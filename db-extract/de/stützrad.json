                ],
                "senses": [
                    {
                        "sense_id": "f0474ba5-6127-34bd-b321-3fb9d93e7fad",
                        "entry_id": "24468bcf-c9ba-37d4-9078-9528098a32cf",
                        "glosses": [
                            "(kleineres) Rad, das zur Abstützung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b61c9ab-8764-4d5c-aaad-3007a7c207d6",
                                "sense_id": "f0474ba5-6127-34bd-b321-3fb9d93e7fad",
                                "text": "„Er kurbelte das Stützrad herunter, löste die Stromversorgung und das Sicherungsseil.“"
                            },
                            {
                                "example_id": "dd81d8d2-0dfc-4eae-9d08-14915a17869c",
                                "sense_id": "f0474ba5-6127-34bd-b321-3fb9d93e7fad",
                                "text": "„Nach dem Essen holte Larsson aus dem Benz ein Paket mit Schraubenschlüsseln, löste zuerst das rechte Stützrad des Kinderfahrrades, dann das linke.“"
                            },
                            {
                                "example_id": "4fd3e4ac-6110-402a-8af1-276f7ca44622",
                                "sense_id": "f0474ba5-6127-34bd-b321-3fb9d93e7fad",
                                "text": "„Das Stützrad setzte auf, löste sich von der Felge, rollte gemächlich den Abhang Richtung Rhein hinunter.“"
                            },
                            {
                                "example_id": "db072db7-e5b0-4e1b-8cf9-5ce47a39da7d",
                                "sense_id": "f0474ba5-6127-34bd-b321-3fb9d93e7fad",
                                "text": "„Zuletzt noch das Stützrad hochkurbeln, bis es ganz eingeklappt ist und die Reise kann losgehen.“"
                            },
                            {
                                "example_id": "6cc326f6-64f0-47c1-a24f-12732372df51",
                                "sense_id": "f0474ba5-6127-34bd-b321-3fb9d93e7fad",
                                "text": "„Es war jetzt daran einen Laden für Wohnwagenzubehör aufzutreiben, um ein neues Stützrad zu erwerben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
