                            }
                        },
                        {
                            "text": "The manager's <w>supercilious</w> attitude toward his employees caused many of them to quit.",
                            "target_lang_translations": {
                                "ru": "<w>Надменное</w> отношение менеджера к сотрудникам привело к тому, что многие из них уволились."
                            }
