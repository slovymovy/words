                ],
                "senses": [
                    {
                        "sense_id": "b2775325-ac35-3f54-a533-0db1faa6ce19",
                        "entry_id": "b99942dd-cc79-334a-8e44-bcc3a7d6f5fd",
                        "glosses": [
                            "безмоторный летательный аппарат, зависящий от восходящих потоков воздуха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0998fff2-e381-4062-9685-555d93b650ec",
                                "sense_id": "b2775325-ac35-3f54-a533-0db1faa6ce19",
                                "text": "Планёры могут находиться в воздухе практически неограниченное время, используя для этого восходящие воздушные потоки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ac95af3-645c-4808-a074-d743c8e43b78",
                        "source_entry_id": "b99942dd-cc79-334a-8e44-bcc3a7d6f5fd",
                        "source_sense_id": "b2775325-ac35-3f54-a533-0db1faa6ce19",
                        "target_lang_word": "glider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eefc54bd-6f0c-3a46-801a-ac8b34e62034",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "One who glides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "439b0a40-97bc-3d9f-9a0c-069a760e68c5",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "Any heavier-than-air aircraft optimised for unpowered flight; a sailplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40a0e6e2-71c6-36d4-825a-25af8d31ad64",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "A pilot of glider aircraft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20bef77a-51a9-3a59-94ac-f62b32b6e47e",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "Any animal with the ability to glide, such as the marsupial gliding possums of Australia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4e0e3ae-aab5-3b1f-8d17-89ddc945d320",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "Synonym of glide (“cap affixed to base of legs of furniture”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c2bff8-fbe3-4dd9-862e-ea82e4127f95",
                                                "sense_id": "e4e0e3ae-aab5-3b1f-8d17-89ddc945d320",
                                                "text": "The left drawer runner is probably replaced. Nail holes on the upper surface of the stretchers suggest the piece once had a bottom shelf. Modern metal gliders have been added under the feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a33a4f7-12f7-38b6-bef5-a23e0af4926c",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "A kind of garden swing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a68b58a-e331-45c6-84b1-4a5c5fb2e011",
                                                "sense_id": "8a33a4f7-12f7-38b6-bef5-a23e0af4926c",
                                                "text": "Francine sat in the glider on the porch, swinging lightly, her mind a thousand miles away. The chain squeaked a little, almost like a cricket."
                                            },
                                            {
                                                "example_id": "18235e52-be88-4be5-80fb-65fd2cf64372",
                                                "sense_id": "8a33a4f7-12f7-38b6-bef5-a23e0af4926c",
                                                "text": "Then I went into the backyard, which had a flower-covered arbor, a small garden wall, and room behind it for a garden. Swings and gliders adorned the yard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5962b5c1-dad4-3bdc-baa1-10afbc56398a",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "In the Game of Life, a particular configuration of five cells that recurs periodically at fixed offsets and appears to \\\"walk\\\" across the grid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb2f9e3-784b-44cd-a1a6-577bba1a1fb8",
                                                "sense_id": "5962b5c1-dad4-3bdc-baa1-10afbc56398a",
                                                "text": "By the way, what happens to a beehive which is under attack by one or two gliders such as pictured:"
                                            },
                                            {
                                                "example_id": "d6210de6-a2a2-4e09-b4b7-e7c380c662ba",
                                                "sense_id": "5962b5c1-dad4-3bdc-baa1-10afbc56398a",
                                                "text": "I believe it is indeed new -- I've gone back through everything I can find, as far back as the early 90's when Heisenburp devices were first invented, and there don't seem to be any reactions based on a glider suppressing a blinker."
                                            },
                                            {
                                                "example_id": "0eeb5fad-e890-4965-a1db-4ba3206f098b",
                                                "sense_id": "5962b5c1-dad4-3bdc-baa1-10afbc56398a",
                                                "text": "In Conway's Life interesting effects can be obtained by colliding gliders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e214ea-f72a-396b-98b3-b985d0716b98",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "In the Game of Life, a particular configuration of five cells that recurs periodically at fixed offsets and appears to \\\"walk\\\" across the grid.",
                                            "Any spaceship in a cellular automaton, especially one which exhibits glide reflection."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f97e43-800b-45bd-badd-9d36fc0ec56b",
                                                "sense_id": "44e214ea-f72a-396b-98b3-b985d0716b98",
                                                "text": "It is a reversible rule, and an interesting one. Shortly after I implemented it, Chris and I were watching it run from a small random configuration of vants, when we noticed a structure consisting of 2 vants propagating away from the others -- it is a glider of sorts, consisting of 2 cooperating vants moving along, erasing each others' trail."
                                            },
                                            {
                                                "example_id": "9a8024d9-8eb1-4354-b917-a6b2f8b5d881",
                                                "sense_id": "44e214ea-f72a-396b-98b3-b985d0716b98",
                                                "text": "I wanted to test some totalistic automaton and the glider with the B024S1 rule, which Ilmari Karonen described."
                                            },
                                            {
                                                "example_id": "1e6041e9-94b5-4b56-8286-a1ad92aae24a",
                                                "sense_id": "44e214ea-f72a-396b-98b3-b985d0716b98",
                                                "text": "By contrast, consider a rule like Seeds (B2/S) that has \"gliders\" and oscillators and so forth, so theoretically it might support universal computation somehow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4ff726-8f65-3001-9c40-349527f44c0e",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "A vehicle, of a usually motorised type, without a powertrain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e756e1be-0b15-38f4-9127-e8988e160ed1",
                                        "entry_id": "6ca5a732-1e24-379e-b6b6-19eaf9e65075",
                                        "glosses": [
                                            "Any of various species of dragonfly that glide on out-held wings while flying, such as the common glider, Tramea loewii, of Australia, New Guinea, Indonesia, and the Pacific."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d791a30a-d170-44e8-865b-c0750820edd8",
                        "source_entry_id": "b99942dd-cc79-334a-8e44-bcc3a7d6f5fd",
                        "source_sense_id": "b2775325-ac35-3f54-a533-0db1faa6ce19",
                        "target_lang_word": "Segelflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segelflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                        "entry_id": "bbddc179-ac28-3de6-8bbd-0354c9a3a0a4",
                                        "glosses": [
                                            "ein für den Segelflug konstruiertes Luftfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e87749-b936-4ea9-aa0f-768ee2805bf1",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Der erfahrene Pilot besteigt sein Segelflugzeug mit nicht mehr Angst als der Autofahrer sein Auto.“"
                                            },
                                            {
                                                "example_id": "2e3c22fc-b291-4f92-b997-3fcfd6336684",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Die Erlaubnis für Außenlandungen von Motorseglern und Segelflugzeugen, die sich auf einem Überlandflug befinden, gilt als erteilt.“"
                                            },
                                            {
                                                "example_id": "203a9dcc-37b8-406a-a819-6b372da1e15a",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "Ein Segelflugzeug hat keinen eigenen Motor, aber sehr lange Tragflächen."
                                            },
                                            {
                                                "example_id": "afa443ee-21bd-4afd-b6b4-a798a93f058f",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "Bereits nach dem ersten Weltkrieg entstanden die ersten Akaflieg-Gruppen; mit Segelflugzeugen konnten Flieger das Versailler Flugverbot umgehen."
                                            },
                                            {
                                                "example_id": "bc106b42-ab59-4bee-ab36-c3243cd93c10",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Papa bastelte im Keller ein großes Segelflugzeug aus Holz.“"
                                            },
                                            {
                                                "example_id": "0d9a9b95-a66d-47be-ac81-49e4bd6acb84",
                                                "sense_id": "559d4c86-d63d-3adb-bb19-d2c059f903ae",
                                                "text": "„Die besten Hängegleiter erzielen heute Flugleistungen, die an die früher Segelflugzeuge anknüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43301949-3471-4fef-af97-f38988e36560",
                        "source_entry_id": "b99942dd-cc79-334a-8e44-bcc3a7d6f5fd",
                        "source_sense_id": "b2775325-ac35-3f54-a533-0db1faa6ce19",
                        "target_lang_word": "Segelflieger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segelflieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "412951dd-434a-3875-814f-c98ba0beaaa7",
                                        "entry_id": "32144d00-6558-362c-954a-8b5933089df3",
                                        "glosses": [
                                            "Person, die das Fliegen mit Segelflugzeugen betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd217b22-e134-425b-b490-157b47039996",
                                                "sense_id": "412951dd-434a-3875-814f-c98ba0beaaa7",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
                                            },
                                            {
                                                "example_id": "3930a178-d64c-44a7-9624-145b34bd49d6",
                                                "sense_id": "412951dd-434a-3875-814f-c98ba0beaaa7",
                                                "text": "„Sechs deutsche Segelflieger, unter ihnen Hanna Reitsch, überqueren von Salzburg aus die Alpen und landen bei Udine.“"
                                            },
                                            {
                                                "example_id": "a45eb97d-e48d-4c9c-84c9-96f82e17e13e",
                                                "sense_id": "412951dd-434a-3875-814f-c98ba0beaaa7",
                                                "text": "„Bei mehreren Flügen in den Höhenwinden (Lee-Wellen) über den argentinischen Anden gelang es einer Gruppe von Segelfliegern, mit der Stemme S10VT mehrfach die magische 1 000-Kilometer-Marke zu überwinden.“"
                                            },
                                            {
                                                "example_id": "4281a55c-e017-4b4b-a88f-e540ec4c6c6b",
                                                "sense_id": "412951dd-434a-3875-814f-c98ba0beaaa7",
                                                "text": "„Die Ergebnisse wurden als Empfehlungen an den DAeC weitergeleitet, denn beschließen können die Segelflieger nichts, weil sie bislang – ebenso wie die Motorflieger, Modellflieger, Ballonfahrer und Fallschirmsportler – keine selbständige Sparte innerhalb des DAeC bilden, der den gesamten Luftsport beim Internationalen Luftfahrt-Verband (FAI) vertritt.“"
                                            },
                                            {
                                                "example_id": "d46ccb5c-1264-42b0-818f-9312a8cc1919",
                                                "sense_id": "412951dd-434a-3875-814f-c98ba0beaaa7",
                                                "text": "Der Segelflieger konnte sein Flugzeug ohne Probleme landen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf580fb9-571a-333f-a8e1-802a64ef7137",
                                        "entry_id": "32144d00-6558-362c-954a-8b5933089df3",
                                        "glosses": [
                                            "für den Segelflug konstruiertes Luftfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da6fb00c-e022-4686-92a2-71efca26c878",
                        "source_entry_id": "b99942dd-cc79-334a-8e44-bcc3a7d6f5fd",
                        "source_sense_id": "b2775325-ac35-3f54-a533-0db1faa6ce19",
                        "target_lang_word": "Segler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4512d1ce-a6d4-36c5-bfe5-d0da7ada6a80",
                                        "entry_id": "be81ec35-2d08-3aa3-a7af-962eb61f5392",
                                        "glosses": [
                                            "jemand, der segelt (als Sport)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c531d078-5ad3-468a-9af9-9c9299f489d1",
                                                "sense_id": "4512d1ce-a6d4-36c5-bfe5-d0da7ada6a80",
                                                "text": "Mein Mann ist begeisterter Segler."
                                            },
                                            {
                                                "example_id": "0d397b18-8d0e-43bc-b91c-e94d1f43288e",
                                                "sense_id": "4512d1ce-a6d4-36c5-bfe5-d0da7ada6a80",
                                                "text": "Bei schönem Wetter sind oft Segler unterwegs."
                                            },
                                            {
                                                "example_id": "d40fe65a-9214-41f0-959b-c24702a8dd6e",
                                                "sense_id": "4512d1ce-a6d4-36c5-bfe5-d0da7ada6a80",
                                                "text": "„Der Wind frischte im Lauf des Nachmittags so sehr auf, daß der Segler niedergerefft und mit nachgelassenen Bramstengen hätte fahren müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c98ef8d-1244-36b7-8563-c48aa9cc6f3e",
                                        "entry_id": "be81ec35-2d08-3aa3-a7af-962eb61f5392",
                                        "glosses": [
                                            "Segelschiff oder -boot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7edef12c-9546-4646-b3a6-7e0247036f7d",
                                                "sense_id": "0c98ef8d-1244-36b7-8563-c48aa9cc6f3e",
                                                "text": "Bei schönem Wetter sind oft Segler unterwegs."
                                            },
                                            {
                                                "example_id": "82698030-4735-4502-b06c-9254e5a4d4d0",
                                                "sense_id": "0c98ef8d-1244-36b7-8563-c48aa9cc6f3e",
                                                "text": "Er ist auf einem Segler gefahren."
                                            },
                                            {
                                                "example_id": "c3a8f671-b35d-49b2-808e-3c5c7b571a65",
                                                "sense_id": "0c98ef8d-1244-36b7-8563-c48aa9cc6f3e",
                                                "text": "„Auf vielen Routen hatten Dampfer längst ihren Siegeszug angetreten und den Seglern die profitableren Ladungen abgejagt.“"
                                            },
                                            {
                                                "example_id": "4199ad77-187a-48b1-88f7-76b49e463f18",
                                                "sense_id": "0c98ef8d-1244-36b7-8563-c48aa9cc6f3e",
                                                "text": "„1000 Jahre lang wird es keiner anderen europäischen Kultur gelingen, Segler zu konstruieren, die schneller unterwegs sind als die Kriegsschiffe der Wikinger, die Drachenboote.“"
                                            },
                                            {
                                                "example_id": "2ddf8501-17e9-4b7d-bb93-4f7311095a5d",
                                                "sense_id": "0c98ef8d-1244-36b7-8563-c48aa9cc6f3e",
                                                "text": "„Wir hatten ein Vollschiff, eine Brigg und zwölf Schoner, insgesamt vierzehn Segler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "557bc5a4-c6c9-3385-89f7-5ac400361790",
                                        "entry_id": "be81ec35-2d08-3aa3-a7af-962eb61f5392",
                                        "glosses": [
                                            "Vogel, der die meiste Zeit in der Luft verbringt, (Familie Apodidae), dessen Aussehen und Lebensweise der Schwalbe ähneln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c0ea94-7325-4884-89b9-f8b19f7e791a",
                                                "sense_id": "557bc5a4-c6c9-3385-89f7-5ac400361790",
                                                "text": "In der Schweiz brüten zwei Arten von Seglern."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c57e7f50-40fd-39f2-8938-4a25a0c613fd",
                                        "entry_id": "be81ec35-2d08-3aa3-a7af-962eb61f5392",
                                        "glosses": [
                                            "Flugzeug, welches sich mittels Nutzung der Thermik fortbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41fbf641-882c-477a-82bb-21eb233b3825",
                                                "sense_id": "c57e7f50-40fd-39f2-8938-4a25a0c613fd",
                                                "text": "Bei schönem Wetter sind oft Segler unterwegs."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
