                ],
                "senses": [
                    {
                        "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                        "entry_id": "23a89612-5687-3525-b322-1904d18506eb",
                        "glosses": [
                            "женск. к поэт; женщина-поэт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf26da6c-5624-41d4-841d-a1f210f27590",
                                "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                "text": "Но раз мы услышали, что в Москве застрелилась молодая скромная поэтесса, тихая девушка, и что это самоубийство связано с Брюсовым."
                            },
                            {
                                "example_id": "0807291b-8e18-4b28-bba7-b9964fb2a350",
                                "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                "text": "― Но, правда, эти стихи навеяны мне стихами одной молодой поэтессы."
                            },
                            {
                                "example_id": "e66c445a-677b-4342-a863-557e7e7200c3",
                                "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                "text": "Она поэтесса, и почти в каждом номере стенной газеты есть ее стихи."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62b1bf7e-5f3a-41cd-ad70-eec3a34f1bbf",
                        "source_entry_id": "23a89612-5687-3525-b322-1904d18506eb",
                        "source_sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                        "target_lang_word": "poetess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poetess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e422451-a969-3551-bcd6-4c42d6e6d8f4",
                                        "entry_id": "96aef620-2442-31d5-a6ac-b732d632765d",
                                        "glosses": [
                                            "A female poet."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45af8362-f571-4912-bdfc-7569619cd154",
                                                "sense_id": "3e422451-a969-3551-bcd6-4c42d6e6d8f4",
                                                "text": "The ancient poetess singeth, that Hesperus all things bringeth, / Smoothing the wearied mind: bring me my love, Rosalind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
