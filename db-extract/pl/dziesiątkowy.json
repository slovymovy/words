                                    {
                                        "sense_id": "0b733cc2-59dc-3b0f-88aa-644343d9e28b",
                                        "entry_id": "c938a137-0eab-3d2b-b6c8-400419eee3e3",
                                        "glosses": [
                                            "A number expressed in the base-ten system, (particularly) a fractional numeral written in this system."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de397d39-7d84-45ed-a6e5-4f8dc585d40a",
                                                "sense_id": "0b733cc2-59dc-3b0f-88aa-644343d9e28b",
                                                "text": "What is ⁷⁄₂₃ as a decimal?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cba9725-c790-3a3f-a108-fe984ae42799",
