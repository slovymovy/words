                    "frequency": "Middle",
                    "semantic_group_id": "sensations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent du soir apportait le parfum <w>suave</w> des fleurs d'oranger du jardin."
                        },
                        {
                            "text": "Sa voix <w>suave</w> et rassurante a immédiatement calmé l'enfant qui pleurait."
                        }
                    ],
                    "synonyms": [
                        "délicat",
                        "doux",
