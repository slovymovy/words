                                    },
                                    {
                                        "sense_id": "948e03c0-ba98-35bb-a512-acff07ae57a2",
                                        "entry_id": "527768b2-5d90-3936-82d7-f85d1a89d248",
                                        "glosses": [
                                            "Surly; churlish; gruff; rough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a715467-4bfe-436f-ab58-95eef1f3ef6e",
                                                "sense_id": "948e03c0-ba98-35bb-a512-acff07ae57a2",
                                                "text": "[…] he had a bluff, rough-and-ready face, all roughened and reddened and lined in his long travels."
