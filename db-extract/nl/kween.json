                        "sense_id": "e13340dc-5a02-3d53-8cba-108b9dc732ef",
                        "entry_id": "97fbde95-067a-37eb-bffc-ea3d2d4bbe23",
                        "glosses": [
                            "onvruchtbaar dier dat geslachtskenmerken van beide geslachten bezit, zoals dat kan voorkomen bij runderen, varkens, schapen en geiten"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "3ecacacb-ce8d-4c46-85ad-19f82589f2c5",
                                "sense_id": "e13340dc-5a02-3d53-8cba-108b9dc732ef",
                                "text": ",,Ik groeide op in een boerendorp. Dieren die kenmerken vertoonden van beide geslachten en onvruchtbaar waren, werden kweentjes genoemd. En die gingen per direct naar de slacht, waren toch waardeloos. Ik was ook een kweentje en dus niet goed genoeg”, bedacht Geert al op jonge leeftijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "9649e1a1-3e8a-3ff7-a718-5b4a4595a78b",
                        "entry_id": "97fbde95-067a-37eb-bffc-ea3d2d4bbe23",
                        "glosses": [
                            "oude, truttige vrouw"
                        ],
                        "tags": [
                            "obsolete",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4c4d12f1-6563-4774-962e-0db62d617fe7",
                                "sense_id": "9649e1a1-3e8a-3ff7-a718-5b4a4595a78b",
                                "text": "Die tijt, die breect dit ende tgene,\nHadde so versoft dese oude quene,\nDat si en wiste wat si dede:"
                            }
                        ]
                    }
