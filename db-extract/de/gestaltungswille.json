                ],
                "senses": [
                    {
                        "sense_id": "1478adc7-a5ab-3b59-adb1-89adfe88f9bd",
                        "entry_id": "0e171f3f-82b7-3da1-b5ed-54880089b608",
                        "glosses": [
                            "Wille, etwas zu gestalten, zu formen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4b3734-204a-46fd-ad26-ee2a01c9bf64",
                                "sense_id": "1478adc7-a5ab-3b59-adb1-89adfe88f9bd",
                                "text": "„Der staatliche Gestaltungswille manifestierte sich hier in der Gesetzgebung in genereller Weise.“"
                            },
                            {
                                "example_id": "c51c8ce7-4716-471a-9308-8a8bfcf9a356",
                                "sense_id": "1478adc7-a5ab-3b59-adb1-89adfe88f9bd",
                                "text": "„Ein solcher Gestaltungswille artikuliert sich vor allem in den künstlerischen Bereichen, der bildenden Kunst, der Musik und Literatur.“"
                            },
                            {
                                "example_id": "2d2d4049-025c-4e64-bf09-c4ba19719764",
                                "sense_id": "1478adc7-a5ab-3b59-adb1-89adfe88f9bd",
                                "text": "„Durch den Gestaltungswillen und die damit einhergehenden Produktionsschritte wird ein inszeniertes Bild von einer einzelnen Person oder gemeinschaftlich als Gruppe realisiert.“"
                            },
                            {
                                "example_id": "cc697564-c765-4c00-9389-fe16b0651d54",
                                "sense_id": "1478adc7-a5ab-3b59-adb1-89adfe88f9bd",
                                "text": "„Der Gestaltungswille zeigt sich einerseits in der Nutzbarmachung und Weiterentwicklung der bereits vorgefundenen Materialien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
