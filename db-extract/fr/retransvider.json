                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9463d0-b92b-4847-83d5-6b27541751f2",
                                "sense_id": "33c4930a-09ef-3f62-9407-b51a67c271bb",
                                "text": "Après cela, il faut mettre ta bière au frais 2 ou 3 jours pour que les levures s'agglomèrent dans le fond et retransvider une fois avant la mise en bouteille."
                            },
                            {
                                "example_id": "3b09b3dd-a43b-44e6-b5d3-484e9636b60d",
                                "sense_id": "33c4930a-09ef-3f62-9407-b51a67c271bb",
                                "text": "Je dois donc le retransvider dans la bouteille et espérer qu'il sera encore bon à 18h ?"
                            },
                            {
                                "example_id": "66ec2d8d-ce21-4b0f-adab-6ef71b344faa",
                                "sense_id": "33c4930a-09ef-3f62-9407-b51a67c271bb",
                                "text": "L'avantage est que lorsque l'on décongèle les pots, aucune manipulation n'est nécesaire pour retransvider le lait : il suffit simplement d'ajouter l'adaptateur et la tétine Avent !"
                            }
                        ]
                    }
