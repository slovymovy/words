            },
            {
                "entry_id": "7588aaa8-26f4-3edd-9cac-8471305c29c1",
                "word": "couchée",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48afce1a-9533-3810-a6ec-63a047480113",
                        "entry_id": "7588aaa8-26f4-3edd-9cac-8471305c29c1",
                        "glosses": [
                            "Participe passé féminin singulier de coucher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6f8493b3-cdf4-4df6-aca3-8dc3b278c876",
                                "sense_id": "48afce1a-9533-3810-a6ec-63a047480113",
                                "text": "On se sentait là visé par quelqu’un qu’on ne voyait point, et l’on comprenait que toute la longueur de la rue était couchée en joue."
                            },
                            {
                                "example_id": "9ab74726-736a-4e1f-87ca-e1f2cb7c4260",
                                "sense_id": "48afce1a-9533-3810-a6ec-63a047480113",
                                "text": "À gauche, les îles Sainte-Marguerite et Saint-Honorat, couchées dans l’eau, montrent leur dos couvert de sapins."
                            },
                            {
                                "example_id": "0ad104a8-b901-42be-b157-d4d6d8385145",
                                "sense_id": "48afce1a-9533-3810-a6ec-63a047480113",
                                "text": "Au bout de quelques pas, à un second détour de la route, je rencontre un autre oiseau. Cette fois, c’est un faucon mort, ou plutôt raidi par le froid, une bête aux yeux vitreux, couchée dans la neige."
                            }
                        ]
                    }
                ],
