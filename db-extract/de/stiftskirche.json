                ],
                "senses": [
                    {
                        "sense_id": "44052ce6-ccc9-3c2d-b791-97058f939444",
                        "entry_id": "5cbc4320-321c-3533-9305-5bb4aa190780",
                        "glosses": [
                            "die zu einem Stift (2) gehörende Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef96d6c-075c-434f-80cd-534875245bcd",
                                "sense_id": "44052ce6-ccc9-3c2d-b791-97058f939444",
                                "text": "Die Stiftskirche Sankt Peter und Paul auf der Insel Reichenau gefällt mir außerordentlich gut."
                            },
                            {
                                "example_id": "990caaeb-649d-40fd-845d-ec512232d0dc",
                                "sense_id": "44052ce6-ccc9-3c2d-b791-97058f939444",
                                "text": "„Doch nachdem Erzbischof Balduin die Kirche 1315 sanierte und zunächst einen Misserfolg mit der Erneuerung als Stiftskirche erlebte, erlebte sie nach 1331 mit den Kartäusermönchen über vierhundert Jahre ihre Blütezeit.“"
                            },
                            {
                                "example_id": "de214e46-ecc3-4a47-8a78-9aec2c59958e",
                                "sense_id": "44052ce6-ccc9-3c2d-b791-97058f939444",
                                "text": "„Martin Luther lag erst ein gutes Jahr in der Wittenberger Stiftskirche (heute Schlosskirche) im Sarg, als im Frühling 1547 von den Türmen der Stadtkirche, in der er so oft gepredigt hatte, die steinernen Aufbauten entfernt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
