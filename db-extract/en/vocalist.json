                    {
                        "translation_id": "d804b65e-125d-4a1b-b7d4-9950e2c01bed",
                        "source_entry_id": "92c9e5a2-bcfe-30e6-b484-3d93f6d44149",
                        "source_sense_id": "ff1ced49-eb1a-30c0-9975-4448523799f8",
                        "source_sense_description": "singer",
                        "target_lang_word": "Sänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                        "entry_id": "681c4869-1d0e-3efd-82cd-f91a6f12c897",
                                        "glosses": [
                                            "jemand, der singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85ff160-b948-47ce-9c51-080ca90014aa",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "Wer war nochmal der Sänger von diesem Lied?"
                                            },
                                            {
                                                "example_id": "540e7a85-7672-4227-ac99-d011955a010f",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "Es gibt nicht so viele Rapper, Sänger und Bands, die positive Werte vertreten."
                                            },
                                            {
                                                "example_id": "e21f7da2-6e1f-47fe-badb-7dd999d0b99a",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "„Herausforderung für die Sänger […] Zurzeit hat der Kammerchor 35 Sängerinnen und Sänger. Für das neue Projekt werden weitere gesucht. ‚Mein Traum wäre es, wenn wir 48 Sänger zusammenbekommen‘, sagt Lehmann.“"
                                            },
                                            {
                                                "example_id": "7705b044-8c3e-4aff-b1a7-54046b6f198e",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "„Der Trommler, ein hagerer, gut aussehender Soldat von etwa vierzig Jahren, brach bei den letzten Worten nach soldatischer Art kurz ab, machte eine Handbewegung, als schleudere er etwas auf die Erde, warf den übrigen Sängern einen strengen Blick zu und schloss für einen Moment die Augen.“"
                                            },
                                            {
                                                "example_id": "9ff678a9-ebe3-4805-92f1-97f573a76250",
                                                "sense_id": "4c50f9b4-8164-33a3-a5e4-99672abb3478",
                                                "text": "„Ein Sänger singt bei einem Agenten eine Arie vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04f9f7ba-d8fc-3724-bfc6-7d293ed8ce9d",
                                        "entry_id": "681c4869-1d0e-3efd-82cd-f91a6f12c897",
                                        "glosses": [
                                            "ein Vogel, der singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f7a943-00a2-4a60-9c86-d0bbf9aeefe9",
                                                "sense_id": "04f9f7ba-d8fc-3724-bfc6-7d293ed8ce9d",
                                                "text": "Zebrafinken: Laute Sänger haben bei Weibchen Vorteile."
                                            },
                                            {
                                                "example_id": "8278ddcc-13fa-4318-a2b3-6ecca19006d0",
                                                "sense_id": "04f9f7ba-d8fc-3724-bfc6-7d293ed8ce9d",
                                                "text": "Sie ist die Königin der Sänger, die Nachtigall."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df0177d4-12e1-4021-bc4d-d20f42f77d0f",
                        "source_entry_id": "92c9e5a2-bcfe-30e6-b484-3d93f6d44149",
                        "source_sense_id": "ff1ced49-eb1a-30c0-9975-4448523799f8",
                        "source_sense_description": "singer",
                        "target_lang_word": "Sängerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sängerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                        "entry_id": "5fe15538-19a4-3976-8172-2dce1f06139a",
                                        "glosses": [
                                            "eine weibliche Person, die berufsmäßig singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ac3999-028f-4a1e-87c5-d5ccbecff446",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "Pink, Christina Aguilera, Lil' Kim und Mya waren die Sängerinnen von „Lady Marmalade“."
                                            },
                                            {
                                                "example_id": "fd53d6cc-e810-4629-8441-8d06229e0f99",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Da ist eine schwarze Sängerin mit einer schönen Stimme.“"
                                            },
                                            {
                                                "example_id": "07c18ff4-22a4-4ef6-8dd5-58e2f161b372",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Sie war Sängerin, er hatte sie unterrichtet.“"
                                            },
                                            {
                                                "example_id": "3468df7e-917f-4662-a22f-4aeb021728d1",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Im zweiten Akt verkleidet die Gräfin, die sich von dem kleinen Schäker und Draufgänger gern anhimmeln lässt, den jungen Mann, der von einer Sängerin gespielt wird, in eine junge Frau.“"
                                            },
                                            {
                                                "example_id": "a6427adf-a57b-467a-8914-de5749063fc5",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Vorübergehend trat sie als Sängerin auf, im langen weißen Kleid aus fließender Seide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d5df0b3-4516-367c-8c0b-578bb8038252",
                                        "entry_id": "5fe15538-19a4-3976-8172-2dce1f06139a",
                                        "glosses": [
                                            "eine weibliche Person, die hobbymäßig, zum Beispiel in einem Chor singt"
                                        ],
                                        "tags": [
                                            "im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a679b5c-ecbb-434c-b07d-127d5fe58f00",
                                                "sense_id": "5d5df0b3-4516-367c-8c0b-578bb8038252",
                                                "text": "Laura steht in dem Ruf, eine gute Sängerin zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a0b7bc9-94b2-4f73-aa11-f1862f8a9c60",
                        "source_entry_id": "92c9e5a2-bcfe-30e6-b484-3d93f6d44149",
