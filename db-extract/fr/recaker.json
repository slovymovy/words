                "senses": [
                    {
                        "sense_id": "92a73579-e840-3859-9c71-32cba79bcd60",
                        "entry_id": "e3e3de4b-062c-366a-b1b5-43d7e368cdeb",
                        "glosses": [
                            "Se rassécher les mains en les plongeant dans le sac à magnésie."
                        ],
                        "tags": [
                            "Escalade"
                        ],
                        "examples": [
                            {
                                "example_id": "c02a30e4-789a-4a8f-bcb2-14d07d836645",
                                "sense_id": "92a73579-e840-3859-9c71-32cba79bcd60",
                                "text": "Une invers main droite puis un bi main gauche permettent de recaker."
                            },
                            {
                                "example_id": "8864f053-4008-40a9-aab3-db31db368d6d",
                                "sense_id": "92a73579-e840-3859-9c71-32cba79bcd60",
                                "text": "Recaker devient vite un réflexe inutile dans la plupart des cas, et le jour où on n'en a plus, on s'affole et on n'arrive plus à grimper."
                            }
                        ]
                    }
