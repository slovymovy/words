                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "910697cd-e070-46bd-808c-f93bad1b7cae",
                        "entry_id": "de539fe0-3fc8-3b85-a310-5df4b3eb6e77",
                        "tags": [
                            "plural"
                        ],
                        "form": "conveyors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ed8bf87-a336-3c1b-be6e-560fa0d67231",
                        "entry_id": "de539fe0-3fc8-3b85-a310-5df4b3eb6e77",
                        "glosses": [
                            "A person that conveys, transports or delivers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c291a02-bdff-33d2-92ce-1a51dc8c80ae",
                        "entry_id": "de539fe0-3fc8-3b85-a310-5df4b3eb6e77",
                        "glosses": [
                            "Anything that conveys, transports or delivers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c6e0ac-9ad0-412c-b3a8-c481ba47d15f",
                                "sense_id": "2c291a02-bdff-33d2-92ce-1a51dc8c80ae",
                                "text": "Words are a conveyor of meaning."
                            }
                        ]
                    },
                    {
                        "sense_id": "bae89d20-7489-350a-895f-10ef5649d78e",
                        "entry_id": "de539fe0-3fc8-3b85-a310-5df4b3eb6e77",
                        "glosses": [
                            "A mechanical arrangement for transporting material or objects, generally over short or moderate distances, as from one part of a building to another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ab9f71-d075-4b4f-9ac1-f3862580a653",
                                "sense_id": "bae89d20-7489-350a-895f-10ef5649d78e",
                                "text": "The 1.7 mile-long conveyor system was commissioned in November 2022, and will remove one million lorry movements from the roads around West London."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa365278-5a55-43eb-975c-28aef5418ab7",
                        "source_entry_id": "de539fe0-3fc8-3b85-a310-5df4b3eb6e77",
                        "source_sense_description": "a person that conveys, transports or delivers",
                        "target_lang_word": "convoyeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convoyeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d453b33b-301a-3a02-91c0-f01bb19ba174",
                                        "entry_id": "809f170e-48e2-3e9c-a1bc-acbf283c2fa8",
                                        "glosses": [
                                            "Qui est chargé d’accompagner et de surveiller un transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d10f7a7-1786-4531-82a5-005365fdd030",
                                                "sense_id": "d453b33b-301a-3a02-91c0-f01bb19ba174",
                                                "text": "Ces appareils à axe horizontal et vis convoyeuse sont à fonctionnement continu. Le bol horizontal tourne entre 1500 et 3000 tr/min, la vis convoyeuse a une vitesse légèrement inférieure."
                                            },
                                            {
                                                "example_id": "c658013c-3594-4ff1-9f6d-ca4872d6bde3",
                                                "sense_id": "d453b33b-301a-3a02-91c0-f01bb19ba174",
                                                "text": "Les chaînes convoyeuses transportent le produit à l'arrière, jusqu'au déflecteur qui amorce l'enroulement de la récolte, […]."
                                            },
                                            {
                                                "example_id": "1e50c812-4e61-4110-a598-060add8cf3be",
                                                "sense_id": "d453b33b-301a-3a02-91c0-f01bb19ba174",
                                                "text": "— La Hollande avait néanmoins consenti à une sorte de transaction , en admettant que le bâtiment convoyeur devait montrer les papiers des navires marchands ; cette concession enlevait au vaisseau de guerre toute la force qu’il devait tirer de sa qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dd610bf-116f-31f1-b884-9af74ff149dc",
                                        "entry_id": "809f170e-48e2-3e9c-a1bc-acbf283c2fa8",
                                        "glosses": [
                                            "Qualifiait le préposé qui était chargé du service postal dans les trains omnibus."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "207b703b-d73c-4492-a613-c09ce316a3f6",
                                                "sense_id": "3dd610bf-116f-31f1-b884-9af74ff149dc",
                                                "text": "Sur les autres trains, il s'agit de wagons-poste fermés, ou de fourgons avec un local postal, au pire d’un seul courrier convoyeur, agent des Postes, dans un compartiment pour voyageurs, réquisitionné pour la circonstance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "convoyeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3afc7dab-989c-3a31-9346-0154d473ea69",
                                        "entry_id": "8c24e371-d055-3255-8f37-0d4f3a363a31",
                                        "glosses": [
                                            "Engin pour transporter des colis ou des produits en vrac. Il peut être constitué d’une bande continue enchâssée et entraînée par un moteur. Il peut aussi être constitué de rouleaux rapprochés, de plaques minces ou d’augets installés dans un châssis rigide, reliés à une chaîne ou un câble, et entraînés par un moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aaa5f71-4b25-42f7-aeee-511061293e9a",
                                                "sense_id": "3afc7dab-989c-3a31-9346-0154d473ea69",
                                                "text": "Les longueurs unitaires des convoyeurs vont de 5 m (petites sauterelles de chargement) à plus de 1 000 m, les largeurs de bandes s'étageant entre 0,3 et 1,2 m (exceptionnellement 1,40 à 1,80m)."
                                            },
                                            {
                                                "example_id": "6ba0b8d2-b960-4c77-b115-b447a1e93bfb",
                                                "sense_id": "3afc7dab-989c-3a31-9346-0154d473ea69",
                                                "text": "Ces convoyeurs doivent souvent faire de l’accumulation. Pour ce faire, on peut découper le convoyeur en modules ayant chacun sa propre motorisation. Les palettes avancent ainsi de place en place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2290d02e-dafc-3bee-a937-c9dc2fd2964a",
                                        "entry_id": "8c24e371-d055-3255-8f37-0d4f3a363a31",
                                        "glosses": [
                                            "Navire qui escorte d'autres navires."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc19d74-17ee-4c8d-90e8-3760a0cb3846",
                                                "sense_id": "2290d02e-dafc-3bee-a937-c9dc2fd2964a",
                                                "text": "Les bâtiments à vapeur seront aussi d’excellents convoyeurs, et on les emploiera avec beaucoup d'avantage à la défense des rades et des ports qu’un ennemi menacerait d’une attaque de we force ou qu il gênerait par un blocus ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "convoyeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a565f4-aec9-3d91-9f10-91ee1fbc0f1d",
                                        "entry_id": "84c5e4ef-fee7-3433-8aab-e271e87df2f4",
                                        "glosses": [
                                            "Agent chargé d’accompagner et de surveiller un transport."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001e30fe-e5f6-4d2b-b87f-214e34b17660",
                                                "sense_id": "c6a565f4-aec9-3d91-9f10-91ee1fbc0f1d",
                                                "text": "Enfin, ils prennent position dans le bâtiment, sur le chemin qu'empruntent habituellement les convoyeurs pour se rendre à la salle des coffres. Chavel, Roland et Paul se cachent. Ils ne doivent pas être vus."
                                            },
                                            {
                                                "example_id": "7a00a373-873c-4d9c-b5da-c4c15f05387f",
                                                "sense_id": "c6a565f4-aec9-3d91-9f10-91ee1fbc0f1d",
                                                "text": "Une cinquantaine de convoyeurs se réunissent devant le bâtiment de la Banque de France, à Nanterre, où la Poste devait effectuer un prélèvement de 50 millions de francs (7,5 millions d'euros) avec ses propres véhicules escortés par des CRS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
