        "ru-extract.jsonl": [
            {
                "entry_id": "af3f6e79-f9ab-3e9a-b81f-185acd4c952b",
                "word": "Малец",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a190208-6571-3544-b471-40ad6d2f0b65",
                        "entry_id": "af3f6e79-f9ab-3e9a-b81f-185acd4c952b",
                        "glosses": [
                            "славянская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f029a2-53b0-4cd7-8e89-22b736d81fb7",
                                "sense_id": "4a190208-6571-3544-b471-40ad6d2f0b65",
                                "text": "От человека по фамилии Малец ничего хорошего ждать не приходилось."
                            },
                            {
                                "example_id": "c4527840-6487-4839-9d97-61b5416d6440",
                                "sense_id": "4a190208-6571-3544-b471-40ad6d2f0b65",
                                "text": "— Он Зосин, а фамилия ихняя Малец. У него одна мать, он сирота. — Так ты, значит, пан Данила Малец, — засмеялся учитель."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
