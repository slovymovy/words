                        "examples": [
                            {
                                "example_id": "9914d979-d796-4ea9-8f52-c7cd25898439",
                                "sense_id": "1f39712e-461d-31a7-b2d8-91c38a8c652f",
                                "text": "Door de uitvinding van de transistor raakte de ontwikkeling van de computer in een stroomversnelling."
                            },
                            {
                                "example_id": "01ff2d48-778f-4fd0-b7dc-5f04c442a2ba",
                                "sense_id": "1f39712e-461d-31a7-b2d8-91c38a8c652f",
                                "text": "Hoewel de laatste dagen in afwachting van de wapenstilstand vrij rustig verliepen, kwam alles onverhoeds in een stroomversnelling."
                            },
                            {
                                "example_id": "356b0391-949a-4899-b1d2-acc5a2b2b426",
                                "sense_id": "1f39712e-461d-31a7-b2d8-91c38a8c652f",
                                "text": "\"In Rusland is de afgelopen weken en maanden terughoudend gereageerd op de mogelijkheid van een NAVO-lidmaatschap voor Finland en Zweden. Uit de commentaren proef je wrevel, men is in Moskou duidelijk 'not amused' en lijkt enigszins verrast door de stroomversnelling waarin dit proces ineens is gekomen. Maar concrete indicaties van een mogelijk Russisch antwoord op de uitbreiding van de alliantie zijn vooralsnog uitgebleven."
                            }
                        ]
                    }
