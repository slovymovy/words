                    }
                ],
                "senses": [
                    {
                        "sense_id": "731f8d18-cde3-3d74-b38e-d97a9b39b672",
                        "entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                        "glosses": [
                            "kuliste naczynie o wydłużonej, zakrzywionej szyjce, najczęściej wykonane ze szkła, używane do destylacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c13e36-b604-4fc7-8f76-0b7c2c5270db",
                                "sense_id": "731f8d18-cde3-3d74-b38e-d97a9b39b672",
                                "text": "Profesor z rozwichrzoną czupryną przelewał z retorty do retorty mętną białawą ciecz, mieszał ją z substancjami, zawartymi w szeregach probówek, przygotowując jakąś reakcję."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e2767dfd-96b5-3b7a-b727-fa4ef58154e4",
                        "entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                        "glosses": [
                            "duży, cylindryczny piec, w którym materiał poddawany jest wysokim temperaturom, służący do wypalania węgla drzewnego lub otrzymywania lotniejszych metali"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45eb3cc6-634f-40f1-8b98-2fff926b3166",
                                "sense_id": "e2767dfd-96b5-3b7a-b727-fa4ef58154e4",
                                "text": "Kiedyś zaczynał od wypalania węgla drzewnego w retortach, o takich jak on mówiło się, że w lasach są u wrót piekieł."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ebc3a89e-66f9-33dc-9b02-5f0882b0c4a4",
                        "entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                        "glosses": [
                            "komora pieca krematoryjnego, w której spopielane są zwłoki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b4adb0-fff6-43ad-969c-12d94197541c",
                                "sense_id": "ebc3a89e-66f9-33dc-9b02-5f0882b0c4a4",
                                "text": "Członkowie Sonderkommando układali na podłodze po pięć zwłok przed każdą retortą, a resztę przenosili do magazynu koło windy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91b758a1-0bb3-439c-848c-fdae0429322b",
                        "source_entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                        "source_sense_id": "731f8d18-cde3-3d74-b38e-d97a9b39b672",
                        "target_lang_word": "retort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                        "entry_id": "d11e11d4-f3a3-3cb8-8343-8836282228b0",
                                        "glosses": [
                                            "A sharp or witty reply, or one which turns an argument against its originator; a comeback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82e37f2-9a50-4d3b-9ad3-e15771d8c180",
                                                "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                                "text": "He countered her insult with a clever retort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To say something sharp or witty in answer to a remark or accusation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5c0699d-c74d-4b31-b8bf-304c4a7b7dad",
                                                "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                                "text": "“It is a pity,” he retorted with aggravating meekness, “that they do not use a little common sense. The case resembles that of Columbus' egg, and is every bit as simple.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To make a remark which reverses an argument upon its originator; to return, as an argument, accusation, censure, or incivility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab29852a-22be-45ce-bd98-fdfe10114536",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "to retort the charge of vanity"
                                            },
                                            {
                                                "example_id": "12615b7a-dce6-4932-afb0-038280fcc94f",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "And with retorted scorn his back he turned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To bend or curve back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fcfa779-28f5-4580-896a-22ff5a13cf42",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "a retorted line"
                                            },
                                            {
                                                "example_id": "06cd211c-7879-4318-8a28-5780e81a0a58",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "With retorted head, pruned themselves as they floated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To throw back; to reverberate; to reflect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb38f23d-1089-4776-9845-e77c265a0294",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "As when his virtues, shining upon others, / Heat them and they retort that heat again / To the first giver."
                                            },
                                            {
                                                "example_id": "a51b4be5-44cb-45de-8ef7-9aa15b1ab66d",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "Glasses were filled, arresting the trooper on a theme of passion; the pariahdom of the country cop, whose self-respect is to retort the law's blackmail for blackmail levied on his self-respect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A flask with a rounded base and a long neck that is bent down and tapered, used to heat a liquid for distillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435383bd-6d9e-483c-a567-9d6071ea26bc",
                                                "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                                "text": "A large curved retort was boiling furiously in the bluish flame of a Bunsen burner, and the distilled drops were condensing into a two-litre measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86940d79-253c-33fd-9e57-c0ff054c3cd5",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "An airtight vessel in which material is subjected to high temperatures in the chemical industry or as part of an industrial manufacturing process, especially during the smelting and forging of metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A pressure cooker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98dc5a11-ec9c-49af-bd31-2d0e9a9040b6",
                                                "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                                "text": "The retort is above boiling water. Beneath is a furnace. To the right a man is removing the chips from which the camphor has been extracted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6381c185-86e7-3c80-bc14-b51d1bf2b41a",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A crematory furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52608053-0259-3665-aedb-094863994256",
                                        "entry_id": "db3d1c60-9ace-3300-8c25-c24c7910e9bb",
                                        "glosses": [
                                            "To heat in a retort."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0a4d347-60c2-4654-85a6-6ee296ba402b",
                        "source_entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                        "source_sense_id": "731f8d18-cde3-3d74-b38e-d97a9b39b672",
                        "target_lang_word": "Retorte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Retorte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                        "entry_id": "efbe43e8-db80-38e7-be42-d19cb090d625",
                                        "glosses": [
                                            "Gefäß zum Destillieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea2d27b-f0e6-4bf4-89c5-03fe0c58bb2d",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "Retorten wurden schon im Mittelalter benutzt."
                                            },
                                            {
                                                "example_id": "a6c63f7e-fcb3-4c69-922c-956d221a6d5b",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "„Böttger betrachtet wieder einmal enttäuscht den Niederschlag in der Retorte.“"
                                            },
                                            {
                                                "example_id": "2defa33a-4bdb-4651-8984-afd129e776eb",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "„Eine doppelte Reihe von mit Glasstöpseln verschlossenen Flaschen stand in einem Regal an der Wand gegenüber der Tür, und der Tisch war vollständig bedeckt mit einem Durcheinander von Bunsenbrennern, Reagenzgläsern und Retorten.“"
                                            },
                                            {
                                                "example_id": "79d47c8d-2d35-46cc-a6d7-045f056301f7",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "„Sie schütteten sie in die Retorte, gossen Alkohol hinzu, zündeten das Feuer an und warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27c538f1-64e0-465e-a387-82e2cce515f3",
                        "source_entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                        "source_sense_id": "e2767dfd-96b5-3b7a-b727-fa4ef58154e4",
                        "target_lang_word": "retort",
