    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0effa486-f70f-3d82-bfe6-028fad319fe8",
                "word": "Luca",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4513ba1a-092e-310d-8224-f7279cb692a2",
                        "entry_id": "0effa486-f70f-3d82-bfe6-028fad319fe8",
                        "glosses": [
                            "A male given name from Italian, borrowed in the 2000s."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dfdbc003-6a9f-3ee1-bfcd-d53acee7badc",
                        "entry_id": "0effa486-f70f-3d82-bfe6-028fad319fe8",
                        "glosses": [
                            "A female given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285e4169-a530-432f-b683-597c68a24fe1",
                                "sense_id": "dfdbc003-6a9f-3ee1-bfcd-d53acee7badc",
                                "text": "This is my bedroom, and Luca’s, and Fran’s, and my mother’s. The four of us sleep here, and at the back of the house live Celesta and Rose, my other two sisters who I don’t really know. […] We are Celesta, Rosaria, Francesca, Luca, Dolores."
                            },
                            {
                                "example_id": "62ae571a-4161-435a-82ad-17284432869e",
                                "sense_id": "dfdbc003-6a9f-3ee1-bfcd-d53acee7badc",
                                "text": "Miss Lori, my girlfriend is on the phone. Her name is Luca."
                            },
                            {
                                "example_id": "fc41eb48-aedc-415a-85f4-04773111eb20",
                                "sense_id": "dfdbc003-6a9f-3ee1-bfcd-d53acee7badc",
                                "text": "“No, it wasn’t a dream, Luke….You have a daughter. […] I just assumed she was Ryan’s. I got married days after you came to Chicago….days after you and me… I’m sorry….” / “What’s her name, Drea?” […] “Luca….your daughter’s name is Luca.” / “No, no… her name is Luca Landon.” […] Luca Landon would always connect Mattdrea Cyrus to Luke Landon."
                            },
                            {
                                "example_id": "03e6f937-842f-43b7-bf43-87aa310c805f",
                                "sense_id": "dfdbc003-6a9f-3ee1-bfcd-d53acee7badc",
                                "text": "Who is the playwright of the Diamond Theater responsible for these stirring stories? Her name is Luca Syara, but beyond that, she’s an enigma."
                            },
                            {
                                "example_id": "b5488870-eacb-4d85-9c70-679a8559b8b7",
                                "sense_id": "dfdbc003-6a9f-3ee1-bfcd-d53acee7badc",
                                "text": "I don’t know if you ever met my stepmother, Luca. […] When Luca’s husband died protecting my dad, he’d felt obligated to show his loyalty and gratitude by marrying her, adopting her sons, treating them as his own."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "239612ca-5ca9-3884-9c9f-bcee376e72ca",
                "word": "Luca",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e2b8326-776d-4177-8051-58ca92ab4982",
                        "entry_id": "239612ca-5ca9-3884-9c9f-bcee376e72ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "Lucas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd126e42-6b81-310e-814c-82408eae3ed3",
                        "entry_id": "239612ca-5ca9-3884-9c9f-bcee376e72ca",
                        "glosses": [
                            "Alternative letter-case form of LUCA."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6ea491-8ebf-4bfa-af08-62710e229f44",
                                "sense_id": "fd126e42-6b81-310e-814c-82408eae3ed3",
                                "text": "What’s more, every living organism is ultimately descended from a single ancestral population: the Last Universal Common Ancestor (Luca), which lived over 3.5 billion years ago when the planet was newly formed."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "72cdace8-41f9-301b-85ca-352f54073ee5",
                "word": "LUCA",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "98ca4020-da1d-44e5-ac25-ce4f33bfc15f",
                        "entry_id": "72cdace8-41f9-301b-85ca-352f54073ee5",
                        "tags": [
                            "plural"
                        ],
                        "form": "LUCAs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a130697-6acf-35ab-963d-804bfd4779c8",
                        "entry_id": "72cdace8-41f9-301b-85ca-352f54073ee5",
                        "glosses": [
                            "Initialism of last universal common ancestor; the hypothesised most recent primordial organism that is an ancestor to all organisms now living."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "a24675fb-1aa6-4adb-88d8-3a22e3e0e51d",
                                "sense_id": "2a130697-6acf-35ab-963d-804bfd4779c8",
                                "text": "Luca is now usually placed deep underground, in a fissure in hot igneous rocks, where she fed on sulphur, iron, hydrogen and carbon."
                            },
                            {
                                "example_id": "1d8395e4-d605-416f-aa55-84cba736ffc1",
                                "sense_id": "2a130697-6acf-35ab-963d-804bfd4779c8",
                                "text": "It was around 2.9 billion years ago that LUCA split into the three domains of life: the single-celled bacteria and archaea, and the more complex eukaryotes that gave rise to animals and plants[…]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "9fc3863b-93e7-4cf9-ad10-cc4f6f611e5b",
                        "source_entry_id": "72cdace8-41f9-301b-85ca-352f54073ee5",
