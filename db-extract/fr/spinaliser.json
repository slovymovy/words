                "senses": [
                    {
                        "sense_id": "3789eb50-bfbd-3634-9914-7644b606c437",
                        "entry_id": "d7de13bd-ad27-387b-902a-ad7170f2ea5d",
                        "glosses": [
                            "Couper la liaison entre la moelle épinière et le cerveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53013909-6d2b-4365-add4-6d281ede2af8",
                                "sense_id": "3789eb50-bfbd-3634-9914-7644b606c437",
                                "text": "On peut, il est vrai, « spinaliser » l’animal en arrière de la naissance des nerfs phréniques, ce qui rend possible l’expérimentation chronique, mais la réduit au train postérieur."
                            },
                            {
                                "example_id": "cdaa2683-5715-4930-91fd-8249283ebfbd",
                                "sense_id": "3789eb50-bfbd-3634-9914-7644b606c437",
                                "text": "Chez l’enfant, chez l’animal spinalisé et chez le blessé médullaire, un autre réflexe, médié par les fibres non myélinisées de type C, capsaïcine sensible, permet la contraction vésicale."
                            }
                        ]
                    }
