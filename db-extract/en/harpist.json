                                        "entry_id": "be323116-3b33-3065-83e1-c52a45b95646",
                                        "glosses": [
                                            "Person, die (professionell) Harfe spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5d6117-0f49-4383-8ff9-da7c3c886967",
                                                "sense_id": "20a1f36a-074d-3036-8934-190dbc506406",
                                                "text": "Wir lauschten ergriffen einem Harfenspieler."
                                            },
                                            {
                                                "example_id": "b12d98f5-208d-46d9-ac78-97b107b429c2",
                                                "sense_id": "20a1f36a-074d-3036-8934-190dbc506406",
                                                "text": "„Der irische Harfenspieler und Komponist wurde 1670 als Sohn einfacher Bauern geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f83cb8cc-474d-4daf-918e-a3881672298a",
                        "source_entry_id": "5316e2ad-011b-3204-b2f1-f2a672f977bd",
