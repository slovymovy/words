                ],
                "senses": [
                    {
                        "sense_id": "6dcf27f6-23b7-3a17-8b67-b878a7d6b4a9",
                        "entry_id": "023856b3-63ad-3c28-911f-3cdcfab68e50",
                        "glosses": [
                            "спец. забор воды из водоёма, водотока или подземного водоисточника для её использования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc84e259-3478-4fa8-8e39-b94f904858cd",
                                "sense_id": "6dcf27f6-23b7-3a17-8b67-b878a7d6b4a9",
                                "text": "Увеличится водозабор, увеличатся сбросы и соответственно возрастут затраты на разбавление."
                            },
                            {
                                "example_id": "49d5f115-ed5d-416c-abbf-577c5c64d74e",
                                "sense_id": "6dcf27f6-23b7-3a17-8b67-b878a7d6b4a9",
                                "text": "В посёлке Пирамида водозабор производится из озера Голубого, но воды в нём не хватает."
                            }
                        ]
                    },
                    {
                        "sense_id": "42d48319-93c9-3b05-bd5d-b9d99abedda4",
                        "entry_id": "023856b3-63ad-3c28-911f-3cdcfab68e50",
                        "glosses": [
                            "сооружение для такого забора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cded5f6b-5fe2-4e0b-a103-6dff48804fb5",
                                "sense_id": "42d48319-93c9-3b05-bd5d-b9d99abedda4",
                                "text": "Много лет практически по всей стране не ремонтировались и не усовершенствовались плотины и водозаборы."
                            }
                        ]
                    }
