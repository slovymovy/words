                        ]
                    },
                    {
                        "translation_id": "557a37ba-b633-4bea-819a-0b15d5aeb777",
                        "source_entry_id": "fc587d68-0e98-3a17-8d1a-8915ede57e5b",
                        "source_sense_id": "ea137e1b-995c-3b14-876f-ed03f252f428",
                        "source_sense_description": "einen Bereich Haut chemisch oder mit Hitze zerstören, mit dem Ziel eine Infektion zu stoppen oder zu vermeiden",
                        "target_lang_word": "ausbrennen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3225eaba-c5cf-4be7-a33b-48a78db16f32",
                        "source_entry_id": "fc587d68-0e98-3a17-8d1a-8915ede57e5b",
                        "source_sense_id": "e41942c8-d4df-3de2-bd1e-d312da49271d",
                        "source_sense_description": "verhindern, das jemand ein Gefühl, insbesondere einen negatives, fühlt",
                        "target_lang_word": "abstumpfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstumpfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05e98f6d-eb21-3961-9d74-6d15549374bb",
                                        "entry_id": "39ca854c-025d-39eb-abc2-343bd28ae20b",
                                        "glosses": [
                                            "etwas stumpf machen, beispielsweise eine Kante oder einen Weg im Winter bei Glätte durch Streuen von Sand;\\n (von alleine) seine Schärfe verlieren/stumpf werden, beispielsweise durch Gebrauch"
                                        ],
                                        "tags": [
                                            "auch",
                                            "bei Messern",
                                            "Schneiden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce045183-8d96-4269-a84d-837434ae76a7",
                                                "sense_id": "05e98f6d-eb21-3961-9d74-6d15549374bb",
                                                "text": "Um die Oberfläche bei Schnee und Eis abzustumpfen sind als Streumaterial Sand, Splitt und Granulat geeignet."
                                            },
                                            {
                                                "example_id": "2a809286-dccd-40e2-8541-18574e7a610a",
                                                "sense_id": "05e98f6d-eb21-3961-9d74-6d15549374bb",
                                                "text": "„„Abstumpfende Mittel“ stumpfen die Glätte ab und schmelzen das Eis nicht, nehmen beim Streuen aber direkt die Rutschglätte.“"
                                            },
                                            {
                                                "example_id": "8aaae025-2811-41cb-9dc0-0e101731078c",
                                                "sense_id": "05e98f6d-eb21-3961-9d74-6d15549374bb",
                                                "text": "„Sand lässt zwar nicht den Schnee und das Eis tauen, aber es stumpft sie ab - und damit rutscht man darauf nicht mehr aus.“"
                                            },
                                            {
                                                "example_id": "24048399-7935-4dab-9f46-4955c497badf",
                                                "sense_id": "05e98f6d-eb21-3961-9d74-6d15549374bb",
                                                "text": "Man sollte die Zahnbürste alle drei Monate wechseln, aber nicht wegen Keimen, sondern weil die Borsten abstumpfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                        "entry_id": "39ca854c-025d-39eb-abc2-343bd28ae20b",
                                        "glosses": [
                                            "unempfindlich, gleichgültig, emotionslos werden"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32acb095-7198-4f9f-b8a7-89389d2ef7ef",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "Nach ein paar Monaten im Gefängnis stumpft man ab."
                                            },
                                            {
                                                "example_id": "b5a37412-9a7f-4474-826c-cb2e0377fa21",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "Stumpfen Menschen ab, wenn sie jeden Tag Nachrichten hören und Bilder sehen von Menschen, die verhungern, von Krieg, von Flucht und Vertreibung?"
                                            },
                                            {
                                                "example_id": "cbd7c42a-4af6-49ef-bb9c-d5063f5484b2",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "„Der mexikanische Regisseur Michel Franco“ [zeigt] „Mexiko als Klassengesellschaft, die angesichts der grassierenden Kriminalität zunehmend abstumpft.“"
                                            },
                                            {
                                                "example_id": "e29144d0-e167-4951-96d6-de341f0be23c",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "„Doch ich will weder abstumpfen noch mich in die bequeme Ohnmacht flüchten, sowieso nichts ändern zu können.“"
                                            },
                                            {
                                                "example_id": "70d554d8-9fbf-4b49-94ca-2cfdb83778be",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "„Die in den Nachrichten bekannt gegebenen Zahlen von manchmal über tausend Toten lassen uns nicht abstumpfen, sagt Assmann, »aber wir können es uns nicht wirklich vorstellen. Eintausend Corona-Tote täglich, das sind vier Flugzeugabstürze.«“"
                                            },
                                            {
                                                "example_id": "c530f15f-49c4-4905-9a56-6eff7a0947ad",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "[Kriegsfotos aus der Ukraine:] „»Keine Bilder zu zeigen, weil die Leute abstumpfen könnten, sollte nie ein Argument sein. Wenn solche fürchterlichen Sachen passieren, sollte man auch darüber berichten.«“"
                                            },
                                            {
                                                "example_id": "cae79d48-c0c2-4cf3-9817-718219f891d5",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "„Durch allzu apokalyptische Prognosen könnten Menschen in einer krisengeplagten Welt abstumpfen – und der nötige Klimaschutz vernachlässigt werden.“"
                                            },
                                            {
                                                "example_id": "80a8a749-44b8-4e66-a1d4-e34985e824f7",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "[Aufnahmen von Gewalt unter Kindern, Pornografie und Cybermobbing im Netz:] „Was machen solche Bilder mit unseren Kindern? Haben sie Alpträume, entwickeln sie Ängste, oder stumpfen sie schlicht ab?“"
                                            },
                                            {
                                                "example_id": "76703dca-013f-4dac-9cc4-9c06d49feaab",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "„Der ORF will sein Publikum nicht durch ein Übermaß an Gewaltdarstellungen abstumpfen.“"
                                            },
                                            {
                                                "example_id": "20b7dd50-8058-4401-a129-beeef1449f3c",
                                                "sense_id": "cf5cef72-ff3d-3976-9a40-92d57d7c20f9",
                                                "text": "„»Ich muss gestehen, dass ich nie besonders feste moralische Prinzipien hatte. Ich will mich nicht rechtfertigen, aber eine Erklärung dafür liegt in dem unaufhörlichen Überlebenskampf, den ich von frühester Kindheit an zu bestehen hatte. Dieser Kampf hat meine Skrupel abstumpfen lassen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
