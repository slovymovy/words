                "senses": [
                    {
                        "sense_id": "58b80db9-fce0-3683-87d1-eb7fc14e02c3",
                        "entry_id": "bea81470-7ffb-31f1-8315-749351f53c61",
                        "glosses": [
                            "советск., разг. в СССР: член большевистской партии, коммунистической партии; большевик, коммунист"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d594a69-9c3d-4c9d-bcdb-edf3fe9f0f52",
                                "sense_id": "58b80db9-fce0-3683-87d1-eb7fc14e02c3",
                                "text": "Сеть групоргов устанавливается с таким расчётом, чтобы групорг, сменорг применительно к условиям отдельной мелкой производственной единицы охватывал группу партийцев в 3 — 5 чел."
                            }
                        ]
                    },
                    {
                        "sense_id": "e584fe5f-ea92-31bd-94e3-0cb84b7151e2",
                        "entry_id": "bea81470-7ffb-31f1-8315-749351f53c61",
                        "glosses": [
                            "разг. член какой-либо политической партии"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "669e2e1f-05f4-4dd7-b69a-2324af149721",
                        "source_entry_id": "bea81470-7ffb-31f1-8315-749351f53c61",
                        "source_sense_description": "в СССР: член большевистской партии, коммунистической партии; большевик, коммунист",
                        "target_lang_word": "party member",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "party member",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e61c422-c7d8-337d-9737-ea29537f432a",
                                        "entry_id": "e1afd5e7-8cd8-3b01-938f-deb3d233e019",
                                        "glosses": [
                                            "A person who belongs to a political party."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97a29d76-3a03-4983-8dc1-70a4c95421bf",
                        "source_entry_id": "bea81470-7ffb-31f1-8315-749351f53c61",
                        "source_sense_description": "в СССР: член большевистской партии, коммунистической партии; большевик, коммунист",
                        "target_lang_word": "Parteimitglied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parteimitglied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                        "entry_id": "09b2eca2-681a-366b-8317-5b21947cc759",
                                        "glosses": [
                                            "Person, die in eine Partei eingetreten ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32db91cb-549e-4c0d-9deb-4affa7e14cb2",
                                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                                "text": "Nur die Grünen haben in letzter Zeit die Zahl ihrer Parteimitglieder steigern können."
                                            },
                                            {
                                                "example_id": "62543831-4686-4e8d-943d-f684e8a77b96",
                                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                                "text": "„Stattdessen jedoch fanden in der Reichshauptstadt und ihren Vororten insgesamt 32 formal geschlossene Versammlungen für Parteimitglieder statt, mit insgesamt mindestens 30000, wahrscheinlich aber mehr als 100000 Teilnehmern.“"
                                            },
                                            {
                                                "example_id": "759f6575-33c0-4953-bba9-adeeccdc8c53",
                                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                                "text": "„Zuerst tritt dafür ein Parteimitgleid aus dem Ruhrgebiet auf.“"
                                            },
                                            {
                                                "example_id": "e7d61e2f-c0c9-4f60-8cdd-eba2d0e3a9f4",
                                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                                "text": "„Die Parteimitglieder werden zum Dialog auch mit oppositionellen Parteien und Organisationen aufgefordert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
