                ],
                "senses": [
                    {
                        "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                        "entry_id": "8dd0bdc7-e74a-366b-9999-a6d796b02cb4",
                        "glosses": [
                            "kompromissloser, rücksichtsloser Einsatz dafür, etwas, das man für allein richtig hält, allgemein durchzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e3f1ae-af47-49e7-85d9-2d6dadffae4d",
                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                "text": "„Ihren Hauptgegner sah die osteuropäische Haskala im Chassidismus, der für die Maskilim den Inbegriff von Aberglauben, Irrationalität, Unbildung und religiösem Fanatismus darstellte.“"
                            },
                            {
                                "example_id": "ff03c30a-962b-4a29-945a-9dc96c282c7b",
                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                "text": "„Ich kannte seinen Fanatismus in dieser Hinsicht und wollte nicht darauf beharren.“"
                            },
                            {
                                "example_id": "b50b5115-3f72-4068-b650-d7c1ab88ad8b",
                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                "text": "„Merkwürdigerweise hatte ich den alten Derkum nie fanatisch gefunden, aber vielleicht hatte mein Vater Fanatismus und Konsequenz miteinander verwechselt.“"
                            },
                            {
                                "example_id": "9eae5ca2-6488-481c-b44f-b948a0ea289c",
                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                "text": "„Ich bin mit Necla Kelek verabredet und möchte mit ihr über Fanatismus und Fundamentalismus reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
