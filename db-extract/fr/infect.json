                ],
                "translations": [
                    {
                        "translation_id": "75befd2b-0c9c-4a40-8725-89ddf6081178",
                        "source_entry_id": "d67ed7f7-3423-37f4-b350-9f4fcb3f2354",
                        "target_lang_word": "vile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                                        "entry_id": "89015da1-b039-3ba9-9618-41b0a628bc10",
                                        "glosses": [
                                            "Morally low; base; despicable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec433e2-0cf0-4f21-b0c1-029e41a7c4e8",
                                                "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                                                "text": "vile accusation"
                                            },
                                            {
                                                "example_id": "43911873-81a1-4552-9296-cdc8d47db1e5",
                                                "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                                                "text": "vile man"
                                            },
                                            {
                                                "example_id": "e0491bf0-d6ea-4fc1-9e28-a1706acd9b19",
                                                "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                                                "text": "Turn now to the temperance revolution. In it we shall find a stronger bondage broken, a viler slavery manumitted, a greater tyrant deposed; in it, more of want supplied, more disease healed, more sorrow assuaged."
                                            },
                                            {
                                                "example_id": "d982bbc4-4d7d-431d-8b23-59e4350e04fc",
                                                "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                                                "text": "The parties stooped to vile and unbecoming meannesses; infinite briberies, forgeries, perjuries, and all manners of debauchings of the principles and manners of the electors were attempted."
                                            },
                                            {
                                                "example_id": "af4808f5-2a75-4321-b6eb-77a616c0f0a8",
                                                "sense_id": "802cbb13-07cd-3462-92cb-f133233397c7",
                                                "text": "People crave human decency, warmth, and sincerity even in the vilest of circumstances…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                        "entry_id": "89015da1-b039-3ba9-9618-41b0a628bc10",
                                        "glosses": [
                                            "Causing physical or mental repulsion; horrid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c44f2b9-470c-4c2f-896d-1f891f95da77",
                                                "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                                "text": "I glimpsed a vile squid-like creature in the depths."
                                            },
                                            {
                                                "example_id": "67509424-8995-4601-ae09-d0395bffee21",
                                                "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                                "text": "vile taste"
                                            },
                                            {
                                                "example_id": "a3b6486b-0d58-4d34-a2ae-2cad32544a3e",
                                                "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                                "text": "vile smell"
                                            },
                                            {
                                                "example_id": "9cff1f05-a3e2-496e-931b-055de7ec5666",
                                                "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                                "text": "vile smile"
                                            },
                                            {
                                                "example_id": "4dd9176c-9a2f-4489-a677-77e44a543816",
                                                "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                                "text": "vile substance"
                                            },
                                            {
                                                "example_id": "61f2dcf6-d32c-49ad-a681-7d485ef25842",
                                                "sense_id": "57aacfdd-8f51-3803-8532-fe0e590dca5d",
                                                "text": "vile weather"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21723b7e-7659-37b1-bfaf-2b9aa6cb9515",
                                        "entry_id": "7601bbdd-d8a8-3ceb-b27c-9e8f0304af5b",
                                        "glosses": [
                                            "That which is vile; vileness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2d8bb6a-54c6-4c0e-9ec1-643eb7c6564b",
                                                "sense_id": "21723b7e-7659-37b1-bfaf-2b9aa6cb9515",
                                                "text": "“I had seen those two work before—in the smoking-room the day prior to their attack on you, if I recollect it correctly, and so, knowing their methods, I am convinced that their enmity is a sufficient guarantee of the integrity of its object. Men such as they must cleave only to the vile, hating all that is noblest and best.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d397fb3-42ac-420e-ab31-29c83754643f",
                        "source_entry_id": "d67ed7f7-3423-37f4-b350-9f4fcb3f2354",
                        "target_lang_word": "loathsome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loathsome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18fbc354-21f6-38f3-ab34-8106987bc44e",
                                        "entry_id": "109b32d9-b34d-3469-9dc3-8e01ba6b9aec",
                                        "glosses": [
                                            "Highly offensive; abominable, sickening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ec9286-3fc8-4791-b917-9730c747b25a",
                                                "sense_id": "18fbc354-21f6-38f3-ab34-8106987bc44e",
                                                "text": "Come on my Lords the better foot before, / Straight vvill I bring you to the lothſome pit, / VVhere I eſpied the Panther faſt a ſleepe."
                                            },
                                            {
                                                "example_id": "b292cda2-1d8d-4bd5-badc-326018dc636c",
                                                "sense_id": "18fbc354-21f6-38f3-ab34-8106987bc44e",
                                                "text": "That grave but yesterday received one who was to have been his bride—his betrothed from childhood for whose sake he had been to far lands and gathered much wealth, but who had pined in his absence and died. He flung himself on the loathsome place, and the night-wind bore around the ravings of his despair."
                                            },
                                            {
                                                "example_id": "1bd3b1de-9589-4ccb-b988-4fdd596cdf55",
                                                "sense_id": "18fbc354-21f6-38f3-ab34-8106987bc44e",
                                                "text": "Lying on the floor was a dead man, in evening dress, with a knife in his heart. He was withered, wrinkled, and loathsome of visage. It was not till they had examined the rings that they recognized who it was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47e9ceef-eaf0-4355-8e92-f01a0d1f92a7",
                        "source_entry_id": "d67ed7f7-3423-37f4-b350-9f4fcb3f2354",
                        "target_lang_word": "revolting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d606769-c2ba-3176-a777-ab9386118d0e",
                                        "entry_id": "3ce07f23-16fb-36dd-8071-91e7b133235f",
                                        "glosses": [
                                            "present participle and gerund of revolt"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae8b0b80-9a41-41b6-bb86-db09f1719ddb",
                                                "sense_id": "4d606769-c2ba-3176-a777-ab9386118d0e",
                                                "text": "The feudal subjects decided to revolt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revolting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3d8178-2653-31c4-8c7d-cc6e207a43ff",
                                        "entry_id": "d9e9b4bd-6f77-3517-9f2c-4f7d6dd3f5e7",
                                        "glosses": [
                                            "revolution; revolt"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f68ca386-049a-42dc-b64b-a9a2fbc05292",
                                                "sense_id": "1f3d8178-2653-31c4-8c7d-cc6e207a43ff",
                                                "text": "Yet revoltings of the soul would attend this violence to nature, this abuse of physical and intellectual energy, while the beauty of social order would be defaced, and the fountains of earth's felicity broken up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revolting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1401f34c-f9f4-3120-adb3-c281201ee2ca",
                                        "entry_id": "a42afe72-cb1f-3efa-8c8a-7b1063d80157",
                                        "glosses": [
                                            "repulsive, disgusting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c559ec5b-8712-4e09-8a71-14521a6743f0",
                                                "sense_id": "1401f34c-f9f4-3120-adb3-c281201ee2ca",
                                                "text": "The most revolting smell was coming from the drains."
                                            },
                                            {
                                                "example_id": "9b2401fb-2215-480b-a69d-65f9547f6f10",
                                                "sense_id": "1401f34c-f9f4-3120-adb3-c281201ee2ca",
                                                "text": "Why anyone should want such a revolting object had always been a mystery to me."
                                            },
                                            {
                                                "example_id": "451456ee-8f93-426e-a440-75853ea50873",
                                                "sense_id": "1401f34c-f9f4-3120-adb3-c281201ee2ca",
                                                "text": "The Leicester Daily Mercury reflected on how these concerns were the result of changing ways of getting around: \"It might sound a bit crazy or just a little revolting that at Christmas works parties, some should drink themselves into a near-insensible state... This was not serious when they used public transport, but today more men and women use their own cars.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05015ca1-ef5e-4666-a636-fba4556fd562",
                        "source_entry_id": "d67ed7f7-3423-37f4-b350-9f4fcb3f2354",
                        "target_lang_word": "disgusting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgusting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                        "entry_id": "0baa67de-a82f-3fcd-9609-0e245f24ff6e",
                                        "glosses": [
                                            "Causing disgust; repulsive; distasteful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fdb63f3-89be-406d-ada8-a56e732c5ca9",
                                                "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                                "text": "The taste and digestion are often depraved, anorexia, nausea, inappetence and vomiting supervene, the woman desires innutritious or disgusting food, such as chalk, cinders, putrescent animal food, […]"
                                            },
                                            {
                                                "example_id": "b7685284-cf5d-4520-9b05-e7cb2534ae12",
                                                "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                                "text": "But it is much more sensible and much more fun and much more disgusting to assume that the English Leather woman is really saying \"All my men wear English leather or nothing at all.\"."
                                            },
                                            {
                                                "example_id": "3f266cf4-7e65-41c8-888d-b1618964b4ea",
                                                "sense_id": "f671ce0e-6229-3ca5-88b3-a0ea2d6a2840",
                                                "text": "One guy farted repeatedly and laughed out loud each time he let it out. To top off his disgusting behavior, he constantly picked his nose and thumped the waste in the air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disgusting",
                                "target_lang_code": "en",
                                "target_senses": [
