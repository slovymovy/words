                        "form": "die Regresse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ef47b83-1605-3fde-bb6e-002010140641",
                        "entry_id": "67e95146-094f-31a6-a018-96fd1917d224",
                        "glosses": [
                            "der Rückgriff des vom Gläubiger belangten Schuldners auf seinen eigenen Schuldner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33de5f4c-3b06-4295-9487-9bd8afa8a6a3",
                                "sense_id": "4ef47b83-1605-3fde-bb6e-002010140641",
                                "text": "Als der Endkunde den Mangel beanstandete, nahm der Händler den Hersteller in Regress."
                            },
                            {
                                "example_id": "934c6d6b-6ee2-461e-9428-fe5e62f8ebd8",
                                "sense_id": "4ef47b83-1605-3fde-bb6e-002010140641",
                                "text": "Da bei sehr hohen Fremdschäden durch den Regress die wirtschaftliche Existenz des Versicherungsnehmers gefährdet sein kann, ist dessen Höhe begrenzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2ec7571-31c8-3400-b9ae-ae7b37c34f17",
                        "entry_id": "67e95146-094f-31a6-a018-96fd1917d224",
                        "glosses": [
                            "der Rückschluss von der Wirkung auf die Ursache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cab75f-0604-4d55-a046-823177f53d71",
                                "sense_id": "c2ec7571-31c8-3400-b9ae-ae7b37c34f17",
                                "text": "In der Tat, wenn wir zureichend begründen wollen, dass bestimmte Annahmen oder Hilfshypothesen wahr sind, dann entsteht ein unendlicher Regress."
                            },
                            {
                                "example_id": "46346e3e-cec4-4c5a-957c-625ebfd72fa9",
                                "sense_id": "c2ec7571-31c8-3400-b9ae-ae7b37c34f17",
                                "text": "„Wie sehr sich Freud in seiner Seelentheorie von Darwins Muster speiste, zeigt sein Regress auf die Urhorde, die an heutige Affenfamilien erinnert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0ada8a9-86d1-4483-bd82-e0d2f83e249d",
                        "source_entry_id": "67e95146-094f-31a6-a018-96fd1917d224",
                        "source_sense_id": "4ef47b83-1605-3fde-bb6e-002010140641",
                        "source_sense_description": "Recht: der Rückgriff des vom Gläubiger belangten Schuldners auf seinen eigenen Schuldner",
                        "target_lang_word": "regress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7620d18-18f4-3623-9a7a-6222193d4937",
                                        "entry_id": "d4426bfd-29d7-3db9-b90b-912059e72d86",
                                        "glosses": [
                                            "The act of passing back; passage back; return; retrogression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d740bf-3c90-4c3d-9cfc-51652ed8a65c",
                                                "sense_id": "c7620d18-18f4-3623-9a7a-6222193d4937",
                                                "text": "Its bearing on the progress or regress of man is not an inconsiderable question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0024a1a2-6c95-3d9d-802a-ef48212e4253",
                                        "entry_id": "d4426bfd-29d7-3db9-b90b-912059e72d86",
                                        "glosses": [
                                            "The power or liberty of passing back."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdee56a5-517a-4c69-bf82-a42d7d75aeb6",
                                                "sense_id": "0024a1a2-6c95-3d9d-802a-ef48212e4253",
                                                "text": "Thou shalt have egresse and regresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd13d617-f371-3166-967f-4e21d8cfc76b",
                                        "entry_id": "d4426bfd-29d7-3db9-b90b-912059e72d86",
                                        "glosses": [
                                            "The right of a person (such as a lessee) to return to a property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "regress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "418d2709-ba05-312a-b208-7213b23354b0",
                                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                                        "glosses": [
                                            "To move backwards to an earlier stage; to devolve."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81dde224-0c5e-3d9a-a6ed-a9c47ba99b16",
                                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                                        "glosses": [
                                            "To move backwards to an earlier stage; to devolve.",
                                            "To re-develop behavior one had previously grown out of, particularly a behavior left behind in childhood."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "509fae05-1a3f-4571-895b-b3d55fb7823b",
                                                "sense_id": "81dde224-0c5e-3d9a-a6ed-a9c47ba99b16",
                                                "text": "Your nightmares stopped when you were eight years old, but after the house burned down, you regressed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c93d5f0-118a-31e4-aa62-83b22b6147e6",
                                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                                        "glosses": [
                                            "To move in the retrograde direction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "682b8c66-b314-3740-b4a4-9c4bc1321afa",
                                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                                        "glosses": [
                                            "To reduce in severity or size (as of a tumor), without reaching total remission."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a60ba9e-9f76-39fa-a3d7-aa173a34a6b4",
                                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                                        "glosses": [
                                            "To perform a regression on an explanatory variable."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd6a2019-54fc-4d02-8c9f-918573c3a76c",
                                                "sense_id": "1a60ba9e-9f76-39fa-a3d7-aa173a34a6b4",
                                                "text": "When we regress Y on X, we use the values of variable X to predict those of Y."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3de8c6-5bd5-3eda-9c1b-40e14211133f",
                                        "entry_id": "0a54be34-d447-3335-9c27-b4d5ded84d71",
                                        "glosses": [
                                            "To interrogate a person in a state of trance about forgotten elements of their past."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29670939-897e-4995-a652-328d5abfa728",
                                                "sense_id": "fe3de8c6-5bd5-3eda-9c1b-40e14211133f",
                                                "text": "They regressed me, putting me under hypnosis. Then, through the hypnosis, they found out that our car was abducted right off the road and into a craft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
