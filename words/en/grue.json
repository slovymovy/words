{
    "word_family": [
        "gruesome",
        "gruesomeness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b538397-c9fd-3307-a866-0dbe7ed398b4",
                    "sense_definition": "A fictional man-eating predator that dwells in the dark.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fictional_creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player was suddenly plunged into darkness and eaten by a <w>grue</w>.",
                            "target_lang_translations": {
                                "ru": "Игрок внезапно погрузился во тьму и был съеден <w>грю</w>."
                            }
                        },
                        {
                            "text": "In many old text adventures, you must carry a light source to avoid a <w>grue</w> attack.",
                            "target_lang_translations": {
                                "ru": "Во многих старых текстовых квестах нужно носить с собой источник света, чтобы избежать нападения <w>грю</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eaten by a grue"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in gaming culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленный хищник-людоед, обитающий в темноте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грю",
                                "target_lang_sense_clarification": "транслитерация названия существа в играх"
                            },
                            {
                                "target_lang_word": "чудовище",
                                "target_lang_sense_clarification": "общее название монстра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a84721b-3935-3d03-8ff1-1e021e4fafd1",
                    "sense_definition": "Any byproduct of a gruesome event, such as gore, viscera, blood, and guts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher was covered in the accumulated <w>grue</w> of a hard day's work.",
                            "target_lang_translations": {
                                "ru": "Мясник был покрыт <w>кровавым месивом</w>, накопившимся за тяжелый рабочий день."
                            }
                        },
                        {
                            "text": "The horror movie was filled with sheer <w>grue</w> that made the audience uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Фильм ужасов был полон натуралистичного <w>насилия</w>, от которого зрителям становилось не по себе."
                            }
                        }
                    ],
                    "synonyms": [
                        "gore",
                        "viscera"
                    ],
                    "common_phrases": [
                        "sheer grue",
                        "explosions of grue"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in horror contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой побочный продукт ужасного события, такой как кровь, внутренности и останки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кровавое месиво",
                                "target_lang_sense_clarification": "останки и кровь"
                            },
                            {
                                "target_lang_word": "расчлененка",
                                "target_lang_sense_clarification": "разговорное о сценах насилия"
                            },
                            {
                                "target_lang_word": "потроха",
                                "target_lang_sense_clarification": "внутренности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51a2865f-6376-374e-b33f-9c7ae7acf577",
                    "sense_definition": "A shiver or a shudder caused by cold or fear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cold <w>grue</w> went through me as I stepped into the abandoned house.",
                            "target_lang_translations": {
                                "ru": "Холодная <w>дрожь</w> пробежала по моему телу, когда я вошел в заброшенный дом."
                            }
                        },
                        {
                            "text": "The sight of the ghost cast a <w>grue</w> upon all who saw it.",
                            "target_lang_translations": {
                                "ru": "Вид призрака вызвал <w>трепет</w> у всех, кто его видел."
                            }
                        }
                    ],
                    "synonyms": [
                        "shiver",
                        "shudder",
                        "frisson"
                    ],
                    "common_phrases": [
                        "cold grue"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дрожь или содрогание, вызванное холодом или страхом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "от холода или страха"
                            },
                            {
                                "target_lang_word": "озноб",
                                "target_lang_sense_clarification": "физическое ощущение холода"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "от волнения или страха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2966e07a-9b99-3667-94d1-2a103cb6b9e4",
                    "sense_definition": "A bland mixture of foods served as a disciplinary meal in prisons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inmate was sentenced to several days of eating nothing but <w>grue</w>.",
                            "target_lang_translations": {
                                "ru": "Заключенный был приговорен к нескольким дням питания одной лишь <w>баландой</w>."
                            }
                        },
                        {
                            "text": "Prisoners often complain about the tasteless nature of the <w>grue</w> served in solitary.",
                            "target_lang_translations": {
                                "ru": "Заключенные часто жалуются на безвкусицу <w>тюремной еды</w>, которую подают в карцере."
                            }
                        }
                    ],
                    "synonyms": [
                        "nutraloaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US prison slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Безвкусная смесь продуктов, подаваемая в качестве дисциплинарного обеда в тюрьмах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюремная баланда",
                                "target_lang_sense_clarification": "жидкая невкусная еда"
                            },
                            {
                                "target_lang_word": "нутрилоаф",
                                "target_lang_sense_clarification": "специфическое блюдо в тюрьмах США"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea19517f-f3e1-386b-a242-df18143a3972",
                    "sense_definition": "To be frightened or to shudder with fear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound of the wind made my very flesh <w>grue</w> in the middle of the night.",
                            "target_lang_translations": {
                                "ru": "От звука ветра посреди ночи у меня <w>кожа покрылась мурашками</w>."
                            }
                        },
                        {
                            "text": "He began to <w>grue</w> at the thought of entering the dark cave alone.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>содрогаться</w> при мысли о том, чтобы войти в темную пещеру в одиночку."
                            }
                        }
                    ],
                    "synonyms": [
                        "shudder",
                        "tremble"
                    ],
                    "common_phrases": [
                        "flesh grue"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily Scottish"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "rare in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пугаться или содрогаться от страха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содрогаться",
                                "target_lang_sense_clarification": "от ужаса"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "от сильного страха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23b25db5-094e-3549-8722-226083d9bdf9",
                    "sense_definition": "Describing a single color category that includes both green and blue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient languages used a <w>grue</w> term to describe the color of both the sea and the forest.",
                            "target_lang_translations": {
                                "ru": "Во многих древних языках использовался <w>зиний</w> термин для описания цвета как моря, так и леса."
                            }
                        },
                        {
                            "text": "Linguists use the word <w>grue</w> when translating texts from cultures that do not distinguish blue from green.",
                            "target_lang_translations": {
                                "ru": "Лингвисты используют слово <w>«зиний»</w> при переводе текстов культур, которые не отличают синий от зеленого."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grue language",
                        "grue term"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic technical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначение единой цветовой категории, включающей как зеленый, так и синий цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зиний",
                                "target_lang_sense_clarification": "лингвистический термин для сине-зеленого"
                            },
                            {
                                "target_lang_word": "сине-зеленый",
                                "target_lang_sense_clarification": "описание цвета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbedb3db-e486-3a85-8297-14bec78ea762",
                    "sense_definition": "A property of an object that is green if observed before a certain time and blue if observed after.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>grue</w> property is a famous example used in the philosophy of induction.",
                            "target_lang_translations": {
                                "ru": "Свойство <w>«зиний»</w> — известный пример, используемый в философии индукции."
                            }
                        },
                        {
                            "text": "According to the paradox, an emerald observed now is both green and <w>grue</w>.",
                            "target_lang_translations": {
                                "ru": "Согласно парадоксу, изумруд, наблюдаемый сейчас, является одновременно зеленым и <w>«зиним»</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grue property",
                        "grue paradox"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophical technical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство объекта быть зеленым до определенного времени и синим после него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«зиний»",
                                "target_lang_sense_clarification": "философский термин Нельсона Гудмена"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ed54a0c2-002d-32d7-aa58-dfb6d768b0a0",
                    "sense_definition": "A municipality located in the Innlandet region of Norway.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The administrative center of <w>Grue</w> is the village of Kirkenær.",
                            "target_lang_translations": {
                                "ru": "Административным центром <w>Груэ</w> является деревня Киркенеэр."
                            }
                        },
                        {
                            "text": "Many tourists visit <w>Grue</w> to explore the scenic landscapes of eastern Norway.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Груэ</w>, чтобы изучить живописные ландшафты восточной Норвегии."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Муниципалитет, расположенный в регионе Иннландет в Норвегии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Груэ",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}