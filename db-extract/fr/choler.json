                ],
                "senses": [
                    {
                        "sense_id": "4fa9f03c-d3dd-3b6d-99ca-03e1d63eee78",
                        "entry_id": "84e0a9e0-2652-32be-8672-39a9412ba72b",
                        "glosses": [
                            "Jouer à la chole."
                        ],
                        "tags": [
                            "Picardie"
                        ],
                        "examples": [
                            {
                                "example_id": "87fa40a2-d95c-4dfa-adc5-1e50818fa3cd",
                                "sense_id": "4fa9f03c-d3dd-3b6d-99ca-03e1d63eee78",
                                "text": "Pour corser le jeu, les équipes sont divisées en deux camps : ceux qui cholent en direction de la tonne et ceux qui décholent, renvoyant la cholette au diable vauvert selon une fréquence invariable."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9a2d8be-9515-34fc-b6b2-04d1ad5f2c86",
                        "entry_id": "84e0a9e0-2652-32be-8672-39a9412ba72b",
                        "glosses": [
                            "Bousculer, chahuter."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "30e54d6f-efe4-47bb-ac98-098c9044ff03",
                                "sense_id": "e9a2d8be-9515-34fc-b6b2-04d1ad5f2c86",
                                "text": "Ce jeu exigeait la rase campagne pour les grands ébattements auxquels il donnait lieu, et malheur à celui qui se laissait trop engager dans la mêlée, il était cholé (blessé), suivant notre expression picarde encore usitée."
                            },
                            {
                                "example_id": "91a098d4-6185-43c4-9933-cb536e79df1f",
                                "sense_id": "e9a2d8be-9515-34fc-b6b2-04d1ad5f2c86",
                                "text": "Sur la côte picarde les marins pêcheurs sur leurs bateaux par mauvais temps se retrouvaient cholés quand la tempête les surprenait et que les bateaux roulaient bord sur bord."
                            }
                        ]
                    }
                ],
