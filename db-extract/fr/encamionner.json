                "senses": [
                    {
                        "sense_id": "5f201da8-2f5a-3ea0-9d68-83da2dbb1def",
                        "entry_id": "63bacc89-6d70-3739-942e-2f2c68938fe2",
                        "glosses": [
                            "Charger dans un camion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547f74cd-8b2a-4a66-8faa-99da747e8478",
                                "sense_id": "5f201da8-2f5a-3ea0-9d68-83da2dbb1def",
                                "text": "Il y a tout simplement des visiteurs de bennes, qui circulent la nuit et qui encamionnent tout ce qui est négociable…"
                            },
                            {
                                "example_id": "ed5affe8-6f2f-4e69-a494-ef26c18ae5a6",
                                "sense_id": "5f201da8-2f5a-3ea0-9d68-83da2dbb1def",
                                "text": "Eh non: il faut plutôt emprunter camion et remorque, et aller rejoindre les bûches (elles ne font rien par elles-mêmes, c’est un scandale!). Les encamionner…"
                            }
                        ]
                    }
