                "senses": [
                    {
                        "sense_id": "2496703e-b2a1-38e4-a713-d53281a22be5",
                        "entry_id": "50351f14-01b0-3c5d-ace0-cc6793cabe75",
                        "glosses": [
                            "jemand, der sich für jemanden ausspricht/einsetzt; Fürsprecher"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b3a68c29-7996-43dd-9d51-af3b952f2ca8",
                                "sense_id": "2496703e-b2a1-38e4-a713-d53281a22be5",
                                "text": "„Auch brauchen ja gerade armer Leute Kinder einen mächtigen Fürsprech im Himmel. Wir wollen ihn Andreas taufen. Das ist ein gar vornehmer Heiliger gewesen; man hat selbst Könige nach ihm genannt, und sogar unser Herr Bürgermeister heißt so.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b64bf79-0183-35f4-a6c2-559e9697d612",
                        "entry_id": "50351f14-01b0-3c5d-ace0-cc6793cabe75",
                        "glosses": [
                            "staatlich geprüfter und zur Rechtsberatung zugelassener Jurist, der freiberuflich tätig ist und der seine Auftraggeber bei Gericht sowie außergerichtlich vertritt; Rechtsanwalt"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "9c324311-3acf-43fb-a365-42e6267697ea",
                                "sense_id": "3b64bf79-0183-35f4-a6c2-559e9697d612",
                                "text": "„Der Solothurner Kantonsrat hat den 46-jährigen Fürsprech und Notar Andreas Eng zum neuen Staatsschreiber gewählt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
