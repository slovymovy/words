                    {
                        "sense_id": "858773a0-2d3b-359c-b5b8-e23065540e95",
                        "entry_id": "f259b77b-37b4-35c8-a7e3-6a9f16debce9",
                        "glosses": [
                            "in die Vergangenheit gerichtete, „prognostische“ Aussage; Rekonstruktion von etwas Vergangenem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f24275-0137-4351-9ed0-310e9d3442cf",
                                "sense_id": "858773a0-2d3b-359c-b5b8-e23065540e95",
                                "text": "„Die Vorhersage eines vergangenen, aber unbekannten Zustandes ist eine Retrognose.“"
                            },
                            {
                                "example_id": "73baccda-4258-419c-86b7-19c1fbb6651c",
                                "sense_id": "858773a0-2d3b-359c-b5b8-e23065540e95",
                                "text": "„Die Prognose als Vorhersage von Ereignissen auf der Basis erkannter Ursachen-Wirkungs-Zusammenhänge stützt sich als 2. Teil der Theorienbildung auf Erklärungen ab und macht eine zukunftsbezogene Aussage; der weniger bedeutsame Fall ihres Gebrauchs für in der Vergangenheit liegende Ereignisse wird Retrognose genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
