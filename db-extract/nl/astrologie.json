                "senses": [
                    {
                        "sense_id": "3656792e-56e2-3e3a-8bd6-a520251cecda",
                        "entry_id": "a6a532a9-143e-354d-9389-b12fd13a0e90",
                        "glosses": [
                            "de leer die gebeurtenissen aan het hemelgewelf in verband brengt met gebeurtenissen op aarde"
                        ],
                        "tags": [],
                        "examples": [
