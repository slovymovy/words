                "senses": [
                    {
                        "sense_id": "f69672fc-9734-38be-b84b-187fdca80a43",
                        "entry_id": "38aaf615-e62f-3571-994b-58fae3433881",
                        "glosses": [
                            "Störenfried, Unruhestifter, Agitator, Aufwiegler"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce5c5496-c226-44f4-bb3b-3f762ec5fbfb",
                        "source_entry_id": "38aaf615-e62f-3571-994b-58fae3433881",
                        "source_sense_id": "f69672fc-9734-38be-b84b-187fdca80a43",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Störenfried",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Störenfried",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                        "entry_id": "611aa1ce-e74f-37ff-8421-a1b215f1e846",
                                        "glosses": [
                                            "Person, die mit ihren Handlungen etwas/jemanden stört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb1e6cc-81b0-439e-b57e-54303fbd4bb7",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "Der Lehrer schickte den Störenfried vor die Tür."
                                            },
                                            {
                                                "example_id": "55879b65-cba4-4b7a-a1f2-15de2b578472",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "Ein Störenfried ist häufig unbeliebt."
                                            },
                                            {
                                                "example_id": "3ea9501e-1cca-43da-a786-4a1b37d5b219",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Dann putzte er das Monokel und schwieg, ohne den Blick von den Störenfrieden abzuwenden.“"
                                            },
                                            {
                                                "example_id": "1a536f46-fa07-4a91-84bd-03f811c691f3",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Dieser Störenfried muss nicht nur ignoriert, sondern aktiv unterdrückt werden.“"
                                            },
                                            {
                                                "example_id": "52679984-2865-4110-b73e-2c55bc35c49e",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Die einmütige Wut aber richtete sich gegen den unbekannten Neuling, diesen unerwünschten Eindringling und Störenfried.“"
                                            },
                                            {
                                                "example_id": "8e5d9ca5-1882-41fd-a87b-b9130054d05b",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "[Andrij Melnyk:] „Der Botschafter der Ukraine in Berlin ist für die einen eine hoch geachtete politische Person, für andere ein Störenfried.“"
                                            },
                                            {
                                                "example_id": "a95c8132-2e75-43db-b277-0e452d03fdc3",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„»Die neue Regierung betrachtet die Umweltschützer nicht mehr als lästige Störenfriede, sondern sieht uns als Partner«, sagt Ali.“"
                                            },
                                            {
                                                "example_id": "1b2cfbaf-5079-4eb8-b7ca-d4240c88ddf4",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "[Matthias Willenbacher:] „»Leute, die mit Kohle- und Atomkraftwerken Geld verdienen, und die Politiker, die diese Unternehmen unterstützen, sehen mich mit Sicherheit als Störenfried.«“"
                                            },
                                            {
                                                "example_id": "79018d6e-3570-426e-82c1-3c99f28ddd55",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Vielleicht hätte er sich doch noch zurückhalten können; aber es verging kein Tag, ohne dass beim Fürsten Wassilij, der sonst selten Gäste empfing, eine Soiree stattgefunden hätte, an der Pierre teilnehmen musste, wenn er nicht als Störenfried wirken und die allgemeine Erwartung enttäuschen wollte.“"
                                            },
                                            {
                                                "example_id": "c492245a-2945-4fcd-a4d2-db005b99e849",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "Durchgehend werden in der rechten Presse Polens die Migranten an der Grenze nicht als hilfsbedürftige Menschen, sondern als fremde Störenfriede dargestellt."
                                            },
                                            {
                                                "example_id": "1f8fa8d1-fd0f-41a7-bde3-8e26e97004b0",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Für den britischen Philosophen John Stuart Mill sind wir als Gesellschaft auf Pluralismus, auf Störenfriede und Exzentriker angewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43031edd-bf40-4f77-83ab-32be9f179fc3",
                        "source_entry_id": "38aaf615-e62f-3571-994b-58fae3433881",
                        "source_sense_id": "f69672fc-9734-38be-b84b-187fdca80a43",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Unruhestifter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unruhestifter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6fc027a-1306-3376-8097-ddf342eb6fa9",
                                        "entry_id": "d3741a49-b530-33d5-a5b4-4ae5e47e2697",
                                        "glosses": [
                                            "jemand, der Unruhe stiftet oder etwas, das Unruhe stiftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d60bed-e143-4416-adbf-f621fb053e52",
                                                "sense_id": "c6fc027a-1306-3376-8097-ddf342eb6fa9",
                                                "text": "„[…] Er machte dabei erneut Russland als Unruhestifter in der Ostukraine aus: ‚Es ist klar, dass russische Spezialkräfte und Agenten der Katalysator hinter dem Chaos der vergangenen 24 Stunden waren.‘“"
                                            },
                                            {
                                                "example_id": "87167e53-ae1e-4964-aca1-c10f9157da85",
                                                "sense_id": "c6fc027a-1306-3376-8097-ddf342eb6fa9",
                                                "text": "„Unruhestifter waren nach den Angaben der naturgemäß einseitig urteilenden römischen Quellen die jenseits des Hadrianswalls siedelnden Kaledoniert und Mäaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51e8bbe8-0564-4dcd-a254-b7d00ffc6b83",
                        "source_entry_id": "38aaf615-e62f-3571-994b-58fae3433881",
                        "source_sense_id": "f69672fc-9734-38be-b84b-187fdca80a43",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Agitator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agitator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                        "entry_id": "a448202b-2e06-3a68-9e5d-68459b519937",
                                        "glosses": [
                                            "jemand, der durch anspornende oder aufhetzende Reden oder Schriften, Menschenmassen zu bestimmten gemeinsamen Handlungen bewegen möchte; Person, die Agitation betreibt"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83f20bc3-26cb-487f-a057-b570c0c03c33",
                                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                                "text": "„François Noël Babeuf, genannt Gracchus Babeuf […] war Journalist und ein linksrevolutionärer französischer Agitator während der ersten französischen Revolution.“"
                                            },
                                            {
                                                "example_id": "ee7a7348-c34c-4191-9dde-06b5fac1e466",
                                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                                "text": "„Anders als seine Mitstreiter sieht er [Gábor Vona] harmlos aus: blauer Strickpullover, darunter ein gestreiftes Businesshemd, die braunen Augen blicken sanft. Dabei ist der 30-Jährige der gefährlichste Agitator im Magyarenland.“"
                                            },
                                            {
                                                "example_id": "2b761eab-91f4-4341-be39-e5b05488dafa",
                                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                                "text": "„Kaum verschlüsselt schildert der Autor den Auftritt eines charismatischen politischen Agitators, dem bald die Massen zuströmen sollten.“"
                                            },
                                            {
                                                "example_id": "9fc8d94d-438e-4fcb-befe-204144c73a58",
                                                "sense_id": "9e796fca-3df0-3fd2-9647-1b19406a6712",
                                                "text": "„Für das Empfinden bürgerlicher Ästheten hatte der Dichter zugunsten des Agitators abgedankt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "929af51a-1433-4ef6-87a9-3b23139bb90a",
                        "source_entry_id": "38aaf615-e62f-3571-994b-58fae3433881",
                        "source_sense_id": "f69672fc-9734-38be-b84b-187fdca80a43",
