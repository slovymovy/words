{
    "word_family": [
        "leisure",
        "leisured"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36b68ed9-f602-35bc-9565-f5a31f3fff33",
                    "sense_definition": "Characterized by leisure; taking plenty of time; unhurried.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a <w>leisurely</w> breakfast on Sunday morning while reading the newspaper.",
                            "target_lang_translations": {
                                "de": "Wir genossen am Sonntagmorgen ein <w>gemütliches</w> Frühstück, während wir die Zeitung lasen.",
                                "pl": "W niedzielny poranek zjedliśmy <w>niespieszne</w> śniadanie, czytając gazetę."
                            }
                        },
                        {
                            "text": "They took a <w>leisurely</w> stroll through the park to enjoy the autumn leaves.",
                            "target_lang_translations": {
                                "de": "Sie machten einen <w>gemächlichen</w> Spaziergang durch den Park, um das Herbstlaub zu genießen.",
                                "pl": "Wybrali się na <w>niespieszny</w> spacer po parku, aby podziwiać jesienne liście."
                            }
                        }
                    ],
                    "synonyms": [
                        "leisured"
                    ],
                    "antonyms": [
                        "hurried",
                        "rushed"
                    ],
                    "common_phrases": [
                        "leisurely stroll",
                        "leisurely pace",
                        "leisurely breakfast"
                    ],
                    "target_lang_definitions": {
                        "de": "Geprägt von Muße; sich viel Zeit lassend; ohne Eile oder Hektik.",
                        "pl": "Charakteryzujący się spokojem, brakiem pośpiechu; niespieszny."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gemächlich",
                                "target_lang_sense_clarification": "langsam und ohne Eile"
                            },
                            {
                                "target_lang_word": "entspannt",
                                "target_lang_sense_clarification": "ruhig und stressfrei"
                            },
                            {
                                "target_lang_word": "geruhsam",
                                "target_lang_sense_clarification": "voll von Ruhe und Muße"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niespieszny",
                                "target_lang_sense_clarification": "taki, który nie wymaga pośpiechu"
                            },
                            {
                                "target_lang_word": "spokojny",
                                "target_lang_sense_clarification": "odbywający się bez pośpiechu i stresu"
                            },
                            {
                                "target_lang_word": "powolny",
                                "target_lang_sense_clarification": "odbywający się w wolnym tempie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dee019c4-0c99-347a-bd12-9c47229dfd62",
                    "sense_definition": "In an unhurried or relaxed manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked <w>leisurely</w> down the street, stopping to look in every shop window.",
                            "target_lang_translations": {
                                "de": "Sie ging <w>gemächlich</w> die Straße hinunter und hielt an, um in jedes Schaufenster zu schauen.",
                                "pl": "Słała <w>niespiesznie</w> ulicą, zatrzymując się, by zajrzeć do każdej witryny sklepowej."
                            }
                        },
                        {
                            "text": "The river flowed <w>leisurely</w> through the quiet valley.",
                            "target_lang_translations": {
                                "de": "Der Fluss floss <w>träge</w> durch das ruhige Tal.",
                                "pl": "Rzeka płynęła <w>powoli</w> przez cichą dolinę."
                            }
                        }
                    ],
                    "antonyms": [
                        "hurriedly",
                        "hastily"
                    ],
                    "common_phrases": [
                        "walk leisurely",
                        "stroll leisurely"
                    ],
                    "target_lang_definitions": {
                        "de": "In einer entspannten, ruhigen Art und Weise, ohne sich zu beeilen.",
                        "pl": "W sposób niespieszny, zrelaksowany, bez pośpiechu."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gemächlich",
                                "target_lang_sense_clarification": "langsam und in aller Ruhe"
                            },
                            {
                                "target_lang_word": "ohne Eile",
                                "target_lang_sense_clarification": "ohne Hektik oder Zeitdruck"
                            },
                            {
                                "target_lang_word": "gemütlich",
                                "target_lang_sense_clarification": "in einer behaglichen, entspannten Weise"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niespiesznie",
                                "target_lang_sense_clarification": "w sposób niewymagający pośpiechu"
                            },
                            {
                                "target_lang_word": "powoli",
                                "target_lang_sense_clarification": "w wolnym tempie"
                            },
                            {
                                "target_lang_word": "bez pośpiechu",
                                "target_lang_sense_clarification": "spokojnie, bez presji czasu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}