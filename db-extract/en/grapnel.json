                                        "glosses": [
                                            "zaostrzony, długi drąg z hakiem używany w pożarnictwie i żeglarstwie, również jako prymitywna broń drzewcowa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7650f7c-3973-459f-9d10-c5a59aac3bb5",
                                                "sense_id": "969c1eb8-955b-3eab-b0d4-f8514ec7629a",
                                                "text": "(…) przygotowano drabiny, pęki chrustu, wory z piaskiem, bosaki, i pod wieczór tłum, zbrojny po większej części tylko w szable, począł ściągać się w miejsce, gdzie podkopy i ziemne osłony przymykały najbliżej do fosy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
