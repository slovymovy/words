                "senses": [
                    {
                        "sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                        "entry_id": "8d6e2fc6-c75b-36dc-a5e2-1d09802d3658",
                        "glosses": [
                            "zu den Stachelhäutern gehörendes, in Meeren lebendes wirbelloses Tier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86470fe7-a2ec-412a-b5a7-766956175c57",
                                "sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                                "text": "Sie sehen aus wie träge, stachelige Würste und leben am Meeresgrund. Doch wer eine Seegurke reizt, erfährt ihr übles Geheimnis."
                            },
                            {
                                "example_id": "55e18e67-7854-4797-8742-1bfc8436811a",
                                "sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                                "text": "„Noch heute ist die Zahl der Muscheln, Seegurken und Seeigel dort deutlich höher als auf nicht terrassierten Stränden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e1fe672-4fa2-464a-88bb-bf0996285398",
                        "source_entry_id": "8d6e2fc6-c75b-36dc-a5e2-1d09802d3658",
                        "source_sense_id": "192a63fc-95da-3d44-a697-eb71ffc3e1d0",
                        "source_sense_description": "Zoologie: zu den Stachelhäutern gehörendes, in Meeren lebendes wirbelloses Tier",
