                                        "entry_id": "40cd286e-d595-3466-95b2-2d15f0f5aa4a",
                                        "glosses": [
                                            "Wegfall eines oder mehrerer Laute oder auch einer Silbe am Wortende; im Deutschen besonders des unbetonten Endungs-e – Dativ-e; meist mit dem Satzzeichen Apostroph angezeigt"
                                        ],
                                        "tags": [
                                            "Philologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91366cc8-e117-4842-bd5a-0de37617de40",
                                                "sense_id": "dcb65fa1-06af-371d-93a8-6f7725aec26a",
                                                "text": "Apokopen im Deutschen sind: „ich geh fort“ statt „ich gehe fort“ oder „wart“ statt „warte“."
                                            },
                                            {
                                                "example_id": "ac2a32cb-fdc5-4caa-aef7-f437a9cb8d84",
                                                "sense_id": "dcb65fa1-06af-371d-93a8-6f7725aec26a",
                                                "text": "Die Apokope ist vor allem im Oberdeutschen, im südlichen Mitteldeutschen sowie im nördlichen Niederdeutschen verbreitet."
                                            },
                                            {
                                                "example_id": "71300a10-ebc1-414d-b886-5bcf23d8288f",
                                                "sense_id": "dcb65fa1-06af-371d-93a8-6f7725aec26a",
                                                "text": "Die Apokope des „Schwa“ in Auslautposition tritt im Mittelniederländischen häufig auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
