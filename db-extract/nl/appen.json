                ],
                "senses": [
                    {
                        "sense_id": "b30da60b-1d2a-3ec8-9e3c-5fb61d1a511e",
                        "entry_id": "c55a02da-8663-3aa9-8063-323226a9f7fc",
                        "glosses": [
                            "tekstberichten versturen met een smartphone"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "99584891-5270-46ad-af37-efb2c7519b2a",
                                "sense_id": "b30da60b-1d2a-3ec8-9e3c-5fb61d1a511e",
                                "text": "Ik heb je al geappt."
                            },
                            {
                                "example_id": "bc67a0b4-0eff-4857-8876-838370dba8e6",
                                "sense_id": "b30da60b-1d2a-3ec8-9e3c-5fb61d1a511e",
                                "text": "\"Misschien was je telefoon kapot\", probeerde ze een opening te zoeken in de dichte doornenhaag van verbittering. \"Dan kan ze toch appen!\". Hoe dat zou moeten, met een kapotte telefoon,vroeg ik mij fronsend af, maar was wel wijzer om het hardop te vragen."
                            },
                            {
                                "example_id": "6016d364-f819-447e-b9b3-2f7e2cb913eb",
                                "sense_id": "b30da60b-1d2a-3ec8-9e3c-5fb61d1a511e",
                                "text": "De Amsterdamse politie heeft maandag de eerste zes bekeuringen uitgedeeld wegens het appen op de fiets."
                            },
                            {
                                "example_id": "530b3747-10cd-4e93-8bae-2640cf7d8e15",
                                "sense_id": "b30da60b-1d2a-3ec8-9e3c-5fb61d1a511e",
                                "text": "Ik heb de kinderen gezegd dat ik een week slecht bereik heb en dat ze met hun vragen naar papa moeten gaan. Die weet heus ook wel waar de krentenbollen, gymtassen en huiswerkroosters liggen. En inderdaad, ze appen niet. Dat is goed. Tegelijkertijd word ik er gek van niet te weten hoe het gaat."
                            }
                        ]
                    }
                ],
