                "senses": [
                    {
                        "sense_id": "9f57bd91-a2a4-3301-8ed5-b9ed486b8199",
                        "entry_id": "b7c50610-63fe-394f-84be-f34c7c30c322",
                        "glosses": [
                            "Mec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5aa86ec-970e-44e4-92ab-019690a9a674",
                                "sense_id": "9f57bd91-a2a4-3301-8ed5-b9ed486b8199",
                                "text": "Soi-disant c'était la ministre des Jeunes et du Sport (Michèle Alliot-Marie). Tu aurais vu la yeuve(vieille), elle était habillée en tailleur et en talons aiguilles. Tu avais dix keums pour surveiller son keuss (sac)."
                            },
                            {
                                "example_id": "844e5de9-73e6-4ad7-99d4-7578c7bdf12b",
                                "sense_id": "9f57bd91-a2a4-3301-8ed5-b9ed486b8199",
                                "text": "Ça boit, ça fume, ça parle comme dans les cités et ça s’échange des paroles du type : « Hollande a flingué Fabius avec son référendum, vous avez vu ça, un vrai killer, le keum »."
                            },
                            {
                                "example_id": "9c789aef-edde-441b-bbe2-0dacc5c2bfc7",
                                "sense_id": "9f57bd91-a2a4-3301-8ed5-b9ed486b8199",
                                "text": "Bizarre que le prof soit avec un keum aussi crade. Lui qui était toujours avec ses chemises blanches et ses petits foulards…"
                            }
                        ]
                    }
                ],
