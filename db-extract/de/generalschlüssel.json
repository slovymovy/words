                    },
                    {
                        "translation_id": "b6ee86c4-6d2b-4bc0-a005-ece45deb03f0",
                        "source_entry_id": "c4204292-0a2c-312f-a309-521d8c12b41e",
                        "source_sense_id": "23b4b8f3-4857-3681-bd78-2ec21524ef49",
                        "source_sense_description": "Schlüssel, der in allen Schlössern eines Schließsystems schließt",
                        "target_lang_word": "passkey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passkey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0111c58-2d34-30fd-9de6-d1ab4d3cc113",
                                        "entry_id": "a064a113-fe66-3f8c-b41d-f0b665cc6d8d",
                                        "glosses": [
                                            "A key, especially in a hotel, that allows someone in authority to open any door."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94075d9f-c3c3-404f-8566-f74d0d7b833d",
                                                "sense_id": "b0111c58-2d34-30fd-9de6-d1ab4d3cc113",
                                                "text": "With the universal pass-key of imagination we open the dingy door, pass down a dark passage and up a narrow stair."
                                            },
                                            {
                                                "example_id": "b6ace206-4345-456a-8451-d8d4716575db",
                                                "sense_id": "b0111c58-2d34-30fd-9de6-d1ab4d3cc113",
                                                "text": "Jourdain stood by with a quiet sad smile, holding his passkey in his hand, and giving me time to take it all in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e495724-1679-342f-955b-5bb57f65ae6e",
                                        "entry_id": "a064a113-fe66-3f8c-b41d-f0b665cc6d8d",
                                        "glosses": [
                                            "A key for entering a house or other building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cdc2959-efa2-4236-82c3-c38c547c746e",
                                                "sense_id": "6e495724-1679-342f-955b-5bb57f65ae6e",
                                                "text": "Now, Balmy, here's the passkey to that house. The windows are wired, but the front door isn't. Get inside that door as quietly as you can, and find out as much as you can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704eee84-315c-3797-9a70-52a1d1b696b3",
                                        "entry_id": "a064a113-fe66-3f8c-b41d-f0b665cc6d8d",
                                        "glosses": [
                                            "A cryptographic key that is tied to specific devices or cloud accounts and is meant to be used instead of a password."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d29f0816-fb92-4a93-8ae0-6befb97ad61f",
                                                "sense_id": "704eee84-315c-3797-9a70-52a1d1b696b3",
                                                "text": "Based on FIDO standards, passkeys are a replacement for passwords that provide faster, easier, and more secure sign-ins to websites and apps across a user's devices. Unlike passwords, passkeys are always strong and phishing-resistant. Passkeys simplify account registration for apps and websites, are easy to use, work across most of a user's devices, and even work on other devices within physical proximity. Why passkeys? Passwords are a problem."
                                            },
                                            {
                                                "example_id": "b0168360-26b3-4dd2-8f2b-7783412c970e",
                                                "sense_id": "704eee84-315c-3797-9a70-52a1d1b696b3",
                                                "text": "Sign in with passkeys on iPhone / Passkeys give you a simple and secure way to sign in without passwords by relying on Face ID (supported models) or Touch ID (supported models) to identify you when you sign in to supporting websites and apps. / Intro to passkeys / Based on industry standards for account authentication, passkeys are easier to use than passwords and far more secure. A passkey is a cryptographic entity that's not visible to you, and it's used in place of a password. A passkey consists of a key pair, which—compared to a password—profoundly improves security. One key is public, registered with the website or app you're using. The other key is private, held only by your devices."
                                            },
                                            {
                                                "example_id": "3c3f0873-6da5-425c-a376-e81db350e982",
                                                "sense_id": "704eee84-315c-3797-9a70-52a1d1b696b3",
                                                "text": "Google is starting to nudge users to try out passkeys, a replacement for traditional passwords that can stop phishing attacks and make sign-ins easier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f852825d-741f-3b44-b0bf-a10ae8a64fca",
                                        "entry_id": "a064a113-fe66-3f8c-b41d-f0b665cc6d8d",
                                        "glosses": [
                                            "Synonym of password."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec6e22a1-af38-4689-b779-ba8cddcc801a",
                                                "sense_id": "f852825d-741f-3b44-b0bf-a10ae8a64fca",
                                                "text": "The router then generates a random numeric passkey and delivers it to the user […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7a8e7f8-2656-4a52-95eb-c5e89d260d13",
                        "source_entry_id": "c4204292-0a2c-312f-a309-521d8c12b41e",
