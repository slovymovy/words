    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76c94831-2c54-39da-866b-5c2ef8f8f755",
                    "sense_definition": "плохое физическое самочувствие, головная боль и жажда на следующий день после употребления алкоголя",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "похмельное_состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После шумной вечеринки у него с утра был ужасный <w>бодун</w>.",
                            "target_lang_translations": {
                                "en": "After the wild party, he had a terrible <w>hangover</w> in the morning."
                            }
                        },
                        {
                            "text": "Он выпил стакан холодной воды, чтобы хоть немного облегчить тяжелый <w>бодун</w>.",
                            "target_lang_translations": {
                                "en": "He drank a glass of cold water to at least slightly relieve his severe <w>hangover</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "похмелье",
                        "сушняк"
                    ],
                    "common_phrases": [
                        "с бодуна",
                        "тяжелый бодун"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное выражение"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a state of physical unwellness, headache, and thirst experienced the day after drinking alcohol"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hangover",
                                "target_lang_sense_clarification": "after-effects of heavy alcohol consumption"
                            },
                            {
                                "target_lang_word": "morning after",
                                "target_lang_sense_clarification": "informal, referring to a hangover state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71bf880e-b36a-3d85-9e8f-9d3982ad4cfc",
                    "sense_definition": "животное или человек, имеющие обыкновение или склонность бодаться",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "бодающийся",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Осторожнее подходи к этому козлу, он настоящий <w>бодун</w>.",
                            "target_lang_translations": {
                                "en": "Be careful approaching that goat, he is a real <w>butter</w>."
                            }
                        },
                        {
                            "text": "Молодой бычок оказался задиристым <w>бодуном</w> и пугал всех во дворе.",
                            "target_lang_translations": {
                                "en": "The young bull turned out to be a feisty <w>headbutter</w> and scared everyone in the yard."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "диалектное слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an animal or person prone to butting with horns or head"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "butter",
                                "target_lang_sense_clarification": "an animal or person that butts"
                            },
                            {
                                "target_lang_word": "headbutter",
                                "target_lang_sense_clarification": "someone or an animal that butts with the head"
                            }
                        ]
                    }
                }
            ]
        }
    ]
