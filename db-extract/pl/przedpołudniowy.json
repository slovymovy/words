                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfcba76d-6277-458c-84f6-55da0eda1e6e",
                        "source_entry_id": "7c484da1-77e0-3404-ba8c-d5833d4916e2",
                        "source_sense_id": "f91de217-63cb-367e-bb31-3bd3e367e822",
                        "target_lang_word": "antemeridian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antemeridian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83d776d3-7f32-3d84-b36e-4c7ba1d1c964",
                                        "entry_id": "6b53d25a-1477-3a7e-8241-253eed7f6769",
                                        "glosses": [
                                            "Of or relating to morning; that happens in the morning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "569b8bb9-6b03-4dd9-814b-67d6280408ad",
                        "source_entry_id": "7c484da1-77e0-3404-ba8c-d5833d4916e2",
                        "source_sense_id": "f91de217-63cb-367e-bb31-3bd3e367e822",
                        "target_lang_word": "forenoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forenoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                        "entry_id": "4f325957-b1df-30e3-898d-593c969073a9",
                                        "glosses": [
                                            "Synonym of morning: the part of the day between sunrise and noon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb3566f-df64-4117-9c91-bfd328f8d189",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "You are ambitious for poor knaves' caps and legs; you wear out a good wholesome forenoon in hearing a cause between an orange-wife and a fosset-seller, and then rejourn the controversy of threepence to a second day of audience."
                                            },
                                            {
                                                "example_id": "8388a81c-168f-487e-880e-f23c141d4712",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "Later in the forenoon the gale increased more and more; the seas set in, and the waves grew bigger and bigger[.]"
                                            },
                                            {
                                                "example_id": "05ff34b2-4816-4b9a-803f-8d424e92f330",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "This, too, was why no one, not even the twins, paid Papa O. any heed when the family returned from Mass one Sunday forenoon and he told them someone had been knocking while they were away."
                                            },
                                            {
                                                "example_id": "59263fdd-4708-4a53-ac3b-8bac677142e2",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "A hot sun burned down on us. Ten times during a single forenoon every stitch of clothes on one's body was soaked with perspiration, and ten times it dried again."
                                            },
                                            {
                                                "example_id": "dbd88d10-72d1-401a-a808-78cdde5cecfa",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "It was run in by Ranochan of Polmadie on the forenoon slow to Carlisle and the afternoon slow back to the North."
                                            },
                                            {
                                                "example_id": "d2eb1078-686b-41ed-991e-1700adc28562",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "Desire to be alone in forenoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
