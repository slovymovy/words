                "senses": [
                    {
                        "sense_id": "749e3433-3097-3327-aa54-882d482fd559",
                        "entry_id": "3f18eccd-1e88-3ec7-851c-00b2c556cb9b",
                        "glosses": [
                            "Kampf oder intensives Bemühen, um Freiheit zu erreichen, meist gegen einen Unterdrücker oder ein System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492b8ddd-47f0-4a7e-85bf-73302e4c9953",
                                "sense_id": "749e3433-3097-3327-aa54-882d482fd559",
                                "text": "Der Freiheitskampf im Iran wurde niedergeschlagen."
                            },
                            {
                                "example_id": "7649067f-2f6a-42dd-977c-99833c07b859",
                                "sense_id": "749e3433-3097-3327-aa54-882d482fd559",
                                "text": "„Er ist noch keine 34, gilt inzwischen aber als der wortmächtigste Anführer im Freiheitskampf der Schwarzen.“"
                            },
                            {
                                "example_id": "2621961c-5f79-448a-a6f2-44d7504067be",
                                "sense_id": "749e3433-3097-3327-aa54-882d482fd559",
                                "text": "„Viele historische Figuren, die wir heute für ihren mutigen Freiheitskampf bewundern, hatten ihre ganz eigene Auffassung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
