                            {
                                "example_id": "e26e16e2-01c7-478d-8a44-44a9f32d6af5",
                                "sense_id": "eaa577a1-feb3-32ed-8574-13af0ae6fa63",
                                "text": "Codziennie z usług miejskich środków transportu korzysta 7 milionów paryżan"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e835203-8c32-42e0-9d6d-1f326d453e6a",
                        "source_entry_id": "14981960-d4ff-3f26-9f7d-21dbafc94105",
                        "source_sense_id": "eaa577a1-feb3-32ed-8574-13af0ae6fa63",
                        "target_lang_word": "Parisian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "547089c2-375b-38c4-a316-1469e214691b",
                                        "entry_id": "d6cf8ff7-a3d2-30e7-abbb-840ca9128a41",
                                        "glosses": [
                                            "A native, citizen and/or inhabitant of Paris, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b528304-dcf2-49f7-9195-ccc48ea35aa8",
                                                "sense_id": "547089c2-375b-38c4-a316-1469e214691b",
                                                "text": "Not all of France was inundated by the nationalist wave – it was predominantly young, intelligent Parisians who embraced the new bellicism […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Parisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32537e1b-c081-3156-8282-12a510a74c2c",
                                        "entry_id": "de66880e-b0bb-3ee9-908b-758355ca22ab",
                                        "glosses": [
                                            "Of, relating, or pertaining to Paris, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42138cde-4ae1-42e0-ae49-e37b1176438b",
                                                "sense_id": "32537e1b-c081-3156-8282-12a510a74c2c",
                                                "text": "He lived in Paris for ten years, and became more Parisian than the natives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "583d6d60-4647-491f-a1c5-7f36280c8cb2",
                        "source_entry_id": "14981960-d4ff-3f26-9f7d-21dbafc94105",
                        "source_sense_id": "eaa577a1-feb3-32ed-8574-13af0ae6fa63",
                        "target_lang_word": "Pařížan",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pařížan",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c6727441-cf45-30ed-a321-b3010d5f30cf",
                                        "entry_id": "af84481f-0ed8-3066-a4f1-77216524761f",
                                        "glosses": [
                                            "obyvatel Paříže"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecec5b4-f7c9-4788-8213-e5138f2ec63e",
                                                "sense_id": "c6727441-cf45-30ed-a321-b3010d5f30cf",
                                                "text": "Zítra budeš patřit nám // bum bum ratata // bumtarata tram // až vítězně do tvých bran // vtáhne hrdý Pařížan!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8326d178-595a-4944-bf83-613fa6c43d5d",
                        "source_entry_id": "14981960-d4ff-3f26-9f7d-21dbafc94105",
                        "source_sense_id": "eaa577a1-feb3-32ed-8574-13af0ae6fa63",
                        "target_lang_word": "Parisien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parisien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                        "entry_id": "2989af9c-e99c-39ee-8924-b1a9cd035c37",
                                        "glosses": [
                                            "Habitant ou personne originaire de Paris, capitale de la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79701197-9b0b-46a7-bd42-c24c972f0045",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Étant né, comme il est dit, dans un atelier, et l’atelier étant situé rue de l’Ouest, en face du Luxembourg, il était incontestablement Parisien ; ce titre suffisait à sa gloire."
                                            },
                                            {
                                                "example_id": "84b6bf70-748d-421d-8a98-22b53996ff16",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "— Comment ton père n’a-t-il pas senti, dit-il en poursuivant son idée avec véhémence, qu’il est dangereux pour une honnête famille, d’introduire dans son sein, un de ces Parisiens du Paris cosmopolite qui ne peuvent nous apporter que la corruption ?"
                                            },
                                            {
                                                "example_id": "ae9e713b-44e0-458c-86c4-33709175320d",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Donc, oui, définitivement, le Parisien est ultra-sociable."
                                            },
                                            {
                                                "example_id": "5987f53a-4aa3-487f-a1fc-0f1c984dac26",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Non, Madame, non ! C’est un Parisien de Monaco, — l’espèce abonde !"
                                            },
                                            {
                                                "example_id": "9630bb2f-a993-469c-81f8-39b7b6922ec2",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Si on pouvait mettre en présence le personnage que j’étais alors et quelques-uns de ces petits Parisiens de douze ou treize ans élevés par les méthodes les plus perfectionnées et les plus modernes, qui déjà déclament, pérorent, ont des idées en politique, me glacent par leurs conversations, comme ce serait drôle et avec quel dédain ils me traiteraient !"
                                            },
                                            {
                                                "example_id": "e604031a-8166-4bcf-9940-5ffbfd60cb68",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Parisiens, Parisiennes et autre badauds, il vous sera possible d’admirer Eva Longoria, Cindy Bruna et Leïla Bekhti, dimanche, à 20 heures."
                                            },
                                            {
                                                "example_id": "06279587-41f3-4616-9b93-de062dbe5c84",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Toi, te voilà comme le pou sur ses pieds de derrière parce que tu as épousé un Parisien. Et quand je dis un Parisien… Les vrais Parisiens d’origine ont moins de caractère dans la physionomie. On dirait que Paris les efface !"
                                            },
                                            {
                                                "example_id": "7d8a51aa-8d40-4af9-b853-fed33e4c4bea",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "Il commença la conversation sur un ton de politesse et de bonne humeur, comme quelqu’un que tous connaissent. Il admira bientôt des trous d’obus encore frais ; il regarda en l’air et conclut qu’il pourrait bien nous en tomber d’autres. Tout à fait comme un Parisien à la mer."
                                            },
                                            {
                                                "example_id": "d9ce549c-104b-4dbf-afd7-a4c6128d56c0",
                                                "sense_id": "e7404ced-79e1-3d01-8ff1-6a6236157d24",
                                                "text": "La plupart des Parisiens rencontrés au fil des archives criminelles se déplacent en effet à pied, et crotter ses vêtements n'est pas le pire qui puisse arriver au piéton lors de ses déplacements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a0ca8a-ace4-3b4b-82b9-622a3bd2e87b",
                                        "entry_id": "2989af9c-e99c-39ee-8924-b1a9cd035c37",
                                        "glosses": [
                                            "Personne habitante ou originaire de la banlieue parisienne."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e944e55-b33c-4d22-b518-d53037614a28",
                                                "sense_id": "17a0ca8a-ace4-3b4b-82b9-622a3bd2e87b",
                                                "text": "En tant que Parisien — de banlieue, bien entendu (Sourires) — je souhaite cet équilibre nécessaire entre Paris et la province."
                                            },
                                            {
                                                "example_id": "066fd0fd-b796-4657-96e3-37bb29e41b36",
                                                "sense_id": "17a0ca8a-ace4-3b4b-82b9-622a3bd2e87b",
                                                "text": "Il y a encore cinquante ans, au moment de l’élaboration de la politique agricole commune, un paysan du Berry ou de Provence avait une vision du monde et de la vie très différente de celle d’un Parisien de banlieue ou d’un Italien de Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf1d4ea-2d59-3ce3-a064-2bd0d7fa889f",
                                        "entry_id": "2989af9c-e99c-39ee-8924-b1a9cd035c37",
                                        "glosses": [
                                            "Personne venant d’une région étrangère à celle où l’on habite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddea5040-354e-45e0-b08f-b2172a6b7e69",
                                                "sense_id": "cdf1d4ea-2d59-3ce3-a064-2bd0d7fa889f",
                                                "text": "Ceux qui sont pour nous, en bloc, des « Parisiens », ont moqué nos ossuaires, des « granges à os » (mais, pour être tout à fait équitable, il faut dire que les Bretons eux-mêmes les nomment « craou an eskern », des « crèches à os »)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Parisien",
                                "target_lang_code": "fr",
                                "target_senses": [
