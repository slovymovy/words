                    {
                        "translation_id": "8d67272c-0525-455e-ae52-3592aa5d7eac",
                        "source_entry_id": "f6a814db-0555-3e85-b14c-e657677d4826",
                        "source_sense_id": "0b4f046e-bfc1-3cbf-9d39-d558dae929ee",
                        "target_lang_word": "Geiziger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5f45261e-b5e9-4b1d-a770-b73954ca9086",
                        "source_entry_id": "f6a814db-0555-3e85-b14c-e657677d4826",
                        "source_sense_id": "0b4f046e-bfc1-3cbf-9d39-d558dae929ee",
                        "target_lang_word": "Geizhals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geizhals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                        "entry_id": "f0115770-e4cc-38df-a492-9d420a10d5d7",
                                        "glosses": [
                                            "sehr geizige Person; jemand, der sehr wenig Neigung hat, anderen etwas zu geben oder überhaupt etwas auszugeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c71237f-fb21-4ec1-abb2-66ad11217301",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "Dieser Geizhals hat uns in unserer Notlage nicht mal 50 Cent zum Telefonieren gegeben!"
                                            },
                                            {
                                                "example_id": "4b5e09e8-e354-4715-aa58-d97aad856730",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Beinahe wöchentlich stand der Gerichtsvollzieher vor der Tür, um etwas zu pfänden, immer wieder drohte der Rauswurf aus den Wohnungen – vielleicht mit ein Grund, warum mein Vater zeitlebens so erpicht darauf war, Reichtümer anzuhäufen und dennoch lebte wie ein Geizhals, der sich nur das Nötigste gönnte.“"
                                            },
                                            {
                                                "example_id": "4bd5820d-b94f-4edc-82e9-86637af32d68",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Alles ist hier schön an seinem Ort, Hoffmann führt Regie, und wir spüren, daß es ihm sehr viel leichter fällt, einen Maler einen alten Geizhals prellen zu lassen, als einer vornehmen französischen Dame eine Moralpredigt in den Mund zu legen.“"
                                            },
                                            {
                                                "example_id": "d6625696-6dbe-4bf1-8516-ad4165a1de90",
                                                "sense_id": "a4ffe49d-8f94-30de-bd4a-4f3e829e58a4",
                                                "text": "„Der Sohn eines Geizhalses ist verschwenderisch, der Sohn eines Verschwenders ist geizig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
