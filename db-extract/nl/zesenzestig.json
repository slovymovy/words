                        "examples": [
                            {
                                "example_id": "5da2f94a-b039-41db-b858-d9c0c66281f0",
                                "sense_id": "5170e53b-d2c3-3018-b390-e7b38f9f2dc3",
                                "text": "De zesenzestig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
