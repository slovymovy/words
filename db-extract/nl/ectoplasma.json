                    }
                ],
                "senses": [
                    {
                        "sense_id": "49297958-fb75-35cd-9bb4-8541b334216b",
                        "entry_id": "e271ad93-c406-395e-9362-d8527723843f",
                        "glosses": [
                            "buitenste laagje van het protoplasma bij amoeben en sommige cellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6540a849-51a2-4909-9248-47d7cb8c711e",
                                "sense_id": "49297958-fb75-35cd-9bb4-8541b334216b",
                                "text": "Door de toevoeging van die stof verdween het ectoplasma."
                            }
                        ]
                    },
                    {
                        "sense_id": "8475e4b5-cd51-3ada-83fa-a3ac831c2ea9",
                        "entry_id": "e271ad93-c406-395e-9362-d8527723843f",
                        "glosses": [
                            "materiaal waaruit geesten zichtbare lichamen kunnen aannemen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aa2ca0c9-7fcb-3b29-8d70-52e660427b1c",
                        "entry_id": "e271ad93-c406-395e-9362-d8527723843f",
                        "glosses": [
                            "persoon zonder enig begripsvermogen"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "31932617-6906-40f3-8006-d76b601ccaaa",
                                "sense_id": "aa2ca0c9-7fcb-3b29-8d70-52e660427b1c",
                                "text": "Maar terwijl Marokko de Verlichting lijkt te ontdekken, zitten we in Nederland met wandelende overblijfselen van het pre-islamitische tijdperk opgescheept, die graag hun eigen hersenen in boerka’s en nikabs wikkelen. En die comateuze ectoplasma’s zitten allemaal in de Commissie Gelijke Behandeling die zichzelf nu pompeus tot College voor de Rechten van de Mens heeft omgedoopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e5725a2-c47f-4ae3-8816-e74265045801",
                        "source_entry_id": "e271ad93-c406-395e-9362-d8527723843f",
                        "target_lang_word": "Ektoplasma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ektoplasma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb72b838-92bd-3ae9-a81b-fc68c937a004",
                                        "entry_id": "d90863bb-9360-3770-a316-091e1af87cea",
                                        "glosses": [
                                            "Teil des Zytoplasma zwischen der Zellmembram und dem -kern; äußere Schicht des Protoplasmas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2dc5f70-2a35-4450-b637-ff0ff3c3b4dc",
                                                "sense_id": "eb72b838-92bd-3ae9-a81b-fc68c937a004",
                                                "text": "Das Endo- und Ektoplasma lassen sich in ihrer Konsistenz voneinander unterscheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80ba9b7b-d6de-36ef-8af5-190efcb86047",
                                        "entry_id": "d90863bb-9360-3770-a316-091e1af87cea",
                                        "glosses": [
                                            "Bezeichnung eines paranormalen Stoffes, der überwiegend gasförmig ist und angeblich aus den Körperöffnungen eines Mediums¹⁰ oder Sensitiven¹ austritt"
                                        ],
                                        "tags": [
                                            "Parapsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6330e3db-ce56-4cf8-95c4-b64ea7fa2968",
                                                "sense_id": "80ba9b7b-d6de-36ef-8af5-190efcb86047",
                                                "text": "Der Begriff Ektoplasma wird häufig mit spiritueller Chirurgie in Verbindung gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f992a59d-134e-4eb9-8045-b08c4bed897a",
                        "source_entry_id": "e271ad93-c406-395e-9362-d8527723843f",
                        "target_lang_word": "ectoplasm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ectoplasm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "037bba25-1b6a-3bde-8f34-683726ef0a9f",
                                        "entry_id": "d2813e76-445b-38c5-91dc-296b10e60cb1",
                                        "glosses": [
                                            "A visible substance believed to emanate from the body of a spiritualistic medium during communication with the dead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6b5745d-2fb1-4be3-bfbc-5e8a18a39681",
                                                "sense_id": "037bba25-1b6a-3bde-8f34-683726ef0a9f",
                                                "text": "He saw again clearly enough[…]the doctor’s consulting room in the Avenida de la Revolución, visited for some drunken reason in the early hours of the morning, macabre with its pictures of ancient Spanish surgeons, their goat faces rising queerly from ruffs resembling ectoplasm, roaring with laughter as they performed inquisitorial operations; […]"
                                            },
                                            {
                                                "example_id": "fe947a28-6b37-4789-9aa1-5b6e49e03a8c",
                                                "sense_id": "037bba25-1b6a-3bde-8f34-683726ef0a9f",
                                                "text": "Watching as the woman lifted her skirts and flung out ectoplasm, expelled it into a bowl, then brandished it around at her audience wildly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcfda941-31de-3b14-9a76-3b1ce0346fef",
                                        "entry_id": "d2813e76-445b-38c5-91dc-296b10e60cb1",
                                        "glosses": [
                                            "An immaterial or ethereal substance, especially the transparent corporeal presence of a spirit or ghost."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fe625c-86d2-4b24-83e9-36953960521d",
                                                "sense_id": "bcfda941-31de-3b14-9a76-3b1ce0346fef",
                                                "text": "Then came some hollow groanings from inside the cabinet. The Spiritualists sat up expectantly. \"That's ectoplasm,\" said Ogilvy. \"It always causes pain on emission.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d065ac26-d32b-3c12-a1f9-766e5b7e4475",
                                        "entry_id": "d2813e76-445b-38c5-91dc-296b10e60cb1",
                                        "glosses": [
                                            "The outer granule-free layer of cytoplasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afdaf1fc-ed26-4f5b-b98b-8885b1b614b3",
                        "source_entry_id": "e271ad93-c406-395e-9362-d8527723843f",
