    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33fa033d-4639-3027-81a7-2360913a1048",
                    "sense_definition": "Een spraakklank waarbij de luchtstroom ongehinderd door de mond naar buiten komt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het Nederlands heeft vijf basisklinkers: a, e, i, o, u.",
                            "target_lang_translations": {
                                "en": "Dutch has five basic <w>vowels</w>: a, e, i, o, u.",
                                "ru": "В нидерландском языке пять основных <w>гласных</w>: a, e, i, o, u."
                            }
                        },
                        {
                            "text": "In het woord huis vormen de letters u en i samen een <w>klinker</w>.",
                            "target_lang_translations": {
                                "en": "In the word 'huis', the letters u and i together form a <w>vowel</w>.",
                                "ru": "В слове huis буквы u и i вместе образуют один <w>гласный звук</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vocaal"
                    ],
                    "antonyms": [
                        "medeklinker"
                    ],
                    "common_phrases": [
                        "lange klinker",
                        "korte klinker"
                    ],
                    "target_lang_definitions": {
                        "en": "A speech sound produced without any obstruction of the airflow through the mouth.",
                        "ru": "Звук речи, при котором поток воздуха проходит через рот без препятствий."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vowel",
                                "target_lang_sense_clarification": "a speech sound"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гласный",
                                "target_lang_sense_clarification": "звук"
                            },
                            {
                                "target_lang_word": "гласный звук",
                                "target_lang_sense_clarification": "фонетика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68a52ad0-8ffd-312c-b8b2-3e7eb0550033",
                    "sense_definition": "Een letter of teken dat een <w>vocaal</w> voorstelt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De meest voorkomende <w>klinker</w> in het Nederlands is de e.",
                            "target_lang_translations": {
                                "en": "The most common <w>vowel</w> in Dutch is the 'e'.",
                                "ru": "Самая распространенная <w>гласная</w> в нидерландском языке — это e."
                            }
                        },
                        {
                            "text": "Je moet de dubbele <w>klinker</w> schrijven om de klank lang te maken.",
                            "target_lang_translations": {
                                "en": "You must write the double <w>vowel</w> to make the sound long.",
                                "ru": "Нужно писать двойную <w>гласную</w>, чтобы сделать звук долгим."
                            }
                        }
                    ],
                    "synonyms": [
                        "klinkletter"
                    ],
                    "common_phrases": [
                        "dubbele klinker"
                    ],
                    "target_lang_definitions": {
                        "en": "A letter or character representing a vowel sound.",
                        "ru": "Буква или символ, обозначающий гласный звук."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vowel",
                                "target_lang_sense_clarification": "a written letter"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гласная",
                                "target_lang_sense_clarification": "буква"
                            },
                            {
                                "target_lang_word": "гласная буква",
                                "target_lang_sense_clarification": "письменность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "810d9825-d9fb-3031-9d82-756c9d8c0551",
                    "sense_definition": "Een harde baksteen die vaak wordt gebruikt voor het bestraten van wegen of pleinen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De klinkers werden door de stratenmaker zorgvuldig in het zandbed gelegd.",
                            "target_lang_translations": {
                                "en": "The <w>clinkers</w> were carefully laid in the sand bed by the paver.",
                                "ru": "Мостовщик аккуратно укладывал <w>клинкеры</w> на песчаную подушку."
                            }
                        },
                        {
                            "text": "De oude straat is belegd met een rode <w>klinker</w>.",
                            "target_lang_translations": {
                                "en": "The old street is paved with a red <w>brick</w>.",
                                "ru": "Старая улица вымощена красным <w>клинкерным кирпичом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rode klinker",
                        "gebakken klinker"
                    ],
                    "target_lang_definitions": {
                        "en": "A hard brick often used for paving roads or squares.",
                        "ru": "Твердый кирпич, часто используемый для мощения дорог или площадей."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clinker",
                                "target_lang_sense_clarification": "a hard-burned brick"
                            },
                            {
                                "target_lang_word": "paver",
                                "target_lang_sense_clarification": "a brick used for paving"
                            },
                            {
                                "target_lang_word": "brick",
                                "target_lang_sense_clarification": "general building block"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "клинкер",
                                "target_lang_sense_clarification": "вид кирпича"
                            },
                            {
                                "target_lang_word": "клинкерный кирпич",
                                "target_lang_sense_clarification": "строительный материал"
                            },
                            {
                                "target_lang_word": "брусчатка",
                                "target_lang_sense_clarification": "материал для мощения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6732d41-d610-3cf9-aab4-bbc90a55aa1f",
                    "sense_definition": "Iemand die met klinknagels metalen onderdelen aan elkaar vastmaakt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>klinker</w> werkte vroeger op de scheepswerf om de stalen platen te verbinden.",
                            "target_lang_translations": {
                                "en": "The <w>riveter</w> used to work at the shipyard to join the steel plates.",
                                "ru": "<w>Клепальщик</w> раньше работал на верфи, соединяя стальные листы."
                            }
                        },
                        {
                            "text": "Samen met de nageljongen vormde de <w>klinker</w> een onmisbaar team in de metaalindustrie.",
                            "target_lang_translations": {
                                "en": "Together with the rivet boy, the <w>riveter</w> formed an indispensable team in the metal industry.",
                                "ru": "Вместе с подручным <w>клепальщик</w> составлял незаменимую команду в металлургической промышленности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Dit beroep komt in de moderne industrie nauwelijks meer voor."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who fastens metal parts together using rivets.",
                        "ru": "Человек, который соединяет металлические детали с помощью заклепок."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "riveter",
                                "target_lang_sense_clarification": "a person who rivets"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "клепальщик",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
