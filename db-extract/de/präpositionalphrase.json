                "senses": [
                    {
                        "sense_id": "5f771d5b-e950-3b35-a8a2-cf12f27d35a3",
                        "entry_id": "3ce040b4-a247-310a-a1ce-794efe8afe28",
                        "glosses": [
                            "Satzteil (Konstituente), der mindestens aus einer Präposition und einem Nomen oder Pronomen, oder stattdessen aus einem Präpositionaladverb besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b739da79-788c-488e-b665-f30fbe4575db",
                                "sense_id": "5f771d5b-e950-3b35-a8a2-cf12f27d35a3",
                                "text": "In dem Satz: \"Das Bild hängt an der Wand\" ist das Syntagma \"an der Wand\" eine Präpositionalphrase."
                            },
                            {
                                "example_id": "31ef8376-9afd-4927-a6d9-dcabdb620a47",
                                "sense_id": "5f771d5b-e950-3b35-a8a2-cf12f27d35a3",
                                "text": "„Der Verfasser würde ihn aber mit Sicherheit nicht vertreten, wenn er nicht an die Altehrwürdigkeit glaubte, denn die meisten Genitive stehen mit Artikel oder Pronomina und sind nicht kompakter als Präpositionalphrasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
