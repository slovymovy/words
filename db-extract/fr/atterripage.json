                        "entry_id": "476f54b3-7f76-306e-8cb9-511f0620fb8e",
                        "glosses": [
                            "Page web sur laquelle l’internaute arrive en premier en consultant un site web."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "cfb22491-6f33-4baa-b842-00f0ed6f8f13",
                                "sense_id": "5aee534b-06db-3e2e-b43d-7a79e6439dba",
                                "text": "L’intérêt est de l’associer à des « landing pages » (ou « atterripage »), intégrant le formulaire qui reste essentiel pour la qualification de la base de données."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "935004df-a2b6-4631-9be2-cde802888679",
                        "source_entry_id": "476f54b3-7f76-306e-8cb9-511f0620fb8e",
                        "source_sense_id": "5aee534b-06db-3e2e-b43d-7a79e6439dba",
                        "target_lang_word": "landing page",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landing page",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7249bfd8-7669-3166-bd7e-f05d1c0dab72",
                                        "entry_id": "f1fdcb88-95d4-3549-9bfc-98300c5964af",
                                        "glosses": [
                                            "A web page at which a user first arrives at a website, now especially one optimized for a marketing campaign or for lead generation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "767f3714-2497-4b63-ad7e-bf725f9fc3d0",
                                                "sense_id": "7249bfd8-7669-3166-bd7e-f05d1c0dab72",
                                                "text": "A good international landing page should have languages in some type of graphic that all browsers can read, followed by a selection of other languages that the user can shoot to quickly."
                                            },
                                            {
                                                "example_id": "1834d595-70b0-457a-9970-747747af49eb",
                                                "sense_id": "7249bfd8-7669-3166-bd7e-f05d1c0dab72",
                                                "text": "When the user arrives at that landing page the content is not generic (as the home page will be) but specific"
                                            },
                                            {
                                                "example_id": "cd3b9bab-003a-43a9-8a05-df07a853d51c",
                                                "sense_id": "7249bfd8-7669-3166-bd7e-f05d1c0dab72",
                                                "text": "Your most important information on the landing page should be above the fold."
                                            },
                                            {
                                                "example_id": "e54dacf3-062f-4324-bb31-14980972a94c",
                                                "sense_id": "7249bfd8-7669-3166-bd7e-f05d1c0dab72",
                                                "text": "If they see their user-generated scent of information (keywords) on a website's landing page, they believe the page will help ... Searchers become confident that the landing page is giving them what they need."
                                            },
                                            {
                                                "example_id": "b1bdad9c-af6f-4ba5-bdac-a928e5e9974e",
                                                "sense_id": "7249bfd8-7669-3166-bd7e-f05d1c0dab72",
                                                "text": "Is your landing page clearly about that keyword, and is the keyword used repeatedly on the landing page?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
