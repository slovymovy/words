                ],
                "senses": [
                    {
                        "sense_id": "6eec4d8b-5b95-3ec4-b2af-d332ada37891",
                        "entry_id": "e69c5f91-c1d5-35a1-b51f-98ac1613b86b",
                        "glosses": [
                            "coś, co jest zmanipulowane lub spreparowane, tylko z pozoru wyglądające na prawdziwe ( zdjęcie) lub markowe ( buty / koszulka / telefon), w rzeczywistości jednak sfałszowane"
                        ],
                        "tags": [
                            "colloquial",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "a79c9af3-d307-45f8-8cfb-40a34da3d819",
                                "sense_id": "6eec4d8b-5b95-3ec4-b2af-d332ada37891",
                                "text": "Im bliżej premiery filmu, tym więcej przecieków w internecie. Spora część z nich to fejki, ale podobno w każdym kłamstwie jest ziarno prawdy."
                            },
                            {
                                "example_id": "2cc293c6-4032-4f0a-a75a-e6c6f2d9398a",
                                "sense_id": "6eec4d8b-5b95-3ec4-b2af-d332ada37891",
                                "text": "Ta koszulka, mimo że jest fejkiem, wygląda naprawdę nieźle."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c450985-f208-468b-b9d2-4920688814af",
                        "source_entry_id": "e69c5f91-c1d5-35a1-b51f-98ac1613b86b",
                        "source_sense_id": "6eec4d8b-5b95-3ec4-b2af-d332ada37891",
                        "target_lang_word": "fake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "043a2735-0904-3ff1-9393-57d510b87ee2",
                                        "entry_id": "202d2f9f-511e-3800-84f5-d9ad8f46a880",
                                        "glosses": [
                                            "Not real; false, fraudulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74a4220-3169-4417-8c46-7ae90a095a9b",
                                                "sense_id": "043a2735-0904-3ff1-9393-57d510b87ee2",
                                                "text": "Which fur coat looks fake?"
                                            },
                                            {
                                                "example_id": "ab43b7f6-bf0e-4b50-a3f1-212e1857548d",
                                                "sense_id": "043a2735-0904-3ff1-9393-57d510b87ee2",
                                                "text": "Seeing Rossano Brazzi play an aristocratic White Russian, standing in the fakest snow that wartime supplies could buy, may be the most peculiar twist of all in the curious story of how Ayn Rand's autobiographical first novel came to the screen."
                                            },
                                            {
                                                "example_id": "1b454059-5055-47ac-b737-9dfec4a2c10d",
                                                "sense_id": "043a2735-0904-3ff1-9393-57d510b87ee2",
                                                "text": "The truth panic had the unwelcome side-effect of emboldening those it sought to oppose. “Fake” was one of Trump’s favourite slap-downs, especially to news outlets that reported unwelcome facts about him and his associates. A booming Maga media further amplified the president’s lies and denials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5725968e-a86d-3f8b-b3f1-05a33cb1cd77",
                                        "entry_id": "202d2f9f-511e-3800-84f5-d9ad8f46a880",
                                        "glosses": [
                                            "Insincere"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "980d8bb3-6ea3-307f-9ac4-8f3b3f54b9c4",
                                        "entry_id": "59cfa53e-c839-35fb-9de5-9917b865497d",
                                        "glosses": [
                                            "Something which is not genuine, or is presented fraudulently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb4f1b6-04db-42b9-9854-82407516bd2b",
                                                "sense_id": "980d8bb3-6ea3-307f-9ac4-8f3b3f54b9c4",
                                                "text": "I suspect this passport is a fake."
                                            },
                                            {
                                                "example_id": "27719c94-4eb7-4085-bb88-c0611c754d3c",
                                                "sense_id": "980d8bb3-6ea3-307f-9ac4-8f3b3f54b9c4",
                                                "text": "Among other interesting and weighty opinions, which were in general agreement with our contentions, was one by Mr. H. A. Staddon of Goodmayes, a gentleman who had made a particular hobby of fakes in photography. His report is too long and too technical for inclusion, but, under the various headings of composition, dress, development, density, lighting, poise, texture, plate, atmosphere, focus, halation, he goes very completely into the evidence, coming to the final conclusion that when tried by all these tests the chances are not less than 80 per cent. in favour of authenticity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c9371d-6b63-3a85-aa5b-da5327227939",
                                        "entry_id": "59cfa53e-c839-35fb-9de5-9917b865497d",
                                        "glosses": [
                                            "A move meant to deceive an opposing player, used for gaining advantage for example when dribbling an opponent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fabf4cf-6e5a-3af2-99a6-30128482007b",
                                        "entry_id": "59cfa53e-c839-35fb-9de5-9917b865497d",
                                        "glosses": [
                                            "A trick; a swindle"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11b5bdd3-8930-31a1-8a19-2656c1008447",
                                        "entry_id": "b8668a9b-feef-3c33-ad5e-9792e6b81daa",
                                        "glosses": [
                                            "To make a counterfeit, to counterfeit, to forge, to falsify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c0df8a8-143b-3773-85ac-00874d8e9b1b",
                                        "entry_id": "b8668a9b-feef-3c33-ad5e-9792e6b81daa",
                                        "glosses": [
                                            "To make a false display of, to affect, to feign, to simulate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd067024-cd0f-421c-935f-28d2376d89fe",
                                                "sense_id": "8c0df8a8-143b-3773-85ac-00874d8e9b1b",
                                                "text": "to fake a marriage"
                                            },
                                            {
                                                "example_id": "ac761020-e956-4194-9ef6-a343e4cce98a",
                                                "sense_id": "8c0df8a8-143b-3773-85ac-00874d8e9b1b",
                                                "text": "to fake happiness"
                                            },
                                            {
                                                "example_id": "c0f21d1b-c13a-4061-85fc-c42d326a4b85",
                                                "sense_id": "8c0df8a8-143b-3773-85ac-00874d8e9b1b",
                                                "text": "to fake a smile"
                                            },
                                            {
                                                "example_id": "1cdf85ff-344d-4748-a039-06563f72a445",
                                                "sense_id": "8c0df8a8-143b-3773-85ac-00874d8e9b1b",
                                                "text": "\"She constantly faked being sick, and perhaps mistakenly, I indulged her more than I should have, pretending I couldn't tell. But I AM a teacher myself, so it's kind of hard to just let this slide.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d75ef64-a2de-3b7f-ae9f-2c11aae39610",
                                        "entry_id": "b8668a9b-feef-3c33-ad5e-9792e6b81daa",
                                        "glosses": [
                                            "To cheat; to swindle; to steal; to rob."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49646820-97a9-328d-aa81-c0a9a0b1666f",
                                        "entry_id": "b8668a9b-feef-3c33-ad5e-9792e6b81daa",
                                        "glosses": [
                                            "To modify fraudulently, so as to make an object appear better or other than it really is"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f243a25b-6a6d-4ea6-b166-a60d3e0e3d75",
                                                "sense_id": "49646820-97a9-328d-aa81-c0a9a0b1666f",
                                                "text": "He had a hundred similar tricks, but I never knew him fake a horse, or sell one as sound if it was not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc7ca2d4-e9b4-3f45-981b-cfcdecf740cb",
                                        "entry_id": "b8668a9b-feef-3c33-ad5e-9792e6b81daa",
                                        "glosses": [
                                            "To improvise, in jazz."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd71330f-aafa-4ffb-9440-e0ba0cf1f0d3",
                                                "sense_id": "dc7ca2d4-e9b4-3f45-981b-cfcdecf740cb",
                                                "text": "Occasionally the opportunity arises to stand up and \"fake\" a jazz standard."
                                            },
                                            {
                                                "example_id": "880a616a-a277-4249-ab5c-8c1534f0063a",
                                                "sense_id": "dc7ca2d4-e9b4-3f45-981b-cfcdecf740cb",
                                                "text": "In the face of this print music culture, 'faking' was the ability—at once respected and disrespected—to improvise a song (or a part in an arrangement) without reading the notation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
