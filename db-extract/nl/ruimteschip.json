                                    },
                                    {
                                        "sense_id": "dafd812a-bd73-30f1-be16-05629dee1cb2",
                                        "entry_id": "508a50b3-3e89-3ae9-87db-01364bf1333f",
                                        "glosses": [
                                            "A finite pattern that reappears after a certain number of generations in the same orientation but in a different position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065911ed-2cc3-46af-98de-42de8c9b8f76",
                                                "sense_id": "dafd812a-bd73-30f1-be16-05629dee1cb2",
                                                "text": "The spaceships look like a row of threshers harvesting a field of wheat; the thickness in the direction of motion is only about 10 cells."
                                            },
                                            {
                                                "example_id": "73fb7527-15d6-4a64-b117-b294b0edf6f8",
                                                "sense_id": "dafd812a-bd73-30f1-be16-05629dee1cb2",
                                                "text": "We describe software that searches for spaceships in Conway's Game of Life and related two-dimensional cellular automata."
                                            },
                                            {
                                                "example_id": "0f9febb7-b1e1-4a95-8de3-0ed6865ac410",
                                                "sense_id": "dafd812a-bd73-30f1-be16-05629dee1cb2",
                                                "text": "Synthesis of spaceship flotillas is even more complicated than synthesis of oscillators, since spaceships are like oscillators that move[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13eb43ad-31d1-31f7-b751-71a1b1485486",
                                        "entry_id": "508a50b3-3e89-3ae9-87db-01364bf1333f",
                                        "glosses": [
                                            "The operator <=> in certain programming languages, which compares two values and indicates whether the first is lesser than, greater than, or equal to the second."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e3810e4-fa4c-43e3-bf19-5197ef655f03",
                                                "sense_id": "13eb43ad-31d1-31f7-b751-71a1b1485486",
                                                "text": "If we reverse the positions of $a and $b, the spaceship will sort in the opposite order[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc497668-df70-3456-af2b-8054afc79212",
                                        "entry_id": "508a50b3-3e89-3ae9-87db-01364bf1333f",
