                                        "sense_id": "363cd83a-4d19-383d-965e-076ed3483b20",
                                        "entry_id": "2e96f597-4665-39fc-882a-0347081374ed",
                                        "glosses": [
                                            "toestel waarmee men het licht van een lichtbron kan splitsen in de verschillende kleuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d5983b-f54f-4550-8f10-377705dd6873",
                                                "sense_id": "363cd83a-4d19-383d-965e-076ed3483b20",
                                                "text": "De satelliet bevat drie meetinstrumenten, legt Westenberg uit. Een camera om foto's te maken, een infrarood- en een ultraviolet-spectrometer. Allemaal bedoeld om het weer, de seizoenen en atmosfeer te onderzoeken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9961f86-7eac-380f-a4d3-0665ac40acbc",
                                        "entry_id": "2e96f597-4665-39fc-882a-0347081374ed",
                                        "glosses": [
                                            "toestel waarmee men de verschillende frequenties van een zeker straling kan onderzoeken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55eacb89-1cb8-441f-97ea-e0645ff08438",
                                                "sense_id": "e9961f86-7eac-380f-a4d3-0665ac40acbc",
                                                "text": "De wetenschappers maken gebruik van een 2 miljard dollar kostend meetinstrument dat is gemonteerd aan de buitenkant van het Internationaal Ruimtestation ISS. De Alpha Magnetic Spectrometer (AMS) detecteert kosmische straling."
                                            }
                                        ]
                                    }
                                ]
                            }
