                "senses": [
                    {
                        "sense_id": "7991fc85-6cd2-3595-90f9-b6ca67fcaea2",
                        "entry_id": "e6e2a17d-5ffb-3a84-93b1-32ef8dd4b7e7",
                        "glosses": [
                            "A milk-based product stiffened by a bacterium-aided curdling process, and sometimes mixed with fruit or other flavoring."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da44dfe1-0a55-4157-be6e-0ed4263f3880",
                                "sense_id": "7991fc85-6cd2-3595-90f9-b6ca67fcaea2",
                                "text": "Moroccan curried crab and streaks of minty, lemony yogurt add luxury to a supersimple zucchini soup ($14)."
                            },
                            {
                                "example_id": "ec5a5bf3-07f8-40ce-ad24-9d874acd230d",
                                "sense_id": "7991fc85-6cd2-3595-90f9-b6ca67fcaea2",
                                "text": "It makes up an estimated 73 percent of the U.S. food supply, and contains stereotypically “unhealthy” products like sodas, candies and hot dogs as well as seemingly “healthy” ones like whole grain breads, breakfast cereals, flavored yogurts and plant milks."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa4b949f-9dcd-31f9-bb01-a98b2e98c8b4",
                        "entry_id": "e6e2a17d-5ffb-3a84-93b1-32ef8dd4b7e7",
                        "glosses": [
                            "Any similar product based on other substances (e.g. soy yogurt)."
                        ],
                        "tags": [
                            "countable",
                            "especially",
                            "in-compounds",
                            "uncountable"
                        ],
                        "examples": []
                    }
