                        "sense_id": "7ec638fa-abfa-3220-81c1-89965b7b0f6c",
                        "entry_id": "7ca4bf66-cf9a-3dbe-bed2-e9f06f3cd5cf",
                        "glosses": [
                            "Relatif à Isis, divinité égyptienne."
                        ],
                        "tags": [
                            "Mythologie égyptienne"
                        ],
                        "examples": [
                            {
                                "example_id": "d2b1036e-9e37-4fa8-abe8-6c018bdeaa40",
                                "sense_id": "7ec638fa-abfa-3220-81c1-89965b7b0f6c",
                                "text": "Alliette est l'homme le plus heureux de la terre; il ne parle que tarots, cartes, sortilèges, sciences égyptiennes de Thot, mystères isiaques."
                            },
                            {
                                "example_id": "d2452a6a-3c36-4235-ba06-1a5368456c81",
                                "sense_id": "7ec638fa-abfa-3220-81c1-89965b7b0f6c",
                                "text": "J’ai tout de même un petit faible pour le second qui réunit (j’ai presque envie de dire qui « dédualise ») les deux triangles isiaques en un seul rectangle."
                            },
                            {
                                "example_id": "22c32d17-fdf8-4783-8f54-f30cf1bae60c",
                                "sense_id": "7ec638fa-abfa-3220-81c1-89965b7b0f6c",
                                "text": "La table isiaque est un célèbre monument de l’Antiquité sur lequel sont représentés les mystères d’Isis."
                            }
                        ]
                    }
                ],
