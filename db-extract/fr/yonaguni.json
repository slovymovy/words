                        "sense_id": "eec8a255-9865-31d4-8139-cdc669ce7ef4",
                        "entry_id": "ad2697e6-ff81-339f-8dc9-6fac20d2086c",
                        "glosses": [
                            "Langue indigène de l’ile de Yonaguni-jima, au Japon et faisant partie des langues ryūkyū."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4809bf70-9037-4217-ad62-dccc633749c6",
                                "sense_id": "eec8a255-9865-31d4-8139-cdc669ce7ef4",
                                "text": "Les langues japoniques ayant le moins de locuteurs sont — entre autres — le yonaguni, le yoron, l'amami du Sud, l'oki-no-erabu, et le kunigami."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f89b4d73-b30d-44b0-817a-cc3bd525d85b",
                        "source_entry_id": "ad2697e6-ff81-339f-8dc9-6fac20d2086c",
                        "source_sense_id": "eec8a255-9865-31d4-8139-cdc669ce7ef4",
                        "source_sense_description": "langue",
                        "target_lang_word": "Yonaguni",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yonaguni",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "469c913f-69f9-301c-9860-4f80891fa579",
                                        "entry_id": "eb49c416-3d41-355e-881b-70e5db26ad44",
                                        "glosses": [
                                            "A town and island of Yaeyama district, Okinawa Prefecture, Japan; the westmost inhabited island of Japan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ab32c4-843a-4442-91f3-32774bd5d147",
                                                "sense_id": "469c913f-69f9-301c-9860-4f80891fa579",
                                                "text": "Yonaguni, with three tiny villages and a small airport, is Japan’s westernmost point, a place from which Taiwan is visible on a clear day. It is also the closest spot of inhabited land to the Senkakus, a small group of uninhabited islets controlled by Japan but also claimed by China and Taiwan, which call them the Diaoyu Islands.\nThis put Yonaguni and its 1,600 mostly aging residents uncomfortably close to a bruising diplomatic showdown with Beijing last September over a Chinese trawler detained near the Senkakus, which resulted in Tokyo’s backing down. The government of Prime Minister Naoto Kan has since vowed to beef up defenses for Japan’s “outlying islands,” and it appears close to a decision on the small Yonaguni garrison, a plan that has been under discussion for years."
                                            },
                                            {
                                                "example_id": "34b0f0f2-63c3-4754-8d58-699f3a995c15",
                                                "sense_id": "469c913f-69f9-301c-9860-4f80891fa579",
                                                "text": "The quake had a depth of 27.5 km (17.1 miles) with its epicentre 89.5 km (55.6 miles) off Taiwan's east coast, roughly halfway between the coast of Hualien county and the southern Japanese island of Yonaguni, the weather bureau said."
                                            },
                                            {
                                                "example_id": "73a1fd81-4af2-41c7-872e-38a44517094c",
                                                "sense_id": "469c913f-69f9-301c-9860-4f80891fa579",
                                                "text": "For years it was known as the \"Two Gun\" island – one gun for each of the two policemen stationed here.\nYonaguni, Japan's most westerly island, can feel like a peaceful paradise — it is covered in tropical forests and hammerhead sharks glide through its azure waters.\nBut there is trouble on the horizon. Almost 70 miles away lies the island of Taiwan — the self-governing democracy which once again finds itself in the headlines.\nOn Thursday, six Chinese ballistic missiles landed in water near Japan's southwestern islands, one of them near Yonaguni and five others within Japan's Exclusive Economic Zone, according to the Japanese authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e753fc-2228-3a35-b193-0b779083d583",
                                        "entry_id": "eb49c416-3d41-355e-881b-70e5db26ad44",
                                        "glosses": [
                                            "A Ryukyuan language spoken on the island of Yonaguni."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
