                ],
                "senses": [
                    {
                        "sense_id": "5edd0ebd-9069-33ac-944a-76873754862b",
                        "entry_id": "0c4e89df-d906-3100-8f59-5d88d93fa7bd",
                        "glosses": [
                            "Spitze/äußeres Ende der Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223b07bf-9031-4aff-9551-1b86c485a44b",
                                "sense_id": "5edd0ebd-9069-33ac-944a-76873754862b",
                                "text": "„Er senkt den Kopf und gibt sich Mühe, nimmt auch die Nasenspitze zwischen drei Finger, geht nur noch in kleinen Schritten weiter.“"
                            },
                            {
                                "example_id": "aca9cb29-8f94-438e-bf03-82b787125dd5",
                                "sense_id": "5edd0ebd-9069-33ac-944a-76873754862b",
                                "text": "„Mir lief der Schweiß schon von der Nasenspitze.“"
                            },
                            {
                                "example_id": "bd05bf4b-b3f2-475c-bc95-a0ed664138c1",
                                "sense_id": "5edd0ebd-9069-33ac-944a-76873754862b",
                                "text": "„Während ich auf dem Riesenball hüpfte und mal wieder meine Nasenspitze antippen durfte, erzählte sie mir von einer Fehlgeburt, einem Computerbrand und davon, wie sehr sie die Wiener Nachspeisen liebte.“"
                            },
                            {
                                "example_id": "ff018d7c-662c-4fad-9753-c306599b4dc9",
                                "sense_id": "5edd0ebd-9069-33ac-944a-76873754862b",
                                "text": "„Die Brille auf der Nasenspitze, den Kopf in den Nacken zurückgelegt, stand Marja Dmitrijewna in der Saaltür und sah die Eintretenden streng und scharf an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
