                "senses": [
                    {
                        "sense_id": "97aeac71-a6ec-35a1-858f-2b61a4c29ca0",
                        "entry_id": "bb014cf2-4140-3432-9e0e-a97a3d9e99c1",
                        "glosses": [
                            "Fit to live in; habitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8780851d-f920-4a61-b8f3-a9113942c02b",
                                "sense_id": "97aeac71-a6ec-35a1-858f-2b61a4c29ca0",
                                "text": "It is more ſuitable to the wiſdom, power and greatneſs of God, to think that the fixt Stars are all of them Suns, with Syſtems of inhabitable Planets moving about them, to whoſe Inhabitants he diſplays the marks of his Goodneſs as well as to us[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86bd7952-56a6-4ad2-adac-c91ae417a75f",
