                    {
                        "translation_id": "4078ad89-9af1-4806-b1d5-08facb66a330",
                        "source_entry_id": "c89a6530-498a-3802-9dbe-8cf42112085e",
                        "source_sense_id": "21b64e44-8bdc-3e97-a6b6-521815b16914",
                        "source_sense_description": "typerend voor de winter",
                        "target_lang_word": "winterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                        "entry_id": "2a72df60-190e-3d16-94a6-1d68a8b8cb7c",
                                        "glosses": [
                                            "charakteristisch für den Winter; dem Winter entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08e0a185-3ab7-49b9-a193-fce46f728681",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Mit Ausnahme der südlichen Landschaften war das Land rau und winterlich, von Natur aus eher zur Viehzucht als zum Ackerbau geeignet.“"
                                            },
                                            {
                                                "example_id": "9bc8148f-fac5-42fd-aec3-c17c5f75536e",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Während im übrigen Land noch winterliches Schmuddelwetter herrscht, ist es am Bodensee schon frühlingshaft mild.“"
                                            },
                                            {
                                                "example_id": "3c4c90f8-2e7f-4ed5-8162-0d4c3b5bd1bf",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Jeff Bridges reitet im zehnfach oscarnominierten Remake eines herbstlichen John-Wayne-Klassikers durch eine winterliche Welt.“"
                                            },
                                            {
                                                "example_id": "9e9fc3c9-c84d-407b-bb0b-4478f3418c5b",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Auf dem Watzmann ist es selbst in dieser Jahreszeit noch winterlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
