                ],
                "senses": [
                    {
                        "sense_id": "770d00c5-d3fe-30c3-83df-9eacf3d35edf",
                        "entry_id": "76d1e47c-1d83-3937-ade4-e28995619f6c",
                        "glosses": [
                            "gatunek rośliny z rodziny astrowatych"
                        ],
                        "tags": [],
