                        ]
                    },
                    {
                        "translation_id": "8abcea09-537d-4a0b-9fe2-0f7c293ff601",
                        "source_entry_id": "4e152ef8-360b-33f6-ad4e-2accef9db2a4",
                        "target_lang_word": "tyrannisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4be270fa-fb77-360d-8ab4-509bf0244ca1",
                                        "entry_id": "61eadf8d-8c5c-3c44-ae21-ac8e42fcf83a",
                                        "glosses": [
                                            "andere bevormundend, unterdrückend, autoritär und schlecht behandelnd (tyrannisierend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96b4a18-37f0-440b-a920-84bc122500bf",
                                                "sense_id": "4be270fa-fb77-360d-8ab4-509bf0244ca1",
                                                "text": "„Xavier ist ein tyrannischer Chef, der von all seinen Untergebenen gefürchtet wird. Er vertraut niemandem und geht so weit, die Schriftstücke auf den Schreibtischen seiner Untergebenen zu lesen und deren Anrufbeantworter abzuhören.“"
                                            },
                                            {
                                                "example_id": "878058fb-6f6e-41b2-8222-9c134bbb4842",
                                                "sense_id": "4be270fa-fb77-360d-8ab4-509bf0244ca1",
                                                "text": "„Besonders wenn man nie auch nur die geringste Chance hatte, gegen eine so übermächtige und tyrannische Mutter aufzubegehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7cad182-90fe-33d9-8a40-c3d1545a41c4",
                                        "entry_id": "61eadf8d-8c5c-3c44-ae21-ac8e42fcf83a",
                                        "glosses": [
                                            "sich wie ein Gewaltherrscher (Tyrann) aufführend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee201f1-c48f-40a9-a45f-64ee4dabfb68",
                                                "sense_id": "c7cad182-90fe-33d9-8a40-c3d1545a41c4",
                                                "text": "Die ersten fünf Jahre regierte Nero löblich, aber dann wurde er mehr und mehr zum tyrannischen Regenten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d39a6178-ce9b-4ac3-bff5-15aee028cf6f",
                        "source_entry_id": "4e152ef8-360b-33f6-ad4e-2accef9db2a4",
                        "target_lang_word": "tyrannique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28e7600a-be9b-3aac-b0da-af31ef4245f4",
                                        "entry_id": "e0441a30-530e-39a7-adc0-71e30c06ea24",
                                        "glosses": [
                                            "Qui tient de la tyrannie, qui est injuste, violent, contre le droit et la raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a0448f-50ef-4b7b-9012-807fbf94a653",
                                                "sense_id": "28e7600a-be9b-3aac-b0da-af31ef4245f4",
                                                "text": "Rien chez les empereurs romains tyranniques (Caligula, Néron, Élagabal, Commode) ne signe un manque affectif dans leur petite enfance, bien au contraire."
                                            },
                                            {
                                                "example_id": "fa1619a8-9c00-4685-acb3-f3852aa241a9",
                                                "sense_id": "28e7600a-be9b-3aac-b0da-af31ef4245f4",
                                                "text": "Enfin, c’est celui qui veut remplacer la loi tutélaire de la majorité par l'arbitraire tyrannique du petit nombre, faire le peuple esclave du parti & écraser la démocratie tout entière sous une despotique kakistocratie."
                                            },
                                            {
                                                "example_id": "4336a3ce-dc93-456a-9e99-f8a6a69b54a0",
                                                "sense_id": "28e7600a-be9b-3aac-b0da-af31ef4245f4",
                                                "text": "En 1767, les idées libérales, défendues par les physiocrates, disciples de Quesnay, remportèrent une première victoire sur l'esprit tyrannique des vieilles corporations […]."
                                            },
                                            {
                                                "example_id": "19d7a27f-bf05-4605-9f56-86c1c0ef3a88",
                                                "sense_id": "28e7600a-be9b-3aac-b0da-af31ef4245f4",
                                                "text": "Gouvernement tyrannique. — Pouvoir tyrannique. — Une jalousie tyrannique."
                                            },
                                            {
                                                "example_id": "4a0527e3-79dc-47ad-95c6-101466d13f2f",
                                                "sense_id": "28e7600a-be9b-3aac-b0da-af31ef4245f4",
                                                "text": "Pourtant son affection se fatigua très vite, et quand elle devint aigre, Hindley devint tyrannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1c741b-2b68-3c49-8e72-104aba6ed0c9",
                                        "entry_id": "e0441a30-530e-39a7-adc0-71e30c06ea24",
                                        "glosses": [
                                            "Qui exerce une action, un pouvoir irrésistible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc142075-efec-4187-ad05-57a8c3739d3a",
                                                "sense_id": "db1c741b-2b68-3c49-8e72-104aba6ed0c9",
                                                "text": "En effet, il ne ressemblait pas aux autres, et ne voulait pas courber la tête sous le joug de leur tyrannique médiocrité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea840376-d117-4c0e-962d-bdafb4078100",
                        "source_entry_id": "4e152ef8-360b-33f6-ad4e-2accef9db2a4",
                        "target_lang_word": "despotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                        "entry_id": "4eba651e-bbff-3e10-9d93-0f05698fc33a",
                                        "glosses": [
                                            "Qui est propre au despote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef4dc050-5974-42d0-833a-b242f7bba0d6",
                                                "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                                "text": "Enfin, c’est celui qui veut remplacer la loi tutélaire de la majorité par l'arbitraire tyrannique du petit nombre, faire le peuple esclave du parti & écraser la démocratie tout entière sous une despotique kakistocratie."
                                            },
                                            {
                                                "example_id": "4fa38e4a-def9-4dee-b484-eeb7d13b5f7a",
                                                "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                                "text": "Passant ensuite aux détails techniques de la composition et de l’instrumentation, Liszt caractérise la manière incisive dont Wagner a rendu les attractions lascives du Venusberg : […]. « Il y a des notes qui sifflent à l’oreille comme certains regards chatoient à la vue : longues, désarmantes, perfides ! Sous le velouté de leur artificielle douceur on saisit des intonations despotiques, on sent trembler la colère. Çà et là des mordantes de violon s’échappent de l’archet comme des étincelles phosphoriques. […] »"
                                            },
                                            {
                                                "example_id": "2a035668-06d6-4d6f-8dac-02c891206ff7",
                                                "sense_id": "1a229523-5ac1-3d72-a89f-8413f3c6942e",
                                                "text": "À vrai dire, la République romaine n’était qu’une oligarchie despotique et pillarde dont les chefs s’enrichissaient en dépouillant le monde par les guerres et les rapines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2271521a-023a-4a3f-8099-72cb80276caa",
                        "source_entry_id": "4e152ef8-360b-33f6-ad4e-2accef9db2a4",
                        "target_lang_word": "dominateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dominateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e21acfc-f881-3e48-bded-1236a3a706f8",
                                        "entry_id": "11c9b053-1c8c-330e-88a4-6344a0c9595b",
                                        "glosses": [
                                            "Celui qui domine, qui s’arroge une grande autorité, qui exerce un grand empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cfb2eb0-6842-4909-be03-760b7395443c",
                                                "sense_id": "8e21acfc-f881-3e48-bded-1236a3a706f8",
                                                "text": "Déchues de leur rôle de dominatrices, les Fougères se sont réfugiées à l'ombre des grands Phanérogames; elles vivent sous bois et n'y brillent pas."
                                            },
                                            {
                                                "example_id": "69cfeba0-d507-4f20-bb5e-e191e2d75b33",
                                                "sense_id": "8e21acfc-f881-3e48-bded-1236a3a706f8",
                                                "text": "Alexandre le Grand devint le dominateur de l’Asie. — Cette nation fut longtemps la dominatrice des mers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dominateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca87530-dc11-37f1-9d7a-4b92cd7516e6",
                                        "entry_id": "9214d401-e54b-3ebd-b69c-2fd549d6ad49",
                                        "glosses": [
                                            "Qui domine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f456041-95fe-4d03-b288-9b1215a1cb4e",
                                                "sense_id": "7ca87530-dc11-37f1-9d7a-4b92cd7516e6",
                                                "text": "Esprit dominateur."
                                            },
                                            {
                                                "example_id": "2bc4f812-ac2c-4cfe-96c5-44a778a09357",
                                                "sense_id": "7ca87530-dc11-37f1-9d7a-4b92cd7516e6",
                                                "text": "Pouvoir dominateur."
                                            },
                                            {
                                                "example_id": "a12abb98-17a2-4277-97ec-823d3272f6d3",
                                                "sense_id": "7ca87530-dc11-37f1-9d7a-4b92cd7516e6",
                                                "text": "Force dominatrice."
                                            },
                                            {
                                                "example_id": "5b2c3d44-0d38-409b-b5f1-85cfbfd344e7",
                                                "sense_id": "7ca87530-dc11-37f1-9d7a-4b92cd7516e6",
                                                "text": "Je l’avais admiré, combattu, méconnu, sa disparition marquait la fin d’un monde, la fin d’un temps, et, voguant vers le pays qui abritait « un peuple d’élite, sûr de lui-même et dominateur », comme il l’avait déclaré trois ans plus tôt au cours d’une conférence de presse, je ressentis une très réelle tristesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
