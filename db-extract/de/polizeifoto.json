                ],
                "senses": [
                    {
                        "sense_id": "51dceb4a-612c-33b9-803b-c524dde27078",
                        "entry_id": "7d291052-5948-39a6-9d42-353025f4bcd4",
                        "glosses": [
                            "von der Polizei aufgenommenes Foto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6651c47c-7ff9-4122-b033-25131cc9b958",
                                "sense_id": "51dceb4a-612c-33b9-803b-c524dde27078",
                                "text": "„Ich denke an Polizeifotos von Autounfällen und Schussverletzungen aus nächster Nähe.“"
                            },
                            {
                                "example_id": "50a515da-c08d-4c19-a9b5-b0eec7f5cb65",
                                "sense_id": "51dceb4a-612c-33b9-803b-c524dde27078",
                                "text": "„Es waren zwar keine Polizeifotos, doch der junge Mann blickte jeweils argwöhnisch in die Kamera.“"
                            },
                            {
                                "example_id": "8fa381d8-2bb9-498b-84d3-52ad2147433b",
                                "sense_id": "51dceb4a-612c-33b9-803b-c524dde27078",
                                "text": "„Miles klappte seine Aktentasche auf und reichte Malcolm eine Mappe. Malcolm öffnete sie und starrte auf die Polizeifotos, die oben ans erste Blatt geheftet waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
