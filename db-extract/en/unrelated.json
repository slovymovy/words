                        "examples": [
                            {
                                "example_id": "24b9649a-e9c3-4812-a4ea-a9cb577e9579",
                                "sense_id": "01d8a2e0-48c0-3995-b842-2e1aeb17b1a7",
                                "text": "The holiday started with two unrelated mishaps."
                            },
                            {
                                "example_id": "21772099-d799-4ef5-bff3-e1eb72fa4598",
                                "sense_id": "01d8a2e0-48c0-3995-b842-2e1aeb17b1a7",
                                "text": "I was having lunch with Jim the other day, who's just had his first kid. Oh, and on a completely unrelated note, there's a new cinema opened up in town."
                            }
                        ]
                    },
                    {
                        "sense_id": "cffe105f-236a-3ff5-9732-846572f7e562",
                        "entry_id": "b30c8436-0472-3d95-b457-d58e7a2f4c18",
                        "glosses": [
                            "Not related by kinship."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d1b3df8-104d-454a-a1b8-7bd7e90bc5c5",
                                "sense_id": "cffe105f-236a-3ff5-9732-846572f7e562",
                                "text": "He had the same surname as me, but we were unrelated."
                            }
                        ]
                    }
                ],
