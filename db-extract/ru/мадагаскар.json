                        ]
                    },
                    {
                        "translation_id": "c685e5b1-b00f-4a06-8b4e-8a5cfaa9479d",
                        "source_entry_id": "8bfe7196-fe0e-3845-bd35-06714531271b",
                        "target_lang_word": "Madagaskar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Madagaskar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df12e36c-5f55-3846-9aab-70d52aa61864",
                                        "entry_id": "828887e6-24cb-33d7-8061-6a53223cf637",
                                        "glosses": [
                                            "Inselrepublik im Indischen Ozean, die viertgrößte Insel der Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "571aea5e-dfa4-4a63-9663-554cc45a08c5",
                                                "sense_id": "df12e36c-5f55-3846-9aab-70d52aa61864",
                                                "text": "Madagaskar ist berühmt für seine einzigartige Tier- und Pflanzenwelt."
                                            },
                                            {
                                                "example_id": "cbbf126d-c0ae-4efd-a96d-1bc0281a7811",
                                                "sense_id": "df12e36c-5f55-3846-9aab-70d52aa61864",
                                                "text": "Antananarivo ist die Hauptstadt von Madagaskar."
                                            },
                                            {
                                                "example_id": "d18451da-901e-4e5a-9abb-08bbffb7c259",
                                                "sense_id": "df12e36c-5f55-3846-9aab-70d52aa61864",
                                                "text": "„Madagaskar ist einer der letzten Teile der Erde, die durch den Menschen besiedelt wurden.“"
                                            },
                                            {
                                                "example_id": "f1276381-28bd-42de-bea5-0c2e252309ad",
                                                "sense_id": "df12e36c-5f55-3846-9aab-70d52aa61864",
                                                "text": "„Er hatte auch geschrieben, daß es ihm dort ganz gut gehe, daß er mit einer Frau aus Madagaskar zusammen lebe, die auch verdiene.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba97e64-bea7-4ddb-9dcd-7efd3c6fa7f0",
                        "source_entry_id": "8bfe7196-fe0e-3845-bd35-06714531271b",
                        "target_lang_word": "Madagascar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Madagascar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c947749b-d64a-3e29-b67b-0e70a335d3c7",
                                        "entry_id": "3f4fe007-e652-3394-a972-e2e74125b1d5",
                                        "glosses": [
                                            "Grande île de l’océan Indien située à 400 km à l’est du Mozambique, remarquable pour la variété unique de sa faune."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1325c98-b7bc-4149-985f-48e2101227e9",
                                                "sense_id": "c947749b-d64a-3e29-b67b-0e70a335d3c7",
                                                "text": "On a fait à Madagascar avec succès des essais sur deux espèces d’araignées séricigènes dont on a récolté une grande quantité de cocons."
                                            },
                                            {
                                                "example_id": "f311ab16-8bdd-4c5c-b0d7-eca4607bd526",
                                                "sense_id": "c947749b-d64a-3e29-b67b-0e70a335d3c7",
                                                "text": "Les varis roux vivent, normalement, dans les forêts tropicales humides de Madagascar."
                                            },
                                            {
                                                "example_id": "41f3e43e-9f2a-4f23-8950-5d8bbf4cc604",
                                                "sense_id": "c947749b-d64a-3e29-b67b-0e70a335d3c7",
                                                "text": "La séparation en deux de l’ancien continent du Gondwana, amorcée dès le Permien par le golfe d’Arabie vers le N. de Madagascar, ne paraît pas avoir été complète, même au Crétacé supérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53e97412-9892-320a-b701-0e3e81a19e67",
                                        "entry_id": "3f4fe007-e652-3394-a972-e2e74125b1d5",
                                        "glosses": [
                                            "État insulaire occupant cette île, ayant pour capitale Antananarivo."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
