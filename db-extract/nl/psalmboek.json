                        "glosses": [
                            "boek met vertalingen van de psalmen uit het Oude Testament"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d036c3db-f839-41a3-a56b-6555320902e7",
                                "sense_id": "b59f2a81-236d-3793-8968-9568d2990497",
                                "text": "Utrechts psalmboek genomineerd voor Unescolijst: Het Utrechts Psalter, een eeuwenoud boek met 150 psalmen en 16 bijbelse liederen, is genomineerd voor een vermelding in de documenten-erfgoedlijst van de VN-organisatie Unesco, het Memory of the World Register."
                            },
                            {
                                "example_id": "712ce754-7b3a-412a-80c6-aceb43097ca9",
                                "sense_id": "b59f2a81-236d-3793-8968-9568d2990497",
                                "text": "Op een veiling in New York heeft een psalmboek een recordbedrag opgeleverd: 14,2 miljoen dollar, omgerekend ruim 10 miljoen euro. Het Bay Psalm Book uit 1640 is daarmee het kostbaarste gedrukte boek ter wereld."
                            }
                        ]
                    }
