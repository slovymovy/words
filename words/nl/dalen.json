                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "waarde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijs van de aandelen is deze week flink <w>gedaald</w> op de beurs.",
                            "target_lang_translations": {
