                                            {
                                                "example_id": "91463545-d0c8-44d6-9d20-9034941b792a",
                                                "sense_id": "95299316-21e4-3843-b8c3-8bfbc8a1822a",
                                                "text": "В связи с этим программирование экономических и конторских задач является значительно более сложным делом, чем программирование математических вычислений."
                                            },
                                            {
                                                "example_id": "b08bf7f3-258f-495e-8f58-9b4670def37a",
                                                "sense_id": "95299316-21e4-3843-b8c3-8bfbc8a1822a",
                                                "text": "Будущее колонизировано планированием, в нём может произойти только запрограммированное или подлежащее программированию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
