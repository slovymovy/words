                ],
                "senses": [
                    {
                        "sense_id": "f0ffbcf6-aaea-3bb2-acfc-be8789bf2b7f",
                        "entry_id": "2e797921-e6d1-3a50-a551-a7ab12c700f6",
                        "glosses": [
                            "Operator, der ausdrückt, dass eine bestimmte Bedingung für alle Objekte zutrifft"
                        ],
                        "tags": [
                            "Prädikatenlogik"
                        ],
                        "examples": [
                            {
                                "example_id": "9811ea14-c58f-478d-ad1b-9adca1c053ed",
                                "sense_id": "f0ffbcf6-aaea-3bb2-acfc-be8789bf2b7f",
                                "text": "„Die Ausdrücke ‚für alle…‘ und ‚es gibt…‘ heißen Quantoren. Dabei heißt ‚für alle…‘ Allquantor und ‚es gibt…‘ Existenzquantor.“"
                            },
                            {
                                "example_id": "cc117bb6-f229-4fd4-9834-e4f2e0e4c330",
                                "sense_id": "f0ffbcf6-aaea-3bb2-acfc-be8789bf2b7f",
                                "text": "„Gleichzeitig zeigt dieses Beispiel, dass der Allquantor und der Aspekt nicht ein und demselben Operator ohne Skopusunterschiede zugeschrieben werden können.“"
                            },
                            {
                                "example_id": "c21d9db3-7e22-454a-9c7c-d67a98b3891f",
                                "sense_id": "f0ffbcf6-aaea-3bb2-acfc-be8789bf2b7f",
                                "text": "„Hier zeigt sich wiederum ein deutlicher Unterschied zwischen der Analyse des Wortes ‚omnis‘ in der Logik des Mittelalters und dem Allquantor in der modernen Logik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
