                    },
                    {
                        "translation_id": "ff4f7d2f-db0f-4603-899c-79a572d6e698",
                        "source_entry_id": "abb0ad27-d48a-3616-8f30-aaf261b37d13",
                        "source_sense_id": "a077282e-a6e5-30f1-b664-022936c5315a",
                        "target_lang_word": "потолок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "потолок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "726ac0df-1e67-34de-b407-a3918538701c",
                                        "entry_id": "95363b82-f5e5-3d2c-be91-907f0ba999ec",
                                        "glosses": [
                                            "верхнее покрытие внутри помещения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38bb9951-0d2e-48cf-90dc-779f70abe004",
                                                "sense_id": "726ac0df-1e67-34de-b407-a3918538701c",
                                                "text": "Комната была высокая, с тяжёлым, украшенным лепкой потолком."
                                            },
                                            {
                                                "example_id": "7261ea4c-83fa-4111-9c3b-3e60565ed2de",
                                                "sense_id": "726ac0df-1e67-34de-b407-a3918538701c",
                                                "text": "Пыль … плавала, клубилась вокруг лампочек под потолком коридора."
                                            },
                                            {
                                                "example_id": "357ef12d-09b4-4268-a651-7f8dfba3380e",
                                                "sense_id": "726ac0df-1e67-34de-b407-a3918538701c",
                                                "text": "Книжные шкафы были до самого потолка, с пола не достать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29164051-629f-32c8-aad3-1d084ec01db1",
                                        "entry_id": "95363b82-f5e5-3d2c-be91-907f0ba999ec",
                                        "glosses": [
                                            "авиац. предельная высота подъёма летательного аппарата с заданной нагрузкой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08fff818-1b69-4403-8349-bc616588b3fe",
                                                "sense_id": "29164051-629f-32c8-aad3-1d084ec01db1",
                                                "text": "Максимальная скорость 210 км/ч; крейсерская скорость 190 км/ч; практический потолок 5000 м; статический потолок (без влияния земли) 2000 м."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ab5ccbd-f4ec-365c-b7b3-72fb975a42ab",
                                        "entry_id": "95363b82-f5e5-3d2c-be91-907f0ba999ec",
                                        "glosses": [
                                            "перен., разг. предельное значение какой-либо величины, верхняя граница; предел, предельная степень чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b812c3d8-5864-4c06-9d22-78184f816e50",
                                                "sense_id": "8ab5ccbd-f4ec-365c-b7b3-72fb975a42ab",
                                                "text": "По его мнению, рядовой страхователь выиграет от появления на рынке новых продуктов, которым «рынок будет диктовать потолок цен»."
                                            },
                                            {
                                                "example_id": "e22c9aa0-7197-4484-9f42-52f83e5e92c8",
                                                "sense_id": "8ab5ccbd-f4ec-365c-b7b3-72fb975a42ab",
                                                "text": "Сегодня Томская область по финансовым показателям занимает в России 4-е, а по экономическим―16-е место. И это не потолок. Я думаю, область привлекает не только природными ресурсами, но и здоровой общественной атмосферой."
                                            },
                                            {
                                                "example_id": "6eafa4b5-4388-45d6-98f5-44591c2bb821",
                                                "sense_id": "8ab5ccbd-f4ec-365c-b7b3-72fb975a42ab",
                                                "text": "Их цель — повысить его эффективность и сократить государственные расходы, которые в условиях рыночный экономики практически достигли своего потолка."
                                            },
                                            {
                                                "example_id": "2320c5ff-0a6d-4e05-9f7f-591db7a4eb73",
                                                "sense_id": "8ab5ccbd-f4ec-365c-b7b3-72fb975a42ab",
                                                "text": "По мнению аналитиков, рекордная цена выше 100 долларов — ещё не потолок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7358da17-444e-3e69-9cec-da9390ce1455",
                                        "entry_id": "95363b82-f5e5-3d2c-be91-907f0ba999ec",
                                        "glosses": [
                                            "рег. (Кубань) чердак"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e21f828e-1316-4241-8168-aa94842fa20e",
                        "source_entry_id": "abb0ad27-d48a-3616-8f30-aaf261b37d13",
                        "source_sense_id": "4b5efaf7-5c62-31a3-9cbe-bb27172d1a45",
