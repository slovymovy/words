                                                "sense_id": "71a22420-ea6e-38e9-bf6d-173b70aa940f",
                                                "text": "It's Ashot lore that I used to have a priv where I posted pictures of weird animals I found on the street."
                                            },
                                            {
                                                "example_id": "457624d9-1a52-424e-9d61-f5465d24e307",
                                                "sense_id": "71a22420-ea6e-38e9-bf6d-173b70aa940f",
                                                "text": "Most new followers don't know about my marching band lore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac204110-1ff1-34bd-9bd5-81a2174b104f",
                                        "entry_id": "3ccdeba5-c69a-316d-b0e6-b97f99f0fe4d",
                                        "glosses": [
                                            "Workmanship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6101c4b6-2a15-4b54-84c1-13a81667a95f",
                                                "sense_id": "ac204110-1ff1-34bd-9bd5-81a2174b104f",
                                                "text": "In her right hand a rod of peace shee bore, / About the which two serpents weren wound; / Entrayled mutually in lovely lore, / And by the tailes together firmely bound […]"
                                            }
                                        ]
                                    }
                                ]
                            },
