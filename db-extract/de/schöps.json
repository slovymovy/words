                    {
                        "translation_id": "b2d98c38-270d-4386-9373-3473811d45d0",
                        "source_entry_id": "c6690554-5f72-30f5-a3ad-79729e28ce32",
                        "source_sense_id": "279afb82-155d-30ab-937f-b839a7dd9802",
                        "target_lang_word": "mutton",
