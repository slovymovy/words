    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdf0ca6d-75cb-3da5-8691-8635a25bf5f4",
                    "sense_definition": "An explanation of the basis or fundamental reasons for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager provided a clear <w>rationale</w> for the sudden change in company policy.",
                            "target_lang_translations": {
                                "ru": "Менеджер представил четкое <w>обоснование</w> внезапного изменения в политике компании."
                            }
                        },
                        {
                            "text": "The underlying <w>rationale</w> for this project is to improve long-term efficiency.",
                            "target_lang_translations": {
                                "ru": "Основная <w>логика</w> этого проекта заключается в повышении долгосрочной эффективности."
                            }
                        }
                    ],
                    "synonyms": [
                        "reasoning",
                        "rationalization"
                    ],
                    "common_phrases": [
                        "underlying rationale",
                        "provide a rationale",
                        "clear rationale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объяснение основы или фундаментальных причин чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обоснование",
                                "target_lang_sense_clarification": "логические доводы или причины"
                            },
                            {
                                "target_lang_word": "основание",
                                "target_lang_sense_clarification": "база для принятия решения или вывода"
                            },
                            {
                                "target_lang_word": "логика",
                                "target_lang_sense_clarification": "внутренняя последовательность и разумность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cdc764a-c809-3048-8c3e-d7c97de88252",
                    "sense_definition": "A justification or rationalization for something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report gave her some <w>rationale</w> for why the decision had been so destructive.",
                            "target_lang_translations": {
                                "ru": "Отчет дал ей некоторое <w>объяснение</w> того, почему решение оказалось таким разрушительным."
                            }
                        },
                        {
                            "text": "He struggled to find a logical <w>rationale</w> to justify his controversial actions.",
                            "target_lang_translations": {
                                "ru": "Он изо всех сил пытался найти логическое <w>оправдание</w> своим спорным действиям."
                            }
                        }
                    ],
                    "synonyms": [
                        "reasoning"
                    ],
                    "common_phrases": [
                        "logical rationale",
                        "economic rationale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оправдание или рациональное объяснение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "аргумент в защиту действий"
                            },
                            {
                                "target_lang_word": "разумное объяснение",
                                "target_lang_sense_clarification": "логическая интерпретация событий"
                            },
                            {
                                "target_lang_word": "мотивировка",
                                "target_lang_sense_clarification": "совокупность мотивов и доводов"
                            }
                        ]
                    }
                },
                {
