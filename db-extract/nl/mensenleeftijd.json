                    {
                        "sense_id": "bee05598-3686-3cfa-a6e8-53b64b4b5f1c",
                        "entry_id": "f86f70cb-b6d0-32ea-9e59-5f22b8470227",
                        "glosses": [
                            "aantal jaren dat een mens oud zou zijn als hij een even groot deel van zijn doorsnee verwachte levensduur zou hebben geleefd als een bepaald dier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d008f985-ee64-499d-8c4d-df8dddad0fd4",
                                "sense_id": "bee05598-3686-3cfa-a6e8-53b64b4b5f1c",
                                "text": "Er wordt gebeld en terwijl ik naar de voordeur loop, sjokt onze bejaarde hond nieuwsgierig mee. De twee 11-jarige jochies op de stoep zijn meteen vertederd, willen hem graag aaien en vragen hoe oud hij eigenlijk is. „Dertien”, antwoord ik, „in mensenleeftijd zou dat eigenlijk eenennegentig jaar zijn, vandaar zijn grijze snuit.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "637c8216-926a-3b81-ad88-b52056a9de25",
                        "entry_id": "f86f70cb-b6d0-32ea-9e59-5f22b8470227",
                        "glosses": [
                            "doorsnee tijdsduur in jaren tussen geboorte en overlijden van mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c069c4c-9d0d-4863-8add-fb8ad128bf00",
                                "sense_id": "637c8216-926a-3b81-ad88-b52056a9de25",
                                "text": "We blijven herdenken: Auschwitz, Birkenau, Neuengamme, Ravensbrück, capitulatie Wageningen, Bevrijdingsdag, et cetera, inmiddels 60 jaar (welhaast een mensenleeftijd) geleden."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb458847-16a3-38e9-8f38-6cd904f6435e",
                        "entry_id": "f86f70cb-b6d0-32ea-9e59-5f22b8470227",
                        "glosses": [
                            "doorsnee tijdsduur van het productief bestaan"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c455f6cd-f800-4d33-8164-eb431c1fc4a4",
                                "sense_id": "fb458847-16a3-38e9-8f38-6cd904f6435e",
                                "text": "De jaren 1562-63 hadden voor het Calvinisme de betekenis van een soortgelijke diepgaande verandering als een mensenleeftijd eerder het jaar 1533 voor de secte der Wederdopers: het werd ‘massaal en revolutionnair’."
                            }
                        ]
                    }
