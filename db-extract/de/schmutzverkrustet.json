                ],
                "senses": [
                    {
                        "sense_id": "5b762bd7-dcfc-3065-93aa-075f6ee651a3",
                        "entry_id": "48deb7f3-2426-322a-92fd-50b23440739b",
                        "glosses": [
                            "mit Schmutz verkrustet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd9f0d36-7160-4260-b473-29cbdb4ac86e",
                                "sense_id": "5b762bd7-dcfc-3065-93aa-075f6ee651a3",
                                "text": "„Sein linkes Auge betrachtete die schmutzverkrusteten Kanvasschuhe des Polizisten, während das rechte einem Froschbaby folgte, das die Constitution Avenue überquerte.“"
                            },
                            {
                                "example_id": "b00c7ad2-d34f-4dad-9c6b-fb4b1aa55a0f",
                                "sense_id": "5b762bd7-dcfc-3065-93aa-075f6ee651a3",
                                "text": "„Selbst die schmutzverkrusteten Schuhe trug er noch.“"
                            },
                            {
                                "example_id": "52e49a8c-091a-44ad-8a96-d1b274692434",
                                "sense_id": "5b762bd7-dcfc-3065-93aa-075f6ee651a3",
                                "text": "„Fahle Schwammgewächse, schwarmweise in feuchten Winkeln verborgen, kamen ans Licht; den ganzen Tag über hackten schmutzverkrustete Aufräumungsarbeiter den toten Mörtel aus den aufgestapelten schwarzen Ziegeln.“"
                            },
                            {
                                "example_id": "54904f49-fcde-4adc-a148-00f10fb7a308",
                                "sense_id": "5b762bd7-dcfc-3065-93aa-075f6ee651a3",
                                "text": "„Seine nackten Knie und Knöchel waren schmutzverkrustet, und als er näher kam, musste ich mich gegen den Gestank von Alter, Schweiß und Traurigkeit stählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
