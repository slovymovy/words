                "senses": [
                    {
                        "sense_id": "1d7e500b-dd2b-360c-9f09-e58073c095f5",
                        "entry_id": "059037ea-05f3-3bbe-bbbc-d0c7c200e437",
                        "glosses": [
                            "Technologie, die der Versorgung bestimmter Bereiche mit Kühlung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad1c1c78-de32-4df3-9f19-17d503483c2d",
                                "sense_id": "1d7e500b-dd2b-360c-9f09-e58073c095f5",
                                "text": "„Neben der Trocknung von Nahrungsmitteln wie Milch, Kaffee oder Suppen waren es die Konserven und die Kühltechnik, die den wichtigsten Beitrag zur Nationalisierung, Globalisierung und kontinuierlichen Versorgung mit Lebensmitteln leisteten.“"
                            },
                            {
                                "example_id": "3e62d9f6-a470-4818-9bfb-b4e4b03b499e",
                                "sense_id": "1d7e500b-dd2b-360c-9f09-e58073c095f5",
                                "text": "„Ohne Wärmeeinträge (Beheizung, Sonneneinstrahlung) oder Kühltechnik, nehmen Gebäude annähernd die Temperatur der Umgebung an.“"
                            },
                            {
                                "example_id": "c39d2b8a-3694-4372-88e4-f1eb87e44e71",
                                "sense_id": "1d7e500b-dd2b-360c-9f09-e58073c095f5",
                                "text": "Die Kühltechnik wirkt im Kühlschrank."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
