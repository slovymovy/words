                                "target_senses": [
                                    {
                                        "sense_id": "e2918222-7dbd-3b64-9d9f-c5952d30b74e",
                                        "entry_id": "be44beb8-e9f9-332c-8e50-2fb8fb11091c",
                                        "glosses": [
                                            "A room, often in a school, where classes take place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f334f116-8907-4f01-8767-851341286d25",
                                                "sense_id": "e2918222-7dbd-3b64-9d9f-c5952d30b74e",
                                                "text": "Secondly, preserved railways are not 24/7 operations. There are closed seasons where they can be turned into open-air classrooms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
