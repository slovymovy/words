                    {
                        "translation_id": "6f3d4fe5-5020-4cf6-a398-2ae18b612027",
                        "source_entry_id": "72f809ab-8690-39a2-9a01-968ae5caf831",
                        "source_sense_id": "efa53b01-7ebe-3092-a5a2-45f8efb91063",
                        "target_lang_word": "Kolostrum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolostrum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18055405-4c15-39b5-acca-4b91043a9a76",
                                        "entry_id": "b08f507e-ac3e-3d83-94c9-2e97b260bda8",
                                        "glosses": [
                                            "sehr eiweißreiches, besonders viele Abwehrstoffe enthaltendes, milchähnliches Sekret, das in den letzten Wochen der Schwangerschaft und in den ersten Tagen nach der Geburt von den Milchdrüsen abgesondert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775addd6-e1db-47dd-a98d-6abcf4b37306",
                                                "sense_id": "18055405-4c15-39b5-acca-4b91043a9a76",
                                                "text": "Muttermilch enthält eine stark wachstumsfördernde Substanz. Vor allem im Kolostrum, dem Sekret der ersten Tage nach der Geburt, ist dieser Stoff reichlich vorhanden: Seine Konzentration ist dann 15mal so hoch wie zwei Monate später."
                                            },
                                            {
                                                "example_id": "da4d4648-ccb0-48d7-9ca5-518e493e7417",
                                                "sense_id": "18055405-4c15-39b5-acca-4b91043a9a76",
                                                "text": "Das Lama-Kind hat in den Stunden nach seiner Geburt fleißig aus Muttis Zitzen \"Kolostrum\" gesaugt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d01cefb-056d-3128-8f32-aca740927e2d",
                                        "entry_id": "b08f507e-ac3e-3d83-94c9-2e97b260bda8",
                                        "glosses": [
                                            "bereits in der Antike bekanntes Nahrungsmittel aus der Erstmilch von Säugetieren, nunmehr auch Nahrungsergänzungsmittel zur Prävention und Unterstützung von Therapien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb1a939-fe2c-4747-81d1-aef6ee605b9c",
                                                "sense_id": "5d01cefb-056d-3128-8f32-aca740927e2d",
                                                "text": "Bei der Produktion wird nur überschüssiges Kolostrum verwendet, das vom Kalb nicht benötigt wird."
                                            },
