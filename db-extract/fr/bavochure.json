                        "glosses": [
                            "Défaut de ce qui est bavoché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "989cdfae-86d5-4783-ad38-090ec6fcb3d5",
                                "sense_id": "97927eab-bda2-3d0d-8718-2eab00ede7a0",
                                "text": "Il y a deux bavochures dans cette estampe."
                            },
                            {
                                "example_id": "75a43df0-b2b3-4f9f-a51b-011a98012d01",
                                "sense_id": "97927eab-bda2-3d0d-8718-2eab00ede7a0",
                                "text": "Cette impression est pleine de bavochures."
                            },
                            {
                                "example_id": "508caee2-b95d-4e74-82a5-cad70b85c686",
                                "sense_id": "97927eab-bda2-3d0d-8718-2eab00ede7a0",
                                "text": "Çà et là, la silhouette d’un vaisseau engagé dans un canal dépassait les verdures d’un jardin ou les toits d’un village, et le ciel immense, léger de ton, brouillé de nuages colorés en blanc par-dessus, en gris bleuâtre par-dessous, posait sur une ligne de terre et d’eau parfaitement horizontale, où les saillies des maisons et des arbres ne faisaient que de faibles bavochures"
                            },
                            {
                                "example_id": "6746f58d-b4a8-422c-8207-9a81d1e59ee7",
                                "sense_id": "97927eab-bda2-3d0d-8718-2eab00ede7a0",
                                "text": "Les bavochures ont un grand nombre de causes; quelques-unes même échappent à la perspicacité de l’ouvrier."
                            }
                        ]
                    }
                ],
