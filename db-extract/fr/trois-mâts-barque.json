                        "glosses": [
                            "Trois-mâts gréé en voiles carrées, excepté le mât d’artimon gréé en voiles auriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af306c5-968d-42a5-ba23-b8c86f3d9732",
                                "sense_id": "5bb4c6c2-9687-3988-93d7-713073a76a26",
                                "text": "Le Baltimore, trois-mâts-barque venant de la Havane, essuya de très-forts coups de vent de l’Ouest."
                            },
                            {
                                "example_id": "1559741e-2a5d-4fd9-997e-393286501eb8",
                                "sense_id": "5bb4c6c2-9687-3988-93d7-713073a76a26",
                                "text": "Il apparaissait notamment dans la Gazette de Hull et figurait en haut de la seconde page dans un numéro de cette feuille modeste que le Mary Queen, trois-mâts-barque chargé de charbon, apporta le 1ᵉʳ novembre à Rotterdam."
                            }
                        ]
