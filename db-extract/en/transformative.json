                                ]
                            },
                            {
                                "target_word": "transformateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f080126c-179f-3bcd-a2ed-49065e58eda7",
                                        "entry_id": "4d9aebe0-78b2-3987-ac12-ad925a76a149",
                                        "glosses": [
                                            "Appareil qui modifie la forme, l’intensité, la tension de l’énergie électrique qu’il reçoit."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "107a0096-15f2-4624-b990-4109a696e1cb",
                                                "sense_id": "f080126c-179f-3bcd-a2ed-49065e58eda7",
                                                "text": "Voilà… j’ai mis au point un transformateur spécial et une guirlande…"
                                            },
                                            {
                                                "example_id": "0e71866b-2fcb-4a0b-90af-e0a353f9ba8c",
                                                "sense_id": "f080126c-179f-3bcd-a2ed-49065e58eda7",
                                                "text": "Un vol de 910 kilos de câbles en cuivre a été signalé lundi sur un chantier de RTE (Réseau de Transport d'Electricité) à Crevin, au sud de Rennes, à proximité immédiate du site de construction d'un important transformateur."
                                            },
                                            {
                                                "example_id": "41b4b3ee-15e9-4f9d-9471-52e52a5a3f8c",
                                                "sense_id": "f080126c-179f-3bcd-a2ed-49065e58eda7",
                                                "text": "Même si le nombre exact reste inconnu, d’après l’association environ 4,5 millions de transformateurs sont installés en UE et en Norvège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeaed77a-96da-3b66-b6c3-ad13f589d030",
                                        "entry_id": "4d9aebe0-78b2-3987-ac12-ad925a76a149",
                                        "glosses": [
                                            "Tout intervenant dans l'industrie de la transformation de la viande, depuis l'abattoir jusqu'à la vente en gros, excluant cette dernière."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7779d7a-ddc4-43bc-9945-b0df5089446a",
                                                "sense_id": "aeaed77a-96da-3b66-b6c3-ad13f589d030",
                                                "text": "Un éleveur de porcs de Lanaudière dénonce les transformateurs comme Olymel, qui achète plus d’un million de porcs de l’Ontario chaque année alors que nos porcheries débordent de cochons."
                                            },
                                            {
                                                "example_id": "f56db3dc-5ee9-483c-9d6f-4a54cf68049c",
                                                "sense_id": "aeaed77a-96da-3b66-b6c3-ad13f589d030",
                                                "text": "Selon ces pêcheurs, les seuls dans la province à être regroupés autour d’un office de mise en marché, les transformateurs ne respectent pas une formule de prix qui leur permettrait d’obtenir davantage que 2,25$ par livre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transformateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d11de2ac-274e-357b-9b7d-ceceb5b7ed15",
                                        "entry_id": "72ecfa0e-23b1-3cf5-8437-dea6dd40cd2e",
                                        "glosses": [
                                            "Personne qui transforme ou qui se transforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa3010f9-1899-4561-85f6-9f0083ee1157",
                                                "sense_id": "d11de2ac-274e-357b-9b7d-ceceb5b7ed15",
                                                "text": "Une femme en devenir, une transformatrice se doit de rester souple, ouverte, et plutôt feuilleter les éphémérides au cours des transitions importantes de sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
