                        "entry_id": "58b99e19-a6f8-3d15-a5c8-74e64cee69d8",
                        "glosses": [
                            "wachsartige Substanz aus dem Darm des Pottwals, die früher zur Parfümherstellung verwendet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd3dffc-2411-4e26-8116-284d9bd6cc13",
                                "sense_id": "fdd1ff45-330b-3e3e-8389-1b7c7ee6f697",
                                "text": "Amber war zeitweise teurer als Gold."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53142f98-5332-48ec-b3e1-b2ea11ba36ef",
                        "source_entry_id": "58b99e19-a6f8-3d15-a5c8-74e64cee69d8",
                        "source_sense_id": "fdd1ff45-330b-3e3e-8389-1b7c7ee6f697",
                        "source_sense_description": "wachsartige Substanz aus dem Darm des Pottwals, die früher zur Parfümherstellung verwendet wurde",
                        "target_lang_word": "Ambra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ambra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                        "entry_id": "c2ce5d98-d43b-350a-9d6e-207cd140acad",
                                        "glosses": [
                                            "fettige Substanz aus dem Darm des Pottwals, die früher in Parfüms verwendet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5413e6d2-d08d-4d9a-bc99-74f133237e48",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "Ambra wird heute synthetisch hergestellt."
                                            },
                                            {
                                                "example_id": "d4f3e679-29b1-43c5-a928-d10d3ce4c1aa",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "Frische Ambra riecht sehr unangenehm."
                                            },
                                            {
                                                "example_id": "d5bf9d7f-dc3b-47ef-a7c4-8bed795c54f8",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "„Im obersten Knopfloch seines Rockes trug er einen großen Strauß aus Tuberosen und Narzissen; ein starker Duft von Ambra entströmte der Pomade, mit der er Perücke und Brauen am Kopf festgeklebt hatte, und sein durchdringender Mundgeruch mißfiel zwar nicht Madame D'Urfé, war mir aber unerträglich.“"
                                            },
                                            {
                                                "example_id": "dc8fbd6c-3250-4b2d-9c19-951d91c0355e",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "„Die Berberin brachte Clerfayt lautlos Ambra.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
