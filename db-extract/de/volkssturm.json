                ],
                "senses": [
                    {
                        "sense_id": "93d7b1e9-922b-3dba-b145-70cfee2766a2",
                        "entry_id": "fa459875-a50f-392d-a229-c41cf8df6430",
                        "glosses": [
                            "generell Volksaufstand gegen die herrschende Klasse, z. B. während der Zeit der Französischen Revolution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24679d60-0100-4bf8-885b-c5dc0719e731",
                                "sense_id": "93d7b1e9-922b-3dba-b145-70cfee2766a2",
                                "text": "„Ich behaupte, daß eine jede republikanische, oder andere Verfassung, welche diesen Satz nicht annimmt, und welche dem Aufstande an sich (ohne Rücksicht auf die Art oder den Zweck desselben) diejenigen Eigenschaften beilegt, die nur dem Gesetze zukommen, weiter nichts ist, als ein auf Sand ruhendes Gebäude, welches der nächste Volkssturm einstürzt.“"
                            },
                            {
                                "example_id": "67c5aca5-e161-446f-b979-b8df217c4b39",
                                "sense_id": "93d7b1e9-922b-3dba-b145-70cfee2766a2",
                                "text": "„Bei uns ging also der Volkssturm in Stellung.“"
                            },
                            {
                                "example_id": "e1812a98-c40a-4239-9d42-5d7c88c3e939",
                                "sense_id": "93d7b1e9-922b-3dba-b145-70cfee2766a2",
                                "text": "„Der Krieg wird für die sechzehnjärige Agathe erst im Januar 1945 wirklich spürbar, als Vater Johann zum Volkssturm eingezogen wird.“"
                            },
                            {
                                "example_id": "9ee8fcef-cbf5-4646-b8b8-66188205df5e",
                                "sense_id": "93d7b1e9-922b-3dba-b145-70cfee2766a2",
                                "text": "„Der Kompanieführer des Zingster Volkssturms hieß Andreas Schmidt und war gleichzeitig Amtsvorsteher in Zingst.“"
                            },
                            {
                                "example_id": "259d6d17-2dea-45d2-9082-ece4e958f8cb",
                                "sense_id": "93d7b1e9-922b-3dba-b145-70cfee2766a2",
                                "text": "„Der ganze Volkssturm wurde in Stolp in einen riesig langen Zug verladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af952883-b3b1-358a-86f0-27db232a4fb8",
                        "entry_id": "fa459875-a50f-392d-a229-c41cf8df6430",
