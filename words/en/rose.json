                        "zh": [
                            {
                                "target_lang_word": "玫瑰色",
                                "target_lang_sense_clarification": "颜色"
                            },
                            {
                                "target_lang_word": "玫红",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
