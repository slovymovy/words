                        "form": "das Geschiebe"
                    },
                    {
                        "form_id": "0e289043-7567-4008-a69e-fe4b01552ef4",
                        "entry_id": "14f9b519-8941-3ae3-b1b6-59e888b6dc24",
                        "tags": [
                            "accusative",
