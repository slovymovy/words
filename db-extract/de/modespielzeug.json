                "senses": [
                    {
                        "sense_id": "8d9c3ae5-1a36-37bb-8d74-23c36414040b",
                        "entry_id": "a9075dfb-0cc0-3335-92e2-3885f0ad8ac3",
                        "glosses": [
                            "Spielzeug, das der aktuellen Mode entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b768352-54d4-4be1-94df-413d6fbebec3",
                                "sense_id": "8d9c3ae5-1a36-37bb-8d74-23c36414040b",
                                "text": "„Kennen und wünschen deine Kinder von sich aus auch anderes als das gerade gängige Modespielzeug?“"
                            },
                            {
                                "example_id": "10be56b7-2856-4614-8bdd-a8969d59b6f7",
                                "sense_id": "8d9c3ae5-1a36-37bb-8d74-23c36414040b",
                                "text": "„Als in den dreißiger Jahren die ersten Eisenbahnen in Frankreich gebaut werden sollten, verhielt er sich ablehnend und nannte sie »ein Modespielzeug, an das nach wenigen Jahren niemand mehr denken würde«.“"
                            },
                            {
                                "example_id": "2af6e565-36fd-4865-be0b-a42d8911a57b",
                                "sense_id": "8d9c3ae5-1a36-37bb-8d74-23c36414040b",
                                "text": "„Eher ein synthetisches Modespielzeug, oder sagen wir, ein Produkt zum intellektuellen Werbrauch für eine Elite, die das Miese kultiviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
