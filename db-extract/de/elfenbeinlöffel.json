                "senses": [
                    {
                        "sense_id": "be15526d-2b9c-3684-a1a3-2c66bfc76dfe",
                        "entry_id": "3c506e0d-15a9-38f7-b863-3f338db4d56c",
                        "glosses": [
                            "aus Elfenbein hergestellter Esslöffel"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a7ee7d-5ae8-4ae5-82a5-4cb5fd8d783d",
                                "sense_id": "be15526d-2b9c-3684-a1a3-2c66bfc76dfe",
                                "text": "„Das Bett wurde im Alkoven untergebracht, und mein Essen auf einen kleinen Tisch gestellt; mein Besteck bestand aus einem Elfenbeinlöffel, den er für mein Geld gekauft hatte; Gabel, Messer und alle schneidenden Werkzeuge waren verboten.“"
                            },
                            {
                                "example_id": "8e0c43fb-72ae-477d-9646-55f17987fc2b",
                                "sense_id": "be15526d-2b9c-3684-a1a3-2c66bfc76dfe",
                                "text": "„Aus diesem Haarwulst ragt der zierlich geschnitzte Stiel des kleinen Elfenbeinlöffels hervor, dessen sich der Kaffer bedient, um seine Nase mit Schnupftabak zu füllen.“"
                            },
                            {
                                "example_id": "13f0d07d-3b97-4dba-8700-f3ea552e36ac",
                                "sense_id": "be15526d-2b9c-3684-a1a3-2c66bfc76dfe",
                                "text": "„Klar, es wäre schon elitär, wenn der Spartenchef sein Frühstücksei mit einem von Carla besorgten Elfenbeinlöffel schlappern könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
