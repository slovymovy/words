{
    "word_family": [
        "onion-like",
        "oniony"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "655d0baa-806e-3edc-bb8b-97bf376e03ef",
                    "sense_definition": "The edible bulb of a plant with a strong taste and smell, used as a vegetable.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "onion_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always start my pasta sauce by frying a finely chopped <w>onion</w> in olive oil.",
                            "target_lang_translations": {
                                "ru": "Я всегда начинаю готовить соус для пасты с обжаривания мелко нарезанного <w>лука</w> на оливковом масле."
                            }
                        },
                        {
                            "text": "My eyes usually start to water whenever I am <w>chopping</w> <w>onions</w> for dinner.",
                            "target_lang_translations": {
                                "ru": "У меня обычно начинают слезиться глаза, когда я режу <w>лук</w> к ужину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chopped onion",
                        "red onion",
                        "fried onions",
                        "raw onion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобная луковица растения с резким вкусом и запахом, используемая как овощ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лук",
                                "target_lang_sense_clarification": "овощ"
                            },
                            {
                                "target_lang_word": "репчатый лук",
                                "target_lang_sense_clarification": "конкретный вид овоща"
                            },
                            {
                                "target_lang_word": "луковица",
                                "target_lang_sense_clarification": "одна головка лука"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d1ca7a6-7a2b-3c4a-8023-42fc9c1d27e0",
                    "sense_definition": "A plant of the genus Allium, specifically Allium cepa, grown for its edible bulb.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onion_plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer decided to plant a new row of <w>onion</w> in the garden this spring.",
                            "target_lang_translations": {
                                "ru": "Этой весной фермер решил посадить в саду новый ряд <w>лука</w>."
                            }
                        },
                        {
                            "text": "A <w>spring</w> <w>onion</w> is often harvested early before the bulb has fully developed.",
                            "target_lang_translations": {
                                "ru": "Зелёный <w>лук</w> часто собирают рано, до того как луковица полностью разовьется."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spring onion",
                        "wild onion",
                        "onion plant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение рода Allium, в частности Allium cepa, выращиваемое ради его съедобной луковицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лук",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "луковое растение",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9762bcf1-bc6a-397a-a599-bd225c95ad69",
                    "sense_definition": "A decorative seal attached to a pocket watch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman pulled out his gold watch, which featured a heavy <w>onion</w> hanging from the chain.",
                            "target_lang_translations": {
                                "ru": "Джентльмен вытащил свои золотые часы, на цепочке которых висела тяжелая <w>луковица</w>."
                            }
                        },
                        {
                            "text": "In old slang, a thief might target a wealthy man just to steal his silver <w>onion</w>.",
                            "target_lang_translations": {
                                "ru": "На старом сленге вор мог выбрать целью богача только для того, чтобы украсть его серебряную <w>луковицу</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "thieves' cant"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный брелок или печать, прикрепляемая к карманным часам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "луковица",
                                "target_lang_sense_clarification": "старинные карманные часы или аксессуар к ним"
                            },
                            {
                                "target_lang_word": "брелок",
                                "target_lang_sense_clarification": "украшение на цепочке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17bd9f74-d67b-3f24-9b7f-adfcd1b719cc",
                    "sense_definition": "A derogatory term referring to soy or individuals associated with the soy boy stereotype.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet forum was filled with users using <w>onion</w> as a coded insult for certain lifestyles.",
                            "target_lang_translations": {
                                "ru": "Интернет-форум был полон пользователей, использующих слово «<w>лук</w>» как зашифрованное оскорбление определенного образа жизни."
                            }
                        },
                        {
                            "text": "He used the term <w>onion</w> to mock the dietary choices of his political opponents online.",
                            "target_lang_translations": {
                                "ru": "Он использовал термин «<w>лук</w>», чтобы высмеять диетические предпочтения своих политических оппонентов в сети."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уничижительный термин, относящийся к сое или людям, ассоциирующимся со стереотипом «соевого парня»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лук",
                                "target_lang_sense_clarification": "интернет-сленг, оскорбление"
                            },
                            {
                                "target_lang_word": "соевый",
                                "target_lang_sense_clarification": "переносное значение, сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "eb5a90a5-ede6-3087-8902-24fa31cbafe2",
                    "sense_definition": "A person who lives in or comes from Bermuda.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The local <w>Onion</w> explained the history of the island's famous architecture to the tourists.",
                            "target_lang_translations": {
                                "ru": "Местный <w>бермудец</w> объяснил туристам историю знаменитой архитектуры острова."
                            }
                        },
                        {
                            "text": "Being a true <w>Onion</w>, he felt a deep connection to the maritime traditions of Bermuda.",
                            "target_lang_translations": {
                                "ru": "Будучи истинным <w>бермудцем</w>, он чувствовал глубокую связь с морскими традициями Бермудских островов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Bermuda"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который живет на Бермудских островах или родом оттуда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бермудец",
                                "target_lang_sense_clarification": "житель Бермуд"
                            },
                            {
                                "target_lang_word": "луковица",
                                "target_lang_sense_clarification": "прозвище жителей Бермуд"
                            }
                        ]
                    }
                }
            ]
        }
    ]
