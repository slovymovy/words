                                                "sense_id": "be49e6be-0f08-395c-a2a0-a6ac5a0b1bd4",
                                                "text": "No sight could pass / Betwixt the nice partitions of the grass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d43a49-18ae-34b7-b45b-dbc0d9150ad3",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "A part divided off by walls; an apartment; a compartment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
