                        "glosses": [
                            "bedrijf dat bestaat uit een aantal losse bedrijven die modeartikelen produceren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b970a3bf-e4d7-4b93-81bc-76a99cfb8bdb",
                                "sense_id": "906c08c7-b708-3648-9fa2-3bd999de861e",
                                "text": "Het van oorsprong Zwiterse bedrijf werd in december overgenomen door het Italiaanse modeconcern Sempione Retail AG. Toen werd al bekend dat het zich meer gaat richten op andere markten."
                            },
                            {
                                "example_id": "5f0bea59-0a47-48bd-93be-3e2fa61f6e92",
                                "sense_id": "906c08c7-b708-3648-9fa2-3bd999de861e",
                                "text": "Ook bij het Spaanse modeconcern Inditex, het bedrijf achter Zara, Pull&Bear en Bershka, doet de beslissing om de winkels te sluiten pijn. Rusland is na Spanje de belangrijkste markt voor het bedrijf. Inditex zegt dat onder de huidige omstandigheden de continuïteit van de activiteiten in Rusland niet kan worden gegarandeerd. De Russische invasie in Oekraïne wordt niet als reden genoemd."
                            }
                        ]
