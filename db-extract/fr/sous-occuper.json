                "senses": [
                    {
                        "sense_id": "4f178a6a-254b-33de-87e1-77a044358ef1",
                        "entry_id": "693fa4b0-e613-3bac-b1b1-457351d18c84",
                        "glosses": [
                            "Occuper moins que ce qui serait possible et normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a739dbe8-675f-4ff6-a182-9f732e716822",
                                "sense_id": "4f178a6a-254b-33de-87e1-77a044358ef1",
                                "text": "Pour répondre aux besoins de logements HLM de grande surface, les locataires qu'un changement de situation familiale conduit à \" sous-occuper \" un logement plus grand que ne le justifient leurs besoins ne pourront plus le conserver."
                            },
                            {
                                "example_id": "2b10ad68-c008-43cd-9d58-b172a5128328",
                                "sense_id": "4f178a6a-254b-33de-87e1-77a044358ef1",
                                "text": "Les locataires de 60 ans et plus ont en effet tendance à sous-occuper les grands logements du parc social."
                            },
                            {
                                "example_id": "34789594-98f8-4002-b23d-8a5fc54c7fe7",
                                "sense_id": "4f178a6a-254b-33de-87e1-77a044358ef1",
                                "text": "En résumé, voulons-nous brader cette parcelle de 18000 m2, la sous-occuper pendant un certain nombre d'années?"
                            }
                        ]
                    }
                ],
