                "senses": [
                    {
                        "sense_id": "6a37b1e0-b89a-35df-8f1d-f970af032d15",
                        "entry_id": "d3bac153-fa6f-3a3c-8f53-dcc3603fc826",
                        "glosses": [
                            "chemische Verbindung, bei der Astat als Bestandteil enthalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb19d299-9352-428f-bb5e-6892ccc9942c",
                                "sense_id": "6a37b1e0-b89a-35df-8f1d-f970af032d15",
                                "text": "„Fähigkeit des Astats, organische Verbindungen zu bilden, als auch die thermodynamisch geringe Stabilität von Astatverbindungen hervorgehoben.“"
                            },
                            {
                                "example_id": "11bd5a05-805f-4091-a64d-f51b789ee691",
                                "sense_id": "6a37b1e0-b89a-35df-8f1d-f970af032d15",
                                "text": "„Die Synthesen der verschiedenen Astatverbindungen erfolgten mit jeweils 0,2 ml wäßriger, elementares Astat enthaltender Lösung durch Umsetzung mit den in Tab. 1 angeführten Reagenzien.“"
                            },
                            {
                                "example_id": "ef8e8f5b-4743-4145-ac2f-3187cd2d8506",
                                "sense_id": "6a37b1e0-b89a-35df-8f1d-f970af032d15",
                                "text": "„Die Messung der Wanderungsgeschwindigkeiten der einzelnen Astatverbindungen erfolgte in der bereits beschriebenen experimentellen Anordnung, 1,2. “"
                            },
                            {
                                "example_id": "114570ce-f51c-4f54-80ec-6153a7e36daa",
                                "sense_id": "6a37b1e0-b89a-35df-8f1d-f970af032d15",
                                "text": "„Organische Astatverbindungen setzt man zur Bestrahlung bösartiger Tumore und als radioaktive Markierungsmittel für die Schilddrüse ein, denn Astat wird wie Iod in der Schilddrüse angereichert und in der Leber gespeichert […]“"
                            },
                            {
                                "example_id": "c60993e1-b345-4d6b-a187-a7e9ecdbd853",
                                "sense_id": "6a37b1e0-b89a-35df-8f1d-f970af032d15",
                                "text": "„Organische Astatverbindungen dienen in der Nuklearmedizin zur Bestrahlung bösartiger Tumore.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
