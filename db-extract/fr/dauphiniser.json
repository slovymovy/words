                "senses": [
                    {
                        "sense_id": "7f5fd5ad-0ce5-3ea9-b8a0-239be7321c43",
                        "entry_id": "65599a68-595c-37c7-990a-92e3bf2107c0",
                        "glosses": [
                            "Donner un caractère rappelant un dauphin (l’animal) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af357d4c-b6d9-4124-9c0e-abb9f953349a",
                                "sense_id": "7f5fd5ad-0ce5-3ea9-b8a0-239be7321c43",
                                "text": "L’humilité, la simplicité et le dynamisme avec lesquels vous avez rendu vos exemples auront, quant à eux, l’effet d’ondes recherché: dauphiniser nos relations."
                            },
                            {
                                "example_id": "3a5d17f5-3910-47fb-abc9-32b8f1e9dfc0",
                                "sense_id": "7f5fd5ad-0ce5-3ea9-b8a0-239be7321c43",
                                "text": "T'inquiète je vais te dauphiniser"
                            }
                        ]
                    },
                    {
                        "sense_id": "1517205b-9677-391a-af79-9ee30edbbc55",
                        "entry_id": "65599a68-595c-37c7-990a-92e3bf2107c0",
                        "glosses": [
                            "Donner un caractère de dauphin, de second, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5546f028-61f6-4758-af88-17d556c14073",
                                "sense_id": "1517205b-9677-391a-af79-9ee30edbbc55",
                                "text": "Ils s'apprêtent à reprendre la course, même si dans les têtes le Tour est déjà bouclé, Indurain intronisé, Zülle dauphinisé, Jalabert reverdi et Virenque à pois."
                            }
                        ]
                    }
