                                "target_senses": [
                                    {
                                        "sense_id": "595b77f0-5f80-318c-af16-ea11aa42f155",
                                        "entry_id": "ee9da277-435e-36be-8d06-ed8f2aeaa8a3",
                                        "glosses": [
                                            "To divide by six, equivalent to multiplying a denominator by six."
