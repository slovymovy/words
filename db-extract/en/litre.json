                                "target_senses": [
                                    {
                                        "sense_id": "abcb3dfc-f823-3a2e-861a-74729ac3c363",
                                        "entry_id": "474156e7-21e4-3208-a500-86537f809234",
                                        "glosses": [
                                            "metrická jednotka objemu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56fcd808-ebfa-43b8-bfae-1a1a6729500b",
                                                "sense_id": "abcb3dfc-f823-3a2e-861a-74729ac3c363",
                                                "text": "Koupil jsem si rohlíky a půl litru mléka."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546828d9-d4f1-380b-b50b-f156992b4470",
                                        "entry_id": "474156e7-21e4-3208-a500-86537f809234",
                                        "glosses": [
                                            "tisíc korun"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b86d5e35-f6a9-42b4-974f-39c861588cf0",
                                                "sense_id": "546828d9-d4f1-380b-b50b-f156992b4470",
                                                "text": "Ta nová motorka ho přišla na sto padesát litrů."
                                            },
                                            {
                                                "example_id": "17680f8c-a5d4-4a8c-b497-78e56162d6b8",
                                                "sense_id": "546828d9-d4f1-380b-b50b-f156992b4470",
                                                "text": "Toto píšu i na základě vlastní zkušenosti, kdy nedoplatek pojišťovně ve výši sto padesáti korun, o které mě pojišťovna nikdy neurgovala a dluh vznikl bordelem v pojišťovně, šel k advokátovi a jen náhodou neskončil u soudu. Takže mě to stálo jen osm litrů, jinak, jak jsem se dozvěděl, by se to vyhouplo na pětatřicet litrů. To je přece hnus, převyšující cokoli odporného ve věci finančnictví"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "604093f9-1198-4037-8d4d-2403a2f94f18",
                        "source_entry_id": "6cc35034-dea4-3bb0-94a4-37bbfeb9d023",
                        "source_sense_description": "unit of fluid measure",
                        "target_lang_word": "liter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c2151cd-4c83-3b17-86cf-fa71b0a72a78",
                                        "entry_id": "5b96d0c8-dd27-3c6c-9757-ce999b7f54cc",
                                        "glosses": [
                                            "een inhoudsmaat voor voornamelijk vloeistoffen en gassen, gelijk aan 1.000 milliliter, gelijk aan 0,001 kiloliter, gelijk aan 0,001 kubieke meter, gelijk aan één kubieke decimeter, weergegeven met symbool l, L of ℓ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4eda41-8357-40ea-8281-35075325ddf0",
                                                "sense_id": "0c2151cd-4c83-3b17-86cf-fa71b0a72a78",
                                                "text": "Dit pak bevat twee liter melk."
                                            },
                                            {
                                                "example_id": "82fb0cfe-0971-454a-beee-c046c6f23cbc",
                                                "sense_id": "0c2151cd-4c83-3b17-86cf-fa71b0a72a78",
                                                "text": "Er zou die dag namelijk pas na 32 kilometer water te vinden zijn, waardoor ik zeven liter water boven op mijn basisuitrusting mee moest sjouwen."
                                            },
                                            {
                                                "example_id": "3c4a1cfb-f0e5-407a-bfe7-72e615758b7e",
                                                "sense_id": "0c2151cd-4c83-3b17-86cf-fa71b0a72a78",
                                                "text": "Grote omgevallen boomstammen zaten klem tussen de rotsen en waren geheel kaal en afgestompt door de sterke stroming die miljoenen liters smeltwater per dag uit de bergen moest verwerken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed4d4cc-603f-4a90-b00b-1045c11deaea",
                        "source_entry_id": "6cc35034-dea4-3bb0-94a4-37bbfeb9d023",
                        "source_sense_description": "unit of fluid measure",
                        "target_lang_word": "litre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "litre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da74dafe-ae76-35db-a862-b5fe0116c783",
                                        "entry_id": "6e09263e-0d84-38e3-af30-065de1544c04",
                                        "glosses": [
                                            "Unité de capacité du système métrique égale à un décimètre cube (dm³), couramment employé pour mesurer les volumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0f059d-8dc7-483c-a654-9f4ab71730cf",
                                                "sense_id": "da74dafe-ae76-35db-a862-b5fe0116c783",
                                                "text": "Un nouveau réservoir d’eau claire de 200 litres conservera l’eau, mieux que des barils de chêne."
                                            },
                                            {
                                                "example_id": "32ef8b5f-db3a-4b08-b5cf-ffc59d9d5e6c",
                                                "sense_id": "da74dafe-ae76-35db-a862-b5fe0116c783",
                                                "text": "Notre hydravion chargé de 2.600 litres d’essence accusait un poids de 5.500 kilogrammes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "476be566-69ba-35bf-bc71-e1481676f19d",
                                        "entry_id": "6e09263e-0d84-38e3-af30-065de1544c04",
                                        "glosses": [
                                            "Récipient, bouteille qui contient un litre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad452a2d-12c7-4a8f-b3b9-f0f1d08a31b2",
                                                "sense_id": "476be566-69ba-35bf-bc71-e1481676f19d",
                                                "text": "Résignée, elle mit dans le cabas deux litres vides et s’en fut à l’auberge d’où elle revint bientôt avec le vin."
                                            },
                                            {
                                                "example_id": "a1c10f19-ddf4-4526-981e-27048ce06ce3",
                                                "sense_id": "476be566-69ba-35bf-bc71-e1481676f19d",
                                                "text": "— Qu’on m’apporte un litre, un litre vrai, un litre… naturel.\n— Je…\n— Oui, vous me comprenez, un litre de verre, mais de marque… authentifié par une maison sérieuse… Un litre Pernod, par exemple… vide, bien entendu…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c4816a-d15f-3d28-8a1a-8f88a92be100",
                                        "entry_id": "6e09263e-0d84-38e3-af30-065de1544c04",
                                        "glosses": [
                                            "Contenu de ce récipient."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4af3bfa-0bab-4af4-a4b9-5d96c33cbd23",
                                                "sense_id": "62c4816a-d15f-3d28-8a1a-8f88a92be100",
                                                "text": "Regardez. Brutalement éclairées par une lampe, de vieilles gens autour d'une table vident un litre d'aramon."
                                            },
                                            {
                                                "example_id": "efeed7c7-4067-485b-8740-092d8e98a70d",
                                                "sense_id": "62c4816a-d15f-3d28-8a1a-8f88a92be100",
                                                "text": "Ô riche et chanceux Hérault, toi qui verses au cœur des citadins déprimés l’intarissable joie liquide de tes litres vendus par toi trente sous et revendus, par l’épicier ou sur le zinc, trois francs."
                                            },
                                            {
                                                "example_id": "d4117f85-d483-4f3b-920d-36e09a3f99d1",
                                                "sense_id": "62c4816a-d15f-3d28-8a1a-8f88a92be100",
                                                "text": "Bref, nous avions fini le litre, assis sur une grosse souche, avec la fameuse couverture pendue aux branches, qui pissait l’eau comme une gouttière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "litre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a86961e-1c6d-3116-a9a5-13d38a721f64",
                                        "entry_id": "040e6e18-65ef-3c7d-b8d4-c08ea30014ed",
                                        "glosses": [
                                            "Grande bande ou ceinture noire qu’on tend autour de l’église aux obsèques célébrées en grande pompe et sur laquelle sont appliquées ou peintes les armoiries (obiit) ou les initiales du défunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9fb3d59-dc1d-4176-aeba-e9fdf707aab1",
                                                "sense_id": "9a86961e-1c6d-3116-a9a5-13d38a721f64",
                                                "text": "Droit de litre, droit qu’avaient les seigneurs de faire mettre à l’intérieur des églises une litre portant leurs armoiries."
                                            },
                                            {
                                                "example_id": "95facb6b-a897-4e5d-9765-3a52c239a32f",
                                                "sense_id": "9a86961e-1c6d-3116-a9a5-13d38a721f64",
                                                "text": "La grande porte s’ouvrit, laissant voir au fond de la nef tendue de grandes litres à larmes d’argent un catafalque déjà tout flamboyant de luminaire, auprès de quoi, récitant son bréviaire, attendait le premier vicaire, rigoureusement seul sous l’ampleur des voûtes."
                                            }
                                        ]
                                    }
                                ]
                            },
