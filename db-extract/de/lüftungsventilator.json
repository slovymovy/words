                "senses": [
                    {
                        "sense_id": "d5409652-c58b-3100-b911-c4f1d4dc2fe6",
                        "entry_id": "e6480e56-1173-3105-8b4c-eccc7222ebf6",
                        "glosses": [
                            "Gerät oder technische Einrichtung die zielgerichtet Luft, durch Drehung eines Ventilatorrad, fördert und den Druck im System verändert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328bbe56-5298-4583-b9b9-7be1c50dab3e",
                                "sense_id": "d5409652-c58b-3100-b911-c4f1d4dc2fe6",
                                "text": "„Im Laufe der Zeit haben wir für die Lüftung eine Produktpalette an Ventilatoren entwickelt, die keinen Anwendungsfall unberücksichtigt läßt: verschiedene Ausführungen von Dach-, Axial- Radial- und Kunststoffventilatoren zeigen die möglichen Variationen unserer Lüftungsventilatoren.“"
                            },
                            {
                                "example_id": "800e8526-8026-4128-aed4-4dbe9da22f96",
                                "sense_id": "d5409652-c58b-3100-b911-c4f1d4dc2fe6",
                                "text": "„Ob Dach-, Axial-, Radial-, Kanal-, Rohr- oder Kunststoffventilatoren - TROX TLT fertigt 22 verschiedene Typen Lüftungsventilatoren in insgesamt 219 Baugrößen in eigener deutscher Produktion.“"
                            },
                            {
                                "example_id": "827f2c36-342d-4ce0-810a-d5aeb0366c5f",
                                "sense_id": "d5409652-c58b-3100-b911-c4f1d4dc2fe6",
                                "text": "„Lüftungsventilatoren müssen die festgelegte Zielenergieffizienz erreichen.“"
                            },
                            {
                                "example_id": "64527f5d-19b8-4168-9d33-dbcdfc3f09e8",
                                "sense_id": "d5409652-c58b-3100-b911-c4f1d4dc2fe6",
                                "text": "„Der reine Stromverbrauch nimmt durch die Leistungsaufnahme der Lüftungsventilatoren zu.“"
                            },
                            {
                                "example_id": "37b03fac-f381-4f21-b317-d1e252e47a7d",
                                "sense_id": "d5409652-c58b-3100-b911-c4f1d4dc2fe6",
                                "text": "„Die Kontrolle der Lüftungsventilatoren für das Ober- und das Unterdeck ergaben, dass beide ohne spürbaren Widerstand gedreht werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
