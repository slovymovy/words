                "senses": [
                    {
                        "sense_id": "c9a86d27-1576-3a51-b814-1391052d1049",
                        "entry_id": "63755aac-a19a-3332-ba9f-d18fd56d2f76",
                        "glosses": [
                            "im Einklang mit einer (spezifischen) Ermächtigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e6f93e-266d-4272-a815-c933538421d1",
                                "sense_id": "c9a86d27-1576-3a51-b814-1391052d1049",
                                "text": "„Soweit eine Ermächtigung vorliegt, ist die nationale Sonderregelung ermächtigungskonform auszulegen und erforderlichenfalls fortzubilden, da eine Ratsermächtigung Bestandteil des höherrangigen Gemeinschaftsrechts ist.“"
                            },
                            {
                                "example_id": "98e39018-3a35-4aca-bc53-878bb3be0d83",
                                "sense_id": "c9a86d27-1576-3a51-b814-1391052d1049",
                                "text": "„Das Landessozialgericht Berlin – Brandenburg hat in seiner Entscheidung vom 25.04.2013 – L 36 AS 2095/12 NK – klargestellt, dass die in § 6 WAV getroffenen Regelungen zum Teil ohne Ermächtigung bzw. nicht ermächtigungskonform sind und der Verordnungsgeber mit dem überwiegenden Teil der dazu getroffenen Regelungen den Regelungsbereich, der nach § 8 AG-SGB II i.V.m. §§ 22a bis 22c SGB II satzungsrechtlicher – hier verordnungsrechtlicher Regelung ist verlässt, weil er Materien ordnet, die § 22 Abs. 1 Satz 3 SGB II (bzw. § 35 Abs. 1 und 2 SBG XII) unterliegen.“"
                            },
                            {
                                "example_id": "f8df2507-85eb-4f05-bbd1-cbdb47952d84",
                                "sense_id": "c9a86d27-1576-3a51-b814-1391052d1049",
                                "text": "„Wird beispielsweise in einer Lückenfüllungssatzung die Art der baulichen Nutzung (das Baugebiet i. S. d. Gebietstypen der BauNVO) festgesetzt, muss eine solche Fortsetzung – soll sie nicht als unwirksam angesehen werden – ermächtigungskonform dahingehend interpretiert werden, dass sie die Rechtswirkungen des § 35 Abs. 6 Satz 1 auf Nutzungen der jeweiligen Art erstrecken will.“"
                            },
                            {
                                "example_id": "9679a4bf-1779-48dc-9c14-6cbbe9242a64",
                                "sense_id": "c9a86d27-1576-3a51-b814-1391052d1049",
                                "text": "„§ 7 Abs. 6 gibt nunmehr ermächtigungskonform auch für die Vereinbarung eines Malus die Schriftlichkeit vor.“"
                            },
                            {
                                "example_id": "b16747c0-7ee6-4921-a89b-55181fc5d559",
                                "sense_id": "c9a86d27-1576-3a51-b814-1391052d1049",
                                "text": "„§ 7 ist daher einschränkend ermächtigungskonform auszulegen; er kann Ansprüche, die in keinem Zusammenhang mit einem GüKUMT-Frachtvertrag stehen, nicht erfassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
