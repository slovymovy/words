                "senses": [
                    {
                        "sense_id": "74f5e43c-5d5f-37a6-abaf-fd236ac9e9d4",
                        "entry_id": "1c8ad219-333c-3a9c-927e-0467675dede0",
                        "glosses": [
                            "schwerer, lehmiger, fetter, bindiger Boden der Marsch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf494ad-1610-4c21-9eed-f4e10a4db687",
                                "sense_id": "74f5e43c-5d5f-37a6-abaf-fd236ac9e9d4",
                                "text": "„Der Marschboden zeichnet sich außer seiner für das Pflanzenwachsthum geeigneten Zusammensetzung noch besonders dadurch aus, daß er begierig Feuchtigkeit und Gase einsaugt und dann leicht an der Luft zerfällt.“"
                            },
                            {
                                "example_id": "427fdf0a-801d-49ab-b4c5-46e37fc09596",
                                "sense_id": "74f5e43c-5d5f-37a6-abaf-fd236ac9e9d4",
                                "text": "„Der Marschboden breitet sich beiderseits der Elbe mit nahezu waagrechter, zwischen 0,3 und 1,7 m über Normalnull liegender Oberfläche aus und hat am Hamburger Ufer eine mittlere Breite von rund 8 km.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
