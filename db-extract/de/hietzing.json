                ],
                "senses": [
                    {
                        "sense_id": "a9762e22-c60a-336c-96ec-780577d4abf1",
                        "entry_id": "693d2d8a-3f8a-3674-9c3f-3d9f1db7c2a6",
                        "glosses": [
                            "dreizehnter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02524414-b77b-4085-b203-e174f1ca1631",
                                "sense_id": "a9762e22-c60a-336c-96ec-780577d4abf1",
                                "text": "Während die Innere Stadt gegenüber dem Wien-Schnitt um 40,1 Prozent, die Josefstadt um 9,1, Währing um 3,3, Neubau um 2,9 und Hietzing um 2,7 Prozent zulegten, verloren die einkommensschwachen Bezirke."
                            },
                            {
                                "example_id": "3d6d8278-fb0e-47ae-af87-d09db3ac3a2d",
                                "sense_id": "a9762e22-c60a-336c-96ec-780577d4abf1",
                                "text": "Viele der prunkvollen Villen von damals stehen heute noch und sie bestimmten das Klischee Hietzings mit: ehrwürdige Häuser, Alleebäume in den kleinen Straßen – hier wohnt das bürgerliche Wien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac332b36-7547-3f00-95a5-5a1f086feb5a",
                        "entry_id": "693d2d8a-3f8a-3674-9c3f-3d9f1db7c2a6",
                        "glosses": [
                            "ehemaliges Dorf, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "807f6de9-dc8e-4022-bf3c-41f003d6015c",
                                "sense_id": "ac332b36-7547-3f00-95a5-5a1f086feb5a",
                                "text": "Der Bau des Schlosses Schönbrunn, das an der Stelle der 1683 zerstörten Katterburg errichtet wurde, brachte schließlich den großartigen Aufschwung des damaligen Dorfes Hietzing."
                            },
                            {
                                "example_id": "c323c493-c5a6-444a-82ab-bc616e8a5951",
                                "sense_id": "ac332b36-7547-3f00-95a5-5a1f086feb5a",
                                "text": "Man brachte die rauchenden Pfeifen; auf einem dunkelgeblümten Divan gelagert, sprachen wir in süßer Behaglichkeit von der Anmut des Morgens, dem Landleben, von Hietzings Geschichte und Denkwürdigkeiten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
