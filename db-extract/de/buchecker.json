                            "accusative",
                            "singular"
                        ],
                        "form": "die Buchecker"
                    },
                    {
                        "form_id": "54f74370-caf7-4f93-8768-29adee4e6395",
                        "entry_id": "aec8cc4f-6f81-35fa-ab1f-cccf1190aeaf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bucheckern"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                        "entry_id": "aec8cc4f-6f81-35fa-ab1f-cccf1190aeaf",
                        "glosses": [
                            "dreikantige Frucht der Buche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1228b9b-9a1d-4a4d-b98d-6c5d03e40629",
                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                "text": "Aus Bucheckern kann man Öl gewinnen."
                            },
                            {
                                "example_id": "05320101-6a07-4aa6-a970-c1906b0c1782",
                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                "text": "Früher wurden Bucheckern häufig geröstet und gegessen."
                            },
                            {
                                "example_id": "bdd22312-6cad-4e96-9c8c-94d7ca1b20ab",
                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                "text": "„Während wir unsere Beutel mit Bucheckern füllten, kam ein Forstbeamter des Wegs, mit seinem Hund.“"
                            },
                            {
                                "example_id": "707eb4fc-a55a-479c-8ea9-5c84b4f1b122",
                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                "text": "„Das Interessanteste war, wenn sie im Herbst den ganzen Tag Bucheckern sammelten, aus denen später Öl gepresst wurde.“"
                            },
                            {
                                "example_id": "7294839a-0c98-481f-825f-14ea32dbb83f",
                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                "text": "„Viereinhalb Kilo Bucheckern ergaben einen Liter ungereinigtes Öl.“"
                            },
                            {
                                "example_id": "1c5e9216-5d24-4acf-973c-cd1451b6fd05",
                                "sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
                                "text": "„Und wenn ich etwas wie den frisch-feuchten Geruch der Wasserpumpe rieche, dann fühle ich mich einen Moment lang sowohl traurig als auch geborgen, und ich spüre geradezu die Wurzeln und Bucheckern in meinen Rücken zwicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63609c84-9712-4f14-b19b-0c1081409cd1",
                        "source_entry_id": "aec8cc4f-6f81-35fa-ab1f-cccf1190aeaf",
                        "source_sense_id": "0c689019-f526-3497-94ca-0febe14a09e9",
