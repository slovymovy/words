                "senses": [
                    {
                        "sense_id": "af3f9af3-0824-330a-90fb-dc447765d034",
                        "entry_id": "a882d13a-a49e-35c9-a102-c64bf245be46",
                        "glosses": [
                            "dunkler Hautfleck, der sich im höheren Alter bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3ba1d98-0d05-4384-9855-ac059389e955",
                                "sense_id": "af3f9af3-0824-330a-90fb-dc447765d034",
                                "text": "„Kurz registriere ich, dass die Haut dünn und voller Altersflecken ist, und ducke mich weg.“"
                            },
                            {
                                "example_id": "5836a931-5a14-4124-8601-984626034ec3",
                                "sense_id": "af3f9af3-0824-330a-90fb-dc447765d034",
                                "text": "„Die von Altersflecken übersäten Kopfhäute waren nur noch spärlich bewachsen.“"
                            },
                            {
                                "example_id": "8aa1e21f-d963-4424-a368-e10ff9632034",
                                "sense_id": "af3f9af3-0824-330a-90fb-dc447765d034",
                                "text": "„Seine Hände waren faltig geworden und voller Altersflecken.“"
                            },
                            {
                                "example_id": "68014792-6605-410a-92a5-314396b0f9b0",
                                "sense_id": "af3f9af3-0824-330a-90fb-dc447765d034",
                                "text": "„Einige Augenblicke später öffnete sich die Tür mit einem lauten Knarren, und im Eingang stand eine kleine Frau mit tiefen Falten und braunen Altersflecken im Gesicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70ead462-79e6-4d82-b1eb-4b8ccff7f720",
                        "source_entry_id": "a882d13a-a49e-35c9-a102-c64bf245be46",
