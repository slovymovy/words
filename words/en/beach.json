                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>beach</w> the truck on a large rock.",
                            "target_lang_translations": {
                                "ru": "Он умудрился <w>посадить</w> грузовик на большой камень.",
