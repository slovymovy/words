                "senses": [
                    {
                        "sense_id": "9233f39b-4bcc-3ca5-a784-c5fa02f6e9af",
                        "entry_id": "a8ddbb59-9036-3a4b-846d-73c8fb433e64",
                        "glosses": [
                            "das Gesicht des Kopfes des Gottes Janus, das aus zwei Gesichtern besteht; ein Symbol für Zwiespältigkeit oder auch gleichzeitig vorhandene Gegensätzlichkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffedc766-aaba-4692-90a9-fb01b3994c42",
                                "sense_id": "9233f39b-4bcc-3ca5-a784-c5fa02f6e9af",
                                "text": "„Der polnische Papst, obwohl selbst aus einem moralischen Guss, hatte für die Gesellschaft von heute das Janusgesicht des Fortschrittlichen und des Reaktionärs.“"
                            },
                            {
                                "example_id": "caf7449e-7d24-40bc-b32d-5b33bab3c599",
                                "sense_id": "9233f39b-4bcc-3ca5-a784-c5fa02f6e9af",
                                "text": "„Unsere Beziehung zu Saudi-Arabien trägt Züge eines Janusgesichtes.“"
                            },
                            {
                                "example_id": "9c3990e8-8873-44bb-8199-f8e88cdb01b0",
                                "sense_id": "9233f39b-4bcc-3ca5-a784-c5fa02f6e9af",
                                "text": "Das Janusgesicht der Gründerjahre zeigte einerseits eine wirtschaftliche Hausse mit hoher Wachstumsrate und ständig steigendem Sozialprodukt, andererseits eine weitgehende Verelendung breiter Bevölkerungskreise."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
