                "senses": [
                    {
                        "sense_id": "988ee132-17ad-3a55-aab8-74ae648be32f",
                        "entry_id": "59332053-6018-3710-8e0e-41d1033ca687",
                        "glosses": [
                            "die Synökologie betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d8f964-671b-4f6f-9361-706b41de6cd0",
                                "sense_id": "988ee132-17ad-3a55-aab8-74ae648be32f",
                                "text": "„Mit diesem Versuch kann die ökologische Potenz, das autökologische Optimum und das synökologische Optimum von Pflanzenarten in Bezug auf ihre Konkurrenz exemplarisch gezeigt werden.“"
                            },
                            {
                                "example_id": "6a61e641-999d-4313-b4fd-9239a910bab8",
                                "sense_id": "988ee132-17ad-3a55-aab8-74ae648be32f",
                                "text": "„Für viele Arten liegt das synökologische Optimum weit vom autökologischen Optimum entfernt.“"
                            }
                        ],
