                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veiling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoogste <w>lover</w> kreeg het antieke schilderij uiteindelijk toegewezen.",
                            "target_lang_translations": {
                                "en": "The highest <w>bidder</w> was ultimately awarded the antique painting."
                            }
