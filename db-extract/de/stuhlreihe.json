                "senses": [
                    {
                        "sense_id": "34ea0eda-daa3-37e9-8261-09ab09b58455",
                        "entry_id": "5f86e8b4-cdc5-312a-bbf4-77801aec94d1",
                        "glosses": [
                            "Reihe mehrerer/vieler Stühle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2123424-ab26-4211-8bb4-8b43c28b3b5e",
                                "sense_id": "34ea0eda-daa3-37e9-8261-09ab09b58455",
                                "text": "„Manche Leute blieben sitzen, manche gingen nach draußen und manche liefen durch die Stuhlreihen und sahen sich um.“"
                            },
                            {
                                "example_id": "a143c477-e056-4088-b0ec-e3ea180f0160",
                                "sense_id": "34ea0eda-daa3-37e9-8261-09ab09b58455",
                                "text": "„Gelenkig wie ein Akrobat kletterte er über drei Stuhlreihen, schwang sich auf die Empore und blieb schließlich vor Helens Tisch stehen.“"
                            },
                            {
                                "example_id": "4e738881-2fcf-465f-ae1c-d1bfdcd91a52",
                                "sense_id": "34ea0eda-daa3-37e9-8261-09ab09b58455",
                                "text": "„Bisher standen Kanzler und Vize im Kongress-Saal Rede und Antwort, die Medienvertreter waren dabei auf Stuhlreihen platziert.“"
                            },
                            {
                                "example_id": "abc3d934-0112-4654-93e9-f24d6c52df2b",
                                "sense_id": "34ea0eda-daa3-37e9-8261-09ab09b58455",
                                "text": "„Hans S., ein Privatbeamter, vernommen am 14. Dezember 19…, saß auf einem der mittleren Sessel in der sechsten Stuhlreihe, rechts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
