                "senses": [
                    {
                        "sense_id": "89377170-e9d5-3345-bda6-4a51ff47cf5d",
                        "entry_id": "8efd0a83-19ee-38eb-99ac-7f1fb8856663",
                        "glosses": [
                            "Aéronef équipé de six moteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7efa034d-1bdd-4d83-aac7-0e31ac11dbd8",
                                "sense_id": "89377170-e9d5-3345-bda6-4a51ff47cf5d",
                                "text": "La Chine et l’Ukraine ont signé un accord visant à redémarrer la production de l’hexamoteur Antonov An-225 \"Mriya\" (rêve) ou \"Cossack\" selon la terminologie Otan."
                            },
                            {
                                "example_id": "0a9ca05e-1a41-4a74-8be4-1a9ac2d2cdff",
                                "sense_id": "89377170-e9d5-3345-bda6-4a51ff47cf5d",
                                "text": "Le gros hexamoteur quitte Diégo-Suarez le 21 novembre et, avec les mêmes escales se pose à Marignane-Berre le 26 ramenant le courrier."
                            },
                            {
                                "example_id": "582882fe-f1db-4234-8159-62555799626f",
                                "sense_id": "89377170-e9d5-3345-bda6-4a51ff47cf5d",
                                "text": "Elle est due à l’un des plus habiles constructeurs soviétiques, A. N. Tupolev, connu pour la construction d’avions cargos et de passagers dont le plus grand, l’hexamoteur géant « Maxim Gorki », s’écrasa en 1935."
                            }
                        ]
                    }
