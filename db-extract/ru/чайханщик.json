                "senses": [
                    {
                        "sense_id": "7346fb3d-5a95-3355-99ba-6af6218d0d6a",
                        "entry_id": "8369bd5a-dc56-3c4a-9e07-f5d0fd9c3224",
                        "glosses": [
                            "владелец чайханы, тот, кто содержит чайхану или работает в ней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08587d3-b2d4-4a6f-9094-59400c9997bb",
                                "sense_id": "7346fb3d-5a95-3355-99ba-6af6218d0d6a",
                                "text": "Чайханщик с поклоном подал на огромном блюде манты ― шлепающие сочные пельмени с душистыми травками."
                            },
                            {
                                "example_id": "d7412392-e5d2-4a44-99a6-6ace34923207",
                                "sense_id": "7346fb3d-5a95-3355-99ba-6af6218d0d6a",
                                "text": "Лагманщики, лепёшечники, самсачники, мантщики, люляшники, шашлычники, чайханщики все были молодые, все высокого роста, все высокомерны, как принцы."
                            }
                        ]
                    }
