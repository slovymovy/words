                                                "sense_id": "542125e0-8b3a-3ed3-851c-6115db5c2ac7",
                                                "text": "Die ganze Ehe hindurch gab es bei ihnen es keinen einzigen Streit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43b9805c-70a9-3002-81f9-4bdb877f4631",
                                        "entry_id": "b2fe3da1-eb68-34f0-94e8-fdfa6ac9d342",
