                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbcb8bd-4fb5-47a2-b245-ea2bc11dc1de",
                                                "sense_id": "eff91313-2aef-3373-a072-f20915614b99",
                                                "text": "Zo bestaat Mill Road, het stadion van de thuisploeg, uit een minuscule tribune – een soort overdekte bank eigenlijk – en een schuur. Wel heeft de club dan weer een petanquebaan, volgens Doing the 116 zegt geen enkele club ter wereld dat Littlehampton Town na."
                                            }
                                        ]
                                    }
                                ]
