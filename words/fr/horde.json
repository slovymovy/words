            "senses": [
                {
                    "sense_id": "52c5ca70-8eef-3f16-a5cb-b5d2e51b1ac9",
                    "sense_definition": "Groupe nombreux de personnes indisciplinées, bruyantes ou agitées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groupe_indiscipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque été, une <w>horde</w> de touristes envahit les ruelles pittoresques de la vieille ville."
                        },
                        {
                            "text": "Une <w>horde</w> d'enfants joyeux et bruyants a couru vers le parc dès la sortie des classes."
                        }
                    ],
                    "synonyms": [
                        "bande",
                        "groupe",
                        "troupe"
                    ],
                    "common_phrases": [
