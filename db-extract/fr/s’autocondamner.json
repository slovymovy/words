                "senses": [
                    {
                        "sense_id": "3dabf34f-d59c-33a4-b63a-0369b5056482",
                        "entry_id": "afe16d0e-cd57-3a73-8cac-6b245880e394",
                        "glosses": [
                            "Se condamner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29aa945-fb40-4b58-817c-7c005325f752",
                                "sense_id": "3dabf34f-d59c-33a4-b63a-0369b5056482",
                                "text": "Un équilibre particulièrement menacé par l’homme depuis ces deux derniers siècles avec son développement à l’extrême du progrès : en entraînant la disparition des autres espèces, l’homme s’autocondamne à l’extinction."
                            },
                            {
                                "example_id": "9e8e762b-2d7e-4f73-aa0d-33a6d78a76eb",
                                "sense_id": "3dabf34f-d59c-33a4-b63a-0369b5056482",
                                "text": "L’instinct de survie exclut qu’elle aille jusqu’à s'autocondamner."
                            }
                        ]
                    }
