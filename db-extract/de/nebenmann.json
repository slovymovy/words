                    {
                        "form_id": "d12a81f4-13c7-4e72-85f8-920b1388d958",
                        "entry_id": "c0a59aca-0077-37d1-8a0b-9f18333f1230",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nebenmänner"
                    },
                    {
                        "form_id": "4203dce9-708d-43d7-a678-3303b6323921",
                        "entry_id": "c0a59aca-0077-37d1-8a0b-9f18333f1230",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nebenleute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72864baf-265e-3be5-bafb-54643baefa60",
                        "entry_id": "c0a59aca-0077-37d1-8a0b-9f18333f1230",
                        "glosses": [
                            "Person, die sich seitlich einer anderen befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9098ed7f-a27b-415e-bb1e-a521d40235da",
                                "sense_id": "72864baf-265e-3be5-bafb-54643baefa60",
                                "text": "„Wohin die Leute drängen, drängt man ebenfalls; kauft jemand Wollsocken, kauft man auch welche; nimmt sich der Nebenmann eine Wurst, sagt man ‘bitte mit Senf‘, der Nebenmann wundert sich.“"
                            },
                            {
                                "example_id": "0cef223e-3ae0-4f42-b298-0d1493d3b956",
                                "sense_id": "72864baf-265e-3be5-bafb-54643baefa60",
                                "text": "„Die Mädchen und Jungen, die sich auf die Eckbank der leeren Bahnhofshalle setzten, kamen aus einem Jazzkonzert. Ihr Gespräch verstummte rasch. Einer nach dem anderen legten sie den Kopf auf die Schulter ihres Nebenmanns.“"
                            },
                            {
                                "example_id": "52333d51-6fd8-49ef-a4a8-32f4b6900c44",
                                "sense_id": "72864baf-265e-3be5-bafb-54643baefa60",
                                "text": "„Gleich darauf bemerkte ich jenes fast unhörbare Geräusch, welches ein Ungeübter für das Wehen eines ganz, ganz leisen Lüftchens halten würde - sie kamen! ›Aufgepaßt!‹ flüsterte ich meinem Nebenmanne zu!“"
                            },
                            {
                                "example_id": "845a98ca-5c95-481d-b02f-d408571419e7",
                                "sense_id": "72864baf-265e-3be5-bafb-54643baefa60",
                                "text": "„Während man dem Linieninfanteristen nicht genug empfehlen kann, stets an seine Nebenmänner zu schließen, während man sich abmüht, ihn zur gänzlichen Passivität zu erziehen, zur Maschine zu machen …“"
                            },
                            {
                                "example_id": "bc72e13f-030c-4726-8c1a-2f3fb2859fa7",
                                "sense_id": "72864baf-265e-3be5-bafb-54643baefa60",
                                "text": "„Die Reiter beyder Glieder erhalten sich in leiser Bügelberührung mit ihren Nebenmännern; nur durch die richtige Beybehaltung derselben wird dem so schädlichen Gedränge vorgebeugt, dem Reiter hinlängliche Freyheit und dem Pferde Raum verschaft, sich ungehindert zu bewegen“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "de0e5586-5693-3192-b2bd-1a87df8a98a6",
                        "entry_id": "c0a59aca-0077-37d1-8a0b-9f18333f1230",
                        "glosses": [
                            "Mann, mit dem eine Ehefrau neben ihrem Ehemann eine Beziehung hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4414295-ec41-457a-8f1d-53898d9df4b5",
                                "sense_id": "de0e5586-5693-3192-b2bd-1a87df8a98a6",
                                "text": "„Dagegen hatte eine vernachlässigte Frau das Recht, sich aus den nächsten Anverwandten ihres Mannes einen Nebenmann zu wählen.“"
                            },
                            {
                                "example_id": "3411a93d-4985-4c5b-af6b-d637e39cda06",
                                "sense_id": "de0e5586-5693-3192-b2bd-1a87df8a98a6",
                                "text": "„Sie lebte öffentlich mit ihren Nebenmännern. Sie begehrte die Männer öfter, als daß sie begehrt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
