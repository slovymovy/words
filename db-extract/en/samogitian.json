                                        "glosses": [
                                            "Dialecte du lituanien parlé en Samogitie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692c1b82-3f27-404c-9d9d-b0e60b3d8793",
                                                "sense_id": "d7fa0d22-da03-3103-85b4-22b228128012",
                                                "text": "Je fis tout ce qui dépendait de moi pour lui persuader que je n'avais gardé aucune impression fâcheuse de cette première entrevue, et, pour couper court à ce sujet, je lui demandai s'il était vrai qu'il possédât le Catéchisme samogitien du père Lawiçki ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597cacc4-236e-439c-a871-fa49f85c073c",
                        "source_entry_id": "4385b862-0338-363b-9ec8-835967909489",
                        "source_sense_id": "26c158a8-acde-3e98-a734-df3dc31f09d5",
                        "source_sense_description": "Of, from, or pertaining to the region of Samogitia, or its people",
                        "target_lang_word": "Schemaitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schemaitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3689cad5-963c-39cf-b3de-a26d595ef8aa",
                                        "entry_id": "3342d0a6-c56b-3cf4-8e01-855ad84298e5",
                                        "glosses": [
                                            "ein Dialekt des Litauischen, der vor allem in Samogitien (Niederlitauen) gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fbdc098-c7bd-489b-9816-673568620011",
                                                "sense_id": "3689cad5-963c-39cf-b3de-a26d595ef8aa",
                                                "text": "„Dauksza übersetzte den Katechismus des spanischen Jesuiten Jakob Ledesma (1522-1570) ins Schemaitische.“"
                                            },
                                            {
                                                "example_id": "5b53b969-26a4-48bb-ad6f-6afabba4d2c0",
                                                "sense_id": "3689cad5-963c-39cf-b3de-a26d595ef8aa",
                                                "text": "„Die erste Hervorhebung zeigt, daß Paszkiewicz den Stellenwert des Schemaitischen derart vorbildlich wissen möchte, daß es den alten Kultursprachen der Welt ebenbürtig wird.“"
                                            },
                                            {
                                                "example_id": "7d2f1659-8ad8-4e11-bda3-741e43ef3fa5",
                                                "sense_id": "3689cad5-963c-39cf-b3de-a26d595ef8aa",
                                                "text": "„Das Litauische wird in zwei Dialektformen gesprochen, als Hochlitauisch (Aukschtaitisch) und Niederlitauisch (Schemaitisch).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
