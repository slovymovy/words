{
    "word_family": [
        "stuff",
        "stuffiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36e3e627-d318-373a-875e-f1a662c4535c",
                    "sense_definition": "Lacking fresh air, poorly ventilated, and uncomfortably warm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meeting room felt very <w>stuffy</w>, so somebody finally opened a window.",
                            "target_lang_translations": {
                                "ru": "В переговорной было очень <w>душно</w>, поэтому кто-то наконец открыл окно."
                            }
                        },
                        {
                            "text": "It was difficult to sleep inside the <w>stuffy</w> bedroom during the summer heat.",
                            "target_lang_translations": {
                                "ru": "В летнюю жару было трудно уснуть в <w>душной</w> спальне."
                            }
                        }
                    ],
                    "synonyms": [
                        "fusty",
                        "oppressive"
                    ],
                    "antonyms": [
                        "airy"
                    ],
                    "common_phrases": [
                        "stuffy room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый свежего воздуха, плохо проветриваемый, душный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душный",
                                "target_lang_sense_clarification": "о помещении или воздухе"
                            },
                            {
                                "target_lang_word": "спёртый",
                                "target_lang_sense_clarification": "о несвежем воздухе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc335dc0-bf33-3541-ac47-c3d680109def",
                    "sense_definition": "Blocked or congested, making it difficult to breathe through the nose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nasal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I woke up with a cold and a very <w>stuffy</w> nose this morning.",
                            "target_lang_translations": {
                                "ru": "Этим утром я проснулся с простудой и сильно <w>заложенным</w> носом."
                            }
                        },
                        {
                            "text": "Drinking warm tea can often relieve a <w>stuffy</w> head and clear your breathing.",
                            "target_lang_translations": {
                                "ru": "Тёплый чай часто помогает облегчить <w>тяжесть в</w> голове от насморка и восстановить дыхание."
                            }
                        }
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "stuffy nose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заложенный, затрудняющий дыхание через нос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заложенный",
                                "target_lang_sense_clarification": "о носе при насморке"
                            },
                            {
                                "target_lang_word": "забитый",
                                "target_lang_sense_clarification": "о носе или дыхательных путях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3dd590c-f7f3-3eb3-934c-4fb028561a93",
                    "sense_definition": "Boring, old-fashioned, excessively formal, and resistant to change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to modernize its <w>stuffy</w> image to attract younger customers.",
                            "target_lang_translations": {
                                "ru": "Компания решила осовременить свой <w>старомодный</w> имидж, чтобы привлечь более молодых клиентов."
                            }
                        },
                        {
                            "text": "Nobody enjoyed the lecture given by the <w>stuffy</w> professor.",
                            "target_lang_translations": {
                                "ru": "Никому не понравилась лекция, которую читал этот <w>занудный</w> профессор."
                            }
                        }
                    ],
                    "antonyms": [
                        "progressive"
                    ],
                    "common_phrases": [
                        "stuffy institution",
                        "stuffy atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучный, старомодный, чопорный и консервативный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чопорный",
                                "target_lang_sense_clarification": "излишне строгий и старомодный"
                            },
                            {
                                "target_lang_word": "занудный",
                                "target_lang_sense_clarification": "скучный, неинтересный"
                            },
                            {
                                "target_lang_word": "закостенелый",
                                "target_lang_sense_clarification": "консервативный, не терпящий изменений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "132d2eae-96b8-3d7a-8c33-6e4bbc9dc696",
                    "sense_definition": "Angry, obstinate, or sulky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew rather <w>stuffy</w> and refused to talk to anyone after losing the argument.",
                            "target_lang_translations": {
                                "ru": "Он совершенно <w>надулся</w> и отказался с кем-либо разговаривать после того, как проиграл спор."
                            }
                        },
                        {
                            "text": "Her <w>stuffy</w> silence ruined the cheerful mood of the dinner party.",
                            "target_lang_translations": {
                                "ru": "Её <w>обиженное</w> молчание испортило весёлое настроение званого ужина."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "dated usage meaning ill-tempered or sulky"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обиженный, надутый, раздражительный или упрямый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надутый",
                                "target_lang_sense_clarification": "обиженный, замкнувшийся в себе"
                            },
                            {
                                "target_lang_word": "обидчивый",
                                "target_lang_sense_clarification": "легко обижающийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eeeb640-a837-37a8-8490-d06f908d0f8a",
                    "sense_definition": "Stout, mettlesome, or resolute.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "build",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old soldier remained a <w>stuffy</w> and determined man until his final days.",
                            "target_lang_translations": {
                                "ru": "Старый солдат оставался <w>стойким</w> и решительным человеком до своих последних дней."
                            }
                        },
                        {
                            "text": "He showed a <w>stuffy</w> resistance against any form of intimidation.",
                            "target_lang_translations": {
                                "ru": "Он оказал <w>упорное</w> сопротивление любым попыткам запугивания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic usage meaning stout or resolute"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкий, стойкий, решительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойкий",
                                "target_lang_sense_clarification": "непоколебимый, упорный"
                            },
                            {
                                "target_lang_word": "упорный",
                                "target_lang_sense_clarification": "настойчивый, несгибаемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2b63173-1378-386c-baf0-375a8d77cc05",
                    "sense_definition": "Stout; sturdy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "build",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They chose a <w>stuffy</w> pony capable of carrying heavy packs across the hills.",
                            "target_lang_translations": {
                                "ru": "Они выбрали <w>коренастого</w> пони, способного нести тяжёлые вьюки по холмам."
                            }
                        },
                        {
                            "text": "The small cart was pulled by a couple of <w>stuffy</w> workhorses.",
                            "target_lang_translations": {
                                "ru": "Небольшую тележку тащила пара <w>крепких</w> рабочих лошадок."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "dialectal usage meaning sturdy or thickset"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коренастый, приземистый, плотного сложения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коренастый",
                                "target_lang_sense_clarification": "плотного и крепкого телосложения"
                            },
                            {
                                "target_lang_word": "крепыш",
                                "target_lang_sense_clarification": "о животном или человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74c7f7a2-5ba2-3a70-a8f7-2ae5c8198be8",
                    "sense_definition": "A stuffed toy animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl hugged her favorite <w>stuffy</w> before falling asleep.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка обняла свою любимую <w>мягкую игрушку</w> перед тем, как заснуть."
                            }
                        },
                        {
                            "text": "His bed was covered with colorful <w>stuffies</w> that he had collected over the years.",
                            "target_lang_translations": {
                                "ru": "Его кровать была завалена разноцветными <w>плюшевыми игрушками</w>, которые он собирал годами."
                            }
                        }
                    ],
                    "synonyms": [
                        "stuffed toy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a plush or stuffed toy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая плюшевая игрушка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягкая игрушка",
                                "target_lang_sense_clarification": "плюшевый зверь"
                            },
                            {
                                "target_lang_word": "плюшевая игрушка",
                                "target_lang_sense_clarification": "игрушечный зверёк"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}