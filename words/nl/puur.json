                        "louter",
                        "volkomen"
                    ],
                    "common_phrases": [
                        "puur geluk",
                        "pure angst",
                        "pure onzin"
                    ],
                    "target_lang_definitions": {
                        "en": "total or complete, often used to emphasize an emotion or state"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pure",
