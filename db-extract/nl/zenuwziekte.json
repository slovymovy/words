                "senses": [
                    {
                        "sense_id": "301d1580-5d33-350f-b546-a205e3bc82a9",
                        "entry_id": "0c5574a9-79e1-374d-8a40-36a7d32f9b66",
                        "glosses": [
                            "aandoening van het zenuwstelsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e649d8-dbab-459d-a59f-79fb632250d9",
                                "sense_id": "301d1580-5d33-350f-b546-a205e3bc82a9",
                                "text": "Fernando Ricksen kan zich weer verstaanbaar maken. De 41-jarige ex-international die lijdt aan de zenuwziekte ALS maakt sinds een maand gebruik van een spraakcomputer."
                            },
                            {
                                "example_id": "a82a4003-a495-4409-9298-93290a4683de",
                                "sense_id": "301d1580-5d33-350f-b546-a205e3bc82a9",
                                "text": "Hij heeft primair progressieve multiple sclerose (PPMS), een progressieve vorm van zenuwziekte MS. De behandeling is duur en wordt niet vergoed. Daarom is een crowdfunding gestart met allerlei acties in zijn woonplaats en in de stad waar hij opgroeide, Elburg."
                            },
                            {
                                "example_id": "57edf859-b6ec-4691-b837-8f47c35ac995",
                                "sense_id": "301d1580-5d33-350f-b546-a205e3bc82a9",
                                "text": "Examenkandidaat Ivo Boers (17) vliegt deze ochtend pas terug uit Frankrijk. Precies op tijd voor hét telefoontje ploft hij neer in de tuin. De scholier beklom afgelopen maandag de Mont Ventoux om geld in te zamelen voor de zenuwziekte MS."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e2f1a42-640d-3144-be61-153de2eb2473",
                        "entry_id": "0c5574a9-79e1-374d-8a40-36a7d32f9b66",
                        "glosses": [
                            "psychische aandoening"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba8b71a7-b336-4f5e-be45-68f5b4cf0667",
                        "source_entry_id": "0c5574a9-79e1-374d-8a40-36a7d32f9b66",
                        "source_sense_id": "301d1580-5d33-350f-b546-a205e3bc82a9",
                        "source_sense_description": "aandoening van het zenuwstelsel en dan met name van de zenuwbanen",
                        "target_lang_word": "nervous illness",
