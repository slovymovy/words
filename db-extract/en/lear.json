                    {
                        "sense_id": "8cedc522-f037-3fe6-85a5-61b54993926a",
                        "entry_id": "6cb1e178-8a87-3d87-a6cd-d69c6e8dee4d",
                        "glosses": [
                            "Learning, lore; doctrine."
                        ],
                        "tags": [
                            "Scotland",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "230dc878-4fb9-42ef-b4c5-25908818bb0b",
                                "sense_id": "8cedc522-f037-3fe6-85a5-61b54993926a",
                                "text": "when all other helpes she saw to faile, / She turnd her selfe backe to her wicked leares / And by her deuilish arts thought to preuaile [...]."
                            },
                            {
                                "example_id": "3734946c-cf8a-4a3c-82cd-2237227c713f",
                                "sense_id": "8cedc522-f037-3fe6-85a5-61b54993926a",
                                "text": "'Foul befa' him and his lear too! It maun be o' some new-fangled kind, I think. Our auld minister had lear enough, baith Hebrew and Latin, and he believed in witches and warlocks, honest man, like ony ither sober, godly person.'"
                            },
                            {
                                "example_id": "ca3e2dc1-5763-4408-9df7-f84ae884de10",
                                "sense_id": "8cedc522-f037-3fe6-85a5-61b54993926a",
                                "text": "They dressed up in maids' array,\nAnd passd for sisters fair;\nWith ae consent gaed ower the sea,\nFor to seek after lear."
                            }
                        ]
                    }
                ],
