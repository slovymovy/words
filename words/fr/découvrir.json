{
    "word_family": [
        "découverte",
        "découvreur",
        "redécouvrir",
        "redécouverte"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea62da2a-3074-3ee4-bd84-6c0753d6a9b7",
                    "sense_definition": "Trouver ce qui n'était pas connu, ce qui était ignoré ou caché dans la nature, les sciences ou l'histoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques espèrent <w>découvrir</w> un traitement efficace contre cette maladie rare."
                        },
                        {
                            "text": "Les archéologues ont <w>découvert</w> une cité antique enfouie sous le sable du désert."
                        }
                    ],
                    "synonyms": [
                        "trouver"
                    ],
                    "common_phrases": [
                        "découvrir un trésor",
                        "découvrir une nouvelle espèce"
                    ]
                },
                {
                    "sense_id": "99ac8d3e-af99-3f4b-a11e-05e952373349",
                    "sense_definition": "Faire pour la première fois l'expérience de quelque chose, commencer à connaître un lieu ou une activité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant leurs vacances en Italie, ils ont adoré <w>découvrir</w> les ruelles pittoresques de Rome."
                        },
                        {
                            "text": "Les enfants <w>découvrent</w> le plaisir de la lecture grâce à ces contes illustrés."
                        }
                    ],
                    "common_phrases": [
                        "découvrir une ville",
                        "découvrir une nouvelle passion"
                    ]
                },
                {
                    "sense_id": "b08c2a20-7243-3f45-8ab5-0e5dc83ab843",
                    "sense_definition": "Enlever ou ôter ce qui recouvrait, protégeait ou enveloppait quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent a <w>découvert</w> le toit de la vieille grange pendant la tempête."
                        },
                        {
                            "text": "Il a retiré la bâche pour <w>découvrir</w> le monument restauré devant les habitants rassemblés."
                        }
                    ],
                    "common_phrases": [
                        "découvrir le pot"
                    ]
                },
                {
                    "sense_id": "aabbdc8d-8c81-323e-8d79-f6cdf270c91e",
                    "sense_definition": "Révéler ou faire connaître ce qui était gardé secret ou confidentiel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a promis de ne jamais <w>découvrir</w> son secret aux policiers chargés de l'enquête."
                        },
                        {
                            "text": "Elle refusa de <w>découvrir</w> ses projets avant d'avoir obtenu l'accord officiel de la direction."
                        }
                    ],
                    "antonyms": [
                        "cacher",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "découvrir un secret",
                        "découvrir la vérité"
                    ]
                }
            ]
        }
    ]
}