                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4a7ee4-c84a-3feb-aad1-d79bcb868d5c",
                                        "entry_id": "c443eed0-12c6-3803-afc1-52f771335036",
                                        "glosses": [
                                            "schwer bewaffneter Fußsoldat des 16. und 17. Jahrhunderts, später ein Dienstgrad"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec40eef-013b-4b92-9a3a-e0e50902e4ba",
                                                "sense_id": "5f4a7ee4-c84a-3feb-aad1-d79bcb868d5c",
                                                "text": "„Auf den Flügeln waren Reiter und Gruppen von Musketieren aufgestellt.“"
                                            },
                                            {
                                                "example_id": "23159a73-1bb9-44a8-b243-a6f3d3a7bbf2",
                                                "sense_id": "5f4a7ee4-c84a-3feb-aad1-d79bcb868d5c",
                                                "text": "„Die Derrièregarde (Nachhut) aus 800 kaiserlichen Musketieren, 1.500 Reitern übergab Melander dem bewährten Feldmarschallleutnant Grafen Montecuculi.“"
                                            },
                                            {
                                                "example_id": "04345e28-542d-4280-979f-16ad5e4e69a8",
                                                "sense_id": "5f4a7ee4-c84a-3feb-aad1-d79bcb868d5c",
                                                "text": "„Zu Beginn des Dreißigjährigen Krieges betrug das Verhältnis der Musketiere zur Anzahl von Pikenträgern auf den Schlachtfeldern in der Regel 1:1, bei Kriegsende 2:1.“"
                                            },
                                            {
                                                "example_id": "7cc1fdd4-fadb-401f-85c9-e983c48b2dc9",
                                                "sense_id": "5f4a7ee4-c84a-3feb-aad1-d79bcb868d5c",
                                                "text": "„Unter anderem wurde das Kartäuser Beatuskloster von 60 Merodischen Musketieren unter dem Leutnant Peter Jungglas zur Verteidigung belegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
