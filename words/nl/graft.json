                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "canal",
                                "target_lang_sense_clarification": "obsolete form, in the sense of a man-made water channel"
                            },
                            {
                                "target_lang_word": "waterway",
                                "target_lang_sense_clarification": "obsolete form, in the general sense of a water channel"
                            },
                            {
                                "target_lang_word": "moat",
                                "target_lang_sense_clarification": "obsolete form, especially when used as a defensive water channel around a town"
                            }
                        ]
