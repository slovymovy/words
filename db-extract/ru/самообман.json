                        ]
                    },
                    {
                        "translation_id": "4fd18c8a-4b07-4711-9c43-3fe9cfcc2a06",
                        "source_entry_id": "bb9c7352-893d-3293-b833-0e1333b3c59e",
                        "source_sense_id": "05265cc6-cf2a-3181-90d2-5f932c4e611e",
                        "target_lang_word": "self-delusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-delusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5104b183-7b58-35f3-8eaf-46a0c61aee59",
                                        "entry_id": "cf122935-028e-385b-bc8f-d1cc7a71cb97",
                                        "glosses": [
                                            "The act of deluding oneself, or the state of being so deluded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99eb6d5-c0dd-428c-8df5-8ac242657e76",
                                                "sense_id": "5104b183-7b58-35f3-8eaf-46a0c61aee59",
                                                "text": "This self-delusion is even more the case with Trotsky, whose bloodstained intolerance is generally passed over because the 1960s student generation pretended then, and pretends still, that Trotsky was in some way a freedom-loving, Gulag-free alternative to Stalin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fbcd45-83b8-44fa-9120-33476f3a6cf4",
                        "source_entry_id": "bb9c7352-893d-3293-b833-0e1333b3c59e",
                        "source_sense_id": "05265cc6-cf2a-3181-90d2-5f932c4e611e",
