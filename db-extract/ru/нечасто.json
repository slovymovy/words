                                "target_senses": [
                                    {
                                        "sense_id": "cd9b0a97-3589-3f3f-86e8-729c2c0aff55",
                                        "entry_id": "e59c4724-e653-345d-a7ab-cf9b482553b2",
                                        "glosses": [
                                            "Not frequently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580ee8df-014e-4b54-b03d-318e325c45ca",
                                                "sense_id": "cd9b0a97-3589-3f3f-86e8-729c2c0aff55",
                                                "text": "“As a result, OCR found that the district’s pattern of inconsistent responses to reports it received of sexual harassment – infrequently responding under Title IX or not responding at all – rose to the level that the district’s response to some families’ sexual harassment reports was deliberately indifferent to students’ civil rights,” a news release from DOE reads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d286b03-55be-4299-93b4-cc31086a42c5",
                        "source_entry_id": "ab2a0a9e-86f8-3f73-85ac-c329640e2a06",
                        "source_sense_id": "d06b5392-8135-34fa-b2d0-f667d2719ceb",
                        "target_lang_word": "seldom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seldom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                        "entry_id": "d6b226e6-4526-30b2-bf6c-ed356a973c0b",
                                        "glosses": [
                                            "Infrequently, rarely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd1efa2-cfe2-484b-b2d9-d3b3dec63d3e",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "They seldom come here now."
                                            },
                                            {
                                                "example_id": "87110131-9625-4240-8b66-b5f244a5da8f",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed."
                                            },
                                            {
                                                "example_id": "990e6365-3a77-4721-8862-ec1aebc654fe",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "I'll miss the sea. But a person needs new experiences. They draw something deep inside, allowing him to grow. Without change, something sleeps inside us and seldom awakens. The sleeper must awaken."
                                            },
                                            {
                                                "example_id": "58b00a85-1603-46ea-bd1f-69962149ed02",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "People who talk about an imminent possibility of war seldom pose this question: What would North Korea’s leadership get from unleashing a war that they are likely to lose in weeks, if not days?"
                                            },
                                            {
                                                "example_id": "1465c2f0-6081-4c72-b186-22d8d883c130",
                                                "sense_id": "b948b7a2-41c7-3fe0-8385-68c7f2819d11",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seldom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                        "entry_id": "e078bb78-f32d-3041-975b-9238708b0207",
                                        "glosses": [
                                            "Rare; infrequent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa91202-c3da-46cf-a7d8-294dd7dfb361",
                                                "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                                "text": "a suppressed and seldom anger"
                                            },
                                            {
                                                "example_id": "a2973b3e-3552-4fd6-b0b3-43568b7dc3b7",
                                                "sense_id": "a45e6ff7-77db-3565-a1e7-add656b3fb28",
                                                "text": "He was very curious in his garden, which was never out of order; in which he would at seldom times take a short walk or two, not enduring to see a weed in it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
