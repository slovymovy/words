                "senses": [
                    {
                        "sense_id": "7381ec64-d53f-3c2a-9aff-860515d2554d",
                        "entry_id": "3889a05b-6693-3f54-95b4-445d92117e4e",
                        "glosses": [
                            "człowiek morza, żeglarz, marynarz starszego rocznika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d04033-8db6-47b6-9bbf-b611c8dfc82d",
                                "sense_id": "7381ec64-d53f-3c2a-9aff-860515d2554d",
                                "text": "W tawernie portowej stary barman opowiadał fantastyczne przygody swojego życia, jakoby był zejmanem w bitwie pod Oliwą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3304aa32-672c-3aef-892a-9244d414f0d2",
                        "entry_id": "3889a05b-6693-3f54-95b4-445d92117e4e",
                        "glosses": [
                            "żargon żeglarski: żeglarz, człowiek morza, żeglarz/marynarz starszego rocznika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d253d2c3-22bd-4b8b-86e2-05ea40a5158b",
                                "sense_id": "3304aa32-672c-3aef-892a-9244d414f0d2",
                                "text": "Przed rejsem brakowało doświadczonych marynarzy. Na szczęście zgłosiło się kilku zejmanów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "39efab6a-a098-3b4a-addc-feef535ff8b8",
