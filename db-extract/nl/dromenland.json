                                "sense_id": "7f71fe66-54dc-31a9-b6b9-08ab8ffd853a",
                                "text": "Ze reisde naar het betoverende dromenland terwijl ze sliep.",
                                "translation": "She traveled to the enchanting dreamland while she was asleep.",
                                "english": "She traveled to the enchanting dreamland while she was asleep."
                            },
                            {
                                "example_id": "2c528350-b765-472c-9579-975576f35c10",
                                "sense_id": "7f71fe66-54dc-31a9-b6b9-08ab8ffd853a",
                                "text": "In mijn dromenland kan alles gebeuren.",
                                "translation": "In my dreamland, anything can happen.",
                                "english": "In my dreamland, anything can happen."
                            },
                            {
                                "example_id": "a730b298-64ba-4f04-a02a-5d1808665c02",
                                "sense_id": "7f71fe66-54dc-31a9-b6b9-08ab8ffd853a",
                                "text": "Kinderen hebben vaak levendige avonturen in hun eigen kleine dromenland.",
                                "translation": "Children often have vivid adventures in their own little dreamland.",
                                "english": "Children often have vivid adventures in their own little dreamland."
                            }
                        ]
                    }
