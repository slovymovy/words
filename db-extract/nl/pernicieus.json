                                "target_senses": [
                                    {
                                        "sense_id": "a5622bda-a6e2-3ccf-836f-ea3914b80973",
                                        "entry_id": "24a9167f-5214-30fc-a518-aac5b508fd01",
                                        "glosses": [
                                            "Causing much harm in a subtle way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608d392c-276d-4a90-890a-63c040e97146",
                                                "sense_id": "a5622bda-a6e2-3ccf-836f-ea3914b80973",
                                                "text": "Ang. Belieue me on mine Honor,\nMy words expreſſe my purpoſe.\nIſa. Ha? Little honor, to be much beleeu'd,\nAnd moſt pernitious purpoſe: Seeming, ſeeming.\nI will proclaime thee Angelo, looke for't."
                                            },
                                            {
                                                "example_id": "6a69dd21-d885-45b6-9b82-556a219282c6",
                                                "sense_id": "a5622bda-a6e2-3ccf-836f-ea3914b80973",
                                                "text": "[…]her health also having suffered by the change, she immediately, when told of Douglas's projected departure from India, felt the strongest desire to accompany him; and to which Colonel Melbourne the more readily consented, having with reluctance yielded to her request of quitting England, willing as he had been to sacrifice the enjoyment of her society rather than that she should submit to the disadvantages attendant upon a residence in a clime usually found so pernicious to the female constitution."
                                            },
                                            {
                                                "example_id": "e8c923ac-d236-4301-aca9-289d6af7fa67",
                                                "sense_id": "a5622bda-a6e2-3ccf-836f-ea3914b80973",
                                                "text": "Puritanism no longer employs the thumbscrew and lash; but it still has a most pernicious hold on the minds and feelings of the American people."
                                            },
                                            {
                                                "example_id": "41668d80-7028-48ac-9383-4d654459eb1f",
                                                "sense_id": "a5622bda-a6e2-3ccf-836f-ea3914b80973",
                                                "text": "In January, the company laid off a third of its staff and renounced ads as a pernicious influence on the world, without mentioning that Google and Facebook are so good at ads there’s hardly room for anyone else to compete."
                                            },
                                            {
                                                "example_id": "f75d2667-aa4b-4fc5-80c7-1be6345f9268",
                                                "sense_id": "a5622bda-a6e2-3ccf-836f-ea3914b80973",
                                                "text": "A man has always been a woman’s best excuse to avoid her destiny; that a man is her destiny is one of patriarchy’s most pernicious tenets. What a scam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9093a049-71ab-381c-9e43-dba9dbbdc0be",
                                        "entry_id": "24a9167f-5214-30fc-a518-aac5b508fd01",
                                        "glosses": [
                                            "Causing death or injury; deadly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88f05342-e03b-363f-9b3b-4950a7223c8a",
                                        "entry_id": "24a9167f-5214-30fc-a518-aac5b508fd01",
                                        "glosses": [
                                            "Insidiously villainous: intending to cause harm, especially in a subtle way."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    }
