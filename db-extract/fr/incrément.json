                        "glosses": [
                            "Ajout, valeur ajoutée à une autre, en général à plusieurs reprises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887df5f4-eb95-4751-9c25-c290a8e15f6b",
                                "sense_id": "f8e2faf2-8500-307b-adbf-f59802f5c695",
                                "text": "Entre deux prises, le châssis du capteur est déplacé par incréments d'un demi-pixel."
