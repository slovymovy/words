                    {
                        "sense_id": "dda40f70-47f6-3212-822b-756c88bbe720",
                        "entry_id": "01ed9425-04cd-3775-878d-2883e1e48dfb",
                        "glosses": [
                            "Personne qui élève les huitres dans un parc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a10f63-3dde-41d1-ad8f-7e25b1195967",
                                "sense_id": "dda40f70-47f6-3212-822b-756c88bbe720",
                                "text": "Comme tous les parqueurs de l’époque, il subit la première crise : en 69 la disparition de l’huître plate, et en 70 celle de la portugaise."
                            },
                            {
                                "example_id": "bc103da6-a17b-4b93-8ca8-4ea52cf8a375",
                                "sense_id": "dda40f70-47f6-3212-822b-756c88bbe720",
                                "text": "Ah, les parqueurs de Ouaga ! Toujours prompts à réclamer le prix du gardiennage, mais jamais prêts à assumer certaines responsabilités."
                            },
                            {
                                "example_id": "1922047b-d530-4928-8a61-f763be3c7530",
                                "sense_id": "dda40f70-47f6-3212-822b-756c88bbe720",
                                "text": "Les « parqueurs » eux, à l’intention des clients, ont un slogan à la bouche : « on paye avant de rentrer »."
                            }
                        ]
                    }
