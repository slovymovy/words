                {
                    "sense_id": "94ad5a2e-7f22-3c1f-944b-ae6c7a9a85f8",
                    "sense_definition": "Tirer parti de quelque chose, exploiter au mieux une opportunité ou une ressource.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche à <w>utiliser</w> au mieux les compétences de chaque employé.",
                            "target_lang_translations": {
                                "en": "The company is trying to <w>make the most of</w> each employee's skills.",
                                "ru": "Компания стремится <w>максимально эффективно использовать</w> навыки каждого сотрудника.",
                                "nl": "Het bedrijf probeert de vaardigheden van elke medewerker zo goed mogelijk <w>te benutten</w>.",
                                "de": "Das Unternehmen versucht, die Fähigkeiten jedes Mitarbeiters bestmöglich <w>zu nutzen</w>.",
                                "pl": "Firma stara się jak najlepiej <w>wykorzystać</w> umiejętności każdego pracownika.",
                                "it": "L'azienda cerca di <w>sfruttare al meglio</w> le competenze di ogni dipendente.",
                                "cs": "Firma se snaží co nejlépe <w>využít</w> schopnosti každého zaměstnance.",
                                "tr": "Şirket, her çalışanın becerilerini en iyi şekilde <w>değerlendirmeye</w> çalışıyor.",
                                "es": "La empresa intenta <w>aprovechar al máximo</w> las habilidades de cada empleado.",
                                "zh": "公司正努力充分<w>利用</w>每位员工的技能。"
                            }
                        },
                        {
                            "text": "Le navigateur a su <w>utiliser</w> chaque souffle de vent pour avancer plus vite.",
                            "target_lang_translations": {
                                "en": "The navigator knew how to <w>make the most of</w> every gust of wind to move faster.",
                                "ru": "Штурман сумел <w>извлечь пользу из</w> каждого порыва ветра, чтобы идти быстрее.",
                                "nl": "De stuurman wist elke windstoot <w>te benutten</w> om sneller vooruit te komen.",
                                "de": "Der Steuermann verstand es, jeden Windstoß <w>zu nutzen</w>, um schneller voranzukommen.",
                                "pl": "Żeglarz potrafił <w>wykorzystać</w> każdy podmuch wiatru, żeby płynąć szybciej.",
                                "it": "Il navigatore ha saputo <w>sfruttare</w> ogni soffio di vento per andare più veloce.",
                                "cs": "Navigátor dokázal <w>využít</w> každý závan větru, aby plul rychleji.",
                                "tr": "Gemici, daha hızlı ilerleyebilmek için esen her rüzgârı iyi <w>değerlendirmeyi</w> bildi.",
                                "es": "El navegante supo <w>aprovechar</w> cada ráfaga de viento para avanzar más rápido.",
                                "zh": "这位舵手懂得<w>利用</w>每一阵风，好让船走得更快。"
                            }
                        }
