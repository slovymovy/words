                        "cross_references": [
                            {
                                "target_word": "antiskating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26ccd3d-e719-3b5d-9443-cd466ef5efcc",
                                        "entry_id": "18831ee9-6f34-3745-941e-369011d4056b",
                                        "glosses": [
                                            "A feature of a record player that prevents the stylus from slipping out of the groove and \\\"skating\\\" across the surface of the record."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c55696-cb03-492e-9501-44eb2269a537",
                                                "sense_id": "d26ccd3d-e719-3b5d-9443-cd466ef5efcc",
                                                "text": "Virtually all pickups these days appear to have been designed for use on turntables with antiskating, which my AR lacks. I talked with one man who had replaced his cartridge with a modern one having an elliptical stylus […]"
                                            },
                                            {
                                                "example_id": "3e8a53b1-c454-41cd-9dde-96d8d76b36a5",
                                                "sense_id": "d26ccd3d-e719-3b5d-9443-cd466ef5efcc",
                                                "text": "I must take issue with the method of setting a tone arm's antiskating compensation recommended in August's \"Troubleshooting\" article […]"
                                            },
                                            {
                                                "example_id": "68867e0d-0a4d-441d-b527-ec99db2ee290",
                                                "sense_id": "d26ccd3d-e719-3b5d-9443-cd466ef5efcc",
                                                "text": "There are many different ways to generate the antiskating force. It is incorrect to assume that increasing the drag on the horizontal motion of the tonearm will compensate for skating. Skating force is independent of groove spiraling speed […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
