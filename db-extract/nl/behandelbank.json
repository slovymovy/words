                        "glosses": [
                            "een ligbank waarop de te behandelen persoon ligt en daar zijn behandeling ontvangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f248e0d-b60c-4169-adba-6d273825eeb3",
                                "sense_id": "1876d469-0f7b-324a-af25-96feac4c490f",
                                "text": "De volgende dag lag ik op de behandelbank bij de lokale masseur van Bishop voor een extra lange behandeling. Door de spanning van de afgelopen week was mijn lijf op slot gegaan en ik hoopte dat hij mij weer kon laten ontspannen."
                            },
                            {
                                "example_id": "62ed43ae-18c4-4e7e-8983-a95f1c4507ed",
                                "sense_id": "1876d469-0f7b-324a-af25-96feac4c490f",
                                "text": "Na drie maanden zat mijn lichaam zo vast dat ik zowat mijn auto niet meer uitkwam. Een afspraak bij de fysiotherapeut volgde en het bleek dat ik totaal overbelast was. Ik heb vier keer als een aangespoelde potvis in de verdrukking gelegen op de behandelbank om alles weer uit de kreukels te laten halen."
                            }
                        ]
                    }
