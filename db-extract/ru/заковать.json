                "translations": [
                    {
                        "translation_id": "d9deb2fa-67c4-4358-994f-b7f3f8d7848f",
                        "source_entry_id": "3daf37c6-3b31-38f0-af60-6a4b98838f13",
                        "target_lang_word": "fetter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fetter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b13d6d7-1b73-37a3-93d2-e372c2d513b6",
                                        "entry_id": "0e56745b-5a45-3309-ba3c-857f57d02c11",
                                        "glosses": [
                                            "A chain or similar object used to bind a person or animal – often by its legs (usually in plural)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                        "entry_id": "0e56745b-5a45-3309-ba3c-857f57d02c11",
                                        "glosses": [
                                            "Anything that restricts or restrains."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ea8c4ab-5f99-435e-9bd7-0155ef8f23df",
                                                "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                                "text": "Passion's too fierce to be in fetters bound."
                                            },
                                            {
                                                "example_id": "0834c8b8-948f-43aa-a28a-43a62d3ca2b0",
                                                "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                                "text": "He looks upon study as an odious fetter; his time is spent in the open air, climbing the hills or rowing on the lake."
                                            },
                                            {
                                                "example_id": "933fc386-e47f-4cd5-b002-f25dfb5a90ef",
                                                "sense_id": "9f07418a-b871-3133-9c73-ee433377f902",
                                                "text": "That was the turning-point of my life. I broke my fetters, and I fought a hard fight for a new career …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fetter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd890b94-a7be-3806-8eaa-c2e829bb1d4f",
                                        "entry_id": "378d8ca3-3786-39b3-8891-9dd4136713d0",
                                        "glosses": [
                                            "To shackle or bind up with fetters."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b4c7ade-c315-4143-bf97-2270a6b26a64",
                                                "sense_id": "cd890b94-a7be-3806-8eaa-c2e829bb1d4f",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0df1a3-2f11-30a0-8a50-b130228cdcda",
                                        "entry_id": "378d8ca3-3786-39b3-8891-9dd4136713d0",
                                        "glosses": [
                                            "To restrain or impede; to hamper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
