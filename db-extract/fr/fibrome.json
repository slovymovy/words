                ],
                "senses": [
                    {
                        "sense_id": "112d232f-5a6d-3f5e-9d95-1fdd3581625a",
                        "entry_id": "5e796908-4d76-3dcc-9788-f05ee26d8fd5",
                        "glosses": [
                            "Tumeur généralement abdominale, composée par des tissus fibreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e257431-7b50-4cda-b478-42947fdecc72",
                                "sense_id": "112d232f-5a6d-3f5e-9d95-1fdd3581625a",
                                "text": "Cette femme a été opérée d’un fibrome."
                            },
                            {
                                "example_id": "95a940c7-21da-440c-a7c4-2cfdcf1f19d5",
                                "sense_id": "112d232f-5a6d-3f5e-9d95-1fdd3581625a",
                                "text": "Ses cheveux abondants, dont elle devait être fière, semblaient dévorer sa substance ; eux seuls étaient vivants, luxuriants, sur ce corps dévasté, sans doute rongé à l’intérieur par quelque fibrome."
                            },
                            {
                                "example_id": "95bd1104-8de1-4e21-975d-98f221efe8c0",
                                "sense_id": "112d232f-5a6d-3f5e-9d95-1fdd3581625a",
                                "text": "– Depuis que sa femme est morte d’un fibrome, il est aigri ! Tous les veufs sont pareils."
                            }
                        ]
                    }
                ],
