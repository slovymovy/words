                        "entry_id": "d891ea05-3bac-3417-a60b-28f122632189",
                        "glosses": [
                            "Anciennement, à Dieppe, droit que les pêcheurs dieppois avaient de vendre leur poisson par leurs mains, à la hotte et sans passer par l'intermédiaire d'un vendeur."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "cb529a5c-b853-4719-b1c1-8881dd38cda0",
                                "sense_id": "5bb05e73-db61-3b68-9e0f-39ae56525eff",
                                "text": "Maintenir et garder les marchands forains et étrangers, apportant leur poisson en ladite ville [Dieppe] pour y être vendu, en leur ancienne liberté et franchise et lesdits suppléants [les Dieppois] en leur droit de hottage, comme ils en ont joui par le passé."
                            }
                        ]
                    },
                    {
                        "sense_id": "33267be8-70a8-3c98-8c16-aab36c8260a6",
                        "entry_id": "d891ea05-3bac-3417-a60b-28f122632189",
                        "glosses": [
                            "Action de porter le poisson dans des hottes."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "c437c4e7-e610-4349-a9f5-1340c52e0a2d",
                                "sense_id": "33267be8-70a8-3c98-8c16-aab36c8260a6",
                                "text": "L'administration municipale [de Dieppe] ayant demandé l'avis de la commission de l'écorage, en vue du désir qu'aurait la municipalité de voir augmenter le salaire des personnes occupées au hottage pendant la saison du hareng."
                            }
                        ]
                    }
