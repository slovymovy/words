                        "glosses": [
                            "разг. уменьш.-ласк. к вишня (дерево)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb5159b-f0a8-4bdc-80d4-beb54bb79be5",
                                "sense_id": "564af108-8594-3392-8d77-18dd7e6990b4",
                                "text": "На выгоне за усадьбой стояла вишенка, и Кемальчик решил полакомиться ягодами, раз уж ему не дают поговорить с гостем."
                            }
                        ]
                    },
                    {
                        "sense_id": "2260a167-d421-31b9-830a-17507afad769",
                        "entry_id": "effe4bb6-77b1-35d7-9d2f-28c86a001aad",
                        "glosses": [
                            "уменьш.-ласк. к вишня (плод)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4423935b-d13d-4eed-a458-52cfb3cce3d6",
                                "sense_id": "2260a167-d421-31b9-830a-17507afad769",
                                "text": "И вот он уже сам бежал среди деревьев, усеянных маленькими поспевающими вишенками..."
                            }
                        ]
                    }
