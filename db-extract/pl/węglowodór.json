                                        "glosses": [
                                            "A compound consisting only of carbon and hydrogen atoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be711980-a306-4d0a-9a23-fc8b96186092",
                                                "sense_id": "3917c970-1250-3f20-ac44-8e958f5eeef8",
                                                "text": "Chofen is an unusually small hydrogen-helium gas giant, with traces of sulphur and hydrocarbons in the atmosphere. The Alliance surveyor ship Ibn Battuta provided inconclusive evidence of hydrocarbon life in the atmosphere (over 1000 meters below the cloud tops), where pressure compresses Chofen's hydrogen into a liquid state."
                                            },
                                            {
                                                "example_id": "ebe7bc30-98e6-404a-9a6b-20a778aa7773",
                                                "sense_id": "3917c970-1250-3f20-ac44-8e958f5eeef8",
                                                "text": "Researchers analysed samples of nurdles and burnt lumps of plastic from four Sri Lankan beaches for heavy metals and various chemicals, including benzotriazole UV-stabilisers, which are used to prevent discoloration in plastics, bisphenols and polyaromatic hydrocarbons (PAHs)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
