                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4ea5bc-9431-4458-b7ea-49d92e8439a4",
                                                "sense_id": "88cd4ea4-d4cc-39a1-a262-fb04c613e3ac",
                                                "text": "Ich vermute mal, dass er Recht hat."
                                            },
                                            {
                                                "example_id": "9935a170-dfc3-4092-8fde-14d87ac0748f",
                                                "sense_id": "88cd4ea4-d4cc-39a1-a262-fb04c613e3ac",
                                                "text": "Der Golfstrom ist wichtig für das milde Klima in Westeuropa. Nun deutet eine Studie darauf hin, dass sich die Strömung abschwächt. Ursache sei der Klimawandel, vermuten die Forscher."
                                            },
                                            {
                                                "example_id": "0a8705b0-cb61-45ae-bef4-885fa6fc93fd",
                                                "sense_id": "88cd4ea4-d4cc-39a1-a262-fb04c613e3ac",
                                                "text": "„Argelander vermutet den Schlüssel für die Sozialprobleme in der schon sehr früh aufgetretenen Leidenschaft für den Flugsport.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
