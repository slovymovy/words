                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a80d890-f89f-3bbb-a3ac-b848d0950947",
                                        "entry_id": "31135845-ea5e-3797-980c-7a7edbd8bcdf",
                                        "glosses": [
                                            "Food, especially for livestock."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c50ae81-6553-4dd3-ab71-14c0f0bcce11",
                                                "sense_id": "3a80d890-f89f-3bbb-a3ac-b848d0950947",
                                                "text": "The farm which supplied to him ungrudging provender had all his vast capacity for work in willing exercise …"
                                            },
                                            {
                                                "example_id": "5c8c90dd-cb94-428f-9f0c-54a3199f1de6",
                                                "sense_id": "3a80d890-f89f-3bbb-a3ac-b848d0950947",
                                                "text": "He ripp'd the womb up of his mother, / Dame Tellus, 'cause he wanted fother, / And provender, wherewith to feed / Himself and his less cruel steed."
                                            },
                                            {
                                                "example_id": "fdb58e67-c0af-4543-918f-552b16b9d8c2",
                                                "sense_id": "3a80d890-f89f-3bbb-a3ac-b848d0950947",
                                                "text": "Irregular, sporadic feeding and strange provender were beginning to take their toll, and I felt queasy at the thought of 'various curries' the Amat's clerk had promised for the first meal of the day."
                                            },
                                            {
                                                "example_id": "22755880-35f9-4af3-8d2b-b94148b3733a",
                                                "sense_id": "3a80d890-f89f-3bbb-a3ac-b848d0950947",
                                                "text": "(...) hobbits were easy-going with their children in the matter of sitting up late, especially when there was a chance of getting them a free meal. Bringing up young hobbits took a lot of provender."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "provender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd86644b-38e7-3681-bcb1-83c524cd42c3",
                                        "entry_id": "e452cb6a-8113-392f-a166-d37a3c5d70cd",
                                        "glosses": [
                                            "To feed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
