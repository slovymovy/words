                    {
                        "sense_id": "938fb9ec-2270-32e0-9b0c-2108da2e2fbf",
                        "entry_id": "e3818ae1-436a-33c7-8846-aea3e58c3b59",
                        "glosses": [
                            "Qui recherche l’intimité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8849a6b4-1823-42f8-b7f2-b259a9b4f39e",
                                "sense_id": "938fb9ec-2270-32e0-9b0c-2108da2e2fbf",
                                "text": "Le cadre intimiste d’un intérieur bourgeois."
                            },
                            {
                                "example_id": "756f5723-fea3-4ea6-85f1-cc9360cc07e3",
                                "sense_id": "938fb9ec-2270-32e0-9b0c-2108da2e2fbf",
                                "text": "la « Matinale du Monde » a publié, le 30 janvier, un long entretien « intimiste » avec le confrère d’Inter Patrick Cohen, « l’homme le plus écouté de France ». — (Le Canard enchaîné, 8 février 2017, page 7)"
                            },
                            {
                                "example_id": "6a9f93aa-1fb9-4a08-b0aa-e839dca5ea0d",
                                "sense_id": "938fb9ec-2270-32e0-9b0c-2108da2e2fbf",
                                "text": "Le discours empreint de dignité et d’un ton parfois intimiste qu’affectionne le président Biden a conforté, certes, tous ceux qui se sentaient blessés dans leur âme pendant le mandat de Trump."
                            },
                            {
                                "example_id": "e74bb024-a67e-421a-a4b1-a730ac1e7bf3",
                                "sense_id": "938fb9ec-2270-32e0-9b0c-2108da2e2fbf",
                                "text": "Elles ont également droit à des lieux intimistes et sécuritaires qui respectent leur dignité, leur pudeur et leurs sensibilités."
                            }
                        ]
                    },
                    {
                        "sense_id": "84017e9e-eae1-3068-a942-7ca1e2734088",
                        "entry_id": "e3818ae1-436a-33c7-8846-aea3e58c3b59",
