                                "target_senses": [
                                    {
                                        "sense_id": "f06bda0c-b750-3119-b5ba-04d7cc5207b0",
                                        "entry_id": "e25f18a1-7e3b-3ac6-b350-4e4c8f86d418",
                                        "glosses": [
