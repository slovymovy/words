                "senses": [
                    {
                        "sense_id": "bc24df93-3c91-3476-81fc-c797479c6c82",
                        "entry_id": "899e9623-64c7-381a-bc9a-bc0f465f571b",
                        "glosses": [
                            "dewiacja seksualna polegająca na obnażaniu się w miejscu publicznym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87194700-2638-401a-a21b-01aa69d3b2bd",
                                "sense_id": "bc24df93-3c91-3476-81fc-c797479c6c82",
                                "text": "Ekshibicjonizm nie jest może niebezpieczny, ale dla wielu ludzi degustujący."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "18e86db2-e5ae-35f9-b2c8-583753a6c79e",
                        "entry_id": "899e9623-64c7-381a-bc9a-bc0f465f571b",
                        "glosses": [
                            "skłonność do obnażania się w sprawach intymnych, często drastycznych"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0f5beef6-eadc-4b26-a147-7e56353df7a1",
                                "sense_id": "18e86db2-e5ae-35f9-b2c8-583753a6c79e",
                                "text": "W twórczości autobiograficznej tego pisarza można było dostrzec pewien ekshibicjonizm."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68167448-7ca0-4f33-bfe6-0ea675fc3f0f",
                        "source_entry_id": "899e9623-64c7-381a-bc9a-bc0f465f571b",
                        "source_sense_id": "bc24df93-3c91-3476-81fc-c797479c6c82",
                        "target_lang_word": "exhibitionism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhibitionism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4919ba32-8df9-3d94-b250-77757ef42239",
                                        "entry_id": "d4e27c63-902b-3772-842d-78e322f68773",
                                        "glosses": [
                                            "The practice or character trait of deliberately drawing attention to oneself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73650b08-f0cb-34d2-b84c-b534c52c8a1b",
                                        "entry_id": "d4e27c63-902b-3772-842d-78e322f68773",
                                        "glosses": [
                                            "The practice or character trait of deliberately displaying one's genitals, nipples, or buttocks in public for sexual gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff65066-d6e0-4a85-ab57-0e4205ce66c7",
                                                "sense_id": "73650b08-f0cb-34d2-b84c-b534c52c8a1b",
                                                "text": "The dance consisted of sexual exhibitionism, reeling and swaying as if in a state of intoxication, erotic bodily movements, and denudation."
                                            },
                                            {
                                                "example_id": "efea031c-bf5a-4498-a8d0-436446d7216d",
                                                "sense_id": "73650b08-f0cb-34d2-b84c-b534c52c8a1b",
                                                "text": "Yes, really. Blanchard has expanded the DSM's \"paraphilia\" section (where crimes such as paedophilia and exhibitionism go) to include transvestic disorder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adff7fa2-223a-4369-8476-d68602e4fffc",
                        "source_entry_id": "899e9623-64c7-381a-bc9a-bc0f465f571b",
                        "source_sense_id": "bc24df93-3c91-3476-81fc-c797479c6c82",
                        "target_lang_word": "exhibicionismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhibicionismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0a00cd09-78dc-300e-b9f5-9df12133592c",
                                        "entry_id": "f996ad93-c06f-361e-a7b2-bd62ee52e9a4",
                                        "glosses": [
                                            "Inclinación, afán, gusto o prurito de exhibirse, de hacerse ver en público deliberadamente para atraer atención o admiración."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9997840c-4acf-3cd0-910d-999b9b6c8e04",
                                        "entry_id": "f996ad93-c06f-361e-a7b2-bd62ee52e9a4",
                                        "glosses": [
                                            "Acción morbosa o compulsión patológica de mostrar a otras personas órganos que se consideran íntimos, tales como los genitales, glúteos, torso y pechos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89a80630-a490-4a24-b464-6ee84ff107b0",
                        "source_entry_id": "899e9623-64c7-381a-bc9a-bc0f465f571b",
                        "source_sense_id": "bc24df93-3c91-3476-81fc-c797479c6c82",
                        "target_lang_word": "Exhibitionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exhibitionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "Sexualtrieb, bei dem Lustgewinn aus der Zurschaustellung der eigenen Genitalien gezogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40533f1-a6b0-4af2-a779-823312c8e890",
                                                "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                                "text": "Exhibitionismus im klinischen Sinne, bedingt immer auch einen Leidensdruck Betroffener."
                                            },
                                            {
                                                "example_id": "5ae80818-006b-4d0e-ba2b-b001d961ec25",
                                                "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                                "text": "„Freud übrigens führt an, dass es im Verbergen auch ein Aufreizen gibt und dass der weibliche Exhibitionismus sich im Verrücken der Röcke, im Hochdrücken der Büste offenbart.“"
                                            },
                                            {
                                                "example_id": "00bd5320-4849-49a4-a77d-0cd312d1d506",
                                                "sense_id": "8956cca6-e27b-3bfc-b2ff-129cc9a7b1b9",
                                                "text": "„Zuzusehen, wie Adrienne auf der Party diesen Exhibitionismus beobachtete, weckte in Sylvia die Angst, dass Adrienne Gelüste hegte, die sie nicht befriedigen konnte, was sie wiederum unangenehm an Cyprians Warnung erinnerte, als Suzanne noch gelebt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "der Drang sich selbst oder sein Leben zu präsentieren, in die Öffentlichkeit zu tragen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80641cb6-13b1-476a-9a67-9ddcc4e61ef1",
                                                "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                                "text": "„Was sich mit den sozialen Netzwerken geändert hat, sind die Praktiken und der Kontext von Selbstdarstellung. Das wird von vielen älteren Menschen als Exhibitionismus missverstanden.“"
                                            },
                                            {
                                                "example_id": "12e2a916-2a11-49f2-9a02-1a0f3e1d7392",
                                                "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                                "text": "„Bis dahin war alles beherrscht gewesen von Narzissmus und Exhibitionismus, seltsam leblos, trotz der Kühnheit und der Zurschaustellung von Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "006c829d-1533-3b97-b22c-0b32832f805d",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "Handlung, die von einer männlichen Person verübt wird, bei der durch Zurschaustellung von Genitalien Dritte belästigt werden"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11fb042-6680-4387-a8dc-3e7bdc0dcb69",
                                                "sense_id": "006c829d-1533-3b97-b22c-0b32832f805d",
                                                "text": "„In Schwenningen kam es in der Nacht zu Samstag zu zwei Fällen von Exhibitionismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
