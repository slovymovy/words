                        ]
                    },
                    {
                        "translation_id": "53be566c-4073-4dda-8dcf-f01ad1a623e6",
                        "source_entry_id": "b6a55c45-8e3d-3644-a628-bdd27a8ad2fb",
                        "source_sense_id": "b1b73097-4db2-324f-82e1-78b00dbab5cc",
                        "target_lang_word": "spoorwegman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoorwegman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a582df4-557a-368b-81b1-0807ec8c236f",
                                        "entry_id": "7013974d-dd8e-3407-a653-18257d2c1038",
                                        "glosses": [
                                            "iemand die werk bij een spoorwegbedrijf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d5a72be-f9d6-4fb4-977e-a9b2b1205751",
                                                "sense_id": "5a582df4-557a-368b-81b1-0807ec8c236f",
                                                "text": "Langs het treinstel drentelde inderdaad een spoorwegman in uniform die de wagons in het oog hield."
                                            },
                                            {
                                                "example_id": "a417fa09-7bb1-4235-8111-dd27524f4581",
                                                "sense_id": "5a582df4-557a-368b-81b1-0807ec8c236f",
                                                "text": "De ontsnapping was gelukt, maar hoe moest het verder? \"Ik ging naar een spoorwegman toe met de vraag of hij me kon helpen. Maar hij zei 'nee' en holde weg. Gek hé, dat beeld vergeet ik nooit.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bdc8c5d-cca1-4df0-a9bd-79c5d2bc11be",
                        "source_entry_id": "b6a55c45-8e3d-3644-a628-bdd27a8ad2fb",
                        "source_sense_id": "b1b73097-4db2-324f-82e1-78b00dbab5cc",
                        "target_lang_word": "Eisenbahner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisenbahner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                        "entry_id": "43c23b8d-986d-3efa-a603-4007bdb73ea4",
                                        "glosses": [
                                            "Mitarbeiter eines Eisenbahnunternehmens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603a2505-8ca0-48cd-a33f-485d1e89aa2c",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "Unter den Eisenbahnern gibt es ein starkes Zusammengehörigkeitsgefühl."
                                            },
                                            {
                                                "example_id": "11a9f31f-3849-4876-9ffc-8df9760f6ab4",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "„Ihr Vater war als Eisenbahner am Bahnhof von Tollmingkehmen beschäftigt.“"
                                            },
                                            {
                                                "example_id": "5ebce84c-ab29-4448-8e82-1705131bc568",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "„Ein Eisenbahner mit einer kleinen Lampe schüttelte mich und fragte nach meinem Reiseziel.“"
                                            },
                                            {
                                                "example_id": "3d61c424-a43d-4d95-a383-c4e7d6e1dbba",
                                                "sense_id": "fe38b51d-ea15-305b-8fa0-f9a6503a10fc",
                                                "text": "„Er nahm den Eisenbahner nicht für einen Offizier, trotz der Achselstücke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60df76c4-d9f4-49e5-9bd5-a249b9443e87",
                        "source_entry_id": "b6a55c45-8e3d-3644-a628-bdd27a8ad2fb",
                        "source_sense_id": "b1b73097-4db2-324f-82e1-78b00dbab5cc",
                        "target_lang_word": "железнодорожник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "железнодорожник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "55644a57-692a-3d79-b015-d0811ea5562a",
                                        "entry_id": "58bfadd8-8944-3522-a40a-c8e018e4e8ae",
                                        "glosses": [
                                            "работник железнодорожного транспорта; строитель железных дорог"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f610bf-eedc-45a4-88dc-ef814994ef5f",
                                                "sense_id": "55644a57-692a-3d79-b015-d0811ea5562a",
                                                "text": "Всем давно известна формула русской железной дороги: «Не дорога создана для публики, а публика для дороги». Нет такого железнодорожника, с кондуктора до директора включительно, который бы сомневался в этой аксиоме и не посмотрел бы на вас с насмешливым удивлением, если б вы стали утверждать перед ним, что дорога создана для публики."
                                            },
                                            {
                                                "example_id": "17b2373f-b2b3-483d-82af-7e6bdc8ca4bd",
                                                "sense_id": "55644a57-692a-3d79-b015-d0811ea5562a",
                                                "text": "Железнодорожники продолжают изощряться в изыскании новых мер борьбы с «зайцами»."
                                            },
                                            {
                                                "example_id": "af4a3887-f1ba-489a-bc6d-5a06396d7cfc",
                                                "sense_id": "55644a57-692a-3d79-b015-d0811ea5562a",
                                                "text": "— А у нас-то какая беда! — сказал вдруг железнодорожник. — Занесло поезд. Стоит в степи второй день, и ничего поделать не можем. Рабочих рук нет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d42e98-f430-3d3b-88f8-47c0574df7df",
                                        "entry_id": "58bfadd8-8944-3522-a40a-c8e018e4e8ae",
                                        "glosses": [
                                            "спортсмен, выступающий за команду «Локомотив»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dac72ef-4956-41b2-bb7b-1c9bff411612",
                                                "sense_id": "b8d42e98-f430-3d3b-88f8-47c0574df7df",
                                                "text": "\"Локомотиву\" уже с давних пор удаётся каждый раз добиваться победы, затрачивая при этом абсолютный минимум энергии, однако в субботу КПД железнодорожников зашкалил за 100 процентов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
