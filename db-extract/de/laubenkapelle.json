                ],
                "senses": [
                    {
                        "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                        "entry_id": "e03b5fff-f5db-35e7-b0a1-d95769cbf8dc",
                        "glosses": [
                            "Kapelle mit laubenartigem Zubau, die unregelmäßig für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93aa451a-6f25-4d4b-9bb0-fa6ce296c71d",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Laubenkapellen stellen eine Sonderform dar, wobei die Laube sowohl als homogene Bauform mit vorgezogenem Dach und Säulen vorliegen kann, als auch als späterer Zubau, gerade die letztgenannte Form ist in NÖ oft zu finden.“"
                            },
                            {
                                "example_id": "f5cdd2b4-1c10-4577-b00b-5d804c008bc2",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Sie ist der Heiligen Rosalia geweiht, eine Laubenkapelle mit einer Vorhalle, die auf Holzsäulen steht.“"
                            },
                            {
                                "example_id": "53113745-e3ea-4523-abb3-b44f3320bea3",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Der Sensenwerksbesitzer Zeitlinger errichtete 1843 die kleine Laubenkapelle im Bodinggraben.“"
                            },
                            {
                                "example_id": "8f2409bc-b8c4-4f9c-8d27-db9920f50016",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Am Rosenkogel- und Mariazeller-Wanderweg, kurz nachdem man die Max-Gschiel-Straße erreicht hat, steht rechts die Laubenkapelle in leichter Hanglage.“"
                            },
                            {
                                "example_id": "7838ae3a-3df2-46e8-bdd9-fafc72fcd0e3",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Die Kreuzwegstationen in Form von Laubenkapellen mit weit vorgezogenem, auf toskanischen Säulen ruhendem Walmdach wurden zeitgleich errichtet.“"
                            },
                            {
                                "example_id": "d0f2d98e-b481-471f-a500-68c645490338",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Natürlich kommen wir an den typischen Laubenkapellen vorbei, an denen sich Wege gabeln und wo sich früher Verliebte von Nachbarhöfen unter einem besonderen Schutz getroffen haben mögen.“"
                            },
                            {
                                "example_id": "a4a6ba57-5928-4883-91ac-790ed315ae94",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Die Bandbreite reicht vom Blechschnittkreuz über Kasten- oder Bretterkreuze bis zu Bildstöcken und Laubenkapellen.“"
                            },
                            {
                                "example_id": "381dce13-b6a4-4c3a-8c86-28a9ee967071",
                                "sense_id": "05abb296-4544-3814-8680-5e30a031bc63",
                                "text": "„Die 1843 erbaute Kapelle ist der Heiligen Rosalia geweiht, eine Laubenkapelle mit einer Vorhalle, die auf Holzsäulen steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
