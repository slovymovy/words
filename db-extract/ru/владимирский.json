                                        "entry_id": "f4679520-6d8f-3a87-a5d5-6fa088bbe75b",
                                        "glosses": [
                                            "A transliteration of the Macedonian or Russian male given name Вла́ди́мир (Vládímir), equivalent to Volodymyr, popular throughout the history of Slavic countries and societies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e36daf7-ed9e-36d0-abda-7b4f3644028d",
                                        "entry_id": "f4679520-6d8f-3a87-a5d5-6fa088bbe75b",
                                        "glosses": [
                                            "A male given name from Russian, but rare as a name of English-speaking persons."
                                        ],
