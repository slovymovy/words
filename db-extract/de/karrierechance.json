                "senses": [
                    {
                        "sense_id": "f800ab0c-6b88-3c3d-bceb-c8147eb17bce",
                        "entry_id": "3612c851-d5cd-39e5-b7a5-9c05628c431d",
                        "glosses": [
                            "Möglichkeit auf eine bestimmte berufliche Laufbahn"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "452a5e0b-a129-43d4-9fe2-65fcee39d18e",
                                "sense_id": "f800ab0c-6b88-3c3d-bceb-c8147eb17bce",
                                "text": "„Vorteile der Telearbeit sind die niedrigeren Arbeitskosten durch die Einsparung von Büromieten sowie die größere Flexibilität der Mitarbeiter; Nachteile sind fehlende Kontrolle, soziale Isolation und geringere Karrierechancen.“"
                            },
                            {
                                "example_id": "73304556-103d-414c-bb81-d2ea55cbecba",
                                "sense_id": "f800ab0c-6b88-3c3d-bceb-c8147eb17bce",
                                "text": "„Um neues Wissen zu erwerben und die eigenen Karrierechancen im Unternehmen zu verbessern, kann ein Studium eine sinnvolle Möglichkeit sein - sei es als Aufbaustudium oder als Erststudium nach einer Ausbildung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
