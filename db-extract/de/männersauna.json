                "senses": [
                    {
                        "sense_id": "953554b8-51b5-316c-945b-58794816404c",
                        "entry_id": "a49c53c3-380f-3568-98a6-d2e3a4e60fb1",
                        "glosses": [
                            "Sauna, in die nur Männer Zugang haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7976ea31-a249-490e-8c2f-38c6825c6811",
                                "sense_id": "953554b8-51b5-316c-945b-58794816404c",
                                "text": "„Die Männer benehmen sich meist zurückhaltend und trinken nicht so viel wie in einer reinen Männersauna.“"
                            },
                            {
                                "example_id": "2537eea4-d070-432e-bf60-37211c797537",
                                "sense_id": "953554b8-51b5-316c-945b-58794816404c",
                                "text": "„Montags kümmert sie sich ausschließlich um das Wohlbefinden des ‚starken Geschlechts‘ – Männersauna ist angesagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
