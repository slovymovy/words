                                                "sense_id": "b8652ccd-afa3-377e-af8d-e924b0f30bd3",
                                                "text": "Thomas, warum bist du nur so maulfaul? Sag doch mal was!"
                                            },
                                            {
                                                "example_id": "47439eac-b709-4c00-9100-ba6187391c19",
                                                "sense_id": "b8652ccd-afa3-377e-af8d-e924b0f30bd3",
                                                "text": "„Ich warte auf eine Kontaktanzeige, in der eine Frau einen maulfaulen Stubenhocker sucht, der weder tanzt noch wandert, aber gerne die Sopranos guckt und dabei Pralinen futtert.“"
                                            },
                                            {
                                                "example_id": "762a5def-793d-4203-8ae5-6eae6f445209",
                                                "sense_id": "b8652ccd-afa3-377e-af8d-e924b0f30bd3",
                                                "text": "„Da kommen die maulfaulsten Filme her und der herzwehste Blues.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
