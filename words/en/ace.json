                {
                    "sense_id": "6b7a9fc7-4756-336f-8953-aad5747b3082",
                    "sense_definition": "A playing card with a single symbol on it, usually having the highest or lowest value in a deck.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cards_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need an <w>ace</w> to complete my winning hand in this poker game.",
