                        "target_lang_word": "заку́сочная",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "заку́сочная",
                                "target_lang_code": "ru",
                                "target_senses": [
