{
    "word_family": [
        "пористый",
        "пористость"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54e7112e-4f7b-31e8-ac0a-2bca67487129",
                    "sense_definition": "Определенный момент или отрезок времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Уже <w>пора</w> идти домой, потому что становится темно.",
                            "target_lang_translations": {
                                "en": "It is already <w>time</w> to go home because it is getting dark."
                            }
                        },
                        {
                            "text": "Мы до сих <w>пор</w> не получили ответа на наше письмо.",
                            "target_lang_translations": {
                                "en": "We have not received an answer to our letter <w>yet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "время",
                        "срок"
                    ],
                    "common_phrases": [
                        "до сих пор",
                        "на первых порах"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific moment or period of time, often implying that it is the right time for something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "General term for a specific moment or occasion."
                            },
                            {
                                "target_lang_word": "high time",
                                "target_lang_sense_clarification": "Used when something is overdue or should be done immediately."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24fc3a2e-2261-3c9d-9a73-eaf6303e8cfe",
                    "sense_definition": "Время года или определенный сезон.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летняя <w>пора</w> — лучшее время для отдыха на море.",
                            "target_lang_translations": {
                                "en": "The summer <w>season</w> is the best time for a vacation by the sea."
                            }
                        },
                        {
                            "text": "Золотая осенняя <w>пора</w> всегда вдохновляла многих поэтов.",
                            "target_lang_translations": {
                                "en": "The golden autumn <w>time</w> has always inspired many poets."
                            }
                        }
                    ],
                    "synonyms": [
                        "время",
                        "период"
                    ],
                    "target_lang_definitions": {
                        "en": "A season or a specific time of year."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "season",
                                "target_lang_sense_clarification": "A particular period of the year."
                            },
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "Used to refer to a period characterized by specific conditions."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5379d79-3b6d-39b3-8f5c-940275b266ac",
                    "sense_definition": "Длительный промежуток времени, эпоха.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это была <w>пора</w> великих открытий и научных достижений.",
                            "target_lang_translations": {
                                "en": "It was an <w>era</w> of great discoveries and scientific achievements."
                            }
                        },
                        {
                            "text": "В ту <w>пору</w> люди жили совсем иначе, чем сейчас.",
                            "target_lang_translations": {
                                "en": "In that <w>period</w>, people lived quite differently than they do now."
                            }
                        }
                    ],
                    "synonyms": [
                        "период"
                    ],
                    "target_lang_definitions": {
                        "en": "A long period of time or an era."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "era",
                                "target_lang_sense_clarification": "A long and distinct period of history."
                            },
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "A length or portion of time."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f602c6d1-dd6e-33c7-a13b-a07780453660",
                    "sense_definition": "Мельчайшее отверстие на поверхности кожи или в структуре материала.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Через <w>поры</w> кожи наш организм выводит лишнюю влагу.",
                            "target_lang_translations": {
                                "en": "Through the <w>pores</w> of the skin, our body releases excess moisture."
                            }
                        },
                        {
                            "text": "Этот материал имеет мелкие <w>поры</w>, поэтому он хорошо пропускает воздух.",
                            "target_lang_translations": {
                                "en": "This material has tiny <w>pores</w>, so it allows air to pass through easily."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A minute opening on the surface of the skin or in a material."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pore",
                                "target_lang_sense_clarification": "A tiny opening in the skin or a material."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
