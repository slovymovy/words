{
    "word_family": [
        "только-только"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9b30adc0-e78a-33ea-b62f-a760f0fdd734",
                    "sense_definition": "Указывает на ограничение; означает «не больше, чем», «исключительно этот» или «ничего, кроме».",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате остался <только> один стул.",
                            "target_lang_translations": {
                                "en": "There was <only> one chair left in the room.",
                                "zh": "房间里<w>只</w>剩下一把椅子了。"
                            }
                        },
                        {
                            "text": "Я хочу купить <только> хлеб и молоко.",
                            "target_lang_translations": {
                                "en": "I want to buy <only> bread and milk.",
                                "zh": "我<w>只</w>想买面包和牛奶。"
                            }
                        },
                        {
                            "text": "Это стоит <только> сто рублей.",
                            "target_lang_translations": {
                                "en": "It costs <only> one hundred rubles.",
                                "zh": "这个<w>才</w>一百卢布。"
                            }
                        }
                    ],
                    "synonyms": [
                        "лишь",
                        "исключительно",
                        "всего",
                        "всего лишь"
                    ],
                    "common_phrases": [
                        "только один",
                        "только ты",
                        "не только",
                        "всего только"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a restriction; means \"no more than\", \"exclusively this\", or \"nothing but\".",
                        "zh": "表示限制，意思是“不超过”“只有这个”或“除……以外没有别的”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "only",
                                "target_lang_sense_clarification": "exclusively; no more than"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "merely; nothing more than"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "只",
                                "target_lang_sense_clarification": "表示限制，相当于“仅仅、只是”"
                            },
                            {
                                "target_lang_word": "才",
                                "target_lang_sense_clarification": "表示数量少或程度低，相当于“仅仅”"
                            },
                            {
                                "target_lang_word": "仅",
                                "target_lang_sense_clarification": "较正式，表示“仅”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14ca4117-1329-34a2-8c9b-8f6be484ce1f",
                    "sense_definition": "Указывает на то, что действие произошло совсем недавно, непосредственно перед моментом речи (часто используется с частицей «что»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_recent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <только> что вернулись из отпуска.",
                            "target_lang_translations": {
                                "en": "We have <just> returned from vacation.",
                                "zh": "我们<w>刚刚</w>度假回来。"
                            }
                        },
                        {
                            "text": "Он <только> вошёл в квартиру.",
                            "target_lang_translations": {
                                "en": "He <just> entered the apartment.",
                                "zh": "他<w>刚</w>进公寓。"
                            }
                        }
                    ],
                    "synonyms": [
                        "недавно",
                        "сейчас",
                        "минуту назад",
                        "совсем недавно"
                    ],
                    "common_phrases": [
                        "только что",
                        "только пришёл",
                        "только начал"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used without 'что' in colloquial speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that an action happened very recently, immediately before the moment of speech (often used with \"что\").",
                        "zh": "表示动作是在说话前不久刚发生的，常相当于“刚”“刚刚”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "a very short time ago"
                            },
                            {
                                "target_lang_word": "only just",
                                "target_lang_sense_clarification": "emphasizing very recent completion"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刚",
                                "target_lang_sense_clarification": "表示动作刚刚发生"
                            },
                            {
                                "target_lang_word": "刚刚",
                                "target_lang_sense_clarification": "强调“就在不久前”"
                            },
                            {
                                "target_lang_word": "才",
                                "target_lang_sense_clarification": "用于“刚……就……”等结构，表示事情发生不久"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3932b9-5cff-39cd-ba84-ce567d2e9a42",
                    "sense_definition": "Указывает на начальный этап действия или состояния; имеет значение «пока ещё», «ещё не закончено».",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_stage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <только> начало большого пути.",
                            "target_lang_translations": {
                                "en": "This is <only> the beginning of a long journey.",
                                "zh": "这<w>才</w>是漫长旅程的开始。"
                            }
                        },
                        {
                            "text": "Ребёнок <только> учится говорить.",
                            "target_lang_translations": {
                                "en": "The child is <only> learning to speak.",
                                "zh": "这个孩子<w>才</w>开始学说话。"
                            }
                        },
                        {
                            "text": "Мы <только> собираемся завтракать.",
                            "target_lang_translations": {
                                "en": "We are <just> getting ready to have breakfast.",
                                "zh": "我们<w>正要</w>吃早饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ещё",
                        "пока",
                        "лишь"
                    ],
                    "common_phrases": [
                        "только начало",
                        "только учусь"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the initial stage of an action or state; means \"so far\", \"not yet finished\".",
                        "zh": "表示动作或状态还处在开始阶段，相当于“才”“刚开始”，意思是还没发展完。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "only",
                                "target_lang_sense_clarification": "indicating an early stage or limited extent"
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "barely; in the early stages of"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "才",
                                "target_lang_sense_clarification": "表示“刚到这个阶段、还早”"
                            },
                            {
                                "target_lang_word": "刚开始",
                                "target_lang_sense_clarification": "表示动作刚开始"
                            },
                            {
                                "target_lang_word": "正要",
                                "target_lang_sense_clarification": "表示马上要开始做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f6654f1-d60b-376c-99cf-1abf059e6edd",
                    "sense_definition": "В сочетании с частицей «бы» выражает сильное желание или мечту.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Только> бы не опоздать на последний автобус!",
                            "target_lang_translations": {
                                "en": "<If only> I don't miss the last bus!",
                                "zh": "<w>但愿</w>别错过末班车！"
                            }
                        },
                        {
                            "text": "<Только> бы погода завтра была хорошей.",
                            "target_lang_translations": {
                                "en": "<If only> the weather were good tomorrow.",
                                "zh": "<w>但愿</w>明天天气好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "лишь"
                    ],
                    "common_phrases": [
                        "только бы",
                        "если бы только"
                    ],
                    "target_lang_definitions": {
                        "en": "Combined with the particle \"бы\", expresses a strong desire or dream.",
                        "zh": "和“бы”连用时，表示强烈的愿望、盼望或担心，希望某事发生或不要发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "if only",
                                "target_lang_sense_clarification": "used to express a strong wish or regret"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "但愿",
                                "target_lang_sense_clarification": "表示强烈愿望，希望事情如此"
                            },
                            {
                                "target_lang_word": "只求",
                                "target_lang_sense_clarification": "书面或较强烈地表示愿望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de6a76b1-ee30-3386-9918-1fbd5e79022f",
                    "sense_definition": "Используется для усиления эмоциональной окраски, удивления или возмущения, часто после вопросительных слов.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где он <только> не путешествовал за эти годы!",
                            "target_lang_translations": {
                                "en": "Where <on earth> hasn't he traveled over these years!",
                                "zh": "这些年他<w>到底</w>去过多少地方旅行啊！"
                            }
                        },
                        {
                            "text": "О чём ты <только> думаешь в такой момент?",
                            "target_lang_translations": {
                                "en": "What <on earth> are you thinking about at a moment like this?",
                                "zh": "这种时候你<w>到底</w>在想什么？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "кто только",
                        "где только",
                        "подумать только"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to intensify emotional coloring, surprise, or indignation, often after question words.",
                        "zh": "用于加强感情色彩，表示惊讶、责备、不满等语气，常放在疑问词后面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "on earth",
                                "target_lang_sense_clarification": "intensifier used after question words"
                            },
                            {
                                "target_lang_word": "ever",
                                "target_lang_sense_clarification": "intensifier for surprise or emphasis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底",
                                "target_lang_sense_clarification": "放在疑问词后，加强追问、惊讶或不满的语气"
                            },
                            {
                                "target_lang_word": "究竟",
                                "target_lang_sense_clarification": "较书面，表示追问或强调"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "ce332ac1-3180-3461-88ea-ef973354a5aa",
                    "sense_definition": "Выражает противопоставление или ограничительное условие; соответствует по значению союзам «но», «однако».",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conjunction_adversative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я согласен пойти в кино, <только> давай выберем комедию.",
                            "target_lang_translations": {
                                "en": "I agree to go to the cinema, <only> let's choose a comedy.",
                                "zh": "我同意去看电影，<w>不过</w>我们选喜剧吧。"
                            }
                        },
                        {
                            "text": "Бери мою книгу, <только> верни её завтра.",
                            "target_lang_translations": {
                                "en": "Take my book, <only> return it tomorrow.",
                                "zh": "拿我的书吧，<w>不过</w>你明天要还我。"
                            }
                        },
                        {
                            "text": "Он хороший человек, <только> иногда слишком строгий.",
                            "target_lang_translations": {
                                "en": "He is a good person, <only> sometimes too strict.",
                                "zh": "他人很好，<w>只是</w>有时候太严格了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "но",
                        "однако"
                    ],
                    "common_phrases": [
                        "да только",
                        "только осторожно"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses contrast or a restrictive condition; corresponds to the conjunctions \"but\", \"however\".",
                        "zh": "表示转折或附带限制条件，相当于“但是”“不过”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "only",
                                "target_lang_sense_clarification": "informal conjunction meaning 'but' or 'except that'"
                            },
                            {
                                "target_lang_word": "but",
                                "target_lang_sense_clarification": "adversative conjunction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不过",
                                "target_lang_sense_clarification": "表示转折，相当于“但是”"
                            },
                            {
                                "target_lang_word": "只是",
                                "target_lang_sense_clarification": "表示轻微转折或补充限制"
                            },
                            {
                                "target_lang_word": "但是",
                                "target_lang_sense_clarification": "最常见的转折连词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5526f5e2-b9db-3992-88ba-3fb9ba1a6ac6",
                    "sense_definition": "Обозначает момент времени, сразу после которого происходит другое действие; в значении «как только», «едва».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conjunction_temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Только> солнце взошло, птицы начали петь.",
                            "target_lang_translations": {
                                "en": "<As soon as> the sun rose, the birds began to sing.",
                                "zh": "<w>一</w>太阳升起来，鸟儿<w>就</w>开始唱歌了。"
                            }
                        },
                        {
                            "text": "<Только> он лёг в кровать, как сразу уснул.",
                            "target_lang_translations": {
                                "en": "<As soon as> he lay down in bed, he immediately fell asleep.",
                                "zh": "他<w>一</w>躺到床上<w>就</w>睡着了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "едва",
                        "лишь"
                    ],
                    "common_phrases": [
                        "как только",
                        "лишь только"
                    ],
                    "target_lang_definitions": {
                        "en": "Denotes a moment in time immediately after which another action occurs; meaning \"as soon as\", \"barely\".",
                        "zh": "表示一个动作刚发生，另一个动作立刻接着发生，相当于“刚一……就……”“一……就……”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as soon as",
                                "target_lang_sense_clarification": "immediately when"
                            },
                            {
                                "target_lang_word": "the moment",
                                "target_lang_sense_clarification": "at the exact time that"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一……就……",
                                "target_lang_sense_clarification": "表示前一动作一发生，后一动作马上发生"
                            },
                            {
                                "target_lang_word": "刚……就……",
                                "target_lang_sense_clarification": "强调“刚一……就……”"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}