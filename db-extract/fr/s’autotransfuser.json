                "senses": [
                    {
                        "sense_id": "5efa3962-3591-3ea6-82ce-e75d11db33ea",
                        "entry_id": "4fab1af5-42b8-3d10-a0b2-aa5637b8a64e",
                        "glosses": [
                            "Se transfuser à soi-même son propre sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5824a8c-b285-40f9-bd7a-e3f22e3ac340",
                                "sense_id": "5efa3962-3591-3ea6-82ce-e75d11db33ea",
                                "text": "Deux solutions pour le rebooster : avoir recours à l'EPO, détectable, ou s'autotransfuser son sang congelé préalablement."
                            },
                            {
                                "example_id": "3c7eac3a-8915-4138-8276-02230d65dd46",
                                "sense_id": "5efa3962-3591-3ea6-82ce-e75d11db33ea",
                                "text": "C'est quand même plus sexy que de se piquer ou de s'autotransfuser, non?"
                            },
                            {
                                "example_id": "52a55718-4c35-413d-a106-d1ba10d73fe4",
                                "sense_id": "5efa3962-3591-3ea6-82ce-e75d11db33ea",
                                "text": "Mais une autre hypothèse existe : il aurait pu s'autotransfuser du sang « souillé » par des produits dopants absorbés auparavant."
                            }
                        ]
                    }
