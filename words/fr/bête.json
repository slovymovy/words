    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61000bab-10cb-3f5c-a7fe-2bbdc00268d9",
                    "sense_definition": "Animal, en particulier tout animal autre que l'être humain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier s'occupe de ses <w>bêtes</w> tous les matins avant l'aube."
                        },
                        {
                            "text": "Cette <w>bête</w> à poils longs dort toute la journée dans le jardin."
                        },
                        {
                            "text": "Ma fille a peur de la petite <w>bête</w> qui court sur le mur."
                        }
                    ],
                    "synonyms": [
                        "animal"
                    ],
                    "common_phrases": [
                        "petite bête",
                        "bête de somme"
                    ]
                },
                {
                    "sense_id": "33ad90d7-0bff-339d-973c-1a844eb39940",
                    "sense_definition": "Animal sauvage, souvent dangereux ou féroce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la forêt, nous avons entendu une <w>bête</w> sauvage rôder près du camp."
                        },
                        {
                            "text": "Le berger a peur que la <w>bête</w> féroce n'attaque ses moutons."
                        }
                    ],
                    "common_phrases": [
                        "bête sauvage",
                        "bête féroce",
                        "bêtes sauvages"
                    ]
                },
                {
                    "sense_id": "91546330-59e8-3430-9140-c258b0f0ee73",
                    "sense_definition": "Personne stupide, qui a peu d'intelligence ou de bon sens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne l'écoute pas, c'est une vraie <w>bête</w> quand il s'agit de conduire."
                        },
                        {
                            "text": "Il se prend pour un génie, mais ce n'est qu'une <w>bête</w>."
                        }
                    ],
                    "synonyms": [
                        "idiot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier, souvent péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "81468518-ee32-377b-8966-4c2b28ebdec4",
                    "sense_definition": "Tout être vivant de la catégorie des animaux, y compris l'être humain, au sens biologique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour un biologiste, l'être humain est aussi une <w>bête</w> parmi les autres."
                        },
                        {
                            "text": "Nous sommes tous des <w>bêtes</w> au sens biologique du terme."
                        }
                    ]
                },
                {
                    "sense_id": "824894c1-7cb9-381c-9f85-c1f6846c8ad6",
                    "sense_definition": "Personne, considérée avec une nuance de familiarité ou de caractère (bon, rusé, etc.).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour Paul, c'est une bonne <w>bête</w> qui ne ferait de mal à personne."
                        },
                        {
                            "text": "Cette vieille tante est une fine <w>bête</w> qui comprend tout très vite."
                        }
                    ],
                    "common_phrases": [
                        "bonne bête",
                        "fine bête"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier"
                        }
                    ]
                },
                {
                    "sense_id": "666c4bb2-5433-3fff-af1e-fef84c13a151",
                    "sense_definition": "Élève ou personne très douée dans une matière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa sœur est une <w>bête</w> en maths, elle a eu vingt sur vingt."
                        },
                        {
                            "text": "Dans notre classe, Léa est une vraie <w>bête</w> en physique."
                        }
                    ],
                    "common_phrases": [
                        "bête en maths"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier"
                        }
                    ]
                },
                {
                    "sense_id": "9c935c0d-d21a-35a2-8d8e-d6163c4bca27",
                    "sense_definition": "Chose quelconque, en particulier un objet imposant ou une machine dont on parle avec familiarité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Venez voir la <w>bête</w> : c'est un vieil ordinateur, mais il fonctionne encore très bien."
                        },
                        {
                            "text": "Le garagiste a sorti la <w>bête</w> du garage pour me montrer la nouvelle moto."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier"
                        }
                    ]
                },
                {
                    "sense_id": "8355337b-6578-3960-a4d4-0a167068a37b",
                    "sense_definition": "Ce qui, chez l'être humain, le rapproche de l'animal : les sens, les passions, les appétits matériels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand la colère monte, la <w>bête</w> reprend le dessus sur la raison."
                        },
                        {
                            "text": "Il lutte contre la <w>bête</w> qui sommeille en lui."
                        }
                    ],
                    "common_phrases": [
                        "bête humaine"
                    ]
                },
                {
                    "sense_id": "5e7525a5-a6b4-37ca-b3b4-2d6f3c601c08",
                    "sense_definition": "Pièce de gibier, animal que l'on poursuit à la chasse, notamment à courre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chiens ont relancé la <w>bête</w> à travers les bois."
                        },
                        {
                            "text": "Après deux heures de poursuite, la <w>bête</w> a donné le change aux chasseurs."
                        }
                    ],
                    "common_phrases": [
                        "relancer la bête"
                    ]
                },
                {
                    "sense_id": "d41b8dab-7a57-3471-9175-1ae2c0aadfd6",
                    "sense_definition": "Animal féroce que, chez les Romains, on faisait combattre dans le cirque.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'Antiquité, les condamnés étaient parfois livrés aux <w>bêtes</w> dans l'arène."
                        },
                        {
                            "text": "Les Romains aimaient assister aux combats de <w>bêtes</w> au cirque."
                        }
                    ],
                    "common_phrases": [
                        "combat de bêtes"
                    ]
                },
                {
                    "sense_id": "1ab64079-3f04-3794-bc22-19fb55cc5d84",
                    "sense_definition": "Jeu de cartes auquel on joue à trois, à quatre ou à cinq personnes.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jeu de cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soir, ils jouaient à la <w>bête</w> autour d'une table avec des cartes."
                        },
                        {
                            "text": "La <w>bête</w> est un ancien jeu de cartes qui se joue à plusieurs."
                        }
                    ],
                    "common_phrases": [
                        "jouer à la bête"
                    ]
                },
                {
                    "sense_id": "ac89b764-13c8-3bb1-9fa7-b01fe7db533e",
                    "sense_definition": "Le mal, le malin, le diable (souvent avec une majuscule).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce texte religieux, la <w>Bête</w> représente le mal qui menace le monde."
                        },
                        {
                            "text": "Certains auteurs annoncent la venue de la <w>Bête</w> à la fin des temps."
                        }
                    ],
                    "common_phrases": [
                        "nombre de la Bête"
                    ]
                },
                {
                    "sense_id": "16278632-4807-3528-94d3-e1ed93f8d111",
                    "sense_definition": "Somme déposée par un joueur qui a perdu un coup, et qui reste au jeu pour être gagnée par celui qui remportera un coup suivant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jeu de cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a perdu le coup et a dû mettre sa <w>bête</w> au jeu."
                        },
                        {
                            "text": "Celui qui gagne le coup suivant tire la <w>bête</w> et ramasse l'argent."
                        }
                    ],
                    "common_phrases": [
                        "tirer la bête",
                        "gagner la bête"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "59bb09bb-f3ff-3399-9d99-785efb50d0f5",
                    "sense_definition": "Stupide, peu intelligent, qui manque de jugement ; se dit aussi d'une conduite, de propos ou de manières sottes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stupidité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce n'est pas très gentil de dire qu'il est <w>bête</w>."
                        },
                        {
                            "text": "J'ai fait une chose vraiment <w>bête</w> : j'ai oublié mes clés."
                        },
                        {
                            "text": "Elle n'est pas <w>bête</w> : elle a tout de suite compris le problème."
                        }
                    ],
                    "synonyms": [
                        "idiot"
                    ],
                    "antonyms": [
