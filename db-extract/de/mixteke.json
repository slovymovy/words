                        "glosses": [
                            "Angehöriger eines indigenen mexikanischen Volks, das seinen Ursprung in der Mixteca-Region hat (heute Teil der Bundesstaaten Oaxaca, Puebla und Guerrero)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddcf5baa-e7dd-4d92-9baf-81c407415575",
                                "sense_id": "514c37a9-b478-318f-bf50-b1aa7345575d",
                                "text": "„So machte sich der Steuermann Gonzalo de Umbria nach Zacatula im heutigen Oaxaca auf, wo die von den Mexica unterworfenen Mixteken lebten, die für ihr Goldhandwerk berühmt waren.“"
                            }
