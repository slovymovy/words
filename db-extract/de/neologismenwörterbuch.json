                "senses": [
                    {
                        "sense_id": "6103d4ca-5e03-34b9-9c33-71cd07ae747e",
                        "entry_id": "7f26ebab-451d-3548-9c9a-cf48939773f5",
                        "glosses": [
                            "Wörterbuch, das neu entstandene Wörter des Wortschatzes einer Sprache auflistet und erklärt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7103d07-b026-4a64-9a35-384550cf580a",
                                "sense_id": "6103d4ca-5e03-34b9-9c33-71cd07ae747e",
                                "text": "„Das Deutsche Neologismenwörterbuch enthält 2 Typen von Einträgen: vollständige Einträge und Verweiseinträge.“"
                            },
                            {
                                "example_id": "4bdbcd10-40f3-4a96-bcad-9f1e3ce56d5f",
                                "sense_id": "6103d4ca-5e03-34b9-9c33-71cd07ae747e",
                                "text": "„Aber trotz des nachweislich großen Informationsbedarfes gibt es bisher für das Deutsche - im Unterschied zu vielen anderen verbreiteten Sprachen - kein genuines, auf Prinzipien der wissenschaftlichen Lexikographie basierendes Neologismenwörterbuch als aktuelle Ergänzung zu den großen Gesamtwörterbüchern.“"
                            },
                            {
                                "example_id": "74e4612a-b1e9-4998-9eef-dc6d78fc793e",
                                "sense_id": "6103d4ca-5e03-34b9-9c33-71cd07ae747e",
                                "text": "„Eine breitere Grundlage haben Neologismenwörterbücher wie Herberg et al. (2004) oder Quasthoff (Hrsg.) (2007).“"
                            },
                            {
                                "example_id": "3867c9e8-3f85-4f6f-9a8f-c638b52d8ee0",
                                "sense_id": "6103d4ca-5e03-34b9-9c33-71cd07ae747e",
                                "text": "„Die im Tiel dieses Aufsatzes genannten Wörter finden sich als Ergebnis solcher korpusbasierten Untersuchungen im Neologismenwörterbuch dieses Projektes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
