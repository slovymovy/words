                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b35706-db92-450b-8760-af7e75f0b851",
                                "sense_id": "c7119da3-7a8c-3f79-993d-2c0f28fa9912",
                                "text": "„Der Einfluss der Heidelberger Wörterbuchforschung war wichtig, weil schon die räumliche Nähe für einen langjährigen und intensiven Austausch der Ideen sorgte.“"
                            },
                            {
                                "example_id": "ffcdaef2-fa93-455e-b1ce-3c13a585fd7a",
                                "sense_id": "c7119da3-7a8c-3f79-993d-2c0f28fa9912",
                                "text": "„Die Wörterbuchforschung kann existierende Wörterbücher beschreiben, klassifizieren, beurteilen.“"
                            },
                            {
                                "example_id": "64d76f2b-3a08-424c-95c9-ac32dfedc36d",
                                "sense_id": "c7119da3-7a8c-3f79-993d-2c0f28fa9912",
                                "text": "„Es sind darauf Teilgebiete zu erkennen, welche auf Grund von Ergebnissen der Wörterbuchforschungen von 1930 und i960 abgegrenzt wurden.“"
                            }
                        ],
