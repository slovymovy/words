    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ff1c17e-4570-377b-be96-689cad43b21f",
                    "sense_definition": "Donner adroitement à entendre quelque chose de manière indirecte ou détournée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Qu'essayez-vous d'<w>insinuer</w> en posant toutes ces questions indiscrètes ?"
                        },
                        {
                            "text": "Il <w>insinue</w> souvent que ses collègues ne méritent pas leur promotion."
                        }
                    ],
                    "synonyms": [
                        "laisser entendre"
                    ],
                    "common_phrases": [
                        "insinuer que"
                    ]
                },
                {
                    "sense_id": "86797c8b-856b-35cd-8f2f-3b5e4c82f9bb",
                    "sense_definition": "Introduire délicatement ou progressivement une chose dans un interstice ou un endroit étroit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien <w>insinue</w> la fine sonde avec une grande précaution."
                        },
                        {
                            "text": "Le chat <w>insinue</w> sa patte sous la porte pour attraper son jouet."
                        }
                    ]
                },
                {
                    "sense_id": "943e1ec5-5615-3d99-8c5d-c6ca1c1e4d7f",
                    "sense_definition": "Pénétrer adroitement ou se faire admettre insensiblement quelque part ou auprès de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet individu a réussi à s'<w>insinuer</w> dans les bonnes grâces du directeur."
                        },
                        {
                            "text": "Un doute persistant commence à s'<w>insinuer</w> dans son esprit malgré ses certitudes."
                        }
                    ]
                },
                {
                    "sense_id": "b21fba59-c3b5-3ec7-acc7-149566d59bb0",
                    "sense_definition": "Enregistrer formellement un acte privé ou une donation dans un registre public pour lui donner valeur légale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire royal devait faire <w>insinuer</w> cette donation avant la fin du mois."
                        },
                        {
                            "text": "L'avocat a fait <w>insinuer</w> l'acte de vente au greffe du tribunal."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Terme juridique sous l'Ancien Régime"
                        }
                    ]
                }
            ]
        }
    ]
