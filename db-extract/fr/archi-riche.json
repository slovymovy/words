                        "glosses": [
                            "Extrêmement riche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4826d7b-2f60-4ffd-a872-72bf5e9854f3",
                                "sense_id": "77576a8b-fa29-3496-9419-18a2b2163560",
                                "text": "Il n’y a qu’à voir la quantité de mariages de stars archi-riches, super belles, gâtées par la vie et confites de certitudes, qui ne passent pas la saison deux."
                            },
                            {
                                "example_id": "e37f0607-aeb0-4370-be0b-a10778fca640",
                                "sense_id": "77576a8b-fa29-3496-9419-18a2b2163560",
                                "text": "Les réfugiés, dit l'homme, ils étaient tous archi-riches avec des voitures de sport et des poules de luxe."
                            },
                            {
                                "example_id": "b07fdd2c-5bae-4d30-9241-5c912f2d0069",
                                "sense_id": "77576a8b-fa29-3496-9419-18a2b2163560",
                                "text": "Mes premiers bouquins autobiographiques, tout comme ma nouvelle Le Triplex, montrent des gens de la « gentry » : ma grand-mère archi-riche, mon oncle Louis, général, etc."
                            }
                        ]
                    }
