                                                "sense_id": "cc66cbab-d32e-3f6c-b9c7-0e3547c3cbad",
                                                "text": "The program loops until the user presses a key."
                                            },
                                            {
                                                "example_id": "a4390f42-3526-4155-9336-94b860bf1094",
                                                "sense_id": "cc66cbab-d32e-3f6c-b9c7-0e3547c3cbad",
                                                "text": "The outstanding Tom Palmer won a line-out and then charged into the heart of the Welsh defence, scrum-half Ben Youngs moved the ball swiftly right and Cueto's looping pass saw Ashton benefit from a huge overlap to again run in untouched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d1f4c5-c801-38bb-8b1e-29d64aef97cb",
                                        "entry_id": "15cfc340-ace0-3259-b037-53913664a410",
                                        "glosses": [
                                            "To place in a loop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a950b9-272c-4f8e-ba86-a4b0b4412f68",
                                                "sense_id": "93d1f4c5-c801-38bb-8b1e-29d64aef97cb",
                                                "text": "It found that trains often looped on their journey emit 14% to 20% more NOx and particulates than non-stop services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975213dc-41e7-3885-b5a5-9a32bb2dbf2f",
                                        "entry_id": "15cfc340-ace0-3259-b037-53913664a410",
                                        "glosses": [
                                            "To have the teacher progress through multiple school years with the same students."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1dca333-c428-4d13-9aa9-c98b8bd0c028",
                                                "sense_id": "975213dc-41e7-3885-b5a5-9a32bb2dbf2f",
                                                "text": "Tolland Middle School in Connecticut where close to four hundred middle school students participated in looping, students from looped classroom structures scored much higher than students from prior years without the looped structure on standardized tests in mathematics and writing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
