                "senses": [
                    {
                        "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                        "entry_id": "840c07c0-7ff7-3e49-91ac-64688bf479c2",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06257b2d-b169-4a1c-af0a-458d8a775d39",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Frau Bärtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "390fdc03-3326-4cc9-bf7e-e309d932a4a4",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Herr Bärtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "920a7bfb-6bf2-43dc-92b6-406597d1dfd1",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Die Bärtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8587aa7f-8512-4750-898f-44f77fd03df2",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Der Bärtle trägt nie die Schals, die die Bärtle ihm strickt."
                            },
                            {
                                "example_id": "9653afc8-0903-4400-a4cc-4e3533d48a93",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bärtle kommt, geht der Herr Bärtle.“"
                            },
                            {
                                "example_id": "6a539f3b-1d32-4441-aad9-0640e5294a50",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Bärtle kommt und geht."
                            },
                            {
                                "example_id": "3c7d44d0-de11-493a-8394-da81a8b55272",
                                "sense_id": "de838e07-87b9-3dc5-aa40-69cb27936975",
                                "text": "Bärtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
