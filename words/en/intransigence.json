                    "sense_id": "2722e512-ee37-37d9-8142-a081d49b6d09",
                    "sense_definition": "Unwillingness to change one's views or to agree; stubborn refusal to compromise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intransigence</w> of both sides frustrated the negotiators who were trying to secure peace.",
                            "target_lang_translations": {
                                "nl": "De <w>onverzettelijkheid</w> van beide kanten frustreerde de onderhandelaars die vrede probeerden te bewerkstelligen."
                            }
                        },
                        {
                            "text": "Talks broke down quickly due to government <w>intransigence</w> over wage demands.",
                            "target_lang_translations": {
                                "nl": "De gesprekken liepen al snel vast door de <w>onbuigzaamheid</w> van de regering met betrekking tot de looneisen."
                            }
                        }
                    ],
                    "synonyms": [
                        "stubbornness",
                        "obstinacy",
                        "inflexibility"
                    ],
                    "antonyms": [
                        "flexibility",
                        "compliance",
                        "compromise"
                    ],
                    "common_phrases": [
                        "political intransigence",
                        "stubborn intransigence"
                    ],
                    "target_lang_definitions": {
                        "nl": "De weigering om van standpunt te veranderen of in te stemmen; koppige weigering om een compromis te sluiten."
                    },
