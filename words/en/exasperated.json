{
    "word_family": [
        "exasperate",
        "exasperation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a94222e2-4c61-3676-b26b-08b3e4caad5e",
                    "sense_definition": "Feeling intense annoyance or frustration due to a lack of patience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She grew <w>exasperated</w> by his constant interruptions during the meeting.",
                            "target_lang_translations": {
                                "cs": "Byla čím dál víc <w>rozčilená</w> z jeho neustálého přerušování během schůzky."
                            }
                        },
                        {
                            "text": "The teacher gave an <w>exasperated</w> sigh when the students refused to listen.",
                            "target_lang_translations": {
                                "cs": "Učitel si <w>rozčileně</w> povzdechl, když studenti odmítali poslouchat."
                            }
                        }
                    ],
                    "synonyms": [
                        "frustrated",
                        "annoyed",
                        "irritated"
                    ],
                    "antonyms": [
                        "calm",
                        "patient"
                    ],
                    "common_phrases": [
                        "look exasperated",
                        "sound exasperated"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit intenzivního podráždění nebo frustrace z nedostatku trpělivosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozčilený",
                                "target_lang_sense_clarification": "vyjadřuje stav podráždění a ztráty trpělivosti"
                            },
                            {
                                "target_lang_word": "zoufale podrážděný",
                                "target_lang_sense_clarification": "zdůrazňuje vysokou míru frustrace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9e252e9-fd93-3413-8502-092427eaeec6",
                    "sense_definition": "Made more intense or severe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>exasperated</w> symptoms of the disease made the patient very uncomfortable.",
                            "target_lang_translations": {
                                "cs": "<w>Zhoršené</w> příznaky nemoci způsobovaly pacientovi velké nepohodlí."
                            }
                        },
                        {
                            "text": "His <w>exasperated</w> condition required immediate medical attention from the doctors.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>vyhrocený</w> stav vyžadoval okamžitou lékařskou pomoc."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggravated",
                        "intensified"
                    ],
                    "antonyms": [
                        "alleviated"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učiněný intenzivnějším nebo závažnějším."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zhoršený",
                                "target_lang_sense_clarification": "ve smyslu stupňování negativního stavu"
                            },
                            {
                                "target_lang_word": "vyhrocený",
                                "target_lang_sense_clarification": "ve smyslu zvýšené intenzity nebo závažnosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72bd7831-b6ef-383f-ab10-e4d98552efe5",
                    "sense_definition": "Past tense and past participle of <w>exasperate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise <w>exasperated</w> everyone in the office all afternoon.",
                            "target_lang_translations": {
                                "cs": "Ten neustálý hluk celé odpoledne všechny v kanceláři <w>rozčiloval</w>."
                            }
                        },
                        {
                            "text": "He has <w>exasperated</w> his parents with his reckless behavior lately.",
                            "target_lang_translations": {
                                "cs": "Svým bezohledným chováním v poslední době své rodiče <w>vytočil</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyed",
                        "frustrated",
                        "irritated"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb exasperate."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa exasperate (rozčílit, vytočit)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozčílil",
                                "target_lang_sense_clarification": "způsobil někomu intenzivní podráždění"
                            },
                            {
                                "target_lang_word": "vytočil",
                                "target_lang_sense_clarification": "hovorový výraz pro vyvedení z míry"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}