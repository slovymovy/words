                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda2134a-4d0c-49ff-8333-ff008c361b7b",
                        "source_entry_id": "825551b9-abf4-385c-ba5f-12462e1ba086",
                        "source_sense_id": "9f3594ab-ea64-3ed2-98cd-1f7277ac6f59",
                        "target_lang_word": "environmental",
