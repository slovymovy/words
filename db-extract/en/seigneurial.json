                            {
                                "example_id": "a46a177e-fbb5-4abf-a1e8-cbfdaf8417e5",
                                "sense_id": "9ddcb914-943d-3243-8b23-447fa5cc22c8",
                                "text": "In April 1768 Carleton had proposed the restoration of the seigneurial militia system."
                            }
                        ]
                    },
                    {
                        "sense_id": "4526c7b2-2b76-3d34-b03b-22521967d29f",
                        "entry_id": "7bdb490a-bbaa-3d92-a8d9-d60bc70eff09",
                        "glosses": [
                            "Befitting a seigneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef20a36-4225-4544-a0de-8bfe367f7089",
                                "sense_id": "4526c7b2-2b76-3d34-b03b-22521967d29f",
                                "text": "She would chat for hours, without thinking anything of it, with the chief of the village on her mother's estate, when he happened to come into town, and talk with him as if he were her equal, without any signs of seigneurial condescension."
                            },
                            {
                                "example_id": "a4f3de94-2e26-448e-8828-de7dd419fbea",
                                "sense_id": "4526c7b2-2b76-3d34-b03b-22521967d29f",
                                "text": "It had a church, just at the junction of the roads, and a fine seigneurial chateau, in a garden, beside the church; otherwise it was a little lonely mean place, built of brick and plaster on a great lonely heap of chalk downland."
                            }
                        ]
                    }
