                "senses": [
                    {
                        "sense_id": "4f7bdb8e-7d80-32fc-88cc-63be4c70fd88",
                        "entry_id": "213ecb08-03a2-38c1-992a-d37c7a50c88c",
                        "glosses": [
                            "Satz, der einen Ausruf wiedergibt und damit die emotionale Beteiligung des Sprechers anzeigt."
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "29fd0d89-23e1-481f-8b79-12ded5a6fba4",
                                "sense_id": "4f7bdb8e-7d80-32fc-88cc-63be4c70fd88",
                                "text": "Der Satz \"Du bist aber groß geworden!\" ist ein Ausrufesatz."
                            },
                            {
                                "example_id": "01f7ef36-bd11-4b81-a710-dfcb3e7fc31b",
                                "sense_id": "4f7bdb8e-7d80-32fc-88cc-63be4c70fd88",
                                "text": "Ausrufesätze werden im Schriftbild mit einem Ausrufezeichen kenntlich gemacht."
                            },
                            {
                                "example_id": "e2c1790b-6f0b-42e5-bd98-4033803bb5e0",
                                "sense_id": "4f7bdb8e-7d80-32fc-88cc-63be4c70fd88",
                                "text": "„Gelegentlich werden ein Fragezeichen und ein Ausrufezeichen gesetzt, um einen Fragesatz gleichzeitig als Ausrufesatz zu kennzeichnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
