                    "sense_id": "8a6ef6d7-462c-3d07-9f85-1fc6f6f2aee9",
                    "sense_definition": "To follow as a model or a pattern; to make a copy, counterpart or semblance of.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young child tried to <w>imitate</w> the way his father walked.",
                            "target_lang_translations": {
                                "tr": "Küçük çocuk, babasının yürüyüşünü <w>taklit etmeye</w> çalıştı."
                            }
                        },
                        {
                            "text": "Many modern buildings <w>imitate</w> the style of ancient Greek architecture.",
                            "target_lang_translations": {
                                "tr": "Birçok modern bina, antik Yunan mimarisinin tarzını <w>taklit eder</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "mimic",
                        "emulate",
                        "reproduce"
                    ],
                    "antonyms": [
                        "create",
                        "innovate"
                    ],
                    "common_phrases": [
                        "imitate the style",
                        "imitate the behavior"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini veya bir şeyi model alarak ona benzemeye çalışmak; bir şeyin benzerini veya kopyasını yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "taklit etmek",
                                "target_lang_sense_clarification": "Birinin davranışlarını, konuşmasını veya bir nesnenin biçimini kopyalamak."
                            },
                            {
                                "target_lang_word": "öykünmek",
                                "target_lang_sense_clarification": "Birine veya bir şeye benzemeye çalışmak, onu örnek alarak benzerini yapmak."
                            },
                            {
                                "target_lang_word": "örnek almak",
                                "target_lang_sense_clarification": "Birinin davranışlarını veya tarzını kendine model olarak benimsemek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
