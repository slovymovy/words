{
    "word_family": [
        "custom",
        "customary",
        "customize",
        "customization",
        "accustom"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1aa9c581-9d53-3c18-93a0-202bbf509f3d",
                    "sense_definition": "A person or company that buys goods or services from a shop or business.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "buyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every person who walks into the store is a potential <w>customer</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый, кто заходит в магазин, — это потенциальный <w>покупатель</w>."
                            }
                        },
                        {
                            "text": "Good <w>customer</w> service is essential for keeping clients happy.",
                            "target_lang_translations": {
                                "ru": "Хорошее <w>клиентское</w> обслуживание необходимо для того, чтобы заказчики оставались довольны."
                            }
                        }
                    ],
                    "synonyms": [
                        "client",
                        "buyer",
                        "purchaser",
                        "shopper",
                        "patron"
                    ],
                    "antonyms": [
                        "seller",
                        "vendor",
                        "merchant",
                        "supplier"
                    ],
                    "common_phrases": [
                        "customer service",
                        "regular customer",
                        "loyal customer",
                        "potential customer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или компания, покупающие товары или услуги у магазина или предприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиент",
                                "target_lang_sense_clarification": "лицо, пользующееся услугами"
                            },
                            {
                                "target_lang_word": "покупатель",
                                "target_lang_sense_clarification": "тот, кто приобретает товар за деньги"
                            },
                            {
                                "target_lang_word": "заказчик",
                                "target_lang_sense_clarification": "лицо, заказывающее выполнение работ или услуг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29235452-968a-303a-b5cd-b648b2b767fc",
                    "sense_definition": "A person of a particular type, especially one who is difficult to deal with or behaves in a specific way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager is a tough <w>customer</w> who expects perfection from everyone.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер — трудный <w>тип</w>, который ожидает совершенства от каждого."
                            }
                        },
                        {
                            "text": "He remained calm during the crisis, proving to be a cool <w>customer</w>.",
                            "target_lang_translations": {
                                "ru": "Он сохранял спокойствие во время кризиса, проявив себя как невозмутимый <w>субъект</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "character",
                        "individual",
                        "fellow"
                    ],
                    "common_phrases": [
                        "tough customer",
                        "cool customer",
                        "tricky customer",
                        "ugly customer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек определенного типа, особенно тот, с кем трудно иметь дело или кто ведет себя специфическим образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "человек с определенными чертами характера"
                            },
                            {
                                "target_lang_word": "субъект",
                                "target_lang_sense_clarification": "ироничное или пренебрежительное обозначение человека"
                            },
                            {
                                "target_lang_word": "фрукт",
                                "target_lang_sense_clarification": "разговорное о странном или неприятном человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e322a5d-912d-3993-9173-d9181780407e",
                    "sense_definition": "An official responsible for collecting customs duties.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>customer</w> inspected the merchant's goods at the port.",
                            "target_lang_translations": {
                                "ru": "<w>Таможенник</w> осмотрел товары купца в порту."
                            }
                        },
                        {
                            "text": "He was appointed as the chief <w>customer</w> to oversee tax collection.",
                            "target_lang_translations": {
                                "ru": "Он был назначен главным <w>сборщиком</w> для надзора за сбором налогов."
                            }
                        }
                    ],
                    "synonyms": [
                        "customs officer",
                        "tax collector"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо, ответственное за сбор таможенных пошлин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таможенник",
                                "target_lang_sense_clarification": "сотрудник таможни"
                            },
                            {
                                "target_lang_word": "сборщик пошлин",
                                "target_lang_sense_clarification": "лицо, взимающее налоги или сборы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}