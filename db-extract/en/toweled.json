                    {
                        "sense_id": "8d7bd9fa-3436-3adf-b94e-ff373509129d",
                        "entry_id": "49217715-93e3-3eb1-bb6d-62acafc0ace5",
                        "glosses": [
                            "Wearing a towel."
                        ],
                        "tags": [
