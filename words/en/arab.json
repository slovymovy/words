                            {
                                "target_lang_word": "阿拉伯马",
                                "target_lang_sense_clarification": "马的品种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb76dc38-6680-3cda-900a-81908f2a86c2",
                    "sense_definition": "One billion (1,000,000,000) in the Indian numbering system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "number_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction project is estimated to cost several <w>arab</w> rupees.",
                            "target_lang_translations": {
                                "ru": "Стоимость строительного проекта оценивается в несколько <w>арабов</w> рупий.",
                                "zh": "该建筑项目预计耗资数十亿卢比。"
                            }
                        },
                        {
                            "text": "In the Indian system, one <w>arab</w> follows ten crores.",
                            "target_lang_translations": {
                                "ru": "В индийской системе счисления один <w>араб</w> следует за десятью крорами.",
                                "zh": "在印度计数系统中，一“arab”紧随十千万（crore）之后。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Indian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Миллиард (1 000 000 000) в индийской системе счисления.",
                        "zh": "印度计数系统中的十亿（1,000,000,000）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ара́б",
                                "target_lang_sense_clarification": "индийская мера исчисления"
                            }
                        ],
                        "zh": []
                    }
                },
                {
                    "sense_id": "8a9865ae-0641-345e-addb-8ad087e6ce3a",
                    "sense_definition": "A homeless or neglected child living on the streets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "street_child_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel depicts the hard life of a street <w>Arab</w> in Victorian London.",
                            "target_lang_translations": {
                                "ru": "В романе описывается тяжелая жизнь <w>уличного мальчишки</w> в викторианском Лондоне.",
                                "zh": "这部小说描绘了维多利亚时代伦敦一名<w>流浪儿</w>的艰苦生活。"
                            }
                        },
                        {
                            "text": "Charities were established to help the poor <w>arabs</w> find shelter and food.",
                            "target_lang_translations": {
                                "ru": "Были созданы благотворительные организации, чтобы помочь бедным <w>беспризорникам</w> найти приют и еду.",
                                "zh": "慈善机构成立的目的是帮助贫困的<w>流浪儿</w>寻找住所和食物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "street Arab"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often offensive or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бездомный или беспризорный ребенок, живущий на улице.",
                        "zh": "生活在街头的无家可归或被忽视的儿童。"
                    },
                    "translations": {
                        "ru": [
