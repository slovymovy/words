                    {
                        "translation_id": "f4337fdf-95d4-47d7-adc1-5fdee88213c8",
                        "source_entry_id": "d0168f99-a62a-3f6b-9ba9-1872051b77cd",
                        "source_sense_id": "d30dfb7d-5f36-3a64-9a58-3f318274cd49",
