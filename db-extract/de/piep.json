                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55f85e9e-0031-381d-a4dc-0d6eef432f67",
