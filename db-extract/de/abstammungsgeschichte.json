                "senses": [
                    {
                        "sense_id": "f85b3676-5155-36fd-acf4-21cd2d22f6ce",
                        "entry_id": "4ac51691-1c5c-375d-b712-7686753ea215",
                        "glosses": [
                            "Entwicklungsgeschichte des gesamten Tier- und Pflanzenreiches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ffb1ddb-6a16-4967-9156-296bc31e3a09",
                                "sense_id": "f85b3676-5155-36fd-acf4-21cd2d22f6ce",
                                "text": "„Heberer konnte in den 1950er- und 1960er-Jahren Wesentliches zur Abstammungsgeschichte des Menschen sowie zur Synthetischen Evolutionstheorie beitragen.“"
                            },
                            {
                                "example_id": "93850d38-0c8d-4cad-8eb2-0ef62ca9ca63",
                                "sense_id": "f85b3676-5155-36fd-acf4-21cd2d22f6ce",
                                "text": "„Trotz derartiger Vorbehalte und Einwände haben sich die alten Abstammungsgeschichten zäh behauptet, und zwar über die Krise des Geschichtsdenkens im 15. Jahrhundert hinaus bis an die Schwelle der Moderne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
