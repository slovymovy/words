                    },
                    {
                        "sense_id": "70e14cbd-d40a-39e7-aa4d-6478681f3668",
                        "entry_id": "93fe99eb-a7b9-3114-86e6-84a25e0bfccf",
                        "glosses": [
                            "страдающий неврастенией; болезненно раздражительный, неуравновешенный"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3203eaa-98a2-3aae-81fe-5c18a1c24cd9",
                        "entry_id": "93fe99eb-a7b9-3114-86e6-84a25e0bfccf",
                        "glosses": [
                            "свойственный тому, кто страдает неврастенией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1446edc2-3c03-4d31-b3ff-ec5034d3bd11",
                                "sense_id": "c3203eaa-98a2-3aae-81fe-5c18a1c24cd9",
                                "text": "Форма невроза не столько истерична, сколько неврастенична; у женщин при этом часто страдает физическое здоровье, появляется, например, анемия со всеми ее последствиями."
                            }
                        ]
                    }
                ],
