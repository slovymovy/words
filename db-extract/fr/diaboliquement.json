                                            {
                                                "example_id": "e8cf5395-4902-4254-99f6-20e87a3bd80c",
                                                "sense_id": "563ad5f4-7faa-3bae-9299-a3d45fcd320c",
                                                "text": "Soms werd Nicolaas door zoveel duivelse Pieten gevolgd, dat die de heilige totaal overheersten."
