                                        "glosses": [
                                            "breed, diep en stromingsarm genoeg om bevaren te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a6cba4-e4ec-4b42-b75a-541887b825e9",
                                                "sense_id": "4b36a3f7-6876-3191-9286-0ac1d29dd3bb",
                                                "text": "Veel rivieren in Europa zijn met allerlei aanpassingen, zoals de aanleg van sluizen, bevaarbaarder gemaakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1abb2799-462a-4431-a32b-45718b3bed44",
                        "source_entry_id": "5efba6c6-1f2d-394d-bd1b-b1261c850d69",
                        "source_sense_description": "for a body of water: sea, river etc.",
                        "target_lang_word": "navigable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navigable",
