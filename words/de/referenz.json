                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein Eigenname wie „Goethe“ hat eine eindeutige <w>Referenz</w>: Er bezeichnet eine ganz bestimmte Person."
