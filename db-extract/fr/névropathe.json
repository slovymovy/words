                        "form": "névropathes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b65e645f-aebe-33ef-b723-6491d4c10739",
                        "entry_id": "98dcb2fe-76fd-3874-8fee-d09e3c16a80f",
                        "glosses": [
                            "Névrosé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb4cc9a-0636-4607-a53a-6f654738cb3a",
                                "sense_id": "b65e645f-aebe-33ef-b723-6491d4c10739",
                                "text": "Un névropathe adulte, qui ne sais pas ce qu'est l’onanisme buccal ou la friquarelle (cela arrive), ne fait jamais mention de ces perversions dans son autoanalyse, quelque loin qu'elle soit poussée."
                            },
                            {
                                "example_id": "c49b126b-3711-457b-abe0-fef659cfb087",
                                "sense_id": "b65e645f-aebe-33ef-b723-6491d4c10739",
                                "text": "Il est clair par exemple qu'il est difficile de faire suivre un régime alimentaire à un névropathe à la table de famille et que cela est plus facile quand il vit séparément."
                            }
                        ]
                    }
                ],
