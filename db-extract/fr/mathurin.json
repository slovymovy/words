                    }
                ],
                "senses": [
                    {
                        "sense_id": "b543ca4f-1cab-3505-a7e2-fb339440ef97",
                        "entry_id": "f016693c-d26c-3b54-a659-fc66b2dfd966",
                        "glosses": [
                            "Religieux de l'ordre des Trinitaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867a6013-7ac8-4fde-8065-ed0759b3991e",
                                "sense_id": "b543ca4f-1cab-3505-a7e2-fb339440ef97",
                                "text": "Ils raillèrent sans pitié les deux prêtres qui envoyaient une armée de frères mathurins à la rédemption des captifs. Les mathurins étaient un ordre spécialement consacré au rachat des prisonniers faits par les corsaires barbaresques."
                            }
                        ]
                    },
                    {
                        "sense_id": "30774935-f28a-3466-8b42-c6b371ddb0c0",
                        "entry_id": "f016693c-d26c-3b54-a659-fc66b2dfd966",
                        "glosses": [
                            "Matelot."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4fcd16b3-3b7a-4315-92d7-5558c901a74b",
                                "sense_id": "30774935-f28a-3466-8b42-c6b371ddb0c0",
                                "text": "Il acheva sa soirée dans l’orgie, en société de vieux mathurins, d’anciens camarades de bord."
                            },
                            {
                                "example_id": "50be0e60-116a-4f4d-80c1-20dc0dd801a7",
                                "sense_id": "30774935-f28a-3466-8b42-c6b371ddb0c0",
                                "text": "Nous autres les troubades nous regardions manoeuvrer les mathurins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a50903d-88b4-419d-9145-6d0fc1b1ce5f",
