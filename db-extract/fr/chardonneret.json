                        "entry_id": "ca0fc7ee-30eb-398e-a3e9-2b39a2e5c08c",
                        "glosses": [
                            "Espèce de petit oiseau passereau vivement coloré qui se nourrissent de graines de chardon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125446df-8066-4881-a55f-f34ab082428e",
                                "sense_id": "8d7e606a-6ae7-3d51-937f-fb369c61e8ba",
                                "text": "Des troupes de linots et de chardonnerets passent incessamment d'un monticule à l'autre, …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c55949b3-846a-430d-a602-ce2f9f9643c5",
                        "source_entry_id": "ca0fc7ee-30eb-398e-a3e9-2b39a2e5c08c",
                        "source_sense_id": "8d7e606a-6ae7-3d51-937f-fb369c61e8ba",
                        "target_lang_word": "Distelfink",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Distelfink",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48703e9c-6e78-302e-9fa9-7f510cd38243",
                                        "entry_id": "ff7fa96b-0618-3fe4-bc8c-fdc537387f59",
                                        "glosses": [
                                            "auffällig gefärbter Singvogel, mit (schnabelwärts) schwarz-weiß-roter Färbung am Kopf und gelber Flügelbinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709f7208-aee2-422f-b7c6-8342ef311a93",
                                                "sense_id": "48703e9c-6e78-302e-9fa9-7f510cd38243",
                                                "text": "Die bei den Distelfinken auffällige Färbung des Kopfes fehlt bei Jungvögeln."
                                            },
                                            {
                                                "example_id": "7572b761-f9f7-4406-8d6a-ef718d06d43c",
                                                "sense_id": "48703e9c-6e78-302e-9fa9-7f510cd38243",
                                                "text": "„Sein Kopf war nahezu perfekt eiförmig, und er blickte aus dem Fenster auf einen Laubbaum mit zwei zwitschernden Distelfinken, als verkörperten sie den Sinn des Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c30ab8d3-ca42-47a3-81af-fec719d9f918",
                        "source_entry_id": "ca0fc7ee-30eb-398e-a3e9-2b39a2e5c08c",
                        "source_sense_id": "8d7e606a-6ae7-3d51-937f-fb369c61e8ba",
                        "target_lang_word": "Stieglitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stieglitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18282055-2f02-3434-ba39-436cd54fc1b0",
                                        "entry_id": "f0a47562-49f9-355c-8dca-ab6a85136516",
                                        "glosses": [
                                            "auffällig gefärbter Singvogel, mit (schnabelwärts) schwarz-weiß-roter Färbung am Kopf und gelber Flügelbinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68506cac-91fd-45d2-a5b1-989b5cb3eb4c",
                                                "sense_id": "18282055-2f02-3434-ba39-436cd54fc1b0",
                                                "text": "Der Stieglitz ist auffallend bunt gefärbt."
                                            },
                                            {
                                                "example_id": "6f663a37-f1c1-4742-ae8b-45cd97f2b149",
                                                "sense_id": "18282055-2f02-3434-ba39-436cd54fc1b0",
                                                "text": "„Der Wirt schmeckt an seiner Plombe, man muß den Stieglitz mehr ans Fenster rücken, solch Tierchen will auch ein bißchen Licht.“"
                                            },
                                            {
                                                "example_id": "1d87d947-9a0f-4383-9e1b-6dd7f19c66f5",
                                                "sense_id": "18282055-2f02-3434-ba39-436cd54fc1b0",
                                                "text": "„Fast jede Familie hatte im Käfig vor dem Fenster einen Stieglitz oder einen Zeisig, um sich an seinem Gesang zu erfreuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
