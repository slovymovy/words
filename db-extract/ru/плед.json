                    }
                ],
                "senses": [
                    {
                        "sense_id": "65fd91d7-4a7c-36fd-9db5-db9ea54d9cbc",
                        "entry_id": "830e99b7-3af8-3d21-904f-b03620ca8c53",
                        "glosses": [
                            "плотное матерчатое (часто — шерстяное или полушерстяное) покрывало, используемое как домашнее тёплое одеяло, тёплый ковёр, дорожное одеяло и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40622143-9402-4af3-8bb7-cee79fec3dcf",
                                "sense_id": "65fd91d7-4a7c-36fd-9db5-db9ea54d9cbc",
                                "text": "(Берет со стула плед.) Вот очень хороший плед, я желаю продавать…"
                            },
                            {
                                "example_id": "300ec388-d7c1-4052-83ca-b5545d799b96",
                                "sense_id": "65fd91d7-4a7c-36fd-9db5-db9ea54d9cbc",
                                "text": "На ней был толстый плед и простенькая шляпка."
                            },
                            {
                                "example_id": "a87eacd6-0d0d-4e6b-8674-ad3e0686466e",
                                "sense_id": "65fd91d7-4a7c-36fd-9db5-db9ea54d9cbc",
                                "text": "Ночью ты должен будешь сторожить, чтобы никто не вошёл в купе, а также поправлять ей плед, которым она покрыта и который сползает у неё ежеминутно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73bf0fec-72ae-4e27-8e67-342423f0fff6",
                        "source_entry_id": "830e99b7-3af8-3d21-904f-b03620ca8c53",
                        "source_sense_id": "65fd91d7-4a7c-36fd-9db5-db9ea54d9cbc",
                        "target_lang_word": "plaid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b919612b-c764-34c1-b74d-cdc1c04683bf",
                                        "entry_id": "0bb82f7b-0fe5-3c0d-866b-7a5dd040e4ea",
                                        "glosses": [
                                            "A type of twilled woollen cloth, often with a tartan or chequered pattern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369117a1-8ae6-4eb9-b3c8-65d55c9c53ed",
                                                "sense_id": "b919612b-c764-34c1-b74d-cdc1c04683bf",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c919dee7-78d3-34d3-a766-62b71d763dbc",
                                        "entry_id": "0bb82f7b-0fe5-3c0d-866b-7a5dd040e4ea",
                                        "glosses": [
                                            "A length of such material used as a piece of clothing, formerly worn in the Scottish Highlands and other parts of northern Britain and remaining as an item of ceremonial dress worn by members of Scottish pipe bands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e242104-6204-40bc-9be3-9ae2253dc629",
                                                "sense_id": "c919dee7-78d3-34d3-a766-62b71d763dbc",
                                                "text": "In battle, the plaid was customarily shrugged off before the charge bit home, and the warrior came into contact with only his long, saffron shirt (‘leine chrochach’) to preserve modesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78e80d1-f7d4-3e6a-b4b7-75e237547297",
                                        "entry_id": "0bb82f7b-0fe5-3c0d-866b-7a5dd040e4ea",
                                        "glosses": [
                                            "The typical chequered pattern of a plaid; tartan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plaid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4adf58c-6673-3ca0-8e7f-102a3b8fecd4",
                                        "entry_id": "950013cd-53e4-3e2c-a0b9-aa2b413a48f5",
                                        "glosses": [
                                            "Having a pattern or colors which resemble a Scottish tartan; checkered or marked with bars or stripes at right angles to one another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plaid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43eeb4ad-7ce1-3bef-a0ad-bc347256f316",
                                        "entry_id": "86f235d7-f2ba-31ec-aa0c-a57bef27e004",
                                        "glosses": [
                                            "simple past and past participle of play"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1c8743-9a34-4233-8de8-4e74bd6ece95",
                                                "sense_id": "43eeb4ad-7ce1-3bef-a0ad-bc347256f316",
                                                "text": "1774, Dr Samuel Johnson, Preface to the Works of the English Poets, J. Nichols, Volume II, Page 134,\n\"...then plaid on the organ, and sung...\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9bfa438-2b1f-4090-8d6a-694f388c6a54",
                        "source_entry_id": "830e99b7-3af8-3d21-904f-b03620ca8c53",
                        "source_sense_id": "65fd91d7-4a7c-36fd-9db5-db9ea54d9cbc",
                        "target_lang_word": "plaid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03809925-2d0f-374b-b9be-d2e33e0d4c46",
                                        "entry_id": "30f2d207-964d-3389-b8af-aa16118d5caa",
                                        "glosses": [
                                            "Procès, assemblée ou juridiction du Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a59d56-f416-4db7-ba38-8f40f350ddf9",
                                                "sense_id": "03809925-2d0f-374b-b9be-d2e33e0d4c46",
                                                "text": "Au-dessous encore existaient d’autres assemblées : celles des vicaires, des centeniers ; que dis-je, les moindres bénéficiers, les intendants des fermes royales, tenaient des plaids comme les comtes."
                                            },
                                            {
                                                "example_id": "10ee0e68-c394-4e29-852e-189b5077d1b2",
                                                "sense_id": "03809925-2d0f-374b-b9be-d2e33e0d4c46",
                                                "text": "En discorde (discordia) avec eux à cause de terres et d'autres biens qu'ils leur avaient injustement enlevés, ils se sont rendus au plaid (placitum) à Laizé en présence du cellérier et du doyen de ce lieu. Là, ils ont abandonné leur injustice (calumpnia)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plaid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "699277ac-0f0f-3e4a-9999-e7be28e1ecd6",
                                        "entry_id": "be24cd2f-e3f2-312c-a532-19db7ed7b14c",
                                        "glosses": [
                                            "Motifs de carreaux écossais aux couleurs vives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95ee26da-1ee1-3b35-8fe4-50e3e65ec5f3",
                                        "entry_id": "be24cd2f-e3f2-312c-a532-19db7ed7b14c",
                                        "glosses": [
                                            "Couverture en laine qui sert de manteau aux montagnards écossais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e02cd090-a63c-4dc7-ab52-4eeddfed0a69",
                                                "sense_id": "95ee26da-1ee1-3b35-8fe4-50e3e65ec5f3",
                                                "text": "Evans prend possession de l'unique lit et s'y fourre entre deux édredons, tandis que je monte mon lit de voyage et m'y enroule dans mon plaid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd66db1f-fb7a-38b1-8f94-f4dfaad4af90",
                                        "entry_id": "be24cd2f-e3f2-312c-a532-19db7ed7b14c",
                                        "glosses": [
                                            "Petite couverture épaisse que l'on étend sur le sol ou que l'on place sur ses jambes pour se réchauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374e3c01-38bd-404d-a42a-dbf4067eb30f",
                                                "sense_id": "cd66db1f-fb7a-38b1-8f94-f4dfaad4af90",
                                                "text": "Mes parents […] prirent l’habitude de me laisser aller promener sans eux du côté de Méséglise, enveloppé dans un grand plaid qui me protégeait contre la pluie."
                                            },
                                            {
                                                "example_id": "8819d475-93d3-46aa-ae2c-c9678d7d4a90",
                                                "sense_id": "cd66db1f-fb7a-38b1-8f94-f4dfaad4af90",
                                                "text": "Godefroy d’Étigues avait apporté, plié sur son épaule, un long plaid. Avec une brutalité rageuse, il en couvrit la tête de la jeune femme et lui plaqua la main contre la bouche pour étouffer ses cris."
                                            },
                                            {
                                                "example_id": "832dc5f6-07f8-425f-8be3-7b2cd10f8472",
                                                "sense_id": "cd66db1f-fb7a-38b1-8f94-f4dfaad4af90",
                                                "text": "À la vue du plaid fleuri qui recouvre sa couche, et qu'elle a assorti aux rideaux et à sa robe de chambre, je réalise soudain le sens de l’expression « border l'insomniaque », de même que l'importance du Viagra dans une vie de couple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
