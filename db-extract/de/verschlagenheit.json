                    {
                        "form_id": "7b809e20-5c0b-47ea-9474-3b3290cdf063",
                        "entry_id": "fe2530a3-d306-37f0-b5eb-47b00ed5875a",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Verschlagenheit"
                    },
                    {
                        "form_id": "95290726-c098-48e3-8dc7-f73d7665f111",
                        "entry_id": "fe2530a3-d306-37f0-b5eb-47b00ed5875a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Verschlagenheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9ba1f50-485a-351c-824f-0774d8b8f23f",
                        "entry_id": "fe2530a3-d306-37f0-b5eb-47b00ed5875a",
                        "glosses": [
                            "hinterhältiges Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba3c6bfe-6bea-4e04-a2c3-b0ba114e5742",
                                "sense_id": "e9ba1f50-485a-351c-824f-0774d8b8f23f",
                                "text": "„Umsichtig bis zur Verschlagenheit tritt er seinem Naturell entgegen.“"
                            },
                            {
                                "example_id": "443b9b53-4cc9-45a5-8dfb-f1a29b3e8241",
                                "sense_id": "e9ba1f50-485a-351c-824f-0774d8b8f23f",
                                "text": "„Über diese diplomatische Verschlagenheit mußte ich fast lächeln.“"
                            },
                            {
                                "example_id": "28e01862-0095-49ae-b792-e1ad8753d093",
                                "sense_id": "e9ba1f50-485a-351c-824f-0774d8b8f23f",
                                "text": "„Mit jener Verschlagenheit, über die sonst nur Liebende verfügen, war es uns gelungen, für eine kurze Zeit allein zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3e02e75-7669-4f84-9f4f-40fa82405294",
                        "source_entry_id": "fe2530a3-d306-37f0-b5eb-47b00ed5875a",
                        "source_sense_id": "e9ba1f50-485a-351c-824f-0774d8b8f23f",
                        "source_sense_description": "hinterhältiges Verhalten",
                        "target_lang_word": "cunning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cunning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91af8e9b-8361-3017-9d2d-c360e01badc8",
                                        "entry_id": "17f391a5-4ebd-3975-ab14-17f2d2787957",
                                        "glosses": [
                                            "Sly; crafty; clever in surreptitious behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc1878b-a255-4603-9e00-e1ddc31a1fc4",
                                                "sense_id": "91af8e9b-8361-3017-9d2d-c360e01badc8",
                                                "text": "They are resolved to be cunning; let others run the hazard of being sincere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a3e64f-b0fc-304e-8ea3-939d11c34b76",
                                        "entry_id": "17f391a5-4ebd-3975-ab14-17f2d2787957",
                                        "glosses": [
                                            "Skillful, artful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cf4d924-0dea-4d35-beaa-304dc7b01699",
                                                "sense_id": "c3a3e64f-b0fc-304e-8ea3-939d11c34b76",
                                                "text": "Esau was a cunning hunter."
                                            },
                                            {
                                                "example_id": "4c8ffebd-47eb-4610-a35e-1b0149ef6711",
                                                "sense_id": "c3a3e64f-b0fc-304e-8ea3-939d11c34b76",
                                                "text": "a cunning workman"
                                            },
                                            {
                                                "example_id": "c409365c-b9e8-4ebe-9943-44aec8cec0cd",
                                                "sense_id": "c3a3e64f-b0fc-304e-8ea3-939d11c34b76",
                                                "text": "Tis beauty truly blent, whose red and white / Nature's own sweet and cunning hand laid on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a519622-2b38-309b-bcb9-ea69867ee5e2",
                                        "entry_id": "17f391a5-4ebd-3975-ab14-17f2d2787957",
                                        "glosses": [
                                            "Wrought with, or exhibiting, skill or ingenuity; ingenious."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dcdd112-aad6-4ec1-a61a-78aa6cee6a20",
                                                "sense_id": "3a519622-2b38-309b-bcb9-ea69867ee5e2",
                                                "text": "cunning work"
                                            },
                                            {
                                                "example_id": "dd640020-6ecc-41c6-be2f-de6dc54b26b8",
                                                "sense_id": "3a519622-2b38-309b-bcb9-ea69867ee5e2",
                                                "text": "Over them Arachne high did lift / Her cunning web."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe5f02e-a5fe-34a2-abf8-3f4ebb5630f9",
                                        "entry_id": "17f391a5-4ebd-3975-ab14-17f2d2787957",
                                        "glosses": [
                                            "Cute, appealing."
                                        ],
                                        "tags": [
                                            "Maine",
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e5a646d-9376-4b20-85ba-2ae5fce377bb",
                                                "sense_id": "6fe5f02e-a5fe-34a2-abf8-3f4ebb5630f9",
                                                "text": "everybody gives something to the cunning little boy; his eyes are large and soft, and he wears a pointed hat, and tight breeches, and jacket"
                                            },
                                            {
                                                "example_id": "e8050b26-f2a3-4f38-876d-564d6040a717",
                                                "sense_id": "6fe5f02e-a5fe-34a2-abf8-3f4ebb5630f9",
                                                "text": "“I shan't mind that at all, I like the little house 'cause it's got a garden, and there's a cunning room with a three-cornered closet in it that I always wanted.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cunning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77eb93c3-fa61-35dd-b8c9-fcddcb11e3a6",
                                        "entry_id": "7ced25e8-2ecb-3aa0-adf1-00cc2d535a34",
                                        "glosses": [
                                            "Practical knowledge or experience; aptitude in performance; skill, proficiency; dexterity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91503756-30ad-460a-a48b-553dc79afb9d",
                                                "sense_id": "77eb93c3-fa61-35dd-b8c9-fcddcb11e3a6",
                                                "text": "indeed at this very moment he's slipped away with the utmost cunning into a form that's most perplexing to investigate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592e59cd-9fc4-3ac3-af5d-3699b190e330",
                                        "entry_id": "7ced25e8-2ecb-3aa0-adf1-00cc2d535a34",
                                        "glosses": [
                                            "Practical skill employed in a secret or crafty manner; craft; artifice; skillful deceit; art or magic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74af8197-a1c8-41c5-8583-817cdb985343",
                                                "sense_id": "592e59cd-9fc4-3ac3-af5d-3699b190e330",
                                                "text": "Caliban: As I told thee before, I am subject to a tyrant, a sorcerer that by his cunning hath cheated me of the island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26348d26-8188-3a74-9dbe-94a83fab217a",
                                        "entry_id": "7ced25e8-2ecb-3aa0-adf1-00cc2d535a34",
                                        "glosses": [
                                            "The disposition to employ one's skill in an artful manner; craftiness; guile; artifice; skill of being cunning, sly, conniving, or deceitful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28cf169c-d89b-33d2-b03e-c473e3e3fe97",
                                        "entry_id": "7ced25e8-2ecb-3aa0-adf1-00cc2d535a34",
                                        "glosses": [
                                            "The natural wit or instincts of an animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a877982a-2b5b-46f6-998f-3b477b6b9713",
                                                "sense_id": "28cf169c-d89b-33d2-b03e-c473e3e3fe97",
                                                "text": "the cunning of the fox or hare"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef47618-b13e-34b5-889a-ca50250a697d",
                                        "entry_id": "7ced25e8-2ecb-3aa0-adf1-00cc2d535a34",
                                        "glosses": [
