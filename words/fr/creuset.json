            "senses": [
                {
                    "sense_id": "ce2d675e-8ba2-3cf0-82f1-f51abf2ff620",
                    "sense_definition": "Lieu ou milieu où se mêlent et s'assimilent des cultures, des idées ou des personnes diverses pour former une réalité nouvelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande ville cosmopolite est devenue un véritable <w>creuset</w> de cultures et d'influences artistiques."
                        },
                        {
                            "text": "L'université a servi de <w>creuset</w> aux mouvements intellectuels de toute une génération."
                        }
                    ],
                    "synonyms": [
                        "foyer",
                        "melting-pot"
                    ],
                    "common_phrases": [
                        "creuset culturel",
                        "creuset des cultures",
                        "véritable creuset"
                    ]
                },
                {
                    "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                    "sense_definition": "Récipient constitué d'un matériau très résistant à la chaleur, utilisé pour fondre ou calciner des métaux et d'autres substances.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan dépose soigneusement les morceaux d'or dans un <w>creuset</w> avant d'allumer le fourneau."
                        },
                        {
                            "text": "Le métal en fusion est versé avec précaution hors du <w>creuset</w> dans un moule."
                        }
                    ],
                    "common_phrases": [
                        "creuset de fonderie"
                    ]
                }
            ]
        }
