                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stößel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3191f301-a3f7-3410-ba1b-da0a73e60832",
                                        "entry_id": "dbb3a0b2-f754-3a39-82bf-f69505105b3e",
                                        "glosses": [
                                            "stabartiges Gerät zum Verkleinern/Zerstoßen oder Zerreiben von Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "055c36ff-f9e0-4d8e-9d96-ce1a29d4ba6a",
                                                "sense_id": "3191f301-a3f7-3410-ba1b-da0a73e60832",
                                                "text": "„Ihre Muskeln treten an ihren sehnigen Oberarmen hervor, bevor sie den Stößel, der fast so groß wie sie selbst ist, mit voller Wucht in den grob behauenen, hölzernen Mörser donnern lässt.“"
                                            }
                                        ],
