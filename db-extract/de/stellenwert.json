                    {
                        "form_id": "5e5a1d61-7eaf-4161-ba49-19ed12ba3549",
                        "entry_id": "5973c731-1957-3ec9-a056-c740b4f5896e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stellenwerte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                        "entry_id": "5973c731-1957-3ec9-a056-c740b4f5896e",
                        "glosses": [
                            "die Wichtigkeit, die jemandem zuerkannt wird innerhalb einer Gruppe; die Wichtigkeit, die etwas beigemessen wird in einer Ordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b87566-79d6-4f9e-b8c3-f08cdce6e435",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "Ein gutes Aussehen besitzt für sie einen hohen Stellenwert."
                            },
                            {
                                "example_id": "14329cdc-8543-4f79-bf4a-0912914ea27c",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "Sein Stellenwert ist in seiner Abteilung im letzten Jahr gesunken."
                            },
                            {
                                "example_id": "1d004432-b97c-42fc-89f8-e6e4ebeab1d6",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "Senioren als „Werbesubjekte“, als Zielgruppe, sind sehr wichtig geworden, sie haben einen großen Stellenwert bekommen."
                            },
                            {
                                "example_id": "ab603a4f-b4b7-4eb8-85b4-fe3ed8248f49",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "Vor gut einem Jahr begannen die Kundgebungen der Bürgerbewegung [Pulse of Europe]. Sie zeigten eindrucksvoll, welchen Stellenwert die EU noch in der Bevölkerung besitzt."
                            },
                            {
                                "example_id": "74011827-9f7c-4073-91c7-97911b19c38e",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "In China ist der Vorgang des Kopierens nicht unbedingt etwas Schlechtes. Urheberrecht und kreative Originalität haben dort nicht immer den gleichen Stellenwert wie bei uns."
                            },
                            {
                                "example_id": "bc4ffe0b-a6ff-4cce-99e1-fcbb0c01d9d6",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "Es gab eine Zeit, da hatte Jazz aus Frankfurt am Main einen äußerst wichtigen Stellenwert in der deutschen Musiklandschaft."
                            },
                            {
                                "example_id": "8289672d-90b9-4e40-ad4a-570e07bbe971",
                                "sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                                "text": "Ich glaube, dass es heute so viele Möglichkeiten gibt, auch jenseits der Erwerbsarbeit ein erfülltes Leben zu führen, dass der Stellenwert, den die Erwerbsarbeit für den Menschen hat, geringer geworden ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ffaeea67-8d21-3823-80e8-059dd9ca415a",
                        "entry_id": "5973c731-1957-3ec9-a056-c740b4f5896e",
                        "glosses": [
                            "Wert einer Ziffer, die sich aus Ihrer Position in einer Ziffernfolge (beispielsweise einer natürlichen Zahl oder einer Potenz) ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d589ff8b-0617-488c-95a4-496276bc7204",
                                "sense_id": "ffaeea67-8d21-3823-80e8-059dd9ca415a",
                                "text": "„In Kapitel 2 haben Sie den Stellenwert von ganzen Zahlen kennengelernt. Tabelle 11.1 beispielsweise zeigt, wie die ganze Zahl 4.672 im Hinblick auf die Stellenwerte zerlegt werden kann. Diese Zahl bedeutet 4.000 + 600 + 70 + 2.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "583133eb-14a6-44d3-a565-62227e1514fe",
                        "source_entry_id": "5973c731-1957-3ec9-a056-c740b4f5896e",
                        "source_sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                        "target_lang_word": "significance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "significance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                                        "entry_id": "0ba44ab8-c847-3212-b5cf-09ca3f1680df",
                                        "glosses": [
                                            "The extent to which something matters; importance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4cc102-1bc4-4af9-bc07-0cecb6d3285c",
                                                "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                                                "text": "As a juror your opinion is of great significance for the outcome of the trial."
                                            },
                                            {
                                                "example_id": "1c0c165b-f6c7-44ef-ad96-b782111068fe",
                                                "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                                                "text": "Of more significance in the nature of branch development; in the Jubulaceae, as in the Porellaceae, branches are acroscopic and normally replace a ventral leaf lobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a30bd58-5833-33b5-9cb1-70882f2d3657",
                                        "entry_id": "0ba44ab8-c847-3212-b5cf-09ca3f1680df",
                                        "glosses": [
                                            "Meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f10599e5-b82c-4e24-9957-acc10a4ba684",
                                                "sense_id": "8a30bd58-5833-33b5-9cb1-70882f2d3657",
                                                "text": "the significance of a gesture"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0eb46cd-2b98-4085-a6d4-11108b3d4906",
                        "source_entry_id": "5973c731-1957-3ec9-a056-c740b4f5896e",
                        "source_sense_id": "0855fe7a-284b-32e0-873a-34083a0cb54d",
                        "target_lang_word": "importance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Ce qui fait qu’une chose est d’un grand intérêt, est considérable par elle-même, ou par les circonstances qui l’accompagnent, ou par les suites qu’elle peut avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ec89a5-6978-4702-8610-0eb28c279b30",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu'il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu'il voyait guillotiner après quelque défaite, sous l'inculpation de manquement à leur devoir ; […]."
                                            },
                                            {
                                                "example_id": "df590c33-9cdc-4c3c-8ce9-898c2d6e25ae",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Le proviseur adjoint l'écoute poliment et acquiesce à ses suggestions, le valorise et lui donne de l’importance. Je ne sais pas s'il est sincère."
                                            },
                                            {
                                                "example_id": "e3234a8c-305f-4e4e-9afb-7d6d524d4dc1",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "En toutes choses, il est d’une grande importance de bien commencer."
                                            },
                                            {
                                                "example_id": "c06d4a81-e537-4cc1-b9a7-bec914fad1e5",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Mettre, attacher de l’importance à une chose, La considérer comme ayant beaucoup d’importance."
                                            },
                                            {
                                                "example_id": "25fa5f74-a8b6-41c1-b63b-c68520904943",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Il attache de l’importance aux plus petites choses."
                                            },
                                            {
                                                "example_id": "f7534012-1314-4075-8e61-1159382feb76",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Je n’attache pas d’importance à ma tenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Caractère de ce qui est considérable en nombre, en quantité, en volume, en dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813ba44c-a468-4281-945e-74c701100853",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "Les mauvaises herbes sont pour l'agriculture de tous les pays un fléau dont il est malaisé de chiffrer l’importance."
                                            },
                                            {
                                                "example_id": "311e751e-8136-4933-9516-39780f60153e",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "Les seuls marchés qui aient conservé quelque importance sont ceux de Formerie, de Gournay et de Songeons. Le premier dépasse de beaucoup tous les autres, même celui de Gournay."
                                            },
                                            {
                                                "example_id": "30bd58cf-f4e2-4d48-bd49-cc4b472553c1",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "L’importance de la diffusion à Paris explique en partie la faiblesse des invendus, qui atteignent environ 20-22 % des exemplaires fournis aux NMPP, et par conséquent la facilité des réglages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Autorité, crédit, influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b618ffd-724f-4b8b-b040-269f8509888d",
                                                "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                                "text": "Ils pensent en effet que le luxe vestimentaire est proportionnel à l'importance et à la renommée d'un individu : […]."
                                            },
                                            {
                                                "example_id": "d396d107-54ec-4c5b-8dee-91a2166d4387",
                                                "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                                "text": "Cette place lui donne beaucoup d’importance dans le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Caractère de ceux qui montrent de l’orgueil, de la vanité et veulent paraître plus considérables qu’ils ne le sont réellement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0b8be5-bbbe-464f-9349-153ad65fda25",
                                                "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                                "text": "Prendre un ton d’importance."
                                            },
                                            {
                                                "example_id": "a6a00c1b-d426-4262-8f7a-5000f5e2cb1f",
                                                "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                                "text": "Il se donne des airs d’importance qui choquent tout le monde."
                                            }
