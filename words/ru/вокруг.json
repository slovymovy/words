{
    "word_family": [
        "круг",
        "кругом",
        "окружать",
        "окружение",
        "круглый"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "02a571cd-15db-32e5-9e8d-75dca41a2750",
                    "sense_definition": "Употребляется при указании на нахождение или движение со всех сторон от кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся семья собралась вечером <w>вокруг</w> большого стола.",
                            "target_lang_translations": {
                                "en": "The whole family gathered in the evening <w>around</w> the big table.",
                                "zh": "傍晚，全家人聚在了一张大桌子<w>周围</w>。"
                            }
                        },
                        {
                            "text": "Земля постоянно вращается <w>вокруг</w> своей оси.",
                            "target_lang_translations": {
                                "en": "The Earth constantly rotates <w>around</w> its axis.",
                                "zh": "地球一直在<w>围绕</w>地轴自转。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вокруг света",
                        "вокруг дома",
                        "вокруг оси",
                        "ходить вокруг да около"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate location or movement on all sides of someone or something.",
                        "zh": "表示在某人或某物四周的位置或运动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "around",
                                "target_lang_sense_clarification": "surrounding or on all sides of"
                            },
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "circling or surrounding"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "围绕",
                                "target_lang_sense_clarification": "表示在某物四周"
                            },
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "表示在某物四周"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c761bffd-d4a2-33bf-983d-871d605f8c41",
                    "sense_definition": "Со всех сторон; в окружающем пространстве.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я посмотрел <w>вокруг</w>, но никого не увидел.",
                            "target_lang_translations": {
                                "en": "I looked <w>around</w>, but saw no one.",
                                "zh": "我向<w>四周</w>看了看，但没看见任何人。"
                            }
                        },
                        {
                            "text": "В лесу было тихо, и всё <w>вокруг</w> спало.",
                            "target_lang_translations": {
                                "en": "It was quiet in the forest, and everything <w>around</w> was asleep.",
                                "zh": "森林里很安静，一切<w>周围</w>的事物都在沉睡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кругом"
                    ],
                    "common_phrases": [
                        "посмотреть вокруг",
                        "оглянуться вокруг",
                        "всё вокруг"
                    ],
                    "target_lang_definitions": {
                        "en": "On all sides; in the surrounding space.",
                        "zh": "在四周；在周围的空间里。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "around",
                                "target_lang_sense_clarification": "in the surrounding area"
                            },
                            {
                                "target_lang_word": "round",
                                "target_lang_sense_clarification": "on all sides"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "四周",
                                "target_lang_sense_clarification": "指周围的空间"
                            },
                            {
                                "target_lang_word": "周围",
                                "target_lang_sense_clarification": "指周围的环境"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}