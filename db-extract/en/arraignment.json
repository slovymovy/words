                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "74fb8286-c7fb-4f9c-9cfa-ebe8924a3435",
                        "entry_id": "e6d220f8-d9fd-36af-bf47-5b14f577cdda",
                        "tags": [
                            "plural"
                        ],
                        "form": "arraignments"
