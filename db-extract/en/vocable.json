            {
                "entry_id": "b5379535-870f-3bc3-bea2-1fcc6818c5b6",
                "word": "vocable",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7157a5c4-e21c-4c1d-8dd0-140b76c095e4",
                        "entry_id": "b5379535-870f-3bc3-bea2-1fcc6818c5b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "vocables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5eabe4b6-f6c8-36d2-9ebd-5d0b7035cd35",
                        "entry_id": "b5379535-870f-3bc3-bea2-1fcc6818c5b6",
                        "glosses": [
                            "A word or utterance, especially with reference to its form rather than its meaning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0927ad8-7811-47fc-a6b0-5cb0b66426c4",
                                "sense_id": "5eabe4b6-f6c8-36d2-9ebd-5d0b7035cd35",
                                "text": "Without words and almost with the seriousness of asylum nurses they at once set upon an unsavoury-looking matron who began to cry out Mediterranean vocables of distress."
                            },
                            {
                                "example_id": "dc06265e-7f53-4b8e-8ddc-9b14e98f3db4",
                                "sense_id": "5eabe4b6-f6c8-36d2-9ebd-5d0b7035cd35",
                                "text": "At first the man puzzled; then he smiled. He pronounced a string of uncouth vocables."
                            }
                        ]
                    },
                    {
                        "sense_id": "8307a29e-8ab3-33bd-a224-14574ca8824f",
                        "entry_id": "b5379535-870f-3bc3-bea2-1fcc6818c5b6",
                        "glosses": [
                            "A syllable or sound without specific meaning, used together with or in place of actual words in a song."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30af4651-abb6-48d7-9e78-0fe1305f8c86",
                                "sense_id": "8307a29e-8ab3-33bd-a224-14574ca8824f",
                                "text": "Many Native American songs employ vocables, syllables that do not have referential meaning. These may be used to frame words or may be inserted among them; in some cases, they constitute the entire song text."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f5904a3-e759-4aaf-931e-27d6b45d73f4",
                        "source_entry_id": "b5379535-870f-3bc3-bea2-1fcc6818c5b6",
                        "source_sense_description": "linguistics: word or utterance",
                        "target_lang_word": "Vokabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vokabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51b06bb2-1a06-3166-ae65-77877507c060",
                                        "entry_id": "24b6d48c-6b13-3e0e-8954-a10dcc293093",
                                        "glosses": [
                                            "Wort einer (Fremd-)Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03eb0e55-4774-4fd7-82de-1e8b30f4f01d",
                                                "sense_id": "51b06bb2-1a06-3166-ae65-77877507c060",
                                                "text": "Ich muss für morgen noch ein paar Vokabeln lernen."
                                            },
                                            {
                                                "example_id": "c31001d6-de0a-425a-b3a4-337e59549af4",
                                                "sense_id": "51b06bb2-1a06-3166-ae65-77877507c060",
                                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                                            },
                                            {
                                                "example_id": "fc084372-5953-443a-a720-1102dcf1e3a5",
                                                "sense_id": "51b06bb2-1a06-3166-ae65-77877507c060",
                                                "text": "„Jeden Tag entdeckt er vergessene Vokabeln wieder.“"
                                            },
                                            {
                                                "example_id": "52aae350-a48c-4deb-bb74-baa247fbd8af",
                                                "sense_id": "51b06bb2-1a06-3166-ae65-77877507c060",
                                                "text": "„In den Schulferien sammelt er sie, liest die Stellen, über die er sich Notizen machte, noch einmal durch, ordnet die Zettel, auf die er sich meistens englische und französische Vokabeln, Satzkonstruktionen, Wendungen notiert hat und deren Bedeutung sich für ihn erst erklärt, wenn sie ihm zwei- oder dreimal begegnet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8c51d60-7e25-4b91-936d-41061f212172",
