    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                "word": "iPhone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1dc9ff1f-e7fb-41de-a7ec-b37e44b31852",
                        "entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                        "tags": [
                            "plural"
                        ],
                        "form": "iPhones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                        "entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                        "glosses": [
                            "A smartphone of a series produced by Apple, which typically combine a camera phone, PDA, multimedia player, and wireless communication device."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e271412f-8f0a-4876-821a-94570ba95b64",
                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                "text": "His mom bought him an IPhone for his 11th birthday."
                            },
                            {
                                "example_id": "7580ec00-63b5-4ec7-ac2f-bfa8c7013518",
                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                "text": "This concept puts the curve back on the iPhone 5 with a silhouette that's reminiscent of a banana phone."
                            },
                            {
                                "example_id": "25a0fbb1-8895-4f70-a4a5-d2860d25c7a2",
                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                "text": "Apple is rolling out the public beta of iOS 14 and iPadOS 14 on Thursday. We have a full (and lengthy) preview guide on both operating systems here, and now we’re breaking down how to get the public beta on your iPhone or iPad."
                            },
                            {
                                "example_id": "ab5a4eee-6b76-4a7b-aeb0-8ae27f89c7df",
                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                "text": "“This is before everyone had [geographic information system] mapping, before iPads, iPhones, laptops, Google,” he says. “This is doing research way back with a hammer and a chisel.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "548434b9-0b45-35b1-8202-9986fb497e76",
                        "entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                        "glosses": [
                            "Any knockoff or similar high-end smartphone; through trademark genericization."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56d3efb2-8153-4cc3-ac2f-11a13c66b5ef",
                        "source_entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
