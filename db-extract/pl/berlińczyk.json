                                        "glosses": [
                                            "Personne originaire de Berlin, ou y vivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb5aef9-d4ab-4ceb-9747-48a56f48e5a3",
                                                "sense_id": "9781c798-2d4b-3a94-a786-3864d73534d4",
                                                "text": "Je suis entré ce soir au café « Sturm ». Les Berlinois de la Société ne fréquentent jamais ce dancing vulgaire où la jeunesse brune et les « sous-offs » de la garnison fraternisent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1c513d6-4d29-49cf-97c0-ae789cdda6cb",
