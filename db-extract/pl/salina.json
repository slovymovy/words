                                "target_senses": [
                                    {
                                        "sense_id": "7294a1c6-6ad0-3b56-8444-86174df406d8",
                                        "entry_id": "7f36421b-6040-38e8-925b-ab7661f5b082",
                                        "glosses": [
                                            "Lieu où l’on fabrique ou conserve le sel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e076e3-30be-43e9-bd26-7d89f5b3e7a5",
                                                "sense_id": "7294a1c6-6ad0-3b56-8444-86174df406d8",
                                                "text": "Les Salins du midi exploitent: […]\n— dans l'est, à Varangéville (Meurthe-et-Moselle), une importante saline d'une capacité annuelle de 625 000 tonnes de sel ignigène, ainsi qu'une mine de sel gemme dont la capacité annuelle d'extraction est de 600 000 tonnes ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e137c1-3103-359b-ae23-a84bc91f75b6",
                                        "entry_id": "7f36421b-6040-38e8-925b-ab7661f5b082",
                                        "glosses": [
                                            "Mines de sel gemme."
                                        ],
                                        "tags": [
                                            "Saliculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77bec0af-0d6b-4af5-84a4-2d7541cbc3f9",
                                                "sense_id": "39e137c1-3103-359b-ae23-a84bc91f75b6",
                                                "text": "L'ouverture du trafic transisthmique offrira de nouveaux débouchés au bétail de Choluteca, ainsi qu'au sel qu'on ne tardera pas à produire dans les salines de cette même région."
                                            },
                                            {
                                                "example_id": "2716c99b-1ef7-4cbe-adf7-54d248ab5d4d",
                                                "sense_id": "39e137c1-3103-359b-ae23-a84bc91f75b6",
                                                "text": "Quant aux anciennes salines qui semblent présenter la rigidité de l'asphalte, et sonnent dur sous le talon, elles cèdent parfois sous le poids de roues. La blanche croûte de sel crève, alors, sur la puanteur d'un marais noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12cfc890-40e1-3854-a976-4f50b221436e",
                                        "entry_id": "7f36421b-6040-38e8-925b-ab7661f5b082",
                                        "glosses": [
                                            "Lieu où l'on sale le poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3304d374-0d17-3faf-8635-b6f9eddc813a",
                                        "entry_id": "7f36421b-6040-38e8-925b-ab7661f5b082",
                                        "glosses": [
                                            "Appât pour la chasse composé principalement de sel, surtout pour l'orignal."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a251c91-bd87-4ab9-b755-66c1e229b2bf",
                                                "sense_id": "3304d374-0d17-3faf-8635-b6f9eddc813a",
                                                "text": "Il y aura aussi des gens qui offrent des produits de chasse comme Pro Expédition pour les salines, sans oublier les différents conférenciers qui seront là pour informer les gens."
                                            }
                                        ]
                                    }
                                ]
