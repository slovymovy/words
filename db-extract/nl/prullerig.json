                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc368614-9eba-3320-9e1f-4227d555335a",
                                        "entry_id": "c336f0b8-f3e1-310a-be79-e7561aeab9c7",
                                        "glosses": [
                                            "Having no flavour; bland; insipid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd12bd1-527e-43e3-8c18-60c007e56ab5",
                                                "sense_id": "bc368614-9eba-3320-9e1f-4227d555335a",
                                                "text": "Near-synonym: untasteable"
                                            },
                                            {
                                                "example_id": "4c1c6454-e18f-4186-87dc-7cac80c1bac9",
                                                "sense_id": "bc368614-9eba-3320-9e1f-4227d555335a",
                                                "text": "They accused the cook of being a hack, claiming that the soup was tasteless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496ccd27-1ea6-3dcd-a427-69decc21851e",
                                        "entry_id": "c336f0b8-f3e1-310a-be79-e7561aeab9c7",
                                        "glosses": [
                                            "Lacking delicacy, refinement, and good taste; unbecoming; crass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d07997-60d5-410c-98ce-ffa627a05821",
                                                "sense_id": "496ccd27-1ea6-3dcd-a427-69decc21851e",
                                                "text": "They accused the designer of being a tasteless hack."
                                            },
                                            {
                                                "example_id": "4f7a43e3-fd94-47fc-a150-1cf662b5c7fb",
                                                "sense_id": "496ccd27-1ea6-3dcd-a427-69decc21851e",
                                                "text": "That was a rather tasteless attack on the designer, especially given that many people like the design."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e810484-0b6e-4ef6-9cf2-a4219c902c38",
                        "source_entry_id": "fe4953d6-25d8-3aa1-b905-07224e7ad69f",
                        "source_sense_id": "01008ad9-a8da-373f-b727-d299590a6d33",
                        "source_sense_description": "smakeloos",
                        "target_lang_word": "gimcrack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gimcrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f136494-ec5b-39bd-b65b-f08c619bc147",
                                        "entry_id": "385829ca-97ce-3aaf-bbdf-8f86fdf006fd",
                                        "glosses": [
                                            "Showy but of poor quality; worthless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc0116d0-3995-4cfc-81eb-a4b005f6a6b2",
                                                "sense_id": "7f136494-ec5b-39bd-b65b-f08c619bc147",
                                                "text": "For years past this branch of art-manufacture had been entrusted to those whose taste, if it may be called taste at all, can be no more referred to correct principles of design than the gimcrack decorations of a wedding-cake could be tested by any standard of sculpturesque beauty."
                                            },
                                            {
                                                "example_id": "d0b96797-5f19-4c4a-a5dc-41ff32faac7a",
                                                "sense_id": "7f136494-ec5b-39bd-b65b-f08c619bc147",
                                                "text": "It was cocking her up with gimcrack notions about ladies till she'd be ashamed to look at her own hands after she had done a day's work with them."
                                            },
                                            {
                                                "example_id": "167f44c2-fc32-4d68-8815-5a8e253b561e",
                                                "sense_id": "7f136494-ec5b-39bd-b65b-f08c619bc147",
                                                "text": "'The Rape of the Lock' was 'gimcrack,' if you care to call it so; but it was a delicate brilliant work; and so, I repeat, was Maltby's 'Ariel'."
                                            },
                                            {
                                                "example_id": "be8765fe-739c-4a8c-9558-680a576e178e",
                                                "sense_id": "7f136494-ec5b-39bd-b65b-f08c619bc147",
                                                "text": "“He scribbled something on a message pad, tore, folded, gave” and “ ‘G-Gay?’ puzzled Bev” are fair examples of Mr. Burgess’s gimcrack contortions."
                                            },
                                            {
                                                "example_id": "6a44e83d-dd34-4f47-a263-6cf9407c3836",
                                                "sense_id": "7f136494-ec5b-39bd-b65b-f08c619bc147",
                                                "text": "The movie burnishes the image of this visionary C.E.O. [Steve Jobs] even as it tries to peek behind the curtain at the gimcrack machinery of omnipotence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gimcrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07f14d93-fe8f-36a9-91ce-3ee69b4ccb6d",
                                        "entry_id": "b98578df-5f1e-3a15-8ecd-3aeb86c93373",
                                        "glosses": [
                                            "Something showy but worthless; a bauble or gimmick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c67fbb5-7190-4345-a121-026b12b981b4",
                                                "sense_id": "07f14d93-fe8f-36a9-91ce-3ee69b4ccb6d",
                                                "text": "Any little absurd gewgaw or gimcrack they had they disposed in such a way as to make it attract attention most readily."
                                            },
                                            {
                                                "example_id": "c491d75d-1af0-4c6d-b4b5-a48ee1da3580",
                                                "sense_id": "07f14d93-fe8f-36a9-91ce-3ee69b4ccb6d",
                                                "text": "[H]er miſlike of my Dreſs confirms me, this muſt be ſome levvd London Gimcrack, ſome Play-houſe haunting Couſin; […]"
                                            },
                                            {
                                                "example_id": "8ecdb7b5-75f8-4ba6-a29f-8c5ff3d7bd02",
                                                "sense_id": "07f14d93-fe8f-36a9-91ce-3ee69b4ccb6d",
                                                "text": "[…] he came home to find […] honest Swartz in her favourite amber-coloured satin, with turquoise bracelets, countless rings, flowers, feathers, and all sorts of tags and gimcracks, about as elegantly decorated as a she chimney-sweep on May-day."
                                            },
                                            {
                                                "example_id": "b286db09-71a2-480b-abb0-56fd71e53a3f",
                                                "sense_id": "07f14d93-fe8f-36a9-91ce-3ee69b4ccb6d",
                                                "text": "We finds the place after awhile, a lodgin'-house all lorn and loony, set down all by itself in the middle o' some real estate extension like a tepee in a 'barren'—a crazy 'modern' house all gimcrack and woodwork and frostin', with never another place in so far as you could hear a coyote yelp."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gimcrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8933d82b-e4c7-3551-94cf-2bcda2cf9734",
                                        "entry_id": "38262495-9f4b-308a-9c6f-1569827ec52e",
                                        "glosses": [
                                            "To put together quickly and without much care; to bodge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc1c7fbb-e1da-4ad6-947d-04594e5a78cc",
                                                "sense_id": "8933d82b-e4c7-3551-94cf-2bcda2cf9734",
                                                "text": "Actually the book is a series of related images (some fresh and sharp) and fragmentary sketches (a few vividly effective), gimcracked together with a semblance of plot and allegory,"
                                            },
                                            {
                                                "example_id": "0e702f5f-4f72-4bb7-b772-206c0be80027",
                                                "sense_id": "8933d82b-e4c7-3551-94cf-2bcda2cf9734",
                                                "text": "That page, written fifteen years before by Land Recorder Frederic Prigg, was an imprecise description of land without benefit of any survey, and was more eyeball than ciphers, with measures gimcracked together by a claimant and a recorder who barely understood each other."
                                            },
                                            {
                                                "example_id": "bc2c8c22-bc7b-4b0b-8d6d-9708e19f575a",
                                                "sense_id": "8933d82b-e4c7-3551-94cf-2bcda2cf9734",
                                                "text": "He led only a handful of record dates and some of these were gimcracked round a desire to feature the bass as a solo instrument, often rather artificially so."
                                            },
                                            {
                                                "example_id": "f4c74c0d-8ec9-4b90-919f-491f6a8760df",
                                                "sense_id": "8933d82b-e4c7-3551-94cf-2bcda2cf9734",
                                                "text": "I wos gimcracked right inta the middle o' these murders like a puppet on a string an' I'm the one ta wrap that string around the puppetmaster's neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75625dc9-2383-312b-86bc-35f58d807fbc",
                                        "entry_id": "38262495-9f4b-308a-9c6f-1569827ec52e",
                                        "glosses": [
                                            "To embellish with gimcracks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b6284c-b9df-4162-93b2-8ff0954c90a6",
                                                "sense_id": "75625dc9-2383-312b-86bc-35f58d807fbc",
                                                "text": "Furthermore many of the peripheral characters and myths that the Disney interests have appropriated over the years have been gimcracked to death, so that they have none of their original integrity ."
                                            },
                                            {
                                                "example_id": "5d1fe16e-9399-47fc-8b8f-07e86e67b21c",
                                                "sense_id": "75625dc9-2383-312b-86bc-35f58d807fbc",
                                                "text": "It was a small café, gimcracked with atmosphere, the usual red-checkered tablecloths, and candles dribbling down the sides of old wine bottles."
                                            },
                                            {
                                                "example_id": "1700eb9b-219b-4ed2-9da4-4f89d6569486",
                                                "sense_id": "75625dc9-2383-312b-86bc-35f58d807fbc",
                                                "text": "Merle the Pearl, Juicy Fruit, Latigo, Slippery Will Carothers and Star Fontaine, this gimcracked stripper who had no qualms about taking her dentures out at the bar—they were all still there, mechanically drinking like toy dipping birds in the Blue Curaçao gloom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
