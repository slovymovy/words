{
    "word_family": [
        "enseignant",
        "enseignement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeaac71b-c37c-3e32-8672-348d3d6792c8",
                    "sense_definition": "Transmettre des connaissances, une matière ou une discipline à des élèves.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transmission_savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>enseigne</w> les mathématiques dans un lycée de quartier depuis dix ans."
                        },
                        {
                            "text": "Elle adore <w>enseigner</w> le français à des étudiants étrangers venus du monde entier."
                        }
                    ],
                    "synonyms": [
                        "apprendre"
                    ],
                    "common_phrases": [
                        "enseigner le français",
                        "enseigner les mathématiques"
                    ]
                },
                {
                    "sense_id": "74c6894d-b781-3903-8ee6-b141489f6c78",
                    "sense_definition": "Inculquer des principes moraux ou faire comprendre une vérité par l'expérience.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents essaient d'<w>enseigner</w> les valeurs de partage et de solidarité à leurs enfants."
                        },
                        {
                            "text": "Cette difficile épreuve lui a <w>enseigné</w> la patience et la prudence face aux imprévus."
                        }
                    ],
                    "common_phrases": [
                        "enseigner les valeurs",
                        "enseigner la tolérance"
                    ]
                },
                {
                    "sense_id": "4a02dcc3-fb6b-3d22-8b5e-880d1fbab5db",
                    "sense_definition": "Former intellectuellement des personnes ou un groupe d'individus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "instruire_personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe s'était donné pour mission d'<w>enseigner</w> la jeunesse de sa cité."
                        },
                        {
                            "text": "Dans cette région isolée, l'instituteur devait d'abord <w>enseigner</w> les enfants les plus démunis."
                        }
                    ],
                    "synonyms": [
                        "instruire"
                    ],
                    "common_phrases": [
                        "enseigner la jeunesse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "tournure avec la personne comme complément d'objet direct"
                        }
                    ]
                },
                {
                    "sense_id": "5e316da1-0b7e-3504-be21-bbebdaf84a72",
                    "sense_definition": "Indiquer ou faire connaître une direction ou un chemin à quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indiquer_chemin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un passant aimable voulut bien nous <w>enseigner</w> le chemin pour rejoindre la gare."
                        },
                        {
                            "text": "Pourriez-vous m'<w>enseigner</w> la route à suivre pour arriver avant la tombée de la nuit ?"
                        }
                    ],
                    "common_phrases": [
                        "enseigner le chemin"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "au sens d'indiquer une direction"
                        }
                    ]
                }
            ]
        }
    ]
}