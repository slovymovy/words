                "senses": [
                    {
                        "sense_id": "469bc822-1c37-3971-8af6-f7c74f63d909",
                        "entry_id": "317d3e9e-9d32-3dfe-abd2-acb00304aea7",
                        "glosses": [
                            "Qui n’a pas été conquis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb586cae-bf45-417f-83d3-560b3de9e5af",
                                "sense_id": "469bc822-1c37-3971-8af6-f7c74f63d909",
                                "text": "C’est un pays inconquis, malgré toutes les attaques qu’il a subies."
                            },
                            {
                                "example_id": "b427bb27-56e1-41ab-a605-48ecf525d02c",
                                "sense_id": "469bc822-1c37-3971-8af6-f7c74f63d909",
                                "text": "La vie reculait et sur le front la bataille ne faisait plus rage. D’en face, les cellules malades avançaient au pas de charge et déposaient sur chaque organe le drapeau rouge de la victoire. Quand les terres inconquises ne seraient plus que quelques lopins au milieu d’un paysage d’os déjà putréfiés, ma conscience s’éteindrait d’elle-même."
                            }
                        ]
                    }
                ],
