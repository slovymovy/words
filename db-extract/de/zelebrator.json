                ],
                "senses": [
                    {
                        "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                        "entry_id": "1414fc32-1316-33f7-9e59-bc7ec19f08ba",
                        "glosses": [
                            "mit besonderem Nachdruck oder mit Hingabe Handelnder; Vollzieher einer sakra(menta)len Handlung"
                        ],
                        "tags": [
                            "auch in religiösem Zusammenhang"
                        ],
                        "examples": [
                            {
                                "example_id": "88e539fd-bcec-479f-a12a-50dec4310b70",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Er war der Meister der Langsamkeit, der Zelebrator des 360-Grad-Schwenks, der Weltmeister der Plansequenz.“"
                            },
                            {
                                "example_id": "ca8852f1-c266-4edd-9094-5c91ab34b53d",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Er war zudem ein überzeugter Europäer, ein Zelebrator der gemeinsamen europäischen Kultur, die er dem ,rechten' und blutigen Nationalismus, den er tief verabscheute, entgegensetzte.“"
                            },
                            {
                                "example_id": "a8c5757e-680b-4370-a0a2-949cad98c080",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Frankfurt, das international vor allem als eben Hort von DM und Paulskirche geschätzt wird und den ureigentlichen Zelebrator des Made in Germany verkörpert, ist der Durchlauferhitzer dieser Valuta.“"
                            },
                            {
                                "example_id": "b358ae97-d050-420e-8291-a25362fec6ed",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Wie schaffe ich es dann als Unterrichtsdirigentln, mich zwischen Karajan (dem effektheischenden Zelebrator seiner Kunst) und Bernstein (dem geduldigen Führer durch Sachkompetenz) hindurch zu lavieren?“"
                            },
                            {
                                "example_id": "ce6ba913-3f78-4acf-a41f-86195cb0a7b9",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Er, gewohnter Zelebrator bricht ein.“"
                            },
                            {
                                "example_id": "03d02cbe-1abb-423e-8dcf-406e5efbec81",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Unerwähnt hingegen bleibt der Bischof als Zelebrator der Messe, wohingegen dem Abt von St- Denis eine entscheidende Rolle im zeremoniellen Verlauf zugeschrieben wird.“"
                            },
                            {
                                "example_id": "8f405db3-7a0f-48e1-8bfb-175342f8fd38",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Auf diesen Polster knieen Se königl, Majestät niedet und empfangen von dem Zelebrator die Kommunion.“"
                            },
                            {
                                "example_id": "60300e31-4e14-4b1e-82d4-30e19fe18cbd",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Prior und Subprior forderten zum Kircheneintritt auf, im Kirchenschiff ließ sich der Zelebrator mit Assistenten nieder, im Chorgestühl der Konvent.“"
                            },
                            {
                                "example_id": "ff3597bd-eb05-4848-8279-a7475ea2d464",
                                "sense_id": "20825fe5-a59b-3dbf-acd5-b301960f0393",
                                "text": "„Ebenso wird, trotz aller Anlässe, die nicht heruntergespielt werden dürfen, die Problematik der Redensart deutlich, der Priester werde zum bloßen „Zelebrator“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
