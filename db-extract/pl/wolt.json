                "senses": [
                    {
                        "sense_id": "e14d2e16-062d-3393-9f6f-649bed90cdfa",
                        "entry_id": "6204276c-bff0-339c-8981-2ea33c928638",
                        "glosses": [
                            "jednostka potencjału elektrycznego, napięcia elektrycznego i siły elektromotorycznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c661792-d372-424e-a83c-d2b9c847f03b",
                                "sense_id": "e14d2e16-062d-3393-9f6f-649bed90cdfa",
                                "text": "Jeden elektronowolt jest to energia, jaką uzyskuje elektron, który jest przyspieszany napięciem równym jednemu woltowi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44068b47-7149-4e21-99ae-e9aa60e897cb",
                        "source_entry_id": "6204276c-bff0-339c-8981-2ea33c928638",
                        "source_sense_id": "e14d2e16-062d-3393-9f6f-649bed90cdfa",
                        "target_lang_word": "volt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dcfb588-b9a9-38a1-8cd6-a62a9bce89d1",
                                        "entry_id": "15598e2f-ce6e-3d4e-aea2-1df603f92d99",
                                        "glosses": [
                                            "In the International System of Units, the derived unit of electrical potential and electromotive force (voltage); the potential difference across a conductor when a current of one ampere uses one watt of power. Symbol: V"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df3c2130-736a-4a92-8b69-0393745991cd",
                                                "sense_id": "5dcfb588-b9a9-38a1-8cd6-a62a9bce89d1",
                                                "text": "If the volt, ampere and ohm were taken as the absolute units, the practical units would be the ampere, begohm and begavolt, names just as convenient as ampere, coulomb and farad."
                                            },
                                            {
                                                "example_id": "5b2ca395-1e7b-4246-ad05-b1a5808e6f92",
                                                "sense_id": "5dcfb588-b9a9-38a1-8cd6-a62a9bce89d1",
                                                "text": "The system voltage is 630 volts d.c. and the supply to the trains is by top-contact third rail with running rail return."
                                            },
                                            {
                                                "example_id": "ba55d041-0ab0-46f9-a895-ff39284d4aa4",
                                                "sense_id": "5dcfb588-b9a9-38a1-8cd6-a62a9bce89d1",
                                                "text": "Each turbogenerator consisted of a steam turbine, powered by 900 psi of superheated steam, that was coupled by a set of reduction gears to a General Electric marine alternating-current generator operating at 1,800 rpm. Each generator had a capacity of 2,000 kilowatts of three-phase power at 450 volts and 60 hertz. The main 450-volt switchboard was energized by the two turbogenerators. The emergency switchboard, in the emergency generator room, was fed from the main switchboard through an electrical tie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "volt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a541b04a-814e-3518-a1e6-c6e46400d7e9",
                                        "entry_id": "35b00136-5754-3cfe-8681-99244256008e",
                                        "glosses": [
                                            "A circular movement in which the horse goes round in a small circle."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
