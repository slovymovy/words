                                        "entry_id": "9982e9d8-b696-3053-80e7-9f2e142f5a18",
                                        "glosses": [
                                            "Liste des fautes d’impression d’un ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de745b9-30d8-412f-9c01-4c5ee358433f",
                                                "sense_id": "73564ffd-e5a4-36b1-a17f-c06e5f698e2e",
                                                "text": "Il a fait un errata fort exact."
                                            },
                                            {
                                                "example_id": "e5b1ebb1-4300-474c-b407-7726448dc3ae",
                                                "sense_id": "73564ffd-e5a4-36b1-a17f-c06e5f698e2e",
                                                "text": "On trouvera l’errata à la fin du volume."
                                            },
                                            {
                                                "example_id": "c216deb2-1f50-4053-97cd-361cb19e0eb6",
                                                "sense_id": "73564ffd-e5a4-36b1-a17f-c06e5f698e2e",
                                                "text": "— Par distraction, si vous voulez, répliqua le major en insistant, et vous en serez quitte pour faire quelques errata à votre prochaine édition."
                                            },
                                            {
                                                "example_id": "85e4b9b4-6c9a-4ec7-8f24-26f055c8f446",
                                                "sense_id": "73564ffd-e5a4-36b1-a17f-c06e5f698e2e",
                                                "text": "Je lui ai tendu ensuite un assez long post-scriptum détaché, qui est une liste des errata relevés par lui dans mon livre."
                                            }
                                        ]
                                    }
                                ]
