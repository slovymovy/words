                "senses": [
                    {
                        "sense_id": "cd3922e4-467e-3d76-abd9-bb3aa2b3a9c1",
                        "entry_id": "c952d489-871e-35aa-b86f-9b68fd8f6c86",
                        "glosses": [
                            "Totémiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e47c7a-b7d9-4589-9b2e-9d4cd28674c5",
                                "sense_id": "cd3922e4-467e-3d76-abd9-bb3aa2b3a9c1",
                                "text": "Si tu veux faire de la pédagogie forte, ce ne serait pas plus simple de prendre avec toi quelques amis sachems normaux, et d'aller retotémiser les sachems déviants, histoire de leur montrer ce que c'est que la tot' ?"
                            },
                            {
                                "example_id": "d94ce6a5-f7c6-4c68-9daf-b4bdb0d1409c",
                                "sense_id": "cd3922e4-467e-3d76-abd9-bb3aa2b3a9c1",
                                "text": "Ou alors tu te fais retotémiser Wipsy, comme Wipsy est un animal qui n'existe pas, tu pourras prendre les bandelettes que tu veux, au nombre que tu veux, en respectant toutefois les conditions ci-dessus."
                            }
                        ]
                    }
