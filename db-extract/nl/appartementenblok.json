                        "examples": [
                            {
                                "example_id": "a3014ed2-9af3-4dd6-86ef-3113ecf0e67b",
                                "sense_id": "4d3c6133-2347-35d5-8e23-59c3d5f0b5e2",
                                "text": "Vorig jaar november werd de 24-jarige Itzik Amsalem begraven. Hij was een van de drie slachtoffers van de Palestijnse raket die insloeg in een appartementenblok in de Israëlische plaats Kyriat Malachi."
                            },
                            {
                                "example_id": "1e0f4f87-2e42-4073-81c0-9cee9d2ea77b",
                                "sense_id": "4d3c6133-2347-35d5-8e23-59c3d5f0b5e2",
                                "text": "Twee maanden geleden was er weer een lawine, die een heel appartementenblok losrukte en een paar meter verderop neerzette."
                            }
                        ]
                    }
