                                                "example_id": "a276ddfe-6583-4572-bd4c-090533edea54",
                                                "sense_id": "f9b385f9-426b-3a67-9239-2f9a3eb7ed0a",
                                                "text": "„Archaische Bilder hält das Malaysia des 21. Jahrhunderts noch jede Menge parat.“"
