                "senses": [
                    {
                        "sense_id": "e7158a78-db6a-30ea-89cb-7621ec554c70",
                        "entry_id": "90bc9ca6-94a4-328b-8b46-8afff1368d36",
                        "glosses": [
                            "geheel van gronden die samen als landbouwbedrijf worden geëxploiteerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52dbec2b-8e3e-4b03-96a0-1b81a1588411",
                                "sense_id": "e7158a78-db6a-30ea-89cb-7621ec554c70",
                                "text": "In Cannibals All (1857) stelde de zuidelijke apologeet George Fitzhugh het koloniale leven gelijk aan het leven op een grote plantage. Aangezien het zo is dat een agrarische samenleving zich in veel opzichten gedraagt als een gezin, kan zo'n notie met evenveel recht worden toegepast op zowel de tropische kolonie als de zuidelijke landerij."
                            },
                            {
                                "example_id": "e97b5311-e7e2-4320-988f-c289067979d7",
                                "sense_id": "e7158a78-db6a-30ea-89cb-7621ec554c70",
                                "text": "Het werd Columbus zelfs verboden de Indianen in slavernij weg te voeren. Wel mocht hij hen tot ‘lijfeigenen’, levenslang aan een landerij gebonden arbeiders, maken."
                            },
                            {
                                "example_id": "3099b10a-5164-46eb-9a86-ac9e2cdf945c",
                                "sense_id": "e7158a78-db6a-30ea-89cb-7621ec554c70",
                                "text": "Het is nutteloos een enkele landerij te saneren en de erosie op de omliggende percelen van andere eigenaars te laten voortgaan."
                            }
                        ]
                    }
                ],
