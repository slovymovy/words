                        "examples": [
                            {
                                "example_id": "b19d445a-638d-4a25-961e-f563f31b268d",
                                "sense_id": "06a4b7a6-a3a1-302e-96a6-c42f291af507",
                                "text": "On y voit une femme s’autoflageller publiquement, selon les rituels convenus de la wokitude."
                            },
                            {
                                "example_id": "47d2ab8b-18e6-40d3-8352-e6a7d763937a",
                                "sense_id": "06a4b7a6-a3a1-302e-96a6-c42f291af507",
                                "text": "Un couple d’Argentins, en provenance de Dubaï, s’autoflagelle, mais juste un peu."
                            },
                            {
                                "example_id": "22101000-e26e-4200-a482-095fa38d6bc4",
                                "sense_id": "06a4b7a6-a3a1-302e-96a6-c42f291af507",
                                "text": "Parfois, quand je suis seule, j’ai tendance à m’autoflageller, parce que je doute et je crains de ne pas y arriver."
                            }
                        ]
                    }
