                    {
                        "translation_id": "67aed97e-57d0-4dab-8d5f-3f1365ba45af",
                        "source_entry_id": "7350f073-0f15-33c6-a646-bdd3490b630f",
                        "source_sense_id": "a8aa127d-ae77-3bb6-aad6-e34810efab6e",
                        "source_sense_description": "een pot, meestal uit kunststof of eertijds geëmailleerd ijzer, waar men zijn behoefte in kan doen",
                        "target_lang_word": "Nachttopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachttopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10edecc7-e0f9-3ce8-b151-13643769af49",
                                        "entry_id": "430d5990-b527-3a4d-91d8-370f74593c80",
                                        "glosses": [
                                            "Behältnis für Kot, Urin und Erbrochenes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a8a8a1-b67f-4d92-8674-d21fe52286a9",
                                                "sense_id": "10edecc7-e0f9-3ce8-b151-13643769af49",
                                                "text": "Früher stand in jedem Schlafzimmer ein Nachttopf."
                                            },
                                            {
                                                "example_id": "57f0a168-f2e8-422d-bcef-2be1800e218a",
                                                "sense_id": "10edecc7-e0f9-3ce8-b151-13643769af49",
                                                "text": "„Unsere Zimmer hatten ein Bett mit einem Nachttopf darunter und einen Nachttisch mit einer Bibel.“"
                                            },
                                            {
                                                "example_id": "63020e02-2753-4cc2-9d90-142ee7c3debd",
                                                "sense_id": "10edecc7-e0f9-3ce8-b151-13643769af49",
                                                "text": "„In vielen Zimmern schliefen sogar zwei, drei Leute, und die Dienstmädchen hatten genug zu tun mit dem Leeren der Nachttöpfe und dem Auffüllen der Waschkrüge und dem heißen Wasser für die Rasur der Männer.“"
                                            },
                                            {
                                                "example_id": "351e048f-d43a-4614-898b-1cb31c3b41fb",
                                                "sense_id": "10edecc7-e0f9-3ce8-b151-13643769af49",
                                                "text": "„Sicher hatte er genau den Nachttopf vor Augen, den wir geteilt hatten, bis meine erste Regel einsetzte.“"
                                            },
                                            {
                                                "example_id": "b049fc27-6dae-41b6-85b0-d44428866c15",
                                                "sense_id": "10edecc7-e0f9-3ce8-b151-13643769af49",
                                                "text": "„Wir arbeiteten in Sechsergruppen, buddelten und reichten die Erde in unseren Nachttöpfen hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
