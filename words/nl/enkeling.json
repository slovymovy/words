                    "sense_id": "c525afe5-bbb6-340a-b94b-bd48f338f127",
                    "sense_definition": "één individu of één persoon",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "individu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wetgever moet rekening houden met de rechten van een <w>enkeling</w> binnen de maatschappij.",
                            "target_lang_translations": {
                                "en": "The legislator must take into account the rights of an <w>individual</w> within society."
                            }
                        },
                        {
                            "text": "In deze grote stad voelt een <w>enkeling</w> zich soms verloren tussen de massa.",
                            "target_lang_translations": {
                                "en": "In this big city, an <w>individual</w> sometimes feels lost among the masses."
                            }
                        }
                    ],
                    "synonyms": [
                        "individu"
                    ],
                    "common_phrases": [
                        "rechten van een enkeling"
                    ],
                    "target_lang_definitions": {
                        "en": "a single individual or person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "individual",
                                "target_lang_sense_clarification": "a person considered alone rather than as part of a group"
                            },
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "a human being"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "533a9c57-7b7f-3e62-b748-0f924723359a",
                    "sense_definition": "een klein aantal personen of slechts een paar mensen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meestal is het niet gevaarlijk maar een <w>enkeling</w> kan wel ernstig ziek worden.",
                            "target_lang_translations": {
                                "en": "Usually it is not dangerous, but <w>a few</w> can become seriously ill."
                            }
                        },
                        {
                            "text": "Slechts een <w>enkeling</w> wist de moeilijke puzzel binnen de tijd op te lossen.",
                            "target_lang_translations": {
                                "en": "Only <w>a few</w> managed to solve the difficult puzzle within the time limit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slechts een enkeling"
                    ],
                    "target_lang_definitions": {
                        "en": "a small number of people or just a few individuals"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a few",
                                "target_lang_sense_clarification": "a small number of people"
                            },
                            {
                                "target_lang_word": "the odd one",
                                "target_lang_sense_clarification": "an occasional person among a larger group"
                            },
                            {
                                "target_lang_word": "handful",
                                "target_lang_sense_clarification": "a very small number of people"
                            }
                        ]
                    }
                }
            ]
        }
    ]
