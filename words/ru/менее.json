{
    "word_family": [
        "мало",
        "маленький",
        "малый",
        "меньшинство",
        "уменьшить",
        "преуменьшить",
        "малость"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7aae7080-29c6-387c-91ed-d9ad1456b293",
                    "sense_definition": "Служит для образования аналитической формы сравнительной степени прилагательных и наречий; обозначает меньшую интенсивность признака.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparative_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот вариант решения проблемы кажется мне <менее> удачным.",
                            "target_lang_translations": {
                                "en": "This solution to the problem seems <less> successful to me.",
                                "zh": "我觉得这个解决问题的方案<w>较不</w>理想。"
                            }
                        },
                        {
                            "text": "Постарайтесь вести себя <менее> шумно в библиотеке.",
                            "target_lang_translations": {
                                "en": "Try to behave <less> noisily in the library.",
                                "zh": "在图书馆里请尽量<w>没那么</w>吵闹。"
                            }
                        }
                    ],
                    "antonyms": [
                        "более"
                    ],
                    "common_phrases": [
                        "менее всего",
                        "менее важно",
                        "менее известный",
                        "менее интересно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to form the comparative degree of adjectives and adverbs, indicating a lower intensity of a quality.",
                        "zh": "用于构成形容词和副词的比较级，表示程度较低。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "less",
                                "target_lang_sense_clarification": "comparative marker"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "较不",
                                "target_lang_sense_clarification": "用于形容词或副词前，表示程度较低"
                            },
                            {
                                "target_lang_word": "没那么",
                                "target_lang_sense_clarification": "口语中表示程度不及某标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db631b26-9bb2-3681-8794-fdb4484c0fa0",
                    "sense_definition": "В меньшей степени (часто используется в составе устойчивых выражений для подчеркивания значимости или противопоставления).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree_extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тем не <менее>, мы успели закончить работу вовремя.",
                            "target_lang_translations": {
                                "en": "Neverthe<less>, we managed to finish the work on time.",
                                "zh": "<w>尽管如此</w>，我们还是及时完成了工作。"
                            }
                        },
                        {
                            "text": "Для нас это событие не <менее> важно, чем для вас.",
                            "target_lang_translations": {
                                "en": "For us, this event is no <less> important than for you.",
                                "zh": "这件事对我们来说<w>不</w>比对你们<w>少</w>重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "меньше"
                    ],
                    "antonyms": [
                        "больше"
                    ],
                    "common_phrases": [
                        "тем не менее",
                        "не менее",
                        "ничуть не менее",
                        "гораздо менее"
                    ],
                    "target_lang_definitions": {
                        "en": "To a smaller extent or degree; often used in set expressions to emphasize significance or contrast.",
                        "zh": "在较小的程度上；常用于固定搭配中以强调重要性或进行对比。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "less",
                                "target_lang_sense_clarification": "to a smaller extent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不……少",
                                "target_lang_sense_clarification": "用于强调程度不亚于某物"
                            },
                            {
                                "target_lang_word": "尽管如此",
                                "target_lang_sense_clarification": "用于“тем не менее”的意译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}