                                        "entry_id": "9c09bc07-f04e-3315-847b-51102c1b3fb3",
                                        "glosses": [
                                            "The act of, or an instance of, reduplicating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c26eb31b-5c8f-40ff-bd8c-b1182b55913b",
                                                "sense_id": "22eff2f8-beb5-3d11-bed1-a3f924ac2a04",
                                                "text": "Her Malay was the Malay of the Staate of Lanchap [...] and she spoke it fierily, with crisp glottal checks, with much bubbling reduplication."
                                            },
                                            {
                                                "example_id": "70bac53d-77a0-40f4-bd25-369f4a41d40d",
                                                "sense_id": "22eff2f8-beb5-3d11-bed1-a3f924ac2a04",
                                                "text": "Grammatically, Malay uses reduplication for plurals (burung = bird, burung-burung = birds) and thus repeated words are commonly heard in Malay speech[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d476ab1-7197-3116-b70a-8b3b83fc9e4f",
                                        "entry_id": "9c09bc07-f04e-3315-847b-51102c1b3fb3",
                                        "glosses": [
                                            "The folding or doubling of a part or organ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8bc5cee-b193-4389-89d5-33d1486f6afd",
                        "source_entry_id": "90ee21ff-db85-3822-bd2e-46d639be0380",
                        "source_sense_id": "44cf6596-1a02-33d2-bdc2-8fc552f760a0",
