                        "glosses": [
                            "Se dévaloriser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e63814-386b-4b7b-9b76-ff725c2b4a19",
                                "sense_id": "39323446-71f4-3595-a2be-923610c023ab",
                                "text": "Les victimes risquent également de se désintéresser de leur scolarité et de se mettre en situation d'échec, mais aussi de s'autodévaloriser, de déprimer, de craquer nerveusement, voire de se suicider(Kaltiala-Heino et autres, 1999 ; Lawlor, 2002 ; O'Moore, 2003 ; Rigby, 1998)."
                            },
                            {
                                "example_id": "adb330bc-a804-4ccc-a106-7d81f9a40608",
                                "sense_id": "39323446-71f4-3595-a2be-923610c023ab",
                                "text": "Enfin, le mépris construit autour des groupes exclus les amène à s'autodévaloriser."
                            }
                        ]
                    }
