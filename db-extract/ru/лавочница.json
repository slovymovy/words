                "senses": [
                    {
                        "sense_id": "f2c547bc-82d8-31cc-80a6-b440b66c188d",
                        "entry_id": "96ed45da-619c-36c3-baae-ea2afe9e6ed6",
                        "glosses": [
                            "female equivalent of ла́вочник (lávočnik): female small shopkeeper"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "611b1866-5fb3-4b15-84bb-f59c75866e3c",
                                "sense_id": "f2c547bc-82d8-31cc-80a6-b440b66c188d",
                                "text": "Она́ не да́ма, не ба́рыня, а ла́вочница с углова́тыми мане́рами: хо́дит — рука́ми ма́шет, сиди́т, положи́в но́гу на́ ногу, пока́чиваясь взад и вперёд всем ко́рпусом, лежи́т, подня́в но́ги, и т. д…",
                                "translation": "Anton Chekhov",
                                "english": "Anton Chekhov"
                            },
                            {
                                "example_id": "67d79d67-7a9d-444c-8179-e8549a329a85",
                                "sense_id": "f2c547bc-82d8-31cc-80a6-b440b66c188d",
                                "text": "Ползу́т в со́нных трамва́ях со́нные ла́вочницы, подде́рживая отяжеле́вших со́нных ребя́т.",
                                "translation": "Nadezhda Teffi",
                                "english": "Nadezhda Teffi"
                            }
                        ]
                    }
                ],
