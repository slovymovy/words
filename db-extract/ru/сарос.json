                                        "entry_id": "c2627c7f-6ff4-3227-a745-f198d2616297",
                                        "glosses": [
                                            "Période de 6 585,32 jours ou 223 lunaisons permettant de prédire les éclipses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0801578d-df17-4476-a191-e2d497c0a79f",
                                                "sense_id": "a88ec87e-0c93-393c-8566-16df5f1be72b",
                                                "text": "Un saros s’étale en général sur trente-huit saisons d’éclipses qui se produisent environ tous les six mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0f526ab-d419-368a-ae36-f7c97805c289",
                                        "entry_id": "c2627c7f-6ff4-3227-a745-f198d2616297",
                                        "glosses": [
                                            "Période synodique des Chaldéens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d9914c-e567-4e84-984d-bede068f5c8c",
                                                "sense_id": "d0f526ab-d419-368a-ae36-f7c97805c289",
                                                "text": "Les Chaldéens avaient une autre période qu’ils appelaient sare ou saros. C’était une révolution de 3 600 ans. À celle-là on n’a pu découvrir aucun usage astronomique."
                                            }
                                        ]
                                    }
                                ]
