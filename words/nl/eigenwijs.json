{
    "word_family": [
        "eigenwijsheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6eb5e97b-e5cc-3d1d-9695-9a7efd2c5b71",
                    "sense_definition": "overtuigd zijn van het eigen gelijk en niet bereid zijn om naar anderen te luisteren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "koppigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>eigenwijze</w> oude man wilde niet naar de adviezen van de verpleegster luisteren.",
                            "target_lang_translations": {
                                "en": "The <w>stubborn</w> old man did not want to listen to the nurse's advice."
                            }
                        },
                        {
                            "text": "Het <w>eigenwijze</w> kind deed lekker niet wat zijn moeder zei.",
                            "target_lang_translations": {
                                "en": "The <w>headstrong</w> child simply didn't do what his mother said."
                            }
                        }
                    ],
                    "synonyms": [
                        "eigenzinnig",
                        "koppig",
                        "stijfkoppig"
                    ],
                    "antonyms": [
                        "gezeglijk",
                        "meegaand"
                    ],
                    "common_phrases": [
                        "lekker eigenwijs",
                        "een eigenwijze houding"
                    ],
                    "target_lang_definitions": {
                        "en": "Being convinced of one's own rightness and unwilling to listen to others' advice or opinions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stubborn",
                                "target_lang_sense_clarification": "unwilling to change one's mind"
                            },
                            {
                                "target_lang_word": "opinionated",
                                "target_lang_sense_clarification": "holding strong beliefs and refusing to listen"
                            },
                            {
                                "target_lang_word": "headstrong",
                                "target_lang_sense_clarification": "determined to have one's own way"
                            },
                            {
                                "target_lang_word": "self-willed",
                                "target_lang_sense_clarification": "obstinately pursuing one's own wishes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "514ff865-0d74-3f19-b75f-5bc4cc7d0432",
                    "sense_definition": "op een koppige manier vasthouden aan eigen ideeën of gedrag",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "koppigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is zo <w>eigenwijs</w> dat hij nooit hulp vraagt bij zijn werk.",
                            "target_lang_translations": {
                                "en": "He is so <w>opinionated</w> that he never asks for help with his work."
                            }
                        },
                        {
                            "text": "Ondanks de waarschuwingen bleef ze op haar eigen <w>eigenwijze</w> manier doorgaan.",
                            "target_lang_translations": {
                                "en": "Despite the warnings, she continued in her own <w>obstinate</w> way."
                            }
                        }
                    ],
                    "synonyms": [
                        "halsstarrig",
                        "hardnekkig",
                        "stijfhoofdig"
                    ],
                    "antonyms": [
                        "volgzaam"
                    ],
                    "common_phrases": [
                        "eigenwijs gedrag",
                        "behoorlijk eigenwijs"
                    ],
                    "target_lang_definitions": {
                        "en": "Persisting in one's own ideas or behavior in a stubborn or unconventional manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obstinate",
                                "target_lang_sense_clarification": "refusing to change one's behavior or ideas"
                            },
                            {
                                "target_lang_word": "pigheaded",
                                "target_lang_sense_clarification": "stupidly stubborn"
                            },
                            {
                                "target_lang_word": "willful",
                                "target_lang_sense_clarification": "intent on having one's own way regardless of consequences"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}