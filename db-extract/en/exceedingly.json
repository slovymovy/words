                                            "sehr, im höchsten/allerhöchsten/außerordentlichen Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "addda0fd-554c-4a75-919f-ef308d9a2b02",
                                                "sense_id": "cd20cfed-f23c-3958-af69-5b3b7639ebf0",
                                                "text": "Die Lage ist äußerst angespannt."
                                            },
                                            {
                                                "example_id": "c2f8bf79-9e19-4256-b821-81b935b83eb4",
                                                "sense_id": "cd20cfed-f23c-3958-af69-5b3b7639ebf0",
                                                "text": "Sie ist äußerst erregt."
                                            },
                                            {
                                                "example_id": "bf7dcf09-f163-4647-9dfe-9e0624ffaad3",
                                                "sense_id": "cd20cfed-f23c-3958-af69-5b3b7639ebf0",
                                                "text": "„Gleitschirmfliegen gelte als äußerst sichere Flugsportart.“"
                                            },
                                            {
                                                "example_id": "b6f0f9b8-c0a4-4ff5-921b-857f52b1dff8",
                                                "sense_id": "cd20cfed-f23c-3958-af69-5b3b7639ebf0",
                                                "text": "„Man muss kein Medizinexperte sein, um sagen zu können, dass diese Challenge nicht nur schmerzhaft, sondern äußerst gefährlich sein kann.“"
