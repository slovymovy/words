                "senses": [
                    {
                        "sense_id": "d53a5629-0d2a-3edb-a72a-8f272cdadd36",
                        "entry_id": "68ffcc97-e8ac-3544-aca5-04d48c269922",
                        "glosses": [
                            "od: kołowrót"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1b5f9929-7f42-37db-971d-3fc8aeee55d1",
                        "entry_id": "68ffcc97-e8ac-3544-aca5-04d48c269922",
                        "glosses": [
                            "przyrząd wędkarski w formie szpuli z rączką służący do nawijania i rozwijania zapasu żyłki, zwykle będący częścią wędki spinningowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11faf9a-4af1-48c2-8903-528cd2021df9",
                                "sense_id": "1b5f9929-7f42-37db-971d-3fc8aeee55d1",
                                "text": "Podstawowa zasada powodzenia, to takie zmontowanie zestawu (spławik, ciężarek), by ryba biorąc nie wyczuła najmniejszego oporu. Łowiąc z gruntu bez spławika radziłbym poszerzyć otwór ciężarka, zostawić otwarty kabłąk kołowrotka"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0b80186c-9bd2-38cd-a270-3f757014768d",
                        "entry_id": "68ffcc97-e8ac-3544-aca5-04d48c269922",
                        "glosses": [
                            "urządzenie mechaniczne służące do przędzenia nici"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "21c4729d-5391-4aad-a360-439d7a548d06",
                                "sense_id": "0b80186c-9bd2-38cd-a270-3f757014768d",
                                "text": "W porze bajek i pieśni, późną jesienią, palce wyciągały z motka wełny przędzę, przy miarowym stukaniu pedału kołowrotków"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "861492ee-f1eb-3fcc-bb37-0c989a986bcd",
                        "entry_id": "68ffcc97-e8ac-3544-aca5-04d48c269922",
                        "glosses": [
                            "obrotowe urządzenie umieszczane przy wejściach do miejsc, gdzie trzeba przepuszczać ludzi pojedynczo"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "5723a68c-aec7-34d9-a93f-6f5487d2b22a",
                        "entry_id": "68ffcc97-e8ac-3544-aca5-04d48c269922",
                        "glosses": [
                            "urządzenie w formie ruchomego bębna służące do biegania hodowanym w domu gryzoniom i innym małym zwierzętom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a4bd9e-93c6-4915-884a-fd3cd7ff88d6",
                                "sense_id": "5723a68c-aec7-34d9-a93f-6f5487d2b22a",
                                "text": "Chomik potrafi biegać w kołowrotku nawet kilka godzin i przemierzyć do ośmiu kilometrów w ciągu jednej nocy"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "4a25fbeb-3d71-37b3-8cab-77473ffa7fd5",
                        "entry_id": "68ffcc97-e8ac-3544-aca5-04d48c269922",
                        "glosses": [
                            "zamęt, często związany z natłokiem wydarzeń lub obowiązków"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "a0d63331-815c-479b-8d51-52e65c49854d",
                                "sense_id": "4a25fbeb-3d71-37b3-8cab-77473ffa7fd5",
                                "text": "Ale mam dziś kołowrotek w pracy! Od rana urywają się telefony, mam trzy spotkania z klientami i jeszcze ten raport na jutro."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
                ],
