                "senses": [
                    {
                        "sense_id": "1a5497ef-fe9d-35f9-a626-3af6d0d3e30f",
                        "entry_id": "1ba528a8-db01-3816-bab6-a3f7ea4c1025",
                        "glosses": [
                            "van een manier van spreken dat die lijkt op het houden van een vermaning of preek door een godsdienstleraar of geestelijke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87045d5a-d1f7-47ef-aeb8-ab6fdab79b8e",
                                "sense_id": "1a5497ef-fe9d-35f9-a626-3af6d0d3e30f",
                                "text": "U2 bleek vanavond tijdens zijn optreden in de Amsterdamse Ziggo Dome zijn vertrouwde zelf: bombastisch, prekerig, visueel overdonderend en simpelweg heel erg goed."
                            },
                            {
                                "example_id": "55752e07-62c1-4f43-97c6-bb041afb2d3b",
                                "sense_id": "1a5497ef-fe9d-35f9-a626-3af6d0d3e30f",
                                "text": "Even dringt de vergelijking met Project X zich op, al blijkt die niet terecht. Waar die feestfilm de totale anarchie bewierookte, toont Feuten: Het feestje beide kanten van de medaille, zonder prekerig te worden."
                            },
                            {
                                "example_id": "074b87d0-d969-48b1-9c62-d527fbc878ab",
                                "sense_id": "1a5497ef-fe9d-35f9-a626-3af6d0d3e30f",
                                "text": "Helaas, vega of vegetarische kookboeken zijn of saai, of prekerig en meestal puur vervelend. Hoe anders is de onlangs uitgekomen De Groene Bakplaat!"
                            }
                        ]
                    }
