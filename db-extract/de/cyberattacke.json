                    }
                ],
                "translations": [
                    {
                        "translation_id": "36468bf7-22cd-4279-9dad-d59ff690982a",
                        "source_entry_id": "fba44c00-cc37-3dc5-bd63-6247b8b785b6",
                        "source_sense_id": "a5fe87f2-0ac2-3672-ba94-9676f0d94521",
                        "source_sense_description": "von außen durchgeführter, gezielter Angriff auf ein Computernetzwerk",
                        "target_lang_word": "网络攻击",
                        "target_lang_code": "zh",
