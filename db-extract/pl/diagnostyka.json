                            },
                            {
                                "target_word": "diagnostics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1544c112-0849-3167-a476-24feeb25520f",
                                        "entry_id": "3fd7fc4a-abbe-36df-8645-30ddbaeeef07",
                                        "glosses": [
                                            "The process of arriving at a diagnosis (through diagnostic efforts: tests, analysis, thought).",
                                            "Diagnostic methods considered collectively."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06d7853-455b-4609-8d14-647478127512",
                                                "sense_id": "1544c112-0849-3167-a476-24feeb25520f",
                                                "text": "Near-synonym: diagnosis"
                                            },
                                            {
                                                "example_id": "df86809e-5e3b-4072-9b67-9534cb4bb44b",
                                                "sense_id": "1544c112-0849-3167-a476-24feeb25520f",
                                                "text": "Diagnostics is the area in which this molecule is most useful, whereas it is not a treatment target in itself."
                                            },
                                            {
                                                "example_id": "fba7d8e1-6a45-4f49-aa4c-5593130e2c8d",
                                                "sense_id": "1544c112-0849-3167-a476-24feeb25520f",
                                                "text": "The diagnostics were extensive, with scores of laboratory tests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7bed79a-8606-3a65-8223-a9d5e51759dd",
                                        "entry_id": "3fd7fc4a-abbe-36df-8645-30ddbaeeef07",
                                        "glosses": [
                                            "The process of arriving at a diagnosis (through diagnostic efforts: tests, analysis, thought).",
                                            "The process of determining the state of or capability of a component to perform its function(s)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b34037a-32c3-4dcf-9724-a9ab20d4e387",
                                                "sense_id": "b7bed79a-8606-3a65-8223-a9d5e51759dd",
                                                "text": "Diagnostics is the area in which the cost of hiring a factory-certified technician might easily pay for itself through downtime reduction."
                                            },
                                            {
                                                "example_id": "631f8b19-130d-4b94-9bff-94eff4209509",
                                                "sense_id": "b7bed79a-8606-3a65-8223-a9d5e51759dd",
                                                "text": "The diagnostics were a nightmare, but we finally isolated the problem to a specific one of the many ECUs — of which this ridiculous design has at least fourteen that we know of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49c9c010-6ff3-4edb-b22b-bf430bd8e560",
                        "source_entry_id": "8083bfb0-3dc6-334a-beec-9b7ec3e63d6b",
                        "source_sense_id": "2e6e2e77-f9c8-3f9e-bd6a-6ba04e0f923a",
                        "target_lang_word": "Diagnostik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diagnostik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf86dd1e-73d4-3e37-a316-f50f29efec74",
                                        "entry_id": "52a8fec3-6e2c-3c0e-974d-419bcb1f016d",
                                        "glosses": [
                                            "Lehre von der Erkennung/Bestimmung (insbesondere von Krankheiten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43eae81-f907-4125-8df0-5e18cf1d0d20",
                                                "sense_id": "cf86dd1e-73d4-3e37-a316-f50f29efec74",
                                                "text": "„Ob in Brennstoffzellen, zur medizinischen Diagnostik oder Produktion neuer Materialien und Energieträger — Katalysatoren haben ein enormes Einsatzpotenzial.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8b98073-a7a1-4fcb-94e9-603e04cd8e7a",
                        "source_entry_id": "8083bfb0-3dc6-334a-beec-9b7ec3e63d6b",
                        "source_sense_id": "2e6e2e77-f9c8-3f9e-bd6a-6ba04e0f923a",
                        "target_lang_word": "диагностика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "диагностика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "65f1b174-840a-37a3-a971-d2d76405d10f",
                                        "entry_id": "5752bd04-ccff-3333-a9ff-d346fd1228ba",
                                        "glosses": [
                                            "мед., техн. исследование с целью определить причину болезни организма, неисправности механизма и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24bf880a-ecc2-47c1-95a4-408c8c2bc107",
                                                "sense_id": "65f1b174-840a-37a3-a971-d2d76405d10f",
                                                "text": "Ещё одна важная область применения тепловидения — диагностика злокачественных опухолей, расположенных неглубоко под поверхностью тела, особенно опухолей кожи и молочных желез."
                                            },
                                            {
                                                "example_id": "5b07c3ff-0ac1-4a2c-a98a-27bfcb52b833",
                                                "sense_id": "65f1b174-840a-37a3-a971-d2d76405d10f",
                                                "text": "Хотя ни один человек не может подвергнуться тестированию насильно, многие понимают, что уклоняться нецелесообразно, ведь ранняя диагностика значительно повышает шансы на продление жизни."
                                            },
                                            {
                                                "example_id": "50de68f7-42c9-4def-bc41-eed967f76c03",
                                                "sense_id": "65f1b174-840a-37a3-a971-d2d76405d10f",
                                                "text": "Диагностику двигателю следует сделать ещё и потому, что при пробеге под 200 тыс. км мотор может потребовать замены маслосъёмных колец, вкладышей коленвала и всех сальников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc8c18a8-25c4-3def-accc-203cb28fd1cd",
                                        "entry_id": "5752bd04-ccff-3333-a9ff-d346fd1228ba",
                                        "glosses": [
                                            "раздел медицины, изучающий методы и принципы распознавания болезней и постановки диагноза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148bdf89-8dce-4bc5-bdc8-490b6232c702",
                                                "sense_id": "cc8c18a8-25c4-3def-accc-203cb28fd1cd",
                                                "text": "Благодаря тому что в мире идентифицировано множество генов, ответственных за многие болезни человека, в том числе онкологические, наследственные, нейродегенеративные, возникли и бурно прогрессируют два направления медицинской геномики — геномная диагностика, а также поиск и идентификация не только «больных» генов, ответственных за те или иные патологии, но и генов, определяющих предрасположенность ко многим тяжелым болезням человека."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
