                        "glosses": [
                            "That cannot be suppressed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a0cfb7b-2093-4b68-847b-8d3fbf6101c2",
                                "sense_id": "3ddf4093-4fc3-3ab2-a864-59009a82817f",
                                "text": "It seemed as if the sense of public resentment had long been gathering strength unperceived, and now burst forth into insuppressible violence."
                            },
                            {
                                "example_id": "7e01bf8a-eabe-4cb4-b3e4-9f7407259e50",
                                "sense_id": "3ddf4093-4fc3-3ab2-a864-59009a82817f",
                                "text": "In its stead Victor favoured Karslake with a slow smile of understanding that broadened into an insuppressible grin of successful malice, a grimace of crude exultation through which peered out the impish savage mutinously imprisoned within a flimsy husk of modern manner."
                            }
                        ]
                    }
