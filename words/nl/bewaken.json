                    ],
                    "target_lang_definitions": {
                        "en": "to prevent an opponent in a sports match from scoring",
                        "ru": "не давать противнику в спортивном матче забить гол"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mark",
                                "target_lang_sense_clarification": "to stay close to an opponent in sports"
                            },
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to defend against a specific player"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "опекать",
                                "target_lang_sense_clarification": "плотно играть против конкретного игрока"
                            },
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "не давать игроку противника свободно действовать"
                            }
