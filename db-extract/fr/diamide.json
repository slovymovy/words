                        "examples": [
                            {
                                "example_id": "acf9fd7a-8569-4c8e-9a4e-9abbd20cfb45",
                                "sense_id": "ebf23e55-44fb-3222-abd3-db2c21cfd916",
                                "text": "Réactif pour préparer un agent radiopharmaceutique qui est un chélateur métallique renfermant une monoamine, une diamide et un thiol lié par covalence."
                            },
                            {
                                "example_id": "254eeed0-86c4-4aa6-aa15-cc899bf4a538",
                                "sense_id": "ebf23e55-44fb-3222-abd3-db2c21cfd916",
                                "text": "Elle fut obtenue en faisant passer un courant de gaz chlorhydrique par une solution bien refroidie de la diamide dans l’alcool méthylique."
                            }
                        ]
