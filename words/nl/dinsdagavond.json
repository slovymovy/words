                    ],
                    "target_lang_definitions": {
                        "en": "The later hours of Tuesday, the part of the day between afternoon and night.",
                        "ru": "Вечернее время вторника, часть суток между днем и ночью.",
                        "pl": "Późniejsze godziny wtorku, część dnia między popołudniem a nocą.",
                        "de": "Die späteren Stunden des Dienstags, der Teil des Tages zwischen Nachmittag und Nacht.",
                        "fr": "Les heures tardives du mardi, la partie de la journée située entre l'après-midi et la nuit.",
                        "it": "Le ore serali del martedì, la parte della giornata tra il pomeriggio e la notte.",
                        "cs": "Pozdní hodiny úterý, část dne mezi odpolednem a nocí.",
                        "tr": "Salı gününün öğleden sonra ile gece arasındaki saatleri.",
                        "es": "Las últimas horas del martes, la parte del día entre la tarde y la noche.",
                        "zh": "星期二的傍晚到夜晚这段时间。"
                    },
