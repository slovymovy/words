            "senses": [
                {
                    "sense_id": "bf33d1ed-9309-3da0-b5f7-39ca1fa1db46",
                    "sense_definition": "An annoying or mischievous child",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get off my lawn, you little <w>perisher</w>!",
                            "target_lang_translations": {
                                "nl": "Ga van mijn gazon af, jij kleine <w>deugniet</w>!"
                            }
                        },
                        {
                            "text": "That young <w>perisher</w> has been throwing stones at the windows again.",
                            "target_lang_translations": {
                                "nl": "Die jonge <w>etterbak</w> heeft weer stenen naar de ramen gegooid."
                            }
                        }
                    ],
                    "synonyms": [
                        "brat",
                        "rascal"
                    ],
                    "common_phrases": [
                        "little perisher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in British English to describe a naughty child."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vervelend of ondeugend kind."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "deugniet",
