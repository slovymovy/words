                "senses": [
                    {
                        "sense_id": "ee1539c6-6272-379e-9ff8-9420fef8e997",
                        "entry_id": "9ed15ab8-78a0-3ac2-9b2e-4e559a9b96c5",
                        "glosses": [
                            "durch den Geruchssinn wahrgenommene Gerüche, die sexuell erregen, zum Beispiel die des Geschlechtsorgans, die des begehrten Organismus oder die organischer Abscheidungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073af47b-9c35-4bc9-968e-1c7a71b45f7b",
                                "sense_id": "ee1539c6-6272-379e-9ff8-9420fef8e997",
                                "text": "„Was die spezifischen Sexualgerüche anlangt, die von den männlichen und weiblichen Genitalien ausgehen, so werden sie normalerweise alle als unangenehm empfunden, doch können gerade sie bei manchen Menschen das erotische Verlangen des Partners aufstacheln.“"
                            },
                            {
                                "example_id": "d74a6fc7-c7bb-4d96-a3dc-e2a18e0a2272",
                                "sense_id": "ee1539c6-6272-379e-9ff8-9420fef8e997",
                                "text": "„Für Moschus, das ursprünglich aus der Vorhautdrüse des tibetischen Moschusochsen stammt und ein Sexualgeruch ist, haben auch die Menschen noch eine überaus feine Nase - ein paar Moleküle genügen.“"
                            },
                            {
                                "example_id": "6929c392-7b79-4c92-9d2a-c8ccdd0dcaff",
                                "sense_id": "ee1539c6-6272-379e-9ff8-9420fef8e997",
                                "text": "„Ausgesprochene Sexualgerüche wurden in unserer Befragung selten erwähnt, hingegen wurde das Thema Sexualität in den zusätzlichen Bemerkungen öfter angesprochen.“"
                            },
                            {
                                "example_id": "31807aa6-ebef-4be6-8ab2-d21852ccb537",
                                "sense_id": "ee1539c6-6272-379e-9ff8-9420fef8e997",
                                "text": "„Neuere Versuche mit Tagfaltern, vornehmlich mit Parnassiusapollo, bringen mich sogar zu der Annahme, daß auch bei dieser Gruppe unserer Falter ein allerdings schwach entwickelter Sexualgeruch bei dem Finden der Geschlechter eine Rolle spielt.“"
                            },
                            {
                                "example_id": "289ad4ea-bda0-4253-921e-2c9060f084a0",
                                "sense_id": "ee1539c6-6272-379e-9ff8-9420fef8e997",
                                "text": "„Die zwei typischen sexualen Secrete, das der Vorhauttalgdrüsen und des Sperma, gehören zu der Gruppe der Caprylgerüche, der specifischen Sexualgerüche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
