                ],
                "senses": [
                    {
                        "sense_id": "f24ae86a-379d-3d75-853e-8aaa37f6de18",
                        "entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "glosses": [
                            "system rządów, polegający na sprawowaniu władzy w państwie przez wąską grupę uprzywilejowanych obywateli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc7e8d6-4a94-4651-b1a4-e09ed263fb6b",
                                "sense_id": "f24ae86a-379d-3d75-853e-8aaa37f6de18",
                                "text": "O ile w przypadku dyktatury władza przynależy do jednej osoby, o tyle w oligarchii jest ona przywłaszczona przez wąską grupę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2b7159d1-b87c-3748-bc8f-f3ba178b1b8d",
                        "entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "glosses": [
                            "niewielka grupa uprzywilejowanych ludzi sprawująca władzę lub mająca na nią duży wpływ"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bab2b83-0ce3-4806-830d-a5d06af14c13",
                        "source_entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "source_sense_id": "f24ae86a-379d-3d75-853e-8aaa37f6de18",
                        "target_lang_word": "oligarchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligarchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "A government run by and for only a few, often the aristocracy, the wealthy, or their friends and associates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0264089d-8515-4654-b4e1-d1068e03eb63",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "Despite the involvement of all classes of society, America's political duopoly and the importance of money to mass-market campaigning has established an oligarchy that is seldom responsive to the citizenry as a whole, when opposed to the wealthy or major interest groups."
                                            },
                                            {
                                                "example_id": "ca3d50df-5afc-4b6d-b792-ad8b1b6c44c9",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "It's an oligarchy because these families own and run almost everything that makes money in El Salvador. Coffee gave birth to the oligarchy in the late 19th century, and economic growth has revolved around them ever since."
                                            },
                                            {
                                                "example_id": "8f63c0c0-c64e-439a-9cbc-63cfffd1371f",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "The Itasca Project is just one example of existing oligarchy, and a surprisingly open one at that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33d564a-1452-30a3-b75e-551f15d8610d",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "A state ruled by such a government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40742ca1-100f-4afa-8b4f-ec7b1aa657d6",
                                                "sense_id": "f33d564a-1452-30a3-b75e-551f15d8610d",
                                                "text": "The 1832 Reform Act aimed to transform the British oligarchy and allow Parliament to represent the interests of a broader range of the population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5069cdc2-9d00-3709-a223-a40008e0f607",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "Those who make up an oligarchic government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54eea853-dab3-421a-ba1f-fe61c32293af",
                                                "sense_id": "5069cdc2-9d00-3709-a223-a40008e0f607",
                                                "text": "The modern British oligarchy—particularly during periods of Tory rule—has been called a chumocracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c43229d-d504-41b7-8ddc-f8dc484563ac",
                        "source_entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "source_sense_id": "f24ae86a-379d-3d75-853e-8aaa37f6de18",
                        "target_lang_word": "oligarquía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligarquía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0be90c4f-95d8-3392-b7e1-238027a4ee51",
                                        "entry_id": "701599e2-b46a-3dc1-8f1a-49d47aa155e4",
                                        "glosses": [
                                            "Forma o condición de un gobierno en el que el poder político es ejercido por un grupo reducido de personas."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "931feccd-9277-36e7-9edc-b85183db1afc",
                                        "entry_id": "701599e2-b46a-3dc1-8f1a-49d47aa155e4",
                                        "glosses": [
                                            "Grupo minoritario de personas, generalmente con gran poder e influencia, que dirige y controla una organización, institución, Estado o colectividad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a85eff7-83cd-4644-9712-29b198ef5544",
                        "source_entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "source_sense_id": "f24ae86a-379d-3d75-853e-8aaa37f6de18",
                        "target_lang_word": "Oligarchie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oligarchie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                        "entry_id": "c300bd67-51cb-3f8f-a220-78f3051dbc8b",
                                        "glosses": [
                                            "Herrschaft einer kleinen, bestimmten Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4e99e1-d4b4-4c01-92e2-3dc11d9b7b57",
                                                "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                                "text": "Das alte Rom war eine Oligarchie."
                                            },
                                            {
                                                "example_id": "c88c85eb-3b4e-4a1d-ba07-1b1f14ddd2da",
                                                "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                                "text": "„Parlamentarische Demokratien im heutigen Sinne gab es noch nicht. Wohl aber existierten parlamentarisch verfaßte Oligarchien (Großbritannien) neben relativ offenen parlamentarischen Systemen (Frankreich=, stark eingeschränkt parlamentarischen, halb-autoritären Strukturen (Deutsches Reich und Österreich-Ungarn) und beinahe unbegrenzte Autokratien (Rußland).“"
                                            },
                                            {
                                                "example_id": "b67b01eb-f5e0-4368-a1c9-936476825c1f",
                                                "sense_id": "3de8d568-6422-363b-9f5e-f5a66d84a512",
                                                "text": "„In Nürnberg war die Oligarchie ebenso schmal und ebenso abgeschlossen wie in Augsburg, anders als etwa in der Hansestadt Lübeck, wo die Fluktuation der Eliten verhinderte, dass sich eine geburtsständische Exklusivität der politischen Macht herausbildete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "668793cf-d781-4496-ae7d-dd136554bd37",
                        "source_entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "source_sense_id": "f24ae86a-379d-3d75-853e-8aaa37f6de18",
                        "target_lang_word": "олигархия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "олигархия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "00c3b39c-55a7-35a5-9f25-f410c743b3ca",
                                        "entry_id": "a3f5a911-8b93-31e3-9f97-c3e413e72231",
                                        "glosses": [
                                            "истор. государство, основанное на политическом и экономическом господстве небольшой группы лиц, аристократической верхушки (в древности и в средние века)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990d1729-3fe9-4464-b450-c79076b4241d",
                                                "sense_id": "00c3b39c-55a7-35a5-9f25-f410c743b3ca",
                                                "text": "Война междугосударственная тут была логически и жизненно связана с войною гражданскою между богатыми и бедными, ибо с самого начала она велась между величайшей демократией и могущественной олигархией Эллады."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d547d55-f4e7-3700-a3ee-d871c04bc1b6",
                                        "entry_id": "a3f5a911-8b93-31e3-9f97-c3e413e72231",
                                        "glosses": [
                                            "полит., экон. политическое и экономическое господство в государстве небольшой группы лиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9166658b-f62b-428c-94e7-17180a946ffe",
                                                "sense_id": "3d547d55-f4e7-3700-a3ee-d871c04bc1b6",
                                                "text": "Городская промышленная революция, сломив рыцарство, приходила в Швейцарии весьма естественным путем к олигархии."
                                            },
                                            {
                                                "example_id": "06286724-1570-4741-a809-d292641205a3",
                                                "sense_id": "3d547d55-f4e7-3700-a3ee-d871c04bc1b6",
                                                "text": "Для России в настоящее время и ещё надолго конституционное правление было бы гибельно, потому что оно немедленно бы обратилось в олигархию и анархию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "579e9a7c-ed19-344d-bd20-1c484d168379",
                                        "entry_id": "a3f5a911-8b93-31e3-9f97-c3e413e72231",
                                        "glosses": [
                                            "собир., полит., экон. такая группа лиц, стоящая во главе какого-либо политического, экономического и т. п. объединения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05825fa-fadf-4788-a374-53b52a52ba5e",
                                                "sense_id": "579e9a7c-ed19-344d-bd20-1c484d168379",
                                                "text": "Со времени В. Шуйского в выборном царе с ограниченной властью видели партийного государя, орудие боярской олигархии."
                                            },
                                            {
                                                "example_id": "5e4004fc-83c2-46a7-a493-437ae1f07536",
                                                "sense_id": "579e9a7c-ed19-344d-bd20-1c484d168379",
                                                "text": "Результатом кризиса было нарушение равенства земельных наделов, этого источника военной силы Спарты, и скопление богатств в руках немногочисленной многоземельной олигархии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a51cff94-2ac8-4285-ba57-cc2e47857bfc",
                        "source_entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "source_sense_id": "2b7159d1-b87c-3748-bc8f-f3ba178b1b8d",
                        "target_lang_word": "oligarchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligarchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "A government run by and for only a few, often the aristocracy, the wealthy, or their friends and associates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0264089d-8515-4654-b4e1-d1068e03eb63",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "Despite the involvement of all classes of society, America's political duopoly and the importance of money to mass-market campaigning has established an oligarchy that is seldom responsive to the citizenry as a whole, when opposed to the wealthy or major interest groups."
                                            },
                                            {
                                                "example_id": "ca3d50df-5afc-4b6d-b792-ad8b1b6c44c9",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "It's an oligarchy because these families own and run almost everything that makes money in El Salvador. Coffee gave birth to the oligarchy in the late 19th century, and economic growth has revolved around them ever since."
                                            },
                                            {
                                                "example_id": "8f63c0c0-c64e-439a-9cbc-63cfffd1371f",
                                                "sense_id": "1b2d69bd-5cd9-3fea-9a25-363d54c2fcf9",
                                                "text": "The Itasca Project is just one example of existing oligarchy, and a surprisingly open one at that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f33d564a-1452-30a3-b75e-551f15d8610d",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "A state ruled by such a government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40742ca1-100f-4afa-8b4f-ec7b1aa657d6",
                                                "sense_id": "f33d564a-1452-30a3-b75e-551f15d8610d",
                                                "text": "The 1832 Reform Act aimed to transform the British oligarchy and allow Parliament to represent the interests of a broader range of the population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5069cdc2-9d00-3709-a223-a40008e0f607",
                                        "entry_id": "cefe3646-3d4f-32b3-801d-e2ed9a86a02a",
                                        "glosses": [
                                            "Those who make up an oligarchic government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54eea853-dab3-421a-ba1f-fe61c32293af",
                                                "sense_id": "5069cdc2-9d00-3709-a223-a40008e0f607",
                                                "text": "The modern British oligarchy—particularly during periods of Tory rule—has been called a chumocracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a79b01f-8e2d-41b0-92bc-74150ed1c961",
                        "source_entry_id": "f788ea2a-aed1-3c8d-a97f-90f8b6f3194c",
                        "source_sense_id": "2b7159d1-b87c-3748-bc8f-f3ba178b1b8d",
                        "target_lang_word": "oligarquía",
