                        "entry_id": "3d2f27e9-1794-3c41-be2b-73739d5449a7",
                        "glosses": [
                            "Vogelart, die in vegetationsarmen Küstengebieten (nicht in Deutschland) brütet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2334920d-5b4b-41d6-bc98-a3da06cdd45f",
                                "sense_id": "55c6a675-b889-3ca1-a4f5-1b120392917f",
                                "text": "Der Berghänfling ernährt sich hauptsächlich von Samen, die am Boden liegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db4fa6fc-8155-4e38-bdcb-1877e24c4430",
                        "source_entry_id": "3d2f27e9-1794-3c41-be2b-73739d5449a7",
                        "source_sense_id": "55c6a675-b889-3ca1-a4f5-1b120392917f",
                        "source_sense_description": "Ornithologie: Vogelart, die in vegetationsarmen Küstengebieten (nicht in Deutschland) brütet",
                        "target_lang_word": "twite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de1f7607-b15b-372d-94f2-7f5528277218",
                                        "entry_id": "1500f7a4-7c15-3c1b-aa40-53e9c1581d8a",
                                        "glosses": [
                                            "A small passerine bird, Linaria flavirostris (syn. Carduelis flavirostris), that breeds in northern Europe and across central Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "144ac9bf-086f-4637-a648-20129d975c64",
                                                "sense_id": "de1f7607-b15b-372d-94f2-7f5528277218",
                                                "text": "The Twite has the distinction of being the only European bird derived from the Tibetan fauna type."
                                            },
                                            {
                                                "example_id": "b7430135-33bc-404a-b8e1-7065c1391069",
                                                "sense_id": "de1f7607-b15b-372d-94f2-7f5528277218",
                                                "text": "Twites also breed in southwest and central Asia – at up to 3,500 m asl in Tibet – and it is supposed that the European relict populations became isolated during the retreat of the ice age (Voous 1960)."
                                            },
                                            {
                                                "example_id": "bfe936c6-cca7-4896-a456-e516f6245e20",
                                                "sense_id": "de1f7607-b15b-372d-94f2-7f5528277218",
                                                "text": "With subsequent climate warming, Twites in Europe followed the tundra north and became isolated."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e163ed81-3ca4-38fb-83f2-85fea0c0ddf6",
                                        "entry_id": "9786761e-a57e-3914-a741-0521b0aa459b",
                                        "glosses": [
                                            "Obsolete form of twit."
                                        ],
