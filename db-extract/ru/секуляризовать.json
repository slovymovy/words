                                                "sense_id": "7e3fe3d0-1573-39cd-a655-b7e2136f4fff",
                                                "text": "„Ihm schloß sich ein Teil des südfranzösischen Adels an, der die Kirchenländereien säkularisieren wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
