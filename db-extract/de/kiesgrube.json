                ],
                "senses": [
                    {
                        "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                        "entry_id": "7495e5f1-042d-304a-a10b-43205189f5f1",
                        "glosses": [
                            "ein großes Erdloch, aus dem im Tagebau Sand, Kies und Schotter abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f88785-809c-4983-85a5-8e150e2336f5",
                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                "text": "[…] lieber ins Baggerloch springen. Das ist kein natürlicher See, sondern eine ehemalige Kiesgrube, die voller Wasser gelaufen ist."
                            },
                            {
                                "example_id": "ca01ee8a-3f2f-41e4-a557-5c5835cb8493",
                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                "text": "Im Dachauer KZ und seinen 140 Außenlagern waren von 1933 bis 1945 mehr als 200.000 Menschen aus ganz Europa inhaftiert. Arbeitsfähige Häftlinge wurden als Arbeitssklaven im Straßenbau oder in Kiesgruben eingesetzt, nach Kriegsbeginn vor allem in der Rüstungsindustrie."
                            },
                            {
                                "example_id": "cd6bc74a-07be-4e0b-8712-283b5a61d9a2",
                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                "text": "Als Unternehmer von Kiesgruben initiierte [der heute 78-jährige Naturschützer Hubert] Weinzierl bereits in den 50iger Jahren Renaturierungen […]."
                            },
                            {
                                "example_id": "4ce35e55-c930-4991-bc50-57639360655d",
                                "sense_id": "624fe229-2bfe-3372-82e4-e444d702eb3d",
                                "text": "„Nach dem Wald gelangten die Götzlacker auf eine freie Straße, die um eine große Kiesgrube herumführte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab1edbd-b05e-4c53-b7d5-2746af813d9d",
