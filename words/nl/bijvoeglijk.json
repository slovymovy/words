    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49ca0f90-99b5-3943-8d11-9a91a2d431b6",
                    "sense_definition": "Een eigenschap of kenmerk toevoegend aan een zelfstandig naamwoord.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>bijvoeglijk</w> naamwoord geeft extra informatie over een zelfstandig naamwoord.",
                            "target_lang_translations": {
                                "ru": "Имя <w>прилагательное</w> дает дополнительную информацию об имени существительном."
                            }
                        },
                        {
                            "text": "In de zin de grote hond is grote een <w>bijvoeglijk</w> naamwoord.",
                            "target_lang_translations": {
                                "ru": "В предложении «большая собака» слово «большая» является именем <w>прилагательным</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bijvoeglijk naamwoord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к прилагательному, выполняющий функцию определения существительного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилагательный",
                                "target_lang_sense_clarification": "в составе термина 'имя прилагательное'"
                            },
                            {
                                "target_lang_word": "адъективный",
                                "target_lang_sense_clarification": "лингвистический термин, относящийся к прилагательному"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adc09d4a-197e-3a09-a687-2f8795522f44",
                    "sense_definition": "Betrekking hebbend op een <w>bijvoeglijk</w> naamwoord.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De taalkundige analyse richtte zich op het <w>bijvoeglijk</w> gebruik van dit woord.",
                            "target_lang_translations": {
                                "ru": "Лингвистический анализ был сосредоточен на <w>адъективном</w> употреблении этого слова."
                            }
                        },
                        {
                            "text": "Het <w>bijvoeglijk</w> element in deze zin is essentieel voor de betekenis.",
                            "target_lang_translations": {
                                "ru": "<w>Адъективный</w> элемент в этом предложении важен для смысла."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий отношение к грамматической категории прилагательного или его использованию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адъективный",
                                "target_lang_sense_clarification": "используемый в значении прилагательного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
