                                "target_senses": [
                                    {
                                        "sense_id": "a52d84c0-2b70-3d90-a28d-ff812b6d8863",
                                        "entry_id": "ece567f3-287e-3fd9-9cf0-1c9bf3a8d35a",
                                        "glosses": [
                                            "de vloeistof van het bloed waar geen bloedlichaampjes meer in zitten maar nog wel stollingseiwitten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2779a3d-b255-4947-ad07-90af5993e68b",
                                                "sense_id": "a52d84c0-2b70-3d90-a28d-ff812b6d8863",
                                                "text": "„Ik was 21 en ik zat in dienst. Je kreeg er speciaal een dag vrij voor. Niet dat dat de reden was, maar toch. Omdat ik een zeldzame bloedgroep heb, AB-positief, werd ik niet vaak opgeroepen. Pas later werd me gevraagd om bloedplasma af te staan. Daar worden medicijnen uit gemaakt en het wordt gegeven aan patiënten met brandwonden of heel veel bloedverlies. Sinds 1995 ga ik zo’n beetje om de week naar de bloedbank.”"
                                            }
                                        ]
                                    }
                                ]
                            }
