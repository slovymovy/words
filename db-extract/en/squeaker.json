                        "entry_id": "5d013cf8-8da5-37c9-b2ba-4fb8e513f4b8",
                        "glosses": [
                            "A game or election won by a narrow margin."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "6376ea6c-2339-4143-8a05-f7a4823c49dc",
                                "sense_id": "70d3607c-0aec-33a1-bd61-ea7c7f57ebb4",
                                "text": "I mentioned that you correctly predicted nine of the last 10 presidential election outcomes, save one, in 2000 when George W. Bush defeated Al Gore, and that was a squeaker."
                            }
                        ]
                    },
                    {
                        "sense_id": "9318bb74-a542-3279-a61c-3fc5375d0cfb",
                        "entry_id": "5d013cf8-8da5-37c9-b2ba-4fb8e513f4b8",
                        "glosses": [
                            "An act of flatulence; a fart."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "df7a5c75-045d-4ea9-9b0f-ffb5480c6d52",
                                "sense_id": "9318bb74-a542-3279-a61c-3fc5375d0cfb",
                                "text": "He sat down, let out a squeaker, and then unloaded his entire wedding breakfast into the pan. Cheers buddy. Nothing kills a moment of nostalgia better than a fat man using the shithouse."
                            }
                        ]
                    },
