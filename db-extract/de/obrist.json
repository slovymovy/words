                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "27fee5cc-167a-44fa-aba6-c75866a1c5fd",
                                "sense_id": "207d090d-400b-3974-a690-6edafc3d9146",
                                "text": "„Der Obrist war ein vornehmer und hochgelahrter Edelmann, Graf und Baron und Junker aus dem Lande Pommern und residierte hier auf einem Rittergut in der Nachbarschaft.“"
                            },
                            {
                                "example_id": "222044e1-b5f7-4238-b4a1-82aaa1d2deda",
                                "sense_id": "207d090d-400b-3974-a690-6edafc3d9146",
                                "text": "„Die wichtigsten Instanzen sind der Obrist, sein Locotenent (Stellvertreter)) und die Trabanten, die als Leibwache fungieren, mitunter aber auch als eine Art Stab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1de434c6-48c8-3dfa-81a9-8cf4e182fadc",
                        "entry_id": "b0576a0c-58ff-3c6e-a614-32302be13903",
                        "glosses": [
                            "abwertend: Soldat als Mitglied einer Militärjunta"
                        ],
                        "tags": [],
                        "examples": [
                            {
