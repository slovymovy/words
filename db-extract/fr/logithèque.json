                        "sense_id": "65a687e6-2297-396e-9eb2-1f8be34a2944",
                        "entry_id": "bcfa5ec1-49de-39a9-ac27-951a10e41453",
                        "glosses": [
                            "software collection (especially on the Internet, or one's personal collection)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "16cab3e2-af63-4e69-8ac7-674b051c3559",
                                "sense_id": "65a687e6-2297-396e-9eb2-1f8be34a2944",
                                "text": "Que ce soit pour archiver vos images, effectuer des photomontages ou réaliser certaines corrections, vous serez certainement amené à devoir compléter votre logithèque."
                            }
                        ]
                    }
                ],
