                        "entry_id": "e3320642-51bf-3fd7-8e38-0366d5d07d5f",
                        "glosses": [
                            "afternoon, between 12 and 6 o'clock"
                        ],
                        "tags": [
                            "Belgium",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "89a75ccf-a9e4-4a1a-b61a-4b63b0a6b092",
                                "sense_id": "b7328635-4a20-3b4a-a774-f51075175ce9",
                                "text": "In België is het warmer in de namiddag.",
                                "translation": "In Belgium, it's warmer in the afternoon.",
                                "english": "In Belgium, it's warmer in the afternoon."
                            },
                            {
                                "example_id": "a8d8ee0f-781a-4aa3-9b75-649e40095107",
                                "sense_id": "b7328635-4a20-3b4a-a774-f51075175ce9",
                                "text": "Ik heb een afspraak in de namiddag.",
                                "translation": "I have an appointment in the afternoon.",
                                "english": "I have an appointment in the afternoon."
                            },
                            {
                                "example_id": "d012c5b2-ad70-44e8-a194-bda07552ed88",
                                "sense_id": "b7328635-4a20-3b4a-a774-f51075175ce9",
                                "text": "Kinderen spelen buiten in de namiddag.",
                                "translation": "Children play outside in the afternoon.",
                                "english": "Children play outside in the afternoon."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dbbeefa-32c4-3d56-b243-937cd5be862e",
                        "entry_id": "e3320642-51bf-3fd7-8e38-0366d5d07d5f",
                        "glosses": [
                            "late afternoon, between 4 and 6 o'clock"
                        ],
                        "tags": [
                            "Netherlands",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "423b06ce-1053-4009-a1ca-9a48edc53c25",
                                "sense_id": "8dbbeefa-32c4-3d56-b243-937cd5be862e",
                                "text": "In Nederland wordt de namiddag als de late namiddag beschouwd.",
                                "translation": "In the Netherlands, the late afternoon is considered as the namiddag.",
                                "english": "In the Netherlands, the late afternoon is considered as the namiddag."
                            },
                            {
                                "example_id": "60b713ce-8140-4ed6-8b5c-24f64b5e3c8b",
                                "sense_id": "8dbbeefa-32c4-3d56-b243-937cd5be862e",
                                "text": "Het licht is zachter in de namiddag.",
                                "translation": "The light is softer in the late afternoon.",
                                "english": "The light is softer in the late afternoon."
                            },
                            {
                                "example_id": "b8146e87-1978-450c-bd6d-76392b47c3e8",
                                "sense_id": "8dbbeefa-32c4-3d56-b243-937cd5be862e",
                                "text": "Veel mensen gaan wandelen in de namiddag.",
                                "translation": "Many people go for a walk in the late afternoon.",
                                "english": "Many people go for a walk in the late afternoon."
                            }
                        ]
                    }
