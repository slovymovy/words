                    {
                        "sense_id": "bb3d8905-af36-330a-8e0e-caec24857977",
                        "entry_id": "1eb89344-e1a9-325e-a72c-f76fb14e657b",
                        "glosses": [
                            "de studie van de literatuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bca8375-ef02-44aa-aad6-59900209e4cd",
                                "sense_id": "bb3d8905-af36-330a-8e0e-caec24857977",
                                "text": "Zij studeerde af in de letterkunde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61c241d4-94e5-490f-bcc6-79ad96c4eb5f",
                        "source_entry_id": "1eb89344-e1a9-325e-a72c-f76fb14e657b",
                        "source_sense_id": "bb3d8905-af36-330a-8e0e-caec24857977",
                        "source_sense_description": "de studie van de literatuur",
                        "target_lang_word": "Literaturwissenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Literaturwissenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                        "entry_id": "ff92fac1-4d64-3a1b-9215-95916b328e41",
                                        "glosses": [
                                            "Wissenschaftsdisziplin, die sich vorwiegend mit der künstlerischen Literatur der verschiedenen Sprachgemeinschaften befasst."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e469cf-8808-44ca-b207-9628c7583b4a",
                                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                                "text": "Die Literaturwissenschaft untersucht die Autoren, Gattungen, Geschichte und künstlerische Gestaltung literarischer Werke (Stil)."
                                            },
                                            {
                                                "example_id": "7c29ef27-701f-4f6b-935e-c7e71d1e9764",
                                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                                "text": "„Seit den Anfängen seiner Forschungstätigkeit beschäftigte ihn der Beitrag von Literatur und Literaturwissenschaft zur nationalen Identitätsstiftung und zum nationalistischen Wahn.“"
                                            },
                                            {
                                                "example_id": "cb7afb9e-9db7-49e0-951b-1227f46dd7c8",
                                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                                "text": "„Tim Grant kommt aus Dover, hat Literaturwissenschaften studiert.“"
                                            },
                                            {
                                                "example_id": "62488e34-7e47-42da-91f9-53e60c40a107",
                                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                                "text": "„In der Literaturwissenschaft wachse sich die Analyse von Romananfängen schon zu einem eigenen Forschungszweig aus, sagte Kempowski nach der Pause […].“"
                                            },
                                            {
                                                "example_id": "8e70b61e-1444-4c6a-8710-49fb261b7930",
                                                "sense_id": "f241cc0e-ca62-3d15-b43b-13f02f3bc316",
                                                "text": "„Historiker werden dann nicht mehr von Schicksal und geschichtlichen Ausnahmesituationen sprechen, sondern die Wege aufzeigen, die die Deutschen zu Hitler geführt haben; die Literaturwissenschaft beginnt sich zu erinnern, daß während des Dritten Reiches die Elite der deutschen Dichter im Exil gelebt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ba30ed1-e9a5-48f1-a8ce-6fe1d6361a67",
                        "source_entry_id": "1eb89344-e1a9-325e-a72c-f76fb14e657b",
                        "source_sense_id": "bb3d8905-af36-330a-8e0e-caec24857977",
                        "source_sense_description": "de studie van de literatuur",
                        "target_lang_word": "literature",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "literature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f50fafda-274c-35c7-81ce-709ff0f5b3fe",
                                        "entry_id": "e5a61334-4963-350d-8475-b21e5d4fc872",
                                        "glosses": [
                                            "The body of all written works."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "083f117c-0560-301c-be26-e894979d404d",
                                        "entry_id": "e5a61334-4963-350d-8475-b21e5d4fc872",
                                        "glosses": [
                                            "The collected creative writing of a nation, people, group, or culture."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c379fe46-8672-4321-a82d-3750c79d7bc5",
                                                "sense_id": "083f117c-0560-301c-be26-e894979d404d",
                                                "text": "He’s studying English literature at university."
                                            },
                                            {
                                                "example_id": "87ba8b38-7e64-4bae-87ad-980c06d87132",
                                                "sense_id": "083f117c-0560-301c-be26-e894979d404d",
                                                "text": "There’s a vast body of scientific literature on the subject."
                                            },
                                            {
                                                "example_id": "0f71bbf4-07e2-497e-8b34-42770ebb4a5b",
                                                "sense_id": "083f117c-0560-301c-be26-e894979d404d",
                                                "text": "classical literature"
                                            },
                                            {
                                                "example_id": "d626a1ea-9303-494e-8b2c-5e499277c123",
                                                "sense_id": "083f117c-0560-301c-be26-e894979d404d",
                                                "text": "scientific literature"
                                            },
                                            {
                                                "example_id": "f1b56957-2641-4517-a8a0-e264d370065e",
                                                "sense_id": "083f117c-0560-301c-be26-e894979d404d",
                                                "text": "world literature"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a1a324-2c5c-3dae-8cd1-9a7af009c63c",
                                        "entry_id": "e5a61334-4963-350d-8475-b21e5d4fc872",
                                        "glosses": [
                                            "All the papers, treatises, etc. published in academic journals on a particular subject."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd4113d-a021-441e-83cc-ca30c8916b2a",
                                                "sense_id": "e1a1a324-2c5c-3dae-8cd1-9a7af009c63c",
                                                "text": "The obvious question to ask at this point is: ‘Why posit the existence of a set of Thematic Relations (THEME, AGENT, INSTRUMENT, etc.) distinct from constituent structure relations?ʼ The answer given in the relevant literature is that a variety of linguistic phenomena can be accounted for in a more principled way in terms of Thematic Functions than in terms of constituent structure relations."
                                            },
                                            {
                                                "example_id": "8cfd696b-7110-4558-b777-254163c5f449",
                                                "sense_id": "e1a1a324-2c5c-3dae-8cd1-9a7af009c63c",
                                                "text": "In fact, information on when each of the terms first appeared in English, and if obsolete, how long they persisted, is entirely absent from the literature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f1eb258-3e0a-3aac-bdeb-ea03a06423bc",
                                        "entry_id": "e5a61334-4963-350d-8475-b21e5d4fc872",
                                        "glosses": [
                                            "Written fiction of a high standard."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38800a07-dc7c-4474-b607-f89e28ee7224",
                                                "sense_id": "7f1eb258-3e0a-3aac-bdeb-ea03a06423bc",
                                                "text": "2008, Adam Cadre\nHowever, even “literary” science fiction rarely qualifies as literature, because it treats characters as sets of traits rather than as fully realized human beings with unique life stories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb0ba1d-c99e-31f0-acdb-a0dd3277436c",
                                        "entry_id": "e5a61334-4963-350d-8475-b21e5d4fc872",
                                        "glosses": [
                                            "Literacy; ability to read and write."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2a1d1a3-5114-4e20-b948-efcc9c058adb",
                                                "sense_id": "8fb0ba1d-c99e-31f0-acdb-a0dd3277436c",
                                                "text": "They all assumed to be mighty rakish and knowing, they were not very tidy in their private dresses, they were not at all orderly in their domestic arrangements, and the combined literature of the whole company would have produced but a poor letter on any subject."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc2b6684-88c6-41eb-8402-d52cc5909217",
                        "source_entry_id": "1eb89344-e1a9-325e-a72c-f76fb14e657b",
                        "source_sense_id": "bb3d8905-af36-330a-8e0e-caec24857977",
                        "source_sense_description": "de studie van de literatuur",
                        "target_lang_word": "littérature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "littérature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ed765a-1caa-3cda-82fd-cbe7118f970b",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Ensemble des productions littéraires d’une nation, d’un pays, d’une époque et portant les marques des préoccupations esthétiques ; bel usage du langage écrit ou oral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972c13e7-1330-4879-af68-85baf458ec34",
                                                "sense_id": "a6ed765a-1caa-3cda-82fd-cbe7118f970b",
                                                "text": "Malgré la critique amère des bouffons ignorants, nous osons assurer que les lettres peuvent seules polir l’esprit, perfectionner le goût, et prêter des grâces aux sciences. Il faut même pour être profond dans la Littérature, abandonner les auteurs qui n’ont fait que l’effleurer et puiser dans les sources de l’antiquité, la connaissance de la religion, de la politique, du gouvernement, des lois, des mœurs, des coutumes, des cérémonies, des jeux, des fêtes, des sacrifices et des spectacles de la Grèce et de Rome."
                                            },
                                            {
                                                "example_id": "828bc75e-e5dc-4e6b-9d79-422c85ffbb91",
                                                "sense_id": "a6ed765a-1caa-3cda-82fd-cbe7118f970b",
                                                "text": "[…] c’était l’époque où, toute froissée de nos malheurs, si grands et si récents, la littérature semblait n’avoir d’autre occupation que de consoler notre vanité malheureuse."
                                            },
                                            {
                                                "example_id": "149a6bc6-5d69-495c-b61d-e08f9382fae9",
                                                "sense_id": "a6ed765a-1caa-3cda-82fd-cbe7118f970b",
                                                "text": "On affirme trop souvent qu’après la première génération félibréenne et les œuvres de Roumanille, d’Aubanel et de Mistral, la littérature de langue d’oc n’a point soutenu sa valeur, et que, Mistral disparu, le Félibrige a reçu un coup mortel."
                                            },
                                            {
                                                "example_id": "fb87d33b-8ae5-4678-8a38-aebf965b85d4",
                                                "sense_id": "a6ed765a-1caa-3cda-82fd-cbe7118f970b",
                                                "text": "La plus belle époque de la littérature arabe est celle qui précède le siècle des croisades. Nos premiers chevaliers sont entrés en Orient au milieu de la splendeur dont elle témoignait, car la littérature est le miroir des temps."
                                            },
                                            {
                                                "example_id": "51aa2ecc-7e4d-47e9-ba31-b16addf46348",
                                                "sense_id": "a6ed765a-1caa-3cda-82fd-cbe7118f970b",
                                                "text": "L’anglais paie le prix fort de son hégémonie. Car le « globish » disgracieux que l’on ânonne d’un bout à l’autre de notre monde globalisé n’a rien à voir avec la langue abondante, élégante et infiniment plastique qui a fait les riches heures de la littérature d’expression anglaise […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a69764-5107-3fea-af98-3725a97567d8",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Histoire littéraire, critique littéraire (portant sur des œuvres littéraires contemporaines)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d1c31c-98a0-4d40-bdce-5f518f861fe8",
                                                "sense_id": "37a69764-5107-3fea-af98-3725a97567d8",
                                                "text": "J'ai bien retrouvé sur sa figure, surtout quand il parle de M. Mairobert, l'âcreté qui fait la seule vie des articles de littérature compris dans le pamphlet rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06187c60-961a-3d4e-ac5e-802bc9f8aa70",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Domaine particulier de production éditoriale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb122d01-6d20-4538-bda5-2c1c8ba9b127",
                                                "sense_id": "06187c60-961a-3d4e-ac5e-802bc9f8aa70",
                                                "text": "La littérature érotique embrasse plus de réalités psychologiques que la morale bourgeoise ne voulait en connaître, et que le puritanisme n'en tolère. Or ces réalités, quoiqu'on en juge, sont au moins aussi quotidiennes et obsédantes que les réalités économiques, […]."
                                            },
                                            {
                                                "example_id": "e5b52dce-ccee-4c99-a895-d29ea2bd894f",
                                                "sense_id": "06187c60-961a-3d4e-ac5e-802bc9f8aa70",
                                                "text": "La lecture de la littérature gynécologique et, en particulier, celle des articles consacrés à la lutte contre la stérilité, renforce l’impression d’une grande monotonie et surtout d’une grande brièveté dans l’acte."
                                            },
                                            {
                                                "example_id": "9a899836-d0c5-4408-bf30-cec362293988",
                                                "sense_id": "06187c60-961a-3d4e-ac5e-802bc9f8aa70",
                                                "text": "Parmi la maigre littérature, en particulier francophone, concernant la malherbologie, il manquait une synthèse taxonomique sur la flore des champs cultivés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f534e9-3b13-3da1-843b-4c2dd6660a82",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Ensemble d'ouvrages ou de simples écrits typiques, produits par un groupe social particulier, ou pour un public ciblé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346b0b2e-ffb6-4c87-9769-a0da1a176297",
                                                "sense_id": "95f534e9-3b13-3da1-843b-4c2dd6660a82",
                                                "text": "On crie et on chante. Le boulangisme engendre toute une littérature de chansons - souvent d'une prosodie peu heureuse."
                                            },
                                            {
                                                "example_id": "086db844-be05-41b9-8797-0526e0912ed2",
                                                "sense_id": "95f534e9-3b13-3da1-843b-4c2dd6660a82",
                                                "text": "Les écrivains anarchistes qui demeurèrent fidèles à leur ancienne littérature révolutionnaire, ne semblent pas avoir vu de très bon œil le passage de leurs amis dans les syndicats […]."
                                            },
                                            {
                                                "example_id": "2a4d5ece-a1f4-4cd6-9a82-cc771525ed47",
                                                "sense_id": "95f534e9-3b13-3da1-843b-4c2dd6660a82",
                                                "text": "Certains articles sentent la pression, tantôt légère, tantôt brutale. Il y a un mot pour ce genre de littérature.\n— Je sais : chantage. […] Mais le chantage est un délit, Monsieur le juge. Il faut l’établir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8edeaeab-2fec-32e0-82c7-55cf77143a67",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Développement bavard, spécieux, peu sérieux et souvent amphigourique."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567ef16f-9ad1-4cb3-9674-9bb181e3126c",
                                                "sense_id": "8edeaeab-2fec-32e0-82c7-55cf77143a67",
                                                "text": "Que ton vers soit la bonne aventure\nÉparse au vent crispé du matin\nQui va fleurant la menthe et le thym…\nEt tout le reste est littérature."
                                            },
                                            {
                                                "example_id": "9521950b-ab13-4a4e-b9b6-0521d028dcc5",
                                                "sense_id": "8edeaeab-2fec-32e0-82c7-55cf77143a67",
                                                "text": "La réalité est que l'IA est un enjeu stratégique fort. Les États-Unis veulent continuer à imposer leurs entreprises et leurs produits au reste du monde, la Chine veut faire au moins jeu égal avec eux et l'Europe ne veut pas se laisser distancer. Le reste n'est que littérature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce632e6f-efc3-3cef-b6b6-63984571a707",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Bibliographie sur un sujet. Liste des ouvrages spécialisés consacrés à un sujet précis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24aa3f98-4467-48cd-b31a-300a21dd051f",
                                                "sense_id": "ce632e6f-efc3-3cef-b6b6-63984571a707",
                                                "text": "Ajoutez que dès les premiers pas, on risque de perdre pied dans la littérature myrmécophile. Elle est aussi abondante que la littérature apicole […]."
                                            },
                                            {
                                                "example_id": "d88143c5-691c-41a0-a341-d17adb6a460b",
                                                "sense_id": "ce632e6f-efc3-3cef-b6b6-63984571a707",
                                                "text": "Dans la littérature, on peut distinguer trois résultats de généralité croissante établissant l'intégralité des coefficients de Taylor d'applications miroir d'une variable lorsque |e| = |f|."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7492d5e4-6065-3b67-a6ab-2fe3482c6760",
                                        "entry_id": "cb981393-4d4f-30d0-9688-6b76effa417e",
                                        "glosses": [
                                            "Connaissance des classiques, de l’art littéraire, des principes des belles-lettres, des procédés de style, etc. Emploi vieilli ou comique ; remplacé par le mot culture en français moderne."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc2a47c-bad3-4975-afc7-25d3a8512874",
                                                "sense_id": "7492d5e4-6065-3b67-a6ab-2fe3482c6760",
                                                "text": "N’avoir point de littérature. - Avoir beaucoup de littérature."
                                            },
                                            {
                                                "example_id": "ba29a6c1-07fe-4ea7-9955-ce0cd77ee624",
                                                "sense_id": "7492d5e4-6065-3b67-a6ab-2fe3482c6760",
                                                "text": "Je ne sais s’il connaissait ses tragiques, mais il était sensible à l’honneur ; il parut flatté. Il avait quelque littérature […]"
                                            }
                                        ]
                                    }
                                ]
                            },
