                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52d76af8-9162-4891-b9ca-71fadb940c37",
                        "source_entry_id": "8f19c149-b035-34f0-a39f-1fab37ffcd16",
                        "source_sense_id": "aef8a734-2d6c-322b-92cf-4758f3b43e7f",
                        "target_lang_word": "polygame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3e9cc6-10bd-38c1-b8d5-7626dba789c4",
                                        "entry_id": "b91ab782-625d-383f-a2c9-9169ece4d5df",
                                        "glosses": [
                                            "Qui est marié ou uni à plusieurs femmes, qui est mariée ou unie à plusieurs hommes en même temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51a7f398-8b84-400c-9bfc-b0d03812eab7",
                                                "sense_id": "bc3e9cc6-10bd-38c1-b8d5-7626dba789c4",
                                                "text": "Elle est polygame."
                                            },
                                            {
                                                "example_id": "5246d871-dd6d-4dd5-b81d-1710110540b2",
                                                "sense_id": "bc3e9cc6-10bd-38c1-b8d5-7626dba789c4",
                                                "text": "L’avocat de l’homme accusé par Brice Hortefeux d’être polygame et de frauder les allocations familiales fait savoir qu’il envisage de poursuivre le ministre français de l’Intérieur en diffamation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7396b0-da13-387f-bd5b-846c7ba79859",
                                        "entry_id": "b91ab782-625d-383f-a2c9-9169ece4d5df",
                                        "glosses": [
                                            "Qui est marié ou uni à plusieurs femmes, qui est mariée ou unie à plusieurs hommes en même temps.",
                                            "Relatif à la polygamie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41f37471-efd5-4512-817e-eefc8e84ba4f",
                                                "sense_id": "4d7396b0-da13-387f-bd5b-846c7ba79859",
                                                "text": "[…] suspicion de relations polygames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d90f223-de8c-3b83-bea5-6a3afb89364c",
                                        "entry_id": "b91ab782-625d-383f-a2c9-9169ece4d5df",
                                        "glosses": [
                                            "Plantes qui portent sur le même pied des fleurs hermaphrodites et des fleurs les unes mâles, les autres femelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffcc4ff9-70af-4472-b2d0-c03d6f429ffa",
                                                "sense_id": "2d90f223-de8c-3b83-bea5-6a3afb89364c",
                                                "text": "Les mots de bissexuel et d’unisexuel, d’hermaphrodite et d’androgyne, de monoïque et de dioïque, de polygame et de dichogame… etc., n'atteignent guère jusqu'à la subtilité des distinctions qui demanderaient à être faites."
                                            },
                                            {
                                                "example_id": "7caec0d1-6040-4f83-9a0d-271ceeeedaa7",
                                                "sense_id": "2d90f223-de8c-3b83-bea5-6a3afb89364c",
                                                "text": "Plantes, végétaux polygames."
                                            },
                                            {
                                                "example_id": "a1a8295e-4bde-475b-8269-82188c93a202",
                                                "sense_id": "2d90f223-de8c-3b83-bea5-6a3afb89364c",
                                                "text": "Un forestier de l'université de Géorgie estime qu'à l'échelle mondiale, seuls 5% environ des arbres sont dioïques; les autres sont monoïques, cosexuels ou polygames, ce qui signifie qu'un même arbre peut avoir des organes reproducteurs mâles et femelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polygame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d166212-1dda-3637-ba50-d2278b0e3dae",
                                        "entry_id": "fa8a1ecb-cbae-3403-83cf-ad06008d629c",
                                        "glosses": [
                                            "Celui qui est marié ou uni à plusieurs femmes, celle qui est mariée ou unie à plusieurs hommes en même temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5714131e-3c22-47a6-b51f-70c32aacb9cb",
                                                "sense_id": "1d166212-1dda-3637-ba50-d2278b0e3dae",
                                                "text": "— Regarde : toi et moi, on vient de se sortir d'un nombre d’emmerdements que même un polygame cocu il aurait pas eu assez de femmes pour faire moins bien."
                                            },
                                            {
                                                "example_id": "1b6dbed2-4de5-404b-8377-40341fe06f43",
                                                "sense_id": "1d166212-1dda-3637-ba50-d2278b0e3dae",
                                                "text": "Premièrement, une individualisation accentuée, se traduisant par une augmentation de la mono-parentalité et des familles matricentrées (les célibataires, les femmes veuves et divorcées font partie de ce groupe, mais également une partie des femmes mariées à un polygame, […].)"
                                            },
                                            {
                                                "example_id": "1468d1a1-67e5-4828-b0c5-20b849d54c5d",
                                                "sense_id": "1d166212-1dda-3637-ba50-d2278b0e3dae",
                                                "text": "« Joe Exotic » (Joseph Maldonado-Passage de son vrai nom), polygame gay coiffé d’un mulet peroxydé et passionné de très très gros chats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
