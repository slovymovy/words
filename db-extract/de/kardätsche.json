                "senses": [
                    {
                        "sense_id": "7629c8ba-7922-38c0-b133-5744471723c2",
                        "entry_id": "32a4552e-3f72-3dce-89c3-502f2b28ae40",
                        "glosses": [
                            "eine relativ feine Bürste zum Reinigen und Glattstreichen des Fells (zum Beispiel eines Pferdes oder Rindes), nachdem es mit einem Striegel angeraut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74c4b5b-43e0-4454-af29-d36c2bb5f800",
                                "sense_id": "7629c8ba-7922-38c0-b133-5744471723c2",
                                "text": "„Das Fell wird mit Striegel und Kardätsche gepflegt. Dabei wird nicht nur der Schmutz entfernt, sondern es werden auch die Muskeln massiert und die Durchblutung gefördert. Meist wird dem Striegel kreisförmig und mit der Kardätsche wird in Fellrichtung geputzt. Mit der Wurzelbürste werden die Beine gesäubert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
