                        "sense_id": "7afea4ac-b751-31e0-b118-94044a5c2356",
                        "entry_id": "ba201b9f-38d4-3c9b-b266-7e675b5941a0",
                        "glosses": [
                            "Applying constant and enduring effort to a task or course of action; in a sedulous manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d2ed3f-559b-4d41-a18e-eeee4063f512",
                                "sense_id": "7afea4ac-b751-31e0-b118-94044a5c2356",
                                "text": "When the neighbours saw Mirbel thus sedulously adorning herself, they quickly discovered that she had ceased to think of her father—that she had ceased to mourn for him."
                            },
                            {
                                "example_id": "12d63d32-f57c-40f4-a167-56b429a61f20",
                                "sense_id": "7afea4ac-b751-31e0-b118-94044a5c2356",
                                "text": "We bought some biscuits and chocolate which we ate sedulously as we wandered through the squalid streets where the families of the fishermen live."
                            },
                            {
                                "example_id": "2c1d7590-b16d-44b4-9327-e39c986e1e3a",
                                "sense_id": "7afea4ac-b751-31e0-b118-94044a5c2356",
                                "text": "That court would sedulously avoid meeting contentious issues and would sit in resplendent dignity aloof from the issues of the day."
                            }
                        ]
                    }
                ],
