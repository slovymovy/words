                ],
                "senses": [
                    {
                        "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                        "entry_id": "6080d51f-a0cb-3da7-a29c-26a976f6d944",
                        "glosses": [
                            "Produit qui provoque une perte de l’appétit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058df99e-0912-4d9a-b39c-a018f3786ade",
                                "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                "text": "Certains anorexigènes sont souvent utilisés comme produits dopants par les sportifs."
                            },
                            {
                                "example_id": "2b320c81-de7d-4a51-9479-8d07f84609da",
                                "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                "text": "La plupart des anorexigènes appartiennent à la famille des amphétamines et sont apparentés aux stupéfiants. La plupart d’entre eux sont interdits dans de nombreux pays à cause d’effets secondaires graves."
                            },
                            {
                                "example_id": "456aca8b-1313-4c90-81e8-2e873c9c50c6",
                                "sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
                                "text": "Le principe actif de Médiator s’appelle « Benfluorex », c’est une molécule qui est très proche de l’amphétamine, l’amphétamine étant un psychostimulant, un hallucinogène et un anorexigène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cbeb449-2853-49c7-970f-e0edb8ac49cc",
                        "source_entry_id": "6080d51f-a0cb-3da7-a29c-26a976f6d944",
                        "source_sense_id": "a52c4fe9-c778-3b03-b974-c3374e8f5057",
