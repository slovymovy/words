                ],
                "senses": [
                    {
                        "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                        "entry_id": "a3cb1934-4fd5-3e76-bc5e-dda84443c814",
                        "glosses": [
                            "Mittel, das tödlich für viele Arten von Pflanzen wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d9a8e92-5a65-4c22-8102-42c7a5ecc170",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Glyphosat ist ein sog. Breitbandherbizid, d.h., es wirkt umfassend gegen jegliche Grünpflanzen.“"
                            },
                            {
                                "example_id": "90a37b92-60b3-460d-ad92-d1ee44afe4fa",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Der Photosynthesehemmer Glufosinat ist ein natürlich vorkommendes, systemisch wirkendes Breitbandherbizid.“"
                            },
                            {
                                "example_id": "0eb0172f-7f48-4431-bfa7-7e2325df5c94",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Glyphosathaltige Unkrautvernichter, zum Beispiel Roundup von Monsanto, sind sogenannte Breitbandherbizide. Sie sind für fast alle Pflanzenarten giftig.“"
                            },
                            {
                                "example_id": "005c9a1e-b74a-4616-b968-1cdcc5abade1",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Das Insektensterben führen etliche Umweltforscher auf den Einsatz von Breitbandherbiziden zurück.“"
                            },
                            {
                                "example_id": "7a885849-8071-42bb-a84e-ba1f72b897e3",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Diese indirekten Effekte durch (Zer-)Störung der Nahrungsnetze treten nicht nur bei der Anwendung von Glyphosat, sondern auch bei anderen Breitbandherbiziden auf.“"
                            },
                            {
                                "example_id": "ba4ad382-3baf-4249-bb2e-48638d6d552f",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Neben den direkten toxischen Effekten gefährdet die Wirkung als Breitbandherbizid auch zahlreiche andere Organismen, denn durch die Vernichtung der Wildkrautflora gehen Nahrungsquellen und Lebensräume verloren.“"
                            },
                            {
                                "example_id": "1d0d54db-fdf5-49e4-8860-f8297090e6dc",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Bei der Übertragung von Herbizid-Resistenzgenen besteht jedoch des weiteren das kommerzielle Interesse, Breitbandherbizide im großen Maßstab einsetzen zu können.“"
                            },
                            {
                                "example_id": "f50b3baa-7a34-4043-b226-bbad69408467",
                                "sense_id": "81e4c318-105f-341d-8bd1-80a15d181c7e",
                                "text": "„Nicht einigen konnten sich die Kreisräte darauf, auch Breitbandherbizide und Insektenvernichtungsmittel mit bienengefährlicher Einstufung zu verbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
