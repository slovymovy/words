                ],
                "senses": [
                    {
                        "sense_id": "789f1429-a8e0-3615-9fa0-07d92605db9e",
                        "entry_id": "ae9e2967-75bc-39c0-9a30-d575af7b2498",
                        "glosses": [
                            "substancja wykorzystywana w medycynie do leczenia"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0abf8a5a-817a-4835-a89e-23c77ce180d3",
                        "source_entry_id": "ae9e2967-75bc-39c0-9a30-d575af7b2498",
                        "source_sense_id": "789f1429-a8e0-3615-9fa0-07d92605db9e",
                        "target_lang_word": "médicament",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médicament",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                        "entry_id": "fc22be22-7f8c-3bba-a0ee-297b256da682",
                                        "glosses": [
                                            "Substance ou composition possédant des propriétés curatives ou préventives, destinées à guérir, à soulager ou à prévenir des maladies humaines ou animales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "044c2f35-700b-4a13-9770-15d329cc6cae",
                                                "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                                "text": "Le sucre était connu des anciens qui ne l'employaient qu'en très-petite quantité et comme médicament ; il y a 200 ans à peine, il se vendait seulement chez les pharmaciens, à un prix très-élevé."
                                            },
                                            {
                                                "example_id": "ee5c31a8-3e87-4e0d-ac88-a83d6c1a4d39",
                                                "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                                "text": "Les produits de contraste sont des médicaments de développement récent."
                                            },
                                            {
                                                "example_id": "4af52efa-883f-42be-aa79-a1fb2e10f450",
                                                "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                                "text": "Dans toutes les batailles de la Grande Guerre, l’armée russe manqua de munitions, ses ambulances manquèrent de médicaments."
                                            },
                                            {
                                                "example_id": "588a50a4-a90b-4bb4-9fdf-0422583815a9",
                                                "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                                "text": "Les médicaments s’abîment si vous ne les conservez pas dans de bonnes conditions. Ils peuvent perdre leur efficacité et même devenir dangereux."
                                            },
                                            {
                                                "example_id": "7b877bec-edca-469f-b217-8f356214a759",
                                                "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                                "text": "Il existe aussi des médicaments (warfarine) dont l'usage est destiné à ralentir la formation du caillot sanguin, à « éclaircir le sang », comme disent certains patients."
                                            },
                                            {
                                                "example_id": "a63ade8c-1723-421c-864f-7fafa07741bd",
                                                "sense_id": "5a966d81-d0ed-3cef-9ce6-db797ff278b1",
                                                "text": "Environ 25 % du prix de vente d'un médicament sert à couvrir les dépenses publicitaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "554ed5c4-ad5b-40f9-ae00-f86958ef214d",
                        "source_entry_id": "ae9e2967-75bc-39c0-9a30-d575af7b2498",
                        "source_sense_id": "789f1429-a8e0-3615-9fa0-07d92605db9e",
                        "target_lang_word": "медикамент",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "медикамент",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a18e892a-e98d-36af-8c7e-849bef9d454b",
                                        "entry_id": "e55125ab-642d-30d8-b360-ae30bc9f5bb1",
                                        "glosses": [
                                            "книжн., мед., фарм. лекарство, лекарственное средство"
                                        ],
                                        "tags": [
                                            "чаще мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2249141b-605e-44b4-9fff-9d8c45ae40ca",
                                                "sense_id": "a18e892a-e98d-36af-8c7e-849bef9d454b",
                                                "text": "Современные методы лечения патологии позвоночника более совершенны. Официальная медицина предлагает для этого целый набор процедур, медикаментов и операций."
                                            },
                                            {
                                                "example_id": "2afbb5b0-a5ca-44bc-8b48-ec877d0b07c5",
                                                "sense_id": "a18e892a-e98d-36af-8c7e-849bef9d454b",
                                                "text": "Гарнизон крепости был обеспечен и предметами санитарного снабжения ― перевязочными материалами, медикаментами и прочим ― и мог пользоваться санитарными поездами, которые доставляли раненых, больных и отравленных в тыловые госпитали."
                                            },
                                            {
                                                "example_id": "93240b7f-85e5-4af5-a050-e39c3a44fb1e",
                                                "sense_id": "a18e892a-e98d-36af-8c7e-849bef9d454b",
                                                "text": "Страдая пороком сердца, он не раз за весь вечер уходил в мой соседний кабинет и принимал различные медикаменты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
