                "senses": [
                    {
                        "sense_id": "9edce335-f171-35f4-b47c-4f97c1e5f1ac",
                        "entry_id": "950be7ac-de30-358a-8ed1-2b0ab52c7c54",
                        "glosses": [
                            "To look; to pay attention to with one’s eyes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b12561ec-e70d-4421-853c-b04706180514",
                                "sense_id": "9edce335-f171-35f4-b47c-4f97c1e5f1ac",
                                "text": "Now kool my downy kicksies—the style for me, / Built on a plan werry naughty,"
                            },
                            {
                                "example_id": "526c40fd-c960-4a16-86dc-353b2cf323cd",
                                "sense_id": "9edce335-f171-35f4-b47c-4f97c1e5f1ac",
                                "text": "We had not been engaged in our reading very long when at the far end of the arch I noticed a twinkling light. \"Kool esclop!\" shouted one of the boys, at the same moment doucing the glim and bolting with his companion, leaving me in the dark with my upset beer bottle and my douced candle, forming a spectacle which seemed to arouse suspicion on the part of our friend the policeman, whose light it was that had appeared in the distance."
                            },
                            {
                                "example_id": "6eaf750f-a9e3-4b28-87f6-df20c6d9cdb0",
                                "sense_id": "9edce335-f171-35f4-b47c-4f97c1e5f1ac",
                                "text": "“Kool retfa the posh” he’d call to Mum, “I’m going to ekat the yenom to the kaynab” Somewhere Dad had learnt Backslang and this was the preferred medium of communication between him and Mum when there were customers in the shop. What he had just said was, “Look after the shop, I’m taking the money to the bank”"
                            }
                        ]
                    }
                ],
