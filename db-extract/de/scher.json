                ],
                "senses": [
                    {
                        "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                        "entry_id": "aa1fad96-42fc-3e80-a6fe-49a1e10e0d47",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97af63de-c361-419e-bff4-400af079814a",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Frau Scher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cb1a0400-8095-43f4-b435-b38f9e159197",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Herr Scher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0189565c-846d-4b5e-aaec-c605f331fa30",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Die Schers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a7a6aa8f-afaf-4fd8-8eca-3769d73bce99",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Der Scher trägt nie die Schals, die die Scher ihm strickt."
                            },
                            {
                                "example_id": "c3ff2b25-1bc8-4f38-9baf-bac423c662f1",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scher kommt, geht der Herr Scher.“"
                            },
                            {
                                "example_id": "ab149f53-2182-46b7-9a7a-a0dc10689396",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Scher kommt und geht."
                            },
                            {
                                "example_id": "62eb8728-01d8-4153-8cf7-721adbfc0322",
                                "sense_id": "1d5a2637-ea81-3ce5-922b-261ca7c8bcc2",
                                "text": "Schers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
