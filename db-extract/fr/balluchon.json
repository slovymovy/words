                                    {
                                        "sense_id": "9f2422d4-a314-3957-ab1f-283f089bda45",
                                        "entry_id": "117996b0-6c1a-339c-8911-a448f5f2eba0",
                                        "glosses": [
                                            "A large quantity (of something)."
                                        ],
                                        "tags": [
