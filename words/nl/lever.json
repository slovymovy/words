            "pos": "noun",
            "senses": [
                {
                    "sense_id": "798bb099-c380-3b6d-8db2-5219d74b2a3e",
                    "sense_definition": "Een groot vitaal orgaan in het lichaam dat helpt bij de spijsvertering en het zuiveren van het bloed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter onderzocht of de <w>lever</w> van de patiënt nog goed functioneerde.",
                            "target_lang_translations": {
                                "en": "The doctor examined whether the patient's <w>liver</w> was still functioning properly.",
                                "ru": "Врач проверил, хорошо ли всё ещё функционирует <w>печень</w> пациента."
                            }
                        },
                        {
                            "text": "Overmatig alcoholgebruik kan ernstige schade toebrengen aan de menselijke <w>lever</w>.",
                            "target_lang_translations": {
                                "en": "Excessive alcohol consumption can cause serious damage to the human <w>liver</w>.",
                                "ru": "Чрезмерное употребление алкоголя может нанести серьезный вред человеческой <w>печени</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "menselijke lever"
                    ],
                    "target_lang_definitions": {
                        "en": "A large vital organ in the body that helps with digestion and purifying the blood.",
                        "ru": "Крупный жизненно важный орган в теле, который помогает пищеварению и очищению крови."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "liver",
                                "target_lang_sense_clarification": "anatomical organ"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "печень",
                                "target_lang_sense_clarification": "анатомический орган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b63ef341-fb94-3024-bb45-b1df362ab6ac",
                    "sense_definition": "Het orgaan van een dier dat wordt gebruikt als voedsel of ingrediënt in de keuken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit restaurant serveren ze gebakken <w>lever</w> met uien en spek.",
                            "target_lang_translations": {
                                "en": "In this restaurant, they serve fried <w>liver</w> with onions and bacon.",
                                "ru": "В этом ресторане подают жареную <w>печень</w> с луком и беконом."
                            }
                        },
                        {
                            "text": "Veel mensen vinden de smaak van <w>lever</w> te sterk voor hun persoonlijke voorkeur.",
                            "target_lang_translations": {
                                "en": "Many people find the taste of <w>liver</w> too strong for their personal preference.",
                                "ru": "Многие люди находят вкус <w>печени</w> слишком специфическим для своих предпочтений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gebakken lever"
                    ],
                    "target_lang_definitions": {
                        "en": "The organ of an animal used as food or an ingredient in cooking.",
                        "ru": "Орган животного, используемый в качестве пищи или ингредиента в кулинарии."
                    },
                    "translations": {
