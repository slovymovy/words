                "entry_id": "9bc940ab-40c6-3c40-a66f-74579a278dd2",
                "word": "dirigisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a7f35d1-b0ce-4468-a3e3-3d40fc5db081",
                        "entry_id": "9bc940ab-40c6-3c40-a66f-74579a278dd2",
                        "tags": [
                            "plural"
                        ],
                        "form": "dirigismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f5f2fbb-d59a-3fbc-86b0-a5e3d4b4d203",
                        "entry_id": "9bc940ab-40c6-3c40-a66f-74579a278dd2",
                        "glosses": [
                            "Système dans lequel l’État dirige l’économie du pays ou influe sur son orientation, sans sortir du cadre de l’économie capitaliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df6ab884-a481-4db2-8e11-a7a299b27efb",
                                "sense_id": "1f5f2fbb-d59a-3fbc-86b0-a5e3d4b4d203",
                                "text": "Le dirigisme et le néo-libéralisme avaient une vision plus profonde et donc aussi plus critique des défaillances répétées du système économique et ils considéraient tous deux que l’instabilité était avant tout liée à des perturbations dans l’allocation des ressources, sous l’effet de la mutation des structures productives et des comportements concurrentiels."
                            }
                        ]
                    },
                    {
                        "sense_id": "57ef1b97-d275-3a56-a689-08dd2f869c3e",
                        "entry_id": "9bc940ab-40c6-3c40-a66f-74579a278dd2",
                        "glosses": [
                            "Orientation donnée par l’État dans différents domaines."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b06d6186-ac25-41b7-a5a3-75adaa7d7bbf",
                                "sense_id": "57ef1b97-d275-3a56-a689-08dd2f869c3e",
                                "text": "Dirigisme culturel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fa827f2-19b7-4253-8764-e4d05b5a190a",
                        "source_entry_id": "9bc940ab-40c6-3c40-a66f-74579a278dd2",
                        "target_lang_word": "dirigisme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dirigisme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a17fb8-912e-3e40-8624-b00be40b665c",
                                        "entry_id": "d19e8d64-669f-3354-9425-e1378ab40bc8",
                                        "glosses": [
                                            "A policy of strong state control over the economy and related social matters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a45112cb-adb7-429a-9a88-7907acce708b",
                                                "sense_id": "e8a17fb8-912e-3e40-8624-b00be40b665c",
                                                "text": "In the name of development, the reformed states adopted the dirigisme of colonial administration – forced labour re-emerged in them as well."
                                            },
                                            {
                                                "example_id": "4e37d0ec-fba3-4b43-8330-eec2dea190c1",
                                                "sense_id": "e8a17fb8-912e-3e40-8624-b00be40b665c",
                                                "text": "These agents, for the same distributional and paternalistic reasons that motivated many of the socialist experiments in economic dirigisme, may seek to use political authority to modify, at least in part, the results of the market system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
