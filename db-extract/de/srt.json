                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c3e92272-6ecf-3ae6-b822-8ee95dcb44e0",
                        "entry_id": "53926f5e-2603-38c9-a196-6579501029ba",
                        "glosses": [
                            "Schule für Rundfunktechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540072b3-b74e-498b-abe9-5b8c6c68b8b8",
                                "sense_id": "c3e92272-6ecf-3ae6-b822-8ee95dcb44e0",
                                "text": "Seit geraumer Zeit sind Vorbereitungen auf Seiten der beteiligten öffentlich-rechtlichen Rundfunkanstalten zu einer Zusammenlegung von SRT und ZFP im Gange."
                            }
