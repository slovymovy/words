                    {
                        "sense_id": "d427a4c6-5479-3b8c-94cf-c36248f7d86d",
                        "entry_id": "c42caed3-d6a6-3316-9b7d-8e8dc21261da",
                        "glosses": [
                            "Réunion des parents avec les professeurs dans une école, typiquement organisée le soir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70597bdc-7459-4ef4-8d45-c52c118bc006",
                                "sense_id": "d427a4c6-5479-3b8c-94cf-c36248f7d86d",
                                "text": "Meine Mutter kommt fast nie zum Elternabend, und wenn doch, dann mit Fahne.",
                                "translation": "Ma mère ne vient presque jamais à la réunion des parents d'élèves, et quand elle y vient, c'est avec haleine alcoolisée."
                            }
                        ]
                    }
                ],
