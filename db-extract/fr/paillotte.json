                        "examples": [
                            {
                                "example_id": "1b10416a-2a4a-46bf-b950-b0962da8a7fa",
                                "sense_id": "5a23290d-8a51-359e-9730-d0f740af71c4",
                                "text": "Pour éviter que les termites ne détruisent ma paillotte, j’avais fait poser ses quatre pied dans ds boîtes de conserve emplies d’huile de vidange."
                            },
                            {
                                "example_id": "e4b08de6-c409-4464-80ec-dfd38624bc7e",
                                "sense_id": "5a23290d-8a51-359e-9730-d0f740af71c4",
                                "text": "Ce terme signifiait tout simplement que le règne des paillottes prévalait celui des bâtiments en dur, que le moindre indigène voulait s’affubler d'un veston à l’indienne, d'un chèche de policier, et que la plus grande pagaille régnait en moins de six mois."
                            }
                        ]
