                ],
                "translations": [
                    {
                        "translation_id": "dce3e047-cac0-41f8-900a-7b61f5a7245f",
                        "source_entry_id": "b5a28690-c5fb-304e-809f-6edb431c02e1",
                        "source_sense_id": "049a0514-87f9-37fb-b995-a4b0fa1b7bb5",
                        "target_lang_word": "Schneewittchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneewittchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8f830b-966a-3739-ac25-595430ed75a9",
                                        "entry_id": "e40aa6db-c69b-3349-a119-5a4c1a86bfe4",
                                        "glosses": [
                                            "sehr altes europäisches Märchen und Märchenfigur/Titelgestalt/Titelfigur, die wegen ihrer überirdischen Schönheit von ihrer königlichen Stiefmutter verfolgt wurde und Schutz bei den sieben Zwergen fand (auch bekannt unter den Bezeichnungen Schneeweißchen und Sneewittchen)"
                                        ],
                                        "tags": [
                                            "Märchen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34da6d65-1a49-4a50-81d9-65bc17246ce9",
                                                "sense_id": "cf8f830b-966a-3739-ac25-595430ed75a9",
                                                "text": "Das Märchen Schneewittchen erschien 1812 bei den Gebrüdern Grimm als 53. Märchen im ersten Band der „Kinder- und Hausmärchen“."
                                            },
                                            {
                                                "example_id": "5e7df9a6-c763-4640-8456-c44f4429759c",
                                                "sense_id": "cf8f830b-966a-3739-ac25-595430ed75a9",
                                                "text": "„… Frau Königin! Sie sind die schönste hier! Aber Schneewittchen hinter den Bergen bei den sieben Zwergen ist tausendmal schöner als ihr.“"
                                            },
                                            {
                                                "example_id": "b8b262e8-4ff7-4e56-bbae-c6d3b6a74497",
                                                "sense_id": "cf8f830b-966a-3739-ac25-595430ed75a9",
                                                "text": "Schneewittchen sucht ihre Zwerge und ein Mädchen liegt ohne Decke in der kühlen Nacht auf dem Bett."
                                            },
                                            {
                                                "example_id": "e60bf70b-abf4-47a6-b393-416958e258a7",
                                                "sense_id": "cf8f830b-966a-3739-ac25-595430ed75a9",
                                                "text": "Ist David Ortegas (30) \"Schneewittchen\" in Wahrheit die böse Königin aus dem gleichnamigen Märchen?"
                                            },
                                            {
                                                "example_id": "cdda0d77-8a29-432b-95e4-9c1b3d8e29d9",
                                                "sense_id": "cf8f830b-966a-3739-ac25-595430ed75a9",
                                                "text": "Look des Tages Lizzy Caplan schön wie Schneewittchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "053694cf-0e3e-4be1-80b2-e80a2ddcf090",
                        "source_entry_id": "b5a28690-c5fb-304e-809f-6edb431c02e1",
                        "source_sense_id": "049a0514-87f9-37fb-b995-a4b0fa1b7bb5",
                        "target_lang_word": "Snow White",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Snow White",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1795cbf4-bfe1-382a-8bc6-372012bf4e61",
                                        "entry_id": "8e8dfb48-0988-31a8-9d61-3540407c5819",
                                        "glosses": [
                                            "A fairy tale, the best-known version of Schneewittchen collected by the Brothers Grimm, in which a beautiful young girl is targeted by a jealous queen and tended by dwarfs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c77b4f48-6280-31d0-83df-b6b89467b719",
                                        "entry_id": "8e8dfb48-0988-31a8-9d61-3540407c5819",
                                        "glosses": [
                                            "The main character in that story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d0eb8e-01ab-4c89-95ec-4872b227bed5",
                                                "sense_id": "c77b4f48-6280-31d0-83df-b6b89467b719",
                                                "text": "There is no shortage of little girls dressed as Sleeping Beauties, Snow Whites, Cinderellas, or even any of the princess “rebels” such as Ariel (who gave up her voice for a man) or Belle (who endured captivity as a pathway to love)."
                                            },
                                            {
                                                "example_id": "fc54ed81-9b1d-46e4-bd41-3cc55c40ee5d",
                                                "sense_id": "c77b4f48-6280-31d0-83df-b6b89467b719",
                                                "text": "The discovery of male Cinderellas and Snow Whites in modern Turkish folklore invites further meditations and investigations."
                                            },
                                            {
                                                "example_id": "19a2ea40-24cf-4837-89c9-9bf17f702dab",
                                                "sense_id": "c77b4f48-6280-31d0-83df-b6b89467b719",
                                                "text": "Though it is often up to the Prince Charming of each novel to sweep the Austenian Snow Whites and Cinderellas off their feet, it is often up to the Snow Whites and Cinderellas to teach their respective heroes a little sense—or, in the case of Colonel Brandon and his all-but-impassioned Shakespeare reading, a little sensibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b9e51f-3c03-3d95-ba83-b9923a2ddf3c",
                                        "entry_id": "8e8dfb48-0988-31a8-9d61-3540407c5819",
                                        "glosses": [
                                            "A fictional character in the fairy tale Snow-White and Rose-Red, from Schneeweißchen und Rosenrot collected by the Brothers Grimm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2009b03b-cf9c-4bb4-aaa4-8de31661105a",
                        "source_entry_id": "b5a28690-c5fb-304e-809f-6edb431c02e1",
                        "source_sense_id": "049a0514-87f9-37fb-b995-a4b0fa1b7bb5",
