                "senses": [
                    {
                        "sense_id": "b42702d9-53fa-3f0f-a6e8-bb8861bafa0a",
                        "entry_id": "d67e1a09-3e7d-35a9-abba-4d6c1c0ff6b1",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße den guten Sitten widersprechendes (amoralisches) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ac4433-2dd2-4ac8-98f5-4f3b57f1ae97",
                                "sense_id": "b42702d9-53fa-3f0f-a6e8-bb8861bafa0a",
                                "text": "„Schön will seine eigene Amoralität auf die Frau projizieren und sich gleichzeitig von dieser Amoralität freisprechen, das funktioniert aber nur, wenn die Frau diese Projektion hinnimmt. Lulu aber geht offensiv mit ihrer Amoralität um.“"
                            },
                            {
                                "example_id": "7e326b0b-b491-48d9-8f91-e4f9fbf7e54a",
                                "sense_id": "b42702d9-53fa-3f0f-a6e8-bb8861bafa0a",
                                "text": "Der marktwirtschaftlichen Ordnung wird immer wieder der Vorwurf der Amoralität gemacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
