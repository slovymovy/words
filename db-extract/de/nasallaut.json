                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3619aeaf-d817-3f22-bb16-35853195ce04",
                                        "entry_id": "c94a02ff-0d79-3248-88a2-ce9fccbf7cb6",
                                        "glosses": [
                                            "Ellipsis of nasal vowel."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02139cba-f7fb-303f-b54e-3f20eb8dd2f2",
                                        "entry_id": "c94a02ff-0d79-3248-88a2-ce9fccbf7cb6",
                                        "glosses": [
                                            "The part of a helmet projecting to protect the nose; a nose guard."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47ef5da-a66f-4227-968c-80ec1b26b6a9",
                                                "sense_id": "02139cba-f7fb-303f-b54e-3f20eb8dd2f2",
                                                "text": "The nasal continued in use until about 1140, when it was generally discarded, but isolated examples may be found in every succeeding century down to the seventeenth."
                                            },
                                            {
                                                "example_id": "a98957f6-71ae-4ec4-80f1-ecdbea950292",
                                                "sense_id": "02139cba-f7fb-303f-b54e-3f20eb8dd2f2",
                                                "text": "Rorge had donned a black halfhelm with a broad iron nasal that made it hard to see that he did not have a nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00dfb45-4b43-3a02-8bb2-1358e7fd7bfe",
                                        "entry_id": "c94a02ff-0d79-3248-88a2-ce9fccbf7cb6",
                                        "glosses": [
                                            "Ellipsis of nasal bone."
