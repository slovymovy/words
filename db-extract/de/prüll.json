                                "sense_id": "b651b539-93b6-3ec9-8e25-4e6af6fdb552",
                                "text": "Du musst mal deinen Prüll aus der Küche wegräumen!",
                                "translation": "You need to remove your stuff from the kitchen.",
                                "english": "You need to remove your stuff from the kitchen."
                            },
                            {
                                "example_id": "de4c8a95-eafb-44e7-a276-540ad0989ce0",
                                "sense_id": "b651b539-93b6-3ec9-8e25-4e6af6fdb552",
                                "text": "Den ganzen Prüll hier schmeiß ich jetzt weg.",
                                "translation": "I'm throwing out all this junk now.",
                                "english": "I'm throwing out all this junk now."
                            }
                        ]
                    }
