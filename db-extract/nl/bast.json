                "senses": [
                    {
                        "sense_id": "dffa214a-67f3-3a12-a697-db24568d878d",
                        "entry_id": "53db11ec-0855-371a-af6d-71915345218b",
                        "glosses": [
                            "buitenste laag van een boom, meestal het geheel van schors en aangroeilaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "166cfdb6-b101-4bd6-8c2d-151eaa5774ae",
                                "sense_id": "dffa214a-67f3-3a12-a697-db24568d878d",
                                "text": "De bast van een berk is wit."
                            },
                            {
                                "example_id": "9433f696-9ba1-4b00-b44d-46cc275d8983",
                                "sense_id": "dffa214a-67f3-3a12-a697-db24568d878d",
                                "text": "Mijn wandelstokken prikte ik heel voorzichtig in de bast van de boom en aarzelend deed ik mijn eerste stappen over de rivier."
                            },
                            {
                                "example_id": "3f18c932-229b-45a7-923a-bb27cef02de2",
                                "sense_id": "dffa214a-67f3-3a12-a697-db24568d878d",
                                "text": "Met zijn rijtjeshuis, met een raam waar ze nooit echt door naar buiten kijken, omdat ze denken dat ze iedere struik, iedere bloem, de bast van elke boom, de stemming van elke wolk, al kennen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c21a20c-1f8b-3d58-a794-beef80c39fbb",
                        "entry_id": "53db11ec-0855-371a-af6d-71915345218b",
                        "glosses": [
                            "fluweelachtige huid rond een nieuw gewei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3491ab7-c56b-4f80-b086-146936e70c5c",
                                "sense_id": "1c21a20c-1f8b-3d58-a794-beef80c39fbb",
                                "text": "Nadat het gewei volgroeid is moet de bast er nog vanaf."
                            }
                        ]
                    },
                    {
                        "sense_id": "d47e964c-3d56-3660-8556-d7f50a0dfa1c",
                        "entry_id": "53db11ec-0855-371a-af6d-71915345218b",
                        "glosses": [
                            "lichaam: gisteren nog in blote bast op 't strand, nu alweer aan 't werk"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
