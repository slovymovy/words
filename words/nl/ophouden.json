                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "handhaven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeert altijd de schone schijn <w>op te houden</w> voor de buren.",
                            "target_lang_translations": {
                                "en": "She always tries to <w>keep up</w> appearances for the neighbors."
                            }
                        },
                        {
                            "text": "Het is lastig om die traditie in deze tijd <w>op te houden</w>.",
                            "target_lang_translations": {
                                "en": "It is difficult to <w>maintain</w> that tradition in this day and age."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de schone schijn ophouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to maintain or preserve something, often an impression or outward appearance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep up",
                                "target_lang_sense_clarification": "to maintain an appearance or tradition"
                            },
                            {
                                "target_lang_word": "maintain",
                                "target_lang_sense_clarification": "to keep something in existence"
                            },
                            {
                                "target_lang_word": "uphold",
                                "target_lang_sense_clarification": "to support or maintain a custom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f40e3643-14a7-3b6a-9523-a382c282fdff",
