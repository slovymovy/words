                        "entry_id": "07ea8d4b-0c47-3bb8-ba1a-388efac5da90",
                        "glosses": [
                            "in een auto ingebouwde radio (vaak tevens voorzien van cd-speler etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80fe1d9c-580f-41b1-92b9-5c45f78f51c5",
                                "sense_id": "6b370625-7e5c-3db6-ad4a-393d2b3fb17c",
                                "text": "In de spreektaal heeft men het nog steeds over de autoradio, maar in de praktijk is het ondertussen een multimediaal instrument, dat ook een functie kan hebben in telefonie en navigatie"
                            },
                            {
                                "example_id": "d7fa7456-d774-4418-a7be-28ee4660ecd7",
                                "sense_id": "6b370625-7e5c-3db6-ad4a-393d2b3fb17c",
                                "text": "De autoradio staat hard aan. Eén van de mannen zit in de auto. Een paar anderen staan er omheen. Als er meisjes langs komen, fluiten of roepen ze naar hen."
                            }
                        ]
                    }
