                "senses": [
                    {
                        "sense_id": "d88dc9d3-053d-3ed9-85c4-a7427cd3b4b3",
                        "entry_id": "f59a9d1a-006b-374c-a4dc-a5d54b13bc1e",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным граница; свойственный, характерный для него; лежащий на границе, пограничный"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30badb99-7622-4b49-89d8-7a7ad195698c",
                        "source_entry_id": "f59a9d1a-006b-374c-a4dc-a5d54b13bc1e",
                        "source_sense_id": "d88dc9d3-053d-3ed9-85c4-a7427cd3b4b3",
                        "target_lang_word": "boundary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boundary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50126164-b40a-3c16-a068-d2af3c4c8cfd",
                                        "entry_id": "009733bc-9c03-3af3-9e50-7be0ea870820",
                                        "glosses": [
                                            "the dividing line or location between two areas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09773707-dbd4-4e00-8c93-ad39989e816d",
                                                "sense_id": "50126164-b40a-3c16-a068-d2af3c4c8cfd",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "60e8ab50-74a8-4aed-8476-9e351e5a6452",
                                                "sense_id": "50126164-b40a-3c16-a068-d2af3c4c8cfd",
                                                "text": "City or national boundaries are locations of economic opportunity, especially if the existence of the border is itself the source of a monopoly situation that favors one side over the other (Krakover, 1997)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5abec92-f70d-3537-baba-14b3d60ba1fc",
                                        "entry_id": "009733bc-9c03-3af3-9e50-7be0ea870820",
                                        "glosses": [
                                            "the bounds, confines, or limits between immaterial things (such as one’s comfort zone, privacy, or professional sphere and the realm beyond)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e5917d0-5a18-4698-a315-ea3b67e1311e",
                                                "sense_id": "c5abec92-f70d-3537-baba-14b3d60ba1fc",
                                                "text": "I didn’t mean to push the boundaries by sending my boss a message on Saturday night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f38a18-ec20-32a7-805a-fc1d440da926",
                                        "entry_id": "009733bc-9c03-3af3-9e50-7be0ea870820",
                                        "glosses": [
                                            "an edge or line marking an edge of the playing field"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04ff5faf-30e8-35e7-98e0-e8c930be95e0",
                                        "entry_id": "009733bc-9c03-3af3-9e50-7be0ea870820",
                                        "glosses": [
                                            "an event whereby the ball is struck and either touches or passes over a boundary (with or without bouncing), usually resulting in an award of 4 (four) or 6 (six) runs respectively for the batting team"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08313246-be76-4584-b801-85bbe7f172f0",
                                                "sense_id": "04ff5faf-30e8-35e7-98e0-e8c930be95e0",
                                                "text": "Travis hit a boundary to seal the match on the last ball of the over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8200dff7-af86-30e0-a7a0-ce4986d60d67",
                                        "entry_id": "009733bc-9c03-3af3-9e50-7be0ea870820",
                                        "glosses": [
                                            "(of a set) the set of points in the closure of a set S, not belonging to the interior of that set"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2624eb1a-9dc0-3205-b817-e815cce84ea8",
                                        "entry_id": "009733bc-9c03-3af3-9e50-7be0ea870820",
                                        "glosses": [
                                            "commission paid by a bus or jeepney driver to a public transportation operator for taking passengers, or the excess collected fares taken as daily wage"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
