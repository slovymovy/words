                "senses": [
                    {
                        "sense_id": "31b0b66d-7835-3f38-9ade-f30456135fe7",
                        "entry_id": "bc3e42b7-37f9-3d2f-ae67-9be3c1b4c196",
                        "glosses": [
                            "Stellenwertsystem zur Basis 16"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f08072b-6488-412e-a3cc-266b16db76b0",
                                "sense_id": "31b0b66d-7835-3f38-9ade-f30456135fe7",
                                "text": "Aus Mangel an genügend Ziffern werden im Hexadezimalsystem oft zusätzlich die Buchstaben von A bis F benutzt."
                            },
                            {
                                "example_id": "fdae6f46-e07f-4c20-a3cd-1a97968b67aa",
                                "sense_id": "31b0b66d-7835-3f38-9ade-f30456135fe7",
                                "text": "Die Zahl „165“ im Dezimalsystem bekommt im Hexadezimalsystem die Form „A5“: A (auf 2. Stelle von rechts) ≙ 10 * 16¹ = 160 plus 5 (auf 1. Stelle von rechts) ≙ 5 * 16⁰ = 5"
                            },
                            {
                                "example_id": "4aad1c24-017e-43dc-9d4b-a928658b9f48",
                                "sense_id": "31b0b66d-7835-3f38-9ade-f30456135fe7",
                                "text": "Maschinen rechnen üblicherweise im Binärsystem, um es leichter lesen zu können, wird oft das Hexadezimalsystem als Lesehilfe genutzt."
                            },
                            {
                                "example_id": "133b3bf7-9e34-498d-9046-5b1c21239b2a",
                                "sense_id": "31b0b66d-7835-3f38-9ade-f30456135fe7",
                                "text": "„Auch mit dem Binär- und Hexadezimalsystem wusste er dann später als Erstklässler seine Lehrerin zu verblüffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
