                    {
                        "translation_id": "8b230c0e-bf3c-4517-b1f0-9dd92417d580",
                        "source_entry_id": "caf5dae1-877b-302b-9c5e-89912383322b",
                        "source_sense_id": "2abd6ea1-bb91-3ee4-9a48-de1dc397fac5",
                        "source_sense_description": "Toilettenanlage im Außenbereich von mittelalterlichen Burgen",
                        "target_lang_word": "gemak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9fc91d1c-48d9-3507-a26b-840d747426b9",
                                        "entry_id": "0bbd7cc8-7a96-3db0-83ec-1a6831506b8b",
                                        "glosses": [
                                            "op een rustige en eenvoudige manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95266014-686f-4f4f-ad55-5e43e2d68ddd",
                                                "sense_id": "9fc91d1c-48d9-3507-a26b-840d747426b9",
                                                "text": "Hij kon op zijn gemak de folders uitzoeken."
                                            },
                                            {
                                                "example_id": "70e6be4e-dbfe-4789-b629-3fde25998c0f",
                                                "sense_id": "9fc91d1c-48d9-3507-a26b-840d747426b9",
                                                "text": "De Franse traditie ziet er heel anders uit, zoals de Britse trendwatcher Stephen Bayley opmerkte. Je rijdt op je gemak over een met platanen omzoomde tweebaansweg, in een comfortabele auto, bij voorkeur een Citroën DS. Ondertussen zoekt je passagier in de Michelingids een restaurant waar je goed en uitgebreid kunt lunchen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94da9ff0-3ec1-3132-b0c0-34d64491dc4d",
                                        "entry_id": "0bbd7cc8-7a96-3db0-83ec-1a6831506b8b",
                                        "glosses": [
                                            "zonder spanning of angst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8adf9a24-699d-405d-b925-492098c909b0",
                                                "sense_id": "94da9ff0-3ec1-3132-b0c0-34d64491dc4d",
                                                "text": "Langzamerhand kwam ik in een gestage cadans en ik begon me steeds meer op mijn gemak te voelen in deze omgeving."
                                            },
                                            {
                                                "example_id": "f8e04b07-c478-4edc-b142-6ab573a86002",
                                                "sense_id": "94da9ff0-3ec1-3132-b0c0-34d64491dc4d",
                                                "text": "In de hoofse literatuur was de ideale ridder geen houwdegen zoals Willem de Maarschalk, maar een smooth operator die zich op zijn gemak voelde aan het hof en in gezelschap van dames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "112c6bad-7953-3a4f-85f8-607cbe631db3",
                                        "entry_id": "0bbd7cc8-7a96-3db0-83ec-1a6831506b8b",
                                        "glosses": [
                                            "zonder al teveel moeite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "329d699b-d996-4a3e-adf5-b0603cc77cb0",
                                                "sense_id": "112c6bad-7953-3a4f-85f8-607cbe631db3",
                                                "text": "Met groot gemak schoot hij de voetbal in de kruising."
                                            },
                                            {
                                                "example_id": "5bdfd6c1-79a9-4eb3-a2d9-62c8f5028ba3",
                                                "sense_id": "112c6bad-7953-3a4f-85f8-607cbe631db3",
                                                "text": "Het is niet eens de boosheid over hun slippertje die de boventoon voert, het zijn de jaren aan opgekropte woede over het gemak waarmee Annet een plek veroverde in ons familiesysteem, alsof het haar eigen familie was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
