                    }
                ],
                "senses": [
                    {
                        "sense_id": "608db752-2bba-3744-9b89-7a890ac875e3",
                        "entry_id": "8e716c1e-1511-31cc-b93c-777f764e071a",
                        "glosses": [
                            "betrekking hebbend op de geest, de psyche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cae3b15-c43c-42d0-ba38-aba4e9b2e021",
                                "sense_id": "608db752-2bba-3744-9b89-7a890ac875e3",
                                "text": "De pasgeboren baby was geestelijk gezond."
                            },
                            {
                                "example_id": "bdb845ac-60b6-45a0-b7bd-8368e32f0337",
                                "sense_id": "608db752-2bba-3744-9b89-7a890ac875e3",
                                "text": "Ik had gehoord dat de trail geestelijk veel zwaarder zou zijn dan lichamelijk. Vooraf kon ik me hier niks bij voorstellen maar nu werd het me langzaam duidelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1154d69-f5d8-3dd9-b491-1fd18093df35",
                        "entry_id": "8e716c1e-1511-31cc-b93c-777f764e071a",
                        "glosses": [
                            "betrekking hebbend op godsdienst"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc0f165c-22ea-4f18-834d-3e52c846c041",
                        "source_entry_id": "8e716c1e-1511-31cc-b93c-777f764e071a",
                        "source_sense_id": "608db752-2bba-3744-9b89-7a890ac875e3",
                        "source_sense_description": "met betrekking tot de geest",
                        "target_lang_word": "geistig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geistig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                        "entry_id": "e2197456-6984-3d80-98da-5ab71a0b20a9",
                                        "glosses": [
                                            "den menschlichen Geist, die Gedanken betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178ef854-d1f7-4b57-afdc-1a7d739a00a7",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "Man sollte sich nicht nur körperlich, sondern auch geistig anstrengen."
                                            },
                                            {
                                                "example_id": "5423c1c0-76e9-44f4-b688-39cdedfdc61a",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "Der alte Herr ist geistig noch topfit."
                                            },
                                            {
                                                "example_id": "74e0279d-dc6e-45d2-b09d-39316943d0ec",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "„Die Intelligenz, das geistige Leistungsvermögen, zeigt sich darin, inwieweit ein Lebewesen in der Lage ist, Probleme in einer gegebenen Umwelt situationsgerecht und rasch zu lösen.“"
                                            },
                                            {
                                                "example_id": "8b97da24-04aa-4f66-b3c3-4b8f49eece67",
                                                "sense_id": "fb9aae49-7055-3c28-9f0e-16398d957a67",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                        "entry_id": "e2197456-6984-3d80-98da-5ab71a0b20a9",
                                        "glosses": [
                                            "Alkohol enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da19d14a-649e-4df0-879e-617c36e685a4",
                                                "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                                "text": "An diesem Abend flossen hauptsächlich geistige Getränke."
                                            },
                                            {
                                                "example_id": "82d64c8f-eea9-4cd5-84d1-0a5a4bdfdaeb",
                                                "sense_id": "5cb172dc-8df9-301a-8814-5cd045520540",
                                                "text": "Eine dünne, klare, röhlich-gelbe, geistige Flüssigkeit, welche, besonders wenn sie in der flachen Hand gerieben oder auf einem erhitzten Bleche verdampft einen eigenen lieblichen Geruch äußert und einen süßlichen, zugleich etwas scharfen und gelind etwas balsamischen Geschmack besitzt. (1825)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
