                    {
                        "sense_id": "3d3e2fe4-ba70-3025-bb69-9ce0d7d66c68",
                        "entry_id": "f198dd61-a71b-3af4-94c1-7be67174f6bf",
                        "glosses": [
                            "in Gedichtform gefasster Liebesbrief einer fiktiven, illustren Figur, (zumeist) einer Heroin, eines Heroen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e6a623-8853-4025-93af-3d909d7274f6",
                                "sense_id": "3d3e2fe4-ba70-3025-bb69-9ce0d7d66c68",
                                "text": "„Die Auseinandersetzung mit der Form der Heroide bringt Platen in direkten Zusammenhang mit der Liebe zu Fritz: Heute endlich hatte ich ein paar Dichterstunden, die ich wohl benützte.“"
                            },
                            {
                                "example_id": "f39c2256-8414-4742-b555-2b7dee9f4ba4",
                                "sense_id": "3d3e2fe4-ba70-3025-bb69-9ce0d7d66c68",
                                "text": "„Bereits im Jahre 1514 erschienen hier die neulateinischen Heroiden des berühmten Humanisten Helius Eobanus Hessus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
