                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc0610b-d120-4817-b37d-265c4c0daf45",
                                "sense_id": "6772f4df-2a73-3d5d-a1be-f75d682316f8",
                                "text": "„Die Frau, die uns am nächsten saß, eine schlanke Gestalt in einem lila Wickelkleid, nahm eine lila Plastikschale zur Hand, wusch ihre Zehen, trocknete sie an der Sonne und lackierte sie sorgfältig mit lila Nagellack.“"
                            },
                            {
                                "example_id": "163e03d7-8614-432e-975f-328331c83da2",
                                "sense_id": "6772f4df-2a73-3d5d-a1be-f75d682316f8",
                                "text": "„Auf dem Boden, unter einer Schicht aus Kleidern, lag eine Serie von Dias in weißen Plastikschalen, jedes Diafoto in einem eigenen Rahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
