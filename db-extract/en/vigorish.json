    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e5a6ca55-2c88-3e01-9a41-13d14298072e",
                "word": "vigorish",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "09eae707-8b8f-4b47-b7e6-55f98682590b",
                        "entry_id": "e5a6ca55-2c88-3e01-9a41-13d14298072e",
                        "tags": [
                            "plural"
                        ],
                        "form": "vigorishes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6263e51-5bc2-3987-8060-86b416d0b412",
                        "entry_id": "e5a6ca55-2c88-3e01-9a41-13d14298072e",
                        "glosses": [
                            "A charge taken on bets, as by a bookie or gambling establishment."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b4568dba-3235-4ebf-9771-a725785d4bc8",
                                "sense_id": "e6263e51-5bc2-3987-8060-86b416d0b412",
                                "text": "The house sets vigs on any game they allow you to bet on. It is your responsibility to play only those games where the vig is not prohibitive. Let's take one more look at how vigorish works for the house."
                            },
                            {
                                "example_id": "a8c6cf2e-982d-4f3d-aafe-96e0cf822ac6",
                                "sense_id": "e6263e51-5bc2-3987-8060-86b416d0b412",
                                "text": "The bookmaker's mean profit per dollar bet is called vigorish or “the vig.” In our example, 11 + 11 = $22 is bet, and the bookmaker wins $1 so the vig is 1/22 = 4.5%."
                            }
                        ]
                    },
                    {
                        "sense_id": "20a5b45e-5adc-380c-a0ec-8602d145d5f8",
                        "entry_id": "e5a6ca55-2c88-3e01-9a41-13d14298072e",
                        "glosses": [
                            "The interest on a loan of money, especially for loans made by a usurer or loan shark."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7b036ad-0ab6-4383-b9d5-c10f2d1923b5",
                                "sense_id": "20a5b45e-5adc-380c-a0ec-8602d145d5f8",
                                "text": "His clients included wealthy women who possessed jewelry of great value, a fact which did not escape the loan shark. When it became apparent that the hairdresser could not meet his substantial vigorish payments, he was pressed into service as a \"fingerman\" for a burglary ring."
                            },
                            {
                                "example_id": "2af3eccb-5237-4220-9e34-8b551cd0275e",
                                "sense_id": "20a5b45e-5adc-380c-a0ec-8602d145d5f8",
                                "text": "They lend you a thousand and call it a bone. It cost a hundred a week vigorish to borrow the bone."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8a6b949-b996-308c-bd46-c068f6ac7acc",
                        "entry_id": "e5a6ca55-2c88-3e01-9a41-13d14298072e",
                        "glosses": [
                            "An amount owed on account of or payment of a bookie's charge or of interest."
                        ],
                        "tags": [
                            "countable",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5a1828ac-4620-3e67-984c-e40fc66a2a99",
                        "entry_id": "e5a6ca55-2c88-3e01-9a41-13d14298072e",
                        "glosses": [
                            "A commission or similar extra charge."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f185494e-8be0-4a1d-a08b-59b54614961b",
                                "sense_id": "5a1828ac-4620-3e67-984c-e40fc66a2a99",
                                "text": "I was asking a man who had never bent a rule in his entire life to do it once. This wasn't Italy or France, where such miracles are possible with a little political vigorish. This was Switzerland, where nothing like this ever happens."
                            }
                        ]
                    }
                ],
