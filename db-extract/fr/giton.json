                        "sense_id": "cbd2cad6-1a5d-33be-91e9-48def0365b3c",
                        "entry_id": "3793edf1-8dd8-3429-abe4-86466a576292",
                        "glosses": [
                            "Prostitué homosexuel, gigolo, mignon."
