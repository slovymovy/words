                                        "examples": [
                                            {
                                                "example_id": "b50352d8-d9ca-47ab-99f4-7e8575777061",
                                                "sense_id": "5edf38ef-f253-3cac-8e33-c118ef2668ae",
                                                "text": "„›Deine Leute haben Jungen von hier beschäftigt, die nicht wiederaufgetaucht sind.‹“"
                                            },
                                            {
                                                "example_id": "2ed546e6-b8e2-4b0e-91b1-7ca7f4499189",
                                                "sense_id": "5edf38ef-f253-3cac-8e33-c118ef2668ae",
                                                "text": "„Von hier auf dem Parkplatz aus konnte sie nicht mehr tun als ihren Männern beim Sturm auf das Gebäude zuzusehen und zu hoffen, dass sie schnell und lautlos reinkamen, bevor die Wachen wiederauftauchten oder irgendjemand nach den beiden toten Kameraden suchte, die sie unter die Lastwagen gezerrt hatten.“"
                                            }
                                        ],
