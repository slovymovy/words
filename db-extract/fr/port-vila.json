                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc3ce80-8fd2-4c0e-a44e-4dd92cc90aa8",
                                "sense_id": "ff3ad903-03b0-3782-bf1d-94d328b95bff",
                                "text": "Durant les deux dernières décennies, Port-Vila a continué de croître de façon anarchique, sans plan d’urbanisme, ce qui accentua la ségrégation spatiale héritée du condominium des Nouvelles-Hébrides."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bd838d8-98e2-3f3e-87e2-0e4388d0d3f7",
