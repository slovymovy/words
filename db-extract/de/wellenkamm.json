                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd4801b6-7d08-3ea6-99e8-a24817f656a4",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "A design or logo, especially one of an institution, sports club, association or high-class family."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb94162-c14a-4827-8d5a-3d30e4074376",
                                                "sense_id": "fd4801b6-7d08-3ea6-99e8-a24817f656a4",
                                                "text": "Hungry for fame and the approval of rare-animal collector Queen Victoria (Imelda Staunton), Darwin deceives the Captain and his crew into believing they can get enough booty to win the pirate competition by entering Polly in a science fair. So the pirates journey to London in cheerful, blinkered defiance of the Queen, a hotheaded schemer whose royal crest reads simply “I hate pirates.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "422007de-58d3-3804-b886-3a40b669856d",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "Any of several birds in the family Regulidae, including the goldcrests and firecrests."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
