        "fr-extract.jsonl": [
            {
                "entry_id": "42995cce-21e7-3719-84ce-315d4afeaa8c",
                "word": "lasure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "75ebb9da-a376-44cb-8894-c670f964a55e",
                        "entry_id": "42995cce-21e7-3719-84ce-315d4afeaa8c",
                        "tags": [
                            "plural"
                        ],
                        "form": "lasures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2244792-716c-34c8-8f81-fec34354cb45",
                        "entry_id": "42995cce-21e7-3719-84ce-315d4afeaa8c",
                        "glosses": [
                            "Enduit pour matériaux poreux comme le bois ou les bétons, non générateur de film à la différence des vernis et des peintures, qui contiennent des liants, qui créent en séchant une structure homogène à travers ou sur le matériau traité. Généralement elles contiennent un hydrofuge, un insecticide, un fongicide, et une teinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0c4005a-2dc6-4791-af77-b0ae2595c6f9",
                                "sense_id": "b2244792-716c-34c8-8f81-fec34354cb45",
                                "text": "Il est déconseillé d'appliquer une lasure sur un support horizontal comme un plancher, soumis aux frottements, à la poussière, à l'humidité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1af47cd4-1467-4b93-bc7b-2a25af241cf7",
                        "source_entry_id": "42995cce-21e7-3719-84ce-315d4afeaa8c",
                        "source_sense_id": "b2244792-716c-34c8-8f81-fec34354cb45",
                        "source_sense_description": "Enduit pour matériaux poreux",
                        "target_lang_word": "Lasur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lasur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb4f02f-136e-3cdf-af4f-cea88224d1c2",
                                        "entry_id": "4057b81c-b6f1-3606-b5a8-97b207afd4af",
                                        "glosses": [
                                            "durchsichtiger Anstrich (oft auf Holz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79cbab97-9ec7-4213-a752-c82332859d34",
                                                "sense_id": "aeb4f02f-136e-3cdf-af4f-cea88224d1c2",
                                                "text": "„Jan van Eyck, ein Meister der Illusion. Wie hat er das geschafft? Erstens hat er die Technik der Ölmalerei perfektioniert. Es gelang ihm, die Farbe flüssiger zu machen, sodass er sie Schicht für Schicht als durchschimmernde Lasuren anbringen konnte. Dadurch entstanden Tiefe und eine geradezu überirdische Leuchtkraft.“"
                                            },
                                            {
                                                "example_id": "6fad2d10-fc78-44c7-b5e9-72240d29a7dd",
                                                "sense_id": "aeb4f02f-136e-3cdf-af4f-cea88224d1c2",
                                                "text": "„Wohin der Blick in der Ausstellung auch fällt, er trifft auf wulstige Objekte und schrundige Oberflächen, deren farbige Lasuren schillern oder das Licht in tiefen Kratern verschlucken.“"
                                            },
                                            {
                                                "example_id": "4c7726ba-6af3-4e01-a94d-9454c448decf",
                                                "sense_id": "aeb4f02f-136e-3cdf-af4f-cea88224d1c2",
                                                "text": "[…] „wenn man da mal mit dem Mikroskop rangeht, dann sieht man, dass da ganz hauchdünne Lasuren sind, entweder mit Krapp ausgemischt oder dem reinen Ultramarin. Und diese hauchdünnen Lasuren geben dann dem Schwarz so dieses Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                        "entry_id": "4057b81c-b6f1-3606-b5a8-97b207afd4af",
                                        "glosses": [
                                            "Flüssigkeit zum Ausführen von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c607e23e-2143-4b40-93e1-214ae66358c3",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Die Auswahl an unterschiedlichen Lasuren zum Holzschutz ist groß.“"
                                            },
                                            {
                                                "example_id": "547f6109-d9d5-42c7-bc86-f234ec9ed78c",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Beachten Sie die Trocknungszeit der Lasur und tragen Sie nach vollständiger Trocknung einen weiteren Schutzanstrich auf.“"
                                            },
                                            {
                                                "example_id": "dcfb12f3-2d4d-42ae-b381-5db74fdf13d1",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Je nachdem, in welchem Bereich Sie die Lasur einsetzen möchten, benötigen Sie ein passendes Produkt.“"
                                            },
                                            {
                                                "example_id": "395e4b48-b3a0-4b0b-8cb7-cef9aa93b4af",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Lasuren sind typischerweise farblos, um die natürliche Holzfarbe zu erhalten.“"
                                            },
                                            {
                                                "example_id": "2b67af90-4464-4459-8675-4598576b9786",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Mit einer weißen Lasur können Sie die Holzfarbe optisch aufhellen, während eine dunkle Lasur die Farben des Holzmöbels intensivieren kann. Braune Lasuren lassen das Holz lebhafter wirken.“"
                                            },
                                            {
                                                "example_id": "cad54a47-1559-4351-ab5c-dff63f26c980",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Bei einem grobporigen Untergrund benötigen Sie eventuell die doppelte Menge an Lasur.“"
                                            },
                                            {
                                                "example_id": "4c040cbc-efc5-4197-97dc-718d7860bc87",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Die Lasur bildet keine deckende Schicht, weshalb das Holz wasserdampfdurchlässig bleibt.“"
                                            },
                                            {
                                                "example_id": "4faf696a-ff7f-4754-8b42-d38044e8efca",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Im Außenbereich steht der Holzschutz im Vordergrund. Mit der Lasur schützen Sie das Holz vor Faktoren wie Nässe und UV-Strahlen.“"
                                            },
                                            {
                                                "example_id": "c964ba38-eb03-431d-99f0-b35a5536de02",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Bei der Lasur hat sich Brigitte Goss für eine umweltfreundliche Holzlasur aus Holzöl, Leinöl, Mikrowachsen und Pigmenten entschieden.“"
                                            },
                                            {
                                                "example_id": "6211c897-5383-4f47-a301-58d888a2a569",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Mischen Sie sich doch Ihre ganz persönliche Wand- oder Möbellasur selbst – zum Herstellen von bunten Lasuren brauchen Sie vor allem echte Pigmenten in Ihrer Wunschfarbe.“"
                                            },
                                            {
                                                "example_id": "f989d834-abab-4704-bdc2-7e24dd4e57b2",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Kase: »Also, eines der Meisterwerke der Schenkung Fohn ist zweifellos das Bildnis des Fotografen Hugo Erfurt von Otto Dix, weil es auf vorzügliche Art und Weise zeigt, wie altmeisterlich versiert Dix mit Lasuren malt.«“"
                                            },
                                            {
                                                "example_id": "39190bf2-e68e-45ff-b540-43e7eaf199a1",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Die Farbeffekte in seinen Gemälden, insbesondere seine Fleischtöne, rühren weniger von der Farbigkeit seiner Pigmente als vielmehr von der Leuchtkraft her, die er mit Hilfe transparenter Pigmente und Lasuren erzielte.“"
                                            },
                                            {
                                                "example_id": "31d25efc-78f2-4b1e-95c4-fd5b0815346b",
                                                "sense_id": "ec6025f6-eeb4-3fd5-8d04-9cfa218cf5a6",
                                                "text": "„Mona Abaza: »Natürlich geht es auch um Kunst. Alaa Awwad und andere Graffiti-Aktivisten in der Straße stritten darüber, ob die Arbeiten dauerhaft erhalten bleiben sollen. Alaa wollte seine Arbeiten mit einer Lasur versiegeln. Die anderen waren dagegen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad21843e-5219-4e67-a8c5-fac5458f9340",
