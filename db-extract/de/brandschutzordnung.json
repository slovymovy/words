                "senses": [
                    {
                        "sense_id": "1836da2a-604b-3f0e-a3f3-21b4e2e69899",
                        "entry_id": "552f6555-572e-3589-b947-67293fde31b3",
                        "glosses": [
                            "Regeln zum Brandschutz in einem bestimmten Objekt und der darin befindlichen Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476deb99-171a-45ef-90c9-8cc421bf1535",
                                "sense_id": "1836da2a-604b-3f0e-a3f3-21b4e2e69899",
                                "text": "„Eine Brandschutzordnung ist eine auf ein bestimmtes Objekt zugeschnittene Zusammenstellung von Regeln für die Brandverhütung und das Verhalten im Brandfall.“"
                            },
                            {
                                "example_id": "01590546-10af-46cd-95b4-3d813ed6f876",
                                "sense_id": "1836da2a-604b-3f0e-a3f3-21b4e2e69899",
                                "text": "„In der Brandschutzordnung sind die Verhaltensregeln zur Brandverhütung, die organisatorischen Maßnahmen des vorbeugenden Brandschutzes und die Verhaltensregeln im Brandfall festzulegen.“"
                            },
                            {
                                "example_id": "aa2442e8-d4b5-453c-bb78-cb201b186740",
                                "sense_id": "1836da2a-604b-3f0e-a3f3-21b4e2e69899",
                                "text": "„Man sieht sie ausgehangen in öffentlichen Gebäuden, aber auch in Betrieben: die Brandschutzordnung.“"
                            },
                            {
                                "example_id": "11a90a19-4e57-455e-894b-f575abb37018",
                                "sense_id": "1836da2a-604b-3f0e-a3f3-21b4e2e69899",
                                "text": "„Diese Brandschutzordnung richtet sich an alle Personen, die sich nicht nur vorübergehend in der Fachhochschule Köln aufhalten.“"
                            },
                            {
                                "example_id": "fd5fc53f-cb83-4fa6-9c33-4c2f5303980e",
                                "sense_id": "1836da2a-604b-3f0e-a3f3-21b4e2e69899",
                                "text": "„Die Brandschutzordnung wird als Merkblattoder als Broschürean die Beschäftigten oder Bewohner ausgehändigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
