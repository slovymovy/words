                "entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                "word": "gedienstigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a144139b-c8f1-4cf8-8d2b-7e87a161f164",
                        "entry_id": "62c91b09-4cec-33aa-8af4-47b7c6ab9249",
                        "tags": [
