                ],
                "senses": [
                    {
                        "sense_id": "daba20b5-c5f3-3604-a21c-81bc47831db2",
                        "entry_id": "82f7bc2e-b400-3684-8f17-129417385ff6",
                        "glosses": [
                            "Éplucher avant stockage ou distribution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c74393-2e1e-4a65-b578-f60401b6c281",
                                "sense_id": "daba20b5-c5f3-3604-a21c-81bc47831db2",
                                "text": "Un exemple parmi beaucoup d’autres est celui des salades pré-épluchées, pré-lavées et pré-découpées qui permettent effectivement d’économiser le temps le plus embêtant dans l’apprêtement de la salade."
                            },
                            {
                                "example_id": "f7ea45de-660c-4c9a-a161-200750c6a930",
                                "sense_id": "daba20b5-c5f3-3604-a21c-81bc47831db2",
                                "text": "Il est désormais proposé de pré-éplucher les légumes avant leur transport en ville et d’enfouir les déchets organiques dans le sol."
                            },
                            {
                                "example_id": "785d6e90-7a9b-4189-942c-c72477808552",
                                "sense_id": "daba20b5-c5f3-3604-a21c-81bc47831db2",
                                "text": "Pré-lavez, pré-épluchez et pré-découpez vos fruits et légumes avant de les mettre dans un sac de congélation, où ils seront très bien conservés tels quels."
                            }
                        ]
                    }
