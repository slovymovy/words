                                "target_senses": [
                                    {
                                        "sense_id": "4083b496-d02c-3257-b34a-898f63f67d89",
                                        "entry_id": "fa8f2bfe-0220-3f79-87e3-1ec5f9aff244",
                                        "glosses": [
                                            "To put in a sack or sacks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f0fdd4-e02b-4bbc-8131-9704a71201f7",
                                                "sense_id": "4083b496-d02c-3257-b34a-898f63f67d89",
                                                "text": "Help me sack the groceries."
                                            },
                                            {
                                                "example_id": "69f3e6b6-880b-4b6b-85fd-db57456bc350",
                                                "sense_id": "4083b496-d02c-3257-b34a-898f63f67d89",
                                                "text": "The gold was sacked in moose-hide bags, fifty pounds to the bag, and piled like so much firewood outside the spruce-bough lodge."
                                            },
                                            {
                                                "example_id": "5300ea1f-03d6-4eb2-bd15-62b25f9aa5e5",
                                                "sense_id": "4083b496-d02c-3257-b34a-898f63f67d89",
                                                "text": "A girl porter sacking some of the many thousands of used railway tickets which are turned over by the London Passenger Transport Board to assist the waste paper salvage campaign"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "129b9a10-2ca0-3139-9481-b8f2d4b60555",
                                        "entry_id": "fa8f2bfe-0220-3f79-87e3-1ec5f9aff244",
                                        "glosses": [
                                            "To bear or carry in a sack upon the back or the shoulders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e065c1e-39c9-3f16-a5e3-eec363c21934",
                                        "entry_id": "fa8f2bfe-0220-3f79-87e3-1ec5f9aff244",
                                        "glosses": [
                                            "To plunder or pillage, especially after capture; to obtain spoils of war from."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9df86cb-670d-47b7-a396-15fbe4fe81a1",
                                                "sense_id": "6e065c1e-39c9-3f16-a5e3-eec363c21934",
                                                "text": "The barbarians sacked Rome in 410 CE."
                                            },
                                            {
                                                "example_id": "9bcf33fc-47d8-442f-90a1-06ec1bfe5169",
                                                "sense_id": "6e065c1e-39c9-3f16-a5e3-eec363c21934",
                                                "text": "Thoſe thouſand horſe shall ſweat with martiall ſpoyle\nOf conquered kingdomes, and of Cities ſackt, […]"
                                            },
                                            {
                                                "example_id": "d2b2aeb2-eb23-43d6-8ea9-894d697c0b29",
                                                "sense_id": "6e065c1e-39c9-3f16-a5e3-eec363c21934",
                                                "text": "It [a lyre] was part of the spoils which he had taken when he sacked the city of Eetion […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9439e89b-ea28-38de-b160-14ead7cb2ae6",
                                        "entry_id": "fa8f2bfe-0220-3f79-87e3-1ec5f9aff244",
                                        "glosses": [
                                            "To tackle the quarterback behind the line of scrimmage, especially before he is able to throw a pass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63994fbd-b12f-42d4-9693-8789eed47d07",
                                                "sense_id": "9439e89b-ea28-38de-b160-14ead7cb2ae6",
                                                "text": "On third down, the rejuvenated Rickey Jackson stormed in over All-Pro left tackle Richmond Webb to sack Marino yet again for a 2-yard loss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d89d32-57ad-3a0b-a11d-5499a27befb7",
                                        "entry_id": "fa8f2bfe-0220-3f79-87e3-1ec5f9aff244",
                                        "glosses": [
                                            "To discharge from a job or position; to fire."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8984ce87-12f1-4747-9a3b-7b491b18bd50",
                                                "sense_id": "21d89d32-57ad-3a0b-a11d-5499a27befb7",
                                                "text": "He was sacked last September."
                                            },
                                            {
                                                "example_id": "55067c4b-a26a-490b-88c0-e80cfae84445",
                                                "sense_id": "21d89d32-57ad-3a0b-a11d-5499a27befb7",
                                                "text": "[…] Boris Berezovsky on Friday dismissed President Boris Yeltsin's move to sack him from his post as executive secretary of the Commonwealth of Independent States, […]"
                                            },
                                            {
                                                "example_id": "8195d2b9-e789-4847-b37e-1a21cd5c298b",
                                                "sense_id": "21d89d32-57ad-3a0b-a11d-5499a27befb7",
                                                "text": "Waste my time working for cowards and creeps / Oh I wish that they'd sack me and leave me to sleep"
                                            },
                                            {
                                                "example_id": "bc1215dc-ef22-4df4-aad6-0f12a1954bc1",
                                                "sense_id": "21d89d32-57ad-3a0b-a11d-5499a27befb7",
                                                "text": "As an aside, Luddendenfoot once had a famous (or perhaps infamous) clerk - drunkard Branwell Brontë, brother to the famous Brontë sisters and writers. He was sacked from his post in March 1842 after an audit revealed a discrepancy in the books. Today, a blue plaque on the Jubilee Refreshment rooms at Sowerby Bridge station commemorates him."
                                            },
                                            {
                                                "example_id": "da31262d-bd90-461d-82e4-ab8f15658ed1",
                                                "sense_id": "21d89d32-57ad-3a0b-a11d-5499a27befb7",
                                                "text": "A group of St Petersburg local politicians who called for President Vladimir Putin to be sacked over the war in Ukraine faces the likely dissolution of their district council following a judge's ruling on Tuesday, one of the deputies said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e57e7b5-7b60-347f-af95-331c8169cb83",
                                        "entry_id": "fa8f2bfe-0220-3f79-87e3-1ec5f9aff244",
                                        "glosses": [
                                            "To give up on, to abandon, delay, to not think about someone or something."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef00d8fc-fd87-4810-950d-2ca21a353169",
                                                "sense_id": "7e57e7b5-7b60-347f-af95-331c8169cb83",
                                                "text": "Sack the homework."
                                            },
                                            {
                                                "example_id": "003c3b37-5456-4360-9fd9-47a312df198a",
                                                "sense_id": "7e57e7b5-7b60-347f-af95-331c8169cb83",
                                                "text": "Sack him, let's run."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "248d9318-2237-348e-adb9-6e67392aa5bf",
                                        "entry_id": "236bc8ee-1066-3051-b37f-881c9f79ba62",
                                        "glosses": [
                                            "A variety of light-colored dry wine from Spain or the Canary Islands; also, any strong white wine from southern Europe; sherry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe3e2c7-cfcb-4848-abaf-dee7ee2323c7",
                                                "sense_id": "248d9318-2237-348e-adb9-6e67392aa5bf",
                                                "text": "Wilt pleaſe your Lord drink a cup of ſacke? […] I am Christophero Sly, call not mee Honour nor Lordship: I ne're drank ſacke in my life: […]"
                                            },
                                            {
                                                "example_id": "74e79f9f-0f4b-481c-aca1-f3770fe12fe1",
                                                "sense_id": "248d9318-2237-348e-adb9-6e67392aa5bf",
                                                "text": "Giue me a Cup of Sacke, Rogue. Is there no Vertue extant?"
                                            },
                                            {
                                                "example_id": "16176f59-2048-41a0-a533-fbb5c62f1b87",
                                                "sense_id": "248d9318-2237-348e-adb9-6e67392aa5bf",
                                                "text": "How cam'ſt thou hither? / Sweare by this Bottle how thou cam'ſt hither: I eſcap'd / vpon a But of Sacke, which the Saylors heaued o'reboord, by this Bottle which I made of the barke of a Tree, with mine owne hands, since I was caſt a'ſhore."
                                            },
                                            {
                                                "example_id": "bb7f4e3b-84af-461d-8d43-29124dab69fc",
                                                "sense_id": "248d9318-2237-348e-adb9-6e67392aa5bf",
                                                "text": "The vesper bell had rung its parting note; the domini were mostly caged in comfortable quarters, discussing the merits of old port; and the merry student had closed his oak, to consecrate the night to friendship, sack, and claret."
                                            },
                                            {
                                                "example_id": "0f1c7636-c5a6-41b4-95fe-60ac1e011a57",
                                                "sense_id": "248d9318-2237-348e-adb9-6e67392aa5bf",
                                                "text": "\"He's got a venison pastry and a flagon of sack in that cupboard behind him.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sack",
                                "target_lang_code": "en",
                                "target_senses": [
