                        "sense_id": "8ca82711-4f52-3294-b893-7477f2dccc3a",
                        "entry_id": "2fee8a18-8706-32f9-9f79-264bfb59cada",
                        "glosses": [
                            "A placename",
                            "A city, the county seat of Campbell County, Wyoming, United States."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ecac5db-367c-4f17-b138-dd5dfa627a30",
                                "sense_id": "8ca82711-4f52-3294-b893-7477f2dccc3a",
                                "text": "In those 18 years, Gillette, a small town in northeastern Wyoming, has changed from a group of houses and a railroad depot servicing a ranching and farming community to a mining boomtown, growing at a rate of 15 to 20 percent a year."
                            },
                            {
                                "example_id": "d4cfd162-899d-49c0-bde0-4d7164d70953",
                                "sense_id": "8ca82711-4f52-3294-b893-7477f2dccc3a",
                                "text": "Gillette is a dusty, bustling coal-mining center in north-eastern Wyoming, bisected by a railroad operated by Burlington Northern Santa Fe Corp., which delivers coal to such cities as Chicago and Centralia, Wash."
                            },
                            {
                                "example_id": "e3c4b03a-c17d-4ab0-ad4b-4484e2cd8100",
                                "sense_id": "8ca82711-4f52-3294-b893-7477f2dccc3a",
                                "text": "By one estimate, there are as many full-time craft artists in the United States as there are people in the town of Gillette, Wyoming. Never heard of Gillette? Well, no wonder; like the universe of craft artists, it has a relatively small population."
                            }
                        ]
                    },
                    {
                        "sense_id": "7231aa97-178e-39ef-85c4-bf4e58291531",
                        "entry_id": "2fee8a18-8706-32f9-9f79-264bfb59cada",
                        "glosses": [
                            "A brand of razor blade"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd52f371-e9d9-4ad3-b513-fe83dd584000",
                                "sense_id": "7231aa97-178e-39ef-85c4-bf4e58291531",
                                "text": "In the men's room he watched a man about his own age pathetically trying to shave a five-day beard with a rusty Gillette razor he had probably found in a trash bin."
                            }
                        ]
                    }
