                                        "entry_id": "26fcf824-7125-3946-a9d3-c93c34ce75a4",
                                        "glosses": [
                                            "Fleuve d’Amérique du Sud, passant par Asunción, qui donne son nom au pays."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e323c54b-d5a2-4987-bf85-5b0f624ec6e6",
                                                "sense_id": "67d51ec7-cfb6-3d0c-8a0d-0621a2fe94e8",
                                                "text": "Entre-temps, quelques centaines d’entre eux ont remonté le Paraná et le Paraguay, se sont installés chez les Guaranis et ont fondé Asunción en 1537."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
