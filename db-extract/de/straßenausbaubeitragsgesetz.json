                "senses": [
                    {
                        "sense_id": "65dc955d-ac61-3843-abd5-a7c396e6dabe",
                        "entry_id": "152ffea6-b42d-3887-872d-3d28540ceac1",
                        "glosses": [
                            "Gesetz, das Kommunalabgaben zum Erhalt und Bau von Straßen regelt"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "49df3f32-c467-4403-a76d-adc39041a1fb",
                                "sense_id": "65dc955d-ac61-3843-abd5-a7c396e6dabe",
                                "text": "„Das Straßenausbaubeitragsgesetz vom 16. März 2006 (GVBI, S. 265), das durch Gesetz vom 8. Juli 2010 (GVBI, S. 398) geändert worden ist, wird aufgehoben.“"
                            },
                            {
                                "example_id": "0ed67d54-053c-4e5a-9bd9-045ef7e2c96d",
                                "sense_id": "65dc955d-ac61-3843-abd5-a7c396e6dabe",
                                "text": "„So könne es nämlich auch nicht mehr zu Ungerechtigkeiten wegen des Länder-Finanzausgleichs kommen, bekanntlich hatte Berlin ja 2012 sein Straßenausbaubeitragsgesetz abgeschafft.“"
                            },
                            {
                                "example_id": "4d8d34d0-5084-4edb-be00-09b0622244fb",
                                "sense_id": "65dc955d-ac61-3843-abd5-a7c396e6dabe",
                                "text": "„Ausnahmezustand im Abgeordnetenhaus. Ausgerechnet zur Anhörung einer so sperrigen Verwaltungsrichtlinie wie des ‚Straßenausbaubeitragsgesetzes‘ stürmten Berliner in Scharen den Preußischen Landtag.“"
                            },
                            {
                                "example_id": "1d23d962-7c79-4107-a93c-d023d653b785",
                                "sense_id": "65dc955d-ac61-3843-abd5-a7c396e6dabe",
                                "text": "„In Berlin ist in der vergangenen Woche das Straßenausbaubeitragsgesetz von der rot-schwarzen Landesregierung abgeschafft worden.“"
                            },
                            {
                                "example_id": "16f32022-ba56-4711-b1ed-f57cafe03925",
                                "sense_id": "65dc955d-ac61-3843-abd5-a7c396e6dabe",
                                "text": "„In früheren Jahren engagierte er sich gegen das Straßenausbaubeitragsgesetz und brachte damit viele Anwohner in seinem von Eigenheimen geprägten Wahlkreis hinter sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
