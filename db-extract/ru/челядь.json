                    {
                        "sense_id": "05079f82-bad6-338d-bfb7-c6fb904d7dfd",
                        "entry_id": "67f22cf0-943a-3ccd-94d6-94c9a473146d",
                        "glosses": [
                            "servants, menials"
                        ],
                        "tags": [
