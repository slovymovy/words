                "translations": [
                    {
                        "translation_id": "d154b464-b632-43d0-bf1b-af84d113e7c5",
                        "source_entry_id": "f213a64e-afd3-3e4b-8767-106379d15583",
                        "source_sense_id": "579c085e-4194-3064-a554-dff7fd7acc25",
                        "source_sense_description": "sehr dünnes Papier: Seidenpapier",
                        "target_lang_word": "Seidenpapier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seidenpapier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68ff9be0-ff8d-32f4-8ff8-d63f93140b15",
                                        "entry_id": "5923c50c-4dd5-3bea-bc6d-0f0c3dfbd830",
                                        "glosses": [
                                            "sehr feines, dünnes Papier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233c5954-b061-4544-a73b-dad39cfecf00",
                                                "sense_id": "68ff9be0-ff8d-32f4-8ff8-d63f93140b15",
                                                "text": "Ich wickelte die Bronze aus ihrem Seidenpapier und betrachtete sie in der Sonne.“"
                                            },
                                            {
                                                "example_id": "965e5e21-2e18-4617-8f53-4f3d79193670",
                                                "sense_id": "68ff9be0-ff8d-32f4-8ff8-d63f93140b15",
                                                "text": "„Am Dienstagabend ist Tyler zu Hause, macht Seife, wickelt sie in Seidenpapier und versendet sie.“"
                                            },
                                            {
                                                "example_id": "e36f6bf2-423c-4c55-97a9-83b166fa3d00",
                                                "sense_id": "68ff9be0-ff8d-32f4-8ff8-d63f93140b15",
                                                "text": "„Nachdem Adam, Nina und der Oberst die Dekorationen bewundert hatten, überreichten sie die in Seidenpapier eingewickelten Geschenke.“"
                                            },
                                            {
                                                "example_id": "0a4cdb0d-f9af-4cdb-be00-6127ceb2fb17",
                                                "sense_id": "68ff9be0-ff8d-32f4-8ff8-d63f93140b15",
                                                "text": "„Als der Deckel aufgestemmt war, fiel das Stroh beiseite, Seidenpapier glitt herab, und die Gliederpuppe erschien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d2abd7-c2bb-4be7-a391-96ca68e03a90",
                        "source_entry_id": "f213a64e-afd3-3e4b-8767-106379d15583",
                        "source_sense_id": "4a0c7955-6d0f-3f59-b5ff-191706e4890c",
                        "source_sense_description": "umgangssprachlich: kleines Löschpapier",
                        "target_lang_word": "klein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                        "entry_id": "59183d49-7d53-3405-bc2f-428e2929c652",
                                        "glosses": [
                                            "von geringem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ef9d19-64de-416b-bcfb-9300fe555fbc",
                                                "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                                "text": "Das ist ein kleines Haus."
                                            },
                                            {
                                                "example_id": "730eeebd-f5c3-422a-905f-3400ff75ab8e",
                                                "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                                "text": "Wale ernähren sich von Plankton und kleinen Fischen."
                                            },
                                            {
                                                "example_id": "fabd7df4-9770-4822-a82c-22802b971355",
                                                "sense_id": "0f720763-7a7d-3505-ba33-1f11cb006ca9",
                                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft treiben können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55d6c0ec-086f-3a68-a6cc-ba7afcadafc0",
                                        "entry_id": "59183d49-7d53-3405-bc2f-428e2929c652",
                                        "glosses": [
                                            "unbedeutend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbcc9cd-da6a-427c-9b24-3fad91d1e37c",
                                                "sense_id": "55d6c0ec-086f-3a68-a6cc-ba7afcadafc0",
                                                "text": "Ich bin hier nur ein kleiner Angestellter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
