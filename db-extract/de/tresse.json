                                "example_id": "1276ba5b-3daa-4925-940b-4d9a41e958bb",
                                "sense_id": "5bfaed9b-4c55-340a-a457-03c7a904fe64",
                                "text": "Sie trug eine lange Tresse."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1217181f-22d9-3eed-b172-1f1dc64dbb12",
                        "entry_id": "1621cc38-6b03-37f7-b3e7-02578296fb5b",
                        "glosses": [
                            "gewebter Besatz auf Kleidungsstücken, meist auf Uniformen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299fd5d9-f0ad-4bb2-867d-0d8df2b1a705",
                                "sense_id": "1217181f-22d9-3eed-b172-1f1dc64dbb12",
                                "text": "Die Tresse war aus Goldfäden gewebt."
                            },
                            {
                                "example_id": "d5eb295a-ea4e-4e59-b615-e06ff89ee924",
                                "sense_id": "1217181f-22d9-3eed-b172-1f1dc64dbb12",
                                "text": "„Er trägt einen dunkelblauen Rock, darüber einen einfachen grauen, mit schwarzer Tresse eingefaßten Militärmantel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f1ecb751-d8fa-3b48-b1e6-c3e5cc61276b",
                        "entry_id": "1621cc38-6b03-37f7-b3e7-02578296fb5b",
                        "glosses": [
                            "dicht gewebtes Drahtgewebe für Filtrationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfcd2880-c74b-4401-9866-8243d913f40b",
                                "sense_id": "f1ecb751-d8fa-3b48-b1e6-c3e5cc61276b",
                                "text": "Eine Tresse ist ein sehr dichtes Drahtgewebe, das eine sehr feine Filtration erlaubt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
