                                "example_id": "893f6ab7-8354-40fb-aae1-f6e876f1a58d",
                                "sense_id": "b789fac2-77bb-348d-8637-56c8d5adf028",
                                "text": "L’espèce, une lycophyte aux pâles microphylles, ressemble davantage, à s’y méprendre, aux mousses acrocarpes qu’aux lycopodes voisins de la région couverte par la Flore."
                            },
                            {
                                "example_id": "7d27c889-8c34-49c9-b9aa-f27162bc897b",
                                "sense_id": "b789fac2-77bb-348d-8637-56c8d5adf028",
                                "text": "Les lycophytes actuelles sont de toute petite taille, alors que celles du Carbonifère étaient des arbres imposants, comme le Lepidodendron."
                            }
                        ]
                    }
