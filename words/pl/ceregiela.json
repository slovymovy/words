    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf678e1f-b551-3f97-bfea-f2eb8b92862a",
                    "sense_definition": "zbędne, przesadne uprzejmości lub konwencjonalne grzeczności",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie rób sobie żadnych <w>ceregieli</w> i poczęstuj się tym ciastem bez pytania.",
                            "target_lang_translations": {
                                "ru": "Не <w>церемонься</w> и угощайся этим пирогом без спроса."
                            }
                        },
                        {
                            "text": "Po co te <w>ceregiele</w>, przecież znamy się od lat i nie musimy być tak oficjalni.",
                            "target_lang_translations": {
                                "ru": "К чему эти <w>церемонии</w>, ведь мы знакомы много лет и нам не нужно быть такими официальными."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceremonie"
                    ],
                    "common_phrases": [
                        "bez ceregieli",
                        "po co te ceregiele"
                    ],
                    "target_lang_definitions": {
                        "ru": "излишние, преувеличенные любезности или формальные вежливости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церемонии",
                                "target_lang_sense_clarification": "излишние формальности в поведении"
                            },
                            {
                                "target_lang_word": "церемонность",
                                "target_lang_sense_clarification": "излишняя официальность и вежливость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3050391b-7295-3793-8193-fd940a3d22be",
                    "sense_definition": "nieszczere wykręcanie się lub przedstawianie nieistotnych zastrzeżeń",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dopiero po długich <w>ceregielach</w> zgodził się w końcu podpisać ten dokument.",
                            "target_lang_translations": {
                                "ru": "Только после долгих <w>отговорок</w> он наконец согласился подписать этот документ."
                            }
                        },
                        {
                            "text": "Nie lubię takich <w>ceregieli</w>, kiedy ktoś udaje, że nie może czegoś zrobić, choć wcale nie ma przeszkód.",
                            "target_lang_translations": {
                                "ru": "Не люблю такие <w>увиливания</w>, когда кто-то притворяется, что не может чего-то сделать, хотя никаких препятствий нет."
                            }
                        }
                    ],
                    "synonyms": [
                        "certacja",
                        "certowanie się"
                    ],
                    "common_phrases": [
                        "wielkie ceregiele"
                    ],
                    "target_lang_definitions": {
                        "ru": "неискренние отговорки или выдвижение несущественных возражений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отговорки",
                                "target_lang_sense_clarification": "неискренние причины для отказа"
                            },
                            {
                                "target_lang_word": "увиливание",
                                "target_lang_sense_clarification": "попытки избежать прямого ответа или действия"
                            },
                            {
                                "target_lang_word": "колебания",
                                "target_lang_sense_clarification": "нерешительность, выражающаяся в затягивании дела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
