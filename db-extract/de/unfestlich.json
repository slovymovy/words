                    }
                ],
                "senses": [
                    {
                        "sense_id": "80bc392b-5bd9-34bc-a44a-68b98a001c4a",
                        "entry_id": "065ad069-f47c-3395-9ce0-e4cc019ca054",
                        "glosses": [
                            "nicht festlich; nicht zu einem Fest passend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824d72ba-f14d-499a-ba4c-7f350ff29dc6",
                                "sense_id": "80bc392b-5bd9-34bc-a44a-68b98a001c4a",
                                "text": "„Es regnet nicht, aber der Himmel ist auch nicht klar; er ist gleichmäßig weißgrau, gewöhnlich, unfestlich […]“ (1909)"
                            },
                            {
                                "example_id": "bed60e21-62de-4ca3-8c33-eb289f1fc28f",
                                "sense_id": "80bc392b-5bd9-34bc-a44a-68b98a001c4a",
                                "text": "„Durch den Einsatz perspektivischer Mittel konnte er die als finster und unfestlich empfundene Anlage heller und freundlicher erscheinen lassen.“"
                            },
                            {
                                "example_id": "b2a78e0a-66a0-4e0b-a7ff-7f1f4b90cf54",
                                "sense_id": "80bc392b-5bd9-34bc-a44a-68b98a001c4a",
                                "text": "„Was ein Festival der Künste zu sein scheint, hat ganz unfestliche, praktisch politische, soziale, pädagogische – auf jeden Fall kluge und ehrenwerte Gründe.“"
                            },
                            {
                                "example_id": "75e07eab-ffb3-4efe-8888-ee6079942ee0",
                                "sense_id": "80bc392b-5bd9-34bc-a44a-68b98a001c4a",
                                "text": "„Gegen längere Aufenthalte auf dem Dach mit seinem imposanten Rundblick auf das abendliche Berlin sprach leider das unfestliche Wetter.“"
                            },
                            {
                                "example_id": "3a288547-28d5-4057-8c77-ca30ab627d05",
                                "sense_id": "80bc392b-5bd9-34bc-a44a-68b98a001c4a",
                                "text": "„Warum Weihnachten so unfestlich war, erschloss sich uns knapp zwei Wochen später in einem Kaff mit dem pittoresken Namen Pijijiapan […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
