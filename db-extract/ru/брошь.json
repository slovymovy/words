                                    }
                                ]
                            },
                            {
                                "target_word": "brooch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31eb926f-f0ef-3963-bd7e-e2b1e7ed71ef",
                                        "entry_id": "ed5d1031-c36e-363f-abc2-0c1181452519",
                                        "glosses": [
                                            "To adorn as with a brooch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5266dda9-3d42-4f12-b440-6d80812f9c75",
                                                "sense_id": "31eb926f-f0ef-3963-bd7e-e2b1e7ed71ef",
                                                "text": "Not the imperious show / Of the full-fortuned Caesar ever shall / Be brooch'd with me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbdb00fd-4bc1-434d-ab1a-eed9c06850d3",
                        "source_entry_id": "5eae113e-6c2b-3dea-a934-c7e5240576f4",
                        "source_sense_id": "0dbb6ecc-9f02-3635-bd67-b958c7412783",
