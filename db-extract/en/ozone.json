                "senses": [
                    {
                        "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                        "entry_id": "344bf4c2-c09b-3808-8757-7dc980f240a1",
                        "glosses": [
                            "To treat with ozone."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a9461f6-a0db-4ae1-ad97-e4c3885a3f52",
                                "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                "text": "Whenever it exists, as it usually does, even where the tide water freshens at the ebb, it seems to have a purifying tendency, probably by ozoning the superincumbent atmosphere."
                            },
                            {
                                "example_id": "a169e060-f40c-4232-a1c8-59e1913071e8",
                                "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                "text": "I worked nonstop to make the house safe. Periodically I ozoned the first-floor bathroom, but it still made us sick."
                            }
                        ]
                    }
                ],
