                                    {
                                        "sense_id": "c9b643a4-6f59-34ce-b640-af273df830c1",
                                        "entry_id": "afa1b5fe-904b-317e-8eb2-ec89b40ecbf7",
                                        "glosses": [
                                            "To send abroad."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a09608e-5a5f-4087-80e3-f0d5833ace2a",
                                                "sense_id": "c9b643a4-6f59-34ce-b640-af273df830c1",
                                                "text": "Thou hellish Dog, Depart, or I will amand, ablegate, and send thee to some vast and horrid Desert."
                                            },
                                            {
                                                "example_id": "70d085e2-7c04-419e-bdda-e7223b40abc1",
                                                "sense_id": "c9b643a4-6f59-34ce-b640-af273df830c1",
                                                "text": "The evil which you imav gine, therefore, is so far from being really felt, that we are now sufferers by the bad policy of our ancestors, in ablegating their poor to till the wilds of America; and maintaining them there at an enormous expence"
                                            },
                                            {
                                                "example_id": "e4e6c50a-d228-4676-9037-39ebc638b61c",
                                                "sense_id": "c9b643a4-6f59-34ce-b640-af273df830c1",
                                                "text": "Couriers were ablegated from all points of the vicinage, to secure the adjuments of pharmacopolists, chirurgeons, and even of amethodists; but their prescriptions had no consimilitude."
                                            }
                                        ]
                                    }
                                ]
                            },
