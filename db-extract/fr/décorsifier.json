                ],
                "senses": [
                    {
                        "sense_id": "22a7b860-91de-31f3-9d5b-b1c92e2782a6",
                        "entry_id": "adfb8cdc-e82d-3edb-b4be-80c5a73b63c1",
                        "glosses": [
                            "Faire perdre son caractère corse à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c14caa6c-cd5d-4405-8be3-6310500d9d2a",
                                "sense_id": "22a7b860-91de-31f3-9d5b-b1c92e2782a6",
                                "text": "Préfets, administrateurs, magistrats, policiers, gendarmes n’ont pas réussi à instaurer l’État de droit que promettait Louis XVIII, mais ils sont parvenus à ébranler sérieusement les structures traditionnelles du peuple corse, qui fut progressivement « décorsifié » sans jamais être vraiment « francisé »."
                            },
                            {
                                "example_id": "e94c9a41-358c-4f1d-b806-e233a85cce0b",
                                "sense_id": "22a7b860-91de-31f3-9d5b-b1c92e2782a6",
                                "text": "On “décorsifie” de plus en plus les emplois : les vicaires, les contrôleurs des tours…, devront être, désormais, di Terra ferma, c’est-à-dire continentaux."
                            },
                            {
                                "example_id": "20135189-b41b-42c9-9ade-d4660dfb9842",
                                "sense_id": "22a7b860-91de-31f3-9d5b-b1c92e2782a6",
                                "text": "Encore un choix de Frédérique Campana : « décorsifier » le dossier, le « désorsoniser », même."
                            },
                            {
                                "example_id": "a8474fb9-da51-4776-8131-a9d5dc61597e",
                                "sense_id": "22a7b860-91de-31f3-9d5b-b1c92e2782a6",
                                "text": "Tu veux tout bazarder pour bien \"décorsifier\" ?"
                            },
                            {
                                "example_id": "41960a0e-65ed-43b6-8f82-eed09096bbdc",
                                "sense_id": "22a7b860-91de-31f3-9d5b-b1c92e2782a6",
                                "text": "L'Intérieur, la Justice et la gendarmerie devront se «décorsifier» progressivement."
                            }
                        ]
                    }
                ],
