                            {
                                "example_id": "0a671651-3250-47b4-868b-f7cf4a895630",
                                "sense_id": "f8b7bd7d-1c33-3199-bd9c-f05d5b32aa4f",
                                "text": "Het Russische mijnbedrijf Nornickel zegt dat uit een pijplijn 44,5 ton vliegtuigbrandstof is gelekt. De vestiging van het dochterbedrijf Norilsktransgaz ligt in het kwetsbare Russische Noordpoolgebied."
                            },
                            {
                                "example_id": "a2fcd01c-22fe-40f4-ad84-4454c5c2e28c",
                                "sense_id": "f8b7bd7d-1c33-3199-bd9c-f05d5b32aa4f",
                                "text": "De afspraak om geen belasting te heffen op vliegtuigbrandstof stamt uit 1944. De afspraken uit het luchtvaartverdrag zijn door de klimaatverandering totaal verouderd, vindt het kabinet. De luchtvaart is inmiddels goed voor 2,5 procent van de CO2-uitstoot, en dat wordt alleen maar meer."
                            }
