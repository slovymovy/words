                        "glosses": [
                            "To treat badly, to abuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5efa7e-2d16-4164-823e-dc386ec4a61e",
                                "sense_id": "0ec2cd10-4577-374e-b2fd-ce23c201a7da",
                                "text": "he received a telegram from the prime minister ordering that on no account were Yacef and Zohra Drif to be maltreated in any way."
                            }
                        ]
