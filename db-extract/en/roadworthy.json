                        "entry_id": "98d31d33-320f-33b5-9d92-c7549739a8dd",
                        "glosses": [
                            "Being able to be driven, or suitable for driving, on the open road."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fbab50-0b8d-4e18-b07e-e42c7694fa62",
                                "sense_id": "10e98a89-e116-34d2-8dda-85fb5b535433",
                                "text": "It was one of the rapidest Constitutions ever put together; made, some say in eight days, by Hérault Séchelles and others; probably a workmanlike, roadworthy Constitution enough; — on which point, however, we are, for some reasons, little called to form a judgment."
                            },
                            {
                                "example_id": "a71ac912-8c21-4de1-88b8-d57d3a0b8533",
                                "sense_id": "10e98a89-e116-34d2-8dda-85fb5b535433",
                                "text": "The coupe shrieked as it hit the curve, but Harry managed the twist with precision and the roadworthy car responded."
                            }
                        ]
                    }
