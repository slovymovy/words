                "senses": [
                    {
                        "sense_id": "80ceaa01-4c6f-36e2-b645-e0c5d4f503ed",
                        "entry_id": "877b80cd-616c-38fd-844f-3c8e4a460382",
                        "glosses": [
                            "Faire perdre son caractère belge à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e27512-fe54-4736-aad9-f90eb6445d4b",
                                "sense_id": "80ceaa01-4c6f-36e2-b645-e0c5d4f503ed",
                                "text": "Maintenant, il serait temps que la Flandre s'attribue tous ses poètes même ceux qui écrivirent en français afin de les « débelgifier »."
                            },
                            {
                                "example_id": "5f7754eb-8397-4a9d-a99b-39b1f22bfac8",
                                "sense_id": "80ceaa01-4c6f-36e2-b645-e0c5d4f503ed",
                                "text": "Tout en se défendant de vouloir jouer la carte d'un protectionnisme d'un autre âge, ils répondent ainsi à un des reproches adressés à Jean-Claude Drouot, celui d'avoir « débelgifié » le Festival."
                            },
                            {
                                "example_id": "daa7cf75-111b-4a86-b4d1-dd79ef7ef9b0",
                                "sense_id": "80ceaa01-4c6f-36e2-b645-e0c5d4f503ed",
                                "text": "Ils ont à assumer la Wallonie, plus la Belgique. Ils ont à se débelgifier!"
                            }
                        ]
                    }
                ],
