                    {
                        "form_id": "cb1a9cf4-093b-47cf-b3d7-0846e49adb5b",
                        "entry_id": "0a30961d-dcee-3820-9358-dcc66d7dcf50",
                        "tags": [
                            "accusative",
                            "plural"
