                        "entry_id": "352988c0-93b9-319d-a625-3d5d8c0eb9b0",
                        "glosses": [
                            "an observation post, a lookout"
                        ],
                        "tags": [
                            "feminine",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "27e336b0-6648-4cc0-825e-65a51ee63e6e",
                                "sense_id": "aacdcd8e-a8d4-3807-9e33-66c5fd0a47d6",
                                "text": "De soldaten hielden de grens in de gaten vanuit een uitkijkpost.",
                                "translation": "The soldiers monitored the border from an observation post.",
                                "english": "The soldiers monitored the border from an observation post."
                            },
                            {
                                "example_id": "f2dfe1c6-c98c-402b-834d-2b09626306b0",
                                "sense_id": "aacdcd8e-a8d4-3807-9e33-66c5fd0a47d6",
                                "text": "De uitkijkpost bood een perfect uitzicht op het omliggende terrein.",
                                "translation": "The lookout provided a perfect view of the surrounding terrain.",
                                "english": "The lookout provided a perfect view of the surrounding terrain."
                            },
                            {
                                "example_id": "acbd80e3-022b-4059-85d5-e88339f50af1",
                                "sense_id": "aacdcd8e-a8d4-3807-9e33-66c5fd0a47d6",
                                "text": "Ze bouwden een klein uitkijkpostje om wilde dieren te observeren.",
                                "translation": "They built a small lookout to observe wild animals.",
                                "english": "They built a small lookout to observe wild animals."
                            }
                        ]
                    }
                ],
