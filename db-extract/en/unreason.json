                    {
                        "translation_id": "d90fe1ba-4712-408c-a930-6919ba668b4e",
                        "source_entry_id": "5f02157a-70df-3d58-b6f0-ea20437cba1e",
                        "source_sense_description": "nonsense, folly",
                        "target_lang_word": "déraison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déraison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                        "entry_id": "362e258f-4d3c-358d-a42a-b5483384cbee",
                                        "glosses": [
                                            "Manière de penser dénuée de raison ; état d’esprit contraire à la raison ou au bon sens commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8ab55b-c9cf-4c9b-b3e3-5d772d4d12bd",
                                                "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                                "text": "Pathétique Vertu qui argumente et, dans sa naïveté, va jusqu'à opposer à la mort la parole d'un philosophe, comme si la raison pouvait lui dicter sa conduite, à elle qui est liberté entière parce qu'elle est entière déraison. C'est l'homme face à l'absurde."
                                            },
                                            {
                                                "example_id": "b21c2154-d1d2-48b5-bcc5-58f22a57a530",
                                                "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                                "text": "Chevallier, décidément, était et agissait en pleine déraison. Malgré son intelligence qui lui disait de rentrer pour affronter lʼadversité, il fit tout le contraire."
                                            },
                                            {
                                                "example_id": "d310a407-f801-4669-8c2c-4e084a85080f",
                                                "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                                "text": "Dans la première partie de ce livre, je me suis livré à la critique de ces déraisons qui enferment l'homme dans sa solitude et qui le condamnent à l'effritement du sens de sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17dda6db-fd86-4481-9868-05e193227c08",
                        "source_entry_id": "5f02157a-70df-3d58-b6f0-ea20437cba1e",
                        "source_sense_description": "nonsense, folly",
                        "target_lang_word": "Torheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Torheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923f9845-1bd5-3b4f-9625-291fb71d00bb",
                                        "entry_id": "a7049b20-9096-36dc-b79c-4961d5fe9567",
                                        "glosses": [
                                            "mangelnde Klugheit, Intelligenz"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c29d0c-63c4-4ee7-9f8c-3ae9918855bc",
                                                "sense_id": "923f9845-1bd5-3b4f-9625-291fb71d00bb",
                                                "text": "Deine Torheit wird uns noch allesamt umbringen."
                                            },
                                            {
                                                "example_id": "acb174ce-f8f3-44f6-8a6a-9f8229598b1d",
                                                "sense_id": "923f9845-1bd5-3b4f-9625-291fb71d00bb",
                                                "text": "„Das Seufzen hatte er schon raus, wie jemand, der hundert Jahre lang im Beichtstuhl gesessen und über die Sünden und Torheiten der Menschheit geseufzt hat.“"
                                            },
                                            {
                                                "example_id": "931b4af3-a367-4bc5-81a4-9e64a96bf389",
                                                "sense_id": "923f9845-1bd5-3b4f-9625-291fb71d00bb",
                                                "text": "„Ich fühlte sogar in meiner Verwirrtheit und Torheit ein Einverständnis mit dem Toten heraus, eine Eintracht, wobei sich beide in ihrem Schweigen über mich lustig machten.“"
                                            },
                                            {
                                                "example_id": "d3a4bc2d-499f-4754-8a0f-da15825d4726",
                                                "sense_id": "923f9845-1bd5-3b4f-9625-291fb71d00bb",
                                                "text": "„Demokrit heißt in der Überlieferung »der lachende Philosoph«, und Wieland zitiert Seneca, der schrieb, man solle über die Torheit der Menschen eher lachen wie Demokrit als zürnen wie Heraklit.“"
                                            },
                                            {
                                                "example_id": "27604205-6eee-4355-90ed-a4e88895a41e",
                                                "sense_id": "923f9845-1bd5-3b4f-9625-291fb71d00bb",
                                                "text": "„Aus meiner Tasche, die ich aus dem Auto mitgebracht hatte, suchte ich mir trockene Kleidung und legte sie an wie einen Schutzschild, eine Schicht aus Jeans, T-Shirt und Pulli, die mich gegen die Welt und gegen die Torheit meiner eigenen Wünsche schützen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7261810-69df-3b17-9e1e-3eedbb376172",
                                        "entry_id": "a7049b20-9096-36dc-b79c-4961d5fe9567",
                                        "glosses": [
                                            "etwas Törichtes, Unvernünftiges, das jemand getan hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f338617-9c38-431c-88df-a3a00fb0e4c2",
                                                "sense_id": "d7261810-69df-3b17-9e1e-3eedbb376172",
                                                "text": "„Kapitän Johnston verpügelte mich nicht wegen dieser Torheit, sondern zog mich nur leicht an den Ohren und tadelte mich streng.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
