                                                "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                                "text": "He snuffs the wind, his heels the sand excite."
                                            },
                                            {
                                                "example_id": "df06f4da-51fd-4e36-9059-a78a3b7ddf56",
                                                "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                                "text": "Earl Walter winds his bugle horn; / To horſe, to horſe, halloo, halloo! / His fiery courſer ſnuffs the morn, / And thronging ſerfs their Lord purſue."
                                            },
                                            {
                                                "example_id": "20675df8-8798-4692-b6fb-dbd92b58099d",
                                                "sense_id": "50aa6282-4860-3b5a-892d-e2882e828311",
                                                "text": "Napoleon paced to and fro in silence, occasionally snuffing at the ground."
                                            }
