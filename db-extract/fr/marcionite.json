                ],
                "senses": [
                    {
                        "sense_id": "72fbb94d-aed7-3857-943c-4a1f41ac1328",
                        "entry_id": "1569f4fe-954c-38ba-969d-23540fe7ddfb",
                        "glosses": [
                            "Sectateur de Marcion, qui admettait deux principes de toutes choses, l’un bon, l’autre mauvais, qui niait la résurrection des corps (la chair étant l’œuvre du mauvais principe), et qui soutenait que Jésus-Christ n’avait eu de cette chair que les apparences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6ae6f8-e724-4c72-b7dd-f9fdca9be4f5",
                                "sense_id": "72fbb94d-aed7-3857-943c-4a1f41ac1328",
                                "text": "Les marcionites sont proches du manichéisme."
                            },
                            {
                                "example_id": "dd3e57cb-3324-4ac2-a2af-7edc562b3e32",
                                "sense_id": "72fbb94d-aed7-3857-943c-4a1f41ac1328",
                                "text": "La perspective de bien gouverner ce monde n’a aucun sens pour le marcionite, pour qui tout le fonctionnement de cette création correspond à la nature et à la logique du Créateur."
                            }
                        ]
                    }
                ],
