                "senses": [
                    {
                        "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                        "entry_id": "240ed639-7d5e-3e55-af7d-3778b652f1e2",
                        "glosses": [
                            "Haarwuchs, bei dem der Haarstrich von einem Zentrum aus spiralförmig angelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4392fc9-2f2c-46fa-bf9f-35d628fbb9b7",
                                "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                                "text": "Haarwirbel hat jeder Mensch, da die menschlichen Kopfhaare immer kreisförmig vom Wirbel aus nach rechts oder links herum wachsen. Sie sind allerdings unterschiedlich stark ausgeprägt."
                            },
                            {
                                "example_id": "22939743-cd35-4442-901a-acdb35fee1d9",
                                "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                                "text": "Auch ein Lockenstab, der schöne große Locken formt, kann Haarwirbel kaschieren."
                            },
                            {
                                "example_id": "57689580-b643-4a7b-aea1-d321e8f42fa7",
                                "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                                "text": "Viele Menschen haben mehrere Haarwirbel, oftmals noch im Ponybereich."
                            },
                            {
                                "example_id": "0015f480-ef6a-4fb0-8a10-2fe7e1b749b4",
                                "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                                "text": "Bei zwei symmetrischen Haarwirbeln am Hinterkopf ergibt sich automatisch ein natürlicher Irokesenschnitt!"
                            },
                            {
                                "example_id": "997c25bd-a41a-408b-9289-e543321ffc9c",
                                "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                                "text": "Der Genexperte vom National Cancer Institute im US-Bundesstaat Maryland hatte die Orientierung der Haarwirbel bei 600 Menschen untersucht und festgestellt, dass 95 Prozent der Rechtshänder einen Wirbel im Uhrzeigersinn haben."
                            },
                            {
                                "example_id": "8b582eeb-4913-4418-bfec-ce08f44d3f0d",
                                "sense_id": "314704cf-3c8b-3873-a8d8-752bf93c9b2f",
                                "text": "Ob ein Pferd lieber rechts oder links herum wendet, lässt sich an seiner Stirn ablesen: Die Richtung des Haarwirbels verrät bei vielen die bevorzugte Seite."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
