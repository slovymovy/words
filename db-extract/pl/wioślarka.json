                "senses": [
                    {
                        "sense_id": "c3f17fcd-f5e2-3959-aaf0-48a3b75833f9",
                        "entry_id": "82dc5d19-9003-321a-8a02-0512115b0823",
                        "glosses": [
                            "kobieta uprawiająca wioślarstwo; taka, która wiosłuje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab8bce0-847d-402a-98ff-bdc3ba7e866a",
                                "sense_id": "c3f17fcd-f5e2-3959-aaf0-48a3b75833f9",
                                "text": "Wioślarka posługuje się dwoma wiosłami osadzonymi w dulkach, siedząc plecami do kierunku ruchu łodzi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4ffc6614-a07c-3b73-8c41-7a83a32ecb1c",
                        "entry_id": "82dc5d19-9003-321a-8a02-0512115b0823",
                        "glosses": [
                            "drobny skorupiak słodkowodny mający dwuczęściową skorupkę i rozwiniętą drugą parą czułków służących do pływania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89aac13-618d-4248-8da1-4f8e30ac3b50",
                                "sense_id": "4ffc6614-a07c-3b73-8c41-7a83a32ecb1c",
                                "text": "Wioślarka pływa przy użyciu drugiej pary czułków."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e113e117-4ac9-4294-8cd5-f9d68bd3d979",
                        "source_entry_id": "82dc5d19-9003-321a-8a02-0512115b0823",
                        "source_sense_id": "c3f17fcd-f5e2-3959-aaf0-48a3b75833f9",
                        "target_lang_word": "rower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                        "entry_id": "8fe1d129-f945-3487-be79-0356c90e0700",
                                        "glosses": [
                                            "One who rows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e236a5ce-42ff-494d-9aca-afed1fe5cc53",
                                                "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                                "text": "It had been a sort of race hitherto, and the rowers, with set teeth and compressed lips, had pulled stroke for stroke."
                                            },
                                            {
                                                "example_id": "f4486bff-0cc8-4d16-b775-beda6f4e1062",
                                                "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                                "text": "Upon her deck were rowers with dream-made oars, and the rowers were the people of men’s fancies, and princes of old story and people who had died, and people who had never been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f319e00-ea4d-34c7-9eb4-b5e6aaffeaaf",
                                        "entry_id": "8fe1d129-f945-3487-be79-0356c90e0700",
                                        "glosses": [
                                            "A rowing machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e284bf7-990f-4792-8b04-429960c0afe4",
                                                "sense_id": "4f319e00-ea4d-34c7-9eb4-b5e6aaffeaaf",
                                                "text": "Aerobic and weight training sessions should also complement each other. For example, on a day you work your upper body with weights, you can use a rower for aerobics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
