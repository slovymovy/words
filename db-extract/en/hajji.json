                                        "entry_id": "6891e069-2709-3f58-bdb5-ead4a306e45c",
                                        "glosses": [
                                            "moslim die gedurende de bedevaartsmaand Mekka bezoekt of ooit een pelgrimstocht naar Mekka heeft afgelegd"
                                        ],
                                        "tags": [
                                            "islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1d1cb7-d4b2-49d5-9345-2a138e488431",
                                                "sense_id": "b7c11659-d33f-3dc9-8145-c097cacebb23",
                                                "text": "Hadji, zo mogen de moslims zich noemen die in Mekka zijn geweest."
                                            },
                                            {
                                                "example_id": "b3f4a253-50de-4246-a8b0-f96c7018358a",
                                                "sense_id": "b7c11659-d33f-3dc9-8145-c097cacebb23",
                                                "text": "De islamistische hadji’s kanaliseerden het sluimerende verzet tegen de blanken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df7a8bcc-b6ff-472d-a037-b347aa6511ac",
