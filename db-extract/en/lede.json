                "senses": [
                    {
                        "sense_id": "311ea5cb-3c4b-31c3-8f10-955261396a99",
                        "entry_id": "efd11275-1b06-3140-b205-172cafde0eba",
                        "glosses": [
                            "A man; a person."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c4eb90be-fee2-4f8f-a3ce-7a1277f95fdc",
                                "sense_id": "311ea5cb-3c4b-31c3-8f10-955261396a99",
                                "text": "& after to callice hee [Thomas Howard, Earl of Surrey] arriued, / like a noble Leed of high degree, / & then to Turwin soone he hyed, / there he thought to haue found King Henery; […]"
                            },
                            {
                                "example_id": "e4d9b87c-05ed-4eef-b68f-488e5901fdb4",
                                "sense_id": "311ea5cb-3c4b-31c3-8f10-955261396a99",
                                "text": "Sweet, yes sweet is over (beyond) measure / The marrying for the young lede (people); / Most sweet it is, I say yet (once more), / When it goes with the rede (counsel) of the elders."
                            },
                            {
                                "example_id": "5361bfb1-a24b-4e0b-9001-588fb9eaa749",
                                "sense_id": "311ea5cb-3c4b-31c3-8f10-955261396a99",
                                "text": "Gramércy, liegé King, / This is to me a comforting: / I tell you sickerly / For to have land or lede / Or other riches, so God me speed, / It is too much for me."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
