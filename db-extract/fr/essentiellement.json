        "fr-extract.jsonl": [
            {
                "entry_id": "59a33ca0-2135-3345-8443-c9e81f32c7c3",
                "word": "essentiellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4bccbada-1553-3e31-9b65-16c5b6a7908c",
                        "entry_id": "59a33ca0-2135-3345-8443-c9e81f32c7c3",
                        "glosses": [
                            "Par essence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ee2b60-b9f1-47e8-946b-4c4153452b74",
                                "sense_id": "4bccbada-1553-3e31-9b65-16c5b6a7908c",
                                "text": "Un moulin à vent se compose essentiellement d'un arbre porté sur un petit bâtiment en bois, qui est susceptible de tourner autour d'un fort pivot vertical, et qui peut par conséquent être orienté convenablement."
                            },
                            {
                                "example_id": "6175978e-bc28-4b36-ad7b-e6521c9e0cc1",
                                "sense_id": "4bccbada-1553-3e31-9b65-16c5b6a7908c",
                                "text": "La moniale bénédictine Hildegarde von Bingen décrivit une cosmologie des affections des plantes qui attribue essentiellement aux vapeurs toxiques du macrocosme les dégâts observés dans les champs du microcosme."
                            },
                            {
                                "example_id": "2b0df0ff-63f4-401e-bbaa-7d9e145f32ad",
                                "sense_id": "4bccbada-1553-3e31-9b65-16c5b6a7908c",
                                "text": "La podzolisation est essentiellement un processus d'altération chimique intense des éléments silicatés, se produisant sous l'action de cet humus brut et libérant des sesquioxydes."
                            },
                            {
                                "example_id": "df145261-5b0a-4dae-bc03-86504477d18f",
                                "sense_id": "4bccbada-1553-3e31-9b65-16c5b6a7908c",
                                "text": "Il est nécessaire, pour la conservation du corps, que nous ayons des sensations essentiellement différentes, quoique les impressions que les objets font sur notre corps ne diffèrent que très peu."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bc210ce-8edd-3251-88b3-8ab6b23f1e04",
                        "entry_id": "59a33ca0-2135-3345-8443-c9e81f32c7c3",
                        "glosses": [
                            "À un très haut degré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10953c0-b4b4-45a1-a868-05675f3d7ba1",
                                "sense_id": "0bc210ce-8edd-3251-88b3-8ab6b23f1e04",
                                "text": "Des discours […] lesquels à la vérité n’attaquaient pas essentiellement votre honneur et votre probité, mais qui répandaient dans le public […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd950dc1-4825-4a7e-87fa-a764c1e3d5cb",
                        "source_entry_id": "59a33ca0-2135-3345-8443-c9e81f32c7c3",
                        "source_sense_description": "par essence",
                        "target_lang_word": "wesentlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wesentlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb67c5b-07a2-3e75-a2cf-d1dd30e376a2",
                                        "entry_id": "185c5d58-9d16-307e-aeb0-7dd3147f3a57",
                                        "glosses": [
                                            "den größten Anteil ausmachend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc91dd9-9bfd-425f-93bc-aff3f0f803ee",
                                                "sense_id": "8bb67c5b-07a2-3e75-a2cf-d1dd30e376a2",
                                                "text": "Er hatte einen wesentlichen Anteil daran, dass das Abkommen jetzt unterschriftsreif ist."
                                            },
                                            {
                                                "example_id": "352b9f68-685d-4876-b6b4-0ab70f3bd668",
                                                "sense_id": "8bb67c5b-07a2-3e75-a2cf-d1dd30e376a2",
                                                "text": "Die wesentlichen Änderungen in der neuen Version sind folgende:…"
                                            },
                                            {
                                                "example_id": "72510e54-84e6-4c2c-b2c3-f034883f67b0",
                                                "sense_id": "8bb67c5b-07a2-3e75-a2cf-d1dd30e376a2",
                                                "text": "„Ein wesentlicher Teil der gesetzgeberischen Tätigkeit betraf die Religionspolitik, weil angesichts der vielen Abweichler der Bedarf an Einheitlichkeit besonders groß war.“"
                                            },
                                            {
                                                "example_id": "da1aa62f-7a46-48fc-8637-16536683d288",
                                                "sense_id": "8bb67c5b-07a2-3e75-a2cf-d1dd30e376a2",
                                                "text": "„Davon sollten nicht zuletzt diejenigen unserer Studierenden profitieren, die Deutschlehrerinnen und Deutschlehrer werden, denn sie vermitteln ganz wesentlich zwischen Linguistik und Öffentlichkeit.“"
                                            },
                                            {
                                                "example_id": "1f420660-29d9-4950-aed3-79c89b0223e7",
                                                "sense_id": "8bb67c5b-07a2-3e75-a2cf-d1dd30e376a2",
                                                "text": "Als eine wesentliche Ursache für die Klimaveränderung gelten bestimmte Luftschadstoffe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b762e59e-866d-34f1-8a08-f11048965dc5",
                                        "entry_id": "185c5d58-9d16-307e-aeb0-7dd3147f3a57",
                                        "glosses": [
                                            "den wirklichen Kern, das Wesen (einer Sache) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a17a5cdd-9c90-4f8d-8cb9-2ae78f678db6",
                                                "sense_id": "b762e59e-866d-34f1-8a08-f11048965dc5",
                                                "text": "Als eine wesentliche Ursache für die Klimaveränderung gelten bestimmte Luftschadstoffe."
                                            },
                                            {
                                                "example_id": "04c16011-13aa-481f-80a3-740bc68250a9",
                                                "sense_id": "b762e59e-866d-34f1-8a08-f11048965dc5",
                                                "text": "„Der wesentliche Unterschied zwischen beiden Sportarten besteht in den Fluggeräten.“"
                                            },
                                            {
                                                "example_id": "fb7c315c-1004-4cda-8e64-8ac84b51aa9a",
                                                "sense_id": "b762e59e-866d-34f1-8a08-f11048965dc5",
                                                "text": "„Dementsprechend stehen Mängel, gleichgültig, ob sie vom Auftraggeber bei der Abnahme gerügt sind oder nicht, der Abnahme als solcher nicht entgegen, solange es sich nicht um wesentliche Mängel handelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e696e142-9252-3213-9d1b-eccc80e5ab3d",
                                        "entry_id": "185c5d58-9d16-307e-aeb0-7dd3147f3a57",
                                        "glosses": [
                                            "sehr, um ein Vielfaches des Angesprochenen"
                                        ],
                                        "tags": [
                                            "adverbielle Verwendung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8196988-59d2-4660-be1f-a371374046c5",
                                                "sense_id": "e696e142-9252-3213-9d1b-eccc80e5ab3d",
                                                "text": "Das ist jetzt aber wesentlich teurer als ich dachte!"
                                            },
                                            {
                                                "example_id": "cf04d73c-e06f-4eee-87b0-e13e12e78c61",
                                                "sense_id": "e696e142-9252-3213-9d1b-eccc80e5ab3d",
                                                "text": "Wenn du das Tempo nicht wesentlich erhöhst, brauchst du gar nicht mitzulaufen."
                                            },
                                            {
                                                "example_id": "76183e06-15d3-4616-bd81-8efb55e175a3",
                                                "sense_id": "e696e142-9252-3213-9d1b-eccc80e5ab3d",
                                                "text": "„Ein konventionell bewirtschafteter Acker weist eine wesentlich geringere Artenvielfalt auf als einer im Biolandbau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ff49869-b31e-4a08-af3e-01f6c7672ab6",
