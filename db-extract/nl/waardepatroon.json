                        "glosses": [
                            "samenhangend geheel van waarden van een individu, groep of samenleving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b7802e-5ccd-4608-a794-2747c0a4c2d9",
                                "sense_id": "6855432c-4cfc-380c-ac22-d8399313440d",
                                "text": "Familiebedrijven worden vaak geleid door mensen uit de familie. Vaak zijn dat mannen die ouder zijn dan de huidige generatie millennials. Zij gaan – vanuit een soort waardepatroon – minder flexibel om met werktijden."
                            },
                            {
                                "example_id": "40aeba48-e7b8-4c20-9131-9c29c95628d2",
                                "sense_id": "6855432c-4cfc-380c-ac22-d8399313440d",
                                "text": "Boomsma: “Én we zijn een moreel kompas kwijt. Aan de instituten vroeger – of het nu denkstromingen waren, kerken of zuilen – zat een duidelijk waardepatroon vast. Er was altijd een manier om goed en kwaad te meten. Dat is weg. Waar horen we bij? Welke kant gaan we op? Er is geen anker.”"
                            }
                        ]
                    }
