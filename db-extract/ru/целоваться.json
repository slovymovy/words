                "senses": [
                    {
                        "sense_id": "1cdc5a4d-aa26-39b0-bfb0-577962f52788",
                        "entry_id": "3be57556-f2a3-3e74-ae8b-3286adecc7eb",
                        "glosses": [
                            "целовать друг друга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f256a3a9-b2b7-4508-874c-cef6f755e6a6",
                                "sense_id": "1cdc5a4d-aa26-39b0-bfb0-577962f52788",
                                "text": "А кто насплетничал, будто я с Марфой целовался?"
                            }
                        ]
                    },
                    {
                        "sense_id": "30470d48-7a1e-3640-8004-f7b288b137c1",
                        "entry_id": "3be57556-f2a3-3e74-ae8b-3286adecc7eb",
                        "glosses": [
                            "перен., разг. совершать небольшое столкновение автомобилей друг с другом"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbed702a-348a-48a5-9ff4-4725ef8323ab",
                        "source_entry_id": "3be57556-f2a3-3e74-ae8b-3286adecc7eb",
                        "source_sense_description": "целовать друг друга",
                        "target_lang_word": "kiss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc821801-f48f-3e2e-b852-535872aaae02",
                                        "entry_id": "7caac7d0-b99e-349c-82f5-127869bd94ef",
                                        "glosses": [
                                            "To touch with the lips or press the lips against, usually to show love or affection or passion, or as part of a greeting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab045db-01e4-4c90-8f4b-72dd90ac6f54",
                                                "sense_id": "fc821801-f48f-3e2e-b852-535872aaae02",
                                                "text": "He […] kissed her lips with such a clamorous smack, / That at the parting all the church echoed."
                                            },
                                            {
                                                "example_id": "a4b52cca-7bd5-427e-b79f-cb45b7db2e71",
                                                "sense_id": "fc821801-f48f-3e2e-b852-535872aaae02",
                                                "text": "I'll kiss thy foot. I'll swear myself thy subject."
                                            },
                                            {
                                                "example_id": "185258c4-6f50-4f0d-8750-87846414336d",
                                                "sense_id": "fc821801-f48f-3e2e-b852-535872aaae02",
                                                "text": "But then I had the [massive] flintlock by me for protection. […] The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            },
                                            {
                                                "example_id": "b4fa7115-e095-48f6-922b-b2860a5f4873",
                                                "sense_id": "fc821801-f48f-3e2e-b852-535872aaae02",
                                                "text": "I kissed a girl and I liked it / The taste of her cherry chapstick / I kissed a girl just to try it / I hope my boyfriend don't mind it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                                        "entry_id": "7caac7d0-b99e-349c-82f5-127869bd94ef",
                                        "glosses": [
                                            "To (cause to) touch lightly or slightly; to come into contact."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bec6155-daa4-4d32-af68-a4c543c8eb97",
                                                "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                                                "text": "The nearside of the car just kissed a parked truck as he took the corner at high speed."
                                            },
                                            {
                                                "example_id": "6ec291fb-111f-4f61-a86f-45b2171c15b5",
                                                "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                                                "text": "His ball kissed the black into the corner pocket."
                                            },
                                            {
                                                "example_id": "044c251d-22bc-4104-a143-836d828abaea",
                                                "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                                                "text": "Like fire and powder, / Which as they kiss consume."
                                            },
                                            {
                                                "example_id": "b91bfc47-7551-4344-ac85-ccb133a5dce6",
                                                "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                                                "text": "Rose, rose and clematis, / Trail and twine and clasp and kiss, / Kiss, kiss; and make her a bower / All of flowers, and drop me a flower, / Drop me a flower."
                                            },
                                            {
                                                "example_id": "32a46e24-23cc-4f0e-ad0c-2a4a13b87a91",
                                                "sense_id": "b9ccffa7-3eab-3db1-b83a-e21f2facce9b",
                                                "text": "Night hath fled away into the valleys. The dawn kisseth the mountain tops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94703121-3daf-3ae8-ae2e-910d5013b51f",
                                        "entry_id": "7caac7d0-b99e-349c-82f5-127869bd94ef",
                                        "glosses": [
                                            "Of two or more people, to touch each other's lips together, usually to express love or affection or passion."
                                        ],
                                        "tags": [
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64198a34-3fa2-40e0-a5a2-12fd9378be5e",
                                                "sense_id": "94703121-3daf-3ae8-ae2e-910d5013b51f",
                                                "text": "We're kissing in the moonlight / Love was shining so bright and true"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05be2ace-1b93-3060-acbf-fe4964a57989",
                                        "entry_id": "7caac7d0-b99e-349c-82f5-127869bd94ef",
                                        "glosses": [
                                            "To treat with fondness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kiss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc2c8f7-cf0e-3fe1-9cb3-c856fb01d3c1",
                                        "entry_id": "7c657d6b-50a9-381f-b5a4-43ecc80c511e",
                                        "glosses": [
                                            "A touch with the lips, usually to express love or affection, or as a greeting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684d8705-4a2e-4af5-a626-e28986c19430",
                                                "sense_id": "1fc2c8f7-cf0e-3fe1-9cb3-c856fb01d3c1",
                                                "text": "“It was the most absurd kiss. I don't believe he'd ever kissed a woman in his life before. I threw my head back, and it was a sort of slidy, pecking dab, just on the end of the chin — here.” Mrs. Hauksbee tapped her masculine little chin with her fan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1875c0dd-96e3-3e76-afa2-d58a9ce81e76",
                                        "entry_id": "7c657d6b-50a9-381f-b5a4-43ecc80c511e",
                                        "glosses": [
                                            "An 'X' mark placed at the end of a letter or other type of message, signifying the bestowal of a kiss from the sender to the receiver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52419de7-ca01-43ab-aa90-6e68f35ca5bc",
                                                "sense_id": "1875c0dd-96e3-3e76-afa2-d58a9ce81e76",
                                                "text": "With some satisfaction, Gergory read this through twice, signed it and added kisses[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a36b10d-7293-3f2c-8692-15c1ae01c1a2",
                                        "entry_id": "7c657d6b-50a9-381f-b5a4-43ecc80c511e",
                                        "glosses": [
                                            "A type of filled chocolate candy, shaped as if someone had kissed the top. See Hershey's Kisses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6a922ce-03a2-3065-9921-5c89ca533c18",
                                        "entry_id": "7c657d6b-50a9-381f-b5a4-43ecc80c511e",
                                        "glosses": [
                                            "The alignment of two bodies in the solar system such that they have the same longitude when seen from Earth; conjunction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "938f9e8a-cbdc-3a29-a0c5-088f4dc0a1ec",
                                        "entry_id": "7c657d6b-50a9-381f-b5a4-43ecc80c511e",
                                        "glosses": [
                                            "A low-speed mid-air collision between the envelopes of two hot air balloons, generally causing no damage or injury."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
