                                        "glosses": [
                                            "One who meditates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41afe75-c835-4b7e-a11f-65127521102f",
                                                "sense_id": "047f6e5d-9e26-368e-9533-df965c648289",
                                                "text": "In the zendo, she settled herself in her teacher’s old seat and looked out over the room at the rows of meditators who were settling on their cushions, turning to face the smooth, white walls."
