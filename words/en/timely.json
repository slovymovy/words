                            {
                                "target_lang_word": "размеренный",
                                "target_lang_sense_clarification": "ровный по темпу"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rhythmisch",
                                "target_lang_sense_clarification": "einen Rhythmus aufweisend"
                            },
                            {
                                "target_lang_word": "taktgerecht",
                                "target_lang_sense_clarification": "im richtigen Takt"
                            }
                        ]
                    }
                }
            ]
        },
        {
