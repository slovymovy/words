                    {
                        "sense_id": "6c087c87-c65f-3ed5-9472-18c5caf294ee",
                        "entry_id": "4593eade-88f7-362f-a8a9-dcda11c82be1",
                        "glosses": [
                            "Synonym of spectacular mark."
                        ],
                        "tags": [
                            "Australia",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "877bbcec-6efe-4bb3-b617-1ba5933251e1",
                                "sense_id": "6c087c87-c65f-3ed5-9472-18c5caf294ee",
                                "text": "‘Snake was just talking about you, said you take a mean specky,’ she said.\nAdam felt his face colour. His marking skills weren′t that great."
                            }
                        ]
                    }
                ],
