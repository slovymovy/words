                ],
                "senses": [
                    {
                        "sense_id": "1e094431-59e1-3326-9a63-049026c48058",
                        "entry_id": "8fbebe7a-eac2-3dbf-8781-b9a5252679cb",
                        "glosses": [
                            "Gruppe geographisch benachbarter Sprachen, die sich in ihren sprachlichen Eigenschaften aufgrund anhaltendes Kontakts gegenseitig beeinflusst haben."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d160e2-2024-45a9-a218-e37b25dce673",
                                "sense_id": "1e094431-59e1-3326-9a63-049026c48058",
                                "text": "Ein Sprachbund ist das Ergebnis wechselseitiger Beeinflussung geographisch benachbarter Sprachen."
                            },
                            {
                                "example_id": "f84f17c4-4126-41a2-a1a3-3fc8ac7e7a3d",
                                "sense_id": "1e094431-59e1-3326-9a63-049026c48058",
                                "text": "„Wenn diese gegenseitige Annäherung ein bestimmtes Ausmaß erreicht hat, spricht man mit Trubetzkoy von Sprachbund...“"
                            },
                            {
                                "example_id": "0b7e911d-52aa-4fc3-9378-1237b2e4ff1b",
                                "sense_id": "1e094431-59e1-3326-9a63-049026c48058",
                                "text": "„Je nach der für einen Sprachbund kennzeichnenden strukturtypischen Merkmalkombination ist es möglich, daß eine Sprache nicht nur einem sondern zwei verschiedenen Arealtypen zugeordnet werden kann.“"
                            },
                            {
                                "example_id": "13126757-eb25-44be-a5c7-dfa245e34a49",
                                "sense_id": "1e094431-59e1-3326-9a63-049026c48058",
                                "text": "„Vom Sprachbund zu unterscheiden ist die Sprachfamilie, die vor allem durch einen gemeinsamen Bestand grammatischer Morpheme und häufig gebrauchter Wörter gekennzeichnet ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
