                "senses": [
                    {
                        "sense_id": "8a418952-e4b5-33d7-8629-956455171a93",
                        "entry_id": "be44edbe-b168-3e0c-b19a-019a9e31622d",
                        "glosses": [
                            "A cooking technique used in Japanese cuisine in which foods are broiled or grilled in a sweet soy sauce marinade."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2944d2f2-42c1-35d6-87c5-fb8572ded51b",
                        "entry_id": "be44edbe-b168-3e0c-b19a-019a9e31622d",
                        "glosses": [
                            "A sweet soy sauce marinade."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1199be05-8819-4410-8bbd-c70ed1ec915e",
                                "sense_id": "2944d2f2-42c1-35d6-87c5-fb8572ded51b",
                                "text": "Put some teriyaki on it."
                            },
                            {
                                "example_id": "b1cb3576-357f-4710-bd4c-39d15eb6a267",
                                "sense_id": "2944d2f2-42c1-35d6-87c5-fb8572ded51b",
                                "text": "Teriyaki sauce, a mixture of mirin, sake, soy sauce, and sometimes sugar, may be brushed on meats, fish, or vegetables […]"
                            },
                            {
                                "example_id": "a9df8f6f-df13-4678-84d8-e24afca6f647",
                                "sense_id": "2944d2f2-42c1-35d6-87c5-fb8572ded51b",
                                "text": "Japan West, an LA restaurant in the '80s, made a huge impression on my sauces. The chef was the father of my grade-school best friend, Mark Tagnipez. We'd watch him make teriyaki from scratch […]"
                            }
                        ]
                    }
                ],
