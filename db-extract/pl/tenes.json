                    {
                        "translation_id": "8e2b4331-22b5-428b-8332-3c59562c01e3",
                        "source_entry_id": "df6d97ad-c685-3354-a723-fe3906c9772f",
                        "source_sense_id": "75f52cf5-f522-3371-b88b-87805f4a0aca",
