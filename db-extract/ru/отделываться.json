                                "sense_id": "c2ec7f34-4898-35e3-b481-107b58a46a5f",
                                "text": "отде́лываться цара́пинами",
                                "translation": "to get off/away with slight cuts",
                                "english": "to get off/away with slight cuts"
                            },
                            {
                                "example_id": "ece9ce88-0b6a-4910-a753-dd502ce4ae43",
                                "sense_id": "c2ec7f34-4898-35e3-b481-107b58a46a5f",
                                "text": "дёшево отде́лываться",
                                "translation": "to get off easy/cheap",
                                "english": "to get off easy/cheap"
                            },
                            {
                                "example_id": "12c8eac4-5df0-47e1-a8a5-24e301a1189a",
                                "sense_id": "c2ec7f34-4898-35e3-b481-107b58a46a5f",
                                "text": "сча́стливо/счастли́во отде́лываться",
