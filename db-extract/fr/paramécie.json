                "senses": [
                    {
                        "sense_id": "e875664c-69b4-3975-9364-1d02e5967f73",
                        "entry_id": "03e0b490-c8f4-3008-a4e4-99e6f46c97d5",
                        "glosses": [
                            "Genre de grand protozoaire cilié de la famille des Parameciidae, de nom scientifique Paramecium, commun dans les étendues d’eau douce ^([1])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4324d3-dd44-4a76-ae6d-fccf41dce9ea",
                                "sense_id": "e875664c-69b4-3975-9364-1d02e5967f73",
                                "text": "Si la paramécie apparaît comme un modèle de choix pour analyser les composantes épigénétiques de l’hérédité, cela tient sans doute à sa complexité structurale et fonctionnelle qui en fait une sorte de métazoaire non cellularisé"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2803b6eb-0460-4a16-a703-0542a00ce97f",
                        "source_entry_id": "03e0b490-c8f4-3008-a4e4-99e6f46c97d5",
                        "source_sense_id": "e875664c-69b4-3975-9364-1d02e5967f73",
                        "source_sense_description": "Grand protozoaire cilié",
                        "target_lang_word": "Pantoffeltierchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pantoffeltierchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e75b417-a03c-3aa2-a8a0-60f785e6e2d3",
                                        "entry_id": "ef74e16d-b216-3777-9d07-f0e0df128154",
                                        "glosses": [
                                            "einzelliges Lebewesen, welches sich von Bakterien ernährt und sich mithilfe seiner zahlreichen Wimpern fortbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7c8c5c-5c35-40ee-84c2-0bd9735df33a",
                                                "sense_id": "1e75b417-a03c-3aa2-a8a0-60f785e6e2d3",
                                                "text": "„Pantoffeltierchen sind frei lebende, sich aktiv bewegende Einzeller mit einer Länge zwischen 50 und 300 Mikrometern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edfa96aa-5b57-45ba-94d1-291ed991973d",
                        "source_entry_id": "03e0b490-c8f4-3008-a4e4-99e6f46c97d5",
                        "source_sense_id": "e875664c-69b4-3975-9364-1d02e5967f73",
                        "source_sense_description": "Grand protozoaire cilié",
                        "target_lang_word": "paramecium",
                        "target_lang_code": "en",
