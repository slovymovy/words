                "senses": [
                    {
                        "sense_id": "e6a578e8-df36-3e01-9ac3-06d2f1bae166",
                        "entry_id": "7d0fb6be-8636-3185-8edc-0d9a7e1ef716",
                        "glosses": [
                            "To mix together; to intermingle or blend."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b1ee6f8-4213-49f8-b288-1f38a878d65d",
                                "sense_id": "e6a578e8-df36-3e01-9ac3-06d2f1bae166",
                                "text": "Either that, or “you have two different groups of hominins with two totally different toolmaking traditions occupying the same landscape at the same time yet never intermixing,” said the study’s lead author, Daniel Adler, an anthropologist at the University of Connecticut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c04574b7-8983-498c-8596-1af151f2f715",
                        "source_entry_id": "7d0fb6be-8636-3185-8edc-0d9a7e1ef716",
                        "source_sense_id": "e6a578e8-df36-3e01-9ac3-06d2f1bae166",
                        "source_sense_description": "mix together",
                        "target_lang_word": "entremêler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entremêler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                        "entry_id": "65a5bf19-9d58-3bbe-8fc3-0de0fec00907",
                                        "glosses": [
                                            "Mêler, insérer plusieurs choses parmi d’autres dont elles diffèrent plus ou moins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6f3dee-04aa-4eb3-bd55-f4b7be95eff7",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Entremêler des fleurs rouges parmi des blanches."
                                            },
                                            {
                                                "example_id": "842f6e63-0c3b-4886-8ff1-769c16318630",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Entremêler des livres et des brochures."
                                            },
                                            {
                                                "example_id": "1e740734-2d54-46bd-b1b8-8c79b84a9e0f",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Il faut entremêler ces orangers et ces grenadiers."
                                            },
                                            {
                                                "example_id": "277f2efb-c9da-49e3-af63-f58c792aa508",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Des nuances qui s’entremêlent."
                                            },
                                            {
                                                "example_id": "f92cb122-f33e-4f1d-b0a2-0ea4839bdeec",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Il ne faut point entremêler des questions si différentes."
                                            },
                                            {
                                                "example_id": "252b7fa8-3094-4626-a8cd-6c3101d272c8",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Entremêler des plaisanteries et des propos sérieux."
                                            },
                                            {
                                                "example_id": "446d3b57-2ab6-42b4-a86d-f6ee9897ec3d",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "Un travail entremêlé de lectures."
                                            },
                                            {
                                                "example_id": "d40da095-6ff7-424f-b280-00a029138e24",
                                                "sense_id": "20600579-4dde-3ff1-b1cc-0734370b040a",
                                                "text": "C’était un Marseillais qui ne parlait que de la Canebière, du cabanon, d’Olive, de Marius, de pêche à la rascasse. On l’aurait laissé faire, il eût entremêlé L’Internationale de galéjades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "353fc108-8315-4295-b697-272f340f0feb",
                        "source_entry_id": "7d0fb6be-8636-3185-8edc-0d9a7e1ef716",
                        "source_sense_id": "e6a578e8-df36-3e01-9ac3-06d2f1bae166",
                        "source_sense_description": "mix together",
                        "target_lang_word": "mélanger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mélanger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63b0dcbb-b094-3c8d-a77a-b6e19a723483",
                                        "entry_id": "ec58583a-f5c7-3109-add5-9b6119a5c8c0",
                                        "glosses": [
                                            "Unir une chose avec une autre, ou plusieurs choses ensemble, de façon qu’elles forment comme un tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62533272-e5bc-4282-b479-bee2346719a9",
                                                "sense_id": "63b0dcbb-b094-3c8d-a77a-b6e19a723483",
                                                "text": "Les sables sont les matières que l'on mélange le plus habituellement à la chaux pour former les mortiers ; ils doivent être rudes au toucher et crier quand on les serre dans la main."
                                            },
                                            {
                                                "example_id": "4443e766-2c4a-4e6c-9f37-2f524500e7f0",
                                                "sense_id": "63b0dcbb-b094-3c8d-a77a-b6e19a723483",
                                                "text": "Je veux simplement examiner la toxicité de certaines graines étrangères qui se trouvent mélangées à l'avoine en proportion parfois importante et auxquelles on attribue des propriétés toxiques : l’ivraie enivrante et la nielle."
                                            },
                                            {
                                                "example_id": "1a3868ef-9803-451a-b084-c8321b7a54e9",
                                                "sense_id": "63b0dcbb-b094-3c8d-a77a-b6e19a723483",
                                                "text": "Ajoutez le furikake (ou le gomashio) et mélangez délicatement afin de ne pas écraser les grains de riz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "245d8474-21c7-37aa-b372-99c7ff4e141f",
                                        "entry_id": "ec58583a-f5c7-3109-add5-9b6119a5c8c0",
                                        "glosses": [
                                            "Ne pas faire la distinction entre plusieurs choses."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353d1a68-6448-4628-ae2f-c25b4f045265",
                                                "sense_id": "245d8474-21c7-37aa-b372-99c7ff4e141f",
                                                "text": "Tu mélanges tout, là : celui-ci et celui-là ne sont pas les mêmes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6114620-d224-37a8-84e4-5ca7618fa8b6",
                                        "entry_id": "ec58583a-f5c7-3109-add5-9b6119a5c8c0",
                                        "glosses": [
                                            "Provoquer la confusion chez quelqu’un."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a0750aa-2eeb-4255-8b60-f18944395399",
                                                "sense_id": "b6114620-d224-37a8-84e4-5ca7618fa8b6",
                                                "text": "Ses explications m’ont mélangé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff12ee81-bdc0-35ac-a664-b8842c6fa0c2",
                                        "entry_id": "ec58583a-f5c7-3109-add5-9b6119a5c8c0",
                                        "glosses": [
                                            "s’embrouiller."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e24e23e2-e302-48c2-8b6b-e8b7c8300c0b",
                                                "sense_id": "ff12ee81-bdc0-35ac-a664-b8842c6fa0c2",
                                                "text": "Je me suis mélangé les pédales ; les pinceaux."
                                            },
                                            {
                                                "example_id": "8e7f60ce-e85c-4795-bfc1-d67422044ddc",
                                                "sense_id": "ff12ee81-bdc0-35ac-a664-b8842c6fa0c2",
                                                "text": "Vous devez piger que c’est pas tellement commode pour moi de ce côté-ci de la frontière, et que si j’ai pas envie de me mélanger avec les flics locaux, faut que je joue en peinard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
