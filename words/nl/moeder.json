                                "pl": "<w>Spółka matka</w> określa politykę dla wszystkich międzynarodowych oddziałów.",
                                "de": "Die <w>Muttergesellschaft</w> bestimmt die Richtlinien für alle internationalen Niederlassungen.",
                                "it": "La <w>casa madre</w> stabilisce la politica per tutte le filiali internazionali.",
                                "cs": "<w>Mateřská společnost</w> určuje strategii pro všechny mezinárodní pobočky.",
                                "tr": "<w>Ana şirket</w> tüm uluslararası şubelerin politikasını belirler.",
                                "es": "La <w>empresa matriz</w> determina la política para todas las sucursales internacionales."
                            }
                        },
                        {
                            "text": "Dit bedrijf fungeert als <w>moeder</w> voor diverse kleine startups.",
                            "target_lang_translations": {
                                "ru": "Эта компания действует как <w>материнская</w> для различных мелких стартапов.",
                                "en": "This company acts as a <w>parent</w> for various small startups.",
                                "fr": "Cette entreprise sert de <w>maison mère</w> à plusieurs petites startups.",
                                "pl": "Ta firma działa jako <w>firma matka</w> dla różnych małych startupów.",
                                "de": "Dieses Unternehmen fungiert als <w>Mutter</w> für verschiedene kleine Start-ups.",
