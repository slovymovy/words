                ],
                "senses": [
                    {
                        "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                        "entry_id": "8658d0ff-8ece-373c-afd4-ed6de063012d",
                        "glosses": [
                            "zuvor nie erreichter Höhepunkt einer Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf9c0d10-2454-49a0-836d-02a52b40ba48",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "Die deutsche Wirtschaft befindet sich in einem Rekordhoch."
                            },
                            {
                                "example_id": "2fbde510-1181-41cb-b32b-c1a9bcb70457",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "[Schlagzeile:] „Emissionen weltweit auf Rekordhoch“"
                            },
                            {
                                "example_id": "8a84e8c9-0713-48dd-837e-45aee9807fa7",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "„Vor einer Woche erreichte der Bitcoin ein neues Rekordhoch von 58.000 US-Dollar.“"
                            },
                            {
                                "example_id": "0509137d-e0be-4af2-a37f-77e9b3fc1100",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "[Aktien:] „Bereits 2021 erfüllten sich die Hoffnungen auf ein erfolgreiches Börsenjahr nicht: Schwellenländeraktien verloren rund sieben Prozent, während die Börsen in USA und Europa von einem Rekordhoch zum nächsten eilten.“"
                            },
                            {
                                "example_id": "57b186c3-4396-423a-ada3-accb516bd31d",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "„Im Euroraum hat sich der Höhenflug der Verbraucherpreise fortgesetzt und die Inflation auf ein Rekordhoch getrieben.“"
                            },
                            {
                                "example_id": "213b4c73-5778-4e36-ae50-7c946de51f69",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "„Doch nicht nur Öl und Gas werden deutlich teurer. Auch der Preis für Palladium ist auf ein Rekordhoch von gut 3440 Dollar je Feinunze gesprungen“ […]."
                            },
                            {
                                "example_id": "ae3e2696-ee04-49d7-a8b5-d8e96da61eb7",
                                "sense_id": "e44d05a5-fd5c-3435-a9f8-051d6bd755cc",
                                "text": "„Während sich die Wirtschaft in den USA insgesamt erholt, sind die Mieten auf ein neues Rekordhoch gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
