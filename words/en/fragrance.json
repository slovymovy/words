{
    "word_family": [
        "fragrant",
        "fragrantly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b7f32b4-6480-348d-9ba1-d446f4700d1c",
                    "sense_definition": "A pleasant or sweet smell.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fragrance</w> of fresh flowers filled the entire room.",
                            "target_lang_translations": {
                                "ru": "<w>Аромат</w> свежих цветов наполнил всю комнату.",
                                "nl": "De <w>geur</w> van verse bloemen vulde de hele kamer."
                            }
                        },
                        {
                            "text": "The chef added herbs to give the dish a more elegant <w>fragrance</w>.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар добавил травы, чтобы придать блюду более изысканный <w>аромат</w>.",
                                "nl": "De chef voegde kruiden toe om het gerecht een eleganter <w>aroma</w> te geven."
                            }
                        }
                    ],
                    "synonyms": [
                        "aroma",
                        "scent"
                    ],
                    "common_phrases": [
                        "elegant fragrance",
                        "sweet fragrance",
                        "floral fragrance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный или сладкий запах.",
                        "nl": "Een aangename of zoete geur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аромат",
                                "target_lang_sense_clarification": "приятный запах"
                            },
                            {
                                "target_lang_word": "благоухание",
                                "target_lang_sense_clarification": "книжное, поэтическое описание приятного запаха"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "geur",
                                "target_lang_sense_clarification": "aangename reuk"
                            },
                            {
                                "target_lang_word": "aroma",
                                "target_lang_sense_clarification": "lekkere geur, vaak van kruiden, eten of bloemen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60272d91-6646-3062-a418-d14553d3c8de",
                    "sense_definition": "A liquid substance, such as perfume or cologne, used to give a pleasant smell to one's body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perfumery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to buy a new <w>fragrance</w> for her mother's birthday.",
                            "target_lang_translations": {
                                "ru": "Она решила купить новый <w>аромат</w> ко дню рождения матери.",
                                "nl": "Ze besloot een nieuw <w>parfum</w> te kopen voor de verjaardag van haar moeder."
                            }
                        },
                        {
                            "text": "Sales of women's <w>fragrances</w> are often higher than those for men.",
                            "target_lang_translations": {
                                "ru": "Продажи женских <w>ароматов</w> часто выше, чем мужских.",
                                "nl": "De verkoop van dames<w>parfums</w> is vaak hoger dan die voor heren."
                            }
                        }
                    ],
                    "synonyms": [
                        "perfume",
                        "scent"
                    ],
                    "common_phrases": [
                        "signature fragrance",
                        "expensive fragrance",
                        "women's fragrance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкое вещество, такое как духи или одеколон, используемое для придания телу приятного запаха.",
                        "nl": "Een vloeistof, zoals parfum of eau de cologne, die gebruikt wordt om het lichaam een lekkere geur te geven."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аромат",
                                "target_lang_sense_clarification": "парфюмерное изделие"
                            },
                            {
                                "target_lang_word": "парфюм",
                                "target_lang_sense_clarification": "общее название для духов и туалетной воды"
                            },
                            {
                                "target_lang_word": "духи",
                                "target_lang_sense_clarification": "парфюмерное средство"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "parfum",
                                "target_lang_sense_clarification": "geurmiddel voor het lichaam"
                            },
                            {
                                "target_lang_word": "geur",
                                "target_lang_sense_clarification": "geurtje of parfum"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60423c36-510c-3c1d-b3f6-efae91a7aa4f",
                    "sense_definition": "To apply a scent or perfume to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer decided to <w>fragrance</w> the soap with natural oils.",
                            "target_lang_translations": {
                                "ru": "Производитель решил <w>ароматизировать</w> мыло натуральными маслами.",
                                "nl": "De fabrikant besloot de zeep te <w>parfumeren</w> met natuurlijke oliën."
                            }
                        },
                        {
                            "text": "They <w>fragranced</w> the air in the lobby to welcome the guests.",
                            "target_lang_translations": {
                                "ru": "Они <w>ароматизировали</w> воздух в вестибюле, чтобы поприветствовать гостей.",
                                "nl": "Ze <w>parfumeerden</w> de lucht in de lobby om de gasten te verwelkomen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить аромат или парфюм на что-либо.",
                        "nl": "Iets voorzien van een geur of parfum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ароматизировать",
                                "target_lang_sense_clarification": "придавать аромат"
                            },
                            {
                                "target_lang_word": "надушить",
                                "target_lang_sense_clarification": "использовать парфюм"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "parfumeren",
                                "target_lang_sense_clarification": "voorzien van een lekker geurtje of parfum"
                            },
                            {
                                "target_lang_word": "aromatiseren",
                                "target_lang_sense_clarification": "een aroma toevoegen aan iets"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}