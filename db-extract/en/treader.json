                        "examples": [
                            {
                                "example_id": "b4fe4b59-31b1-4c94-94cb-e2bf4fa2eb4e",
                                "sense_id": "990981fb-ffa8-33ca-820a-d7790451d684",
                                "text": "Why, he weren’t no more’n knocked offen his treader. An’ now he’ve rid off home on it!"
                            },
                            {
                                "example_id": "35df909e-773b-4fc5-90b7-08d3ba358f24",
                                "sense_id": "990981fb-ffa8-33ca-820a-d7790451d684",
                                "text": "The Royal Academy has just two orange hoops on to which four early-bird visitors can chain their treaders. It is left to the railings outside for the rest."
                            },
                            {
                                "example_id": "dcc89371-b576-466c-aff2-e004453247b8",
                                "sense_id": "990981fb-ffa8-33ca-820a-d7790451d684",
                                "text": "He set off from Oxford on a standard old \"treader\" bike, often at night – navigating by the stars and napping under a hedge if got^([sic]) tired on his way to Holt."
                            }
                        ]
