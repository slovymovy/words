                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spit",
                                "target_lang_sense_clarification": "to eject saliva from the mouth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72dda365-ad64-374a-8993-51a878696477",
                    "sense_definition": "vloeistof, vuur of ander materiaal met grote kracht naar buiten uitstoten",
