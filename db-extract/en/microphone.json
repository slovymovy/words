                                            {
                                                "example_id": "f41b0103-3d38-4d34-a9fc-41f893699191",
                                                "sense_id": "bbe12f28-3a29-3d8a-a865-b27dc3015a50",
                                                "text": "Piosenkarz trzymał usta tak blisko mikrofonu, że mało go nie połknął!"
