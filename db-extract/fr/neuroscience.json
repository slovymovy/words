        "fr-extract.jsonl": [
            {
                "entry_id": "da9633c6-a43f-308e-9fda-213522257a33",
                "word": "neuroscience",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "232b8a6b-c69e-4169-ae0b-62bf7f8f7d1f",
                        "entry_id": "da9633c6-a43f-308e-9fda-213522257a33",
                        "tags": [
                            "plural"
                        ],
                        "form": "neurosciences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                        "entry_id": "da9633c6-a43f-308e-9fda-213522257a33",
                        "glosses": [
                            "Science transdisciplinaire (notamment neurobiologie, chimie, mathématiques, bio-informatique, neuropsychologie) qui étudie certains aspects des neurones et du système nerveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83a7bbd-4e52-4baa-a240-c51e6e2247c7",
                                "sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                                "text": "Avec un souci commun de conceptualisation et de modélisation théorique, ces disciplines ont fécondé un nouveau champ de recherches : la neuroscience, née en 1971, aux États-Unis, avec la première réunion de la Society of Neuroscience."
                            },
                            {
                                "example_id": "88e6a492-1f68-403d-9398-7922c1055c2c",
                                "sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                                "text": "Notre première incursion dans les neurosciences de la vie mentale inconsciente est bien loin de remettre en cause la conception scientifique classique qui dominait les esprits depuis un siècle. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 55)"
                            },
                            {
                                "example_id": "51f88b41-fbf2-4d69-8514-c3447bc975ef",
                                "sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                                "text": "La technologie a été mise au point par une équipe de l'Institut néerlandais de neurosciences (NIN) et décrite dans la revue Science parue jeudi."
                            },
                            {
                                "example_id": "b96fa59d-a9c5-4393-95c0-73214642eb0b",
                                "sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                                "text": "La recherche d’agents neuroprotecteurs dans le cadre d’un accident ou d’une maladie neurologique est une priorité des Neurosciences."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "264c5db1-d782-4dc9-8c50-2aa8aae1ab5d",
                        "source_entry_id": "da9633c6-a43f-308e-9fda-213522257a33",
                        "source_sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                        "target_lang_word": "Neurowissenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurowissenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c3eb36-4c8f-37cf-bd5f-30c5f3b33b9d",
                                        "entry_id": "be72e3f1-08c2-38ab-bfde-ff14b2740431",
                                        "glosses": [
                                            "jede Forschungsrichtung, die sich mit der Erforschung des (menschlichen) Gehirns und des Zentralnervensystems beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0adb7006-c3a0-4e6d-b334-5f773b2f5704",
                                                "sense_id": "f5c3eb36-4c8f-37cf-bd5f-30c5f3b33b9d",
                                                "text": "„Die Neurowissenschaften sind in unserer Zeit eine wissenschaftliche Leitdisziplin geworden. Dieser leitdisziplinäre Charakter der Neurowissenschaften ist wesentlich dadurch zu erklären, dass die Neurowissenschaften heute Fragen zu beantworten suchen, die direkt unsere Alltagserfahrung und unser menschliches Selbstverständnis berühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6bf55db-8b7a-4d1c-b5e8-6d5dfce0712a",
                        "source_entry_id": "da9633c6-a43f-308e-9fda-213522257a33",
                        "source_sense_id": "480e0ee5-e303-33d7-9f48-f2542c918374",
                        "target_lang_word": "neuroscience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neuroscience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                        "entry_id": "27d1a8e0-7229-37d1-bd5e-09e978e594f7",
                                        "glosses": [
                                            "The scientific study of the nervous system."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03da633c-eb13-4401-b5fb-c7d3bf073114",
                                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                                "text": "Meronym: brain science"
                                            },
                                            {
                                                "example_id": "476ac1df-5bc1-4db7-b70f-cb715f6f64b0",
                                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                                "text": "Near-synonym: neurobiology"
                                            },
                                            {
                                                "example_id": "a3bde6b4-6dae-4532-a7c6-60c755de290b",
                                                "sense_id": "ad21d3c9-16d4-36e4-aa2c-e2e66543d38b",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
