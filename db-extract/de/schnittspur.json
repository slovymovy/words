                        "entry_id": "f50ab8e5-384c-3b95-9183-bfcdd91b9c03",
                        "glosses": [
                            "durch Schneiden mit einem Werkzeug verursachtes Merkmal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6fbfd2-be53-431f-8d58-817055dd1f10",
                                "sense_id": "ba10576f-9c73-38fd-9834-984662b6dac7",
                                "text": "„Die Schnittspuren waren sehr wahrscheinlich entstanden, als die Steinzeitmenschen das Fleisch von den Knochen und Sehnen lösten, um es leichter verzehren zu können.“"
                            },
                            {
                                "example_id": "bd42e2da-de15-4f83-b897-e8bb09d32d9f",
                                "sense_id": "ba10576f-9c73-38fd-9834-984662b6dac7",
                                "text": "„Die Röhrenknochen hatte man aufgebrochen, um an das Mark zu kommen, Schnittspuren zeugten davon, dass das Fleisch mit einer scharfen Klinge von den Knochen geschabt worden war.“"
                            }
                        ],
