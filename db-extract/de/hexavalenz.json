                "senses": [
                    {
                        "sense_id": "93d4a024-137d-3c85-9419-71ccdba30ecf",
                        "entry_id": "d1814b8d-9396-3a15-a742-a2f79813e72f",
                        "glosses": [
                            "Eigenschaft, mit sechs anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "01ca83dc-bb89-472e-9fb5-ffcdb832c77f",
                                "sense_id": "93d4a024-137d-3c85-9419-71ccdba30ecf",
                                "text": "„Eine der Hexavalenz des Molybdäns entsprechende Chlorstufe, Mo Cle, ist nicht bekannt und scheint nicht existenzfähig zu sein.“"
                            },
                            {
                                "example_id": "3b29f12b-9856-418e-83ce-e507acd48cb6",
                                "sense_id": "93d4a024-137d-3c85-9419-71ccdba30ecf",
                                "text": "„Ganz ähnliche Argumente können für eine Tetravalenz und sogar für eine Hexavalenz des, gewöhnlich bivalent auftretenden, Schwefels aufgeführt werden.“"
                            },
                            {
                                "example_id": "e91e0a6f-6abb-42f7-8bda-b9d9f1d95cab",
                                "sense_id": "93d4a024-137d-3c85-9419-71ccdba30ecf",
                                "text": "„Zieht man die Hexavalenz des Schwefels in Betracht, so “"
                            },
                            {
                                "example_id": "42a61670-434b-4254-a1aa-73209c2fbf65",
                                "sense_id": "93d4a024-137d-3c85-9419-71ccdba30ecf",
                                "text": "„Zieht man die Hexavalenz des Schwefels in Betracht , so lässt sich ferner die Bildung von Jodsalzen der Formel R′₅SJ erwarten, doch sind solche Substanzen bis jetzt noch nicht mit Bestimmtheit bekannt.“"
                            },
                            {
                                "example_id": "440fb573-5b2b-4648-b633-a6ed6b73eaa7",
                                "sense_id": "93d4a024-137d-3c85-9419-71ccdba30ecf",
                                "text": "„ Cleve aber hat sich auf Grund der Zusammensetzung mehrerer Verbindungen der seltenen Erden für die Dreiwertigkeit ausgesprochen und findet nur wenige auf Hexavalenz deutende Daten, wie z. B. die Zusammensetzung des Didymchloraurats, Lanthan- und Ceracetats, Natriumdidymcarbonats und einzelner Kaliumsulfatdoppelsalze.“"
                            }
                        ],
