                "senses": [
                    {
                        "sense_id": "2e9f099d-419a-3ba3-8aa6-f4604da86b6b",
                        "entry_id": "efc45bd0-67a3-3381-a41d-09d1290dba36",
                        "glosses": [
                            "Unterbrechung einer Tätigkeit zur Zeit des Abends"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05bd9d6a-cf82-47e1-89c9-6e5c7eb67788",
                                "sense_id": "2e9f099d-419a-3ba3-8aa6-f4604da86b6b",
                                "text": "„Nikkam erkundigte sich bei einem Kranen nach dem Verbleib der Restmannschaft und erhielt zur Antwort, sie hätten sich entschlossen, früher als üblich zur Abendpause zu gehen.“"
                            },
                            {
                                "example_id": "ae576095-1b88-42b4-99a1-34a00a47d04e",
                                "sense_id": "2e9f099d-419a-3ba3-8aa6-f4604da86b6b",
                                "text": "„Für diese Schichtmodelle gab es noch eine Abendpause von 17.55 bis 18.25 Uhr.“"
                            },
                            {
                                "example_id": "2214dae0-ccb5-47f9-b0bd-88d95d739a6b",
                                "sense_id": "2e9f099d-419a-3ba3-8aa6-f4604da86b6b",
                                "text": "„Ein nicht ganz unbekannter Sportjournalist schleppt sich nach seiner kurzen Abendpause nach der Fertigstellung der ersten Ausgabe zurück in die Redaktion.“"
                            },
                            {
                                "example_id": "c1b27879-6702-4682-bf9a-a4470a218a81",
                                "sense_id": "2e9f099d-419a-3ba3-8aa6-f4604da86b6b",
                                "text": "„Meine Damen und Herren, ich möchte vor der Abendpause noch einem Redner, nämlich Herrn von Merkatz, das Wort geben.“"
                            },
                            {
                                "example_id": "186a1faf-e153-4481-92a2-e297acab9ce8",
                                "sense_id": "2e9f099d-419a-3ba3-8aa6-f4604da86b6b",
                                "text": "„Nach diesem Gespräch fängt die Abendpause an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
