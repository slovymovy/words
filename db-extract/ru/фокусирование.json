                "senses": [
                    {
                        "sense_id": "e0ca2f44-aabd-36cd-8afc-e5b929e33a4f",
                        "entry_id": "befeb5f3-f83c-3ce4-a089-68dae09369ed",
                        "glosses": [
                            "действие или состояние по значению гл. фокусировать, фокусироваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfa81a2-4d32-4f4d-a8b7-20cb29a5595f",
                                "sense_id": "e0ca2f44-aabd-36cd-8afc-e5b929e33a4f",
                                "text": "Внутреннее фокусирование — конструктивная особенность некоторых объективов, благодаря которой наведение на резкость происходит посредством взаимного смещения внутренних оптических элементов."
                            },
                            {
                                "example_id": "36d5e6ef-88e9-4702-98d0-76e6f8bb9cc5",
                                "sense_id": "e0ca2f44-aabd-36cd-8afc-e5b929e33a4f",
                                "text": "Фокусирование излучения на мишень обычно осуществлялось объективом с фокусным расстоянием f=45 мм, светосилой 1 : 1 и пропусканием около 70%."
                            }
                        ]
                    }
