                ],
                "senses": [
                    {
                        "sense_id": "3c59442f-fc76-3443-8ff1-a039a9e82bcf",
                        "entry_id": "f2c3924e-80ee-3cd2-9ea3-bdc63ff0c0de",
                        "glosses": [
                            "derjenige Schutzheilige, dem ein Kirchengebäude (Kirche, Kapelle, Seitenkapelle, Altar oder Ähnliches) oder eine Kirchenorganisation (Pfarrei, Diözese, Bistum oder Ähnliches) geweiht ist oder geweiht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b302364b-36c9-4328-9492-c43fb7f18384",
                                "sense_id": "3c59442f-fc76-3443-8ff1-a039a9e82bcf",
                                "text": "„Herrera malte in S. Buenaventura, ausser den noch erhaltenen Mönchsfiguren der Decke, vier Scenen aus dem Leben des Titularheiligen, denen Zubaran vier andere hinzufügte.“"
                            },
                            {
                                "example_id": "187ae9b9-fdb2-408f-9cb5-c0110830fcba",
                                "sense_id": "3c59442f-fc76-3443-8ff1-a039a9e82bcf",
                                "text": "„St. Honoratus, der Titularheilige des Schreins, stand in der Mitte unter dem Dreibogen der vorderen Seite, umgeben von den Heiligen Paneratius und Quirinus.“"
                            },
                            {
                                "example_id": "5e9f21f3-f486-48a8-a884-298ad00d8e29",
                                "sense_id": "3c59442f-fc76-3443-8ff1-a039a9e82bcf",
                                "text": "„Die Lage der Pfarrkirche auf einer Insel der Schmutter, der Titularheilige Johannes der Täufer, der Abgang eines großen Ortes bei der Hauptkirche der Gegend, die Ausdehnung des Pfarrsprengels, – alles dieses legt die Annahme nahe, daß wir hier eine alte Taufstätte und Taufkirche (ecclesia baptismalis) haben, […]“"
                            },
                            {
                                "example_id": "3d573752-da9d-4e87-8425-4c9464a18454",
                                "sense_id": "3c59442f-fc76-3443-8ff1-a039a9e82bcf",
                                "text": "„Der heilige Vigil ist der Titularheilige des Bistums Trient, ihm wurden in Südtirol, das in seinem Südteil zumindest kirchlich lange zu Trient gehörte, die eine oder andere Kirche geweiht […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
