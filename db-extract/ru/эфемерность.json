                ],
                "senses": [
                    {
                        "sense_id": "de15e314-c0c9-351a-baf2-af57264cd025",
                        "entry_id": "95345001-b7ea-397c-87a7-bf2bcad0b883",
                        "glosses": [
                            "свойство по значению прилагательного эфемерный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce5b75e-6633-4f6e-9d87-d21a2f4eff68",
                                "sense_id": "de15e314-c0c9-351a-baf2-af57264cd025",
                                "text": "О, тщета! О, эфемерность! О, самое бессильное и позорное время в жизни моего народа — время от рассвета до открытия магазинов!"
                            },
                            {
                                "example_id": "5f5eafee-d32c-497a-95e4-866a23121e3f",
                                "sense_id": "de15e314-c0c9-351a-baf2-af57264cd025",
                                "text": "Так, архаизируя настоящее, модернизируя прошлое и анахронизируя и то и другое, мы боремся с эфемерностью эпохи, в эфемерной же надежде «схватить» вневременное во временном."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bff8cb4f-f86f-4ff2-8b47-76e357357e7b",
                        "source_entry_id": "95345001-b7ea-397c-87a7-bf2bcad0b883",
                        "source_sense_id": "de15e314-c0c9-351a-baf2-af57264cd025",
                        "target_lang_word": "ephemerality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ephemerality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71b20d85-40d3-3bd9-bf7c-34296d8515ad",
                                        "entry_id": "d97efad2-006e-3333-b1a0-174fe2085d00",
                                        "glosses": [
                                            "The state or condition of being ephemeral; transience."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e558b906-bf21-482a-8a6d-753ff3537575",
                                                "sense_id": "71b20d85-40d3-3bd9-bf7c-34296d8515ad",
                                                "text": "But in that quest, we sometimes lose sight of a central tenet: Nature’s ephemerality makes it all the more enchanting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211210a4-6e82-3585-988c-3869caf89e11",
                                        "entry_id": "d97efad2-006e-3333-b1a0-174fe2085d00",
                                        "glosses": [
                                            "Something that is ephemeral."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6097b81-e857-42cf-bb97-2a3b724dbbe2",
                                                "sense_id": "211210a4-6e82-3585-988c-3869caf89e11",
                                                "text": "So, too, the multiplication of bathrooms and the over-expenditure on broadly paved motor roads, and above all, the massive collective concentration on glib ephemeralities of all kinds, performed with supreme technical audacity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
