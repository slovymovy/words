                {
                    "sense_id": "cd816888-1258-3575-82b5-f17cfe56338c",
                    "sense_definition": "een sterke negatieve emotie voelen of uiten tegenover iemand of iets",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn vader was erg <w>boos</w> omdat ik de dure vaas had gebroken.",
                            "target_lang_translations": {
