                            {
                                "example_id": "2c042ade-78d9-4e34-bdbd-526ebb5f2773",
                                "sense_id": "d040fc24-adc3-3c76-96b6-9b9184f33f4e",
                                "text": "W cieniu drzew stał mężczyzna z wycelowanym we mnie obrzynem."
