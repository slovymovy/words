                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54ad8ac2-b66b-3119-9aae-092f9cf03799",
                                        "entry_id": "700925be-22e4-3270-a2e8-5fee5b915097",
                                        "glosses": [
                                            "Instrument de musique à vent, composé de tuyaux et d’une outre formée d’une peau de mouton, qu’on enfle grâce au premier tuyau appelé porte-vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06ac81e-6a69-4b78-acb7-6796e8f12fcf",
                                                "sense_id": "54ad8ac2-b66b-3119-9aae-092f9cf03799",
                                                "text": "Il lui semblait entendre, à travers le brouillard, le son des cornemuses écossaises se répéter sur les bruyères."
                                            },
                                            {
                                                "example_id": "aae704f3-6a86-480d-afb5-f161232dc63d",
                                                "sense_id": "54ad8ac2-b66b-3119-9aae-092f9cf03799",
                                                "text": "Le Kevrenn Kastell compte dans ses rangs, bombardes, cornemuses, caisses-claires et percussions."
                                            },
                                            {
                                                "example_id": "e1b1b11a-50e4-459c-95f1-365a963c5f6d",
                                                "sense_id": "54ad8ac2-b66b-3119-9aae-092f9cf03799",
                                                "text": "Tenant sa cornemuse par les bois, comme on saisit un lièvre aux oreilles, le piper courut jusqu’au château donner l’alerte."
                                            }
                                        ]
                                    }
                                ]
