                        "examples": []
                    },
                    {
                        "sense_id": "e03edbda-0b5f-3c50-b1c5-62f884e275a4",
                        "entry_id": "fed5da86-0cd0-3b32-8a51-3f7513100439",
                        "glosses": [
                            "An Aboriginal who sleeps rough in parks."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c25d24c9-e2a9-4ebe-b7a2-8f1d8bf3670a",
                                "sense_id": "e03edbda-0b5f-3c50-b1c5-62f884e275a4",
                                "text": "Walking into the inner-city Brisbane suburb of West End one morning, I witnessed a group of Aboriginal “parkies” being moved on from a corner of the main road."
                            },
                            {
                                "example_id": "b984d0a4-f41b-43c0-af1a-3b006ac85211",
                                "sense_id": "e03edbda-0b5f-3c50-b1c5-62f884e275a4",
                                "text": "The health service was a sanctuary for Aboriginal people, especially the “parkies” – a young Roach among them – who were living on the nearby streets, many having gravitated to inner-city Melbourne to try to trace their families after years spent on reserves and missions."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dcc9dad-ac92-3a91-bd06-514b10ddd523",
                        "entry_id": "fed5da86-0cd0-3b32-8a51-3f7513100439",
                        "glosses": [
                            "A parking or traffic warden."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aceba4d6-ae45-3ff6-89f8-a3b7c7c25110",
                        "entry_id": "fed5da86-0cd0-3b32-8a51-3f7513100439",
                        "glosses": [
                            "A person with Parkinson's disease."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d433b739-1465-4b68-95ed-450756893073",
                                "sense_id": "aceba4d6-ae45-3ff6-89f8-a3b7c7c25110",
                                "text": "Some people with Parkinson’s embrace being called a ‘Parkie’, while others hate the term."
                            }
                        ]
                    }
