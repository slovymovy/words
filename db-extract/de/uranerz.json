                ],
                "senses": [
                    {
                        "sense_id": "5769aa3a-9f71-3059-939a-46d58c2a2eba",
                        "entry_id": "baa247f6-9595-3ad4-a362-146f52c4ec62",
                        "glosses": [
                            "Uran enthaltendes Erz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f65b2e-8645-40a9-9f92-c940652f4f42",
                                "sense_id": "5769aa3a-9f71-3059-939a-46d58c2a2eba",
                                "text": "„Unabhängig vom Alter der Nebengesteine schwanken die Altersbestimmungen der Uranerze zwischen 53 Millionen und 190 Millionen Jahren.“"
                            },
                            {
                                "example_id": "26449eb4-8cdb-461a-b949-69e1d66b9e61",
                                "sense_id": "5769aa3a-9f71-3059-939a-46d58c2a2eba",
                                "text": "„Der Geologe war begeistert über die Messwerte und dem im Boden befindlichen Uranerz.“"
                            },
                            {
                                "example_id": "d6b1beeb-9e73-4d3f-b393-5ca8ed8c9cb3",
                                "sense_id": "5769aa3a-9f71-3059-939a-46d58c2a2eba",
                                "text": "„Heute kommen die Uranerze erst nach Amerika, wenn sie von Kupfer, Kobalt und anderen leicht abspaltbaren Elementen befreit worden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
