                "translations": [
                    {
                        "translation_id": "bdccb4f0-5d6f-403b-9cb4-1bda39bd1a11",
                        "source_entry_id": "96a023ff-a511-34cc-aecb-c9dd72385726",
                        "source_sense_id": "e6588410-72e4-3ccd-87b9-a35c5b7e1090",
                        "source_sense_description": "performer who takes the accompanying part",
                        "target_lang_word": "accompagnateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accompagnateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec182ef-c3a7-348c-8ef1-e1da4fb50e72",
                                        "entry_id": "23f24ad0-32b5-3348-be86-e1563475ba58",
                                        "glosses": [
                                            "Celui qui accompagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5baa9cbf-e531-42b2-9013-915f3432e394",
                                                "sense_id": "0ec182ef-c3a7-348c-8ef1-e1da4fb50e72",
                                                "text": "Tout accompagnateur, entre autres obligations administratives, est en effet tenu de se déclarer à la Direction départementale de la jeunesse et des sports dont dépend son activité, et à l'URSSAF."
                                            },
                                            {
                                                "example_id": "2c67588b-ac87-46b5-ba67-fd42e1bffa54",
                                                "sense_id": "0ec182ef-c3a7-348c-8ef1-e1da4fb50e72",
                                                "text": "Les enseignants remercient chaleureusement les accompagnateurs : Jean-Pierre Bernardie, Annie Dacher, Françoise Pompier, Mélanie, Laëtitia, sans oublier l’APE qui a pris en charge le coût de la visite et les deux ateliers, ainsi que la municipalité qui a financé quant à elle le transport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e82c80-492b-369c-8730-1d4f361fcdb6",
                                        "entry_id": "23f24ad0-32b5-3348-be86-e1563475ba58",
                                        "glosses": [
                                            "Celui qui exécute un accompagnement musical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b4cdc1-d74e-45c8-9b6d-6774354ebcc4",
                                                "sense_id": "a1e82c80-492b-369c-8730-1d4f361fcdb6",
                                                "text": "Cette cantatrice, ce virtuose amène son accompagnateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2e0ff71-578a-4a12-b2c1-69ecac661471",
                        "source_entry_id": "96a023ff-a511-34cc-aecb-c9dd72385726",
                        "source_sense_id": "e6588410-72e4-3ccd-87b9-a35c5b7e1090",
                        "source_sense_description": "performer who takes the accompanying part",
                        "target_lang_word": "accompagnatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accompagnatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c400e8c-fe71-3a88-b5a5-c8a4c24a6b76",
                                        "entry_id": "a3ffc208-c445-3850-8d2d-ba98d9284d83",
                                        "glosses": [
                                            "Celle qui accompagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86217b6d-39db-4274-a1eb-7bc36dc9ec37",
                                                "sense_id": "5c400e8c-fe71-3a88-b5a5-c8a4c24a6b76",
                                                "text": "Il ne faut pas se fier aux apparences : Ilham Grida, jeune femme au visage angélique et à la silhouette svelte et élancée exerce le métier à haut risque de policière accompagnatrice des personnalités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7aebe5c-3a2f-37e3-8808-7fcbfa196287",
