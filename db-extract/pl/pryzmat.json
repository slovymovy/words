                    {
                        "translation_id": "d4a23538-bc8c-44e6-a3a3-6389cee6d933",
                        "source_entry_id": "529b6c59-c5ce-3788-a49d-5073d7cafc73",
                        "source_sense_id": "3d79d1a9-243a-3b22-8b63-f4f7f16c60ca",
