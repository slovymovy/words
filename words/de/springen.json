                    "sense_definition": "sich mit Schwung vom Boden abstoßen und kurz durch die Luft bewegen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die fröhlichen Kinder <w>springen</w> im Garten immer wieder vor Freude in die Luft."
                        },
                        {
                            "text": "Das braune Pferd kann ohne Probleme über das hohe Hindernis <w>springen</w>."
                        }
                    ],
                    "synonyms": [
                        "hüpfen",
                        "hopsen"
                    ],
                    "common_phrases": [
                        "in die Luft springen",
                        "über ein Hindernis springen"
                    ]
                },
                {
                    "sense_id": "36bf7437-cb33-35b8-8b6f-8e9523f8c411",
                    "sense_definition": "sich von einer erhöhten Stelle nach unten oder in etwas hineinfallen lassen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
