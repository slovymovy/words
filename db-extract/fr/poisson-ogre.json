                "senses": [
                    {
                        "sense_id": "de63dcd8-2428-3065-aed5-33d4cde8c088",
                        "entry_id": "2f69456d-cb3d-3aca-8c39-a1da52970a33",
                        "glosses": [
                            "Espèce de petit poisson abyssal, d’une quinzaine de centimètres, à la dentition particulièrement visible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864958f5-40ed-4c43-94dc-53f4f1ac5f56",
                                "sense_id": "de63dcd8-2428-3065-aed5-33d4cde8c088",
                                "text": "Le poisson-ogre vit dans les grands fonds marins des eaux tropicales, subtropicales et tempérées du monde entier, entre 500 et 5 000 mètres de profondeur."
                            },
                            {
                                "example_id": "507b1a34-bf0f-4a63-9c35-caa012e0196d",
                                "sense_id": "de63dcd8-2428-3065-aed5-33d4cde8c088",
                                "text": "Le poisson-ogre existe-t-il ? Bien sûr ! Les dents de ce petit poisson sont si grandes qu’il ne peut pas fermer sa mâchoire."
                            },
                            {
                                "example_id": "5084d519-b879-4c03-9ae7-9c03dd6aff73",
                                "sense_id": "de63dcd8-2428-3065-aed5-33d4cde8c088",
                                "text": "D’une apparence repoussante, le poisson-ogre s’abrite dans les profondeurs abyssales les moins explorées."
                            }
                        ]
                    }
                ],
