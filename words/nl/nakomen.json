            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4a29a98-7a98-3aef-ab24-45053d313034",
                    "sense_definition": "aan een verplichting, belofte of afspraak voldoen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voldoen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik betwijfel of hij die belofte wel <w>na zal komen</w>.",
                            "target_lang_translations": {
                                "en": "I doubt whether he <w>will keep</w> that promise.",
                                "it": "Dubito che <w>manterrà</w> quella promessa."
                            }
                        },
                        {
                            "text": "Het is erg belangrijk dat je de gemaakte afspraken altijd <w>nakomt</w>.",
                            "target_lang_translations": {
                                "en": "It is very important that you always <w>honor</w> the agreements made.",
                                "it": "È molto importante che tu <w>rispetti</w> sempre gli accordi presi."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervullen",
                        "volbrengen",
                        "voldoen",
                        "zich houden aan",
                        "naleven"
                    ],
                    "antonyms": [
                        "schenden",
                        "verbreken"
                    ],
                    "common_phrases": [
                        "belofte nakomen",
                        "afspraak nakomen",
                        "verplichting nakomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fulfill an obligation, promise, or agreement.",
                        "it": "Adempiere a un obbligo, una promessa o un accordo."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to keep",
                                "target_lang_sense_clarification": "a promise or agreement"
                            },
                            {
                                "target_lang_word": "to fulfill",
                                "target_lang_sense_clarification": "an obligation or duty"
                            },
                            {
                                "target_lang_word": "to honor",
                                "target_lang_sense_clarification": "a commitment or contract"
                            },
                            {
                                "target_lang_word": "to comply with",
                                "target_lang_sense_clarification": "rules or requirements"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "mantenere",
                                "target_lang_sense_clarification": "riferito a una promessa o un impegno"
                            },
                            {
                                "target_lang_word": "adempiere",
                                "target_lang_sense_clarification": "riferito a un obbligo o un dovere"
                            },
                            {
                                "target_lang_word": "rispettare",
                                "target_lang_sense_clarification": "riferito a un accordo o una regola"
                            },
                            {
                                "target_lang_word": "onorare",
                                "target_lang_sense_clarification": "riferito a un impegno o un contratto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13b36d0a-492b-30e9-b711-e1289585b0e6",
                    "sense_definition": "op een later tijdstip arriveren dan de rest van de groep",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arriveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat hij eerst nog moest werken, <w>kwam</w> hij later <w>na</w>.",
                            "target_lang_translations": {
                                "en": "Because he had to work first, he <w>followed later</w>.",
                                "it": "Dato che doveva ancora lavorare, è <w>arrivato in seguito</w>."
                            }
                        },
                        {
                            "text": "De rest van de familie is al op het feest, maar mijn broer zal vanavond <w>nakomen</w>.",
                            "target_lang_translations": {
                                "en": "The rest of the family is already at the party, but my brother will <w>join later</w> tonight.",
                                "it": "Il resto della famiglia è già alla festa, ma mio fratello ci <w>raggiungerà</w> stasera."
                            }
                        }
                    ],
                    "synonyms": [
                        "achternakomen"
                    ],
                    "antonyms": [
                        "vooruitgaan"
                    ],
                    "common_phrases": [
                        "later nakomen"
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive at a later time than the rest of the group.",
                        "it": "Arrivare in un momento successivo rispetto al resto del gruppo."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to follow later",
                                "target_lang_sense_clarification": "arriving after others"
                            },
                            {
                                "target_lang_word": "to join later",
                                "target_lang_sense_clarification": "meeting up with a group already there"
                            },
                            {
                                "target_lang_word": "to come along later",
                                "target_lang_sense_clarification": "arriving separately after the start"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "arrivare in seguito",
                                "target_lang_sense_clarification": "giungere dopo gli altri"
                            },
                            {
                                "target_lang_word": "raggiungere in un secondo momento",
                                "target_lang_sense_clarification": "unirsi a un gruppo già presente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
