                                    {
                                        "sense_id": "d6e66d84-2b3f-3666-8fcc-7742d932a7ed",
                                        "entry_id": "90ed0084-4a15-3981-a1aa-0d0080017695",
                                        "glosses": [
                                            "Saint Columba of Iona, one of the Gaelic missionary monks who reintroduced Christianity to Scotland during the Dark Ages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a5fd14e-2001-36da-aba7-599041596ec4",
                                        "entry_id": "90ed0084-4a15-3981-a1aa-0d0080017695",
                                        "glosses": [
                                            "Any of three other Christian saints who bore the name Columba."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f8858b9-ae54-3d5b-b305-363e14486428",
                                        "entry_id": "90ed0084-4a15-3981-a1aa-0d0080017695",
                                        "glosses": [
