                                        "examples": [
                                            {
                                                "example_id": "420dd61b-47d3-4108-a6eb-c9ea70a6fcfd",
                                                "sense_id": "16069fd8-8d01-33e8-9c8d-eaee1618dfe8",
                                                "text": "This would haue better done in Poeſy; where Tranſcendencies are more allowed."
                                            }
                                        ]
