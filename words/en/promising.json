{
    "word_family": [
        "promise",
        "promisor",
        "promisee",
        "promissory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb04edeb-4ee9-38a1-97fb-b369aea23069",
                    "sense_definition": "Showing signs of future success or being likely to develop in a desirable way",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "positive_outlook",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The initial results of the medical trial are very <w>promising</w> for patients with this condition.",
                            "target_lang_translations": {
                                "ru": "Первые результаты медицинских испытаний очень <w>многообещающие</w> для пациентов с этим заболеванием."
                            }
                        },
                        {
                            "text": "She is a <w>promising</w> young athlete who has already won several national competitions.",
                            "target_lang_translations": {
                                "ru": "Она — <w>перспективная</w> молодая спортсменка, которая уже выиграла несколько национальных соревнований."
                            }
                        }
                    ],
                    "synonyms": [
                        "rosy"
                    ],
                    "antonyms": [
                        "unpromising",
                        "hopeless"
                    ],
                    "common_phrases": [
                        "promising start",
                        "promising future",
                        "highly promising"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывающий признаки будущего успеха или вероятность развития в желаемом направлении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многообещающий",
                                "target_lang_sense_clarification": "дающий надежду на успех"
                            },
                            {
                                "target_lang_word": "перспективный",
                                "target_lang_sense_clarification": "имеющий хорошие возможности для развития"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbaa9254-85f8-352b-a8ba-90d627451bf6",
                    "sense_definition": "Encouraging and inspiring confidence about a particular outcome",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positive_outlook",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast looks <w>promising</w> for our outdoor wedding this weekend.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды выглядит <w>обнадеживающим</w> для нашей свадьбы на открытом воздухе в эти выходные."
                            }
                        },
                        {
                            "text": "Despite the <w>promising</w> signs of economic recovery, many people are still struggling.",
                            "target_lang_translations": {
                                "ru": "Несмотря на <w>благоприятные</w> признаки восстановления экономики, многие люди все еще испытывают трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "rosy"
                    ],
                    "antonyms": [
                        "discouraging"
                    ],
                    "common_phrases": [
                        "promising signs",
                        "look promising"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обнадеживающий и внушающий уверенность в определенном исходе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнадеживающий",
                                "target_lang_sense_clarification": "внушающий надежду"
                            },
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "способствующий успеху"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ad5e48f-e669-3051-81fa-6224c052eed0",
                    "sense_definition": "The present participle and gerund of <w>promise</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>promising</w> to finish the report by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Он <w>обещает</w> закончить отчет к завтрашнему утру."
                            }
                        },
                        {
                            "text": "By <w>promising</w> to help, she made everyone feel much more relaxed.",
                            "target_lang_translations": {
                                "ru": "<w>Пообещав</w> помочь, она заставила всех почувствовать себя гораздо спокойнее."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «обещать»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обещающий",
                                "target_lang_sense_clarification": "дающий обещание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a449342-0297-3fbc-936a-6e3c3603e26f",
                    "sense_definition": "The act of making a promise or giving one's word",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that <w>promisings</w> are essential social contracts in any functional society.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>обещания</w> являются важнейшими социальными контрактами в любом функциональном обществе."
                            }
                        },
                        {
                            "text": "Constant <w>promising</w> without any action eventually leads to a loss of trust.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>обещания</w> без каких-либо действий в конечном итоге приводят к потере доверия."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт принесения обещания или дачи слова"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обещание",
                                "target_lang_sense_clarification": "процесс или акт дачи слова"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}