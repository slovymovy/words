                                    {
                                        "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                        "entry_id": "a370f858-9124-36df-ac70-6498c859e63f",
                                        "glosses": [
                                            "der Zierde oder (oft) zum Aufbewahren von Blumen dienendes Gefäß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da13b356-dca8-4f4e-820c-0b4486e3f926",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "Mir ist die Vase heruntergefallen."
                                            },
                                            {
                                                "example_id": "91e66056-3557-43c7-a399-066d53e62fc4",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "Auf dem Kaminsims stehen wertvolle Vasen aus verschiedenen Epochen."
                                            },
                                            {
                                                "example_id": "b46abd9b-beb6-4b64-9367-14dd579d8830",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "„Einmal war es um eine umgestoßene Vase gegangen.“"
                                            },
                                            {
                                                "example_id": "9ea9a551-8e9f-42c0-bef4-d0a127f983ea",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "„Clerfayt sah eine Vase mit weißem Flieder und einen langen Zweig flacher, weißer Orchideen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d027bbae-eccf-4f3f-9c35-6b0a0a89b43f",
                        "source_entry_id": "511478bd-3206-32e3-a5c6-dce5b4c98b9b",
