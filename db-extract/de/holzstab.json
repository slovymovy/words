                            {
                                "example_id": "37ef1a9e-9bdf-4d8c-aa23-a9b9202b71a9",
                                "sense_id": "4c1eade4-9823-3a50-a2e1-698c38ffd750",
                                "text": "„Ein langer Holzstab außen am Raketenkörper sorgt dafür, dass das Geschoss dabei geradlinig fliegt.“"
                            },
                            {
                                "example_id": "beac5b7e-85f8-4471-9aad-f683147e90d4",
                                "sense_id": "4c1eade4-9823-3a50-a2e1-698c38ffd750",
                                "text": "„Sturmzündhölzer sind Holzstäbe üblicher Länge, die mit einem 20 mm langen Brennsatz umhüllt sind, der einen üblichen Sicherheitszündkopf trägt.“"
                            }
                        ],
