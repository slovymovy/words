                    },
                    {
                        "translation_id": "96c442bd-f35c-4a2c-a83d-354faff8c4f1",
                        "source_entry_id": "55a57b81-9f39-348d-93b3-0a0d677ebd61",
                        "source_sense_id": "39e3e5d5-5207-32bb-b82b-d97413eb794a",
                        "source_sense_description": "patch of land adjoining a church",
                        "target_lang_word": "Friedhof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Friedhof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "737223f0-1691-37de-95d5-e523484e09ca",
                                        "entry_id": "0e96df4a-2514-372a-93e4-beddee760169",
                                        "glosses": [
                                            "Ort (oft neben einer Kirche) zur Bestattung Verstorbener"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d2a486-ba1f-4d58-b365-0ad01929b4bc",
                                                "sense_id": "737223f0-1691-37de-95d5-e523484e09ca",
                                                "text": "Die Beisetzung findet auf dem alten Friedhof statt."
                                            },
                                            {
                                                "example_id": "6bbbe03d-d40e-4c0a-98d4-e318414de8d3",
                                                "sense_id": "737223f0-1691-37de-95d5-e523484e09ca",
                                                "text": "„Hinter dem Friedhof folge ich dem Wanderweg in die nasse Tundra.“"
                                            },
                                            {
                                                "example_id": "aa227e25-dafc-4d4e-b0c5-da989fe7d0fe",
                                                "sense_id": "737223f0-1691-37de-95d5-e523484e09ca",
                                                "text": "„Als schlechtes Omen galt es auch, wenn man einen Geistlichen neben dem Friedhof traf.“"
                                            },
                                            {
                                                "example_id": "2fa4c181-0204-4af8-9469-258c06ef6766",
                                                "sense_id": "737223f0-1691-37de-95d5-e523484e09ca",
                                                "text": "„Ich spazierte zum Friedhof und verbrachte die Zeit damit, die Inschriften auf den Grabsteinen zu lesen.“"
                                            },
                                            {
                                                "example_id": "01f77eb1-06bc-4a3b-aea5-ea65a5461302",
                                                "sense_id": "737223f0-1691-37de-95d5-e523484e09ca",
                                                "text": "„Es wurde immer unbehaglicher, auf dem Friedhof umherzugehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fef5fcc9-ec72-3d16-b200-5537304c7f7f",
                                        "entry_id": "0e96df4a-2514-372a-93e4-beddee760169",
