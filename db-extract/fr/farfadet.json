        "fr-extract.jsonl": [
            {
                "entry_id": "8c94f096-c5aa-3977-9669-69a472d4531c",
                "word": "farfadet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d25a468-be09-4f13-a0a2-d01c58c06e51",
                        "entry_id": "8c94f096-c5aa-3977-9669-69a472d4531c",
                        "tags": [
                            "plural"
                        ],
                        "form": "farfadets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a296c0da-01c2-3623-887a-b059285ccbf5",
                        "entry_id": "8c94f096-c5aa-3977-9669-69a472d4531c",
                        "glosses": [
                            "Être imaginaire, sorte d’esprit follet, de lutin."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "45c5939f-19b4-4ac1-b963-8a281fcbd9c1",
                                "sense_id": "a296c0da-01c2-3623-887a-b059285ccbf5",
                                "text": "Il y a un lutin qui préside à ma destinée. Si ce farfadet pouvait s’entendre avec le génie qui préside à la vôtre, je bénirais ma dernière course."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f975500-c5c6-3aa5-b981-83272a6d74b7",
                        "entry_id": "8c94f096-c5aa-3977-9669-69a472d4531c",
                        "glosses": [
                            "Groupe de deux ou trois éclairs rouges et puissants de la mésosphère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f41b56-5647-48cc-ab57-dbfab63c70d4",
                                "sense_id": "2f975500-c5c6-3aa5-b981-83272a6d74b7",
                                "text": "Un farfadet est une intense décharge électrique qui se produit au-dessus d’un cumulonimbus particulièrement virulent. Cette décharge, d’une hauteur estimée pouvant atteindre 30 à 40 km se produit à partir de 40 km d’altitude et atteint l’ionosphère, située vers 60 km d’altitude."
                            },
                            {
                                "example_id": "9f9887e2-8b11-4bf4-a977-b7758723bd43",
                                "sense_id": "2f975500-c5c6-3aa5-b981-83272a6d74b7",
                                "text": "En cette curieuse région du Cotentin, toute bruissante des verdoyantes ramées, où chaque chaumière se tapit mystérieusement au détour d’une cache, où chaque lopin s’embroussaille de genêt, de houx et d’épine, ou se clôt de murets de pierres sèches, symboles du droit de possession — et du goût du repli — les vieilles légendes s’étaient fidèlement transmises au coin de l’âtre, hiver après hiver. Les goubelins, ces farfadets manchots, l’y disputaient aux fées bénéfiques, comme celle du bois du Rabey."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24722918-cac3-4b08-8089-5ab4851a353a",
                        "source_entry_id": "8c94f096-c5aa-3977-9669-69a472d4531c",
                        "source_sense_id": "a296c0da-01c2-3623-887a-b059285ccbf5",
                        "source_sense_description": "Être imaginaire",
                        "target_lang_word": "leprechaun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leprechaun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54ecc191-d0a2-378a-987a-55fa8adabc48",
                                        "entry_id": "663ae70f-dd8f-37ed-b661-458fff8aa169",
                                        "glosses": [
                                            "One of a race of elves that can reveal hidden treasure to those who catch them."
                                        ],
                                        "tags": [
                                            "Irish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c64490-07c7-4c68-b539-cda5f584ad30",
                                                "sense_id": "54ecc191-d0a2-378a-987a-55fa8adabc48",
                                                "text": "Do you not catch the tiny clamour, / Busy click of an elfin hammer, / Voice of the leprechaun singing shrill, / As he merrily plies his trade?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
