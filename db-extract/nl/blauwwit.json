                    {
                        "sense_id": "526f9946-dde1-327e-a8b5-37dd323da64e",
                        "entry_id": "3cd91676-fdc2-316e-87cb-8702f6e3683f",
                        "glosses": [
                            "wit met een blauwe zweem, dat vaak als \\\"koud\\\" wordt ervaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc9b96f-2f42-48d1-a2d8-d63faa405ced",
                                "sense_id": "526f9946-dde1-327e-a8b5-37dd323da64e",
                                "text": "Op weg naar Doğubeyazit herkende ik opeens de Ararat, in een blauwwit waas tekenden zich de contouren af van zijn besneeuwde top."
                            },
                            {
                                "example_id": "8d5281dc-38b7-4f18-b19c-c36035477fd8",
                                "sense_id": "526f9946-dde1-327e-a8b5-37dd323da64e",
                                "text": "Er was daar een lege koudheid van grijs ijzer en steen onder cru licht: drie trillende gasvlammen, blauwwit, langs de muur."
                            },
                            {
                                "example_id": "acdede78-edbb-45b6-bed4-7c16e397a4d7",
                                "sense_id": "526f9946-dde1-327e-a8b5-37dd323da64e",
                                "text": "Gerrits lippen werden blauwwit van kwaadheid, en hij zoû ze haast besmet en Ontheiligd hebben met een vloek."
                            }
                        ]
                    }
                ],
