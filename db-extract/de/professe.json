                ],
                "senses": [
                    {
                        "sense_id": "1660f183-a953-3979-94ea-0a20c684de3b",
                        "entry_id": "59605860-2a43-30e9-9c58-f900477a42a8",
                        "glosses": [
                            "männliche Person, die mit dem Ablegen der Ordensgelübde einem Orden beitritt"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "2312cfc6-3901-4c52-bfa2-c22fd82c2c31",
                                "sense_id": "1660f183-a953-3979-94ea-0a20c684de3b",
                                "text": "„Die Professen hatten außer den übrigen noch das vierte Gelübde abzulegen, sich jeder Mission des Papstes unbedingt unterziehen zu wollen.“"
                            },
                            {
                                "example_id": "0b096b2c-2b90-4c92-9c62-4b8f0c3e016d",
                                "sense_id": "1660f183-a953-3979-94ea-0a20c684de3b",
                                "text": "„Die Aufnahme des Professen in das eigentliche Heiligthum des Ordens sollte daher auch nur nach den strengsten Prüfungen stattfinden und ihre Zahl überhaupt eine sehr beschränkte bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
