                                    {
                                        "sense_id": "8a30830d-4431-3b09-bdda-9fd596cf18fa",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "Someone or something that feels."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0637bf-d103-4dea-9246-82bbe28ad74d",
                                                "sense_id": "8a30830d-4431-3b09-bdda-9fd596cf18fa",
                                                "text": "Are you more of a feeler or more of a thinker?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "232cc8a4-dc52-370d-aa2f-35b48eb71a67",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "An antenna or appendage used for feeling, especially on an insect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "Something ventured to test another's feelings, opinion, or position."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8bbbb90-4255-4fd7-89c8-baaa9d73a96f",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "I sent out some feelers but they didn't seem interested."
                                            },
                                            {
                                                "example_id": "c3ce6a72-2e72-4fe0-8e3f-9ccd16a7d162",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "This survey is designed to get a feeler about how the citizens feel about the proposed new highway."
                                            },
                                            {
                                                "example_id": "5154a1a8-c319-4cf2-bc3c-9b907e8a519c",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "In 1905, the Russo-Japanese war fought itself to a standstill, and with the destruction of Rozhiestvensky's fleet at Tsushima, the Japanese, for financial reasons, had to put out feelers for peace."
                                            },
                                            {
                                                "example_id": "bd43fb02-3fa8-4e2b-b606-f1a8934ce159",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "Mr. Dayan's peace feeler would he more attractive to Cairo if it were accompanied by suggestions from Jerusalem, public private, for safeguarding Israeli security interests there without sacrificing Cairo's claim to ultimate sovereignty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa67cd5-da7d-3af1-80b5-f2ed55187b65",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "a presumptive person; someone who bases on gut feeling, such as assuming or imagining that something said or done, whether positive or negative, was for a person despite having no concrete confirmation but gut feeling, or someone who assumes one's affection is reciprocated, or indulges in one's own wishful thinking or flatters oneself"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
