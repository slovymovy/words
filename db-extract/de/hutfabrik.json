                                    },
                                    {
                                        "sense_id": "93d05b34-6d69-33ca-838b-025b6652f8ca",
                                        "entry_id": "8ab57b74-211f-39c9-b75d-59e64c4eb7a3",
                                        "glosses": [
                                            "Commerce de chapeaux."
                                        ],
