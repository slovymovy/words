    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c14391f-3872-3396-9574-2150c7fc9997",
                    "sense_definition": "A source of annoyance or persistent grievance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poor grammar on restaurant menus is a major pet <w>peeve</w> of mine.",
                            "target_lang_translations": {
                                "pl": "Błędy gramatyczne w menu restauracji to coś, co <w>doprowadza mnie do szału</w>."
                            }
                        },
                        {
                            "text": "Loud chewing remains his biggest personal <w>peeve</w> when dining with others.",
                            "target_lang_translations": {
                                "pl": "Głośne żucie pozostaje jego największym <w>powodem do irytacji</w> podczas jedzenia z innymi."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyance",
                        "bother",
                        "grievance",
                        "irritation",
                        "nuisance",
                        "vexation"
                    ],
                    "common_phrases": [
                        "pet peeve"
                    ],
                    "target_lang_definitions": {
                        "pl": "Źródło irytacji, uciążliwość lub rzecz, która kogoś szczególnie denerwuje."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "utrapienie",
                                "target_lang_sense_clarification": "źródło udręki lub zmartwienia"
                            },
                            {
                                "target_lang_word": "powód do irytacji",
                                "target_lang_sense_clarification": "coś, co drażni"
                            },
                            {
                                "target_lang_word": "drażniąca rzecz",
                                "target_lang_sense_clarification": "irytujący nawyk lub szczegół"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "caf268d3-ae71-3a5e-bd71-57715fa62f9b",
                    "sense_definition": "To annoy, irritate, or make someone resentful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It always <w>peeves</w> me when people fail to clean up after their pets.",
                            "target_lang_translations": {
                                "pl": "Zawsze mnie <w>irytuje</w>, kiedy ludzie nie sprzątają po swoich zwierzakach."
                            }
                        },
                        {
                            "text": "His constant interruptions began to thoroughly <w>peeve</w> the speaker.",
                            "target_lang_translations": {
                                "pl": "Jego ciągłe przerywanie zaczęło mocno <w>drażnić</w> prelegenta."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "bother",
                        "exasperate",
                        "irk",
                        "irritate",
                        "provoke",
                        "rile",
                        "vex"
                    ],
                    "target_lang_definitions": {
                        "pl": "Irytować, denerwować lub drażnić kogoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drażnić",
                                "target_lang_sense_clarification": "działać komuś na nerwy"
                            },
                            {
                                "target_lang_word": "irytować",
                                "target_lang_sense_clarification": "wywoływać zniecierpliwienie lub złość"
                            },
                            {
                                "target_lang_word": "wkurzać",
                                "target_lang_sense_clarification": "potocznie: mocno denerwować"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}