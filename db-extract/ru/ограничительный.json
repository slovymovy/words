                                        "sense_id": "05859ded-da9b-3bda-a09b-ef8d688d1ddf",
                                        "entry_id": "6852e2f5-724e-38f9-9480-65c25404415f",
                                        "glosses": [
                                            "Confining, limiting, containing within defined bounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af59d26-2d35-4af0-8cc4-5017d7336e1a",
                                                "sense_id": "05859ded-da9b-3bda-a09b-ef8d688d1ddf",
                                                "text": "The help tended to be officious, the rules, if heeded, restrictive, and the management meddlesome."
                                            },
                                            {
                                                "example_id": "36636489-bbaa-4c2a-97f6-22e811711829",
                                                "sense_id": "05859ded-da9b-3bda-a09b-ef8d688d1ddf",
                                                "text": "The pinnacle of the effort to fix restrictive meanings to a set of terminology can be found in two papers in American Speech by Feinsilver (1979, 1980)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddefef21-8c49-38fa-9dc1-aaef27eb2be9",
                                        "entry_id": "6852e2f5-724e-38f9-9480-65c25404415f",
                                        "glosses": [
                                            "limiting free and easy bodily movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555c1c08-78f5-4b50-8806-4651f9bb8c63",
                                                "sense_id": "ddefef21-8c49-38fa-9dc1-aaef27eb2be9",
                                                "text": "Some of them [teenagers] who will become lesbians clearly are being hit with the same kind of garbage which we got hit with in the fifties. There's been a real resurgence of that in terms of values and double standards and music. The clothes again — we're back to high heels and restrictive little femmy outfits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "restrictive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "404599cf-b475-39a8-85bf-337a26d52bec",
                                        "entry_id": "1336c523-11cc-3f84-9d70-49c7815dd149",
                                        "glosses": [
                                            "A clause that narrows the meaning of a noun or noun phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476eecff-2b33-46e3-8604-adcd520a34cd",
                                                "sense_id": "404599cf-b475-39a8-85bf-337a26d52bec",
                                                "text": "[…] a couple of further differences between restrictive and non-restrictive relative clauses: (1) in contrast with restrictives, the wh-phrase in non-restrictives cannot be ellipted; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
