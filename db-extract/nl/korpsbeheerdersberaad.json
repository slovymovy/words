                            {
                                "example_id": "a2cab13c-4ba5-437c-8f20-c6579a40b5de",
                                "sense_id": "defa79e1-c393-3150-bd98-326a2ba3e57d",
                                "text": "De minister en het Korpsbeheerdersberaad zeggen zich grotendeels te herkennen in de conclusies en aanbevelingen van de Algemene Rekenkamer:"
                            },
                            {
                                "example_id": "174242d4-289a-473d-8b01-905a72a06da0",
                                "sense_id": "defa79e1-c393-3150-bd98-326a2ba3e57d",
                                "text": "Het aantal 112-meldkamers wordt teruggebracht van 25 naar 10. Die 10 meldkamers worden één organisatie waarin op dezelfde manier wordt gewerkt. Zo moet de efficiëncy worden vergroot. De ministerraad heeft een reorganisatievoorstel overgenomen van het Veiligheidsberaad en het Korpsbeheerdersberaad."
                            },
                            {
                                "example_id": "b6030ce9-ba96-45c2-90e9-94fc20316886",
                                "sense_id": "defa79e1-c393-3150-bd98-326a2ba3e57d",
                                "text": "Korpsbeheerdersberaad De burgemeester wil bovendien het advies eerst bespreken met de korpschef en de hoofdofficier van de politie. Ook zal het advies besproken worden tijdens het korpsbeheerdersberaad, het overleg tussen de burgemeesters uit de regio Rijnmond."
                            }
                        ]
