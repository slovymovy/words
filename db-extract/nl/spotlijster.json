                        "glosses": [
                            "Mimus polyglottos een zangvogel uit de familie spotlijsters (Mimidae). Het verenkleed is lichtgrijs met een lange staart. De vleugels zijn donkerbruin met witte vlekken en strepen. Het zijn zeer goede imitators. De lichaamslengte bedraagt 23 tot 28 cm"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
                            {
                                "example_id": "9485ffbe-0c4c-456f-a1aa-555531ace747",
                                "sense_id": "62b16446-8bd3-358d-aaa8-b3b489b182fc",
                                "text": "De spotlijster is bekend van tuinen en parken en valt op door zijn uitbundige zang waarin allerlei andere vogels geïmiteerd worden."
                            }
                        ]
                    }
