                "senses": [
                    {
                        "sense_id": "dbd62193-5ca3-32ef-8a38-5c46fd0af5ff",
                        "entry_id": "f808c7bb-3cd5-3f86-a119-bd1abb121d46",
                        "glosses": [
                            "Vermouth produit par Martini & Rossi."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ee271a37-dfdc-37ea-b88e-48e7ec773fa2",
                        "entry_id": "f808c7bb-3cd5-3f86-a119-bd1abb121d46",
                        "glosses": [
                            "Cocktail à base de gin et de vermouth blanc sec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8762889-6439-4f58-b99c-af771f2e8ce4",
                                "sense_id": "ee271a37-dfdc-37ea-b88e-48e7ec773fa2",
                                "text": "La décoration également, raffinée et l’atmosphère y est conviviale autour de cocktails connus et reconnus comme un dry Martini, un daïquiri, une margarita, un bloody-mary, un cuba-libre, une piña-colada…, mais aussi des cocktails sans alcool, un apéritif classique avec une très intéressante carte de whiskies et de champagnes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fa43f5bc-f93c-366e-8c59-a755493786a0",
                "word": "martini",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08349d3b-81ea-411a-9670-c05f67b8e88d",
                        "entry_id": "fa43f5bc-f93c-366e-8c59-a755493786a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "martinis"
                    },
                    {
                        "form_id": "dc9b47bd-440b-48bb-aa62-eccb2c5c3fbf",
                        "entry_id": "fa43f5bc-f93c-366e-8c59-a755493786a0",
                        "tags": [],
                        "form": "Martini"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "520cf51d-5a91-33dd-8c17-b81643ad4422",
                        "entry_id": "fa43f5bc-f93c-366e-8c59-a755493786a0",
                        "glosses": [
                            "Cocktail à base de gin et de vermouth blanc sec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c7257e-10bd-42ad-b6a8-431746d91eeb",
                                "sense_id": "520cf51d-5a91-33dd-8c17-b81643ad4422",
                                "text": "Pendant que les autres se livrent à l’amertume triomphale et glaçonnée du whisky, du martini-gin, on fera dans la tiédeur vieille France, dans le fruité du jardin de curé, dans le sucré suranné."
                            },
                            {
                                "example_id": "688f3331-a9d1-4bb0-8798-affbb73b83dc",
                                "sense_id": "520cf51d-5a91-33dd-8c17-b81643ad4422",
                                "text": "Tu veux essayer ? dit Harry Mitchell, en abattant son verre XXL de martini sur une table basse dotée d'une belle résonance et en s'efforçant de prendre un air de bouledogue – très convaincant, je l'admets."
                            },
                            {
                                "example_id": "5a6e2a3f-6af1-4b45-8bb1-922826ae8f06",
                                "sense_id": "520cf51d-5a91-33dd-8c17-b81643ad4422",
                                "text": "Le serveur apporta nos verres et je pris une gorgée. Je n’avais encore jamais goûté de martini, et j’adorai son âpreté acidulée : comme une gentille claque sur le visage pour vous ranimer, après un évanouissement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91e0fd7b-81f1-4a57-a7f7-d1d6b5d70765",
                        "source_entry_id": "fa43f5bc-f93c-366e-8c59-a755493786a0",
                        "source_sense_id": "520cf51d-5a91-33dd-8c17-b81643ad4422",
                        "target_lang_word": "Martini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Martini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ac0c61a-2024-35aa-9688-ede5e4767349",
                                        "entry_id": "68c3cf78-0dc7-34d6-a176-52fffedb8998",
                                        "glosses": [
                                            "Tag des Heiligen Martin von Tours am 11. November"
                                        ],
                                        "tags": [
                                            "meist ohne Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798471a6-681b-4070-a11b-4d70774bb3b0",
                                                "sense_id": "3ac0c61a-2024-35aa-9688-ede5e4767349",
                                                "text": "Ich freue mich schon auf den traditionellen Gänsebraten an Martini."
                                            },
                                            {
                                                "example_id": "a1b89b67-cc4c-426b-9232-068c66ecffba",
                                                "sense_id": "3ac0c61a-2024-35aa-9688-ede5e4767349",
                                                "text": "„Stets haben Gänse zu Martini ihr Leben lassen müssen. Dieser Tag war schon in alten norwegischen Runenkalendern und im vorigen Jahrhundert auch noch im Tiroler Bauernkalender mit einer gemalten Gans bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Martini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aef54e3c-8518-344c-9a6f-f41695a4d020",
                                        "entry_id": "1cd9d064-6f1c-359b-865c-0d6ddd053bad",
                                        "glosses": [
                                            "alkoholisches Mixgetränk mit Gin und Wermut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea9a5a2-0b66-446a-8a6a-1c2639844415",
                                                "sense_id": "aef54e3c-8518-344c-9a6f-f41695a4d020",
                                                "text": "James Bond mag seinen Martini nur geschüttelt, nicht etwa gerührt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c432f70-b90b-4d65-b90e-8d549beede17",
                        "source_entry_id": "fa43f5bc-f93c-366e-8c59-a755493786a0",
                        "source_sense_id": "520cf51d-5a91-33dd-8c17-b81643ad4422",
                        "target_lang_word": "martini",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "martini",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                        "entry_id": "a30e5362-5124-3ea4-b4ae-1fb670ffbf59",
                                        "glosses": [
                                            "A cocktail made with gin or vodka and vermouth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e4a7934-0121-45d1-b6f4-2ffebf738f3b",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "My boss is out on another of his three-martini lunches."
                                            },
                                            {
                                                "example_id": "5642f4ca-0ef1-4d26-a2d0-afa4cb5c523d",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "Will you join us at six o’clock for martinis?"
                                            },
                                            {
                                                "example_id": "3a5cb121-2fdf-4816-b81d-168710fb9f28",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "Even at Juneau's prices, ten dollars worth of martinis is a lot of liquor to drink in an hour."
                                            },
                                            {
                                                "example_id": "fb1b0b4e-4864-40f7-8b0f-10962e7c1604",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "Could any tiger\nDrink martinis, smoke cigars,\nAnd last as we do?"
                                            },
                                            {
                                                "example_id": "0ffe3d9b-7ed5-454b-b99d-44288b764b93",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "He drank martini, played bridge in the club, and captured treaty-port life wickedly."
                                            },
                                            {
                                                "example_id": "3d42d1cf-980b-4fae-bcd7-1e07cfda2972",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "I had the feeling that had he been a smoker he would have lit a cigarette at this moment. I suspected that once he had been a smoker, for he seemed as if he wished someone would offer him one. He drank martini instead."
                                            },
                                            {
                                                "example_id": "5767ca81-ebce-4048-8f4a-557729a0ee95",
                                                "sense_id": "cc783b68-3bf1-3cfb-a437-c406f817f871",
                                                "text": "After the meal, they drank martini on the rocks in the lounge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6acfbcd1-a0d9-3b19-b1e2-dc9c30b8d6e1",
                                        "entry_id": "a30e5362-5124-3ea4-b4ae-1fb670ffbf59",
                                        "glosses": [
                                            "Any cocktail served in a cocktail glass, often sweet or fruity and aimed at women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43e09308-c124-4593-93c6-0d9c0ae6664d",
                                                "sense_id": "6acfbcd1-a0d9-3b19-b1e2-dc9c30b8d6e1",
                                                "text": "I love the chocolate martinis at Trendy Bar!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
