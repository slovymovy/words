                        "glosses": [
                            "Rendre semblable."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cbc66df4-6121-4af3-b77a-f1e0e1e4ed49",
                                "sense_id": "f3670a35-e45b-37de-a026-b2ca22cc9a91",
                                "text": "Mais, ajoute Deligny, il s’agit plutôt de le semblabliser pour réduire au connu de soi, l’irréductible et vertigineuse étrangeté de lui."
                            },
                            {
                                "example_id": "73e6560d-61ee-4340-8504-9f853958a1f7",
                                "sense_id": "f3670a35-e45b-37de-a026-b2ca22cc9a91",
                                "text": "Il ne faut pas à tout prix vouloir les semblabliser, les charger de nos projets et de nos intentions."
                            }
                        ]
                    }
