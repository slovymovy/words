                "senses": [
                    {
                        "sense_id": "7f06e1e1-8498-3dba-bc10-e7e944aec5f0",
                        "entry_id": "48321333-cc33-3876-96c1-b5aaec554b72",
                        "glosses": [
                            "отвечать на свист свистом, обмениваться свистом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0543ef04-f9a1-4236-b045-00b744e2a537",
                                "sense_id": "7f06e1e1-8498-3dba-bc10-e7e944aec5f0",
                                "text": "Идет он по лесу и весь даже в поту от страха: все кажется, что кругом разбойники пересвистываются!"
                            },
                            {
                                "example_id": "57acd198-ce8a-4355-bec0-c747882b258e",
                                "sense_id": "7f06e1e1-8498-3dba-bc10-e7e944aec5f0",
                                "text": "Тогда наступила полная тишина, и везде стало всё слышно, даже как пересвистывались рябчики в зарослях Сухой речки."
                            },
                            {
                                "example_id": "027339e6-dcc1-4042-9666-f84e505d8640",
                                "sense_id": "7f06e1e1-8498-3dba-bc10-e7e944aec5f0",
                                "text": "Пересвистывались красные сурки, столбиками стоя у своих нор и без боязни глядя на караван."
                            }
                        ]
                    },
