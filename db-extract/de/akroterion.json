                        "entry_id": "3198311a-1db9-3009-87a7-7986e0cebbe5",
                        "glosses": [
                            "Verzierung auf dem First oder an den Ecken des Giebels, die auch als Sockel für Statuen oder Vasen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06ce452-ffca-473b-9874-bca1f13c6d21",
                                "sense_id": "6d126d9e-ce35-30f7-b9ca-f77fae5440b6",
                                "text": "„Gleichsam ein Rudiment des Akanthosschmuckes der Säule ist ja der Blätter-und Blüthenschmuck des Akroterions; auf einem Akroterion findet sich in der That eine ganz analoge ornamentale Verbindung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
