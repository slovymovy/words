                "senses": [
                    {
                        "sense_id": "9bde642e-187b-33be-aa66-0dd1c796c9b2",
                        "entry_id": "dfca17f4-65b5-3add-881a-136743b6b8f8",
                        "glosses": [
                            "Toucher délicatement, traiter amoureusement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86882e5f-0884-4470-9617-e8c2ba894996",
                                "sense_id": "9bde642e-187b-33be-aa66-0dd1c796c9b2",
                                "text": "Par la grand'barrière à vantaux, en arrière, passent les voituriers, le ravitaillement qui entre, les cultivateurs gantés qui sortent et vont mignonner leur terre, bardés de leur parole d'honneur."
                            },
                            {
                                "example_id": "76bf6bbc-65f4-4754-af51-f732cddf95be",
                                "sense_id": "9bde642e-187b-33be-aa66-0dd1c796c9b2",
                                "text": "A son coté Dame Sydoine,\nBlanche, tendre, pollie et attaintée:\nBoire ypocras, à jour et à nuyctée,\nRire, jouer, mignonner et baiser,"
                            }
                        ]
                    }
                ],
