                ],
                "senses": [
                    {
                        "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                        "entry_id": "2db0cc1c-0f0d-32eb-9235-39e8a6cc63a4",
                        "glosses": [
                            "Zustand/Eigenschaft, trostlos zu sein; schlechte, bedrückende Stimmung"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4d9713d2-a702-4e35-a8cd-703d3ad6a736",
                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                "text": "„Sie spürte eine erdrückende Trostlosigkeit und sah nervös ihre Schwester an, die ihre Reaktion beobachtete.“"
                            },
                            {
                                "example_id": "9c959019-5057-4631-83eb-c409642a5f7d",
                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                "text": "„Der Wind würde dunkle, aus Scheinwahrheiten bestehende Wolken über den Himmel treiben, und angesichts der Trostlosigkeit großer Bereiche unserer eigenen Seele würde sich in uns wahrscheinlich eine tiefe Traurigkeit ausbreiten.“"
                            },
                            {
                                "example_id": "a85857a3-2f96-4ab5-a9e3-8bf7084722b9",
                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                "text": "„Und wieder begann eine Nacht, die zweite, furchtbare Nacht, eine Mondnacht mit vielen kalten Sternen, mit der Trostlosigkeit eines klar gewölbten, unendlich stillen Firmamentes, von dem schwere Einsamkeit herniedersank.“"
                            },
                            {
                                "example_id": "42c03f04-7a05-4bad-8321-678ea78f81a4",
                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                "text": "„Meine Trostlosigkeit wird noch dadurch verstärkt, dass ich ständig spüre, wie sehr Sie mir fehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c3d40ca-31d3-3f5b-9112-9c8bef62dcb7",
                        "entry_id": "2db0cc1c-0f0d-32eb-9235-39e8a6cc63a4",
                        "glosses": [
                            "etwas, das trostlos ist oder wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75131ad-e674-4208-ab77-4b4ea0389b11",
                                "sense_id": "2c3d40ca-31d3-3f5b-9112-9c8bef62dcb7",
                                "text": "„Christine ließ Langeweile nicht zu, auch Trostlosigkeiten nicht, denn wenn etwas traurig und freudlos war, dann klagte sie den Missstand an.“"
                            },
                            {
                                "example_id": "85bebb0d-ae74-45c3-96ef-ef7b96047141",
                                "sense_id": "2c3d40ca-31d3-3f5b-9112-9c8bef62dcb7",
                                "text": "„Viele Menschen unter uns warten auf den Trost der Frohen Botschaft in einem umfassenden Sinn; nicht auf ‚Vertröstung‘, sondern auf Hilfe im Ringen mit den vielen ‚Trostlosigkeiten‘ dieser Welt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
