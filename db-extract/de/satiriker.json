                    {
                        "translation_id": "df88358e-16ad-4253-b1ba-73571d399e33",
                        "source_entry_id": "e4e01efd-c608-3f3b-a8c6-55f4739f52e3",
                        "source_sense_id": "df5478eb-6731-3c38-8a0a-c5adf6c2f0cd",
                        "source_sense_description": "Person, die Satiren verfasst",
                        "target_lang_word": "satirizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satirizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81402bcf-25cc-36fe-bec2-06083c361e12",
                                        "entry_id": "7e438052-1903-3a5f-bb35-cefa76f59cef",
                                        "glosses": [
                                            "One who satirizes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29632aea-d35c-4f3f-9c91-0f5d4cf3638c",
                                                "sense_id": "81402bcf-25cc-36fe-bec2-06083c361e12",
                                                "text": "It is a drive-by satirizer of Christians, Jews, old people, police chiefs, groundskeepers, schoolteachers, doctors and the nuclear power industry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb657885-c9b1-44a5-8817-680bebf5254d",
                        "source_entry_id": "e4e01efd-c608-3f3b-a8c6-55f4739f52e3",
                        "source_sense_id": "df5478eb-6731-3c38-8a0a-c5adf6c2f0cd",
                        "source_sense_description": "Person, die Satiren verfasst",
                        "target_lang_word": "сатирик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сатирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6899d495-9132-3667-a78d-3b7234ed6d1c",
                                        "entry_id": "2252e65b-3d0f-3378-aa0e-a3c1dc2607e1",
                                        "glosses": [
                                            "автор сатиры; тот, кто создаёт произведения литературы, искусства, осмеивающие какие-либо пороки, недостатки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e457351a-5370-48de-bf02-cc59a2d37299",
                                                "sense_id": "6899d495-9132-3667-a78d-3b7234ed6d1c",
                                                "text": "Пусть смеются над вами; пусть пишут на вас сатиры, сказки, песни, эпиграммы: вы всё это сносите с стоическим терпением, или, лучше сказать, вы ничего этого не видите и доказываете только тем, что ваши сатирики, желая вас переменить, оставляют вам поле сражения…"
                                            },
                                            {
                                                "example_id": "eeb88f91-df1f-4765-b7b9-9e4a1f6f4845",
                                                "sense_id": "6899d495-9132-3667-a78d-3b7234ed6d1c",
                                                "text": "Сочинитель гордо называл себя сатириком, гонителем людских пороков, — и гонимые люди без боязни подходили к своему гонителю, к дряхлому, беззубому бульдогу, гладили его по толстой и лоснящейся шее и охотно кормили его избытком своей трапезы."
                                            },
                                            {
                                                "example_id": "2e8b8266-bda8-416f-89ef-e0e0fdd29a50",
                                                "sense_id": "6899d495-9132-3667-a78d-3b7234ed6d1c",
                                                "text": "То он становился на почву практического деятеля и осуждал мечтателей, то на почву сатирика и иронически подсмеивался над противниками, то становился строго логичным, то вдруг поднимался в область метафизики."
                                            },
                                            {
                                                "example_id": "d75e3c81-d990-4b67-8934-aaaed0de0792",
                                                "sense_id": "6899d495-9132-3667-a78d-3b7234ed6d1c",
                                                "text": "Сколько благодаря этому на каторге пессимистов, угрюмых сатириков, которые с серьезными злыми лицами толкуют без умолку о людях, о начальстве, о лучшей жизни, а тюрьма слушает и хохочет, потому что в самом деле выходит смешно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
