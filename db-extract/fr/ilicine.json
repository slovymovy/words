                                        "glosses": [
                                            "A bitter alkaloid found in holly."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3abedd-da0b-4102-aabf-ec2b2baeebd4",
                                                "sense_id": "c8f4d399-033f-3b09-935f-091c63d58294",
                                                "text": "They have a bitter, somewhat austere taste; their properties depend upon a principle called ilicin."
                                            },
                                            {
                                                "example_id": "de61373b-bffa-4c61-8eaf-0e3b7287b4cc",
                                                "sense_id": "c8f4d399-033f-3b09-935f-091c63d58294",
                                                "text": "All Ilex hollies contain the bitter compound ilicin."
                                            },
                                            {
                                                "example_id": "b30c2d3b-fe2d-4f0b-aead-a9976d7084dd",
                                                "sense_id": "c8f4d399-033f-3b09-935f-091c63d58294",
                                                "text": "Ilicin is contained in holly berries (Ilex sp) and causes severe gastroirritation including nausea, vomiting, and diarrhea."
                                            }
