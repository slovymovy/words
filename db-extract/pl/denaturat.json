                    {
                        "sense_id": "7cb408c7-5b56-32a6-81ae-ae9e095a1998",
                        "entry_id": "f33b1ee6-7dae-3a9c-bca8-c7efec3663e3",
                        "glosses": [
                            "nazwa handlowa skażonego alkoholu etylowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97418eb6-6a4b-4f85-a961-ab4bce28b306",
                                "sense_id": "7cb408c7-5b56-32a6-81ae-ae9e095a1998",
                                "text": "Denaturat to alkohol używany do celów technicznych"
                            },
                            {
                                "example_id": "c1de82ac-930c-4438-a98f-3ebabd6390f9",
                                "sense_id": "7cb408c7-5b56-32a6-81ae-ae9e095a1998",
                                "text": "W sklepach alkoholi olbrzymi wybór, ale nie brakuje amatorów picia denaturatu"
                            },
                            {
                                "example_id": "d10ae059-ee58-4e1a-a1b0-ef87d1a684ac",
                                "sense_id": "7cb408c7-5b56-32a6-81ae-ae9e095a1998",
                                "text": "Od czasu do czasu szybki powiększalnika należy przemyć denaturatem i wytrzeć do sucha"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
