                ],
                "senses": [
                    {
                        "sense_id": "8eb5db8f-b623-3cbf-abc1-d27b224ae0de",
                        "entry_id": "4d349124-9952-3e8e-b6f2-91253bf19102",
                        "glosses": [
                            "Abend im November"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281a88ac-9ff4-40cb-9b78-dcbd09da9f14",
                                "sense_id": "8eb5db8f-b623-3cbf-abc1-d27b224ae0de",
                                "text": "Evelin kam an einem Novemberabend."
                            },
                            {
                                "example_id": "dfeb854b-3f70-4445-b2c2-79246e7708ea",
                                "sense_id": "8eb5db8f-b623-3cbf-abc1-d27b224ae0de",
                                "text": "„Ich hatte meiner Mutter an jenem Novemberabend eine Überraschung bereiten wollen, hatte mich ohne Ermahnung ausgezogen und gewaschen.“"
                            },
                            {
                                "example_id": "4dc547a2-e3aa-4d74-820f-def482f37f2e",
                                "sense_id": "8eb5db8f-b623-3cbf-abc1-d27b224ae0de",
                                "text": "„Im Hof, ungefähr an der gleichen Stelle, wo ich an einem Novemberabend Texas begraben hatte, nahmen wir Abschied voneinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
