                    "semantic_group_id": "friendship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>vrienden</w> komen vanavond op mijn verjaardag.",
                            "target_lang_translations": {
                                "en": "My <w>friends</w> are coming to my birthday party tonight.",
                                "ru": "Мои <w>друзья</w> придут сегодня вечером на мой день рождения.",
                                "pl": "Moi <w>przyjaciele</w> przychodzą dziś wieczorem na moje urodziny.",
                                "de": "Meine <w>Freunde</w> kommen heute Abend zu meinem Geburtstag.",
                                "fr": "Mes <w>amis</w> viennent à mon anniversaire ce soir.",
                                "it": "I miei <w>amici</w> vengono al mio compleanno stasera.",
                                "cs": "Moji <w>kamarádi</w> dnes večer přijdou na mou oslavu narozenin.",
                                "tr": "<w>Arkadaşlarım</w> bu akşam doğum günüme geliyor.",
                                "es": "Mis <w>amigos</w> vienen a mi cumpleaños esta noche."
                            }
                        },
                        {
                            "text": "Op school kun je makkelijk nieuwe <w>vrienden</w> maken.",
                            "target_lang_translations": {
                                "en": "You can easily make new <w>friends</w> at school.",
                                "ru": "В школе можно легко найти новых <w>друзей</w>.",
                                "pl": "W szkole można łatwo znaleźć nowych <w>przyjaciół</w>.",
                                "de": "In der Schule kann man leicht neue <w>Freunde</w> finden.",
                                "fr": "À l'école, on peut facilement se faire de nouveaux <w>amis</w>.",
                                "it": "A scuola puoi fare facilmente nuovi <w>amici</w>.",
                                "cs": "Ve škole si můžeš snadno najít nové <w>kamarády</w>.",
                                "tr": "Okulda kolayca yeni <w>arkadaşlar</w> edinebilirsin.",
                                "es": "En la escuela puedes hacer nuevos <w>amigos</w> fácilmente."
                            }
