                "senses": [
                    {
                        "sense_id": "118000a3-f8a9-3333-9af5-79cc4d4bec34",
                        "entry_id": "e5da2ead-64fc-3b64-8946-b3c761b87ec9",
                        "glosses": [
                            "Donner un caractère indifférencié, plus standard et moins cher, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc893e9-f0dc-4071-9476-16c2a24e0e24",
                                "sense_id": "118000a3-f8a9-3333-9af5-79cc4d4bec34",
                                "text": "Nous avons commodisé notre produit"
                            },
                            {
                                "example_id": "c52e91d0-3971-4527-9e6c-1431db6f4d57",
                                "sense_id": "118000a3-f8a9-3333-9af5-79cc4d4bec34",
                                "text": "dans un monde où le système d'exploitation a déjà été commodisé (linux), le cpu se fait commodiser (arm)."
                            },
                            {
                                "example_id": "d9006d25-26dd-4295-9ce7-61cc029f3018",
                                "sense_id": "118000a3-f8a9-3333-9af5-79cc4d4bec34",
                                "text": "Grâce à la virtualisation des serveurs et du stockage, l'infrastructure IT tend à se commodiser."
                            },
                            {
                                "example_id": "75f2f2e5-b84c-48fd-a434-6fe77c50c84a",
                                "sense_id": "118000a3-f8a9-3333-9af5-79cc4d4bec34",
                                "text": "Le mobile est l’avenir de la banque… si cette dernière ne se retrouve pas « commodisée » par les géants des télécoms."
                            }
                        ]
                    }
