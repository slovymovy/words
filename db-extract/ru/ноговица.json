                "senses": [
                    {
                        "sense_id": "cbdd4b7d-e847-3329-9554-28f6370bd7cd",
                        "entry_id": "d2f062b1-0e1c-32c3-be78-1292b22cf024",
                        "glosses": [
                            "рег. и спец. принадлежность обуви или одежды, закрывающая голень с коленом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30118bd6-ae34-4057-8bdd-42e7dc021aaf",
                                "sense_id": "cbdd4b7d-e847-3329-9554-28f6370bd7cd",
                                "text": "Ступни ног были в зеленых чувяках, и икры обтянуты чёрными ноговицами, обшитыми простым шнурком."
                            },
                            {
                                "example_id": "ead17808-4103-4a3a-ae7e-62bf5bd5a315",
                                "sense_id": "cbdd4b7d-e847-3329-9554-28f6370bd7cd",
                                "text": "Из камер пригоняли сюда смуглых людей в смушковых папахах, обутых в мягкие кавказские ноговицы, нагруженных перинами и ковровыми сумками."
                            }
                        ]
                    }
