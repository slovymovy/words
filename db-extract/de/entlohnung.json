                "senses": [
                    {
                        "sense_id": "afe87771-2b81-3b27-b8c2-30310ee920e6",
                        "entry_id": "be0d7a87-1e8a-3420-b6f7-c7bde55ec30f",
                        "glosses": [
                            "Bezahlung für erbrachte Leistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e6fd6d9-ceb8-4cda-a171-e8b23491419f",
                                "sense_id": "afe87771-2b81-3b27-b8c2-30310ee920e6",
                                "text": "Die Höhe der Entlohnung für Arbeit ist in der Regel vertraglich festgesetzt."
                            },
                            {
                                "example_id": "2388c66b-99a3-4ae4-8ff6-cf42a337d0c8",
                                "sense_id": "afe87771-2b81-3b27-b8c2-30310ee920e6",
                                "text": "„In Perpignan verabschiedete ich meinen Diener mit einer guten Entlohnung und berichtete meinem Bruder nach Paris von meinem Glück, der Hinterlist dreier Meuchelmörder entronnen zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e42342c6-8ab0-44a2-af06-e145ea3ef484",
                        "source_entry_id": "be0d7a87-1e8a-3420-b6f7-c7bde55ec30f",
                        "source_sense_id": "afe87771-2b81-3b27-b8c2-30310ee920e6",
                        "source_sense_description": "Bezahlung für erbrachte Leistung",
                        "target_lang_word": "payment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "payment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05cf3c9b-3e97-30e0-9245-aaf27050724c",
                                        "entry_id": "40407345-2900-3f7d-a73f-71e7863cb65c",
                                        "glosses": [
                                            "The act of paying."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0eb89410-0f3c-3259-8fbe-0395a0969e08",
                                        "entry_id": "40407345-2900-3f7d-a73f-71e7863cb65c",
                                        "glosses": [
                                            "An instance of that act; a sum of money paid in exchange for goods or services, or the transaction that conveys it."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d9466d-0906-4c38-94e5-e70afc694535",
                                                "sense_id": "0eb89410-0f3c-3259-8fbe-0395a0969e08",
                                                "text": "“[…] This is Mr. Churchill, who, as you are aware, is good enough to come to us for his diaconate, and, as we hope, for much longer; and being a gentleman of independent means, he declines to take any payment.” Saying this Walden rubbed his hands together and smiled contentedly."
                                            },
                                            {
                                                "example_id": "dedb3e9a-20ae-4b68-9c02-b2855f3cd474",
                                                "sense_id": "0eb89410-0f3c-3259-8fbe-0395a0969e08",
                                                "text": "In a report published on October 31, Transport Focus said that a number of train companies were unable to convince it about their ability to sell a full range of tickets, handle cash payments, and avoid excessive queues at ticket machines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6a3dbbd-aff8-4afe-a47f-3d3389ddabfc",
                        "source_entry_id": "be0d7a87-1e8a-3420-b6f7-c7bde55ec30f",
                        "source_sense_id": "afe87771-2b81-3b27-b8c2-30310ee920e6",
                        "source_sense_description": "Bezahlung für erbrachte Leistung",
                        "target_lang_word": "вознаграждение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вознаграждение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f8a428e2-fe4b-354c-8269-3ca1af7e5776",
                                        "entry_id": "38368cb1-b658-38e2-843c-bf5284a1680a",
                                        "glosses": [
                                            "действие по значению гл. вознаграждать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7400c5b3-116f-4110-ae73-26937c94e56e",
                                                "sense_id": "f8a428e2-fe4b-354c-8269-3ca1af7e5776",
                                                "text": "Без цели ничего не делается… Всякое дело требует вознаграждения… Требовать, чтобы человек делал что-нибудь даром, значит нарушать право собственности…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f2d0f0-2b1a-399c-9641-3ad18b15c678",
                                        "entry_id": "38368cb1-b658-38e2-843c-bf5284a1680a",
                                        "glosses": [
                                            "результат такого действия; плата за труд, благодарность, награда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43db93ac-7a8b-44f2-9928-276d56fad0f7",
                                                "sense_id": "d5f2d0f0-2b1a-399c-9641-3ad18b15c678",
                                                "text": "Я прошу только припечатать, что тот, кто ко мне этого подлеца представит, получит достаточное вознаграждение."
                                            },
                                            {
                                                "example_id": "0ee7f0ba-2c88-4440-8d06-5c5bd5d4bada",
                                                "sense_id": "d5f2d0f0-2b1a-399c-9641-3ad18b15c678",
                                                "text": "Я получил в вознаграждение (22 января 1829 года) чин статского советника."
                                            },
                                            {
                                                "example_id": "c52637ca-96c1-4336-a7f6-ea3747505841",
                                                "sense_id": "d5f2d0f0-2b1a-399c-9641-3ad18b15c678",
                                                "text": "Я просил графа, — говорил он, — представить меня только к денежному вознаграждению."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aebc74b-e844-3e36-aa67-4709b5003001",
                                        "entry_id": "38368cb1-b658-38e2-843c-bf5284a1680a",
                                        "glosses": [
                                            "восполнение, замена чем-либо равноценным чего-либо утраченного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a69af1a-9dfb-4ed2-8e22-61da3577e9d9",
                                                "sense_id": "1aebc74b-e844-3e36-aa67-4709b5003001",
                                                "text": "Жители переведены были в город, и им обещано вознаграждение за весь убыток."
                                            },
                                            {
                                                "example_id": "9eccd176-7db0-4ae9-bff1-cf2937e2a788",
                                                "sense_id": "1aebc74b-e844-3e36-aa67-4709b5003001",
                                                "text": "Это не торг, ваше высочество, даже не вознаграждение за претерпенные убытки: требуя денег, мы лишаем неприятеля способов вредить нам на долгое время."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
