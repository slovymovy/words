                                                "sense_id": "bcb98bbb-b8c0-39f5-9f4e-cd7bc92a252a",
                                                "text": "They came together in a chance meeting on the way home from work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f09588b5-c2d0-3c94-ad86-cc5233891981",
                                        "entry_id": "28e103a2-01e8-3361-8a99-758310aeaaa6",
                                        "glosses": [
                                            "A place or instance of junction or intersection; a confluence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b73dc97-28a2-4509-a754-fb26f3205822",
                                                "sense_id": "f09588b5-c2d0-3c94-ad86-cc5233891981",
                                                "text": "Earthquakes occur at the meeting of tectonic plates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065623cf-71ac-3fa1-bb95-993c30fa9a4d",
                                        "entry_id": "28e103a2-01e8-3361-8a99-758310aeaaa6",
                                        "glosses": [
                                            "A religious service held by a charismatic preacher in small towns in the United States."
