                "senses": [
                    {
                        "sense_id": "03fefde0-dfb2-38c6-86e9-6c3ee5e877c7",
                        "entry_id": "dcab1888-09d1-363c-96e6-2e0916a1dc17",
                        "glosses": [
                            "Ort, in dem medizinische Therapien in Form von Kuren angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1dd343-11ea-497e-ac52-703b041228cb",
                                "sense_id": "03fefde0-dfb2-38c6-86e9-6c3ee5e877c7",
                                "text": "„Auf den Schnee schien die Sonne, und der Kurort sah wie auf Postkarten aus.“"
                            },
                            {
                                "example_id": "b076715e-89de-4edb-9d15-e9802ef5b1f6",
                                "sense_id": "03fefde0-dfb2-38c6-86e9-6c3ee5e877c7",
                                "text": "„Es ist zwar lächerlich, aber es sieht so aus, als würde sich Theresienstadt zu einem Kurort wandeln.“"
                            },
                            {
                                "example_id": "bf012bf0-b015-42f0-9d88-3a3d8778eff4",
                                "sense_id": "03fefde0-dfb2-38c6-86e9-6c3ee5e877c7",
                                "text": "„In einem kleinen Kurort an der Ostsee rettete ich mich vor dem Regen in das Haus des Gastes.“"
                            },
                            {
                                "example_id": "cd3eb679-983f-4146-8499-c7c44b25f274",
                                "sense_id": "03fefde0-dfb2-38c6-86e9-6c3ee5e877c7",
                                "text": "„Frankreich ist übersät von diesen alternden Kurorten, deren elegante Tage längst der Vergangenheit angehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
