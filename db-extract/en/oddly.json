    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                "word": "oddly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                        "glosses": [
                            "In a peculiar manner; strangely; unusually."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "96541df5-ae55-4169-bb0c-197733ba4364",
                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                "text": "For December, it was oddly warm."
                            },
                            {
                                "example_id": "a2973025-3eb2-4e20-8bf8-8e04bdc917b5",
                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                "text": "Novv, Sir, vvhen my Time comes, leſt they ſhou'd think it vvorth vvhile to handle my Memory vvith the ſame Freedom, I am vvilling to prevent its being ſo odly beſmear'd (or at beſt but flatly vvhite-vvash'd) by taking upon me to give the Publick This, as true a Picture of myſelf as natural Vanity vvill permit me to dravv; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                        "glosses": [
                            "In a manner measured by an odd number."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eb800333-ec5f-44d7-ae79-27174e2fa8d8",
                                "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                "text": "The oddly counted lords are always out of sync with at least one other evenly counted cycle. These two strange counts assured that at no single moment could all cycles end at the same time for an extraordinarily long time, for at least one odd count threw off all the even ones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40084e98-8cc9-46c6-ae7e-41a64eb164f3",
                        "source_entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                        "source_sense_description": "strangely",
                        "target_lang_word": "étrangement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrangement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                        "entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                                        "glosses": [
                                            "D'une manière étrange ; bizarrement, étonnamment, de manière peu commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f922f6-f230-486b-b715-2fed1c9550bf",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; […]."
                                            },
                                            {
                                                "example_id": "810ed90e-05ac-4013-9cd6-2769f947e1d0",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                                            },
                                            {
                                                "example_id": "cf56dc80-e5ed-4f66-b9d7-71144ee10f49",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
