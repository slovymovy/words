                                        "entry_id": "dd5c7502-a0ff-35c9-bacb-22020187884f",
                                        "glosses": [
                                            "A person to whom a debt is owed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e5f6e7-9268-4278-926a-cc1e6b42975a",
                                                "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                                "text": "The creditor demanded immediate payment."
                                            },
                                            {
                                                "example_id": "0b4365de-f41b-4e22-bded-dabf8deaeb91",
                                                "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                                "text": "She met with her creditors to negotiate the debt."
                                            },
                                            {
                                                "example_id": "9f193497-4b94-4c29-b1b3-048e4da7d84c",
                                                "sense_id": "8cbf72c1-afd8-392b-9d40-3a046847f93d",
                                                "text": "The creditor took legal action against the bankrupt company."
                                            }
                                        ]
                                    },
