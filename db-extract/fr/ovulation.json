        "fr-extract.jsonl": [
            {
                "entry_id": "d1087d19-3f49-3201-b22f-d41e695a2cd9",
                "word": "ovulation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0aa10b25-fe80-4b68-9841-33a83c994d45",
                        "entry_id": "d1087d19-3f49-3201-b22f-d41e695a2cd9",
                        "tags": [
                            "plural"
                        ],
                        "form": "ovulations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18e8d75d-7037-3edd-8c58-041aa1ac5e5d",
                        "entry_id": "d1087d19-3f49-3201-b22f-d41e695a2cd9",
                        "glosses": [
                            "Chute de l’ovule hors de la vésicule ovarienne (follicule mûr), et, par suite, hors de l’ovaire jusqu’au pavillon de l’oviducte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548aca78-dd02-4381-a8cd-583b4b1ce8b0",
                                "sense_id": "18e8d75d-7037-3edd-8c58-041aa1ac5e5d",
                                "text": "L’insémination intra-utérine intraconjugale en laboratoire ou cabinet médical, qui allie induction d’ovulation et préparation-lavage du sperme qui sera injecté dans l’utérus, lors d’une infertilité masculine ou féminine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08afd05e-67c6-4fd5-8afe-36920009c940",
                        "source_entry_id": "d1087d19-3f49-3201-b22f-d41e695a2cd9",
                        "source_sense_id": "18e8d75d-7037-3edd-8c58-041aa1ac5e5d",
                        "target_lang_word": "Ovulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ovulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4c00fe8-4cc2-329f-ae6c-a2adc747dc19",
                                        "entry_id": "1ec77953-65fc-360d-aed2-330d0962838f",
                                        "glosses": [
                                            "Ausstoßung des reifen Eis aus dem Eierstock"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83725e4-dffb-4a8b-81fb-d1b6e75fd388",
                                                "sense_id": "c4c00fe8-4cc2-329f-ae6c-a2adc747dc19",
                                                "text": "„Die Pille täuscht also eine Schwangerschaft vor. Dadurch kann keine Eireifung, keine Ovulation und keine Befruchtung stattfinden.“"
                                            },
                                            {
                                                "example_id": "791df80e-27ef-4e5d-81b9-9c6048055ada",
                                                "sense_id": "c4c00fe8-4cc2-329f-ae6c-a2adc747dc19",
                                                "text": "„[…] Katzen […] verlassen sich auf die induzierte Ovulation: Der Eisprung wird durch den Geschlechtsakt ausgelöst.“"
                                            },
                                            {
                                                "example_id": "d6722a48-1526-40e0-b2f3-7987fc13fcd1",
                                                "sense_id": "c4c00fe8-4cc2-329f-ae6c-a2adc747dc19",
                                                "text": "„»[…] was wir glauben, ist tatsächlich: Der Reflex, der hinter dem menschlichen weiblichen Orgasmus steckt, ist ein alter, […] und die Funktion war das Auslösen von Ovulation.«“"
                                            },
                                            {
                                                "example_id": "d461a3f2-6556-4814-abf9-7b35c1880346",
                                                "sense_id": "c4c00fe8-4cc2-329f-ae6c-a2adc747dc19",
                                                "text": "„Mittels Hormonen wird der Zyklus reguliert und in die Ovulation eingegriffen, damit mehr Eier zum Eisprung gelangen.“"
                                            },
                                            {
                                                "example_id": "e8ecddd8-4c57-4602-9864-abb794d3e2f1",
                                                "sense_id": "c4c00fe8-4cc2-329f-ae6c-a2adc747dc19",
                                                "text": "„»Wenn man [bei einer Frau] die Ovulation ausschaltet und damit quasi den normalen Zyklus mit der Östrogen- und der Gestagenphase nicht mehr hat, dann tritt das PMS nicht auf.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aec569b-6c9f-40e4-826d-67bf6fbcf649",
                        "source_entry_id": "d1087d19-3f49-3201-b22f-d41e695a2cd9",
                        "source_sense_id": "18e8d75d-7037-3edd-8c58-041aa1ac5e5d",
                        "target_lang_word": "Follikelsprung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f8f82cab-1433-4a70-b20b-718241143a7f",
                        "source_entry_id": "d1087d19-3f49-3201-b22f-d41e695a2cd9",
                        "source_sense_id": "18e8d75d-7037-3edd-8c58-041aa1ac5e5d",
                        "target_lang_word": "Eisprung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisprung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb48724e-039f-3fc9-ac5e-3d67eff1c243",
                                        "entry_id": "db444623-8e92-3d3f-a736-14aeda9b1b66",
                                        "glosses": [
                                            "Ausstoßen einer noch unbefruchteten Eizelle aus dem Eierstock"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f101914-cba9-4d0f-a444-360b1838225f",
                                                "sense_id": "eb48724e-039f-3fc9-ac5e-3d67eff1c243",
                                                "text": "Der Eisprung ist Voraussetzung für eine Befruchtung."
                                            },
                                            {
                                                "example_id": "32943e34-25d6-4d49-986d-96884baf68cf",
                                                "sense_id": "eb48724e-039f-3fc9-ac5e-3d67eff1c243",
                                                "text": "Bei Haushühnern findet täglich ein Eisprung statt."
                                            },
                                            {
                                                "example_id": "d3ba1f99-66a2-40da-8872-7b8a82e5b731",
                                                "sense_id": "eb48724e-039f-3fc9-ac5e-3d67eff1c243",
                                                "text": "„Wissenschaftler verkabelten Frauen am Kopf und fanden so heraus, dass sie vor dem Eisprung die kantigen, urwüchsigen Typen bevorzugen. Nach dem Eisprung allerdings ziehen sie die Kuscheltypen vor.“"
                                            },
                                            {
                                                "example_id": "1e1c4c62-92fd-4ee8-b024-5699806e4d87",
                                                "sense_id": "eb48724e-039f-3fc9-ac5e-3d67eff1c243",
                                                "text": "„Nach einigen Zyklen kannte sich Mia mit sich selbst aus, hatte ihren Eisprung taxiert und war mit umsichtigen Rechnungen nach Knaus-Ogino gewappnet für Ereignisse, die noch in der Zukunft lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
