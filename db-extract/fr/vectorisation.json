                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5d9cf2f-f685-303a-a6c9-49db299d9c8f",
                        "entry_id": "ae668d44-85b2-3013-8ae5-efb9aab21421",
                        "glosses": [
                            "Fait de vectoriser, de mettre sous forme de vecteur."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a8024c85-7508-35a7-b881-206768146470",
                        "entry_id": "ae668d44-85b2-3013-8ae5-efb9aab21421",
                        "glosses": [
                            "Traitement d'une image numérique pour la faire passer d'une forme matricielle à une forme vectorielle."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8e9b70f9-0893-4963-b12b-445a3075eef2",
                                "sense_id": "a8024c85-7508-35a7-b881-206768146470",
                                "text": "Néanmoins la vectorisation entraîne des imprécisions et des pertes d'informations qui peuvent être parfois gênantes pour des traitements ultérieurs. Pour vectoriser une image il faut au préalable extraire le squelette des objets."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8629e11-37c2-3aa1-b68a-1cb8a538420b",
                        "entry_id": "ae668d44-85b2-3013-8ae5-efb9aab21421",
                        "glosses": [
                            "Injection de composés actifs dans un vecteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b485a9-998e-43a2-9fd7-7d1bf4001f1b",
                                "sense_id": "c8629e11-37c2-3aa1-b68a-1cb8a538420b",
                                "text": "« Je ne sais pas du tout », répond sans fard Christophe Vieu, qui note que la vectorisation de médicaments est souvent évoquée, « sans garantie que cela marche »."
                            }
                        ]
                    }
