                },
                {
                    "sense_id": "220ce3fa-5aa6-3087-ad49-05f3460495fd",
                    "sense_definition": "mający nadwagę lub obfite ciało; otyły",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cialo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz kot jest zbyt <w>gruby</w>, więc musi przejść na dietę.",
                            "target_lang_translations": {
                                "ru": "Наш кот слишком <w>толстый</w>, поэтому ему нужно сесть на диету."
                            }
                        },
                        {
                            "text": "Mężczyzna był tak <w>gruby</w>, że z trudem wchodził po schodach.",
                            "target_lang_translations": {
                                "ru": "Мужчина был настолько <w>толстым</w>, что с трудом поднимался по лестнице."
                            }
                        }
                    ],
                    "synonyms": [
