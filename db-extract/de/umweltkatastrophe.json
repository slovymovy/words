                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47ca827b-8e45-4912-92b5-754846d20bf3",
                                "sense_id": "4dfe7415-7a14-3829-ab4f-610b87db3984",
                                "text": "„Durch die Havarie der Ölplattform »Deepwater Horizon« im Golf von Mexiko vor der US-amerikanischen Küste entsteht eine Umweltkatastrophe, die das in diesem Bereich bekannte Maß übersteigt.“"
                            },
                            {
                                "example_id": "8d7de624-bb7d-476f-a4e6-7002552b81ec",
                                "sense_id": "4dfe7415-7a14-3829-ab4f-610b87db3984",
                                "text": "„Ein nuklearer Angriff und die daraus resultierende Umweltkatastrophe wäre in jedem Fall auch für jenes Land selbstmörderisch, das ihn startet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
