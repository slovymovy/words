                "senses": [
                    {
                        "sense_id": "58428a3c-e735-3d90-8496-cbf5515fb8c2",
                        "entry_id": "f63c18f4-8d1d-3461-83c1-1a691442a4fa",
                        "glosses": [
                            "Procéder à un surcadrage : introduire un cadre à l’intérieur du cadre de l’image."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "8057ee8f-8c99-4e3a-8070-2b40c57615b9",
                                "sense_id": "58428a3c-e735-3d90-8496-cbf5515fb8c2",
                                "text": "Il serre le cadre et utilise des éléments du décor - fenêtres, œil-de-bœuf, chambranle de porte, trous dans des murs de brique etc.- pour surcadrer les flics ce qui crée le suspense chez le spectateur."
                            },
                            {
                                "example_id": "4575198d-72fe-4b17-af87-37bdded0409b",
                                "sense_id": "58428a3c-e735-3d90-8496-cbf5515fb8c2",
                                "text": "Le film Anaconda (1997) a pas mal innové en faisant bouffer plein de gens par de gros et méchants serpents, ainsi qu’en utilisant des plans originaux que l’on pourrait baptiser « snake shots » : juste avant leur ingestion, les proies humaines sont vues depuis le fond de la gorge de l’anaconda, la bouche du serpent venant joliment surcadrer la victime."
                            },
                            {
                                "example_id": "23803021-b59b-4919-8014-2548fa6ff293",
                                "sense_id": "58428a3c-e735-3d90-8496-cbf5515fb8c2",
                                "text": "Dans un film, la voiture devient donc une machine à surcadrer : en sus du cadre défini par la caméra - qui deviendra dans la salle le cadre de l’écran -, elle propose des cadres seconds : vue du pare-brise avant, de la fenêtre avant gauche, etc."
                            }
                        ]
                    }
