                "senses": [
                    {
                        "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                        "entry_id": "9f356796-b536-3665-9552-6838794b509a",
                        "glosses": [
                            "To combine (multiple things) together; to blend, to fuse."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6f459852-f368-4dbb-b197-b17f4d657120",
                                "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                                "text": "One can meld copper and zinc together to form brass."
                            },
                            {
                                "example_id": "5feddd54-24dc-4ef6-87a1-1d01206ea8a4",
                                "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                                "text": "Much as America's motto celebrates melding many into one, South Africa's says that it doesn't matter what you look like – we can all be proud of our young country."
                            },
                            {
                                "example_id": "62a36309-baf0-4f8f-b7d6-1dcad96883ee",
                                "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                                "text": "Users can upload an unlimited number of voice messages, text prompts, photographs and videos of themselves, and in return an algorithm melds together memories and media and spits out a “virtual you” – an avatar that can speak to loved ones on phone calls and through text messages “so that children, grandchildren and beyond can know what you’re really like”."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7346c62-4c18-3ced-b410-a50055abd354",
                        "entry_id": "9f356796-b536-3665-9552-6838794b509a",
                        "glosses": [
                            "To combine, to blend, to fuse."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6b82157-6e56-463b-8f43-0906e53df1ae",
                        "source_entry_id": "9f356796-b536-3665-9552-6838794b509a",
                        "source_sense_description": "to combine (multiple things) together — see also blend, fuse",
                        "target_lang_word": "samensmelten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samensmelten",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "efa71d7c-7763-332d-a350-9d628bbce626",
                                        "entry_id": "8da84ea4-45e3-37c0-8596-8fbe0fc35819",
                                        "glosses": [
                                            "door smelten tot een geheel worden"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4052ef-c28f-4c0f-b1a1-d0f3575576a0",
                                                "sense_id": "efa71d7c-7763-332d-a350-9d628bbce626",
                                                "text": "Het zilver was met het goud samengesmolten tot elektrum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e8b4e3-cd3b-3004-9377-3ebd1c9113f1",
                                        "entry_id": "8da84ea4-45e3-37c0-8596-8fbe0fc35819",
                                        "glosses": [
                                            "door smelten tot een geheel maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "272c1862-af35-4044-ac1f-38bc2ec4c86e",
                                                "sense_id": "77e8b4e3-cd3b-3004-9377-3ebd1c9113f1",
                                                "text": "Zilver en goud kunnen in alle verhoudingen tot een legering samengesmolten worden."
                                            },
                                            {
                                                "example_id": "6d005d82-6c2d-488b-85e5-e9f62892c699",
                                                "sense_id": "77e8b4e3-cd3b-3004-9377-3ebd1c9113f1",
                                                "text": "Ik kan niet alles letterlijk reproduceren en ik moet toegeven dat ik ook niet alles verstond, omdat ik niet was voorbereid op deze uitbarsting van Franse poëzie, maar ik verstond genoeg om te begrijpen dat het ging om een feministische visie op drie verlaten vrouwen uit de mythologie, Nausica, Medea en Dido, die volgens mij werden samengesmolten tot één modern personage in de gedaante van een zwerfster in de metro van Parijs, maar voor het laatste deel van deze interpretatie moet ik gezien de particuliere metaforiek een slag om de arm houden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
