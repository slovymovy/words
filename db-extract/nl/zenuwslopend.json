                "senses": [
                    {
                        "sense_id": "a473e6cc-8510-37f8-b72b-f46e2ca70242",
                        "entry_id": "686984cd-b2e6-3daf-8e58-2cfd9a5b4253",
                        "glosses": [
                            "spannend, leidend tot veel zenuwachtigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92681082-25ad-4ef6-af28-d55afbf9ddfb",
                                "sense_id": "a473e6cc-8510-37f8-b72b-f46e2ca70242",
                                "text": "De finale van het wereldkampioenschap voetbal in 2010 was zenuwslopend."
                            },
                            {
                                "example_id": "e150f695-118d-4a46-8a4c-ef69d0edf70d",
                                "sense_id": "a473e6cc-8510-37f8-b72b-f46e2ca70242",
                                "text": "Het was niet goed, het was zenuwslopend, maar FC Twente is terug in de eredivisie. Omdat de enige overgebleven concurrent Sparta onderuit ging bij Jong PSV, was een punt tegen Jong AZ voldoende. De mooiste 0-0 van het seizoen voelde als de meest glorieuze zege. De ultieme bevrijding."
                            },
                            {
                                "example_id": "52aa5f63-67eb-4ab2-b34d-789bbb3685a9",
                                "sense_id": "a473e6cc-8510-37f8-b72b-f46e2ca70242",
                                "text": "Het was de uitkomst van een zenuwslopende stemming waarbij Laurence, de absolute topfavoriet van de bookmakers, bij de jury enigszins teleurstellend als derde eindigde met 231 punten. Zweden won bij de vakjury’s voor het verrassende Noord-Macedonië."
                            }
                        ]
                    }
