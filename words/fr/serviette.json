                {
                    "sense_id": "6fcbbabe-00cb-385a-a40c-6e6c3c4eb3cc",
                    "sense_definition": "Pièce de tissu ou de papier individuelle servant à s'essuyer la bouche et les doigts pendant un repas.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "linge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas d'utiliser ta <w>serviette</w> pour t'essuyer la bouche à table."
                        },
                        {
                            "text": "Elle a posé une jolie <w>serviette</w> en tissu blanc à côté de chaque assiette."
                        }
                    ],
                    "common_phrases": [
