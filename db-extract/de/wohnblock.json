                "senses": [
                    {
                        "sense_id": "f8b77a85-4c6d-35f9-8b5f-2279e3050ad7",
                        "entry_id": "36febf94-f9e6-319f-9369-35d542822c0e",
                        "glosses": [
                            "Ensemble von Straßen umfasster Häuser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202983b8-9628-4b53-8fe7-99409012d396",
                                "sense_id": "f8b77a85-4c6d-35f9-8b5f-2279e3050ad7",
                                "text": "„Für ihre rasche Unterbringung standen 1992 rund 900 Garçonnieren, 350 Startwohnungen in Althäusern und 120 Wohnplätze in einem modernen Wohnblock (20) zur Verfügung; die durchschnittliche Verweildauer beträgt 1 1/2 Jahre.“"
                            },
                            {
                                "example_id": "b43fb805-5a74-424e-8318-8bbf0159e7bf",
                                "sense_id": "f8b77a85-4c6d-35f9-8b5f-2279e3050ad7",
                                "text": "„Der Hamburger Künstler Boran Burchhardt will im Stadtteil Veddel die Vorderseite eines Wohnblocks auf 300 Quadratmetern mit 23,5 Karat Blattgold verkleiden.“"
                            },
                            {
                                "example_id": "703ad6fd-1a42-4c16-96dc-5d6d60c73d30",
                                "sense_id": "f8b77a85-4c6d-35f9-8b5f-2279e3050ad7",
                                "text": "„Neue Wohnblocks entstehen am Stadtrand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "27c208bf-053c-3375-8d67-ab8788bcbc2c",
                        "entry_id": "36febf94-f9e6-319f-9369-35d542822c0e",
                        "glosses": [
                            "mehr- oder vielgeschossiges, schlicht gegliedertes Wohngebäude, häufig freistehend und nach dem Ende der Altbauära errichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7124b660-87e7-40af-9f0c-20372014ac47",
                                "sense_id": "27c208bf-053c-3375-8d67-ab8788bcbc2c",
                                "text": "„Zu einem Brand im sechsten Stock eines Wohnblocks … ist gestern Abend die Feuerwehr alarmiert worden.“"
                            },
                            {
                                "example_id": "fd53d824-8174-44ca-9b7b-1c5c58683464",
                                "sense_id": "27c208bf-053c-3375-8d67-ab8788bcbc2c",
                                "text": "„In einem Ostberliner Wohnblock greift eine 85-jährige Frau jeden Morgen zu ihrer Zigarre und raucht, ehe sie aufsteht.“"
                            },
                            {
                                "example_id": "da99be62-69da-4716-accb-87c431f43fe8",
                                "sense_id": "27c208bf-053c-3375-8d67-ab8788bcbc2c",
                                "text": "„Gegenüber der Polizeistation standen Wohnblocks.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
