            "senses": [
                {
                    "sense_id": "951e7de8-52ac-376f-8c46-3fb6256783cd",
                    "sense_definition": "zichzelf dronken maken door te veel alcohol te drinken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dronken_worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het slechte nieuws besloot hij zich in de kroeg te <w>bedrinken</w>.",
                            "target_lang_translations": {
                                "ru": "После плохих новостей он решил <w>напиться</w> в баре."
                            }
                        },
                        {
                            "text": "Het is niet verstandig om je te <w>bedrinken</w> als je morgen vroeg op moet.",
                            "target_lang_translations": {
                                "ru": "Неразумно <w>напиваться</w>, если завтра тебе нужно рано вставать."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezuipen",
                        "zuipen"
                    ],
                    "common_phrases": [
                        "zich bedrinken"
                    ],
                    "target_lang_definitions": {
                        "ru": "напиваться, приводить себя в состояние опьянения алкоголем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напиваться",
                                "target_lang_sense_clarification": "до состояния опьянения"
                            },
                            {
                                "target_lang_word": "напиться",
                                "target_lang_sense_clarification": "соверш. вид"
                            },
                            {
                                "target_lang_word": "напиваться пьяным",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06cb3fc4-78ca-3add-876c-597e57a70818",
                    "sense_definition": "jezelf in een slechte toestand brengen door te veel alcohol te drinken totdat je dronken bent",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dronken_worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kan ook een avondje gaan dansen of jezelf <w>bedrinken</w> om je zorgen te vergeten.",
                            "target_lang_translations": {
                                "ru": "Можно также пойти потанцевать на вечер или <w>напиться</w>, чтобы забыть о своих заботах."
                            }
                        },
                        {
                            "text": "Hij wilde zichzelf <w>bedrinken</w> na het verlies van zijn baan.",
                            "target_lang_translations": {
                                "ru": "Он хотел <w>напиться</w> после потери работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezuipen"
                    ],
                    "common_phrases": [
                        "jezelf bedrinken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used reflexively to describe heavy drinking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "напиваться до бесчувствия или тяжелого состояния, чтобы забыться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напиваться",
                                "target_lang_sense_clarification": "чтобы забыть о проблемах"
                            },
                            {
                                "target_lang_word": "напиваться в стельку",
                                "target_lang_sense_clarification": "разговорное, до сильного опьянения"
                            },
                            {
                                "target_lang_word": "напиваться допьяна",
                                "target_lang_sense_clarification": "до тяжелого состояния"
                            }
                        ]
                    }
                },
                {
