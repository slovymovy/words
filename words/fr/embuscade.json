                    "frequency": "Middle",
                    "semantic_group_id": "attaque_surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le convoi militaire est tombé dans une <w>embuscade</w> au détour d'une route de montagne."
                        },
                        {
                            "text": "Les soldats ont réussi à déjouer l'<w>embuscade</w> tendue par les insurgés dans la forêt."
                        }
                    ],
                    "synonyms": [
                        "guet-apens",
                        "piège",
                        "embûche"
                    ],
                    "common_phrases": [
