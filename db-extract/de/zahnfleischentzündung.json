                        "examples": [
                            {
                                "example_id": "c8179c68-77f4-4969-9b7a-26e52125fd65",
                                "sense_id": "649006d3-2ab2-3a41-9fae-dc859155fcef",
                                "text": "Eine Zahnfleischentzündung sollte man vom Zahnarzt behandeln lassen."
                            },
                            {
                                "example_id": "f768a501-f2de-48a9-af7f-d1a11cb3a7c2",
                                "sense_id": "649006d3-2ab2-3a41-9fae-dc859155fcef",
                                "text": "„In einer Studie der MHH kam jetzt heraus, dass bereits diese leichten Zahnfleischentzündungen das Risiko für Arteriosklerose, im Volksmund auch Arterienverkalkung genannt, erhöhen.“"
                            }
                        ],
