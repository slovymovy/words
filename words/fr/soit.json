            "senses": [
                {
                    "sense_id": "6d15810b-ba85-378b-9d5a-91dfe9cf0f05",
                    "sense_definition": "Introduit une alternative entre deux ou plusieurs termes ou propositions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le dessert, vous prendrez <w>soit</w> une tarte, <w>soit</w> une glace."
                        },
                        {
                            "text": "Il viendra nous voir <w>soit</w> ce soir, <w>soit</w> demain matin."
                        }
                    ],
                    "synonyms": [
