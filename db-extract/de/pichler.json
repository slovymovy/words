                ],
                "senses": [
                    {
                        "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                        "entry_id": "e8be8a92-25c6-3020-a408-8d025e1ff692",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname, sechshäufigster Nachname in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f9d816-34f5-44da-8dcb-f135cb1a0261",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Frau Pichler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "759918b0-be0f-4627-ba15-88d27eecca5b",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Herr Pichler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5e98afc9-8e41-4d70-80c9-795d93366f82",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Die Pichlers fahren heute nach Stuttgart."
                            },
                            {
                                "example_id": "366519f8-1d2a-42c0-aff1-0c0d9da7d0b4",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Der Pichler trägt nie die Schals, die die Pichler ihm strickt."
                            },
                            {
                                "example_id": "a54f3383-2ee2-4856-9970-154902776164",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pichler kommt, geht der Herr Pichler.“"
                            },
                            {
                                "example_id": "d522efa6-e4b9-4b9d-b215-224adffee939",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Pichler kommt und geht."
                            },
                            {
                                "example_id": "5e930392-d653-4110-85c8-62d0f2e752e7",
                                "sense_id": "8deb733a-87ea-3e3a-bfd9-951faa3f272b",
                                "text": "Pichlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
