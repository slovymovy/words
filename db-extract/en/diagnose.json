                    {
                        "sense_id": "85ca555c-a25a-31bd-b247-d3b9c2721d9c",
                        "entry_id": "bcff138b-2f2c-30a7-ba32-3519668a087d",
                        "glosses": [
                            "To determine the cause of a problem."
