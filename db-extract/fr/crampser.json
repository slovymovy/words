                                "example_id": "342bc725-2282-4780-91ea-3ba12183b275",
                                "sense_id": "512a65be-5a68-34e3-bd28-9123b4c7c96f",
                                "text": "Elle est très gentille la bergère ; mais elle a des yeux à le faire crampser dans six mois, s'il ne se donne à garde."
                            },
                            {
                                "example_id": "d0bb8112-5d6a-4db7-8aaf-12b90d471e3a",
                                "sense_id": "512a65be-5a68-34e3-bd28-9123b4c7c96f",
                                "text": "C'est dans cette sacrée passe de Chilkoot que j'ai failli crampser."
                            }
                        ]
                    }
