                    }
                ],
                "translations": [
                    {
                        "translation_id": "852458f9-7f5a-4b2d-9664-2b14ff29efaf",
                        "source_entry_id": "50ee16da-c078-34e8-8aab-7d6ecbd9786c",
                        "source_sense_id": "d4d71d18-18ff-301d-a26f-5e1f53d96528",
                        "target_lang_word": "strawbed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strawbed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2b7d86-57f0-3452-882e-3be8514b35ad",
                                        "entry_id": "18cca07a-d8dc-36e5-b210-dbbbfffd057c",
                                        "glosses": [
                                            "A mattress made of dry straw in a cloth sack, often used beneath a featherbed or other softer mattress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517a2572-1569-4b68-a59c-fb24019eef2c",
                                                "sense_id": "bb2b7d86-57f0-3452-882e-3be8514b35ad",
                                                "text": "The lying-in woman was not allowed to lie in bed, but a strawbed was prepared for her on the floor."
                                            },
                                            {
                                                "example_id": "75098c82-b015-455c-b72c-d72402c5b8f0",
                                                "sense_id": "bb2b7d86-57f0-3452-882e-3be8514b35ad",
                                                "text": "To cut down labor pains , put something made of iron or steel between the strawbed and the featherbed."
                                            },
                                            {
                                                "example_id": "676ae660-3f34-4530-9fe5-30c9d8fdab3b",
                                                "sense_id": "bb2b7d86-57f0-3452-882e-3be8514b35ad",
                                                "text": "It is very difficult for me to make my strawbed in accordance with military regulations."
                                            },
                                            {
                                                "example_id": "1009d039-8740-4660-8bc4-3cd1bc63063c",
                                                "sense_id": "bb2b7d86-57f0-3452-882e-3be8514b35ad",
                                                "text": "Molitor escaped and \"hid in the strawbed of his French mistress\" before inexplicably leaving Germany and \"arriving safely\" in New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01460950-f494-371e-8af1-4ba122772050",
                                        "entry_id": "18cca07a-d8dc-36e5-b210-dbbbfffd057c",
                                        "glosses": [
                                            "Childbirth."
                                        ],
                                        "tags": [
                                            "Bahamas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9abbbf2d-6514-4c61-bc12-3660ac7c48a2",
                                                "sense_id": "01460950-f494-371e-8af1-4ba122772050",
                                                "text": "An old woman called \"Ala Ju\" (Mother Julia) walked three miles to get me a sample of the Granny Bush (Croton linearis), whose leaves are steeped and given to women for nine days after childbirth, or \"strawbed\" as it is termed here."
                                            },
                                            {
                                                "example_id": "c0db6491-5e75-406f-b195-ee6fb0301a80",
                                                "sense_id": "01460950-f494-371e-8af1-4ba122772050",
                                                "text": "It grows profusely in the Bahamas. It is used for \"building up men's energy and body\" and as a sponge bath for women, \"after they come out of strawbed\"."
                                            },
                                            {
                                                "example_id": "168fc3a4-2dc5-46ce-b418-dc327f93569c",
                                                "sense_id": "01460950-f494-371e-8af1-4ba122772050",
                                                "text": "\"Strawbed fever\" results from an infection caught in \"strawbed\" (childbirth)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5309d76-1801-4372-bf14-d821fadf8334",
                        "source_entry_id": "50ee16da-c078-34e8-8aab-7d6ecbd9786c",
                        "source_sense_id": "d4d71d18-18ff-301d-a26f-5e1f53d96528",
                        "target_lang_word": "jergón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jergón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a8190253-9e15-3a66-bf9e-b43cfbf38d66",
                                        "entry_id": "1b63e84d-d79b-3f74-b709-c789c97162a5",
                                        "glosses": [
                                            "Colchón de paja, esparto o hierba y sin bastas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33291cb-bd4f-4c3e-a45c-3236e51dea49",
                                                "sense_id": "a8190253-9e15-3a66-bf9e-b43cfbf38d66",
                                                "text": "Dejé de dormir en el jergón que había rescatado y pasé a una hamaca muy buena …."
                                            },
                                            {
                                                "example_id": "cee69719-9f46-47f8-9bb5-f91b32580c1f",
                                                "sense_id": "a8190253-9e15-3a66-bf9e-b43cfbf38d66",
                                                "text": "El destierro enseña a vivir y a bastarse; porque pan y jergón son las más dulces medicinas del hambre y del cansancio."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3d23773-88dd-31d7-9ff9-5b405df96c54",
                                        "entry_id": "1b63e84d-d79b-3f74-b709-c789c97162a5",
                                        "glosses": [
                                            "Vestido mal hecho y poco ajustado al cuerpo."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "55369b37-34c5-3130-a4f0-ee4644fcc3f2",
                                        "entry_id": "1b63e84d-d79b-3f74-b709-c789c97162a5",
                                        "glosses": [
