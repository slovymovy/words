                "senses": [
                    {
                        "sense_id": "4f940b90-ecbd-35bd-b8ed-da9c9ab92869",
                        "entry_id": "2ad3f718-8cce-3dd6-b2c4-b6536c966402",
                        "glosses": [
                            "Coque de silice amorphe entourant certaines diatomées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdee7f34-7b6e-47c5-bf7a-cc47cd77c17c",
                                "sense_id": "4f940b90-ecbd-35bd-b8ed-da9c9ab92869",
                                "text": "Les Diatomées sont des Algues microscopiques unicellulaires, enfermées dans une logette siliceuse transparente à deux valves, qu’elles sécrètent elles mêmes, le frustule."
                            },
                            {
                                "example_id": "1d2749d4-8c1d-4d56-bd58-a1ba975f757e",
                                "sense_id": "4f940b90-ecbd-35bd-b8ed-da9c9ab92869",
                                "text": "La diatomée crée ainsi de petites billes de silice qui s’assemblent pour former une frustule."
                            },
                            {
                                "example_id": "9af86607-347b-4b07-80a7-00159d1c852d",
                                "sense_id": "4f940b90-ecbd-35bd-b8ed-da9c9ab92869",
                                "text": "Ces dépôt de diatomées au fond des lacs ou des océans ont participé à la formation d'une roche « tendre», issue des frustules accumulés et compactés, appelée diatomite."
                            }
                        ]
                    }
                ],
