                "senses": [
                    {
                        "sense_id": "3d76027d-670c-37a1-81a1-7815b12c8f13",
                        "entry_id": "050dafea-2836-39c0-8ca0-fb509716b265",
                        "glosses": [
                            "von der Bühne, dem Podium/Sprechplatz weit entfernte Sitzbank für Publikum (oft mit dem Beiton, dass derjenige unwichtig ist, der dort sitzt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b58655-20a4-455a-b0f4-ae7a4ec92d5a",
                                "sense_id": "3d76027d-670c-37a1-81a1-7815b12c8f13",
                                "text": "„Hier lag vielleicht ein Grund für seinen tollkühnen Entschluss: Churchill war gekränkt und verletzt – unzweifelhaft nahm er es übel, dass seine Parteiführer ihn drei Jahre lang auf den Hinterbänken schmachten ließen.“"
                            },
                            {
                                "example_id": "2236befa-c211-4db4-94e8-42e5401f0ca7",
                                "sense_id": "3d76027d-670c-37a1-81a1-7815b12c8f13",
                                "text": "Nun ist sie endlich wieder von der Hinterbank zurück und auch sofort wieder im Rampenlicht gelandet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0b32484-185a-3fcd-86ca-3df01c9853ef",
                        "entry_id": "050dafea-2836-39c0-8ca0-fb509716b265",
                        "glosses": [
                            "durchgehende Sitzfläche (in einem Auto), die hinter dem Fahrer und Beifahrer liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "317a75db-f357-4685-b102-8c19efb30a27",
                                "sense_id": "c0b32484-185a-3fcd-86ca-3df01c9853ef",
                                "text": "Ich sitze nicht gerne auf der Hinterbank, da wird mir immer schlecht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
