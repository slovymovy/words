                ],
                "senses": [
                    {
                        "sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
                        "entry_id": "646a2dd6-5e22-3486-adb8-220782f14969",
                        "glosses": [
                            "Noble indien, membre d'une des quatre varnas (caste en Inde), comprenant les rois, seigneurs, et chefs de guerre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30bb186c-ef6c-437d-863a-5e2ec7324aee",
                                "sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
                                "text": "Tu connais, de plus, tes devoirs de kshatriya : ils t’enjoignent de combattre selon les principes de la religion ; tu ne peux donc hésiter.\nHeureux les kshatriyas à qui s’offre ainsi l’occasion de combattre."
                            },
                            {
                                "example_id": "43206c62-98b4-4eb9-8038-a4b76173eaa0",
                                "sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
                                "text": "Je suis un kshatriya. Je ne vais pas abandonner mon pays, comme un lâche sous prétexte que j’ai peur. Courage, mère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2fe5930-681a-4bd7-8b47-96d2c137b84a",
                        "source_entry_id": "646a2dd6-5e22-3486-adb8-220782f14969",
                        "source_sense_id": "11145b87-1478-3df2-bd57-c8d52bfb2937",
