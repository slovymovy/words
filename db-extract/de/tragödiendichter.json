                "senses": [
                    {
                        "sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                        "entry_id": "97f6b119-176b-34e2-944c-c2590aaba3a1",
                        "glosses": [
                            "Dichter von Tragödien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635a534a-45f2-4757-ad41-8c0008ddce80",
                                "sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                                "text": "„Ach, das Kapitel vom inaktiven Fahrer ist eines der traurigsten – ein Schicksal, das wert wäre, von einem wirklichen Tragödiendichter besungen zu werden!“"
                            },
                            {
                                "example_id": "d67de646-acb1-41c1-8a9f-2c3653ad895a",
                                "sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                                "text": "„Erst durch diese christliche Stilmischung konnte sich die Ahnung verwirklichen, die Plato am Ende des Gastmahls ausspricht; wo Sokrates im Morgengrauen den letzten, von Müdigkeit auch schon nahezu überwältigten Zechern Agathon und Aristophanes erklärt, daß ein und derselbe Dichter die Komödie und die Tragödie beherrschen müsse, und daß der echte Tragödiendichter auch ein Komödiendichter sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "092674d3-510c-4d20-ba9c-f1593cb657d0",
                        "source_entry_id": "97f6b119-176b-34e2-944c-c2590aaba3a1",
                        "source_sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                        "source_sense_description": "Dichter von Tragödien",
                        "target_lang_word": "tragedian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                        "entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                                        "glosses": [
                                            "An actor who specializes in tragic roles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01cf8c9f-1e9e-434f-b277-c887134a88fc",
                                                "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                                "text": "Euen thoſe you were wont to take such delight in the Tragedians of the City."
                                            },
                                            {
                                                "example_id": "89b2b8cf-3eb9-4c59-a885-ca4da2bbbad6",
                                                "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                                "text": "And as for the separation scene from the child, while Becky was reciting it, Emmy retired altogether behind her pocket-handkerchief, so that the consummate little tragedian must have been charmed to see the effect which her performance produced on her audience."
                                            },
                                            {
                                                "example_id": "342aa6c7-da9a-4daf-969c-ba9b315e71fe",
                                                "sense_id": "d1614cbc-5f57-3e76-bf8c-ff87da63ed70",
                                                "text": "Greene died of a debauch; and Marlowe, the gracer of tragedians, perished in an ignominious brawl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdaea335-ac2b-360e-a1c4-5b219c63e079",
                                        "entry_id": "245c8191-d2b1-37c6-88a7-6a4e05df95c1",
                                        "glosses": [
                                            "A playwright who writes tragedies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0278b805-20af-46f7-8d91-66b357fa918f",
                        "source_entry_id": "97f6b119-176b-34e2-944c-c2590aaba3a1",
                        "source_sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                        "source_sense_description": "Dichter von Tragödien",
                        "target_lang_word": "tragic dramatist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98a3fa32-9d6a-4f44-9e32-f7c65b9e5c68",
                        "source_entry_id": "97f6b119-176b-34e2-944c-c2590aaba3a1",
                        "source_sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                        "source_sense_description": "Dichter von Tragödien",
                        "target_lang_word": "poète tragique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0cb8bacc-b32b-448b-8d31-fc77a216e914",
                        "source_entry_id": "97f6b119-176b-34e2-944c-c2590aaba3a1",
                        "source_sense_id": "fb1d5b9d-31e4-374a-95b9-ac58e35d510e",
                        "source_sense_description": "Dichter von Tragödien",
                        "target_lang_word": "tragique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d37ab46d-cc7c-3e49-9fd9-e0b73a5605f9",
                                        "entry_id": "51b4bd3c-e220-379a-9707-123079615a6f",
                                        "glosses": [
                                            "Qui appartient à la tragédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "944b249b-9371-4b00-b1ea-7da2258d567f",
                                                "sense_id": "d37ab46d-cc7c-3e49-9fd9-e0b73a5605f9",
                                                "text": "« Tragique » veut dire en grec la voix muante et rauque du bouc mis à mort."
                                            },
                                            {
                                                "example_id": "46c46f1e-9257-446f-abe9-d60a46f336dc",
                                                "sense_id": "d37ab46d-cc7c-3e49-9fd9-e0b73a5605f9",
                                                "text": "Le premier auteur-acteur tragique, Thespis, s’enduisit le visage de blanc de céruse, puis il inventa le masque de toile, d'abord assez neutre, sans expression, […]. Peu à peu, mais sans qu'on sache dater précisément cette évolution, le masque tragique va figurer l'expression des sentiments humains […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a00bc6ac-cb97-335b-acac-47621f4d9540",
                                        "entry_id": "51b4bd3c-e220-379a-9707-123079615a6f",
                                        "glosses": [
                                            "Qui est funeste, terrible ; qui se finit mal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4115e3-54bc-4b25-afd8-bf33fbf58adc",
                                                "sense_id": "a00bc6ac-cb97-335b-acac-47621f4d9540",
                                                "text": "Elle me revient à l’esprit, la tragique phrase de Duveyrier : « Le colonel met le pied à l’étrier et reçoit au même moment un coup de sabre… »"
                                            },
                                            {
                                                "example_id": "9dc531c1-d294-458b-83ae-b826938b9634",
                                                "sense_id": "a00bc6ac-cb97-335b-acac-47621f4d9540",
                                                "text": "Voici, par exemple, au bord de la route qui me conduit à Montauban, le joli bourg de Réalville, […] où, par la suite, se déroulèrent de tragiques épisodes de la vaine lutte entre catholiques et protestants."
                                            },
                                            {
                                                "example_id": "f6628b9a-cea1-4ae6-8802-831235ab6814",
                                                "sense_id": "a00bc6ac-cb97-335b-acac-47621f4d9540",
                                                "text": "Hantée par les fantômes, séquestrée, abandonnée, renvoyée, oubliée, suicidée : tragiques sont les histoires des gouvernantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tragique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f440588-e638-3008-a8b3-08159898d12f",
                                        "entry_id": "653be8db-a81c-3bc8-b94f-5d184fc39132",
                                        "glosses": [
                                            "Genre tragique, tragédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6533ea9f-fd9b-4a0e-912a-45668d9d6d06",
                                                "sense_id": "5f440588-e638-3008-a8b3-08159898d12f",
                                                "text": "Ce poète s’est voué au tragique."
                                            },
                                            {
                                                "example_id": "69723882-6372-4ec1-bea1-087d7d547714",
                                                "sense_id": "5f440588-e638-3008-a8b3-08159898d12f",
                                                "text": "Cet acteur est excellent dans le tragique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17946a44-60d6-3c6a-ac0e-cf1ba1067b50",
                                        "entry_id": "653be8db-a81c-3bc8-b94f-5d184fc39132",
                                        "glosses": [
                                            "Auteur de tragédies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34df307e-f21f-409c-a57e-4e0d44c6a319",
                                                "sense_id": "17946a44-60d6-3c6a-ac0e-cf1ba1067b50",
                                                "text": "Les tragiques grecs."
                                            },
                                            {
                                                "example_id": "de385bba-2834-4a96-8f62-a461d471abf6",
                                                "sense_id": "17946a44-60d6-3c6a-ac0e-cf1ba1067b50",
                                                "text": "Corneille et Racine sont nos deux grands tragiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019340a5-e2db-3e6b-b5e5-e8c985dea56e",
                                        "entry_id": "653be8db-a81c-3bc8-b94f-5d184fc39132",
                                        "glosses": [
                                            "Ce qui a un caractère funeste, terrible, alarmant."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69f5b84-98c8-4aa3-b75f-ae1388716859",
                                                "sense_id": "019340a5-e2db-3e6b-b5e5-e8c985dea56e",
                                                "text": "Le tragique est que là, devant moi, le passé reste mort en sa permanence et permanent en son dessèchement, tache ineffaçable ou parfum irretrouvable."
                                            }
                                        ]
                                    }
                                ]
                            },
