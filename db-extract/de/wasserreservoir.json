                        "examples": [
                            {
                                "example_id": "e4c69a0f-e25b-4afd-8862-bf6461fdfb8b",
                                "sense_id": "84e909cd-5fa1-3e8e-b858-e1ce91b31fb8",
                                "text": "Nach den heftigen Regenfällen der letzten Tage war das Wasserreservoir gut gefüllt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "407944d6-eded-3d86-bd74-4e3928dd35b2",
                        "entry_id": "65ed2ba8-ec17-36ee-b32f-7f4727887a0f",
                        "glosses": [
                            "Vorrat an Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed7e1bc-30a9-46af-b99c-054be8dc00b1",
                                "sense_id": "407944d6-eded-3d86-bd74-4e3928dd35b2",
                                "text": "„Das Kobalt hat der Christlessee aber scheinbar für sich behalten, das sieht man - besonders im Sommer – aus der Tiefe dieses Sees leuchten, der mit seinen Quellen übrigens das Wasserreservoir für Oberstdorf ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
