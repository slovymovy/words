                    },
                    {
                        "translation_id": "82fc660e-cb0a-485b-88e8-956776486bc9",
                        "source_entry_id": "9a5c3abc-5498-335e-859b-c9ce9e522fb2",
                        "source_sense_id": "73e3bf0f-87ea-3b72-815d-1fcbd512838d",
                        "target_lang_word": "méiose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méiose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "792ce83c-42bd-3d71-93c7-1a690a19d82a",
                                        "entry_id": "b8cd5c47-6282-3794-8926-99e31014a2d0",
                                        "glosses": [
                                            "Ensemble des deux divisions cellulaires aboutissant à la formation du gamète par réduction chromatique."
                                        ],
                                        "tags": [
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39a78f3b-09f6-4506-867e-cf78e29b5013",
                                                "sense_id": "792ce83c-42bd-3d71-93c7-1a690a19d82a",
                                                "text": "La conception nécessite l’atteinte et la pénétration par le spermatozoïde de l’ovocyte, qui complète sa méiose II avant la fusion des deux noyaux lors de la fécondation ([…])."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3419310c-3eef-40a4-a8f9-bce9f9189a22",
                        "source_entry_id": "9a5c3abc-5498-335e-859b-c9ce9e522fb2",
                        "source_sense_id": "73e3bf0f-87ea-3b72-815d-1fcbd512838d",
                        "target_lang_word": "meiosis",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meiosis",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b5fc652d-1bb3-30d2-9372-a7ea98133f44",
                                        "entry_id": "0f14f794-4e1e-3a9c-b7bb-a62b726e690f",
                                        "glosses": [
                                            "División celular compleja, propia de los eucariontes, que conduce a la producción de cuatro gametos, los cuales son células que tienen un número de cromosomas igual a la mitad del que tiene el resto de las células del individuo."
                                        ],
                                        "tags": [],
                                        "examples": [],
