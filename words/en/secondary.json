{
    "word_family": [
        "second",
        "secondarily",
        "secondariness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf1d9ece-4f80-343d-9c32-a65ca697e15d",
                    "sense_definition": "Of less than primary importance or value; minor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cost of the project is a <w>secondary</w> consideration compared to the safety of the workers.",
                            "target_lang_translations": {
                                "ru": "Стоимость проекта — это <w>второстепенный</w> вопрос по сравнению с безопасностью рабочих.",
                                "zh": "与工人的安全相比，项目成本只是一个<w>次要</w>考虑因素。"
                            }
                        },
                        {
                            "text": "Winning the game was <w>secondary</w> to having fun with friends.",
                            "target_lang_translations": {
                                "ru": "Победа в игре была <w>второстепенной</w> по сравнению с весельем в кругу друзей.",
                                "zh": "比起和朋友们玩得开心，赢球只是<w>次要</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "minor",
                        "subordinate",
                        "subsidiary",
                        "lesser",
                        "incidental"
                    ],
                    "common_phrases": [
                        "secondary importance",
                        "secondary issue",
                        "secondary role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий меньшую важность или ценность по сравнению с чем-то основным; второстепенный.",
                        "zh": "重要性或价值较低的；次要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "второстепенный",
                                "target_lang_sense_clarification": "не основной"
                            },
                            {
                                "target_lang_word": "побочный",
                                "target_lang_sense_clarification": "сопутствующий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "次要",
                                "target_lang_sense_clarification": "非主要的"
                            },
                            {
                                "target_lang_word": "附带",
                                "target_lang_sense_clarification": "伴随的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65ebf22e-fcf8-30f4-9c4d-173a0790545e",
                    "sense_definition": "Related to the education of children between the ages of approximately 11 and 18, following primary education.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She teaches mathematics at a large <w>secondary</w> school in the city.",
                            "target_lang_translations": {
                                "ru": "Она преподает математику в большой <w>средней</w> школе в городе.",
                                "zh": "她在城里的一所大型<w>中学</w>教数学。"
                            }
                        },
                        {
                            "text": "Students usually begin their <w>secondary</w> education at the age of eleven.",
                            "target_lang_translations": {
                                "ru": "Ученики обычно начинают <w>среднее</w> образование в возрасте одиннадцати лет.",
                                "zh": "学生通常在十一岁时开始接受<w>中学</w>教育。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "secondary school",
                        "secondary education",
                        "secondary level"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in UK, Australia, Canada; equivalent to high school in US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к обучению детей в возрасте от 11 до 18 лет, следующему за начальным образованием.",
                        "zh": "指小学之后，针对11至18岁左右青少年的教育阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средний",
                                "target_lang_sense_clarification": "об образовании или школе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中学",
                                "target_lang_sense_clarification": "指教育阶段或学校"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65477863-34ed-30a8-b6ba-a2f8e568df5f",
                    "sense_definition": "Coming after the first or primary one in time, place, or order; not original.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drug has a beneficial <w>secondary</w> effect that helps patients sleep.",
                            "target_lang_translations": {
                                "ru": "У лекарства есть полезный <w>побочный</w> эффект, который помогает пациентам спать.",
                                "zh": "这种药有一种有益的<w>副</w>作用，能帮助病人入睡。"
                            }
                        },
                        {
                            "text": "Historians prefer to use primary documents rather than <w>secondary</w> sources.",
                            "target_lang_translations": {
                                "ru": "Историки предпочитают использовать первоисточники, а не <w>вторичные</w> источники.",
                                "zh": "历史学家更喜欢使用原始文献，而不是<w>二次</w>文献。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subsequent",
                        "derivative"
                    ],
                    "common_phrases": [
                        "secondary source",
                        "secondary effect",
                        "secondary stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следующий за первым или основным по времени, месту или порядку; не оригинальный, а производный.",
                        "zh": "在时间、地点或顺序上排在第一或主要之后；非原创的，衍生出来的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторичный",
                                "target_lang_sense_clarification": "производный, следующий за первым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二次",
                                "target_lang_sense_clarification": "非原始的"
                            },
                            {
                                "target_lang_word": "衍生",
                                "target_lang_sense_clarification": "从主要来源派生的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59aca472-4c46-3d4f-9fe4-65eddb6c1fcb",
                    "sense_definition": "Caused by or resulting from another condition or disease.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient developed a <w>secondary</w> infection while in the hospital.",
                            "target_lang_translations": {
                                "ru": "У пациента развилась <w>вторичная</w> инфекция во время пребывания в больнице.",
                                "zh": "病人在住院期间发生了<w>继发性</w>感染。"
                            }
                        },
                        {
                            "text": "His high blood pressure is <w>secondary</w> to kidney disease.",
                            "target_lang_translations": {
                                "ru": "Его высокое кровяное давление <w>вторично</w> по отношению к заболеванию почек.",
                                "zh": "他的高血压是肾病<w>继发</w>引起的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "idiopathic"
                    ],
                    "common_phrases": [
                        "secondary infection",
                        "secondary symptom",
                        "secondary tumor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызванный другим состоянием или заболеванием; являющийся следствием.",
                        "zh": "由另一种疾病或状况引起的；作为某种情况的后果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторичный",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继发性",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7889404e-c370-3487-97e7-945ea01459c6",
                    "sense_definition": "Formed by mixing two primary colors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Green is a <w>secondary</w> color made by mixing blue and yellow.",
                            "target_lang_translations": {
                                "ru": "Зеленый — это <w>составной</w> цвет, получаемый смешиванием синего и желтого.",
                                "zh": "绿色是由蓝色和黄色混合而成的<w>间色</w>。"
                            }
                        },
                        {
                            "text": "The artist used a palette of <w>secondary</w> colors to create a soft contrast.",
                            "target_lang_translations": {
                                "ru": "Художник использовал палитру <w>составных</w> цветов для создания мягкого контраста.",
                                "zh": "艺术家使用了一组<w>间色</w>来营造柔和的对比感。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "secondary color"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образованный смешением двух основных цветов.",
                        "zh": "由两种原色混合而成的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составной",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "вторичный",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间色",
                                "target_lang_sense_clarification": "美术术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93a9b2e6-d71f-3e48-9f80-03ce323d998a",
                    "sense_definition": "The defensive players who position themselves behind the linebackers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quarterback threw a long pass over the heads of the <w>secondary</w>.",
                            "target_lang_translations": {
                                "ru": "Квотербек бросил длинный пас через головы игроков <w>задней линии защиты</w>.",
