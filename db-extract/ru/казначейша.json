                "senses": [
                    {
                        "sense_id": "f42132c8-9730-3c59-a877-62352bbd5dd4",
                        "entry_id": "c986cd09-fc47-3be2-b960-3fcb705a3e4d",
                        "glosses": [
                            "устар. жена казначея"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829ba7fe-81fe-4bc9-8666-a1b2cf3021c7",
                                "sense_id": "f42132c8-9730-3c59-a877-62352bbd5dd4",
                                "text": "Что казначейша иногда // Сгорит, бывало, от стыда."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c7e5ee1-e50f-31e0-939f-cb3748a2363e",
                        "entry_id": "c986cd09-fc47-3be2-b960-3fcb705a3e4d",
                        "glosses": [
                            "разг. монахиня в женском монастыре, заведующая хозяйством, приходом и расходом денежных средств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95049ace-3150-4b18-a21e-4160204b06fa",
                                "sense_id": "2c7e5ee1-e50f-31e0-939f-cb3748a2363e",
                                "text": "И потому раньше других ушел он от Бузуна, изо всех сил стараясь держаться преувеличенно пьяно и весело; еще раз, напоказ крепко крест-накрест, как на Пасху, расцеловался с попом, еще раз напомнил казначейше о ветчине ― как будто ничего не случилось, ― все сделал, чтобы никто не сказал: вошел большим ― вышел маленьким."
                            }
                        ]
                    }
                ],
