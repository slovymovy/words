                                        "entry_id": "54c82cb6-9528-3464-aca1-3a5478f0295c",
                                        "glosses": [
                                            "Any of many marine protozoa of the phylum Dinoflagellata, which have two flagella."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb38735e-bf49-48d6-ad9f-a965a5929c11",
                                                "sense_id": "83ab9db8-b447-3026-b239-a4399447ad5b",
                                                "text": "Noctiluna scintillans, a tiny marine dinoflagellate, glows in the dark thanks to thousands of bioluminescent spherical organelles in its cytoplasm; gathered in millions, it can illuminate the whole sea at night."
                                            }
                                        ]
                                    }
