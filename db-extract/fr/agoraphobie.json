                                    {
                                        "sense_id": "70044711-0c29-3c2c-97c8-da078ec8130c",
                                        "entry_id": "5e1a1e50-24ec-36ad-9666-194198862f85",
                                        "glosses": [
                                            "krankhafte Angst vor weiten Plätzen, Menschenmengen oder Reisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e2be51-a9c7-464e-aa97-8a76e357e73d",
                                                "sense_id": "70044711-0c29-3c2c-97c8-da078ec8130c",
                                                "text": "In der überwiegenden Zahl der Fälle tritt die Agoraphobie gemeinsam mit einer Panikstörung auf, wobei die Angst vor dem Auftreten von Panikattacken in der Folge zur Vermeidung bestimmter Orte führt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbefac0a-a947-459f-b8dc-bd4ac744b497",
