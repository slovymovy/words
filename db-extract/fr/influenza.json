        "fr-extract.jsonl": [
            {
                "entry_id": "9bb6bbb3-17fd-3bcd-bb9f-7da748f13876",
                "word": "influenza",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e64767e-5110-43ec-8b3a-c27244e047f2",
                        "entry_id": "9bb6bbb3-17fd-3bcd-bb9f-7da748f13876",
                        "tags": [
                            "plural"
                        ],
                        "form": "influenzas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9be89750-5f80-341f-9fba-dbf28d44b62d",
                        "entry_id": "9bb6bbb3-17fd-3bcd-bb9f-7da748f13876",
                        "glosses": [
                            "Grippe."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ec496d81-d039-461b-b79c-17241e8774db",
                                "sense_id": "9be89750-5f80-341f-9fba-dbf28d44b62d",
                                "text": "Nous fûmes pris d’influenza, la Marinette et moi, au cours de l’hiver tardif et rude de 1895, et Madeleine, la femme de Charles, fut obligée de venir de Puy-Brot pour nous soigner."
                            },
                            {
                                "example_id": "6a7c20aa-362f-44a0-8d7a-35b9c76d2fa0",
                                "sense_id": "9be89750-5f80-341f-9fba-dbf28d44b62d",
                                "text": "[…] ; on avait bien enregistré trois décès, occasionnés par l’influenza, mais les naissances compensaient les décès."
                            },
                            {
                                "example_id": "30b0f8bf-ee3a-4d34-be09-d6a568cb73ab",
                                "sense_id": "9be89750-5f80-341f-9fba-dbf28d44b62d",
                                "text": "Le « sémaphore » signalait de très violentes épidémies d'influenza dans les quartiers exposés au vent du large."
                            },
                            {
                                "example_id": "c9dc5d35-86bb-45da-8ac7-8c6afb9c109f",
                                "sense_id": "9be89750-5f80-341f-9fba-dbf28d44b62d",
                                "text": "L'épidémie d'influenza était devenue très maligne, on commençait même à en mourir un peu de tous les côtés."
                            },
                            {
                                "example_id": "8724e978-472d-48fa-9681-62a3f4a40b03",
                                "sense_id": "9be89750-5f80-341f-9fba-dbf28d44b62d",
                                "text": "La nouvelle était montée de la Vallée comme un influenza et les griveleux ne doutaient ni de sa vérité, ni de l’hostilité qu’on leur vouait."
                            }
                        ]
                    }
                ],
