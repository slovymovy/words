                "senses": [
                    {
                        "sense_id": "a8f4d57d-0e89-3bb5-81b7-40564bf00f4d",
                        "entry_id": "112736f3-dfad-3240-9206-f0b9b07b6ab2",
                        "glosses": [
                            "Stelle von oder an einem Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ea3fb5-d287-4804-80e5-c482b49d5c9c",
                                "sense_id": "a8f4d57d-0e89-3bb5-81b7-40564bf00f4d",
                                "text": "Eine schmale Wegstelle nennt man Engpass."
                            },
                            {
                                "example_id": "6d728a80-d488-492c-884d-f5bc63901729",
                                "sense_id": "a8f4d57d-0e89-3bb5-81b7-40564bf00f4d",
                                "text": "„Die Eltern kamen an eine 100 Meter lange, überspülte Wegstelle unter der sich eine Senke befand.“"
                            },
                            {
                                "example_id": "8737cfa9-0415-439f-b154-b145cb661a30",
                                "sense_id": "a8f4d57d-0e89-3bb5-81b7-40564bf00f4d",
                                "text": "„Wenig später rückte Dora an einer engen Wegstelle im Wald dicht auf Pferd auf.“"
                            },
                            {
                                "example_id": "5de4cf18-09a8-45e2-8706-379b14a0d94a",
                                "sense_id": "a8f4d57d-0e89-3bb5-81b7-40564bf00f4d",
                                "text": "„Während dieses Gespräch zwischen Schach und Frau von Carayon geführt wurde, war das ihnen voranschreitende Paar bis an eine Wegstelle gekommen, von der aus ein Fußpfad über ein frisch gepflügtes Ackerfeld hin sich abzweigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
