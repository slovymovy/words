    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3cb16ce-e515-37a5-85dc-c658f8fcc50d",
                    "sense_definition": "Ce qui est produit par une cause ; résultat ou conséquence d'une action, d'un phénomène ou d'un produit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "résultat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament a un <w>effet</w> rapide sur la douleur."
                        },
                        {
                            "text": "Les <w>effets</w> du réchauffement climatique sont visibles dans le monde entier."
                        },
                        {
                            "text": "Ce traitement peut provoquer des <w>effets</w> secondaires chez certains patients."
                        }
                    ],
                    "synonyms": [
                        "conséquence",
                        "résultat"
                    ],
                    "antonyms": [
                        "cause"
                    ],
                    "common_phrases": [
                        "effets secondaires",
                        "effet de serre",
                        "avoir un effet sur"
                    ]
                },
                {
                    "sense_id": "96ea37c2-39e5-3bf7-a9ed-4a8c9fd1c275",
                    "sense_definition": "Impression produite sur les yeux ou sur l'esprit par ce qui attire l'attention ou frappe par son aspect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impression",
                    "name_type": "no",
                    "examples": [
