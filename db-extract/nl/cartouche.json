                    {
                        "translation_id": "cbd91830-13c5-4e9f-a145-7f237dfba8b9",
                        "source_entry_id": "a3d22b8d-cc55-3bb1-83b5-fa9cd0020dc0",
                        "source_sense_id": "6346aed3-8923-33c3-a078-c1bae00a7136",
                        "source_sense_description": "omlijst schild met tekst of een wapen op een kaart of gebouw",
