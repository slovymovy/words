                "senses": [
                    {
                        "sense_id": "250efda0-2354-32d0-a42f-347026131c55",
                        "entry_id": "20d468b6-aa8b-3626-8e14-7e80c03eccec",
                        "glosses": [
                            "ruchy przełyku, żołądka, jelit i moczowodów wywołujące przesuwanie się zawartości tego narządu"
                        ],
                        "tags": [],
