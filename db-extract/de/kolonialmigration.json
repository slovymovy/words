                "senses": [
                    {
                        "sense_id": "8c243741-48ce-3903-8910-919c301401b8",
                        "entry_id": "fb9f311f-525d-3eea-8c78-c2cb87ec3453",
                        "glosses": [
                            "Einwanderung aus einer Kolonie in das Mutterland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e174aa-45c0-420a-9260-65a5139cf4ba",
                                "sense_id": "8c243741-48ce-3903-8910-919c301401b8",
                                "text": "„Im Gegensatz zu anderen europäischen Kolonialmächten wie Frankreich, England oder den Niederlanden, in denen die Kolonialmigration nach 1918 erheblich anwuchs und die jeweiligen Gesellschaften bis heute nachhaltig prägt, erlebte das deutsche Reich keinen weiteren Zuzug aus den Kolonien.“"
                            },
                            {
                                "example_id": "75a475e1-1eb3-45ca-a41f-6c51736b290c",
                                "sense_id": "8c243741-48ce-3903-8910-919c301401b8",
                                "text": "„Diese Abgrenzung stellte für die Weißen Machthaber jedoch vor allem im Rahmen der entstandenen „Kolonialmigration\" ein „Problem\" dar, durch welches erstmals zahlreiche Menschen afrikanischer Herkunft in die deutsche Öffentlichkeit fanden.“"
                            },
                            {
                                "example_id": "9f5b00a9-5581-424d-a2d0-1f38eacaf768",
                                "sense_id": "8c243741-48ce-3903-8910-919c301401b8",
                                "text": "„Grosse selbst kündigt in seinem Buch eine Studie zur Kolonialmigration in Deutschland zwischen 1870 und 1945 an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4dcd9d0-5a48-3c93-a5e4-1e7ffae75130",
                        "entry_id": "fb9f311f-525d-3eea-8c78-c2cb87ec3453",
                        "glosses": [
                            "Auswanderung aus dem Mutterland in eine Kolonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192ea758-f935-4543-852f-686b8f6309b0",
                                "sense_id": "a4dcd9d0-5a48-3c93-a5e4-1e7ffae75130",
                                "text": "„Neben der Kolonialmigration vom 16. bis 19. Jahrhundert verließen auch noch in der zweiten Hälfte des 20. Jahrhunderts hunderttausende Spanier ihr Land.“"
                            },
                            {
                                "example_id": "a995a87a-d7c5-4fa6-9e6d-6e8fb471b3a6",
                                "sense_id": "a4dcd9d0-5a48-3c93-a5e4-1e7ffae75130",
                                "text": "„Neben der transpazifischen Arbeitsmigration nach Nordamerika kam es ab den 1880er-Jahren zu einer Welle der Kolonialmigration in südostasiatische Gebiete, auf die Japan im Glauben an die Überlegenheit einer japanischen Yamato-Rasse Ansprüche erhob.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
