                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23ff1326-ead3-459e-b96f-fefb738e8ca2",
                                                "sense_id": "b701978e-d1dd-328c-af8e-1d7420f55057",
                                                "text": "I am meagred to a skeleton; my nose is broiled to flaming heat, and I am suffering the greatest inconvenience from the loss of my baggage which I fear the enemy have taken with my servant at Konigsberg."
                                            }
                                        ]
