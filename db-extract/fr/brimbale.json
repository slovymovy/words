                "senses": [
                    {
                        "sense_id": "7e740a9b-6a85-3337-bcd5-700343f16f38",
                        "entry_id": "5ae8cbcc-935d-3c60-a980-92813976402a",
                        "glosses": [
                            "Levier qui sert à faire aller une pompe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4c8b4e-87d9-4db7-b138-94c952ffdfcf",
                                "sense_id": "7e740a9b-6a85-3337-bcd5-700343f16f38",
                                "text": "À la campagne, dans les villages, on tire l’eau des puits comme au bon vieux temps. Ce matin, de ma chambre, je vois fonctionner une antique brimbale."
                            }
                        ]
                    },
                    {
                        "sense_id": "958c98a1-ab76-323c-a0ee-130221b0203d",
                        "entry_id": "5ae8cbcc-935d-3c60-a980-92813976402a",
                        "glosses": [
                            "Potence en fer ou en bois servant à la cuisson ou au service des aliments."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "736142cb-16de-3464-bb1a-7bb52d3c778f",
                        "entry_id": "5ae8cbcc-935d-3c60-a980-92813976402a",
                        "glosses": [
                            "Pour la pêche blanche, perche soutenant dans la cabane toutes les lignes qui pendent dans l'eau à travers le trou dans la glace."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "631d333f-3c88-4ea3-951c-59c247ace544",
                                "sense_id": "736142cb-16de-3464-bb1a-7bb52d3c778f",
                                "text": "La clientèle occasionnelle, pour sa part, pourra louer une cabane et des brimbales et demander qu'on perce ses trous"
                            }
                        ]
                    }
                ],
