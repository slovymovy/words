                                    {
                                        "sense_id": "79e08c52-3789-3940-b769-00cef2f7f2bb",
                                        "entry_id": "7c830f3b-5bd0-3123-b081-ce8f936c20fd",
                                        "glosses": [
                                            "kombinace vysoké inflace a současného nízkého výkonu ekonomiky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7521614a-e829-4476-83dd-572a70eb4757",
                                                "sense_id": "79e08c52-3789-3940-b769-00cef2f7f2bb",
                                                "text": "Analytici už delší dobu upozorňují, že Evropě hrozí riziko stagflace, což je stav, kdy stagnuje či mírně klesá výroba, zatímco cenová hladina má tendenci se rychle zvyšovat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
