                        "glosses": [
                            "kleding die alleen wordt gedragen bij speciale gelegenheden zoals wanneer men een feest of concert bijwoont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12dea384-fb7c-4367-b81d-a34b34eeadb3",
                                "sense_id": "0d45939f-f503-3761-8a13-7bd845d8c918",
                                "text": "Joera en Tonja kregen in die dagen voor het eerst in hun leven uitgaanskleding aangemeten: Joera een gekleed zwart kostuum en Tonja een avondjapon van licht satijn en met een iets open hals."
                            },
                            {
                                "example_id": "97882336-762e-49b7-80bf-06e0ae6b8c71",
                                "sense_id": "0d45939f-f503-3761-8a13-7bd845d8c918",
                                "text": "De Nederlandse Stichting voor het Gehandicapte Kind (NSGK) daagt iedereen uit feestelijke uitgaanskleding te ontwerpen voor jongeren in een rolstoel. De stichting heeft daarom een ontwerpwedstrijd uitgeschreven."
                            }
                        ]
                    }
