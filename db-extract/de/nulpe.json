                "senses": [
                    {
                        "sense_id": "d4643c16-b510-3b59-b19c-e6fc03f25ed8",
                        "entry_id": "adcafffa-1dcd-361e-9e42-e9be6912eaf3",
                        "glosses": [
                            "fool, nitwit"
                        ],
                        "tags": [
                            "dated",
                            "derogatory",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "e5705431-e7d8-4ff7-8311-57b5a7eaca68",
                                "sense_id": "d4643c16-b510-3b59-b19c-e6fc03f25ed8",
                                "text": "Aber der König! Er konnte nicht wegfinden von dem Brautpaar, biederte sich an und schien am liebsten als Zuschauer dableiben zu wollen. Diederich, dem der König schon immer zu konziliant gewesen war für diese harte Zeit, nannte ihn jetzt einfach eine Nulpe.",
                                "translation": "But the king! He couldn't get away from the bride and groom, he was ingratiating himself and seemed to prefer to stick around as a spectator. Diederich, for whom the king had always been too accommodating for these hard times, now simply termed him a dope.",
                                "english": "But the king! He couldn't get away from the bride and groom, he was ingratiating himself and seemed to prefer to stick around as a spectator. Diederich, for whom the king had always been too accommodating for these hard times, now simply termed him a dope."
                            }
                        ]
                    }
                ],
