                        "théâtre antique",
                        "monde antique",
                        "histoire antique"
                    ]
                },
                {
                    "sense_id": "2625944b-e060-3960-95fd-5481471951b8",
                    "sense_definition": "Extrêmement ancien, qui date d'une époque reculée.",
