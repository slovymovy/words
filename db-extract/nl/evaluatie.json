                "senses": [
                    {
                        "sense_id": "29795b86-44f5-39a3-aa38-c5e1b84d3ce7",
                        "entry_id": "466b6932-10d0-306c-96c5-1a3c15840ee0",
                        "glosses": [
                            "bespreking en beoordeling van de gang van zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ce3b69-9712-43cc-822c-e72f903ebf51",
                                "sense_id": "29795b86-44f5-39a3-aa38-c5e1b84d3ce7",
                                "text": "Alles wat hem berucht heeft gemaakt zat erin: zijn onbedaarlijke snoeverij, zijn haat tegen een deel van de pers (CNN en The New York Times), zijn wraakzucht (hier tegen Spanje), zijn onbetrouwbaarheid bij de evaluatie van gebeurtenissen (de effecten van de bombardementen in Iran)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8bbc7db-81ea-49e2-8bab-6a7adf7680c5",
                        "source_entry_id": "466b6932-10d0-306c-96c5-1a3c15840ee0",
                        "source_sense_id": "29795b86-44f5-39a3-aa38-c5e1b84d3ce7",
                        "source_sense_description": "bespreking en beoordeling van de gang van zaken",
                        "target_lang_word": "Evaluierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evaluierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf46bc8e-0925-37e9-ba5b-9d8136f6ad45",
                                        "entry_id": "ab7912c8-33b7-3134-8a83-30aa21923870",
                                        "glosses": [
                                            "fachgerechte Bewertung und Analyse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "874d8d7a-5c43-4609-aaf1-de0d7da76e54",
                                                "sense_id": "bf46bc8e-0925-37e9-ba5b-9d8136f6ad45",
                                                "text": "Nach der Evaluierung aller Optionen wird die günstigste ausgewählt und umgesetzt."
                                            },
                                            {
                                                "example_id": "08b6439c-f8b5-4ec9-a9f4-cd691aab878c",
                                                "sense_id": "bf46bc8e-0925-37e9-ba5b-9d8136f6ad45",
                                                "text": "„Wir rissen sie auf wie Kinder, die Geschenke auspackten, und nahmen jede ein Exemplar mit zur Morgenbesprechung, die mit einer Evaluierung begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a00825d0-9fc8-4b0b-b6a7-0c7bfc687b98",
                        "source_entry_id": "466b6932-10d0-306c-96c5-1a3c15840ee0",
                        "source_sense_id": "29795b86-44f5-39a3-aa38-c5e1b84d3ce7",
                        "source_sense_description": "bespreking en beoordeling van de gang van zaken",
                        "target_lang_word": "Auswertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auswertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                        "entry_id": "40dc5523-04c1-392c-bbd2-a912fe8535b5",
                                        "glosses": [
                                            "das Ziehen oder Gewinnen von Schlüssen aus einem Befund, oder das Gewinnen von Ergebnissen aus bekannten beziehungsweise bekannt gewordenen Tatsachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad79b76-9630-4986-a6f5-232655a8c350",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "Die Auswertung von Handy-Daten von Asylbewerbern ist juristisch problematisch."
                                            },
                                            {
                                                "example_id": "462d0618-7eb5-46fb-959e-67df51bb63bb",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "Die Auswertungen der Testergebnisse wurden am Montag in der Lokalzeitung publiziert."
                                            },
                                            {
                                                "example_id": "e1953b95-9bea-49c4-aded-ab95b914a30b",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "Nach dem Absturz des Airbus der französischen Air France wurden die Flugschreiber gestern zur Auswertung nach Ottawa gebracht."
                                            },
                                            {
                                                "example_id": "8f1f637c-57ba-4c52-81eb-4362b6ed63c2",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "„Die interne Auswertung kam zu dem Ergebnis, dass sich in der mittleren Leitungsebene eine hohe Zahl unterqualifizierter Mitarbeiter befinde.“"
                                            },
                                            {
                                                "example_id": "cb0fd148-889c-481e-b68a-afdd60a37b73",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "Nicht nur in Mitteleuropa brach der Januar 2007 Temperaturrekorde: Nach Auswertungen des Goddard Institute for Space Studies der NASA war der Monat auch weltweit mit 0,89 Grad Celsius über der Januar-Durchschnittstemperatur von 1951 bis 1980 der wärmste Januar seit mindestens 1880."
                                            },
                                            {
                                                "example_id": "b90ea4cc-393d-4ec3-a4f2-06b8142c5e90",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "Guckt man sich die Auswertungen der Studie genauer an, dann sieht man: Vor allem in Familien mit mittlerem und höherem Einkommen zeigen sich die Verbesserungen gegenüber den vergangen Jahren. Kaum aber verbessern sich die Zahlen in den unteren sozialen Schichten."
                                            },
                                            {
                                                "example_id": "e6522fb1-f29b-4ba9-aa62-82c78a2440e4",
                                                "sense_id": "ed087458-37ca-3a65-9775-3636597ed8ee",
                                                "text": "Afrikas Städte stehen in den kommenden Jahren vor einem dramatischen Anstieg der Bevölkerung. Zu diesem Ergebnis kommt das Bundesinstitut für Bevölkerungsforschung (BiB) nach der Auswertung von UN-Daten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59f07932-5548-47ea-bbe2-47fe508fa536",
                        "source_entry_id": "466b6932-10d0-306c-96c5-1a3c15840ee0",
