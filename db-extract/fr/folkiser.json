                        "glosses": [
                            "Donner un caractère folk à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0c18b86-ee6f-4fba-b6d1-e0a772eb01f5",
                                "sense_id": "347aacb2-7e1e-39df-bccf-d88953f6fd36",
                                "text": "Ils n’ont pas leur pareil pour folkiser des tubes !"
                            },
                            {
                                "example_id": "de427273-6b51-418c-8f8a-949ed32e58f2",
                                "sense_id": "347aacb2-7e1e-39df-bccf-d88953f6fd36",
                                "text": "La spécificité de ce courant est de \"folkiser\" le folklore polonais."
