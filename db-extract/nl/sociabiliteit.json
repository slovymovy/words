                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bf4c872-68d9-4aea-b474-3ad16d21f5d5",
                                                "sense_id": "5a5bbbb4-09af-3a4a-8ceb-a860035f8829",
                                                "text": "He was a true introvert, and his sociability lagged behind others of his age in the school."
                                            }
                                        ]
