                        {
                            "text": "The pressure caused the old cannon to <w>rive</w> unexpectedly during the battle.",
                            "target_lang_translations": {
                                "ru": "Давление привело к тому, что старая пушка неожиданно <w>разорвалась</w> во время боя."
                            }
