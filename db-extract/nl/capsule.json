                        "examples": [
                            {
                                "example_id": "ae55fb0b-1d2f-4d32-8cd9-85de502a0cc0",
                                "sense_id": "b3396fa9-7c3f-3121-8985-898961209408",
                                "text": "Een capsule slikt men in met een grote slok water."
                            },
                            {
                                "example_id": "f9c56ef3-0a31-4689-b77f-086157ff0593",
                                "sense_id": "b3396fa9-7c3f-3121-8985-898961209408",
                                "text": "Ze draaide de deksel van het potje en pakte er een crèmekleurige capsule uit."
                            },
