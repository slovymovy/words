                        "form": "ко́рпусна"
                    },
                    {
                        "form_id": "e503069d-b5fb-4f50-ab1f-0b3990cf9d56",
                        "entry_id": "db5d1cab-83be-3ef0-9caf-44c27c90dd5e",
                        "tags": [
                            "plural",
