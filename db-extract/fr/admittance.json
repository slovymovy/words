                    {
                        "sense_id": "827ce36b-50f5-3070-847b-b0ef08fcd791",
                        "entry_id": "f06393aa-942c-367a-b6c8-443a3e9bec10",
                        "glosses": [
                            "Inverse de l’impédance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "114221bd-2782-4e89-8b80-fc1b7b0447fa",
                                "sense_id": "827ce36b-50f5-3070-847b-b0ef08fcd791",
                                "text": "L’impédance étant une résistance complexe, et la conductance G étant l'inverse de la résistance, l’admittance est une conductance complexe."
                            },
                            {
                                "example_id": "a422c428-8da2-46f0-b713-8f88ddf84756",
                                "sense_id": "827ce36b-50f5-3070-847b-b0ef08fcd791",
                                "text": "Montrons que dans le plan complexe l’admittance globale est un cercle et déterminons la position de son centre et son rayon."
                            },
                            {
                                "example_id": "27a87cb9-e643-4bcc-bfe5-d68639a6246f",
                                "sense_id": "827ce36b-50f5-3070-847b-b0ef08fcd791",
                                "text": "Dans le schéma ci-contre, les Z désignent des impédances et les Y, des admittances. Nous avons une impédance Z₁ en série avec deux admittances, Y₁ et Y′, en parallèles."
                            }
                        ]
                    }
