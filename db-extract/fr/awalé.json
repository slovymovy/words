                        "glosses": [
                            "Jeux de stratégie, originaire d’Afrique de l’Ouest, dans lesquels on distribue des cailloux, graines ou coquillages dans des coupelles ou des trous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab9e6bb-ff82-4cae-81c1-5994901e5157",
                                "sense_id": "ddce4c9f-ac31-38ef-bf67-44bfdfa20249",
                                "text": "Jouer à l’awalé c'est démontrer ses capacités de réflexion, éprouver sa concentration et montrer son degré de patience."
                            },
                            {
                                "example_id": "3a318895-60ec-4675-88cf-912ce3583f61",
                                "sense_id": "ddce4c9f-ac31-38ef-bf67-44bfdfa20249",
                                "text": "Comme les échecs, l’awalé fait appel aux mathématiques et exige une grande concentration."
                            }
                        ]
                    }
                ],
