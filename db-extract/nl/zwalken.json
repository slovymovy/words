                ],
                "senses": [
                    {
                        "sense_id": "753e7359-4c08-39c5-86fd-76ef5ba35a5f",
                        "entry_id": "70667581-7b02-3d95-b01e-6dcaeb7102e7",
                        "glosses": [
                            "op zee ronddolen, dobberen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "26187923-ab3b-4901-871c-9702519cadaf",
                                "sense_id": "753e7359-4c08-39c5-86fd-76ef5ba35a5f",
                                "text": "Gij hebt nu ook, dat gij mij slacht, wat van de wereld gezien, en mogelijk wel meer, want als men zoo maanden na malkander op zee zwalkt, zonder dat men iets anders, dan lucht en water ziet en den holsblok, waarop, men met janmaat is ingescheept, dan ziet men niet heel veel nieuws.’"
                            },
                            {
                                "example_id": "b46135f6-1178-4443-897d-5d5bb66a9d82",
                                "sense_id": "753e7359-4c08-39c5-86fd-76ef5ba35a5f",
                                "text": "' 'In een open bootje op zee zwalken,' mompelde ik."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ab76819-9849-36ae-a920-ccd6cc79d715",
                        "entry_id": "70667581-7b02-3d95-b01e-6dcaeb7102e7",
                        "glosses": [
                            "doelloos en ongecontroleerd zich voortbewegen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "29d7cb8a-8b26-4695-823e-acc4682f6ac6",
                                "sense_id": "9ab76819-9849-36ae-a920-ccd6cc79d715",
                                "text": "De dronken zwerver zwalkte over de weg."
                            },
                            {
                                "example_id": "66a93b08-f8cb-490d-8f35-fe5929e9d189",
                                "sense_id": "9ab76819-9849-36ae-a920-ccd6cc79d715",
                                "text": "Man, zei ik zo, ik laat de meiden voortaan dryven en zeilen; het zyn agterenden van beulen, daar niet mee is te beginnen. Het is vry wat erger! Jy zwalkt overal heen. Hebje niets gehoord?’"
                            }
                        ]
                    }
                ],
