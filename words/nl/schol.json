                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen riep <w>schol</w> en bracht een toost uit op het bruidspaar.",
                            "target_lang_translations": {
