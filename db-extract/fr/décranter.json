                        "entry_id": "2bb95a59-68f0-309a-9a9d-aa95c6a7dd70",
                        "glosses": [
                            "Déplacer d’un cran (ou de plusieurs)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32291ce1-008d-4075-96b7-ea000b933165",
                                "sense_id": "7e0bee0f-dbf0-35ef-be24-bfcd7a520bcd",
                                "text": "Je crois que décranter seulement d'une dent devant baisse la voiture de 3 à 4 cm, alors qu'en décrantant devant puis recrantant derrière, on arrive à ajuster au demi-centimètre près, voire moins il me semble..."
                            },
                            {
                                "example_id": "7ca7e15a-8521-410d-8ef8-a0f43815a1a3",
                                "sense_id": "7e0bee0f-dbf0-35ef-be24-bfcd7a520bcd",
                                "text": "Bonjour, je vais tenter de vous expliquer comment décranter ou recranter votre train arrière."
                            },
                            {
                                "example_id": "e7d2a922-6b5d-4e8d-be97-4603b1d94702",
                                "sense_id": "7e0bee0f-dbf0-35ef-be24-bfcd7a520bcd",
                                "text": "Comment décranter mes barres de torsion?"
                            },
                            {
                                "example_id": "ee7bd14b-866d-4616-8b8d-6297247a0cb6",
                                "sense_id": "7e0bee0f-dbf0-35ef-be24-bfcd7a520bcd",
                                "text": "J'ai lu sur pas mal de forums qu'en décrantant le débimètre on pouvait tromper le calculateur et donc augmenter le débit d'essence ce qui permettrait de rouler en 100% éthanol sans boitier."
                            }
                        ]
                    }
