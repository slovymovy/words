                "senses": [
                    {
                        "sense_id": "e9e477c6-c476-32dc-a06f-5739b34637e5",
                        "entry_id": "94164539-271b-36e4-b030-bfe2c8dc4c59",
                        "glosses": [
                            "plastic folie die er voor zorgt dat eten niet uitdroogt en dus vers blijft"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "60d24960-0fa3-4e74-8685-32f25212bb1d",
                                "sense_id": "e9e477c6-c476-32dc-a06f-5739b34637e5",
                                "text": "De alligator - een krokodilachtig reptiel - was helemaal in vershoudfolie gewikkeld, alleen zijn neusgaten waren vrijgelaten. Daardoor kon hij zich niet meer bewegen. Het dier was ongeveer een meter lang en zat in een veel te kleine koffer. De kans dat hij de vlucht had overleefd, was klein, stelt de douane."
                            },
                            {
                                "example_id": "11e26878-58a4-4301-bb90-e3637b47db74",
                                "sense_id": "e9e477c6-c476-32dc-a06f-5739b34637e5",
                                "text": "Helemaal plasticvrij zullen de verse producten niet snel worden. Vershoudfolie kan het verschil maken tussen opeten of weggooien. Zo verliest een komkommer zonder plastic huls binnen drie dagen al tien procent van zijn gewicht. En voedselverspilling is ook niet goed voor het milieu."
                            },
                            {
                                "example_id": "e151916f-3fce-4b5d-92fb-1d5b5ee531b0",
                                "sense_id": "e9e477c6-c476-32dc-a06f-5739b34637e5",
                                "text": "Een man uit Roosendaal is veroordeeld tot een werkstraf van 240 uur voor het witwassen van 120.000 euro. Het geld zat verpakt in vershoudfolie en was in de onderbroek van de man genaaid."
                            }
                        ]
                    }
