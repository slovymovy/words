                "senses": [
                    {
                        "sense_id": "db837aa6-ecb6-31a6-94b1-08ddf1b1f5bf",
                        "entry_id": "7f443be1-6a85-3cf3-b03b-d9fc1c2e0000",
                        "glosses": [
                            "Enrouler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f984bb71-e1b7-4fe6-91fe-b4fbdea95e19",
                                "sense_id": "db837aa6-ecb6-31a6-94b1-08ddf1b1f5bf",
                                "text": "S’étant aperçue de ce manège, la bonne femme ne fit semblant de rien, et, feignant de se baisser, elle ramassa subtilement le fin bout de la longue queue du personnage, l’attacha avec son brin de laine et se mit à la « vironner, vironner », sur son rouet, comme si ç’eût été un écheveau."
                            }
                        ]
                    },
                    {
                        "sense_id": "b727e289-1560-3b0a-9bd6-35363225b9e7",
                        "entry_id": "7f443be1-6a85-3cf3-b03b-d9fc1c2e0000",
                        "glosses": [
                            "Errer, se promener."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "04b5f06b-d163-4a16-8907-79db2379ee46",
                                "sense_id": "b727e289-1560-3b0a-9bd6-35363225b9e7",
                                "text": "Il fait beau et je vais vironner dans la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "34ffa914-92dd-3f35-872b-fe0852887472",
                        "entry_id": "7f443be1-6a85-3cf3-b03b-d9fc1c2e0000",
                        "glosses": [
                            "Trotter dans la tête."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "36c58d7b-151b-4c43-9b12-4b7cdff7a14d",
                                "sense_id": "34ffa914-92dd-3f35-872b-fe0852887472",
                                "text": "Cette idée folle qui me vironne dans la tête."
                            }
                        ]
                    }
