                "entry_id": "91cd22a5-df47-33de-bce8-5ff3685a300c",
                "word": "asfalt",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "14fd6eae-74cf-4227-b2ff-6a4a014ac4d1",
                        "entry_id": "91cd22a5-df47-33de-bce8-5ff3685a300c",
                        "tags": [
                            "plural"
                        ],
                        "form": "asfalten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2354960-4c72-300f-a449-4bd6c70b6472",
                        "entry_id": "91cd22a5-df47-33de-bce8-5ff3685a300c",
                        "glosses": [
                            "een mengsel van bitumen en minerale aggregaten, dat vooral als wegdek gebruikt wordt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9781f88-1738-4c4b-8367-ba4edee46951",
                                "sense_id": "f2354960-4c72-300f-a449-4bd6c70b6472",
                                "text": "De politie heeft woensdagmiddag zo'n dertig actievoerders van klimaatactiegroep Extinction Rebellion aangehouden wegens het blokkeren van de toegang tot de A12 in Den Haag. De demonstranten voerden actie door over de volle breedte van de weg op het asfalt te gaan zitten. Twee anderen ketenden zich aan een auto vast."
                            },
                            {
                                "example_id": "565bf1d7-953f-464e-a8c1-db04d78e4958",
                                "sense_id": "f2354960-4c72-300f-a449-4bd6c70b6472",
                                "text": "Na het nemen van de afslag ziet de weg naar boven er nog even mild uit, maar dan begint het asfalt al snel te welven. Er is minder dan een handvol haarspeldbochten, maar de hellingsgraden slopen de eerste reserves uit de benen."
                            },
                            {
                                "example_id": "0e06cc13-3ee2-4629-a1ee-824545ee42f5",
                                "sense_id": "f2354960-4c72-300f-a449-4bd6c70b6472",
                                "text": "De weg werd met asfalt bestraat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63ecc9bf-61d2-48c9-8c4b-0cbaefcfc2aa",
                        "source_entry_id": "91cd22a5-df47-33de-bce8-5ff3685a300c",
                        "source_sense_id": "f2354960-4c72-300f-a449-4bd6c70b6472",
                        "target_lang_word": "Asphalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asphalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                        "entry_id": "5b7e4e4b-d03e-3578-9cb9-9954e7c5d5ab",
                                        "glosses": [
                                            "eine natürliche oder technisch hergestellte Mischung aus Bitumen und Mineralstoffen, die im Straßenbau verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0a5562-53df-49c0-a7b3-6a46671b8bca",
                                                "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                                "text": "Die Straße wird mit Asphalt befestigt."
                                            },
                                            {
                                                "example_id": "292cb0fd-1e10-4aa2-a42e-aaa75e227237",
                                                "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                                "text": "Der Straßenbelag besteht aus Asphalt."
                                            },
                                            {
                                                "example_id": "c0ee4a4b-c2ba-42fd-ba49-a76c81d6689a",
                                                "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                                "text": "„Daníel erklärte mir, dass es zwei Sorten Asphalt gibt.“"
                                            },
                                            {
                                                "example_id": "5cbad36b-bf5a-4d71-8c26-7a4a06893e1e",
                                                "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                                "text": "„Auf dem Asphalt sind dunkle Blutspuren.“"
                                            },
                                            {
                                                "example_id": "99db1b47-b48b-48ab-9128-0b7f0343c3c4",
                                                "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                                "text": "„Wir hielten an, stiegen aus; die Ausflügler verteilten sich auf den wenigen Quadratmetern Asphalt und zückten die Apparate.“"
                                            },
                                            {
                                                "example_id": "a8fa1c18-0c89-4af4-899c-4850a8e729d0",
                                                "sense_id": "f9164310-baeb-39a4-876e-2d840e11fab2",
                                                "text": "„Als sie vor das Landgericht tritt, hat die Sonne sich in eine Wolkenlücke geschoben und lässt den nassen Asphalt silbrig glänzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0945e084-dd07-4811-91e5-236342192c44",
                        "source_entry_id": "91cd22a5-df47-33de-bce8-5ff3685a300c",
                        "source_sense_id": "f2354960-4c72-300f-a449-4bd6c70b6472",
                        "target_lang_word": "asphalt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphalt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "A sticky, black to brown and highly viscous liquid or semi-solid, composed almost entirely of bitumen with small mineral particles, that is present in most crude petroleums and in some natural deposits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3384066d-357a-4d53-822d-b0ea8704ec4b",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "The mining of asphalt was big business in this area in the early twentieth century."
                                            },
                                            {
                                                "example_id": "8c6190b2-5f40-4cdc-9ef6-f630d3ba8c03",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "Felltham wrote in the beginning of the 17th century of the “Bitumated walls of Babylon;” the source of its supply, the fountains of Is, on a tributary of the Euphrates, still yields asphalt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "Ellipsis of asphalt concrete, a hard ground covering used for roads and walkways."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a4fc99-d445-4f40-a3aa-9a78fea8b404",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Near-synonyms: tarmac, tarmacadam, blacktop, bitumen"
                                            },
                                            {
                                                "example_id": "26b5c27c-e741-41b1-a6de-636379769b18",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Please hose off the asphalt near the top of the driveway if the trucks get lots of mud on it."
                                            },
                                            {
                                                "example_id": "105cb154-efff-428d-b9fe-55d092027c33",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Between the grey mist of rainclouds the sun suddenly appeared to mottle the wet asphalt of Marble Arch in patches of silver and ebony."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asphalt",
                                "target_lang_code": "en",
                                "target_senses": [
