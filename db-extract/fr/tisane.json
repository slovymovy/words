        "fr-extract.jsonl": [
            {
                "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                "word": "tisane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7184b774-d1b2-4074-96dc-9198fcfdbd45",
                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                        "tags": [
                            "plural"
                        ],
                        "form": "tisanes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                        "glosses": [
                            "Boisson obtenue par infusion, macération ou décoction de plantes sèches, généralement avec des vertus médicamenteuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b348a90-9fac-4e37-b80a-ab4cc3753992",
                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                "text": "Une tasse de tisane."
                            },
                            {
                                "example_id": "73705296-f64a-40e4-b899-dd654a82fb0e",
                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                "text": "On lui fit boire quelques tasses de tisane rafraîchissante, dont la pharmacie végétale de Granite-house fournit les ingrédients."
                            },
                            {
                                "example_id": "67c6a4a4-3078-4d9e-b650-0bb9bedad389",
                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                "text": "Elle avait beau avaler des boules de gomme et des pâtes, s’ingurgiter des tisanes de mauve et des quatre-fleurs, des sirops calmants et des loochs, la toux ne s’en allait point."
                            },
                            {
                                "example_id": "5ff2aaba-a4f1-4b65-ad35-d5f96c095506",
                                "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                                "text": "La semaine suivante, Mme la directrice l’invita à venir boire chez elle une tisane anglaise qu’on appelait du thé."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7ac1a73-e300-3b77-916f-f39a8a9c9f69",
                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                        "glosses": [
                            "Paroles douçâtres, consolations lénifiantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f227ff-f2f1-48c3-b55e-3df716c4e8d3",
                                "sense_id": "d7ac1a73-e300-3b77-916f-f39a8a9c9f69",
                                "text": "Son tourment profond n’avait que faire de ces tisanes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9787068d-5fbe-39ca-9357-f64b0cb61e9f",
                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                        "glosses": [
                            "Essence, carburant."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "88b7d66d-bf75-4287-8318-0fc641c3d81b",
                                "sense_id": "9787068d-5fbe-39ca-9357-f64b0cb61e9f",
                                "text": "On a pu franchir quelque vingt mille bornes en si peu de temps avec si peu de tisane ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9bb47ec9-2ab7-3c4b-a044-fb12731105f9",
                        "entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                        "glosses": [
                            "Raclée, correction."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "795e36b8-101f-4875-9c3c-a0e7ead3f2d3",
                                "sense_id": "9bb47ec9-2ab7-3c4b-a044-fb12731105f9",
                                "text": "La première tisane sérieuse que je me suis laissé aller, c’est avec le fils Rocca, un merdeux qu’habitait au 5 de la rue, juste à côté du 3."
                            },
                            {
                                "example_id": "60f0515a-5031-43e0-b19e-07b10f354ec0",
                                "sense_id": "9bb47ec9-2ab7-3c4b-a044-fb12731105f9",
                                "text": "J’arrive juste à temps pour voir relever l’Ukrainien, cette fois pâle comme une assiette. Toly, à peine essoufflé, me raconte en concluant : « Je lui ai foutu une tisane devant ses copains, il va être vexé, ça lui apprendra. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3fd0e25-ad76-4d55-bdad-2f7c4f7b2f78",
                        "source_entry_id": "b99bb29f-85ec-383d-abc3-d9aa1a21b944",
                        "source_sense_description": "Infusion médicinale",
                        "target_lang_word": "Kräutertee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kräutertee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55c0ec87-9716-32d6-8780-f4d5e87daf71",
                                        "entry_id": "6041cb7e-5a83-360c-be93-5846be53d34c",
                                        "glosses": [
                                            "aus Pflanzenteilen zubereitetes Aufgussgetränk, in dem bestimmte Kräuter enthalten sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c481314-6948-44f0-924e-7013b87b1290",
                                                "sense_id": "55c0ec87-9716-32d6-8780-f4d5e87daf71",
                                                "text": "„Als Durstlöscher empfehlen sich Mineralwässer, ungesüßte Kräuter- und Früchtetees sowie im Verhältnis 1:1 mit Wasser verdünnte Obst- oder Gemüsesäfte.“"
                                            },
                                            {
                                                "example_id": "1ac48e2d-946f-4403-beeb-97a40e22708e",
                                                "sense_id": "55c0ec87-9716-32d6-8780-f4d5e87daf71",
                                                "text": "„Einige Male flößt Ramon ihm Sirup und Kräutertee ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c7f55ce-cf39-4f18-9569-4c362fa318d6",
