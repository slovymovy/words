{
    "word_family": [
        "ukkepuk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff843a31-ff03-30c6-9b1d-dfc73915223b",
                    "sense_definition": "Een jong en klein kind.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klein_wezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine <w>puk</w> kon al heel mooie bellen blazen met spuug.",
                            "target_lang_translations": {
                                "en": "The little <w>tot</w> could already blow very beautiful bubbles with spit."
                            }
                        },
                        {
                            "text": "Kijk die kleine <w>puk</w> daar eens vrolijk in de zandbak spelen.",
                            "target_lang_translations": {
                                "en": "Look at that little <w>tyke</w> playing happily in the sandbox over there."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleintje",
                        "ukkepuk"
                    ],
                    "common_phrases": [
                        "kleine puk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik voor kinderen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A young and small child."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tot",
                                "target_lang_sense_clarification": "a small child"
                            },
                            {
                                "target_lang_word": "little one",
                                "target_lang_sense_clarification": "affectionate term for a child"
                            },
                            {
                                "target_lang_word": "tyke",
                                "target_lang_sense_clarification": "a small, often mischievous child"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce99b255-0abe-3348-a553-93dc4a4099bf",
                    "sense_definition": "Iemand die opvallend klein van stuk is of een dier dat klein is voor zijn soort.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "klein_wezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een dappere <w>puk</w> is dat veulen dat nu al probeert te trappen.",
                            "target_lang_translations": {
                                "en": "What a brave <w>little fellow</w> that foal is, already trying to kick."
                            }
                        },
                        {
                            "text": "Vergeleken met de andere honden in de groep is hij echt een <w>puk</w>.",
                            "target_lang_translations": {
                                "en": "Compared to the other dogs in the group, he is really a <w>runt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleintje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak vertederend bedoeld"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who is remarkably small in stature or an animal that is small for its species."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "runt",
                                "target_lang_sense_clarification": "the smallest animal in a litter"
                            },
                            {
                                "target_lang_word": "shrimp",
                                "target_lang_sense_clarification": "informal, often derogatory for a small person"
                            },
                            {
                                "target_lang_word": "little fellow",
                                "target_lang_sense_clarification": "affectionate term for a small person or animal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a80d511-90f5-362a-83fc-e2690cbf4b40",
                    "sense_definition": "Een unieke cijfercode om de blokkering van een simkaart of identiteitskaart op te heffen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb drie keer de verkeerde pincode ingevoerd en nu heb ik de <w>puk</w> nodig.",
                            "target_lang_translations": {
                                "en": "I entered the wrong PIN code three times and now I need the <w>PUK</w>."
                            }
                        },
                        {
                            "text": "Je kunt de <w>puk</w> meestal vinden op de plastic houder van je simkaart.",
                            "target_lang_translations": {
                                "en": "You can usually find the <w>PUK</w> on the plastic holder of your SIM card."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puk code"
                    ],
                    "target_lang_definitions": {
                        "en": "A unique numerical code used to unblock a SIM card or identity card."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "PUK code",
                                "target_lang_sense_clarification": "Personal Unblocking Key"
                            },
                            {
                                "target_lang_word": "PUK",
                                "target_lang_sense_clarification": "acronym for Personal Unblocking Key"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6042e99-ed03-3802-a996-ebab6fe7cbb4",
                    "sense_definition": "Een informele benaming voor een mopshond.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hondenras",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze wandelde door het park met een kleine dikke <w>puk</w> aan de lijn.",
                            "target_lang_translations": {
                                "en": "She walked through the park with a small fat <w>pug</w> on a leash."
                            }
                        },
                        {
                            "text": "De rimpelige snuit van de <w>puk</w> gaf hem een zorgelijke uitdrukking.",
                            "target_lang_translations": {
                                "en": "The wrinkled snout of the <w>pug</w> gave him a worried expression."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopshond"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "minder gebruikelijk in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An informal name for a pug dog."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pug",
                                "target_lang_sense_clarification": "the dog breed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38db3499-5cf4-34fa-9f12-f174077000e5",
                    "sense_definition": "Afkorting voor een psychiatrische universiteitskliniek.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt werd voor gespecialiseerde diagnostiek doorverwezen naar de <w>PUK</w>.",
                            "target_lang_translations": {
                                "en": "The patient was referred to the <w>PUC</w> for specialized diagnostics."
                            }
                        },
                        {
                            "text": "Binnen de <w>PUK</w> wordt wetenschappelijk onderzoek gecombineerd met klinische behandeling.",
                            "target_lang_translations": {
                                "en": "Within the <w>PUC</w>, scientific research is combined with clinical treatment."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "afkorting"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Abbreviation for a psychiatric university clinic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "PUC",
                                "target_lang_sense_clarification": "Psychiatric University Clinic"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "37836087-4de8-3c3d-bb3c-7d36a80d9198",
                    "sense_definition": "De Patriottische Unie van Koerdistan, een politieke partij in Irak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politiek",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "De <w>PUK</w> en de KDP bereikten een akkoord over de komende verkiezingen.",
                            "target_lang_translations": {
                                "en": "The <w>PUK</w> and the KDP reached an agreement on the upcoming elections."
                            }
                        },
                        {
                            "text": "In Noord-Irak is de <w>PUK</w> een van de meest invloedrijke politieke bewegingen.",
                            "target_lang_translations": {
                                "en": "In Northern Iraq, the <w>PUK</w> is one of the most influential political movements."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The Patriotic Union of Kurdistan, a political party in Iraq."
                    },
                    "translations": {
