                ],
                "senses": [
                    {
                        "sense_id": "6888ad54-b524-32f8-942f-37ce852a454c",
                        "entry_id": "d5117fda-d469-3537-88b6-b169deb643d9",
                        "glosses": [
                            "iemand die op een dier rijdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbd3a716-b008-418a-9db7-cf036cb568b5",
                                "sense_id": "6888ad54-b524-32f8-942f-37ce852a454c",
                                "text": "Volgens een getuige liep de ruin met zijn berijder het omhooglopende pad langs de Tunnelweg op toen het 'uitgleed'. Het dier en zijn ruiter kwamen ten val."
                            },
                            {
                                "example_id": "ef30c179-ee77-406f-b3c1-ca1f473e916c",
                                "sense_id": "6888ad54-b524-32f8-942f-37ce852a454c",
                                "text": "De berijder die op de rug van de olifant zat kon niet voorkomen dat Ekasit zijn eigenaar vastpakte en verpletterde met zijn slurf. ,,De olifant draaide zich plotseling om en gebruikte zijn slurf om het slachtoffer te pakken, vertelt Wuthichai Muangman, de directeur van de dierentuin. ,,Toen gebruikte hij zijn slurf om hem te pletten."
                            }
                        ]
                    },
                    {
                        "sense_id": "21607ad8-fe58-3132-819e-2b84d4ea7566",
                        "entry_id": "d5117fda-d469-3537-88b6-b169deb643d9",
                        "glosses": [
                            "bestuurder van een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4a3ea1-d78c-4efb-b4bc-597004204683",
                                "sense_id": "21607ad8-fe58-3132-819e-2b84d4ea7566",
                                "text": "De bestuurder van een scooter is maandag in Enschede in het ziekenhuis beland. De berijder ging op de Hegebeekweg onderuit."
                            },
                            {
                                "example_id": "7b251109-d0f6-47f4-b80e-24ec6c75d91c",
                                "sense_id": "21607ad8-fe58-3132-819e-2b84d4ea7566",
                                "text": "De nieuwste Lamborghini Hurancán Performante is geen auto voor introverte persoonlijkheden. De vormgeving, het motorgeluid en de rijsensaties van dit 640 pk sterke monster zorgen voor veel aandacht, maar ook voor de afgifte van een hoop blij makende stofjes bij zijn berijder."
                            },
                            {
                                "example_id": "1567e70d-eed7-4478-b91b-3ed6e1488412",
                                "sense_id": "21607ad8-fe58-3132-819e-2b84d4ea7566",
                                "text": "Motorfietsen met stuwraketten bestonden tot nu toe alleen op de dragstrip om een recordtijd neer te zetten. Bosch wil deze techniek integreren in alle nieuwe motoren. Niet om snel te accelereren, maar om schade aan motor en berijder te voorkomen."
                            }
                        ]
                    }
