                        "glosses": [
                            "To revolt against."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8c8503-be03-4949-b92f-b0652f73283c",
                                "sense_id": "e95cacef-26bc-30ef-96df-7a2378ac372e",
                                "text": "A good word, well applied and highly geared, Has oft worlds friendly revolutioneered."
                            },
                            {
                                "example_id": "e8b8f050-21fa-46d9-98ea-541a8da7da84",
                                "sense_id": "e95cacef-26bc-30ef-96df-7a2378ac372e",
                                "text": "Now magots with me, have an Irrisistible, Irritating, repulsive power, and to see Two armies of those Larvas Issuing from Two opposite parts of a cheese, so much revolutionise my stomack (particularly when at sea) that, that same stomack revolutioneers again them."
                            },
                            {
                                "example_id": "bb9e9b3c-b372-4ea4-bb6f-7c101ad81315",
                                "sense_id": "e95cacef-26bc-30ef-96df-7a2378ac372e",
                                "text": "Heller here also criticises the Nation-State, which we do not need. Instead, we need to revolutioneer the institutions that create and serve equity and well-being."
                            }
                        ]
                    }
