{
    "word_family": [
        "mincer",
        "mincemeat",
        "mincingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b713b52d-040e-3069-8cab-9fb0c7d46d7f",
                    "sense_definition": "To cut food, especially meat, into very small pieces using a knife or a machine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>mince</w> the garlic finely before adding it to the hot frying pan.",
                            "target_lang_translations": {
                                "ru": "Вам следует мелко <w>порубить</w> чеснок, прежде чем добавлять его в горячую сковороду."
                            }
                        },
                        {
                            "text": "The butcher will <w>mince</w> the beef for you if you want to make burgers.",
                            "target_lang_translations": {
                                "ru": "Мясник <w>сделает фарш</w> из говядины для вас, если вы хотите приготовить бургеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "cut"
                    ],
                    "common_phrases": [
                        "mince the garlic",
                        "mince the meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измельчать пищу, особенно мясо, на очень мелкие кусочки с помощью ножа или мясорубки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рубить",
                                "target_lang_sense_clarification": "мелко резать ножом"
                            },
                            {
                                "target_lang_word": "пропускать через мясорубку",
                                "target_lang_sense_clarification": "делать фарш"
                            },
                            {
                                "target_lang_word": "крошить",
                                "target_lang_sense_clarification": "мелко измельчать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5a7c94e-f1d6-3403-88dd-8c29a584ee95",
                    "sense_definition": "To speak in an indirect or polite way to avoid offending someone, usually used in the negative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager did not <w>mince</w> words when he told the team their performance was poor.",
                            "target_lang_translations": {
                                "ru": "Менеджер не <w>выбирал выражений</w>, когда сказал команде, что их результаты плохи."
                            }
                        },
                        {
                            "text": "She is known for her honesty and she will never <w>mince</w> her words.",
                            "target_lang_translations": {
                                "ru": "Она известна своей честностью и никогда не будет <w>смягчать</w> свои слова."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not mince words",
                        "mince one's words"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить иносказательно или вежливо, чтобы не обидеть кого-либо; обычно используется в отрицании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "делать выражения менее резкими"
                            },
                            {
                                "target_lang_word": "церемониться",
                                "target_lang_sense_clarification": "выбирать выражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abaf8143-c181-3143-b214-9086ab756b4c",
                    "sense_definition": "To walk with very short, quick, and often affected or dainty steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor began to <w>mince</w> across the stage to portray a very delicate character.",
                            "target_lang_translations": {
                                "ru": "Актер начал <w>семенить</w> по сцене, чтобы изобразить очень нежного персонажа."
                            }
                        },
                        {
                            "text": "She watched the cat <w>mince</w> daintily through the wet grass to keep its paws dry.",
                            "target_lang_translations": {
                                "ru": "Она наблюдала, как кошка изящно <w>семенит</w> по мокрой траве, чтобы не намочить лапы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mince daintily",
                        "mince along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти очень короткими, быстрыми и часто неестественными или манерными шагами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семенить",
                                "target_lang_sense_clarification": "идти мелкими шажками"
                            },
                            {
                                "target_lang_word": "идти жеманной походкой",
                                "target_lang_sense_clarification": "манерно шагать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95b58f71-a0e3-398b-948c-b05c7c594c9a",
                    "sense_definition": "To make something seem less important or smaller than it actually is.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>mince</w> the severity of the accident to avoid worrying his parents.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>преуменьшить</w> серьезность аварии, чтобы не волновать родителей."
                            }
                        },
                        {
                            "text": "The politician attempted to <w>mince</w> the impact of the new tax on the poor.",
                            "target_lang_translations": {
                                "ru": "Политик попытался <w>сгладить</w> влияние нового налога на бедные слои населения."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "lessen",
                        "reduce",
                        "weaken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять что-либо менее важным или серьезным, чем оно есть на самом деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преуменьшать",
                                "target_lang_sense_clarification": "умалять значение"
                            },
                            {
                                "target_lang_word": "сглаживать",
                                "target_lang_sense_clarification": "скрывать остроту проблемы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e9f7bf7-bb07-3858-80a0-51248496ae6e",
                    "sense_definition": "Meat that has been finely chopped or ground, often used in dishes like spaghetti bolognese.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought some beef <w>mince</w> from the supermarket to make a large lasagna.",
                            "target_lang_translations": {
                                "ru": "Я купил говяжий <w>фарш</w> в супермаркете, чтобы приготовить большую лазанью."
                            }
                        },
                        {
                            "text": "The recipe requires five hundred grams of pork <w>mince</w> and some fresh herbs.",
                            "target_lang_translations": {
                                "ru": "Для рецепта требуется пятьсот граммов свиного <w>фарша</w> и немного свежей зелени."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beef mince",
                        "pork mince"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British and Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо, которое было мелко порублено или измельчено, часто используемое для таких блюд, как спагетти болоньезе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фарш",
                                "target_lang_sense_clarification": "измельченное мясо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "501e9ff9-b675-3db9-bf5b-d500d05cb4c6",
                    "sense_definition": "A sweet mixture of dried fruits and spices, traditionally used as a filling for pies at Christmas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every December, my grandmother makes her own <w>mince</w> for the holiday pies.",
                            "target_lang_translations": {
                                "ru": "Каждый декабрь моя бабушка сама готовит <w>сладкую начинку</w> для праздничных пирогов."
                            }
                        },
                        {
                            "text": "The shop sells jars of fruit <w>mince</w> that are perfect for quick baking.",
                            "target_lang_translations": {
                                "ru": "В магазине продаются банки с фруктовой <w>начинкой</w>, которые идеально подходят для быстрой выпечки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mince pie"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкая смесь из сухофруктов и специй, традиционно используемая в качестве начинки для рождественских пирогов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сладкая начинка",
                                "target_lang_sense_clarification": "смесь сухофруктов и специй"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad8b5fd-c2be-31fc-8ab4-27d88941ef75",
                    "sense_definition": "Something that is considered to be of very poor quality or complete rubbish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to watch that new show, but it was absolute <w>mince</w> from start to finish.",
                            "target_lang_translations": {
                                "ru": "Я пытался посмотреть это новое шоу, но это была полная <w>чушь</w> от начала до конца."
                            }
                        },
                        {
                            "text": "Don't listen to his advice because most of what he says is total <w>mince</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его советов, потому что большая часть того, что он говорит — полная <w>ерунда</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "total mince",
                        "absolute mince"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Mainly Scottish"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что считается очень низкого качества или полной чепухой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "ерунда, низкое качество"
                            },
                            {
                                "target_lang_word": "дрянь",
                                "target_lang_sense_clarification": "некачественная вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "528c1ae0-ac8a-35be-9d44-dd48cb8d1e7e",
                    "sense_definition": "An affected or dainty way of walking with short steps.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked with a slight <w>mince</w> that made him look very formal and stiff.",
                            "target_lang_translations": {
                                "ru": "Он шел слегка <w>семенящей походкой</w>, из-за чего выглядел очень официально и чопорно."
                            }
                        },
                        {
                            "text": "The character's exaggerated <w>mince</w> was intended to make the audience laugh.",
                            "target_lang_translations": {
                                "ru": "Утрированная <w>манерная походка</w> персонажа должна была рассмешить зрителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dignified mince"
                    ],
                    "target_lang_definitions": {
                        "ru": "Манерная или изящная походка короткими шагами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "семенящая походка",
                                "target_lang_sense_clarification": "ходьба мелкими шагами"
                            },
                            {
                                "target_lang_word": "жеманная походка",
                                "target_lang_sense_clarification": "манерный шаг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}