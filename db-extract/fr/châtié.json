                "senses": [
                    {
                        "sense_id": "c33ede20-c163-31d2-a606-ccd96f95379a",
                        "entry_id": "4a4bff7c-870e-366d-bbf9-4bedeb57caa7",
                        "glosses": [
                            "Puni."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "457cdb77-5f70-40dd-981f-86eaa14ec5f0",
                                "sense_id": "c33ede20-c163-31d2-a606-ccd96f95379a",
                                "text": "Femmes châtiées"
                            }
                        ]
                    },
                    {
                        "sense_id": "de59705e-89f2-363f-b5bf-88d435042bb9",
                        "entry_id": "4a4bff7c-870e-366d-bbf9-4bedeb57caa7",
                        "glosses": [
                            "Particulièrement pur et surveillé, en parlant de la façon de parler ou d’écrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28a1242-d8b8-48fc-b8f0-24d6caea6132",
                                "sense_id": "de59705e-89f2-363f-b5bf-88d435042bb9",
                                "text": "Parmi les sculptures mutilées et d'un style peu châtié, je ne vois rien qui offre un grand intérêt."
                            },
                            {
                                "example_id": "ab164080-1c90-4eb8-8eb4-67881450a513",
                                "sense_id": "de59705e-89f2-363f-b5bf-88d435042bb9",
                                "text": "Reste que parler n’importe comment et espérer qu’on se comprenne bien est un pari risqué. Les messages du Docteur Arruda n’auraient-ils pas été plus clairs s’ils avaient été formulés dans une langue précise, voire châtiée ?"
                            },
                            {
                                "example_id": "97c96fd9-914e-4691-9d1c-38b9134baf6d",
                                "sense_id": "de59705e-89f2-363f-b5bf-88d435042bb9",
                                "text": "Un langage châtié."
                            },
                            {
                                "example_id": "49f06def-5527-4c29-b8bf-6a6a70d2320c",
                                "sense_id": "de59705e-89f2-363f-b5bf-88d435042bb9",
                                "text": "Il avait le verbe facile, Kateb Yacine. Il s’exprimait d’une manière impeccable. Son français était châtié, je dirai même académique."
                            }
                        ]
                    }
