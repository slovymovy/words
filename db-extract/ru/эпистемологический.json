                "senses": [
                    {
                        "sense_id": "19adaf44-631d-353c-960b-f109def3f849",
                        "entry_id": "42a14c08-57b4-3411-aa50-c6a7583949a2",
                        "glosses": [
                            "филос. связанный, соотносящийся по значению с существительным эпистемология"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e8b570d-c6ae-4241-953d-5bc916cb23ab",
                        "source_entry_id": "42a14c08-57b4-3411-aa50-c6a7583949a2",
                        "source_sense_id": "19adaf44-631d-353c-960b-f109def3f849",
                        "target_lang_word": "epistemological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epistemological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                        "entry_id": "36e5e18d-b021-3b12-9302-5930ad6ca707",
                                        "glosses": [
                                            "Of or pertaining to epistemology or theory of knowledge, as a field of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2fcb25-67d8-4d8a-a093-861a8b6c6111",
                                                "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                                "text": "The epistemological position of Ritschl, in our author's exposition of it, is little more than idealistic rationalism."
                                            },
                                            {
                                                "example_id": "7376f38a-e584-4e76-9671-d2637e72f22f",
                                                "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                                "text": "In the period from Spinoza to the end of the 19th century, the reading of design into nature received such devastating attacks from naturalists to non-naturalists alike that there developed an epistemological neurosis which Von Baer aptly termed “teleophobia.”"
                                            },
                                            {
                                                "example_id": "d70f9195-ba7a-426f-9392-1099b111a427",
                                                "sense_id": "bb11b343-02fc-364f-9350-027788e6f4e1",
                                                "text": "My conclusion dovetails with Fasold's conclusion, which is based on a quite different, more epistemological kind of argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684bfcd2-bea0-3e7a-ab40-743fe1d9c06d",
                                        "entry_id": "36e5e18d-b021-3b12-9302-5930ad6ca707",
                                        "glosses": [
                                            "Synonym of epistemic (“of or relating to cognition or knowledge, its scope, or how it is acquired”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07252c01-17f2-4f7e-b2a8-23371c545c74",
                                                "sense_id": "684bfcd2-bea0-3e7a-ab40-743fe1d9c06d",
                                                "text": "The reality which thus emerges is the outcome of the epistemological process in which the mind conceptually structures a given content."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e708979-6b34-44ab-ac44-0d2d016aa9e6",
                        "source_entry_id": "42a14c08-57b4-3411-aa50-c6a7583949a2",
                        "source_sense_id": "19adaf44-631d-353c-960b-f109def3f849",
