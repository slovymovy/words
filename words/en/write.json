                            {
                                "target_lang_word": "написать",
                                "target_lang_sense_clarification": "законченное действие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pisać",
                                "target_lang_sense_clarification": "czynność tworzenia znaków"
                            },
                            {
                                "target_lang_word": "napisać",
                                "target_lang_sense_clarification": "dokonana czynność zapisu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c25bc857-332f-3567-a728-c756ee8fa3f5",
                    "sense_definition": "To be the author or creator of a text, such as a book, article, or poem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My uncle <w>writes</w> newspaper articles for a living.",
                            "target_lang_translations": {
                                "ru": "Мой дядя зарабатывает на жизнь тем, что <w>пишет</w> газетные статьи.",
                                "pl": "Mój wujek zarabia na życie, <w>pisząc</w> artykuły do gazet."
                            }
                        },
                        {
                            "text": "She <w>wrote</w> a famous novel about life in the city.",
                            "target_lang_translations": {
                                "ru": "Она <w>написала</w> известный роман о жизни в городе.",
                                "pl": "<w>Napisała</w> słynną powieść o życiu w mieście."
                            }
