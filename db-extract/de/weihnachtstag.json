                    {
                        "form_id": "85b741c7-7580-43b0-ab4c-7d093464bd52",
                        "entry_id": "aef3defd-864c-3a82-a8b9-f4492d4a1872",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weihnachtstage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7575ee6f-0c52-3990-9247-1c0cc2ef9fc9",
                        "entry_id": "aef3defd-864c-3a82-a8b9-f4492d4a1872",
                        "glosses": [
                            "einer der Tage, an denen Weihnachten gefeiert wird; der 25. oder der 26. Dezember"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5aa5f9-5675-4880-bdca-40b3f6da2e18",
                                "sense_id": "7575ee6f-0c52-3990-9247-1c0cc2ef9fc9",
                                "text": "Die Weihnachtstage verbringe ich zuhause mit meiner Familie."
                            },
                            {
                                "example_id": "036d38f5-6ef0-4c19-b2c0-30be95adad85",
                                "sense_id": "7575ee6f-0c52-3990-9247-1c0cc2ef9fc9",
                                "text": "Am zweiten Weihnachtstag fahren wir zum Skifahren."
                            },
                            {
                                "example_id": "ea082795-5682-409a-9757-5a59fb950571",
                                "sense_id": "7575ee6f-0c52-3990-9247-1c0cc2ef9fc9",
                                "text": "„Die Weihnachtstage vergingen.“"
                            },
                            {
                                "example_id": "9c2f24f1-ae75-4b3e-a211-5f3129c6068f",
                                "sense_id": "7575ee6f-0c52-3990-9247-1c0cc2ef9fc9",
                                "text": "„Niemals hatte sich im Rostowschen Hause diese Atmosphäre von Verliebtheit und Bereitschaft zur Liebe mit einer solche Stärke fühlbar gemacht wie in diesen Weihnachtstagen.“"
                            },
                            {
                                "example_id": "67b9f240-c4a5-4318-b1ca-b6116d9756c9",
                                "sense_id": "7575ee6f-0c52-3990-9247-1c0cc2ef9fc9",
                                "text": "„Ein politisches Interesse an Pakistan wurde schlagartig durch den Einmarsch sowjetischer Truppen in das Nachbarland Afghanistan in den Weihnachtstagen des Jahres 1979 geweckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
