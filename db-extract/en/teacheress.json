                                "example_id": "7d8595a6-a148-429a-9a79-af7a33fc7010",
                                "sense_id": "34987f3e-2da2-3b6c-b3db-80089311ac70",
                                "text": "The plan of the Teacheress to erect a large building for us, and to educate our daughters, pleases us exceedingly, and we send fifteen rupees to assist the Teacheress in providing for them."
                            }
                        ]
                    }
                ],
