                "senses": [
                    {
                        "sense_id": "008abb95-b876-360f-aae2-75f3537a5915",
                        "entry_id": "c2711c45-b9a8-3a03-919a-c67f21e888a3",
                        "glosses": [
                            "Abfallbehälter, Mülleimer"
                        ],
                        "tags": [
                            "überwiegend österreichisch und umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "3413c3c1-06dd-4603-8e4f-689f293037b5",
                                "sense_id": "008abb95-b876-360f-aae2-75f3537a5915",
                                "text": "Ich habe natürlich mal wieder vergessen, den Mistkübel zu leeren."
                            },
                            {
                                "example_id": "e6994997-24be-4a84-b30c-f09edc3d9ed9",
                                "sense_id": "008abb95-b876-360f-aae2-75f3537a5915",
                                "text": "Das WC ist kein Mistkübel!"
                            },
                            {
                                "example_id": "d8e64840-fb5e-4a70-a38a-441d58bc3243",
                                "sense_id": "008abb95-b876-360f-aae2-75f3537a5915",
                                "text": "„Die Klägerin sei an diesem Tag um 07:05 Uhr von einem Mitarbeiter der MA 48 mit einem fahrbaren Mistkübel »auf Höhe der Rankgasse Tür Nr 4« niedergestoßen worden und schwer verletzt am Boden liegen geblieben.“"
                            },
                            {
                                "example_id": "2cadaa71-4fee-4261-b23c-04db89a9498a",
                                "sense_id": "008abb95-b876-360f-aae2-75f3537a5915",
                                "text": "„Heb das sofort auf und schmeiß es in den Mistkübel dort!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
