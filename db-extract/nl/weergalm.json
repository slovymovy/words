                            },
                            {
                                "target_word": "echo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34c00852-f5ed-3e22-b80f-11f7af94f27d",
                                        "entry_id": "0dc0c995-c2ce-375e-b125-34276f152bc9",
                                        "glosses": [
                                            "Of a sound or sound waves: to reflect off a surface and return; to reverberate or resound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a23a45-efb9-4e3c-8f82-22d6e336b1bf",
                                                "sense_id": "34c00852-f5ed-3e22-b80f-11f7af94f27d",
                                                "text": "With each clap of thunder echoing from one high building to another the noise was terrific."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3345c943-2bff-3dd5-856f-5f011c392866",
                                        "entry_id": "0dc0c995-c2ce-375e-b125-34276f152bc9",
                                        "glosses": [
                                            "Of a rumour, opinion, etc.: to spread or reverberate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e583bec-6078-4fa9-a979-a24d3eed9ccd",
                                                "sense_id": "3345c943-2bff-3dd5-856f-5f011c392866",
                                                "text": "The sense that it takes outrageous fortune to get inoculated echoes here in the Bay Area, where pharmacies have canceled flu-shot clinics, doctors turn away pleading patients and health officials are reduced to telling panicked callers that they should practice good personal hygiene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387adfc2-aecd-3532-8edf-f050cb137199",
                                        "entry_id": "0dc0c995-c2ce-375e-b125-34276f152bc9",
                                        "glosses": [
                                            "To reflect back (a sound)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd2632f-1f29-47d3-99db-46838878f705",
                                                "sense_id": "387adfc2-aecd-3532-8edf-f050cb137199",
                                                "text": "Those peals are echoed by the Trojan throng."
                                            },
                                            {
                                                "example_id": "0b524fb0-1c66-49c1-8237-87374e63e783",
                                                "sense_id": "387adfc2-aecd-3532-8edf-f050cb137199",
                                                "text": "The wondrous sound / Is echoed on forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c4b9462-3a6b-3693-951c-396088a21b3f",
                                        "entry_id": "0dc0c995-c2ce-375e-b125-34276f152bc9",
                                        "glosses": [
                                            "To repeat (another’s speech, opinion, etc.)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4546f453-b7ff-465a-9576-92d8c2296ccb",
                                                "sense_id": "3c4b9462-3a6b-3693-951c-396088a21b3f",
                                                "text": "Sid echoed his father’s point of view."
                                            },
                                            {
                                                "example_id": "4b1ed71d-9083-4163-9dfd-b3ac17264ce8",
                                                "sense_id": "3c4b9462-3a6b-3693-951c-396088a21b3f",
                                                "text": "‘I want nothing.’\n‘Nor I,’ echoed Sydney."
                                            },
                                            {
                                                "example_id": "fb8ad43f-565e-426d-8b72-96884d277621",
                                                "sense_id": "3c4b9462-3a6b-3693-951c-396088a21b3f",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            },
                                            {
                                                "example_id": "1da56db0-a72c-48ec-8794-d104ad7a1da4",
                                                "sense_id": "3c4b9462-3a6b-3693-951c-396088a21b3f",
                                                "text": "His views were echoed by The Economist, which feared that the effects of modernisation would be no more than “chromium-plated” inefficiency caused by unimaginative railway management and adverse union reaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00681a90-b096-3039-bb58-d73838633d7f",
                                        "entry_id": "0dc0c995-c2ce-375e-b125-34276f152bc9",
                                        "glosses": [
                                            "To repeat its input as input to some other device or system."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd70482-4c82-4110-9c30-33ca5d952704",
                                                "sense_id": "00681a90-b096-3039-bb58-d73838633d7f",
                                                "text": "The device that is to echo the characters should be optioned for echoplexing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78bbd835-ab07-3e2a-aca4-cfefa2bf8b63",
                                        "entry_id": "0dc0c995-c2ce-375e-b125-34276f152bc9",
                                        "glosses": [
                                            "To give the echo signal, informing one's partner about cards one holds."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3f784c8-85fe-4026-9971-1be48ab71e55",
                        "source_entry_id": "b7d96d67-9fb9-30bf-9ba4-6b1294e31e5b",
                        "source_sense_id": "c4c017e0-6820-3ace-926c-d36eee945b66",
                        "target_lang_word": "resonance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resonance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c318e9d6-af81-3cc9-bc84-2eb03656ae72",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The quality of being resonant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4a84e5-dbf2-4224-a404-0c3117d7a439",
                                                "sense_id": "c318e9d6-af81-3cc9-bc84-2eb03656ae72",
                                                "text": "The leiter-wagons contained great, square boxes, with handles of thick rope; these were evidently empty by the ease with which the Slovaks handled them, and by their resonance as they were roughly moved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47bc80c-9515-3aca-9c82-56db7add0b37",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "A resonant sound, echo, or reverberation, such as that produced by blowing over the top of a bottle."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1a0b3b-78e7-419e-b39b-9b492540f612",
                                                "sense_id": "d47bc80c-9515-3aca-9c82-56db7add0b37",
                                                "text": "He passed on, and the lights and cries of the station dropped away, merged in a wider haze and a hollower resonance, as the train gathered itself up with a long shake and rolled out again into the darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82cda728-6706-3886-9dc2-e0fcd2d32275",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The sound produced by a hollow body part such as the chest cavity upon auscultation, especially that produced while the patient is speaking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "Something that evokes an association, or a strong emotion; something that strikes a chord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fbb46b2-1deb-4f8d-bf49-c1e58c8c31ca",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "emotional resonance"
                                            },
                                            {
                                                "example_id": "f86ef3d8-7b22-456f-b266-d29e83f536a1",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "But the film is largely redeemed by an unexpected emotional resonance befitting a Steven Spielberg production."
                                            },
                                            {
                                                "example_id": "1c21f949-3fd3-4fce-8745-e5d93be4f38f",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "The whole recognition process has a deep colonial resonance. [title]"
                                            },
                                            {
                                                "example_id": "2a3c0252-89bb-41b6-9f89-71f7ccf2d599",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "For audiences, all these shows mean a chance to revisit a story that still chimes loudly, and to see whether, as many suspect, it will have a more chilling resonance in the winter of 2022."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef2b758-db24-3260-b166-923100be0b48",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The increase in the amplitude of an oscillation of a system under the influence of a periodic force whose frequency is close to that of the system's natural frequency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d9ad822-04a6-48ba-98e4-f9879c68c23f",
                                                "sense_id": "0ef2b758-db24-3260-b166-923100be0b48",
                                                "text": "One of the most important developments beyond the original concept of magnetic resonance is so-called double resonance in which, as the name suggests, one excites one resonant transition of a system while simultaneously monitoring a different transition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11731bc2-22d5-3dce-86b0-4b1f76653d3b",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "A short-lived subatomic particle or state of atomic excitation that results from the collision of atomic particles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78c9ad0-4081-44a0-b499-99b2778b237b",
                                                "sense_id": "11731bc2-22d5-3dce-86b0-4b1f76653d3b",
                                                "text": "When experiments with the first ‘atom-smashers’ took place in the 1950s to 1960s, many short-lived heavier siblings of the proton and neutron, known as ‘resonances’, were discovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c3f5e7f-964f-3ac8-95a1-e220018808ba",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "An increase in the strength or duration of a musical tone produced by sympathetic vibration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "316be2d3-4b22-3583-a597-ba0758a4c85c",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The property of a compound that can be visualized as having two structures differing only in the distribution of electrons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18cc055d-afb0-309a-85eb-f61f5b84881f",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "An influence of the gravitational forces of one orbiting object on the orbit of another, causing periodic perturbations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f8a664-edb5-4c2d-9783-766ed9b54669",
                                                "sense_id": "18cc055d-afb0-309a-85eb-f61f5b84881f",
                                                "text": "The dedicated time Cheops spent observing the star helped astronomers iron out the mixed signals from the TESS data to determine how many planets were crossing in front of the star and the resonance of their orbits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7734d1f-48b2-3f8e-b798-fae2a708dee6",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The condition where the inductive and capacitive reactances have equal magnitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "956bf1fd-f612-3150-b7cb-e3e8cae35d45",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "A quality of human relationship with the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d693c5c-9e07-4543-a73a-d5b26344e823",
                                                "sense_id": "956bf1fd-f612-3150-b7cb-e3e8cae35d45",
                                                "text": "Resonance is a kind of relationship to the world, formed through affect and emotion, intrinsic interest, and perceived self-efficacy, in which subject and world are mutually affected and transformed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
