                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4082c1-5359-4359-988c-b9dd831077a4",
                                "sense_id": "72efe3c6-25f1-3a9b-af39-d592d6eebf83",
                                "text": "Séverine Le Prigent-Coatmellec, infirmière et pratiquante de yoga depuis vingt-cinq ans, reprend la suite des cours de hatha yoga de sa professeur, Marie-Catherine Beuzit, à la salle communale de Penzé, à partir du 12 septembre 2022."
                            }
                        ]
                    },
                    {
