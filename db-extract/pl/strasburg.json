                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strasbourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1499e85a-22f1-3776-85c8-0165440b683b",
                                        "entry_id": "d0403a3b-a2ed-30cf-91b7-12de84851cea",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département du Bas-Rhin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113a4e1d-13ad-41db-b815-9645b0604b79",
                                                "sense_id": "1499e85a-22f1-3776-85c8-0165440b683b",
                                                "text": "Nos grandes places de guerre, Strasbourg et Metz, les véritables boulevards de notre défense, n’avaient été ni armées, ni approvisionnées."
                                            },
                                            {
                                                "example_id": "e9652c26-4b6c-411c-9ffb-4cedee583a4f",
                                                "sense_id": "1499e85a-22f1-3776-85c8-0165440b683b",
                                                "text": "Les Allemands ont considérablement embelli Strasbourg et nombre d’Alsaciens préféraient l’organisation allemande au laisser-aller français."
                                            },
                                            {
                                                "example_id": "66ec552d-a367-450d-a541-56a8f6cd0a30",
                                                "sense_id": "1499e85a-22f1-3776-85c8-0165440b683b",
                                                "text": "Alsace, chère Alsace, maintes fois je te visitai au temps où Guillaume II le Terrible, de temps à autre, paradait dans les rues de Strasbourg […]"
                                            },
                                            {
                                                "example_id": "3c3eb3e3-5e67-4071-a474-23441ff7120a",
                                                "sense_id": "1499e85a-22f1-3776-85c8-0165440b683b",
                                                "text": "Depuis que j’ai résolument renoncé au charme inattendu d’un soulier rouge et noir, je plais beaucoup à Strasbourg; je suis entourée de la parfaite bonté de Bücher, cent fois meilleur qu’il ne veut se l’avouer dans ses prétentions à la dureté ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daffb3c4-1aaf-3ec4-ad6d-818962b589a8",
                                        "entry_id": "d0403a3b-a2ed-30cf-91b7-12de84851cea",
                                        "glosses": [
                                            "Ville du Canada, dans la province de Saskatchewan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56268bdf-dd97-346e-9329-f61bc39675fa",
                                        "entry_id": "d0403a3b-a2ed-30cf-91b7-12de84851cea",
                                        "glosses": [
                                            "Ancien nom de la commune d’Emir Abdelkader dans la wilaya de Jijel en Algérie."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Strasbourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ae934a-62f4-344d-aa35-dc9f0fca3481",
                                        "entry_id": "f51f2655-fb8e-3de6-b1a3-dd3161ecf4c4",
                                        "glosses": [
                                            "Saucisse de Strasbourg (par aphérèse)."
                                        ],
                                        "tags": [
                                            "Charcuterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e885bc-2518-411e-bfcb-66346abee1e0",
                                                "sense_id": "b5ae934a-62f4-344d-aa35-dc9f0fca3481",
                                                "text": "Nicolas, munificent, offrit à chacune des filles deux « Strasbourg » chaudes et molles dans un papier. Françoise n’en avait jamais mangé d’aussi bonnes. Elles craquaient et jutaient sous la dent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
