                        "entry_id": "b8e30f93-2633-3f2b-bfdd-6d190b9522e5",
                        "glosses": [
                            "To allocate (a resource) to another person or purpose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5cb3714c-8978-4de0-9b01-957f40e420cb",
                                "sense_id": "52c927ab-df2f-3ae7-9b35-1646b513d61e",
                                "text": "Near-synonym: redistribute"
                            },
                            {
                                "example_id": "a80449ef-9a87-4b8c-be1f-1089d93caa5c",
                                "sense_id": "52c927ab-df2f-3ae7-9b35-1646b513d61e",
                                "text": "I want to reallocate some of my money from stocks to bonds. (I want to sell some of my stocks and use the proceeds to buy bonds to replace them.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "a80dcf27-0525-3f14-835a-e4863e8742be",
                        "entry_id": "b8e30f93-2633-3f2b-bfdd-6d190b9522e5",
                        "glosses": [
                            "To allocate again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1f056b6e-95c5-4bde-85a4-b43c3577f8b4",
                                "sense_id": "a80dcf27-0525-3f14-835a-e4863e8742be",
                                "text": "Appending items one at a time is still a better deal than concatenation, which reallocates every time."
                            }
                        ]
                    }
