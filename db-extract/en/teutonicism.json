                        "target_lang_word": "Teutonismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teutonismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "559ba567-fe68-3f18-a78a-9477072b742d",
                                        "entry_id": "b36cf44c-a250-3a2a-b852-784238e35154",
                                        "glosses": [
                                            "etwas, das als typisch deutsch angesehen wird"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f51dadb-5856-41fb-913d-1fa82a770c31",
                                                "sense_id": "559ba567-fe68-3f18-a78a-9477072b742d",
                                                "text": "„Hatte sich ein halbes Jahrhundert lang der Rest der Welt vom Teutonismus zu emanzipieren bemüht, so setzten nun ausgerechnet die Siegermächte mit nahezu diktatorischen Methoden die Tradition der \"Webern-Nachfolge\" (wie Thomas Bernhard so treffend in \"Holzfällen\" parodiert) als neue Vormacht ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "deeb7bd0-0390-3a77-9603-c7764b3f639e",
                                        "entry_id": "b36cf44c-a250-3a2a-b852-784238e35154",
                                        "glosses": [
                                            "ein sprachlicher Ausdruck, der typisch/charakteristisch für die Varietäten des bundesdeutschen Deutsch ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a3e8a3-1f34-442b-9f4a-00413d844e1e",
                                                "sense_id": "deeb7bd0-0390-3a77-9603-c7764b3f639e",
                                                "text": "„Ein von der Trias »Austriazismus, Helvetismus, Teutonismus« abgeleitetes teutonisch bezieht sich zu deutlich auf einen germanischen Altstamm…“."
                                            },
                                            {
                                                "example_id": "323a634d-d040-4137-9f30-8d9341339588",
                                                "sense_id": "deeb7bd0-0390-3a77-9603-c7764b3f639e",
                                                "text": "„Das Verständnis für Teutonismen und Austriazismen ist in Österreich viel stärker ausgeprägt als in Deutschland, weil sich hier „die beiden deutschen Sprachen“ unter dem Einfluss der bundesdeutschen Medien stark vermischen.“"
                                            },
                                            {
                                                "example_id": "f92366e6-cf1b-4ccb-b442-9a0d6007763b",
                                                "sense_id": "deeb7bd0-0390-3a77-9603-c7764b3f639e",
                                                "text": "Ein \"Teutonismus\" ist ein Begriff, der nur im deutschländischen Standarddeutsch vorkommt, also im deutschschweizerischen und im österreichischen Standarddeutsch nicht; ein \"Germanismus\" ist ein ursprünglich deutscher Begriff, der in andern Sprachen vorkommt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
