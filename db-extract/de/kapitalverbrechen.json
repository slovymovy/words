                ],
                "senses": [
                    {
                        "sense_id": "efb271f3-1a59-326e-b924-aa9e104c8285",
                        "entry_id": "1a1606b6-a904-379d-b24b-c60793929334",
                        "glosses": [
                            "schwerwiegendes Verbrechen (wie Mord oder Ähnliches), das früher mit dem Tod bestraft wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5894668-9400-40c0-a0d6-8c55a0a08af0",
                                "sense_id": "efb271f3-1a59-326e-b924-aa9e104c8285",
                                "text": "„Kindestötung wird von allen Kapitalverbrechen am seltensten gerichtlich verfolgt und am häufigsten übersehen.“"
                            },
                            {
                                "example_id": "5ab76164-29a6-4590-8ef0-e37f6b2ed9e3",
                                "sense_id": "efb271f3-1a59-326e-b924-aa9e104c8285",
                                "text": "„Die Frage, ob ein Kapitalverbrechen dem Morddezernat oder der Politischen Abteilung gehörte, wurde im Präsidium kontrovers diskutiert.“"
                            },
                            {
                                "example_id": "a1a1e071-fe57-458e-b490-5985509e7420",
                                "sense_id": "efb271f3-1a59-326e-b924-aa9e104c8285",
                                "text": "„Letztes Jahr sind am Terrell County Court neunzehn Fälle von Kapitalverbrechen verhandelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
