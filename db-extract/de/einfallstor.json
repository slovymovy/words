                "senses": [
                    {
                        "sense_id": "f8e00fa7-fbdb-303a-9a07-423280daf20e",
                        "entry_id": "82e24108-5e1f-3133-9d51-ecbd51ac8401",
                        "glosses": [
                            "Bereich, durch den man zum Ziel vordringen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c29aa0e-e774-419d-b855-935f74a22aac",
                                "sense_id": "f8e00fa7-fbdb-303a-9a07-423280daf20e",
                                "text": "„Belgien war ja von keinem Feind als Einfallstor nach Deutschland, sondern von Deutschland als Einfallstor nach Frankreich benutzt worden.“"
                            },
                            {
                                "example_id": "0868e08c-4e7c-4bc5-9da4-5ac78139d7dc",
                                "sense_id": "f8e00fa7-fbdb-303a-9a07-423280daf20e",
                                "text": "„Die Provinz Hatay war schon immer das Einfallstor zum Nahen Osten gewesen.“"
                            },
                            {
                                "example_id": "da63c565-f9e2-48a0-b1ad-28e5cfb58085",
                                "sense_id": "f8e00fa7-fbdb-303a-9a07-423280daf20e",
                                "text": "„An den Ufern des Binnenmeers hatten die ersten deutschen Ordensritter ihre Anker geworfen; das Haff war eines der frühen Einfallstore der Kolonisatoren gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
