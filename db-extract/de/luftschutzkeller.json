                ],
                "senses": [
                    {
                        "sense_id": "302d0a03-0f03-3928-ad4b-83dd3cab2241",
                        "entry_id": "6ddda674-69d2-35b0-b0b9-a4720ec5f66c",
                        "glosses": [
                            "Keller, der Schutz gegen Luftangriffe bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "379a17f1-b77b-4302-b26a-e9034e114d12",
                                "sense_id": "302d0a03-0f03-3928-ad4b-83dd3cab2241",
                                "text": "„Den meisten ehemaligen Kriegskindern liegt es völlig fern, sich selbst als Opfer zu sehen, auch dann, wenn sie ein oder zwei Jahre lang im Luftschutzkeller gehockt haben.“"
                            },
                            {
                                "example_id": "51595d4e-6849-4293-8cec-3f3f9552e8b2",
                                "sense_id": "302d0a03-0f03-3928-ad4b-83dd3cab2241",
                                "text": "„Alicias Eltern, beide 1943 in Königsberg geboren, verbrachten ihre ersten zwei Lebensjahre überwiegend in Luftschutzkellern und auf der Flucht.“"
                            },
                            {
                                "example_id": "7d11fd92-9d3a-4f15-9886-ab1c2aa769cb",
                                "sense_id": "302d0a03-0f03-3928-ad4b-83dd3cab2241",
                                "text": "„Vom Luftschutzkeller her kannte ich ihn und von der Eisbahn.“"
                            },
                            {
                                "example_id": "1c3dbb07-b289-4853-abb3-488cdc44d6b0",
                                "sense_id": "302d0a03-0f03-3928-ad4b-83dd3cab2241",
                                "text": "„Lothars Mutter glaubt die Familie im Luftschutzkeller sicherer.“"
                            },
                            {
                                "example_id": "9e1e5365-195e-4fcd-9d3a-0324dbb3524c",
                                "sense_id": "302d0a03-0f03-3928-ad4b-83dd3cab2241",
                                "text": "„Sie hörten, daß die Wohnungstür aufgeschlossen wurde und Eitel-Fritz und Hanna Hattenroth aus dem Luftschutzkeller zurückkehrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
