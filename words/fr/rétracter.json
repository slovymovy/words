                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a catégoriquement refusé de <w>rétracter</w> ses propos devant les journalistes."
                        },
                        {
                            "text": "Après avoir parlé sous la pression, le témoin a décidé de <w>rétracter</w> sa déclaration."
                        }
                    ],
