                "senses": [
                    {
                        "sense_id": "4f8e2f65-21ff-3513-bd6c-10915fda6452",
                        "entry_id": "cfc32236-0bcd-326a-9c9e-cf8fee206ce7",
                        "glosses": [
                            "een rok met een (lange) opening aan de zijkant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ff138c-b7b0-458a-aced-77c3232cbe81",
                                "sense_id": "4f8e2f65-21ff-3513-bd6c-10915fda6452",
                                "text": "„Een langere rok wordt snel droog en degelijk”, zegt Erik Frenken, de Nederlandse ontwerper achter Avelon, een van de merken die dit voorjaar komt met splitrokken; in zijn geval een kuitlange rok met een rits in het split, die naar believen kan worden opengezet. „Zo’n split zorgt voor wat elegante sexyness.”"
                            },
                            {
                                "example_id": "2a77d10d-910f-4cb8-92a7-06572848d297",
                                "sense_id": "4f8e2f65-21ff-3513-bd6c-10915fda6452",
                                "text": "Mooie driekwart mantels, lange splitrokken, blouses en broekrokken in gauchostijl waren sterke stukken in een collectie die een ode wil zijn aan American Legends. Vrouwen als Gloria Vanderbilt, Diana Vreeland en Von Furstenberg zelf, natuurlijk."
                            },
                            {
                                "example_id": "2f3e6f5a-a80a-4b5f-bf79-76a567d980d1",
                                "sense_id": "4f8e2f65-21ff-3513-bd6c-10915fda6452",
                                "text": "Ze speelde in een dertigtal films, maar dat waren niemendallen als Queen of outer space – een bijrol als Venusbewoonster in splitrok die verliefd wordt op een aardling."
                            }
                        ]
                    }
