            {
                "entry_id": "140841ba-bda0-36e0-ad60-07fef4a27a7b",
                "word": "PDF",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "de1ccd4c-9cc4-4a73-a752-1bd801598fae",
                        "entry_id": "140841ba-bda0-36e0-ad60-07fef4a27a7b",
                        "tags": [
                            "plural"
                        ],
                        "form": "PDFs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e25386d-56be-30f3-9334-0346c0b0bb38",
                        "entry_id": "140841ba-bda0-36e0-ad60-07fef4a27a7b",
                        "glosses": [
                            "Initialism of Portable Document Format, a standard for representing electronic documents, allowing them to be transmitted and reproduced accurately with the same printed layout."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e71a55e0-ccd9-4191-9d4f-dc02bbe48eb6",
                                "sense_id": "6e25386d-56be-30f3-9334-0346c0b0bb38",
                                "text": "DjVu was developed at AT&T Research by Yan LeCun et al. in 1966. It generates files that are smaller than PDF files. […] PDF primarily encodes graphics and text as vectorized data, whereas DjVu primarily encodes them as pixmap images."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6620040-682a-3564-9fe1-0bb9e0d7a768",
                        "entry_id": "140841ba-bda0-36e0-ad60-07fef4a27a7b",
                        "glosses": [
                            "Initialism of portable document format (“document in PDF format”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5351111a-0826-435e-b3e6-f6ad919befc2",
                                "sense_id": "e6620040-682a-3564-9fe1-0bb9e0d7a768",
                                "text": "The reMarkable PDF reader is really targeted at the digital writing market, rather than the digital reading market, though most serious e-readers support pens for annotations and signatures."
                            },
                            {
                                "example_id": "b95a0aea-b1fa-4f9f-8cd8-506267196291",
                                "sense_id": "e6620040-682a-3564-9fe1-0bb9e0d7a768",
                                "text": "Teams are required to clearly highlight the relevant specification or standard (e.g., ASTM number, VOC content) directly on the PDF for each material to demonstrate compliance.\nProvide PDFs of basic technical information for materials lacking specific requirements. For example, printouts from store websites or packaging showing material properties are acceptable."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3e32c84-a4b9-3118-a80d-ce6d43788c3e",
                        "entry_id": "140841ba-bda0-36e0-ad60-07fef4a27a7b",
                        "glosses": [
                            "Alternative letter-case form of pdf (“probability density function”)."
                        ],
                        "tags": [
