                "senses": [
                    {
                        "sense_id": "865ba211-e2d1-390f-8e86-e32245982e76",
                        "entry_id": "7d335189-06a6-364f-9f87-d5afc703cfe7",
                        "glosses": [
                            "vertraglich vereinbarter oder gesetzlich angeordneter Aufschub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e611abe1-0229-43b3-abe6-f3a343a3c401",
                                "sense_id": "865ba211-e2d1-390f-8e86-e32245982e76",
                                "text": "„Gegen einen schnellen Ausstieg spricht vorerst nur eins: die Behauptung der Strombranche, Deutschland importiere seit Beginn des Moratoriums mehr Atomstrom aus Frankreich und Tschechien als zuvor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "599c6002-6214-46f6-873d-926d467e1246",
                        "source_entry_id": "7d335189-06a6-364f-9f87-d5afc703cfe7",
                        "source_sense_id": "865ba211-e2d1-390f-8e86-e32245982e76",
                        "source_sense_description": "vertraglich vereinbarter oder gesetzlich angeordneter Aufschub",
                        "target_lang_word": "moratorium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moratorium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7277171-0731-34fc-be5c-a9ba28732945",
                                        "entry_id": "ed8b767f-7d11-30f0-bf6a-f93ce62a732c",
                                        "glosses": [
                                            "An authorization to a debtor, permitting temporary suspension of payments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                        "entry_id": "ed8b767f-7d11-30f0-bf6a-f93ce62a732c",
                                        "glosses": [
                                            "A suspension of an ongoing activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8143a1b3-3f39-4568-b5a8-ff9cdb3bea40",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "Canada may put a moratorium on cloning for research."
                                            },
                                            {
                                                "example_id": "24ccb446-6732-402f-b977-157c10802199",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "It so happened that at that time the moratorium on the death penalty caused by the Supreme Court decision in the Furman case was still in effect."
                                            },
                                            {
                                                "example_id": "b4429f88-8f34-4638-a7c3-ca2682d6af17",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "If such a pause cannot be enacted quickly, governments should step in and institute a moratorium."
                                            },
                                            {
                                                "example_id": "017e3379-d0cd-40b0-b000-ecb8167c0951",
                                                "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                                                "text": "Proponents of an AI moratorium had argued that a patchwork of state and local AI laws is hindering progress in the AI industry and the ability of U.S. firms to compete with China."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "803abb93-4f15-485e-8fb6-24f6b546636d",
                        "source_entry_id": "7d335189-06a6-364f-9f87-d5afc703cfe7",
                        "source_sense_id": "865ba211-e2d1-390f-8e86-e32245982e76",
                        "source_sense_description": "vertraglich vereinbarter oder gesetzlich angeordneter Aufschub",
                        "target_lang_word": "moratoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moratoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55556ec4-ce23-3229-ad25-1e6c9ae73689",
                                        "entry_id": "8fdc108f-ee4b-3bcb-bab8-d25b64d3f673",
                                        "glosses": [
                                            "Qui formule ou qui établit un délai, dilatoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484400f5-d1bd-493c-8253-137f6f00b508",
                                                "sense_id": "55556ec4-ce23-3229-ad25-1e6c9ae73689",
                                                "text": "Sentence moratoire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moratoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb5fa87-1867-33cc-89e8-dee841ecf042",
                                        "entry_id": "6189820a-3286-34ac-a62d-99c56c2ee37a",
                                        "glosses": [
                                            "Moratorium, suspension momentanée des paiements, autorisée par un décret ou une loi dans certaines circonstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3262764b-4c79-4db0-a2ed-872a41a42139",
                                                "sense_id": "8bb5fa87-1867-33cc-89e8-dee841ecf042",
                                                "text": "Après examen de recevabilité et analyse du passif et de l'actif de votre dossier, la commission de surendettement peut proposer un moratoire de vos dettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d36f1f4-ed2d-39df-9a86-73c86ac63f89",
                                        "entry_id": "6189820a-3286-34ac-a62d-99c56c2ee37a",
                                        "glosses": [
                                            "Délai qu’on se donne a priori avant d’appliquer, de modifier, une décision ; suspension jusqu’à nouvel ordre durant ce délai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88164320-c82c-4fb0-b54d-27c216060a0c",
                                                "sense_id": "1d36f1f4-ed2d-39df-9a86-73c86ac63f89",
                                                "text": "Au nom du principe de précaution, le conseil municipal du 22 octobre a adopté un moratoire sur toute nouvelle implantation d’antennes-relais."
                                            },
                                            {
                                                "example_id": "c908a587-a185-4ee7-9bae-b39247ddf8aa",
                                                "sense_id": "1d36f1f4-ed2d-39df-9a86-73c86ac63f89",
                                                "text": "Il y a quatre ans, alors que la Haute assemblée était encore à gauche, le rapport des sénateurs Alain Anziani (PS) et Antoine Lefèvre (UMP) appelait à « régler le sort des machines à voter ». Depuis 2008, un moratoire empêche en effet de nouvelles communes de s’équiper."
                                            },
                                            {
                                                "example_id": "45de5b2f-2839-4c99-947d-0a1934d678e4",
                                                "sense_id": "1d36f1f4-ed2d-39df-9a86-73c86ac63f89",
                                                "text": "A l'été 1979, les cédétistes s'engagent dans une campagne de pétition pour un moratoire sur le nucléaire. L'initiative plaide pour un plan public en faveur des énergies nouvelles."
                                            },
                                            {
                                                "example_id": "54166ad6-0f43-4618-aaaa-a6397c62ae89",
                                                "sense_id": "1d36f1f4-ed2d-39df-9a86-73c86ac63f89",
                                                "text": "Même si des entreprises albertaines ont démontré de l'intérêt pour le potentiel pétrolier du Saint-Laurent, Québec maintient qu'il n'a aucune intention de lever son moratoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
