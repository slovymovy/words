{
    "word_family": [
        "rot",
        "rotten",
        "rotting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15910cb8-6d42-3d3f-aa26-380ec76a22d6",
                    "sense_definition": "Destroyed or damaged by decay or rot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rotted</w> wood fell apart when we touched it.",
                            "target_lang_translations": {
                                "ru": "<w>Сгнившее</w> дерево рассыпалось, когда мы до него дотронулись."
                            }
                        },
                        {
                            "text": "We found a pile of <w>rotted</w> leaves in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы нашли в саду кучу <w>сгнивших</w> листьев."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotten"
                    ],
                    "common_phrases": [
                        "rotted wood",
                        "rotted leaves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушенный или поврежденный в результате гниения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгнивший",
                                "target_lang_sense_clarification": "о предметах, подвергшихся процессу гниения"
                            },
                            {
                                "target_lang_word": "трухлявый",
                                "target_lang_sense_clarification": "о древесине, ставшей мягкой и рассыпающейся от старости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4ef8e0-5dcc-3472-b49e-d7b85692f813",
                    "sense_definition": "Feeling deeply annoyed or irritated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt completely <w>rotted</w> by the constant noise from his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>раздражен</w> постоянным шумом от соседей."
                            }
                        },
                        {
                            "text": "She was <w>rotted</w> after waiting for hours in the rain.",
                            "target_lang_translations": {
                                "ru": "Она была <w>озлоблена</w> после того, как прождала несколько часов под дождем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to express strong irritation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокого раздражения или досады."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздраженный",
                                "target_lang_sense_clarification": "испытывающий сильное недовольство"
                            },
                            {
                                "target_lang_word": "озлобленный",
                                "target_lang_sense_clarification": "находящийся в состоянии сильного раздражения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1928cfa8-5e89-31f6-a1b0-36ceed73b9cd",
                    "sense_definition": "The simple past and past participle of <w>rot</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fruit had <w>rotted</w> because it was left in the sun too long.",
                            "target_lang_translations": {
                                "ru": "Фрукты <w>сгнили</w>, потому что слишком долго пролежали на солнце."
                            }
                        },
                        {
                            "text": "The old fence <w>rotted</w> away during the wet winter.",
                            "target_lang_translations": {
                                "ru": "Старый забор <w>сгнил</w> за влажную зиму."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb rot."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие глагола «гнить»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгнил",
                                "target_lang_sense_clarification": "прошедшее время глагола гнить"
                            },
                            {
                                "target_lang_word": "сгнивший",
                                "target_lang_sense_clarification": "причастие, обозначающее результат процесса гниения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}