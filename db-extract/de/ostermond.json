                    }
                ],
                "translations": [
                    {
                        "translation_id": "8883d967-d8db-48f8-ab85-d4c2ccbce15f",
                        "source_entry_id": "cf98aa8f-ee57-3b18-afb7-ac6cceb9cdb4",
                        "source_sense_id": "739d5337-d2c7-3330-a241-0dc73c1b4858",
                        "source_sense_description": "der vierte Monat des Jahres",
                        "target_lang_word": "avril",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avril",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "162da2af-e1f9-3c1b-9512-d39e4ed124f7",
                                        "entry_id": "c361fe2b-a036-3c55-9e9c-9a101a60b39d",
                                        "glosses": [
                                            "Quatrième mois de l’année dans le calendrier grégorien, il est placé entre mars et mai et il dure 30 jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f246f8-4ec1-462c-8eb3-f8c222d3b381",
                                                "sense_id": "162da2af-e1f9-3c1b-9512-d39e4ed124f7",
                                                "text": "Avril, gracile fille du printemps, pucelette maigrelette, aux yeux charmants, je vois fleurir tes seins menus sur la branche d’abricotier, la branche blanche dont les bourgeons pointus, rosés, sont caressés par le soleil du frais matin, à ma fenêtre, en mon jardin."
                                            },
                                            {
                                                "example_id": "5427059a-97c6-4171-a533-922ba4cff11a",
                                                "sense_id": "162da2af-e1f9-3c1b-9512-d39e4ed124f7",
                                                "text": "Il avait pris le maquis un an plus tôt : arrêté par les gendarmes d’Alès, en avril 1943, pour ses activités politiques, il s’était évadé et avait trouvé refuge chez les francs-tireurs et partisans (FTP)."
                                            },
                                            {
                                                "example_id": "10e85417-0a0f-4d14-bac4-5d9c5a8aa6a0",
                                                "sense_id": "162da2af-e1f9-3c1b-9512-d39e4ed124f7",
                                                "text": "Dès la fin novembre, les plantations de peupliers peuvent débuter, […]. À l’exception toutefois des stations où la nappe remonte près de la surface en hiver. Dans ces parcelles, mieux vaut attendre mars, voire avril."
                                            },
                                            {
                                                "example_id": "050a0f79-4bb6-4ede-809f-7982efa4d5e3",
                                                "sense_id": "162da2af-e1f9-3c1b-9512-d39e4ed124f7",
                                                "text": "Un renardeau photographié en avril 2019."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17ee518-08fd-3d60-aed1-9a1bbcdc7e7f",
                                        "entry_id": "c361fe2b-a036-3c55-9e9c-9a101a60b39d",
                                        "glosses": [
                                            "La jeunesse de quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9d1feb-fcb0-4253-84b0-2cac05df5efa",
                                                "sense_id": "f17ee518-08fd-3d60-aed1-9a1bbcdc7e7f",
                                                "text": "Cette sorcière a été sans doute belle en son avril, car ce sont les plus jolies filles qui font les plus horribles vieilles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
