                "senses": [
                    {
                        "sense_id": "1ee3cd01-71a8-3c29-86d5-b7f7e0ab9d20",
                        "entry_id": "3fe2486e-b098-3f20-9e8d-806ae36bd3b8",
                        "glosses": [
                            "Lehranstalt mit Unterbringungsmöglichkeit; Schule mit angeschlossenem Internat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974805c0-479f-4fa0-bffc-f6ee138db8f7",
                                "sense_id": "1ee3cd01-71a8-3c29-86d5-b7f7e0ab9d20",
                                "text": "Neben wenigen staatlichen Pensionaten werden die meisten Pensionate privat betrieben und kosten viel Geld."
                            },
                            {
                                "example_id": "c320b51f-bd3b-4c67-8e6b-14f084705e2c",
                                "sense_id": "1ee3cd01-71a8-3c29-86d5-b7f7e0ab9d20",
                                "text": "„Der kleine Aranda begrüßte mich mit großer Zärtlichkeit und bat mich, zum Frühstück zu ihm in sein Pensionat zu kommen; er versicherte mir, Mademoiselle Viard werde mich gern wiedersehen.“"
                            },
                            {
                                "example_id": "ad21bb17-7b35-4c17-9cf3-aa52d1f80c4f",
                                "sense_id": "1ee3cd01-71a8-3c29-86d5-b7f7e0ab9d20",
                                "text": "„Dieser Autor (er hatte eine kleine Mnemotechnik veröffentlicht) gab Literaturunterricht in einem Pensionat junger Damen, hatte orthodoxe Ansichten und trug ein seriöses Benehmen zur Schau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5daa02d5-1240-3267-9f60-4265407fee9e",
                        "entry_id": "3fe2486e-b098-3f20-9e8d-806ae36bd3b8",
                        "glosses": [
                            "(Zwangs-)Erziehungsanstalt, Strafanstalt"
                        ],
