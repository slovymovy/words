                        "glosses": [
                            "Qui peut être divulgué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cdf294a-a8fd-4a3e-bc05-279b2cdadd29",
                                "sense_id": "cb19c263-a347-375d-a626-f6e0574b9334",
                                "text": "Lorsqu’une administration refuse à un citoyen l’accès à un document, il peut se tourner vers la commission qui décidera si l’information cherchée est divulgable."
                            },
                            {
                                "example_id": "e7b33a71-ffc4-4e6c-a9f7-7f70ff0cd282",
                                "sense_id": "cb19c263-a347-375d-a626-f6e0574b9334",
                                "text": "Les assureurs ne devraient-ils pas adopter le système américain en infligeant aux automobilistes pris sur le fait un malus qui augmente leurs primes ?\n… Le casier judiciaire des automobilistes demeure strictement personnel et non divulgable."
                            },
                            {
                                "example_id": "bfca85c9-91c6-4ef1-8b6e-5e21f03c63dc",
                                "sense_id": "cb19c263-a347-375d-a626-f6e0574b9334",
                                "text": "Le contenu du projet lauréat, que le trio tricolore a conçu pendant la durée du confinement, n’est, pour l’heure, pas divulgable."
                            }
                        ]
                    }
