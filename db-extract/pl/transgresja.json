                                        "sense_id": "4eddc434-4b9a-3d23-92c6-7801e9a85828",
                                        "entry_id": "c03090ed-4b73-3c43-8883-a268c6d78fd9",
                                        "glosses": [
                                            "A violation of a law, duty or commandment."
                                        ],
                                        "tags": [
                                            "countable",
