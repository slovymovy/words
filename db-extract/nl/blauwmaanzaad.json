                "senses": [
                    {
                        "sense_id": "a6da49e8-bf07-3889-b48a-43840f861280",
                        "entry_id": "0dd1a0e3-4536-317b-89c6-6b2c3901a999",
                        "glosses": [
                            "bevruchte kiemen uit de maanbol van de slaapbol, Papaver somniferum, die vooral gebruikt wordt op brood en broodjes door voor het bakken het deeg in een bak met zaad te duwen of het zaad er overheen te strooien\\nHet bevat sporen van de actieve stoffen in opiaten maar kan redelijk veilig gegeten worden. Tests die naar het gebruik van opiaten kijken, reageren echter ook op het gegeten hebben van maanzaad."
                        ],
                        "tags": [
                            "specerij",
                            "wikidata: blauwmaanzaad"
                        ],
                        "examples": [
                            {
                                "example_id": "3548102e-12b1-41a4-8188-cdda5f6c13cc",
                                "sense_id": "a6da49e8-bf07-3889-b48a-43840f861280",
                                "text": "Het bestaan van de traditionele papaverteelt voor blauwmaanzaad in Nederland was aanleiding om via veredeling een Nederlands papaverras te kweken met een hoger alkaloïdgehalte dan tot nu toe."
                            }
                        ]
                    },
                    {
                        "sense_id": "d68d0281-d153-3c8a-a80b-da97c0592601",
                        "entry_id": "0dd1a0e3-4536-317b-89c6-6b2c3901a999",
                        "glosses": [
                            "bepaald soort plant, Papaver somniferum"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "6a2ec6fd-c370-4275-a243-8ee3bcebad58",
                                "sense_id": "d68d0281-d153-3c8a-a80b-da97c0592601",
                                "text": "Of zaai er blauwmaanzaad tussen (Papaver somniferum, 1 m) dat weliswaar kort bloeit – bleekroze met lila stippen – maar u nadien mooie papaverbollen schenkt, vol maanzaad."
                            }
                        ]
                    }
