                        "source_entry_id": "d5e1fe3f-e3b8-3567-a7b5-7a9c959a14e3",
                        "source_sense_id": "27622348-4a57-35ea-b35a-d7ac2b7efbc3",
                        "target_lang_word": "Trost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50bd0f1c-a174-33c3-90a3-6c54b872c430",
                                        "entry_id": "e56b5535-3360-3cf4-b1dc-d1b74e44ea44",
                                        "glosses": [
                                            "Handlung, Geste oder Gegebenheit, die zur Linderung von Leid beiträgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c57bb4-c706-4eb9-9a2b-761758197cf7",
                                                "sense_id": "50bd0f1c-a174-33c3-90a3-6c54b872c430",
                                                "text": "Nach den schrecklichen Dingen, die geschehen waren, kam jeder Trost zu spät."
                                            },
                                            {
                                                "example_id": "ddd0ede9-9871-4c30-98b4-301ef0122953",
                                                "sense_id": "50bd0f1c-a174-33c3-90a3-6c54b872c430",
                                                "text": "„Religion kann Trost spenden, sie kann Ruhe und Harmonie stiften.“"
                                            },
                                            {
                                                "example_id": "3c56f468-11d6-4c14-8afc-7dd0abcedeca",
                                                "sense_id": "50bd0f1c-a174-33c3-90a3-6c54b872c430",
                                                "text": "„Viele suchen Trost im Alkohol.“"
                                            },
                                            {
                                                "example_id": "a8baf40e-e7ba-4f6c-95d1-89e5a7150d06",
                                                "sense_id": "50bd0f1c-a174-33c3-90a3-6c54b872c430",
                                                "text": "„Es war sogar noch mehr, ich fand keinen Trost mehr darin.“"
                                            },
                                            {
                                                "example_id": "4835b3db-7912-408c-afa2-90b19cb82b7d",
                                                "sense_id": "50bd0f1c-a174-33c3-90a3-6c54b872c430",
                                                "text": "„Sie suchten Trost beim Pferderennen, beim Boxkampf und am Tresen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
