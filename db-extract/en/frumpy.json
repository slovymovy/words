                        "entry_id": "1b8b7c34-c1f6-3915-833c-22c617110e3c",
                        "glosses": [
                            "Dowdy, unkempt, or unfashionable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38454436-eb9a-40c4-aab7-70b8725aa398",
                                "sense_id": "f92c51b8-3390-36d9-8ee3-f625e5aa2218",
                                "text": "She came to the door in a frumpy housedress and bedroom slippers."
                            },
                            {
                                "example_id": "a5de45c8-3563-4054-8897-976374aa1bdc",
                                "sense_id": "f92c51b8-3390-36d9-8ee3-f625e5aa2218",
                                "text": "Although still young at heart and head, he looks more and more like his old friend Archimedes, increasingly bearded and increasingly grey, with an otherworldly mien – a look that should earn him a spot in the online quiz featuring portraits of frumpy old men under the rubric “Prof or Hobo?”"
                            }
                        ]
                    },
                    {
                        "sense_id": "52bea0e0-7a28-353a-bf59-fa263ed6cd17",
                        "entry_id": "1b8b7c34-c1f6-3915-833c-22c617110e3c",
                        "glosses": [
                            "Bad-tempered."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
