                            {
                                "target_lang_word": "turnbuckle",
                                "target_lang_sense_clarification": "rotating catch"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "завёртка",
                                "target_lang_sense_clarification": "механизм"
