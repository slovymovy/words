                "senses": [
                    {
                        "sense_id": "79199d01-3b6b-3fc6-9fe3-5ba85ced6967",
                        "entry_id": "5744fc2b-b3ae-3673-b6c0-13e59e5f76e9",
                        "glosses": [
                            "Donner un caractère égoïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07bb77cc-48e3-4304-8cf0-77120245ae1b",
                                "sense_id": "79199d01-3b6b-3fc6-9fe3-5ba85ced6967",
                                "text": "et par le sentiment de ne plus appartenir à une communauté de valeurs morales unificatrices, le marché économique ayant pour mode de fonctionnement d’égoïciser."
                            },
                            {
                                "example_id": "45c69d84-ea7d-4847-9882-f3901ef3ba92",
                                "sense_id": "79199d01-3b6b-3fc6-9fe3-5ba85ced6967",
                                "text": "Mais ce moi-homme primordial, ce moi concrètement incarné ou ce corps comme vivant égoïcisé est lui-même l’unité d’une constitution transcendantale et, par là, nous parvenons pourtant de façon ultime, en questionnant en retour la formation constitutive du sens d’être moi-homme, à la distinction la plus profonde : entre le moi primordial transcendantal de sa vie transcendantale fluante - constituant en cela le monde - et le non-moi, le monde, y compris le moi incarné."
                            },
                            {
                                "example_id": "986b6b13-632c-4113-83a7-d32e96bc6ce0",
                                "sense_id": "79199d01-3b6b-3fc6-9fe3-5ba85ced6967",
                                "text": "La lettre égoïcisée?"
                            }
                        ]
                    }
