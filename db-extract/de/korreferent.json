                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "cdd23636-6662-457e-8a2d-50fb02ea7ce2",
                                "sense_id": "f80bd1da-107d-32a9-b2ab-3c0ba8e4c481",
                                "text": "Zu jedem Vortrag gibt es ein Korreferat. Der Korreferent schildert das Dissertationsvorhaben noch einmal aus seiner Sicht und gibt Hinweise für das weitere Vorgehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
