                "translations": [
                    {
                        "translation_id": "a83510c7-d274-4f02-b922-ef9e0cf198b5",
                        "source_entry_id": "92e132c6-af48-35ab-85a5-f79817f1b8b8",
                        "source_sense_id": "7f2ec096-dcbb-3226-af8d-17443523c4f9",
                        "source_sense_description": "Tanz: schneller altfranzösischer Tanz in einem Dreiertakt",
                        "target_lang_word": "courante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55a3d083-06b4-3320-b57d-89dff74a7ae2",
                                        "entry_id": "99d75d75-5a4f-37e5-93b8-d066d24daa91",
                                        "glosses": [
                                            "Espèce d’ancienne danse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd61c8a0-7a3e-4124-905d-081458a9c548",
                                                "sense_id": "55a3d083-06b4-3320-b57d-89dff74a7ae2",
                                                "text": "On ne danse plus la courante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6001dfc8-58d5-3232-9b2f-e33dfa53985b",
                                        "entry_id": "99d75d75-5a4f-37e5-93b8-d066d24daa91",
                                        "glosses": [
                                            "Air sur lequel on dansait une courante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e3792e-a9e0-4017-9fc8-e0f8cb0bb16e",
                                                "sense_id": "6001dfc8-58d5-3232-9b2f-e33dfa53985b",
                                                "text": "Jouer une courante sur le violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59949bb-3613-37a4-8c55-54813e691fc1",
                                        "entry_id": "99d75d75-5a4f-37e5-93b8-d066d24daa91",
                                        "glosses": [
                                            "Diarrhée."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3800553-866c-44e6-bb78-600de9b9eb07",
                                                "sense_id": "a59949bb-3613-37a4-8c55-54813e691fc1",
                                                "text": "Avoir la courante."
                                            },
                                            {
                                                "example_id": "699ab8d1-18f7-45b9-94ec-1c8eb82ea1b8",
                                                "sense_id": "a59949bb-3613-37a4-8c55-54813e691fc1",
                                                "text": "— Laissons donc (je suis ton hôte) sur sa patte ton échassier ; mais dis-moi ce que tu penses de l’abbé de Corbigny, qui prétend avoir en bouteille du lait de la Très Sainte-Vierge ; et dis-moi que te semble aussi M. de Sermizelles, qui, un jour, ayant la courante, s’administra de l’eau bénite et de la poudre de reliques, en tisane de lavement !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98e0b494-ac7f-3046-b575-8ed54a2ece7e",
                                        "entry_id": "c0048721-8a05-36ca-bf28-1d6e9eda2f55",
                                        "glosses": [
                                            "Féminin singulier de courant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d8315e7-890f-4071-9e6e-4f52655d7744",
                                                "sense_id": "98e0b494-ac7f-3046-b575-8ed54a2ece7e",
                                                "text": "Lorsqu’un vin vient à mal tourner, la maison n’hésite pas à le débouteiller pour l’employer dans un vin de consommation courante, dont il peut servir à bonifier la qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3a7c64-bfbf-3163-bf21-bdf91a0a4fab",
                                        "entry_id": "c0048721-8a05-36ca-bf28-1d6e9eda2f55",
                                        "glosses": [
                                            "En parlant d’une rivière, voir courante en."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
