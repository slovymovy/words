    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3e21fd7-be04-34e7-b5e0-7a74fea2d825",
                    "sense_definition": "taki, którego nie ma w danym miejscu lub w danym czasie, zwłaszcza tam, gdzie być powinien",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "brak_obecności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz nauczyciel był dzisiaj <w>nieobecny</w> z powodu nagłej choroby.",
                            "target_lang_translations": {
                                "de": "Unser Lehrer war heute wegen einer plötzlichen Krankheit <w>abwesend</w>."
                            }
                        },
                        {
                            "text": "Tomasz był <w>nieobecny</w> na spotkaniu, więc nie zna ustaleń.",
                            "target_lang_translations": {
                                "de": "Tomasz war bei dem Treffen <w>abwesend</w>, daher kennt er die Vereinbarungen nicht."
                            }
                        }
                    ],
                    "antonyms": [
                        "obecny"
                    ],
                    "common_phrases": [
                        "nieobecny na lekcjach",
                        "nieobecny w pracy",
                        "nieobecny na spotkaniu"
                    ],
                    "target_lang_definitions": {
                        "de": "an einem bestimmten Ort oder zu einer bestimmten Zeit nicht anwesend, wo man eigentlich sein sollte"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abwesend",
                                "target_lang_sense_clarification": "nicht am Ort des Geschehens"
                            },
                            {
                                "target_lang_word": "fehlen",
                                "target_lang_sense_clarification": "als Prädikat: nicht da sein, fehlen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "452af656-d3e5-372c-883a-ce71fe089aff",
                    "sense_definition": "będący myślami gdzie indziej, sprawiający wrażenie zamyślonego lub nieskupionego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stan_umysłu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zauważyłem jej <w>nieobecny</w> wzrok, gdy mówiłem o planach na wakacje.",
                            "target_lang_translations": {
                                "de": "Ich bemerkte ihren <w>abwesenden</w> Blick, als ich über die Urlaubspläne sprach."
                            }
                        },
                        {
                            "text": "Od rana jesteś zupełnie <w>nieobecny</w> i o czymś intensywnie myślisz.",
                            "target_lang_translations": {
                                "de": "Seit dem Morgen bist du völlig <w>geistesabwesend</w> und denkst intensiv über etwas nach."
                            }
                        }
                    ],
                    "synonyms": [
                        "zamyślony",
                        "zdekoncentrowany"
                    ],
                    "common_phrases": [
                        "nieobecny wzrok",
                        "nieobecne spojrzenie"
                    ],
                    "target_lang_definitions": {
                        "de": "mit den Gedanken woanders, unkonzentriert oder in Gedanken versunken wirkend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abwesend",
                                "target_lang_sense_clarification": "geistig nicht anwesend"
                            },
                            {
                                "target_lang_word": "geistesabwesend",
                                "target_lang_sense_clarification": "zerstreut, in Gedanken versunken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc25d36c-4b9d-3b26-92e5-e9ebd15b9812",
                    "sense_definition": "niewystępujący lub niemający wpływu w jakiejś dziedzinie, zjawisku bądź przestrzeni",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "brak_obecności",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten ważny temat był zupełnie <w>nieobecny</w> w publicznej debacie politycznej.",
                            "target_lang_translations": {
                                "de": "Dieses wichtige Thema war in der öffentlichen politischen Debatte überhaupt <w>nicht präsent</w>."
                            }
                        },
                        {
                            "text": "Pewne motywy kulturowe są niemal całkowicie <w>nieobecne</w> w literaturze tego okresu.",
                            "target_lang_translations": {
                                "de": "Bestimmte kulturelle Motive sind in der Literatur dieser Epoche so gut wie <w>nicht vorhanden</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "obecny"
                    ],
                    "common_phrases": [
                        "nieobecny w debacie"
                    ],
                    "target_lang_definitions": {
                        "de": "in einem bestimmten Bereich, Diskurs oder Phänomen nicht vorkommend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nicht existent",
                                "target_lang_sense_clarification": "überhaupt nicht vorkommend"
                            },
                            {
                                "target_lang_word": "nicht vorhanden",
                                "target_lang_sense_clarification": "fehlend in einem Kontext"
                            },
                            {
                                "target_lang_word": "abwesend",
                                "target_lang_sense_clarification": "gehoben oder metaphorisch: fehlend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "240dba84-14c0-348c-bf4f-5b808b309a89",
                    "sense_definition": "osoba, której nie ma w określonym miejscu lub czasie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "osoba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sekretarka sporządziła listę <w>nieobecnych</w> na dzisiejszym zebraniu pracowników.",
                            "target_lang_translations": {
                                "de": "Die Sekretärin erstellte eine Liste der <w>Abwesenden</w> bei der heutigen Betriebsversammlung."
                            }
                        },
                        {
                            "text": "Mówi się żartobliwie, że <w>nieobecni</w> nie mają racji.",
                            "target_lang_translations": {
                                "de": "Man sagt scherzhaft, dass die <w>Abwesenden</w> immer unrecht haben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nieobecni nie mają racji",
                        "lista nieobecnych"
                    ],
                    "target_lang_definitions": {
