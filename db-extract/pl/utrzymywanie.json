                        "examples": [
                            {
                                "example_id": "fb85ee8e-6a0c-4455-84cd-b770d8beffdf",
                                "sense_id": "0f653b7e-a0af-34d1-b918-202b3aafdb91",
                                "text": "„Antropolodzy mają prawo twierdzić, że przyczynili się do zachowania kulturowego dziedzictwa społeczeństw, które badali, […]. Lecz prawdą jest również, iż mieli oni swój udział, czasem tylko pośredni, w utrzymywaniu struktur władzy reprezentowanych przez system kolonialny”."
                            },
                            {
                                "example_id": "6bf338f8-78d8-4cc1-b21d-988a65fe88d3",
                                "sense_id": "0f653b7e-a0af-34d1-b918-202b3aafdb91",
                                "text": "W tym celu zwołał naradę międzyresortową, której tematem był traktat handlowy z Sowietami i zasadność utrzymywania dotychczasowego stanowiska w kwestii należności z tytułu traktatu ryskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
