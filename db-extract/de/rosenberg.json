                        ],
                        "form": "die Rosenbergs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                        "entry_id": "28b337a4-963c-3e5c-9562-1ad2716906ea",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86426c4c-9330-439e-9c04-2c0f2e5c6846",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Frau Rosenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8cd8a862-bc43-4301-8d20-063acad9f0d5",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Herr Rosenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0bbd1a96-7ada-40be-9114-fd27073c9875",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Die Rosenbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e646cf28-65ff-4233-bd83-0f7bf2a41813",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Der Rosenberg trägt nie die Schals, die die Rosenberg ihm strickt."
                            },
                            {
                                "example_id": "d668c259-9a1b-409a-a01b-3186a0e4fc87",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rosenberg kommt, geht der Herr Rosenberg.“"
                            },
                            {
                                "example_id": "0ce35f93-db8d-486b-89a1-0e167fd0bc68",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Rosenberg kommt und geht."
                            },
                            {
                                "example_id": "73fe358d-7d0f-4c59-ba7b-a0cfd5c7a805",
                                "sense_id": "a7a0f208-9c86-3528-9dc8-02bb1e082389",
                                "text": "Rosenbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
