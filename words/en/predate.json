    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "573ba52c-3c88-322e-9aea-6c03cf8915d9",
                    "sense_definition": "To exist or happen at an earlier time than something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "earlier_in_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone tools <w>predate</w> the arrival of modern humans in the region."
                        },
                        {
                            "text": "Many of these traditional customs <w>predate</w> the founding of the republic."
                        }
                    ],
                    "synonyms": [
                        "antedate",
                        "precede",
                        "preexist"
                    ],
                    "antonyms": [
                        "postdate"
                    ],
                    "common_phrases": [
                        "predate modern history",
                        "predate by centuries"
                    ]
                },
                {
                    "sense_id": "22255063-017d-3cf1-91f8-4561b458bc48",
                    "sense_definition": "To assign an earlier date than the actual one to a document, event, or check.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "earlier_in_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer advised him not to <w>predate</w> the contract before signing."
                        },
                        {
                            "text": "She chose to <w>predate</w> the check so the payment would appear on time."
                        }
                    ],
                    "synonyms": [
                        "antedate",
                        "backdate"
                    ],
                    "antonyms": [
                        "postdate"
                    ],
                    "common_phrases": [
                        "predate a document",
                        "predate a check"
                    ]
                },
                {
                    "sense_id": "31ff91fc-4c43-35ab-9ad8-2cab1fbd4fb4",
                    "sense_definition": "To hunt, catch, and feed on other animals as a predator.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wolves often <w>predate</w> on deer and other small mammals in the winter."
                        },
                        {
                            "text": "Invasive fish species rapidly <w>predate</w> native amphibians in local rivers."
                        }
                    ],
                    "common_phrases": [
                        "predate on other animals"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6925665c-c0a8-3b04-a319-ea99b0d2b59a",
                    "sense_definition": "A periodical, such as a magazine or newspaper, bearing a printed date that is later than the date on which it was published.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought the latest issue early because it was distributed as a <w>predate</w>."
                        },
                        {
                            "text": "A Sunday <w>predate</w> was already available at the newsstand by Friday evening."
                        }
                    ]
                }
            ]
        }
    ]
