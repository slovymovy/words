                    ],
                    "synonyms": [
                        "natural",
                        "pesticide-free"
                    ],
                    "antonyms": [
                        "inorganic"
                    ],
                    "common_phrases": [
                        "organic food",
                        "organic farming",
                        "organic vegetables"
