                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5e3c51f-07b8-372d-b1b8-1bc7d6a1870b",
                        "entry_id": "217752ca-7d35-33c2-9126-15aa0132e42e",
                        "glosses": [
                            "mit Rosen bepflanztes Beet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0436761-1f97-42c5-9365-12aa988773a9",
                                "sense_id": "d5e3c51f-07b8-372d-b1b8-1bc7d6a1870b",
                                "text": "„Sie hat sich im Garten des Hauses, in dem sie elf Jahre lang gedient hat, auf den Boden gekniet und sich mit einem Löffel die Erde aus dem Rosenbeet in den Mund geschaufelt.“"
                            },
                            {
                                "example_id": "4b00070d-e236-4927-ba5a-558de3a8109d",
                                "sense_id": "d5e3c51f-07b8-372d-b1b8-1bc7d6a1870b",
                                "text": "„Von hier konnte ich den größten Teil des zur See hin abfallenden Gartens sehen, die vernachlässigten Rosenbeete, die Sonnenuhr, dahinter die Stufen, die hinunterführten zum Fischteich, und den Weg, der danach im Zickzack zwischen den Bäumen bis zum hinteren Gartentor verlief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b93b6ff6-bd19-473f-989d-cee0c6e32e8a",
                        "source_entry_id": "217752ca-7d35-33c2-9126-15aa0132e42e",
                        "source_sense_id": "d5e3c51f-07b8-372d-b1b8-1bc7d6a1870b",
                        "source_sense_description": "mit Rosen bepflanztes Beet",
                        "target_lang_word": "bed of roses",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bed of roses",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "443c9b6a-3e63-3705-923f-b4221bd547e1",
                                        "entry_id": "a09fe75b-674b-3bfe-87e0-dcfb833f9609",
                                        "glosses": [
                                            "A pleasant or easy situation; an untroubled existence."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51094af-358a-4393-97ea-36fa89615626",
                                                "sense_id": "443c9b6a-3e63-3705-923f-b4221bd547e1",
                                                "text": "It's a straightforward job, but it's no bed of roses, with such long hours."
                                            },
                                            {
                                                "example_id": "7a955039-e694-4818-af33-f247d35a9a3e",
                                                "sense_id": "443c9b6a-3e63-3705-923f-b4221bd547e1",
                                                "text": "Just speak to the stars about the bed of roses which is popularly supposed to be their resting place in the rarified atmosphere of the stellar regions!"
                                            },
                                            {
                                                "example_id": "99b151be-e8d4-42d2-80de-7ab105de4a33",
                                                "sense_id": "443c9b6a-3e63-3705-923f-b4221bd547e1",
                                                "text": "I thank you all / But it's been no bed of roses / No pleasure cruise"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
