                    },
                    {
                        "translation_id": "7565e390-3f6c-478e-81ac-fc0d84133b73",
                        "source_entry_id": "f2bedc8b-6e98-30d3-bbd5-ff5df7ac02e5",
                        "source_sense_id": "446ecef1-d732-32ae-ae00-20a42f1dcafb",
                        "target_lang_word": "Plünderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plünderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                        "entry_id": "32b88e11-397b-3207-97e4-3e19c46c9a74",
                                        "glosses": [
                                            "Person, die Sachen entwendet und dabei Gewalt anwendet/große Zerstörung hinterlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf08cf5c-681d-40f7-bbc7-0c957c73043e",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "Nach dem Krieg wurden Plünderer mit dem Tode bestraft."
                                            },
                                            {
                                                "example_id": "03e18353-f856-422a-b597-e688b963e296",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Slawische und finnische Stämme leben in dieser dünn besiedelten Region; lohnende Ziele für Plünderer wie etwa Städte oder Klöster gibt es nicht.“"
                                            },
                                            {
                                                "example_id": "e59f32e6-fc8a-4e1b-810a-e0f774597556",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Auf Anmarschrouten von 500 und mehr Kilometern bewegten sich die Plünderer aus der Tiefe der Wildnis heraus, um die spanischen Vorposten und Bauerndörfer anzugreifen, in denen Großgrundbesitzer Haciendas betrieben und die Felder von Mestizen und versklavten Indios bestellen ließen.“"
                                            },
                                            {
                                                "example_id": "be35b11b-364c-4d7d-a537-fc2eda823c79",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Ich schaffe es einfach nicht, da hineinzuklettern und sie wie ein Plünderer zu durchstöbern; ich kehre um.“"
                                            },
                                            {
                                                "example_id": "1977cf66-6282-4e56-95a8-8c1832304087",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Trotz der strengen Auflagen und ein oder zwei ziemlich heftiger Beispiele für Srafen, die der Kommodore verhängte, waren die Black Jokers in jener Nacht an Land nicht die einzigen Plünderer gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14b76802-767b-4cbb-940a-4ed33afaaf12",
                        "source_entry_id": "f2bedc8b-6e98-30d3-bbd5-ff5df7ac02e5",
                        "source_sense_id": "446ecef1-d732-32ae-ae00-20a42f1dcafb",
                        "target_lang_word": "мародёр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мародёр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "136bd7a4-4866-37ef-8fcd-579c09f450cb",
                                        "entry_id": "dec86bd8-1860-3af5-8b2d-9bdb942d28ee",
                                        "glosses": [
                                            "человек, грабящий убитых и раненых на поле сражения или в районе военных действий; морально разложившийся солдат, грабящий население во время войны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98157b90-2b72-49ee-b33d-e800708a79b8",
                                                "sense_id": "136bd7a4-4866-37ef-8fcd-579c09f450cb",
                                                "text": "Мародёрство, вкравшееся в армии, усилилось так, что, думая о сохранении сколько можно спокойствия в столице и окрестностях, я нахожу нужным обратиться и к Вашему Сиятельству с тем, чтобы Вы находящимся ныне в Можайске, Верее и других местах войскам ополчения Вашего дали повеления Ваши, что естли бы мародёры от армий показались где-либо в окрестностях Москвы, то, перелавливая их, собирать при полках Ваших и, по собрании некоторого их числа, мне доносить"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a6d03cf-4394-3e1d-ae28-09bd1cdeb38d",
                                        "entry_id": "dec86bd8-1860-3af5-8b2d-9bdb942d28ee",
                                        "glosses": [
                                            "перен., разг. торговец-спекулянт, перепродающий товары по очень высокой цене"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
