                                "target_senses": [
                                    {
                                        "sense_id": "5547b48c-e379-3ef3-a753-4055388c48a5",
                                        "entry_id": "77fac40f-7ab3-3680-9760-15f18be6ef72",
                                        "glosses": [
                                            "de rode bloedkleurstof die verantwoordelijk is voor het zuurstof- en CO2 transport in het bloed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba25277-1fe2-4447-9734-f26d88e4b759",
                                                "sense_id": "5547b48c-e379-3ef3-a753-4055388c48a5",
                                                "text": "Cyanose is een blauwe verkleuring van huid en slijmvliezen door tekort aan zuurstof. Het bloed bevat te veel hemoglobine zonder zuurstof. Dat kan plaatselijk zijn of algemeen."
                                            },
                                            {
                                                "example_id": "3d8d2b3d-4046-4614-a623-ee5980917ed7",
                                                "sense_id": "5547b48c-e379-3ef3-a753-4055388c48a5",
                                                "text": "Mol (1999) beschrijft hoe verschillende soorten bloedarmoede kunnen bestaan. Door te luisteren naar klachten of door het hemoglobinegehalte van een patiënt te vergelijken met het gemiddelde van een populatie, kan een arts tot deze diagnose komen. Het gaat dan echter om diagnoses die elkaar niet precies overlappen. Een patiënt kan klachten hebben, terwijl zijn hemoglobinegehalte volgens de statistiek niet buiten de normale waarden valt en omgekeerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "939c2b85-e46d-455f-904e-bfd12aa0cc3e",
                        "source_entry_id": "ae239e20-3df9-325a-9e53-2f2e8ef1eb28",
                        "source_sense_id": "a0e1e90a-ba3a-3a83-ba85-f36b01ce29ef",
                        "target_lang_word": "Hämoglobin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämoglobin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                        "entry_id": "09b2e0b2-54a8-3ca4-b696-8a364d4b6e4f",
                                        "glosses": [
                                            "Protein, welches auf den Erythrozyten den Sauerstoff bindet"
                                        ],
                                        "tags": [
                                            "Biochemie",
                                            "Zellbiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a0ea8a-2781-4429-8878-5673b53fcb08",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "Hämoglobin ist sehr eisenhaltig."
                                            },
                                            {
                                                "example_id": "87e3056b-3c24-4fbb-a0ec-069ba46f4488",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Methämoglobin entsteht normalerweise nur in geringen Mengen im Körper und wird durch ein Enzym wieder in Hämoglobin umgewandelt.“"
                                            },
                                            {
                                                "example_id": "a51d7e87-7aae-4057-b4d8-12732b91865a",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Neben dem Sauerstofftransport zum Gewebe dienen die Hämoglobine auch dem Kohlendioxidtransport vom Gewebe zur Lunge.“"
                                            },
                                            {
                                                "example_id": "6ab66c66-db95-4b2b-a7f3-3903c4ecbfac",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Wie er dabei feststellte, sind sich die Hämoglobine von Menschen und Menschenaffen ähnlicher als eines von beiden dem Hämoglobin von Kühen oder Fröschen.“"
                                            },
                                            {
                                                "example_id": "870811a2-611b-47e8-8586-589c0c438c2f",
                                                "sense_id": "c2de79be-413f-3e59-bb20-824c7b118e15",
                                                "text": "„Immer wenn rote Blutkörperchen platzen – das Ereignis nennt sich Hämolyse – wird Hämoglobin frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e18b7c1-3437-4cc4-9131-6309cc686974",
                        "source_entry_id": "ae239e20-3df9-325a-9e53-2f2e8ef1eb28",
