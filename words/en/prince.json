{
    "word_family": [
        "princess",
        "princely",
        "principality",
        "princeling",
        "princedom"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db32be7d-12a0-3863-bf42-ea1e2915a9b8",
                    "sense_definition": "A male member of a royal family, especially the son or grandson of a king or queen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "royalty_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>prince</w> waved to the crowd from the palace balcony.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>принц</w> помахал толпе с балкона дворца.",
                                "zh": "年轻的<w>王子</w>从宫殿阳台上向人群挥手。"
                            }
                        },
                        {
                            "text": "Everyone hoped that the <w>prince</w> would one day become a wise king.",
                            "target_lang_translations": {
                                "ru": "Все надеялись, что однажды <w>принц</w> станет мудрым королем.",
                                "zh": "大家都希望这位<w>王子</w>有朝一日能成为一位贤明的国王。"
                            }
                        }
                    ],
                    "synonyms": [
                        "royal"
                    ],
                    "antonyms": [
                        "commoner"
                    ],
                    "common_phrases": [
                        "Crown Prince",
                        "Prince Charming",
                        "Prince of Wales"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член королевской семьи мужского пола, особенно сын или внук короля или королевы.",
                        "zh": "皇室成员，通常指国王或女王的儿子或孙子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принц",
                                "target_lang_sense_clarification": "член королевской семьи"
                            },
                            {
                                "target_lang_word": "царевич",
                                "target_lang_sense_clarification": "сын царя"
                            },
                            {
                                "target_lang_word": "королевич",
                                "target_lang_sense_clarification": "сын короля (устар., поэт.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "王子",
                                "target_lang_sense_clarification": "皇室男性成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83dd155-3a5e-3155-8912-1d7227e84945",
                    "sense_definition": "A male ruler or monarch of a country or state.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Machiavelli wrote a famous book about how a <w>prince</w> should maintain power.",
                            "target_lang_translations": {
                                "ru": "Макиавелли написал известную книгу о том, как <w>государь</w> должен удерживать власть.",
                                "zh": "马基雅维利写了一本关于<w>君主</w>应如何维持权力的名著。"
                            }
                        },
                        {
                            "text": "The <w>prince</w> governed his lands with absolute authority.",
                            "target_lang_translations": {
                                "ru": "<w>Князь</w> правил своими землями, обладая абсолютной властью.",
                                "zh": "这位<w>统治者</w>以绝对的权威治理着他的领地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "monarch",
                        "ruler",
                        "sovereign",
                        "king"
                    ],
                    "antonyms": [
                        "subject"
                    ],
                    "common_phrases": [
                        "merchant prince",
                        "prince of peace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правитель или монарх страны или государства мужского пола.",
                        "zh": "统治国家或地区的男性君主。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "государь",
                                "target_lang_sense_clarification": "монарх, правитель"
                            },
                            {
                                "target_lang_word": "правитель",
                                "target_lang_sense_clarification": "глава государства"
                            },
                            {
                                "target_lang_word": "князь",
                                "target_lang_sense_clarification": "феодальный правитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "君主",
                                "target_lang_sense_clarification": "国家统治者"
                            },
                            {
                                "target_lang_word": "统治者",
                                "target_lang_sense_clarification": "掌权者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8cd59ce-4ddf-3f2e-864b-7c0b0731a361",
                    "sense_definition": "The male ruler or head of a principality.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ruler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prince</w> of Monaco attended the international gala.",
                            "target_lang_translations": {
                                "ru": "<w>Князь</w> Монако посетил международный гала-концерт.",
                                "zh": "摩纳哥<w>亲王</w>出席了国际晚宴。"
                            }
                        },
                        {
                            "text": "As the head of a small state, the <w>prince</w> had to navigate complex diplomatic relations.",
                            "target_lang_translations": {
                                "ru": "Как глава небольшого государства, <w>князь</w> должен был разбираться в сложных дипломатических отношениях.",
                                "zh": "作为小国的元首，这位<w>亲王</w>必须处理复杂的外交关系。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Правитель или глава княжества мужского пола.",
                        "zh": "公国或小国的男性统治者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "князь",
                                "target_lang_sense_clarification": "правитель княжества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亲王",
                                "target_lang_sense_clarification": "公国统治者"
                            },
                            {
                                "target_lang_word": "大公",
                                "target_lang_sense_clarification": "欧洲封建领主"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ee08310-2174-3157-9093-b119747e8c93",
                    "sense_definition": "A man who is considered the best, most important, or most talented in a particular group or field.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_best",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was considered a <w>prince</w> among jazz musicians for his incredible talent.",
                            "target_lang_translations": {
                                "ru": "Его считали <w>королем</w> среди джазовых музыкантов за его невероятный талант.",
                                "zh": "他因其非凡的才华被认为是爵士乐手中的<w>佼佼者</w>。"
                            }
                        },
                        {
                            "text": "She described her late husband as a <w>prince</w> of a man, kind and generous to everyone.",
                            "target_lang_translations": {
                                "ru": "Она описывала своего покойного мужа как <w>идеал</w> мужчины, доброго и щедрого ко всем.",
                                "zh": "她形容她已故的丈夫是男人中的<w>佼佼者</w>，对每个人都很友善慷慨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "master",
                        "leader",
                        "giant"
                    ],
                    "common_phrases": [
                        "prince among men"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to praise someone highly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который считается лучшим, самым важным или талантливым в определенной группе или области.",
                        "zh": "在特定领域中被认为最杰出、最重要或最有才华的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "король",
                                "target_lang_sense_clarification": "лучший в своем деле"
                            },
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "выдающийся специалист"
                            },
                            {
                                "target_lang_word": "идеал",
                                "target_lang_sense_clarification": "совершенный образец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佼佼者",
                                "target_lang_sense_clarification": "出类拔萃的人"
                            },
                            {
                                "target_lang_word": "大师",
                                "target_lang_sense_clarification": "杰出人才"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "185a6a1f-e0c2-3794-87ac-540c8bb38145",
                    "sense_definition": "A high title of nobility used in some European countries, ranking below a king but often above a duke.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nobility_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Russian <w>prince</w> lost his estates during the revolution.",
                            "target_lang_translations": {
                                "ru": "Русский <w>князь</w> потерял свои поместья во время революции.",
                                "zh": "那位俄国<w>公爵</w>在革命期间失去了他的庄园。"
                            }
                        },
                        {
                            "text": "Although he held the title of <w>prince</w>, he had no political power in the modern republic.",
                            "target_lang_translations": {
                                "ru": "Хотя он носил титул <w>князя</w>, в современной республике у него не было политической власти.",
                                "zh": "尽管他拥有<w>亲王</w>的头衔，但在现代共和国中他并没有政治权力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nobleman",
                        "aristocrat"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "historical European contexts like France or Holy Roman Empire"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий дворянский титул в некоторых европейских странах, рангом ниже короля, но часто выше герцога.",
                        "zh": "欧洲的一种高级贵族爵位，地位低于国王，常高于公爵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "князь",
                                "target_lang_sense_clarification": "дворянский титул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公爵",
                                "target_lang_sense_clarification": "贵族爵位"
                            },
                            {
                                "target_lang_word": "亲王",
                                "target_lang_sense_clarification": "高级贵族头衔"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "88fb125b-6b0e-3b2b-ae5b-2345e4f84800",
                    "sense_definition": "A male given name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name_given",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My neighbor named his son <w>Prince</w> after the famous singer.",
                            "target_lang_translations": {
                                "ru": "Мой сосед назвал сына <w>Принс</w> в честь известного певца.",
                                "zh": "我的邻居以那位著名歌手的名字给他的儿子取名为<w>普林斯</w>。"
                            }
                        },
                        {
                            "text": "<w>Prince</w> Fielder was a well-known professional baseball player.",
                            "target_lang_translations": {
                                "ru": "<w>Принс</w> Филдер был известным профессиональным бейсболистом.",
                                "zh": "<w>普林斯</w>·菲尔德是一位著名的职业棒球运动员。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Принс",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普林斯",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5df9d5a8-f30e-395a-863f-cd182fef911d",
                    "sense_definition": "A surname derived from a nickname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Prince</w> has been teaching mathematics at the high school for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Принс</w> преподает математику в средней школе уже двадцать лет.",
                                "zh": "<w>普林斯</w>先生在这所高中教数学已经二十年了。"
                            }
                        },
                        {
                            "text": "We are looking for the records of a family named <w>Prince</w> who lived here in the 1900s.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье по фамилии <w>Принс</w>, которая жила здесь в 1900-х годах.",
                                "zh": "我们正在寻找一个在20世纪住在这里的、姓<w>普林斯</w>的家庭的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, образованная от прозвища.",
                        "zh": "源自绰号的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Принс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普林斯",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbabe040-f262-3cf2-896c-e6dd61256ce2",
                    "sense_definition": "A place name used for various small towns or locations in North America.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small township of <w>Prince</w> during their trip to Ontario.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшой поселок <w>Принс</w> во время поездки в Онтарио.",
                                "zh": "他们在安大略省旅行期间参观了名为<w>普林斯</w>的小镇。"
                            }
                        },
                        {
                            "text": "The map shows a hamlet called <w>Prince</w> located in Saskatchewan.",
                            "target_lang_translations": {
                                "ru": "На карте показана деревушка под названием <w>Принс</w>, расположенная в Саскачеване.",
                                "zh": "地图上显示在萨斯喀彻温省有一个叫<w>普林斯</w>的小村庄。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, используемое для различных небольших городов или местностей в Северной Америке.",
                        "zh": "北美一些小城镇或地点的名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Принс",
                                "target_lang_sense_clarification": "название места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普林斯",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fbf6da0-1306-390b-91f9-8592aa4b7efa",
                    "sense_definition": "To behave or act in a regal, haughty, or extravagant manner like a prince.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tends to <w>prince</w> it about the office as if he owns the company.",
                            "target_lang_translations": {
                                "ru": "Он имеет обыкновение <w>важничать</w> в офисе, как будто владеет компанией.",
                                "zh": "他总是在办公室里<w>摆架子</w>，好像公司是他开的一样。"
                            }
                        },
                        {
                            "text": "Stop <w>princing</w> around and help us with the actual work.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>строить из себя принца</w> и помоги нам с настоящей работой.",
                                "zh": "别再<w>装腔作势</w>了，快来帮我们做点实事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя по-царски, высокомерно или экстравагантно.",
                        "zh": "表现得像王子一样，傲慢或铺张浪费。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важничать",
                                "target_lang_sense_clarification": "вести себя высокомерно"
                            },
                            {
                                "target_lang_word": "строить из себя принца",
                                "target_lang_sense_clarification": "вести себя заносчиво"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摆架子",
                                "target_lang_sense_clarification": "表现傲慢"
                            },
                            {
                                "target_lang_word": "装腔作势",
                                "target_lang_sense_clarification": "行为做作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}