            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76832fc8-bd68-35fa-8915-dd92162dd1f6",
                    "sense_definition": "Of or relating to the Middle Ages, the period of European history from approximately 500 to 1500 AD.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists visited a well-preserved <w>medieval</w> castle on the hill.",
                            "target_lang_translations": {
                                "ru": "Туристы посетили хорошо сохранившийся <w>средневековый</w> замок на холме.",
                                "zh": "游客们参观了山上那座保存完好的<w>中世纪</w>城堡。",
                                "es": "Los turistas visitaron un castillo <w>medieval</w> bien conservado en la colina.",
                                "tr": "Turistler tepedeki iyi korunmuş <w>orta çağ</w> kalesini ziyaret ettiler.",
                                "de": "Die Touristen besuchten eine gut erhaltene <w>mittelalterliche</w> Burg auf dem Hügel."
                            }
                        },
                        {
                            "text": "She is studying <w>medieval</w> history at the university.",
                            "target_lang_translations": {
                                "ru": "Она изучает <w>средневековую</w> историю в университете.",
                                "zh": "她正在大学里学习<w>中世纪</w>史。",
                                "es": "Ella estudia historia <w>medieval</w> en la universidad.",
                                "tr": "Üniversitede <w>orta çağ</w> tarihi okuyor.",
                                "de": "Sie studiert <w>mittelalterliche</w> Geschichte an der Universität."
                            }
                        }
                    ],
                    "antonyms": [
                        "modern"
                    ],
                    "common_phrases": [
                        "medieval history",
                        "medieval times",
                        "medieval period",
                        "medieval architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Средним векам, периоду европейской истории примерно с 500 по 1500 год н.э.",
                        "zh": "指中世纪的，即公元500年至1500年左右的欧洲历史时期。",
                        "es": "Que pertenece o concierne a la Edad Media, el periodo de la historia europea aproximadamente entre los años 500 y 1500 d.C.",
                        "tr": "Orta Çağ ile ilgili veya Orta Çağ'a ait; Avrupa tarihinde yaklaşık 500 ile 1500 yılları arasındaki dönem.",
                        "de": "Das Mittelalter betreffend oder sich darauf beziehend, die Epoche der europäischen Geschichte von etwa 500 bis 1500 n. Chr."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средневековый",
                                "target_lang_sense_clarification": "относящийся к истории Средних веков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中世纪的",
                                "target_lang_sense_clarification": "指与中世纪历史相关的"
