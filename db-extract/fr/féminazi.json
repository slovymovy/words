                        ],
                        "examples": [
                            {
                                "example_id": "19663e59-92f6-4082-8bcc-86b17bb4f841",
                                "sense_id": "44698383-951c-36fb-badb-49cd771e555e",
                                "text": "Visiblement, c’est aussi le féminisme multiculturaliste, féminazi (sic), qui inspire Limbaugh dont les exemples corrosifs alimentent délibérément la polémique."
                            }
                        ]
                    }
                ],
