                        "translation_id": "bec49f9e-4d3b-4d97-8e64-a65571cda535",
                        "source_entry_id": "168d9ddc-1412-3f72-8a3c-865c66d24820",
                        "source_sense_description": "things made of wicker",
                        "target_lang_word": "vlechtwerk",
                        "target_lang_code": "nl",
