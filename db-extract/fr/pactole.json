                ],
                "senses": [
                    {
                        "sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                        "entry_id": "d24b233d-1e16-3077-866b-2cd76d8f0c34",
                        "glosses": [
                            "Source de grande richesse ou d’importants profits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635c8102-8994-414a-9b01-ec5081197e0c",
                                "sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                                "text": "Comme il nageait en plein dans un Pactole imaginaire, un bruit de clef tournant dans la serrure vint interrompre l’héritier présomptueux au moment le plus reluisant de son rêve doré."
                            },
                            {
                                "example_id": "b300dc0b-c314-45df-8ef6-b567bd09f6f4",
                                "sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                                "text": "Ce qu’il fera de son pactole ne m’intéresse pas le moins du monde."
                            },
                            {
                                "example_id": "cf9e8a7b-1901-484b-b3b3-bcde7941609e",
                                "sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                                "text": "À 50 000 ou 100 000 F le passage, c’est le pactole."
                            },
                            {
                                "example_id": "a3446011-f2b5-4ce6-8cf7-a28b578a77be",
                                "sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                                "text": "Un pactole inespéré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41120327-09a3-48f0-8feb-944414b9a7db",
                        "source_entry_id": "d24b233d-1e16-3077-866b-2cd76d8f0c34",
                        "source_sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                        "target_lang_word": "einträgliches Geschäft",
