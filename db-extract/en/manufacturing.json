                                        "entry_id": "61f22f39-14a4-3e58-a055-3e4a8b91a586",
                                        "glosses": [
                                            "Erstellung von Gütern, Dienstleistungen, Informationen oder Energien; neben der Beschaffung und dem Absatz die dritte betriebliche Grundfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ebe526-0086-4817-b522-836d07d316a4",
                                                "sense_id": "a472fec9-3972-3c6f-bcaa-a451f0bfdf83",
                                                "text": "Zu hohe Entlohnung im Westen hat zu Verlusten bei der Produktion geführt, wodurch heute viele Produkte in Billigländer hergestellt werden."
                                            },
                                            {
                                                "example_id": "c6175027-4d2e-4485-b65d-8e1785477bca",
                                                "sense_id": "a472fec9-3972-3c6f-bcaa-a451f0bfdf83",
                                                "text": "„Durch seine Beziehungen zu den Amerikanern gelang es dem Geschäftspartner von Christine Troll, größere Mengen von Chemikalien zu beschaffen, die für die Produktion unentbehrlich waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3955ae7-7c67-3db5-9dd6-50d623d8a617",
                                        "entry_id": "61f22f39-14a4-3e58-a055-3e4a8b91a586",
                                        "glosses": [
                                            "Abteilung einer Unternehmung, die [1] durchführt"
                                        ],
                                        "tags": [
                                            "Management"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33519920-eba8-4512-a1a4-ce008381bd41",
                                                "sense_id": "f3955ae7-7c67-3db5-9dd6-50d623d8a617",
                                                "text": "Die Produktion kommt bei den Aufträgen nicht mehr mit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7dc92e18-3410-372e-ad3a-a8f7959e2ded",
                                        "entry_id": "61f22f39-14a4-3e58-a055-3e4a8b91a586",
                                        "glosses": [
                                            "gemeinschaftliche Erstellung eines Musikstückes, Films oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5287e03-ce4c-4fc2-b100-9dd6c545690b",
                                                "sense_id": "7dc92e18-3410-372e-ad3a-a8f7959e2ded",
                                                "text": "Die Produktion dauerte länger als geplant."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a314e490-8c1a-3986-97a0-b8e0ef65fee8",
                                        "entry_id": "61f22f39-14a4-3e58-a055-3e4a8b91a586",
                                        "glosses": [
