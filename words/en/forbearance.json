{
    "word_family": [
        "forbear",
        "forbearing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e6c3065-6c26-3634-8dd7-596a7d604011",
                    "sense_definition": "Patient self-control; restraint and tolerance under provocation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "patience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher showed great <w>forbearance</w> when the students were being noisy.",
                            "target_lang_translations": {
                                "de": "Die Lehrerin zeigte große <w>Langmut</w>, als die Schüler laut waren."
                            }
                        },
                        {
                            "text": "He practiced <w>forbearance</w> despite the constant criticism from his colleagues.",
                            "target_lang_translations": {
                                "de": "Er übte <w>Nachsicht</w> trotz der ständigen Kritik seiner Kollegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "patience",
                        "restraint"
                    ],
                    "common_phrases": [
                        "show great forbearance",
                        "exercise forbearance"
                    ],
                    "target_lang_definitions": {
                        "de": "Geduldige Selbstbeherrschung; Zurückhaltung und Nachsicht gegenüber Provokationen oder Fehlverhalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Langmut",
                                "target_lang_sense_clarification": "gehobener Ausdruck für große Geduld und Duldsamkeit"
                            },
                            {
                                "target_lang_word": "Nachsicht",
                                "target_lang_sense_clarification": "verständnisvolle, milde Haltung gegenüber Fehlern"
                            },
                            {
                                "target_lang_word": "Geduld",
                                "target_lang_sense_clarification": "allgemeine Fähigkeit zum Ausharren und Ertragen"
                            },
                            {
                                "target_lang_word": "Beherrschung",
                                "target_lang_sense_clarification": "Selbstkontrolle und Zurückhaltung in schwierigen Momenten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29bb35f2-3d74-3cec-a01a-3dc8a808a7ce",
                    "sense_definition": "A refraining from the enforcement of something, such as a debt or obligation, that is due.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank granted the struggling business a period of <w>forbearance</w> on their loan payments.",
                            "target_lang_translations": {
                                "de": "Die Bank gewährte dem angeschlagenen Unternehmen eine <w>Stundung</w> der Kreditraten."
                            }
                        },
                        {
                            "text": "The landlord offered a short <w>forbearance</w> on the rent due to the tenant's emergency.",
                            "target_lang_translations": {
                                "de": "Der Vermieter bot wegen der Notlage des Mieters einen kurzen <w>Zahlungsaufschub</w> für die Miete an."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loan forbearance",
                        "grant forbearance"
                    ],
                    "target_lang_definitions": {
                        "de": "Der vorübergehende Verzicht auf die rechtliche Durchsetzung oder Einforderung einer fälligen Schuld oder Pflicht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stundung",
                                "target_lang_sense_clarification": "Hinausschieben der Fälligkeit einer Zahlung"
                            },
                            {
                                "target_lang_word": "Zahlungsaufschub",
                                "target_lang_sense_clarification": "vorübergehende Fristverlängerung für Verbindlichkeiten"
                            },
                            {
                                "target_lang_word": "Unterlassung",
                                "target_lang_sense_clarification": "das bewusste Unterlassen einer rechtlichen Durchsetzung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}