            {
                "entry_id": "9ab7b0e5-0317-3357-8602-457c1b5bb716",
                "word": "factorial",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bee337c7-97ef-4185-91b8-6ea90db41cac",
                        "entry_id": "9ab7b0e5-0317-3357-8602-457c1b5bb716",
