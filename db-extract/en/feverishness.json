                                    {
                                        "sense_id": "a5513ffd-1f32-3b39-b2a9-c917cc525197",
                                        "entry_id": "1d9f2f32-afec-3d14-9d3b-c396f19332e9",
                                        "glosses": [
                                            "État de ce qui est fébrile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac861135-c08e-41a8-ae21-f11b4e784e4e",
                                                "sense_id": "a5513ffd-1f32-3b39-b2a9-c917cc525197",
                                                "text": "Une grande fébrilité règne au château de Macbeth suite à l'assassinat du roi."
                                            },
                                            {
                                                "example_id": "7f96cfc0-655f-4a5b-bfb9-55ef539142de",
                                                "sense_id": "a5513ffd-1f32-3b39-b2a9-c917cc525197",
                                                "text": "Nous préparions la Fête-Dieu avec une ardeur et une fébrilité d'autant plus vive que chaque quartier entendait exhiber le plus beau reposoir. Quelle mobilisation !"
                                            },
                                            {
                                                "example_id": "b957535e-53ff-444c-82e1-d23eeba93682",
                                                "sense_id": "a5513ffd-1f32-3b39-b2a9-c917cc525197",
                                                "text": "Rédigé dans la fébrilité par un intellectuel ayant le goût de la théorisation, ce guide bien écrit du parfait révolutionnaire sera lu, médité et parfois même appliqué par une génération de jeunes tentés par l’engagement."
                                            }
                                        ]
                                    }
