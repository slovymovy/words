                                        "entry_id": "2d16369c-ef4a-3c09-b520-d089e8fc9138",
                                        "glosses": [
                                            "Linguistik: Beeinträchtigung der Beherrschung der Muttersprache beim Erwerb einer weiteren Sprache"
                                        ],
                                        "tags": [],
