                        "glosses": [
                            "Mittelgebirge am Oberlauf der Elbe in Deutschland und Tschechien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6acccdd7-b7d5-409e-af29-53c048e04da5",
                                "sense_id": "9aea4519-d41c-38ce-9fcd-8c0828fc95c8",
                                "text": "Das Elbsandsteingebirge ist ein beliebtes Ziel für Wanderer und Kletterer."
                            },
                            {
                                "example_id": "03372ec1-ea44-4cd7-8457-3d415e67ea43",
                                "sense_id": "9aea4519-d41c-38ce-9fcd-8c0828fc95c8",
                                "text": "Ich bin im Elbsandsteingebirge geboren."
                            },
                            {
                                "example_id": "2a03bb03-1ebf-4563-ae8e-744f9b5941cc",
                                "sense_id": "9aea4519-d41c-38ce-9fcd-8c0828fc95c8",
                                "text": "Ich habe im Elbsandsteingebirge meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "05e86583-1442-42b8-aaba-0474e97a8d15",
                                "sense_id": "9aea4519-d41c-38ce-9fcd-8c0828fc95c8",
                                "text": "In das Elbsandsteingebirge führen viele Wege."
                            },
                            {
                                "example_id": "338f44e6-803e-4c5a-8ea2-7dbbe1b7347e",
                                "sense_id": "9aea4519-d41c-38ce-9fcd-8c0828fc95c8",
                                "text": "„Das eigenartigste Glied der Elbtalzone ist zweifellos das Elbsandsteingebirge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
