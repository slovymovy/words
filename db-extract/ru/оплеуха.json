                ],
                "senses": [
                    {
                        "sense_id": "c7354035-e07f-3035-b45a-a624af2dc95f",
                        "entry_id": "9bc9115c-67a1-3963-8c7f-bed0da5f8538",
                        "glosses": [
                            "разг. удар ладонью по щеке, по голове; пощёчина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd149308-6384-4ed5-922f-990e9c31cc88",
                                "sense_id": "c7354035-e07f-3035-b45a-a624af2dc95f",
                                "text": "Геннадий мгновенно отвесил спутнице оплеуху."
                            }
                        ]
                    },
                    {
                        "sense_id": "c381f02c-d0a9-3db0-bd56-79a7233de50f",
                        "entry_id": "9bc9115c-67a1-3963-8c7f-bed0da5f8538",
                        "glosses": [
                            "перен. оскорбление, унижение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9593f14b-95f8-470e-8829-843aa69f656b",
                                "sense_id": "c381f02c-d0a9-3db0-bd56-79a7233de50f",
                                "text": "Поскольку атомный взрыв четырехдневной давности еще был свеж в памяти, купальник тут же назвали бикини и посчитали оплеухой общественной нравственности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e7147b9-aba8-4257-b352-6f3a1ffd6fd3",
                        "source_entry_id": "9bc9115c-67a1-3963-8c7f-bed0da5f8538",
                        "source_sense_description": "удар ладонью по лицу",
                        "target_lang_word": "box on the ear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f10626ab-7010-4935-9cb6-6886d896eb75",
                        "source_entry_id": "9bc9115c-67a1-3963-8c7f-bed0da5f8538",
                        "source_sense_description": "удар ладонью по лицу",
                        "target_lang_word": "Ohrfeige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrfeige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                        "entry_id": "6f013902-d317-3ba3-9439-0e8e6dfc2574",
                                        "glosses": [
                                            "ein Schlag mit der flachen Hand ins Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615d6e20-5e2a-4e0b-831c-92d092bfd22c",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "Wegen seiner schlechten Noten verabreichte sein Vater ihm eine Ohrfeige."
                                            },
                                            {
                                                "example_id": "83c9e75c-089d-4dd4-a8f4-4729a2df4fb8",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Die Züchtigung, insbesondere die Ohrfeige, war noch bis in die 1950er Jahre hinein ein legales und probates Mittel an bayerischen Schulen.“"
                                            },
                                            {
                                                "example_id": "b0a838ba-cf8a-4be6-8855-5137de7210bf",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Die Ohrfeige hätte ihre Reize entwertet, und sie prahlte doch damit, daß die Gesellschaft von deren wahrem Wert überzeugt sei.“"
                                            },
                                            {
                                                "example_id": "dbfe9f57-7828-4583-a92b-1bfdc1b50b12",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Er verpaßte mir eine solche Ohrfeige, daß mein Bademantel verrutschte und das Sektglas sich in tausend Splitter auflöste.“"
                                            },
                                            {
                                                "example_id": "f83390d2-b223-4976-b5eb-f185906cde95",
                                                "sense_id": "fca18039-49cc-37cd-8698-ab5614346275",
                                                "text": "„Wir standen mit unseren Uniformen, unseren Mordwaffen und den Ohrfeigen draußen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
