                ],
                "senses": [
                    {
                        "sense_id": "64a440f2-b039-37ef-a701-da957d05b658",
                        "entry_id": "89529843-d011-3688-a627-2092e190bebd",
                        "glosses": [
                            "Spielform, deren Spielgedanke dem Wettkampfprinzip und einer harten kämpferischen Auseinandersetzung folgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482bdf0a-470a-40f0-a0a1-d16b9f7894ee",
                                "sense_id": "64a440f2-b039-37ef-a701-da957d05b658",
                                "text": "„Auch hier gilt, wie bei den Kampfspielen, dass wir die Spiele nicht einfach im Sinne unserer Erziehungswünsche verändern und damit den Kindern ihre Spielbedürfnisse und –thematik verderben sollen.“"
                            },
                            {
                                "example_id": "815cb7fd-209a-450a-b292-b337190fd57a",
                                "sense_id": "64a440f2-b039-37ef-a701-da957d05b658",
                                "text": "„Spiel, auch Kampfspiel, muss, wenn es seinen Charakter behalten soll, gezähmt bleiben in seinem Aggressionspotenzial.“"
                            },
                            {
                                "example_id": "a8a021b9-68b1-4ca5-9cf6-cdfb865eea80",
                                "sense_id": "64a440f2-b039-37ef-a701-da957d05b658",
                                "text": "„Fußball ist ein Kampfspiel, sagte der Schalker Manager.“"
                            },
                            {
                                "example_id": "86466f3f-a698-47c7-9fcb-df5909880fc9",
                                "sense_id": "64a440f2-b039-37ef-a701-da957d05b658",
                                "text": "„Die 15356 Zuschauer im Ingolstädter Sportpark sahen ein hart geführtes Kampfspiel.“"
                            },
                            {
                                "example_id": "111f056f-6481-48e1-b34f-f8c59bd5b9b2",
                                "sense_id": "64a440f2-b039-37ef-a701-da957d05b658",
                                "text": "„Schmidt erwartet im Volksparkstadion ein Kampfspiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
