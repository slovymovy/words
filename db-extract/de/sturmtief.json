                "senses": [
                    {
                        "sense_id": "82baae55-7d48-3d52-9349-264514cc9a91",
                        "entry_id": "25c1b763-f89e-3215-a085-df3cf4ec4ada",
                        "glosses": [
                            "Tiefdruckgebiet mit hohen Windgeschwindigkeiten (Stärke 9 bis 11 auf der Beaufortskala)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd246dd-bc90-42cb-9e5b-9c37955e28af",
                                "sense_id": "82baae55-7d48-3d52-9349-264514cc9a91",
                                "text": "„Das Sturmtief zog inzwischen in Richtung Kanada weiter.“"
                            },
                            {
                                "example_id": "ddf4aa8d-d8e6-4f9e-bc89-e49fc5b21c1d",
                                "sense_id": "82baae55-7d48-3d52-9349-264514cc9a91",
                                "text": "„Ihre Mutter hatte ja recht, das Sturmtief, das gerade übers Land zog, rüttelte immer wieder kräftig am Auto, was zur Folge hatte, dass ihre Mutter noch langsamer fuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
