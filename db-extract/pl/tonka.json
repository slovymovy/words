                "senses": [
                    {
                        "sense_id": "b236132f-491e-3cad-ac54-4afec7ba2b1a",
                        "entry_id": "3af8b597-afd4-31f8-81a3-6751f8b976f3",
                        "glosses": [
                            "aromatyczne ziarno tonkowca wonnego używane jako przyprawa oraz dodatek aromatyzujący kosmetyki i tytoń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc67982-fdda-4c19-9a3a-6256ddc02e58",
                                "sense_id": "b236132f-491e-3cad-ac54-4afec7ba2b1a",
                                "text": "W USA zabroniono używania tonka, ze względu na zawartość kumaryny, która jest szkodliwa"
                            },
                            {
                                "example_id": "76c7effd-5a0b-480c-a949-0780ec2ea13e",
                                "sense_id": "b236132f-491e-3cad-ac54-4afec7ba2b1a",
                                "text": "Choć wielu z nas nie zdaje sobie z tego sprawy, fasolę tonkę często czujemy na co dzień"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b52884f-183e-477f-b874-945625f12e2f",
                        "source_entry_id": "3af8b597-afd4-31f8-81a3-6751f8b976f3",
                        "source_sense_id": "b236132f-491e-3cad-ac54-4afec7ba2b1a",
