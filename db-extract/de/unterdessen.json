                                                "example_id": "d4951f7f-28f6-424e-ae8a-b49ab5c17615",
                                                "sense_id": "3b2b9321-3141-38e0-93f4-91ae5d89a276",
                                                "text": "Lubię horrory, tymczasem moja żona woli komedie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "240bea96-851b-3a85-b04e-c47fde6f2b0a",
                                        "entry_id": "c043f753-1eca-3ee0-a690-552e8b6a7373",
                                        "glosses": [
                                            "sygnalizuje treść niezgodną z oczekiwaniami wyrażonymi w pierwszej części zdania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc30456-8159-4ca1-ae8d-aba307cf2341",
                                                "sense_id": "240bea96-851b-3a85-b04e-c47fde6f2b0a",
                                                "text": "Miałem nadzieję, że na urlopie wypocznę, tymczasem okazał się bardziej męczący od pracy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tymczasem",
