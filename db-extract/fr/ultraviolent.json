                        "sense_id": "6214d772-cbec-334f-bf73-435df55105bb",
                        "entry_id": "71dd458d-cea8-3daf-a4b9-5f5c4ee561e9",
                        "glosses": [
                            "Extrêmement violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f3be168-2214-4fc4-a8e1-bc0278cbd851",
                                "sense_id": "6214d772-cbec-334f-bf73-435df55105bb",
                                "text": "Trois jeunes adolescents ultraviolents ont agressé pour les voler vingt-cinq personnes en moins de trois jours dans différents villages de l’ouest de Montpellier (Hérault)."
                            },
                            {
                                "example_id": "c0873253-9b00-4d16-970c-9381ae412dcd",
                                "sense_id": "6214d772-cbec-334f-bf73-435df55105bb",
                                "text": "Lorsque Ilia rencontre Neige, il la sauve des griffes d’un clan ultraviolent."
                            },
                            {
                                "example_id": "7db5e0f8-aa45-4a51-b3bb-eb91cef5bfed",
                                "sense_id": "6214d772-cbec-334f-bf73-435df55105bb",
                                "text": "Passée la stupeur face à un tel coup du sort, vient le temps de l’hésitation, entre la volonté de voir le capitaine du XV de France revenir le plus vite possible et la raison qui voudrait que, après avoir subi une charge ultraviolente à la tête, on laisse le Toulousain tranquille jusqu’à la fin du Mondial, aussi douloureuse que soit cette perspective (lire l’encadré)."
                            }
                        ]
                    }
