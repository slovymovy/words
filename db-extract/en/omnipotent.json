                        "examples": [
                            {
                                "example_id": "b2b97d11-226c-4742-8c32-90d7c76bc6e3",
                                "sense_id": "03dfc7d8-4e6d-3d00-bbe6-bbbba32cb4c5",
                                "text": "All the spirits of the elements bowed down before him; but the future was still hidden from his eyes, and Death was omnipotent."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc6c9af2-63c1-3db4-a0e0-1d466be1733d",
