                        "sense_id": "d84aab98-645a-3d8b-908a-5fb1c00919aa",
                        "entry_id": "28b661eb-139c-3205-b0a9-cbe16a21e669",
                        "glosses": [
                            "The act of repelling an enemy, etc."
                        ],
                        "tags": [
