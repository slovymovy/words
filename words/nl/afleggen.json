                {
                    "sense_id": "bbb41536-487a-3da0-a4fd-b1d3e21e0ede",
                    "sense_definition": "Iets van het lichaam of de geest verwijderen, zoals kleding, uitrusting of gewoontes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij binnenkomst in de warme kamer <w>legde</w> hij zijn zware jas <w>af</w>.",
                            "target_lang_translations": {
                                "ru": "Войдя в теплую комнату, он <w>снял</w> свое тяжелое пальто.",
                                "en": "Upon entering the warm room, he <w>took off</w> his heavy coat.",
                                "fr": "En entrant dans la pièce chauffée, il a <w>enlevé</w> son manteau lourd."
                            }
                        },
                        {
                            "text": "Het kostte hem veel moeite om zijn slechte gewoontes eindelijk <w>af</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "ru": "Ему стоило больших усилий наконец <w>избавиться</w> от своих вредных привычек.",
                                "en": "It cost him a lot of effort to finally <w>shed</w> his bad habits.",
                                "fr": "Cela lui a demandé beaucoup d'efforts pour enfin <w>se défaire de</w> ses mauvaises habitudes."
                            }
                        }
                    ],
