                ],
                "senses": [
                    {
                        "sense_id": "227f2292-b0c8-3e17-ae72-d97d47e76231",
                        "entry_id": "5879e5ca-4352-337f-a8e9-beedf9c6adb0",
                        "glosses": [
                            "Tapage, vacarme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "74130ede-9b87-48a4-a7ca-e10f9b569ec9",
                                "sense_id": "227f2292-b0c8-3e17-ae72-d97d47e76231",
                                "text": "Une huée le salua. Un drôle de ramdam, une rumeur déferlante !"
                            },
                            {
                                "example_id": "fc79b359-218d-401c-ac2d-527a8a659134",
                                "sense_id": "227f2292-b0c8-3e17-ae72-d97d47e76231",
                                "text": "Vous faites pourtant un de ces ramdams, dit le flicard."
                            },
                            {
                                "example_id": "b93175d6-a730-434e-a6b8-75da9c4d75c0",
                                "sense_id": "227f2292-b0c8-3e17-ae72-d97d47e76231",
                                "text": "Au Vatican, ça fit un joli ramdam : il fallait garantir la filiation, choisir un suivant."
                            },
                            {
                                "example_id": "50747a90-6c21-4a2c-8806-6f61facafa30",
                                "sense_id": "227f2292-b0c8-3e17-ae72-d97d47e76231",
                                "text": "Les garçons rôdent longtemps à leur recherche par les rues mornes de Nogent, hurlant des cris de mort, fouillant les couloirs et les escaliers à grand ramdam de galoches, claquant les portes à la volée et faisant jaillir des fenêtres des têtes de vieilles convulsées de rage."
                            },
                            {
                                "example_id": "f344c7bc-8cca-4885-8113-55bf3f8d12ca",
                                "sense_id": "227f2292-b0c8-3e17-ae72-d97d47e76231",
                                "text": "Ça allait faire du bruit, un beau ramdam."
                            }
                        ]
                    }
                ],
