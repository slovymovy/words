            {
                "entry_id": "7e5ed830-f0c8-35c1-b4b9-67e6acbfadab",
                "word": "marching",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4aaec3c1-4820-4cd7-ab59-107870e56c62",
                        "entry_id": "7e5ed830-f0c8-35c1-b4b9-67e6acbfadab",
                        "tags": [
                            "plural"
                        ],
                        "form": "marchings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9183e3de-c9ac-3408-b310-a8efa3ed5a53",
                        "entry_id": "7e5ed830-f0c8-35c1-b4b9-67e6acbfadab",
                        "glosses": [
                            "Action described by the verb \\\"to march\\\"."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d868150-3dcc-482a-9439-32ed63e46c19",
                                "sense_id": "9183e3de-c9ac-3408-b310-a8efa3ed5a53",
                                "text": "A pianoforte is desirable, to lead the singing, and accompany the plays, gymnastics, frequent marchings, and dancing, when that is taught,—which it should be."
                            },
                            {
                                "example_id": "4c56a025-29bb-4677-b542-7bd5e34c269f",
                                "sense_id": "9183e3de-c9ac-3408-b310-a8efa3ed5a53",
                                "text": "But of the marchings and retreatings of these Six-thousand no Xenophon exists. Nothing, but an inarticulate hum, of cursing and sooty frenzy, surviving dubious in the memory of ages!"
                            },
                            {
                                "example_id": "bf9a0fe2-f100-4dd7-a363-0f63d7e5c3bd",
                                "sense_id": "9183e3de-c9ac-3408-b310-a8efa3ed5a53",
                                "text": "All steps and marchings executed from a halt, except right step, begin with the left foot."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
