                ],
                "translations": [
                    {
                        "translation_id": "9057801e-9dd0-48a0-8b7c-c847428b09b8",
                        "source_entry_id": "8d1aa9d0-cd11-372b-84e6-fba113e4a74e",
                        "source_sense_id": "ac0d4318-1439-3b9e-a494-f7794b75a7bc",
                        "source_sense_description": "pferdeähnliches Gesicht",
                        "target_lang_word": "horseface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horseface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "876ca974-a93c-379f-aa06-9f14a5c75eec",
                                        "entry_id": "6a153738-3e16-3a2b-ab35-ccb03a10041d",
                                        "glosses": [
                                            "The face of a horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208dad22-10e2-4cdf-b3bc-ee845cc973ec",
                                                "sense_id": "876ca974-a93c-379f-aa06-9f14a5c75eec",
                                                "text": "In the mid-1940s, he used it as a mask, on an owl, or on a horseface."
                                            },
                                            {
                                                "example_id": "177f7b05-2655-4c03-9f77-54d765f8c4bb",
                                                "sense_id": "876ca974-a93c-379f-aa06-9f14a5c75eec",
                                                "text": "It comes in the form of a mask, or a harmless owl, or a punning resemblance in the soft muzzle of a horseface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19b3f5f5-9b73-379f-805f-22b5edcf92a0",
                                        "entry_id": "6a153738-3e16-3a2b-ab35-ccb03a10041d",
                                        "glosses": [
                                            "A face that is long and ugly, with coarse features."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cc1eff7-8318-4cad-9e0f-7007c6a26ce5",
                                                "sense_id": "19b3f5f5-9b73-379f-805f-22b5edcf92a0",
                                                "text": "He did have a horseface, Darby decided angrily as he yanked a handkerchief from his back pocket to wipe the tobacco off another ruined shirt."
                                            },
                                            {
                                                "example_id": "3b88530d-6fea-4a3a-8d5c-503b33c85bff",
                                                "sense_id": "19b3f5f5-9b73-379f-805f-22b5edcf92a0",
                                                "text": "There had been gossip about the American Minister's wife's absence, which reported that she was very ugly and had a horseface."
                                            },
                                            {
                                                "example_id": "1705f009-c935-4cd9-805e-f5ebc547e8be",
                                                "sense_id": "19b3f5f5-9b73-379f-805f-22b5edcf92a0",
                                                "text": "But she had a horseface and nobody knew how on earth she got in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe37b091-78f2-347e-a558-1f5333e72a4e",
                                        "entry_id": "6a153738-3e16-3a2b-ab35-ccb03a10041d",
                                        "glosses": [
                                            "Someone who is unattractive and has a horseface."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "539eed05-cbad-44d5-acb5-fdf06cf843e1",
                                                "sense_id": "fe37b091-78f2-347e-a558-1f5333e72a4e",
                                                "text": "We got a horseface for a home room teacher."
                                            },
                                            {
                                                "example_id": "1b343ab0-7090-4960-9330-f4b035dfd012",
                                                "sense_id": "fe37b091-78f2-347e-a558-1f5333e72a4e",
                                                "text": "Aunt Samantha had shown annoyance at this by puffing her nostrils and issuing a sort of whinny-like protest which made her seem all the more a horseface."
                                            },
                                            {
                                                "example_id": "551e4e41-9c7a-4071-a36f-aee3726e46d5",
                                                "sense_id": "fe37b091-78f2-347e-a558-1f5333e72a4e",
                                                "text": "This one girl, Dasanna, kept asking me if I wanted to meet in person, and she wasn't a horseface in the game or anything, so we decided to hang at Champps sports bar."
                                            },
                                            {
                                                "example_id": "4dee0f02-6c7c-4ebb-ba55-71750d2a7129",
                                                "sense_id": "fe37b091-78f2-347e-a558-1f5333e72a4e",
                                                "text": "On Tuesday, the President of the United States referred to a porn star with whom he has been alleged to have had in affair in the mid 2000s as \"horseface.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
