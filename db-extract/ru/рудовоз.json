                                ]
                            },
                            {
                                "target_word": "minéralier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5be3aa62-d48b-3a72-abb1-ee843c778a27",
                                        "entry_id": "8b0137c0-fedb-3564-99a8-0b93a430b724",
                                        "glosses": [
                                            "Cargo destiné au transport de minerais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df555c7b-8039-4717-81b2-02e37f6106ec",
                                                "sense_id": "5be3aa62-d48b-3a72-abb1-ee843c778a27",
                                                "text": "Le minéralier Berge Stahl transporte du minerai du Brésil aux Pays-Bas dix fois par an, soit un voyage aller-retour de cinq semaines."
                                            },
                                            {
                                                "example_id": "e96f00ed-5362-463b-a5f9-dfc53736de45",
                                                "sense_id": "5be3aa62-d48b-3a72-abb1-ee843c778a27",
                                                "text": "Quand il a compris comment les choses s’emmanchaient, il a fait engager le gendre comme officier en second sur le Chios, un minéralier qui faisait la ligne Marseille-Nouméa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35196db-eb5e-3953-93f7-6d07b0f12157",
                                        "entry_id": "8b0137c0-fedb-3564-99a8-0b93a430b724",
                                        "glosses": [
                                            "Société d'eau minérale."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5338c904-85db-4e3b-bec4-a439bd441b7b",
                                                "sense_id": "c35196db-eb5e-3953-93f7-6d07b0f12157",
                                                "text": "Les minéraliers hexagonaux sont d’ailleurs, de loin, les premiers exportateurs mondiaux. La fiscalité les aide : le droit de bouchon, versé aux communes, ne s’applique pas aux volumes vendus au-delà des frontières. Or, une marque comme Perrier est exportée aux deux tiers !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
