{
    "word_family": [
        "skater",
        "skateboard",
        "skateboarder",
        "skateboarding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ce6ce45-100f-31a6-899a-c1d9bfb086d5",
                    "sense_definition": "The sport or activity of moving along a surface, such as ice or pavement, using skates.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to go <w>skating</w> on the frozen pond this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы планируем пойти <w>кататься на коньках</w> на замерзший пруд в эти выходные.",
                                "zh": "我们计划这个周末去冰冻的池塘上<w>滑冰</w>。"
                            }
                        },
                        {
                            "text": "Figure <w>skating</w> is one of the most popular events in the Winter Olympics.",
                            "target_lang_translations": {
                                "ru": "<w>Фигурное катание</w> — одна из самых популярных дисциплин на зимних Олимпийских играх.",
                                "zh": "<w>花样滑冰</w>是冬奥会中最受欢迎的项目之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ice skating",
                        "figure skating",
                        "roller skating",
                        "speed skating",
                        "go skating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спорт или вид деятельности, заключающийся в передвижении по поверхности (например, льду или асфальту) на коньках.",
                        "zh": "指在冰面或地面上穿戴滑冰鞋或滑轮鞋移动的运动或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катание на коньках",
                                "target_lang_sense_clarification": "общий термин для занятия"
                            },
                            {
                                "target_lang_word": "конькобежный спорт",
                                "target_lang_sense_clarification": "вид спорта на скорость"
                            },
                            {
                                "target_lang_word": "фигурное катание",
                                "target_lang_sense_clarification": "вид спорта с художественными элементами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑冰",
                                "target_lang_sense_clarification": "指在冰上滑行"
                            },
                            {
                                "target_lang_word": "轮滑",
                                "target_lang_sense_clarification": "指在地面上穿轮滑鞋滑行"
                            },
                            {
                                "target_lang_word": "花样滑冰",
                                "target_lang_sense_clarification": "指包含艺术表演元素的滑冰运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f847459-2397-3d0f-a39e-46d1ecb1efa4",
                    "sense_definition": "A skiing technique where the skier pushes off one ski diagonally to slide forward on the other.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "skiing_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete switched to <w>skating</w> to gain more speed on the flat section of the track.",
                            "target_lang_translations": {
                                "ru": "Спортсмен перешел на <w>коньковый ход</w>, чтобы набрать скорость на равнинном участке трассы.",
                                "zh": "运动员切换到<w>滑冰式滑雪</w>，以便在赛道的平坦路段获得更快的速度。"
                            }
                        },
                        {
                            "text": "<w>Skating</w> is often faster than the classic style on groomed cross-country trails.",
                            "target_lang_translations": {
                                "ru": "<w>Коньковый ход</w> часто быстрее классического стиля на подготовленных лыжных трассах.",
                                "zh": "在平整过的越野滑雪道上，<w>滑冰式滑雪</w>通常比经典式滑雪更快。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника лыжного хода, при которой лыжник отталкивается одной лыжей по диагонали, скользя вперед на другой.",
                        "zh": "一种越野滑雪技术，滑雪者通过斜向蹬地使另一只雪板向前滑行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коньковый ход",
                                "target_lang_sense_clarification": "стиль передвижения на лыжах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑冰式滑雪",
                                "target_lang_sense_clarification": "越野滑雪中的一种技术风格"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36ce020e-0d63-3955-9215-889dcbe109bc",
                    "sense_definition": "The present participle and gerund of <w>skate</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look at how fast she is <w>skating</w> across the ice.",
                            "target_lang_translations": {
                                "ru": "Посмотри, как быстро она <w>катится на коньках</w> по льду.",
                                "zh": "看她在那冰面上<w>滑</w>得多快。"
                            }
                        },
                        {
                            "text": "They were <w>skating</w> hand in hand around the rink.",
                            "target_lang_translations": {
                                "ru": "Они <w>катались на коньках</w> за руки по катку.",
                                "zh": "他们手拉着手在溜冰场上<w>滑冰</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени и герундия от глагола skate.",
                        "zh": "动词 skate 的现在分词或动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на коньках",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑冰",
                                "target_lang_sense_clarification": "指进行滑冰这一动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}