                "senses": [
                    {
                        "sense_id": "eb997409-58db-3b1c-82d3-a6ab650fcb96",
                        "entry_id": "ec1312cc-f7eb-398f-b916-8b441496e1b3",
                        "glosses": [
                            "Connecter sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f6d282-45ca-48c5-92b9-343563c33548",
                                "sense_id": "eb997409-58db-3b1c-82d3-a6ab650fcb96",
                                "text": "La meilleure connection consiste à autoconnecter Kouadio, puisqu’il n’en coûte que 12.300 valeur inférieure à 15.050 F."
                            },
                            {
                                "example_id": "7b802780-0c84-4d69-9b24-090e19faf58d",
                                "sense_id": "eb997409-58db-3b1c-82d3-a6ab650fcb96",
                                "text": "Pour générer automatiquement de nouvelles pages, cochez Autoconnecter."
                            },
                            {
                                "example_id": "548b1f1f-d834-4280-8342-bce9aa142b54",
                                "sense_id": "eb997409-58db-3b1c-82d3-a6ab650fcb96",
                                "text": "Elle permet une fabrication directe, relativement simple et peu coûteuse, de circuits éventuellement complexes pouvant s’« autoconnecter » aisément à des fibres optiques."
                            }
                        ]
                    }
