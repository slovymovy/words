                "senses": [
                    {
                        "sense_id": "85c2dca5-b0f1-3bbd-8047-51d88539b8d2",
                        "entry_id": "3b4a0d22-710a-38b8-9642-fc9b224a2053",
                        "glosses": [
                            "The assumption of an exaggerated pose or attitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287877b1-7962-4a60-8f7d-8189699acc1c",
                                "sense_id": "85c2dca5-b0f1-3bbd-8047-51d88539b8d2",
                                "text": "With his \"hatred of what was theatrical\" (1:124) he is put off by the posturings and attitudinizings of the chief actors."
                            },
                            {
                                "example_id": "86155bd3-2732-40b1-b780-fb2540f9fffc",
                                "sense_id": "85c2dca5-b0f1-3bbd-8047-51d88539b8d2",
                                "text": "Few political careers start when people are in their 70s, but Hendy is actually relishing it, although he is incensed sometimes by the pointlessness of the posturing by the opposition, which keeps him up late. \"The bit I don't like is getting home at 0100 or 0200 in the morning because the opposition have been fruitlessly arguing for a long time.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "6570834c-50f9-3e3f-9007-a04e936bedd5",
                        "entry_id": "3b4a0d22-710a-38b8-9642-fc9b224a2053",
                        "glosses": [
                            "The behavior of some birds as a means of signalling etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c34cc90d-6c11-409d-b83d-d6b01d0db14f",
                        "source_entry_id": "3b4a0d22-710a-38b8-9642-fc9b224a2053",
                        "source_sense_description": "assumption of an exaggerated pose or attitude",
                        "target_lang_word": "Inszenierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inszenierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                        "entry_id": "4c3aa317-395a-3c2d-9ae2-0e9b8ff53d69",
                                        "glosses": [
                                            "künstlerische Gestaltung einer Aufführung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7562a28b-682f-467e-a25a-2d3f26f7b27c",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "Die Inszenierung des Stückes war gewöhnungsbedürftig."
                                            },
                                            {
                                                "example_id": "bb3ad05c-a750-4e4f-83e7-674ffe048962",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "„Er denkt schon an eine große Inszenierung, nicht an eine kleine Gelegenheitssache.“"
                                            },
                                            {
                                                "example_id": "d08370a1-1bea-4034-89ab-3bc7134271b5",
                                                "sense_id": "b800e7e4-558d-3343-a3c9-42a7b8efd22f",
                                                "text": "„Er klatscht in die Hände, als gälte es eine gelungene Inszenierung zu bejubeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                        "entry_id": "4c3aa317-395a-3c2d-9ae2-0e9b8ff53d69",
                                        "glosses": [
                                            "übertriebene Selbstdarstellung, Auslösung eines Skandals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a0e495-b78a-46fd-804a-cd25729b9d29",
                                                "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                                "text": "Ihre Inszenierung hat ihre wahren Absichten gezeigt."
                                            },
                                            {
                                                "example_id": "a0f8a328-899a-488e-8192-ae3586b2544d",
                                                "sense_id": "7a200fd5-cab4-3b49-8103-8f3a54225496",
                                                "text": "„Kurz kam ihm der Gedanke, dass das hier möglicherweise alles eine große Inszenierung war, dass die beiden ihm etwas verheimlichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
