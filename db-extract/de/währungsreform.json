                ],
                "senses": [
                    {
                        "sense_id": "22f513e1-3055-36cc-8347-86d7b54ca1c4",
                        "entry_id": "561e9917-22da-3d26-bb47-4d945d5576ce",
                        "glosses": [
                            "eine größere Änderung, eine Reform der Währung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5df918-0c5f-40c8-a34e-8c21f5c73528",
                                "sense_id": "22f513e1-3055-36cc-8347-86d7b54ca1c4",
                                "text": "„Es ist, als stiege man in die Verliese einer Vergangenheit, deren Reize und Schrecken ich allein vom Hörensagen kenne, aus den zahllosen Erzählungen meiner Eltern und Großeltern, die von Gestellungsbefehlen und Bombennächten, Kriegsgefangenschaft und Hamsterfahrten handelten und mit der Währungsreform endeten.“"
                            },
                            {
                                "example_id": "e1d38deb-cf6a-4f86-9048-a81da3eb073a",
                                "sense_id": "22f513e1-3055-36cc-8347-86d7b54ca1c4",
                                "text": "„Bei der Währungsreform bekam man schließlich 1 Prozent davon als Deutsche Mark, jedoch nicht mehr als 50 Mark.“"
                            },
                            {
                                "example_id": "a6b7a396-9375-499a-a2ac-50931409b71a",
                                "sense_id": "22f513e1-3055-36cc-8347-86d7b54ca1c4",
                                "text": "„Währungsreformen sind immer mit Verunsicherung und logistischen Herausforderungen verbunden, ihre Folgen sind niemals vollständig kalkulierbar.“"
                            },
                            {
                                "example_id": "bcabf784-4e1e-4be7-8336-57f341cb4ccd",
                                "sense_id": "22f513e1-3055-36cc-8347-86d7b54ca1c4",
                                "text": "„Nach der Währungsreform vom Juni 1948 konnten sie es sich leisten, ihre Industrie auf das modernste neu auszurüsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
