                "senses": [
                    {
                        "sense_id": "62ee5b25-3c5a-3945-8bb8-3bf95f308956",
                        "entry_id": "0a40e6e2-9434-32d1-be45-502eb4a4d422",
                        "glosses": [
                            "de hand aan de overzijde van waar zich in het lichaam gewoonlijk het hart bevindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b23ceaec-6fd1-4c5c-bdf4-adc892913259",
                                "sense_id": "62ee5b25-3c5a-3945-8bb8-3bf95f308956",
                                "text": "De meeste mensen schrijven met hun rechterhand."
                            }
                        ]
                    },
                    {
                        "sense_id": "74610971-5bf6-322c-b7f1-462ee091e3bc",
                        "entry_id": "0a40e6e2-9434-32d1-be45-502eb4a4d422",
                        "glosses": [
                            "een assistent van een persoon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cb476d-e15f-4e44-9e30-3a343ca367f4",
                                "sense_id": "74610971-5bf6-322c-b7f1-462ee091e3bc",
                                "text": "Voortdurend waarschuwde Bernie Sanders voor de opmars van de superrijken die hun invloed in de politiek en de media kopen. En zie hoe hij gelijk heeft gekregen nu Elon Musk de officieuze rechterhand van Trump is geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65769b3f-b9c4-4ad4-b741-74eca46f67f4",
                        "source_entry_id": "0a40e6e2-9434-32d1-be45-502eb4a4d422",
                        "source_sense_id": "62ee5b25-3c5a-3945-8bb8-3bf95f308956",
                        "source_sense_description": "de hand aan de overzijde van waar zich in het lichaam gewoonlijk het hart bevindt",
                        "target_lang_word": "Rechte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f159443a-008d-341c-8c21-9f69508e952a",
                                        "entry_id": "ccc16f92-c010-3a11-9fe4-fc5206cca861",
                                        "glosses": [
                                            "die rechts gelegene Hand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d10e513-aeae-41dd-bb05-5c67579ea963",
                                                "sense_id": "f159443a-008d-341c-8c21-9f69508e952a",
                                                "text": "Der König hielt das Zepter in der Rechten und den Reichsapfel in der Linken."
                                            },
                                            {
                                                "example_id": "c43f2a84-d9b2-4a0c-9452-c6fb095a5466",
                                                "sense_id": "f159443a-008d-341c-8c21-9f69508e952a",
                                                "text": "„Auf einer zweispurigen Asphaltstraße fahren wir durch die Wüste, immer geradeaus, schneebedeckte Gebirgsketten zu unserer Rechten, flimmernde Weite zu unserer Linken.“"
                                            },
                                            {
                                                "example_id": "f034ebbf-7f8b-427f-a47d-0c9faa2f8de2",
                                                "sense_id": "f159443a-008d-341c-8c21-9f69508e952a",
                                                "text": "„Er erhob sich langsam vom Tisch, die Rechte in der Tasche, während die Linke seine Krawatte zurechtrückte.“"
                                            },
                                            {
                                                "example_id": "b2a57337-0a62-4268-b126-e7fff61025f0",
                                                "sense_id": "f159443a-008d-341c-8c21-9f69508e952a",
                                                "text": "„Ich trank wie Graf Bonneval, der zu meiner Rechten saß, ausgezeichneten weißen Burgunder.“"
                                            },
                                            {
                                                "example_id": "a8d321bf-638b-41fe-86b5-aa3b100c3fd7",
                                                "sense_id": "f159443a-008d-341c-8c21-9f69508e952a",
                                                "text": "„Nachdem der Miko dieses verdolmetscht hatte, legte der junge Comanchee seine Rechte an die Brust und neigte sein Haupt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3db03114-23fa-3c40-8dcd-3445f90dc85c",
                                        "entry_id": "ccc16f92-c010-3a11-9fe4-fc5206cca861",
                                        "glosses": [
                                            "ein Schlag, ein Treffer mit der rechten Hand"
                                        ],
                                        "tags": [
                                            "Boxen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b94231-d67f-465f-b37f-2ca5b1767e7e",
                                                "sense_id": "3db03114-23fa-3c40-8dcd-3445f90dc85c",
                                                "text": "Ein wuchtiger Treffer mit der Rechten beendete den Kampf vorzeitig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cb0ed6d-cbb1-3279-891a-425a9504dc71",
                                        "entry_id": "ccc16f92-c010-3a11-9fe4-fc5206cca861",
                                        "glosses": [
                                            "Gruppe politisch Aktiver, die dem rechten Spektrum zugerechnet werden; konservative Parteien"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db43a0f-1fc1-4ce2-9ff8-6e4e75fcb835",
                                                "sense_id": "1cb0ed6d-cbb1-3279-891a-425a9504dc71",
                                                "text": "„Die politische Rechte profitiert auch von einem Vertrauensverlust in die etablierten Parteien.“"
                                            },
                                            {
                                                "example_id": "62cf7a26-7753-4281-888d-927bb1292b52",
                                                "sense_id": "1cb0ed6d-cbb1-3279-891a-425a9504dc71",
                                                "text": "Er würde seine Partei nicht zu den Rechten zählen – eher zur bürgerlichen Mitte."
                                            },
                                            {
                                                "example_id": "a63d9245-4a7b-4a6f-b7ad-c6c7becb5bfb",
                                                "sense_id": "1cb0ed6d-cbb1-3279-891a-425a9504dc71",
                                                "text": "„In seinem Bestseller „Rückkehr nach Reims“ beschreibt Eribon am Beispiel seiner eigenen Familie die Entfremdung des Proletariats von der politischen Linken und ihre Hinwendung zur extremen Rechten. Eine Entwicklung, die in allen Industrieländern zu beobachten ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5c6845cc-7f93-36f9-9174-926419beb994",
                                        "entry_id": "ccc16f92-c010-3a11-9fe4-fc5206cca861",
                                        "glosses": [
                                            "weibliche Person, die einer Partei nach [3] nahesteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc5e0c3-1f11-4fca-990c-24f49322882d",
                                                "sense_id": "5c6845cc-7f93-36f9-9174-926419beb994",
                                                "text": "„Die Wählerinnen und Wähler entscheiden, ob es mit dem liberalen Amtsinhaber Emmanuel Macron weitergeht oder die Rechte Le Pen Staatschefin wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
