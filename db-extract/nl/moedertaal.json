                "senses": [
                    {
                        "sense_id": "5473f5dd-6340-3913-8b33-9d681fab2859",
                        "entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                        "glosses": [
                            "taal die tijdens de jeugd, zonder formeel taalonderwijs, wordt verworven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a38832e-1353-4870-a1ef-cd6dfdbd0ad6",
                                "sense_id": "5473f5dd-6340-3913-8b33-9d681fab2859",
                                "text": "Het Nederlands is niet mijn moedertaal."
                            },
                            {
                                "example_id": "3ab5a01c-2588-41ee-b8a6-c75fb64d6444",
                                "sense_id": "5473f5dd-6340-3913-8b33-9d681fab2859",
                                "text": "'Op uw gedichten studeer ik nog. Ik heb echter moeite met de klanken van uw moedertaal, dus ik vrees dat ik, wanneer de gelegenheid zich voordoet om iets van uw hand te citeren, mijn toevlucht zal moeten nemen tot de Engelse, Duitse of Italiaanse vertaling. Ik hoop dat u bij voorbaat de grootmoedigheid kunt opbrengen om mij dat te vergeven.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "bcf14f75-1680-3b87-b110-311c84d4f107",
                        "entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                        "glosses": [
                            "iets waar iemand zich helemaal in thuis voelt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a12cc2ee-3bbb-4798-942b-c0505ad35cb6",
                                "sense_id": "bcf14f75-1680-3b87-b110-311c84d4f107",
                                "text": "Natuurkunde is mijn moedertaal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e68889a-9a17-4efa-822d-a3f3f9d94789",
                        "source_entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                        "target_lang_word": "Muttersprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muttersprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                        "entry_id": "502c2573-c42c-3557-9431-ad247d8ebaf1",
                                        "glosses": [
                                            "Sprache, die ein Mensch in der Kindheit erlernt (hat) und in der er primär denkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba99288-1632-4ba1-8ba7-52df7607ff15",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "Unsere Muttersprache ist die erste Sprache, die wir im Spracherwerb gelernt haben."
                                            },
                                            {
                                                "example_id": "23d4f5dc-aa32-4d65-ba4e-a1ee1a9d94a8",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "„Die Abkürzungssprache - auch Aküsprache oder Aküspra genannt - wird allmählich ein Bestandteil unserer Muttersprache.“"
                                            },
                                            {
                                                "example_id": "f277846e-52a9-4994-8ab1-50f577f7822b",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "„Aber eine von diesen nimmt bei allen Menschen eine besondere Stellung ein: das ist die, die er in seinem Leben zuerst gelernt hat, seine Muttersprache (…).“"
                                            },
                                            {
                                                "example_id": "944252c3-6c92-4623-bcf0-3b2e9ab68c00",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "„Vielerorts werden Kinder bis heute streng bestraft, wenn sie sich in der Schule - und sei es selbst in der Pause - in ihrer Muttersprache unterhalten.“"
                                            },
                                            {
                                                "example_id": "2b3eb15c-7b75-4b7a-ba67-fb8b8d40d7ee",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "„In Deutschland wurde der Sprachwechsel dadurch gefördert, dass die Juden selbst ihre eigene Muttersprache bis dahin in einem vagen Sinne als eine jüdische Form des Deutschen aufgefasst und in ihrem Sprachgebrauch sporadisch zu verschiedenen Gelegenheiten Anleihen am Schriftdeutschen gemacht hatten.“"
                                            },
                                            {
                                                "example_id": "790a7a37-ce6d-4768-b951-d8dc16b224ea",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "„Wenn meine Mutter wütend war, verfiel sie in ihre Muttersprache.“"
                                            },
                                            {
                                                "example_id": "fddb02f6-3c18-4657-8562-83fa16cc5d3b",
                                                "sense_id": "390d530f-7388-3009-b300-ad7a05900119",
                                                "text": "„Bis zum fünften Lebensjahr haben die meisten Kinder dann den Satzbau ihrer Muttersprache verinnerlicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "694196eb-8496-352c-ae04-1e8d3c39b2c5",
                                        "entry_id": "502c2573-c42c-3557-9431-ad247d8ebaf1",
                                        "glosses": [
                                            "Sprache, von der andere Sprachen abstammen"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b55196-9959-496a-9a56-cb4600f48c65",
                                                "sense_id": "694196eb-8496-352c-ae04-1e8d3c39b2c5",
                                                "text": "Die italische Sprache Latein ist die Muttersprache der romanischen Sprachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f5aacd5-df46-422f-996e-83d749071781",
                        "source_entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                        "target_lang_word": "mother tongue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mother tongue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                        "entry_id": "0dac3f2f-303a-332a-9d69-2d9e8fa6b8a7",
                                        "glosses": [
                                            "The language one first learned; the language one grew up with; one's native language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "833f1844-22f2-4431-8e91-d1c16e5f28da",
                                                "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                                "text": "His mother tongue is a relatively conservative dialect of Aramaic."
                                            },
                                            {
                                                "example_id": "7ab4bd57-424b-4ba8-9250-d21694f990e9",
                                                "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                                "text": "One young Tamil teacher had assimilated the sound-system of English so thoroughly to that of his mother-tongue that none of the Chinese and Malay children understood him."
                                            },
                                            {
                                                "example_id": "73fc70f4-4592-4e3f-b28b-7844da8dd06a",
                                                "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                                "text": "Throughout their long history as a minority, Anglo-Indians learned their \"father tongue\" but were indifferent to their \"mother tongue,\" an indigenous Indian language."
                                            },
                                            {
                                                "example_id": "b3742532-101b-469d-b498-a25631afcaef",
                                                "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                                "text": "A father tongue is a foreign language, therefore English is a foreign language not a mother tongue."
                                            },
                                            {
                                                "example_id": "c00a87ee-5cc4-49d9-b8a6-52395924752c",
                                                "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                                "text": "Ramanujan has also argued that many Hindu men have both a mother tongue (the everyday language, such as Tamil, spoken by women downstairs, in the back, in the kitchen) and a father tongue (once Sanskrit, more recently English, the literary lingua franca spoken—or at least discussed—by men in the front rooms)."
                                            },
                                            {
                                                "example_id": "1162a2d9-4652-4d93-9b30-73af210ce6d4",
                                                "sense_id": "9812f7b8-21a8-3559-a1d9-bfc200b84796",
                                                "text": "In the early Middle Ages, 'mother tongue' was largely 'a pejorative term to describe the unlearned language of women and children' (Haugen 1991: 82). This reflected the low status of women in society and contrasted with Latin, the more prestigious 'father tongue' on the continent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7932cc-3756-3a05-83de-3b551706b14a",
                                        "entry_id": "0dac3f2f-303a-332a-9d69-2d9e8fa6b8a7",
                                        "glosses": [
                                            "The language spoken by one’s ancestors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8457982a-05aa-3453-be21-f2c4ab432f2d",
                                        "entry_id": "0dac3f2f-303a-332a-9d69-2d9e8fa6b8a7",
                                        "glosses": [
                                            "The language spoken by one's mother, when it differs from that spoken by one's father."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cccb08b0-12cc-4884-918a-252091397c53",
                                                "sense_id": "8457982a-05aa-3453-be21-f2c4ab432f2d",
                                                "text": "Questions about respondents' place of birth, their parents' place of birth, nativity, and language use (called “mother tongue” and “father tongue”) were added to the Census between 1850 and 1960."
                                            },
                                            {
                                                "example_id": "7dc9b1e2-59a0-4013-bfb2-e374025ace56",
                                                "sense_id": "8457982a-05aa-3453-be21-f2c4ab432f2d",
                                                "text": "Informed by the experience of other parents who had successfully raised their children with more than one language and our own observations, we knew clearly that Léandre and Dominique's mother tongue and father tongue would not have a chance without deliberate 'control' of their linguistic environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da185231-6cb1-3e57-80a8-ec2dce0b6c1e",
                                        "entry_id": "0dac3f2f-303a-332a-9d69-2d9e8fa6b8a7",
                                        "glosses": [
                                            "Informal speech, as opposed to educated language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf1a7df-0541-4af0-8f2f-4b1d51485d9b",
                                                "sense_id": "da185231-6cb1-3e57-80a8-ec2dce0b6c1e",
                                                "text": "The other is the maturity and experience of that; if that is our mother tongue, this is our father tongue, a reserved and select expression, too significant to be heard by the ear, which we must be born again in order to speak."
                                            },
                                            {
                                                "example_id": "621ce8f2-cff6-4fe0-89ef-c6202b35b00a",
                                                "sense_id": "da185231-6cb1-3e57-80a8-ec2dce0b6c1e",
                                                "text": "We learn the father tongue to prove we have outgrown the mother tongue."
                                            },
                                            {
                                                "example_id": "41510d08-74a6-4033-9e1a-350908111685",
                                                "sense_id": "da185231-6cb1-3e57-80a8-ec2dce0b6c1e",
                                                "text": "In each case, we are reborn -- a fact that explains Thoreau's preference here for the father tongue over the mother tongue, as Cavell explains: \"A son of man is born of woman; but rebirth, according to our Bible, is the business of the father.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a68a8f-6f03-423b-98c1-4567f0da1fa2",
                        "source_entry_id": "93d27991-2f00-33a6-9962-25d321907e47",
                        "target_lang_word": "langue maternelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "langue maternelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0fbc378c-4537-3e82-8bbf-87215da57178",
                                        "entry_id": "79c99f09-14bf-3eeb-a26b-95aab4325eb1",
                                        "glosses": [
                                            "Première langue qu’un enfant apprend auprès d’un membre ou non de sa famille, principalement sa mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272d1564-c03f-40fb-bd1c-9c8fd5b2312c",
                                                "sense_id": "0fbc378c-4537-3e82-8bbf-87215da57178",
                                                "text": "On a beau parler couramment une langue étrangère, c’est vers sa langue maternelle qu’on tend à se tourner pour nommer fruits et légumes. Bien que je sache parfaitement comment s’appelle tel fruit ou tel légume en anglais ou en français, c’est le créole que j’emploie pour en parler."
                                            },
                                            {
                                                "example_id": "2d037bdd-be76-450a-9442-b895191dfed8",
                                                "sense_id": "0fbc378c-4537-3e82-8bbf-87215da57178",
                                                "text": "Il parlait et écrivait mieux le japonais que la plupart des enfants dont c’était la langue maternelle."
                                            },
                                            {
                                                "example_id": "bb1a2717-72f3-43fd-8df5-1830597c55b1",
                                                "sense_id": "0fbc378c-4537-3e82-8bbf-87215da57178",
                                                "text": "Il alternait les injures, dans un français approximatif, avec les prières dans sa langue maternelle."
                                            },
                                            {
                                                "example_id": "7db9a229-7c6b-4778-9a1f-74b64903d997",
                                                "sense_id": "0fbc378c-4537-3e82-8bbf-87215da57178",
                                                "text": "Depuis 1998, l’Éducation nationale fait une petite place sur les bancs de l’école à certaines langues de Guyane avec le dispositif des intervenants en langue maternelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
