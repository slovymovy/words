                "senses": [
                    {
                        "sense_id": "08dbadc6-42f1-3560-a559-b299f0a211c5",
                        "entry_id": "07f73f77-6346-3319-bea0-02ff353af6ff",
                        "glosses": [
                            "(männliche^☆) Person, die eine Frau ermordet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33cdd4e-371b-4a91-b610-0595cf62cc3b",
                                "sense_id": "08dbadc6-42f1-3560-a559-b299f0a211c5",
                                "text": "„Der Favoritner Frauenmörder Herbert P., der seit über 18 Jahren im Gefängnis sitzt, ist am Dienstag am Wiener Landesgericht wegen schwerer Körperverletzung zu zwei weiteren Jahren unbedingter Haft verurteilt worden.“"
                            },
                            {
                                "example_id": "49e9d235-9272-4dff-b0c1-7927fd938455",
                                "sense_id": "08dbadc6-42f1-3560-a559-b299f0a211c5",
                                "text": "„Ein Vergewaltiger und Frauenmörder, dem sie gerade erst eine positive Prognose gestellt hat, nimmt Hanna als Geisel, in ihrem Büro.“"
                            },
                            {
                                "example_id": "5b5cdffb-669f-47b8-af6e-37365f986371",
                                "sense_id": "08dbadc6-42f1-3560-a559-b299f0a211c5",
                                "text": "„Trotz zahlreicher Hinweise an die Ermittler ist der mutmaßliche Frauenmörder Ali S. noch immer auf der Flucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
