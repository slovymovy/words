                    },
                    {
                        "translation_id": "6b7990a2-1e1f-4fa6-95f8-dceecbcefec0",
                        "source_entry_id": "59108b46-b45e-3f37-a0ba-2ddc7c5dce5e",
                        "source_sense_id": "974e6868-dbde-3bf4-b02b-fcfd49dce604",
