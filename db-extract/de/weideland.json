                ],
                "senses": [
                    {
                        "sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                        "entry_id": "24674993-deab-3312-b737-68adaae13345",
                        "glosses": [
                            "Landwirtschaftliche Flächen, die als Weiden genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "503defce-9d7d-4a36-ab43-8c11c7587d68",
                                "sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                                "text": "\"Der Fluß, der es durchquert, macht daraus etwas wie zwei Regionen von unterschiedlichem Aussehen: alles was links liegt, ist Weideland; alles, was rechts liegt, wird beackert.\""
                            },
                            {
                                "example_id": "4c491948-810d-4c6e-bb72-600a30dd1786",
                                "sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                                "text": "Vilsack kündigte an, den Tierhaltern zu helfen, mit den steigenden Nahrungsmittelpreisen, den Engpässen bei Heu und dem sich verschlechternden Weideland umzugehen. Den Bauern werde Heu von zusätzlichem Weideland zur Verfügung gestellt."
                            },
                            {
                                "example_id": "925a0410-43d4-465e-b30e-0ff7cc92d0ec",
                                "sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                                "text": "Dort streitet sich das Hirtenvolk der Orma mit den Pokomo, die vom Ackerbau leben, seit langer Zeit um das Weideland am Fluss Tana."
                            },
                            {
                                "example_id": "078660fb-993c-461b-a067-e33469030a8b",
                                "sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                                "text": "„In den weiten Wiesen, auf denen häufig Birken gedeihen, sehen die Ankömmlinge Weideland für ihr Vieh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5539877a-995f-4404-85f2-a9dd7ada0d5b",
                        "source_entry_id": "24674993-deab-3312-b737-68adaae13345",
                        "source_sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                        "source_sense_description": "Landwirtschaftliche Flächen, die als Weiden genutzt werden",
                        "target_lang_word": "pasture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da566e72-e3cb-3ee6-8062-7374e3649648",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Land, specifically, an open field, on which livestock is kept for feeding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Ground covered with grass or herbage, used or suitable for the grazing of livestock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce31ecdc-f187-4dda-a6ca-6833159b8184",
                                                "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                                "text": "He maketh me to lie down in green pastures."
                                            },
                                            {
                                                "example_id": "2804240b-4694-41ab-bc8b-1b9e20409095",
                                                "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                                "text": "So graze as you find pasture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Food, nourishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820ebeb7-8205-44db-a028-394edba85baa",
                                                "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                                "text": "Ne euer is he wont on ought to feed, / But toades and frogs, his pasture poysonous […]."
                                            },
                                            {
                                                "example_id": "2907fc8d-b9f2-42d0-80d5-4bab96695d15",
                                                "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                                "text": "It was reserved for Christians to torture bread, the staff of life, bread for which children in whole districts wail, bread, the gift of pasture to the poor, bread, for want of which thousands of our fellow beings annually perish by famine; it was reserved for Christians to torture the material of bread by fire, to create a chemical and maddening poison, burning up the brain and brutalizing the soul, and producing evils to humanity, in comparison of which, war, pestilence, and famine, cease to be evils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pasture",
                                "target_lang_code": "en",
                                "target_senses": [
