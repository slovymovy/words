{
    "word_family": [
        "tendency",
        "tendance",
        "tender",
        "attendant",
        "attention"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d49497c-0d07-3bcf-9743-2e0e6bcfb314",
                    "sense_definition": "To be likely to behave in a particular way or have a certain characteristic",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>tend</w> to go out on Saturdays when the weather is nice.",
                            "target_lang_translations": {
                                "ru": "Они <w>склонны</w> гулять по субботам, когда погода хорошая."
                            }
                        },
                        {
                            "text": "It <w>tends</w> to snow here in winter during the coldest months.",
                            "target_lang_translations": {
                                "ru": "Здесь <w>обычно</w> идет снег зимой в самые холодные месяцы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tend to be",
                        "tend to have"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь склонность вести себя определенным образом или обладать определенной характеристикой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь склонность",
                                "target_lang_sense_clarification": "к определенному поведению"
                            },
                            {
                                "target_lang_word": "склоняться",
                                "target_lang_sense_clarification": "к какому-либо действию"
                            },
                            {
                                "target_lang_word": "иметь тенденцию",
                                "target_lang_sense_clarification": "проявлять закономерность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17f475cc-e73c-37de-a042-949ba4d2f5db",
                    "sense_definition": "To care for or look after someone or something",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caretaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>tend</w> to the garden because it has become a mess.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>привести в порядок</w> сад, потому что он совсем зарос."
                            }
                        },
                        {
                            "text": "The nurse will <w>tend</w> to the patient until the doctor arrives.",
                            "target_lang_translations": {
                                "ru": "Медсестра будет <w>ухаживать</w> за пациентом до прихода врача."
                            }
                        }
                    ],
                    "synonyms": [
                        "care for",
                        "look after",
                        "take care of",
                        "nurse"
                    ],
                    "antonyms": [
                        "neglect",
                        "ignore"
                    ],
                    "common_phrases": [
                        "tend to the garden",
                        "tend to the sick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заботиться или присматривать за кем-либо или чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "за больным или садом"
                            },
                            {
                                "target_lang_word": "заботиться",
                                "target_lang_sense_clarification": "о ком-либо или чем-либо"
                            },
                            {
                                "target_lang_word": "присматривать",
                                "target_lang_sense_clarification": "наблюдать и помогать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "468aa663-5b3e-3c16-9b24-93fb91d5768e",
                    "sense_definition": "To watch over and protect, especially animals or a fire",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caretaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherds <w>tend</w> their flocks in the green valley all day.",
                            "target_lang_translations": {
                                "ru": "Пастухи весь день <w>пасут</w> свои стада в зеленой долине."
                            }
                        },
                        {
                            "text": "He stayed up late to <w>tend</w> the fire and keep the cabin warm.",
                            "target_lang_translations": {
                                "ru": "Он не ложился допоздна, чтобы <w>поддерживать</w> огонь и сохранять тепло в хижине."
                            }
                        }
                    ],
                    "synonyms": [
                        "guard",
                        "watch"
                    ],
                    "antonyms": [
                        "abandon"
                    ],
                    "common_phrases": [
                        "tend the flock",
                        "tend the fire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следить и защищать, особенно животных или огонь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пасти",
                                "target_lang_sense_clarification": "стадо животных"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "огонь в костре или печи"
                            },
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "за сохранностью чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51194f71-bef9-3533-a81e-19403fb0001e",
                    "sense_definition": "To contribute to or move toward a specific result or outcome",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These new economic policies <w>tend</w> toward the destruction of small businesses.",
                            "target_lang_translations": {
                                "ru": "Эта новая экономическая политика <w>ведет</w> к уничтожению малого бизнеса."
                            }
                        },
                        {
                            "text": "His comments <w>tend</w> to support the theory that the climate is changing.",
                            "target_lang_translations": {
                                "ru": "Его замечания <w>подкрепляют</w> теорию о том, что климат меняется."
                            }
                        }
                    ],
                    "synonyms": [
                        "attend to"
                    ],
                    "common_phrases": [
                        "tend toward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствовать или двигаться к определенному результату или исходу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "к определенному результату"
                            },
                            {
                                "target_lang_word": "клониться",
                                "target_lang_sense_clarification": "к какому-либо исходу"
                            },
                            {
                                "target_lang_word": "тяготеть",
                                "target_lang_sense_clarification": "к определенному направлению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6586d557-eee2-36cd-bd8f-db456b9d2a32",
                    "sense_definition": "To serve or wait upon someone as an attendant",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "caretaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servants <w>tend</w> upon the king during the royal banquet.",
                            "target_lang_translations": {
                                "ru": "Слуги <w>прислуживают</w> королю во время королевского банкета."
                            }
                        },
                        {
                            "text": "Several knights were chosen to <w>tend</w> upon the prince during his journey.",
                            "target_lang_translations": {
                                "ru": "Несколько рыцарей были выбраны, чтобы <w>сопровождать</w> принца во время его путешествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "minister to"
                    ],
                    "common_phrases": [
                        "tend upon"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить или прислуживать кому-либо в качестве сопровождающего"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прислуживать",
                                "target_lang_sense_clarification": "высокопоставленному лицу"
                            },
                            {
                                "target_lang_word": "сопровождать",
                                "target_lang_sense_clarification": "в качестве свиты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}