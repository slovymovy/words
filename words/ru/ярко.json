                        "fr": "Forme courte du neutre singulier de l'adjectif « lumineux » ou « éclatant »."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bright",
                                "target_lang_sense_clarification": "full of light"
                            },
                            {
                                "target_lang_word": "vivid",
                                "target_lang_sense_clarification": "intense or clear (memory)"
                            }
                        ],
                        "es": [
                            {
