{
    "word_family": [
        "enamor",
        "enamorment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "baa8ae1e-a2b4-3507-b218-13c6ed6f5bbb",
                    "sense_definition": "Feeling strong love or admiration for someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "love",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is completely <w>enamored</w> with her new boyfriend.",
                            "target_lang_translations": {
                                "zh": "她完全<w>迷恋</w>上了她的新男友。"
                            }
                        },
                        {
                            "text": "The tourists were <w>enamored</w> of the beautiful mountain scenery.",
                            "target_lang_translations": {
                                "zh": "游客们被美丽的群山景色所<w>倾心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "head over heels",
                        "twitterpated"
                    ],
                    "common_phrases": [
                        "enamored with",
                        "enamored of"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某人或某物怀有强烈的爱慕或赞赏之情。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迷恋",
                                "target_lang_sense_clarification": "指对人或事物极度喜爱，难以舍弃。"
                            },
                            {
                                "target_lang_word": "倾心",
                                "target_lang_sense_clarification": "指对某人或某事产生爱慕或敬佩。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0a0edc5-f995-3052-9070-9bf704ee5f1d",
                    "sense_definition": "Past tense and past participle of <w>enamor</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "love",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>enamored</w> her with his charming personality.",
                            "target_lang_translations": {
                                "zh": "他以迷人的个性<w>使</w>她<w>迷恋</w>上了自己。"
                            }
                        },
                        {
                            "text": "She was <w>enamored</w> by the beautiful gift he gave her.",
                            "target_lang_translations": {
                                "zh": "她被他送的精美礼物所<w>迷住</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人迷恋或倾心（enamor的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……迷恋",
                                "target_lang_sense_clarification": "指通过某种特质或行为让对方产生爱慕。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}