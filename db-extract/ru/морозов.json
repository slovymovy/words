                                "example_id": "ec99bb14-b4d9-4bc7-bacb-bfb3b0f35b80",
                                "sense_id": "64c20855-abfd-32dc-9c79-87d03ac5450d",
                                "text": "Тимофе́й Са́ввич Морозов.",
