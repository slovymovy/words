                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>cliente</w> attend patiemment son tour devant la caisse du magasin.",
                            "target_lang_translations": {
                                "en": "The <w>customer</w> waits patiently for her turn at the till in the shop.",
                                "ru": "<w>Покупательница</w> терпеливо ждёт своей очереди у кассы магазина.",
                                "nl": "De <w>klant</w> wacht geduldig op haar beurt bij de kassa van de winkel.",
                                "de": "Die <w>Kundin</w> wartet geduldig an der Kasse des Ladens, bis sie an der Reihe ist.",
                                "pl": "<w>Klientka</w> cierpliwie czeka na swoją kolej przy kasie w sklepie.",
                                "it": "La <w>cliente</w> aspetta pazientemente il suo turno alla cassa del negozio.",
                                "cs": "<w>Zákaznice</w> trpělivě čeká na svou řadu u pokladny v obchodě.",
                                "tr": "Kadın <w>müşteri</w> mağazadaki kasanın önünde sırasını sabırla bekliyor.",
                                "es": "La <w>clienta</w> espera pacientemente su turno en la caja de la tienda.",
                                "zh": "这位女<w>顾客</w>在商店的收银台前耐心地等着轮到自己。"
                            }
                        },
                        {
                            "text": "Cette boulangerie offre une réduction à chaque <w>cliente</w> fidèle.",
                            "target_lang_translations": {
                                "en": "This bakery offers a discount to every loyal <w>customer</w>.",
                                "ru": "Эта пекарня предлагает скидку каждой постоянной <w>клиентке</w>.",
                                "nl": "Deze bakkerij geeft elke trouwe <w>klant</w> korting.",
                                "de": "Diese Bäckerei gewährt jeder treuen <w>Kundin</w> einen Rabatt.",
                                "pl": "Ta piekarnia oferuje zniżkę każdej stałej <w>klientce</w>.",
                                "it": "Questa panetteria offre uno sconto a ogni <w>cliente</w> fedele.",
                                "cs": "Tato pekárna poskytuje každé věrné <w>zákaznici</w> slevu.",
                                "tr": "Bu fırın her sadık <w>müşteriye</w> indirim sunuyor.",
                                "es": "Esta panadería ofrece un descuento a cada <w>clienta</w> fiel.",
                                "zh": "这家面包店给每一位忠实的女<w>顾客</w>提供折扣。"
                            }
                        }
                    ],
