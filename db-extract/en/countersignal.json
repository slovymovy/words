                        "sense_id": "7d7ea69e-9d16-3f3d-877d-3a78648c416d",
                        "entry_id": "56979fe7-86d1-3393-9a55-2f7a32aa5b78",
                        "glosses": [
                            "To send a false or misleading signal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eca021eb-6e58-4293-ba8b-9d881f962a23",
                                "sense_id": "7d7ea69e-9d16-3f3d-877d-3a78648c416d",
                                "text": "But of course, Silicon Valley is a mecca of counter-signaling—witness the superstatus Zuckerbergian hoodie—and it's no surprise to discover that in the land of the billionaire dropout, an Internet entrepreneur like Thiel sees evidence that higher education inhibits innovation."
                            },
                            {
                                "example_id": "adc3f97d-f1a5-43f8-a8e0-1362e1804361",
                                "sense_id": "7d7ea69e-9d16-3f3d-877d-3a78648c416d",
                                "text": "Just as the logic of signaling attracts New Money to luxury, countersignaling directs the Old Money sensibility toward modesty."
                            }
                        ]
                    }
