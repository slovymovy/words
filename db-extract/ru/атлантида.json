                                        "entry_id": "61165dfa-1251-3afd-a31d-76b439dc142c",
                                        "glosses": [
                                            "nella filosofia di Platone è un luogo immaginario e surreale descritto con una civiltà sapiente ed evoluta, amante della verità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaba0791-a184-4cd6-ad2d-4836f30450b2",
                                                "sense_id": "0374f658-a509-3854-8c25-b4c9298a36c5",
                                                "text": "in Atlantide pare fossero presenti meravigliosi giardini a terrazze"
