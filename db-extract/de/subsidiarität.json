                "senses": [
                    {
                        "sense_id": "96650128-22e5-365f-a5bf-efed5daddcc2",
                        "entry_id": "69df7548-ced6-35e6-9b02-5c0463e0b9e0",
                        "glosses": [
                            "Verantwortung möglichst niedrigen Entscheidungsebenen zuweisen, um größtmögliche Selbstbestimmung zu erreichen"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dffeb090-4436-41f2-a97b-1722d1e44464",
                                "sense_id": "96650128-22e5-365f-a5bf-efed5daddcc2",
                                "text": "Das Prinzip der Subsidiarität entstammt der katholischen Soziallehre."
                            },
                            {
                                "example_id": "46b190ab-18d3-4a04-baae-ec0a1c2a1420",
                                "sense_id": "96650128-22e5-365f-a5bf-efed5daddcc2",
                                "text": "Das Prinzip der Subsidiarität in der EU bedeutet, dass Entscheidungen auf einer möglichst bürgernahen Ebene zu treffen sind."
                            },
                            {
                                "example_id": "b10e16de-493d-4815-8ab7-d1b3acf0473c",
                                "sense_id": "96650128-22e5-365f-a5bf-efed5daddcc2",
                                "text": "„Die hochgradige Komplexität des Lernfeldes erfordert Fächerkooperation, die sich zum Prinzip der Subsidiarität bekennt: Jedes beteiligte Fach beschränkt sich auf jene Aufgaben, die es besser lösen kann als andere Fächer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2116ea25-18bd-4b6a-b7b6-c58daff04959",
                        "source_entry_id": "69df7548-ced6-35e6-9b02-5c0463e0b9e0",
                        "source_sense_id": "96650128-22e5-365f-a5bf-efed5daddcc2",
                        "source_sense_description": "Verantwortung möglichst niedrigen Entscheidungsebenen zuweisen, um größtmögliche Selbstbestimmung zu erreichen",
                        "target_lang_word": "subsidiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsidiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6491cd0-7ced-3a39-a086-7b7d1a5a1ce2",
                                        "entry_id": "01f973ba-fc0a-3507-b1a6-53c33597e203",
                                        "glosses": [
                                            "The principle that initiative (whether in government, business or religion) ought to reside at the lowest feasible level (i.e. at the local or regional level, instead of the national or supranational level, unless the latter presents clear advantages)"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a41c12-040c-4fa6-abd0-bf9947b33239",
                                                "sense_id": "f6491cd0-7ced-3a39-a086-7b7d1a5a1ce2",
                                                "text": "According to the principle of subsidiarity, government should be as habitative as possible. Government functions must therefore be exercised at the most habitative level, as close as possible to those affected by the exercise of such functions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c2fb059-9f47-474f-8708-17108be87886",
                        "source_entry_id": "69df7548-ced6-35e6-9b02-5c0463e0b9e0",
                        "source_sense_id": "96650128-22e5-365f-a5bf-efed5daddcc2",
                        "source_sense_description": "Verantwortung möglichst niedrigen Entscheidungsebenen zuweisen, um größtmögliche Selbstbestimmung zu erreichen",
                        "target_lang_word": "subsidiarité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subsidiarité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0bef1e0-d2b0-3d35-8ea8-65cbaea611bd",
                                        "entry_id": "db1da090-ab17-3ad2-8575-8ea5be3fdfe2",
                                        "glosses": [
                                            "État de ce qui est subsidiaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ded9cba-be20-402a-99e9-f4f69025a0e5",
                                                "sense_id": "c0bef1e0-d2b0-3d35-8ea8-65cbaea611bd",
                                                "text": "Dans le cadre de l’obligation alimentaire, il faut mieux définir la subsidiarité entre la solidarité familiale et celle mise en place par les pouvoirs publics dans le cadre d’une protection sociale organisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3e85e20-866f-3c30-b85b-8484ba360a31",
                                        "entry_id": "db1da090-ab17-3ad2-8575-8ea5be3fdfe2",
                                        "glosses": [
                                            "État de ce qui est subsidiaire.",
                                            "En particulier dans les relations entres l'Union européenne et ses États membres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b073286a-7a4b-4766-a4ce-18e01e84f20f",
                                                "sense_id": "d3e85e20-866f-3c30-b85b-8484ba360a31",
                                                "text": "Le principe de subsidiarité."
                                            },
                                            {
                                                "example_id": "11820553-a394-4920-9763-e8d07e2265fb",
                                                "sense_id": "d3e85e20-866f-3c30-b85b-8484ba360a31",
                                                "text": "Le premier principe est celui de la subsidiarité : ne pas faire remonter à l'échelon national ce qui peut-être négocié à l'échelon local."
                                            },
                                            {
                                                "example_id": "d25f83df-6776-4b89-9598-00d36c6aaeac",
                                                "sense_id": "d3e85e20-866f-3c30-b85b-8484ba360a31",
                                                "text": "Conformément à l’article 5, paragraphe 3, du traité sur l'Union européenne, le principe de subsidiarité ne s’applique pas dans les domaines qui relèvent de la compétence exclusive de l’Union. Conformément à l’article 3, paragraphe 1, du TFUE, l’Union dispose d’une compétence exclusive dans le domaine de la politique monétaire pour les États membres dont la monnaie est l’euro. Dans ce domaine, aucune action de la part des États membres de la zone euro n’est possible et le principe de subsidiarité ne s’applique donc pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
