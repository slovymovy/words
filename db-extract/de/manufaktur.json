                        "form": "die Manufaktur"
                    },
                    {
                        "form_id": "a88055b1-1a56-4eca-bc9e-172234355ddb",
                        "entry_id": "82a5c4e4-392e-3664-8084-f73dc9c89e5b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Manufakturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "736c2799-1988-35f9-88a5-5a6f757ffbe8",
                        "entry_id": "82a5c4e4-392e-3664-8084-f73dc9c89e5b",
                        "glosses": [
                            "eine (historische) Produktionsstätte, in der gewerbliche Waren handwerklich in der Serie hergestellt werden, die Vorstufe zur Fabrik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bcee63-0113-4e42-b0d8-fe93b5aae479",
                                "sense_id": "736c2799-1988-35f9-88a5-5a6f757ffbe8",
                                "text": "„Die Manufaktur war ein zentralisierter Großbetrieb, in dem angestellte Arbeiter manuell an einem Ort bestimmte Produkte fertigten. Erst durch die Mechanisierung entstanden aus den Manufakturen sog. Fabriken. Um 1800 arbeiteten im Alten Reich etwa 1000 Manufakturen mit gut 100 000 Beschäftigten.“"
                            },
                            {
                                "example_id": "29c83f24-d636-4b3c-87fe-8d30e22228aa",
                                "sense_id": "736c2799-1988-35f9-88a5-5a6f757ffbe8",
                                "text": "„Ich sagte, nach der Krise würde ich wiederkommen und ihr einen von den schönen Pullovern abkaufen, die in der Manufaktur zum Verkauf angeboten wurden.“"
                            },
                            {
                                "example_id": "014399bf-cdcd-45f9-acf7-fd16305bd145",
                                "sense_id": "736c2799-1988-35f9-88a5-5a6f757ffbe8",
                                "text": "„Es war das erste Mal, dass er hier einen Gegenstand sah, der aus einer Manufaktur stammte.“"
                            },
                            {
                                "example_id": "c88b2fb9-edc3-4c5b-a9ab-f84db8c31129",
                                "sense_id": "736c2799-1988-35f9-88a5-5a6f757ffbe8",
                                "text": "„Der Gedanke, Leiter einer Manufaktur zu werden, gefiel mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3536afa6-0330-4989-a009-ec82670aa420",
                        "source_entry_id": "82a5c4e4-392e-3664-8084-f73dc9c89e5b",
                        "source_sense_id": "736c2799-1988-35f9-88a5-5a6f757ffbe8",
