                                "sense_id": "0ebfbfda-b440-364b-97c5-235f01be7f84",
                                "text": "Meine Enkeltochter geht noch zur Schule."
                            },
                            {
                                "example_id": "a0575359-78d8-4911-a375-5f84b1d2c5d7",
                                "sense_id": "0ebfbfda-b440-364b-97c5-235f01be7f84",
                                "text": "„Eines Tages äußerte ihre damals 17-jährige Enkeltochter den Wunsch, sie in den Hörsaal zu begleiten.“"
                            },
                            {
                                "example_id": "50081bc9-7c24-4a49-bc67-9d96d436d80c",
                                "sense_id": "0ebfbfda-b440-364b-97c5-235f01be7f84",
                                "text": "„Das ist Alice, Ihre Enkeltochter.“"
                            }
                        ],
