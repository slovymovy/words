                        "entry_id": "17ed24b5-a141-3496-b268-195843ea6628",
                        "glosses": [
                            "Nom usuel des plantes du genre Draba de la famille des Brassicaceae (Brassicacées) (anciennement crucifères) généralement alpines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e81adc-e404-4be2-aa5d-70e6deba2dbc",
                                "sense_id": "3172971a-5b65-3363-b445-7210c1c0ea77",
                                "text": "La drave vernale est appelée mignonnette par les jardiniers."
                            }
                        ]
