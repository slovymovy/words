    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "047410fa-aa93-3beb-be63-dd8b877e8716",
                    "sense_definition": "Étendre une matière molle ou liquide en couche régulière sur une surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "application_matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux <w>étaler</w> un peu de beurre sur cette tranche de pain frais."
                        },
                        {
                            "text": "Le cuisinier commence à <w>étaler</w> la pâte avec un rouleau en bois."
                        }
                    ],
                    "synonyms": [
                        "tartiner",
                        "appliquer"
                    ],
                    "common_phrases": [
                        "étaler du beurre",
                        "étaler la pâte",
                        "étaler de la confiture"
                    ]
                },
                {
                    "sense_id": "d8c637a6-f5f9-3148-b614-76596bd7852d",
                    "sense_definition": "Déployer ou disposer des objets sur une surface pour les rendre bien visibles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disposition_objets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant va <w>étaler</w> ses documents sur la table pour préparer son examen."
                        },
                        {
                            "text": "Elle a <w>étalé</w> toutes ses photos de vacances afin de les montrer à ses amis."
                        }
                    ],
                    "synonyms": [
                        "déployer",
                        "éparpiller",
                        "disposer"
                    ],
                    "antonyms": [
                        "ranger",
                        "ramasser"
                    ],
                    "common_phrases": [
