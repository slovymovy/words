                "senses": [
                    {
                        "sense_id": "26a2c3a6-a7b0-3de6-bbe7-0763b06e519a",
                        "entry_id": "25cd4bde-9889-3db1-a912-e0f22f15fc9d",
                        "glosses": [
                            "Funktionsverlust eines Stellwerks auf Grund verschiedener Ursachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29df00e0-0953-4e01-be1b-ba021ac8199f",
                                "sense_id": "26a2c3a6-a7b0-3de6-bbe7-0763b06e519a",
                                "text": "„Ein Stellwerkausfall hat am Mittwochmorgen in Dortmund und der Region für massive Probleme im Bahnverkehr gesorgt.“"
                            },
                            {
                                "example_id": "32fb772f-8f32-4ce5-bad4-50068562427a",
                                "sense_id": "26a2c3a6-a7b0-3de6-bbe7-0763b06e519a",
                                "text": "„Auf Grund des Stellwerkausfalls kam der ICE mit der Mannschaft von Hannover 96 mit 84-minütiger Verspätung in Frankfurt an.“"
                            },
                            {
                                "example_id": "31e7ab1e-f69d-496e-9e47-b5b257ee27a2",
                                "sense_id": "26a2c3a6-a7b0-3de6-bbe7-0763b06e519a",
                                "text": "„Ein kompletter Stellwerkausfall am Biesdorfer Kreuz hat bereits gestern von 15.50 Uhr an dazu geführt, daß der Bahnverkehr teilweise lahmgelegt wurde.“"
                            },
                            {
                                "example_id": "713c7798-0ccf-4285-806e-3b9c171f7733",
                                "sense_id": "26a2c3a6-a7b0-3de6-bbe7-0763b06e519a",
                                "text": "„Ein Stellwerkausfall im Hauptbahnhof Hannover hat zu erheblichen Behinderungen im Berufsverkehr geführt.“"
                            },
                            {
                                "example_id": "14eeaaab-feb7-46ce-8503-c2fd12691196",
                                "sense_id": "26a2c3a6-a7b0-3de6-bbe7-0763b06e519a",
                                "text": "„Die Nordwest-Bahn fühlt sich durch Bahnübergangsstörungen, Stellwerkausfälle, festgefrorene Weichen, Langsamfahrstellen und Personalausfälle bei DB Netz ausgebremst.“"
                            }
                        ],
