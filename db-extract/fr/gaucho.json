                                "target_senses": [
                                    {
                                        "sense_id": "f5b7ee96-b4cd-33a9-99bb-2135c29de064",
                                        "entry_id": "68d6ed09-ce86-32ca-b293-1c141db27881",
                                        "glosses": [
                                            "A cowboy of the South American pampas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dceb4a1-003c-4423-8885-1219bcfa0f0d",
                                                "sense_id": "f5b7ee96-b4cd-33a9-99bb-2135c29de064",
                                                "text": "Theirs was the spirit which upheld Darwin among the gauchos of the Argentine or Wallace among the head-hunters of Malaya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd26459b-c239-380b-8da6-a62956efc74d",
