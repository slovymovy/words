                "senses": [
                    {
                        "sense_id": "3d64de3e-188c-3e21-8945-1d123b3b5ead",
                        "entry_id": "a68e78f4-830d-3139-8e30-f1c84c8463f4",
                        "glosses": [
                            "Affaiblir, donner mauvaise apparence à."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a1928ab8-e34a-4db9-8806-405bf0bda490",
                                "sense_id": "3d64de3e-188c-3e21-8945-1d123b3b5ead",
                                "text": "Surpris de ma figure débiffée et barbouillée de sang, mon père ne dit pas un mot"
                            },
                            {
                                "example_id": "0ce44c8f-2bf7-487f-ae3b-046e42e218a3",
                                "sense_id": "3d64de3e-188c-3e21-8945-1d123b3b5ead",
                                "text": "Elle ne ressemble pas à celle de Cadmus ou de Malplaquet, où le prétendu victorieux se trouve plus débiffé & plus éclopé que le vaincu."
                            },
                            {
                                "example_id": "c55083a8-27cb-4079-96cb-9e979641ebc8",
                                "sense_id": "3d64de3e-188c-3e21-8945-1d123b3b5ead",
                                "text": "Si un Serin a le flux de ventre, ce qui se voit facilement lorsque, tout débiffé, il remue et serre sa queue, et que sa fiente est liquide, dans ce cas il faut lui déplumer la partie qui avoisine l’anus,et le lui graisser d’huile d’amende douce ou de beurre frais, et ensuite lui donner de la graine de laitue et de melon mondé pendant quatre ou cinq jours."
                            }
                        ]
                    }
                ],
