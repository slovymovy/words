                "senses": [
                    {
                        "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                        "entry_id": "6a6aae60-7fd0-36c5-88c0-d677c9d9f4c1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d4455a-177c-439a-a66e-dedd75d5ea04",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Frau Trump ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8e1dc86a-67b7-499c-8487-1bc5d8d6e477",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Herr Trump wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c8fe2af4-6614-4638-b8ba-e14aed839b7c",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Die Trumps fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ad22b22b-3a71-4499-a073-d745765ae51d",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Der Trump trägt nie die Schals, die die Trump ihm strickt."
                            },
                            {
                                "example_id": "5f39d6b5-0734-4175-8374-efd1e7648b86",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Trump kommt, geht der Herr Trump.“"
                            },
                            {
                                "example_id": "9846f84b-04fb-47e9-9a3b-2815c65e9984",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Trump kommt und geht."
                            },
                            {
                                "example_id": "4a4804a2-f2c7-4800-a001-3f6d80c0fd02",
                                "sense_id": "74177c99-c7fb-37f2-b4ac-b915fde113b3",
                                "text": "Trumps kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
