                "senses": [
                    {
                        "sense_id": "9cfc227a-e1e4-3164-afd3-8da12f3ea327",
                        "entry_id": "b58ad32f-c39f-3d1b-9dc9-2adee5f3ff2e",
                        "glosses": [
                            "Agentur für Gesundheit und Ernährungssicherheit mit Sitz in Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f5356d-f6d7-47dc-8012-0f763e9ff768",
                                "sense_id": "9cfc227a-e1e4-3164-afd3-8da12f3ea327",
                                "text": "Die Aufgaben der AGES bestehen in Untersuchungen und Begutachtungen u.a. nach dem Lebensmittelgesetz."
                            },
                            {
                                "example_id": "5a5ff78e-69b5-4f65-a8d9-49a2783b5cd4",
                                "sense_id": "9cfc227a-e1e4-3164-afd3-8da12f3ea327",
                                "text": "Zum Aufgabegebiet der AGES genören „insbesondere auch die Mitwirkung bei der Bekämpfung von Infektionskrankheiten, Epidemien und Pandemien.“"
                            },
                            {
                                "example_id": "ddeda583-d2d5-499f-82c4-8ad82e8f2928",
                                "sense_id": "9cfc227a-e1e4-3164-afd3-8da12f3ea327",
                                "text": "Zur Erreichung der in § 8 Abs. 3 Z 6 GESG genannten Aufgaben werden der Österreichischen Agentur für Gesundheit und Ernährungssicherheit GmbH (im Folgenden: AGES) die Durchführung des Lehrbetriebs gemäß den §§ 2 und 3 für Schüler der Höheren Landwirtschaftlichen Bundeslehranstalt Francisco Josephinum Wieselburg als weitere Aufgabe übertragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
