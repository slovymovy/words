                    {
                        "sense_id": "96d9f07a-430b-3b9f-ac63-eeff6b484252",
                        "entry_id": "4eaaf14d-7fb6-3e53-8994-c89486ed4834",
                        "glosses": [
                            "een versierde paal of boom die men plant op 30 april of 1 mei maar soms ook rond Pinksteren of tijdens het Midzomerfeest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e5076b-2cbd-4bc5-a8bb-343704e5fee9",
                                "sense_id": "96d9f07a-430b-3b9f-ac63-eeff6b484252",
                                "text": "Wie genoeg energie heeft gekregen van de aardappelcurry, kan onder een versierde meiboom een koptelefoon opzetten voor de silent disco. \"Ieder mens probeert zich wel ergens van te bevrijden. Hopelijk komen de bezoekers op 5 mei dansend uit hun harnas.\""
                            },
                            {
                                "example_id": "0b6a7cde-dd74-4448-be76-70870854cc78",
                                "sense_id": "96d9f07a-430b-3b9f-ac63-eeff6b484252",
                                "text": "De 75-jarige sv Bon Boys valt dit jaar de eer te beurt om een schildje te onthullen in de Meiboom aan de Molenstraat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ef091d2-052f-4cd7-8490-7c9ed1b1c5d8",
                        "source_entry_id": "4eaaf14d-7fb6-3e53-8994-c89486ed4834",
                        "source_sense_id": "96d9f07a-430b-3b9f-ac63-eeff6b484252",
