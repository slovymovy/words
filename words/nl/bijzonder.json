                        "bijzondere eigenschap"
                    ],
                    "target_lang_definitions": {
                        "en": "having its own, sometimes strange or specific quality",
                        "ru": "обладающий собственным, иногда странным или специфическим качеством"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "particular",
                                "target_lang_sense_clarification": "specific or distinct from others"
                            },
                            {
                                "target_lang_word": "peculiar",
                                "target_lang_sense_clarification": "strange or unusual; unique to one person or thing"
                            },
                            {
                                "target_lang_word": "unique",
                                "target_lang_sense_clarification": "being the only one of its kind"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "своеобразный",
