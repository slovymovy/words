                    }
                ],
                "senses": [
                    {
                        "sense_id": "0624d2c8-86fc-3213-83b7-7e5c4bef1d65",
                        "entry_id": "5252c866-5346-325b-8646-3a62882d18d8",
                        "glosses": [
                            "разг. ласк. к бабушка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fff4c16-5d81-42d5-ac5c-703e0f041aee",
                                "sense_id": "0624d2c8-86fc-3213-83b7-7e5c4bef1d65",
                                "text": "— Люблю пошутить, — сказал ей Митя и повернулся к бабушке: — А тебе, бабуся, пойти бы прилечь."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0f31c26-cc3b-3f8c-a3ee-88182a0f7217",
                        "entry_id": "5252c866-5346-325b-8646-3a62882d18d8",
                        "glosses": [
                            "разг."
                        ],
                        "tags": [
                            "употребляется как фамильярно-ласковое обращение к пожилой женщине"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caf82dc6-b07d-4ff5-b3b3-2ecd8c98172b",
                        "source_entry_id": "5252c866-5346-325b-8646-3a62882d18d8",
                        "source_sense_description": "ласк. к бабушка",
                        "target_lang_word": "grandma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f96802d3-46ea-389b-ad43-7398ac6a9b40",
                                        "entry_id": "784d78cb-7a84-36a3-859e-668981f164be",
                                        "glosses": [
                                            "Grandmother."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grandma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02d4b950-65b8-3e4d-8ad9-b5a546d85b04",
                                        "entry_id": "1ea16d5a-8f57-375c-8fce-08f360188646",
                                        "glosses": [
                                            "To address (someone) as “grandma”."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794084cb-5091-4885-8e99-f216a01308f5",
                                                "sense_id": "02d4b950-65b8-3e4d-8ad9-b5a546d85b04",
                                                "text": "This Laura had died within a year of her marriage, but Lottie had claimed relationship to the family just the same, grandma-ing Mrs. Richards and aunty-ing the sisters. John, however, was never called uncle, except in fun."
                                            },
                                            {
                                                "example_id": "e2a11ae7-7c24-4559-bce9-520f982a27cd",
                                                "sense_id": "02d4b950-65b8-3e4d-8ad9-b5a546d85b04",
                                                "text": "“But Grandma—,” I said. […] “And don’t you go ‘Grandma-ing’ me neither,” she said."
                                            },
                                            {
                                                "example_id": "2ae186a5-3074-4c0c-8449-4b7ee4eac6d6",
                                                "sense_id": "02d4b950-65b8-3e4d-8ad9-b5a546d85b04",
                                                "text": "“Gran-” Nancy started. / “Quit Grandma-ing me girl.[…]” Grandma Wilson insisted."
                                            },
                                            {
                                                "example_id": "1c625ae4-c260-49fd-ab18-1ddbb35730b8",
                                                "sense_id": "02d4b950-65b8-3e4d-8ad9-b5a546d85b04",
                                                "text": "“He can be my doctor anytime.” / “Grandma, eww!” / “Oh, stop grandma-ing me. You know I hate that. Come introduce us.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429f6b54-2d6c-399a-a683-eb4f8c7cae42",
                                        "entry_id": "1ea16d5a-8f57-375c-8fce-08f360188646",
                                        "glosses": [
                                            "To be or act as a grandmother to (someone)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72751d34-7854-4642-b1c4-c141b08f41e1",
                                                "sense_id": "429f6b54-2d6c-399a-a683-eb4f8c7cae42",
                                                "text": "And what about Cliff working on cars and painting signs, and Wendy working nights to take care of that baby, and young Allen raking leaves for everyone, and Doris grandmaing folks, and wounded folks bouncing back to life . . . ?”"
                                            },
                                            {
                                                "example_id": "5a699df9-7eb8-422c-a649-6ae8683e32b7",
                                                "sense_id": "429f6b54-2d6c-399a-a683-eb4f8c7cae42",
                                                "text": "“I don’t want you to be a grandma.” / But why, I wondered, worried that he perceived some defect in my grandma-ing ability. Doesn’t he think I’ll be a good grandma?"
                                            },
                                            {
                                                "example_id": "89343070-bdd3-42c1-8e8d-0ea56ac44523",
                                                "sense_id": "429f6b54-2d6c-399a-a683-eb4f8c7cae42",
                                                "text": "Each is grandma’s favorite child / For them, ever tireless and without guile / They have a special place in her heart / She makes grandma’ing a work of art."
                                            },
                                            {
                                                "example_id": "37e23995-731f-4ddb-afc6-6f8e1791484f",
                                                "sense_id": "429f6b54-2d6c-399a-a683-eb4f8c7cae42",
                                                "text": "2. to act like a grandparent (moving slowly and carefully). {ʔuʔhúy t suʔsíyaʔs. She was just grandma-ing. (MJT)}"
                                            },
                                            {
                                                "example_id": "2ec8d27c-d29e-462e-87a9-fb353c8d90e3",
                                                "sense_id": "429f6b54-2d6c-399a-a683-eb4f8c7cae42",
                                                "text": "Her apron looks like a black belt in grandma-ing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c2fa1e-d4b4-4d34-baac-9208d72256f4",
