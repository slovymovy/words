                "senses": [
                    {
                        "sense_id": "4e1b15eb-ad2b-37ba-af1f-0073d2397ccf",
                        "entry_id": "5402e736-eb46-32d1-9287-8e386898ede2",
                        "glosses": [
                            "Érythrone, ou Erythronium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3086aa53-402a-4cfd-8ef8-dceb192cddef",
                                "sense_id": "4e1b15eb-ad2b-37ba-af1f-0073d2397ccf",
                                "text": "Ces jolies petites clochettes jaunes perchées en haut d’une fine tige d’environ trente centimètres sont celles de l’érythronium."
                            }
                        ]
                    },
                    {
                        "sense_id": "52a53057-cb9c-361e-82b6-cb184cddb497",
                        "entry_id": "5402e736-eb46-32d1-9287-8e386898ede2",
                        "glosses": [
                            "Nom que le chimiste mexicain Andrés Manuel del Río donna au vanadium, lors de sa découverte."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d1590b1d-b3ba-4359-bb01-07f3f729fdb3",
                                "sense_id": "52a53057-cb9c-361e-82b6-cb184cddb497",
                                "text": "Peu de temps après, le même minéral ayant été soumis à l’analyse par Collet Descotils, celui-ci annonça que l’érythronium n’était que du chrome impur."
                            },
                            {
                                "example_id": "beea72ba-8bc7-4b09-9866-ebe9ed41b71f",
                                "sense_id": "52a53057-cb9c-361e-82b6-cb184cddb497",
                                "text": "ÉRYTHRONIUM, s. m., erythronium. Nom donné par Del Rio à un métal particulier, dont il aperçut l’existence en 1801, que Collet Descotils crut être du chrome impur, et que Woehler a reconnu être le vanadium."
                            }
                        ]
                    }
                ],
