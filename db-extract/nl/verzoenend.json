                                        "glosses": [
                                            "Inclined to forgive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df261efc-54dc-4ab8-bb5c-2c8aee7f719e",
                                                "sense_id": "e8b96180-72c9-309b-8749-8c6e3c569eb9",
                                                "text": "I am inclined to take a forgiving attitude, since this is his first offence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900891c9-9c31-3c54-9090-55e989ea41d9",
                                        "entry_id": "5f1aadf6-11fd-3167-bc5d-7f563be01841",
                                        "glosses": [
                                            "User-friendly, such that harmful mistakes are not easily made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c679ca6-f4b5-4897-8259-759383d793bf",
                                                "sense_id": "900891c9-9c31-3c54-9090-55e989ea41d9",
                                                "text": "A good WebApp interface is understandable and forgiving, providing the user with a sense of control. […] Work is carefully and continuously saved, with full option for the user to undo any activity at any time."
                                            }
                                        ]
                                    }
                                ]
                            },
