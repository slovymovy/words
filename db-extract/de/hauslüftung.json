                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df5891d4-c709-42bb-8115-e5e4227a7c5a",
                                "sense_id": "92b4e5ea-d334-3676-8f7e-d1f144650350",
                                "text": "„Sie können Frischluftkomfort mit Wärmerückgewinnung für Einzelräume oder als zentrale Hauslüftung nutzen.“"
                            },
                            {
                                "example_id": "ea7dd397-120a-472c-b1b5-9a92dffd4ce3",
                                "sense_id": "92b4e5ea-d334-3676-8f7e-d1f144650350",
                                "text": "„Wir besitzen das Know-how, um Ihnen je nach Bausubstanz, Dämmsituation und weiteren Faktoren die geeignete und wirtschaftlichste Lösung zur Hauslüftung vorzuschlagen.“"
                            },
                            {
                                "example_id": "da80b341-fa2a-4035-80e3-8d361eb821d3",
                                "sense_id": "92b4e5ea-d334-3676-8f7e-d1f144650350",
                                "text": "„Bisher erfolgt die Steuerung dieser Hauslüftung mittels 3-Stufenschalter oder Schaltuhr.“"
                            },
                            {
                                "example_id": "9135f75c-80dd-46bd-97ae-50013f246c8f",
                                "sense_id": "92b4e5ea-d334-3676-8f7e-d1f144650350",
                                "text": "„Besonders kompakt präsentiert sich unsere ausgereifte Technologie, die zentrale Hauslüftung.“"
                            },
                            {
                                "example_id": "13d4f10f-e898-4171-ad80-7ff966461870",
                                "sense_id": "92b4e5ea-d334-3676-8f7e-d1f144650350",
                                "text": "„Ständig sind innovative Produkte rund um die Hauslüftung in der Pipeline.“"
