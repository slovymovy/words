                        "glosses": [
                            "An advocate of egoism."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae51fb0d-06eb-371e-956d-2a02687b24b5",
                        "entry_id": "806d008b-23de-3ce7-9547-8f3300d9bd6c",
                        "glosses": [
                            "An egocentric or self-centered person."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a374a0a-15b0-308d-bc30-78ff29ce0bb0",
                        "entry_id": "806d008b-23de-3ce7-9547-8f3300d9bd6c",
                        "glosses": [
                            "An egotist (person who talks excessively about themselves)."
                        ],
                        "tags": [
                            "nonstandard"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6c46afe-da28-4a49-8fe9-3e88b5ed9f34",
                        "source_entry_id": "806d008b-23de-3ce7-9547-8f3300d9bd6c",
                        "source_sense_description": "advocate of egoism",
                        "target_lang_word": "égoïste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égoïste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f870420e-65ed-3ff3-b1d9-db5cbfe72d66",
                                        "entry_id": "ca7c61bd-6913-3175-bec0-e80484d31a1a",
                                        "glosses": [
                                            "Qui ne pense qu'à soi, à ses intérêts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c9db4d-92fc-4af5-8695-070a962a7ab0",
                                                "sense_id": "f870420e-65ed-3ff3-b1d9-db5cbfe72d66",
                                                "text": "Avec beaucoup de tact, ce vieillard, qui savait n’être ni autoritaire ni égoïste, s’efforçait de gagner l’affection de Nazira et de se faire pardonner d’être vieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b18377ce-2a5c-3390-9465-23daeaa4a154",
                                        "entry_id": "ca7c61bd-6913-3175-bec0-e80484d31a1a",
                                        "glosses": [
                                            "Qui découle principalement ou entièrement du souci de soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb6021d-3350-4b61-8742-85ebc36c7e7b",
                                                "sense_id": "b18377ce-2a5c-3390-9465-23daeaa4a154",
                                                "text": "Débusquer les bases biologiques d’un comportement n’enlève rien à l’humanisme du geste ni au libre arbitre : nous demeurons toujours libres de choisir entre un geste altruiste ou égoïste."
                                            },
                                            {
                                                "example_id": "feef2377-36ce-4094-b428-d066da3708ad",
                                                "sense_id": "b18377ce-2a5c-3390-9465-23daeaa4a154",
                                                "text": "Le fait d’éprouver de la joie à faire le bien d’autrui, ou d’en retirer de surcroît des bienfaits pour soi-même, ne rend pas, en soi, un acte égoïste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "égoïste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3827849a-edd3-352b-9393-9621d2aa8538",
                                        "entry_id": "ae805ce8-538b-3f1b-9b36-0aab85bf7c76",
                                        "glosses": [
                                            "Celui, celle qui met en pratique l’égoïsme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66de232a-5d01-4c18-bfb1-9ea5b715cf73",
                                                "sense_id": "3827849a-edd3-352b-9393-9621d2aa8538",
                                                "text": "En trouvant sous le poète un égoïste ambitieux, la pire espèce de tous les égoïstes, car il en est d’aimables, Ernest éprouva je ne sais quelle pudeur à le quitter."
                                            },
                                            {
                                                "example_id": "c1ce8697-f2bb-48a1-966c-2d6ea536f1a3",
                                                "sense_id": "3827849a-edd3-352b-9393-9621d2aa8538",
                                                "text": "Un sale égoïste, voilà ce que tu es, préoccupé seulement de ta propre personne. Je ne sais pas pourquoi j'ai perdu mon temps avec un conard pareil. Fiche le camp !"
                                            },
                                            {
                                                "example_id": "c28f6ac3-286b-4c7f-b0bc-a886b56983a1",
                                                "sense_id": "3827849a-edd3-352b-9393-9621d2aa8538",
                                                "text": "En vérité, l’égoïste pèche principalement par ignorance. S’il comprenait mieux les mécanismes du bonheur et de la souffrance, il accomplirait son propre bien en faisant preuve de bonté à l’égard d’autrui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27975c16-3200-450a-b1e7-0cbf8b1cd310",
                        "source_entry_id": "806d008b-23de-3ce7-9547-8f3300d9bd6c",
                        "source_sense_description": "advocate of egoism",
                        "target_lang_word": "Egoist",
