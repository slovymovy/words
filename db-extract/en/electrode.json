                                        "entry_id": "0f8b22e7-d1c8-3e3c-beea-9993b81b8b74",
                                        "glosses": [
                                            "końcówka przewodnika pozostającego w kontakcie ze środowiskiem, do którego doprowadza lub z którego odprowadza prąd elektryczny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b9f250-09c8-45e9-a2b6-243fb7a61338",
                                                "sense_id": "7ec5077c-0a52-39b5-810f-15cf3d9f52c2",
                                                "text": "Anoda w urządzeniach generujących siłę elektromotoryczną, np. akumulatorach, jest elektrodą ujemną, w urządzeniach absorbujących siłę elektromotoryczną, np. elektrolizerach, jest elektrodą dodatnią, a w lampach elektronowych jest elektrodą dodatnią."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c02b0a10-64db-4cc1-a9ed-671a2eb0f0e4",
                        "source_entry_id": "9328f034-f03b-3483-9222-277fa082d984",
