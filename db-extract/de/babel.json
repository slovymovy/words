                        "form": "das Babel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e939fe0-6fce-30f2-90a4-174d16947aba",
                        "entry_id": "0fd29eb2-8e53-3cd0-af93-91ae9755d897",
                        "glosses": [
                            "hebräischer Name für Babylon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ec6eab0-dfca-48e9-ac50-71052d833cf0",
                                "sense_id": "6e939fe0-6fce-30f2-90a4-174d16947aba",
                                "text": "Wir denken bei der Stadt zuerst an die biblische Geschichte vom Turmbau zu Babel."
                            },
                            {
                                "example_id": "dacecc1f-8095-46c9-98a3-670d570e9223",
                                "sense_id": "6e939fe0-6fce-30f2-90a4-174d16947aba",
                                "text": "„An den Strömen Babels, da saßen wir und weinten, wenn wir an Zion dachten“"
                            },
                            {
                                "example_id": "e0707eea-1242-47cb-b64e-270487c57340",
                                "sense_id": "6e939fe0-6fce-30f2-90a4-174d16947aba",
                                "text": "„›Bei den Wassern Babels saßen",
                                "translation": "Kennst du noch das alte Lied?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab41bc15-b7c9-3ac0-8766-d1e207dcfec6",
                        "entry_id": "0fd29eb2-8e53-3cd0-af93-91ae9755d897",
                        "glosses": [
                            "Ort, an dem ein Durcheinander von verschiedenen Sprachen zu hören ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c73fec-0dde-4615-8237-652b72022896",
                                "sense_id": "ab41bc15-b7c9-3ac0-8766-d1e207dcfec6",
                                "text": "„Eine Rückkehr zum Zustand vor Babel, zur Einheit vor dem Wirrsal, ist immer wieder versucht worden - über die Wissenschaftssprache Latein, eine philosophische Sprache der Logik, die Algorithmen der Programmiersprachen.“"
                            },
                            {
                                "example_id": "f27e787a-37e5-4f55-96bf-307a3a1b57cb",
                                "sense_id": "ab41bc15-b7c9-3ac0-8766-d1e207dcfec6",
                                "text": "Berlin ist ein Babel – besuche doch mal eine Hauptschule in Neukölln!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0998537b-3895-3fbe-b1d6-5764f4bf7376",
                        "entry_id": "0fd29eb2-8e53-3cd0-af93-91ae9755d897",
                        "glosses": [
                            "lasterhafter Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6720e0b-7e7f-46b4-8edc-a5ddbfd445f2",
                                "sense_id": "0998537b-3895-3fbe-b1d6-5764f4bf7376",
                                "text": "„»Hahaha. Ich erkenne dich, deutsche Tugendhaftigkeit … Paris sagt man nicht, sondern, mit frommem Schauder, ‚das Babel an der Seine‘.«“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1650c19e-8e90-4016-8312-0db30fbd0cec",
                        "source_entry_id": "0fd29eb2-8e53-3cd0-af93-91ae9755d897",
                        "source_sense_id": "6e939fe0-6fce-30f2-90a4-174d16947aba",
