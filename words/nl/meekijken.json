                {
                    "sense_id": "31d190d4-cd67-3818-9591-748a0b229025",
                    "sense_definition": "samen met iemand anders ergens naar kijken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "samen kijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we vanavond gezellig samen <w>meekijken</w> naar de finale van het songfestival?",
                            "target_lang_translations": {
                                "en": "Shall we <w>watch</w> the Eurovision final <w>together</w> tonight?"
                            }
                        },
                        {
                            "text": "Je kunt live <w>meekijken</w> via de website terwijl de presentatie bezig is.",
                            "target_lang_translations": {
                                "en": "You can <w>watch along</w> live via the website while the presentation is in progress."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "live meekijken",
                        "gezellig meekijken"
                    ],
                    "target_lang_definitions": {
                        "en": "To watch something together with someone else."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch along",
                                "target_lang_sense_clarification": "to view something simultaneously with others"
                            },
                            {
                                "target_lang_word": "watch with",
                                "target_lang_sense_clarification": "to join someone in viewing something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6279647a-e367-3b65-9cc6-cc89f2bff047",
                    "sense_definition": "observeren wat iemand anders aan het doen is, vaak om te controleren of te helpen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "observeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De helpdeskmedewerker kan op afstand <w>meekijken</w> op je scherm om het probleem op te lossen.",
                            "target_lang_translations": {
                                "en": "The helpdesk employee can <w>view</w> your screen remotely to solve the problem."
                            }
                        },
                        {
                            "text": "Ik vind het niet prettig als mensen over mijn schouder <w>meekijken</w> terwijl ik typ.",
                            "target_lang_translations": {
                                "en": "I don't like it when people <w>look over my shoulder</w> while I am typing."
                            }
                        }
                    ],
                    "synonyms": [
                        "observeren",
                        "controleren"
                    ],
                    "common_phrases": [
                        "over de schouder meekijken",
                        "op afstand meekijken"
                    ],
                    "target_lang_definitions": {
                        "en": "To observe what someone else is doing, often to check, monitor, or assist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look on",
                                "target_lang_sense_clarification": "to observe someone's actions"
                            },
                            {
                                "target_lang_word": "watch over someone's shoulder",
                                "target_lang_sense_clarification": "to monitor what someone is doing closely"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "to remotely or directly observe a screen or process"
                            }
                        ]
                    }
                }
            ]
        }
    ]
