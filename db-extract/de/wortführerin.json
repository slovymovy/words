                        ]
                    },
                    {
                        "translation_id": "749349fe-a2e1-4afe-a024-8a30a1698801",
                        "source_entry_id": "2571dd97-7171-3572-8989-5ef3a2beda77",
                        "source_sense_id": "01b0b9b2-b826-3646-80a0-fdf23a7c43f6",
