                "senses": [
                    {
                        "sense_id": "5e7cef56-f17b-3399-a241-88d1a267cf3e",
                        "entry_id": "f29adb0c-4385-38a8-9ebb-a9da11f77c04",
                        "glosses": [
                            "sechzehnter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c259c1-daa5-4b38-b8dd-6afc6806bdfc",
                                "sense_id": "5e7cef56-f17b-3399-a241-88d1a267cf3e",
                                "text": "Ottakring hatte viele traditionsreiche Industrie- und Gewerbebetrie, wie die Ottakringer Brauerei, die Bekleidungsfabrik Fürnkranz und der Lebensmittelkonzern Julius Meinl."
                            },
                            {
                                "example_id": "660368db-68fb-42fe-94bb-bd1578ab55f7",
                                "sense_id": "5e7cef56-f17b-3399-a241-88d1a267cf3e",
                                "text": "In Ottakring gibt es viele künstlerisch oder historisch Wertvolle Plätze, Gebäude oder Objekte zu entdecken."
                            },
                            {
                                "example_id": "5152041f-4211-4529-9382-1182a05de627",
                                "sense_id": "5e7cef56-f17b-3399-a241-88d1a267cf3e",
                                "text": "Schätzungen zufolge ist die Ottakringer Gegend seit dem 9. Jahrhundert besiedelt, erstmals tatsächlich urkundlich erwähnt wurde Ottakring Mitte des 12. Jahrhunderts im Zusammenhang mit einer Weingartenschenkung."
                            },
                            {
                                "example_id": "169c0d1d-3c69-46c1-b7ef-5ca47ed45443",
                                "sense_id": "5e7cef56-f17b-3399-a241-88d1a267cf3e",
                                "text": "Ottakring entwickelte sich zu einem Zentrum der Arbeiterbewegung und entsandte 1900 in der Person Franz Schuhmeiers einen der beiden ersten Sozialdemokraten in den Wiener Gemeinderat (der andere war im 10. Bezirk Jakob Reumann)."
                            },
                            {
                                "example_id": "7bbff348-be6d-4218-8911-ff1cbb700bc7",
                                "sense_id": "5e7cef56-f17b-3399-a241-88d1a267cf3e",
                                "text": "1892 wurden Ottakring und Neulerchenfeld offiziell zum 16. Wiener Gemeindebezirk Ottakring zusammengelegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
