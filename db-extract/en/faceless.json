    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                "word": "faceless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bc6d8030-fda0-4b1e-8630-5166d1c8961c",
                        "entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more faceless"
                    },
                    {
                        "form_id": "e4675c58-7e4f-4e7f-8d97-447131e08a8d",
                        "entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most faceless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "321dcc8d-ea03-3953-92a0-79ff2f98b50b",
                        "entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                        "glosses": [
                            "Having no face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9515957-a0ed-4397-a02b-74d880f3aa53",
                                "sense_id": "321dcc8d-ea03-3953-92a0-79ff2f98b50b",
                                "text": "These vague, faceless spectres from my ramblesome past have as much right as anyone else to be ranked among the salvors of the Navy's songs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce1a7c9e-39ed-3120-8b74-9609decb7cec",
                        "entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                        "glosses": [
                            "Having or revealing no individual identity or character; anonymous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135d48b8-6124-45a9-b9b4-ca90f55f19db",
                                "sense_id": "ce1a7c9e-39ed-3120-8b74-9609decb7cec",
                                "text": "A faceless mob attacked the Capitol building."
                            },
                            {
                                "example_id": "68206d5d-0a36-4148-a14b-a1e7423bf400",
                                "sense_id": "ce1a7c9e-39ed-3120-8b74-9609decb7cec",
                                "text": "With assembly line consistency, Martin receives countless rejections from faceless editors—a triggering reminder for any literary hopeful navigating the modern culture industry."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bf5da71-5a81-3a99-88e5-41711d59c002",
                        "entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                        "glosses": [
                            "Having or revealing no individuality, personality or distinctive characteristics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0df1a1f-ae8e-4581-818b-a07f084ebb86",
                                "sense_id": "9bf5da71-5a81-3a99-88e5-41711d59c002",
                                "text": "I started working for a faceless corporation."
                            },
                            {
                                "example_id": "d971fea1-a960-463a-b766-96fd95cc3be2",
                                "sense_id": "9bf5da71-5a81-3a99-88e5-41711d59c002",
                                "text": "The highest official in Oran remains anonymous, referred to merely as \"the Prefect.\" Use of the majusculed generic title instead of a proper name is less suggestive of a faceless tyrant, a Maghreb Big Brother, than of the detached, ineffectual bureaucrat he appears to be at every meeting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a45ce2d6-9f23-4a35-a0c2-e8a63381133e",
                        "source_entry_id": "dad1041c-1ab7-39ec-91f7-2cccbc577012",
                        "source_sense_description": "having no face",
                        "target_lang_word": "gesichtslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gesichtslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                        "entry_id": "917abda2-5490-38fd-ac3d-bba88331bd0b",
                                        "glosses": [
                                            "ohne besondere Eigenschaften, ohne Charakteristika; meist im Zusammenhang mit Menschen, Orten oder Gebäuden gebraucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a3f628d-0242-4b2c-a2b1-f0f5cebb93c9",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "Als gesichtsloser Schreiber kann man sich in sozialen Medien Hasskommentare erlauben."
                                            },
                                            {
                                                "example_id": "6dc20686-0243-4f6c-8bb5-2f27a7118462",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "Das ist kein toller Film, die Hauptfiguren bleiben ziemlich gesichtslos."
                                            },
                                            {
                                                "example_id": "170c0d1a-7f8d-411b-a87e-ff8ae1ec9eff",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„[…] Bandfotos gibt es nicht, Interviews auch nicht. Belle & Sebastian sind lange eine gesichtslose Band.“"
                                            },
                                            {
                                                "example_id": "f75f6d30-b38b-412a-8aaa-97a2504fc814",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Die gesichtslose Massengesellschaft wird allmählich Realität.“"
                                            },
                                            {
                                                "example_id": "85caa353-315c-418c-a8b4-6031b9071df2",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Die gesichtslosen Bürokraten in Mischustins Regierung haben eine wichtige Aufgabe vor sich: die wachsende soziale Unzufriedenheit zu unterdrücken.“"
                                            },
                                            {
                                                "example_id": "72668cf8-1719-43f3-9359-5f2e1ad468b4",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„»Die Hannoveraner werden von außen manchmal als gesichtslos und langweilig belächelt, Hannover gilt als graue Stadt.«“"
                                            },
                                            {
                                                "example_id": "33a9eb79-bcd6-48f4-9de6-43ef456c7501",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Der Potsdamer Platz entwickelt sich aktuell zu genau dem gesichtslosen Retortenplatz, den seine Kritiker schon immer in ihm sahen.“"
                                            },
                                            {
                                                "example_id": "cfaa5101-d01f-4d48-ace1-605054734f74",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Der erste spektakuläre Fall war der Abriss eines historischen Hauses in der Altstadt, an dessen Stelle ein gesichtsloser Neubau errichtet wurde.“"
                                            },
                                            {
                                                "example_id": "3853599f-3d22-4603-83b0-5f62bd41abf3",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Mit einem Kultur- und Kongresszentrum will sich Schlieren vom Ruf einer gesichtslosen Industrievorstadt trennen.“"
                                            },
                                            {
                                                "example_id": "30da888e-68f8-4aad-a0b4-3735a6b2d72e",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„»Wedel war eine lange Zeit berühmt-berüchtigt für die Zahl seiner Gaststätten. An das historische Brauhaus, das hier stand, erinnert rein gar nichts. Es ist gesichtslos geworden.«“"
                                            },
                                            {
                                                "example_id": "eb17275b-ccc7-42b1-85f2-a7effb516112",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Am 8. April 1904 bekommt der bislang gesichtslose ‚Long Acre Square‘ im Herzen Manhattans einen neuen Namen: ‚Times Square‘.“"
                                            },
                                            {
                                                "example_id": "63a20802-8152-450e-9d99-45740329e32a",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Auf jeden Fall wollten Planer und Architekten die Fehler der Vergangenheit vermeiden – gesichtslose Trabantenstädte ohne Infrastruktur.“",
                                                "translation": "mit Steigerung:"
                                            },
                                            {
                                                "example_id": "877cc4ee-5ba1-40d5-b840-8da955ed0218",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Gut möglich, dass die Ödipus-Tochter Ismene wirklich die gesichtsloseste Figur des Dramenkanons ist.“"
                                            },
                                            {
                                                "example_id": "400c00b3-4aee-47c6-add9-a17fe5a7a42e",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Die grauen Männer – haben sich in Schatten verwandelt. Aus dem Blaulichtauto steigt der graueste, der gesichtsloseste von allen und geht auf die Tür der Bibliothekarin zu.“"
                                            },
                                            {
                                                "example_id": "afa961a7-a749-443e-a865-3ea4efc817a2",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Sachsen-Anhalt, das gelegentlich als „das gesichtsloseste [Land] der Republik“ beschrieben wird, kann trotz seiner kurzen Existenz als eigenständiges Land auf ein umfangreiches historisches Erbe blicken.“"
                                            },
                                            {
                                                "example_id": "619be54e-5127-4031-9ee0-a2af41275ba4",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„»Durch solche Tapeten kann sich der Städter noch in die gesichtsloseste Wohnung Gemütlichkeit holen«, sagt auch Katharina Semling, Wohnexpertin aus Oldenburg.“"
                                            },
                                            {
                                                "example_id": "f41c6110-0415-48b5-8669-9d7caa48afb4",
                                                "sense_id": "242d09d8-efe1-3572-833e-5706bc06a90a",
                                                "text": "„Von gut situierten Randgebieten abgesehen behaupten wir heute, dass Chandigarh die gesichtsloseste, hässlichste Stadt der Welt ist – ein Negativrekord!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
