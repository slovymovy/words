                        "glosses": [
                            "Relatif au technosolutionnisme, la croyance en la technologie pour résoudre des problèmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096ae8d3-dccb-4a59-bad2-ea66912e50f8",
                                "sense_id": "834ff8df-3d73-3542-adad-ce0c2e0d6c56",
                                "text": "Lorsqu’une technologie climatique est guidée par des intérêts commerciaux, sans faire l’objet ni d’une identification préalable des risques par une autorité indépendante ni d’une discussion démocratique préalable, cette situation relève d’un Far West technosolutionniste contournant Etats et citoyens pour les intérêts de quelques entreprises."
                            },
                            {
                                "example_id": "34254c72-9bd0-43fb-831e-9bafd9aaeb28",
                                "sense_id": "834ff8df-3d73-3542-adad-ce0c2e0d6c56",
                                "text": "L’humour permet de se détacher un peu du réel et de se moquer des discours climatosceptiques ou technosolutionnistes."
                            }
                        ]
                    }
