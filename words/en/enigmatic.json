{
    "word_family": [
        "enigma",
        "enigmatically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "607bdf9f-0596-3b26-b277-6a708e591545",
                    "sense_definition": "Difficult to interpret or understand; mysterious.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mystery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>enigmatic</w> smile on the painting has puzzled art historians for centuries.",
                            "target_lang_translations": {
                                "zh": "画中那抹<w>神秘的</w>微笑几个世纪以来一直让艺术史学家感到困惑。"
                            }
                        },
                        {
                            "text": "He left an <w>enigmatic</w> message on my desk before disappearing without a trace.",
                            "target_lang_translations": {
                                "zh": "他在消失得无影无踪之前，在我的桌上留下了一条<w>费解的</w>信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mysterious",
                        "cryptic",
                        "puzzling"
                    ],
                    "antonyms": [
                        "clear",
                        "obvious"
                    ],
                    "common_phrases": [
                        "enigmatic smile",
                        "enigmatic behavior"
                    ],
                    "target_lang_definitions": {
                        "zh": "难以解释或理解的；神秘的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "神秘的",
                                "target_lang_sense_clarification": "指难以捉摸、充满未知感。"
                            },
                            {
                                "target_lang_word": "费解的",
                                "target_lang_sense_clarification": "指逻辑或意图难以理清。"
                            },
                            {
                                "target_lang_word": "高深莫测的",
                                "target_lang_sense_clarification": "形容人或事物深不可测，难以看透。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b4e8279-d2b3-3864-ba5b-95993dbe589d",
                    "sense_definition": "Relating to or resembling an <w>enigma</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mystery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author is known for his <w>enigmatic</w> style that leaves readers questioning reality.",
                            "target_lang_translations": {
                                "zh": "这位作家以其<w>谜一般的</w>风格而闻名，让读者不禁质疑现实。"
                            }
                        },
                        {
                            "text": "Her <w>enigmatic</w> nature makes it hard for others to truly know her thoughts.",
                            "target_lang_translations": {
                                "zh": "她那<w>高深莫测的</w>性格让别人很难真正了解她的想法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mysterious"
                    ],
                    "target_lang_definitions": {
                        "zh": "与谜题相关的，或具有谜一般特质的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "谜一般的",
                                "target_lang_sense_clarification": "形容像谜一样令人困惑。"
                            },
                            {
                                "target_lang_word": "不可思议的",
                                "target_lang_sense_clarification": "形容难以用常理推断的特质。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}