{
    "word_family": [
        "conference",
        "conferee",
        "conferment",
        "conferral"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3450bf3a-7029-3614-8a58-ee75ac95c9c5",
                    "sense_definition": "To discuss something with other people in order to reach a decision or exchange ideas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consultation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers needed to <w>confer</w> with their clients before the trial could proceed.",
                            "target_lang_translations": {
                                "ru": "Адвокатам нужно было <w>посовещаться</w> со своими клиентами, прежде чем судебный процесс мог быть продолжен."
                            }
                        },
                        {
                            "text": "The judges will <w>confer</w> in private to decide which contestant wins the grand prize.",
                            "target_lang_translations": {
                                "ru": "Судьи <w>совещаются</w> в частном порядке, чтобы решить, кто из участников получит главный приз."
                            }
                        }
                    ],
                    "synonyms": [
                        "palaver"
                    ],
                    "common_phrases": [
                        "confer with colleagues",
                        "confer in private"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсуждать что-либо с другими людьми для принятия решения или обмена идеями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совещаться",
                                "target_lang_sense_clarification": "обсуждать совместно с кем-либо"
                            },
                            {
                                "target_lang_word": "советоваться",
                                "target_lang_sense_clarification": "обмениваться мнениями для принятия решения"
                            },
                            {
                                "target_lang_word": "обсуждать",
                                "target_lang_sense_clarification": "вести разговор на какую-либо тему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10834a92-e627-3b00-b686-ba1ea0f48606",
                    "sense_definition": "To give an official title, honor, or advantage to someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bestowal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university decided to <w>confer</w> an honorary degree upon the visiting scientist.",
                            "target_lang_translations": {
                                "ru": "Университет решил <w>присудить</w> почетную степень приглашенному ученому."
                            }
                        },
                        {
                            "text": "The new law will <w>confer</w> additional rights on citizens living in rural areas.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>наделит</w> дополнительными правами граждан, проживающих в сельской местности."
                            }
                        }
                    ],
                    "synonyms": [
                        "afford"
                    ],
                    "common_phrases": [
                        "confer an honor",
                        "confer a degree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально присваивать кому-либо звание, награду или предоставлять преимущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присуждать",
                                "target_lang_sense_clarification": "официально присваивать награду или степень"
                            },
                            {
                                "target_lang_word": "присваивать",
                                "target_lang_sense_clarification": "наделять званием, правами или полномочиями"
                            },
                            {
                                "target_lang_word": "даровать",
                                "target_lang_sense_clarification": "официально предоставлять права или титул"
                            },
                            {
                                "target_lang_word": "наделять",
                                "target_lang_sense_clarification": "предоставлять права или качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edfcd272-fe66-3a6d-9383-6445b97b89e0",
                    "sense_definition": "To compare different pieces of information or texts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar had to <w>confer</w> the original manuscript with the later printed versions.",
                            "target_lang_translations": {
                                "ru": "Ученому пришлось <w>сверить</w> оригинальную рукопись с более поздними печатными версиями."
                            }
                        },
                        {
                            "text": "If we <w>confer</w> these observations with previous data, we might find a pattern.",
                            "target_lang_translations": {
                                "ru": "Если мы <w>сопоставим</w> эти наблюдения с предыдущими данными, мы сможем найти закономерность."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of comparing texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнивать различные фрагменты информации или тексты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверять",
                                "target_lang_sense_clarification": "сопоставлять для проверки точности"
                            },
                            {
                                "target_lang_word": "сопоставлять",
                                "target_lang_sense_clarification": "сравнивать тексты или данные"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba3cb10c-2295-344e-a371-4d31c05d086b",
                    "sense_definition": "To contribute to or help bring about a particular result.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structural integrity of the building does much to <w>confer</w> to its overall safety.",
                            "target_lang_translations": {
                                "ru": "Структурная целостность здания во многом <w>способствует</w> его общей безопасности."
                            }
                        },
                        {
                            "text": "Every small improvement will <w>confer</w> to the success of the final project.",
                            "target_lang_translations": {
                                "ru": "Каждое небольшое улучшение будет <w>содействовать</w> успеху финального проекта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of contributing to a result"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствовать достижению определенного результата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "содействовать получению результата"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "помогать в достижении цели"
                            }
                        ]
                    }
                }
            ]
        },
        {
