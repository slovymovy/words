                "senses": [
                    {
                        "sense_id": "dbd8ef3e-45a0-3746-8dda-334322f9ea69",
                        "entry_id": "7857ef2f-b8ea-3c3a-9a7a-2ce9d96a148d",
                        "glosses": [
                            "semantische Funktion/semantische Rolle der Person oder Organisation, die von dem im Satz dargestellten Vorgang als Nutznießer oder Geschädigter betroffen ist"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "0e5453a9-4935-41ff-865f-137a72d4b493",
                                "sense_id": "dbd8ef3e-45a0-3746-8dda-334322f9ea69",
                                "text": "In der Kasusgrammatik ist der Benefaktiv der Kasus des von der Handlung Betroffenen."
                            },
                            {
                                "example_id": "7936a6a0-9cca-451c-9074-2fcb11adbb34",
                                "sense_id": "dbd8ef3e-45a0-3746-8dda-334322f9ea69",
                                "text": "In dem Satz „Ich habe dir leider die Vase zerdeppert“ steht „dir“ für den Benefaktiv."
                            },
                            {
                                "example_id": "9a137715-b82b-4172-b851-2fdaf2165695",
                                "sense_id": "dbd8ef3e-45a0-3746-8dda-334322f9ea69",
                                "text": "Der Benefaktiv ist eine semantische Funktion einer Wortgruppe beziehungsweise ein Tiefenkasus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe8b261e-4aff-35ff-91f5-edafd0bb5efc",
                        "entry_id": "7857ef2f-b8ea-3c3a-9a7a-2ce9d96a148d",
                        "glosses": [
                            "in einigen Sprachen (darunter Baskisch) ein eigener Kasus des Kasussystems für den Nutznießer oder Geschädigten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbb982b-1ec9-40b0-8666-4438e92ddad1",
                                "sense_id": "fe8b261e-4aff-35ff-91f5-edafd0bb5efc",
                                "text": "Im Baskischen gibt es einen eigenen Kasus Benefaktiv (Oberflächenkasus)."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
