                        ],
                        "examples": [
                            {
                                "example_id": "b6da7d50-ee89-4d04-b7d6-1517e9c668b4",
                                "sense_id": "a1184474-09c1-3eee-8945-0bbe9e17d1cc",
                                "text": "Combien, dit-il, méritons-nous d’estre blasmez, nous qui ne prenons aucun soin de guérir les consciences agitées de doutes, ni d’expliquer les dogmes purement & simplement, sans sophisterie ?"
                            },
                            {
                                "example_id": "6af005f4-3632-47f0-91ba-9401b9a19144",
                                "sense_id": "a1184474-09c1-3eee-8945-0bbe9e17d1cc",
                                "text": "[Montaigne] fait tomber un millénaire de ratiocinations et d’arguties, de chicanes et de sophisteries."
                            }
                        ]
                    }
