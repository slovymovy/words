                        "glosses": [
                            "Relatif à Lorient, commune française située dans le département du Morbihan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a39b8b7a-4ab6-47d5-953b-8ab69a5fef3a",
                                "sense_id": "dbface00-51a9-3702-a3a9-11e74062b1cb",
                                "text": "« Régis, il faut le connaître sur la durée pour que ça fonctionne vraiment avec lui », estime Jocelyn Laurent (26 ans), qui l’a côtoyé au centre de formation lorientais."
                            },
                            {
                                "example_id": "caaa950c-2906-4224-8272-c7e6e862058c",
                                "sense_id": "dbface00-51a9-3702-a3a9-11e74062b1cb",
                                "text": "Le FCL va rester à ce niveau jusqu’au coup de tonnerre dont nous reparlerons, celui de 1967 lorsque le club lorientais décida de créer une section professionnelle !"
                            }
                        ]
                    }
