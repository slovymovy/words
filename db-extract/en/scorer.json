            {
                "entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                "word": "scorer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b86c023-e363-4eec-9562-2725cf2b16a0",
                        "entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                        "tags": [
