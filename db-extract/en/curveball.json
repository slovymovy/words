    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a19e562f-0e04-341c-ae27-50a7efc419c5",
                "word": "curveball",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "577f0382-bf0b-41b9-aef5-1ec70b54953e",
                        "entry_id": "a19e562f-0e04-341c-ae27-50a7efc419c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "curveballs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c2cf1d1-a7e2-347a-9b7c-c7378cc45b6e",
                        "entry_id": "a19e562f-0e04-341c-ae27-50a7efc419c5",
                        "glosses": [
                            "A forespin pitch thrown by rotating the index and middle fingers down and resulting in motion down \\\"curve\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13751be9-487a-4313-9002-a3484ec1629d",
                                "sense_id": "1c2cf1d1-a7e2-347a-9b7c-c7378cc45b6e",
                                "text": "He bit on a curveball in the dirt."
                            },
                            {
                                "example_id": "f1072377-7c65-48cb-afc8-231674beb9cb",
                                "sense_id": "1c2cf1d1-a7e2-347a-9b7c-c7378cc45b6e",
                                "text": "Cam Smith bounced to shortstop on a 100 mph fastball, and Jacob Melton also grounded out on an 86.9 mph curveball."
                            },
                            {
                                "example_id": "03b366a8-0dc0-47c2-beab-78ab807d8a59",
                                "sense_id": "1c2cf1d1-a7e2-347a-9b7c-c7378cc45b6e",
                                "text": "Caglianone ripped Miles Mikolas’ curveball into the right-field corner for an RBI double that scored Salvador Perez in the fourth inning of the first game of a doubleheader against the Cardinals."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd463934-86e0-328e-965d-9b85b24b443e",
                        "entry_id": "a19e562f-0e04-341c-ae27-50a7efc419c5",
                        "glosses": [
                            "An unexpected turn of events initiated by an opponent or chance; an exception or outlier."
                        ],
                        "tags": [
                            "US",
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6aecf4bd-beef-4514-a3ce-3c5ed80dce0f",
                                "sense_id": "bd463934-86e0-328e-965d-9b85b24b443e",
                                "text": "Life has thrown him a few curveballs."
                            },
                            {
                                "example_id": "2fbf2a91-85e2-43a6-bec1-06f5735474e4",
                                "sense_id": "bd463934-86e0-328e-965d-9b85b24b443e",
                                "text": "The season’s first episode, “Bart Gets an F,” got the highest ratings in its history, but “Treehouse of Horror” was the real curveball: a genre-busting effort that proudly punched above the show’s expectations."
                            },
                            {
                                "example_id": "a085bf27-c7d8-45b1-bcc2-70c5f70baddb",
                                "sense_id": "bd463934-86e0-328e-965d-9b85b24b443e",
                                "text": "There are two curveball nominations, one perhaps a popularity bid and the other a credibility bid. The popular one is Bieber’s Purpose."
                            },
                            {
                                "example_id": "19b55f82-3587-4608-81af-01a82e69b164",
                                "sense_id": "bd463934-86e0-328e-965d-9b85b24b443e",
                                "text": "But from time to time, June throws up a curveball, in the shape of unusual and hard to predict meteorological events."
                            },
                            {
                                "example_id": "afe8c547-e177-45c2-a506-b7145bcd251b",
                                "sense_id": "bd463934-86e0-328e-965d-9b85b24b443e",
                                "text": "And I think that’s an example of where faced with a seemingly intractable political reality, technology produces a solution that is a total curveball and not that imaginable a few decades ago."
                            }
                        ]
                    }
                ],
