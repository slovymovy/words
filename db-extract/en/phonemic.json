                        "entry_id": "ce8438b7-b023-31bd-9f2b-4dc64b1f7639",
                        "glosses": [
                            "Corresponding precisely and consistently with the phonemes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a283a6c2-d93e-42e2-b8bc-98fe15472874",
                                "sense_id": "b8064f6d-3d26-3bd4-9297-e9856a06c8fa",
                                "text": "Spanish orthography is highly phonemic: you can tell exactly how the words sound just by looking at how they are spelled."
                            }
                        ]
                    }
