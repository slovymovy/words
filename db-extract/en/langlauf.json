                "senses": [
                    {
                        "sense_id": "c0dbc818-e8e6-33aa-a4f1-766b46a4e18a",
                        "entry_id": "ed482c30-72fd-3e02-b10c-7a0025aa9cf9",
                        "glosses": [
                            "To go cross-country skiing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b00206-80c7-4b6d-b6ee-c141247dc805",
                                "sense_id": "c0dbc818-e8e6-33aa-a4f1-766b46a4e18a",
                                "text": "He who langlaufs last langlaufs longest."
                            },
                            {
                                "example_id": "24752ddf-7fc7-46c2-a696-a38d39e2e8e0",
                                "sense_id": "c0dbc818-e8e6-33aa-a4f1-766b46a4e18a",
                                "text": "‘Weekends the family make excursions. Romp in the woods, langlauf, play badminton.’"
                            },
                            {
                                "example_id": "15d05daa-0438-4ce9-a0ce-224a52ea213e",
                                "sense_id": "c0dbc818-e8e6-33aa-a4f1-766b46a4e18a",
                                "text": "He langlaufed across the small plateau that tilted gently upward, and paused on the ridge."
                            },
                            {
                                "example_id": "84b11573-0c87-4aa7-acad-265362c7b0c3",
                                "sense_id": "c0dbc818-e8e6-33aa-a4f1-766b46a4e18a",
                                "text": "They langlaufed into Hot Sulphur Springs at 9 p.m., and found the Grand Ball in progress."
                            },
                            {
                                "example_id": "07fe6ba8-db27-4be3-b0bd-b2c5864b25a7",
                                "sense_id": "c0dbc818-e8e6-33aa-a4f1-766b46a4e18a",
                                "text": "We then langlaufed over to 'Higgie' (Mt Higginbottom) and finally back to the Diamantina about 3.30."
                            }
                        ]
                    }
