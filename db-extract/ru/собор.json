                "senses": [
                    {
                        "sense_id": "3d157631-e2ad-3ce4-bd31-5e0d36a3946d",
                        "entry_id": "ca522455-3013-354a-9167-f6f2c02ccb88",
                        "glosses": [
                            "истор., религ. собрание, съезд представителей церковных или иных организаций"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90105e7-9f8c-4eff-9b8d-02c63edddfc1",
                                "sense_id": "3d157631-e2ad-3ce4-bd31-5e0d36a3946d",
                                "text": "Собором положили // В последний раз // отведать силу просьбы // Над скорбною // правителя душой."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd5e5e8d-0447-3f92-a5d7-73b51c0f8860",
                        "entry_id": "ca522455-3013-354a-9167-f6f2c02ccb88",
                        "glosses": [
                            "крупный, часто главный в городе христианский храм; главная церковь в монастыре"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afe22fda-3057-4cda-a250-806b7f054e9c",
                        "source_entry_id": "ca522455-3013-354a-9167-f6f2c02ccb88",
                        "source_sense_description": "собрание",
                        "target_lang_word": "council",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "council",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40ef065a-6161-3d69-8b9b-29805c1ebcb7",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "A committee that leads or governs (e.g. city council, student council)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57289e31-1574-4545-b071-2559dfa3ed87",
                                                "sense_id": "40ef065a-6161-3d69-8b9b-29805c1ebcb7",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            },
                                            {
                                                "example_id": "8190b6c7-58c9-47b7-92b0-401849e7f194",
                                                "sense_id": "40ef065a-6161-3d69-8b9b-29805c1ebcb7",
                                                "text": "The comments were made at a council meeting last month, during which one councillor questioned whether changing the names would be pushing reconciliation efforts along too quickly. […] At a city council meeting on Oct. 8, Campbell River councillors discussed a letter sent by the B.C. Geographical Names Office inviting comments on the name changes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73631d56-d291-368d-aa7e-c7a9b19784fd",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "A committee that leads or governs (e.g. city council, student council).",
                                            "A local authority."
                                        ],
                                        "tags": [
                                            "UK",
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f750de5-783e-3791-9aaa-407dc96e42c5",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "Discussion or deliberation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d470148e-09ad-4c28-ae21-84d88c79db4d",
                                                "sense_id": "2f750de5-783e-3791-9aaa-407dc96e42c5",
                                                "text": "Satan […] void of rest, / His potentates to council called by night;"
                                            },
                                            {
                                                "example_id": "d497cb16-6994-46d0-be3d-3b597e5437ca",
                                                "sense_id": "2f750de5-783e-3791-9aaa-407dc96e42c5",
                                                "text": "O great in action and in council wise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd2b899-a6d1-3054-8220-1435f9d2f69d",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "Short for church council"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ee4c6a-e099-48b5-acb3-a5fe5479d27e",
                                                "sense_id": "9bd2b899-a6d1-3054-8220-1435f9d2f69d",
                                                "text": "the First Council of Nicaea"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08ac9e0a-afa8-4177-bc04-e8ee182feb90",
                        "source_entry_id": "ca522455-3013-354a-9167-f6f2c02ccb88",
                        "source_sense_description": "собрание",
                        "target_lang_word": "concile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb7ec23-b1ff-3237-8efb-144aa53e3c52",
                                        "entry_id": "01927a67-d1c4-3540-b3e4-32d31ad65c9a",
                                        "glosses": [
                                            "Assemblée légitimement convoquée de plusieurs évêques et docteurs de l’Église catholique romaine, pour délibérer et décider sur des questions de doctrine et de discipline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10bbe05-6338-4cc4-a539-fc59dd733bba",
                                                "sense_id": "eeb7ec23-b1ff-3237-8efb-144aa53e3c52",
                                                "text": "Elle fit valoir cette excuse devant un grand concile du clergé d’Angleterre, comme la seule raison qu’elle avait eue de prendre l’habit religieux."
                                            },
                                            {
                                                "example_id": "511c8de4-c95a-4791-860c-00077b693c12",
                                                "sense_id": "eeb7ec23-b1ff-3237-8efb-144aa53e3c52",
                                                "text": "C'est ainsi qu'en 465 le concile de Vannes interdit aux clercs non seulement de prendre part aux repas de juifs, mais de les inviter à leur propre table."
                                            },
                                            {
                                                "example_id": "9265cd67-4036-4764-8e7e-274f26ba91fe",
                                                "sense_id": "eeb7ec23-b1ff-3237-8efb-144aa53e3c52",
                                                "text": "[…], Abélard n'échappa au sort de Bérenger et de Roscelin. Saint Bernard, au concile de Sens, le fit condamner en affirmant qu'il comprenait la Trinité comme un arien, la grâce comme un pélagien et la Personne du Christ comme un nestorien."
                                            },
                                            {
                                                "example_id": "34de784d-917c-4a83-b576-3ef499bf4d40",
                                                "sense_id": "eeb7ec23-b1ff-3237-8efb-144aa53e3c52",
                                                "text": "Soit, d'abord, le niveau culturel. En 529 le concile de Vaison avait ordonné que les prêtres ruraux éduquassent les candidats à la cléricature."
                                            },
                                            {
                                                "example_id": "7eb3c4f9-5bd7-4480-b3d0-b37c1248c45a",
                                                "sense_id": "eeb7ec23-b1ff-3237-8efb-144aa53e3c52",
                                                "text": "Les conciles généraux par contre, sont ceux auxquels est largement représenté l’épiscopat des diverses parties de la chrétienneté, mais auxquels n'a pas été reconnu le caractère de l’œcuménicité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0da02f-e4ba-3e76-b6b5-b0dc9ae60568",
                                        "entry_id": "01927a67-d1c4-3540-b3e4-32d31ad65c9a",
                                        "glosses": [
                                            "Ensemble des décrets et des canons rédigés dans un concile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a1582e-8309-4cd5-bf26-8a20642d3778",
                                                "sense_id": "bd0da02f-e4ba-3e76-b6b5-b0dc9ae60568",
                                                "text": "Le législateur canonique intervient aussi pour réprimer le rapt ; le Concile de Chalcédoine de 451 (canon 27) dépose les clercs coupables de complicité de rapt et excommunie les laïques dans ces cas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
