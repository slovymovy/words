                                "target_senses": [
                                    {
                                        "sense_id": "30be53df-c10b-3140-a7f2-6d7c44274c9e",
                                        "entry_id": "da7f7d0a-2bf1-32b3-89b7-57fe41bea0fa",
                                        "glosses": [
                                            "Archipel de Mélanésie, baigné par la mer de Corail dans l’océan Pacifique Sud."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "233f8a4b-ebc3-3768-af8a-c1c24d58afae",
                                        "entry_id": "da7f7d0a-2bf1-32b3-89b7-57fe41bea0fa",
                                        "glosses": [
                                            "Collectivité française composée de cet archipel et quelques autres satellites, jouissant d’une autonomie particulière, dont l’île principale est la Grande Terre et la capitale Nouméa."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1621b8f6-c09e-482e-8579-b962c8ce6583",
                                                "sense_id": "233f8a4b-ebc3-3768-af8a-c1c24d58afae",
                                                "text": "La Nouvelle-Calédonie émet, par habitant, autant de CO2 que les États-Unis."
                                            },
                                            {
                                                "example_id": "a1cc8c63-f806-4802-b66f-280b48cc6ff2",
                                                "sense_id": "233f8a4b-ebc3-3768-af8a-c1c24d58afae",
                                                "text": "La réhabilitation mémorielle concerne en premier lieu les victimes d’une politique coloniale de peuplement, par laquelle des condamnés de droit commun ont été transportés en Nouvelle-Calédonie pour des faits parfois mineurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e15ff1c-01f9-348c-a5de-693346ca25da",
                                        "entry_id": "da7f7d0a-2bf1-32b3-89b7-57fe41bea0fa",
                                        "glosses": [
                                            "Ancien nom de ce qui est maintenant la Colombie-Britannique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a69276-8452-4543-a42a-c9c0c132a73d",
                                                "sense_id": "6e15ff1c-01f9-348c-a5de-693346ca25da",
                                                "text": "[…] différentes parties de la côte qui sont comprises dans la troisième région [de la côte nord-ouest de l’Amérique septentrionale] […] nᵒ 1 Nouveau-Norfolk […] nᵒ 2 Nouveau-Cornouaille […] nᵒ 3 Nouvelle-Hanovre […] nᵒ 4 Nouvelle-Géorgie […] La compagnie anglaise du Nord-Ouest comprend actuellement ces quatre territoires sous le nom de Nouvelle-Calédonie."
                                            },
                                            {
                                                "example_id": "1551bed6-7931-484b-b1c2-3501283841d1",
                                                "sense_id": "6e15ff1c-01f9-348c-a5de-693346ca25da",
                                                "text": "Cornwall (Nouveau-), contrée de l’Amérique du Nord, sur la côte occidentale, dans la Nouvelle-Calédonie, entre le Nouveau-Norfolk au N., et le Nouveau-Hanovre au S."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
