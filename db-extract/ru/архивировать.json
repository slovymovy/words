                                        "sense_id": "8f19dc7e-bae1-3332-af47-1591d4ffbfb2",
                                        "entry_id": "9fe08667-bb7f-35c7-b1a0-6cdd039208b2",
                                        "glosses": [
                                            "A place for storing earlier, and often historical, material. An archive usually contains documents (letters, records, newspapers, etc.) or other types of media kept for historical interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38d2c16-6416-4cf1-9ab0-e60286219f50",
                                                "sense_id": "8f19dc7e-bae1-3332-af47-1591d4ffbfb2",
                                                "text": "“I don’t know how one could be interested in libraries and not archives,” Lannon told me. They tell you “the stories behind things,” he said, “the unpublished, the hard to find, the true story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be290e24-72e1-33a0-bf6c-9a2c5ec2bb0c",
                                        "entry_id": "9fe08667-bb7f-35c7-b1a0-6cdd039208b2",
                                        "glosses": [
                                            "The material so kept, considered as a whole (compare archives)."
                                        ],
