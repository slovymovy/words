                ],
                "senses": [
                    {
                        "sense_id": "3d3e2c64-2daf-3b6a-aca3-becd683a8068",
                        "entry_id": "184e6a4c-4b3b-3011-ae18-79a45c8155a3",
                        "glosses": [
                            "Abandonner de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7522e61-3fed-4efa-a819-42c73a3e2770",
                                "sense_id": "3d3e2c64-2daf-3b6a-aca3-becd683a8068",
                                "text": "Dès qu’arrivait la fin du mois d’août, il leur fallait réabandonner leur tendre cabane jusqu’à l’année suivante."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9224e2d-5594-3d44-9a52-cfea59935855",
                        "entry_id": "184e6a4c-4b3b-3011-ae18-79a45c8155a3",
                        "glosses": [
                            "Abandonner encore une fois."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "38e27d0d-b3b2-4f24-bc33-221495d60d3b",
                                "sense_id": "a9224e2d-5594-3d44-9a52-cfea59935855",
                                "text": "Malgré ses efforts, il réabandonnera deux ans plus tard."
                            }
                        ]
                    },
                    {
                        "sense_id": "78bd58a5-8078-3ad9-bf60-825aadafeab6",
                        "entry_id": "184e6a4c-4b3b-3011-ae18-79a45c8155a3",
                        "glosses": [
                            "S’abandonner de nouveau."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "9a04f2ae-2167-4e07-b6cd-ddf80a39764f",
                                "sense_id": "78bd58a5-8078-3ad9-bf60-825aadafeab6",
                                "text": "En dépit d’une fatigue de plus en plus prenante, ils se réabandonnèrent l’un à l’autre jusqu’au matin."
                            }
                        ]
                    }
