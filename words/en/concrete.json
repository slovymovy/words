{
    "word_family": [
        "concretion",
        "concretize",
        "concretely",
        "concreteness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3f0a29c4-eba7-396e-99e3-21b84e0278eb",
                    "sense_definition": "Made of the hard building material known as concrete.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children scraped their knees while playing on the rough <w>concrete</w> playground.",
                            "target_lang_translations": {
                                "ru": "Дети ободрали колени, играя на неровной <w>бетонной</w> площадке.",
                                "zh": "孩子们在粗糙的<w>混凝土</w>操场上玩耍时擦伤了膝盖。"
                            }
                        },
                        {
                            "text": "They built a high <w>concrete</w> wall around the perimeter of the prison.",
                            "target_lang_translations": {
                                "ru": "Они построили высокую <w>бетонную</w> стену по периметру тюрьмы.",
                                "zh": "他们在监狱四周筑起了一道高高的<w>混凝土</w>墙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "concrete floor",
                        "concrete wall",
                        "concrete block",
                        "concrete jungle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из твердого строительного материала, известного как бетон.",
                        "zh": "由混凝土制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бето́нный",
                                "target_lang_sense_clarification": "сделанный из бетона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混凝土的",
                                "target_lang_sense_clarification": "由混凝土构成的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8267858b-e65d-30bf-80d4-a11cd569556b",
                    "sense_definition": "Specific, definite, and clearly defined; based on facts rather than theories or guesses.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reality_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police cannot arrest the suspect until they find <w>concrete</w> evidence of the crime.",
                            "target_lang_translations": {
                                "ru": "Полиция не может арестовать подозреваемого, пока не найдет <w>конкретных</w> доказательств преступления.",
                                "zh": "在找到犯罪的<w>确凿</w>证据之前，警方无法逮捕嫌疑人。"
                            }
                        },
                        {
                            "text": "While everyone else offered thoughts and prayers, she made a <w>concrete</w> proposal to help.",
                            "target_lang_translations": {
                                "ru": "Пока все остальные предлагали молитвы и сочувствие, она внесла <w>конкретное</w> предложение о помощи.",
                                "zh": "当其他人都在表达关切和祈祷时，她提出了一个<w>具体</w>的援助方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specific",
                        "particular"
                    ],
                    "antonyms": [
                        "abstract",
                        "intangible"
                    ],
                    "common_phrases": [
                        "concrete evidence",
                        "concrete proof",
                        "concrete example",
                        "concrete plan",
                        "concrete steps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический, определенный и четко обозначенный; основанный на фактах, а не на теориях или догадках.",
                        "zh": "具体的、明确的；基于事实而非理论或猜测。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкре́тный",
                                "target_lang_sense_clarification": "точный, предметный"
                            },
                            {
                                "target_lang_word": "определённый",
                                "target_lang_sense_clarification": "установленный, явный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "具体的",
                                "target_lang_sense_clarification": "明确的，非抽象的"
                            },
                            {
                                "target_lang_word": "确凿的",
                                "target_lang_sense_clarification": "证据确凿的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec2c9a63-4005-3798-9fbf-01258043e199",
                    "sense_definition": "Existing in a material or physical form; real and tangible; not abstract.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reality_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A toy is a <w>concrete</w> object that a child can hold, unlike an idea which is in the mind.",
                            "target_lang_translations": {
                                "ru": "Игрушка — это <w>материальный</w> предмет, который ребенок может держать в руках, в отличие от идеи, которая находится в уме.",
                                "zh": "玩具是一个孩子可以拿在手里的<w>实体</w>物品，这与存在于脑海中的想法不同。"
                            }
                        },
                        {
                            "text": "He prefers dealing with <w>concrete</w> things rather than discussing theoretical concepts.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает иметь дело с <w>конкретными</w> вещами, а не обсуждать теоретические концепции.",
                                "zh": "他更喜欢处理<w>具体</w>事务，而不是讨论理论概念。"
                            }
                        }
                    ],
                    "antonyms": [
                        "abstract",
                        "intangible"
                    ],
                    "common_phrases": [
                        "concrete object",
                        "concrete reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в материальной или физической форме; реальный и осязаемый; не абстрактный.",
                        "zh": "以物质或物理形式存在的；真实的、可感知的；非抽象的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материа́льный",
                                "target_lang_sense_clarification": "вещественный, осязаемый"
                            },
                            {
                                "target_lang_word": "реа́льный",
                                "target_lang_sense_clarification": "существующий на самом деле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实体的",
                                "target_lang_sense_clarification": "有形的，物质的"
                            },
                            {
                                "target_lang_word": "具体的",
                                "target_lang_sense_clarification": "现实存在的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9d38e91-b347-377b-bc88-2a54f21fdb23",
                    "sense_definition": "A hard building material created by mixing cement, water, sand, and gravel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction workers poured wet <w>concrete</w> into the wooden frame to make the foundation.",
                            "target_lang_translations": {
                                "ru": "Строители залили влажный <w>бетон</w> в деревянную опалубку, чтобы сделать фундамент.",
                                "zh": "建筑工人们将湿<w>混凝土</w>倒入木框架中以建造地基。"
                            }
                        },
                        {
                            "text": "Modern cities are often described as jungles of steel and <w>concrete</w>.",
                            "target_lang_translations": {
                                "ru": "Современные города часто описывают как джунгли из стали и <w>бетона</w>.",
                                "zh": "现代城市常被形容为钢铁和<w>混凝土</w>的丛林。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reinforced concrete",
                        "mix concrete",
                        "pour concrete",
                        "slab of concrete"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый строительный материал, создаваемый путем смешивания цемента, воды, песка и гравия.",
                        "zh": "一种由水泥、水、沙子和砾石混合而成的坚硬建筑材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бето́н",
                                "target_lang_sense_clarification": "строительный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混凝土",
                                "target_lang_sense_clarification": "建筑材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de38109-1bbb-363a-90ae-5b5fc85f07fb",
                    "sense_definition": "A dessert made of frozen custard mixed with toppings, known for being so thick it does not pour.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped at the custard stand to buy a chocolate chip <w>concrete</w> after the game.",
                            "target_lang_translations": {
                                "ru": "После игры мы остановились у киоска с мороженым, чтобы купить <w>конкрит</w> с шоколадной крошкой.",
                                "zh": "比赛结束后，我们在蛋奶糊摊位停下来买了一份巧克力碎<w>冰淇淋甜点</w>。"
                            }
                        },
                        {
                            "text": "The server turned the cup upside down to show that the <w>concrete</w> was too thick to fall out.",
                            "target_lang_translations": {
                                "ru": "Официант перевернул стаканчик вверх дном, чтобы показать, что <w>конкрит</w> слишком густой и не выпадет.",
                                "zh": "服务员把杯子倒过来，展示这种<w>甜点</w>因为太浓稠而不会掉出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "frozen custard concrete",
                        "chocolate concrete"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Десерт из замороженного заварного крема с добавками, известный тем, что он настолько густой, что не выливается.",
                        "zh": "一种由冷冻蛋奶糊和配料混合而成的甜点，因质地浓稠而得名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкрит",
                                "target_lang_sense_clarification": "десерт из замороженного крема"
