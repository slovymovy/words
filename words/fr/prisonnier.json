{
    "word_family": [
        "prison",
        "emprisonner",
        "emprisonnement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5b12c47-08d4-3024-88a7-585f07b693de",
                    "sense_definition": "Personne détenue dans une prison ou privée de liberté par une autorité judiciaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gardien accompagne le <w>prisonnier</w> jusqu'à sa cellule après l'interrogatoire."
                        },
                        {
                            "text": "L'avocat a demandé la libération d'un <w>prisonnier</w> dont la peine était terminée."
                        }
                    ],
                    "synonyms": [
                        "détenu"
                    ],
                    "common_phrases": [
                        "libérer un prisonnier",
                        "surveiller les prisonniers"
                    ]
                },
                {
                    "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                    "sense_definition": "Personne capturée par l'ennemi lors d'un conflit armé ou d'une guerre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "guerre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soldat courageux est devenu un <w>prisonnier</w> de guerre après la bataille."
                        },
                        {
                            "text": "Les deux nations organisent un échange de <w>prisonniers</w> pour apaiser le conflit."
                        }
                    ],
                    "common_phrases": [
                        "prisonnier de guerre",
                        "échange de prisonniers"
                    ]
                },
                {
                    "sense_id": "5b9d407f-4c72-32e6-887a-18fbf13da633",
                    "sense_definition": "Personne qui se trouve privée de sa liberté d'action, de pensée ou de choix par une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'homme politique reste le <w>prisonnier</w> de son passé et de ses erreurs."
                        },
                        {
                            "text": "Elle refuse de vivre en <w>prisonnière</w> des attentes de sa famille."
                        }
                    ],
                    "common_phrases": [
                        "prisonnier de son passé"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                    "sense_definition": "Qui est capturé, détenu ou enfermé contre sa volonté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée ennemie a fait <w>prisonnier</w> le capitaine lors de cette attaque nocturne."
                        },
                        {
                            "text": "Le soldat craint d'être fait <w>prisonnier</w> s'il traverse la frontière seul."
                        }
                    ],
                    "synonyms": [
                        "détenu",
                        "enfermé"
                    ],
                    "common_phrases": [
                        "faire prisonnier",
                        "être fait prisonnier"
                    ]
                },
                {
                    "sense_id": "832ab409-d966-376d-96dd-4cc1401943b4",
                    "sense_definition": "Qui est coincé, retenu ou entravé matériellement dans ses mouvements.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "entrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son pied est resté <w>prisonnier</w> entre deux rochers au bord du ruisseau."
                        },
                        {
                            "text": "L'oiseau blessé se débattait les ailes <w>prisonnières</w> d'un filet de pêche."
                        }
                    ],
                    "synonyms": [
                        "enfermé"
                    ],
                    "common_phrases": [
                        "rester prisonnier"
                    ]
                },
                {
                    "sense_id": "ebde18bf-c8f8-3fa9-b657-4bc318c4a336",
                    "sense_definition": "Qui est assujetti ou captif moralement d'une influence, d'un état ou d'une habitude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette application cherche à garder <w>prisonnier</w> l'internaute sur son écran pendant des heures."
                        },
                        {
                            "text": "L'écrivain se sentait <w>prisonnier</w> de ses habitudes et ne trouvait plus l'inspiration."
                        }
                    ],
                    "common_phrases": [
                        "garder prisonnier"
                    ]
                }
            ]
        }
    ]
}