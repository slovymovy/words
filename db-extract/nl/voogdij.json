                        "entry_id": "f7476c66-04f6-3045-a431-4ff2e92b9125",
                        "glosses": [
                            "familierechtelijke situatie waarbij door wet, rechter of bij testament de zorg voor de belangen van een minderjarige of verlengd minderjarige, het beheer van zijn vermogen en de vertegenwoordiging in rechtszaken wordt toevertrouwd aan een ander dan zijn ouder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4289e69e-56c4-46b5-9721-c942f424ef34",
                                "sense_id": "502963c2-fda9-3c8a-b462-9663c1faf3df",
                                "text": "Na het vreselijke ongeluk, waarbij hun beide ouders omgekomen waren, kreeg oom Jan de voogdij over de twee weeskinderen toegewezen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "081b010d-144e-4200-a38b-cc5d9e82d19a",
