                                                "sense_id": "afc0ada9-2787-3997-be18-0ba83e259c4a",
                                                "text": "father Arnall's face looked very black but he was not in a wax: he was laughing."
                                            },
                                            {
                                                "example_id": "7f039fe8-3569-4606-a040-0a42338e2e7c",
                                                "sense_id": "afc0ada9-2787-3997-be18-0ba83e259c4a",
