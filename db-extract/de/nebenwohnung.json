                "senses": [
                    {
                        "sense_id": "4b9fb75b-60f4-3382-9be6-5abc68e9e567",
                        "entry_id": "7ac52989-0bdb-3f08-95a0-1b77eb6dc79d",
                        "glosses": [
                            "zweite Wohnung an einem anderen Ort als dem Erstwohnsitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a658e391-0272-45d0-a6b8-2f7053e6b80d",
                                "sense_id": "4b9fb75b-60f4-3382-9be6-5abc68e9e567",
                                "text": "„Eine Wohnung kann für einen Bewohner die einzige Wohnung, für einen anderen die Hauptwohnung und für einen weiteren die Nebenwohnung sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0f4f152-91e4-3351-97c9-101685e679d7",
                        "entry_id": "7ac52989-0bdb-3f08-95a0-1b77eb6dc79d",
                        "glosses": [
                            "Wohnung, die direkt neben der eigenen Wohnung liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7657bdf5-446f-4a1a-bfd8-213e30d0b5e4",
                                "sense_id": "e0f4f152-91e4-3351-97c9-101685e679d7",
                                "text": "„Dort liegt vor der Nebenwohnung die Post seines Nachbarn, der gerade auf Urlaub in Tunesien ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
