                "senses": [
                    {
                        "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                        "entry_id": "f83c4644-4b18-324b-9e2e-c8bed35ae57c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b9e4a9-11e0-4727-9f97-29bb84c6cda5",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mältzer kommt, geht der Herr Mältzer.“"
                            },
                            {
                                "example_id": "b1b13d50-c6db-43ae-9f66-e78fb11b99b3",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Mältzer kommt und geht."
                            },
                            {
                                "example_id": "60261622-6901-4f70-ab59-bccbee0fe10e",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Mältzers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "96569543-bf20-4688-af16-a2e6cd7405b7",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Der Mältzer trägt nie die Schals, die die Mältzer ihm strickt."
                            },
                            {
                                "example_id": "e2815be4-4b84-49aa-8b01-38a3c0020225",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Frau Mältzer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4fb83b21-0c88-4c79-9376-5080c0fad79a",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Herr Mältzer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fed2c056-6f44-4973-8542-d6ec0fd409db",
                                "sense_id": "6c822193-ffc6-3dec-809d-40ed15735a6c",
                                "text": "Die Mältzers fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
