                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "683e4f51-3697-4f30-a01d-25738387531a",
                        "entry_id": "c3cb48b3-3105-3ac9-b794-ed6745186122",
                        "tags": [
                            "plural"
