                "senses": [
                    {
                        "sense_id": "d70a16d9-4dc5-32c9-99a8-4aa5d2911b6b",
                        "entry_id": "96224f96-2751-3041-9798-1b91325cc799",
                        "glosses": [
                            "weibliche Person, die mit einem Fahrrad fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a98559-4a6a-4bc8-8094-7e8b5147d727",
                                "sense_id": "d70a16d9-4dc5-32c9-99a8-4aa5d2911b6b",
                                "text": "Die Radfahrerin beobachtete aufmerksam die anderen Verkehrsteilnehmer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2fa76985-560a-3e08-945e-c1c89f8779e4",
                        "entry_id": "96224f96-2751-3041-9798-1b91325cc799",
                        "glosses": [
                            "weibliche Person, die nach oben buckelt und nach unten „tritt“, das heißt autoritär auftritt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b462c902-2ff6-47e9-b9f1-d16b9714b5f4",
                                "sense_id": "2fa76985-560a-3e08-945e-c1c89f8779e4",
                                "text": "Die Frau hat keine Eierstöcke, die reinste Radfahrerin: nach oben buckeln und nach unten treten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12358032-8e3b-4a89-a1c6-c8f0f807f7c0",
                        "source_entry_id": "96224f96-2751-3041-9798-1b91325cc799",
                        "source_sense_id": "d70a16d9-4dc5-32c9-99a8-4aa5d2911b6b",
                        "source_sense_description": "weibliche Person, die mit einem Fahrrad fährt",
                        "target_lang_word": "bicyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bicyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                        "entry_id": "78ea4dd8-3d16-3659-8b6e-f62cbad43391",
                                        "glosses": [
                                            "Rare form of cyclist."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf80c2b-19ba-44d8-8bdf-d1b7565c8b6b",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "“Yes, that is true, professor. I believe I’ve been guilty of doing so myself; but look here, Miss Eunice,” and he turned suddenly to the professor’s daughter, “they tell me that you are an enthusiastic bicyclist.”"
                                            },
                                            {
                                                "example_id": "0e8ff210-3678-4de6-bb92-d7b41debe5c4",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "Our policemen, of course, will be fitted out with large, twirlable moustaches and small, twirlable rolling-pins, and will be taught to turn their backs on traffic jams, but to blow whistles violently at solitary bicyclists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20e453cf-c348-47af-8129-b5d000baba36",
                        "source_entry_id": "96224f96-2751-3041-9798-1b91325cc799",
                        "source_sense_id": "d70a16d9-4dc5-32c9-99a8-4aa5d2911b6b",
                        "source_sense_description": "weibliche Person, die mit einem Fahrrad fährt",
                        "target_lang_word": "cycliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "105e27c2-68b4-35f4-ba9d-d48b0ce056be",
                                        "entry_id": "e85d81cc-c60c-3e90-b926-63a879844ed1",
                                        "glosses": [
                                            "Qui concerne le cyclisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed19d106-adda-3061-9407-6dcb4b495647",
                                        "entry_id": "ebe35584-713f-39ac-93e5-d05fa3531af2",
                                        "glosses": [
                                            "Personne qui pratique le cyclisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c548dc8-b999-47df-85d0-ef11d3aa8d09",
                                                "sense_id": "ed19d106-adda-3061-9407-6dcb4b495647",
                                                "text": "Entre La Couarde-sur-Mer et Ars-en-Ré, le cycliste découvrira les marais salants qui se déploient à perte de vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                        "entry_id": "ebe35584-713f-39ac-93e5-d05fa3531af2",
                                        "glosses": [
                                            "Personne qui va à bicyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4708f6e5-6bc4-4f7f-a72f-a170ce93b93e",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "On me dit qu'un cycliste est tombé de sa machine, et que, dans sa chute, son fusil est parti tout seul: alors on a fait feu dans sa direction."
                                            },
                                            {
                                                "example_id": "b0cff143-77fc-4a49-865a-6fde15365abd",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "— Il ne doit pas y avoir beaucoup de cyclistes dans Paris. Surtout place de la Concorde…\n— On m’a dit qu’il y en avait encore…\n— C’est vrai, s’écria Busard. J’en ai même connu un. Il est venu en vacances ici. C’était un porteur de journaux.\n— Il y a longtemps ?\n— En 1946.\n— Maintenant les porteurs de journaux doivent avoir des mobylettes.\n— Pas nécessairement, dit Busard. Ça dépend du prix de revient et de l’amortissement."
                                            },
                                            {
                                                "example_id": "d3ec2751-4324-44d7-824e-feeefd981764",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "Le cataphote rouge vacille et brille à l'arrière de la bicyclette et bouge suivant les zigzags et les mouvements que fait le cycliste invisible sur la selle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6861e2-929e-36e7-a02b-583149353843",
                                        "entry_id": "c758381d-37e9-3b6a-9125-1281d9391c09",
                                        "glosses": [
                                            "Short moulant, à l'origine porté par les cyclistes puis devenu un vêtement à la mode pour les femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85be8df9-48fe-4fbe-8864-0a018447cc7a",
                                                "sense_id": "0d6861e2-929e-36e7-a02b-583149353843",
                                                "text": "L’homme porte un cycliste noir, et c’est tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
