                    {
                        "sense_id": "5d776d5d-82b7-3b49-8003-5fb09ccaf23e",
                        "entry_id": "35b13874-2b58-3a15-9898-0d53960a053e",
                        "glosses": [
                            "deel van een ruimte of lokaal waar men iets kan bouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55dce59d-83f6-46d3-8644-d823995884d2",
                                "sense_id": "5d776d5d-82b7-3b49-8003-5fb09ccaf23e",
                                "text": "Kinderen (en ouders) kunnen ook zelf de handen uit de mouwen steken in de bouwhoek. De entree bedraagt twee euro."
                            },
                            {
                                "example_id": "c677de0e-7e86-4a0a-99bb-f183cc0d0eb9",
                                "sense_id": "5d776d5d-82b7-3b49-8003-5fb09ccaf23e",
                                "text": "In de binnenspeeltuin zijn er leuke glijbanen, klimhuisjes, bouwhoeken, fietsen en ook daar is een kaboutertrein."
                            },
                            {
                                "example_id": "f0edc5e4-6c1a-4f4e-9c90-ca6bd2372bd6",
                                "sense_id": "5d776d5d-82b7-3b49-8003-5fb09ccaf23e",
                                "text": "Jonathan van Vulpen (4) zit in groep 1: \"Ik ben gelukkig als ik met mijn broertjes en mama ben en als ik school speel in de ziekenhuishoek en de bouwhoek.\""
                            }
                        ]
                    },
