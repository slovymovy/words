                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5f6f4f-1ec1-4196-ba66-2aab48b0bfaf",
                                                "sense_id": "81c3f35b-5d45-32a3-8f6e-5e42ed50c151",
                                                "text": "Hanggin Rear Banner, Bayannur, Inner Mongolia, China"
                                            },
                                            {
                                                "example_id": "448bc7dc-f94e-435c-8b47-604817e1ef3d",
                                                "sense_id": "81c3f35b-5d45-32a3-8f6e-5e42ed50c151",
                                                "text": "The first Inner Mongolian modern prose work was “Struggling in a Sea of Suffering” (Gashigun-u dotorakhi telchilegchi khemekhü üliger, 1940) by Rinchinkhorlo (1904-63) of Khüriye (Hure) banner, who also translated an American detective story from Japanese into Mongolian."
                                            }
                                        ]
                                    }
