                                "target_senses": [
                                    {
                                        "sense_id": "84bd37a2-63f5-3b6d-82ed-66e0c94c6275",
                                        "entry_id": "739a49d1-f3c4-3e8a-95b5-3ec8f93e356a",
                                        "glosses": [
                                            "A machine which reproduces documents by photographing the original over a glass plate and printing duplicates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd21b54-35b9-4710-8472-9af2b7bbc0e1",
                                                "sense_id": "84bd37a2-63f5-3b6d-82ed-66e0c94c6275",
                                                "text": "Now the chintzy nameplate is all that distinguishes his work space from those of the photocopier repairperson, diet food company, and kitchen designer down the hall."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a50c7a-d141-488f-aab7-fe3296065a27",
                        "source_entry_id": "7819a208-bd26-3173-99a2-7912b2a57196",
                        "source_sense_id": "ebeb6175-1d2f-3836-8946-f839373ea611",
                        "source_sense_description": "Gerät zum Fotokopieren",
                        "target_lang_word": "photocopieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photocopieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                        "entry_id": "8730c3bb-7ab0-3b7d-a651-6a3162f1ed2c",
                                        "glosses": [
                                            "Appareil utilisant un procédé xérographique qui est une technique d'électrophotographie et permettant de reproduire un document rapidement et à bon marché lorsque le nombre d'exemplaires à reproduire est relativement peu élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8ee5f5-ae46-4ea5-b712-7c753e926d6f",
                                                "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                                "text": "Le photocopieur est constitué d’un cylindre métallique nommé tambour ou photoconducteur recouvert d’une couche de matériau semi-conducteur."
                                            },
                                            {
                                                "example_id": "8fe1c5c9-2858-4969-ac4a-a9cb59bcee93",
                                                "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                                "text": "On lui a demandé de faire des photocopies. Elle dit: a) Le photocopieur, c’est où? b) Pourriez-vous me dire où se trouve le photocopieur? c) Je dois faire des photocopies. Qu’est-ce que je fais?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc4525f-2d1e-4df6-9091-dbfdeb08fb79",
                        "source_entry_id": "7819a208-bd26-3173-99a2-7912b2a57196",
                        "source_sense_id": "ebeb6175-1d2f-3836-8946-f839373ea611",
                        "source_sense_description": "Gerät zum Fotokopieren",
                        "target_lang_word": "photocopieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
