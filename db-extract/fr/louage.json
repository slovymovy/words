        "fr-extract.jsonl": [
            {
                "entry_id": "839c5409-d18c-370b-8a67-5e250538d890",
                "word": "louage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04c73963-aac8-44b9-9b8a-3a2eb1833cde",
                        "entry_id": "839c5409-d18c-370b-8a67-5e250538d890",
                        "tags": [
                            "plural"
                        ],
                        "form": "louages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a964b75d-6cb2-3580-9179-21ebaebdd6d7",
                        "entry_id": "839c5409-d18c-370b-8a67-5e250538d890",
                        "glosses": [
                            "Cession de l’usage de quelque chose, faite par le propriétaire pour un certain temps, moyennant un certain prix."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "5b87e761-a5cd-47f8-9df7-b325870bd4c4",
                                "sense_id": "a964b75d-6cb2-3580-9179-21ebaebdd6d7",
                                "text": "Les hommes qui n’ont pas eu de maison paternelle, qui, tout petits, ont été promenés de place en place dans des gîtes de louage, ne peuvent évidemment rien comprendre à ces vagues sentiments-là."
                            },
                            {
                                "example_id": "763a0170-d6f0-4bee-8487-e9664fde1457",
                                "sense_id": "a964b75d-6cb2-3580-9179-21ebaebdd6d7",
                                "text": "D’une façon générale, le législateur a divisé le louage en deux parties : le louage de choses et le louage d’ouvrage. Le premier comprend le louage des biens meubles et celui des immeubles. Le second englobe le louage de services personnels et le contrat d’entreprise."
                            },
                            {
                                "example_id": "13916c46-d338-43af-9f8a-5d8fe31371d3",
                                "sense_id": "a964b75d-6cb2-3580-9179-21ebaebdd6d7",
                                "text": "Un jour pourtant elle prit une auto de louage, et demanda au chauffeur de passer lentement sans s’arrêter sous les fenêtres de ce qu’on appelait à l’Asile le pavillon des Fougères."
                            },
                            {
                                "example_id": "e8bec4d5-7bb2-486a-9c24-4094d7a974a9",
                                "sense_id": "a964b75d-6cb2-3580-9179-21ebaebdd6d7",
                                "text": "Devant une vieille voiture de louage, portant la livrée d’un cocher, Fersen les attendait."
                            },
                            {
                                "example_id": "98624361-a3ee-41c7-a718-a7846cd74e14",
                                "sense_id": "a964b75d-6cb2-3580-9179-21ebaebdd6d7",
                                "text": "On vient en foule me réclamer le prix du louage, mais je n’ai un peu d’argent qu’à Nouakchott. Les propriétaires devront donc attendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3e45639-b3a3-3fd6-b6d9-0dcb4ed954c9",
                        "entry_id": "839c5409-d18c-370b-8a67-5e250538d890",
                        "glosses": [
                            "Taxi collectif."
                        ],
                        "tags": [
                            "Maghreb"
                        ],
                        "examples": [
                            {
                                "example_id": "a0199a0e-efcf-4708-8bc4-8cae352cb316",
                                "sense_id": "f3e45639-b3a3-3fd6-b6d9-0dcb4ed954c9",
                                "text": "Rapide, pratique et peu onéreux, le louage est un moyen de transport national en Tunisie. Forme institutionnalisée du covoiturage, ces minibus ou grands taxis collectifs accueillent jusqu’à 8 passagers et filent d’une destination à une autre dès que les places sont prises."
                            }
                        ]
                    }
