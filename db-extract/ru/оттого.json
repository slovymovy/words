                        ]
                    },
                    {
                        "translation_id": "bd071c30-ab4e-4430-9463-617e4ddb3a2b",
                        "source_entry_id": "f2036b68-fea9-3759-9c79-027989073f58",
                        "target_lang_word": "deshalb",
