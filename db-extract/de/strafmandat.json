                ],
                "senses": [
                    {
                        "sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                        "entry_id": "8f1e8007-52eb-3a91-941d-b260aab728dd",
                        "glosses": [
                            "schriftliche Verfügung in einem abgekürzten Verfahren; auch deren Inhalt und die Höhe der Verfügung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d45e50f-aa77-48a5-bdd5-551abe0a544a",
                                "sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                                "text": "„Tatsächlich sei er damals im Zuge einer Fahrzeugkontrolle angehalten worden, allerdings sei damals weder ein Strafmandat ergangen und sei ihm auch nicht erinnerlich, dass im Nachhinein eine Strafverfügung oder gar ein Straferkenntnis erlassen worden sei.“"
                            },
                            {
                                "example_id": "3d8689fd-f5c6-44ee-b592-1fad4f3c2ffa",
                                "sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                                "text": "„Die Erhöhung der Strafrahmen bedeutet aber gleichzeitig, dass die Strafmandate höher werden können.“"
                            },
                            {
                                "example_id": "aea60110-3b94-4c0b-ac02-2c59cbefbc46",
                                "sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                                "text": "„Es erwies sich in diesem Fall als ungünstig, dass die Militärprozess-Ordnung nicht die Ersetzung des Auditors vorsieht, wenn dessen Strafmandat von der vorgesetzten Stelle angefochten wird.“"
                            },
                            {
                                "example_id": "89fe5738-9e9c-46e6-aa98-c88eebe28d0f",
                                "sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                                "text": "„Weil er sich weigert, ein Strafmandat über 25 Euro zu bezahlen, muss ein Miesbacher für einen Tag ins Gefängnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74f356c8-6e70-4782-936d-0740c6142cd5",
                        "source_entry_id": "8f1e8007-52eb-3a91-941d-b260aab728dd",
                        "source_sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                        "source_sense_description": "schriftliche Verfügung in einem abgekürzten Verfahren; auch deren Inhalt und die Höhe der Verfügung",
                        "target_lang_word": "contravention",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contravention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c570f307-ae68-3c9e-b79c-9a3557801a45",
                                        "entry_id": "20a9d2eb-3a63-3497-8778-1324b305966c",
                                        "glosses": [
                                            "Action de contrevenir à une loi, à une ordonnance, à un règlement, à un décret ou à un contrat qu’on a fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b90343-f7fd-4b78-86ee-65c2662783f3",
                                                "sense_id": "c570f307-ae68-3c9e-b79c-9a3557801a45",
                                                "text": "C’est une contravention manifeste au traité de paix, au contrat, à l’acte de société que nous avons fait ensemble."
                                            },
                                            {
                                                "example_id": "4e7c3af8-7a19-4eaa-8ad3-fdd7faeab148",
                                                "sense_id": "c570f307-ae68-3c9e-b79c-9a3557801a45",
                                                "text": "— La quantité que vous avez là, dit le pharmacien, ne peut pas causer d’accidents ; cependant je suis en contravention avec la loi, car enfin, en allant chez plusieurs pharmaciens et en réunissant ainsi beaucoup de petites quantités, on finirait par en faire une grande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1e0b4c-0d28-3f55-8bec-eb7afa017756",
                                        "entry_id": "20a9d2eb-3a63-3497-8778-1324b305966c",
                                        "glosses": [
                                            "Dans la législation pénale, action de contrevenir aux règlements de police ; par opposition aux délits et aux crimes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d8174e-f508-46aa-9a0c-9500b82991a0",
                                                "sense_id": "fa1e0b4c-0d28-3f55-8bec-eb7afa017756",
                                                "text": "Individuellement ou en \"petty sessions\", les Magistrats procèdent à la recherche, dans leur voisinage, des contraventions, délits et crimes de toute espèce."
                                            },
                                            {
                                                "example_id": "3f1d41d9-c185-44f0-8a49-29133f20ec05",
                                                "sense_id": "fa1e0b4c-0d28-3f55-8bec-eb7afa017756",
                                                "text": "Le législateur de 1810 a traité séparément des contraventions de simple police et les a classifiées ordinairement selon leur objet , la plupart de ces contraventions étant culpeuses de leur nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "967a3db4-f2a3-3341-9226-2ca975f6e44e",
                                        "entry_id": "20a9d2eb-3a63-3497-8778-1324b305966c",
                                        "glosses": [
                                            "Procès-verbal fait par la police de cet acte contraire aux règlements, en particulier le code de la route, auquel est souvent jointe une injonction de payer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c88272e-4e87-415d-8a10-f5c8948154b5",
                                                "sense_id": "967a3db4-f2a3-3341-9226-2ca975f6e44e",
                                                "text": "Le duc le plus haut gradé d’Angleterre, qui détient aussi le titre de comte-maréchal, avait déjà eu deux contraventions pour des excès de vitesse en 2019, d’où la sévérité de la sanction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ce2a51-3df4-30ae-813d-2c67ac865f09",
                                        "entry_id": "20a9d2eb-3a63-3497-8778-1324b305966c",
                                        "glosses": [
                                            "Amende versée à la police."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c628e384-3a52-4d7e-9259-355e7fc204bf",
                                                "sense_id": "e8ce2a51-3df4-30ae-813d-2c67ac865f09",
                                                "text": "L’éventualité de la gifle dissuade l'enfant de déchirer les livres de la bibliothèque paternelle, comme l’éventualité de la contravention dissuade l'automobiliste de stationner, dans la zone bleue, au delà de l'heure marquée au cadran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba09ed9c-b9db-43e6-a76f-0297de714ad0",
                        "source_entry_id": "8f1e8007-52eb-3a91-941d-b260aab728dd",
                        "source_sense_id": "93cc45ee-0722-3f9c-b322-e15c0c292a3d",
                        "source_sense_description": "schriftliche Verfügung in einem abgekürzten Verfahren; auch deren Inhalt und die Höhe der Verfügung",
                        "target_lang_word": "contredanse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contredanse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                        "entry_id": "c754912a-8b08-3a9d-a660-1f0a3d7e79e9",
                                        "glosses": [
                                            "Sorte de danse composée de figures qui s’exécute ordinairement à huit personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c8ee5fe-1ca6-4c8f-8c75-108b588c48cb",
                                                "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                                "text": "— Me ferez-vous l’honneur de danser cette contredanse avec moi, mademoiselle ?"
                                            },
                                            {
                                                "example_id": "808e82c2-9f85-49a6-9ae0-1bb0d8193b3f",
                                                "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                                "text": "— Monsieur Leuwen, lui dit-elle de loin, je vous demande de danser avec moi la première contredanse.\n« C’est charmant, se dit Lucien, et voilà ce qu’on n’oserait pas se permettre à Paris. Réellement, ces pays étrangers ont du bon ; ces gens-ci sont moins timides que nous. »"
                                            },
                                            {
                                                "example_id": "6c2cc0c7-b924-46b7-8564-2370139f646d",
                                                "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                                "text": "Ces danseurs et ces danseuses, presque étrangers à la maison, et qui finissent par s’emparer du terrain à toutes les noces, se livraient à ces interminables dernières contredanses nommées des cotillons, les joueurs de bouillotte étaient acharnés à leurs tables, le père Crevel gagnait six mille francs."
                                            },
                                            {
                                                "example_id": "aa6277da-4443-45b5-9565-7ab23f477af5",
                                                "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                                "text": "La soirée se termine par un petit bal improvisé, où l’on ne danse, hélas ! ni jota, ni fandango, ni bolero, ces danses étant abandonnées aux paysans, aux servantes et aux bohémiens, mais bien la contredanse et le rigodon, et quelquefois la valse."
                                            },
                                            {
                                                "example_id": "f1a7e542-0b59-4342-90a5-9d953c1f4c37",
                                                "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                                "text": "Le dimanche, dans l’après-midi, on se réunissait sous un petit berceau de vignes qui touchait la maison ; j’allais prendre ma harpe au clou où elle restait accrochée pendant toute la semaine, et je faisais danser les deux frères et les deux sœurs. Ni les uns ni les autres n’avaient appris à danser, mais Alexis et Benjamin avaient été une fois à un bal de noces aux Mille-Colonnes, et ils en avaient rapporté des souvenirs plus ou moins exacts de ce qu’est la contredanse ; c’étaient ces souvenirs qui les guidaient."
                                            },
                                            {
                                                "example_id": "7a0f4e3a-aa98-4517-be7c-a9131765e591",
                                                "sense_id": "0704fa0a-d625-3088-87bd-65b86fecf95d",
                                                "text": "La contredanse havanaise est issue en droite ligne des contredanses anglaise et française. Assaisonnée à la sauce locale par Noirs, Blancs et mulâtres, elle a pris le nom de habanera. Ces danses de figures nous arrivèrent par diverses voies, dès le XVIIIe siècle, mais en particulier par les pièces légères de la scène espagnole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e87f84-4470-3825-bd2a-df5e1cb0d4d4",
                                        "entry_id": "c754912a-8b08-3a9d-a660-1f0a3d7e79e9",
                                        "glosses": [
                                            "Air de contredanse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284de0b6-adf0-44f1-88b3-b1775df920ba",
                                                "sense_id": "88e87f84-4470-3825-bd2a-df5e1cb0d4d4",
                                                "text": "Jouer une contredanse."
                                            },
                                            {
                                                "example_id": "46c768a8-cb70-4b4b-a01f-fac15b102a83",
                                                "sense_id": "88e87f84-4470-3825-bd2a-df5e1cb0d4d4",
                                                "text": "Entre huit et neuf heures, une sorte de rumeur joyeuse éclata dans le fond de la plaine, et fit aboyer subitement tous les chiens de ferme des environs ; c’était la musique aigre et cadencée des cornemuses jouant un air de contredanse."
                                            },
                                            {
                                                "example_id": "88f267a7-c46a-4be6-81a8-ba54dc3ff7b8",
                                                "sense_id": "88e87f84-4470-3825-bd2a-df5e1cb0d4d4",
                                                "text": "Pour leur plaire, il faudrait les mener au bal, les régaler, faire des calembours, parler beaucoup, les faire parler davantage, leur faire écouter des contredanses ou de la musique de régiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eea7f49-faf0-33b9-94b2-e6e48620d3ef",
                                        "entry_id": "c754912a-8b08-3a9d-a660-1f0a3d7e79e9",
                                        "glosses": [
                                            "Contravention."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "260627e7-7164-405a-8b30-866dfe81d366",
                                                "sense_id": "3eea7f49-faf0-33b9-94b2-e6e48620d3ef",
                                                "text": "Lâche encore ce volant et je te colle une contredanse."
                                            },
                                            {
                                                "example_id": "33d25976-7eb2-4a67-bef6-c1e43495d034",
                                                "sense_id": "3eea7f49-faf0-33b9-94b2-e6e48620d3ef",
                                                "text": "Infliger une contredanse, même peu salée, à Bernard Arnault pour mouillage irrégulier aurait fait mauvais genre…"
                                            },
                                            {
                                                "example_id": "029dd04c-6290-4cc0-9f24-be905d2ccde4",
                                                "sense_id": "3eea7f49-faf0-33b9-94b2-e6e48620d3ef",
                                                "text": "– Si t’es venu me coller une contredanse, c’est pas la peine. La voiture est volée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contredanse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbfe3f9b-3030-309a-8726-2fc19d7d828e",
                                        "entry_id": "0373da44-abb1-3769-9656-5b969f11fc42",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de contredanser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
