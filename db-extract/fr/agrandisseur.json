                        "sense_id": "c0da954d-c129-322e-be4e-fa3b287549d1",
                        "entry_id": "96fa10ec-738f-306c-bdee-a44c0448d072",
                        "glosses": [
                            "Appareil utilisé en photographie pour réaliser des agrandissements à partir de négatifs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249c1e48-72ae-4725-af51-310662b7b0ca",
                                "sense_id": "c0da954d-c129-322e-be4e-fa3b287549d1",
                                "text": "Si l’objectif de votre appareil photographique forme l’image qui sera sur le négatif, celui de l’agrandisseur forme l’image agrandie du négatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdc0ec20-cd65-414e-82f5-238593184d9c",
                        "source_entry_id": "96fa10ec-738f-306c-bdee-a44c0448d072",
                        "source_sense_id": "c0da954d-c129-322e-be4e-fa3b287549d1",
                        "target_lang_word": "enlarger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlarger",
