                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f848093a-1784-4678-913c-a8df7bbc7101",
                                "sense_id": "a0500524-bfe1-36fb-a6e0-b215fb70e196",
                                "text": "Before they could agree or disagree he’d hauled the horse around by the hackamore and was pounding off up the track."
