                    },
                    {
                        "sense_id": "496c1667-b47c-3f16-9cc5-0e855bc45769",
                        "entry_id": "27cb2369-3ffe-3787-a0cc-a851d025af69",
                        "glosses": [
                            "изготовленный из фильдекоса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7328e09-f390-41c1-aec7-c0c400457d3c",
                                "sense_id": "496c1667-b47c-3f16-9cc5-0e855bc45769",
                                "text": "Ежели баба в шляпке, ежели чулочки на ней фильдекосовые, или мопсик у ней на руках, или зуб золотой, то такая аристократка мне и не баба вовсе, а гладкое место."
                            }
                        ]
                    }
