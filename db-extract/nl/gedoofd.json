            {
                "entry_id": "aebf16ab-b4c7-3fef-9bb3-f41702a56f70",
                "word": "gedoofd",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25f48d49-fe8b-3fb4-9270-fffb0797a76a",
                        "entry_id": "aebf16ab-b4c7-3fef-9bb3-f41702a56f70",
                        "glosses": [
                            "van een brandend vuur dat het is uitgemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ac6684-151d-4c7e-9bfa-ee18916815d1",
                                "sense_id": "25f48d49-fe8b-3fb4-9270-fffb0797a76a",
                                "text": "Bij een brand in een studentencomplex aan de Ina Boudier-Bakkerlaan in Utrecht zijn vijf mensen gewond geraakt. De bewoners hebben rook ingeademd en zijn in een ziekenhuis behandeld. Het complex is ontruimd, maar inmiddels weer vrijgegeven. De brand is vermoedelijk ontstaan door een niet volledig gedoofde vuurkorf."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc49a636-5c01-306a-8266-1f07939af453",
                        "entry_id": "aebf16ab-b4c7-3fef-9bb3-f41702a56f70",
                        "glosses": [
                            "van een vulkaan dat deze niet meer actief is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6ad633-1a70-46d4-b057-7075088e43f8",
                                "sense_id": "dc49a636-5c01-306a-8266-1f07939af453",
                                "text": "Vanaf het strand is er uitzicht op La Graciosa, dat geliefd is bij dagjesmensen vanwege de ongerepte sfeer en stranden. Links liggen de witte huizen van het dorp Orzola, met pal daarachter de contouren van enkele gedoofde vulkanen van bijna 700 meter hoogte."
                            }
                        ]
                    },
                    {
                        "sense_id": "5750a9a3-381e-35a5-b4b3-8ef1d2f1c521",
                        "entry_id": "aebf16ab-b4c7-3fef-9bb3-f41702a56f70",
                        "glosses": [
                            "van lichten dat ze zijn uitgedaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00469018-3ba5-42de-8f87-a70797de2a1a",
                                "sense_id": "5750a9a3-381e-35a5-b4b3-8ef1d2f1c521",
                                "text": "Getuigen zagen 16 juni kort na de explosie om 03.30 uur aan de Lattropbrink twee donker geklede mannen wegrennen. Kort daarna reed een auto met gedoofde lichten weg."
                            },
                            {
                                "example_id": "93af02a4-01b3-4d6a-82eb-98b41e020846",
                                "sense_id": "5750a9a3-381e-35a5-b4b3-8ef1d2f1c521",
                                "text": "Even was hij twintig jaar terug, in de commandotoren van een u-boot, die geruisloos Wilhelmshaven uit voer, met gedoofde lichten, de duisternis in."
                            }
                        ]
                    },
                    {
                        "sense_id": "91061543-1e0d-3a5e-bc82-ace7544938d9",
                        "entry_id": "aebf16ab-b4c7-3fef-9bb3-f41702a56f70",
                        "glosses": [
                            "van een heftige emotie dat men die niet meer heeft"
                        ],
                        "tags": [],
                        "examples": []
                    }
