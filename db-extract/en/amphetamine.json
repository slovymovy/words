                    {
                        "translation_id": "513b7088-1929-41da-a747-c85fb4d0e20c",
                        "source_entry_id": "155dd3ed-c6cb-3907-939d-eeff69cc3021",
                        "source_sense_description": "amphetamine",
                        "target_lang_word": "amphétamine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphétamine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                        "entry_id": "e93970d8-97fc-373d-a635-e4cfa6409726",
                                        "glosses": [
                                            "Molécule synthétique de formule brute C₉H₁₃N utilisée comme drogue, dopant sportif, stimulant du système nerveux central, coupe-faim ou médicament dans le traitement de l'hyperactivité chez l’enfant, pour ses effets anorexigène et psychoanaleptique."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8400405-48b4-471e-94a7-16c58f6f853a",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "Il avala deux pilules de maxiton. L’usage des dopants à base d’amphétamine d’abord pratiqué par les étudiants pendant les périodes d’examens, est devenu commun chez les ouvriers depuis les années 1948 ; à Bionnas, on les utilise fréquemment pour vaincre la somnolence d’après la sixième ou septième heure du travail aux presses."
                                            },
                                            {
                                                "example_id": "5cf117a7-7488-4f85-912b-f14f98a86f82",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "L’amphétamine et ses dérivés font partie de ce qu’on a appelé les dopants de la première génération."
                                            },
                                            {
                                                "example_id": "8c82e676-5c3c-4053-b5f7-d46b4ac2a488",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "Très vite, le lien entre ce que voulait dire Motörhead, ou speedfreak, c'est-à-dire quelqu'un qui carbure aux amphétamines et surtout pas aux drogues dures de type héroïne."
                                            },
                                            {
                                                "example_id": "fbe3cc5f-af5f-45c1-8e57-81897ebde521",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "On trouve le reste en pharmacie : morphine ou méthédrine, une amphétamine prisée des routards ; et en avant la fixette, à moi les cachetons avalés entre deux shiloms."
                                            },
                                            {
                                                "example_id": "807040f2-d9cc-4433-8d0b-5bf234919923",
                                                "sense_id": "fdce79f7-4685-323f-903b-6874e3dfdc3b",
                                                "text": "Les amphétamines sont connues pour couper les élans vitaux mais cette fois-là, ce fut le contraire et Lélia avait été conçue dans l’euphorie d’une nuit sans fin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3cf4e1a-fc19-4df1-8bb4-436e69a2bc96",
                        "source_entry_id": "155dd3ed-c6cb-3907-939d-eeff69cc3021",
                        "source_sense_description": "amphetamine",
                        "target_lang_word": "Amphetamin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amphetamin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "348265e2-1814-345e-899a-588289797d09",
                                        "entry_id": "66b18fd3-1b6a-3b1b-b9ff-dda1e7430fd1",
                                        "glosses": [
                                            "synthetisch hergestelltes Mittel, das das zentrale Nervensystem anregt und das als Droge verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b677d1f-5007-4d9d-af5f-d46d2e907688",
                                                "sense_id": "348265e2-1814-345e-899a-588289797d09",
                                                "text": "Amphetamin, die Muttersubstanz aller „Wachmacher“, wurde schon 1887 synthetisiert – zur Behandlung von Schnupfen."
                                            },
                                            {
                                                "example_id": "4369bc11-8fe2-46f9-8554-19ab969d3484",
                                                "sense_id": "348265e2-1814-345e-899a-588289797d09",
                                                "text": "In den 1930er Jahren fügten Chemiker der Berliner Temmler-Werke dem Amphetamin eine zusätzliche Methylgruppe an und verkauften den neuen Wirkstoff in Tablettenform."
                                            },
                                            {
                                                "example_id": "67774997-735b-400b-9abc-91abac1a10b1",
                                                "sense_id": "348265e2-1814-345e-899a-588289797d09",
                                                "text": "Wegen des millionenschweren Schmuggels von rund 130 Kilo Amphetamin ist ein Drogenkurier vor dem Landgericht Trier zu acht Jahren Gefängnis verurteilt worden."
                                            },
                                            {
                                                "example_id": "1267e226-1e27-439d-8e22-0cfce53cf79b",
                                                "sense_id": "348265e2-1814-345e-899a-588289797d09",
                                                "text": "Amphetamin und Metamphetamin sind gem. § l Abs. l Betäubungsmittelgesetz (BtMG) in Verbindung mit der Anlage III verkehrs- und verschreibungsfähige Betäubungsmittel."
                                            },
                                            {
                                                "example_id": "24aa1f05-7c36-478c-a20b-43adf398c5cf",
                                                "sense_id": "348265e2-1814-345e-899a-588289797d09",
                                                "text": "Beim abruptem Absetzen von Amphetaminen treten kurzzeitig deutliche, vor allem psychische Entzugssymptome auf, welche das Verlangen nach der Droge (»Stoffhunger«) zum Wiedererlangen des Rauschzustandes steigern […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
