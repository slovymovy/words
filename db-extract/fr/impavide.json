                                        "glosses": [
                                            "Without fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cb932d-72f2-4036-bd05-73814a06359d",
                                                "sense_id": "6b42e1d5-bece-3753-9a6c-ff7410bf5fd4",
                                                "text": "\"Our fearless reporter\"... I'm not fearless, John. I don't like this."
                                            },
                                            {
                                                "example_id": "1a1543d8-046f-4a20-840e-0ebef7e87a1b",
                                                "sense_id": "6b42e1d5-bece-3753-9a6c-ff7410bf5fd4",
                                                "text": "England's wicket-keeper in the 50s, he was fearless about standing on the stumps to fastish bowlers[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
