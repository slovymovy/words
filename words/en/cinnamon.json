{
    "word_family": [
        "cinnamonic",
        "cinnamony"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3dac6264-394d-3ad3-a787-7f87cfd79722",
                    "sense_definition": "A spice made from the dried aromatic bark of certain trees, used in cooking as a powder or in sticks.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cinnamon_spice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love to sprinkle some <w>cinnamon</w> on my oatmeal every morning for extra flavor.",
                            "target_lang_translations": {
                                "ru": "Я люблю каждое утро посыпать овсянку <w>корицей</w> для дополнительного вкуса."
                            }
                        },
                        {
                            "text": "The recipe calls for a <w>cinnamon</w> stick to be simmered with the apple cider.",
                            "target_lang_translations": {
                                "ru": "По рецепту палочку <w>корицы</w> нужно варить на медленном огне вместе с яблочным сидром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ground cinnamon",
                        "cinnamon stick",
                        "cinnamon powder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пряность, изготовленная из высушенной ароматной коры определенных деревьев, используемая в кулинарии в виде порошка или палочек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корица",
                                "target_lang_sense_clarification": "пряность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42a79c87-a505-3498-996c-e3514a559ff6",
                    "sense_definition": "A warm, yellowish-brown color resembling the spice.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cinnamon_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat had beautiful <w>cinnamon</w> fur that glowed in the sunlight.",
                            "target_lang_translations": {
                                "ru": "У кошки была красивая шерсть <w>цвета корицы</w>, которая сияла на солнце."
                            }
                        },
                        {
                            "text": "She chose a <w>cinnamon</w> shade of paint for the living room walls.",
                            "target_lang_translations": {
                                "ru": "Она выбрала <w>коричный</w> оттенок краски для стен в гостиной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cinnamon color",
                        "shade of cinnamon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплый желтовато-коричневый цвет, напоминающий эту пряность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коричневый цвет",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "цвет корицы",
                                "target_lang_sense_clarification": "специфический оттенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "252c5ece-ba84-3d95-a698-573fa2c11376",
                    "sense_definition": "A small evergreen tree native to South Asia from which the spice is obtained.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cinnamon_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cinnamon</w> tree is widely cultivated in Sri Lanka for its aromatic bark.",
                            "target_lang_translations": {
                                "ru": "<w>Коричное дерево</w> широко культивируется на Шри-Ланке ради его ароматной коры."
                            }
                        },
                        {
                            "text": "Farmers carefully peel the bark from the <w>cinnamon</w> to produce the spice we use.",
                            "target_lang_translations": {
                                "ru": "Фермеры осторожно снимают кору с <w>коричника</w>, чтобы произвести пряность, которую мы используем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cinnamon tree",
                        "wild cinnamon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое вечнозеленое дерево, родом из Южной Азии, из которого получают пряность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коричное дерево",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "коричник",
                                "target_lang_sense_clarification": "ботаническое название"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
