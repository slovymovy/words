                                    {
                                        "sense_id": "2d5f90da-7173-34bc-8e4f-fcdd089087bd",
                                        "entry_id": "9b7047b5-b2f8-347e-8f51-64ef32bcf6ed",
                                        "glosses": [
                                            "A bomb that generates thick smoke when it explodes; used especially to produce a smokescreen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31360011-83a9-48bd-a7a9-03f0c62a55a9",
                        "source_entry_id": "bb0ccd09-bf6d-3812-b7b1-b84ba0b5ca38",
                        "source_sense_id": "0b67a85e-4e9f-3517-9ecf-6810748469d0",
                        "source_sense_description": "Militär: Wurfgeschoss zur Erzeugung von Rauch oder Nebel",
                        "target_lang_word": "fumigène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fumigène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                        "entry_id": "bf3dee1a-9342-3c4b-bb9b-eb561bd8c0e2",
                                        "glosses": [
                                            "Qui génère de la fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc21521-1c96-4d0a-9536-7ea5a4c3c0fa",
                                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                                "text": "Seize personnes […] auraient été arrêtées par la police qui a utilisé des bombes fumigènes."
                                            },
                                            {
                                                "example_id": "f8e2a5ec-85c8-4ac7-a873-456cba670168",
                                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                                "text": "Les observatoires de la colline de Saint-Walfroy, située à l'est, de l'autre côté de la Chiers, seront aveuglés par des tirs fumigènes qui seront poursuivis jusqu'à la tombée de la nuit."
                                            },
                                            {
                                                "example_id": "32205117-b4d9-43cf-a582-9d3dad8811de",
                                                "sense_id": "0f17bf20-52ab-327e-8c29-f104bc92a741",
                                                "text": "Elle insulta un piéton qui traversait et se faufila en donnant des coups de klaxon indignés dans l’étroit passage laissé par un taxi et un bus fumigène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fumigène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                                        "entry_id": "9a617376-45ef-3c60-b755-093e0a7f7113",
                                        "glosses": [
                                            "Objet destiné à produire de la fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0726ea76-9e08-4aae-ad0c-fc204eb62a93",
                                                "sense_id": "06c468ba-edad-334d-bef7-9cfdd1e8a1bc",
                                                "text": "D’énormes fumigènes rouges et une bombe agricole illuminèrent le virage de Boulogne, et différents projectiles fusèrent en direction du terrain sous les cris de : « CRS marseillais ! » Des agents de sécurité couraient dans tous les sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e78c60f6-5bae-4810-8071-3eb57dfbdf0d",
                        "source_entry_id": "bb0ccd09-bf6d-3812-b7b1-b84ba0b5ca38",
                        "source_sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                        "source_sense_description": "übertragen: sprachliches Mittel, um etwas zu verschleiern",
                        "target_lang_word": "red herring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "red herring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45ca3762-ba3c-3768-9f6f-9ce85d6c4c5f",
                                        "entry_id": "89868f88-e125-3191-8fd6-5a4f722c1e45",
                                        "glosses": [
                                            "A herring that is cured in smoke and brine strong enough to turn the flesh red; a typeof kipper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254132d3-d42d-4583-8444-fb6f0bbf15b7",
                                                "sense_id": "45ca3762-ba3c-3768-9f6f-9ce85d6c4c5f",
                                                "text": "Up in the morning, and had some red herrings to our breakfast, while my boot-heel was a-mending, by the same token the boy left the hole as big as it was before."
                                            },
                                            {
                                                "example_id": "4dbe0670-6137-4d80-b82e-755a64d62ba1",
                                                "sense_id": "45ca3762-ba3c-3768-9f6f-9ce85d6c4c5f",
                                                "text": "‘Mamma,’ said Rosamond, ‘when Fred comes down I wish you would not let him have red herrings. I cannot bear the smell of them all over the house at this hour of the morning.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340aa94d-5487-3c8d-8d9c-b772c220956b",
                                        "entry_id": "89868f88-e125-3191-8fd6-5a4f722c1e45",
                                        "glosses": [
                                            "A clue, information, argument, etc. that is or is intended to be misleading, diverting attention from the real answer or issue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f06fc9-cf9e-41d6-918a-8031086fae3a",
                                                "sense_id": "340aa94d-5487-3c8d-8d9c-b772c220956b",
                                                "text": "By its thirtieth episode, the show [Twin Peaks] had degenerated into tics and shticks and mannerisms and red herrings, and part of the explanation for this was that [David] Lynch was trying to divert our attention from the fact that he really had no idea how to wrap the central murder case up."
                                            },
                                            {
                                                "example_id": "ad8bb53d-1a78-40da-948b-a01a802d7e0d",
                                                "sense_id": "340aa94d-5487-3c8d-8d9c-b772c220956b",
                                                "text": "I will, of course, turn my analytical talents to bear on the identity of the imitation Hathor, but in my opinion she is only a red herring – a nuisance, a distraction."
                                            },
                                            {
                                                "example_id": "20e8d5d7-bdc0-4c6e-ac3b-4209e1cfe84f",
                                                "sense_id": "340aa94d-5487-3c8d-8d9c-b772c220956b",
                                                "text": "Colombia is a red herring, however. The songs that became Madame X actually came together during Madonna’s two years in Portugal, where she decamped in 2017 when her son David enrolled in Benfica’s football academy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b374b69-4fa4-3a1a-b995-224cc5bbdbfb",
                                        "entry_id": "89868f88-e125-3191-8fd6-5a4f722c1e45",
                                        "glosses": [
                                            "A red herring prospectus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4b1bbd2-1509-3785-9511-59963b7b2e08",
                                        "entry_id": "89868f88-e125-3191-8fd6-5a4f722c1e45",
                                        "glosses": [
                                            "A soldier."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "056a84be-0a3c-409e-bed5-15a168a5485d",
                                                "sense_id": "f4b1bbd2-1509-3785-9511-59963b7b2e08",
                                                "text": "“Devil a bit, Ma’am,” said the Major. “We couldn’t afford it. Unless the world was peopled with J.B.’s—tough and blunt old Joes, Ma’am, plain red herrings with hard roes, Sir—we couldn’t afford it. It wouldn’t do.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edd502c0-1108-4b8e-843a-a45feed0480a",
                        "source_entry_id": "bb0ccd09-bf6d-3812-b7b1-b84ba0b5ca38",
                        "source_sense_id": "7d740e4a-23e6-3911-8c56-8a5ee0d32f4e",
                        "source_sense_description": "übertragen: sprachliches Mittel, um etwas zu verschleiern",
                        "target_lang_word": "enfumage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfumage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "910709c1-70f2-3493-a6c3-6d42ac669057",
                                        "entry_id": "838c7109-42b7-3354-bc2d-b8b0c4aad644",
                                        "glosses": [
                                            "Action d’enfumer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bd24566-ad9e-322d-8511-a6415c02946a",
                                        "entry_id": "838c7109-42b7-3354-bc2d-b8b0c4aad644",
                                        "glosses": [
                                            "Désinformation, intoxication."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "066fc8b6-9ff5-4920-acb6-8394cc220381",
                                                "sense_id": "6bd24566-ad9e-322d-8511-a6415c02946a",
                                                "text": "Mais, en interne, c’est enfumage et bouche cousue […]."
                                            },
                                            {
                                                "example_id": "e259078b-c42e-411d-85f7-c37cb7210616",
                                                "sense_id": "6bd24566-ad9e-322d-8511-a6415c02946a",
                                                "text": "Bref, la haine de l’autre se serait infiltrée partout. Partout, sauf à gauche, forcément. Une fois de plus, la France doit supporter le numéro d’enfumage du parti du Bien."
                                            },
                                            {
                                                "example_id": "71e83795-fea2-45cc-8f3e-2408b2db9c9d",
                                                "sense_id": "6bd24566-ad9e-322d-8511-a6415c02946a",
                                                "text": "À terme, la complexité d’un réel qui ne se laisse jamais ressaisir intégralement par une seule théorie devient, pour eux, une forme d’enfumage idéologique, servant à détourner le peuple qu’ils croient incarner de la Vérité qu’ils croient posséder dans sa version majusculaire, illuminés qu’ils sont par la nouvelle révélation."
                                            },
                                            {
                                                "example_id": "786169f1-4a8a-458d-ab85-de415b44cdb2",
                                                "sense_id": "6bd24566-ad9e-322d-8511-a6415c02946a",
                                                "text": "Un fiasco. La semaine dernière, nous avons publié un article sur notre site Internet à propos d’une – supposée, car cela s’est révélé faux – exploitation d’une femme sans papiers algérienne par le couple de députés Raquel Garrido et Alexis Corbière. Mal nous en a pris, car il y avait là une bonne couche d’enfumage, y compris une manipulation probable venant de l’extérieur du journal (et nous en recherchons l’origine)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
