                "senses": [
                    {
                        "sense_id": "585c58aa-ddfe-363f-8db8-36776180730f",
                        "entry_id": "fbf12e97-2828-3728-983c-61bb35a70e7e",
                        "glosses": [
                            "Auto, das von einem Raketentriebwerk angetrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a00ae8-ab53-45b6-80f0-93c107179959",
                                "sense_id": "585c58aa-ddfe-363f-8db8-36776180730f",
                                "text": "„1970 fuhr Gary Gabelich mit seinem Raketenauto Blue Flame mit über 1000 km/h über das Salz.“"
                            },
                            {
                                "example_id": "67c827f2-b394-416b-9724-0f5bfdce4477",
                                "sense_id": "585c58aa-ddfe-363f-8db8-36776180730f",
                                "text": "„Lange existierte das Raketenauto nur als Modell - jetzt soll mit dem Bau begonnen werden.“"
                            },
                            {
                                "example_id": "d9ceb550-2724-4632-bd35-5ff35b757599",
                                "sense_id": "585c58aa-ddfe-363f-8db8-36776180730f",
                                "text": "„Zum Serienstatus hat es der Raketenantrieb bei Autos nie geschafft – aber Opel ging es auch mehr um die Faszination an der ultramodernen Technik, als die Rüsselsheimer 1927 mit ihren Forschungen zu einem Raketenauto begannen.“"
                            }
                        ],
