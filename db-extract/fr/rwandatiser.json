                ],
                "senses": [
                    {
                        "sense_id": "c262a2ad-938b-37d8-b50f-132694d7b9fb",
                        "entry_id": "bddc628b-dd9f-307d-8d59-ed8c87fcba7a",
                        "glosses": [
                            "Donner un caractère rwandais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8417892f-8ebb-492e-be68-74f5d3a74903",
                                "sense_id": "c262a2ad-938b-37d8-b50f-132694d7b9fb",
                                "text": "Des pseudo-Nationalistes qui souhaitent voir le pays de Samuel Eto'o rwandatisé par l'aide satanique américaine."
                            },
                            {
                                "example_id": "4621d896-d9f5-4b3b-922a-8978c751cdbe",
                                "sense_id": "c262a2ad-938b-37d8-b50f-132694d7b9fb",
                                "text": "Le simple fait pour ce brillant juriste et originaire de l'Ouest-Cameroun d'avoir pris mr Alassane Dramane Ouattaracomme une référence politique pour lui aurait suffit à tous les Jeunes Panafricains qui crient en longueur de journée sur les réseaux sociaux de comprendre que le Cameroun était sur le chemin de se faire somaliser et rwandatiser."
                            },
                            {
                                "example_id": "10affafb-c4ef-4f26-a75e-4c738601f124",
                                "sense_id": "c262a2ad-938b-37d8-b50f-132694d7b9fb",
                                "text": "Qu'est-ce que fait croire aux Haïtiens qu'Haïti ne peut pas être rwandatisé, sierraléonisé, soudanisé, etc?"
                            }
                        ]
                    }
