                    },
                    {
                        "form_id": "152bbe16-e8c8-45ed-8e3b-c62ec56da2c4",
                        "entry_id": "9bad525b-d3cc-3ab9-936b-ee32b7bf7d8e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lieferservices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b062204c-3190-3180-b775-a33e0449d339",
                        "entry_id": "9bad525b-d3cc-3ab9-936b-ee32b7bf7d8e",
                        "glosses": [
                            "vom Empfänger ausgehende Beurteilung der Leistungsfähigkeit beziehungsweise Qualität einer logistischen Dienstleistung, abhängig zum Beispiel von Lieferzeit, -zuverlässigkeit und -flexibilität"
                        ],
                        "tags": [
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "0e113e8e-968a-4cf3-a5ad-9837fe8341ec",
                                "sense_id": "b062204c-3190-3180-b775-a33e0449d339",
                                "text": "„Der Lieferservice wird durch die Komponenten Lieferzeit, Lieferbereitschaft und Lieferzuverlässigkeit gemeinsam gekennzeichnet. Zuweilen wird auch die Lieferflexibilität als Teil des Lieferservice angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "71633a17-49bd-309a-9416-ac39d62fcf60",
                        "entry_id": "9bad525b-d3cc-3ab9-936b-ee32b7bf7d8e",
                        "glosses": [
                            "Dienstleistung, die den Transport von bestellten Produkten eines Unternehmens (zum Beispiel Pizzaservice) zum Kunden betreibt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "5fe22ea0-33b5-4714-a6ab-718cc3440582",
                                "sense_id": "71633a17-49bd-309a-9416-ac39d62fcf60",
                                "text": "„Mein Abendessen kommt heute nicht aus der eigenen Küche, sondern vom Lieferservice.“"
                            },
                            {
                                "example_id": "e204549a-c876-4cc4-b5cc-02a19397f738",
                                "sense_id": "71633a17-49bd-309a-9416-ac39d62fcf60",
                                "text": "„Sie sieht einen weißen Van vor der Haustür, ihr erster Gedanke ist, dass ein Lieferservice etwas abgeben will.“"
                            },
                            {
                                "example_id": "d32478a6-1889-43a1-bdc9-bcd2a612627b",
                                "sense_id": "71633a17-49bd-309a-9416-ac39d62fcf60",
                                "text": "„Für die meisten Restaurantbesitzer ist ein eigener Lieferservice schlichtweg zu teuer, doch hiermit bietet ihnen Deliveroo die Möglichkeit, ihren Umsatz zu steigern – teilweise bis zu 1/5 des Gesamtumsatzes.“"
                            },
                            {
                                "example_id": "2d1e5240-09dd-491c-989e-38a0810fd023",
                                "sense_id": "71633a17-49bd-309a-9416-ac39d62fcf60",
                                "text": "„Thomas hätte lieber einen Lebenmitteleinzelhändler mit Lieferservice in der Familie.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
