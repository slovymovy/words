                "senses": [
                    {
                        "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                        "entry_id": "a0c84455-e510-3a11-b7c5-e8d8113859ab",
                        "glosses": [
                            "Gerät zum Beheizen von Räumen, das meist mit Holz oder Kohlen als Energieträger betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc6c2903-ef34-4121-92e8-38090598a357",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "Anzeige: Wir vermieten eine 2-Zimmer-Wohnung mit Ofenheizung."
                            },
                            {
                                "example_id": "7de6222b-a345-41c0-8f25-07c07ea9f5a9",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "Anzeige: Vermiete 3 1/2 Zimmerwohnung, 2. OG o. Fahrstuhl, Ofenheizung, EBK, Bad, Balkon, Kellerraum, in 12345 Adorf, Miete: 450,-- kalt, Tel. 0170/1234567"
                            },
                            {
                                "example_id": "966d8e5a-512c-4d87-a746-9a88f7f32fea",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„In den 1970er Jahren verdrängten die aufkommenden Zentralheizungen die bis dahin üblichen Ofenheizungen.“"
                            },
                            {
                                "example_id": "f44d9e02-e145-48ea-8932-888c857091a3",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Zu den letzten günstigen Quartieren gehören Wohnungen mit Ofenheizung.“"
                            },
                            {
                                "example_id": "bed223a5-7b2a-4e5d-afe0-ad4720eaccf0",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Auch der Brennholzpreis hat sich in diesem Jahr verdreifacht, aber Ofenheizung ist immer noch am billigsten.“"
                            },
                            {
                                "example_id": "a6b7eb14-d317-4fa3-bc08-1931519fb504",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "[Alte Kolonie Eving/Dortmud:] „Alle Wohnungen waren mit fließendem Wasser und Ofenheizung ausgestattet und verfügten über einen eigenen Eingang, einen Stall sowie Gartenland.“"
                            },
                            {
                                "example_id": "04d9ed2b-a828-4f3a-be15-18d91be22f44",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Der Mietpreis in den Wohnungen der LS W33 soll für eine Wohnung mit Ofenheizung bei 2,50 Euro pro Quadratmeter liegen, mit Zentralheizung bei drei Euro. Kein schlechter Preis: Die durchschnittlichen Mieten liegen in Leipzig bei ungefähr fünf Euro.“"
                            },
                            {
                                "example_id": "94ce3466-c93b-4542-92b0-361cc4335dfa",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Die Graphikdesignerin zahlt knapp 500 Euro für eine unsanierte 96-Quadratmeter-Wohnung mit Ofenheizung.“"
                            },
                            {
                                "example_id": "a9d753d4-023f-4054-a0b0-ecfbd206475f",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Seine erste feste Wohnung in Wilmersdorf, mit Innentoilette und Ofenheizung, kostete 108 D-Mark.“"
                            },
                            {
                                "example_id": "a8bc2f15-4e97-489e-a486-fe726b6bcc7a",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Auch das notwendige Brennmaterial für die früher durchweg übliche Ofenheizung wie Brennholz oder Kohle fand seinen Platz häufig im Keller.“"
                            },
                            {
                                "example_id": "990b6a51-3b6b-4ed7-b052-b5df0be452f4",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„Es standen nur noch ein Dutzend klapprige Holzstühle drin, es gab lediglich eine Ofenheizung und alles war vollkommen marode.“"
                            },
                            {
                                "example_id": "06a85002-03a8-460a-a118-8ead920b5e3a",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "„In dem maroden Gerichtsgebäude mit Ofenheizung und Außentoilette stapeln sich die Gerichtsakten auf dem Fußboden.“"
                            },
                            {
                                "example_id": "24ee588b-c5c6-416e-818c-786439cf2c93",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "[…] „in Hamburgs mächtiger Baubehörde, angeführt von Sozialdemokraten des rechten Flügels, herrschte nach wie vor die Meinung, dass man Altbauten mit Ofenheizung, Toilette auf halber Treppe und schimmligen Wänden am besten abreißt und durch neue Gebäude ersetzt.“"
                            },
                            {
                                "example_id": "d2382c97-b049-4cd9-a115-0afc20990bcc",
                                "sense_id": "585d300a-dd35-3dcf-bceb-53c58f6c28df",
                                "text": "»Es war ein großer Schritt für uns, als wir die Ofenheizungen abgeschafft haben und auf Fernwärme umgestellt haben«, sagt Wenzel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
