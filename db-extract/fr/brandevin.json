                "entry_id": "6d33d89b-6ca0-3437-982b-dbe5c2674fa4",
                "word": "brandevin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7fe1458-965b-426b-b35b-b4882b8c60c3",
                        "entry_id": "6d33d89b-6ca0-3437-982b-dbe5c2674fa4",
                        "tags": [
                            "plural"
                        ],
