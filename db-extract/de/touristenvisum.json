                ],
                "senses": [
                    {
                        "sense_id": "98e66a82-85bf-31f2-95be-c4a2530ae6c3",
                        "entry_id": "07c0d7d9-15c9-341d-a528-84a20836c298",
                        "glosses": [
                            "Visum, das zu touristischen Aufenthalten in einem Land berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c9865d1-8165-4110-9480-fa30d0400e67",
                                "sense_id": "98e66a82-85bf-31f2-95be-c4a2530ae6c3",
                                "text": "„Ich habe ein Touristenvisum, und wenn ich zur Polizei gehe, dann lande ich im Knast.“"
                            },
                            {
                                "example_id": "8963228f-6e9b-4438-9f78-f564f79fdf27",
                                "sense_id": "98e66a82-85bf-31f2-95be-c4a2530ae6c3",
                                "text": "„Die Escobars hatten Touristenvisa beantragt, und vielleicht könnte man die mit der Begründung widerrufen, dass von Tourismus keine Rede sein könne, wenn jemand aus Angst um sein Leben flüchtet.“"
                            },
                            {
                                "example_id": "73bbca6e-37ba-4e75-a6b5-1da979bb87e7",
                                "sense_id": "98e66a82-85bf-31f2-95be-c4a2530ae6c3",
                                "text": "„Das sowjetische Konsulat braucht normalerweise etwa zwei Wochen, um ein Touristenvisum auszustellen.“"
                            },
                            {
                                "example_id": "4965bfdf-b706-47e3-93c3-0fefed22857b",
                                "sense_id": "98e66a82-85bf-31f2-95be-c4a2530ae6c3",
                                "text": "„Zwar stellte sie jährlich nur etwa 1500 Visa für die Immigration in die Vereinigten Staaten aus, aber diese Zahl ist irreführend, weil die meisten Israelis mit einem Touristenvisum einreisten und nur wenige erklärten, Israel für immer verlassen zu wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
