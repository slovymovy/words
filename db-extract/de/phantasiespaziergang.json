                "senses": [
                    {
                        "sense_id": "f3db53fc-da52-3e69-b70b-00aca91f0808",
                        "entry_id": "1cf85473-5314-3c89-949f-88aa75f5850d",
                        "glosses": [
                            "imaginärer Spaziergang; Spaziergang, der in der Vorstellung stattfindet"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8f496e89-7b22-4264-bffa-25dc4365dcf0",
                                "sense_id": "f3db53fc-da52-3e69-b70b-00aca91f0808",
                                "text": "„Setzen Sie einfach den Kopfhörer auf − und Sie fühlen sich nach einem erholsamen Phantasiespaziergang frisch und munter!“"
                            },
                            {
                                "example_id": "3a6a8e52-d7f2-4751-9900-c8dd527936ef",
                                "sense_id": "f3db53fc-da52-3e69-b70b-00aca91f0808",
                                "text": "„Nach diesem Grundmuster laden die Wellness Soundtracks zu einem Phantasiespaziergang ein, der allmählich »in die Tiefe« führt.“"
                            },
                            {
                                "example_id": "b74f46db-f0cc-4b5e-802d-8daa6ea88469",
                                "sense_id": "f3db53fc-da52-3e69-b70b-00aca91f0808",
                                "text": "„Das harmonische Miteinander von Naturgesetz und menschlichen Absichten, welches man den Landschaften für Phantasiespaziergänge gern zubilligt, muß dann verfehlt wirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
