                        "cross_references": []
                    },
                    {
                        "translation_id": "68b7d460-a82f-42bc-a430-047db90b85e7",
                        "source_entry_id": "b0c047af-822f-3bfa-9164-45da19cc6bd2",
                        "source_sense_id": "39fa258c-7bbd-326a-8da5-403059077753",
                        "source_sense_description": "bijna niet, op het nippertje",
                        "target_lang_word": "knapp",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knapp",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                        "entry_id": "fef7ba27-5af3-3521-af3a-700cd3eb1c4d",
                                        "glosses": [
                                            "gerade noch ausreichend; weniger als das, was man eigentlich braucht oder gerne hätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "137e4834-320c-4247-a96a-cf19f069f819",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Für Mike Gorges wird die Zeit langsam richtig knapp. Er muss Ende des Monats seine Masterarbeit in Germanistik abgeben."
                                            },
                                            {
                                                "example_id": "02b49763-51fb-4ef9-be71-7f42299d3800",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Das Essen wird rationiert, denn unsere Vorräte sind knapp bemessen."
                                            },
                                            {
                                                "example_id": "36496ea9-301a-4610-949d-df5a5f133f90",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Rechne lieber noch einen Meter drauf, sonst ist mir das zu knapp."
                                            },
                                            {
                                                "example_id": "ce81df44-a8fb-4529-ba93-1767b478a1a4",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Das Angebot an qualifiziertem Personal wird immer knapper."
                                            },
                                            {
                                                "example_id": "7c053888-d811-4d82-8843-dcd7f13ef3af",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Der weltweit steigende Preis signalisiert, dass Erdöl knapp wird."
                                            },
                                            {
                                                "example_id": "c9523f04-3737-4fb1-8f4e-a2158953e9fd",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Die Mehrheit im Parlament ist mit zwei Stimmen extrem knapp."
                                            },
                                            {
                                                "example_id": "383e284f-4b48-4bbd-9292-490a4b87d6ef",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "[Am 23. Juni 2016] stimmte eine knappe Mehrheit der Briten für den Brexit."
                                            },
                                            {
                                                "example_id": "19537f59-6d06-4310-ac62-94ab2a4d10e0",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Bezahlbarer Wohnraum in den Innenstädten wird knapp."
                                            },
                                            {
                                                "example_id": "d2bf177b-efd5-45c5-921f-a6d8a656c69b",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "Bei anhaltender Hitze und Trockenheit könnte das Löschwasser in kleineren Teichen knapp werden, heißt es von Seiten der Feuerwehr."
                                            },
                                            {
                                                "example_id": "0cc968e5-020b-4898-bfdc-b60e85611c59",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "„[…] wenn Kita-Plätze ohnehin knapp sind, hat ein Akademikerpaar oft auch die größere Kompetenz, sich einen zu sichern, als die zugewanderte Frau aus Afghanistan.“"
                                            },
                                            {
                                                "example_id": "5f6ca193-b38a-43f0-aaa6-49bd88c7236a",
                                                "sense_id": "a955fa42-aa63-3806-891d-c593a5271370",
                                                "text": "„Doch das Ballungsgebiet hat auch Nachteile: Bezahlbarer Wohnraum wird knapp.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                        "entry_id": "fef7ba27-5af3-3521-af3a-700cd3eb1c4d",
                                        "glosses": [
                                            "etwas kleiner als angegeben"
                                        ],
                                        "tags": [
                                            "mit Zahl- oder Maßangabe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39376d71-ee3b-46a5-8a40-7cd9cfb579c7",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "„Das etwa 3,6 Meter lange Fluggerät war zunächst von einem B-52-Bomber in einer Flughöhe von knapp 12200 Meter abgesetzt und dann von einer Rakete auf 30000 Meter Höhe gebracht worden.“"
                                            },
                                            {
                                                "example_id": "d3054484-0760-45d9-b0e1-6c8f91b4f6eb",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "Es waren knapp (seltener: knappe) zwanzig Leute da."
                                            },
                                            {
                                                "example_id": "ea8d831f-8492-4f04-bb88-06477d26bd32",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "Das Ziel ist noch einen knappen Kilometer entfernt."
                                            },
                                            {
                                                "example_id": "83f91dc1-cf7e-4fb4-a232-755a63728124",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "Mein Sohn ist knapp zwei Jahre alt."
                                            },
                                            {
                                                "example_id": "006d9d6a-9c83-4a86-ac25-1c75c832439b",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "Herzstück ist ein knapp 600 Meter langer Tunnel, der das Dorf La Punt quasi unterfährt."
                                            },
                                            {
                                                "example_id": "e790018d-9a8e-4653-b124-0a37cd8d7363",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "Bei knapp 400 Medikamenten gibt es einen Lieferengpass."
                                            },
                                            {
                                                "example_id": "ec9a3881-f79d-4bb9-8eae-8e9e944f1e59",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "Wenn beide Elternteile Abitur hätten, erlangten [in Deutschland] 74 Prozent der Kinder auch die Hochschulreife. Bei Eltern ohne Abitur schafften dies nur knapp ein Viertel der Kinder."
                                            },
                                            {
                                                "example_id": "22af86dc-b164-4714-acf3-a1cdc4d65b64",
                                                "sense_id": "e8a87f27-b8d4-3c70-bab0-8bed2bfe7ac4",
                                                "text": "[COVID-19-Pandemie:] „Insgesamt wurden in Südkorea bislang knapp 11.000 Menschen positiv getestet […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d69cadda-d3c5-359d-a54d-922f51e10ce7",
                                        "entry_id": "fef7ba27-5af3-3521-af3a-700cd3eb1c4d",
                                        "glosses": [
                                            "mit nur wenig (kleinst möglichem) Abstand"
                                        ],
                                        "tags": [
                                            "bei Distanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f49381-08d2-4a89-824f-70707470c11c",
                                                "sense_id": "d69cadda-d3c5-359d-a54d-922f51e10ce7",
                                                "text": "Das war aber ein knapper Sieg."
                                            },
                                            {
                                                "example_id": "f90ec7fd-a6fe-4471-bf22-4c67a90715f5",
                                                "sense_id": "d69cadda-d3c5-359d-a54d-922f51e10ce7",
                                                "text": "Der Bach fließt ganz knapp neben der Straße."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "065d8ab2-c784-3ada-b262-e67e51bbe24d",
                                        "entry_id": "fef7ba27-5af3-3521-af3a-700cd3eb1c4d",
                                        "glosses": [
                                            "kurz oder (fast) zu eng"
                                        ],
                                        "tags": [
                                            "bei Kleidungsstücken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c775fe-ea2c-41c5-b864-55a58b7df9f2",
                                                "sense_id": "065d8ab2-c784-3ada-b262-e67e51bbe24d",
                                                "text": "Dein Rock ist aber ziemlich knapp."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e17fb102-5970-356b-962e-8790d529078e",
                                        "entry_id": "fef7ba27-5af3-3521-af3a-700cd3eb1c4d",
                                        "glosses": [
                                            "auf das Wesentliche beschränkt"
                                        ],
                                        "tags": [
                                            "bei Formulierungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce57d3c-2f53-4ad4-8b2e-0abc6977a758",
                                                "sense_id": "e17fb102-5970-356b-962e-8790d529078e",
                                                "text": "Kurz und knapp: Wir werden ihren Vertrag nicht verlängern."
                                            },
                                            {
                                                "example_id": "d633866b-f3cb-4081-acc5-795a78decbdc",
                                                "sense_id": "e17fb102-5970-356b-962e-8790d529078e",
                                                "text": "Mit dieser knappen Bedienungsanleitung kann ich den Schrank nicht aufbauen."
                                            },
                                            {
                                                "example_id": "369d4423-c568-4d25-b1d7-c7b3fc83fe20",
                                                "sense_id": "e17fb102-5970-356b-962e-8790d529078e",
                                                "text": "Durch knappe, sarkastische Kommentare offenbart die Autorin [Betsy Udink] ihre Gefühle."
                                            },
                                            {
                                                "example_id": "d84ca236-6b3a-4db4-87d5-028c245a6b1e",
                                                "sense_id": "e17fb102-5970-356b-962e-8790d529078e",
                                                "text": "Unsere „wichtigen“ Ratschläge hörten sich die beiden Hundeexperten gelassen an, ihr knappes Fazit: „Lasst uns man machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2836b99f-3e1e-49b7-8ffd-c30f3a29555d",
                        "source_entry_id": "b0c047af-822f-3bfa-9164-45da19cc6bd2",
                        "source_sense_id": "39fa258c-7bbd-326a-8da5-403059077753",
                        "source_sense_description": "bijna niet, op het nippertje",
                        "target_lang_word": "mit knapper Not",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mit knapper Not",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                        "entry_id": "a6fcb6ec-988b-39bf-8083-d09580d36f71",
                                        "glosses": [
                                            "nur mit Mühe; gerade noch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c8bbc7-4e4c-4565-bb06-6b9502f2b1ab",
                                                "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                                "text": "„»Mitten im Leben sind wir vom Tod umfangen.« Er lauert in allen Ecken auf uns, und wenn er hervorbricht und wir ihm mit knapper Not entgehen, so wird man beglückwünscht.“"
                                            },
                                            {
                                                "example_id": "2fffc7b2-1139-479d-9066-58a2b7dba78f",
                                                "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                                "text": "„Ehe drei Jahre um sind, ist der behäbige Wohlstand des Kleinbürgers zerschlagen, hat die Mutter sich im Gefängnis erhängt, hat die jüngere Tochter ihren jungen Gatten verloren, ist der Vater mit knapper Not dem Todesurteil entronnen, ist, was von der Familie noch übrig ist, in alle Winde zerstreut, verfolgt, verachtet und friedlos.“"
                                            },
                                            {
                                                "example_id": "63e5260d-cf77-4b2b-8c8d-425df2cb2cf8",
                                                "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                                "text": "„Deutlich wie damals hörte dieser im Sinnen die hohe und erzene Stimme, die zu ihm gesprochen: »Fortan sollst du Jisrael heißen« — woraufhin er den Inhaber dieser besonderen Stimme aus seinen Armen entlassen hatte, so daß er denn hoffentlich mit knapper Not noch mochte zur Zeit gekommen sein…“"
                                            },
                                            {
                                                "example_id": "edbbcd10-4a4a-4d81-8040-dd59034225fb",
                                                "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                                "text": "„Das Lenkrad entriß sich Burres Händen; ich vermied mit knapper Not, mir den Schädel am Wagendach einzustoßen.“"
                                            },
                                            {
                                                "example_id": "1a32b94c-af20-4292-b413-73860e0535d4",
                                                "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                                "text": "„Zur gleichen Zeit war er mit knapper Not dem Tod entgangen.“"
                                            },
                                            {
                                                "example_id": "ffc31a6c-f0f6-45c1-91a7-582f66595abc",
                                                "sense_id": "4e2f78c5-3feb-3e95-8732-191757e7b1ef",
                                                "text": "„Aaron Silbermans Sohn ist gerade aus Berlin zurückgekehrt, und wie ich hörte, ist er nur mit knapper Not davongekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aedd34b7-92d1-4297-81a2-217ed1974dc9",
                        "source_entry_id": "b0c047af-822f-3bfa-9164-45da19cc6bd2",
                        "source_sense_id": "39fa258c-7bbd-326a-8da5-403059077753",
