                                        "entry_id": "56377abc-577f-30f0-bc56-f242cda41646",
                                        "glosses": [
                                            "Fruit — arille — de l’arbre du même nom, comestible mais pouvant être toxique s’il n'est pas correctement préparé. → voir hypoglycine"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
