                        "sense_id": "f7a615a1-8238-3790-9011-3b7aa3e9d030",
                        "entry_id": "5d00f5ba-f1d0-3329-9813-ec06500f4905",
                        "glosses": [
                            "Synonym of grains of paradise, seeds or seed capsules of Aframomum melegueta, of East Africa."
                        ],
