                        "glosses": [
                            "Spiraler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66adb633-eb13-4f85-ae59-9318871efb92",
                                "sense_id": "a8fbb9d0-3e8c-3a28-9c0b-864631d35317",
                                "text": "Sinon, vous pouvez toujours mettre un fermoir, mais n’oubliez pas de respiraler la chaîne avant de la refermer."
                            },
                            {
                                "example_id": "715f806f-9175-4d2d-8665-a85fecf79a4e",
                                "sense_id": "a8fbb9d0-3e8c-3a28-9c0b-864631d35317",
                                "text": "Conclusion : avant de respiraler avec un milan, je regarderai ^([sic : regarderais]) bien en dessous ^([sic : en-dessous]) si le reste de la colonie n’est pas en train de monter comme des fusées :-)"
                            },
                            {
                                "example_id": "d5e02be4-a37e-497c-8ac1-167992970753",
                                "sense_id": "a8fbb9d0-3e8c-3a28-9c0b-864631d35317",
                                "text": "En planeur ton moteur ce sont les pompes, d’un côté on peut dire que c’est toujours de la « gestion de moteur » le fait de spiraler, transiter, respiraler etc… ^([sic : etc.]) mais dans un autre genre !"
                            }
                        ]
                    }
