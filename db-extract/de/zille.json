                        "entry_id": "bb424be5-f7d5-3bd8-bd7d-b284030658be",
                        "glosses": [
                            "flacher Lastkahn, dessen Bug spitz zusammenläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322c7845-ee6a-46a8-9a0e-22dea0b853af",
                                "sense_id": "5b63c0ab-8d2d-3b92-b765-48c8607e3269",
                                "text": "„Eine Zille zog schwarz und langsam vorüber.“"
                            },
                            {
                                "example_id": "5692fca2-4a05-405b-9e40-bcfe2578745b",
                                "sense_id": "5b63c0ab-8d2d-3b92-b765-48c8607e3269",
                                "text": "„Nicht nur diese schwimmenden Straßenbahnen, auch Fernzüge fahren unausgesetzt auf dem Wasser hinüber und herüber; auf ungedeckter Zille zwei oder drei Gleise mit je achtzehn Waggons; als Lokomotive dient ein Remorqueur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
