                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59f4fba-1a52-41e1-82cf-87693f589041",
                                                "sense_id": "335683fd-e61b-3891-abef-4e2bb19b1875",
                                                "text": "Na všechny otázky testu jste odpověděl správně a získal jste tak plný počet bodů."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "správně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7a733e2f-7b28-3007-ac65-342cd1abf298",
                                        "entry_id": "e4c511b1-4aa8-35f2-a571-d8ea294fc2e7",
                                        "glosses": [
                                            "v odpovědi schvaluje předchozí tvrzení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9247132f-10cd-4521-bc05-1ab536d1cd54",
                                                "sense_id": "7a733e2f-7b28-3007-ac65-342cd1abf298",
                                                "text": "„Podle mého názoru pachatel dopis napsal na tomto psacím stroji.“ — „Správně!“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b5d2286-aae1-4ec7-9478-5a4babd41140",
                        "source_entry_id": "fb908837-720d-3ca9-bef0-4f5f20c192fe",
                        "source_sense_id": "2a15a314-2bf6-3b5f-98fc-c438f4456d09",
                        "target_lang_word": "correctement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correctement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8da31178-dd5b-33c0-9e44-dac12d9bc30f",
                                        "entry_id": "df930b75-2d54-37b7-9a70-f42e46d84360",
                                        "glosses": [
                                            "D’une manière correcte ; sans faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142e5b6f-1777-4c56-a25a-6b7aed160886",
                                                "sense_id": "8da31178-dd5b-33c0-9e44-dac12d9bc30f",
                                                "text": "« Son pire ennemi, c’est sa situation. Il n’a pas correctement été pris en charge », contre-argumente Mᵉ Noël, son avocate."
                                            },
                                            {
                                                "example_id": "67fa5d39-c739-4c7a-951b-bf78de8f861a",
                                                "sense_id": "8da31178-dd5b-33c0-9e44-dac12d9bc30f",
                                                "text": "Parlez toujours correctement devant eux [les enfants], faites qu’ils ne se plaisent avec personne autant qu’avec vous, et soyez sûrs qu’insensiblement leur langage s'épurera sur le vôtre, sans que vous les ayez jamais repris."
                                            },
                                            {
                                                "example_id": "4424b1d2-cdfe-4454-b5a6-0dcb5c369bc9",
                                                "sense_id": "8da31178-dd5b-33c0-9e44-dac12d9bc30f",
                                                "text": "Je puis en dire autant d’El-Haj Ahmed Ben-Chekron qui me sert d’interprète dans mes autres visites et qui, lui, ayant vécu en Espagne, s’exprime correctement en castillan."
                                            },
                                            {
                                                "example_id": "8e206abc-9427-4253-b035-5956afa0c443",
                                                "sense_id": "8da31178-dd5b-33c0-9e44-dac12d9bc30f",
                                                "text": "Cependant, il juge assez correctement des distances et ne lance pas sa langue à l’étourdie sur une proie hors d’atteinte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9f6730f-154e-4c8f-a972-516397423acd",
                        "source_entry_id": "fb908837-720d-3ca9-bef0-4f5f20c192fe",
                        "source_sense_id": "2a15a314-2bf6-3b5f-98fc-c438f4456d09",
                        "target_lang_word": "convenablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convenablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a550084e-2ef2-353b-b83d-6d4bd9794c6c",
                                        "entry_id": "e14c761e-7da0-3025-beb9-9f12ae6526cc",
                                        "glosses": [
                                            "D’une manière convenable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11bac23f-fa20-4540-91d6-dfb26451bde8",
                                                "sense_id": "a550084e-2ef2-353b-b83d-6d4bd9794c6c",
                                                "text": "En réalité, ce vin du Caucase, quelque peu aigrelet, accompagne convenablement la poule bouillie, disons le « pilau », – ce qui permet de lui trouver une saveur spéciale."
                                            },
                                            {
                                                "example_id": "879fe79e-074c-4b8f-8b11-0b03d84abda0",
                                                "sense_id": "a550084e-2ef2-353b-b83d-6d4bd9794c6c",
                                                "text": "Un moulin à vent se compose essentiellement d'un arbre porté sur un petit bâtiment en bois, qui est susceptible de tourner autour d'un fort pivot vertical, et qui peut par conséquent être orienté convenablement."
                                            },
                                            {
                                                "example_id": "2886014e-b998-48eb-9fe9-4b369e85b12a",
                                                "sense_id": "a550084e-2ef2-353b-b83d-6d4bd9794c6c",
                                                "text": "En mettant de côté les supporteurs argentino-indiens, dont le cas reste à élucider, seuls les Tunisiens et les Marcains réussissent à faire monter les décibels à peu près convenablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eade4c41-fd84-3e58-a376-28ba10257246",
                                        "entry_id": "e14c761e-7da0-3025-beb9-9f12ae6526cc",
                                        "glosses": [
                                            "Conformément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b5ba83-a801-4c39-9b59-bcd72e79a0f8",
                                                "sense_id": "eade4c41-fd84-3e58-a376-28ba10257246",
                                                "text": "J'agirai convenablement à vos vues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fd8e5f5-ddb5-4eca-981c-729780fdc457",
                        "source_entry_id": "fb908837-720d-3ca9-bef0-4f5f20c192fe",
                        "source_sense_id": "2a15a314-2bf6-3b5f-98fc-c438f4456d09",
                        "target_lang_word": "strictement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strictement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8db61dc-2fa6-3e51-ac4b-d781b49e12dc",
                                        "entry_id": "32c43e25-8af5-35ac-ad94-7e78f294ac89",
                                        "glosses": [
                                            "D’une manière stricte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4e09d6-7ca0-407c-8597-94561e3fd76f",
                                                "sense_id": "d8db61dc-2fa6-3e51-ac4b-d781b49e12dc",
                                                "text": "Surveillez-les donc très strictement, […]."
                                            },
                                            {
                                                "example_id": "c858dd8b-bf64-42cc-9c6f-3657ed97cc0e",
                                                "sense_id": "d8db61dc-2fa6-3e51-ac4b-d781b49e12dc",
                                                "text": "Le bilan traditionnel mesurait la solvabilité; il appliquait strictement les principes de prudence et d’indépendance des exercices et, orienté vers le passé, il considérait le présent comme la conséquence de ce passé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d8e05c-4b50-34cf-a6e3-786a542a1d31",
                                        "entry_id": "32c43e25-8af5-35ac-ad94-7e78f294ac89",
                                        "glosses": [
                                            "Absolument"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54009173-de6f-4fa4-9246-dbe36063c496",
                                                "sense_id": "83d8e05c-4b50-34cf-a6e3-786a542a1d31",
                                                "text": "Ensuite c'est à chacun de voir en quoi cela l'intéresse, le concerne, lui parle. Il n'y a strictement aucune prétention comminatoire du genre : si vous ne passez pas par là, vous êtes fichu."
                                            },
                                            {
                                                "example_id": "2dc43f83-9289-441c-9785-5c8a156e1a0a",
                                                "sense_id": "83d8e05c-4b50-34cf-a6e3-786a542a1d31",
                                                "text": "Moi j'étais un peu en retrait et j'observais le cirque habituel des enterrements. Je ne disais rien, je n'avais d'ailleurs strictement rien à dire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b969e4-7401-3937-bd38-84034192cc0c",
                                        "entry_id": "32c43e25-8af5-35ac-ad94-7e78f294ac89",
                                        "glosses": [
                                            "En excluant l’égalité, sans être égal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5bbb1d-8427-48d0-92d6-6cb5c3228fe6",
                                                "sense_id": "a1b969e4-7401-3937-bd38-84034192cc0c",
                                                "text": "Un entier strictement positif ne peut être égal à zéro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c902ef24-be9a-43fa-8827-f0cef9a6b51e",
                        "source_entry_id": "fb908837-720d-3ca9-bef0-4f5f20c192fe",
                        "source_sense_id": "2a15a314-2bf6-3b5f-98fc-c438f4456d09",
                        "target_lang_word": "purement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e806bca7-db64-3ce4-8e75-e4b3bf49ea7e",
                                        "entry_id": "f57687f1-dc0b-301a-a52b-31fcfcb246d0",
                                        "glosses": [
                                            "D’une manière pure, avec pureté."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8767782-937f-3240-93b5-fb36613ffd1b",
                                        "entry_id": "f57687f1-dc0b-301a-a52b-31fcfcb246d0",
                                        "glosses": [
                                            "D’une manière pure et innocente."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f888c44-3fa0-4c35-bcfd-57d137766876",
                                                "sense_id": "c8767782-937f-3240-93b5-fb36613ffd1b",
                                                "text": "Les courtisanes, pour embrasser tout le sexe féminin qu’on baptise, qu’on débaptise et rebaptise à chaque quart de siècle, conservent toutes au fond de leur cœur un florissant désir de recouvrer leur liberté, d’aimer purement, saintement et noblement un être auquel elles sacrifient tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7700c862-56fc-3079-82ad-29342ee3dee4",
                                        "entry_id": "f57687f1-dc0b-301a-a52b-31fcfcb246d0",
                                        "glosses": [
                                            "Avec une grande propriété d’expressions, en n’employant que des tours conformes à l’usage et au génie de la langue."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7a184d-e301-45ea-a37f-9588d9c5ea1c",
                                                "sense_id": "7700c862-56fc-3079-82ad-29342ee3dee4",
                                                "text": "Parler, écrire purement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdff18c0-754c-3b95-a472-b57db953cd29",
                                        "entry_id": "f57687f1-dc0b-301a-a52b-31fcfcb246d0",
                                        "glosses": [
                                            "D’une manière exacte, correcte."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c418592-aabe-4883-9c24-410aba260792",
                                                "sense_id": "cdff18c0-754c-3b95-a472-b57db953cd29",
                                                "text": "Dessiner purement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99117a00-90b9-3781-973a-21aec486c6ed",
                                        "entry_id": "f57687f1-dc0b-301a-a52b-31fcfcb246d0",
                                        "glosses": [
                                            "Uniquement ; simplement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e959caf1-96c5-4c1e-a38f-a64fb944e2cc",
                                                "sense_id": "99117a00-90b9-3781-973a-21aec486c6ed",
                                                "text": "S'il y eut des saintes et des martyres, en revanche point de papesses ou seulement de clergeonnes. La messe est purement virile."
                                            },
                                            {
                                                "example_id": "29661e26-8313-45af-a45a-3e2bd778126d",
                                                "sense_id": "99117a00-90b9-3781-973a-21aec486c6ed",
                                                "text": "En 1910, Ehrlich avait réussi à obtenir le premier exemple d'un médicament antimicrobien purement synthétique. Il s'agissait du salvarsan, en l'occurrence un composé contenant de l'arsenic (…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b37235e-4a51-4441-8e95-e26bd4d7ec3b",
                        "source_entry_id": "fb908837-720d-3ca9-bef0-4f5f20c192fe",
                        "source_sense_id": "2a15a314-2bf6-3b5f-98fc-c438f4456d09",
                        "target_lang_word": "décemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                        "entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                                        "glosses": [
                                            "D’une manière décente, conformément à la décence, aux convenances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79c5ba8-0223-45a1-b23e-7e1a536dd4de",
                                                "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                                "text": "Se vêtir décemment, se comporter décemment."
                                            },
                                            {
                                                "example_id": "8b2c0c9e-e796-4528-bb50-a79eee04c870",
                                                "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                                "text": "Dès qu'il put décemment se lever de table, il se précipita plutôt qu'il ne courut à l'écurie, sella lui-même son cheval, et partit au galop."
                                            },
                                            {
                                                "example_id": "3f552e34-be9b-495b-ba65-80ad9ff48b1c",
                                                "sense_id": "e32f71e6-855a-369b-a323-6778b579b726",
                                                "text": "Il faut absolument que j’y aille, dit-elle, à pied ou à cheval ; mais je consens volontiers à m’habiller plus décemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354b3f2d-5e8d-3167-8f0b-5383a24d1042",
                                        "entry_id": "7a37c5b8-6e31-3686-a4d4-fd96d01fb858",
                                        "glosses": [
                                            "Raisonnablement, pour être convenable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c844ed-5f88-419e-bc01-e270e190a38d",
                                                "sense_id": "354b3f2d-5e8d-3167-8f0b-5383a24d1042",
                                                "text": "Décemment, nous ne pouvons pas nous dispenser de lui faire une visite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
