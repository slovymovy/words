                    "target_lang_definitions": {
                        "ru": "Обмывать и одевать тело умершего, подготавливая его к похоронам.",
                        "en": "To wash and dress a deceased person's body in preparation for burial.",
                        "fr": "Laver et habiller le corps d'un défunt en préparation des funérailles."
                    },
                    "translations": {
