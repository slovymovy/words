                "senses": [
                    {
                        "sense_id": "c2e5e24f-d89f-3aaf-8406-751ebc4444d4",
                        "entry_id": "2c398729-60ef-36f7-83a1-b0f69cd2d939",
                        "glosses": [
                            "bauliche Vorrichtung, um die in einer Fabrik entstehenden Abgase beziehungsweise den Rauch von darin befindlichen Heizungen, Herden oder Öfen nach außen zu leiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161e337a-7750-4e4d-acd5-e3c3ebb14d07",
                                "sense_id": "c2e5e24f-d89f-3aaf-8406-751ebc4444d4",
                                "text": "„Sonst sieht die ehemalige Sargerzeugung Atzgersdorf wie so viele verlassene Fabriksgebäude aus: ein mächtiger Bau aus grauen Ziegeln, mit Heizungsturm und Fabrikschornstein.“"
                            },
                            {
                                "example_id": "c17debb2-8d60-47ea-a128-a14a3d5f854e",
                                "sense_id": "c2e5e24f-d89f-3aaf-8406-751ebc4444d4",
                                "text": "„Und ihre Blicke irrten über den Haufen Bausteine hin, über das ekelhafte Wasser, in dem ein Strohbündel schwamm, über einen Fabrikschornstein, der sich am Horizont erhob; Kloakendünste stiegen empor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
