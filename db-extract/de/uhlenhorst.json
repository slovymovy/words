                "senses": [
                    {
                        "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                        "entry_id": "60ff2bc9-6cec-3e56-847c-b66ae141f8de",
                        "glosses": [
                            "Stadtteil von Hamburg, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e00e741-e906-41ac-8283-cb49779840a5",
                                "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                                "text": "Ich wohne auf der Uhlenhorst."
                            },
                            {
                                "example_id": "ab02fe65-5109-4dce-8c0c-0fde67bbafbe",
                                "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                                "text": "Ein Finanzmakler auf der Uhlenhorst ist verhaftet worden, weil er Anlagebetrug in Millionenhöhe verursacht haben soll."
                            },
                            {
                                "example_id": "e37d8f48-4f16-4384-b9ea-a7bfd4796981",
                                "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                                "text": "„Es habe vereinzelt Hinweise gegeben, dass Kinder auf der Uhlenhorst von sogenannten „Mitschnackern“ angesprochen wurden.“"
                            },
                            {
                                "example_id": "af47aad9-a904-4c1d-9b19-4e3f7c666cda",
                                "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                                "text": "„Wusstet ihr, dass man auf der Uhlenhorst Stand-Up-Paddling als Unterrichtsfach wählen kann?“"
                            },
                            {
                                "example_id": "ce3e0cbf-ccc0-4456-8641-82f3104d3372",
                                "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                                "text": "„Der Asphalt wird erneuert, über eine lange Strecke ist die Straße auf der Uhlenhorst gesperrt.“"
                            },
                            {
                                "example_id": "db05fe39-7bc4-4c74-a369-c75f29a723f6",
                                "sense_id": "38a8324c-712d-3922-8ad2-d9d81c6f8272",
                                "text": "„Groß geworden ist sie auf der Uhlenhorst, zwischen Außenalster und Kuhmühlenteich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
