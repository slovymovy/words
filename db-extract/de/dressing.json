                                        "sense_id": "6d879ea5-addb-3ac8-9959-cc870864df62",
                                        "entry_id": "a25fae89-7621-38c4-8587-dc128feeebd7",
                                        "glosses": [
                                            "Material applied to a wound for protection or therapy."
