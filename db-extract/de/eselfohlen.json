                "translations": [
                    {
                        "translation_id": "775aa0fb-0dd9-42a0-a29b-bb2c53a957ae",
                        "source_entry_id": "a1284997-93ee-38af-83c0-963a7f1a961d",
                        "source_sense_id": "87c2f7b4-2a22-3d18-82f1-6b711f3f2ea6",
                        "source_sense_description": "Jungtier eines Esels",
                        "target_lang_word": "donkey foal",
                        "target_lang_code": "en",
