                                    {
                                        "sense_id": "72738931-5acd-303f-9b88-9f30f2cbce4c",
                                        "entry_id": "a0ca21b2-22e5-379f-80f6-c4ab0ac416f3",
                                        "glosses": [
                                            "Einwohner einer Gemeinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54702711-554e-4b4b-aa1b-a5fbe82c2a10",
                                                "sense_id": "72738931-5acd-303f-9b88-9f30f2cbce4c",
                                                "text": "Die Bürger Berlins gingen auf die Straßen und protestierten."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "4724f577-5c99-380d-bdd5-2ccb61c63e2e",
                                        "entry_id": "a0ca21b2-22e5-379f-80f6-c4ab0ac416f3",
                                        "glosses": [
                                            "Angehöriger eines Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e25776b-4665-41c4-b311-e3ffb1685f57",
                                                "sense_id": "4724f577-5c99-380d-bdd5-2ccb61c63e2e",
                                                "text": "„Am 1. November […] hatte die DDR wieder visafreie Reisen in die ČSSR zugelassen; zwei Tage später hatte sie der Öffnung der tschechoslowakischen Grenze zur Bundesrepublik für Bürger der DDR zugestimmt.“"
                                            },
                                            {
                                                "example_id": "fa4ad959-888b-41a9-aa53-8a26ebeb6c41",
                                                "sense_id": "4724f577-5c99-380d-bdd5-2ccb61c63e2e",
                                                "text": "„Mussten die Bürger 2006 noch insgesamt zwei Milliarden Euro zuzahlen, so waren es 2007 nur noch 1,6 Milliarden.“"
                                            },
                                            {
                                                "example_id": "35eed2e4-b860-4160-abdc-b35da5885713",
                                                "sense_id": "4724f577-5c99-380d-bdd5-2ccb61c63e2e",
                                                "text": "„Aus diesen Zusatzartikeln sollte schließlich die Bill of Rights hervorgehen, die die Grundrechte der Bürgerinnen und Bürger gegenüber der Regierung ins Zentrum der politischen Identität Amerikas rückte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "9536d13b-7a69-38f2-87e3-fa9156501ad5",
                                        "entry_id": "a0ca21b2-22e5-379f-80f6-c4ab0ac416f3",
                                        "glosses": [
                                            "Angehöriger der Mittelschicht, des Bürgertums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9ce84f7-56df-42a4-8bca-a013bbbb924a",
                                                "sense_id": "9536d13b-7a69-38f2-87e3-fa9156501ad5",
                                                "text": "In sozialkritischen Schriften werden Bürger häufig kritisch betrachtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
