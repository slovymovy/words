                                        "entry_id": "da4b44e6-b234-3720-8cdb-0f21447f5007",
                                        "glosses": [
                                            "in a brief, condensed or compact form"
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02098ce-6932-45b1-88e0-36d896580259",
                                                "sense_id": "9bc723c1-4415-32f4-bbb2-89091f04e1de",
                                                "text": "If this capsule history of our progress teaches us anything, it is that man, in his quest for knowledge and progress, is determined and cannot be deterred."
