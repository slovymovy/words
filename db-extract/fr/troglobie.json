                                    {
                                        "sense_id": "4e312695-8edf-38f4-a95b-4fcafec1efd9",
                                        "entry_id": "223d59a7-0aa0-3add-a0fd-0f602b33fb2d",
                                        "glosses": [
                                            "Relating to, or characteristic of a troglobite"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15e14d8-1327-4d96-87b0-1b7076978a40",
                                                "sense_id": "4e312695-8edf-38f4-a95b-4fcafec1efd9",
                                                "text": "By breeding two troglobitic species of the genus Aphaenops, she was able to obtain the first larval instar and observed that it does not feed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
