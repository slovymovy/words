                    {
                        "translation_id": "5a6a302d-e13b-4a35-aac1-e88c9612a8ac",
                        "source_entry_id": "6bdd9143-a8f6-3402-af28-fd60d1faa1d1",
                        "source_sense_id": "fd7076ff-c78d-39f2-90cd-5835819cb196",
                        "source_sense_description": "list of words with their definitions",
                        "target_lang_word": "glossaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glossaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                        "entry_id": "e69fd13c-f3de-3a2b-909a-911e54454507",
                                        "glosses": [
                                            "Dictionnaire spécialisé servant à expliquer le vocabulaire d'un domaine technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2af0ca-8193-47ef-bd92-ec80bd79541c",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "Mon glossaire jmoude était très riche ; mais le sens d'un certain nombre de mots appris de la bouche de paysans grossiers demeurait encore pour moi enveloppé d'une obscurité relative."
                                            },
                                            {
                                                "example_id": "a4ce7745-00ea-437c-a116-be6925c94c35",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "[…]; au premier abord, le lecteur pourra se sentir un peu dérouté, mais qu'il veuille bien se donner la peine, sans être obligé de se reporter au glossaire, de lire quelques lignes à haute voix ; […]."
                                            },
                                            {
                                                "example_id": "cd5937c4-4afa-4c61-914b-da95ede635cd",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "Cela suppose un vocabulaire commun. Ce glossaire répond au défi de la Babel humaine selon un tempo à deux temps :\n— Au présent, le glossaire, donne des définitions et introduit des réflexions. […].\n— Au futur le glossaire s'enrichira de votre contribution. […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76ae45f9-e96e-457c-8466-269f10546081",
                        "source_entry_id": "6bdd9143-a8f6-3402-af28-fd60d1faa1d1",
                        "source_sense_id": "fd7076ff-c78d-39f2-90cd-5835819cb196",
                        "source_sense_description": "list of words with their definitions",
                        "target_lang_word": "Glossar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glossar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                        "entry_id": "853700da-4a1a-3efc-83d8-8fbe6b1cdb2a",
                                        "glosses": [
                                            "Liste von Fach- oder anderen nicht geläufigen Wörtern mit Erklärung (traditionell als Anhang in einem Buch, heute auch im Internet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a71261-8e01-4494-abe3-3f00bc82a4ce",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "Das Nützlichste an diesem Buch ist sein umfangreiches Glossar."
                                            },
                                            {
                                                "example_id": "f748b3a3-41b3-42cf-a4f0-99958ce03d56",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Der Abrogans, das älteste lateinisch-deutsche Glossar (…), bietet zu jedem Element eines lateinischen Synonymenpaars je ein althochdeutsches Äquivalent.“"
                                            },
                                            {
                                                "example_id": "f4281d8b-8f23-4421-a4ca-f020874173cc",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Abgerundet wird dieses Werk durch ein Glossar, in dem die Wurzeln der geografischen Namen (aus zahlreichen Sprachen) in kurzer Zusammenschau erklärt werden.“"
                                            },
                                            {
                                                "example_id": "ed4c7ca5-7c0f-45c5-8f11-646674c6c989",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Aber ich habe etliche dieser Begriffe separat im Anschluß an das Glossar aufgezählt.“"
                                            },
                                            {
                                                "example_id": "9d7e6326-a975-4eeb-86db-e3d394d2f27e",
                                                "sense_id": "6114ae1b-cf87-3e46-b6ef-f923dd240aa3",
                                                "text": "„Diese Arbeitsweise trägt der Tatsache Rechnung, dass das Glossar Teil eines sich ständig verändernden Diskurses ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
