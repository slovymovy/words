                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "draught",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "Alternative form of draft in some of its senses."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae840755-dbb6-4d4b-a544-ed9ced6cb448",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "She could feel a draught where she was sitting."
                                            },
                                            {
                                                "example_id": "a68b3189-084c-4660-b02f-14e4ccf2ba82",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "[…]he sayde vnto Simon: Cary vs into the depe, and lett slippe thy nett to make a draught."
                                            },
                                            {
                                                "example_id": "95aadd20-ba6e-47bb-bd05-80ab8373acbd",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "“Drink and pass!” he cried, handing the heavy charged flagon to the nearest seaman. “The crew alone now drink. Round with it, round! Short draughts—long swallows, men; ’tis hot as Satan’s hoof."
                                            },
                                            {
                                                "example_id": "7d192449-0f9b-4740-9279-97b384c60ad3",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "Finally I gave him a draught, and he sank into uneasy slumber."
                                            },
                                            {
                                                "example_id": "ff50e657-28d8-43e9-b5a4-42ecae8c7d4c",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "Much as I wish that I had not to write this chapter, I know that I shall have to swallow many such bitter draughts in the course of this narrative. And I cannot do otherwise, if I claim to be a worshipper of Truth. […]"
                                            },
                                            {
                                                "example_id": "6f716c0c-36ed-46b4-b5e0-a12d4cffdeba",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "All the L.N.E.R. Clyde vessels are paddle-propelled, because of the shallow draught at Craigendoran Pier."
                                            },
                                            {
                                                "example_id": "4eaa5b7b-3cc6-46e1-91aa-165eb9031df6",
                                                "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                                                "text": "A standard type of donkey jacket made of white milled flannel is being introduced by British Railways for the use of staff working in tunnels where there are conditions of extreme cold, dampness and draught."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685187a3-c9be-3055-9f6b-0d99dec9621e",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "A checker: a game piece used in the game of draughts."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30544f85-5233-3893-abc9-227267113544",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "Ale: a type of beer brewed using top-fermenting yeast."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c3218a7-a2b5-3b12-8d4c-2e4c72816b8a",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "A mild vesicatory."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ed29859-e27d-365e-ab48-48c6c3e2309d",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "An outhouse: an outbuilding used as a lavatory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaaac041-6d1f-4f59-a8ad-3d42c5e52cc7",
                                                "sense_id": "4ed29859-e27d-365e-ab48-48c6c3e2309d",
                                                "text": "Then sayde Jesus: are ye yett withoute understondinge? perceave ye not, that whatsoever goeth in at the mouth, descendeth doune into the bely, and ys cast out into the draught?"
                                            },
                                            {
                                                "example_id": "676baf0b-231a-42de-ad79-78e91943cad9",
                                                "sense_id": "4ed29859-e27d-365e-ab48-48c6c3e2309d",
                                                "text": "Rid me these Villaines from your companies; / Hang them, or stab them, drowne them in a draught, / Confound them by some course, and come to me, / Ile giue you Gold enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f32ae2-cdf0-3bc4-9608-91b052be7dfc",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "Any picture or drawing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8823bd2b-c229-42cf-9ef7-5537f0b9da24",
                                                "sense_id": "64f32ae2-cdf0-3bc4-9608-91b052be7dfc",
                                                "text": "And therefore, for the whole process, and full representation, there must be more than one draught; the one representing him in station, the other in session, another in genuflexion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2fe3e8d-7f6a-34f1-b304-2240edae5dad",
                                        "entry_id": "13182e72-556b-3020-9494-6f9c9dce8de2",
                                        "glosses": [
                                            "A sudden attack upon an enemy."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf195435-90df-43e7-b53f-6220577ffb1d",
                                                "sense_id": "e2fe3e8d-7f6a-34f1-b304-2240edae5dad",
                                                "text": "drawing sudden draughts upon the enemy when he looketh not for you"
                                            }
                                        ]
                                    }
                                ]
