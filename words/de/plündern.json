    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d70663a-9d89-3f02-8ad9-8ded900b3bcb",
                    "sense_definition": "nach einer militärischen Eroberung, bei Unruhen oder einer Katastrophe rücksichtslos und gewaltsam Güter aus Orten oder Gebäuden stehlen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rauben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während der Unruhen zogen Randalierer durch die Innenstadt und <w>plünderten</w> viele Geschäfte."
                        },
                        {
                            "text": "Die feindlichen Soldaten drangen in das Dorf ein, um alle Vorräte zu <w>plündern</w>."
                        }
                    ],
                    "common_phrases": [
                        "eine Stadt plündern",
                        "Geschäfte plündern"
                    ]
                },
                {
                    "sense_id": "9a493ba6-dc62-336e-8e0c-fa21cd7b756b",
                    "sense_definition": "einen Vorrat oder ein Behältnis beinahe vollständig leeren, indem man große Mengen daraus entnimmt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entnehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als die hungrigen Kinder nach Hause kamen, <w>plünderten</w> sie sofort den Kühlschrank."
                        },
                        {
                            "text": "Um die teure Reparatur zu bezahlen, mussten wir unser altes Sparschwein <w>plündern</w>."
                        }
                    ],
                    "common_phrases": [
                        "den Kühlschrank plündern",
                        "das Sparschwein plündern"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "übertragen verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "a34d8ff6-1cdb-3251-b79f-b2445722b86d",
                    "sense_definition": "einer Person gewaltsam und unrechtmäßig alle wertvollen Gegenstände abnehmen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rauben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im dichten Wald lauerten die Räuber den Kaufleuten auf und <w>plünderten</w> sie."
                        },
                        {
                            "text": "Die Angreifer überwältigten den wehrlosen Wanderer und <w>plünderten</w> ihn auf offener Straße."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in Bezug auf Personen heute selten"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d99b05d-711e-39be-aded-ebf9a2197c80",
                    "sense_definition": "gewaltsame oder unrechtmäßige Inbesitznahme fremden Eigentums, insbesondere in Kriegs- oder Krisensituationen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rauben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der Naturkatastrophe nutzten Kriminelle die Verwirrung zum <w>Plündern</w> von Geschäften."
                        },
                        {
                            "text": "Die Regierung verhängte eine strenge Ausgangssperre, um das <w>Plündern</w> wirksam einzudämmen."
                        }
                    ],
                    "synonyms": [
                        "Plünderung"
                    ],
                    "common_phrases": [
                        "das Plündern von Geschäften"
                    ]
                }
            ]
        }
    ]
}