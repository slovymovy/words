                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f8485c6-a8ff-4a18-b7a8-06f66b4f718a",
                        "source_entry_id": "a20cba6d-0586-380b-a7c0-3e97e40b3b7f",
                        "source_sense_id": "a89f028c-1fc7-3fed-9629-21e7ef01ad4b",
                        "target_lang_word": "encanailler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encanailler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f436fb1a-b943-3630-9cec-5333a16af227",
                                        "entry_id": "add3a5a6-5f2c-3f70-a837-62009f0ed346",
                                        "glosses": [
                                            "Inciter quelqu’un à déchoir, à se déshonorer en lui faisant fréquenter la canaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c749ab29-b09c-4fca-97b5-5edbfcbb4772",
                                                "sense_id": "f436fb1a-b943-3630-9cec-5333a16af227",
                                                "text": "En introduisant cet homme dans notre société, vous nous avez encanaillés."
                                            },
                                            {
                                                "example_id": "e112fe00-995a-4f78-8a0c-5fef6b872dbb",
                                                "sense_id": "f436fb1a-b943-3630-9cec-5333a16af227",
                                                "text": "Vous encanaillez ce jeune homme en le conduisant dans ces mauvais lieux."
                                            },
                                            {
                                                "example_id": "608367d8-94cb-4b25-bcb3-8397a2b5d6cc",
                                                "sense_id": "f436fb1a-b943-3630-9cec-5333a16af227",
                                                "text": "Vous n’allez tout de même pas encanailler l’histoire !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6d60ca-0e93-3e5b-b3e6-5fc83fce5998",
                                        "entry_id": "add3a5a6-5f2c-3f70-a837-62009f0ed346",
                                        "glosses": [
                                            "Rendre canaille, coquin."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff7bf482-53d4-4f45-a1df-22e2afb83951",
                                                "sense_id": "3d6d60ca-0e93-3e5b-b3e6-5fc83fce5998",
                                                "text": "Souvent même au pied de la lampe de chevet disposait-elle un carré d’indienne dont les amants pourraient encanailler la lumière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e624fdd2-92a6-346a-9c66-934bc79f3382",
                                        "entry_id": "add3a5a6-5f2c-3f70-a837-62009f0ed346",
                                        "glosses": [
                                            "Hanter de la canaille ; avoir commerce, se lier avec de la canaille."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b841705e-db9b-4a17-9a4e-bc343a571869",
                                                "sense_id": "e624fdd2-92a6-346a-9c66-934bc79f3382",
                                                "text": "CÉLIMÈNE — Il est vrai que le goût des gens est étrangement gâté là-dessus, et que le siècle s’encanaille furieusement.\nÉLISE — Celui-là est joli encore, s’encanaille ! Est-ce vous qui l’avez inventé, madame ?"
                                            },
                                            {
                                                "example_id": "42065944-b1e9-442f-9acb-68c37824451b",
                                                "sense_id": "e624fdd2-92a6-346a-9c66-934bc79f3382",
                                                "text": "Et il ajouta, avec le sourire sceptique du gentilhomme encanaillé :\n— Bast ! je puis bien trahir un peu, moi aussi."
                                            },
                                            {
                                                "example_id": "e678c420-0dfc-41f3-996c-07072f4f56a4",
                                                "sense_id": "e624fdd2-92a6-346a-9c66-934bc79f3382",
                                                "text": "Il n’était pas indifférent que les déclarations de Rinri s’adressant à une francophone s’énoncent soit en français, soit en japonais : la langue française représentait sans doute ce territoire à la fois prestigieux et licencieux où l’on pouvait s’encanailler de sentiments inavouables."
                                            },
                                            {
                                                "example_id": "5a732482-5da3-4021-bc5c-40b2d84106af",
                                                "sense_id": "e624fdd2-92a6-346a-9c66-934bc79f3382",
                                                "text": "L’envie de s’encanailler sexuellement auprès d'un « wesh wesh » de banlieue était passée pour la pulpeuse Marjorie qui s'orientait davantage vers une vie de « Marie-Chantal » à la disposition d'une moitié politicienne."
                                            },
                                            {
                                                "example_id": "df2e2a35-9f5a-4ac7-9c6a-574e6f85b891",
                                                "sense_id": "e624fdd2-92a6-346a-9c66-934bc79f3382",
                                                "text": "Francis Claude ambitionnait d'attirer chez lui les intellectuels et la bourgeoisie de la rive gauche, désireux de « s'encanailler ». Aurait-il pu choisir un autre nom que celui de l'homme qui se conduisait comme un milord avec les arsouilles et comme une arsouille avec les milords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118548f2-8e38-313b-ba03-e40be7f847de",
                                        "entry_id": "add3a5a6-5f2c-3f70-a837-62009f0ed346",
                                        "glosses": [
                                            "Sortir des règles, des académismes..."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14f8ad6-b2fa-468d-9247-8526f29a76a7",
                                                "sense_id": "118548f2-8e38-313b-ba03-e40be7f847de",
                                                "text": "Maintenant que notre crédibilité commence à s’établir, le fonds va pouvoir s’encanailler en exposant une nouvelle génération d'artistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
