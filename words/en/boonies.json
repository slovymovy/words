                    "sense_id": "6fec2ea9-b4d8-312b-b7c3-dcb1c204dbcf",
                    "sense_definition": "A remote, rural, or isolated area, often far from cities or civilization.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "remote_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to move out to the <w>boonies</w> to escape the noise of the city.",
                            "target_lang_translations": {
                                "zh": "他们决定搬到<w>乡下</w>去，以躲避城市的喧嚣。"
                            }
                        },
                        {
                            "text": "Living in the <w>boonies</w> means you have to drive a long way just to buy groceries.",
                            "target_lang_translations": {
                                "zh": "住在<w>穷乡僻壤</w>意味着你得开车跑很远的路才能买到日用品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "out in the boonies",
                        "live in the boonies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term used to describe isolated areas."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指远离城市或文明的偏远、荒凉的乡村地区。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乡下",
