                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4c82e1-bb0b-4517-a2a6-4517fcab5946",
                                "sense_id": "0e15ea05-f2db-34f0-99ec-ae72cd39320b",
                                "text": "Bobby has at length ceased to offer me every object which it devolves upon him to hand me, with a quavering voice and a prolonged stammer, since, though I was at first excellently vulnerable by this weapon of offence, I am now becoming hornily hard and indifferent to it."
                            },
                            {
                                "example_id": "40814905-985a-48ef-8eda-b42d30eef4d0",
                                "sense_id": "0e15ea05-f2db-34f0-99ec-ae72cd39320b",
                                "text": "2009, Lee Montgomery, Tony Perez (editors), The Writer's Notebook: Craft Essays from Tin House, Tin House Books, page 18,\nShe had an affinity for world music and one day she sashayed hornily into her neighborhood recorded-music store […] ."
                            },
                            {
                                "example_id": "40559771-30ba-4eee-a302-77c181eb1ab3",
                                "sense_id": "0e15ea05-f2db-34f0-99ec-ae72cd39320b",
                                "text": "The officers look over at her hornily, before realising that she has a bazooka (and that is not a euphemism), which she utilises to fire a giant missile at them (after 'reading the instructions')."
                            }
                        ]
                    }
