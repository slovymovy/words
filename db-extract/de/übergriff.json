                "senses": [
                    {
                        "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                        "entry_id": "7ca1cc17-87da-39e6-a82c-90e250c39fb5",
                        "glosses": [
                            "eine rechtswidrige und/oder unangenehme Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6345cf71-967e-4fad-9209-10386ecd433b",
                                "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                                "text": "Der Übergriff auf ihre körperliche Unversehrtheit ist eine Straftat."
                            },
                            {
                                "example_id": "2f779d1e-3736-4c62-ac11-95d0a0746966",
                                "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                                "text": "„Die Zahl der Übergriffe auf Asylbewerber beziehungsweise ihre Unterkünfte hat sich 2014 verdreifacht.“"
                            },
                            {
                                "example_id": "add403c1-1e96-42a6-aad0-14a77b788ef0",
                                "sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                                "text": "„Allenthalben kam es zu Übergriffen und Misshandlungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ffeda9a-b954-304f-a1f2-2aae29049a1a",
                        "entry_id": "7ca1cc17-87da-39e6-a82c-90e250c39fb5",
                        "glosses": [
                            "das Übergreifen beziehungsweise Ausbreiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1799e1-9365-4746-a25b-3b93901b5153",
                                "sense_id": "9ffeda9a-b954-304f-a1f2-2aae29049a1a",
                                "text": "Diese Mauer soll den möglichen Übergriff eines Feuers von dem einen Gebäude auf das andere verhindern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27c42a95-4d35-4ac2-ae41-e178d42c2581",
                        "source_entry_id": "7ca1cc17-87da-39e6-a82c-90e250c39fb5",
                        "source_sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                        "source_sense_description": "eine rechtswidrige und/oder unangenehme Handlung",
                        "target_lang_word": "infringement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infringement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54afad6e-65e7-3c87-aa25-8eb26cc1d5fc",
                                        "entry_id": "473b797b-0d28-3098-baab-cf53adfb1bdd",
                                        "glosses": [
                                            "A violation or breach, as of a law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7bf6e6-46cf-4947-b985-3e992bff0fe8",
                                                "sense_id": "54afad6e-65e7-3c87-aa25-8eb26cc1d5fc",
                                                "text": "Georgia, ranked 16th in the world, dominated the breakdown before half-time and forced England into a host of infringements, but fly-half Merab Kvirikashvili missed three penalties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d63c8db-fa7d-3971-85ca-9598f62f9555",
                                        "entry_id": "473b797b-0d28-3098-baab-cf53adfb1bdd",
                                        "glosses": [
                                            "An encroachment on a right, a person, a territory, or a property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113ad784-3087-437b-985b-12e3629ec88a",
                                                "sense_id": "9d63c8db-fa7d-3971-85ca-9598f62f9555",
                                                "text": "The pattern of services over these lines today still pays homage to their history, which derived in considerable measure from the L.B.S.C.R.'s efforts to prevent infringement of its monopoly at Brighton and Eastbourne."
                                            },
                                            {
                                                "example_id": "c13b6e49-599c-46c6-828a-c8e4e1fd56c1",
                                                "sense_id": "9d63c8db-fa7d-3971-85ca-9598f62f9555",
                                                "text": "As a reward for their [the Levites'] devotion, they were made the guardians of the shrine from infringement."
                                            },
                                            {
                                                "example_id": "4c08b69e-5fc2-43d3-bf8a-7facec629101",
                                                "sense_id": "9d63c8db-fa7d-3971-85ca-9598f62f9555",
                                                "text": "As soon as it was suggested that it was considering the Swedish model – in which men are criminalised for buying sex, but the women working in prostitution are decriminalised – a slew of prominent male columnists started arguing against this infringement on a man's right to purchase a woman's body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d8cf471-1c54-4b77-b5b9-9e3ade1c33bc",
                        "source_entry_id": "7ca1cc17-87da-39e6-a82c-90e250c39fb5",
                        "source_sense_id": "7ae66627-4ab3-37e5-ad38-bc84730b8f9b",
                        "source_sense_description": "eine rechtswidrige und/oder unangenehme Handlung",
                        "target_lang_word": "encroachment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encroachment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "520e5ff5-e8f1-3892-b599-46e7c2bfaef1",
                                        "entry_id": "159f7eaf-124f-391b-9c94-51044d38a339",
                                        "glosses": [
                                            "An entry into a place or area that was previously uncommon; an advance beyond former borders; intrusion; incursion."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4dfa2c-3910-4292-a141-180e357bd72f",
                                                "sense_id": "520e5ff5-e8f1-3892-b599-46e7c2bfaef1",
                                                "text": "At the same time, the encroachment of vegetation proceeds apace, and broom and brambles have already made portions of the line impassable, even on foot."
                                            },
                                            {
                                                "example_id": "143a4e4c-9d07-428d-ba35-757790ff1a99",
                                                "sense_id": "520e5ff5-e8f1-3892-b599-46e7c2bfaef1",
                                                "text": "[…] the largest extents of encroachments were found in the Dry Zone Districts, such as Anuradhapura, Kurunegala and Moneragala, where encroachable State lands were readily available (Table I). […] Between 1979-1985, some 104,490 new encroachments covering an extent of 70,646 Ha (174,566 acres) took place with high encroachments in the Central Province (40% increase over 1978). The Western Province comes second. This excludes […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5c59a62-531a-385c-b292-0287f06d1896",
                                        "entry_id": "159f7eaf-124f-391b-9c94-51044d38a339",
                                        "glosses": [
                                            "An intrusion upon another's possessions or rights; infringement."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6f2625-396e-488e-90ee-c7a4221bb7e2",
                                                "sense_id": "d5c59a62-531a-385c-b292-0287f06d1896",
                                                "text": "The Legislative department derives a superiority in our Governments from other circumstances. Its constitutional powers being at once more extensive, and less susceptible of precise limits, it can, with the greater facility, mask, under complicated and indirect measures, the encroachments which it makes on the coördinate departments."
                                            },
                                            {
                                                "example_id": "2f6e7c2f-84a1-4005-bf44-c1bd1decea63",
                                                "sense_id": "d5c59a62-531a-385c-b292-0287f06d1896",
                                                "text": "Ah! my brother, we do well to watch our birthright jealously; the least invasion on the meanest peasant, the slightest encroachment of the powerful, are not matters to be neglected—such are the first steps of tyranny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08bb4b7b-bb60-3543-83b3-f2f3ca36f94e",
                                        "entry_id": "159f7eaf-124f-391b-9c94-51044d38a339",
                                        "glosses": [
                                            "That which is gained by such unlawful intrusion."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2ab72ce-3886-3b20-8d30-7a9daf66d1de",
                                        "entry_id": "159f7eaf-124f-391b-9c94-51044d38a339",
                                        "glosses": [
                                            "An unlawful diminution of the possessions of another."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
