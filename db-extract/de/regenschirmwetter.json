                                "example_id": "becded42-1eaa-46bf-ad1c-c70c38e2eff4",
                                "sense_id": "b5db320e-654f-31e0-8809-3603696b0e85",
                                "text": "„Den ganzen Samstag über Regenschirmwetter – daran konnte sich zurückliegend in den vergangenen zehn Jahren niemand vom Lauenbrücker Flohmarktteam erinnern […].“"
                            },
                            {
                                "example_id": "d3201523-17c3-4b4b-aa6d-6403398291d6",
                                "sense_id": "b5db320e-654f-31e0-8809-3603696b0e85",
                                "text": "„Winter in Wuppertal, das hieß wochenlanges Regenschirmwetter.“"
                            },
                            {
                                "example_id": "678f9c14-1e7b-46b0-8889-60003c6903e0",
                                "sense_id": "b5db320e-654f-31e0-8809-3603696b0e85",
                                "text": "„Trotz des Regenschirmwetters versammelte sich am Dienstag (09.06.) ab 14 Uhr eine riesige Menschentraube auf dem Marktplatz von Pößneck.“"
                            }
