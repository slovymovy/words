                    "sense_id": "fb0369b6-c706-36b4-aa7d-d31f475c7033",
                    "sense_definition": "Filled with or inspiring hope.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hoping</w> crowd waited eagerly for the good news.",
                            "target_lang_translations": {
                                "ru": "<w>Надеющаяся</w> толпа с нетерпением ждала хороших новостей.",
                                "de": "Die <w>hoffende</w> Menge wartete sehnsüchtig auf die guten Nachrichten.",
                                "fr": "La foule <w>pleine d'espoir</w> attendait impatiemment la bonne nouvelle."
                            }
                        },
                        {
                            "text": "A <w>hoping</w> heart can endure many difficulties.",
                            "target_lang_translations": {
                                "ru": "<w>Надеющееся</w> сердце может вынести много трудностей.",
                                "de": "Ein <w>hoffendes</w> Herz kann viele Schwierigkeiten ertragen.",
                                "fr": "Un cœur <w>plein d'espoir</w> peut surmonter bien des difficultés."
                            }
                        }
                    ],
