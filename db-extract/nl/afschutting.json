                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63332de0-6fd4-3a86-a4b9-3e6ef98f595d",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "A thin artificial barrier that separates two pieces of land or forms a perimeter enclosing the lands of a house, building, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2a0d18-da4b-4ab1-a94d-ab64b9683727",
                                                "sense_id": "63332de0-6fd4-3a86-a4b9-3e6ef98f595d",
                                                "text": "There was a weak place in the fence separating the two inclosures"
                                            },
                                            {
                                                "example_id": "88571ac7-5a5f-4911-9a84-b4c01d6c452a",
                                                "sense_id": "63332de0-6fd4-3a86-a4b9-3e6ef98f595d",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da5a28c-a3f8-33bb-956f-12272ba7157c",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "Someone who hides or buys and sells stolen goods, a criminal middleman for transactions of stolen goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd251e1-b3ea-4cf7-aa55-0684f3ecd2bd",
                                                "sense_id": "2da5a28c-a3f8-33bb-956f-12272ba7157c",
                                                "text": "The Bat—they called him the Bat.[…]. He'd never been in stir, the bulls had never mugged him, he didn't run with a mob, he played a lone hand, and fenced his stuff so that even the fence couldn't swear he knew his face."
                                            },
                                            {
                                                "example_id": "80f347da-8075-4a6b-9cc0-2bc3b596b203",
                                                "sense_id": "2da5a28c-a3f8-33bb-956f-12272ba7157c",
                                                "text": "The Finn was a fence, a trafficker in stolen goods, primarily in software. In the course of this business, he sometimes came into contact with other fences, some of whom dealt in the more traditional articles of the trade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "859ef4b5-8055-329f-8589-aa7c3777fbcb",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "The place whence such a middleman operates."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60233f49-6fdd-3df7-be1e-06ed11641181",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "Skill in oral debate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2753033c-fe1d-3823-9193-5d2a91eec60d",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "The art or practice of fencing."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249994a9-0bc0-47d9-8c67-9481d0ae0949",
                                                "sense_id": "2753033c-fe1d-3823-9193-5d2a91eec60d",
                                                "text": "I bruised my shin th' other day with playing at sword and dagger with a master of fence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f776c062-fbed-320f-87c0-31534789c135",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "A guard or guide on machinery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "986ce06d-4df4-346f-bca5-853160a3e718",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "A barrier, for example an emotional barrier."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1410265b-5c0c-412e-b1e3-92f8deb2ef7d",
                                                "sense_id": "986ce06d-4df4-346f-bca5-853160a3e718",
                                                "text": "I was in your arms\nThinking I belonged there\nI figured it made sense\nBuilding me a fence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92bb65d-121e-36c7-a6fd-fe1b6f2e55ab",
                                        "entry_id": "64742e8f-95cb-343e-8b62-634c0ae8768b",
                                        "glosses": [
                                            "A memory barrier."
                                        ],
