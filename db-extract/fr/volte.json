                "senses": [
                    {
                        "sense_id": "8e02b480-af05-3e97-8728-a13051f3a435",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Danse à trois temps d’origine provençale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "db2c54b9-a3eb-390c-8b9d-3ecb0b9682d5",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Mouvement en cercle que le cavalier fait exécuter au cheval."
                        ],
                        "tags": [
                            "Manège"
                        ],
                        "examples": [
                            {
                                "example_id": "0f776ee9-bb83-4d56-8609-ced517916690",
                                "sense_id": "db2c54b9-a3eb-390c-8b9d-3ecb0b9682d5",
                                "text": "Il talonna son cheval, qui apprécia moyennement le traitement, et lui fit faire une volte pour couper court à la conversation."
                            },
                            {
                                "example_id": "a7d74121-14bd-4de5-a3bc-71806968cef1",
                                "sense_id": "db2c54b9-a3eb-390c-8b9d-3ecb0b9682d5",
                                "text": "Parfois un bœuf s'échappait du rang et faisait une volte sur le trottoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff4a013c-2f17-3a97-8055-d0f998bf61b2",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Mouvement circulaire effectué par une personne."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "e461d6e5-78fd-4c52-982f-69af3feb7c3f",
                                "sense_id": "ff4a013c-2f17-3a97-8055-d0f998bf61b2",
                                "text": "Ella essaya de trouver son équilibre, mais Clem était trop rapide et les voltes lui donnaient le vertige."
                            },
                            {
                                "example_id": "945d0adb-0e68-4313-92ab-2c31794bcf40",
                                "sense_id": "ff4a013c-2f17-3a97-8055-d0f998bf61b2",
                                "text": "Duchotel, Léontine, Moricet, se retournant en même temps à la voix de Bridois et bondissant dans une volte qui les ramène face au public. — Le commissaire de police !"
                            }
                        ]
                    },
                    {
                        "sense_id": "7fe0d1b3-468d-3dc2-a638-2610a6c24fb0",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Figure imposée au départ de certaines courses de trot, consistant à lancer les chevaux dans un mouvement de volte (2) depuis la raquette dans une ligne perpendiculaire ou parallèle à la ligne de départ, cette dernière ne devant être franchie par aucun concurrent avant la fin du compte-à-rebours sous peine de faux départ."
                        ],
                        "tags": [
                            "Sports hippiques"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3cf0c535-a2b6-38ac-b04a-61830966f392",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Mouvement que l’on fait pour éviter les coups de l’adversaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a8cc7fc-5f76-4ead-83c6-0a441b041c68",
                                "sense_id": "3cf0c535-a2b6-38ac-b04a-61830966f392",
                                "text": "Les soldats frappèrent de tranche en criant comme des rats mais Angelo leur releva vertement les lames et en quelques voltes fort habiles les plaça tous les deux à sa main."
                            }
                        ]
                    },
                    {
                        "sense_id": "a22140ed-440c-311f-8ba6-bc38eff2418a",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Cri de l’oiseau voyant sa proie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "524ffdc6-25f6-3e95-8d1a-266b6055f0e9",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Route du navire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0e32f617-edd4-3eb2-8541-6d133eeac720",
                        "entry_id": "4bf07a00-70e9-38a8-abb8-ab91b046b4a5",
                        "glosses": [
                            "Mouvement circulaire donné à un objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1ad54e-7bef-434d-a78a-a175cc580d38",
                                "sense_id": "0e32f617-edd4-3eb2-8541-6d133eeac720",
                                "text": "Un jour, quelqu’un de la rue a crié : « Où allez-vous donc comme ça ? » Et le marquis Pierre Bertin a répondu : « Service du Roi ! » en saluant les badauds d’une grande volte de son chapeau empanaché."
                            }
                        ]
                    }
                ],
