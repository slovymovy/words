                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d9e5871-db7a-374f-8e12-394a378fc92d",
                        "entry_id": "8c424e37-dcb9-3ea9-874a-f15023b954dc",
                        "glosses": [
                            "zacht gebonk en gestoot van iemand die loopt of een trap opgaat aan de andere kant van een afscheiding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f94faa-e522-48fd-bdb3-b0066f3b516f",
                                "sense_id": "5d9e5871-db7a-374f-8e12-394a378fc92d",
                                "text": "Toen de chauffeur tijdens zijn pauze gestommel uit de wagen hoorde komen, alarmeerde hij de politie. De vluchtelingen zijn aangehouden en overgebracht naar het politiebureau."
                            },
                            {
                                "example_id": "9c90ea55-b2f1-499f-8607-ccb736f1bf06",
                                "sense_id": "5d9e5871-db7a-374f-8e12-394a378fc92d",
                                "text": "De 77-jarige man hoorde rond een uur of tien gestommel in zijn woning aan de Middenweg en ging op onderzoek uit. Op de benedenverdieping zag hij twee mannen staan, die niet blij waren de man te zien. Er ontstond een worsteling waarbij de bewoner gewond raakte aan zijn gezicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1ebb871-d76a-44fb-ad88-475db7b9a986",
                        "source_entry_id": "8c424e37-dcb9-3ea9-874a-f15023b954dc",
                        "source_sense_id": "5d9e5871-db7a-374f-8e12-394a378fc92d",
                        "target_lang_word": "thumping",
