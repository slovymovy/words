{
    "word_family": [
        "tenuously",
        "tenuousness",
        "tenuity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "01cea589-7bc6-3027-967c-611b8de8392b",
                    "sense_definition": "Weak, flimsy, or insubstantial; lacking a sound basis or strength.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had only a <w>tenuous</w> connection between the suspect and the crime scene.",
                            "target_lang_translations": {
                                "cs": "Policie měla mezi podezřelým a místem činu jen <w>chatrné</w> spojení."
                            }
                        },
                        {
                            "text": "After years of conflict, the two nations finally agreed on a <w>tenuous</w> peace.",
                            "target_lang_translations": {
                                "cs": "Po letech konfliktu se oba národy konečně dohodly na <w>křehkém</w> míru."
                            }
                        }
                    ],
                    "synonyms": [
                        "flimsy",
                        "insubstantial",
                        "unsubstantial"
                    ],
                    "antonyms": [
                        "strong",
                        "solid",
                        "substantial"
                    ],
                    "common_phrases": [
                        "tenuous peace",
                        "tenuous connection",
                        "tenuous link"
                    ],
                    "target_lang_definitions": {
                        "cs": "Slabý, chatrný nebo neopodstatněný; postrádající pevný základ nebo sílu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chatrný",
                                "target_lang_sense_clarification": "používá se pro slabé spojení nebo argumenty"
                            },
                            {
                                "target_lang_word": "slabý",
                                "target_lang_sense_clarification": "obecné vyjádření nedostatku síly či důkazů"
                            },
                            {
                                "target_lang_word": "nejistý",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek pevného základu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01b0ed4a-3cc3-3709-924e-a131d253b38e",
                    "sense_definition": "Precarious, highly unstable, or dependent upon unreliable circumstances.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government held a <w>tenuous</w> grip on power during the economic crisis.",
                            "target_lang_translations": {
                                "cs": "Nová vláda si během hospodářské krize udržovala jen <w>nejistou</w> moc."
                            }
                        },
                        {
                            "text": "He managed to maintain a <w>tenuous</w> hold on his job despite his frequent absences.",
                            "target_lang_translations": {
                                "cs": "Navzdory častým absencím se mu podařilo udržet si <w>nejistou</w> pozici v zaměstnání."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragile",
                        "frail"
                    ],
                    "antonyms": [
                        "secure",
                        "stable"
                    ],
                    "common_phrases": [
                        "tenuous grip",
                        "tenuous hold",
                        "tenuous position"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nejistý, velmi nestabilní nebo závislý na nespolehlivých okolnostech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nejistý",
                                "target_lang_sense_clarification": "vyjadřuje nestabilitu pozice či moci"
                            },
                            {
                                "target_lang_word": "křehký",
                                "target_lang_sense_clarification": "používá se pro situace, které se mohou snadno zhroutit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d95e9796-412b-30f7-93bb-22aca6e1c510",
                    "sense_definition": "Very thin, slender, or fine in substance or physical consistency.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_thinness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high-altitude atmosphere consists of <w>tenuous</w> gas that is difficult to breathe.",
                            "target_lang_translations": {
                                "cs": "Vysokohorská atmosféra se skládá z <w>řídkého</w> plynu, který se obtížně dýchá."
                            }
                        },
                        {
                            "text": "The spider spun a web of <w>tenuous</w> threads that glistened in the morning dew.",
                            "target_lang_translations": {
                                "cs": "Pavouk upředl síť z <w>jemných</w> vláken, která se třpytila v ranní rose."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossamer",
                        "delicate"
                    ],
                    "antonyms": [
                        "thick",
                        "dense"
                    ],
                    "common_phrases": [
                        "tenuous threads",
                        "tenuous atmosphere"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi tenký, jemný nebo řídký co do látky či fyzické konzistence."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "řídký",
                                "target_lang_sense_clarification": "používá se pro plyny nebo atmosféru"
                            },
                            {
                                "target_lang_word": "jemný",
                                "target_lang_sense_clarification": "používá se pro fyzickou tenkost a delikátnost"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}