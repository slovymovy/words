                        "glosses": [
                            "Appareil pour effectuer la chromatographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c334ea0-84b7-4ac2-97ba-46b6701eb70e",
                                "sense_id": "fb28bb02-ede4-33bf-9ff7-4b1fca25478c",
                                "text": "L’utilisation de chromatographes en phase gazeuse et d’analyseurs de gaz avec ou sans extraction pour la détermination des émissions au titre des présentes lignes directrices doit être indiquée dans le plan de surveillance de l’installation."
                            },
                            {
                                "example_id": "b790513f-6131-4552-8144-0c52d5d9c666",
                                "sense_id": "fb28bb02-ede4-33bf-9ff7-4b1fca25478c",
                                "text": "C'était une scène assez étrange, car j’étais accoutumée aux instruments compliqués et mystérieux tels les microscopes électroniques à balayage ou les chromatographes en phase gazeuse."
                            }
                        ]
