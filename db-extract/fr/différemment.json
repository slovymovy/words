        "fr-extract.jsonl": [
            {
                "entry_id": "d9d2efe0-2a00-31c1-babc-205a28cf26a4",
                "word": "différemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "522bc84e-ca36-3fca-9e4a-f772846b9b74",
                        "entry_id": "d9d2efe0-2a00-31c1-babc-205a28cf26a4",
                        "glosses": [
                            "D’une manière différente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1075b037-f7e0-4f92-8552-12e915f00134",
                                "sense_id": "522bc84e-ca36-3fca-9e4a-f772846b9b74",
                                "text": "En réfléchissant différemment sur l’installation des équipements, en refusant d’utiliser les équipements disponibles sur étagère, en traquant les poids inutiles, nous avons réussi à gagner 300 kilos sur le bateau proposé par les architectes."
                            },
                            {
                                "example_id": "c20b7cdc-e962-41f5-91c9-16baf7c5b775",
                                "sense_id": "522bc84e-ca36-3fca-9e4a-f772846b9b74",
                                "text": "Chacun apporte différemment son opinion sur cette grande nouvelle."
                            },
                            {
                                "example_id": "6a4fc858-34f7-4da9-9aba-c93f0472f45a",
                                "sense_id": "522bc84e-ca36-3fca-9e4a-f772846b9b74",
                                "text": "Je me contredis, il est vrai : accusez-en les hommes, dont je ne fais que rapporter les jugements, je ne dis pas des différents hommes, je dis les mêmes qui jugent si différemment."
                            },
                            {
                                "example_id": "3378eb27-d812-4ba4-a688-94fa5538db12",
                                "sense_id": "522bc84e-ca36-3fca-9e4a-f772846b9b74",
                                "text": "Qu'est-ce que Jupiter ? un corps sans connaissance. D’où vient donc que son influence Agit différemment sur ces deux hommes-ci ?"
                            },
                            {
                                "example_id": "a359efd4-1d4e-40d2-841c-fbf8d689d24b",
                                "sense_id": "522bc84e-ca36-3fca-9e4a-f772846b9b74",
                                "text": "Si tout cela n'était pas arrivé, vous sentez que les affaires des maisons de France et d’Autriche auraient tourné différemment ; le système de l’Europe aurait changé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2e51b5d-196b-30b7-ba94-82f0b6e900d2",
                        "entry_id": "d9d2efe0-2a00-31c1-babc-205a28cf26a4",
                        "glosses": [
                            "Avec un complément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aed7b2d-3d9e-42cb-995d-8b6d7ae69952",
                                "sense_id": "f2e51b5d-196b-30b7-ba94-82f0b6e900d2",
                                "text": "Les princes agissent différemment des particuliers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84724ce8-3b2f-40c6-bc89-cd4cab27729e",
                        "source_entry_id": "d9d2efe0-2a00-31c1-babc-205a28cf26a4",
                        "target_lang_word": "differently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "differently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab40e12-70cc-3661-8d22-64232d6d1fb9",
                                        "entry_id": "9df6fc8d-c4bc-3b10-a1bf-5510eb571ae2",
                                        "glosses": [
                                            "In a different way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e30832e-5c26-45f9-96f1-2e8831bb2696",
                                                "sense_id": "1ab40e12-70cc-3661-8d22-64232d6d1fb9",
                                                "text": "Things turned out differently from what I'd envisaged."
                                            },
                                            {
                                                "example_id": "5f437416-ee64-4582-9648-df32d445f668",
                                                "sense_id": "1ab40e12-70cc-3661-8d22-64232d6d1fb9",
                                                "text": "I was (says Mr. Highmore) forcibly struck with the violence of its pulsation, so much so, that, if it had been differently situated, I should have considered it an aneurism of considerable magnitude."
                                            },
                                            {
                                                "example_id": "7e633036-1ed2-4745-90e2-21f28751221f",
                                                "sense_id": "1ab40e12-70cc-3661-8d22-64232d6d1fb9",
                                                "text": "\"You see, gentlemen, I couldn't bear the look of him, there was something in him ignoble, impudent, trampling on everything sacred, something sneering and irreverent, loathsome, loathsome. But now that he's dead, I feel differently.\"\n\"How do you mean?\"\n\"I don't feel differently, but I wish I hadn't hated him so.\"\n\"You feel penitent?\"\n\"No, not penitent, don't write that. I'm not much good myself; I'm not very beautiful, so I had no right to consider him repulsive. That's what I mean. Write that down, if you like.\""
                                            },
                                            {
                                                "example_id": "54171e70-6c98-4b34-89d0-6538109c7995",
                                                "sense_id": "1ab40e12-70cc-3661-8d22-64232d6d1fb9",
                                                "text": "Recent research in the field of sociolinguistics and related fields has shown that women and men speak differently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c5e23ff-8f5b-4cf6-b72b-b186fe19a4a7",
