{
    "word": "saltire",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "27a1c63c-c8a0-3710-97e1-58bf8f64b5d3",
                "word": "saltire",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c95ae9ab-4006-457f-aec0-03238f5f6cba",
                        "entry_id": "27a1c63c-c8a0-3710-97e1-58bf8f64b5d3",
                        "tags": [
                            "plural"
                        ],
                        "form": "saltires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "028d9b40-b4c6-3828-a10a-d248e43b5ea6",
                        "entry_id": "27a1c63c-c8a0-3710-97e1-58bf8f64b5d3",
                        "glosses": [
                            "An ordinary (geometric design) in the shape of an X. It usually occupies the entire field in which it is placed."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1b1e0b51-4da4-3ef1-9a47-bbc0f8168830",
                        "entry_id": "27a1c63c-c8a0-3710-97e1-58bf8f64b5d3",
                        "glosses": [
                            "The Saint Andrew's cross, the flag of Scotland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88a6c55d-e05d-4a41-9116-508d61ae82c7",
                                "sense_id": "1b1e0b51-4da4-3ef1-9a47-bbc0f8168830",
                                "text": "But the World Cup winning veteran's left boot was awry again, the attempt sliced horribly wide of the left upright, and the saltires were waving aloft again a moment later when a long pass in the England midfield was picked off to almost offer up a breakaway try."
                            },
                            {
                                "example_id": "1e34fe1d-03b0-40ee-bb25-dc5d6bdf435a",
                                "sense_id": "1b1e0b51-4da4-3ef1-9a47-bbc0f8168830",
                                "text": "It was early August. In the Borders, there were few signs yet of a campaign that could take Scotland out of the United Kingdom. A large Y-E-S hung in separate letters from a tree on the road from Coldstream to Kelso. There wasn't a N-O to match it, but Kelso town hall flew both the saltire and the union jack."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9d1dd2f-7154-332f-bed0-27e5aabf395e",
                        "entry_id": "27a1c63c-c8a0-3710-97e1-58bf8f64b5d3",
                        "glosses": [
                            "The Saint Patrick's Cross, the pre 1922 flag of Ireland."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c8d2ccf-4e6d-47ca-b00d-9b6575e81aaf",
                        "source_entry_id": "27a1c63c-c8a0-3710-97e1-58bf8f64b5d3",
                        "source_sense_description": "ordinary in the shape of a cross",
                        "target_lang_word": "Andreaskreuz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andreaskreuz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b9bef5-d5b0-3652-8a33-f4008da3151a",
                                        "entry_id": "1d621d9f-f7f9-3a9b-8582-db81ef23b111",
                                        "glosses": [
                                            "ein X-förmiges Kreuz mit zwei diagonal verlaufenden, sich kreuzenden Balken. An einem Kreuz dieser Form soll der Apostel Andreas gekreuzigt worden sein."
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba602d94-8050-4b84-aef4-e1aba6ebfe72",
                                                "sense_id": "d0b9bef5-d5b0-3652-8a33-f4008da3151a",
                                                "text": "„Zur Darstellung der Kreuzigung des heiligen Andreas wurde das Andreaskreuz erstmals in einem Autuner Tropar […] verwendet, […] Das Andreaskreuz drang auch in die Heraldik vor.“"
                                            },
                                            {
                                                "example_id": "256c0cb0-2ca3-4753-8f86-35e262ee0a76",
                                                "sense_id": "d0b9bef5-d5b0-3652-8a33-f4008da3151a",
                                                "text": "„Die Verbreitung des Andreaskreuz ist schwankend. In der italienischen und französischen Malerei selten, in der deutschen und niederländischen Kunst seit dem späten Mittelalter überwiegend.“"
                                            },
                                            {
                                                "example_id": "084cc438-f3bd-409b-85a2-4cc7198b6a1e",
                                                "sense_id": "d0b9bef5-d5b0-3652-8a33-f4008da3151a",
                                                "text": "Neben dem altgriechischen Buchstaben \"Tav\" (\"Τ\") gewinnt auch das \"Chi\" (\"χ\") eine Bedeutung als Heilzeichen, da der Anfangsbuchstabe des Christusnamens mit dem Schrägkreuz des \"Chi\" - dem Andreaskreuz - identisch ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3adee1e8-f895-3295-ab07-116eb8f0d6e4",
                                        "entry_id": "1d621d9f-f7f9-3a9b-8582-db81ef23b111",
                                        "glosses": [
                                            "X- und kreuzförmiges Konstruktionselement aus Holz"
                                        ],
                                        "tags": [
                                            "Fachwerkbau"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d7aab7b0-2b3a-352a-9ab7-21e70a14b387",
                                        "entry_id": "1d621d9f-f7f9-3a9b-8582-db81ef23b111",
                                        "glosses": [
                                            "andreaskreuzförmige Symbole zum Anzeigen von Gefahren im Straßenverkehr (Andreaskreuz vor Bahnübergängen) oder für Gefahrstoffe in der Chemie"
                                        ],
                                        "tags": [
                                            "Symbolik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e93967f-b2e9-4176-b81c-ecfb20246ce8",
                                                "sense_id": "d7aab7b0-2b3a-352a-9ab7-21e70a14b387",
                                                "text": "Das Andreaskreuz vor einem Bahnübergang bedeutet: Dem Schienenverkehr Vorrang gewähren!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
