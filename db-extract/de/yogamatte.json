                "senses": [
                    {
                        "sense_id": "6bb7a687-87bd-364f-b5ca-152ea8ae1c9a",
                        "entry_id": "3539a554-796d-3c87-9e77-826ff89ae8f9",
                        "glosses": [
                            "Matte, auf der Yoga ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25b59a15-4734-4204-8f43-b239cd91ba4b",
                                "sense_id": "6bb7a687-87bd-364f-b5ca-152ea8ae1c9a",
                                "text": "„Das zusammengerollte Ding unter Graubarts Arm: eine Yogamatte.“"
                            },
                            {
                                "example_id": "a0438401-08ae-4100-99ba-a1471681c867",
                                "sense_id": "6bb7a687-87bd-364f-b5ca-152ea8ae1c9a",
                                "text": "„Es gibt Gewichte, Yogamatten, sogar eine kleine Stereoanlage, um beim Trainieren Musik abzuspielen.“"
                            },
                            {
                                "example_id": "51cbee2e-887b-4b6b-9048-77491e58ce9b",
                                "sense_id": "6bb7a687-87bd-364f-b5ca-152ea8ae1c9a",
                                "text": "„Ihre Arbeitskabine in einer Ecke des Büroraums konnte man nicht wirklich als Büro bezeichnen, doch war sie immer noch besser als die der meisten anderen Post-Reporter. Drei mal drei Meter, vollgestopft mit Büchern, Zeitschriften, Zeitungen, Aktenordnern, Reisetaschen und Rucksäcken mit Rollen, Yogamatten und weiteren Fitness-Utensilien.“"
                            },
                            {
                                "example_id": "5d71887e-bb71-49f8-b05c-ffe6928e5a59",
                                "sense_id": "6bb7a687-87bd-364f-b5ca-152ea8ae1c9a",
                                "text": "„Ich backte Pfannkuchen für sie, kaufte ihr eine Yogamatte, schlief an den richtigen Tagen mit ihr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
