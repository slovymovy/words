                        "source_sense_description": "middernacht tot middernacht",
                        "target_lang_word": "calendar day",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calendar day",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dfb4778-073c-3798-b8fb-1f6445bd44e4",
                                        "entry_id": "529349d8-1d6c-314a-abf5-67f3b7def51c",
                                        "glosses": [
                                            "A timespan of exactly 24 hours, measured from one midnight to the next."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adcc9e4e-0d83-4aa7-8a43-6699d7a90cf2",
                                                "sense_id": "1dfb4778-073c-3798-b8fb-1f6445bd44e4",
                                                "text": "Travel insurance is available at the special price of pounds 4 for one calendar day, pounds 10 up to 36 hours."
                                            },
                                            {
                                                "example_id": "ca774ace-3b6d-4d4a-a2c8-133d4748293c",
                                                "sense_id": "1dfb4778-073c-3798-b8fb-1f6445bd44e4",
                                                "text": "The $28 billion budget was approved by committees in both houses Wednesday. Since one calendar day must elapse before a floor vote, the votes will take place after midnight Thursday unless Republicans agree to suspend the rule."
                                            },
                                            {
                                                "example_id": "ef8c0d6a-fb0f-433e-a30c-7febb62d5913",
                                                "sense_id": "1dfb4778-073c-3798-b8fb-1f6445bd44e4",
                                                "text": "\"[T]he Games were stopped for a full 24 hours, though it was not a calendar day.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00675cfe-3b62-31cb-aa3c-21a4a6db0a63",
                                        "entry_id": "529349d8-1d6c-314a-abf5-67f3b7def51c",
                                        "glosses": [
                                            "A day having a conventional designation on a recognized calendar, such as a numerical identification within a named month."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7de572-7f21-4ffe-b8af-03205bd7585b",
                                                "sense_id": "00675cfe-3b62-31cb-aa3c-21a4a6db0a63",
                                                "text": "'[T]is wonderful where or when we ever got anything of this which we call wisdom, poetry, virtue. We never got it on any dated calendar day."
                                            },
                                            {
                                                "example_id": "494a6ffe-fff4-400c-bc44-6690ea6744f3",
                                                "sense_id": "00675cfe-3b62-31cb-aa3c-21a4a6db0a63",
                                                "text": "My story started on a calendar day — July 2nd,1977 — and ended on a calendar day — February 14th, 1978 — but in between there was no calendar."
                                            },
                                            {
                                                "example_id": "687e63f4-d423-47fc-b76b-9d04e49d9585",
                                                "sense_id": "00675cfe-3b62-31cb-aa3c-21a4a6db0a63",
                                                "text": "The number 666 has long held significance . . . that it's a mark of the devil. But now that the actual calendar day is about to arrive — on Tuesday, 6/6/06 — it's not only the superstitious among us who are looking ahead nervously."
                                            }
                                        ]
                                    }
                                ]
                            }
