                "senses": [
                    {
                        "sense_id": "e3404689-62a8-339e-940d-cbdd6c6f8eed",
                        "entry_id": "b512f9eb-2c04-3b36-b927-1efba55507fd",
                        "glosses": [
                            "bewegliche Vorrichtung in einer Rohrleitung, die eine Verengung des Rohrquerschnitts ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d9e2a4-25fe-49ee-96a0-4679ada100ab",
                                "sense_id": "e3404689-62a8-339e-940d-cbdd6c6f8eed",
                                "text": "„Die Drosselklappe wird für Luft, Gase, Wasser, Flüssigkeiten, pulverförmige und körnige Medien eingesetzt.“"
                            },
                            {
                                "example_id": "bfbdc923-5a81-4de2-acf2-432e7e8b7bcc",
                                "sense_id": "e3404689-62a8-339e-940d-cbdd6c6f8eed",
                                "text": "„Die Drosselklappe ist nichts anderes als eine Metallplatte, die sich im Inneren des Rauchrohres vor dem Übergang zum eigentlichen Schornstein befindet.“"
                            },
                            {
                                "example_id": "7bab9c19-45aa-4f9b-a58b-760b2613ce24",
                                "sense_id": "e3404689-62a8-339e-940d-cbdd6c6f8eed",
                                "text": "„Bei Vergasern befindet sich die Drosselklappe an einer Stelle des Ansaugtrichters wo er eine zylindrische Form hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
