                "translations": [
                    {
                        "translation_id": "007daceb-8557-4d53-8ac5-72a1f1c1754d",
                        "source_entry_id": "9f7bca36-cc5c-3353-8835-807852f039f2",
                        "source_sense_description": "a plant of the family Portulacaceae",
                        "target_lang_word": "pourpier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pourpier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Nom usuel donné au diverses plantes du genre Portulaca, plantes à feuilles épaisses et à tige couchée de la famille des Portulacacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dae7871-e339-413e-a843-3c0fcef64803",
                                                "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                                "text": "Cela fit, avec quelques plants de pourpier qui croissaient au fond d’un ravin, tout le déjeuner du 22."
                                            },
                                            {
                                                "example_id": "f9e4f75e-54fb-4ab1-8552-9a0038847728",
                                                "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                                "text": "Le pâturin a envahi les allées. Devant le parloir, des pourpiers qui se sont échappés, sans doute, des grands pots d’orangers où on les avait plantés, rampent et fleurissent entre les pavés."
                                            },
                                            {
                                                "example_id": "75cf182f-8f5c-4421-843e-41fe7e1ee312",
                                                "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                                "text": "Il en était de même à Saint-Tropez, quand nous attendions, sous la dense glycine, que le vent de ponant et le soleil, conjugués, éveillassent la mer, les cigales, les convolvulus bleus et le pourpier à quatre couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84315b98-d567-3ed4-af41-467b0bf71d56",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Portulaca oleracea, le pourpier potager ou pourpier sauvage, que l’on cultive comme plante potagère."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b7f943-fb56-4534-b87c-d5da14582d73",
                                                "sense_id": "84315b98-d567-3ed4-af41-467b0bf71d56",
                                                "text": "Une couche de pourpier."
                                            },
                                            {
                                                "example_id": "83155593-cfc0-4767-aaae-d159049f1b42",
                                                "sense_id": "84315b98-d567-3ed4-af41-467b0bf71d56",
                                                "text": "Gregory Cobwell avait terminé son solitaire repas composé de salade de pourpier et d’oignons frits, cuisiné dans un infâme petit réduit qu’il dénommait pompeusement \"office\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc8684e-4100-37d0-8787-256e7a6efc1e",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Portulaca grandiflora, le pourpier à grandes fleurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e25e41f-056c-3b5f-a475-ca25a7529d65",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Nom donné à diverses plantes qui ressemblent au genre Portulaca mais sont d'autres genres, comme par exemples : Atriplex, Lythrum, Sesuvium, Tallinum, etc., certains de ces genres étaient anciennement classés dans la famille des Portulacaeae, celle des pourpiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "072f4698-0a7e-4575-a6be-7b46a92c7be6",
                        "source_entry_id": "9f7bca36-cc5c-3353-8835-807852f039f2",
                        "source_sense_description": "a plant of the family Portulacaceae",
                        "target_lang_word": "Portulak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portulak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be2fe53d-0ff9-37c2-870b-7f7604fae4bf",
                                        "entry_id": "9b75ac3a-82b1-3386-b926-c8f01eadbb07",
                                        "glosses": [
                                            "Pflanzengattung Portulaca aus der Familie der Portulakgewächse"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f45a73b9-996a-459d-9e8a-0f33b23d8f86",
                                                "sense_id": "be2fe53d-0ff9-37c2-870b-7f7604fae4bf",
                                                "text": "Die Gattung Portulak umfasst zahlreiche Arten."
                                            },
                                            {
                                                "example_id": "7f9760e7-2c7e-459f-bde2-925118429a72",
                                                "sense_id": "be2fe53d-0ff9-37c2-870b-7f7604fae4bf",
                                                "text": "Der Winterportulak gehört nicht in die Gattung Portulak."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a86005c7-0a54-37ba-9606-49848c284978",
                                        "entry_id": "9b75ac3a-82b1-3386-b926-c8f01eadbb07",
                                        "glosses": [
                                            "eine der Arten aus der Gattung Portulaca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190f875d-6a1f-488d-aa32-7474ce57d366",
                                                "sense_id": "a86005c7-0a54-37ba-9606-49848c284978",
                                                "text": "Viele Portulake sind sukkulent."
                                            },
                                            {
                                                "example_id": "1d47899c-a7b4-4084-b5f8-4ae723f9b4ec",
                                                "sense_id": "a86005c7-0a54-37ba-9606-49848c284978",
                                                "text": "Die Portulake sind fast überall auf der Welt zu finden."
                                            },
                                            {
                                                "example_id": "1441724a-5035-4f4d-830e-1f48a1594b96",
                                                "sense_id": "a86005c7-0a54-37ba-9606-49848c284978",
                                                "text": "Der einzige Portulak, der Bedeutung in der Küche hat, ist Portulaca olearacea."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de8a1d2b-7e7f-30de-8854-2e3112a297f5",
                                        "entry_id": "9b75ac3a-82b1-3386-b926-c8f01eadbb07",
                                        "glosses": [
                                            "die Art Portulaca oleracea aus der Pflanzengattung Portulaca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20dd0c80-939f-4899-ad66-815312b774c8",
                                                "sense_id": "de8a1d2b-7e7f-30de-8854-2e3112a297f5",
                                                "text": "Portulak kann als Gemüse oder Gewürz verwendet werden."
                                            },
                                            {
                                                "example_id": "517b1e4d-cca4-49dd-ac0a-825c7d5251bb",
                                                "sense_id": "de8a1d2b-7e7f-30de-8854-2e3112a297f5",
                                                "text": "Wir kaufen im Saathaus ein Tütchen mit Samen des Portulaks, um unsere eigenen Pflanzen zu züchten."
                                            },
                                            {
                                                "example_id": "d170dc1a-8261-4eb3-8a35-e51a508e515b",
                                                "sense_id": "de8a1d2b-7e7f-30de-8854-2e3112a297f5",
                                                "text": "Aus dem geernteten Portulak wird ein schmackhafter Salat hergestellt, der viele Omega-3-Fettsäuren liefert."
                                            },
                                            {
                                                "example_id": "9aa9d56d-d832-4bfa-908f-7c6190225d8e",
                                                "sense_id": "de8a1d2b-7e7f-30de-8854-2e3112a297f5",
                                                "text": "Heutzutage wird Portulak nur noch selten verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
