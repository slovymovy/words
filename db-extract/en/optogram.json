                "senses": [
                    {
                        "sense_id": "1492fdcd-0394-3ec7-b9eb-aa48a89f3d7f",
                        "entry_id": "643d9dd3-87a2-3c57-b9ce-ae09d3dfb3d2",
                        "glosses": [
                            "An image of external objects fixed on the retina by the photochemical action of light on rhodopsi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d3556e-4324-4336-80a6-ca505fd3332b",
                                "sense_id": "1492fdcd-0394-3ec7-b9eb-aa48a89f3d7f",
                                "text": "The bleaching of visual purple is limited to the area exposed to light, so that an optogram or image of the luminous object, such as a window, can be obtained."
                            },
                            {
                                "example_id": "2e8420bd-6d5e-4bb9-9b20-b1bc9596835d",
                                "sense_id": "1492fdcd-0394-3ec7-b9eb-aa48a89f3d7f",
                                "text": "The study of optograms caught the imagination of the public as well as the scientific community. Some scientifically minded sleuths hoped that the optograms of murder victims might betray their killers!"
                            },
                            {
                                "example_id": "d239ee0e-4baa-4c0e-b97f-016376a490bc",
                                "sense_id": "1492fdcd-0394-3ec7-b9eb-aa48a89f3d7f",
                                "text": "What Dantin, Ginory, and Bernardet do not know—that is, the true facts about the killer's identity and the source of Dantin's image—will come not from the material evidence of the optogram, but from the vagaries of chance, as Bernardet's flânerie allows him to stumble on both Dantin's portrait and the true killer himself."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79a4951c-8d33-4304-ac1f-0487dfc06cc7",
                        "source_entry_id": "643d9dd3-87a2-3c57-b9ce-ae09d3dfb3d2",
                        "source_sense_id": "1492fdcd-0394-3ec7-b9eb-aa48a89f3d7f",
                        "source_sense_description": "image of external objects fixed on the retina by the photochemical action of light on the visual purple",
                        "target_lang_word": "optogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b8e2cb-e0b9-3f04-b4b0-f3563132ee73",
                                        "entry_id": "de2f2a79-e180-3911-88f4-169120682fd1",
                                        "glosses": [
                                            "Produit de l’optographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9651c6e4-d369-41e8-b3e2-e8d89a0fee44",
                                                "sense_id": "e8b8e2cb-e0b9-3f04-b4b0-f3563132ee73",
                                                "text": "L’optogramme du Docteur Bourion, présenté par le Docteur Vernois dans la revue en 1870 sous le titre Étude photographique sur la rétine des sujets assassinés, pose un problème médico-légal."
                                            },
                                            {
                                                "example_id": "2753f06c-ffca-4b5e-a413-7050a8b0f70b",
                                                "sense_id": "e8b8e2cb-e0b9-3f04-b4b0-f3563132ee73",
                                                "text": "Le savant expérimentateur [M. Kühn] a obtenu ses optogrammes même avec des yeux extirpés une heure après la mort ; avec l’oeil du boeuf on a des images trois fois plus grandes qu’avec l’oeil du lapin."
                                            }
                                        ]
                                    }
