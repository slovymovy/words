                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a251dd-e40b-4098-af55-c5e3c61889bc",
                                "sense_id": "7a91a87d-ee64-321e-93b0-b5884895c094",
                                "text": "Mais l'exil sudiste d'Alain Ducasse lui donnera-t-il une obligation de monégasquiser ses approches culinaires?"
                            },
                            {
                                "example_id": "53064abb-d381-428a-8248-77a577819cf2",
                                "sense_id": "7a91a87d-ee64-321e-93b0-b5884895c094",
                                "text": "Fin juriste, Honoré V Grimaldi demande à monégasquiser les codes napoléoniens et développe considérablement le droit monégasque."
                            },
                            {
                                "example_id": "1a4c4e45-721c-4654-9c8f-ee8bc48d3f22",
                                "sense_id": "7a91a87d-ee64-321e-93b0-b5884895c094",
                                "text": "Pas question pour le moment de « monégasquiser \" le poste de ministre d'Etat, aujourd'hui occupé par un diplomate français, Patrick Leclerc."
                            }
                        ]
                    }
