                "senses": [
                    {
                        "sense_id": "546e0258-bf0e-3e65-8f6d-ae16ca61aaaf",
                        "entry_id": "b4cccc4f-d1b4-32ca-afcc-060bd68dbff7",
                        "glosses": [
                            "ursprünglich eigenständiger Stadtstaat im präkolumbischen Mesoamerika, heute ein Stadtteil von Mexiko-Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66ae54f-f04a-40db-9ed1-957879c09c18",
                                "sense_id": "546e0258-bf0e-3e65-8f6d-ae16ca61aaaf",
                                "text": "„Ihr Altepetl hieß Tlatelolco und hatte seinen eigenen Tlatoani, da die kleinere Aussteigergruppe nicht unter der Herrschaft des Königs der Mehrheit leben und arbeiten wollte.“"
                            },
                            {
                                "example_id": "d9f54a35-f11f-4355-92d0-b1cb725120b3",
                                "sense_id": "546e0258-bf0e-3e65-8f6d-ae16ca61aaaf",
                                "text": "„Dieser herrschte seit 1502 als huey tlatoani (wörtlich ‹großer Sprecher›) der Mexica, also der Bewohner Tenochtitlans und ihrer Schwesterstadt Tlatelolco.“"
                            },
                            {
                                "example_id": "28d371bc-0186-4d87-bb3c-e15f71283381",
                                "sense_id": "546e0258-bf0e-3e65-8f6d-ae16ca61aaaf",
                                "text": "„Tlatelolco war der Tenochtitlan eng verbundene Nachbarort, beide Städte teilten sich die Insel im Texcocosee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
