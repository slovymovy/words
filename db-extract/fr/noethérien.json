                    {
                        "form_id": "ed1bfb1d-f1c3-4e4f-9e0d-98e07f318d53",
                        "entry_id": "42defebd-cc5a-392f-9147-659232f5cf67",
                        "tags": [],
                        "form": "nœthérien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                        "entry_id": "42defebd-cc5a-392f-9147-659232f5cf67",
                        "glosses": [
                            "Se dit des objets vérifiant la condition de chaîne ascendante ou descendante sur un certain type de sous-objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed05b536-34a2-4b14-8964-b661bfe99f5f",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Un anneau noethérien à gauche est un anneau dans lequel tout idéal à gauche admet un système fini de générateurs (prop. 1). Lorsqu’il sera question d’un anneau artinien (resp. noethérien) sans préciser, il sera sous-entendu qu’il s’agit d’un anneau artinien (resp. noethérien) à gauche."
                            },
                            {
                                "example_id": "0552103f-042e-4ffe-9284-06c9374de1c5",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Groupe noethérien : Groupe qui vérifie la condition de chaîne ascendante sur les sous-groupes."
                            },
                            {
                                "example_id": "f7a0d7f9-1f3d-4081-9258-9e901f747636",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Anneau noethérien : Anneau qui vérifie la condition de chaîne ascendante sur les idéaux."
                            },
                            {
                                "example_id": "563d49e5-4040-4fb3-9390-56b529b0ebfb",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Module noethérien : Module qui vérifie la condition de chaîne ascendante sur les sous-modules."
                            },
                            {
                                "example_id": "73ab9d3c-d6d2-4321-bb1e-981d38100e89",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Espace noethérien : Espace topologique qui vérifie la condition de chaîne descendante sur les fermés."
                            },
                            {
                                "example_id": "21e241de-0efd-46c7-bfdf-cc0e1d314a8f",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Récurrence noethérienne ou bien fondée."
                            },
                            {
                                "example_id": "7a434158-c7c7-4b57-a1ca-ed37b5464475",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Système de réécriture noethérien."
                            },
                            {
                                "example_id": "4f25d0b8-d0fb-45dc-8361-c23987d65e08",
                                "sense_id": "0feb0ae7-437e-3f88-8a20-bde95cb828d0",
                                "text": "Schéma noethérien."
                            }
                        ]
                    }
