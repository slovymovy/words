                "senses": [
                    {
                        "sense_id": "badae943-c375-39f2-a0cc-7222ecad5d4c",
                        "entry_id": "3a565cde-a0d3-3d7d-b0b6-51aa04e44560",
                        "glosses": [
                            "To find something again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd4622a3-9673-4c51-8b8b-dfccb791c562",
                                "sense_id": "badae943-c375-39f2-a0cc-7222ecad5d4c",
                                "text": "Cardan, in his fifth book of Wisdom, gives an instance in a smith of Milan, a fellow-citizen of his, one Galeus de Rubeis, that being commended for refinding of an instrument of Archimedes, for joy ran mad."
                            },
                            {
                                "example_id": "153ed582-4cc6-4544-bb7c-58218fdab59e",
                                "sense_id": "badae943-c375-39f2-a0cc-7222ecad5d4c",
                                "text": "I used to get your paper back in the early '80s but then you burned down and I lost touch with you. Just refound your address!"
                            },
                            {
                                "example_id": "a4480145-bf09-42fb-a2a8-fdca62f277de",
                                "sense_id": "badae943-c375-39f2-a0cc-7222ecad5d4c",
                                "text": "Clark now sees an opportunity to help Republicans refind their soul and message."
                            }
                        ]
                    }
