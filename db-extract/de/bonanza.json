                        ],
                        "form": "die Bonanza"
                    },
                    {
                        "form_id": "0f4bf00b-3ef1-4b0d-8d59-8d99da854824",
                        "entry_id": "6597f012-2d75-352c-a71f-26c418cde5c6",
                        "tags": [
                            "accusative",
