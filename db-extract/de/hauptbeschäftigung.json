                        "examples": [
                            {
                                "example_id": "81923896-59e2-4f5e-a3fe-b14a41219f87",
                                "sense_id": "1a1046d0-4fab-368c-84b5-ad7c2b7c519e",
                                "text": "„Die lärmenden Kinder in den Höfen hören auf zu schreien, stopfen sich die Finger in die Ohren und schneiden einander Grimassen, ein paar Ziegen gehen weiter ihren Verrichtungen nach, heben nur ab und zu den Kopf, um sich daraufhin, gelangweilt von dieser heulenden Welt, erneut ihrer Hauptbeschäftigung zu widmen, die darin besteht, keine giftigen Beeren zu erwischen und nur die Blätter zu kauen.“"
                            }
                        ],
