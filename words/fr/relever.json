                        "remonter"
                    ],
                    "antonyms": [
                        "baisser"
                    ],
                    "common_phrases": [
                        "relever la tête",
                        "relever ses manches",
                        "relever son col"
                    ]
                },
                {
                    "sense_id": "a819cbdc-5637-3b7c-bd7a-10635afb81a3",
                    "sense_definition": "Accepter d'affronter une difficulté, une épreuve ou une provocation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute l'équipe est prête à <w>relever</w> ce nouveau défi technologique."
                        },
                        {
                            "text": "Malgré le manque d'expérience, elle a courageusement <w>relevé</w> le gant face à ses adversaires."
