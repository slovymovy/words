                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Doctor <w>Bonjour</w> published an influential study on modern European philosophy.",
                            "target_lang_translations": {
