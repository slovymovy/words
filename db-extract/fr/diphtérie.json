        "fr-extract.jsonl": [
            {
                "entry_id": "ef7ca2dd-f756-360a-b336-ce806b98bef4",
                "word": "diphtérie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fce31b23-f877-4335-8b9c-09ba689c6ba6",
                        "entry_id": "ef7ca2dd-f756-360a-b336-ce806b98bef4",
                        "tags": [
                            "plural"
                        ],
                        "form": "diphtéries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                        "entry_id": "ef7ca2dd-f756-360a-b336-ce806b98bef4",
                        "glosses": [
                            "Maladie infectieuse et contagieuse caractérisée par la formation de fausses membranes dans la gorge."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "313f147b-0585-4626-a7f6-84e68f37bf26",
                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                "text": "Tout mon bras droit de l’épaule au poignet est enflé, dur, brûlant, couvert de pustules, j’ai une grosse fièvre… cela provient de la piqûre qu’a faite à Lili et à moi le médecin d’ici, pour nous empêcher d’attraper la diphtérie. Lili n’a rien, mais moi… j’entends dire qu’il a dû me piquer avec une aiguille pas assez propre…"
                            },
                            {
                                "example_id": "7d2e3650-0695-4c16-9edd-9fd70cdea724",
                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                "text": "La fièvre ne baissait pas, c’était la diphtérie."
                            },
                            {
                                "example_id": "6b44fe74-023b-4613-acef-269f567df4e9",
                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                "text": "Elle raconte qu'ils ont eu une autre fille que moi et qu'elle est morte de la diphtérie à six ans, avant la guerre, à Lillebonne. Elle décrit les peaux dans la gorge, l'étouffement."
                            },
                            {
                                "example_id": "b02f15b6-7d9d-4914-86be-cec6a65fb623",
                                "sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                                "text": "Nul n'a oublié … le maréchal Edme Patrice de Mac Mahon, autre dirigeant de la iiiᵉ République qui nous gratifia du plus mémorable des aphorismes politiques : « La diphtérie, on en meurt ou on en reste idiot; je le sais, je l'ai eue. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da61c7e3-a6cd-473e-97d3-c0e104b7e192",
                        "source_entry_id": "ef7ca2dd-f756-360a-b336-ce806b98bef4",
                        "source_sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
                        "target_lang_word": "Diphtherie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diphtherie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                        "entry_id": "5748b207-756e-3583-89dd-307413ee7ee6",
                                        "glosses": [
                                            "vor allem bei Kindern auftretende, häufig tödlich verlaufende Infektionskrankheit der oberen Atemorgane; hervorgerufen durch das grampositive Corynebacterium diphtheriae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79107e51-73bb-4ecd-8230-853281165684",
                                                "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                                "text": "Emil von Behring hat im Jahr 1890 ein Heilserum gegen die Diphtherie entwickelt."
                                            },
                                            {
                                                "example_id": "83b54862-e8ba-430e-b541-15cb8eaff59b",
                                                "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                                "text": "„Eines Tages brach auf dem Darß die Diphtherie aus.“"
                                            },
                                            {
                                                "example_id": "3b7113e4-2df8-42e7-895d-b81de32da444",
                                                "sense_id": "002bff04-3f7b-35ed-9052-016d3720801d",
                                                "text": "„Pocken, Grippe, Masern, Diphtherie töteten wohl 90 Prozent der indigenen Bevölkerung Nordamerikas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "000374b4-28bf-46a4-aa7d-94c5c825a48b",
                        "source_entry_id": "ef7ca2dd-f756-360a-b336-ce806b98bef4",
                        "source_sense_id": "eef04432-ae40-33ed-aac8-01b909bc15f5",
