                ],
                "senses": [
                    {
                        "sense_id": "6f03f54b-aa7f-3253-bb4a-8290fae070f3",
                        "entry_id": "0773875f-4977-301f-9e34-f0dd28c3e234",
                        "glosses": [
                            "République autoproclamée de Transcaucasie ou région séparatiste d’Azerbaïdjan ayant existé de 1991 à 2023."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0b47f3-6514-4e10-bbf4-bf94aa4cab2c",
                                "sense_id": "6f03f54b-aa7f-3253-bb4a-8290fae070f3",
                                "text": "Une analyse des menaces pesant sur le patrimoine arménien, dans le Haut-Karabakh et en Azerbaïdjan, dans un contexte de néo-impérialisme panturquiste et de guerre froide entre l'Occident et la Russie."
                            },
                            {
                                "example_id": "35469e90-0612-454b-916e-2bea77201f02",
                                "sense_id": "6f03f54b-aa7f-3253-bb4a-8290fae070f3",
                                "text": "Le Haut-Karabakh, théâtre de deux guerres entre l’Arménie et l’Azerbaïdjan, au début des années 1990 puis à l’automne 2020, est l’une des régions les plus minées d’ex-URSS."
                            },
                            {
                                "example_id": "2784f9bf-1b20-4d12-9547-30d3112262ce",
                                "sense_id": "6f03f54b-aa7f-3253-bb4a-8290fae070f3",
                                "text": "Ces habitants du Haut-Karabakh fuient la zone après l’offensive de l’Azerbaïdjan, mardi dernier."
                            }
                        ]
                    }
                ],
                "translations": [
