                        "glosses": [
                            "Donner un caractère de festival à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "689281b7-7e90-47ea-81d8-3afc8e606ce1",
                                "sense_id": "159c3abf-dc6e-3dea-a750-45a6b8eedf85",
                                "text": "La Mirondela del Arts apparait pour festivaliser l'été."
                            },
                            {
                                "example_id": "1b5ff028-e6e0-49d9-951c-9f9db7d64ac7",
                                "sense_id": "159c3abf-dc6e-3dea-a750-45a6b8eedf85",
                                "text": "La Techno Parade a décidé de se « festivaliser » en lançant la troisième édition de la Paris Electronic Week."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a7dbee2-20f9-3893-b873-707931286373",
                        "entry_id": "46ce76f9-0900-34d8-b572-510db91f5372",
                        "glosses": [
                            "Participer à des festivals."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e989a5c0-2b42-48fc-b5f0-b3c4e7deebf7",
                                "sense_id": "2a7dbee2-20f9-3893-b873-707931286373",
                                "text": "Et du coup, je pars sur les routes pour librairiser et festivaliser un peu."
                            },
                            {
                                "example_id": "fa3840ff-1eb7-447a-bfdd-33a929bb40cd",
                                "sense_id": "2a7dbee2-20f9-3893-b873-707931286373",
                                "text": "C'est l'été ! on va « festivaliser »"
                            }
                        ]
