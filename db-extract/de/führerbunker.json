                "senses": [
                    {
                        "sense_id": "722f30a9-f1e3-363e-909c-3913f8785365",
                        "entry_id": "6e68196b-f04b-3f55-aa5b-3e316776ef0e",
                        "glosses": [
                            "Bunker des Führers (Adolf Hitler)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624965ee-91f5-4eb5-b4c8-a5662e7113a0",
                                "sense_id": "722f30a9-f1e3-363e-909c-3913f8785365",
                                "text": "„Zwei Sunden nach Mitternacht traf er im Führerbunker ein.“"
                            },
                            {
                                "example_id": "cab94676-65dd-47a5-8289-cb3ad30a915d",
                                "sense_id": "722f30a9-f1e3-363e-909c-3913f8785365",
                                "text": "„Ende 1942 aber ist der Scheitelpunkt des Zweiten Weltkrieges erreicht, es beginnt der lange deutsche Rückzug, der erst im April 1945 wenige Meter vor dem Führerbunker in Berlin enden wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
