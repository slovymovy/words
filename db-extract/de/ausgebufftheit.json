                "senses": [
                    {
                        "sense_id": "14a0066c-0a84-34c2-8092-3246b0e49c61",
                        "entry_id": "eb73651b-48d7-3ff0-a49a-95fc3a989f0c",
                        "glosses": [
                            "geschickte, taktische Raffinesse; schlaue, oft mit List oder Manipulation verbundene Vorgehensweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0288ee-bbb1-42a4-b288-92234b7d6e08",
                                "sense_id": "14a0066c-0a84-34c2-8092-3246b0e49c61",
                                "text": "Seither lässt seine Übermittlungsform in jeder Zeile gleichzeitig Coolness, zentnerschwere Lebenserfahrung und Ausgebufftheit mitschwingen."
                            },
                            {
                                "example_id": "28399bdf-a969-430e-9453-7d8b86af11d7",
                                "sense_id": "14a0066c-0a84-34c2-8092-3246b0e49c61",
                                "text": "Den Eltern ist bewusst, dass Geschwindigkeit, Excitement, Ausgebufftheit und Verschlagenheit Kinder faszinieren."
                            },
                            {
                                "example_id": "fb625833-380c-46a1-8c11-85d2491edae9",
                                "sense_id": "14a0066c-0a84-34c2-8092-3246b0e49c61",
                                "text": "„Macht“ dagegen ist ein Muster an Ausgebufftheit, erschnüffelt Trends an den krassesten Orten und verkauft sie brühwarm an den Markt."
                            },
                            {
                                "example_id": "4ae61497-0e1b-4e57-b9bd-51f88d653d1a",
                                "sense_id": "14a0066c-0a84-34c2-8092-3246b0e49c61",
                                "text": "Aber von Stoiber ist bekannt, dass ihn die Ausgebufftheit Schröders beeindruckte und ihm auch ein Stück weit unheimlich war."
                            },
                            {
                                "example_id": "66334222-b313-401b-8ad4-e3a6e6fc8209",
                                "sense_id": "14a0066c-0a84-34c2-8092-3246b0e49c61",
                                "text": "Schlauer wurden die Ausgebufftheit und Tristesse der Neuen Deutschen Welle nie kommentiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26a6125e-b701-4613-aed3-eaa6079694f8",
                        "source_entry_id": "eb73651b-48d7-3ff0-a49a-95fc3a989f0c",
