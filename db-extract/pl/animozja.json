                    {
                        "translation_id": "ec67c722-3302-4dea-bf00-f87226688b77",
                        "source_entry_id": "ec23148f-2417-3aac-ae51-d89bf885b52d",
                        "source_sense_id": "162e94c1-9dd4-3837-9be9-6b9b275c01f1",
