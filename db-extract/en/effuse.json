                                        "entry_id": "e12a8fe1-4677-3b81-ad59-8d0364f888f4",
                                        "glosses": [
                                            "jemandem, der geht, etwas übergeben (meist zu einem bestimmten Zweck)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c05fd510-c2fc-4859-a670-1046c5da4251",
                                                "sense_id": "b197c3ac-c0ce-3bc8-98d1-b64011185c21",
                                                "text": "Da er gleich zur Post fuhr, konnten wir ihm unser Paket mitgeben."
                                            },
                                            {
                                                "example_id": "c2a060df-79bd-484c-80dd-01eef0e971e4",
                                                "sense_id": "b197c3ac-c0ce-3bc8-98d1-b64011185c21",
                                                "text": "Dass Mütter ihren Kindern immer etwas zu Essen mitgeben müssen - egal wie alt diese sind - ist schon erstaunlich."
                                            },
                                            {
                                                "example_id": "f23de662-be81-43e0-b630-cd7cabdb86f6",
                                                "sense_id": "b197c3ac-c0ce-3bc8-98d1-b64011185c21",
                                                "text": "Lassen Sie mich Ihnen einen guten Rat auf den Weg mitgeben!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
