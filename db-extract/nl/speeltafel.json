                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d60058a-4818-46d5-970b-1c5fc1c98dd0",
                                                "sense_id": "7dc79659-b5fa-3e15-a122-40c31206b12f",
                                                "text": "The operating console of the new Glasgow Central cabin is divided into four sections, each at an angle to each other and each of which is normally under one signalman's control; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56b48b9-faad-3eaf-bfd2-0197ac46e7cd",
