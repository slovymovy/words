                    {
                        "translation_id": "0c627008-4bfd-44a9-87f5-f5f92e158c37",
                        "source_entry_id": "ad1c1d06-3ff6-3e6f-8b18-f7339c89f346",
                        "source_sense_description": "in a fabulous manner",
                        "target_lang_word": "потряса́юще",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "потряса́юще",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "314afe88-6c12-3b77-98bf-cea77a1c8c49",
                                        "entry_id": "041ae16f-efdc-3f15-9538-576059658294",
                                        "glosses": [
                                            "наречие к потрясающий; производя сильное впечатление, вызывая сильные переживания"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53260580-8c3c-49b5-903b-ee14345398dc",
                                                "sense_id": "314afe88-6c12-3b77-98bf-cea77a1c8c49",
                                                "text": "Когда Магомету было сорок лет, он имел первое божественное откровение, подействовавшее на него крайне потрясающе и бросившее его роковым образом на служение Богу."
                                            },
                                            {
                                                "example_id": "57abd252-cb69-4fa6-8d44-a7d819f8daa6",
                                                "sense_id": "314afe88-6c12-3b77-98bf-cea77a1c8c49",
                                                "text": "Немая, высохшая мать едва передвигала ноги, глядя на всё страшными глазами. брат был золотушный, с язвами на щиколотках, и такой слабенький, что даже плакать громко не мог, а только стонал потрясающе, если был голоден, сытый же дремал и сквозь дрёму как-то странно вздыхал, мурлыкал тихонько, точно котёнок."
                                            },
                                            {
                                                "example_id": "4a36269d-2c0c-4231-81bc-33a3a90bffaf",
                                                "sense_id": "314afe88-6c12-3b77-98bf-cea77a1c8c49",
                                                "text": "Все эти цифры наших потерь давно были нам известны, но теперь, среди моря, на виду печального для нас острова Цусима, действовали на всех слушателей потрясающе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57594130-7948-3981-ac44-1351999981c1",
                                        "entry_id": "041ae16f-efdc-3f15-9538-576059658294",
                                        "glosses": [
                                            "вызывая сотрясение; сотрясая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb00afb-c972-4786-a388-cb6a4a171647",
                                                "sense_id": "57594130-7948-3981-ac44-1351999981c1",
                                                "text": "Целый день за невидимой теперь рекой, из-за сереющих казацких окопов, потрясающе ухали орудия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11b711ee-ac2a-33fd-b5c0-a7207bfaf3f3",
                                        "entry_id": "041ae16f-efdc-3f15-9538-576059658294",
                                        "glosses": [
                                            "разг. в большой степени, удивительно, очень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33683263-9d26-45f0-89fe-32dad9c250fe",
                                                "sense_id": "11b711ee-ac2a-33fd-b5c0-a7207bfaf3f3",
                                                "text": "За этими дверями мрачные, потрясающе мрачные темничные кельи."
                                            },
                                            {
                                                "example_id": "86064d37-696e-4a0a-b5d4-812f2080d2e6",
                                                "sense_id": "11b711ee-ac2a-33fd-b5c0-a7207bfaf3f3",
                                                "text": "И Митя очнулся, весь в поту, с потрясающе ясным сознанием, что он погиб, что в мире так чудовищно безнадежно и мрачно, как не может быть и в преисподней, за могилой."
                                            },
                                            {
                                                "example_id": "0dcfce25-30a1-416e-bc03-c95b9fbe2a40",
                                                "sense_id": "11b711ee-ac2a-33fd-b5c0-a7207bfaf3f3",
                                                "text": "Как потрясающе быстро все сдались, пали духом!"
                                            },
                                            {
                                                "example_id": "dd895d00-765e-4398-97c3-0641f874f844",
                                                "sense_id": "11b711ee-ac2a-33fd-b5c0-a7207bfaf3f3",
                                                "text": "Ищенко был потрясающе спокоен."
                                            },
                                            {
                                                "example_id": "17b01d22-eb5f-4c21-a6d5-12a5979a044b",
                                                "sense_id": "11b711ee-ac2a-33fd-b5c0-a7207bfaf3f3",
                                                "text": "Марта, радость моя, ты потрясающе элегантна!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa86b12-2415-3cc5-a4f4-e9a5ffe0f185",
                                        "entry_id": "041ae16f-efdc-3f15-9538-576059658294",
                                        "glosses": [
                                            "разг. прекрасно, великолепно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b900158-6eb9-45e3-94cf-31090198f591",
                                                "sense_id": "cfa86b12-2415-3cc5-a4f4-e9a5ffe0f185",
                                                "text": "— Гелла, садись, — приказал Воланд и объяснил Маргарите: — Ночь полнолуния — праздничная ночь, и я ужинаю в тесной компании приближенных и слуг. Итак, как чувствуете вы себя? Как прошёл этот утомительный бал? — Потрясающе! — затрещал Коровьев, — все очарованы, влюблены, раздавлены, сколько такта, сколько умения, обаяния и шарма!"
                                            },
                                            {
                                                "example_id": "374991c0-dcf1-492f-89b3-042299ee91ca",
                                                "sense_id": "cfa86b12-2415-3cc5-a4f4-e9a5ffe0f185",
                                                "text": "— О! Ты потрясающе сегодня выглядишь, — сделал он ей комплимент и чмокнул в щеку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4187a99f-ea7c-3b04-be2d-644744ada6a3",
                                        "entry_id": "041ae16f-efdc-3f15-9538-576059658294",
                                        "glosses": [
                                            "разг. обалдеть!, ничего себе!, здо́рово!, вау!"
                                        ],
                                        "tags": [
                                            "межд."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f053f4ca-f389-4328-8487-48f9e9013d91",
                                                "sense_id": "4187a99f-ea7c-3b04-be2d-644744ada6a3",
                                                "text": "— А к Новому году он обещал мне «мерседес». — Потрясающе!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
