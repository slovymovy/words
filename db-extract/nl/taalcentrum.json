                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94555c27-3ea8-4cbf-9c4c-bc7dcc617069",
                                "sense_id": "fde80483-832b-32fb-a3c0-2cd001254bf8",
                                "text": "Tot slot willen we het nog hebben over een vreemd proces dat zich voordoet wanneer de taalcentra in je hersenen al op jonge leeftijd beschadigd raken. Onze hersenen zijn ongelooflijk kneedbaar. Wanneer je linkerhersenhelft beschadigd raakt, kan het namelijk zijn dat je taalvermogen zich in je rechterhersenhelft gaat ontwikkelen."
                            }
