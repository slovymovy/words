                ],
                "senses": [
                    {
                        "sense_id": "bd2eb07f-04ac-39e4-bfac-e63bc5bcceab",
                        "entry_id": "01e01a11-a79e-3963-afc6-4329e80f44b4",
                        "glosses": [
                            "iets wat ontstaan is door het drukken van een voorwerp in of op een ander voorwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e29810a-16b7-44b0-be2d-34a5c63cac57",
                                "sense_id": "bd2eb07f-04ac-39e4-bfac-e63bc5bcceab",
                                "text": "Die wet van God, het juiste afdruksel van Zijn heilige wil, is ook geestelijk. Zij strekt zich niet alleen uit tot het uitwendige, maar zij is ook geestelijk. De mens is verplicht tot inwendige gehoorzaamheid."
                            },
                            {
                                "example_id": "6427e035-8cc5-4319-9cf4-157e878da04c",
                                "sense_id": "bd2eb07f-04ac-39e4-bfac-e63bc5bcceab",
                                "text": "Toen Claes Oldenburg in de jaren zestig zijn slappe sculpturen maakte – en daar doet The Membrane onvermijdelijk aan denken was dit een radicaal en ondermijnend statement tegen alles waar beeldhouwkunst tot op dat moment voor stond: stabiliteit, duurzaamheid, monumentaliteit, plasticiteit, etc. Hetzelfde, nog sterker en subversiever, gold voor de zachte afdruksels in was van Bruce Nauman uit dezelfde periode."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c954a79-958d-4f0a-b695-4abaecf6f4d6",
                        "source_entry_id": "01e01a11-a79e-3963-afc6-4329e80f44b4",
                        "source_sense_id": "bd2eb07f-04ac-39e4-bfac-e63bc5bcceab",
                        "target_lang_word": "print",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "print",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf0efe25-08ed-3a53-a148-987ef5f50963",
                                        "entry_id": "16a07c43-aecb-3db8-ba66-057f05425a76",
                                        "glosses": [
                                            "Of, relating to, or writing for printed publications."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb7e54b-8a8e-46d3-afff-0ba8d7728f8a",
                                                "sense_id": "cf0efe25-08ed-3a53-a148-987ef5f50963",
                                                "text": "a print edition of a book"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "print",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62234b71-b679-32b3-a3b0-453ed12b0c0e",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To produce one or more copies of a text or image on a surface, especially by machine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bde6ac7-c482-4956-8024-0020e99c1e84",
                                                "sense_id": "62234b71-b679-32b3-a3b0-453ed12b0c0e",
                                                "text": "Print the draft double-spaced so we can mark changes between the lines."
                                            },
                                            {
                                                "example_id": "aa979f6b-b221-4882-917b-626e440b5e91",
                                                "sense_id": "62234b71-b679-32b3-a3b0-453ed12b0c0e",
                                                "text": "Two years on, and while the Sultan of Slowjamastan has instigated more than a few bizarre laws (he’s outlawed the wearing of Crocs, for example), the Republic also has all the trappings of a fledgling nation-state. It issues its own passports, flies its own flag, prints its own currency (“the duble”), and has a national anthem that’s played on state occasions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f0283ff-f695-34b0-b421-533c90e50277",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To produce a microchip (an integrated circuit) in a process resembling the printing of an image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84740cce-fdd2-438c-ae14-d87c407a90f6",
                                                "sense_id": "9f0283ff-f695-34b0-b421-533c90e50277",
                                                "text": "The circuitry is printed onto the semiconductor surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155a1f08-a378-3fa4-9882-ce2b08f81ecf",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To write very clearly, especially, to write without connecting the letters as in cursive."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4f0f81-bd35-4fa8-b2c8-804335f430e9",
                                                "sense_id": "155a1f08-a378-3fa4-9882-ce2b08f81ecf",
                                                "text": "Print your name here and sign below."
                                            },
                                            {
                                                "example_id": "8e51edd0-e754-4439-bdc4-e5eeea94b660",
                                                "sense_id": "155a1f08-a378-3fa4-9882-ce2b08f81ecf",
                                                "text": "I'm only in grade 2, so I only know how to print."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f24f12-1629-3067-8ce1-5352a995da5a",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To publish in a book, newspaper, etc."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc83d908-30d6-4e54-a7bf-a0ec3f256d8d",
                                                "sense_id": "73f24f12-1629-3067-8ce1-5352a995da5a",
                                                "text": "How could they print an unfounded rumour like that?"
                                            },
                                            {
                                                "example_id": "d3aea25d-e814-4114-b9b3-bd2ef3fb5c6e",
                                                "sense_id": "73f24f12-1629-3067-8ce1-5352a995da5a",
                                                "text": "From the moment he prints, he must expect to hear no more truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91301647-ab91-3e6d-8c40-2bb149ad1ee3",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To stamp or impress (something) with coloured figures or patterns."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa939df4-9118-4943-b9a5-91e057ef9df9",
                                                "sense_id": "91301647-ab91-3e6d-8c40-2bb149ad1ee3",
                                                "text": "to print calico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c97ccbfb-accf-3fbd-9552-a02d7afda26b",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To fix or impress, as a stamp, mark, character, idea, etc., into or upon something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf286d6-ca74-4993-90f4-db6c5f67a060",
                                                "sense_id": "c97ccbfb-accf-3fbd-9552-a02d7afda26b",
                                                "text": "A look will print a thought that never may remove."
                                            },
                                            {
                                                "example_id": "3df95809-af02-43db-8611-8b2a56c3e2cf",
                                                "sense_id": "c97ccbfb-accf-3fbd-9552-a02d7afda26b",
                                                "text": "Upon his breastplate he beholds a dint, / Which in that field young Edward's sword did print."
                                            },
                                            {
                                                "example_id": "e9847537-8797-467d-9645-c31d535ff8de",
                                                "sense_id": "c97ccbfb-accf-3fbd-9552-a02d7afda26b",
                                                "text": "some footsteps printed in the clay"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ca754b4-0eee-3be4-8839-a740a515fd8b",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To stamp something in or upon; to make an impression or mark upon by pressure, or as by pressure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa298770-90bb-4311-9a97-785fdce4b990",
                                                "sense_id": "7ca754b4-0eee-3be4-8839-a740a515fd8b",
                                                "text": "Forth on his fiery steed betimes he rode, / That scarcely prints the turf on which he trod."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc018ea-051c-3731-9a18-0716706f87a5",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To inadequately conceal a weapon such that its outline or imprint is visible on the person wearing it."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b3e086-c651-3d62-ada4-854a4c819fee",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To display a string on the terminal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f0da1dd-b6f9-423a-b458-5e3ace2430ea",
                                                "sense_id": "54b3e086-c651-3d62-ada4-854a4c819fee",
                                                "text": "However, when you print the string you can see only 11 characters (c, a, r, ', s,, w, h, e, e, l)."
                                            },
                                            {
                                                "example_id": "b5c4c423-ab33-4f69-9d5b-a4ced1aadd16",
                                                "sense_id": "54b3e086-c651-3d62-ada4-854a4c819fee",
                                                "text": "On the RHS side we write the current date to the variable date and print it to the terminal window, followed by the string \"Chris coming home....\" ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192843a4-48cb-3739-92fa-c366ae064cdc",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To produce an observable value."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa42fbe-63a8-453a-b27d-4d261742a9cd",
                                                "sense_id": "192843a4-48cb-3739-92fa-c366ae064cdc",
                                                "text": "On March 16, 2020, the S&P printed at 2,386.13, one of the worst drops in history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c10411-1567-396e-88d4-fb982637d45b",
                                        "entry_id": "9931a3f6-5fae-3dbe-ab62-a189b146584d",
                                        "glosses": [
                                            "To fingerprint (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f3af6e-9d65-4679-8b63-209c7fdb1c77",
                                                "sense_id": "d2c10411-1567-396e-88d4-fb982637d45b",
                                                "text": "Maybe we'll get lucky; maybe he was printed for some minor infraction in some backwater town."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "print",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d3b7186-6e12-3736-a817-e568ae93b145",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "Books and other material created by printing presses, considered collectively or as a medium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3cd1e0-f0f9-4b0d-96cc-58db0ee7f055",
                                                "sense_id": "8d3b7186-6e12-3736-a817-e568ae93b145",
                                                "text": "Three citations are required for each meaning, including one in print."
                                            },
                                            {
                                                "example_id": "e8f2aff7-3187-486f-baeb-7119cbc1efeb",
                                                "sense_id": "8d3b7186-6e12-3736-a817-e568ae93b145",
                                                "text": "TV and the Internet haven't killed print."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e986f29-2d91-3af6-9022-afe4aa6d74a3",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "Clear handwriting, especially, writing without connected letters as in cursive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98d590f-40b6-4d8d-b81f-209d071410fb",
                                                "sense_id": "1e986f29-2d91-3af6-9022-afe4aa6d74a3",
                                                "text": "Write in print using block letters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f436596-8217-3b0a-a5f3-224d79f7fcba",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "The letters forming the text of a document."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e40958ae-0cc8-4dc1-af7d-b4e50f3d6d83",
                                                "sense_id": "6f436596-8217-3b0a-a5f3-224d79f7fcba",
                                                "text": "The print is too small for me to read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f48b861-9a62-3725-978f-cd0a0be37bbb",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A newspaper."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e124af75-735f-440d-a4d4-26f6617d0a81",
                                                "sense_id": "5f48b861-9a62-3725-978f-cd0a0be37bbb",
                                                "text": "I spent my second quarter-century\nLosing what I had learnt at university\nAnd refusing to take in what had happened since.\nNow I know none of the names in the public prints […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f9a0cd-9496-3b65-ac25-f2768591ffdd",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A visible impression on a surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "627c0333-dd78-4115-851f-dc888437682d",
                                                "sense_id": "08f9a0cd-9496-3b65-ac25-f2768591ffdd",
                                                "text": "Using a crayon, the girl made a print of the leaf under the page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90584e58-062a-3dc8-a904-d5baf45e71e8",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A fingerprint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3786b0-c939-45df-a84a-ec56d9f470f8",
                                                "sense_id": "90584e58-062a-3dc8-a904-d5baf45e71e8",
                                                "text": "Did the police find any prints at the scene?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00dcabf1-9bdd-3aa5-b97c-5d8dcc875f6b",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A footprint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "672da36b-7ec7-3568-afab-2058bc37d3e0",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A picture that was created in multiple copies by printing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b3caa8-0926-40bb-8000-b5dd417e93cf",
                                                "sense_id": "672da36b-7ec7-3568-afab-2058bc37d3e0",
                                                "text": "An old print was discovered some time ago in an arch at Waterloo Dock Goods Station[,] Liverpool, in use as a backing on which to write time sheets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c901f9c9-ea61-312c-95e4-e577036ff814",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A photograph that has been printed onto paper from the negative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08f94ef1-07d0-3bbe-be5d-708b68b8163e",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A copy of a film that can be projected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50cb59c1-5344-36ea-aaf1-d3afeca5c26b",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "Cloth that has had a pattern of dye printed onto it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67bf3eb1-c731-43e5-bec1-db2f1f6607b3",
                                                "sense_id": "50cb59c1-5344-36ea-aaf1-d3afeca5c26b",
                                                "text": "The poor are very unreasonable; a kind look and word often go farther in winning upon their affection than even a piece of coarse flannel, or a remnant of dark print."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42b71219-43f1-333c-84d1-ec680ae88d3f",
                                        "entry_id": "2e087e4d-a751-3e34-a883-e09c98e97a69",
                                        "glosses": [
                                            "A plaster cast in bas relief."
                                        ],
