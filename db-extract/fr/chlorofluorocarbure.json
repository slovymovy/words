                                        "sense_id": "a64c922a-2cad-352b-9604-57fc8c88d488",
                                        "entry_id": "e938c979-be2e-3f96-8ddf-49ea83d62051",
                                        "glosses": [
                                            "Initialism of chlorofluorocarbon, a class of molecules containing chlorine, fluorine and carbon atoms."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ad742b-d59c-42b1-ad38-4c994e24dc23",
                                                "sense_id": "a64c922a-2cad-352b-9604-57fc8c88d488",
                                                "text": "Potential replacements for the chlorofluorocarbon (CFC) chemicals now extensively used as refrigerants, propellants, bubbles in plastic and cleaning fluids have already been identified."
                                            },
                                            {
                                                "example_id": "3de0f835-0249-4daa-aea1-5c0da2ddfd48",
                                                "sense_id": "a64c922a-2cad-352b-9604-57fc8c88d488",
                                                "text": "Contrary to his assertion, however, virtually all relevant researchers say the link between CFCs and ozone depletion is based on unassailably solid scientific evidence."
                                            }
                                        ]
                                    },
