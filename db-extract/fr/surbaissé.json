                ],
                "senses": [
                    {
                        "sense_id": "882d9313-32a4-3dfe-ad04-5b588850713a",
                        "entry_id": "d8a5d212-370d-3ca9-ac0c-091aae8397d5",
                        "glosses": [
                            "Qualifie les arcades ou les voûtes qui ne sont pas en plein cintre et dont la montée est moindre que la moitié de leur ouverture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "481ea05b-5260-4243-81d4-e4cbaaa952a8",
                                "sense_id": "882d9313-32a4-3dfe-ad04-5b588850713a",
                                "text": "Une voûte surbaissée, un arc brisé surbaissé."
                            },
                            {
                                "example_id": "ac51d319-589a-4717-b974-1b4b35ffbf7a",
                                "sense_id": "882d9313-32a4-3dfe-ad04-5b588850713a",
                                "text": "… les lourds cintres surbaissés de M. de Brosse, ce gauche architecte du portail Saint-Gervais, voilà pour l’art."
                            },
                            {
                                "example_id": "75c9a454-40aa-4197-a86f-8763369bd675",
                                "sense_id": "882d9313-32a4-3dfe-ad04-5b588850713a",
                                "text": "Le blason de Tolède, cinq étoiles de sable sur champ d’argent, est répété en plusieurs endroits de cette chapelle à voûte surbaissée, fermée à la mode espagnole par une grille d’un beau travail."
                            },
                            {
                                "example_id": "88552509-7ca7-4513-b912-bf35cae33122",
                                "sense_id": "882d9313-32a4-3dfe-ad04-5b588850713a",
                                "text": "Les jours étaient gris : un peu de lumière filtrait par la fenêtre étroite, dont le cintre était surbaissé à l’ancienne mode."
                            },
                            {
                                "example_id": "07f7b8a4-d1e7-491b-91ce-4b1a08b4594c",
                                "sense_id": "882d9313-32a4-3dfe-ad04-5b588850713a",
                                "text": "J’éprouverais, je crois, les mêmes joies qu’autrefois et les mêmes terreurs à suivre les longs couloirs aux plafonds surbaissés, et à relire au-dessus des portes qu’un bras d’enfant fait mouvoir avec peine les préceptes en lettres gothiques, tirés des livres des Psaumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "555a95e3-df5c-3e77-abe2-bccff70802ef",
                        "entry_id": "d8a5d212-370d-3ca9-ac0c-091aae8397d5",
                        "glosses": [
                            "faible garde au sol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9c7ec7-3e8b-4b95-b583-19e934c3ca32",
                                "sense_id": "555a95e3-df5c-3e77-abe2-bccff70802ef",
                                "text": "En effet, les caractéristiques du convoi exceptionnel, notamment s’il est surbaissé, peuvent rendre le franchissement du passage à niveau compliqué et très lent."
                            },
                            {
                                "example_id": "6bbe98e0-225f-4156-abba-9ff112327d3e",
                                "sense_id": "555a95e3-df5c-3e77-abe2-bccff70802ef",
                                "text": "Cette signalisation indique la présence d’un passage à niveau à franchissement difficile pour les véhicules surbaissés."
                            }
                        ]
                    }
                ],
