                                ]
                            },
                            {
                                "target_word": "verdwijnend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3dd371-1968-3a9e-b7b0-e5a0214d6378",
                                        "entry_id": "86fbf6d4-76c4-3939-90e3-8b62ae9b29ef",
                                        "glosses": [
                                            "bezig met ophouden te bestaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15ad86e-d5c0-48e4-8c17-084b26016095",
                                                "sense_id": "fa3dd371-1968-3a9e-b7b0-e5a0214d6378",
                                                "text": "'Croiset speelt een koningsrol,' aldus de jury. 'Tot op de millimeter perfect geacteerd, toont hij vol overtuiging zijn geweldige vakmanschap. Lichtvoetig neemt hij de toeschouwers mee in de wereld van hellende waarheden en verdwijnende realiteiten waar een dementerende oudere in verzeild kan raken.'"
                                            },
                                            {
                                                "example_id": "bac5781d-27ab-477e-a527-e7ee3a677476",
                                                "sense_id": "fa3dd371-1968-3a9e-b7b0-e5a0214d6378",
                                                "text": "Volgens Wolter Odding, lid van de Raad van Bestuur, zal meer dan de helft van de verdwijnende banen in management en ondersteunende functies zijn. “We proberen onze organisatie zo efficiënt mogelijk in te richten. Dan kun je ook met minder management en minder ondersteuning toe.”"
                                            },
                                            {
                                                "example_id": "d0af6e27-3edf-4911-9a35-807fdda85d29",
                                                "sense_id": "fa3dd371-1968-3a9e-b7b0-e5a0214d6378",
                                                "text": "Het aantal verschijnende en verdwijnende kramen houdt elkaar redelijk in evenwicht; al jaren staan er ongeveer 11.000 ondernemers op de markt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
