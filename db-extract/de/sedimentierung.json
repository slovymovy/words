                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b61ba96-45d8-40b9-940d-18cf80e88c5a",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "A crocodile deposits her eggs in the sand."
                                            },
                                            {
                                                "example_id": "be6e8faf-cb17-469c-9c6d-220a05242edf",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "The waters deposited a rich alluvium."
                                            },
                                            {
                                                "example_id": "a7f0f355-5ba2-4631-9f95-59f86e72a473",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "This fear is deposited in conscience."
                                            },
                                            {
                                                "example_id": "b0fcac50-3ecf-4150-b739-c5df637db3d6",
                                                "sense_id": "4c2c7c9e-240e-3736-8695-eb1c3f14b4a2",
                                                "text": "The lights of Luluabourg disappeared, and we were in the blackness of the African night, which was continuously pierced by the showers of red sparks ejected skywards and red hot ashes deposited on the track as the fireman rocked his fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f94cdbb-64ae-3abc-a821-1aebb3c3a908",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To lay up or away for safekeeping; to put up; to store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97548636-08fd-4c30-aa20-a4520e56cb77",
                                                "sense_id": "1f94cdbb-64ae-3abc-a821-1aebb3c3a908",
                                                "text": "to deposit goods in a warehouse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14e0346-95ea-3eb4-a006-59ce4703384e",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To entrust one's assets to the care of another. Sometimes done as collateral."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2696d276-071b-335e-8b98-7e72d686bb32",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To put money or funds into an account."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3192222a-f412-453c-a024-7d49368ce40f",
                                                "sense_id": "2696d276-071b-335e-8b98-7e72d686bb32",
                                                "text": "I had to deposit two months' rent into my landlord's account before he gave me the keys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b701d749-9629-3bb7-a944-5e87b5716dd2",
                                        "entry_id": "588047e9-78a5-3fe6-bf32-4ea80cc07ae7",
                                        "glosses": [
                                            "To lay aside; to rid oneself of."
                                        ],
                                        "tags": [],
                                        "examples": [
