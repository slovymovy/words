                    {
                        "form_id": "0d676001-d5a1-4f33-a001-4bc281cdaa38",
                        "entry_id": "a3b9a5a4-3925-35b8-9154-df73137f4c34",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Damoklesschwerter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e5785a5-dbbe-3ba1-a842-1beb96d8d6dd",
                        "entry_id": "a3b9a5a4-3925-35b8-9154-df73137f4c34",
                        "glosses": [
                            "eine drohende unabwendbare Gefahr, gegen die der Betreffende zum jeweiligen Zeitpunkt machtlos ist"
                        ],
                        "tags": [
                            "metaphorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "eae56b5f-9f9f-4887-9e41-38689fc9006a",
                                "sense_id": "2e5785a5-dbbe-3ba1-a842-1beb96d8d6dd",
                                "text": "„Im zweiten Halbjahr 1945 war dies noch nicht abzusehen; die Entnazifizierung hing wie ein Damoklesschwert über vielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b49ce08c-28c4-43d5-b891-d032b588c3d3",
                        "source_entry_id": "a3b9a5a4-3925-35b8-9154-df73137f4c34",
                        "source_sense_id": "2e5785a5-dbbe-3ba1-a842-1beb96d8d6dd",
                        "source_sense_description": "eine drohende unabwendbare Gefahr, gegen die der Betreffende zum jeweiligen Zeitpunkt machtlos ist",
                        "target_lang_word": "sword of Damocles",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sword of Damocles",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10fe478f-8fd6-351e-9beb-5a8a4ddc140b",
                                        "entry_id": "f8decaeb-348b-348c-aca2-6f1e579e08c6",
                                        "glosses": [
                                            "A thing or situation which causes a prolonged state of impending doom or misfortune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639bf909-41d5-4303-be57-617d9f95098e",
                                                "sense_id": "10fe478f-8fd6-351e-9beb-5a8a4ddc140b",
                                                "text": "Every man, woman and child lives under a nuclear sword of Damocles hanging by the slenderest of threads, capable of being cut at any moment by accident, or miscalculation or by madness. The weapons of war must be abolished before they abolish us."
                                            },
                                            {
                                                "example_id": "72848b78-e32f-4182-a362-d3d8d11f655c",
                                                "sense_id": "10fe478f-8fd6-351e-9beb-5a8a4ddc140b",
                                                "text": "At some point the Sword of Damocles which hangs over all our railway operations will fall with catastrophic impact, just as it did at Hatfield in 2000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e39dc205-b8f8-494d-a239-6733b117a0db",
                        "source_entry_id": "a3b9a5a4-3925-35b8-9154-df73137f4c34",
                        "source_sense_id": "2e5785a5-dbbe-3ba1-a842-1beb96d8d6dd",
                        "source_sense_description": "eine drohende unabwendbare Gefahr, gegen die der Betreffende zum jeweiligen Zeitpunkt machtlos ist",
                        "target_lang_word": "épée de Damoclès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épée de Damoclès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                        "entry_id": "a1c39b63-8866-3207-a55d-321e2dfa1dcc",
                                        "glosses": [
                                            "Danger susceptible de se produire d’un instant à l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee379321-3c2f-4136-a5e5-736220949ce9",
                                                "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                                "text": "Je me demande comment tant de jeunes filles osent encore faire l’amour avec cette terreur, cette épée de Damoclès sur leur ventre ? Sont-elles héroïques ou inconscientes ?"
                                            },
                                            {
                                                "example_id": "322f78dd-5130-4d5b-a091-94d2c1cec213",
                                                "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                                "text": "La science le permet enfin ! Car la nouveauté de ce temps « hiroshimesque » est que l'humanité est capable de suicide par désespoir, comme jadis seulement l’homme individuel. Tout s'assombrit devant l’épée de Damoclès."
                                            },
                                            {
                                                "example_id": "b1ca9406-40c0-48b2-bd2f-e0d646171c78",
                                                "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                                "text": "Plus grave, la molécule a une durée de vie de plusieurs siècles et continue de se transmettre via les produits maraîchers cultivés sur place, faisant peser une épée de Damoclès sanitaire sur les quelque 800 000 habitants recensés dans les deux îles des Antilles françaises."
                                            },
                                            {
                                                "example_id": "27786765-c845-4f0e-8237-4e43c0f40622",
                                                "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                                "text": "Ici, dans les Landes girondines, l’épée de Damoclès est forgée dans la grume d’un pin maritime."
                                            },
                                            {
                                                "example_id": "9e63710b-eed8-4e75-847e-d8f77e579d80",
                                                "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                                "text": "Il y a une épée de Damoclès qui pend au-dessus de la tête de chaque contribuable canadien."
                                            },
                                            {
                                                "example_id": "667ce12a-c4f0-4e91-a9b0-ee6d514d5912",
                                                "sense_id": "ba289808-ed4a-33f2-b1c5-feb16188254a",
                                                "text": "Quand on vit aussi longtemps que moi avec cette épée de Damoclès au-dessus de la tête, pendant des jours, des mois, puis des années, on pris pour qu’elle tombe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc870e7e-c362-4f3b-be9f-6b0cbab3e5fa",
                        "source_entry_id": "a3b9a5a4-3925-35b8-9154-df73137f4c34",
