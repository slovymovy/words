                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985bb1a6-2b9e-4d93-a3ae-63e9d3ce5dfc",
                                                "sense_id": "72b3fadc-cf45-39b5-a0c1-48e55bbdb357",
                                                "text": "Once complete, guide rails will be installed inside the tunnels ready for the box jack itself - which NR intends to push into place during a nine-day engineering possession in September, following a trial push in late August. [...] A small number of weekday and weekend possessions will also be required on June 20-21, September 5-6, and between December 19-March 2021, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17e75dac-442b-384f-ad97-ef4c7293ea60",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "Something that is owned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5250a579-cb0e-4379-89f0-fd9f3bdc7aa8",
                                                "sense_id": "17e75dac-442b-384f-ad97-ef4c7293ea60",
                                                "text": "The car quickly became his most prized possession."
                                            },
                                            {
                                                "example_id": "0b2ae96a-86d1-4057-99ab-9494d2e82901",
                                                "sense_id": "17e75dac-442b-384f-ad97-ef4c7293ea60",
                                                "text": "I would gladly give all of my worldly possessions just to be able to do that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "519a3d94-447e-3d0e-891b-26bb8b023115",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "Ownership; taking, holding, keeping something as one's own."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cdc2635-75bf-430a-b10d-542c755cdc79",
                                                "sense_id": "519a3d94-447e-3d0e-891b-26bb8b023115",
                                                "text": "The car is in my possession."
                                            },
                                            {
                                                "example_id": "15f78ae3-a5bb-4e11-8d0b-b320f9f8d958",
                                                "sense_id": "519a3d94-447e-3d0e-891b-26bb8b023115",
                                                "text": "I'm in possession of the car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9089ad7c-938e-3f6a-a038-e6def2de044d",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "A territory under the rule of another country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b65ea4ad-beb8-43ae-afbf-b99a1710dc22",
                                                "sense_id": "9089ad7c-938e-3f6a-a038-e6def2de044d",
                                                "text": "Réunion is the largest of France's overseas possessions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e70a273-3c6c-3e80-9670-55721edd6272",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "The condition or affliction of being possessed by a demon or other supernatural entity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843b98a9-fdd5-479d-a4aa-5ec12585b603",
                                                "sense_id": "3e70a273-3c6c-3e80-9670-55721edd6272",
                                                "text": "Back then, people with psychiatric disorders were sometimes thought to be victims of demonic possession."
                                            },
                                            {
                                                "example_id": "fb852dec-0430-4020-876a-692d99bc20ad",
                                                "sense_id": "3e70a273-3c6c-3e80-9670-55721edd6272",
                                                "text": "How long hath this possession held the man?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb2d723c-3e93-34bc-868e-acd128f5ad17",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "The condition of being under the control of strong emotion or madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d93b0ca1-c7cf-36a4-9a05-9b452554f90e",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "Control of the ball; the opportunity to be on the offensive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a07f50f-86c4-4801-955f-a41921218f99",
                                                "sense_id": "d93b0ca1-c7cf-36a4-9a05-9b452554f90e",
                                                "text": "The scoreboard shows a little football symbol next to the name of the team that has possession."
                                            },
                                            {
                                                "example_id": "78fa40ef-b8e6-42e0-8374-63e25e02b599",
                                                "sense_id": "d93b0ca1-c7cf-36a4-9a05-9b452554f90e",
                                                "text": "Their first half was marred by the entire side playing too deep, completely unable to build up any form of decent possession once the ball left their bewildered defence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1047e9e4-7537-3932-9d06-a6143207db33",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "A disposal of the ball during a game, i.e. a kick or a handball."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b648358c-d8cf-4454-a97a-fef85d99ecc1",
                                                "sense_id": "1047e9e4-7537-3932-9d06-a6143207db33",
                                                "text": "2019 In the mix: Who's pushing for selection for round eight? Australian Football League, 7 May 2019. Accessed 7 May 2019.\nDefender Colin O'Riordan had 41 possessions in the NEAFL last week to continue his outstanding form, while Ryan Clarke had 47 in the Swans' big loss to Brisbane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f18875e1-42fa-376c-b2cd-7060eb156ec7",
                                        "entry_id": "ce533d11-a4bc-3806-b9d8-6aacd2974b49",
                                        "glosses": [
                                            "A syntactic relationship between two nouns or nominals that may be used to indicate ownership."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5783b7ae-f434-404a-b85d-f9db6c34384f",
                                                "sense_id": "f18875e1-42fa-376c-b2cd-7060eb156ec7",
                                                "text": "Some languages distinguish between a construction like 'my car', which shows alienable possession — the car could become someone else's — and one like 'my foot', which has inalienable possession — my foot will always be mine."
                                            }
                                        ]
                                    }
