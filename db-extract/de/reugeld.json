                        "entry_id": "f3d5236a-98f9-35f4-9866-e43910a26e41",
                        "glosses": [
                            "Zahlung einer Entschädigung im Falle der Nichtteilnahme an einem Wettkampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b5898b-b0e8-47fd-acb6-70b128c434e8",
                                "sense_id": "9f14251c-f67a-3daf-b981-baa8926ff234",
                                "text": "Im Falle der Nichtteilnahme wird ein Reugeld fällig."
