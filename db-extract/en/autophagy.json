                        "cross_references": [
                            {
                                "target_word": "autophagie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc0c184-6c35-3e1c-84b8-feb40f275832",
                                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                                        "glosses": [
                                            "Chez un organisme vivant soumis à l’inanition, particularité d’entretenir la vie aux dépens de sa propre substance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0924bf14-13db-38e0-b789-54e556c0f873",
                                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                                        "glosses": [
                                            "Capacité d’une cellule d’un organisme pluricellulaire à se manger elle-même."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8212fb86-a9bc-4619-9709-ec5d16052976",
                                                "sense_id": "0924bf14-13db-38e0-b789-54e556c0f873",
                                                "text": "« L'autophagie est un mécanisme d'autodigestion cellulaire qui, paradoxalement, peut soit conduire à la protection et donc à la survie de la cellule, soit mener à sa mort ». Explique Patrice Codogno, biologiste à l'Inserm-Hôpital Necker à Paris. « Toutefois chez l'homme, et les mammifères, l'autophagie intervient surtout en réponse à un stress »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aaf2eea-a153-37c5-b612-d1d1ff0e8ae6",
                                        "entry_id": "c4783b64-dc06-344c-a45c-63e02c865ae5",
                                        "glosses": [
                                            "Digestion intracellulaire de divers composants cytoplasmiques par des lysosomes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05aad68b-cccf-46ef-97ef-0907c3c04e8c",
                                                "sense_id": "3aaf2eea-a153-37c5-b612-d1d1ff0e8ae6",
                                                "text": "« L'autophagie consiste à enfermer des éléments cytoplasmiques et des organites devenus inutiles dans des vésicules à double membrane appelés autophagosomes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
