                "translations": [
                    {
                        "translation_id": "a726cf45-03d6-413f-8d38-c17e481b90b5",
                        "source_entry_id": "290f38b7-cb67-3cd9-b0eb-bf4f33a3ab4c",
                        "source_sense_id": "3fde8430-b1ab-3988-b2b9-2e8e51dd66b7",
                        "target_lang_word": "Ossi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ossi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52307de6-e7bf-35dd-a7f5-434b7c0612a5",
                                        "entry_id": "433d70f8-681b-3bf5-ba1c-c8a26dd66a76",
                                        "glosses": [
                                            "Ostdeutscher"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7d8d44c-c117-4874-aa21-05adc8c94628",
                                                "sense_id": "52307de6-e7bf-35dd-a7f5-434b7c0612a5",
                                                "text": "„Gemeint ist nicht, dass Ossis mehr jammern als andere, sondern, dass sie jammern, obwohl sie nicht - in Gegensatz zu den Wessis - das Recht dazu haben.“"
                                            },
                                            {
                                                "example_id": "022d2cca-589d-490a-8d84-b90e481b8c5c",
                                                "sense_id": "52307de6-e7bf-35dd-a7f5-434b7c0612a5",
                                                "text": "„Bei den Bankkonten waren die Ossis die Verlierer, auf den Matratzen aber die Gewinner.“"
                                            },
                                            {
                                                "example_id": "f0775c79-ae41-4782-85b5-ff94dba661dc",
                                                "sense_id": "52307de6-e7bf-35dd-a7f5-434b7c0612a5",
                                                "text": "„Vor allem die Wessis sahen sich gern als Erlöser der Ossis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
