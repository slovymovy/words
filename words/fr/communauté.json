            "senses": [
                {
                    "sense_id": "8639a0f2-d981-3d31-84ac-bb4dac46c48f",
                    "sense_definition": "Ensemble de personnes réunies par des liens d'intérêt commun, une culture, des lois ou des valeurs partagées.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "groupe_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les membres de cette <w>communauté</w> s'entraident toujours dans les moments difficiles."
                        },
                        {
                            "text": "La <w>communauté</w> internationale tente de trouver une issue pacifique à ce conflit."
                        }
                    ],
                    "synonyms": [
                        "collectivité",
                        "collectif"
                    ],
                    "antonyms": [
                        "individu"
                    ],
                    "common_phrases": [
                        "communauté internationale",
                        "communauté locale",
                        "esprit de communauté"
                    ]
                },
                {
                    "sense_id": "dd18fea5-99c1-3ce3-a7c8-09fe9f709ebc",
                    "sense_definition": "Fait de posséder, de partager ou d'éprouver quelque chose ensemble ; état de ce qui est commun.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "partage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une réelle <w>communauté</w> de vues a facilité les négociations entre les deux délégations."
                        },
                        {
                            "text": "Le projet repose sur la mise en <w>communauté</w> des ressources disponibles."
                        }
                    ],
                    "common_phrases": [
                        "communauté de biens",
                        "communauté de destin",
                        "communauté de vues"
                    ]
                },
                {
                    "sense_id": "230b188c-20a3-3f0b-9200-658f9c71b419",
                    "sense_definition": "Groupe de personnes menant une vie commune selon des règles religieuses ou monastiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette <w>communauté</w> de moines vit dans la prière et le travail manuel."
                        },
                        {
                            "text": "Elle a décidé de quitter sa ville pour rejoindre une <w>communauté</w> religieuse."
