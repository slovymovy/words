                        "examples": [
                            {
                                "example_id": "054f8bc5-29d0-44b0-bb40-ad795379d4f1",
                                "sense_id": "c9885371-d11e-34d9-a00a-93b72016695a",
                                "text": "„Der letzte Abschnitt seiner Weltumrundung war ein 15-stündiger Flug über den Pazifik von Kona in Hawaii nach Kalifornien.“"
                            },
                            {
                                "example_id": "4d8c4da0-8600-4bb8-9f33-fa76eb23b520",
                                "sense_id": "c9885371-d11e-34d9-a00a-93b72016695a",
                                "text": "„Mit der LZ-127 konnte nicht nur ein regelmäßiger Transatlantikdienst eingerichtet werden. Sie absolvierte auch zahlreiche andere Pioniertaten wie eine Weltumrundung mit fast 50000 km Reisestrecke in 35 Tagen im Jahre 1929 und eine Polarreise 1931.“"
                            },
                            {
                                "example_id": "e9f9a5ee-c7c5-4a44-89e5-b3545a24d731",
                                "sense_id": "c9885371-d11e-34d9-a00a-93b72016695a",
                                "text": "„Drei Autos mit Brennstoffzelle haben auf einer Weltumrundung die Tauglichkeit auf langer Strecke bewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
