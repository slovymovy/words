                "senses": [
                    {
                        "sense_id": "508f399e-5731-3d87-8ff3-0a23223086de",
                        "entry_id": "01242aa4-d245-3146-af0b-2ce21bad948e",
                        "glosses": [
                            "mörtelfreies Hochziehen von Zwischenwänden und dessen Ergebnis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f629395-9785-46cd-a60e-d6df53f32503",
                                "sense_id": "508f399e-5731-3d87-8ff3-0a23223086de",
                                "text": "„Dank den Dübeln wurde der Trockenbau, bei dem vorgefertigte Elemente aneinandergefügt werden, geradezu revolutioniert.“"
                            },
                            {
                                "example_id": "7baccf68-9817-4e3b-9432-5f8144c3a6c4",
                                "sense_id": "508f399e-5731-3d87-8ff3-0a23223086de",
                                "text": "„Der Trockenbau, ideal für Trennwände, Decken und Verkleidungen - schnell, flexibel und mit einer Vielzahl an Gestaltungsmöglichkeiten.“"
                            },
                            {
                                "example_id": "cce3539a-1937-4bd5-8641-d0d961c08773",
                                "sense_id": "508f399e-5731-3d87-8ff3-0a23223086de",
                                "text": "„Dadurch bedingte Risse beim Trockenbau seien aber ebenso ‚erfolgreich nachgebessert‘ worden wie die undichten Abläufe in einigen Bädern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
