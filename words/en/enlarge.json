{
    "word_family": [
        "enlargement",
        "enlarger",
        "large"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eff942a7-4f31-37db-b187-3931db9596ee",
                    "sense_definition": "To make something bigger in size, amount, or scale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will need to <w>enlarge</w> our budget if we want to include the helicopter ride in our holiday.",
                            "target_lang_translations": {
                                "ru": "Нам нужно будет <w>увеличить</w> наш бюджет, если мы хотим включить полет на вертолете в наш отпуск."
                            }
                        },
                        {
                            "text": "The photographer offered to <w>enlarge</w> a photo for us to hang on the living room wall.",
                            "target_lang_translations": {
                                "ru": "Фотограф предложил <w>увеличить</w> фотографию, чтобы мы могли повесить ее на стену в гостиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "embiggen",
                        "enlargen",
                        "largen",
                        "greaten"
                    ],
                    "antonyms": [
                        "shrink",
                        "reduce",
                        "decrease"
                    ],
                    "common_phrases": [
                        "enlarge a photo",
                        "enlarge the budget",
                        "enlarge the scope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо больше по размеру, количеству или масштабу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличить",
                                "target_lang_sense_clarification": "сделать больше по размеру или количеству"
                            },
                            {
                                "target_lang_word": "расширить",
                                "target_lang_sense_clarification": "сделать более обширным или масштабным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b5ea3d-e7f7-3714-bfa9-56f25cc78a45",
                    "sense_definition": "To become larger or to grow in size.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pupils of her eyes began to <w>enlarge</w> as the room grew darker.",
                            "target_lang_translations": {
                                "ru": "Зрачки ее глаз начали <w>расширяться</w>, когда в комнате стало темнее."
                            }
                        },
                        {
                            "text": "As the business continues to <w>enlarge</w>, we will need to hire more staff.",
                            "target_lang_translations": {
                                "ru": "По мере того как бизнес продолжает <w>расширяться</w>, нам нужно будет нанять больше персонала."
                            }
                        }
                    ],
                    "synonyms": [
                        "expatiate",
                        "dilate"
                    ],
                    "antonyms": [
                        "contract",
                        "narrow"
                    ],
                    "common_phrases": [
                        "continue to enlarge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться больше или расти в размерах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличиваться",
                                "target_lang_sense_clarification": "становиться больше"
                            },
                            {
                                "target_lang_word": "расширяться",
                                "target_lang_sense_clarification": "становиться шире или масштабнее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18fc4540-0afe-3213-b9e6-31d45c3e0f83",
                    "sense_definition": "To speak or write in greater detail about a specific subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elaborate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor promised to <w>enlarge</w> upon the theory during the next lecture.",
                            "target_lang_translations": {
                                "ru": "Профессор пообещал <w>подробно</w> <w>остановиться</w> на этой теории во время следующей лекции."
                            }
                        },
                        {
                            "text": "He began to <w>enlarge</w> on the nature of the ground and the difficulties of the terrain.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>распространяться</w> о характере почвы и трудностях рельефа."
                            }
                        }
                    ],
                    "synonyms": [
                        "expatiate",
                        "dilate"
                    ],
                    "antonyms": [
                        "summarize",
                        "abbreviate"
                    ],
                    "common_phrases": [
                        "enlarge upon the point",
                        "enlarge on the subject"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'on' or 'upon'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать более подробно о конкретном предмете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подробно излагать",
                                "target_lang_sense_clarification": "детально описывать"
                            },
                            {
                                "target_lang_word": "распространяться",
                                "target_lang_sense_clarification": "говорить долго и детально о чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "875d5c72-f749-38c4-bfc3-8705055e5e91",
                    "sense_definition": "To extend the period of time allowed for a legal order or rule to be followed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_extension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>enlarge</w> the time for the defendant to file his response.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>продлить</w> срок подачи ответа для ответчика."
                            }
                        },
                        {
                            "text": "The court would not <w>enlarge</w> the term unless both parties agreed to the delay.",
                            "target_lang_translations": {
                                "ru": "Суд не стал бы <w>продлевать</w> срок, если бы обе стороны не согласились на отсрочку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enlarge the time"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продлить период времени, отведенный для исполнения судебного приказа или правила."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продлевать",
                                "target_lang_sense_clarification": "увеличивать срок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ab38e3d-aacc-3d9b-893e-53d340f098bb",
                    "sense_definition": "To set someone free from confinement or restraint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the fine was paid, the prisoner was <w>enlarged</w> and allowed to return home.",
                            "target_lang_translations": {
                                "ru": "После уплаты штрафа заключенный был <w>освобожден</w> и ему разрешили вернуться домой."
                            }
                        },
                        {
                            "text": "The king ordered his guards to <w>enlarge</w> the man who had been wrongly accused.",
                            "target_lang_translations": {
                                "ru": "Король приказал своей страже <w>освободить</w> человека, который был ложно обвинен."
                            }
                        }
                    ],
                    "antonyms": [
                        "confine",
                        "imprison"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободить кого-либо из-под стражи или ограничений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "выпускать на свободу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}