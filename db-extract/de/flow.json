                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2793357-179d-4ace-95c7-33da5f93b48a",
                                                "sense_id": "7077edb4-7cf2-3f31-83ec-14db1eb2ec9e",
                                                "text": "The room was small, but it had good symmetry and flow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b0a4ebc-6bbd-3cbd-be90-15704ff8099d",
                                        "entry_id": "61016d52-5805-34e1-abc8-8f69c9808820",
                                        "glosses": [
                                            "The amount of a fluid that moves or the rate of fluid movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96419ced-5185-4a3d-aae4-fd214f7dbdf6",
                                                "sense_id": "9b0a4ebc-6bbd-3cbd-be90-15704ff8099d",
                                                "text": "Turn on the valve and make sure you have sufficient flow."
                                            },
                                            {
                                                "example_id": "49705fd2-3976-4ed4-a7c4-8809b1abecbb",
                                                "sense_id": "9b0a4ebc-6bbd-3cbd-be90-15704ff8099d",
                                                "text": "Other devices measure water flow in streams fed by melted ice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7668604-0421-3029-9e80-a4814b009966",
                                        "entry_id": "61016d52-5805-34e1-abc8-8f69c9808820",
                                        "glosses": [
                                            "A flow pipe, carrying liquid away from a boiler or other central plant (compare with return pipe which returns fluid to central plant)."
