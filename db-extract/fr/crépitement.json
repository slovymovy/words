                "senses": [
                    {
                        "sense_id": "35c89f0b-53db-32c3-9cd8-4f11eb9c361e",
                        "entry_id": "be3d2b05-6c85-3201-afe4-696c73e1cdbb",
                        "glosses": [
                            "Bruit sec et répété d’une flamme qui pétille, d’un corps qui brûle en pétillant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ff747549-d693-35fe-8077-e2e934a39b35",
                        "entry_id": "be3d2b05-6c85-3201-afe4-696c73e1cdbb",
                        "glosses": [
                            "Plusieurs claquements secs et répétés."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "d0b58e68-ac00-491a-89c4-3a56c6530e3d",
                                "sense_id": "ff747549-d693-35fe-8077-e2e934a39b35",
                                "text": "Le crépitement de la fusillade amena rapidement sur les lieux le Preussen et le Kiel, […]."
                            },
                            {
                                "example_id": "597869cc-c210-43f2-8f21-1a13fa41fa33",
                                "sense_id": "ff747549-d693-35fe-8077-e2e934a39b35",
                                "text": "Le feu des fusils Mauser commença ; ce fut un vacarme épouvantable dans lequel on percevait le ronflement des obus à la lydite, le crépitement des fusils Metford, les éclats des mitrailleuses boers et les sifflements des Mauser."
                            },
                            {
                                "example_id": "d521f64e-e7cf-4dcb-8f5d-b98e5755a26e",
                                "sense_id": "ff747549-d693-35fe-8077-e2e934a39b35",
                                "text": "Il est à son pupitre, en classe. Avec un petit pistolet, un élève crible de plombs le tableau noir. Il ne le punit pas. Malgré le crépitement des balles, il pense :\n— Je suis admis à faire ma cour !..."
                            },
                            {
                                "example_id": "abcf6011-aa37-4858-9e64-b71578dadfac",
                                "sense_id": "ff747549-d693-35fe-8077-e2e934a39b35",
                                "text": "Vers le milieu de l'après-midi, des crépitements d'armes automatiques se firent entendre, en provenance probable de la vallée d’Auflance. A ce moment, je fis part de mes inquiétudes à l'officier de liaison de notre division présent au P.C. de Tassigny ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fabd203-3d23-4061-83db-44362b259074",
                        "source_entry_id": "be3d2b05-6c85-3201-afe4-696c73e1cdbb",
                        "target_lang_word": "Knistern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knistern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6887d4-07e8-320d-b165-e0ad7345b0b3",
                                        "entry_id": "fe17a18b-c17f-3f26-aab3-fa5bcc56b806",
                                        "glosses": [
                                            "knisterndes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18ae657-8cd9-415e-8986-389df13d46bd",
                                                "sense_id": "2c6887d4-07e8-320d-b165-e0ad7345b0b3",
                                                "text": "„Man hörte nur noch das Knistern des Feuers und das Atmen des Hundes.“"
                                            },
                                            {
                                                "example_id": "98540e0b-505a-4618-bd61-2e1d689be404",
                                                "sense_id": "2c6887d4-07e8-320d-b165-e0ad7345b0b3",
                                                "text": "„Nicht einmal in einer Bibliothek ging es vollkommen leise zu, und obwohl die Geräusche sich nie in ihr Bewusstsein gedrängt hatten, waren sie ihr bei ihrem Gang durch das Gebäude trotzdem nicht verborgen geblieben: das Knistern von Papier, ein Flüstern zwischen Freunden, Bücher, die zu Boden fielen, das Klimpern von Kleingeld, Schuhe, die über den Fliesenboden tappten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f9ff9c4-25a7-4a6c-b463-073bc263a6f4",
