                ],
                "senses": [
                    {
                        "sense_id": "a6a9093c-ab9a-3070-a902-be47dd55a1ec",
                        "entry_id": "401b233f-d568-355a-ba3f-1b5fe61dce16",
                        "glosses": [
                            "zeitliche und spieltaktische Abfolge eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03f9553e-10fb-4b6f-9da2-ca20a131a24a",
                                "sense_id": "a6a9093c-ab9a-3070-a902-be47dd55a1ec",
                                "text": "„Man erlaube einen etwas trivialen Vergleich: Das Individuum ist dem einzelnen Fußballspieler vergleichbar, das Denkkollektiv der auf Zusammenarbeit eingedrillten Fußballmannschaft, das Erkennen dem Spielverlaufe.“"
                            },
                            {
                                "example_id": "877c879e-d89b-45c7-8101-d4cf081fa84c",
                                "sense_id": "a6a9093c-ab9a-3070-a902-be47dd55a1ec",
                                "text": "„Besonders der Spielleiter hat einen entscheidenden Einfluss auf den Spielverlauf, weil er Spielvorschläge unterbreitet, Aktionen anregt, Spielprozesse strukturiert und der Gruppe auch bei der Auswertung der Spielerfahrungen hilft.“"
                            },
                            {
                                "example_id": "e3afb4c0-8fe1-4902-84bd-d885a8ffa7ae",
                                "sense_id": "a6a9093c-ab9a-3070-a902-be47dd55a1ec",
                                "text": "„Greifen wir aus der Fülle der schon erwähnten Varianten die Solo genannte Variante zur Veranschaulichung des Spielverlaufs heraus.“"
                            },
                            {
                                "example_id": "aa5eec33-10c4-48c1-8318-e601de792507",
                                "sense_id": "a6a9093c-ab9a-3070-a902-be47dd55a1ec",
                                "text": "„Bei der Beobachtung des Spielverlaufs, d.h. der Art und Weise, wie Kinder spielen, ist insbesondere zu bedenken, dass wir uns bei der Beantwortung der Frage, wie das Spielgeschehen beim Kind ankommt, häufig ohne Rückversicherung bei den Betroffenen, von unseren erwachsenen Vorstellungen leiten lassen.“"
                            },
                            {
                                "example_id": "6bebfff3-5b87-495f-adb2-14e8b232face",
                                "sense_id": "a6a9093c-ab9a-3070-a902-be47dd55a1ec",
                                "text": "„Getroffene Spieler müssen das Spielfeld verlassen, dürfen aber von außen als Jäger weiterhin den Spielverlauf mitbestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
