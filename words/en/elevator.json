{
    "word_family": [
        "elevate",
        "elevation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e28da04-c4c4-3979-a36f-8a13ce428478",
                    "sense_definition": "A machine with a platform or box that carries people and goods up and down between floors in a building.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to take the <w>elevator</w> to the tenth floor.",
                            "target_lang_translations": {
                                "ru": "Мы решили подняться на <w>лифте</w> на десятый этаж.",
                                "zh": "我们决定<w>乘电梯</w>去十楼。"
                            }
                        },
                        {
                            "text": "The <w>elevator</w> doors opened and a crowd of people walked out.",
                            "target_lang_translations": {
                                "ru": "Двери <w>лифта</w> открылись, и вышла толпа людей.",
                                "zh": "<w>电梯</w>门开了，一群人走了出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lift"
                    ],
                    "common_phrases": [
                        "take the elevator",
                        "freight elevator",
                        "elevator shaft",
                        "elevator pitch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство с кабиной или платформой для перевозки людей и грузов между этажами здания",
                        "zh": "一种在建筑物楼层间运送人员或货物的升降设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лифт",
                                "target_lang_sense_clarification": "подъемное устройство в здании"
                            },
                            {
                                "target_lang_word": "подъёмник",
                                "target_lang_sense_clarification": "грузовой или технический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电梯",
                                "target_lang_sense_clarification": "建筑物内的升降设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6def4b9b-2986-3336-9228-78eb40e13c69",
                    "sense_definition": "A large building or facility used for storing grain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers brought their wheat harvest to the local grain <w>elevator</w>.",
                            "target_lang_translations": {
                                "ru": "Фермеры привезли свой урожай пшеницы на местный зерновой <w>элеватор</w>.",
                                "zh": "农民们把收获的小麦运到了当地的<w>粮仓</w>。"
                            }
                        },
                        {
                            "text": "The old <w>elevator</w> stood tall against the flat horizon.",
                            "target_lang_translations": {
                                "ru": "Старый <w>элеватор</w> возвышался над плоским горизонтом.",
                                "zh": "那座老旧的<w>粮仓</w>高高地矗立在平坦的地平线上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grain elevator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое сооружение или помещение для хранения зерна",
                        "zh": "用于储存谷物的大型建筑物或设施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элеватор",
                                "target_lang_sense_clarification": "зернохранилище"
                            },
                            {
                                "target_lang_word": "зернохранилище",
                                "target_lang_sense_clarification": "силос"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粮仓",
                                "target_lang_sense_clarification": "储存粮食的建筑"
                            },
                            {
                                "target_lang_word": "谷物升降机",
                                "target_lang_sense_clarification": "用于装卸谷物的机械设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0034fce6-9da8-380e-926b-1b2398601155",
                    "sense_definition": "A movable part on the tail of an aircraft that controls its upward or downward movement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot pulled back on the stick to raise the <w>elevator</w>.",
                            "target_lang_translations": {
                                "ru": "Пилот потянул штурвал на себя, чтобы поднять <w>руль высоты</w>.",
                                "zh": "飞行员向后拉操纵杆以抬起<w>升降舵</w>。"
                            }
                        },
                        {
                            "text": "Damage to the <w>elevator</w> made it difficult to control the plane's altitude.",
                            "target_lang_translations": {
                                "ru": "Повреждение <w>руля высоты</w> затруднило управление высотой самолета.",
                                "zh": "<w>升降舵</w>受损导致飞机难以控制高度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "aeronautics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная часть хвостового оперения самолета, управляющая движением вверх или вниз",
                        "zh": "飞机尾部用于控制飞行高度的活动部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руль высоты",
                                "target_lang_sense_clarification": "авиация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "升降舵",
                                "target_lang_sense_clarification": "航空术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9445487f-5118-3a69-8c30-4abd61c1d68c",
                    "sense_definition": "A muscle that lifts a specific part of the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>elevator</w> muscle helps to raise the upper lip when smiling.",
                            "target_lang_translations": {
                                "ru": "<w>Мышца-подниматель</w> помогает приподнять верхнюю губу при улыбке.",
                                "zh": "<w>提肌</w>有助于在微笑时抬起上唇。"
                            }
                        },
                        {
                            "text": "An injury to the <w>elevator</w> can affect facial expressions.",
                            "target_lang_translations": {
                                "ru": "Травма <w>мышцы-поднимателя</w> может повлиять на мимику.",
                                "zh": "<w>提肌</w>受伤可能会影响面部表情。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мышца, которая поднимает определенную часть тела",
                        "zh": "使身体特定部位向上抬起的肌肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мышца-подниматель",
                                "target_lang_sense_clarification": "анатомия"
                            },
                            {
                                "target_lang_word": "леватор",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提肌",
                                "target_lang_sense_clarification": "解剖学名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb6fdf0a-d7e6-30fa-b7ea-7ebd5c77bef4",
                    "sense_definition": "A dental tool used to lift a tooth or bone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist used a small <w>elevator</w> to loosen the tooth before extraction.",
                            "target_lang_translations": {
                                "ru": "Стоматолог использовал маленький <w>элеватор</w>, чтобы расшатать зуб перед удалением.",
                                "zh": "牙医在拔牙前用一个小<w>牙挺</w>松动牙齿。"
                            }
                        },
                        {
                            "text": "Surgical instruments like the <w>elevator</w> must be sterilized after use.",
                            "target_lang_translations": {
                                "ru": "Хирургические инструменты, такие как <w>элеватор</w>, должны стерилизоваться после использования.",
                                "zh": "像<w>牙挺</w>这样的手术器械使用后必须进行消毒。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dentistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стоматологический инструмент, используемый для поднятия зуба или кости",
                        "zh": "牙科中用于撬动牙齿或骨头的工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элеватор",
                                "target_lang_sense_clarification": "стоматологический инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牙挺",
                                "target_lang_sense_clarification": "牙科手术器械"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9edb8fc5-8c47-37a5-8a52-4e5b0ce2a141",
                    "sense_definition": "A shoe with a thick inside sole that makes the wearer look taller.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore <w>elevator</w> shoes to appear taller in the wedding photos.",
                            "target_lang_translations": {
                                "ru": "Он надел обувь на <w>скрытой платформе</w>, чтобы казаться выше на свадебных фотографиях.",
                                "zh": "为了在结婚照里显得高一些，他穿了<w>增高鞋</w>。"
                            }
                        },
                        {
                            "text": "The extra height from the <w>elevator</w> gave him more confidence.",
                            "target_lang_translations": {
                                "ru": "Дополнительный рост благодаря <w>скрытой платформе</w> придал ему уверенности.",
                                "zh": "<w>增高鞋</w>带来的额外高度让他更有自信了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elevator shoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обувь с толстой внутренней стелькой, которая делает владельца визуально выше",
                        "zh": "鞋内有厚底，使穿着者看起来更高的鞋子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытая платформа",
                                "target_lang_sense_clarification": "в обуви для увеличения роста"
                            },
                            {
                                "target_lang_word": "увеличивающая рост",
                                "target_lang_sense_clarification": "об обуви"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增高鞋",
                                "target_lang_sense_clarification": "具有增高功能的鞋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a8f6bd-2d5d-3703-8a95-bd096bba0963",
                    "sense_definition": "Anything that lifts or raises something up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This hydraulic mechanism acts as an <w>elevator</w> for heavy loads.",
                            "target_lang_translations": {
                                "ru": "Этот гидравлический механизм действует как <w>подъёмник</w> для тяжелых грузов.",
                                "zh": "这种液压装置可以作为重物的<w>升降机</w>。"
                            }
                        },
                        {
                            "text": "The machine served as an <w>elevator</w> to move grain onto the truck.",
                            "target_lang_translations": {
                                "ru": "Машина служила <w>элеватором</w> для перемещения зерна в грузовик.",
                                "zh": "这台机器充当了将谷物装上卡车的<w>提升机</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое устройство, которое поднимает что-либо вверх",
                        "zh": "任何用于将物体向上提升的装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъёмник",
                                "target_lang_sense_clarification": "механизм"
                            },
                            {
                                "target_lang_word": "элеватор",
                                "target_lang_sense_clarification": "технический конвейер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "升降机",
                                "target_lang_sense_clarification": "机械装置"
                            },
                            {
                                "target_lang_word": "提升机",
                                "target_lang_sense_clarification": "工业设备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6285267d-5c7c-3a99-8919-e4be4a880576",
                    "sense_definition": "To travel using an elevator.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>elevatored</w> up to the lobby instead of taking the stairs.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поднялись на лифте</w> в вестибюль вместо того, чтобы идти по лестнице.",
                                "zh": "我们<w>乘电梯</w>去了大堂，没走楼梯。"
                            }
                        },
                        {
                            "text": "He <w>elevatored</w> down to the garage to get his car.",
                            "target_lang_translations": {
                                "ru": "Он <w>спустился на лифте</w> в гараж, чтобы забрать машину.",
                                "zh": "他<w>乘电梯</w>下到车库去取车。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться с помощью лифта",
                        "zh": "乘坐电梯移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на лифте",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "подниматься на лифте",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乘电梯",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}