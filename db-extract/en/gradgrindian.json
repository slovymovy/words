                        "glosses": [
                            "Having a soulless devotion to facts and figures; inflexibly utilitarian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9783bd6-80dc-42aa-92d7-b1600e36191e",
                                "sense_id": "de388330-3c46-3f7e-bb5f-0423b7d7ae4d",
                                "text": "But today's winning businesses are positively Gradgrindian in their pursuit of the truth."
                            },
                            {
                                "example_id": "9b4ead5e-a30a-4e02-901d-ab275bfacc6e",
                                "sense_id": "de388330-3c46-3f7e-bb5f-0423b7d7ae4d",
                                "text": "Whether one favours a Gradgrindian Thatcherism that removes all worker rights, or a Corbynista fantasy of wholesale nationalisation, we will find these are impossible, given the reach of the Brussels acquis."
                            },
                            {
                                "example_id": "54c48018-d66a-46ed-a698-4c38c33c22f1",
                                "sense_id": "de388330-3c46-3f7e-bb5f-0423b7d7ae4d",
                                "text": "But I have never quite got my head around my times tables, which I think are a Gradgrindian chanting fetish periodically revived by politicians who, if they are honest with themselves, have never really needed times tables either."
                            }
                        ]
                    }
