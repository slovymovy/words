                "senses": [
                    {
                        "sense_id": "006f3315-c632-3b13-bd44-b755356356fa",
                        "entry_id": "71bd18c0-21a6-32f7-9244-680aebe4a3bd",
                        "glosses": [
                            "Personne qui souhaite, qui a changé de sexe ou qui est en cours de transition."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "9ad7e146-4c98-4dea-8d85-bb79de57b970",
                                "sense_id": "006f3315-c632-3b13-bd44-b755356356fa",
                                "text": "Peut-on avancer la même hypothèse chez le transexuel ? Le transexuel, que l'on ne doit pas confondre avec l'homosexuel, se caractérise par sa conviction inébranlable d'appartenir au sexe opposé."
                            },
                            {
                                "example_id": "65c6ade8-4cdf-45bf-89ef-25466665298c",
                                "sense_id": "006f3315-c632-3b13-bd44-b755356356fa",
                                "text": "Puis l'un d'eux vient à me demander s'il est vrai que je sortais avec un transexuel."
                            },
                            {
                                "example_id": "faa6c487-4871-4b0a-b863-5671429570f0",
                                "sense_id": "006f3315-c632-3b13-bd44-b755356356fa",
                                "text": "Une voie médiane qui n'est pas toujours facile, mais qui peut être néanmoins souvent tenue, ainsi que s'est efforcé de le faire notre droit à l'égard des transexuels ou, plus récemment, par l'introduction du pacte civil de solidarité."
                            }
                        ]
                    }
