                "senses": [
                    {
                        "sense_id": "f5fd9f4b-42e8-3d8e-a080-c5dbb6a5fc01",
                        "entry_id": "96572a3c-8d08-39a2-a55b-edd0e98b9fae",
                        "glosses": [
                            "A hand gesture used to depict the meaning of a song"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e42a98-e672-4ff9-9614-a78473dd3cb0",
                                "sense_id": "f5fd9f4b-42e8-3d8e-a080-c5dbb6a5fc01",
                                "text": "A prudent prayer, and a vigorous dance, with many interwoven leaps and twirls and pirouettes, and hastas all around."
                            }
                        ]
                    }
                ],
                "translations": [],
