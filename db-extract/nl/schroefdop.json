                    {
                        "sense_id": "3ef33fd0-174e-370b-ae85-34ed2a5bec53",
                        "entry_id": "40c11dcd-aba0-3497-b0f3-9dcaffb6858c",
                        "glosses": [
                            "kapje dat je op een fles kunt draaien om de fles af te sluiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0af184e-2604-47e2-81f7-85a7d402d8b5",
                                "sense_id": "3ef33fd0-174e-370b-ae85-34ed2a5bec53",
                                "text": "Hij toont lachend een fles uit de Golanhoogte, met een schroefdop waarop de Israëlische vlag is afgedrukt. ‘Omdat die wijnproducent trots is op zijn product, en waar het wordt gemaakt.’"
                            },
                            {
                                "example_id": "19fb31bc-0266-4bf0-b0ea-86a048a340fd",
                                "sense_id": "3ef33fd0-174e-370b-ae85-34ed2a5bec53",
                                "text": "Fles wijn. ,,Je moet als oudere een behoorlijke kunstenaar zijn om de kurk uit een fles te krijgen. Gelukkig zie je steeds meer flessen met schroefdop.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4813981c-ff6e-4bae-afaa-40267d64d957",
                        "source_entry_id": "40c11dcd-aba0-3497-b0f3-9dcaffb6858c",
                        "source_sense_id": "3ef33fd0-174e-370b-ae85-34ed2a5bec53",
                        "target_lang_word": "screw cap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "screw cap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "883f500b-a44f-3340-9710-b35033969dad",
                                        "entry_id": "c5372035-2f7a-3322-be98-ed7837bd47c9",
                                        "glosses": [
                                            "The cap of a container, especially a bottle or jar, which screws onto the threaded lip of the container."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc76e05-681e-4374-b040-4ab1eee68d79",
                                                "sense_id": "883f500b-a44f-3340-9710-b35033969dad",
                                                "text": "Four-year-old Anna surprised her parents when she unscrewed the screw cap and poured herself a glass of milk, like an old pro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e930611-a5e7-3ab1-817c-66f35a33acbd",
                                        "entry_id": "c5372035-2f7a-3322-be98-ed7837bd47c9",
                                        "glosses": [
                                            "The style of closure that has such a cap; a container that has such a cap."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fb5210-467e-4ff5-9d55-0b960d9d407f",
                                                "sense_id": "6e930611-a5e7-3ab1-817c-66f35a33acbd",
                                                "text": "Corks remain prevalent, but nowadays the wine industry also offers plenty of screw caps, too, for occasions that warrant them or customers who prefer them."
                                            },
                                            {
                                                "example_id": "b8a53efa-9e87-44a0-926b-e950d05be2c1",
                                                "sense_id": "6e930611-a5e7-3ab1-817c-66f35a33acbd",
                                                "text": "When you buy the wine tonight, pick up some screw caps in addition to whichever corked bottles you buy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
