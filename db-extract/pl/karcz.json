                ],
                "translations": [
                    {
                        "translation_id": "072ec61d-8cab-40fe-9bc5-45cd24537077",
                        "source_entry_id": "6fe4bc44-e290-3f97-871b-ad0e80fa2843",
                        "source_sense_id": "95b9d40e-f746-3ff0-bdc8-b50f91ebfa48",
                        "target_lang_word": "пень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d19b88e0-63f6-30e4-8bf7-e2bdb19d4a29",
                                        "entry_id": "2cd5789b-4af0-384f-9861-1d0047c404ed",
                                        "glosses": [
                                            "торчащий из земли остаток срубленного или спиленного дерева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9403bec5-afb4-4ef4-8032-c68fc9998d10",
                                                "sense_id": "d19b88e0-63f6-30e4-8bf7-e2bdb19d4a29",
                                                "text": "Тонкий заострённый пень, бывший когда-то началом осинового ствола, метрах в пяти от них зловеще проглядывал через мелкий кустарник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c620fa-7b2d-3c0d-af5d-eac05c09b4c6",
                                        "entry_id": "2cd5789b-4af0-384f-9861-1d0047c404ed",
                                        "glosses": [
                                            "перен. тупой или бесчувственный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73022d1f-c756-4af0-86dc-fa4720a0b06e",
                                                "sense_id": "d9c620fa-7b2d-3c0d-af5d-eac05c09b4c6",
                                                "text": "— Твой профессор, должно быть, старый пень, — не удержалась Роза, — весело с ним будет, ни потанцевать, ни посмеяться, и в постели небось по большей части спит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31bcd58-1d63-39c3-bd90-289037588546",
                                        "entry_id": "2cd5789b-4af0-384f-9861-1d0047c404ed",
                                        "glosses": [
                                            "комп. жарг. процессор семейства Pentium"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
