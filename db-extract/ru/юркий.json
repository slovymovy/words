                "senses": [
                    {
                        "sense_id": "85ef45ed-6bd2-3698-acd6-7e8f83536197",
                        "entry_id": "48f3c7e4-e7d4-3053-99bf-920cc5fccb55",
                        "glosses": [
                            "о человеке, животном: быстрый и ловкий в движениях; увёртливый, проворный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e9e487-5c55-4b17-9d00-7e7af6fcc96d",
                                "sense_id": "85ef45ed-6bd2-3698-acd6-7e8f83536197",
                                "text": "Здесь же снуют юркие казахские девчонки с сорока косичками."
                            },
                            {
                                "example_id": "1f5e07b6-2ec3-4a7b-8964-7818a48940fb",
                                "sense_id": "85ef45ed-6bd2-3698-acd6-7e8f83536197",
                                "text": ".. с писком разбегались по сторонам .. юркие мыши-полёвки."
                            },
                            {
                                "example_id": "bcd9b96b-33da-4266-bf30-8117dde0ce77",
                                "sense_id": "85ef45ed-6bd2-3698-acd6-7e8f83536197",
                                "text": "А в лесу, где пока что стоит тишина, вдруг весело подаст голос юркая синичка: тинь-тинь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1b59f640-c9ea-38fa-9818-2ceb902066e0",
                        "entry_id": "48f3c7e4-e7d4-3053-99bf-920cc5fccb55",
                        "glosses": [
                            "о средствах передвижения: быстрый, увёртливый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03b7c967-3069-460f-89df-ab4780778a09",
                                "sense_id": "1b59f640-c9ea-38fa-9818-2ceb902066e0",
                                "text": "Юркая лодочка."
                            },
                            {
                                "example_id": "3d6abce5-b462-4b2c-a4c8-4f4c235057b7",
                                "sense_id": "1b59f640-c9ea-38fa-9818-2ceb902066e0",
                                "text": "Юркий катер."
                            },
                            {
                                "example_id": "6fb76ea5-581d-4035-ae2a-15347898e9d3",
                                "sense_id": "1b59f640-c9ea-38fa-9818-2ceb902066e0",
                                "text": "Юркий автомобиль."
                            }
                        ]
                    },
