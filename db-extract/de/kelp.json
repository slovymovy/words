                                                "sense_id": "8dcaf6b8-daf1-30fc-b342-629cc0bf41c2",
                                                "text": "Underneath the area demarcated by the buoys, Ms Puckett plants kelp—a type of seaweed—on long ropes that resemble washing lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40df0746-a5b0-32ba-b859-75496d7f2eb5",
                                        "entry_id": "685dc947-b68c-3c5d-bcf5-e6440858f26a",
                                        "glosses": [
                                            "The calcined ashes of seaweed, formerly used in glass and iodine manufacture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kelp",
