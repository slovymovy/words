                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38f1c750-a2b2-406e-90b6-25d034fd192e",
                                "sense_id": "eb615e0d-7c24-31fc-95fb-09974daa80c6",
                                "text": "„Die beiden Metallkappen des Glasröhrchens der Grobsicherung sind mit einem Abschmelzdraht verbunden.“"
                            },
                            {
                                "example_id": "f89cba46-ec1a-4388-b7ef-d72220847679",
                                "sense_id": "eb615e0d-7c24-31fc-95fb-09974daa80c6",
                                "text": "„Wir verwenden lediglich solide Metallkappen, welche ohne weiteren Verschluß einfach über die Flaschenöffnung, gestülpt werden.“"
                            },
                            {
                                "example_id": "5820b9b7-4c54-462b-a1a0-7242d7ffcebd",
                                "sense_id": "eb615e0d-7c24-31fc-95fb-09974daa80c6",
                                "text": "„Durch Metallkappen am Ende der Metallhülsen werden diese Koaxialleitungen kurzgeschlossen und es bilden sich stehende Wellen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
