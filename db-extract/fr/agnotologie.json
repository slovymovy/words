                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2968dc9-8e43-389f-baa0-13114cfd4ee1",
                        "entry_id": "5ef93e80-c6a1-394b-982f-1522bd93f1f5",
                        "glosses": [
                            "Étude de la production et du maintien de l’ignorance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd3476a-0501-4d65-9bfd-09dc57f06ba2",
                                "sense_id": "e2968dc9-8e43-389f-baa0-13114cfd4ee1",
                                "text": "De telles affaires deviennent si banales et prévisibles qu’elles ont suscité la naissance, outre-Atlantique, d’une nouvelle discipline : l’agnotologie. Sorte d’anti-épistémologie, elle consiste à étudier la manière dont la société met en œuvre de puissants mécanismes d’oblitération du savoir."
                            },
                            {
                                "example_id": "2ebc101c-ab33-4b3f-91ea-3fdbf8df96a9",
                                "sense_id": "e2968dc9-8e43-389f-baa0-13114cfd4ee1",
                                "text": "Une équipe dédiée serait chargée, au sein de la compagnie, de rédiger des articles favorables aux produits de Monsanto qui sont ensuite repris à leur compte par ces scientifiques. Une criante production de désinformation, qui est loin de s’arrêter à la barrière des champs d’OGM. La science qui étudie ce phénomène se nomme l’agnotologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0e85859-1562-476b-821e-94de654d6870",
                        "source_entry_id": "5ef93e80-c6a1-394b-982f-1522bd93f1f5",
                        "source_sense_id": "e2968dc9-8e43-389f-baa0-13114cfd4ee1",
                        "target_lang_word": "Agnotologie",
