                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De scheidsrechter nam een <w>eerlijke</w> beslissing tijdens de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The referee made a <w>fair</w> decision during the match.",
                                "ru": "Судья принял <w>справедливое</w> решение во время матча.",
                                "pl": "Sędzia podjął <w>sprawiedliwą</w> decyzję podczas meczu.",
                                "de": "Der Schiedsrichter traf während des Spiels eine <w>faire</w> Entscheidung.",
                                "fr": "L'arbitre a pris une décision <w>juste</w> pendant le match.",
                                "it": "L'arbitro ha preso una decisione <w>giusta</w> durante la partita.",
                                "cs": "Rozhodčí udělal během zápasu <w>spravedlivé</w> rozhodnutí.",
                                "tr": "Hakem maç sırasında <w>adil</w> bir karar verdi.",
                                "es": "El árbitro tomó una decisión <w>justa</w> durante el partido.",
                                "zh": "裁判在比赛中做出了<w>公平</w>的判决。"
                            }
                        },
                        {
                            "text": "Het is niet <w>eerlijk</w> dat zij meer snoep krijgt dan ik.",
                            "target_lang_translations": {
                                "en": "It is not <w>fair</w> that she gets more candy than I do.",
                                "ru": "Это не <w>справедливо</w>, что она получает больше конфет, чем я.",
                                "pl": "To nie jest <w>sprawiedliwe</w>, że ona dostaje więcej słodyczy niż ja.",
                                "de": "Es ist nicht <w>fair</w>, dass sie mehr Süßigkeiten bekommt als ich.",
                                "fr": "Ce n'est pas <w>juste</w> qu'elle reçoive plus de bonbons que moi.",
                                "it": "Non è <w>giusto</w> che lei riceva più caramelle di me.",
                                "cs": "Není <w>spravedlivé</w>, že dostává víc sladkostí než já.",
                                "tr": "Ondan daha fazla şeker alması <w>adil</w> değil.",
                                "es": "No es <w>justo</w> que ella reciba más dulces que yo.",
                                "zh": "她拿的糖比我多，这不<w>公平</w>。"
                            }
                        }
