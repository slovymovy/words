                {
                    "sense_id": "f9516738-1834-3cd4-b8fd-79b5d51b8c7c",
                    "sense_definition": "een omgeving of situatie waarin iemand zich volledig op zijn gemak en thuis voelt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra hij op het podium staat, voelt hij zich helemaal in zijn <w>element</w>.",
                            "target_lang_translations": {
                                "en": "As soon as he is on stage, he feels completely in his <w>element</w>."
                            }
                        },
                        {
                            "text": "Zij voelde zich in haar <w>element</w> toen ze de hoogdravendheid van haar leraar imiteerde.",
                            "target_lang_translations": {
                                "en": "She felt in her <w>element</w> when she imitated her teacher's pomposity."
                            }
