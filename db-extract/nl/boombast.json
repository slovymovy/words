                            {
                                "example_id": "4e9a1fa8-e3c5-4ae0-80a3-ae9432eaeb36",
                                "sense_id": "d10356fc-f267-3b51-a555-716bef6e3b8e",
                                "text": "Er lag een sliert boombast over het pad."
