                "senses": [
                    {
                        "sense_id": "18ead363-c9a0-3ce1-bd03-210e87434a93",
                        "entry_id": "c9809254-930a-3d5b-a9e0-083b7338f8df",
                        "glosses": [
                            "Enlever son caractère confidentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb1de34-1c70-47d7-8e98-aaea9b7f22ca",
                                "sense_id": "18ead363-c9a0-3ce1-bd03-210e87434a93",
                                "text": "Démythifier, déconfidentialiser, dédramatiser l’écriture."
                            },
                            {
                                "example_id": "bd2f93b2-9ddb-4cca-b910-680667a4de76",
                                "sense_id": "18ead363-c9a0-3ce1-bd03-210e87434a93",
                                "text": "Étant observé que les Tribunaux, connaissance prise des lettres déconfidentialisées par le bâtonnier, n’étaient nullement liés par l’appréciation de celui-ci sur l’existence effective d’un accord qui l’avait conduit à autoriser l’avocat à produire les lettres."
                            },
                            {
                                "example_id": "314e0139-cd3e-41ba-bece-3e1f8dd356e4",
                                "sense_id": "18ead363-c9a0-3ce1-bd03-210e87434a93",
                                "text": "Il est possible de déconfidentialiser ces lettres dans des conditions précises fixées par l’art. 3.2 du Règlement Intérieur National."
                            }
                        ]
                    }
                ],
