                "senses": [
                    {
                        "sense_id": "bead81aa-5732-3489-b21a-a6b059235e61",
                        "entry_id": "ddc7aa2b-df83-3cca-ad75-d8ad99914c68",
                        "glosses": [
                            "Plan für die Zukunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c851cbd9-b3cd-481d-bb52-9c8430b7a700",
                                "sense_id": "bead81aa-5732-3489-b21a-a6b059235e61",
                                "text": "„Er wollte keine Zukunftspläne mehr machen und war sich gar nicht bewußt, daß er sich bereits entschieden hatte.“"
                            },
                            {
                                "example_id": "075bcaf6-b4cd-4ede-898b-6720e7f1514e",
                                "sense_id": "bead81aa-5732-3489-b21a-a6b059235e61",
                                "text": "„Und auch die Ruhe, um über ihre Zukunftspläne zu sprechen, fand Chrissi erst jetzt, ein paar Tage nach dem ausgelassenen Fest.“"
                            },
                            {
                                "example_id": "0049bf04-b9a8-4396-b066-86b8309822fa",
                                "sense_id": "bead81aa-5732-3489-b21a-a6b059235e61",
                                "text": "„Und zum ersten Male seit langer Zeit begann er glückliche Zukunftspläne zu schmieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
