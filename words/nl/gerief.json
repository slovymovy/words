            "senses": [
                {
                    "sense_id": "e2fab815-cb15-3757-91a9-83af0a9c7208",
                    "sense_definition": "Een staat van comfort of gemak.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>gerief</w> van een moderne woning is voor velen vanzelfsprekend.",
                            "target_lang_translations": {
                                "fr": "Le <w>confort</w> d'une habitation moderne est une évidence pour beaucoup."
                            }
                        },
                        {
                            "text": "Zij genoot van het <w>gerief</w> dat de nieuwe hotelkamer haar bood.",
                            "target_lang_translations": {
                                "fr": "Elle profitait du <w>confort</w> que lui offrait la nouvelle chambre d'hôtel."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "gemak"
                    ],
                    "antonyms": [
                        "ongerief"
                    ],
                    "target_lang_definitions": {
                        "fr": "État de confort ou de commodité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "confort",
                                "target_lang_sense_clarification": "état de bien-être matériel"
                            },
                            {
                                "target_lang_word": "commodité",
                                "target_lang_sense_clarification": "ce qui rend la vie plus facile ou agréable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f44ace74-1526-3c28-8978-9c9709f1a961",
                    "sense_definition": "Verzameling van benodigde voorwerpen of gereedschap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij pakte al zijn <w>gerief</w> in voor de lange kampeertocht.",
                            "target_lang_translations": {
                                "fr": "Il a emballé tout son <w>matériel</w> pour la longue randonnée en camping."
                            }
                        },
                        {
                            "text": "Het nodige <w>gerief</w> voor de reparatie lag verspreid over de werkbank.",
                            "target_lang_translations": {
                                "fr": "L'<w>équipement</w> nécessaire à la réparation était éparpillé sur l'établi."
                            }
                        }
                    ],
                    "synonyms": [
                        "gerei",
                        "gereedschap"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Ensemble d'objets ou d'outils nécessaires pour une activité."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "matériel",
                                "target_lang_sense_clarification": "ensemble d'objets nécessaires à une activité"
                            },
                            {
                                "target_lang_word": "équipement",
                                "target_lang_sense_clarification": "ensemble d'outils ou d'accessoires"
                            },
                            {
                                "target_lang_word": "attirail",
                                "target_lang_sense_clarification": "ensemble d'objets encombrants ou nombreux"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd863396-037b-391a-ab2d-6899101f5005",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>gerieven</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>gerief</w> mijzelf met de beschikbare middelen.",
                            "target_lang_translations": {
                                "fr": "Je me <w>satisfais</w> des moyens disponibles."
                            }
                        },
                        {
                            "text": "Ik <w>gerief</w> de gasten graag met een drankje.",
                            "target_lang_translations": {
                                "fr": "J'aime <w>servir</w> les invités avec un verre."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord gerieven."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe 'gerieven' (servir, satisfaire)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "satisfaire",
                                "target_lang_sense_clarification": "répondre aux besoins de quelqu'un"
                            },
                            {
                                "target_lang_word": "servir",
                                "target_lang_sense_clarification": "fournir ce qui est nécessaire"
                            }
                        ]
                    }
                }
            ]
        }
    ]
