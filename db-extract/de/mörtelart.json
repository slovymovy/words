                "senses": [
                    {
                        "sense_id": "ebc73b5c-6cca-3cb9-90bd-00b2944af118",
                        "entry_id": "eb17ac3f-6a73-3af0-a004-34e32c81d1cd",
                        "glosses": [
                            "bestimmte Sorte von Mörtel"
