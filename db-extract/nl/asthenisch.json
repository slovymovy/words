                        "examples": [
                            {
                                "example_id": "116bbe16-5151-44f7-a253-3be82db2c08c",
                                "sense_id": "e93ac4f3-cb8b-33d7-aa55-e68f649af466",
                                "text": "Dan valt hem de enige man van het gezelschap op, terzijde, als het ware afwerend, sober gekleed.. Hij heeft zijn benen in zwarte rijglaarzen over elkaar geslagen. Rutger denkt: zwarte rijglaarzen, zoals de boetepredikers in mijn roman droegen. De onbekende heeft ook hun benige, asthenische uiterlijk, als van Calvijn ten tijde van de Institutio. De zware handen liggen over elkaar gevouwen in zijn schoot. Er gaat een merkwaardige kalmte van hem uit. Geen gewone bezoeker."
                            }
                        ]
                    }
