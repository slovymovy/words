            {
                "entry_id": "e2ff4d72-9315-31c4-9f4c-f48438d750bc",
                "word": "chela",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2a81acb9-8253-4aba-b030-a5e7ada7ad22",
                        "entry_id": "e2ff4d72-9315-31c4-9f4c-f48438d750bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "chelas"
                    },
                    {
                        "form_id": "4ac9bb36-5822-48af-9d93-1d1dc5fade67",
                        "entry_id": "e2ff4d72-9315-31c4-9f4c-f48438d750bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "chele"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f027b511-e441-3bf7-9e08-a1bb3246866a",
                        "entry_id": "e2ff4d72-9315-31c4-9f4c-f48438d750bc",
                        "glosses": [
                            "A pupil or disciple, especially in Hinduism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2110e571-57bd-437e-a10e-867167a8571c",
                                "sense_id": "f027b511-e441-3bf7-9e08-a1bb3246866a",
                                "text": "In fact, Gilgamesh's instructions are still-valid directions from the guru to the chela."
                            },
                            {
                                "example_id": "a303faf0-d9c2-4075-ae13-5b0df29dd5a5",
                                "sense_id": "f027b511-e441-3bf7-9e08-a1bb3246866a",
                                "text": "The guru had insight. He understood his chela. The relationship between a guru and his chela was as a father to a son, as a whole person to a whole person, individual and unique."
                            },
                            {
                                "example_id": "24036bd9-c832-42f5-a225-642b2e572248",
                                "sense_id": "f027b511-e441-3bf7-9e08-a1bb3246866a",
                                "text": "The guru-chela relationship was a theme in many of Nicholas's paintings. In Pearl of Searching, the guru is looking thoughtfully at a pearl necklace with his chela. This symbolizes the \"pearl of great price\" that gives purpose to life."
                            },
                            {
                                "example_id": "d87a919d-2b3b-4a6d-b973-defd5419c6c6",
                                "sense_id": "f027b511-e441-3bf7-9e08-a1bb3246866a",
                                "text": "This, of course, is done by the guru as the result of a long process in which his consciousness must merge with that of the chela and wherein the chela is absorbed essentially into the guru."
                            }
                        ]
                    }
                ],
