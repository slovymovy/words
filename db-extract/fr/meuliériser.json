                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d3d3b1-ea9f-4eb0-8bf4-6503c1a0856f",
                                "sense_id": "82ef7ecd-b75b-3371-9432-5792cf3d995e",
                                "text": "Ces calcaires sont plus ou moins compacts, siliceux et marneux, et peuvent se meuliériser."
                            },
                            {
                                "example_id": "ebaae374-3183-4446-9733-28e69420dfcc",
                                "sense_id": "82ef7ecd-b75b-3371-9432-5792cf3d995e",
                                "text": "Cet étage est formé de calcaires plus ou moins compacts, siliceux et marneux (mollasse du Gâtinais), qui peuvent se meuliériser (meulière de Montmorency) et qui sont caractérisés, comme toutes les formations lacustres, par une faune à Gastéropodes dont les représentants les plus connus sont Helix Ramondi à la base (Chattien) et Helix Aurelianensis au sommet (Aquitanien proprement dit)."
                            }
                        ]
                    }
