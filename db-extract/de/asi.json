                    {
                        "form_id": "a014fee3-ca21-4d8c-99e6-839954468a0f",
                        "entry_id": "3ba0c186-012b-3c9a-80c6-db95dc41360d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Asis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                        "entry_id": "3ba0c186-012b-3c9a-80c6-db95dc41360d",
                        "glosses": [
                            "Asozialer"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9d3ca3b5-f79c-4815-9d5b-12c971e81709",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "Hau ab, du Asi!"
                            },
                            {
                                "example_id": "15b71982-e579-4868-9956-b9332bbcd28e",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "„Das Jugendamt kam, dann mußten wir Sozialhilfe beantragen. Ich war zum Asi geworden und wußte schon nicht mehr, wer ich bin.“"
                            },
                            {
                                "example_id": "9900c362-699e-4525-832f-a2f94a04495c",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "„Der Objektneid begegnete uns vornehmlich in Gestalt der Asis. Die Asis waren unmodisch angezogen, sahen aus irgendeinem Grund immer übernächtigt aus und hatten heisere Stimmen.“"
                            },
                            {
                                "example_id": "8a83ab78-d7a7-4ed3-8e9c-006e1bb13306",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "„Du Asi. Bist du irre?“"
                            },
                            {
                                "example_id": "d0e02c0b-3d47-4c34-89e3-978bbcdefa23",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "„Komm raus, du Asi, ich hau dich kaputt!“"
                            },
                            {
                                "example_id": "ef68fe3b-e120-4836-bea1-5231ee534289",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "„Ein Fall von Diskriminierung liegt vor, wenn man Sie einer marginalisierten Randgruppe zuordnet: «Du Asi», «Spast», «Hurensohn», «Politiker», «Kukidentler», «Pokemon» oder «Schattenparker».“"
                            },
                            {
                                "example_id": "4e59040c-292b-4402-9e3d-b12ea2704240",
                                "sense_id": "c642398a-a265-3bec-9b04-57d01cfcf696",
                                "text": "„Und er galt da als Asi!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
