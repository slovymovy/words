                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c563c8b7-1524-428b-a49a-e693098f0c2b",
                                                "sense_id": "cc2a13ea-b233-3ab5-9da8-9a97f610f8d0",
                                                "text": "On 26 April 1986 the reactor number four at the Chernobyl Nuclear Power Plant located in the Soviet Union near Pripyat in Ukraine exploded. Further explosions and the resulting fire sent a plume of highly radioactive fallout into the atmosphere and over an extensive geographical area."
                                            }
                                        ]
