                            "plural"
                        ],
                        "form": "legumins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38bd8345-07db-3886-89a9-1eadf78a5ff1",
                        "entry_id": "c1b94471-8864-3d64-9b5a-37e9ae4820c9",
                        "glosses": [
                            "Any of a group of globulins, resembling casein, found mostly in legumes and grains."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ea727a3-3aff-434e-b0ae-aba4277fe629",
                                "sense_id": "38bd8345-07db-3886-89a9-1eadf78a5ff1",
                                "text": "1843, Dumas, Cahours, On the Neutral Nitrogenous Matters of Organisation, Charles Watt, John Watt (editors), The Chemist, Volume 4 (Volume 1 of New Series), page 51,\nBy evaporation, a substance of a gummy appearance, susceptible of redissolving in water, is obtained, and which possesses the composition of legumin, as is shown by the following numbers:"
                            },
                            {
                                "example_id": "86986783-9a20-405f-99ce-ff7463d0f4d6",
                                "sense_id": "38bd8345-07db-3886-89a9-1eadf78a5ff1",
                                "text": "The legumin group includes edestin, glycinin, legumin from Vicia faba, arachin, and cocosin."
                            },
                            {
                                "example_id": "fefed2dc-5168-406c-829e-18fcfd8820ce",
                                "sense_id": "38bd8345-07db-3886-89a9-1eadf78a5ff1",
                                "text": "1991, A. H. Shirsat, 6: Control of gene expression in the developing seed, Don Grierson (editor), Developmental Regulation of Plant Gene Expression, Plant Biotechnology: Volume 2, page 158,\nThe 11S proteins of pea and soybean, the legumins and glycinins, have been extensively studied."
                            },
                            {
                                "example_id": "09556350-b9fe-4968-80b3-b85acf48bee2",
                                "sense_id": "38bd8345-07db-3886-89a9-1eadf78a5ff1",
                                "text": "2001, I. G., Plashchina, T. A. Mrashkovskaya, A. N. Danilenko, G. O. Kozhevnikov, N. Yu. Starodubrovskaya, E. E. Braudo, K. D. Schwenke, Complex Formation of Faba Bean Legumin with Chitosan: Surface Chemistry and Emilsion Properties of Complexes, Eric Dickinson, Reinhard Miller (editors), Food Colloids: Fundamentals of Formulation, Royal Society of Chemistry, UK, page 298,\nContrary to the behaviour of legumin, complex formation with chitosan either decreases or does not affect both the enthalpy and entropy of legumin-T denaturation (Table 3)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9095b89c-c032-48a0-a1d0-46befaacf647",
                        "source_entry_id": "c1b94471-8864-3d64-9b5a-37e9ae4820c9",
                        "source_sense_id": "38bd8345-07db-3886-89a9-1eadf78a5ff1",
                        "source_sense_description": "any of a group of globulins",
                        "target_lang_word": "Legumin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legumin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "860ad533-b0d0-35ac-8da8-b0b6d9708283",
                                        "entry_id": "1cd88d9c-c6da-3489-b263-124b32585e5d",
                                        "glosses": [
                                            "in Hülsenfrüchten und im Hafer gespeichertes Protein"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b683e0a7-dcd1-45d3-9c48-a81b8843653e",
                                                "sense_id": "860ad533-b0d0-35ac-8da8-b0b6d9708283",
                                                "text": "Legumin dient keimenden Samen als Stickstoffquelle."
                                            },
                                            {
                                                "example_id": "2011479d-2e21-465c-a235-537c96a684c1",
                                                "sense_id": "860ad533-b0d0-35ac-8da8-b0b6d9708283",
                                                "text": "Legumine sind heterohexamere Holoproteine mit einem Molekulargewicht von zirka 320 bis 400 Kilodalton."
                                            },
                                            {
                                                "example_id": "4bab5ff5-85bf-4b5c-8bf7-5fc520febb60",
                                                "sense_id": "860ad533-b0d0-35ac-8da8-b0b6d9708283",
                                                "text": "Dieser Bildung einer unauflöslichen Verbindung von Kalk und Legumin schreibt Braconnot das Hartwerden zu, welches bei den Hülsenfrüchten beim Kochen in hartem Wasser vorkommt, das schwefelsauren oder kohlensauren Kalk enthält."
                                            },
                                            {
                                                "example_id": "3c66943e-e2b2-4b95-ba04-a4fc12ab8fe3",
                                                "sense_id": "860ad533-b0d0-35ac-8da8-b0b6d9708283",
                                                "text": "OSBORNE wies nach, daß die Samen von Pisum sativum zwei Proteinfraktionen, Legumin und Vicelin, enthalten und ähnliche Proteine auch aus Samen anderer Leguminosen, wie Phaseolus vulgaris oder Glycine max, isolierbar sind."
                                            },
                                            {
                                                "example_id": "7588e497-7ff4-4204-a167-4df7e65b6c0d",
                                                "sense_id": "860ad533-b0d0-35ac-8da8-b0b6d9708283",
                                                "text": "Im Gegensatz zu den Leguminen und den Vicelinen, die in Samen vornehmlich in den Kotyledonen lokalisiert sind, sind die Prolamine im Endosperm enthalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
