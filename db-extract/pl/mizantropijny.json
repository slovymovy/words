                        "cross_references": []
                    },
                    {
                        "translation_id": "9d917892-b98d-4d3d-a4b3-d1a314761254",
                        "source_entry_id": "9728b9b7-48c4-30ed-9744-11f7772abeaf",
                        "source_sense_id": "ce059332-b480-3dd2-84ab-775841ba00c7",
                        "target_lang_word": "menschenfeindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menschenfeindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b72dc70f-bbe0-3da0-a332-f67e174e5699",
                                        "entry_id": "82ab1cd1-2b49-3d6c-8234-feacc9892658",
                                        "glosses": [
                                            "generell gegen grundlegende Bedürfnisse des Menschen gerichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a537afa-9468-4602-8ebe-6bf97d5d2777",
                                                "sense_id": "b72dc70f-bbe0-3da0-a332-f67e174e5699",
                                                "text": "„Da fehlt jede Spur des Verständnisses für die sich hinter solchen Fragen anbahnende Erkenntnis in der Bevölkerung, daß mit Anklagen, die sich auch gegen einen Modrow richten, irgendetwas nicht in Ordnung sein kann. Bei Friedrich Schorlemmer, diesem Vordenker gegen menschenfeindliche Staatsautorität, hätten Sie nachlesen können: Der Rechtsstaat nimmt Schaden, wenn er auf diese Weise politische Prozesse zu führen versucht. Vielleicht wird es Ihnen, meine Herren Staatsanwälte, und Ihrem Dienstherrn noch einmal leid tun, daß Sie nicht auf diese kritischen Stimmen gehört haben.“"
                                            },
                                            {
                                                "example_id": "1a773af3-719b-43b3-997d-737d7c14e5bc",
                                                "sense_id": "b72dc70f-bbe0-3da0-a332-f67e174e5699",
                                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33596284-984a-3bb3-a3aa-90b63fb33fa0",
                                        "entry_id": "82ab1cd1-2b49-3d6c-8234-feacc9892658",
                                        "glosses": [
                                            "ungesellig, misanthropisch"
                                        ],
