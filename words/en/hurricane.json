                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3dca874e-544d-3330-bc07-a7caae6940f3",
                    "sense_definition": "To move or enter a place in a noisy, fast, and dramatic way that commands attention.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hurricaned</w> into the room and started shouting orders at everyone.",
                            "target_lang_translations": {
                                "ru": "Она <w>влетела</w> в комнату как ураган и начала раздавать всем приказы."
                            }
                        },
                        {
                            "text": "The children <w>hurricaned</w> through the house, leaving a trail of toys behind.",
                            "target_lang_translations": {
                                "ru": "Дети <w>пронеслись</w> по дому ураганом, оставляя за собой след из игрушек."
                            }
                        }
                    ],
                    "synonyms": [
                        "storm",
                        "charge",
                        "rush"
                    ],
                    "antonyms": [
                        "tiptoe",
                        "creep"
                    ],
                    "common_phrases": [
                        "hurricaned into the room"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figurative usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или входить куда-либо шумно, быстро и драматично, привлекая к себе внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влететь ураганом",
                                "target_lang_sense_clarification": "о стремительном движении"
                            },
                            {
                                "target_lang_word": "пронестись",
                                "target_lang_sense_clarification": "о быстром и шумном перемещении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4291393a-af79-3d47-854e-e99d4645251f",
                    "sense_definition": "To blow or storm with the intensity and violence of a hurricane.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>hurricaned</w> all night, making it impossible for anyone to sleep.",
                            "target_lang_translations": {
                                "ru": "Всю ночь <w>бушевал ураган</w>, из-за чего никто не мог уснуть."
                            }
                        },
                        {
                            "text": "The wind <w>hurricaned</w> across the plains, flattening the tall grass.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>свирепствовал</w> над равнинами, пригибая к земле высокую траву."
                            }
                        }
                    ],
                    "synonyms": [
                        "storm",
                        "rage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дуть или бушевать с силой и неистовством урагана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушевать",
                                "target_lang_sense_clarification": "о ветре или шторме"
                            },
                            {
                                "target_lang_word": "свирепствовать",
                                "target_lang_sense_clarification": "о стихии"
                            }
                        ]
                    }
                }
            ]
        },
