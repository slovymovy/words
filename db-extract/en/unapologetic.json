                                        "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                        "entry_id": "539829e4-3c09-3e5d-b41a-ed31477d5e07",
                                        "glosses": [
                                            "keine innere Anteilnahme zeigend; emotional unbeeindruckt; gleichgültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfce9fa-827d-4a69-bced-66f5ddee52bd",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„O marmorhart und eisern muß er seyn / Der ungerührt, der ohne Mitleid dich / Gemartert sieht ….“"
                                            },
                                            {
                                                "example_id": "d4c53170-c6ab-4510-ba0b-c5e00ecbaeea",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„Mit dir ist meine Muse nicht vermählt; / Daher magst ungerührt du überseh’n / Die Widmungsworte, die der Dichter wählt ….“"
                                            },
                                            {
                                                "example_id": "9236a7d2-bb2b-4987-9aec-3758960c1ecb",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„[Eine Berbermaus-Mutter übernimmt die Pflege der Jungen einer anderen.] Die andere Mutter blieb nicht ungerührt, sie schloß Frieden mir ihrer Widersacherin und theilte sich mit ihr freundschaftlich in die Freuden und Leiden der Mutterschaft.“"
                                            },
                                            {
                                                "example_id": "0feaaacb-eb20-4a4e-8427-3901efe7e7c9",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„Sie müssen doch sehen, daß [Ihre] Thorheit … mich völlig ungerührt gelassen hat.“"
                                            },
                                            {
                                                "example_id": "7b800d93-4c22-4f76-bc99-4653eab6f031",
                                                "sense_id": "ec84567a-19cc-3dc6-b505-7bd14f9ab1e0",
                                                "text": "„»Wie heißen Sie?« fragte Karl, … zwar sehr höflich, aber gänzlich ungerührt …. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
