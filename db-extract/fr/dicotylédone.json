                        "form": "Dicotylédone"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                        "entry_id": "6b4dd730-ba13-3da8-9abc-5760eb45ef06",
                        "glosses": [
                            "Plante dont l’embryon a deux lobes ou cotylédons. Taxon paraphylétique. Nom scientifique : Magnoliopsida."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9229c245-d85b-4b8f-af8a-f325619a44ad",
                                "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                "text": "D'autres enfin, notamment l’acide 2-4-dichlorophénoxyacétique, l’acide 2-méthyl-4-chlorophénoxyacétique, etc., provoquent une intoxication sélective de certaines Phanérogames ; à dose convenable, elles détruisent la plupart des Dicotylédones, mais ne troublent pas le développement de nombreuses Monocotylédones, en particulier, elles n'agissent guère sur les Graminées."
                            },
                            {
                                "example_id": "0bbfe2e6-50f0-4145-aa91-f3deb87055be",
                                "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                "text": "Mais nous obtenons le même rendement en complétant le désherbage par une simple application de 2,4-D, ceci en l’absence de dicotylédones !"
                            },
                            {
                                "example_id": "836ebad1-1ad0-493e-8b7e-e197d58ba18e",
                                "sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                                "text": "La phytotoxicité du dichlobénil à l’égard des dicotylédones aussi bien que des monocotylédones a été reconnue en 1958."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56d1bfdf-bb8b-4449-be25-c3be3ee64472",
                        "source_entry_id": "6b4dd730-ba13-3da8-9abc-5760eb45ef06",
                        "source_sense_id": "f192cffd-9076-3793-bd2b-2d7636601396",
                        "target_lang_word": "zweikeimblättrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweikeimblättrig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f32e5fc0-0929-3e03-a86e-3e55704338cf",
                                        "entry_id": "5d288c56-a1d1-347c-9c65-b1aca706faba",
                                        "glosses": [
                                            "zwei Keimblätter ausbildend"
                                        ],
                                        "tags": [
                                            "Keimlingen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66dd8ab4-6569-4042-9678-9eecd19ff5b7",
                                                "sense_id": "f32e5fc0-0929-3e03-a86e-3e55704338cf",
                                                "text": "Zweikeimblättrige Pflanzen (Dicotyledonae), auch Dikotylen genannt, sind eine Klasse von Bedecktsamern."
                                            },
                                            {
                                                "example_id": "e5be48f7-ecb4-443a-b40d-773933c05e93",
                                                "sense_id": "f32e5fc0-0929-3e03-a86e-3e55704338cf",
                                                "text": "Die meisten Blütenpflanzen sind zweikeimblättrig. Einige Beispiel[e] für zweikeimblättrige Pflanzen sind Bohnen, Erbsen, Sonnenblumen, Rosen und Eichen."
                                            },
                                            {
                                                "example_id": "d615d58c-7239-4923-bd73-1e63ad761161",
                                                "sense_id": "f32e5fc0-0929-3e03-a86e-3e55704338cf",
                                                "text": "Die zweikeimblättrige Spossachse weist Leitbündel auf, die im Kreis angeordnet sind, einkeimblättrige Sprossachsen besitzen dagegen Leitbündel über den ganzen Sprossachsenquerschnitt verstreut."
                                            },
                                            {
                                                "example_id": "fdc64ca6-7e10-47ee-8ba1-7bcb6109f9ec",
                                                "sense_id": "f32e5fc0-0929-3e03-a86e-3e55704338cf",
                                                "text": "Eine größere wirtschaftliche Bedeutung haben lediglich 60 bis 80 [Unkrautarten], meist dikotyle (zweikeimblättrige) Pflanzenarten."
                                            },
                                            {
                                                "example_id": "0c4fb378-7c27-41b5-bcf4-4e972869929c",
                                                "sense_id": "f32e5fc0-0929-3e03-a86e-3e55704338cf",
                                                "text": "Zweikeimblättrige Unkräuter sind sowohl krautige als auch verholzende Planzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
