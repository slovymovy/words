                        "sense_id": "84282bba-97e8-377c-9d9d-cb481da34dcf",
                        "entry_id": "b03f9697-e54d-3456-8f57-82e292dceaee",
                        "glosses": [
                            "long-skirted"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976fd64b-4f03-411c-82a8-a5e4332ed58e",
                                "sense_id": "84282bba-97e8-377c-9d9d-cb481da34dcf",
                                "text": "Он был одет в длиннополый синий сюртук с пуговицами ниже зада и в высоких, сморщенных на щиколках и прямых на икрах сапогах, сверх которых были надеты большие калоши.",
                                "translation": "He was dressed in a long-skirted blue coat, with buttons below the waist at the back, and wore high boots wrinkled over the ankles and straight over the calf, with big galoshes drawn over them.",
                                "english": "He was dressed in a long-skirted blue coat, with buttons below the waist at the back, and wore high boots wrinkled over the ankles and straight over the calf, with big galoshes drawn over them."
                            }
                        ]
                    }
