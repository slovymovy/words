                        "sense_id": "a9dad994-0736-3678-af90-e9b3df92e5d7",
                        "entry_id": "fe91c32c-acd2-3946-a227-cb519fd4fc87",
                        "glosses": [
                            "orgaan dat een grote rol speelt in de stofwisseling van een gans Anser anser, na het slachten vaak gegeten als delicatesse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d90b67b-09e9-4266-aefb-6973e7ca1a4e",
                                "sense_id": "a9dad994-0736-3678-af90-e9b3df92e5d7",
                                "text": "Onze ganzenlever is trouwens bijzonder. Die komt uit de Extremadura, Spanje, van vrije uitloopganzen die zaden, gras en eikels eten. Totaal anders dan de Franse foie gras."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a0bbcbf-4c02-4101-84a3-b96b68c13a8f",
                        "source_entry_id": "fe91c32c-acd2-3946-a227-cb519fd4fc87",
                        "source_sense_id": "a9dad994-0736-3678-af90-e9b3df92e5d7",
                        "source_sense_description": "orgaan dat een grote rol speelt in de stofwisseling van een gans (Anser anser), na het slachten vaak gegeten als delicatesse",
                        "target_lang_word": "Gänseleber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gänseleber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d416527d-f3fa-382c-9bf2-026af8055858",
                                        "entry_id": "0217ce12-f991-3fce-b10e-7baad8b6d8b9",
                                        "glosses": [
                                            "die Leber einer Gans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09eccca9-ed55-4d3f-8ba9-167f11820c59",
                                                "sense_id": "d416527d-f3fa-382c-9bf2-026af8055858",
                                                "text": "Die Gans speichert die aufgenommenen Kalorien unter anderem als Fett in der Gänseleber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf60be96-9893-3b10-bf15-2be45cb087c8",
                                        "entry_id": "0217ce12-f991-3fce-b10e-7baad8b6d8b9",
                                        "glosses": [
                                            "als Speise zubereitete Gänseleber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d71d30-ffe9-4ac2-b73e-e8c24b430df4",
                                                "sense_id": "bf60be96-9893-3b10-bf15-2be45cb087c8",
                                                "text": "Als Vorspeise wurde uns gebratene Gänseleber in einer Sherrysoße serviert."
                                            },
                                            {
                                                "example_id": "f536ba22-af53-40e6-81db-96086e01bd7e",
                                                "sense_id": "bf60be96-9893-3b10-bf15-2be45cb087c8",
                                                "text": "„Sonntags kochte Maria eine Suppe mit Gänseleber.“"
                                            },
                                            {
                                                "example_id": "e1b19698-0a00-4c63-aa39-2a4706855b83",
                                                "sense_id": "bf60be96-9893-3b10-bf15-2be45cb087c8",
                                                "text": "„Ich dankte ihm für das Muschelgericht und teilte ihm mit, daß ich das Privileg hätte, alle Tage Fleisch und Fastenspeisen zu essen; vor allem solle er die Gänseleber nicht vergessen.“"
                                            },
                                            {
                                                "example_id": "f33f7aac-3ec2-42d2-8a3b-62a4c130c577",
                                                "sense_id": "bf60be96-9893-3b10-bf15-2be45cb087c8",
                                                "text": "„Ich beschloß trotz allem, mir ebenfalls Gänseleber zu bestellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
