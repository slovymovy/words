                "senses": [
                    {
                        "sense_id": "8af6f07b-665b-36c2-947e-7aa680eae88e",
                        "entry_id": "5aea8f50-0f68-3ceb-8a1a-5299b5c99635",
                        "glosses": [
                            "Relatif à un épisode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8162cb49-9864-4d7a-aae0-23f664649907",
                                "sense_id": "8af6f07b-665b-36c2-947e-7aa680eae88e",
                                "text": "Une scène épisodique."
                            },
                            {
                                "example_id": "4e5c4268-28b7-4abe-84ad-aa5975024055",
                                "sense_id": "8af6f07b-665b-36c2-947e-7aa680eae88e",
                                "text": "Un personnage épisodique."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c585e34-427a-3fbc-861e-62b9ff77708d",
                        "entry_id": "5aea8f50-0f68-3ceb-8a1a-5299b5c99635",
                        "glosses": [
                            "Qui apparaît de temps en temps et irrégulièrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62af26dd-a936-4358-932d-ec83c1944478",
                                "sense_id": "3c585e34-427a-3fbc-861e-62b9ff77708d",
                                "text": "Notre moniteur avait entretenu une liaison épisodique avec Sylvia du temps où elle habitait en région parisienne."
                            },
                            {
                                "example_id": "e70e6c0a-e8e1-4053-9e26-f21ba45575e6",
                                "sense_id": "3c585e34-427a-3fbc-861e-62b9ff77708d",
                                "text": "En dépit de ces avertissements, les villes de la vieille Europe ont mis du temps à prendre la menace au sérieux, à comprendre qu’elle était chronique, et non plus épisodique, et qu’il fallait agir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82406a08-145d-4fe7-8d12-475ef323c02d",
                        "source_entry_id": "5aea8f50-0f68-3ceb-8a1a-5299b5c99635",
                        "target_lang_word": "episodic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
