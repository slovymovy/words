                "senses": [
                    {
                        "sense_id": "54eea7da-6fe0-36d3-b839-93b415dc0011",
                        "entry_id": "732d3bf5-c3f4-3873-9839-4a0069edd287",
                        "glosses": [
                            "door een draaiende beweging over een oppervlakte ergens anders naartoe bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b0281b-b693-49ce-a1a3-76e2ecdee3cc",
                                "sense_id": "54eea7da-6fe0-36d3-b839-93b415dc0011",
                                "text": "„Water is zwaar en sterk. Als je maar één slang gebruikt, rolt die weg”, legt Bon uit. „Twee slangen houden elkaar tegen waardoor ze niet wegrollen. Een afdichtzeil over het net zorgt er tenslotte voor dat het water niet onder de dijk door gaat.”"
                            },
                            {
                                "example_id": "7c74a74e-0603-4c76-8169-5271a1a3482a",
                                "sense_id": "54eea7da-6fe0-36d3-b839-93b415dc0011",
                                "text": "Het Italiaans-Amerikaanse autoconcern Fiat Chrysler roept wereldwijd meer dan 1,1 miljoen auto's terug naar de garage vanwege een probleem met de versnellingsbak. Daardoor kunnen de auto's wegrollen nadat de bestuurder is uitgestapt."
                            }
                        ]
                    }
                ],
