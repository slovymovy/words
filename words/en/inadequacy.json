{
    "word_family": [
        "adequate",
        "adequately"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57ec96e3-7f90-3bce-9507-a257adbf3a27",
                    "sense_definition": "The state of not being good enough or sufficient for a particular purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_insufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inadequacy</w> of the current security system was exposed during the recent break-in.",
                            "target_lang_translations": {
                                "es": "La <w>inadecuación</w> del sistema de seguridad actual quedó al descubierto durante el reciente robo."
                            }
                        },
                        {
                            "text": "Management acknowledged the <w>inadequacy</w> of the training program for new employees.",
                            "target_lang_translations": {
                                "es": "La dirección reconoció la <w>deficiencia</w> del programa de capacitación para los nuevos empleados."
                            }
                        }
                    ],
                    "synonyms": [
                        "deficiency",
                        "insufficiency"
                    ],
                    "antonyms": [
                        "adequacy"
                    ],
                    "common_phrases": [
                        "clear inadequacy",
                        "obvious inadequacy"
                    ],
                    "target_lang_definitions": {
                        "es": "El estado de no ser lo suficientemente bueno, apto o adecuado para un propósito determinado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "inadecuación",
                                "target_lang_sense_clarification": "falta de idoneidad o conveniencia"
                            },
                            {
                                "target_lang_word": "insuficiencia",
                                "target_lang_sense_clarification": "condición de no bastar o no ser suficiente"
                            },
                            {
                                "target_lang_word": "deficiencia",
                                "target_lang_sense_clarification": "falta de calidad requerida"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14bcb1b3-138d-3ffc-914d-72208241c69a",
                    "sense_definition": "A lack of the necessary skills, competence, or ability to perform a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_insufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled with a deep sense of <w>inadequacy</w> when faced with complex technical problems.",
                            "target_lang_translations": {
                                "es": "Luchó contra un profundo sentimiento de <w>inseguridad</w> al enfrentarse a problemas técnicos complejos."
                            }
                        },
                        {
                            "text": "Her <w>inadequacy</w> in public speaking made her nervous about the upcoming presentation.",
                            "target_lang_translations": {
                                "es": "Su <w>falta de aptitud</w> para hablar en público la ponía nerviosa por la próxima presentación."
                            }
                        }
                    ],
                    "synonyms": [
                        "incompetence",
                        "inability",
                        "incapability"
                    ],
                    "common_phrases": [
                        "feel inadequacy",
                        "sense of inadequacy"
                    ],
                    "target_lang_definitions": {
                        "es": "Falta de habilidades, competencia o capacidad necesarias para realizar una tarea o sentirse competente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "incompetencia",
                                "target_lang_sense_clarification": "falta de capacidad para realizar una labor"
                            },
                            {
                                "target_lang_word": "incapacidad",
                                "target_lang_sense_clarification": "carencia de aptitud o preparación"
                            },
                            {
                                "target_lang_word": "inseguridad",
                                "target_lang_sense_clarification": "sentimiento de no ser suficiente (en sense of inadequacy)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4381df1b-12a9-3c86-8f87-b8676f425bfe",
                    "sense_definition": "A shortage or insufficient amount of required material or resources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_insufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inadequacy</w> of food supplies led to a crisis in the refugee camp.",
                            "target_lang_translations": {
                                "es": "La <w>escasez</w> de suministros de alimentos provocó una crisis en el campo de refugiados."
                            }
                        },
                        {
                            "text": "They could not finish the project due to the <w>inadequacy</w> of available funding.",
                            "target_lang_translations": {
                                "es": "No pudieron terminar el proyecto debido a la <w>insuficiencia</w> de los fondos disponibles."
                            }
                        }
                    ],
                    "synonyms": [
                        "deficiency",
                        "insufficiency"
                    ],
                    "antonyms": [
                        "plenty"
                    ],
                    "common_phrases": [
                        "resource inadequacy",
                        "funding inadequacy"
                    ],
                    "target_lang_definitions": {
                        "es": "Escasez o cantidad insuficiente de materiales o recursos necesarios."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "insuficiencia",
                                "target_lang_sense_clarification": "escasez de recursos o fondos"
                            },
                            {
                                "target_lang_word": "escasez",
                                "target_lang_sense_clarification": "falta de lo necesario en cantidad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}