                ],
                "senses": [
                    {
                        "sense_id": "e4a8f7bb-7f65-3e4e-92c1-aef2a7a579cb",
                        "entry_id": "cb433838-51bf-3fb7-bd5a-f58a240a711e",
                        "glosses": [
                            "Consonne dont le lieu d'articulation se situe au niveau du palais et dont l'organe constricteur est la pointe de la langue, dirigée vers le haut et l'arrière de la bouche."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "5d23fbea-1069-440f-b56e-c15e0cdbb317",
                                "sense_id": "e4a8f7bb-7f65-3e4e-92c1-aef2a7a579cb",
                                "text": "Le souci d’indiquer la dynamique et les possibilités d’évolution du système m’a amené à présenter la série des aspirés, la vibrante, la rétroflexe et la latérale aux extrémités supérieures et inférieures de la représentation."
                            },
                            {
                                "example_id": "acadb71c-c00f-4d6b-a2af-ed135f7983eb",
                                "sense_id": "e4a8f7bb-7f65-3e4e-92c1-aef2a7a579cb",
                                "text": "Les rétroflexes existaient en sanskrit et se rencontrent fréquemment dans les langues modernes de l’Inde."
                            },
                            {
                                "example_id": "d3af1136-9500-429d-b597-f24e1bd09428",
                                "sense_id": "e4a8f7bb-7f65-3e4e-92c1-aef2a7a579cb",
                                "text": "Les rétroflexes sont répandues dans les langues indoeuropéennes (hindî entre autres) et dravidiennes, ainsi qu'en mandarin, en suédois ou en norvégien."
                            }
                        ]
                    }
                ],
