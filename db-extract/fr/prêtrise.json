                    {
                        "translation_id": "e64765ec-e8da-4272-8100-36c48c29fd1d",
                        "source_entry_id": "bc7f3584-39dd-38ac-9d83-a53d4830e122",
                        "source_sense_id": "406416d5-147c-3296-a94c-b787c3ef44c2",
                        "target_lang_word": "священство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "священство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5510c689-1fcb-3a09-b560-b4cc1ec6660e",
                                        "entry_id": "d238c8f1-861b-3346-978e-da15a5bd2afa",
                                        "glosses": [
                                            "религ. божественная сила, священная благодать, полученная священнослужителем при посвящении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e71a5f5-0495-437e-a5f3-377c898675ea",
                                                "sense_id": "5510c689-1fcb-3a09-b560-b4cc1ec6660e",
                                                "text": "Мысль о превосходстве священства над царством, которую проповедовал Никон, не была новой ― она заложена ещё в Священном Писании"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c4b6a6a-f94f-36c5-be16-b198a713ff4b",
                                        "entry_id": "d238c8f1-861b-3346-978e-da15a5bd2afa",
                                        "glosses": [
                                            "религ. сан, звание священника."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34a5064-ab41-4125-a105-c5bb4f60aa27",
                                                "sense_id": "3c4b6a6a-f94f-36c5-be16-b198a713ff4b",
                                                "text": "Когда в 599 году папа Григорий Великий узнал, что один из епископов предпринимает попытки обучить грамматике некоторых сограждан, он отчитал его: «Мы узнали, что Ваше Священство обучало некоторых прихожан грамматике»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "588752ce-357b-37cf-8a73-42b8b61a7be0",
                                        "entry_id": "d238c8f1-861b-3346-978e-da15a5bd2afa",
                                        "glosses": [
                                            "религ. посвящение в сан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde767c1-33d3-44ad-a235-5a39c68f10b0",
                                                "sense_id": "588752ce-357b-37cf-8a73-42b8b61a7be0",
                                                "text": "По совету старца, он не делается монахом, а лишь священником. В то время многие люди из интеллигенции принимают священство ― П. Флоренский, С. Булгаков, Вл. Соловьев, С. Дурилин и др."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4fe2cf4-b860-3676-a7c9-48ccae3abf3a",
                                        "entry_id": "d238c8f1-861b-3346-978e-da15a5bd2afa",
                                        "glosses": [
                                            "религ. деятельность священника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "008aa8a1-7da9-4023-b3fa-2dc533088a4f",
                                                "sense_id": "e4fe2cf4-b860-3676-a7c9-48ccae3abf3a",
                                                "text": "Я говорю сейчас не о священстве, не о монашестве, ни о чем формальном, а просто чтобы быть человеком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c11fa07b-6840-3d93-8b40-97b13e3629d3",
                                        "entry_id": "d238c8f1-861b-3346-978e-da15a5bd2afa",
                                        "glosses": [
                                            "собир. священники, священнослужители"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c9d96e-c9d5-43ed-901d-877c00ca5f02",
                                                "sense_id": "c11fa07b-6840-3d93-8b40-97b13e3629d3",
                                                "text": "Все два года не молчал патриарх Тихон ― слал послания народным комиссарам, и священству, и пастве; его послания (вот где первый Самиздат!) не взятые типографиями, печатались на машинках…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
