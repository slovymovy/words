                "senses": [
                    {
                        "sense_id": "8a5333c9-d502-3840-a3cc-d7d1631ba5e7",
                        "entry_id": "48d4fb86-d1c8-3f7d-821e-11b570f11b54",
                        "glosses": [
                            "Person, die verdeckt/im Geheimen („im Untergrund“) einen, meist bewaffneten, Konflikt gegen jemanden austrägt; Angehöriger einer Untergrundbewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19363112-a4b0-4e9e-91d3-b15c9138b378",
                                "sense_id": "8a5333c9-d502-3840-a3cc-d7d1631ba5e7",
                                "text": "„Auch innerhalb der russischen Grenzen, etwa in Dagestan östlich von Tschetschenien, sind Untergrundkämpfer aktiv.“"
                            },
                            {
                                "example_id": "fcc2802b-6b33-48f7-8197-4bedd27c36b3",
                                "sense_id": "8a5333c9-d502-3840-a3cc-d7d1631ba5e7",
                                "text": "„Sie stellte sich vor, daß er diese Gelegenheit, noch einmal, ein letztesmal, ehe der Faschismus fiel, als Untergrundkämpfer aufzutreten, nicht vorbeigehen lassen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
