                "senses": [
                    {
                        "sense_id": "98cb348e-60ee-348c-a431-6d48b9efb071",
                        "entry_id": "2134acbb-9a7d-3c13-9135-79645e6a4eba",
                        "glosses": [
                            "свойство по значению прилагательного выносливый; способность переносить нагрузки и неблагоприятные условия, выполнять работу и т. п. в течение длительного времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c44516b-519b-4155-8d36-2db57696f374",
                                "sense_id": "98cb348e-60ee-348c-a431-6d48b9efb071",
                                "text": "⟨…⟩ черты, состоявшие из бесхитростной, наивной веры, ясного, добродушно-весёлого взгляда на жизнь, холодной и деловой отваги, покорства перед лицом смерти, жалости к побеждённому, бесконечному терпению и поразительной физической и нравственной выносливости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b9d2e13-8257-4049-86c1-7c5728cf6549",
                        "source_entry_id": "2134acbb-9a7d-3c13-9135-79645e6a4eba",
                        "source_sense_id": "98cb348e-60ee-348c-a431-6d48b9efb071",
                        "target_lang_word": "endurance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endurance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce01f58e-ca09-333f-b99e-9f0b73800420",
                                        "entry_id": "9d7c3958-788f-34d1-949f-d5d975bee411",
                                        "glosses": [
                                            "The measure of a person's stamina or persistence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "319a518b-d3ce-4d07-9a8e-a9b43fc2bd3d",
                                                "sense_id": "ce01f58e-ca09-333f-b99e-9f0b73800420",
                                                "text": "He has great endurance: he ran a marathon and then cycled home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0918887e-67c9-3729-8969-2dd1137ef53e",
                                        "entry_id": "9d7c3958-788f-34d1-949f-d5d975bee411",
                                        "glosses": [
                                            "An ability to endure hardship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7af252ce-3891-31f5-9567-cba59eefa3d0",
                                        "entry_id": "9d7c3958-788f-34d1-949f-d5d975bee411",
                                        "glosses": [
                                            "The length of time that a ship's rations will supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0e105c3-4bae-42ce-9d23-8fa32529f220",
                        "source_entry_id": "2134acbb-9a7d-3c13-9135-79645e6a4eba",
                        "source_sense_id": "98cb348e-60ee-348c-a431-6d48b9efb071",
                        "target_lang_word": "stamina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stamina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                        "entry_id": "c90f4859-5bc9-3073-a438-a79c8b6bedab",
                                        "glosses": [
                                            "The energy and strength for continuing to do something over a long period of time; power of sustained exertion, or resistance to hardship, illness etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98451ee-c4a4-4950-b40d-654acce79843",
                                                "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                                "text": "He has a lot of stamina. I suppose that's why he can run for a long time."
                                            },
                                            {
                                                "example_id": "dc1a710e-7982-44c1-adb0-2bb8c3404aa7",
                                                "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                                "text": "In the first five minutes muscles which he had not been aware that he possessed had started to ache like neglected teeth. His respect for the toughness and durability of artists' models was now solid. How they acquired the stamina to go through this sort of thing all day and then bound off to Bohemian revels at night was more than he could understand."
                                            },
                                            {
                                                "example_id": "f002f031-20b7-4471-9894-1f8eb4479301",
                                                "sense_id": "d9a252b4-1f8b-34bb-9b60-b4571fd28ba3",
                                                "text": "Yes, gas, price of energy, food, even interest rates are rising, so that means tough times for households. It's often thought that Europeans or we Western people are used to, let's say, to a life which goes always to better and better and thus that we are very weak to face difficulties. But I would say that Ukrainians gave an excellent example that there is stamina amongst people when difficulties come. And difficulties which we are facing are minor if compared to those Ukrainians are meeting. So, I believe that we European people can take it and have resilience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7205072-e209-322a-a481-569e527b61d5",
                                        "entry_id": "c90f4859-5bc9-3073-a438-a79c8b6bedab",
                                        "glosses": [
                                            "The basic elements of a thing; rudimentary structures or qualities."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "plural",
                                            "plural-only",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stamina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                                        "entry_id": "9f99843c-0281-3950-9ad3-3def51fbeeda",
                                        "glosses": [
                                            "plural of stamen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aaf4c2d-8bce-4e4e-bd47-f2e7ec1c5acd",
                                                "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                                                "text": "1790, William Curtis, The Botanical Magazine, Or, Flower-Garden Displayed, Volume 3, 2006 Gutenberg eBook edition,\nIn the specimens we have examined, and which perhaps have been rendered luxuriant by culture, the number of stamina has been from twelve to sixteen; of styles, from six to eight; of flowers on the same stalk, from one to eight."
                                            },
                                            {
                                                "example_id": "caa15535-1b5f-4ba9-945d-8984a90a3d07",
                                                "sense_id": "0ab2735f-800c-38fc-8924-893cf796256a",
                                                "text": "1832 December 8, Spirit of Discovery, in The Mirror of Literature, Amusement, and Instruction, Number 579, 2005 Gutenberg eBook edition,\nThe gay flowers of the hibiscus tiliaceus, as well as the splendid huth or Barringtonia speciosa, covered with its beautiful flowers, the petals of which are white, and the edges of the stamina delicately tinged with pink, give to the trees when in full bloom a magnificent appearance; the hibiscus rosa-chinensis, or kowa of the natives also grows in luxuriance and beauty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e73a06e9-8f5a-4147-91b4-66ad993f5015",
                        "source_entry_id": "2134acbb-9a7d-3c13-9135-79645e6a4eba",
                        "source_sense_id": "98cb348e-60ee-348c-a431-6d48b9efb071",
                        "target_lang_word": "hardiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hardiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "583b891a-60e8-3ed7-ba48-5fdffc1716a0",
                                        "entry_id": "0d1dc0ae-1515-3bf1-a19f-cccc4abf0292",
                                        "glosses": [
                                            "The quality of being hardy.",
                                            "The quality of being able to withstand fatigue and hardship; (of a plant) the quality of being resistant to cold or other environmental conditions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e52a17-074d-47a4-a5b3-19377eb55f64",
                                                "sense_id": "583b891a-60e8-3ed7-ba48-5fdffc1716a0",
                                                "text": "Kale is known for its winter-hardiness."
                                            },
                                            {
                                                "example_id": "c0cb312f-ad08-45bf-b7bd-e9cee87681b7",
                                                "sense_id": "583b891a-60e8-3ed7-ba48-5fdffc1716a0",
                                                "text": "[…] with usefull and generous labours preserving the bodies health, and hardinesse; to render lightsome, cleare, and not lumpish obedience to the minde,"
                                            },
                                            {
                                                "example_id": "364f81cb-01b8-4118-84a0-3ee0a9b56813",
                                                "sense_id": "583b891a-60e8-3ed7-ba48-5fdffc1716a0",
                                                "text": "But the Houynhnhnms train up their Youth to Strength, Speed, and Hardineſs, by exerciſing them in running Races up and down ſteep Hills, and over hard and ſtony Grounds […]"
                                            },
                                            {
                                                "example_id": "d0539af4-da88-424a-bb80-4607669e7f71",
                                                "sense_id": "583b891a-60e8-3ed7-ba48-5fdffc1716a0",
                                                "text": "Wild wheat is small and hard, quite capable of looking after itself, but its heads contain only a few small kernels. Cultivated wheat has lost its hardiness and its self-reliance, but its heads are filled with large kernels which feed the nation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64aba181-6028-3731-87db-a521c6c9de81",
                                        "entry_id": "0d1dc0ae-1515-3bf1-a19f-cccc4abf0292",
                                        "glosses": [
                                            "The quality of being hardy.",
                                            "The quality of being bold in the face of risk or authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39911f7c-8002-4799-96a5-42204f4883f6",
                                                "sense_id": "64aba181-6028-3731-87db-a521c6c9de81",
                                                "text": "Plentie, and Peace breeds Cowards: Hardneſſe euer / Of Hardineſſe is Mother."
                                            },
                                            {
                                                "example_id": "28769469-9377-45e7-a3e9-e90cd640bdde",
                                                "sense_id": "64aba181-6028-3731-87db-a521c6c9de81",
                                                "text": "[…] they who were not yet grown to the hardineſs of Avowing the contempt of the King […] would ſooner have been checked, and recovered their Loyalty and Obedience."
                                            },
                                            {
                                                "example_id": "e6cfd8a8-1767-4990-8c44-59ed0bfae5c2",
                                                "sense_id": "64aba181-6028-3731-87db-a521c6c9de81",
                                                "text": "[…] for every sorrow that his heart turned from, he lost a consolation; for every fear which he dared not confront, he lost a portion of his hardiness; the unsceptred sweep of the storm-clouds, the fair freedom of glancing shower and flickering sunbeam, sank into sweet rectitudes and decent formalisms;"
