                                            {
                                                "example_id": "fd726bbd-a848-4dfd-8394-29adacd40a49",
                                                "sense_id": "b8e00d93-2568-35ae-8e5b-2989b2b32cbb",
                                                "text": "Barwa opalu jest bardzo różna, lecz najczęściej spotyka się mlecznobiałe lub bezbarwne. Niektóre opale ze względu na piękną barwę lub grę barw, tzw. opalescencję, są zaliczane do kamieni ozdobnych i szlachetnych"
                                            }
