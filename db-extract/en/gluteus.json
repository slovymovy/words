                    {
                        "sense_id": "bb2274bc-a6a6-3d03-b321-269caf325242",
                        "entry_id": "f02a5a58-1b76-30a3-9520-36a070148d84",
                        "glosses": [
                            "Any of the several muscles of the nates, each of which arises from the pelvis and inserts into a femur."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7a4d8b24-d7f2-3847-ac02-ce546e37596e",
                        "entry_id": "f02a5a58-1b76-30a3-9520-36a070148d84",
                        "glosses": [
                            "Short for gluteus maximus, either of a pair of large muscles in the human buttocks."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "informal",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1cf2769e-cb87-4847-af51-23215f66a9f7",
                                "sense_id": "7a4d8b24-d7f2-3847-ac02-ce546e37596e",
                                "text": "I'm going to kick your gluteus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f1e6eaf-e412-4586-b744-46d097dc420e",
                        "source_entry_id": "f02a5a58-1b76-30a3-9520-36a070148d84",
                        "source_sense_description": "(anatomy) one of the several muscles of nates",
                        "target_lang_word": "fessier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fessier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4114dc9b-ccfc-325b-bcc1-0c1550e84fe6",
                                        "entry_id": "0e35fb1d-051d-37e8-bb40-e967e895dd14",
                                        "glosses": [
                                            "Relatif aux fesses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc1adbc-6597-4e43-a323-39be6ee5704b",
                                                "sense_id": "4114dc9b-ccfc-325b-bcc1-0c1550e84fe6",
                                                "text": "L’hirsutisme est le développement excessif de la pilosité chez la femme dans les territoires androgéno-dépendants qui en sont habituellement dépourvus : visage, thorax, ligne blanche, région fessière et intergénitocrurale."
                                            },
                                            {
                                                "example_id": "c12cd804-4f9b-44bd-a460-cb3ad7c08dc9",
                                                "sense_id": "4114dc9b-ccfc-325b-bcc1-0c1550e84fe6",
                                                "text": "On tourna le dos à l'Hôtel des monnaies, la vainqueresse musardait, feignant de rien deviner de mes émois ni de la captivité dans laquelle, d'un inimitable balancement fessier, elle m'avait jeté."
                                            },
                                            {
                                                "example_id": "757e0291-fd13-49e1-ae0d-2dfff5e3fab6",
                                                "sense_id": "4114dc9b-ccfc-325b-bcc1-0c1550e84fe6",
                                                "text": "Jouer fessier : Jouer avec grande prudence et effort minimal. S’utilise surtout aux cartes, et par extension à d’autres jeux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fessier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                        "entry_id": "aeb3b384-c070-3cbb-a19c-22c1d3df9eb9",
                                        "glosses": [
                                            "Les fesses de l’homme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e7509d7-d552-41ff-ad12-58c7ecb53597",
                                                "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                                "text": "Puis il y a eu le duel des équipes de pom-poms girls pour chauffer la salle, et pour la première fois depuis le lycée, je n'ai pas bandé en les regardant dandiner leurs jolis fessiers au rythme de la musique. Pourtant, nos nanas sont toutes chaudes comme la braise."
                                            },
                                            {
                                                "example_id": "68ad9591-fc8a-4a8a-a469-b552be72895f",
                                                "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                                "text": "Avec des gradins déserts et la perspective angoissante de ramener les fessiers à 200 $ la craque des les sièges vides, les patrons du Canadien n'ont pas le choix."
                                            },
                                            {
                                                "example_id": "2be5c7ce-1ee8-45f6-8b0a-b0ca0d0fbdaa",
                                                "sense_id": "c81b1045-962b-333b-a678-8d252e729a99",
                                                "text": "Des amasseuses qui prennent leur fessier pour une tirelire !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9e999e-4a19-3b4a-ab9e-021051749c7d",
                                        "entry_id": "aeb3b384-c070-3cbb-a19c-22c1d3df9eb9",
                                        "glosses": [
                                            "Chacun des muscles fessiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9813bf-2453-416b-8ce2-3a4d1c8067c2",
                                                "sense_id": "1b9e999e-4a19-3b4a-ab9e-021051749c7d",
                                                "text": "Le grand fessier et le petit fessier."
                                            },
                                            {
                                                "example_id": "51428451-73b6-422c-9216-c6f178edad48",
                                                "sense_id": "1b9e999e-4a19-3b4a-ab9e-021051749c7d",
                                                "text": "Le fessier superficiel du cheval (m. gluteus superficialis)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
