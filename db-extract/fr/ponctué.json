                        "glosses": [
                            "Qualifie une ligne, un trait formés d’une suite de points."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1d960a-d826-4e53-8116-9b211221fd85",
                                "sense_id": "19afb7a2-a2e1-307c-8075-07b2773d6537",
                                "text": "Dans les cartes géographiques, on indique ordinairement les limites par des lignes ponctuées."
                            }
                        ]
                    }
