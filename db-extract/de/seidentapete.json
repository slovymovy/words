                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b444e0d-8339-417d-b18a-34fb52beb7f6",
                                "sense_id": "f4c1880b-1a88-3718-862a-58e653236d8d",
                                "text": "„Im Gebäude befinden sich prunkvolle Räume mit Spiegelwänden, Deckengemälden und Seidentapeten.“"
                            },
                            {
                                "example_id": "0142dd1a-69d7-4d27-a259-f394d47c3a1c",
                                "sense_id": "f4c1880b-1a88-3718-862a-58e653236d8d",
                                "text": "„In einem Umkleidezimmer mit rosafarbenen Seidentapeten traf Thomas Lieven den Major Loos, der einen schicken neuen Anzug aus dunklem Flanell trug.“"
                            }
                        ],
