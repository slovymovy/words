                        "glosses": [
                            "dünne Ziegelscheiben zur Fassadenverkleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a766ef-3377-4dcc-9b5a-7e8051da8933",
                                "sense_id": "d6ce5769-5539-3102-89a6-c5ff6157e3d8",
                                "text": "„Häufig werden Klinkerriemchen in einen Topf mit Fliesen und Platten, also feinkeramischen Erzeugnissen, geworfen. Ein weit verbreiteter Irrtum, denn Klinkerriemchen sind dünne, aber vollwertige Verblendklinker, die damit zur Grobkeramik gehören.”"
                            },
                            {
                                "example_id": "5f5b2173-ffca-4ff6-a8ce-13ddc4113051",
                                "sense_id": "d6ce5769-5539-3102-89a6-c5ff6157e3d8",
                                "text": "„Die Außenfassaden im zweigeschossigen Bereich erhalten ihre Gestaltung durch eine Verkleidung mit verschieden großen Klinkerriemchen.”"
                            }
                        ],
                        "sense_index_json": "\"1\""
