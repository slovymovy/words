                            {
                                "example_id": "2749ce07-4bff-40c1-968c-26cd5a377e8f",
                                "sense_id": "77de1a5a-0bce-3aa5-aac6-caa5181b0d66",
                                "text": "„Eine Woche später kreuzte sie mit einer Karte in der Hand bei unserem Date auf und veranstaltete ein Riesendrama.“"
                            },
                            {
                                "example_id": "b76bceff-bc02-4364-91be-4d61613a6215",
                                "sense_id": "77de1a5a-0bce-3aa5-aac6-caa5181b0d66",
                                "text": "„›Sie können sich gar nicht vorstellen, Mary‹, sagte sie, ›wie die Frau hinter Rajeev her war. Macht ein Riesendrama, wie unglücklich sie in ihrer Ehe sei - alles im Restaurant Indigo, sie im kleinen Schwarzen.‹“"
                            }
