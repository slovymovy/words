                        "glosses": [
                            "Occurring during wakefulness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "501c7eeb-eed7-4693-835b-2c4796ee980e",
                                "sense_id": "4e13257d-cdd3-3ba9-a3e0-6e0d4b6517a6",
                                "text": "A waking nightmare"
                            },
                            {
                                "example_id": "ce50a252-d75b-41ae-8cd2-9f3289578a65",
                                "sense_id": "4e13257d-cdd3-3ba9-a3e0-6e0d4b6517a6",
                                "text": "The city had as yet hardly drawn its first waking breath."
                            },
                            {
                                "example_id": "8f4df93e-3d44-4272-9794-78c88a9e4735",
                                "sense_id": "4e13257d-cdd3-3ba9-a3e0-6e0d4b6517a6",
                                "text": "Counting occupied my every waking thought."
                            },
                            {
                                "example_id": "070d1cb1-e677-4077-8f8a-a2bfa1ac3e60",
                                "sense_id": "4e13257d-cdd3-3ba9-a3e0-6e0d4b6517a6",
                                "text": "It is this gift of life that we are grateful to receive each waking moment, and so we give thanks, “for our lives, which are committed to Your power.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
