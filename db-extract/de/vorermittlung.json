                                        "glosses": [
                                            "historisch bodemonderzoek volgens NEN 5725 dat meer dan alleen maar de geschiedenis onderzoekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ecbf643-8326-4c3e-9d1f-a64ed3ce6e85",
                                                "sense_id": "cda71c72-0f9d-3b72-89ef-5649162f1a6f",
                                                "text": "Na het vooronderzoek kan bepaald worden wat het vervolgonderzoek moet zijn."
                                            },
                                            {
                                                "example_id": "2b128690-5c00-4055-bf26-66a185b956eb",
                                                "sense_id": "cda71c72-0f9d-3b72-89ef-5649162f1a6f",
                                                "text": "In de loop der jaren had ik al aardig wat kampeerspullen bij elkaar verzameld, maar tijdens mijn vooronderzoek bleek al snel dat ik niets hiervan kon gebruiken."
                                            }
