                    {
                        "translation_id": "f195ab70-10df-4206-86cd-25e072e41b9b",
                        "source_entry_id": "46cd313b-1515-3f0a-9310-3117d4e26fbc",
                        "source_sense_id": "f41bf9d9-e822-3c29-a9f1-e9f49ab6f405",
                        "target_lang_word": "hallelujah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hallelujah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b1a6dc-7c03-3ba1-82ff-6259816ebf3d",
                                        "entry_id": "ded1841d-da73-37fc-a881-1a311dca26ff",
                                        "glosses": [
                                            "An exclamation used in songs of praise or thanksgiving to God."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9ee839-c3a4-4c68-9818-75eb966e46a1",
                                                "sense_id": "d6b1a6dc-7c03-3ba1-82ff-6259816ebf3d",
                                                "text": "AND after theſe things I heard a great voyce of much people in heauen, ſaying, Alleluia: ſaluation, and glorie, and honour, and power vnto the Lord our God:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3f9693-f325-353a-8a1f-a9f87eb6e607",
                                        "entry_id": "ded1841d-da73-37fc-a881-1a311dca26ff",
                                        "glosses": [
                                            "A general expression of gratitude or adoration."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c912f5-0f25-4c81-bb09-8ebdb49f6a97",
                                                "sense_id": "4f3f9693-f325-353a-8a1f-a9f87eb6e607",
                                                "text": "Hallelujah! It’s finally the weekend!"
                                            },
                                            {
                                                "example_id": "2415a1a4-9d98-437d-adff-92ce7acd01bb",
                                                "sense_id": "4f3f9693-f325-353a-8a1f-a9f87eb6e607",
                                                "text": "Hallelujah, it's nice to know you / It's so peculiar how you've come and changed my mind"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hallelujah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b66d852-ad93-353a-b9b7-e620d4e56178",
                                        "entry_id": "384436a2-5911-3786-a937-ce9be129659f",
                                        "glosses": [
                                            "A shout of “Hallelujah”."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd1e968c-05a7-4fc9-8a82-2e55f7b9a420",
                                                "sense_id": "4b66d852-ad93-353a-b9b7-e620d4e56178",
                                                "text": "So ſung they, and the Empyrean rung, / With Halleluiahs: Thus was Sabbath kept."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e889161-e888-3fc2-a43b-0c83fc003ba9",
                                        "entry_id": "384436a2-5911-3786-a937-ce9be129659f",
                                        "glosses": [
                                            "A song of praise to God; a musical composition based on the word \\\"Hallelujah\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0146d56-ba11-3f8a-8445-51a904a5e4cf",
                                        "entry_id": "384436a2-5911-3786-a937-ce9be129659f",
                                        "glosses": [
                                            "General praise."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54a0694-7755-4fa4-92c2-be2bd2a2386e",
                                                "sense_id": "f0146d56-ba11-3f8a-8445-51a904a5e4cf",
                                                "text": "Who so stolid and selfish, that would not give his voice to swell the hallelujahs of a nation’s jubilee, when the chains of servitude had been torn from his limbs?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hallelujah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bea9b34-9984-33f8-97eb-decc8cf92aef",
                                        "entry_id": "68a60a54-6c14-3099-954d-6ec2490ac5df",
                                        "glosses": [
                                            "To cry \\\"hallelujah\\\" in praise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1fe337-0122-4dc8-856d-d122cdc44571",
                                                "sense_id": "8bea9b34-9984-33f8-97eb-decc8cf92aef",
                                                "text": "My aunt Gastonia […] she'd seen the Lord more times than they could ever count, and hallelujahed and hallelujahed, said, “While's all this the Gospel word and true, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
