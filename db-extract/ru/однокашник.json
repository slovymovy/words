                        ]
                    },
                    {
                        "translation_id": "4221ac96-5f4b-4476-9967-7bb85ab08c19",
                        "source_entry_id": "ff9c2567-158f-309a-b272-503d959d9b5a",
                        "source_sense_id": "5e27ffb5-c717-3c07-bb79-099fd1cd217e",
                        "target_lang_word": "Schulkamerad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulkamerad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79723e51-ceaf-38c7-95d8-1ac9edbef925",
                                        "entry_id": "23b243c5-6cf1-3073-94ae-f32f7ad9df75",
                                        "glosses": [
                                            "Person, mit der man zur selben Zeit in dieselbe Schule geht oder ging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca10a3e-e7c8-429a-8079-f9c1475975f7",
                                                "sense_id": "79723e51-ceaf-38c7-95d8-1ac9edbef925",
                                                "text": "Einige meiner alten Schulkameraden sind heute erfolgreiche Manager."
                                            },
                                            {
                                                "example_id": "1de57554-189c-4619-961e-c8f073d44bcb",
                                                "sense_id": "79723e51-ceaf-38c7-95d8-1ac9edbef925",
                                                "text": "„Überhaupt brachte sie selten Schulkameraden mit.“"
                                            },
                                            {
                                                "example_id": "1b16b5eb-f43d-4c92-a012-dc16fbc3271b",
                                                "sense_id": "79723e51-ceaf-38c7-95d8-1ac9edbef925",
                                                "text": "„Aus der Entfernung wirken sie wie Schulkameraden, die vielleicht eine Klausur besprechen.“"
                                            },
                                            {
                                                "example_id": "a3838af3-86a6-4dba-a3bd-379d7d6f1188",
                                                "sense_id": "79723e51-ceaf-38c7-95d8-1ac9edbef925",
                                                "text": "„Meine Schulkameraden waren tief beeindruckt von meinen Erzählungen, auch weil ich als Beweis heimlich ab und zu Gasmasken, kleine Munitionsbehälter und Orden mit in die Schule brachte.“"
                                            },
                                            {
                                                "example_id": "7118ab1d-f5c5-4547-adb7-2d070073285d",
                                                "sense_id": "79723e51-ceaf-38c7-95d8-1ac9edbef925",
                                                "text": "„Robert, der im Laufe der Jahre das Bild dieses früheren Schulkameraden nur undeutlich im Gedächtnis trug, fühlte sich erst bei Leonhards ähnlicher Erscheinung an die alten Vorgänge erinnert und hatte ein sympathisches Zutrauen zu dem jungen Pagen gefaßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f14acffb-33c4-4afe-9bdc-46ad97d5a88e",
                        "source_entry_id": "ff9c2567-158f-309a-b272-503d959d9b5a",
                        "source_sense_id": "5e27ffb5-c717-3c07-bb79-099fd1cd217e",
                        "target_lang_word": "Mitschüler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitschüler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                        "entry_id": "323a3e10-09ef-3358-ad1d-4d7856aaba25",
                                        "glosses": [
                                            "eine Person, die dieselbe Schule besucht(e) wie man selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750220bf-b6dc-4621-bec7-f109d7ae3caa",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "Erwin erpresst seine Mitschüler auf dem Pausenhof."
                                            },
                                            {
                                                "example_id": "3ed1bf87-a427-4e61-8553-fa946152b08e",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "Die Mitschüler halfen einander bei den Hausaufgaben."
                                            },
                                            {
                                                "example_id": "cff28660-3791-455e-8fa1-417590e4bce8",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Wie John feststellte, waren seine beiden Schüler ungefähr gleich begabt, nur besaß Jako eine etwas bessere Auffassungsgabe als sein Mitschüler.“"
                                            },
                                            {
                                                "example_id": "5ed8d28a-4a82-45af-bce7-4161261b989d",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Ganztagsschulen, in denen Kinder vielfältige Lernerfahrungen sammeln, Phasen der An- und Entspannung erleben, mit ihren Mitschüler sozial interagieren können, seien eine geeignete Form, die Folgen der demografischen Entwicklung abzufedern.“"
                                            },
                                            {
                                                "example_id": "70726feb-bd95-405e-a3d1-600580c214ce",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Noch etwas war ihm bei seinen Mitschülern aufgefallen.“"
                                            },
                                            {
                                                "example_id": "de26772e-10ce-4923-bab5-c61a0044cc45",
                                                "sense_id": "a3ccee5f-8dd2-30a3-bdb6-98ef64faf84f",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d51a782a-faad-426c-9500-f6bbf8371d70",
                        "source_entry_id": "ff9c2567-158f-309a-b272-503d959d9b5a",
