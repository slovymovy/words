                        "examples": [
                            {
                                "example_id": "56c31279-88e0-4fce-86fe-02cddd670b3f",
                                "sense_id": "69b1d566-39a4-38b1-9827-9805a44370a8",
                                "text": "Franz Fischler ist ehemaliger österreichischer Landwirtschaftskommissar."
                            },
                            {
                                "example_id": "2034aa02-b299-4784-93e1-0a5faf8052be",
                                "sense_id": "69b1d566-39a4-38b1-9827-9805a44370a8",
                                "text": "„Auf die Idee, dass er bald der überaus erfolgreiche Landwirtschaftskommissar der EU werden würde, kam ich damals nicht.“"
                            },
                            {
                                "example_id": "a34fb391-e85e-4466-bbe3-4ab715aa46fa",
                                "sense_id": "69b1d566-39a4-38b1-9827-9805a44370a8",
                                "text": "„Am 12.12.1924 wurde er Landwirtschaftskommissar der BSSR. Mit der Forcierung der Kollektivierung wurden auch \"Maßnahmen\" gegen Prysčépaü eingeleitet. Am 23.3.1929 wurde Pryščépaü als Landwirtschaftskommissar abgesetzt.“"
                            }
                        ],
