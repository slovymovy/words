                    {
                        "translation_id": "8e929bbc-beb2-4490-905f-05ac1d8cc019",
                        "source_entry_id": "2ef689d0-9f90-3c01-8fdf-70a3ccbc99e1",
                        "source_sense_id": "8da35d50-7986-3963-835e-68cd0f3a3b12",
                        "target_lang_word": "proletariat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
