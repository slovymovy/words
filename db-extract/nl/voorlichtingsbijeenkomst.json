                "senses": [
                    {
                        "sense_id": "6f0b5740-d926-35cf-bd91-6abc0aeac970",
                        "entry_id": "57a8a330-9595-3c15-977d-48792ba14be4",
                        "glosses": [
                            "bijeenkomst waarin men informatie over een bepaald onderwerp krijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4805efdc-85b4-4821-afc8-c34611b81cd7",
                                "sense_id": "6f0b5740-d926-35cf-bd91-6abc0aeac970",
                                "text": "Op maandag 19 maart werd een voorlichtingsbijeenkomst gehouden. Ruim duizend werklozen kregen tijdens die bijeenkomst een toelichting over het project. Ze konden zich inschrijven voor een busrit die hen een week later langs de kassen in het Westland zou voeren. Zo konden ze kennis maken met een aantal tuinderijen. Tijdens de bijeenkomst werd gezegd dat mensen die zich niet wilden inschrijven, gekort konden worden op hun uitkering."
                            },
                            {
                                "example_id": "b5e52b02-bd6c-4183-8ada-fb41249bd930",
                                "sense_id": "6f0b5740-d926-35cf-bd91-6abc0aeac970",
                                "text": "Half januari lanceerde Florijn het plan en op 19 maart organiseerden de projectleiders een voorlichtingsbijeenkomst in Poeldijk voor ongeveer duizend bijstandsgerechtigden. Vervolgens konden zij zich opgeven voor een bustour langs de tuinderijen. Bijstandsgerechtigden die niet naar de bijeenkomst kwamen of niet met de bus meegingen, zouden dertig tot honderd procent van hun uitkering verliezen. 618 mensen meldden zich aan voor de bustour."
                            }
                        ]
                    }
