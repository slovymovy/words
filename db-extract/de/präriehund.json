                    }
                ],
                "translations": [
                    {
                        "translation_id": "296df224-31dd-4974-8494-3667ec118b1c",
                        "source_entry_id": "ce81cb87-8ca4-38a8-8672-347b73e348e6",
                        "source_sense_id": "a3df5fea-a2c9-36f7-9139-f8a02e14b0fc",
                        "source_sense_description": "Zoologie: nordamerikanisches Nagetier aus der Gattung Cynomys",
                        "target_lang_word": "prairie dog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prairie dog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb6d02aa-f0a1-3350-997c-4c68451dd713",
                                        "entry_id": "b369b966-d2e5-3fc3-809d-fdfc8f888a0c",
                                        "glosses": [
                                            "Any of genus Cynomys, small, stout-bodied burrowing rodents with shallow cheek pouches, native to North America and Central America."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prairie dog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3694b53f-c619-32b0-8044-6adf93d56d36",
                                        "entry_id": "6fe4ac77-a60e-376f-9e2f-4f9e3cf74323",
                                        "glosses": [
                                            "To pop up from a hole or similar in a manner that resembles the way a prairie dog pops his head up from his burrow."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb760d4b-7a09-4511-8c3f-8a6776bf3364",
                                                "sense_id": "3694b53f-c619-32b0-8044-6adf93d56d36",
                                                "text": "People prairie-dog over the tops of their cubicles and call to their co-workers: “Hey, you going for a walk at lunch today?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89b8b71-e3ea-371d-97f0-aa76adfa3030",
                                        "entry_id": "6fe4ac77-a60e-376f-9e2f-4f9e3cf74323",
                                        "glosses": [
                                            "To struggle to hold back an involuntary bowel movement."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35314df1-6d91-4802-8763-1a4ddc9a2f92",
                                                "sense_id": "f89b8b71-e3ea-371d-97f0-aa76adfa3030",
                                                "text": "2001, Andy Breckman, Rat Race\n[Kimberly needs to go to the bathroom] Dad, I'm prairie dogging it! What the hell does that mean? You know, like when a prairie dog sticks his head in and out of the ground."
                                            },
                                            {
                                                "example_id": "56f83935-b41c-4a1a-9548-62210d35602e",
                                                "sense_id": "f89b8b71-e3ea-371d-97f0-aa76adfa3030",
                                                "text": "I'm about to crap my pants.\nJe vais me faire au froc.\nI'm prairie-dogging it.\nJ'ai le cigare au bout des lèvres.\nLiterally, “the cigar is at the edge of my lips”"
                                            },
                                            {
                                                "example_id": "064e89a6-4be1-49e7-9734-8bab75608a39",
                                                "sense_id": "f89b8b71-e3ea-371d-97f0-aa76adfa3030",
                                                "text": "[…] Postin' Up On the Blaster / Power Dump / Prairie-Dogging it / Press a Loaf Purp […]"
                                            },
                                            {
                                                "example_id": "7ca4fa10-35ba-4b2c-b91a-1577aa014fa9",
                                                "sense_id": "f89b8b71-e3ea-371d-97f0-aa76adfa3030",
                                                "text": "“Oh, God stop, stop,” Kat said, holding her side, “I'm starting to prairie dog.” […] “You know, prairie dogging,” Kat said, trying to explain between breaths. “When it pokes its head out of the hole and then back in, out and in, out and in.”"
                                            },
                                            {
                                                "example_id": "ede4ad11-1c0c-4a45-b1b8-f12c040f80e9",
                                                "sense_id": "f89b8b71-e3ea-371d-97f0-aa76adfa3030",
                                                "text": "2011, Various, David Mack, James Robinson, Ty Templeton, Alan Moore, Jeph Loeb, Kurt Busiek, Vampirella Masters Series 4: The Lost Tales\n...They are gonna get a mouthful and a pantful. Crappin their shorts all the way into next week... Yeah those little bastards will be prairie dogging it all the way home!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d181f60-b311-4a3e-8a29-29cb68d1864e",
                        "source_entry_id": "ce81cb87-8ca4-38a8-8672-347b73e348e6",
