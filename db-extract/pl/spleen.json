                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36be1d74-e938-480d-bc7c-10ac1b560301",
                                "sense_id": "7db710b1-4530-3ec3-a64b-98cab2460919",
                                "text": "Wiadomość ta odrazu napełniła mię spleenem, trzeba było bowiem zrezygnować ze snu, a kto wie, może nawet i z drzemki"
                            },
                            {
                                "example_id": "589b896f-64ce-43cd-b4ab-a9c00be6864f",
                                "sense_id": "7db710b1-4530-3ec3-a64b-98cab2460919",
                                "text": "Kazik chodził smutny, mówiąc, że spleen go zżera."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
