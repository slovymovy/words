                        "glosses": [
                            "ein süßes Gericht, das oft als Nachspeise, aber auch als Vorspeise oder Hauptgericht gereicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0455a7bd-ac5d-46f6-b4fb-9a5c734fe00e",
                                "sense_id": "dcd4d48c-63f4-3fbf-80aa-944410078690",
                                "text": "Als Süßspeise können wir ihnen einen Schokoladenpudding oder einen Krapfen anbieten."
                            },
                            {
                                "example_id": "4ec84bd7-983a-4362-aeb7-651effe8458d",
                                "sense_id": "dcd4d48c-63f4-3fbf-80aa-944410078690",
                                "text": "Diabetiker müssen bei den Süßspeisen besonders vorsichtig sein, da diese oft Zucker enthalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
