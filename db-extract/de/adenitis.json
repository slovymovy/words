                        "examples": [
                            {
                                "example_id": "7cab7c4d-5782-4324-ae83-b0e226ac0b5d",
                                "sense_id": "8c93bd99-8a73-387f-bfde-83ea16ad9273",
                                "text": "„Die eigentliche Erkrankung, die Adenitis (Entzündung und Vergrößerung der Lymphknoten), verschwindet von alleine.“"
                            },
                            {
                                "example_id": "9e24c729-db85-4d94-a9a5-2ea5de392a80",
                                "sense_id": "8c93bd99-8a73-387f-bfde-83ea16ad9273",
                                "text": "„Als Adenitis bezeichnet man die Entzündung einer Drüse. Diese kann durch Bakterien oder Viren ausgelöst werden oder autoimmun bedingt sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
