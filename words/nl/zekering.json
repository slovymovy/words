{
    "word_family": [
        "zekeren",
        "verzekeren",
        "verzekering",
        "verzekeraar",
        "zekerheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32b7f190-5e61-3d9e-90cf-a928e59a3b3a",
                    "sense_definition": "een onderdeel in een elektrische installatie dat de stroom verbreekt bij overbelasting of kortsluiting",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "elektriciteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik de waterkoker en de oven tegelijk aanzette, sloeg de <w>zekering</w> door.",
                            "target_lang_translations": {
                                "en": "When I turned on the kettle and the oven at the same time, the <w>fuse</w> blew."
                            }
                        },
                        {
                            "text": "Je moet eerst de <w>zekering</w> vervangen voordat de lampen in de woonkamer weer werken.",
                            "target_lang_translations": {
                                "en": "You must first replace the <w>fuse</w> before the lights in the living room work again."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "smeltveiligheid",
                        "smeltstop"
                    ],
                    "common_phrases": [
                        "zekering doorslaan",
                        "zekering vervangen"
                    ],
                    "target_lang_definitions": {
                        "en": "a component in an electrical installation that breaks the current in the event of an overload or short circuit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fuse",
                                "target_lang_sense_clarification": "electrical safety device"
                            },
                            {
                                "target_lang_word": "circuit breaker",
                                "target_lang_sense_clarification": "modern automatic switch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "754b71ec-0a36-3d90-b6ad-1bfb78dd2051",
                    "sense_definition": "een mechanisme of systeem in de klimsport dat voorkomt dat een klimmer een diepe val maakt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "klimsport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De klimmer controleerde zijn <w>zekering</w> zorgvuldig voordat hij aan de steile wand begon.",
                            "target_lang_translations": {
                                "en": "The climber checked his <w>belay</w> carefully before starting the steep wall."
                            }
                        },
                        {
                            "text": "Zonder een goede <w>zekering</w> is het levensgevaarlijk om deze berg te beklimmen.",
                            "target_lang_translations": {
                                "en": "Without proper <w>protection</w>, it is life-threatening to climb this mountain."
                            }
                        }
                    ],
                    "common_phrases": [
                        "extra zekering"
                    ],
                    "target_lang_definitions": {
                        "en": "a mechanism or system in climbing that prevents a climber from making a deep fall"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "belay",
                                "target_lang_sense_clarification": "climbing safety system"
                            },
                            {
                                "target_lang_word": "protection",
                                "target_lang_sense_clarification": "climbing gear used for safety"
                            },
                            {
                                "target_lang_word": "safety",
                                "target_lang_sense_clarification": "general term for fall prevention"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}