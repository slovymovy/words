                                                "example_id": "4ab0123a-2cc1-4d97-b7cc-13f9c96ed620",
                                                "sense_id": "a678837a-529f-35c3-8851-929ce7e84dab",
                                                "text": "Nun rangeln die Kindergärten um die begehrten Fachkräfte – mit allen Mitteln."
                                            },
                                            {
                                                "example_id": "fdc8fa9a-0750-41c2-b012-76c552d6dd91",
                                                "sense_id": "a678837a-529f-35c3-8851-929ce7e84dab",
                                                "text": "Nach seinem Oscar war er noch fünf weitere Male für einen der begehrten Preise der US-Filmakademie nominiert."
                                            },
                                            {
                                                "example_id": "37c75cab-4420-47c0-854d-2d91631a3d84",
                                                "sense_id": "a678837a-529f-35c3-8851-929ce7e84dab",
                                                "text": "Er ist heute beliebter Gast in Talk-Shows, begehrter Interviewpartner und wurde sogar von deutschen Medien als Kandidat für das Amt des Bundespräsidenten favorisiert."
                                            }
