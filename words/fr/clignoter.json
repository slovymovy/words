    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5cc7536-d0cd-3145-815c-bdf46bad6463",
                    "sense_definition": "S'allumer et s'éteindre alternativement à intervalles réguliers et rapprochés, en parlant d'une source lumineuse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyant rouge de l'alarme a commencé à <w>clignoter</w> au milieu de la nuit."
                        },
                        {
                            "text": "Quand la batterie est presque vide, un petit voyant lumineux <w>clignote</w> sans arrêt."
                        }
                    ],
                    "common_phrases": [
                        "voyant qui clignote",
                        "faire clignoter"
                    ]
                },
                {
                    "sense_id": "ef179a42-0040-3fcb-8161-6846e888d760",
                    "sense_definition": "Actionner les feux indicateurs de direction d'un véhicule pour signaler un changement de trajectoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conduite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>clignoter</w> à gauche avant de dépasser ce camion sur l'autoroute."
                        },
                        {
                            "text": "L'automobiliste devant nous a soudainement <w>clignoté</w> à droite pour tourner dans une ruelle."
                        }
                    ],
                    "common_phrases": [
                        "clignoter à gauche",
                        "clignoter à droite"
                    ]
                },
                {
                    "sense_id": "91236505-6411-3db1-a114-9de889d51282",
                    "sense_definition": "Fermer et rouvrir rapidement les paupières à plusieurs reprises, de manière involontaire ou répétée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "yeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ébloui par le soleil levant, il a <w>clignoté</w> des yeux pendant un long moment."
                        },
                        {
                            "text": "L'enfant <w>clignotait</w> nerveusement face aux projecteurs de la scène."
                        }
                    ],
                    "synonyms": [
                        "cligner"
                    ],
                    "common_phrases": [
                        "clignoter des yeux"
                    ]
                }
            ]
        }
