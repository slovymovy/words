                "translations": [
                    {
                        "translation_id": "57a2fabe-899c-44d6-815a-6faa38fcec8c",
                        "source_entry_id": "568fa299-c79d-36e7-a694-83f5998eedbd",
                        "source_sense_id": "0ed1d789-87cd-370d-a3e4-75b4fe36f998",
                        "source_sense_description": "Luftwaffe: Schütze, der mit einem Maschinengewehr oder einer Maschinenkanone aus dem Flugzeug feuert",
                        "target_lang_word": "aerial gunner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
