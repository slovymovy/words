                        "glosses": [
                            "Contre-révolutionnaire qui réprima la Commune de Paris en 1871."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "f2b364d7-f276-4cd2-a055-13ff70a0ddd8",
                                "sense_id": "de3c5187-08a9-3bda-bcff-235a1769645e",
                                "text": "Zéphyrin Camélinat sortira miraculeusement indemne de la Semaine sanglante. Durant les dernières heures passées à la Monnaie, il fait évacuer 30 000 pièces de cinq francs au nez et à la barbe des versaillais."
                            }
                        ]
                    }
