{
    "word_family": [
        "prepositional",
        "prepositionally",
        "postposition",
        "adposition"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ff13730-9aa1-351a-99a7-33bf2c311cc1",
                    "sense_definition": "A word governing, and usually preceding, a noun or pronoun and expressing a relation to another word or element in the clause.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammar_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Words like in, on, and under are common examples of a <w>preposition</w>.",
                            "target_lang_translations": {
                                "ru": "Слова вроде in, on и under — типичные примеры <w>предлогов</w>."
                            }
                        },
                        {
                            "text": "Our English teacher reminded us not to end the sentence with a <w>preposition</w>.",
                            "target_lang_translations": {
                                "ru": "Наш учитель английского напомнил нам не заканчивать предложение <w>предлогом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "adposition"
                    ],
                    "antonyms": [
                        "postposition"
                    ],
                    "common_phrases": [
                        "object of a preposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служебная часть речи, выражающая отношение существительного или местоимения к другим словам в предложении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предлог",
                                "target_lang_sense_clarification": "часть речи в грамматике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e88a06-921d-3110-b408-8f8c804f48df",
                    "sense_definition": "A proposition, exposition, or formal discourse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar presented a lengthy <w>preposition</w> concerning allegiance to the royal throne.",
                            "target_lang_translations": {
                                "ru": "Учёный представил пространное <w>рассуждение</w> о преданности королевскому престолу."
                            }
                        },
                        {
                            "text": "Few listeners understood the obscure <w>preposition</w> delivered before the gathering.",
                            "target_lang_translations": {
                                "ru": "Мало кто из слушателей понял малопонятный <w>тезис</w>, озвученный перед собравшимися."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposition",
                        "exposition",
                        "discourse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of a proposition or formal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее обозначение тезиса, рассуждения, утверждения или официального выступления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тезис",
                                "target_lang_sense_clarification": "утверждение или положение"
                            },
                            {
                                "target_lang_word": "рассуждение",
                                "target_lang_sense_clarification": "формальное высказывание или трактат"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "официальное положение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fef11061-3163-3a7d-b9eb-f8866ec9ad47",
                    "sense_definition": "To position, place, or locate beforehand or in advance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Workers must <w>preposition</w> the heavy machinery before the assembly process begins.",
                            "target_lang_translations": {
                                "ru": "Рабочие должны <w>заблаговременно разместить</w> тяжёлую технику до начала процесса сборки."
                            }
                        },
                        {
                            "text": "The emergency response team will <w>preposition</w> supplies along the expected storm path.",
                            "target_lang_translations": {
                                "ru": "Группа экстренного реагирования <w>предварительно разместит</w> запасы на предполагаемом пути шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "preposition supplies",
                        "preposition equipment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размещать, расставлять или подготавливать заранее или заблаговременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заблаговременно размещать",
                                "target_lang_sense_clarification": "оборудование, запасы или технику"
                            },
                            {
                                "target_lang_word": "предварительно размещать",
                                "target_lang_sense_clarification": "заранее дислоцировать или располагать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}