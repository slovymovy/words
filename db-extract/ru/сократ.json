                                        "entry_id": "20f9a4e9-efdd-3e7f-9a12-eef0c31f4c49",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
