                                        "entry_id": "23327a40-1076-3ec3-9f32-246be081b8c4",
                                        "glosses": [
                                            "A receptacle, originally gourd-shaped and used for liquids or chemicals; a bottle or other container."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e353ca94-c85f-4662-b449-db34b7dedd94",
                                                "sense_id": "9dac36d1-bac3-39ff-aaf1-54082740cdd8",
                                                "text": "When Sulayman saw me, he took refuge with Allah and bade me embrace the True Faith and obey his behests; but I refused, so sending for this cucurbit he shut me up therein, and stopped it over with lead"
                                            }
                                        ]
