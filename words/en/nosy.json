{
    "word_family": [
        "nose",
        "nosily",
        "nosiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6735f038-ac88-34fc-8f80-14538cf5b7e2",
                    "sense_definition": "Prying, excessively curious, or tending to meddle in other people's affairs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "curious_meddling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nosy</w> neighbor kept peeking through the fence to see what we were doing.",
                            "target_lang_translations": {
                                "cs": "<w>Vlezlý</w> soused neustále nakukoval přes plot, aby viděl, co děláme."
                            }
                        },
                        {
                            "text": "She hated it when people asked <w>nosy</w> questions about her personal relationships.",
                            "target_lang_translations": {
                                "cs": "Nesnášela, když lidé kladli <w>vtíravé</w> otázky ohledně jejích osobních vztahů."
                            }
                        }
                    ],
                    "synonyms": [
                        "interfering",
                        "meddlesome"
                    ],
                    "common_phrases": [
                        "nosy neighbor",
                        "nosy questions"
                    ],
                    "target_lang_definitions": {
                        "cs": "Příliš zvědavý, slídivý nebo mající sklon plést se do cizích záležitostí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zvědavý",
                                "target_lang_sense_clarification": "příliš vyzvídavý"
                            },
                            {
                                "target_lang_word": "vlezlý",
                                "target_lang_sense_clarification": "nevybíravě se pletoucí do cizích věcí"
                            },
                            {
                                "target_lang_word": "vtíravý",
                                "target_lang_sense_clarification": "neodbytně zvídavý"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e52a015-091f-3b1e-956d-ba8b83f6cd06",
                    "sense_definition": "Having a prominent, large, or elongated nose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cartoon depicted an exaggerated caricature with big feet and a notably <w>nosy</w> face.",
                            "target_lang_translations": {
                                "cs": "Kreslený vtip zobrazoval přehnanou karikaturu s velkýma nohama a nápadně <w>nosatým</w> obličejem."
                            }
                        },
                        {
                            "text": "He recognized his uncle's distinct, <w>nosy</w> profile from across the busy crowded room.",
                            "target_lang_translations": {
                                "cs": "Poznal strýcův osobitý, <w>nosatý</w> profil přes celou rušnou a přeplněnou místnost."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající nápadně velký, výrazný nebo dlouhý nos."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nosatý",
                                "target_lang_sense_clarification": "s velkým či výrazným nosem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e562f83c-1556-3764-832f-4f870826c0c8",
                    "sense_definition": "An inquisitive look or inspection to satisfy one's curiosity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "curious_meddling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to have a quick <w>nosy</w> around the old bookstore to see their stock.",
                            "target_lang_translations": {
                                "cs": "Rozhodl jsem se na chvíli <w>nakouknout</w> do starého knihkupectví a podívat se, co nabízejí."
                            }
                        },
                        {
                            "text": "They went downstairs to have a <w>nosy</w> at the renovations being done in the basement.",
                            "target_lang_translations": {
                                "cs": "Šli dolů, aby si <w>okoukli</w> rekonstrukci probíhající v suterénu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a nosy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally, especially in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvědavý pohled, zběžná prohlídka nebo nakouknutí za účelem uspokojení zvědavosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nakouknutí",
                                "target_lang_sense_clarification": "zvědavý pohled"
                            },
                            {
                                "target_lang_word": "okouknutí",
                                "target_lang_sense_clarification": "zběžná prohlídka ze zvědavosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba5d62ef-3ff6-3296-8143-b231bbdaa38c",
                    "sense_definition": "An affectionate or diminutive term for a small nose, especially a child's.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tiny snowflake landed right on the toddler's little <w>nosy</w> during the walk.",
                            "target_lang_translations": {
                                "cs": "Během procházky přistála malá sněhová vločka přímo na batolecím <w>nosánku</w>."
                            }
                        },
                        {
                            "text": "The mother gently tapped her baby's <w>nosy</w> to make him giggle with delight.",
                            "target_lang_translations": {
                                "cs": "Maminka jemně ťukla miminko do <w>nosíku</w>, aby ho rozesmála radostí."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily in nursery or child-directed speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zdvořilostní nebo mazlivé označení pro malý nosánek, obvykle u dětí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nosík",
                                "target_lang_sense_clarification": "malý nos"
                            },
                            {
                                "target_lang_word": "nosánek",
                                "target_lang_sense_clarification": "zdrobněle dětský nos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "094c3a39-e551-3520-b1f9-3bd40688f7ad",
                    "sense_definition": "To pry, investigate, or snoop into someone else's personal matters.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curious_meddling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She caught her younger brother as he <w>nosied</w> into her private letters.",
                            "target_lang_translations": {
                                "cs": "Přistihla svého mladšího bratra, jak <w>slídil</w> v jejích soukromých dopisech."
                            }
                        },
                        {
                            "text": "He always <w>nosies</w> around the office trying to discover what everyone earns.",
                            "target_lang_translations": {
                                "cs": "Pořád po kanceláři <w>čmuchá</w> a snaží se zjistit, kolik kdo vydělává."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nosy into"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Slídit, vyzvídat nebo strkat nos do cizích osobních záležitostí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slídit",
                                "target_lang_sense_clarification": "tajně zkoumat, vyzvídat"
                            },
                            {
                                "target_lang_word": "strkat nos",
                                "target_lang_sense_clarification": "plést se do cizích věcí"
                            },
                            {
                                "target_lang_word": "čmuchat",
                                "target_lang_sense_clarification": "pátrat po něčem tajném"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}