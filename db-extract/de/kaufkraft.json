                "senses": [
                    {
                        "sense_id": "aebc2283-0b05-39a7-a723-f135a41a787d",
                        "entry_id": "fe67cd34-8439-3f87-bc77-91488d8118af",
                        "glosses": [
                            "Zahlungsfähigkeit der Bevölkerung/eines Wirtschaftsteilnehmers, beschrieben durch das zum Zwecke des Konsums verfügbare Einkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e033bb1-b946-4da5-a434-dc71488590fd",
                                "sense_id": "aebc2283-0b05-39a7-a723-f135a41a787d",
                                "text": "Die Regierung ist daran interessiert, die Kaufkraft zu steigern."
                            },
                            {
                                "example_id": "848af4cf-59d6-4dd1-837c-5e4fd089a3e1",
                                "sense_id": "aebc2283-0b05-39a7-a723-f135a41a787d",
                                "text": "„Denn sie definiert, wo sich am Markt die Kaufkraft befindet, von der ein Angebot „leben“ will. Dem liegt die Erkenntnis zugrunde, daß eigentlich keiner, außer dem Hersteller, auf ein neues Produkt gewartet hat.“"
                            },
                            {
                                "example_id": "bdb37183-ed42-4932-9a8c-57265b486b61",
                                "sense_id": "aebc2283-0b05-39a7-a723-f135a41a787d",
                                "text": "„Die Kaufkraft dürfte die dreifache von heute gewesen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5e842fa-8b6f-3011-8ffa-c49af40248e4",
                        "entry_id": "fe67cd34-8439-3f87-bc77-91488d8118af",
                        "glosses": [
                            "der Wert einer Währung, ausgedrückt als Gütermenge, die einem bestimmten Betrag entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30b6c77-5969-4c26-adbd-a93a8c8f353c",
                                "sense_id": "f5e842fa-8b6f-3011-8ffa-c49af40248e4",
                                "text": "Die Kaufkraft des Peso ist erneut zurückgegangen."
                            },
                            {
                                "example_id": "f89e1f85-44e6-4cd5-8a05-7381edda901d",
                                "sense_id": "f5e842fa-8b6f-3011-8ffa-c49af40248e4",
                                "text": "„Dreihundert Florin war ein nicht geringes Vermögen, wenn man die damalige Kaufkraft bedenkt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
