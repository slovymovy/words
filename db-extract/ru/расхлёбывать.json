                ],
                "senses": [
                    {
                        "sense_id": "0e522e1a-673b-36a0-ad41-320952543e33",
                        "entry_id": "74beb0bb-5ef2-3aaa-a631-5b16f51233a3",
                        "glosses": [
                            "прост. съедать или выпивать всё без остатка, хлебая вместе с кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0ec6af-48dd-4a22-aa87-2397ce0f3349",
                                "sense_id": "0e522e1a-673b-36a0-ad41-320952543e33",
                                "text": "Да он с господином чаи расхлёбывает, да ещё с ложечкой!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7f5c210e-f01e-3df5-b688-e606f016cc38",
                        "entry_id": "74beb0bb-5ef2-3aaa-a631-5b16f51233a3",
                        "glosses": [
                            "перен., разг. распутывать, поправлять, улаживать что-либо запутанное, неприятное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8081d71-183f-4e79-8787-f745329d46ab",
                                "sense_id": "7f5c210e-f01e-3df5-b688-e606f016cc38",
                                "text": "Она же постоянно влипала в какие-нибудь неприятные истории, расхлёбывать которые приходилось маме, и отец, естественно, был недоволен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5048bf2c-92ed-4e62-82c6-67941e6221c5",
                        "source_entry_id": "74beb0bb-5ef2-3aaa-a631-5b16f51233a3",
                        "source_sense_description": "распутывать, поправлять, улаживать что-либо запутанное, неприятное",
                        "target_lang_word": "disentangle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disentangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0c682b3-5b60-32f8-850f-0bc3549d5d4e",
                                        "entry_id": "d406ab8b-b4de-3ffa-88fa-1e4370243ed2",
                                        "glosses": [
                                            "To free something from entanglement; to extricate or unknot."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3486304-7490-44fc-a3ec-33d7b0ef5543",
                                                "sense_id": "c0c682b3-5b60-32f8-850f-0bc3549d5d4e",
                                                "text": "I had to disentangle him from his own shoelaces."
                                            },
                                            {
                                                "example_id": "bdf52d21-1c34-4028-bbaf-c250b0d56ccd",
                                                "sense_id": "c0c682b3-5b60-32f8-850f-0bc3549d5d4e",
                                                "text": "In my own opinion, “criminal religious movements” (CRMs) is a more accurate and useful category than “cults.” It uses, although selectively, elements from the criminological tradition. It avoids the word “cult” and tries to disentangle the category from both the folk psychology of brainwashing and the politics of “extremism” in theology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed3cc8e-fef6-356d-b9ee-fa553f63729a",
                                        "entry_id": "d406ab8b-b4de-3ffa-88fa-1e4370243ed2",
                                        "glosses": [
                                            "To unravel; to separate into discrete components or units."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2110a855-1f36-4467-b209-00a0a576592c",
                                                "sense_id": "7ed3cc8e-fef6-356d-b9ee-fa553f63729a",
                                                "text": "This overlapping is reflective of hybrid languages, where certain features (phonetic, orthographic, semantic, syntactic) are also difficult to disentangle."
                                            }
                                        ]
                                    },
                                    {
