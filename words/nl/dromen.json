            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c2519f6-806a-3f22-803d-6e4976ce052c",
                    "sense_definition": "Beelden, geluiden of gevoelens ervaren terwijl je slaapt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>droom</w> bijna elke nacht over vliegen.",
                            "target_lang_translations": {
                                "en": "I <w>dream</w> about flying almost every night.",
                                "ru": "Мне почти каждую ночь <w>снится</w>, что я летаю.",
                                "pl": "Prawie każdej nocy <w>śnię</w> o lataniu.",
                                "de": "Ich <w>träume</w> fast jede Nacht vom Fliegen.",
                                "fr": "Je <w>rêve</w> de voler presque chaque nuit.",
                                "it": "Quasi ogni notte <w>sogno</w> di volare.",
                                "cs": "Skoro každou noc <w>sním</w> o létání.",
                                "tr": "Hemen hemen her gece uçtuğumu <w>rüyamda görüyorum</w>.",
                                "es": "Casi todas las noches <w>sueño</w> con volar."
                            }
                        },
                        {
                            "text": "De kinderen <w>dromen</w> over hun verjaardagscadeaus.",
                            "target_lang_translations": {
                                "en": "The children <w>dream</w> about their birthday presents.",
                                "ru": "Детям <w>снятся</w> подарки на день рождения.",
                                "pl": "Dzieciom <w>śnią się</w> ich prezenty urodzinowe.",
                                "de": "Die Kinder <w>träumen</w> von ihren Geburtstagsgeschenken.",
                                "fr": "Les enfants <w>rêvent</w> de leurs cadeaux d'anniversaire.",
                                "it": "I bambini <w>sognano</w> i loro regali di compleanno.",
                                "cs": "Dětem se <w>zdá</w> o jejich narozeninových dárcích.",
                                "tr": "Çocuklar doğum günü hediyelerini <w>rüyalarında görüyorlar</w>.",
                                "es": "Los niños <w>sueñan</w> con sus regalos de cumpleaños."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dromen over",
                        "vies dromen",
                        "hardop dromen"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience images, sounds, or feelings while sleeping.",
                        "ru": "Видеть образы, слышать звуки или испытывать ощущения во время сна.",
                        "pl": "Doświadczać obrazów, dźwięków lub uczuć podczas snu.",
                        "de": "Bilder, Geräusche oder Gefühle während des Schlafens erleben.",
                        "fr": "Éprouver des images, des sons ou des sensations pendant le sommeil.",
                        "it": "Sperimentare immagini, suoni o sensazioni mentre si dorme.",
                        "cs": "Mít sny, prožívat obrazy, zvuky nebo pocity během spánku.",
                        "tr": "Uyurken görüntüler, sesler veya hisler deneyimlemek.",
                        "es": "Experimentar imágenes, sonidos o sensaciones mientras se duerme."
                    },
                    "translations": {
