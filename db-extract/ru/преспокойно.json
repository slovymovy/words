                    {
                        "sense_id": "2d270088-4ed3-3f7f-a3f1-51f4a53f855e",
                        "entry_id": "71a1ffcc-2991-3f8f-a812-97a5b1b1517d",
                        "glosses": [
                            "усилит. к спокойно"
