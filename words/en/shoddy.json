{
    "word_family": [
        "shoddiness",
        "shoddily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "40f6190b-693c-381a-83a9-0b5986aece86",
                    "sense_definition": "Of poor quality or construction",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not settle for <w>shoddy</w> knives if you are serious about cooking.",
                            "target_lang_translations": {
                                "ru": "Не соглашайтесь на <w>дрянные</w> ножи, если вы серьезно относитесь к кулинарии."
                            }
                        },
                        {
                            "text": "The building collapsed because the contractor used <w>shoddy</w> workmanship and cheap materials.",
                            "target_lang_translations": {
                                "ru": "Здание рухнуло, потому что подрядчик допустил <w>халтурную</w> работу и использовал дешевые материалы."
                            }
                        }
                    ],
                    "synonyms": [
                        "inferior",
                        "poor",
                        "substandard",
                        "trashy"
                    ],
                    "antonyms": [
                        "excellent",
                        "superior",
                        "well-made"
                    ],
                    "common_phrases": [
                        "shoddy workmanship",
                        "shoddy construction",
                        "shoddy goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохого качества или небрежного изготовления"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низкопробный",
                                "target_lang_sense_clarification": "о качестве товаров или работы"
                            },
                            {
                                "target_lang_word": "дрянной",
                                "target_lang_sense_clarification": "очень плохого качества"
                            },
                            {
                                "target_lang_word": "халтурный",
                                "target_lang_sense_clarification": "сделанный небрежно"
                            },
                            {
                                "target_lang_word": "недоброкачественный",
                                "target_lang_sense_clarification": "не соответствующий стандартам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76e2d91d-4241-3800-b7ef-0d9ae9f4f644",
                    "sense_definition": "Pretentious, sham, or counterfeit",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's <w>shoddy</w> excuses did little to convince the public of his innocence.",
                            "target_lang_translations": {
                                "ru": "<w>Дешевые</w> оправдания политика мало помогли убедить общественность в его невиновности."
                            }
                        },
                        {
                            "text": "He tried to pass off a <w>shoddy</w> imitation as a genuine antique.",
                            "target_lang_translations": {
                                "ru": "Он пытался выдать <w>грубую</w> подделку за подлинный антиквариат."
                            }
                        }
                    ],
                    "synonyms": [
                        "sham",
                        "counterfeit",
                        "fake"
                    ],
                    "antonyms": [
                        "genuine",
                        "authentic"
                    ],
                    "common_phrases": [
                        "shoddy excuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Претенциозный, фальшивый или поддельный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "липовый",
                                "target_lang_sense_clarification": "поддельный или фальшивый"
                            },
                            {
                                "target_lang_word": "дешевый",
                                "target_lang_sense_clarification": "в значении поверхностный или неубедительный"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "не настоящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37e57fb3-b059-3741-8809-9c200fef8b72",
                    "sense_definition": "Ambitious or pretentious by reason of newly-acquired wealth",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old aristocracy looked down upon the <w>shoddy</w> families who had recently made their fortunes in trade.",
                            "target_lang_translations": {
                                "ru": "Старая аристократия свысока смотрела на семьи <w>выскочек</w>, которые недавно сколотили состояние на торговле."
                            }
                        },
                        {
                            "text": "Their <w>shoddy</w> display of wealth was seen as tasteless by their more established neighbors.",
                            "target_lang_translations": {
                                "ru": "Их <w>вульгарная</w> демонстрация богатства была воспринята их более родовитыми соседями как безвкусица."
                            }
                        }
                    ],
                    "synonyms": [
                        "nouveau riche",
                        "upstart"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in 19th-century contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Амбициозный или претенциозный из-за недавно приобретенного богатства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выскочка",
                                "target_lang_sense_clarification": "о человеке или семье"
                            },
                            {
                                "target_lang_word": "нуворишеский",
                                "target_lang_sense_clarification": "свойственный новым богачам"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cde3ca5-aae8-3b91-a74c-eabf5f34122f",
                    "sense_definition": "A low-grade cloth made from recycled wool or by-products of wool processing",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To fill contracts for uniforms, textile manufacturers compressed the fibers of recycled woolen goods into a material called <w>shoddy</w>.",
                            "target_lang_translations": {
                                "ru": "Для выполнения контрактов на пошив формы производители текстиля спрессовывали волокна переработанных шерстяных изделий в материал, называемый <w>шодди</w>."
                            }
                        },
                        {
                            "text": "The factory specialized in the production of <w>shoddy</w> for inexpensive blankets.",
                            "target_lang_translations": {
                                "ru": "Фабрика специализировалась на производстве <w>искусственной шерсти</w> для недорогих одеял."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoddy cloth"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "historically associated with British textile industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкосортная ткань из переработанной шерсти или отходов шерстяного производства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шодди",
                                "target_lang_sense_clarification": "специальный термин для восстановленной шерсти"
                            },
                            {
                                "target_lang_word": "искусственная шерсть",
                                "target_lang_sense_clarification": "из отходов производства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a1b1d67-0cc3-3735-98ee-b198a08421cf",
                    "sense_definition": "Worthless or inferior goods",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The market was flooded with <w>shoddy</w> that broke after only a few uses.",
                            "target_lang_translations": {
                                "ru": "Рынок был наводнен <w>барахлом</w>, которое ломалось после нескольких использований."
                            }
                        },
                        {
                            "text": "He realized too late that he had spent his savings on absolute <w>shoddy</w>.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что потратил свои сбережения на абсолютную <w>халтуру</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "junk",
                        "rubbish",
                        "trash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезные или низкокачественные товары"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ширпотреб",
                                "target_lang_sense_clarification": "в пренебрежительном смысле о дешевых товарах"
                            },
                            {
                                "target_lang_word": "барахло",
                                "target_lang_sense_clarification": "некачественные вещи"
                            },
                            {
                                "target_lang_word": "халтура",
                                "target_lang_sense_clarification": "некачественно сделанный предмет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}