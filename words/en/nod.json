{
    "word_family": [
        "nodder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9faf1c2-6a7e-310d-9548-7aeb474b1bf4",
                    "sense_definition": "To move the head up and down to show agreement, understanding, or approval.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "head_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>nodded</w> her head to show that she agreed with the plan.",
                            "target_lang_translations": {
                                "ru": "Она <w>кивнула</w> головой, показывая, что согласна с планом.",
                                "zh": "她<w>点头</w>表示同意这个计划。"
                            }
                        },
                        {
                            "text": "The teacher <w>nodded</w> in agreement as the student answered the question correctly.",
                            "target_lang_translations": {
                                "ru": "Учитель одобрительно <w>кивнул</w>, когда ученик правильно ответил на вопрос.",
                                "zh": "当学生正确回答问题时，老师<w>点头</w>表示赞同。"
                            }
                        }
                    ],
                    "antonyms": [
                        "shake"
                    ],
                    "common_phrases": [
                        "nod in agreement",
                        "nod one's head",
                        "nod approval"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать головой вверх-вниз в знак согласия, понимания или одобрения.",
                        "zh": "通过上下移动头部来表示同意、理解或赞同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кивать",
                                "target_lang_sense_clarification": "двигать головой"
                            },
                            {
                                "target_lang_word": "кивнуть",
                                "target_lang_sense_clarification": "однократное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点头",
                                "target_lang_sense_clarification": "表示同意或理解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6979921e-9a5a-38b5-81c7-6508db361063",
                    "sense_definition": "To briefly move the head downwards as a quick greeting or sign of recognition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "head_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>nodded</w> at his neighbor as he walked to his car.",
                            "target_lang_translations": {
                                "ru": "Он <w>кивнул</w> соседу, идя к своей машине.",
                                "zh": "他走向车子时向邻居<w>点头</w>致意。"
                            }
                        },
                        {
                            "text": "I saw my friend across the room and <w>nodded</w> to say hello.",
                            "target_lang_translations": {
                                "ru": "Я увидел друга на другом конце комнаты и <w>кивнул</w> ему в знак приветствия.",
                                "zh": "我隔着房间看见了朋友，便<w>点头</w>打了个招呼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "greet",
                        "acknowledge",
                        "gesture",
                        "signal"
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "nod at someone",
                        "nod a greeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коротко наклонить голову в качестве приветствия или знака узнавания.",
                        "zh": "短暂地低头以示问候或认可。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кивнуть",
                                "target_lang_sense_clarification": "поздороваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点头",
                                "target_lang_sense_clarification": "示意问候"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e690abc-d2bc-31fa-a5b0-7d0f7afc672a",
                    "sense_definition": "To fall asleep for a short time, often unintentionally or while sitting up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather often <w>nods</w> off in his favorite armchair after lunch.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка часто <w>клюет носом</w> в своем любимом кресле после обеда.",
                                "zh": "我爷爷午饭后常在最喜欢的扶手椅里<w>打盹</w>。"
                            }
                        },
                        {
                            "text": "She tried to watch the movie, but she was so tired that she eventually <w>nodded</w> off.",
                            "target_lang_translations": {
                                "ru": "Она пыталась смотреть фильм, но так устала, что в конце концов <w>задремала</w>.",
                                "zh": "她试着看电影，但实在太累了，最后还是<w>打瞌睡</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doze",
                        "drowse",
                        "nap"
                    ],
                    "common_phrases": [
                        "nod off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заснуть на короткое время, часто непреднамеренно или сидя.",
                        "zh": "短时间入睡，通常是无意的或坐着时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клевать носом",
                                "target_lang_sense_clarification": "засыпать сидя"
                            },
                            {
                                "target_lang_word": "задремать",
                                "target_lang_sense_clarification": "погрузиться в сон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打盹",
                                "target_lang_sense_clarification": "小睡"
                            },
                            {
                                "target_lang_word": "打瞌睡",
                                "target_lang_sense_clarification": "困倦入睡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db52bcf6-b532-31e3-b09a-69556dd5250f",
                    "sense_definition": "To hit a ball using the head, especially in sports like soccer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker jumped high and <w>nodded</w> the ball into the net.",
                            "target_lang_translations": {
                                "ru": "Нападающий высоко выпрыгнул и <w>направил головой</w> мяч в сетку.",
                                "zh": "前锋高高跃起，将球<w>头球</w>顶入网中。"
                            }
                        },
                        {
                            "text": "He <w>nodded</w> the pass down to his teammate who was waiting to score.",
                            "target_lang_translations": {
                                "ru": "Он <w>скинул</w> пас головой товарищу по команде, который ждал, чтобы забить.",
                                "zh": "他用<w>头球</w>将球传给等待得分的队友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "head"
                    ],
                    "common_phrases": [
                        "nod the ball",
                        "nod home"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить по мячу головой, особенно в таких видах спорта, как футбол.",
                        "zh": "用头顶球，常见于足球等运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить головой",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "скидывать",
                                "target_lang_sense_clarification": "пас головой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头球",
                                "target_lang_sense_clarification": "足球动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c0640c3-68d7-340e-a635-079299dfc0d8",
                    "sense_definition": "To sway or move up and down gently, often used to describe flowers or trees in the wind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall grass <w>nodded</w> in the gentle summer breeze.",
                            "target_lang_translations": {
                                "ru": "Высокая трава <w>качалась</w> на легком летнем ветерке.",
                                "zh": "高高的草丛在夏日的微风中轻轻<w>摇曳</w>。"
                            }
                        },
                        {
                            "text": "Bright yellow daffodils <w>nodded</w> their heads along the garden path.",
                            "target_lang_translations": {
                                "ru": "Ярко-желтые нарциссы <w>кивали</w> головками вдоль садовой дорожки.",
                                "zh": "明黄色的水仙花沿着花园小径轻轻<w>摇曳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sway",
                        "bob"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавно качаться или двигаться вверх-вниз (о цветах или деревьях на ветру).",
                        "zh": "轻轻摇晃或上下摆动，常用于描述风中的花朵或树木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качаться",
                                "target_lang_sense_clarification": "о растениях"
                            },
                            {
                                "target_lang_word": "кивать",
                                "target_lang_sense_clarification": "поэтическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摇曳",
                                "target_lang_sense_clarification": "植物随风摆动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "937c457b-2866-3bda-94d7-cfa928b3de02",
                    "sense_definition": "To make a reference or allusion to something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director's new film <w>nods</w> to the classic westerns of the past.",
                            "target_lang_translations": {
                                "ru": "Новый фильм режиссера <w>делает отсылку</w> к классическим вестернам прошлого.",
                                "zh": "导演的新片向过去的经典西部片<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "Her painting style <w>nods</w> to the impressionist masters while remaining modern.",
                            "target_lang_translations": {
                                "ru": "Ее стиль живописи <w>перекликается</w> с мастерами импрессионизма, оставаясь при этом современным.",
                                "zh": "她的绘画风格在保持现代感的同时，也<w>影射</w>了印象派大师的作品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allude",
                        "refer"
                    ],
                    "common_phrases": [
                        "nod to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать отсылку или намек на что-либо.",
                        "zh": "对某事进行提及或暗示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать отсылку",
                                "target_lang_sense_clarification": "упоминать"
                            },
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "на источник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "艺术创作中的借鉴"
                            },
                            {
                                "target_lang_word": "影射",
                                "target_lang_sense_clarification": "暗指"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8473b269-b8c2-361e-92e4-ae62f8f6b7f3",
                    "sense_definition": "A movement of the head up and down to show agreement, greeting, or as a signal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "head_movement_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a quick <w>nod</w> to let me know she understood the instructions.",
                            "target_lang_translations": {
                                "ru": "Она сделала короткий <w>кивок</w>, давая понять, что поняла инструкции.",
                                "zh": "她快速<w>点头</w>示意她听懂了说明。"
                            }
                        },
                        {
                            "text": "With a <w>nod</w> of his head, he signaled for us to follow him.",
                            "target_lang_translations": {
                                "ru": "<w>Кивком</w> головы он подал нам знак следовать за ним.",
                                "zh": "他<w>点头</w>示意我们跟上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inclination",
                        "gesture",
                        "signal"
                    ],
                    "antonyms": [
                        "shake"
                    ],
                    "common_phrases": [
                        "give a nod",
                        "nod of the head",
                        "nod of agreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение головой вверх-вниз в знак согласия, приветствия или как сигнал.",
                        "zh": "上下移动头部的动作，以表示同意、问候或作为信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кивок",
                                "target_lang_sense_clarification": "движение головой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点头",
                                "target_lang_sense_clarification": "动作名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edd0766c-3220-3571-b797-384e160ee2f9",
                    "sense_definition": "Official approval or permission to proceed with something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are waiting to get the <w>nod</w> from the manager before starting the project.",
                            "target_lang_translations": {
                                "ru": "Мы ждем, когда менеджер даст <w>добро</w> на запуск проекта.",
                                "zh": "我们正在等待经理的<w>批准</w>以启动项目。"
                            }
                        },
                        {
                            "text": "The committee finally gave the <w>nod</w> to the new building plans.",
                            "target_lang_translations": {
                                "ru": "Комитет наконец дал <w>добро</w> новым планам строительства.",
                                "zh": "委员会最终对新的建筑方案表示<w>首肯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "approval",
                        "go-ahead",
                        "green light",
                        "endorsement"
                    ],
                    "antonyms": [
                        "refusal",
                        "rejection"
                    ],
                    "common_phrases": [
                        "get the nod",
                        "give the nod"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное одобрение или разрешение приступить к чему-либо.",
                        "zh": "进行某事的正式批准或许可。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добро",
                                "target_lang_sense_clarification": "разрешение"
                            },
                            {
                                "target_lang_word": "отмашка",
                                "target_lang_sense_clarification": "сигнал к началу"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "согласие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批准",
                                "target_lang_sense_clarification": "正式许可"
                            },
                            {
                                "target_lang_word": "首肯",
                                "target_lang_sense_clarification": "表示同意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b05ca6d-0e77-3341-a391-b0a39f95f5ce",
                    "sense_definition": "A subtle reference or allusion to something, often in art or literature.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reference_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie contains a respectful <w>nod</w> to classic horror films of the 80s.",
                            "target_lang_translations": {
                                "ru": "Фильм содержит уважительную <w>отсылку</w> к классическим фильмам ужасов 80-х.",
                                "zh": "这部电影包含了一处对80年代经典恐怖片的尊重性<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "His latest book is a <w>nod</w> to the works of Charles Dickens.",
                            "target_lang_translations": {
                                "ru": "Его последняя книга — это <w>реверанс</w> в сторону произведений Чарльза Диккенса.",
                                "zh": "他最新的书是对查尔斯·狄更斯作品的<w>暗示</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allusion",
                        "reference"
                    ],
                    "common_phrases": [
                        "nod to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая отсылка или намек на что-либо, часто в искусстве или литературе.",
                        "zh": "对某事的微妙提及或暗示，常见于艺术或文学中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсылка",
                                "target_lang_sense_clarification": "аллюзия"
                            },
                            {
                                "target_lang_word": "реверанс",
                                "target_lang_sense_clarification": "знак уважения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "艺术上的借鉴"
                            },
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "隐晦的提及"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20bf8c1d-6564-357a-a0db-2047a048baa2",
                    "sense_definition": "An official suggestion of someone for an award or position; a nomination.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor received a <w>nod</w> for Best Actor at the upcoming awards ceremony.",
                            "target_lang_translations": {
                                "ru": "Актер получил <w>номинацию</w> на «Лучшую мужскую роль» на предстоящей церемонии награждения.",
                                "zh": "这位演员获得了即将举行的颁奖典礼的最佳男主角<w>提名</w>。"
                            }
                        },
                        {
                            "text": "Despite the critical acclaim, the film failed to get an Oscar <w>nod</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на признание критиков, фильм не получил <w>номинацию</w> на «Оскар».",
                                "zh": "尽管广受好评，该片还是没能获得奥斯卡<w>提名</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nomination"
                    ],
                    "common_phrases": [
                        "Oscar nod",
                        "Grammy nod"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное выдвижение кого-либо на награду или должность; номинация.",
                        "zh": "对某人获得奖项或职位的正式提名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номинация",
                                "target_lang_sense_clarification": "на награду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提名",
                                "target_lang_sense_clarification": "奖项或职位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}