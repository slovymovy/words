                "entry_id": "ee0dcfa8-8025-3467-ad39-face8bc66059",
                "word": "scaremonger",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "17813589-ad5e-4073-98b7-fed6fbf309cd",
                        "entry_id": "ee0dcfa8-8025-3467-ad39-face8bc66059",
                        "tags": [
                            "plural"
                        ],
                        "form": "scaremongers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e170948-d1ad-3591-9711-4b3b8c9d788a",
                        "entry_id": "ee0dcfa8-8025-3467-ad39-face8bc66059",
                        "glosses": [
                            "Someone who spreads worrying rumours or needlessly alarms people."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfcb65b-8c98-418b-9bc2-af581168b41f",
                                "sense_id": "1e170948-d1ad-3591-9711-4b3b8c9d788a",
                                "text": "I have refrained from giving actual names and dates, for obvious reasons, and have therefore been compelled, even at the risk of being again denounced as a scaremonger, to present the facts in the form of fiction—fiction which, I trust, will point its own patriotic moral."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8227fb-5e67-4db3-87f6-6c3b992d03db",
                        "source_entry_id": "ee0dcfa8-8025-3467-ad39-face8bc66059",
                        "source_sense_id": "1e170948-d1ad-3591-9711-4b3b8c9d788a",
                        "source_sense_description": "alarmist — see also alarmist",
                        "target_lang_word": "šiřitel(ka) poplašných zpráv",
                        "target_lang_code": "cs",
