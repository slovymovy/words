                    {
                        "form_id": "67181848-ede9-40b6-b885-c52c3eed814d",
                        "entry_id": "3b9deb18-2a80-3ef5-9bc6-988748d9d7fe",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Friedensnobelpreise"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b0c91e5-6393-30d1-910f-e21371139f41",
                        "entry_id": "3b9deb18-2a80-3ef5-9bc6-988748d9d7fe",
                        "glosses": [
                            "ein für bedeutende Verdienste um den Weltfrieden gestifteter Preis des schwedischen Chemikers und Industriellen Alfred Nobel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a720574-95ca-4bfb-8028-601c33666175",
                                "sense_id": "9b0c91e5-6393-30d1-910f-e21371139f41",
                                "text": "„Für seine Ostpolitik erhielt Brandt 1971 den Friedensnobelpreis.“"
                            },
                            {
                                "example_id": "2b18cd4e-05b8-4df6-9da8-da3a0bd8356c",
                                "sense_id": "9b0c91e5-6393-30d1-910f-e21371139f41",
                                "text": "„Damit ist der Literatur-Nobelpreis dem Friedensnobelpreis am nächsten.“"
                            },
                            {
                                "example_id": "fc995099-70aa-488d-b603-f73a3545a965",
                                "sense_id": "9b0c91e5-6393-30d1-910f-e21371139f41",
                                "text": "„Den Friedensnobelpreis 2014 an Malala Yousafzai zu vergeben war ein wichtiges Zeichen für mehr Rechte für Frauen, für Gleichberechtigung, für Widerstand gegen das Patriarchat.“"
                            },
                            {
                                "example_id": "e9754fb5-21bd-4f39-9aa3-0625be7a56ba",
                                "sense_id": "9b0c91e5-6393-30d1-910f-e21371139f41",
                                "text": "„Eine besonders kontroverse Diskussion brach los, nachdem die Europäische Union den Friedensnobelpreis mit der Begründung erhalten hatte, die EU hätte zum Frieden in Europa beigetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
