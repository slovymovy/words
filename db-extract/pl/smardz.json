                        "source_sense_id": "34d9c25c-7eb8-3781-9e95-8848e10b6930",
                        "target_lang_word": "Morchel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morchel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb1cf06-ef11-3a57-9488-87f8c026bda1",
                                        "entry_id": "0ef2d699-579a-33db-b946-b84c3e7e648f",
                                        "glosses": [
                                            "Pilz (mit mehreren Arten, darunter auch Speisepilze)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe5c98e-e44c-4b0a-841d-4dff4a77ab89",
                                                "sense_id": "fdb1cf06-ef11-3a57-9488-87f8c026bda1",
                                                "text": "„Zur Vorspeise im traditionellen Värdshuset Lindgården in der Altstadt von Visby werden ein bunter Salat mit Eierschwammerl und geröstetem Elchschinken, außerdem marinierter Gotland-Lachs mit einem milden Senfdressing und Morcheln serviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "925c950a-7675-4b84-a4e5-b887b746134e",
                        "source_entry_id": "c1a3a0cd-9fc7-323c-ad3f-860cb84a2c73",
                        "source_sense_id": "34d9c25c-7eb8-3781-9e95-8848e10b6930",
                        "target_lang_word": "сморчок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сморчок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "62ae1762-b90b-380f-9e0b-e8a93b6b86ae",
                                        "entry_id": "e3792d71-6ce1-3921-ae6b-e87803c105e9",
                                        "glosses": [
                                            "микол. гриб семейства сморчковых, или моршелловых (Morchella)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03017a35-527c-4bfd-ab7a-162b2f467481",
                                                "sense_id": "62ae1762-b90b-380f-9e0b-e8a93b6b86ae",
                                                "text": "Для настоящего ужина повар им приготовил фаршированного поросёнка под галантиром, соус из сморчков и чирков с свежим салатом."
                                            },
                                            {
                                                "example_id": "505e97ed-68e4-44fc-85c0-715b39400875",
                                                "sense_id": "62ae1762-b90b-380f-9e0b-e8a93b6b86ae",
                                                "text": "Мы блуждали по лесным гущам, собирая грибы-подберёзовики, подосиновики, сморчки, опёнки…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сморчок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d831242a-e86c-3d5c-9026-2d75d6b0ed76",
                                        "entry_id": "d3426155-6269-3cb1-bde7-202a5e7b18d0",
                                        "glosses": [
                                            "разг., пренебр. тщедушный, невзрачный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a261647-e5a5-4d8b-bc5b-bb66b75cd663",
                                                "sense_id": "d831242a-e86c-3d5c-9026-2d75d6b0ed76",
                                                "text": "Рядом с ним Тит Горбатый выглядел сморчком: низенький, сгорбленный, с бородкой клинышком и длинными худыми руками, мотавшимися, как деревянные."
                                            },
                                            {
                                                "example_id": "7315176a-00e6-465d-aa86-d08b45798d83",
                                                "sense_id": "d831242a-e86c-3d5c-9026-2d75d6b0ed76",
                                                "text": "Красавица брюнетка с фигурой богини ― и рядом муж, маленький сморчок…"
                                            }
                                        ]
                                    }
                                ]
                            },
