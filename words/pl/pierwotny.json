                    "sense_id": "566279d0-c84c-32b2-9e1e-234a6202e66a",
                    "sense_definition": "istniejący lub występujący na samym początku; początkowy, wyjściowy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "poczatek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musieliśmy diametralnie zmienić nasze <w>pierwotne</w> plany z powodu nagłego załamania pogody.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось кардинально изменить наши <w>первоначальные</w> планы из-за резкого ухудшения погоды."
                            }
                        },
                        {
                            "text": "Po dokładnych badaniach lekarz ustalił <w>pierwotną</w> przyczynę nawracających dolegliwości pacjenta.",
                            "target_lang_translations": {
                                "ru": "После тщательного обследования врач установил <w>первичную</w> причину повторяющихся недомоганий пациента."
                            }
                        }
                    ],
                    "synonyms": [
