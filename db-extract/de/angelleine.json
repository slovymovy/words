                        "sense_id": "fef84e34-87a2-3246-9fc1-0e9cec1f7487",
                        "entry_id": "7099200e-2de2-3610-ad31-4d6c10484cae",
                        "glosses": [
                            "Leine einer Angel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41957ae6-4193-4639-bda2-5accd4ce442a",
                                "sense_id": "fef84e34-87a2-3246-9fc1-0e9cec1f7487",
                                "text": "„Doch er hatte gesehen, was alles am Ende von Angelleinen aus dem Wasser gezogen wurde.“"
                            },
                            {
                                "example_id": "e8483ae3-d41e-4594-b4ae-91a1e22608a9",
                                "sense_id": "fef84e34-87a2-3246-9fc1-0e9cec1f7487",
                                "text": "„Sie aßen ihren Kuchen auf, nahmen die Angelleinen, ließen sie in die Tiefe sinken und warteten dann, dass unten in der Dunkelheit einer anbiss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
