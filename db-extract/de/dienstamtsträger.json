                ],
                "senses": [
                    {
                        "sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                        "entry_id": "c87248c8-b84a-3aa1-b76a-4b179aa7cbbc",
                        "glosses": [
                            "zur Ausübung einer festen Rolle (Dienstamt) feierlich bestellte Person"
                        ],
                        "tags": [
                            "katholische",
                            "Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "fde473c5-d853-43a6-948f-d2645fc260db",
                                "sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                                "text": "„In ihnen kommen angemessen und ausgewogen einzelne Glaubende bzw. Gruppierungen ebenso zu Wort wie Dienstamtsträger oder staatskirchliche Gremien und deren Exponenten, die ‘Basis’ ebenso wie die Hierarchie.“"
                            },
                            {
                                "example_id": "3fc30fc5-f91d-455c-8016-a6e9d036e835",
                                "sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                                "text": "„Anschließend beschreibt er das Gebäude: Es ist zweigeteilt, umfasst einen Ort, der allein den Priestern und Dienstamtsträgern vorbehalten ist, das Sanktuarium [ὶεπατεῖον], und einen Ort, zu dem das ganze gläubige Volk [πᾶσιτοὶς πιστοὶς λαοίς] Zutritt hat, das Kirchenschiff [ναός].“"
                            },
                            {
                                "example_id": "ad06e382-b5c4-4b47-8a23-77e2789abb77",
                                "sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                                "text": "„Andererseits wird selbst die Funktionserfüllung der Dienstamtsträger christologisch, ganz im Sinne des ‚primären Spenders‘, begründet: […]“"
                            },
                            {
                                "example_id": "5f61ddb9-e392-4d35-8734-8f8ff74ac7d3",
                                "sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                                "text": "„Der Geist versieht den ›Dienstamtsträger‹ mit der notwendigen Kraft und Autorität.“"
                            },
                            {
                                "example_id": "566df1f6-5207-4ec0-ac64-1e1103d73176",
                                "sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                                "text": "„Die besonderen Aufgaben der Diakone und Priester werden herausgestellt; sie können teil- und ersatzweise, wenn Bedarf besteht und die hierfür vorgesehenen Weihe- und Dienstamtsträger fehlen, auch Laien übertragen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e4273f9-2e59-4c16-a1c8-1cd40adf81dd",
                        "source_entry_id": "c87248c8-b84a-3aa1-b76a-4b179aa7cbbc",
                        "source_sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                        "source_sense_description": "Inhaber eines Dienstamtes",
                        "target_lang_word": "minister",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b1554d4-d25c-315e-893f-09cfb7639804",
                                        "entry_id": "d2f7abe4-c3c2-3209-99fa-65d15b8276c8",
                                        "glosses": [
                                            "A person who is trained to preach, to perform religious ceremonies, and to afford pastoral care at a Protestant church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a2870f-c95a-40bb-892d-8b9a9fb8b289",
                                                "sense_id": "5b1554d4-d25c-315e-893f-09cfb7639804",
                                                "text": "The minister said a prayer on behalf of the entire congregation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4340fd0-3c95-3682-9d66-1742bb5f4348",
                                        "entry_id": "d2f7abe4-c3c2-3209-99fa-65d15b8276c8",
                                        "glosses": [
                                            "A person (either a layperson or an ordained clergy member) who is commissioned to perform some act on behalf of the Catholic Church."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9df6c811-0abe-3689-b059-0f8287f7250a",
                                        "entry_id": "d2f7abe4-c3c2-3209-99fa-65d15b8276c8",
                                        "glosses": [
                                            "A politician who heads a ministry"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b31f891-9586-40c6-ad00-10920c6086e0",
                                                "sense_id": "9df6c811-0abe-3689-b059-0f8287f7250a",
                                                "text": "He was newly appointed to be Minister of the Interior."
                                            },
                                            {
                                                "example_id": "d1aac4ec-ef91-4880-bd98-3a39eba9053b",
                                                "sense_id": "9df6c811-0abe-3689-b059-0f8287f7250a",
                                                "text": "Ministers to kings, whose eyes, ears, and hands they are, must be answerable to God and man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052b1b4c-7fca-32f4-bf9f-871be582ef2c",
                                        "entry_id": "d2f7abe4-c3c2-3209-99fa-65d15b8276c8",
                                        "glosses": [
                                            "In diplomacy, the rank of diplomat directly below ambassador."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfd3ec65-518d-3c73-ba4a-92def306178b",
                                        "entry_id": "d2f7abe4-c3c2-3209-99fa-65d15b8276c8",
                                        "glosses": [
                                            "A servant; a subordinate; an officer or assistant of inferior rank; hence, an agent, an instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f86a68-a222-4700-84c5-913ce86fbc13",
                                                "sense_id": "bfd3ec65-518d-3c73-ba4a-92def306178b",
                                                "text": "[…], I choſe / Camillo for the miniſter, to poyſon / My friend Polixenes: […]"
                                            },
                                            {
                                                "example_id": "5242001a-b2e3-4a2d-8c04-6272d7a6800f",
                                                "sense_id": "bfd3ec65-518d-3c73-ba4a-92def306178b",
                                                "text": "And Moſes roſe vp, and his miniſter Ioſhua: and Moſes went vp into the mount of God."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8730f58-3eb8-35bd-8501-ffd36f836823",
                                        "entry_id": "126a6eec-a98d-3eb2-8336-3bee54997b5d",
                                        "glosses": [
                                            "To attend to (the needs of); to tend; to take care (of); to give aid; to give service."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e1cd91e-7b89-37fb-9a09-e39e6de979cf",
                                        "entry_id": "126a6eec-a98d-3eb2-8336-3bee54997b5d",
                                        "glosses": [
                                            "To function as a clergyman or as the officiant in church worship."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "404dfa14-e074-33e7-964f-e091081ffac5",
                                        "entry_id": "126a6eec-a98d-3eb2-8336-3bee54997b5d",
                                        "glosses": [
                                            "To afford, to give, to supply."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6bb0b8-9699-4d65-9b03-4d559707caa5",
                                                "sense_id": "404dfa14-e074-33e7-964f-e091081ffac5",
                                                "text": "I do vvell beleeue your Highneſſe, and did it to miniſter occaſion to theſe Gentlemen, […]"
                                            },
                                            {
                                                "example_id": "6d005916-0b84-4144-82b0-29c3d6f75d60",
                                                "sense_id": "404dfa14-e074-33e7-964f-e091081ffac5",
                                                "text": "([…] Now he that miniſtreth ſeede to the ſower, both miniſter bread for your foode, and multiply your ſeede ſowen, and encreaſe the fruites of your righteouſneſſe)"
                                            },
                                            {
                                                "example_id": "077df364-aa9e-4f50-9210-7aada6546826",
                                                "sense_id": "404dfa14-e074-33e7-964f-e091081ffac5",
                                                "text": "We minister to God reason to suspect us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a934dbcb-f6fc-4411-ac96-9f4fb4009565",
                        "source_entry_id": "c87248c8-b84a-3aa1-b76a-4b179aa7cbbc",
                        "source_sense_id": "a78f2a61-4569-3746-ab1a-746ef1f9151b",
                        "source_sense_description": "Inhaber eines Dienstamtes",
                        "target_lang_word": "ministre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ministre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86f3460b-2d2f-3ac1-8517-68253c9aa8ce",
                                        "entry_id": "92db9cb9-a45f-3edd-8f4f-be66994a97cb",
                                        "glosses": [
                                            "Personne chargée de remplir une fonction pour le compte d’autrui."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c00d9e01-1dcf-4757-adbc-91db8163ffae",
                                                "sense_id": "86f3460b-2d2f-3ac1-8517-68253c9aa8ce",
                                                "text": "Ma visite fut un trait de lumière pour la comtesse qui voulut voir en moi le ministre des vengeances du comte"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d550bb2-c74d-3e35-b032-134112848b36",
                                        "entry_id": "92db9cb9-a45f-3edd-8f4f-be66994a97cb",
                                        "glosses": [
                                            "Membre du clergé, pasteur luthérien."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf9126f-3e5b-4bc2-9b3e-f7c5f03ad2ca",
                                                "sense_id": "4d550bb2-c74d-3e35-b032-134112848b36",
                                                "text": "Je ne suis pas non plus du nombre de ceux qui jugent que, pour relever la religion aux yeux des peuples, et mettre en honneur le spiritualisme qu'elle professe, il est bon d'accorder indirectement à ses ministres une influence politique […]. Alexis de Tocqueville, De la démocratie en Amérique, volume 2, 1850, page 164"
                                            },
                                            {
                                                "example_id": "d0c9e0ab-8eb0-47ff-92cd-66f1a498923c",
                                                "sense_id": "4d550bb2-c74d-3e35-b032-134112848b36",
                                                "text": "Les farouches Vendéens, excités par la voix de leurs prêtres, par les discours des ministres du Dieu de miséricorde, égorgeaient, brûlaient vifs, enterraient vivants les républicains qui tombaient entre leurs mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e982e8be-1b20-3c10-b0b9-bca4c42c46e7",
                                        "entry_id": "92db9cb9-a45f-3edd-8f4f-be66994a97cb",
                                        "glosses": [
                                            "Chacune des personnes qui assurent le déroulement d’une liturgie catholique."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb2dbe4-077b-479e-8efa-6684fe5b24b6",
                                                "sense_id": "e982e8be-1b20-3c10-b0b9-bca4c42c46e7",
                                                "text": "Si, à la Messe avec peuple, il n’y a qu’un seul ministre, celui-ci peut exercer diverses fonctions."
                                            },
                                            {
                                                "example_id": "00d3e3ca-67f8-48cd-9bd7-a8c9b539cf0a",
                                                "sense_id": "e982e8be-1b20-3c10-b0b9-bca4c42c46e7",
                                                "text": "«L’écoute des proches du défunt est cruciale! Un peu d’inattention et on passe à côté de l’essentiel… et la cérémonie est fichue d’avance!», lance Nicole Christinat, ministre laïque des funérailles à la paroisse Notre-Dame de Lausanne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92f5157d-007b-3a84-ae81-dd5f3b6fc2c8",
                                        "entry_id": "92db9cb9-a45f-3edd-8f4f-be66994a97cb",
                                        "glosses": [
                                            "Agent diplomatique représentant le gouvernement auprès des gouvernements étrangers qui comportent non une ambassade, mais une légation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3552ec2-700a-4441-a0a9-af2fccfebb69",
                                                "sense_id": "92f5157d-007b-3a84-ae81-dd5f3b6fc2c8",
                                                "text": "Les auteurs du manifeste en prirent occasion d’attaquer M. Poinsett, ministre des États-Unis à Mexico, qu’ils représentèrent comme un agent habile et hypocrite, […]."
                                            },
                                            {
                                                "example_id": "c6b62f68-47ed-4c42-8cd4-276cd3aea1b8",
                                                "sense_id": "92f5157d-007b-3a84-ae81-dd5f3b6fc2c8",
                                                "text": "Et la pauvre femme qui travaille pour m’obtenir le cordon de commandeur de la Légion et le poste de ministre auprès du grand-duc de Bade !"
                                            },
                                            {
                                                "example_id": "ca9b4a0a-0de8-4f59-9039-78707fdad1af",
                                                "sense_id": "92f5157d-007b-3a84-ae81-dd5f3b6fc2c8",
                                                "text": "Après le diner M. B., le ministre plénipotentiaire honoraire, me pris à part pour me consulter sur la possibilité de faire un détour pour éviter « cette Moulouya ». — (Frédéric Weisgerber, Au seuil du Maroc Moderne, Institut des Hautes Études Marocaines, Rabat : Les Éditions de la Porte, 1947, page 268)"
                                            },
                                            {
                                                "example_id": "c0709582-1524-4665-b350-fac5ae6bc187",
                                                "sense_id": "92f5157d-007b-3a84-ae81-dd5f3b6fc2c8",
                                                "text": "Note. À partir de 1945, les légations sont progressivement remplacées par des ambassades, et la distinction entre ambassadeur et ministre tend à disparaître. Le mot « ministre » employé seul pour désigner un agent diplomatique est désormais vieilli, mais l’expression « ministre plénipotentiaire » reste utilisée dans la langue administrative pour désigner des grades ^([2])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                        "entry_id": "92db9cb9-a45f-3edd-8f4f-be66994a97cb",
                                        "glosses": [
                                            "Membre de premier rang d’un gouvernement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef7f2d9-a2e7-4327-8935-8ada18de52c0",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "Empêcher la vie des gens et leur plaisir devrait-il être permis ? De quoi se mêle un ministre ? De quel droit, avec quelle permission ?"
                                            },
                                            {
                                                "example_id": "78cceebe-fe28-4b0e-9897-b5f4f4e9e109",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "Dès minuit, le père Canquoëlle pouvait ourdir toutes les trames, recevoir des espions et des ministres, des femmes et des filles, sans que qui que ce soit au monde s’en aperçût."
                                            },
                                            {
                                                "example_id": "bbef005a-cb53-406b-8590-37b8540388fd",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "Le ministre des Sports, qui est enceinte, n’a pu sauter en parachute comme prévu."
                                            },
                                            {
                                                "example_id": "23ca77cd-4e17-4f33-9ed5-c1bfa36e2880",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "La première impression fait beaucoup avec les imbéciles, et il faut toujours traiter un ministre comme un imbécile, il n’a pas le temps de penser."
                                            },
                                            {
                                                "example_id": "0c1a7ace-9bf8-4202-83ec-dacf9c7b263d",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "Enguerrand de Marigny, le ministre des finances qui avait inspiré à Philippe le Bel sa politique d'altération des monnaies, fut pendu au gibet de Montfaucon."
                                            },
                                            {
                                                "example_id": "666519ae-ffe8-47b9-a907-3a862c2343b8",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "À la fin de 1874 seulement nous nous fixons à Paris quand mon père est devenu ministre des Travaux publics."
                                            },
                                            {
                                                "example_id": "6df199a9-7fd7-4808-9566-8bccc3a0bee7",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "Cette feuille ne craignait pas de dire ce qu'elle pensait, même aux personnages les plus hauts placés. Dans le nᵒ 29 du 30 juin 1793, elle jugeait vertement le général Alexandre Beauharnais, qui venait d'être nommé ministre de la Guerre."
                                            },
                                            {
                                                "example_id": "95315466-e60c-464b-8616-415bfd28023a",
                                                "sense_id": "7b0247de-3570-3a4f-993d-dbf143c94ae5",
                                                "text": "La ministre de l’Écologie Delphine Batho a annoncé, lors de sa visite à l’entreprise MPO, en Mayenne, le 7 janvier, une série de mesures destinées à aider la filière photovoltaïque."
                                            }
                                        ]
