                "senses": [
                    {
                        "sense_id": "b4296ede-b804-3f0b-9dc5-41071d615341",
                        "entry_id": "324a1488-4d06-3e92-a449-339d3abf3be2",
                        "glosses": [
                            "разг. то же, что охаять; обругать, подвергнуть критике"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d044f30a-3bc9-411b-a565-1ecb058183b2",
                                "sense_id": "b4296ede-b804-3f0b-9dc5-41071d615341",
                                "text": "Книга отличная, большая, солидная, но Дима сразу же обхаял супер за сиреневый цвет и за дамскую виньетку на нём, превращённую из его скульптуры «Нежность»."
                            },
                            {
                                "example_id": "a94aa07f-bf3a-4614-9dbf-b17d060e78c6",
                                "sense_id": "b4296ede-b804-3f0b-9dc5-41071d615341",
                                "text": "Единственное, не терплю тех, кто текст прочёл бесплатно, а потом в бложике обхаял текст и автора."
                            }
                        ]
                    }
