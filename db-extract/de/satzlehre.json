                            }
                        ]
                    },
                    {
                        "translation_id": "ab72dc56-8fdf-4e97-8aa8-5389c7f3c4a6",
                        "source_entry_id": "4a035d38-60cd-3f0f-8538-6b1162f04d93",
                        "source_sense_id": "6e810e28-d389-3bc4-bcdc-7e5bf226ebe0",
                        "source_sense_description": "Linguistik: deutscher Terminus für Syntax",
                        "target_lang_word": "синтаксис",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "синтаксис",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "860c93a2-bffe-34b8-94c5-9e003bb12ea6",
                                        "entry_id": "448a2e4c-9803-38a8-ba36-93c1f2871330",
                                        "glosses": [
                                            "лингв. строение предложения и способы сочетания слов в предложении в каком-либо языке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ac2e47-ef04-49ea-a33e-6ca8772233ba",
                                                "sense_id": "860c93a2-bffe-34b8-94c5-9e003bb12ea6",
                                                "text": "Как будто из целого лексикона слов он выбрал именно то, что ни для кого не оказалось годным, как будто для него существовал особый синтаксис, который и хорошие, по-видимому, слова посыпал маком и претворял в снотворные."
                                            },
                                            {
                                                "example_id": "e7f19a18-cb2f-4866-9072-66be5a44e2b7",
                                                "sense_id": "860c93a2-bffe-34b8-94c5-9e003bb12ea6",
                                                "text": "А известно, что у казенной бумаги нет сердца и высушен синтаксис у нее, как гербарий."
                                            },
                                            {
                                                "example_id": "696587ce-768e-442f-b47e-48f037c098b0",
                                                "sense_id": "860c93a2-bffe-34b8-94c5-9e003bb12ea6",
                                                "text": "Я немного изменил и облегчил синтаксис и упростил композицию рассказа."
                                            },
                                            {
                                                "example_id": "9fe7128b-55a9-41b2-934f-c3dcf00b0e31",
                                                "sense_id": "860c93a2-bffe-34b8-94c5-9e003bb12ea6",
                                                "text": "Удрученный Митя на досуге прочитал роман Пруста в подлиннике (мы читали только в переводе) и убедился, что синтаксис оригинала гораздо проще, предложения короче и нет бесконечно длинных периодов, характерных для Пруста по-русски."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d8805e-28f8-37f6-ac61-39435fab5f60",
                                        "entry_id": "448a2e4c-9803-38a8-ba36-93c1f2871330",
                                        "glosses": [
                                            "лингв. раздел языкознания, грамматики, изучающий законы соединения слов и строения предложений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72029a11-53aa-44e6-9037-3251ebcc83e0",
                                                "sense_id": "10d8805e-28f8-37f6-ac61-39435fab5f60",
                                                "text": "И синтаксис, и грамматика, и знаки препинания ― весь арсенал грамотности охотно ей повинуется."
                                            },
                                            {
                                                "example_id": "a44ddcb9-eee9-4f55-9c67-4cc7f9c5315b",
                                                "sense_id": "10d8805e-28f8-37f6-ac61-39435fab5f60",
                                                "text": "По части русского языка у нас были только учебники, то есть грамматика, синтаксис, и риторика."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
