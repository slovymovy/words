                "senses": [
                    {
                        "sense_id": "63af23fc-52b1-3ef3-9b75-55786969e805",
                        "entry_id": "71671cc8-41b3-3b7e-8226-0b5362bf2cac",
                        "glosses": [
                            "mit einer Skala versehenes Reagenzglas zur Bestimmung der Menge an Eiweiß im Harn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22674be-4471-4e00-a99d-2121cf71f5f7",
                                "sense_id": "63af23fc-52b1-3ef3-9b75-55786969e805",
                                "text": "„Zur Bestimmung der Eiweißmenge benutzt man das billige, einfach zu handhabende Albuminimeter von ESBACH.“"
                            },
                            {
                                "example_id": "5938e7b6-8852-4c30-969c-823a710c96b8",
                                "sense_id": "63af23fc-52b1-3ef3-9b75-55786969e805",
                                "text": "„Am vierten Tage der Erkrankung betrug der Eiweissgehalt des Urins mehr, als die Scala des Esbach’schen Albuminimeters zeigt; das specifische Gewicht desselben stellte sich auf 1,055.“"
                            },
                            {
                                "example_id": "15e5f7f0-8e05-4a22-bf71-112ccf7910b5",
                                "sense_id": "63af23fc-52b1-3ef3-9b75-55786969e805",
                                "text": "„In den leichten Fällen stieg die Eiweissmenge bis zu 0,1 %, in den schweren Fällen variirte sie von 0,6 % bis zur Mitte der zwischen den Linien U und R befindlichen Distanz des Albuminimeters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
