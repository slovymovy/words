                ],
                "senses": [
                    {
                        "sense_id": "b3626cc6-f80f-38d3-a08c-97946f05896a",
                        "entry_id": "80a2fcd1-2425-3a58-95ac-c6cbe8e50949",
                        "glosses": [
                            "notdürftig eingerichtetes Gotteshaus oder behelfsmäßig abgeteilter Bereich in etwas, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11715548-027b-4a77-87b4-26d090c7451c",
                                "sense_id": "b3626cc6-f80f-38d3-a08c-97946f05896a",
                                "text": "„Nach Kriegsende formierte sich recht schnell wieder eine Pfarrjugend, die im Schatten der Kirchenruine eine Notkapelle errichtete.“"
                            },
                            {
                                "example_id": "2610f103-6f2d-4e8f-8000-93bbe60ad0ba",
                                "sense_id": "b3626cc6-f80f-38d3-a08c-97946f05896a",
                                "text": "„Zum 1. Januar 1870 kam von St. Leonard der Kaplan Dr. Heinrich Rody, der dann schon zu Christi Himmelfahrt 1871 eine Fachwerk-Notkapelle, vorher als Malerwerkstatt genutzt und von der Gemeinde für 1000 Gulden gekauft, Ecke Berger- und Eichwaldstraße (damals noch Gelnhäuser Straße und Waldstraße) erbaut, mit einem Dachreiter und Glöckchen versehen hatte und für den Gottesdienst für 300 Leute nutzen konnte.“"
                            },
                            {
                                "example_id": "8b61af81-a039-41fe-9628-24defc43c19c",
                                "sense_id": "b3626cc6-f80f-38d3-a08c-97946f05896a",
                                "text": "„So besuchten diese Familien den Gottesdienst in Bitterfeld oder Delitzsch, bevor sie in Eigenleistung eine kleine Notkapelle baute.“"
                            },
                            {
                                "example_id": "12337d79-16b0-4895-b22b-fa44f99afd4d",
                                "sense_id": "b3626cc6-f80f-38d3-a08c-97946f05896a",
                                "text": "„Zum Jahresende 1956 ist auch die Schule in der alten Burg fertig gestellt, ebenso die Notkapelle im Erdgeschoss des Baus.“"
                            },
                            {
                                "example_id": "a11d9cbd-f290-4648-bbcf-dd8443c40055",
                                "sense_id": "b3626cc6-f80f-38d3-a08c-97946f05896a",
                                "text": "„Im zunächst errichteten Seelsorgebezirk wurden die Gottesdienste in einem Wohnhaus in Schwagstorf gefeiert, in dem eine Werkstatt als Notkapelle hergerichtet war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
