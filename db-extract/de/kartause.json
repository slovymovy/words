                    {
                        "sense_id": "e518ba95-d2bb-3f0d-95e3-d241e39b3d71",
                        "entry_id": "9a4d7a35-c508-33d4-9f14-51981c5730a4",
                        "glosses": [
                            "ein oft aus Einzelhäusern bestehendes Kloster der Kartäuser-Mönche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92729788-0862-4da2-8407-4ed4667c9544",
                                "sense_id": "e518ba95-d2bb-3f0d-95e3-d241e39b3d71",
                                "text": "\"Die jüngste Gründung ist die Kartause Sudowon in Südkorea aus dem Jahr 2004.\""
                            },
                            {
                                "example_id": "403e16b3-f57a-4a6b-b2f0-ab50253ff386",
                                "sense_id": "e518ba95-d2bb-3f0d-95e3-d241e39b3d71",
                                "text": "„Erzbischof Balduin hatte, durch die Kartäuser Klostergründung des Mainzer Erzbischofs angeregt, zunächst eine Kartause in Koblenz und danach auch in Trier eine Kartause gegründet.“"
                            },
                            {
                                "example_id": "2d8d2b87-e233-4a45-8c66-e76e349481fe",
                                "sense_id": "e518ba95-d2bb-3f0d-95e3-d241e39b3d71",
                                "text": "„1314 war es nämlich, als der Habsburgische Herzog hungernd durch den Wienerwald irrte und danach die Kartause Mauerbach errichten ließ – ein Kloster für einen Prior und zwölf Mönche, die hier in der Abgeschiedenheit ihr Schweigegelübde lebten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "036f6b1c-1b59-42da-8540-c8677a1b7c9a",
                        "source_entry_id": "9a4d7a35-c508-33d4-9f14-51981c5730a4",
                        "source_sense_id": "e518ba95-d2bb-3f0d-95e3-d241e39b3d71",
