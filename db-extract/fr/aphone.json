                        ]
                    },
                    {
                        "translation_id": "f93286c5-763b-4e51-9db6-e4457b91b6f5",
                        "source_entry_id": "baa46313-61fd-3643-b9f7-c08adf365965",
                        "target_lang_word": "voiceless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voiceless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b27cfa5b-313c-33d3-8d46-098dac1ac8b4",
                                        "entry_id": "31f5509d-7dbc-313d-bc5d-39f95485a083",
                                        "glosses": [
                                            "Lacking a voice, without vocal sound."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1f51b2-6e4c-4e55-bfd0-f6aa8c99ba6e",
                                                "sense_id": "b27cfa5b-313c-33d3-8d46-098dac1ac8b4",
                                                "text": "How people, with any pretence to decency or cleanliness, can, for a day, sit voiceless and patient and see these brutes destroy and befilth everything, public and private, is difficult to believe."
                                            },
                                            {
                                                "example_id": "c9e137fc-ffd9-4c42-adef-52912dba4b7a",
                                                "sense_id": "b27cfa5b-313c-33d3-8d46-098dac1ac8b4",
                                                "text": "A voiceless song in an ageless light / Sings at the coming dawn / Birds in flight are calling there / Where the heart moves the stones / It's there that my heart is calling / All for the love of you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b35cccd-9b17-3ec7-a628-8cb367d4be55",
                                        "entry_id": "31f5509d-7dbc-313d-bc5d-39f95485a083",
                                        "glosses": [
                                            "Without a vote; having no input into a decision."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fef06f3-d033-428f-992f-531896a02dcf",
                                                "sense_id": "7b35cccd-9b17-3ec7-a628-8cb367d4be55",
                                                "text": "I've come to see she is a voiceless person in her world, and so I try to remember to stop and give her my full-faced attention when I see her."
                                            },
                                            {
                                                "example_id": "016cf50a-5f62-47fb-8666-f270161e96c3",
                                                "sense_id": "7b35cccd-9b17-3ec7-a628-8cb367d4be55",
                                                "text": "I feel like hip-hop / Used to be a voice for the voiceless, you know? / And now it's become, at least in the mainstream, a symbol of / misogyny, gay panic, fiscal irresponsibility, you know? / So I figure / if you can't beat 'em / join 'em"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94935d9d-aa04-35d4-a413-07f026881a5b",
                                        "entry_id": "31f5509d-7dbc-313d-bc5d-39f95485a083",
                                        "glosses": [
                                            "Spoken without vibration of the vocal cords; unvoiced, surd, breathed. Examples: [t], [s], [f], [m̥], [u̥]."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
