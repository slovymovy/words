                        ],
                        "examples": [
                            {
                                "example_id": "1aa79890-d0ed-48ed-8195-74b4f33542c6",
                                "sense_id": "09b94937-c450-3eb8-8b5d-51e5aebab122",
                                "text": "Pass auf mit den Blumentöpfen. Da steht noch die Plörre drin.",
                                "translation": "Watch out with the flowerpots. There is still dirty water in them.",
                                "english": "Watch out with the flowerpots. There is still dirty water in them."
                            },
                            {
                                "example_id": "accf9b25-6b1b-45c2-a5d3-43d816540e0b",
                                "sense_id": "09b94937-c450-3eb8-8b5d-51e5aebab122",
                                "text": "Diese Plörre kann man ja nicht trinken.",
                                "translation": "You can't drink these slops.",
                                "english": "You can't drink these slops."
                            }
                        ]
