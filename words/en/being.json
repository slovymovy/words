{
    "word_family": [
        "well-being",
        "non-being"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c17c5794-22bd-3b56-9d65-ca93d23c3e2d",
                    "sense_definition": "The present participle and gerund of <w>be</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>being</w> very helpful to her classmates today.",
                            "target_lang_translations": {
                                "ru": "Сегодня она <ведет себя> очень отзывчиво по отношению к одноклассникам.",
                                "pl": "Ona <zachowuje się> dzisiaj bardzo pomocnie wobec swoich kolegów z klasy."
                            }
                        },
                        {
                            "text": "I really enjoy <w>being</w> part of this team.",
                            "target_lang_translations": {
                                "ru": "Мне очень нравится <быть> частью этой команды.",
                                "pl": "Naprawdę lubię <być> częścią tego zespołu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "being able to",
                        "being late",
                        "being honest"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола <w>be</w>.",
                        "pl": "Imiesłów czasu teraźniejszego lub gerundium czasownika 'być'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть",
                                "target_lang_sense_clarification": "инфинитив"
                            },
                            {
                                "target_lang_word": "будучи",
                                "target_lang_sense_clarification": "деепричастие"
                            },
                            {
                                "target_lang_word": "являясь",
                                "target_lang_sense_clarification": "деепричастие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "być",
                                "target_lang_sense_clarification": "używane jako bezokolicznik w konstrukcjach ciągłych"
                            },
                            {
                                "target_lang_word": "zachowywać się",
                                "target_lang_sense_clarification": "w kontekście tymczasowego zachowania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87b5819f-fdea-3fd1-ae71-0b0953ea457a",
                    "sense_definition": "A living creature, especially a person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "living_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every human <w>being</w> deserves to be treated with respect.",
                            "target_lang_translations": {
                                "ru": "Каждое человеческое <существо> заслуживает уважительного отношения.",
                                "pl": "Każda ludzka <istota> zasługuje na to, by traktować ją z szacunkiem."
                            }
                        },
                        {
                            "text": "The story describes a strange <w>being</w> from another planet.",
                            "target_lang_translations": {
                                "ru": "История описывает странное <существо> с другой планеты.",
                                "pl": "Opowieść opisuje dziwne <stworzenie> z innej planety."
                            }
                        }
                    ],
                    "common_phrases": [
                        "human being",
                        "living being",
                        "supernatural being"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живое создание, особенно человек.",
                        "pl": "Żywa istota, zwłaszcza człowiek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существо",
                                "target_lang_sense_clarification": "живой организм"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "творение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "istota",
                                "target_lang_sense_clarification": "żywy organizm lub osoba"
                            },
                            {
                                "target_lang_word": "stworzenie",
                                "target_lang_sense_clarification": "żywe stworzenie, często w kontekście fantastycznym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49f53d54-dd0c-3124-8505-14200ad28ca5",
                    "sense_definition": "The state or fact of existence, consciousness, or life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "existence_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations came into <w>being</w> early last year.",
                            "target_lang_translations": {
                                "ru": "Новые правила начали свое <существование> в начале прошлого года.",
                                "pl": "Nowe przepisy weszły w <w>życie</w> na początku zeszłego roku."
                            }
                        },
                        {
                            "text": "We decided to stay at the hotel for the time <w>being</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили остаться в отеле на данный <момент>.",
                                "pl": "Zdecydowaliśmy się zostać w hotelu na razie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "come into being",
                        "for the time being",
                        "state of being"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или факт существования, бытия или жизни.",
                        "pl": "Stan lub fakt istnienia, bycia lub życia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существование",
                                "target_lang_sense_clarification": "жизнь, наличие"
                            },
                            {
                                "target_lang_word": "бытие",
                                "target_lang_sense_clarification": "философское понятие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "istnienie",
                                "target_lang_sense_clarification": "fakt bycia obecnym w rzeczywistości"
                            },
                            {
                                "target_lang_word": "bycie",
                                "target_lang_sense_clarification": "stan bycia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d55b307d-9c9e-3d41-83f2-a4c42d0d838c",
                    "sense_definition": "One's basic nature, or the qualities thereof; essence or personality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "existence_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loved her children with her whole <w>being</w>.",
                            "target_lang_translations": {
                                "ru": "Она любила своих детей всем своим <существом>.",
                                "pl": "Kochała swoje dzieci całym swoim <wnętrzem>."
                            }
                        },
                        {
                            "text": "Music seemed to be a part of his very <w>being</w>.",
                            "target_lang_translations": {
                                "ru": "Музыка казалась частью его самого <существа>.",
                                "pl": "Muzyka wydawała się być częścią jego samej <istoty>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whole being",
                        "very being",
                        "inner being"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя природа, сущность или личность человека.",
                        "pl": "Podstawowa natura człowieka, jego esencja lub osobowość."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существо",
                                "target_lang_sense_clarification": "внутренняя природа"
                            },
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "суть"
                            },
                            {
                                "target_lang_word": "естество",
                                "target_lang_sense_clarification": "природа"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "istota",
                                "target_lang_sense_clarification": "głębia czyjejś natury"
                            },
                            {
                                "target_lang_word": "wnętrze",
                                "target_lang_sense_clarification": "głębia duszy lub osobowości"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "2960a576-ff8e-357d-b92d-16aacdfe33e3",
                    "sense_definition": "Given that; since.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will cook dinner tonight, <w>being</w> as you are so tired.",
                            "target_lang_translations": {
                                "ru": "Я приготовлю ужин сегодня, <раз> ты так устал.",
                                "pl": "Przygotuję dzisiaj kolację, <ponieważ> jesteś taki zmęczony."
                            }
                        },
                        {
                            "text": "He decided to walk home, <w>being</w> that the bus was late.",
                            "target_lang_translations": {
                                "ru": "Он решил пойти домой пешком, <так как> автобус опаздывал.",
                                "pl": "Zdecydował się pójść do domu pieszo, <jako że> autobus się spóźniał."
                            }
                        }
                    ],
                    "synonyms": [
                        "because",
                        "seeing that",
                        "as"
                    ],
                    "common_phrases": [
                        "being as",
                        "being that"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as 'being as' or 'being that'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учитывая, что; так как.",
                        "pl": "Biorąc pod uwagę, że; ponieważ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поскольку",
                                "target_lang_sense_clarification": "союз"
                            },
                            {
                                "target_lang_word": "так как",
                                "target_lang_sense_clarification": "союз"
                            },
                            {
                                "target_lang_word": "раз",
                                "target_lang_sense_clarification": "разговорный союз"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ponieważ",
                                "target_lang_sense_clarification": "spójnik przyczynowy"
                            },
                            {
                                "target_lang_word": "jako że",
                                "target_lang_sense_clarification": "spójnik wskazujący na przyczynę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}