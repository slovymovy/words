                "senses": [
                    {
                        "sense_id": "4c0d7607-2940-3797-bed5-b5fa331a3123",
                        "entry_id": "7c583de5-8a01-3dd7-aeb9-7df28433b610",
                        "glosses": [
                            "voltooid deelwoord van aanleggen"
