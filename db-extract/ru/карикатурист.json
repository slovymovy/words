                    {
                        "sense_id": "f35f7866-f7d1-3755-a27c-d8f6721a1b0d",
                        "entry_id": "c1bdce32-85ed-3f41-8c09-2ed798b3820c",
                        "glosses": [
                            "художник, рисующий карикатуры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25968217-4c19-415d-a15c-fcb69b465d5f",
                                "sense_id": "f35f7866-f7d1-3755-a27c-d8f6721a1b0d",
                                "text": "Он отлично рисовал; он был хороший, ядовитый карикатурист; у него было злое сходство и беспощадны под карикатурами подписи."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3e7567e-045e-323f-90cc-9d9fd0f9316c",
                        "entry_id": "c1bdce32-85ed-3f41-8c09-2ed798b3820c",
                        "glosses": [
                            "о писателе, актёре и т. п., изображающем кого-либо, что-либо в карикатурном виде"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd092efd-bb93-4652-a464-0e6dc2d4c9b3",
                        "source_entry_id": "c1bdce32-85ed-3f41-8c09-2ed798b3820c",
                        "target_lang_word": "caricaturist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caricaturist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41adb48b-f531-37d4-9ee9-512266e424b6",
                                        "entry_id": "ec151364-7281-323b-b75e-2b0120d21503",
                                        "glosses": [
                                            "A person who draws caricatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05cc8a8-d682-47f8-a120-b2478d8f0180",
                                                "sense_id": "41adb48b-f531-37d4-9ee9-512266e424b6",
                                                "text": "But, the power of the caricaturist lies in exhibiting with increased ugliness personal and natural defects . . ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b55e5dc-83c1-4acf-aacb-7d8860e70f2d",
                        "source_entry_id": "c1bdce32-85ed-3f41-8c09-2ed798b3820c",
                        "target_lang_word": "caricaturista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b0c3b5a2-24ad-4fd1-bbe3-6c01b34ec4a9",
                        "source_entry_id": "c1bdce32-85ed-3f41-8c09-2ed798b3820c",
                        "target_lang_word": "caricaturista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "85335960-ebd0-4961-a30d-d0704c9955d0",
                        "source_entry_id": "c1bdce32-85ed-3f41-8c09-2ed798b3820c",
                        "target_lang_word": "Karikaturist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karikaturist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                        "entry_id": "d7ce6d78-5cfd-3527-b2b8-74c2ea4b3191",
                                        "glosses": [
                                            "jemand, der Karikaturen zeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b89be371-ed83-4448-a5db-012de3a0f07f",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "Der Karikaturist Jonathan Shapiro, bekannt als Zapiro, hatte die obige Karikatur zu verantworten."
                                            },
                                            {
                                                "example_id": "f7374c4a-c8e9-4811-af80-61e64dbbc2ad",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„Der bekannte griechische Karikaturist steckt Angela Merkel in finster anmutende Uniformen, setzt sie in Panzer und lässt sie griechische Buben erschrecken.“"
                                            },
                                            {
                                                "example_id": "2824949e-809e-42e1-ba37-bd4d0f209cc3",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„Vielmehr offenbart der Karikaturist meist den unbewußten Wunsch, seinen Gegner entstellt und häßlich zu sehen.“"
                                            },
                                            {
                                                "example_id": "ff6c1cc2-dca9-4819-bdec-6d6f17e3096b",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„Die ersten materiellen Früchte seiner literarischen Arbeiten ergänzen nun etwas seine Honorare als Karikaturist und Musikkritiker.“"
                                            },
                                            {
                                                "example_id": "254afa0a-a3aa-4303-bdb8-189fb0a4833e",
                                                "sense_id": "cfe011e7-06b1-38ad-827b-ac47f0413b69",
                                                "text": "„In der Vorstellung auswärtiger Karikaturisten ißt der Deutsche nur Sauerkraut und nichts als Sauerkraut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
