{
    "word": "mandrake",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                "word": "mandrake",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e904cd5-da01-485e-a403-276fe61b2d06",
                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                        "tags": [
                            "plural"
                        ],
                        "form": "mandrakes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bf99b9d-5d72-3f35-8ccd-2b0a20fb7258",
                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                        "glosses": [
                            "Any plant of the genus Mandragora, certain of which are said to have medicinal or aphrodisiac properties; the root of these plants often resembles the shape of a small person, hence occasioning various mythic, magical, or occult uses."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cdce6562-02e2-4a84-8d8e-cc4b128b2eac",
                                "sense_id": "6bf99b9d-5d72-3f35-8ccd-2b0a20fb7258",
                                "text": "[T]his is the true deſcription of the plant and therefore thoſe idle formes of the Mandrakes and Womandrakes, as they are fooliſhly ſo called, which have beene expoſed to publike view, both in ours and other lands and countries, are utterly deceitfull being the work of cunning knaves, onely to get mony by their forgery."
                            },
                            {
                                "example_id": "9a1d79bf-ccd0-4077-81ef-281d3d3308c8",
                                "sense_id": "6bf99b9d-5d72-3f35-8ccd-2b0a20fb7258",
                                "text": "Pharmaceutically tested in recent times, mandrake show aphrodisiac properties."
                            }
                        ]
                    },
                    {
                        "sense_id": "c22540d9-c77e-3e21-becc-3f1865781e7b",
                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                        "glosses": [
                            "A root of a mandrake plant that resembled human form, especially one kept or used for magic or occult purposes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d241fd92-d4ed-4753-98e8-e885c71f0ccd",
                                "sense_id": "c22540d9-c77e-3e21-becc-3f1865781e7b",
                                "text": "Mandrakes were sometimes considered in the light of familiars. Witches kept both male and female specimens of the magic root in bottles[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3ea4ad47-1423-3057-a900-5a26c2e8fcdb",
                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                        "glosses": [
                            "The drug methaqualone."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d5c96cc-0b17-3bba-87e7-0db2765f1c0e",
                        "entry_id": "3f5a73aa-2a5b-3df8-ad30-5c1e880c517c",
                        "glosses": [
                            "A kind of tiny demon immune to fire."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3797ff8-a794-422e-a37f-d9fb112d3cba",
