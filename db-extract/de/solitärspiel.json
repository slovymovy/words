                "senses": [
                    {
                        "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                        "entry_id": "77032240-985a-30c4-8976-82af0ac90704",
                        "glosses": [
                            "Form des Spielens, bei der das Interesse nur auf das eigene Spiel und das eigene Verhalten beschränkt ist und nicht mit anderen interagiert wird beziehungsweise Spielbrett, auf dem es oder Kartenspiel, mit dem es gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295f3b48-2327-4c30-b955-d3d9ccb98e50",
                                "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                                "text": "„In der Tat erscheinen auch in dem vorliegenden Buche altbekannte Spiele, ich erwähne unter den vielen bloß das Boß-Puzzle, das Problem der 15 Pensionatsmädchen, das Solitärspiel, aber, und das ist das Ausschlaggebende, in einer vertieften Gestaltung unter Einordnung der Probleme unter allgemeinere.“"
                            },
                            {
                                "example_id": "e3e1eeba-7a45-433f-a297-2848bdfa66f2",
                                "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                                "text": "„Er spielte im Bett sein Solitärspiel, wie er jetzt manchmal tat, hörte zu, warf eine Frage, ein Lob, einen Tadel in ihre Berichte.“"
                            },
                            {
                                "example_id": "a67187dc-9d67-4870-8a29-798f261aae9f",
                                "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                                "text": "„In der Verhaltensbiologie unterschiedet man die beiden Spiel-Arten Solitärspiel und Sozialspiel. Das Solitärspiel wird alleine, ohne Artgenossen oder andere Mitspieler durchgeführt.“"
                            },
                            {
                                "example_id": "c3259fa1-8e91-48e9-8080-21e7dc0b975b",
                                "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                                "text": "„Die Hausnummern von Samarkand von Ferdinand Hein, Solitärspiel ab 5 Jahren; für ca. 30 Mark erhältlich in ausgewählten Spielwarenfachgeschäften […].“"
                            },
                            {
                                "example_id": "4e87246e-184d-4e3b-87a3-181e81a6f2a7",
                                "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                                "text": "„’Balance of Power’ ist zwar ein klassisches Solitärspiel, doch ohne Zuschauer und Zuspruch macht es viel weniger Spaß.“"
                            },
                            {
                                "example_id": "50f34683-755e-4d5b-b394-eb3e6ce28941",
                                "sense_id": "fc2e5550-1a7a-31d1-83b0-e6eca697b027",
                                "text": "„Auch als Solitärspiel ist ‚Reflexion’ amüsant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
