                    },
                    {
                        "translation_id": "70a72fd5-ca3d-4f58-98c4-859d7e4b62a1",
                        "source_entry_id": "b6d3b820-98e8-37f7-9198-36be2467b0be",
                        "source_sense_id": "9482ef2c-2e0a-3cd6-b414-ded3d75352de",
                        "source_sense_description": "a person who makes or repairs timekeeping devices",
                        "target_lang_word": "horloger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horloger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36551bd6-05d6-3480-b7ad-e2ea35e77868",
                                        "entry_id": "12267d9f-6572-3738-8c5f-1663b75552bb",
                                        "glosses": [
                                            "Relatif à l’horlogerie, aux horloges."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b9f6de2-a529-4247-b37c-1aa629ce2bb2",
                                                "sense_id": "36551bd6-05d6-3480-b7ad-e2ea35e77868",
                                                "text": "L’industrie horlogère."
                                            },
                                            {
                                                "example_id": "b006de41-f700-4d31-8de2-d40e92cbaddc",
                                                "sense_id": "36551bd6-05d6-3480-b7ad-e2ea35e77868",
                                                "text": "Ce besoin s’est fait si bien sentir chez nous, que déjà, à plusieurs reprises, la question de la création d’un journal horloger a été discutée et approfondie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "horloger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7e2afe-37a0-3795-b8b7-625d3cf81ca8",
                                        "entry_id": "37c54532-a8b5-3034-99c3-657623b8448a",
                                        "glosses": [
                                            "Fabricant, vendeur ou réparateur d’horloges, de pendules, de montres."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26303df1-1b53-4a8a-a6ce-f6aac7eab04f",
                                                "sense_id": "3a7e2afe-37a0-3795-b8b7-625d3cf81ca8",
                                                "text": "Moi, j’étais en apprentissage, depuis 1804, chez le vieil horloger Melchior Goulden, à Phalsbourg."
                                            },
                                            {
                                                "example_id": "e5380877-3546-481f-8cc6-7dd5eefa39c6",
                                                "sense_id": "3a7e2afe-37a0-3795-b8b7-625d3cf81ca8",
                                                "text": "Balouard, dont le lorgnon était brisé, reçoit de l’horloger une série de toutes les dyoptries jusqu'à 18."
                                            },
                                            {
                                                "example_id": "c6e92d6d-20d3-40f8-8ad2-942b6971f775",
                                                "sense_id": "3a7e2afe-37a0-3795-b8b7-625d3cf81ca8",
                                                "text": "Une antique Remington occupait l’extrémité d’une table, voisinant avec un registre ouvert et tout ce qu’il fallait pour écrire, plus un cendrier débordant de mégots, une petite lampe à abat-jour vert, un téléphone, un trébuchet sensible comme une midinette, une loupe d’horloger, une pierre de touche, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d610bd-7f16-3691-9603-1f2e01a62ff1",
                                        "entry_id": "37c54532-a8b5-3034-99c3-657623b8448a",
                                        "glosses": [
                                            "Boutique d’un horloger, horlogerie."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b0edb72-a502-4274-84a6-131b3b447e6a",
                                                "sense_id": "21d610bd-7f16-3691-9603-1f2e01a62ff1",
                                                "text": "L’assainissement de l’assortiment des montres en stock chez l’horloger-bijoutier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "horloger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4fd8729-e6c7-3ae0-bddc-19a02074f948",
