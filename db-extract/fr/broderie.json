                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f4e95a4-1242-4950-ac89-598a09d67893",
                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                        "tags": [
                            "plural"
                        ],
                        "form": "broderies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74a79014-d302-341c-be23-021e26e50864",
                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                        "glosses": [
                            "Action de broder."
                        ],
                        "tags": [
                            "Broderie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                        "glosses": [
                            "Ouvrage que l’on fait en brodant."
                        ],
                        "tags": [
                            "Broderie"
                        ],
                        "examples": [
                            {
                                "example_id": "9067aecd-cc85-408f-b5db-7e8c5a943b94",
                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                "text": "Et elle glissa dans son corsage, tout raide de broderies et de diamants, cette lettre qui sortait du pourpoint du jeune homme, […]."
                            },
                            {
                                "example_id": "b27b72f2-36dc-496d-813c-7c239ad7ba24",
                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                "text": "La soie artificielle. […]. Pour certains articles, notamment la passementerie, la rubannerie, les broderies brillantes, on la préfère à la soie naturelle; […]."
                            },
                            {
                                "example_id": "7629b494-807f-4046-927d-abf5b6580f43",
                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                "text": "Souvent, à mi-pente, le touriste aperçoit les grosses touffes jaunes des genêts, une broderie d'orfroi court sous les taillis; […]."
                            },
                            {
                                "example_id": "6a469d37-772e-4ce8-8451-c0fb89f9dd20",
                                "sense_id": "9cfb102d-caf4-33c9-9c45-11b3da4ee152",
                                "text": "Quand il revint, il portait sous son bras trois ou quatre livres. Je n’en puis dire le nombre exact, car ce n’étaient que des liasses de feuilles imprimées, dont les bords jaunis et rongés par le temps rappelaient les broderies du pantalon de ma grand-mère."
                            }
                        ]
                    },
                    {
                        "sense_id": "6be631c6-3e32-3fec-b5ea-1b19774f6124",
                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                        "glosses": [
                            "Détail ou circonstance, que l’on ajoute à un récit pour l’embellir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f89f91-008e-425c-a5ef-d85344d69cf0",
                                "sense_id": "6be631c6-3e32-3fec-b5ea-1b19774f6124",
                                "text": "Il y a de la broderie, un peu de broderie dans ce que vous dites."
                            }
                        ]
                    },
                    {
                        "sense_id": "807e2043-46e4-3132-9f50-6918adfd6be1",
                        "entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                        "glosses": [
                            "Dissonance passagère, consistant en une ou plusieurs notes étrangères suivant, sur un temps faible, une note réelle avant de revenir à cette même note sur un temps fort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf392e80-0bce-404b-9030-0f8a11c7fb09",
                                "sense_id": "807e2043-46e4-3132-9f50-6918adfd6be1",
                                "text": "Remarque : la broderie et la note de passage commencent d’une façon identique. Simplement, la broderie ne poursuit pas son chemin : elle revient à son point de départ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edfb66cf-72ee-4846-8843-e2a80bf133f3",
                        "source_entry_id": "92a98c36-2bda-38bd-a47f-a1f5ca22fda7",
                        "target_lang_word": "Stickerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stickerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a69b0934-efc5-3f30-808e-fddbf36f8e13",
                                        "entry_id": "3c392a1a-3208-34ff-83cc-4c64332bca7e",
                                        "glosses": [
                                            "Tätigkeit, bei der mit Nadel und Garn ein Stück Stoff mit einem Muster oder einem Bild verziert wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68b7cca7-4824-422b-957b-96b789442226",
                                                "sense_id": "a69b0934-efc5-3f30-808e-fddbf36f8e13",
                                                "text": "Die Stickerei hat mir damals meine Oma beigebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f240943-c394-36c1-a057-cfeb8a390bae",
                                        "entry_id": "3c392a1a-3208-34ff-83cc-4c64332bca7e",
                                        "glosses": [
                                            "Produkt/Werk, bei dem Stoff mit einem Muster oder einem Bild verziert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad9857d-bb8a-4f01-9cf8-9dba65ff048a",
                                                "sense_id": "9f240943-c394-36c1-a057-cfeb8a390bae",
                                                "text": "Unsere Sofakissen sind allesamt mit Stickereien verziert."
                                            },
                                            {
                                                "example_id": "e1ed0f46-19ef-46bd-915d-34a34cd7f35e",
                                                "sense_id": "9f240943-c394-36c1-a057-cfeb8a390bae",
                                                "text": "„Eine bunte Jacke voller Stickereien zierte den bedeutendsten Reiter der Großen Armee.“"
                                            },
                                            {
                                                "example_id": "ad820e09-2a00-4044-9608-e9bdf8d86129",
                                                "sense_id": "9f240943-c394-36c1-a057-cfeb8a390bae",
                                                "text": "„Sie vertieft sich wieder in die filigranen blauen Stickereien der Tischdecke.“"
                                            },
                                            {
                                                "example_id": "799e953c-3329-4977-9f39-694cd16cfc93",
                                                "sense_id": "9f240943-c394-36c1-a057-cfeb8a390bae",
                                                "text": "„Sie trug ein mattgelbes Gewand mit Stickereien in Farbtönen von ineinander verblaßtem Blau und Rot.“"
                                            },
                                            {
                                                "example_id": "ddbc09cf-27d1-455a-81dc-cc2ca6d8784b",
                                                "sense_id": "9f240943-c394-36c1-a057-cfeb8a390bae",
                                                "text": "Ásdís schüttelte den Kopf und strich über eine Stickerei auf der Decke neben sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f8aee58c-be92-3a8f-adb3-7ecbdff88bf5",
                                        "entry_id": "3c392a1a-3208-34ff-83cc-4c64332bca7e",
                                        "glosses": [
                                            "Muster oder Bild, das mit Nadel und Garn entstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc75188-b764-4e38-92b3-82f0631b39ba",
                                                "sense_id": "f8aee58c-be92-3a8f-adb3-7ecbdff88bf5",
                                                "text": "Auf Weihnachtsmärkten werden auch Stickereien verkauft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
