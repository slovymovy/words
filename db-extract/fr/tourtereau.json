                    }
                ],
                "senses": [
                    {
                        "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                        "entry_id": "45d5b0c0-1872-3533-81a3-a355b76d6ccd",
                        "glosses": [
                            "Jeune tourterelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4500d421-ee8f-437c-8255-a8c67621b6ea",
                                "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                "text": "Élever des tourtereaux."
                            },
                            {
                                "example_id": "1f98de3b-4cd5-4cba-b439-6047b08f0c19",
                                "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                "text": "Manger des tourtereaux."
                            },
                            {
                                "example_id": "d7dbef9b-dd2b-4466-990c-e3ca597f927f",
                                "sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                                "text": "Dans la volière une tourterelle picore un baiser au bec de son tourtereau et pieusement s’en gargarise."
                            }
                        ]
                    },
                    {
                        "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                        "entry_id": "45d5b0c0-1872-3533-81a3-a355b76d6ccd",
                        "glosses": [
                            "Amoureux, avec une nuance de plaisanterie indulgente."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1984cbd4-7f39-4274-8b86-12ba6f6f18e8",
                                "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                                "text": "Il tenait sa petite femme sous le bras ; elle était fraîche et gaie comme une enfant. Ils avaient l’air de deux tourtereaux."
                            },
                            {
                                "example_id": "3167bfda-fbf5-433e-94b6-601978ad74b8",
                                "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                                "text": "Évidemment ce ne seront plus de très jeunes époux. Ils seront ridicules s’ils veulent prendre des mines de tourtereaux."
                            },
                            {
                                "example_id": "1416a2c7-efb1-48b4-8829-60ceb7877420",
                                "sense_id": "82a0a559-4d90-32ff-aaef-7f7bb99fbea2",
                                "text": "A-t-on jamais vu deux tourtereaux aussi bien assortis ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00bb2b40-2ad3-459d-ab98-df14523bbb9a",
                        "source_entry_id": "45d5b0c0-1872-3533-81a3-a355b76d6ccd",
                        "source_sense_id": "d53d12b8-4d25-3d2f-827d-191c9a96bbb1",
                        "source_sense_description": "Jeune tourterelle.",
                        "target_lang_word": "Taube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a04a81bd-b8f1-354f-aff5-035eee0dbf38",
                                        "entry_id": "f03af1e5-1990-3daa-a693-e7ba063df3bd",
                                        "glosses": [
                                            "eine artenreiche Vogelfamilie aus der Ordnung der Taubenvögel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d721e194-e99c-493b-b831-f379d0602395",
                                                "sense_id": "a04a81bd-b8f1-354f-aff5-035eee0dbf38",
                                                "text": "Das Federkleid der Taube besteht aus ca. 10 000 Federn."
                                            },
                                            {
                                                "example_id": "6e1723e3-afc7-4eb7-9e5b-0338fe1e4949",
                                                "sense_id": "a04a81bd-b8f1-354f-aff5-035eee0dbf38",
                                                "text": "„Die Tauben schlafen.“"
                                            },
                                            {
                                                "example_id": "e199cbf7-5114-449e-9442-e0ff82c8912f",
                                                "sense_id": "a04a81bd-b8f1-354f-aff5-035eee0dbf38",
                                                "text": "„Ein Schwarm weißer Tauben kreiste um den eingestürzten Turm der Marienkirche.“"
                                            },
                                            {
                                                "example_id": "0cd7884b-7e43-4b1b-b758-904de2359bab",
                                                "sense_id": "a04a81bd-b8f1-354f-aff5-035eee0dbf38",
                                                "text": "„Vor allem in dem Waldstück am linken Ufer der Mercy, das sie Jacamar-Wald nannten, erwischten sie haufenweise Cabiais, Tauben, Hasen, Auerhähne und andere Tiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf92c7f0-21e1-368e-a897-1f9c21c3095c",
                                        "entry_id": "f03af1e5-1990-3daa-a693-e7ba063df3bd",
                                        "glosses": [
                                            "mittelgroßer Vogel mit grauem Gefieder; Stadttaube"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef10600d-2322-43b8-8e59-596b64a34e8a",
                                                "sense_id": "cf92c7f0-21e1-368e-a897-1f9c21c3095c",
                                                "text": "Die Tauben machen sehr viel Dreck."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5b65d7a-e13b-399d-a25a-77c0d77f5f74",
                                        "entry_id": "f03af1e5-1990-3daa-a693-e7ba063df3bd",
                                        "glosses": [
                                            "zum Beispiel ein für Frieden und Gewaltfreiheit eintretender Mensch oder auch ein Friedensangebot"
                                        ],
                                        "tags": [
                                            "Symbolik",
                                            "steht für Frieden, Treue und Ähnliches"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7a2298-1850-450f-8878-12601786896b",
                                                "sense_id": "a5b65d7a-e13b-399d-a25a-77c0d77f5f74",
                                                "text": "Wir werden sehen, ob sich die Tauben oder die Falken durchsetzen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4b7ed362-c2a0-3752-9210-6f0e9970fa8b",
                                        "entry_id": "f03af1e5-1990-3daa-a693-e7ba063df3bd",
                                        "glosses": [
                                            "ein Sternbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b17e044f-8924-4b8e-a404-6bd678ea6d6a",
                                                "sense_id": "4b7ed362-c2a0-3752-9210-6f0e9970fa8b",
                                                "text": "Das südliche Sternbild Taube ist in unserem Land nur teilweise an Winterabenden von Januar und Februar sichtbar, wenn es den Meridian überschreitet; dann steht es ganz niedrig über dem südlichen Horizont."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Taube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3be5463c-2a46-3a9c-84ed-0241d0c10b89",
                                        "entry_id": "aeb787ea-f69d-32ef-8efa-9d38c55c5642",
                                        "glosses": [
                                            "weibliche Person, die taub ist, also nicht hören kann"
                                        ],
                                        "tags": [
                                            "Pathologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b0bdd5-328d-47a9-9663-e19bf6412c66",
                                                "sense_id": "3be5463c-2a46-3a9c-84ed-0241d0c10b89",
                                                "text": "Die Taube verständigte sich mit Hilfe der Gebärdensprache."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Taube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                        "entry_id": "f852b929-bed9-3507-8c31-0f3ec9eb0037",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5247e141-739e-48d5-aac8-9e11271ec74f",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Frau Taube ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "74c2ec56-e063-4de6-ae79-8c0f2b67367e",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Herr Taube wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "7bac9829-7d24-4ed4-9080-cedc20c92ddd",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Die Taubes fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "fa5e7399-b732-4dab-8344-f57506ccf6ff",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Der Taube trägt nie die Pullover, die die Taube ihm strickt."
                                            },
                                            {
                                                "example_id": "fe9ea873-a3d5-4263-b6ab-b4bcd906f7a2",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Taube kommt, geht der Herr Taube.“"
                                            },
                                            {
                                                "example_id": "43765b16-064c-4acc-9994-44d58b45e3fb",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Taube kommt und geht."
                                            },
                                            {
                                                "example_id": "e211b82a-ab07-4bfd-8f26-b545dd988ee9",
                                                "sense_id": "1f464d72-95e0-3e14-8400-a6b645e7448a",
                                                "text": "Taubes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
