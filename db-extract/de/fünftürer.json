                "senses": [
                    {
                        "sense_id": "e5b659c9-028d-391d-a0ab-239ffb43b150",
                        "entry_id": "bde60051-02a1-3f09-ace6-b9d025f65a63",
                        "glosses": [
                            "Automobil mit genau fünf Türen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d966f44-f87a-49b4-a4d8-8b44e4807765",
                                "sense_id": "e5b659c9-028d-391d-a0ab-239ffb43b150",
                                "text": "„Wer tendenziell lieber mehr als weniger Sachen mitnimmt, ist mit der Kombi-Version vermutlich besser bedient als mit dem Fünftürer.“"
                            },
                            {
                                "example_id": "e7a9fd45-e15d-4ce5-8dd0-8e229260c5fa",
                                "sense_id": "e5b659c9-028d-391d-a0ab-239ffb43b150",
                                "text": "„Der kurze Dreitürer gibt über Stock und Stein noch einmal eine deutlich bessere Figur ab als der im Januar vorgestellte Fünftürer, sein Bauch setzt nicht so früh auf, und der Wendekreis ist mit kaum mehr als zehn Metern erheblich kleiner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
