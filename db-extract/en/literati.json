                                        "glosses": [
                                            "Celle qui est versée dans la littérature, qui en fait profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d766121-bd8b-40f5-b397-401a2e92ef07",
                                                "sense_id": "b86ee977-3af7-3031-9d2f-069f6353c5b2",
                                                "text": "VENTOLET\nEs-tu littératrice ? (À Lebrun.) Dites-vous littérateur ou littératrice ?\nLEBRUN\nC’est suivant les jours ; mais je dis souvent littérateresse et quelquefois aussi littérateuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "109a8eeb-1bb8-450a-b9fa-4d714acb4e5d",
                        "source_entry_id": "e076e719-653a-3a6d-b772-fae32644ce5e",
                        "source_sense_id": "409ff61c-e132-3cc5-a164-1e69511591a6",
