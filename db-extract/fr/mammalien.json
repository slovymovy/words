                                "example_id": "ee331e71-93aa-42da-bdbb-c2a166726cab",
                                "sense_id": "e604b1e7-1aa7-3c06-b273-5dd6a7bffb0f",
                                "text": "Les reptiles mammaliens."
                            },
                            {
                                "example_id": "135c7b0e-a867-4b89-939a-831482a41a7c",
                                "sense_id": "e604b1e7-1aa7-3c06-b273-5dd6a7bffb0f",
                                "text": "Le développement convergent des chauve-souris et des oiseaux n’a pas grand-chose d’accidentel, car un animal qui se met à voler doit toujours obéir aux lois de l’aérodynamique, quelle que soit son origine biologique - reptilienne (dans le cas des oiseaux) ou mammalienne (dans le cas des chauves-souris)."
                            }
                        ]
                    }
