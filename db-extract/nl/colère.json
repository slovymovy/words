                        "examples": [
                            {
                                "example_id": "850040e6-4523-4cec-95b2-5bdb8694f6c4",
                                "sense_id": "4ba1ac1d-b4fa-368b-b07d-823c6dfefcd6",
                                "text": "Waarna Lamberts in een authentieke colère losbarstte: ,,Ik zou willen afrekenen met de bullshit, want ik heb daar geen ander woord voor, van mensen die denken dat je een muntunie kunt hebben zonder geldoverdracht. Dat is intellectueel incorrect. Nederland zelf is ook geen homogeen land. Ook daar heb je interne transfers tussen de rijkere en armere delen van het land. Dat is zo in Duitsland, dat is zo in Oostenrijk, dat is zo in Finland, dat is overal zo."
                            },
                            {
                                "example_id": "4b612b54-df5a-483a-b3f8-c07171097c7a",
                                "sense_id": "4ba1ac1d-b4fa-368b-b07d-823c6dfefcd6",
                                "text": "Demonstraties zijn volgens haar bedoeld om je ‘colère’ (woede) te laten horen ,,maar we kunnen niet accepteren wat er gisteren is gebeurd in Parijs en in andere Franse steden.’’"
                            }
                        ]
                    }
