                "senses": [
                    {
                        "sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                        "entry_id": "085c548a-d9f0-321c-8474-f372d2e65715",
                        "glosses": [
                            "A child."
                        ],
                        "tags": [
                            "attributive",
                            "often",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4cad2cf8-1145-4184-a383-2d91201a58f6",
                                "sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                                "text": "The kiddie pool was shallow so the children would be safe, which meant it was much warmer than the adult pool."
                            },
                            {
                                "example_id": "391c865b-ddb3-4e48-89a3-8ceffd803116",
                                "sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                                "text": "C. S. Lewis first made kiddie lit a respectable field of study."
                            },
                            {
                                "example_id": "3ec5bcc6-834a-47dc-bbf8-deb15ac51717",
                                "sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                                "text": "Some days later, Dan, Gulunna, and the two kiddies fell in with another tribe which was ruled by Chief Bulla."
                            },
                            {
                                "example_id": "3023c607-200e-4903-8998-b9ef227ac3ac",
                                "sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                                "text": "“He has two kiddies, a pigeon pair.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "814efc61-3432-43e2-a082-770b4efefc36",
                        "source_entry_id": "085c548a-d9f0-321c-8474-f372d2e65715",
                        "source_sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                        "source_sense_description": "a child (hypocorism)",
                        "target_lang_word": "Kleinchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8bf106e4-a412-4041-a81f-518008c5532a",
                        "source_entry_id": "085c548a-d9f0-321c-8474-f372d2e65715",
                        "source_sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
                        "source_sense_description": "a child (hypocorism)",
                        "target_lang_word": "Kindchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e943e9-4a89-3022-9423-12b0b6aaeaaf",
                                        "entry_id": "28df0ac8-1aba-370f-ac70-06525b6bf8be",
                                        "glosses": [
                                            "kleines Kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2adeb70-5459-42c1-a21a-d4a196391223",
                                                "sense_id": "47e943e9-4a89-3022-9423-12b0b6aaeaaf",
                                                "text": "„Schlaf, Kindchen, schlaf!",
                                                "translation": "Schlaf, Kindchen, schlaf!“"
                                            },
                                            {
                                                "example_id": "7450cd51-23f8-481d-9103-76f5bb6d49fd",
                                                "sense_id": "47e943e9-4a89-3022-9423-12b0b6aaeaaf",
                                                "text": "„»Und wenn wir klapprig werden«, sagte Titte Klammergass, »dann ziehen wir eben zu unseren Kinderchen.[…]«“"
                                            },
                                            {
                                                "example_id": "2703b872-df34-41de-8678-e63e7d881594",
                                                "sense_id": "47e943e9-4a89-3022-9423-12b0b6aaeaaf",
                                                "text": "„Dicht daneben, zwischen zwei schlanken Hickorystämmen befestigt, hing, von dem leichten Südwind geschaukelt, eine kleine, aus Papaorinde geflochtene Hängematte, in der ein rotbäckiges Kindchen bis jetzt still und friedlich geschlummert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb1863eb-5187-3240-a7c7-7cfcdc1e4051",
                                        "entry_id": "28df0ac8-1aba-370f-ac70-06525b6bf8be",
                                        "glosses": [
                                            "Kosewort und Anrede an eine (jüngere) weibliche Person"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf5525e-fcf7-46cb-8bde-de04d5eb8766",
                                                "sense_id": "fb1863eb-5187-3240-a7c7-7cfcdc1e4051",
                                                "text": "„O welch ein Trank !",
                                                "translation": "Du hast ganz gewiß mir Dank!“"
                                            },
                                            {
                                                "example_id": "7d1ce1fd-ce44-4494-855a-92502e59cca2",
                                                "sense_id": "fb1863eb-5187-3240-a7c7-7cfcdc1e4051",
                                                "text": "„Na, na, Kindchen, heulen Sie nicht.“"
                                            },
                                            {
                                                "example_id": "0aaa6706-4fae-44ac-b83f-63087cc8e804",
                                                "sense_id": "fb1863eb-5187-3240-a7c7-7cfcdc1e4051",
                                                "text": "„»Na, Kindchen, da haben Sie aber mächtig Ärger an der Backe«, startete sie einen vagen Versuch, mich zu trösten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "17bd5497-1734-3c78-a28f-9ed191e44672",
                                        "entry_id": "28df0ac8-1aba-370f-ac70-06525b6bf8be",
                                        "glosses": [
                                            "Anrede an mehrere Personen"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e2a710c-07d3-473d-a0db-f7bfa3b2d48b",
                                                "sense_id": "17bd5497-1734-3c78-a28f-9ed191e44672",
                                                "text": "„»Ach, Kinderchen, meine lieben Freunde, fürchten Sie sich nicht vor dem Leben![…]«“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73fafefc-26a3-44a2-8c99-79e3747a8475",
                        "source_entry_id": "085c548a-d9f0-321c-8474-f372d2e65715",
                        "source_sense_id": "0ddf0830-2e55-3ba7-b760-abdd9d8da62c",
