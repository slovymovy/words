                "senses": [
                    {
                        "sense_id": "42a24b3c-96aa-3333-9996-ae4985670e87",
                        "entry_id": "e296b380-8a00-35f7-82ba-fd5a7e48e1e8",
                        "glosses": [
                            "das Verkleiden oder auch die Verkleidung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24624453-d9dd-47f8-bd44-80fbd96cf4c3",
                                "sense_id": "42a24b3c-96aa-3333-9996-ae4985670e87",
                                "text": "„Des Erfolges sicher, obwohl ich noch keinen Plan für eine Maskierung von fünf Personen im Kopf hatte, wartete ich auf einen ruhigeren Augenblick, um mir den Kopf darüber zu zerbrechen, denn im Moment beschäftigte mich Irene zu sehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0d9851e4-a3d9-33a0-bb10-cb83f82292aa",
                        "entry_id": "e296b380-8a00-35f7-82ba-fd5a7e48e1e8",
                        "glosses": [
                            "das Ab-/Verdecken oder auch Verbergen von etwas"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a05625df-3306-4787-96a8-2e87671abd63",
                                "sense_id": "0d9851e4-a3d9-33a0-bb10-cb83f82292aa",
                                "text": "„Für die Maskierung unangenehmer oder bitterer Geschmacksnoten funktionaler Inhaltsstoffe hat WACKER die Lösung: Durch die Komplexierung der funktionalen Substanzen mit Cyclodextrinen - ringförmigen, enzymatisch aus Stärke hergestellten Zuckermolekülen - lassen sich unangenehme Geschmacksprofile verändern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ac95fdf-d285-4b8f-b72b-8072796b9b97",
                        "source_entry_id": "e296b380-8a00-35f7-82ba-fd5a7e48e1e8",
