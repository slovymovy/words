                    },
                    {
                        "sense_id": "775b4684-0c3d-3731-85c9-0c096ad47f4f",
                        "entry_id": "7cda75fa-febe-39f3-8b6f-8b4342831332",
                        "glosses": [
                            "A thoughtless person."
                        ],
                        "tags": [
                            "derogatory",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2e9fa364-ffcf-4de1-8a34-f3258884f7b4",
                                "sense_id": "775b4684-0c3d-3731-85c9-0c096ad47f4f",
                                "text": "Muzzling Kelly also elevates a semi-professional obscurantist to the status of free speech martyr, and that invites a cacophonous pile-on from the rightwing bobble heads who screech about the left’s obsession with identity politics while shovelling identity politics at their audiences."
                            },
                            {
                                "example_id": "7446330c-cc5c-4c5d-9812-8fd5d6502b8e",
                                "sense_id": "775b4684-0c3d-3731-85c9-0c096ad47f4f",
                                "text": "Will Trump and his G.O.P. bobbleheads ever wake up to that? Maybe — when it’s too late."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec3582c8-31f6-3fa3-8372-a6a84397d356",
                        "entry_id": "7cda75fa-febe-39f3-8b6f-8b4342831332",
