                ],
                "senses": [
                    {
                        "sense_id": "e4b2ed4f-159b-3c11-b05f-cbdce96aafb1",
                        "entry_id": "8de79aa3-817b-3b5b-9884-bbf2fcda15ce",
                        "glosses": [
                            "eine dauerhafte Kennzeichnung, eine Markierung oder auch ein weithin sichtbarer Punkt, der zur Orientierung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4395473d-8d22-42b6-afef-297c04a802e4",
                                "sense_id": "e4b2ed4f-159b-3c11-b05f-cbdce96aafb1",
                                "text": "Bei der Bombardierung von Köln, im 2. Weltkrieg, war der Kölner Dom die einzige Landmarke der Stadt die von den Bomber nicht zerstört werden sollte."
                            },
                            {
                                "example_id": "226c792d-23e3-470e-bf9d-bdb4d062454d",
                                "sense_id": "e4b2ed4f-159b-3c11-b05f-cbdce96aafb1",
                                "text": "„Weithin sichtbare Geländepunkte sind Landmarken, die Teilgebieten des Geoparks ihren Namen geben.“"
                            },
                            {
                                "example_id": "1712ab13-7fb7-4e6f-8df3-9656e58138fb",
                                "sense_id": "e4b2ed4f-159b-3c11-b05f-cbdce96aafb1",
                                "text": "„Der erste Schritt ist die Extraktion von potentiellen Landmarken, die zu routenabhängigen Landmarken weiterverarbeitet werden können.“"
                            },
                            {
                                "example_id": "ea21fd7b-0cc9-4ec0-bd96-477035a25e21",
                                "sense_id": "e4b2ed4f-159b-3c11-b05f-cbdce96aafb1",
                                "text": "„Als begehbare Stahlkonstruktion konzipiert, die je nach Perspektive ihre Form verändert, symbolisiert die Landmarke in einzigartiger Weise die Erinnerung an den Bergbau und zugleich den dynamischen Wandel in der Bergbauregion.“"
                            },
                            {
                                "example_id": "7eb76379-71f5-4fac-b576-3a1e75bbbb61",
                                "sense_id": "e4b2ed4f-159b-3c11-b05f-cbdce96aafb1",
                                "text": "„Unsere Kirchen sind keine Nicht-Orte. Sie sind Landmarken und Orientierungspunkte in den Herzen unserer kleinen oder größeren Städte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
