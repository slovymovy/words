                    {
                        "sense_id": "a9952698-a25a-3a1f-b286-a6d87a9b4645",
                        "entry_id": "7a99726e-0330-3d4b-8a85-f78c4014aa16",
                        "glosses": [
                            "een persoonlijk getinte tekst vooraf in een boek e.d., meestal bedoeld als inleiding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62675522-c918-4429-a776-2bff2dca1dbe",
                                "sense_id": "a9952698-a25a-3a1f-b286-a6d87a9b4645",
                                "text": "Zoals het voorwoord stelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b27c8c1-6f29-4d16-924d-dda21b8cd699",
                        "source_entry_id": "7a99726e-0330-3d4b-8a85-f78c4014aa16",
                        "source_sense_id": "a9952698-a25a-3a1f-b286-a6d87a9b4645",
                        "target_lang_word": "preface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "A beginning or introductory portion that comes before the main text of a document or book, typically serving to contextualize or explain the writing of the book and sometimes to acknowledge others' contributions; especially, such a discussion written by the work's own author."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b306a6b7-7406-41ad-b114-4d969963a503",
                                                "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                                                "text": "Holonyms: front matter, prelims"
                                            },
                                            {
                                                "example_id": "543b85f9-24e9-4336-8aeb-5670301e0e64",
                                                "sense_id": "fe48a188-aa6f-30ad-919e-c64292f8fb54",
                                                "text": "The book included a brief preface explaining the author's motivations for writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "An introduction, or series of preliminary remarks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6512da1-0042-44f2-abfa-71703ae5ba2c",
                                                "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                                "text": "This superficial tale / Is but a preface of her worthy praise."
                                            },
                                            {
                                                "example_id": "53726171-f07c-415c-aa8c-b64555bb4667",
                                                "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                                "text": "Heav'ns high behest no preface needs."
                                            },
                                            {
                                                "example_id": "59dab612-43f6-4ae2-89f2-95c4be3ae605",
                                                "sense_id": "d0eafa5a-71d0-3189-a97a-c78b2f1ec06e",
                                                "text": "And now, without any further preface, we proceed to our next chapter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c8cbef0-44b7-3e1d-9f7e-87bb79fa4195",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "A variable prayer forming the prelude or introduction to the Eucharistic Prayer or canon of the Mass, following the Sursum corda dialogue and leading into the Sanctus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e9d2e9-9593-45b4-b7c8-436afa11840b",
                                                "sense_id": "5c8cbef0-44b7-3e1d-9f7e-87bb79fa4195",
                                                "text": "Meronyms: protocol, embolism, eschatocol"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bdd8572-5c21-3602-9281-26c2b657017c",
                                        "entry_id": "cd4e1a9c-0640-3438-9ea0-ce4efac3934d",
                                        "glosses": [
                                            "A title or epithet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82db2888-9271-4e37-a454-15e682148d0f",
                                                "sense_id": "5bdd8572-5c21-3602-9281-26c2b657017c",
                                                "text": "[…] a black-tie dinner to celebrate on the eve of the ceremony which would remove the preface \"Sir\" from his name and replace it with the preface \"Lord,\" thought by some to be one of the most potent words in the English language."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d4d107-3031-3614-9ca5-19c150a0d1a9",
                                        "entry_id": "35a8dea7-e7b8-31a3-8071-c8ef3cd18212",
                                        "glosses": [
                                            "To introduce or make a comment before (the main point); to premise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df4f5238-93ad-4d99-be22-8dc3c86e15d1",
                                                "sense_id": "e0d4d107-3031-3614-9ca5-19c150a0d1a9",
                                                "text": "Let me preface this by saying that I don't know him that well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fbf5916-aaf6-3b27-9722-094a99c7b10c",
                                        "entry_id": "35a8dea7-e7b8-31a3-8071-c8ef3cd18212",
                                        "glosses": [
                                            "To give a preface to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0994044f-c092-4558-bdb4-3d899f8c0c5d",
                                                "sense_id": "3fbf5916-aaf6-3b27-9722-094a99c7b10c",
                                                "text": "to preface a book"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
