                },
                {
                    "sense_id": "5a886558-c826-301a-a406-89bb38789e37",
                    "sense_definition": "Free of impediment; unimpeded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The path was <w>expedite</w> and clear for the travelers.",
                            "target_lang_translations": {
                                "ru": "Путь путешественников был <w>беспрепятственным</w> и чистым."
                            }
                        },
                        {
                            "text": "They sought an <w>expedite</w> route through the dense forest.",
                            "target_lang_translations": {
                                "ru": "Они искали <w>свободный</w> маршрут сквозь густой лес."
                            }
                        }
