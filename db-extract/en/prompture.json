                        "examples": [
                            {
                                "example_id": "e9fb237c-40ed-48aa-875e-e7117d95e231",
                                "sense_id": "ab0e7edd-2f88-3aa1-bc8c-79cfee237b5f",
                                "text": "I'll to my brother:\n Though he hath fallen by prompture of the blood,\n Yet hath he in him such a mind of honour.\n That had he twenty heads to tender down\n On twenty bloody blocks, he'd yield them up,\n Before his sister should her body stoop\n To such abhorr'd pollution."
                            },
                            {
                                "example_id": "64c973aa-3e72-4891-bf7e-3289c43b3e13",
                                "sense_id": "ab0e7edd-2f88-3aa1-bc8c-79cfee237b5f",
                                "text": "Has not, since then, Love's prompture deep,\nHas not Love's whisper evermore\nBeen ceaseless, as thy gentle roar?"
                            }
                        ]
                    }
