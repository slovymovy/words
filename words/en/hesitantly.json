{
    "word_family": [
        "hesitate",
        "hesitation",
        "hesitant"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "99acf973-8b6b-3115-a1e0-1b8243db3bc5",
                    "sense_definition": "In a manner showing uncertainty or a pause before acting or speaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hesitantly</w> stepped onto the stage to begin her speech.",
                            "target_lang_translations": {
                                "ru": "Она <w>нерешительно</w> вышла на сцену, чтобы начать свою речь."
                            }
                        },
                        {
                            "text": "The child <w>hesitantly</w> answered the question after a long pause.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>нерешительно</w> ответил на вопрос после долгой паузы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak hesitantly",
                        "move hesitantly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ действия, выражающий неуверенность или паузу перед тем, как что-то сделать или сказать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нерешительно",
                                "target_lang_sense_clarification": "выражает сомнение или заминку"
                            },
                            {
                                "target_lang_word": "колеблясь",
                                "target_lang_sense_clarification": "деепричастие, подчеркивающее процесс сомнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4f2dbf2-d555-31d8-99ac-b9b07dea7713",
                    "sense_definition": "In a manner showing unwillingness or lack of enthusiasm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hesitantly</w> agreed to help with the project despite his busy schedule.",
                            "target_lang_translations": {
                                "ru": "Он <w>неохотно</w> согласился помочь с проектом, несмотря на свой плотный график."
                            }
                        },
                        {
                            "text": "The employee <w>hesitantly</w> accepted the new rules imposed by management.",
                            "target_lang_translations": {
                                "ru": "Сотрудник <w>неохотно</w> принял новые правила, введенные руководством."
                            }
                        }
                    ],
                    "synonyms": [
                        "reluctantly"
                    ],
                    "common_phrases": [
                        "agree hesitantly",
                        "accept hesitantly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ действия, выражающий нежелание или отсутствие энтузиазма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неохотно",
                                "target_lang_sense_clarification": "выражает отсутствие желания или энтузиазма"
                            },
                            {
                                "target_lang_word": "с сомнением",
                                "target_lang_sense_clarification": "выражает скептическое отношение к действию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}