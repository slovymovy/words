                        "source_sense_id": "cc15ea89-42af-3fc0-af0a-69c6b4b21e5d",
                        "target_lang_word": "spree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "325d4aa4-0380-3261-9a38-3b68693d0c79",
                                        "entry_id": "72bc2ea5-6258-3ba1-bae8-15f640bc647e",
                                        "glosses": [
                                            "Uninhibited activity."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dbd6fd4-1236-4f90-a629-d54e92b472be",
                                                "sense_id": "325d4aa4-0380-3261-9a38-3b68693d0c79",
                                                "text": "spending spree"
                                            },
                                            {
                                                "example_id": "edab8b94-2e8c-429c-8320-74218735df8f",
                                                "sense_id": "325d4aa4-0380-3261-9a38-3b68693d0c79",
                                                "text": "Then all three major builders were called upon to deliver 105 Berkshires before the buying spree was over."
                                            },
                                            {
                                                "example_id": "7329484a-99d7-4568-9fde-7fb6d608018e",
                                                "sense_id": "325d4aa4-0380-3261-9a38-3b68693d0c79",
                                                "text": "Twitter has been on a hiring spree, spending $630 million on stock-based compensation in 2021, a 33 percent increase from the previous year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802069ce-1645-3d36-8b0a-69fc136e1b1e",
                                        "entry_id": "72bc2ea5-6258-3ba1-bae8-15f640bc647e",
                                        "glosses": [
                                            "A merry frolic; especially, a drinking frolic."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647b1762-e001-4578-b78c-41cbb4b22feb",
                                                "sense_id": "802069ce-1645-3d36-8b0a-69fc136e1b1e",
                                                "text": "Tradition says she spent the last two years of her life in the strange den I have been speaking of, after having indulged herself in one final, triumphant and satisfying spree."
                                            },
                                            {
                                                "example_id": "0c646172-9404-485b-8157-90d2fadb666c",
                                                "sense_id": "802069ce-1645-3d36-8b0a-69fc136e1b1e",
                                                "text": "It would be a long time before he could be like the majority of these men of the road, who roamed until the hunger for drink and for women mastered them, and then went to work with a purpose in mind, and stopped when they had the price of a spree."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c247d49-9575-3e6b-8439-eafe14859375",
                                        "entry_id": "5b11bc35-3282-3ef3-bfef-3ea548cb8457",
                                        "glosses": [
                                            "To engage in a spree."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be004692-4719-45ad-abf1-1f33b452b4a4",
                                                "sense_id": "4c247d49-9575-3e6b-8439-eafe14859375",
                                                "text": "And I never spreed with the fellows as a student any more than I had enjoyed myself with the lads in the playground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
