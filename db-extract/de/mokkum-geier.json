                    {
                        "translation_id": "d3231bdc-ab8f-42bf-940f-f73b2d287ea7",
                        "source_entry_id": "f3e35790-82e0-3343-a064-56e8a64c0e96",
                        "source_sense_id": "666a12c6-cffe-38d1-9bf5-742c5a915f94",
                        "source_sense_description": "umgangssprachlich: städtischer Müßiggänger; Bettler, Hausierer",
                        "target_lang_word": "mendiant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mendiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d71bbae2-fbca-3aa3-a998-89ca37c44f2f",
                                        "entry_id": "a9b5f3c5-1405-3235-92b8-579bd589b568",
                                        "glosses": [
                                            "Dont la subsistance dépend de la charité publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32eb966f-146c-4d60-8483-44f854b7aa27",
                                                "sense_id": "d71bbae2-fbca-3aa3-a998-89ca37c44f2f",
                                                "text": "Religieux mendiants, moines mendiants."
                                            },
                                            {
                                                "example_id": "7e4510e1-f65f-4309-903c-d8e2d1f5d358",
                                                "sense_id": "d71bbae2-fbca-3aa3-a998-89ca37c44f2f",
                                                "text": "Les Capucins, les Franciscains sont des moines mendiants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a2668e5-194d-30ef-ab58-af79ca6fc008",
                                        "entry_id": "a9b5f3c5-1405-3235-92b8-579bd589b568",
                                        "glosses": [
                                            "Qui quémande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4143b47-7421-43e7-b8b3-b4e24d9e1b46",
                                                "sense_id": "0a2668e5-194d-30ef-ab58-af79ca6fc008",
                                                "text": "Le gentleman rutilant de ses gains, auquel, vers deux heures du matin, fatigué, affamé et crevant de soif — j’avais fait le voyage Paris-Deauville en auto-stop —, je débitai une mendiante prière bien tournée, passa son chemin sans me regarder, mais en me disant : « Je suis navré, cher ami. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mendiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88740d0f-b564-3bdc-ae3c-4343574eb28d",
                                        "entry_id": "18f1ccbf-8453-3e8b-95cb-33cde6b303fa",
                                        "glosses": [
                                            "Celui qui sollicite des dons pour survivre, qui vit de mendicité."
                                        ],
                                        "tags": [
                                            "Errance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c5583d-83c3-46c6-9f56-718583a91798",
                                                "sense_id": "88740d0f-b564-3bdc-ae3c-4343574eb28d",
                                                "text": "D’un geste auguste, il jetait le chat aux pieds de mam’zelle Geneviève […] et aussitôt, se mettait à le dépecer, gardant la viande pour les mendiants, faisant sécher, au bout d’un bâton, la peau qu’elle vendait aux Auvergnats."
                                            },
                                            {
                                                "example_id": "98826c6b-7554-4f68-b38f-5010dc6e7e7d",
                                                "sense_id": "88740d0f-b564-3bdc-ae3c-4343574eb28d",
                                                "text": "Elle aimait les mendiants, comme les crapauds, les limaces, et les cimetières, avec une certaine horreur."
                                            },
                                            {
                                                "example_id": "5ca3cb20-bb61-4024-b5a8-afa5c2fd15d9",
                                                "sense_id": "88740d0f-b564-3bdc-ae3c-4343574eb28d",
                                                "text": "Des mendiants, parmi lesquels on remarque un assez grand nombre de lépreux, reconnaissables à leurs visages voilés et ombragés d’immenses chapeaux en feuilles de palmier nain, bordent la route, et le Sultan leur fait faire l’aumône."
                                            },
                                            {
                                                "example_id": "2f7e28ca-d73a-4c52-9954-d0707f962857",
                                                "sense_id": "88740d0f-b564-3bdc-ae3c-4343574eb28d",
                                                "text": "– Tu veux me faire pleurer ?… Et quand je pense à l’argent, à nos « moyens d’existence » !… Il faudra apprendre à mendier. Je nous vois mendiant à Lyon. C’est la dernière ville au monde où je voudrais être mendiant !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1871c4ee-4ef6-3fc0-a895-698dc78abadc",
                                        "entry_id": "18f1ccbf-8453-3e8b-95cb-33cde6b303fa",
                                        "glosses": [
                                            "Ordre mendiant, celui qui choisit de mendier pour des raisons religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff00f6dc-5ba6-416c-b0e0-0cf0d88c1a7f",
                                                "sense_id": "1871c4ee-4ef6-3fc0-a895-698dc78abadc",
                                                "text": "Les quatre mendiants, se disait autrefois des Jacobins, des Franciscains, des Augustins et des Carmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc976d0-70b9-3f33-8d10-ac9aeea8e626",
                                        "entry_id": "18f1ccbf-8453-3e8b-95cb-33cde6b303fa",
                                        "glosses": [
                                            "Quatre sortes de fruits secs, qui sont les figues, les noisettes, les raisins et les amandes, et dont on fait des assiettes de dessert."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11c5fa0-7f7d-441c-86db-1bdde87dcaaa",
                                                "sense_id": "cbc976d0-70b9-3f33-8d10-ac9aeea8e626",
                                                "text": "Les quatre mendiants."
                                            },
                                            {
                                                "example_id": "cfcf037e-7dc8-4dfa-9783-5231556009ac",
                                                "sense_id": "cbc976d0-70b9-3f33-8d10-ac9aeea8e626",
                                                "text": "Une assiette de mendiants."
                                            },
                                            {
                                                "example_id": "21e3c1df-5933-466b-a0ab-456efe96b52e",
                                                "sense_id": "cbc976d0-70b9-3f33-8d10-ac9aeea8e626",
                                                "text": "– Regardez Myriam, cela ce sont nos pachichòis.\nMadame Chabaud est heureuse de montrer ses traditions provençales. Sur quatre assiettes, les mendiants sont disposés pour symboliser le quatre ordres religieux ayant fait vœu de pauvreté. Les dattes, avec un « O » gravé sur le noyau, évoquent l’exclamation de la Sainte Famille lorsqu’elle goûta ce fruit pour la première fois.\n– Si on n’a pas de dattes, on prend une figue sèche que l’on fourre d’une noix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eaa1c13-a5bc-3fc5-8fe4-34511fde1c91",
                                        "entry_id": "18f1ccbf-8453-3e8b-95cb-33cde6b303fa",
                                        "glosses": [
                                            "Petit gâteau sec recouvert de chocolat sur lequel se trouvent des petits morceaux de fruits secs."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ee41e9-6b08-46b4-8f41-a7ffa97a0271",
                                                "sense_id": "7eaa1c13-a5bc-3fc5-8fe4-34511fde1c91",
                                                "text": "Et elle sort de son cabas une aumônière de papier de soie crème.\nJ’entreprends d’en dénouer le ruban de velours bleu. À l’intérieur, des mendiants au chocolat noir scintillent comme diamants ténébreux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083c2e9c-12f5-3ed7-97c1-d5da8734bd0f",
                                        "entry_id": "18f1ccbf-8453-3e8b-95cb-33cde6b303fa",
                                        "glosses": [
                                            "(vaisselle) Plat de service souvent en 3 parties avec une anse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665b5ae6-3ea4-4b46-9480-3aa9fbc5ab9e",
                                                "sense_id": "083c2e9c-12f5-3ed7-97c1-d5da8734bd0f",
                                                "text": "Plat de présentation trilobé ou serviteur muet à trois compartiments (dit « mendiant »), décor de scènes bretonnes…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mendiant",
