                                "example_id": "577e7e3b-4b9f-4b01-9327-bd63841070d9",
                                "sense_id": "def921b4-b8dd-3dca-9fdd-9f2209f801a5",
                                "text": "Szesnastoletni Bułgar zajął trzecie miejsce w międzynarodowych zawodach narciarstwa alpejskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
