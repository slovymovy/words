                                "target_senses": [
                                    {
                                        "sense_id": "0851d666-8fe0-37f8-a326-1abf5a698484",
                                        "entry_id": "c83d65da-3367-315a-8087-c1d5fd8a1558",
                                        "glosses": [
                                            "von gleich langer Dauer"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6dfb205-9e74-4daa-8c4d-db469b3681ed",
                                                "sense_id": "0851d666-8fe0-37f8-a326-1abf5a698484",
                                                "text": "Kommt das Signal bei Sprach- oder Videoübertragung in zeitlich konstanten Abständen, wird es als isochrones Signal bezeichnet."
                                            },
                                            {
                                                "example_id": "52110294-ad5d-471d-a6f0-4a7f6ed31833",
                                                "sense_id": "0851d666-8fe0-37f8-a326-1abf5a698484",
                                                "text": "Nur isochrone Kommunikation gewährleistet, dass die Signale beim Empfänger die gleichen zeitlichen Abstände aufweisen wie beim Sender, was vor allem bei bewegten Bildern wichtig ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0db61eb-adc2-41e4-9239-5b31060fbc71",
                        "source_entry_id": "ed786199-4cd8-344c-a5e0-ab22586c40ba",
                        "source_sense_id": "97b5fbf8-d7ee-36dd-b274-5a9633f0ccca",
