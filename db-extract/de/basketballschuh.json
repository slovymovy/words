                ],
                "senses": [
                    {
                        "sense_id": "264357aa-648e-3604-9cef-de11f543c0fc",
                        "entry_id": "2f8b158c-4718-36e1-9f40-8787a1c872f4",
                        "glosses": [
                            "Schuh zum Basketballspielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46a48e6-1db4-4a9e-81e3-c2607bbd2dbc",
                                "sense_id": "264357aa-648e-3604-9cef-de11f543c0fc",
                                "text": "„Diese ausgehungerte Alte, die hier vor ihm kauerte, die Füße in zu großen, löchrigen Basketballschuhen, ihre mageren Arme und Beine in einem zu weiten, mit Klebeband geflickten Overall, Klebeband, das sich an den Enden ablöste und dreckverschmiert war - ihr Name war Ramantha.“"
                            },
                            {
                                "example_id": "b1e0ea71-7ae4-402a-823c-3c80a0f5ab89",
                                "sense_id": "264357aa-648e-3604-9cef-de11f543c0fc",
                                "text": "„Des weiteren fanden sich in dem taubenblauen Innenraum außer Flusswasser ein blaues, mit Blüten besticktes Jeanshemd, eine mit Efeulaub bestickte Bluejeans und ein Paar Basketballschuhe der Marke Converse, jedoch weit und breit kein Rant Casey.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
