                "senses": [
                    {
                        "sense_id": "01a49708-b75f-3096-b57c-f473289be222",
                        "entry_id": "02b43489-3ebe-31f8-a862-916f79db6963",
                        "glosses": [
                            "Tüte aus Fließpapier, die man in den Kaffeefilter legt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae5961b-aabc-444b-8999-83df680f509b",
                                "sense_id": "01a49708-b75f-3096-b57c-f473289be222",
                                "text": "Der Kaffeefilter wurde bereits benutzt."
                            },
                            {
                                "example_id": "7251bdec-9fa6-4b1f-b4e6-9e9a9b4357d0",
                                "sense_id": "01a49708-b75f-3096-b57c-f473289be222",
                                "text": "„Volker zeigte mir, wie man Filtertüten umknickt und wann man den Topf mit der Milch für den Kaba vom Herd nimmt.“"
                            },
                            {
                                "example_id": "63f5b113-1a49-48db-860c-b5552c26e3e2",
                                "sense_id": "01a49708-b75f-3096-b57c-f473289be222",
                                "text": "„Sie stellt den Porzellanfilter mit der Filtertüte auf die Kanne, löffelt Kaffeepulver hinein und gießt kochendes Wasser darüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
