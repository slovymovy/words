                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f216e87-dcc0-4994-8fb1-3dae163e4b49",
                                "sense_id": "91532476-3f3c-38b6-a2ab-b131ea40a694",
                                "text": "„Obwohl er kein übermäßig intelligenter Mann war, hatte er schließlich gelernt, wie man gleichzeitig geht und Kaugummi kaut, obwohl es Leute gab, die beschworen, er habe den Trick erst nach heimlichem Mitternachtstraining hingekriegt.“"
                            },
                            {
                                "example_id": "54404558-2fb5-4821-987a-1db6b598214d",
                                "sense_id": "91532476-3f3c-38b6-a2ab-b131ea40a694",
                                "text": "Großer Beliebtheit erfreute sich auch das traditionelle Mitternachtstraining zur Geisterstunde, das jedes Jahr bei dieser Maßnahme stattfindet."
                            },
                            {
                                "example_id": "3c1329f2-a937-4736-9ac3-81e901f624ba",
                                "sense_id": "91532476-3f3c-38b6-a2ab-b131ea40a694",
                                "text": "In elf Trainingseinheiten (inklusive einem Mitternachtstraining) wurden die neusten Wettkampf- und Trainingsstandards vermittelt.."
                            },
                            {
                                "example_id": "dbf8b39e-abf3-4eb2-ac7e-b103ee8a3d7c",
                                "sense_id": "91532476-3f3c-38b6-a2ab-b131ea40a694",
                                "text": "Zudem rief er 1994 das mittlerweile traditionelle Kinderzeltlager der Gemeinde Täferrot sowie das Mitternachtstraining ins Leben."
                            }
                        ],
                        "sense_index_json": "\"1\""
