                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "922b045c-1ead-4e10-a454-5193f5da7dbc",
                        "source_entry_id": "d61f1a0a-efb1-36b0-827a-77c10aa2aa7a",
                        "source_sense_id": "9ca4141d-14e0-3b18-af23-f559e5c873ea",
