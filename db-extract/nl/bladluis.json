                    {
                        "sense_id": "4980924e-8119-3834-aa25-d3968f534c3e",
                        "entry_id": "403bc5eb-04e5-3cf2-9b99-9b2b46170acd",
                        "glosses": [
                            "Aphidoidea klein plantenetend schadelijk insect dat zich met stekende en zuigende monddelen (stiletten) passief voedt met sappen uit het floëem. Het floëemsap stroomt door de zeefvaten en staat onder hoge druk. Het wordt door de plant in het voedselkanaal van de bladluis geperst zodra de stiletten een floëemvat aanprikken"
                        ],
                        "tags": [
                            "halfvleugeligen"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "866b70fe-229f-4211-a6fb-997b5189e8fd",
                        "source_entry_id": "403bc5eb-04e5-3cf2-9b99-9b2b46170acd",
                        "source_sense_id": "4980924e-8119-3834-aa25-d3968f534c3e",
                        "source_sense_description": "een schadelijk klein insect dat zich voedt met het sap van jonge plantenscheuten...",
                        "target_lang_word": "Blattlaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blattlaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                        "entry_id": "1d3068f5-7ee1-3765-af48-490d3745310d",
                                        "glosses": [
                                            "kleines, schädliches Insekt, das sich von Pflanzensaft ernährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b537bad0-ef64-48bf-8b07-7a2247cc5cf2",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "Die Blattlaus lebt vom Saft der Blätter und dadurch schädigt sie die Pflanzen."
                                            },
                                            {
                                                "example_id": "a6acc585-a885-47cc-8460-d04868c90bb7",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "Ameisen pflegen und melken die Blattläuse, weil sie den Saft für ihre eigene Brut verwenden."
                                            },
                                            {
                                                "example_id": "7afa7ac5-72f7-4979-8b7e-785933e76dee",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "Die Blattläuse scheiden Honigtau aus."
                                            },
                                            {
                                                "example_id": "7ea23cd4-9711-4f11-9aab-e603fe36d1e8",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "„Ohrwürmer verzehren große Mengen von Blattläusen.“"
                                            },
                                            {
                                                "example_id": "472833c6-0c1e-4f91-9292-d3982c0c9289",
                                                "sense_id": "90809803-6a3f-3b5f-b2b9-3fe7643eddab",
                                                "text": "„Bei der Jungfernzeugung (Parthogenese) entwickeln sich auch unbefruchtete Eier (z.B. bei den Bienen und Blattläusen).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
