                        "target_lang_word": "bestärken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bestärken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48015d45-335a-3a4f-b68a-cc62242b95ac",
                                        "entry_id": "94125740-02a8-3a19-ac30-b6f73a76444d",
                                        "glosses": [
                                            "jemanden in einer Haltung, einem Vorhaben stützen und ermutigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f62f7ab2-6f0e-491b-b2c9-2c49c674a267",
                                                "sense_id": "48015d45-335a-3a4f-b68a-cc62242b95ac",
                                                "text": "Ich bestärkte ihn in seinem Wunsch eine Weltreise zu machen."
                                            },
                                            {
                                                "example_id": "de9705eb-4a83-4c48-8c46-75e5293534b3",
                                                "sense_id": "48015d45-335a-3a4f-b68a-cc62242b95ac",
                                                "text": "Wir müssen sie jetzt darin bestärken, dass sie völlig richtig gehandelt hat."
                                            },
                                            {
                                                "example_id": "30543b1a-fb79-4916-8cd8-ccb6c4e963ac",
                                                "sense_id": "48015d45-335a-3a4f-b68a-cc62242b95ac",
                                                "text": "„Ich [sein Vater] war es, der ihn [meinen Sohn] darin bestärkt hat, zur Demo zu gehen und Schule zu schwänzen, weil ich es wichtig finde, dass meine Kinder ein politisches Bewusstsein entwickeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53026429-2936-361a-ba16-46dccfc374fd",
                                        "entry_id": "94125740-02a8-3a19-ac30-b6f73a76444d",
                                        "glosses": [
                                            "etwas bestärkt sich: stärker werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccffcb9a-523d-4c82-a864-b98ed9aef9e4",
                                                "sense_id": "53026429-2936-361a-ba16-46dccfc374fd",
                                                "text": "Der Verdacht bestärkte sich in mir."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e75a03eb-ea16-3bef-8077-7e817efcb85b",
                                        "entry_id": "94125740-02a8-3a19-ac30-b6f73a76444d",
                                        "glosses": [
                                            "ein Resultat sicherer werden lassen; verstärken, fördern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5929c6d0-490b-4f35-a630-0cff5d8b6756",
                                                "sense_id": "e75a03eb-ea16-3bef-8077-7e817efcb85b",
                                                "text": "Dieser Vorfall bestärkt meine Ablehnung gegenüber diesen Plan."
                                            },
                                            {
                                                "example_id": "0f8263ef-7914-4478-b8c8-bd2c527c9312",
                                                "sense_id": "e75a03eb-ea16-3bef-8077-7e817efcb85b",
                                                "text": "Das bestärkt doch nur noch, was wir sowieso schon wissen."
                                            },
                                            {
                                                "example_id": "758465da-2560-442b-a481-1d8a4cb75058",
                                                "sense_id": "e75a03eb-ea16-3bef-8077-7e817efcb85b",
                                                "text": "Das Gespräch hat mich darin bestärkt, aus dem Verein auszutreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
