                                            {
                                                "example_id": "c57ee401-c151-4373-a2d2-8c57ea069400",
                                                "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                                "text": "Les grammairiens se sont passé le mot pendant des siècles pour « muettiser » les femmes, estime Céline Labrosse, auteur de Pour une grammaire non sexiste. Il faut donc « dégenriser », dit-elle, abolir la prépondérance du masculin."
                                            },
                                            {
                                                "example_id": "dad78cb1-84ee-4d13-96f8-3001c1bd556f",
                                                "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                                "text": "Pour la septième semaine, Céline Parzys mettra à l’honneur le patrimoine culinaire de la Charente-Maritime."
                                            },
                                            {
                                                "example_id": "8ea0ea6e-1d99-40db-9db5-d8258ebe9bf6",
                                                "sense_id": "db29185f-d25b-330f-97ba-fe8b861b4f98",
                                                "text": "Dis-moi, Céline, les années ont passé\n Pourquoi n'as-tu jamais pensé à te marier ?\n De tout's mes sœurs qui vivaient ici\n Tu es la seule sans mari."
                                            }
                                        ]
                                    }
                                ]
                            },
