                        "examples": [
                            {
                                "example_id": "9d2d2d5a-da52-40d6-aabf-4ec985cc85af",
                                "sense_id": "6926ed2f-b215-3567-8d47-0a497a19930c",
                                "text": "Een Belgische kinderpsychiater gaat de kinderen individueel en gezamenlijk met de ouders begeleiden. Hij zegt dat er een sterke solidariteit is tussen alle kinderen onderling en hun ouders en naaste familie."
                            },
                            {
                                "example_id": "c473b3ac-a95d-457b-a3bc-9e5f2a959891",
                                "sense_id": "6926ed2f-b215-3567-8d47-0a497a19930c",
                                "text": "De kerk benaderde een gerenommeerd kinderpsychiater om al deze klachten te behandelen. Bij de Commissie-Adriaenssens diende zich in korte tijd ruim 450 slachtoffers aan van misbruik binnen de kerk."
                            }
                        ]
