                "senses": [
                    {
                        "sense_id": "f55e2c9c-f9ef-3d68-a284-35d79c84563e",
                        "entry_id": "b19deacd-0b90-3bd3-a774-6b6282a9e613",
                        "glosses": [
                            "związany z osobą lub tytułem palatyna, dotyczący palatyna"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "208bdc2c-8e58-3f40-bf7b-fc77a4a14a91",
                        "entry_id": "b19deacd-0b90-3bd3-a774-6b6282a9e613",
                        "glosses": [
                            "związany z Palatynatem, dotyczący Palatynatu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34064d1-5887-4b39-8745-6ee99218e7d6",
                                "sense_id": "208bdc2c-8e58-3f40-bf7b-fc77a4a14a91",
                                "text": "Co do księstwa Dwóch Mostów, to drogą sukcesji przypadło ono – jak już wspomnieliśmy – Gustawowi Samuelowi Leopoldowi z palatyńskiego rodu Wittelsbachów"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7c7b1de5-c094-35bb-b466-495458d20529",
                        "entry_id": "b19deacd-0b90-3bd3-a774-6b6282a9e613",
                        "glosses": [
                            "związany z Palatynem, dotyczący Palatynu (wzgórza w Rzymie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83301235-c344-4143-84cf-ba27c75af7d9",
                                "sense_id": "7c7b1de5-c094-35bb-b466-495458d20529",
                                "text": "Dla mnie same pałace palatyńskie nie byłyby mieszkaniem godnym ciebie, więc chciałbym także, by ci nie brakło niczego z tych ozdób i wygód, do których z dzieciństwa przywykłaś"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
