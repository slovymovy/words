                "senses": [
                    {
                        "sense_id": "085ac663-0137-33f6-a2a2-48d6329ba632",
                        "entry_id": "314894ac-238f-3c13-a236-bafd13ea3aa1",
                        "glosses": [
                            "аукнуть, подать сигнал криком «ау»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932bc19c-3152-4d53-b52d-6cae621bf6e5",
                                "sense_id": "085ac663-0137-33f6-a2a2-48d6329ba632",
                                "text": "Я хотел аукнуться — рот мой раскрылся и не издал ни звука."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e4d9b64-b016-3d10-8e2d-c2d4e5119f2b",
                        "entry_id": "314894ac-238f-3c13-a236-bafd13ea3aa1",
                        "glosses": [
                            "перен. отозваться, явиться следствием (обычно нежелательным) чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3387e345-8d2c-4aa7-bae0-8d4be1f6f482",
                                "sense_id": "3e4d9b64-b016-3d10-8e2d-c2d4e5119f2b",
                                "text": "Мы были ограничены в выборе исполнителей, особенно в защите — что и аукнулось нам во время матча."
                            },
                            {
                                "example_id": "9e25fd5a-f68e-48df-b689-9055ce873894",
                                "sense_id": "3e4d9b64-b016-3d10-8e2d-c2d4e5119f2b",
                                "text": "Позднее это аукнулось большой бедой."
                            }
                        ]
                    }
                ],
