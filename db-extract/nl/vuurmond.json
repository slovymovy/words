                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f90b0416-cb64-34c8-a6b1-8b8272ba3c4e",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "A large muzzle-loading artillery piece."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927553b6-c5eb-4a60-9d59-4aff5ebc71b6",
                                                "sense_id": "f90b0416-cb64-34c8-a6b1-8b8272ba3c4e",
                                                "text": "Near-synonym: gun (often synonymous)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3a1435-0d2f-3ab7-a99b-7a8121f6d101",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "A carom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effb6de7-231a-4480-a447-109bcbafec85",
                                                "sense_id": "3a3a1435-0d2f-3ab7-a99b-7a8121f6d101",
                                                "text": "In English billiards, a cannon is when one’s cue ball strikes the other player’s cue ball and the red ball on the same shot; and it is worth two points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a0600a-6fcf-3356-a15f-24645d518082",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "The arm of a player who can throw well."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d93f6d9b-7929-4328-81ba-be5b2cfe4102",
                                                "sense_id": "a6a0600a-6fcf-3356-a15f-24645d518082",
                                                "text": "He’s got a cannon out in right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e9d4bc-58e9-35ef-a7b1-623052c155bc",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "A hollow cylindrical piece carried by a revolving shaft, on which it may, however, revolve independently."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a205180-36a3-3b0d-9ee4-ba6e395343d6",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "A cylindrical item of plate armor protecting the arm, particularly one of a pair of such cylinders worn with a couter, the upper cannon protecting the upper arm and the lower cannon protecting the forearm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fedd0a2-150c-44d3-8e88-51e5a920e22b",
                                                "sense_id": "9a205180-36a3-3b0d-9ee4-ba6e395343d6",
                                                "text": "The pauldrons are rather weak, but the cannons of the vambraces are good and come from an Italian armour of considerably earlier date, for they have the tulip form of the first half of the century."
                                            },
                                            {
                                                "example_id": "c961449d-c6f2-4798-85cf-0196ba36a3e4",
                                                "sense_id": "9a205180-36a3-3b0d-9ee4-ba6e395343d6",
                                                "text": "During the second half of the century the upper cannons were often joined to the pauldrons […] Here the cannons and the couter, although separate, are joined together when worn by the points securing them to the arming […]"
                                            },
                                            {
                                                "example_id": "8de4fb5e-50ba-4d8f-843e-fde19afd8307",
                                                "sense_id": "9a205180-36a3-3b0d-9ee4-ba6e395343d6",
                                                "text": "The breastplate was now usually globular in shape with attached tassets. The arm defenses were almost always in one piece, the lower and upper cannons joined permanently to the couter with internal leathers and rivets, and the whole frequently also joined permanently to the pauldron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0852fdf4-1ef7-3397-8866-88ae5af02a64",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "Alternative form of canon (“a large size of type”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "841c1b4d-1569-369b-87b0-6274940ba07f",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "A piece which moves horizontally and vertically like a rook but captures another piece by jumping over a different piece in the line of attack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04705f65-e42b-38d6-8a96-46a4f329d320",
                                        "entry_id": "7a0b1554-81fc-3f4b-ae93-662e242a466f",
                                        "glosses": [
                                            "A pickpocket."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7af845e-0552-498d-9a7b-79083b24d6df",
                                                "sense_id": "04705f65-e42b-38d6-8a96-46a4f329d320",
                                                "text": "I also learned never to conspicuoulsy^([sic]) watch a cannon while he was working. Pickpockets dislike being watched, even by those who may be \"right,\" because they become uneasy and clumsy and feel conspicuous."
                                            },
                                            {
                                                "example_id": "70a069b5-ce2b-4c15-b14b-24281254c1af",
                                                "sense_id": "04705f65-e42b-38d6-8a96-46a4f329d320",
                                                "text": "A good pickpocket is known to his fellows as a pistol. Rufus Dayne is a cannon. One of the best pickpockets in the country, he makes close to a million dollars a year and has no criminal record at all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cannon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1719ea88-6fcc-30c8-b255-9118d4c99dd1",
                                        "entry_id": "cf73a37f-99f3-3c2e-a70d-008240b0055a",
                                        "glosses": [
                                            "To bombard with cannons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c945d96c-b271-3296-ba12-568fded50ad1",
                                        "entry_id": "cf73a37f-99f3-3c2e-a70d-008240b0055a",
                                        "glosses": [
                                            "To play the carom billiard shot; to strike two balls with the cue ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7c2074-08cc-47c6-a67c-5cd8d1261486",
                                                "sense_id": "c945d96c-b271-3296-ba12-568fded50ad1",
                                                "text": "The white cannoned off the red onto the pink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ea6d32-79c5-33e0-9407-e5eae08a3fe2",
                                        "entry_id": "cf73a37f-99f3-3c2e-a70d-008240b0055a",
                                        "glosses": [
                                            "To fire something, especially spherical, rapidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "957194ca-dbee-4756-8a69-fa84c4bb1b2b",
                                                "sense_id": "83ea6d32-79c5-33e0-9407-e5eae08a3fe2",
                                                "text": "Montenegro had hardly threatened in the second period but served notice they were still potent as Nikola Vukcevic took a smart pass from Jovetic and cannoned a shot off Hennessey's shins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff967ef-e1f6-3305-976a-2da7afe412ef",
                                        "entry_id": "cf73a37f-99f3-3c2e-a70d-008240b0055a",
                                        "glosses": [
                                            "To collide or strike violently, especially so as to glance off or rebound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf05ed0-9457-4540-884a-b3a3a8dc2146",
                                                "sense_id": "7ff967ef-e1f6-3305-976a-2da7afe412ef",
                                                "text": "[…] he heard the right-hand goal post crack as a pony cannoned into it—crack, splinter, and fall like a mast."
                                            },
                                            {
                                                "example_id": "a8517e22-fd08-4734-a6ac-68b4247e0f32",
                                                "sense_id": "7ff967ef-e1f6-3305-976a-2da7afe412ef",
                                                "text": "She ran down the stairs which she had come up so nervously that morning and cannoned into Edmund at the bottom."
                                            }
                                        ]
                                    }
                                ]
                            },
