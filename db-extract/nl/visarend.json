                        "cross_references": [
                            {
                                "target_word": "balbuzard pêcheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fba60f6b-ccd6-3b31-b6b9-dea67ba7c9e5",
                                        "entry_id": "d80df7c8-ee54-3f1f-9e49-5916236294e8",
                                        "glosses": [
                                            "Espèce d’oiseau rapace diurne (falconiforme) de la famille des accipitridés, piscivore de taille moyenne au ventre blanc, ainsi que la tête qui présente sur les yeux une bande sombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d0055a-545e-45a7-9031-ce19f571b620",
                                                "sense_id": "fba60f6b-ccd6-3b31-b6b9-dea67ba7c9e5",
                                                "text": "Avec beaucoup de chance, vous pourriez apercevoir le balbuzard pêcheur, une espèce rare."
                                            },
                                            {
                                                "example_id": "50935787-585d-4a56-9a54-4cffe0565c0e",
                                                "sense_id": "fba60f6b-ccd6-3b31-b6b9-dea67ba7c9e5",
                                                "text": "Le Balbuzard pêcheur se nourrit uniquement de poissons, qu’il pêche en plongeant pattes tendues vers l’avant, serres grandes ouvertes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c3e4a79-2f1c-4038-83f1-32be534a864d",
                        "source_entry_id": "1901dba1-8753-3392-8d55-cde1e9945ddc",
                        "source_sense_id": "321f3bbc-3823-324e-a7d6-24859c528e45",
                        "source_sense_description": "Pandion haliaetus, een vooral visetende roofvogel die de enige soort uit de familie Pandionidae is",
                        "target_lang_word": "скопа",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "скопа",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ba7526a4-8ac6-3e7f-88aa-9217f9f81ea0",
                                        "entry_id": "b183ab8a-10a3-38ae-832c-fca72e460cee",
                                        "glosses": [
                                            "зоол., орнитол. крупная хищная птица семейства ястребиных (лат. Falko haliaetos), обитающая по берегам рек, озёр и питающаяся рыбой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375b9f78-d17d-4b6e-b2d7-18a925d1bca0",
                                                "sense_id": "ba7526a4-8ac6-3e7f-88aa-9217f9f81ea0",
                                                "text": "В камышах не проглотит утёнка жадная щука, не унесёт цыплёнка коршун или скопа, которую называют водяным орлом и которая преимущественно питается рыбою."
                                            },
                                            {
                                                "example_id": "c40e904d-ed20-4d08-a426-505997ce10d2",
                                                "sense_id": "ba7526a4-8ac6-3e7f-88aa-9217f9f81ea0",
                                                "text": "Странно, что степные орлы, орланы, речная скопа — почти все только пролётные, на гнездование остаются очень немногие."
                                            },
                                            {
                                                "example_id": "de9fb271-a65e-46bc-877c-3ded6bdff3f0",
                                                "sense_id": "ba7526a4-8ac6-3e7f-88aa-9217f9f81ea0",
                                                "text": "Сегодня Петя видел над озером скопу и потому, что за ней гнались галки, принял было за ястреба, но она повернулась, стали заметны белая грудь и нос крючком по-особенному, скопиному."
                                            }
                                        ]
                                    }
                                ]
