                        "sense_id": "73bbd7ca-aa67-3e88-9ac2-a8c1e2c2d219",
                        "entry_id": "54e6e31b-72d4-3774-9722-4f4e8ebf2066",
                        "glosses": [
                            "aus den auf dem Feld stehenden Mannschaftsmitgliedern gebildeter Kreis, in dem der neue Spielzug besprochen, motiviert oder gejubelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e7a8ffd-b412-4009-8861-b98d3da22b12",
                                "sense_id": "73bbd7ca-aa67-3e88-9ac2-a8c1e2c2d219",
                                "text": "„Der Huddle zur komplexen Aufgabenverteilung unter den Angreifern vor einem Spielzug war ebenfalls noch unbekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
