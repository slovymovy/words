                        "examples": [
                            {
                                "example_id": "35000d29-a620-4587-a2c1-c3b6a994267f",
                                "sense_id": "b4b21fa0-958c-34e8-a52c-db7c32e9eac4",
                                "text": "Een vliegtuig dat woensdag onderweg was van Anchorage naar Seattle, moest om een wel heel bijzondere reden rechtsomkeer maken."
                            },
                            {
                                "example_id": "646ea333-d0c3-4a65-9af6-295d5be28b91",
                                "sense_id": "b4b21fa0-958c-34e8-a52c-db7c32e9eac4",
                                "text": "Dat er een toetredingsproces opgestart is, betekent volgens Michel dat de overtuiging leefde dat Turkije de Europese waarden kan aanmeten, maar ‘de evolutie binnen de Turkse regering doet vaststellen dat er, zonder dat ik kwetsend wil overkomen, op een brutale manier rechtsomkeer is gemaakt op de weg van de toenadering’."
                            },
                            {
                                "example_id": "d55e85ef-ac3c-4306-b207-574c51abbf26",
                                "sense_id": "b4b21fa0-958c-34e8-a52c-db7c32e9eac4",
                                "text": "Toen ze rechtsomkeer wilde maken, kwam de auto op de overweg vast te zitten."
                            }
                        ]
