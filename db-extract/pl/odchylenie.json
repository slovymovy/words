                        "source_sense_id": "60fe08d5-56fa-38f6-8f04-b2fdb7eea736",
                        "target_lang_word": "deviation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deviation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1327be37-2de4-34e2-a8df-50eb0ca80f5d",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "The act of deviating; wandering off the correct or true path or road."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b16d51fe-b79e-3c4b-ac48-7801ed16b533",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "A departure from the correct way of acting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49b9e83d-4859-46a6-8aa4-130db494a60b",
                                                "sense_id": "b16d51fe-b79e-3c4b-ac48-7801ed16b533",
                                                "text": "The combination of Archie Jones’s working-class, Cockney accent, Samad’s Asian-English and Clara’s Creolized Caribbean English represent socio-linguistic deviations from Standard English as the centripetal forces of language undermining any notion of a homoglossic centre to the nation’s language and culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c8361d-6aa1-34f9-9781-2b86d04ee4d1",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "The state or result of having deviated; a transgression; an act of sin; an error; an offense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37ad665-6116-4e66-983c-a72ba5b1ecd7",
                                                "sense_id": "a1c8361d-6aa1-34f9-9781-2b86d04ee4d1",
                                                "text": "mankind’s deviation from divine will"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fab1946-6caf-30a0-b07b-be6b28c7cffa",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "A detour in a road or railway."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1f789d-5d48-4cd7-8fc6-7c5bdb989cd7",
                                                "sense_id": "3fab1946-6caf-30a0-b07b-be6b28c7cffa",
                                                "text": "\"A rough place, my last district; sixty navvies on the Springbank deviation works, let alone eighty of these dole bugs to attend to.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e12875-0f49-3a81-874e-04013b49699f",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "A detour to one side of the originally-planned flightpath (for instance, to avoid weather); the act of making such a detour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eedcbfb-8301-4ae7-8f34-da502e239615",
                                                "sense_id": "06e12875-0f49-3a81-874e-04013b49699f",
                                                "text": "The flightcrew observed en route thunderstorms both visually and on the airplane's weather radar, so they requested and received clearance for a deviation to the left of course from the HNL Combined Center Radar Approach Control (CERAP)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061a4814-df18-3e5a-9362-d855a537f1c3",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "The voluntary and unnecessary departure of a ship from, or delay in, the regular and usual course of the specific voyage insured, thus releasing the underwriters from their responsibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89faed2f-a1aa-375c-962d-025c4d1af90d",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "The shortest distance between the center of the target and the point where a projectile hits or bursts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9da6a271-a75d-3d8b-ad8a-127102616e8f",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
                                        "glosses": [
                                            "For interval variables and ratio variables, a measure of difference between the observed value and the mean."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e43bfbaf-b9e4-399e-a0b9-8c37c1ca06e7",
                                        "entry_id": "95fe551f-a1fb-3652-b051-b115ce723d83",
