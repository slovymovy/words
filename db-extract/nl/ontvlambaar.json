                                        "sense_id": "16444278-36d9-31e9-868a-09628a0f3982",
                                        "entry_id": "bf230202-2c41-3bb4-b868-cde61ae917d4",
                                        "glosses": [
                                            "so, dass es mit einer Entzündung als Körperreaktion abläuft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bd451e6-a764-4fe4-b0de-17c72fb5de7b",
                                                "sense_id": "16444278-36d9-31e9-868a-09628a0f3982",
                                                "text": "Sie leidet an entzündlichem Rheumatismus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c980c930-5f62-3aa4-a6ff-40759ea8250d",
                                        "entry_id": "bf230202-2c41-3bb4-b868-cde61ae917d4",
                                        "glosses": [
                                            "so, dass es sich leicht entzünden kann, im Sinne von brennen, schnell zu erregen"
                                        ],
                                        "tags": [
                                            "aber auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f2f96e8-392c-49f8-a432-686421c223cd",
                                                "sense_id": "c980c930-5f62-3aa4-a6ff-40759ea8250d",
                                                "text": "Helium ist leicht entzündlich."
                                            },
                                            {
                                                "example_id": "af9640d4-2ba1-4dec-9e6c-13e79e9995d5",
                                                "sense_id": "c980c930-5f62-3aa4-a6ff-40759ea8250d",
                                                "text": "„Sie haderte noch immer damit, dass bei ihr offenbar nur Gustavs melancholisches, rasch entzündliches Naturell durchgeschlagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
