                        "entry_id": "b61c7531-42ea-341f-8ae5-47ef960880b5",
                        "glosses": [
                            "Personne défilant à une procession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4991caaa-2f67-4042-9e1d-f666be3342e2",
                                "sense_id": "bc5ae2e0-b12d-3ef0-9823-b5e65e54422d",
                                "text": "Un processionnaire tient une corde fine et se lacère régulièrement le dos en demandant pardon à Dieu pour les péchés du monde."
                            },
                            {
                                "example_id": "d20947dc-0103-4551-be64-1a710ce2743d",
                                "sense_id": "bc5ae2e0-b12d-3ef0-9823-b5e65e54422d",
                                "text": "Voilà pourquoi les maîtres de maison font des offrandes à tous les processionnaires comme au chamane."
                            }
                        ]
                    }
                ],
