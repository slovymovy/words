                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f537da9-c940-4f7d-9cac-941d66051f8e",
                                                "sense_id": "790c3061-c1ed-3d71-a3b7-820db972645f",
                                                "text": "Policisté mohou kapsáře zadržet pouze tehdy, pokud ho chytí přímo při činu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kapsář",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7539bdce-cff8-37bf-b812-a1b2c1333ffd",
                                        "entry_id": "6bb48546-5e9d-3ce6-a32c-02a2d2f6488d",
                                        "glosses": [
                                            "velká kapsa jako součást oděvu, kapsa přivázaná k pasu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3fcc5f0-f297-4373-92cf-d13f4e82f693",
                                                "sense_id": "7539bdce-cff8-37bf-b812-a1b2c1333ffd",
                                                "text": "…vidím ji, jak bývala v čepci, v modré zástěře široké, s kapsářem a pantoflích."
                                            },
                                            {
                                                "example_id": "6c4a0fa6-c2aa-4082-bdf1-4427e48c9727",
                                                "sense_id": "7539bdce-cff8-37bf-b812-a1b2c1333ffd",
                                                "text": "…ale jak šla babička okolo, sáhla do kapsáře, vyprázdnila Adélce do zástěrky chlebové drobečky…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03ecb80c-a416-3bc2-b94e-763c2858bf76",
                                        "entry_id": "6bb48546-5e9d-3ce6-a32c-02a2d2f6488d",
                                        "glosses": [
                                            "interiérový doplněk v podobě zavěšeného pásu látky s našitými kapsami sloužící k ukládání věcí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eaf6a3f-80df-43f4-883c-933024271e17",
                                                "sense_id": "03ecb80c-a416-3bc2-b94e-763c2858bf76",
                                                "text": "Textilní nebo kožené kapsáře nápadných designů a barev slouží jako úložný prostor pro tiskoviny, ale také drobnosti v předsíních."
                                            }
                                        ]
                                    }
                                ]
                            }
