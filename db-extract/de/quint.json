                            {
                                "example_id": "aad36a2c-7970-40a0-ad58-b565e4c3995b",
                                "sense_id": "e516112f-f408-3d31-a9f1-d2f7544b059c",
                                "text": "„1 Marck hat 16 Loth, oder 64 Quinten, oder 256 Pfennig-Gewicht, oder 288 Grän.“"
                            },
                            {
                                "example_id": "d853f046-3375-409f-af2f-42d12b54112c",
                                "sense_id": "e516112f-f408-3d31-a9f1-d2f7544b059c",
                                "text": "„Das Pfund hat 16 Unzen, oder 32 Loth, oder 128 Quint, oder 512 Ort (Pfennig), oder 8192 Es, oder 65536 Gran; die Unze hat 2 Loth oder 8 Quint; das Loth hat 4 Quint oder 16 Ort (Pfennig); das Quint hat 4 Ort oder Pfennig; das Ort hat 16 Es, und das Es 8 Gran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
