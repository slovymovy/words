                                        "entry_id": "22c0bbc5-badc-33e5-9614-8edaa1e7e5c3",
                                        "glosses": [
                                            "Ensemble des éléments constituant la base nécessaire à l’édification et au fonctionnement d’un système, abstrait ou concret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc094d4-b851-4bfc-b8e5-7f7d8abc2019",
                                                "sense_id": "69949c56-7b25-3e1a-8dd9-644a015474c5",
                                                "text": "Toute l’infrastructure qui colporte vos messages consomme de l’énergie, elle-même produite par des centrales utilisant des ressources naturelles, rejetant des déchets et émettant des gaz à effet de serre."
                                            }
                                        ]
                                    },
