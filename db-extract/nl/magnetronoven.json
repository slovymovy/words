                        "entry_id": "faebd967-9744-38a2-92fc-6afa429f69e2",
                        "glosses": [
                            "microwave oven, a fast heating device with mainly culinary use"
                        ],
                        "tags": [
                            "Netherlands",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "6ea61a28-7e65-4288-9995-9872594dc116",
                                "sense_id": "6dc2253f-33f4-3a0b-93fa-0a4b512b61a7",
                                "text": "De restjes van gisteren opwarmen gaat snel in de magnetronoven",
                                "translation": "Heating up yesterday's leftovers is quick in the microwave oven.",
                                "english": "Heating up yesterday's leftovers is quick in the microwave oven."
                            },
                            {
                                "example_id": "5cd10e7f-c9d5-4d6a-88a8-facfa36305c6",
                                "sense_id": "6dc2253f-33f4-3a0b-93fa-0a4b512b61a7",
                                "text": "De magnetronoven is een handig apparaat voor drukke mensen die snel een maaltijd willen bereiden.",
                                "translation": "The microwave oven is a handy appliance for busy people who want to prepare a meal quickly.",
                                "english": "The microwave oven is a handy appliance for busy people who want to prepare a meal quickly."
                            },
                            {
                                "example_id": "1cf0de40-7598-4579-b474-95d9f12f8d06",
                                "sense_id": "6dc2253f-33f4-3a0b-93fa-0a4b512b61a7",
                                "text": "Ze plaatste de bevroren groenten in de magnetronoven om ze te ontdooien.",
                                "translation": "She put the frozen vegetables in the microwave oven to defrost them.",
                                "english": "She put the frozen vegetables in the microwave oven to defrost them."
                            }
                        ]
                    }
