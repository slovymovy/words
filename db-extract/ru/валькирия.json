                ],
                "senses": [
                    {
                        "sense_id": "8e0559fd-0b8e-3720-9fb6-a3edfc3b5215",
                        "entry_id": "7f934eff-bfd6-3ca8-a2a6-c04e4b152bef",
                        "glosses": [
                            "мифол. дочь славного воина, или конунга, которая реет на крылатом коне над полем битвы и решает, кому из воинов, павших в бою, попасть в небесный чертог — Вальхаллу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1608c0e5-b51d-45fe-a452-8d85e0ccf166",
                                "sense_id": "8e0559fd-0b8e-3720-9fb6-a3edfc3b5215",
                                "text": "Предполагалось, что порой валькирии в лебяжьем оперении летали на землю к укромному ручью, где они могли порадовать себя купанием."
                            },
                            {
                                "example_id": "6dddc4c2-cec2-4723-87f8-5845133dbf83",
                                "sense_id": "8e0559fd-0b8e-3720-9fb6-a3edfc3b5215",
                                "text": "К ней стремительно вбегает валькирия Вальтраута и сообщает ей, что близится гибель богов."
                            }
                        ]
                    },
                    {
                        "sense_id": "eda38114-3201-3f36-bb60-be4312319710",
                        "entry_id": "7f934eff-bfd6-3ca8-a2a6-c04e4b152bef",
                        "glosses": [
                            "перен. о «боевой» девушке или женщине"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8b79a0c-92a4-47ed-af42-cfca2c541f6b",
                        "source_entry_id": "7f934eff-bfd6-3ca8-a2a6-c04e4b152bef",
                        "target_lang_word": "valkyrie",
                        "target_lang_code": "en",
