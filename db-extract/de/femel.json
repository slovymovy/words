                "senses": [
                    {
                        "sense_id": "ff52ad01-daf8-3876-ba1d-1e29aa90060a",
                        "entry_id": "10ac29f5-7b49-3567-8308-6910f2fa1f2c",
                        "glosses": [
                            "männliche Pflanze bei Hanf und Hopfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b549c2-f124-4122-ab6e-bd253d256b7a",
                                "sense_id": "ff52ad01-daf8-3876-ba1d-1e29aa90060a",
                                "text": "Der „Femel“ reift früher und ist von schwächerem Wuchs als die weibliche Pflanze."
                            },
                            {
                                "example_id": "cd252716-eeb3-4741-b681-efdbd69a7fed",
                                "sense_id": "ff52ad01-daf8-3876-ba1d-1e29aa90060a",
                                "text": "Bis Ende Juli mußten die früher reifen männlichen Hanfstengel, die Femel oder ‚Fimmel‘, aus den Feldern gezogen werden, eine Arbeit, die regelmäßig Tutzinger Tagewerkerinnen besorgten: …"
                            },
                            {
                                "example_id": "1df14f05-190b-4357-9475-db6d796dee1f",
                                "sense_id": "ff52ad01-daf8-3876-ba1d-1e29aa90060a",
                                "text": "Der männliche Hanf, Staubhanf oder Femel, liefert eine feinere Faser als der größere und später reifende weibliche Hanf (Sämer) der fast nur zur Samengewinnung benutzt wird."
                            },
                            {
                                "example_id": "915accda-9ccf-4aaf-8c36-804dfc26c88c",
                                "sense_id": "ff52ad01-daf8-3876-ba1d-1e29aa90060a",
                                "text": "Der Sämer bleibt noch stehen, er unterscheidet sich vom Femel durch seinen starken grünen Stengel."
                            },
                            {
                                "example_id": "602d4984-c2a0-4469-a8ad-81cfabed1613",
                                "sense_id": "ff52ad01-daf8-3876-ba1d-1e29aa90060a",
                                "text": "Länger angebaut, und in der Slowakei mehr verbreitet, war der Femel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
