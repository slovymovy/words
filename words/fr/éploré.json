            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81493ef8-4149-3ce2-920d-a1df2aa4aef2",
                    "sense_definition": "Qui est tout en larmes, abattu par une immense douleur ou une vive affliction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mère <w>éplorée</w> serrait son enfant contre elle en attendant des nouvelles rassurantes."
                        },
                        {
                            "text": "Après cette terrible annonce, il quitta la pièce le visage <w>éploré</w> et les yeux rougis."
                        }
                    ],
                    "synonyms": [
                        "affligé",
                        "inconsolable",
                        "larmoyant"
                    ],
                    "antonyms": [
                        "hilare",
                        "joyeux",
                        "radieux"
                    ],
                    "common_phrases": [
                        "femme éplorée",
                        "mère éplorée",
                        "visage éploré"
                    ]
                },
                {
                    "sense_id": "d18f2d31-97a1-361f-a5b0-460c19f6b9ae",
                    "sense_definition": "Qui retombe tristement vers le sol, en parlant des branches ou des feuilles d'un arbre.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vegetal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les branches <w>éplorées</w> du saule trempaient doucement dans l'eau claire de la rivière."
                        },
                        {
                            "text": "Au fond du jardin, un grand arbre dressait son feuillage <w>éploré</w> au-dessus du vieux banc."
                        }
                    ],
                    "synonyms": [
                        "pleureur",
                        "retombant"
                    ],
                    "common_phrases": [
                        "branches éplorées",
                        "feuillage éploré"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e0642ba-698e-39bb-91a4-546fee1e3f5c",
                    "sense_definition": "Personne en larmes, submergée par le chagrin.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre s'approcha pour consoler l'<w>éploré</w> accablé par la douleur de ce deuil soudain."
                        },
                        {
                            "text": "Au milieu du vacarme, cette <w>éplorée</w> cherchait désespérément de l'aide auprès des passants indifférents."
                        }
                    ],
                    "synonyms": [
                        "pleureur"
                    ]
                }
            ]
        }
    ]
