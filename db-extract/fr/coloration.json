                                    },
                                    {
                                        "sense_id": "d1031849-981d-39ba-bf4d-3359e37710ef",
                                        "entry_id": "39941051-15a0-3480-b50c-958662bdbd28",
                                        "glosses": [
                                            "Any substance used to give color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071bb02c-c5bb-4210-8213-98dd64e354d5",
                                                "sense_id": "d1031849-981d-39ba-bf4d-3359e37710ef",
                                                "text": "Our cookies contain no artificial flavorings or colorings."
                                            },
                                            {
                                                "example_id": "8c285816-75be-4a62-969a-282ced5104a4",
                                                "sense_id": "d1031849-981d-39ba-bf4d-3359e37710ef",
                                                "text": "The Department of Health and Human Services and the Food and Drug Administration announced on Tuesday a series of measures to phase out eight artificial food dyes and colorings from America's food supply by the end of next year. […] The proposal also outlined a commitment for companies to supply food for school lunches that does not include artificial dyes or coloring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d62219e9-e2ff-34ca-aad9-7864a679e143",
                                        "entry_id": "39941051-15a0-3480-b50c-958662bdbd28",
                                        "glosses": [
                                            "The appearance as to color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dae41427-5f9a-4e8a-8919-57605b1563a3",
                                                "sense_id": "d62219e9-e2ff-34ca-aad9-7864a679e143",
                                                "text": "The Rolands, both U.S.-educated lawyers with faculty positions in the national law school, are olive skinned, with the coloring of some Italians or Sephardic Jews."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0e3de3-81bc-34e2-9ce9-74380b91be52",
                                        "entry_id": "39941051-15a0-3480-b50c-958662bdbd28",
                                        "glosses": [
                                            "A disguise or discoloration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16fbba48-b3bd-3fe4-9b1b-bbdbfef1e1c5",
                                        "entry_id": "39941051-15a0-3480-b50c-958662bdbd28",
                                        "glosses": [
