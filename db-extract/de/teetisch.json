                ],
                "senses": [
                    {
                        "sense_id": "09eb9fd0-dbae-34ae-9236-65711b473a21",
                        "entry_id": "5463e42e-0052-3267-8e67-a0efca1eb8e8",
                        "glosses": [
                            "Tisch, der für ein gemeinsames Teetrinken gedeckt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7400f9-5d34-4c10-8d02-1a1ca53fa305",
                                "sense_id": "09eb9fd0-dbae-34ae-9236-65711b473a21",
                                "text": "„Die Alten sassen zusammen, die Jugend sass zusammen, die Hausfrau waltete ihres Amtes am Teetisch, und auf dem Teetisch stand in einem silbernen Körbchen genau das gleiche Backwerk, das es unlängst auf der Soiree bei Panins gegeben hatte – kurz, alles war genau so wie bei allen anderen Leuten.“"
                            },
                            {
                                "example_id": "351eae56-53c0-4e56-8c9b-e3fc61ebc061",
                                "sense_id": "09eb9fd0-dbae-34ae-9236-65711b473a21",
                                "text": "„Gemeinsam kehrten Johnny, Lucy und Jules ins Wohnzimmer zurück und ließen sich um den großen Teetisch nieder.“"
                            },
                            {
                                "example_id": "30030ed7-695a-486c-95b1-157cadb0d740",
                                "sense_id": "09eb9fd0-dbae-34ae-9236-65711b473a21",
                                "text": "„Frau von Carayon aber bemängelte diese »Morgengabe«, weil man nicht gut geben oder verschenken könne, was man nicht habe, bei welchem Worte die bis dahin unbemerkt am Teetisch beschäftigt gewesene Tochter Victoire der Mutter einen zärtlichen Blick zuwarf, während Alvensleben der schönen Frau die Hand küßte.“"
                            },
                            {
                                "example_id": "1e2ecd42-dd68-4712-8931-386cb9367908",
                                "sense_id": "09eb9fd0-dbae-34ae-9236-65711b473a21",
                                "text": "„James Lively und Squire Dayton mußten ihre Stühle rasch zurückschieben, denn Mrs. Breidelford kam mit solcher Gewalt hinter dem Teetisch vorgesaust, daß sie ihr kaum aus dem Wege rücken konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f120db22-92e7-48c4-a5ea-226802645fca",
                        "source_entry_id": "5463e42e-0052-3267-8e67-a0efca1eb8e8",
                        "source_sense_id": "09eb9fd0-dbae-34ae-9236-65711b473a21",
                        "source_sense_description": "Tisch, der für ein gemeinsames Teetrinken gedeckt ist",
                        "target_lang_word": "table à thé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "table à thé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c9b3f15-d8b7-37a9-9a6f-fd6304898ee5",
                                        "entry_id": "54371b07-dbfd-3168-8574-8fab35e9361b",
                                        "glosses": [
                                            "Petite table, parfois surmontée d’un second plateau, conçue pour accueillir les différents ustensiles et récipients nécessaires au service du thé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f222efb-409b-4fa8-9e01-05d8ffc195ad",
                                                "sense_id": "8c9b3f15-d8b7-37a9-9a6f-fd6304898ee5",
                                                "text": "Un Domestique entre. Après avoir rangé les sièges qui sont autour de la table à thé, il en emporte le cabaret et vient remettre la table à sa place auprès du mur de côté."
                                            },
                                            {
                                                "example_id": "20fe5393-9e62-44d5-a847-66f26f43cf52",
                                                "sense_id": "8c9b3f15-d8b7-37a9-9a6f-fd6304898ee5",
                                                "text": "La table à thé roulée au milieu du salon, la bouilloire placée devant le feu pour que l’eau continue à bouillir, on verse dans l’une des théïères un peu d’eau chaude que l’on rejette ensuite dans le bol."
                                            },
                                            {
                                                "example_id": "375f049d-3732-4fdf-8732-1f6390294fa9",
                                                "sense_id": "8c9b3f15-d8b7-37a9-9a6f-fd6304898ee5",
                                                "text": "Elle va à la table à thé, elle sert Peacock et Saunders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
