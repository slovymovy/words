                                                "sense_id": "89b0984d-20e9-3eaf-8264-bf87c1d3b4a3",
                                                "text": "The ground was littered with broken bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a292080-defb-377b-b4d5-d89a965bd0b5",
                                        "entry_id": "d4167eed-3c15-3982-97e6-9bd32dfe48bc",
                                        "glosses": [
                                            "Fragmented; in separate pieces.",
                                            "Split or ruptured."
                                        ],
