{
    "word_family": [
        "save",
        "savings",
        "savior",
        "safe",
        "safely",
        "safety"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af2a24e1-051a-3db2-bcd7-bef2d333f857",
                    "sense_definition": "A person who regularly puts money aside for the future rather than spending it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a natural <w>saver</w> who always keeps a portion of his salary in the bank.",
                            "target_lang_translations": {
                                "ru": "Он от природы <w>бережливый человек</w>, который всегда оставляет часть зарплаты в банке."
                            }
                        },
                        {
                            "text": "Being a regular <w>saver</w> helps you prepare for unexpected expenses or emergencies.",
                            "target_lang_translations": {
                                "ru": "Привычка быть <w>регулярным вкладчиком</w> помогает подготовиться к непредвиденным расходам или чрезвычайным ситуациям."
                            }
                        }
                    ],
                    "synonyms": [
                        "economizer"
                    ],
                    "antonyms": [
                        "spender",
                        "spendthrift"
                    ],
                    "common_phrases": [
                        "regular saver",
                        "diligent saver",
                        "lifelong saver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который регулярно откладывает деньги на будущее, а не тратит их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладчик",
                                "target_lang_sense_clarification": "человек, хранящий деньги в банке"
                            },
                            {
                                "target_lang_word": "экономный человек",
                                "target_lang_sense_clarification": "тот, кто бережливо относится к деньгам"
                            },
                            {
                                "target_lang_word": "бережливый человек",
                                "target_lang_sense_clarification": "тот, кто склонен к накоплению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb959074-7d29-3b38-9cec-a55d9464847c",
                    "sense_definition": "A person who rescues or preserves someone or something from harm or loss.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rescuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community hailed the volunteer as a <w>saver</w> of the historic library.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество провозгласило волонтера <w>спасителем</w> исторической библиотеки."
                            }
                        },
                        {
                            "text": "In many religious contexts, a <w>saver</w> of souls is a central figure of faith.",
                            "target_lang_translations": {
                                "ru": "Во многих религиозных контекстах <w>спаситель</w> душ является центральной фигурой веры."
                            }
                        }
                    ],
                    "synonyms": [
                        "rescuer",
                        "savior",
                        "protector"
                    ],
                    "antonyms": [
                        "destroyer"
                    ],
                    "common_phrases": [
                        "saver of souls",
                        "life saver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который спасает или оберегает кого-либо или что-либо от вреда или потери."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спаситель",
                                "target_lang_sense_clarification": "тот, кто избавляет от опасности или гибели"
                            },
                            {
                                "target_lang_word": "хранитель",
                                "target_lang_sense_clarification": "тот, кто оберегает или защищает что-либо"
                            },
                            {
                                "target_lang_word": "избавитель",
                                "target_lang_sense_clarification": "тот, кто освобождает от бед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b62a63-5a83-3898-8319-45d3a620fe9f",
                    "sense_definition": "A type of ticket, coupon, or scheme that provides a discounted price for a service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discounts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can get a group <w>saver</w> ticket if you travel with three or more people.",
                            "target_lang_translations": {
                                "ru": "Вы можете приобрести <w>групповой льготный билет</w>, если путешествуете втроем или более."
                            }
                        },
                        {
                            "text": "The supermarket offers a price <w>saver</w> deal on all fresh produce this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные супермаркет предлагает <w>выгодную акцию</w> на все свежие продукты."
                            }
                        }
                    ],
                    "synonyms": [
                        "discount",
                        "coupon"
                    ],
                    "common_phrases": [
                        "group saver",
                        "price saver",
                        "off-peak saver"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English for transport tickets"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип билета, купона или программы, предоставляющий скидку на услугу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льготный билет",
                                "target_lang_sense_clarification": "билет со скидкой"
                            },
                            {
                                "target_lang_word": "эконом-тариф",
                                "target_lang_sense_clarification": "выгодное ценовое предложение"
                            },
                            {
                                "target_lang_word": "скидочный купон",
                                "target_lang_sense_clarification": "талон на получение скидки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}