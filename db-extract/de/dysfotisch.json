                "senses": [
                    {
                        "sense_id": "e2d5e618-956d-373b-aa98-a9a98e7fb952",
                        "entry_id": "ba5a856a-a2a2-372c-9689-443cd7db0cde",
                        "glosses": [
                            "sehr arm an Licht, sodass keine effektive Fotosynthese mehr betrieben werden kann"
                        ],
                        "tags": [
                            "Meereskunde"
                        ],
                        "examples": [
                            {
                                "example_id": "a57b9f84-875c-4cb6-b136-6e8334fb1ff4",
                                "sense_id": "e2d5e618-956d-373b-aa98-a9a98e7fb952",
                                "text": "„Die florafreie Zone hat man oft auch als Sublitoral, während die Zone mit Flora als Laminar bezeichnet, obwohl tiefenmässig beide diese Begriffe dieselbe Zone bedeuten. Deshalb wird es besser vom Begriff ‚laminare Zone‘ Abstand zu nehmen und die ganze eufotische Zone vom Eulitoral bis zur dysfotischen Zone als ‚sublitarafe Zone‘ zu nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
