                            {
                                "example_id": "3a187209-4851-4c6b-8c24-cda778c7f72f",
                                "sense_id": "786e7152-29bd-3d3b-801e-faf3ef024d49",
                                "text": "En leur absence, si nous ne devions compter que sur les interactions d'origine magnétique entre spins voisins pour les orienter, il faudrait descendre à des températures proche du zéro absolu pour voir un corps s'auto-aimanter."
                            },
                            {
                                "example_id": "63c09534-c7de-43dd-85fc-9eaea542bcec",
                                "sense_id": "786e7152-29bd-3d3b-801e-faf3ef024d49",
                                "text": "Le film semble s’auto-aimanter à l’art director : la reconstitution impeccable des années 50 prend toute la place, reléguant la psychologie trouble du comportement du duo Lanny (Kevin Bacon) et Vince (Colin Firth) à l’arrière plan, voire à l’anecdote."
                            }
                        ]
