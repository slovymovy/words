                        "examples": [
                            {
                                "example_id": "2df94137-235c-49fe-a47d-e3e167ac730e",
                                "sense_id": "21029e27-9afc-3465-a355-ce3f263b8306",
                                "text": "Aus dem unangenehmen Geruch der Buttersäure wird bei der Veresterung ein sehr angenehmer Duft des entstandenen Esters."
                            },
                            {
                                "example_id": "52735fcb-64f5-46a0-9bbe-4f6c329b46e2",
                                "sense_id": "21029e27-9afc-3465-a355-ce3f263b8306",
                                "text": "Beim Ranzigwerden von Butter entsteht Buttersäure, die im Wesentlichen für den ranzigen Geruch verantwortlich ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
