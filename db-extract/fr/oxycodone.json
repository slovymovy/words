                "senses": [
                    {
                        "sense_id": "37ae5de0-afa3-37d0-b79d-18bb3c5a98c9",
                        "entry_id": "519abac3-c242-3b02-afe1-13e0f5d7216d",
                        "glosses": [
                            "Analgésique de la famille des opioïdes de formule chimique C₁₈H₂₁NO₄."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "050d1d92-bda5-47c2-a5da-e213c0566b12",
                                "sense_id": "37ae5de0-afa3-37d0-b79d-18bb3c5a98c9",
                                "text": "Le ratio utilisé pour le passage de l’oxycodone oral à la morphine orale est de 1/1,5 (10 mg d’oxycodone est égal à 15 mg de morphine)."
                            },
                            {
                                "example_id": "0efc8a4d-6a11-458b-8238-5499d91eb1a5",
                                "sense_id": "37ae5de0-afa3-37d0-b79d-18bb3c5a98c9",
                                "text": "Au contraire, la codéine peut conduire à une overdose chez des métaboliseurs ultrarapides, surtout s’ils ont un faible volume de distribution (contre-indiqué chez les enfants) ; il en est de même avec l’oxycodone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a03f13b-cf58-4105-b12a-3a3465a17114",
                        "source_entry_id": "519abac3-c242-3b02-afe1-13e0f5d7216d",
                        "source_sense_id": "37ae5de0-afa3-37d0-b79d-18bb3c5a98c9",
                        "target_lang_word": "Oxycodon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oxycodon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
                                        "entry_id": "e344acd4-d396-3a7c-824a-92357585c478",
                                        "glosses": [
                                            "stark wirkendes semisynthetisches Opioid mit hohem Suchtpotenzial, das vor allem als Schmerzmittel bei starken Schmerzen des Menschen angewendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af342ca-5326-49c4-a901-5571d01c522c",
                                                "sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
                                                "text": "„Court war inzwischen regelrecht abhängig von Medikamenten: Vicodin und Oxycodon, Demerol und Dilaudid.“"
                                            },
                                            {
                                                "example_id": "e744516b-fcea-4f81-8810-f93ec33e8aea",
                                                "sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
                                                "text": "„Der größere der Transporter-Männer gab einem der BNGs ein Zeichen, woraufhin dieser einige Päckchen Oxycodon oder Fentanyl aus der Tüte fischte und den Polizisten gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e32afc3-263d-4d92-8fcb-e1f0b52ed290",
                        "source_entry_id": "519abac3-c242-3b02-afe1-13e0f5d7216d",
