                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "врачиха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2419642e-1e51-39ba-8143-3ab1f01aab48",
                                        "entry_id": "6f481a0e-acec-361e-bf85-7db00ac7ab53",
                                        "glosses": [
                                            "разг. женщина-врач"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6c51d1-74b2-4ad2-8ffd-23e58e06d12b",
                                                "sense_id": "2419642e-1e51-39ba-8143-3ab1f01aab48",
                                                "text": "В ту же ночь она заболела, как сама потом говорила, на нервной почве, хотя вызванная соседкой врачиха сказала, что это просто грипп."
                                            }
                                        ]
