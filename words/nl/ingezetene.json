{
    "word_family": [
        "gezetene",
        "inzet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e0227eb-e978-3c7c-ad38-4c193dda9bbd",
                    "sense_definition": "Iemand die officieel in een bepaald land of rechtsgebied woont.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inwoner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke <w>ingezetene</w> van dit land heeft recht op medische zorg.",
                            "target_lang_translations": {
                                "en": "Every <w>resident</w> of this country is entitled to medical care."
                            }
                        },
                        {
                            "text": "De wet geldt voor iedere <w>ingezetene</w> binnen de grenzen.",
                            "target_lang_translations": {
                                "en": "The law applies to every <w>resident</w> within the borders."
                            }
                        }
                    ],
                    "synonyms": [
                        "inwoner",
                        "bewoner"
                    ],
                    "antonyms": [
                        "niet-ingezetene"
                    ],
                    "common_phrases": [
                        "ingezetene van land"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who officially resides in a specific country or jurisdiction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resident",
                                "target_lang_sense_clarification": "General term for someone living in a place."
                            },
                            {
                                "target_lang_word": "inhabitant",
                                "target_lang_sense_clarification": "Someone who lives in a particular place."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5947d11f-ae89-3f5a-9244-c67831951e0d",
                    "sense_definition": "Een bewoner die over een gelegaliseerde identiteit beschikt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inwoner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was een <w>ingezetene</w> van IJsland.",
                            "target_lang_translations": {
                                "en": "He was a <w>resident</w> of Iceland."
                            }
                        },
                        {
                            "text": "De status van <w>ingezetene</w> geeft recht op een verblijfsvergunning.",
                            "target_lang_translations": {
                                "en": "The status of <w>legal resident</w> grants the right to a residence permit."
                            }
                        }
                    ],
                    "synonyms": [
                        "resident"
                    ],
                    "target_lang_definitions": {
                        "en": "A resident who possesses a legalized identity or legal status."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "legal resident",
                                "target_lang_sense_clarification": "Someone with official legal status in a country."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed36af1c-d808-3974-84e2-4636c16b7029",
                    "sense_definition": "Iemand die in een stad woont zonder het staatsburgerschap te bezitten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inwoner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als <w>ingezetene</w> zonder paspoort heeft hij beperkte rechten.",
                            "target_lang_translations": {
                                "en": "As a <w>non-citizen resident</w> without a passport, he has limited rights."
                            }
                        },
                        {
                            "text": "De stad telt veel <w>ingezetenen</w> die elders zijn geboren.",
                            "target_lang_translations": {
                                "en": "The city has many <w>residents</w> who were born elsewhere."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who lives in a city or country without holding citizenship."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "non-citizen resident",
                                "target_lang_sense_clarification": "A person living in a country without being a citizen."
                            },
                            {
                                "target_lang_word": "foreign resident",
                                "target_lang_sense_clarification": "A person residing in a country of which they are not a citizen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}