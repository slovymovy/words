                ],
                "senses": [
                    {
                        "sense_id": "322ce6df-a3b3-3ed0-bfdf-2fae30aad324",
                        "entry_id": "121a3d17-72d1-3d85-87ef-0ebe6b0868d6",
                        "glosses": [
                            "разг. попасть куда-либо, оказаться где-либо (часто внезапно, неожиданно)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af9fd6f5-7b5f-4f08-a214-b2405cb83dc0",
                                "sense_id": "322ce6df-a3b3-3ed0-bfdf-2fae30aad324",
                                "text": "Ты знаешь, что мне не суждено попадать в центр истины, откуда в равном расстоянии видны все крайние точки её круга: нет, я как-то всегда очучусь на самом краю."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ebf094c-d302-3e42-80e4-3fc2eed2b7de",
                        "entry_id": "121a3d17-72d1-3d85-87ef-0ebe6b0868d6",
                        "glosses": [
                            "разг. оказаться в каком-либо положении, состоянии, виде"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66035b0f-9627-4775-a0df-0e7517bad320",
                        "source_entry_id": "121a3d17-72d1-3d85-87ef-0ebe6b0868d6",
                        "target_lang_word": "geraten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geraten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                        "entry_id": "cf6bf18e-9e44-3dd9-a0d5-8b2036e858d1",
                                        "glosses": [
                                            "zufällig/ ohne Absicht an den falschen Ort oder in eine unangenehme Situation kommen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea82f0a-d7fc-4e4b-8f02-8693e80fcdbe",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "„So kann der Prozess im Idealfall korrigiert werden, noch bevor dieser außer Kontrolle gerät und möglicherweise fehlerhafte Teile produziert werden.“"
                                            },
                                            {
                                                "example_id": "a8651475-1ad8-445c-8275-f941f12911db",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "„Oft erzählte er uns viele wunderbare Geschichten und geriet darüber so in Eifer, dass ihm die Pfeife immer ausging, die ich, ihm brennend Papier hinhaltend, wieder anzünden musste, welches mir denn ein Hauptspaß war.“"
                                            },
                                            {
                                                "example_id": "5e95623e-41b0-44a9-8c5b-3c38fdd847b0",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "Wohin sind wir hier bloß geraten?"
                                            },
                                            {
                                                "example_id": "035c50a7-25e9-4515-8dfc-fd0c3386aa7d",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "„Deltafliegen, die ursprüngliche Art des Hängegleitens, ist mit dem Aufkommen des Gleitschirmes etwas in Vergessenheit geraten.“"
                                            },
                                            {
                                                "example_id": "ef93231e-45a2-4291-ab81-edd1e84fc295",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "Sicher ist, dass mindestens 5,3 und bis zu 5,7 Millionen sowjetische Soldaten in [deutsche] Gefangenschaft geraten sind."
                                            },
                                            {
                                                "example_id": "0df3964f-76b4-44dd-a539-b3e863264a02",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "„Die 73 Meter lange „Annika“ war am Freitagmorgen etwa 4,5 Kilometer vor Heiligendamm in Brand geraten.“"
                                            },
                                            {
                                                "example_id": "0d7ca781-e7b3-496d-a200-3abb60c07458",
                                                "sense_id": "7bf0a2fc-19a5-3612-8555-d6374e65e03a",
                                                "text": "„Die Lausitz ist seit dem beschlossenen Kohleausstieg spätestens im Jahr 2038 in den Fokus der Öffentlichkeit geraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e491a3a-8748-3896-9072-859bc6b58370",
                                        "entry_id": "cf6bf18e-9e44-3dd9-a0d5-8b2036e858d1",
                                        "glosses": [
                                            "erfolgreich zu Ende gebracht werden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8e59f0-2c51-4867-b6ba-757f478128d5",
                                                "sense_id": "3e491a3a-8748-3896-9072-859bc6b58370",
                                                "text": "Der Kuchen ist uns wieder sehr gut geraten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6c05dd5e-4c6d-3aa5-92c9-51597f9c4395",
                                        "entry_id": "cf6bf18e-9e44-3dd9-a0d5-8b2036e858d1",
                                        "glosses": [
                                            "jemandem ähnlich sehen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e667e2-e7e8-474a-8e6e-7c24dad66144",
                                                "sense_id": "6c05dd5e-4c6d-3aa5-92c9-51597f9c4395",
                                                "text": "Er gerät mehr nach seiner Mutter als nach seinem Vater."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
