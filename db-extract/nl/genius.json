                                "target_senses": [
                                    {
                                        "sense_id": "f4a4c94a-9640-3f8d-812a-aa2842c3ca47",
                                        "entry_id": "335d9e33-c833-3899-bd55-b1b72301c793",
                                        "glosses": [
                                            "A tutelary angel watching over a particular person in monotheistic contexts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4043b0-1522-41ae-b827-ead3a8793b67",
                                                "sense_id": "f4a4c94a-9640-3f8d-812a-aa2842c3ca47",
                                                "text": "\"We may call them 'guardian angels' as the Catholics do, or 'guides' or 'controls', but whatever you call them, they really do exist and they guard us from evil on the spiritual plane.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8727d0-c992-3705-a065-cdc9408aa02c",
                                        "entry_id": "335d9e33-c833-3899-bd55-b1b72301c793",
                                        "glosses": [
                                            "A person who benevolently watches over another."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989e83ad-0dcb-40d5-a62a-0beddc96b446",
                                                "sense_id": "ce8727d0-c992-3705-a065-cdc9408aa02c",
                                                "text": "I don't know when you appointed yourself my guardian angel, but I can take care of my own self, thank you very much!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
