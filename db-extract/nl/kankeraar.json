                            "singular"
                        ],
                        "form": "kankeraartje"
                    },
                    {
                        "form_id": "49be5c73-8281-4b16-a936-252b9daba3de",
                        "entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "kankeraartjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                        "entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                        "glosses": [
                            "iemand die overmatig veel klaagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e24e9b-d9c8-43e0-bfbe-c38b0b274d1c",
                                "sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                                "text": "Wel had ze grote twijfels toen ze ja zei tegen het stadsdichterschap. 'Ik zit altijd te kankeren op te stad. Incapabele bestuurders, weggesmeten geld, opengebroken straten. Nogal negatief, niet? Ik heb dat ook gezegd toen ze me belden, maar dat was geen bezwaar. En ja, inderdaad, Amsterdam is toch ook vergeven van de kankeraars? Wat dat betreft ben ik een goed voorbeeld, haha.'"
                            },
                            {
                                "example_id": "b3a4fafa-79eb-4067-9895-ea738c7b12b7",
                                "sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                                "text": "In 2011 kwam er in de Maasstad wel een comeback party, maar Langenbach is ook die 'Rotterdamse kankeraar' tegen de politiek en ambtenarij. Dat maakte hem minder populair, al laat het beeld tijdens de presentatie van zijn boek de andere kant zien; alsof Ted weer helemaal terug is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bde8b1ad-3b10-4472-855e-15858aa5a0fe",
                        "source_entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                        "source_sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                        "target_lang_word": "grumbler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grumbler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ca4d9c-938b-3138-a4ee-e58622139913",
                                        "entry_id": "d23d1fbe-0b83-31fc-a9e1-6a658f9646ba",
                                        "glosses": [
                                            "A person who persistently grumbles; a complainer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58eb3e31-59b2-4266-853b-4337f96680a0",
                                                "sense_id": "e8ca4d9c-938b-3138-a4ee-e58622139913",
                                                "text": "But the grumbler must be heard through the newspapers, and a great deal of unpleasantness comes to newspapers from the grumbler; and the newspapers, and not the grumbler, nearly always have to take the brunt of the trouble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4db71064-238b-4360-8a2c-d93f7fb7d234",
                        "source_entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                        "source_sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                        "target_lang_word": "groaner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groaner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d960b6cb-8dd5-37c3-9bc9-536ad29d7e4f",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "One who groans or complains"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5101002e-ace6-4f1c-845a-547d570c709a",
                                                "sense_id": "d960b6cb-8dd5-37c3-9bc9-536ad29d7e4f",
                                                "text": "I don’t need to hear from groaners like you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89bd088-4de0-3578-818f-e4ace526a87e",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "A work of extremely low quality, so bad as to inspire groaning"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d520c6ab-0d16-470a-b765-038ba7163d09",
                                                "sense_id": "e89bd088-4de0-3578-818f-e4ace526a87e",
                                                "text": "That movie was a real groaner."
                                            },
                                            {
                                                "example_id": "c3ebc494-cb8e-411c-a99a-65dc6bf0c614",
                                                "sense_id": "e89bd088-4de0-3578-818f-e4ace526a87e",
                                                "text": "Some groaners are converted into running gags, as when Joel and his brother (Max Greenfield) get in a duel of parting, one-last-thing-before-you-go affirmations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "A particularly egregious joke, especially a pun."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb5a837-480c-4478-8573-12fbdcac5f54",
                                                "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                                "text": "From the cleverest repartee to the worst groaner, people use and respond to puns, but sometimes find them hard to define."
                                            },
                                            {
                                                "example_id": "5f9a3cbb-891c-4fa5-b36a-7e208dcf2c69",
                                                "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                                "text": "In the '40s, I remember ludicrous puns thought to be funny and repeated by teenagers, sometimes to a chorus of laughter. Here is a groaner example: \"Mother, get off the rafters. That is no way to get on the beam.\" Naturally, to understand the joke, it was necessary to know the idiom of the day. \"Get on the beam\" meant \"get with it\" or understand the situation."
                                            },
                                            {
                                                "example_id": "81b22479-d007-4f91-b17d-4110c18b2850",
                                                "sense_id": "32f52ee3-b777-34d5-921a-2051fca3f062",
                                                "text": "\"Ever heard a Terry sermon?\" Delaine wanted to know. \"He usually starts with a joke, almost always a groaner. I love his puns! Besides, he's not afraid to tackle any issue, and he makes fun of just about everything in sight.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6dfb374-d7e2-33ca-97d3-d308c1f9ba22",
                                        "entry_id": "ea148c44-1f6a-3584-adb0-dccd2755f40c",
                                        "glosses": [
                                            "A whistling buoy."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ea2d71a-00f5-411f-acb0-b90559b3b88b",
                        "source_entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                        "source_sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                        "target_lang_word": "moaner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moaner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adb4000a-6b27-302d-b217-1525654cd710",
                                        "entry_id": "45072354-1d11-3f35-8520-4e01fc0f4c3d",
                                        "glosses": [
                                            "One who makes a moaning sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9931d6-beb2-43a0-84af-ab0ff02a4260",
                                                "sense_id": "adb4000a-6b27-302d-b217-1525654cd710",
                                                "text": "Elena was a moaner. Sex and moaning had become synonymous to Grace. She had no trouble conceptualizing sex between any two creatures capable of moaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e2407af-780c-301d-8961-b4868c24382a",
                                        "entry_id": "45072354-1d11-3f35-8520-4e01fc0f4c3d",
                                        "glosses": [
                                            "One who complains."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df8c4414-0c80-4cc6-890e-07ed013fcbc6",
                                                "sense_id": "8e2407af-780c-301d-8961-b4868c24382a",
                                                "text": "In any big outfit, including this one, you're going to get some bitchers and some moaners."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39fba442-cbc3-40d1-bcea-7b16b4dc0272",
                        "source_entry_id": "67805011-5044-3f85-ab7f-7ea67e127e7a",
                        "source_sense_id": "0ce3cc6b-6d26-340d-9794-d0784dad7f40",
                        "target_lang_word": "grouch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378ea67a-41bd-3d15-b198-6d16334909c3",
                                        "entry_id": "1de59ddc-f511-3f15-8d99-788ec0131d4c",
                                        "glosses": [
                                            "A complaint, a grumble, a fit of ill-humor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15bbc36a-e433-427f-98e7-8b68e300f12b",
                                                "sense_id": "378ea67a-41bd-3d15-b198-6d16334909c3",
                                                "text": "But today he had noticed from the moment he had got out of bed that something was amiss with the world. Either he was in the grip of some divine discontent due to the highly developed condition of his soul, or else he had a grouch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bff1079-fc57-311f-914b-e1f6ee0ec124",
                                        "entry_id": "1de59ddc-f511-3f15-8d99-788ec0131d4c",
                                        "glosses": [
                                            "One who is grumpy or irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e2ce0c-7ec8-43bd-96d8-044a8625bc63",
                                                "sense_id": "9bff1079-fc57-311f-914b-e1f6ee0ec124",
                                                "text": "I don't feel like hanging around with that grouch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92782cda-cdce-3c6e-b73d-6e85f206bd8f",
                                        "entry_id": "6cfa1575-1ff5-36ae-939c-dc75f2f907a4",
                                        "glosses": [
                                            "To be grumpy or irritable; to complain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f27c28f-5034-47f4-ba1d-14e5a078ccfd",
                                                "sense_id": "92782cda-cdce-3c6e-b73d-6e85f206bd8f",
                                                "text": "He spent all his time grouching about the problem instead of fixing it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
