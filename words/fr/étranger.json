                    "frequency": "High",
                    "semantic_group_id": "nationalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>étranger</w> a demandé un visa de travail pour pouvoir exercer son métier légalement."
                        },
                        {
                            "text": "L'association locale propose une permanence pour faciliter l'intégration des <w>étrangers</w>."
                        }
                    ],
                    "antonyms": [
