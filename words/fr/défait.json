                },
                {
                    "sense_id": "15141e59-29ab-3602-922f-3bc89f3a7a5b",
                    "sense_definition": "Dont les traits sont altérés par la fatigue, la maladie ou une vive émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est revenu de son voyage avec un visage <w>défait</w> et amaigri.",
                            "target_lang_translations": {
                                "en": "He came back from his trip with a <w>haggard</w>, gaunt face.",
                                "ru": "Он вернулся из поездки с <w>осунувшимся</w> и исхудавшим лицом.",
                                "de": "Er kam von seiner Reise mit einem <w>verhärmten</w>, abgemagerten Gesicht zurück.",
                                "es": "Volvió de su viaje con el rostro <w>demacrado</w> y enflaquecido.",
                                "zh": "他旅行回来后面容<w>憔悴</w>，人也瘦了许多。"
                            }
                        },
                        {
                            "text": "Depuis cette nuit blanche à l'hôpital, elle garde un air <w>défait</w>.",
                            "target_lang_translations": {
                                "en": "Ever since that sleepless night at the hospital, she has had a <w>haggard</w> look.",
                                "ru": "С той бессонной ночи в больнице у неё до сих пор <w>измождённый</w> вид.",
                                "de": "Seit dieser schlaflosen Nacht im Krankenhaus wirkt sie immer noch <w>abgespannt</w>.",
                                "es": "Desde aquella noche en vela en el hospital, conserva un aire <w>desencajado</w>.",
                                "zh": "自从在医院度过那个不眠之夜后，她的神色就一直很<w>憔悴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abattu",
                        "altéré",
                        "bouleversé",
                        "marqué"
                    ],
                    "antonyms": [
                        "frais",
                        "reposé"
                    ],
                    "common_phrases": [
                        "air défait",
                        "visage défait"
                    ],
                    "target_lang_definitions": {
                        "en": "With features altered by fatigue, illness, or strong emotion.",
                        "ru": "С чертами лица, изменёнными усталостью, болезнью или сильным волнением.",
                        "de": "Mit Gesichtszügen, die durch Müdigkeit, Krankheit oder starke Gefühle verändert sind.",
                        "es": "Con los rasgos alterados por el cansancio, la enfermedad o una fuerte emoción.",
                        "zh": "形容词，指面容因疲劳、疾病或强烈情绪而变得憔悴的。"
                    },
