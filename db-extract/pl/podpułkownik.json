                                "target_senses": [
                                    {
                                        "sense_id": "2ad5966a-d14d-3169-a46d-e0cd7c2904a5",
                                        "entry_id": "7bf85338-007b-3e17-8220-69ec412ea771",
                                        "glosses": [
                                            "Stabsoffiziersdienstgrad zwischen dem Major und dem Oberst"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04241834-1018-4bc3-880f-c14e64aa858b",
                                                "sense_id": "2ad5966a-d14d-3169-a46d-e0cd7c2904a5",
                                                "text": "„Er wurde zu Gneisenau geführt und übergab ihm zwei Ordres des Königs: die Mitteilung über den Waffenstillstand und die Beförderung zum Oberstleutnant.“"
                                            },
                                            {
                                                "example_id": "5a308682-2be5-4442-beeb-e55747fa7f14",
                                                "sense_id": "2ad5966a-d14d-3169-a46d-e0cd7c2904a5",
                                                "text": "„Er kehrte im Rang eines Oberstleutnants aus Israel und Angola zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                        "entry_id": "7bf85338-007b-3e17-8220-69ec412ea771",
                                        "glosses": [
                                            "Offizier, der den Dienstgrad eines Oberstleutnants innehat"
                                        ],
                                        "tags": [
                                            "Heer",
                                            "Luftwaffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28853851-15c8-4df9-9c5f-029fc3abedc6",
                                                "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                                "text": "Der Oberstleutnant befahl ihm, zehn Liegestütze zu machen."
                                            },
                                            {
                                                "example_id": "2b766f93-5348-405e-abd1-1e62cfccd8ba",
                                                "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                                "text": "„[Ferdinand Käs] leitete bis 1963 als Oberstleutnant die Gendarmerieschule und war 1963-1979 im Innenministerium tätig (ging als Sektionschef in Pension).“"
                                            },
                                            {
                                                "example_id": "aa5350f5-b247-4c32-8c76-eb5aa095321e",
                                                "sense_id": "4fc459f0-e8f7-3a4c-b5d4-37e1c36483e7",
                                                "text": "„General sei er nicht, aber Oberstleutnant, sagt mir Willi Rom, als ich anrufe – und hängt nicht ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f9fb670-3bbf-406b-b5f0-67e5a51fc46b",
                        "source_entry_id": "6e9570e6-e1d3-34d1-bd58-7a886f8628fd",
                        "source_sense_id": "43d61bf3-e574-30e0-80e3-e70d07c83ece",
                        "target_lang_word": "подполковник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подполковник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                                        "entry_id": "048cae4b-410e-3339-8d17-64801b767af1",
                                        "glosses": [
                                            "воен. воинское звание среднего командного состава, старший офицерский чин в армии рангом выше майора и ниже полковника, а также лицо, имеющее это звание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d9b6b66-8323-4d96-ad13-7b1782de2d63",
                                                "sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                                                "text": "Подле одной из амбразур спал, сидя на земле, командир батареи подполковник Винградов, завернувшись в шинель и опустив голову в колена."
                                            },
                                            {
                                                "example_id": "0cd71bad-07fc-43b8-933c-3f272a8f4201",
                                                "sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                                                "text": "Примерно через час он вернулся в штаб с командиром полка подполковником Опаликовым и с инженером полка Кудлаем."
                                            },
                                            {
                                                "example_id": "01ef1b1a-99b2-4ee2-8dd8-5f621f9e3934",
                                                "sense_id": "d8d6291a-a927-300c-bbd5-e7b3b3dad992",
                                                "text": "Пережив Отечественную и дослужившись до подполковника, дядя вышел в отставку и поселился в Саратове."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
