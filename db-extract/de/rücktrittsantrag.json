                "senses": [
                    {
                        "sense_id": "915a364a-1f9d-39c2-8d62-71b340e3782c",
                        "entry_id": "6382379c-53a4-357b-8877-647234ce3107",
                        "glosses": [
                            "Antrag, in einer bestimmten Funktion nicht mehr tätig sein zu müssen, von ihr zurückzutreten oder auch ganz generell, einen bereits geschlossenen Vertrag nicht mehr einhalten wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d63d50-569c-4ad4-a4c8-5f88e893aa79",
                                "sense_id": "915a364a-1f9d-39c2-8d62-71b340e3782c",
                                "text": "Der Innensenator nahm den Rücktrittsantrag des Abteilungsleiters an."
                            },
                            {
                                "example_id": "efb0f636-809b-4134-b8a0-c2f4b4885f11",
                                "sense_id": "915a364a-1f9d-39c2-8d62-71b340e3782c",
                                "text": "Ein Rücktrittsantrag bei der Bahn, der weniger als 24 Stunden vor Fahrtantritt eingereicht wird, kostet einen bis zu 25€."
                            },
                            {
                                "example_id": "e86f6249-3a84-4f30-b998-af117074ebf8",
                                "sense_id": "915a364a-1f9d-39c2-8d62-71b340e3782c",
                                "text": "Der seinen Austritt beantragende Staat unterliegt seinen Verpflichtungen bis zum Ende des Rechnungsjahres, in dem der Rücktrittsantrag gestellt wird."
                            }
                        ],
