                                "target_lang_sense_clarification": "intelligence department"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7ade009-1d54-38db-9e9c-34a3725e0c28",
                    "sense_definition": "A being or entity that has the ability to think and understand, such as a spirit or an advanced computer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists wonder if there is an alien <w>intelligence</w> trying to contact Earth from deep space.",
                            "target_lang_translations": {
                                "ru": "Ученые гадают, пытается ли инопланетный <w>разум</w> связаться с Землей из глубокого космоса.",
                                "tr": "Bilim insanları, uzayın derinliklerinden Dünya ile temas kurmaya çalışan uzaylı bir <w>zekâ</w> olup olmadığını merak ediyorlar.",
                                "zh": "科学家们想知道是否有外星<w>智慧生命</w>正试图从深空联系地球。"
                            }
                        },
                        {
                            "text": "The machine became a vast <w>intelligence</w> capable of controlling the entire network.",
                            "target_lang_translations": {
                                "ru": "Машина превратилась в мощный <w>интеллект</w>, способный управлять всей сетью.",
                                "tr": "Makine, tüm ağı kontrol edebilen devasa bir <w>zekâya</w> dönüştü.",
                                "zh": "这台机器变成了一个能够控制整个网络的庞大<w>智能</w>系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sophont"
                    ],
                    "common_phrases": [
                        "alien intelligence",
                        "vast intelligence",
                        "higher intelligence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существо или сущность, обладающая способностью мыслить и понимать.",
                        "tr": "Ruh veya gelişmiş bir bilgisayar gibi düşünme ve anlama yeteneğine sahip varlık.",
                        "zh": "具有思考和理解能力的生命体或实体，如外星生命或高级计算机。"
                    },
