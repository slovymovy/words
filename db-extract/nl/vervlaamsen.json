                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4931195a-dc9e-470f-9a3f-284edce8fd0e",
                                "sense_id": "df03250f-e436-3a51-a13a-a8ff1c47a7bf",
                                "text": "Dat wordt even schakelen voor de Vlamingen dus. De AH gaat wellicht pas over op het ‘vervlaamsen’ van de etiketten als er meer filialen opengaan in België."
                            },
                            {
                                "example_id": "12c67e35-3967-452f-81d2-7b43f785b1fe",
                                "sense_id": "df03250f-e436-3a51-a13a-a8ff1c47a7bf",
                                "text": "Het paleis vervlaamst: Van de twintig medewerkers van koning Filip zijn 12 Nederlandstalig en 8 Franstalig. Dat meldt Le Soir. Volgens de krant bewijst het dat het hof al lang niet meer zo francofoon is als weleer."
                            }
                        ]
                    }
