                        "glosses": [
                            "Donner un caractère immense à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8c1e121-9035-466a-b8c0-b017e25d36ea",
                                "sense_id": "5ae91d9a-ca5c-3d6b-81d9-674bca59747d",
                                "text": "Ne convient-il pas aussi, vu l'importance brusquement accrue de ce sentiment, d'en élargir et, pour ainsi dire, « immensifier » l'expression?"
                            },
                            {
                                "example_id": "22b9d123-aab1-4539-a00f-05163794340c",
                                "sense_id": "5ae91d9a-ca5c-3d6b-81d9-674bca59747d",
                                "text": "Immensifier le moi, briser ses limites et non l'abolir, tel est l'apport du Tantrisme."
                            }
                        ]
                    }
