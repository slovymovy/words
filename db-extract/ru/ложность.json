                    {
                        "translation_id": "3c70c590-c6c2-4f86-964b-5eaa9ffa937a",
                        "source_entry_id": "30334613-3aed-3db1-9a21-7a54bde51853",
                        "source_sense_id": "70092473-55a2-3767-b051-ea726192798b",
                        "target_lang_word": "Falschheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falschheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1beb52-1df7-3871-b91d-14ef6bf0e4d5",
                                        "entry_id": "f88c191d-3328-3c6d-b07b-e7513f9e27a2",
                                        "glosses": [
                                            "die Unrichtigkeit, das Falschsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab69a1a-aefd-4d49-b70b-f5730d126a43",
                                                "sense_id": "6a1beb52-1df7-3871-b91d-14ef6bf0e4d5",
                                                "text": "Es ist nicht immer ganz leicht, die Falschheit mancher Vorschläge deutlich zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d5400fe-2087-3d2d-8649-38ffafde682a",
                                        "entry_id": "f88c191d-3328-3c6d-b07b-e7513f9e27a2",
                                        "glosses": [
                                            "die Unaufrichtigkeit, die Verlogenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8054a3e0-49b8-42fd-966f-47d8e799935d",
                                                "sense_id": "3d5400fe-2087-3d2d-8649-38ffafde682a",
                                                "text": "Seine Falschheit ist nicht auf den ersten Blick zu durchschauen."
                                            },
                                            {
                                                "example_id": "605ab28c-16ba-46cd-9c3b-12c5504634f1",
                                                "sense_id": "3d5400fe-2087-3d2d-8649-38ffafde682a",
                                                "text": "„So könne er, Manucci, über meine Falschheit nicht den geringsten Zweifel haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
