                                "target_lang_word": "завёрнутый",
                                "target_lang_sense_clarification": "о подарке, упаковке"
                            },
                            {
                                "target_lang_word": "окутанный",
                                "target_lang_sense_clarification": "о тумане, темноте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eingewickelt",
                                "target_lang_sense_clarification": "über Geschenke, Verpackung"
                            },
                            {
                                "target_lang_word": "umhüllt",
                                "target_lang_sense_clarification": "über Nebel, Dunkelheit"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "envuelto",
                                "target_lang_sense_clarification": "regalos, paquetes, papel"
                            },
                            {
                                "target_lang_word": "rodeado",
                                "target_lang_sense_clarification": "rodeado por niebla u oscuridad"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包裹",
                                "target_lang_sense_clarification": "用纸等包住物品"
                            },
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "雾气、黑暗等覆盖围住"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3adbffa0-36c2-317a-9db6-1fb8eae47d12",
                    "sense_definition": "Qui est corpulent ou bien en chair, avec des formes rondes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec l'âge, cet homme est devenu un peu plus <w>enveloppé</w> mais reste en forme.",
                            "target_lang_translations": {
                                "en": "With age, this man has become a little <w>plumper</w> but is still in good shape.",
                                "ru": "С возрастом этот мужчина стал немного <w>полнее</w>, но всё ещё в хорошей форме.",
                                "de": "Mit dem Alter ist dieser Mann etwas <w>rundlicher</w> geworden, aber er ist immer noch in guter Form.",
                                "es": "Con la edad, este hombre se ha vuelto un poco más <w>rellenito</w>, pero sigue en forma.",
                                "zh": "随着年龄增长，这个男人<w>胖</w>了一些，但身材依然保持得不错。"
                            }
                        },
                        {
                            "text": "Elle a une silhouette plutôt <w>enveloppée</w> qu'elle met en valeur avec de jolies robes.",
                            "target_lang_translations": {
                                "en": "She has a rather <w>plump</w> figure that she shows off nicely in pretty dresses.",
                                "ru": "У неё довольно <w>полная</w> фигура, которую она выгодно подчёркивает красивыми платьями.",
                                "de": "Sie hat eine eher <w>füllige</w> Figur, die sie mit hübschen Kleidern gut zur Geltung bringt.",
                                "es": "Tiene una silueta bastante <w>rellenita</w>, que realza con bonitos vestidos.",
                                "zh": "她身材颇为<w>丰满</w>，她会穿漂亮的连衣裙把这一点衬托出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corpulent",
                        "enrobé",
                        "rondouillard"
                    ],
                    "antonyms": [
                        "maigre",
                        "mince"
                    ],
                    "common_phrases": [
                        "silhouette enveloppée"
                    ],
                    "target_lang_definitions": {
                        "en": "Having a plump, rounded body shape; stout or corpulent.",
                        "ru": "Имеющий полное, округлое телосложение; тучный или полный.",
                        "de": "Mit einem vollen, runden Körperbau; korpulent oder beleibt.",
                        "es": "Que tiene un cuerpo lleno y redondeado; corpulento o algo grueso.",
                        "zh": "形容体态丰满、身材圆润，身形偏胖。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plump",
                                "target_lang_sense_clarification": "rounded, full figure, often positive"
                            },
                            {
                                "target_lang_word": "stout",
                                "target_lang_sense_clarification": "heavy build, often older men"
                            },
