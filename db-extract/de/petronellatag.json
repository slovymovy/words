                "senses": [
                    {
                        "sense_id": "1c87109d-e3b7-3452-81ec-3849e49f9f9f",
                        "entry_id": "4b6746fb-4987-305a-baa6-38cbf9a74348",
                        "glosses": [
                            "Namenstag der Petronella oder der Petronilla, 31. Mai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003ff35c-ab71-4e6a-8dc0-d72c62145ee5",
                                "sense_id": "1c87109d-e3b7-3452-81ec-3849e49f9f9f",
                                "text": "\"Gisela starb am St. Petronellatag (31. Mai) 1221 und wurde in Zwettl begraben.\""
                            },
                            {
                                "example_id": "b65dcefc-03f5-47ed-8079-df6298204ad6",
                                "sense_id": "1c87109d-e3b7-3452-81ec-3849e49f9f9f",
                                "text": "„Königin Elisabeth schließt für sich und ihren Sohn Ladislaus mit Herzog Albrecht von Österreich einen Vertrag […] Gegeben zu Raab am St. Petronellatag 1440.“"
                            },
                            {
                                "example_id": "c8588a57-06d7-457c-9d32-dc9b3ca41850",
                                "sense_id": "1c87109d-e3b7-3452-81ec-3849e49f9f9f",
                                "text": "„1483 Juni 2 (Montag nach St. Petronellatag), Wien. Bürgermeister, Richter und Rat der Stadt Wien an den Kaiser: Sie ersuchen darum, dem Laurenz Taschendorfer […] seitens der Stadt für die erforderlichen Diener des Richters zu sorgen.“"
                            },
                            {
                                "example_id": "39a26aa7-472f-4d73-9d1f-5c42e0dfaa47",
                                "sense_id": "1c87109d-e3b7-3452-81ec-3849e49f9f9f",
                                "text": "Am 31. Mai ist Petronellatag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
