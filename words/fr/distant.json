            "senses": [
                {
                    "sense_id": "ad889205-ad4e-3622-ade5-502692070e41",
                    "sense_definition": "Qui est séparé par une distance spatiale ou temporelle plus ou moins grande ; éloigné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distance_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le village voisin est <w>distant</w> de cinq kilomètres de notre maison."
                        },
                        {
                            "text": "Ces deux villes sont <w>distantes</w> d'une cinquantaine de kilomètres seulement."
                        }
                    ],
                    "synonyms": [
                        "éloigné"
                    ],
                    "common_phrases": [
                        "distant de"
                    ]
                },
                {
                    "sense_id": "207bceef-3ffa-3ff7-a857-7ab5947d5579",
                    "sense_definition": "Qui garde ses distances, manifeste de la réserve ou de la froideur dans ses relations avec autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis leur dispute, il se montre particulièrement <w>distant</w> avec ses collègues."
                        },
                        {
                            "text": "Elle a répondu à ma question avec un ton très <w>distant</w> et formel."
                        }
                    ],
                    "synonyms": [
                        "froid",
                        "réservé"
                    ],
                    "common_phrases": [
                        "air distant",
                        "ton distant"
                    ]
                },
                {
                    "sense_id": "761abdba-c63e-3a61-a629-d16b3e4d6f53",
                    "sense_definition": "Qui est situé sur un autre site géographique et accessible par un réseau informatique ou de télécommunication.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé s'est connecté à un serveur <w>distant</w> pour récupérer ses fichiers."
                        },
                        {
                            "text": "La sauvegarde automatique des données est effectuée sur un site <w>distant</w>."
                        }
                    ],
                    "antonyms": [
