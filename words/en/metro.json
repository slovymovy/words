                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He traveled to <w>Metro</w> to visit his relatives during the holidays.",
                            "target_lang_translations": {
                                "ru": "Он поехал в <w>Метро</w>, чтобы навестить родственников во время праздников.",
                                "zh": "假期期间，他前往<w>梅特罗</w>探望亲戚。"
                            }
                        },
                        {
                            "text": "The climate in <w>Metro</w> is typically tropical and humid.",
                            "target_lang_translations": {
                                "ru": "Климат в <w>Метро</w> обычно тропический и влажный.",
                                "zh": "<w>梅特罗</w>的气候通常是热带潮湿气候。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
