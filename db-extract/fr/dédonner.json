                "senses": [
                    {
                        "sense_id": "739fd262-063f-3362-b30b-d9f2af0b6653",
                        "entry_id": "f0ebf0ba-db5c-32db-b331-d5fca0b71844",
                        "glosses": [
                            "Annuler un don, reprendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38084ac7-ecfd-4500-a885-3097fc7c03f3",
                                "sense_id": "739fd262-063f-3362-b30b-d9f2af0b6653",
                                "text": "Je dédonne au diable l’escarcelle, si vous l'aviez fait."
                            },
                            {
                                "example_id": "a3f5ee40-7791-44ed-ad57-2907f7a276df",
                                "sense_id": "739fd262-063f-3362-b30b-d9f2af0b6653",
                                "text": "On peut pas \"dédonner\" un cadeau"
                            },
                            {
                                "example_id": "edb99687-d293-42cc-9eba-ee908dd7cb8d",
                                "sense_id": "739fd262-063f-3362-b30b-d9f2af0b6653",
                                "text": "« Dédonner », c'est pas beau… On ne peut pas donner en grande pompe puis reprendre en cachette."
                            },
                            {
                                "example_id": "7ccb78a5-1bf2-4d78-a13b-e310c62d5037",
                                "sense_id": "739fd262-063f-3362-b30b-d9f2af0b6653",
                                "text": "Bon, c'était assez mal parti: difficile de \"dédonner\" ce dessin pour l'offrir à ma soeur..."
                            }
                        ]
                    }
                ],
