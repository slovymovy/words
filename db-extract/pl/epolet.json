                    }
                ],
                "translations": [
                    {
                        "translation_id": "01017e69-1ec7-485f-b979-493b5570420e",
                        "source_entry_id": "a6531cda-6a9c-33a0-aa39-5c39d9af4339",
                        "source_sense_id": "74e21f7b-1b7e-31ab-8036-0322e4e327ff",
                        "target_lang_word": "epaulette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epaulette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f10cb19d-2a7b-37a2-b022-d65d8c27b5a6",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "An ornamentation, worn on the shoulders of a military uniform, as a sign of rank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290cff41-98f5-41f2-bbde-d62aa1a0fe4a",
                                                "sense_id": "f10cb19d-2a7b-37a2-b022-d65d8c27b5a6",
                                                "text": "He would have answered for it at the end of a quarter of an hour that some of the glass cases contained swords and epaulettes of ancient colonels and generals; medals and orders once pinned over hearts that had long since ceased to beat; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f6366d-01b3-3b4e-b38e-f170522339bb",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "A similar piece of trimming on a lady’s dress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f518129-54ad-326f-a04d-3a72d8ff4a81",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "A plate on the anterior wings of some insects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a2e4c79-d2ef-3986-ad18-62ddd8a9eefd",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "The red patch on the shoulders of a red-winged blackbird."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf3d63f-3cd1-41f9-8fbe-0a5ff6169258",
                        "source_entry_id": "a6531cda-6a9c-33a0-aa39-5c39d9af4339",
                        "source_sense_id": "74e21f7b-1b7e-31ab-8036-0322e4e327ff",
                        "target_lang_word": "épaulette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épaulette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cff4860-412e-38af-ad95-3a6a3ffe507f",
                                        "entry_id": "39e3af97-c623-33a3-93e6-3bb10baf4712",
                                        "glosses": [
                                            "Bande de toile, d’étoffe, de ruban, cousue à la partie du vêtement qui couvre le dessus de l’épaule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc026c40-194c-4f41-8eb4-23993c78743a",
                                                "sense_id": "8cff4860-412e-38af-ad95-3a6a3ffe507f",
                                                "text": "Les épaulettes d’une chemise, d’une robe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca2c451-68bb-369f-9183-1ebd621a546c",
                                        "entry_id": "39e3af97-c623-33a3-93e6-3bb10baf4712",
                                        "glosses": [
                                            "Bande de galon rembourrée que les soldats portaient sur chaque épaule, qu’on porte encore sur certains uniformes d’apparat, et qui est ordinairement garnie à son extrémité d’une touffe de franges pendantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3e4ffa-3cc3-4140-bd6a-91c7e5ae28de",
                                                "sense_id": "aca2c451-68bb-369f-9183-1ebd621a546c",
                                                "text": "Les colonels portent aussi deux épaulettes à graine d’épinard, mais tout en or ou tout en argent ; ils ont encore deux galons au haut du schakos."
                                            },
                                            {
                                                "example_id": "05f471d4-f801-482b-afcd-752a3b5ea72d",
                                                "sense_id": "aca2c451-68bb-369f-9183-1ebd621a546c",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            },
                                            {
                                                "example_id": "4b7b6fc0-dc25-4096-b7a6-8456147fd705",
                                                "sense_id": "aca2c451-68bb-369f-9183-1ebd621a546c",
                                                "text": "— « À la santé du roi ! dit-il en buvant ; il m’a fait officier de la Légion d’honneur, il est juste que je le suive jusqu’à la frontière. Par exemple, comme je n’ai que mon épaulette pour vivre, je reprendrai mon bataillon après, c’est mon devoir. »"
                                            },
                                            {
                                                "example_id": "a846c12a-916c-4c25-95e4-106f8bb0d9dd",
                                                "sense_id": "aca2c451-68bb-369f-9183-1ebd621a546c",
                                                "text": "Qu’importe à un homme de votre sorte de faire la guerre comme sous-lieutenant ou comme capitaine ? Laissez la petite vanité de l’épaulette aux demi-sots."
                                            },
                                            {
                                                "example_id": "c5d4c2a4-7b8c-46ca-8314-2b05c11527dc",
                                                "sense_id": "aca2c451-68bb-369f-9183-1ebd621a546c",
                                                "text": "Ces deux amis, pour qui la différence des épaulettes n’existait plus, atteignirent Francfort au moment où Napoléon débarquait à Cannes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d599269b-921a-3897-bb9d-bbb90bd1b0f0",
                                        "entry_id": "39e3af97-c623-33a3-93e6-3bb10baf4712",
                                        "glosses": [
                                            "Bande de tissu sur un support rigide, portant l’indication d’un grade, que l’on glisse sur une patte d’épaule."
                                        ],
                                        "tags": [
                                            "Aujourd'hui"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff7a100f-cc48-36ae-b174-d31c8efc5924",
                                        "entry_id": "39e3af97-c623-33a3-93e6-3bb10baf4712",
                                        "glosses": [
                                            "Pièce située à la base des ailes antérieures de hyménoptères."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61c9a232-8cd4-34ef-9804-ed8c10ce7079",
                                        "entry_id": "39e3af97-c623-33a3-93e6-3bb10baf4712",
                                        "glosses": [
                                            "Entaille dans l'arête d'une pièce de bois pour y faire rentrer un autre bois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "495ef51b-85df-3ada-ae54-de81980159b9",
                                        "entry_id": "39e3af97-c623-33a3-93e6-3bb10baf4712",
                                        "glosses": [
                                            "Morceau de métal destiné à soutenir la partie supérieure de la colonne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
