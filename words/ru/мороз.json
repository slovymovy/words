                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой в Сибири часто бывает сильный <w>мороз</w>.",
                            "target_lang_translations": {
                                "en": "In winter in Siberia, there is often severe <w>frost</w>.",
                                "nl": "In de winter is er in Siberië vaak strenge <w>vorst</w>.",
                                "pl": "Zimą na Syberii często bywa silny <w>mróz</w>.",
                                "de": "Im Winter gibt es in Sibirien oft starken <w>Frost</w>.",
                                "fr": "En hiver, en Sibérie, il y a souvent un <w>grand froid</w>.",
                                "it": "In inverno in Siberia c'è spesso un forte <w>gelo</w>.",
                                "cs": "V zimě je na Sibiři často silný <w>mráz</w>.",
                                "tr": "Kışın Sibirya'da sık sık şiddetli <w>ayaz</w> olur.",
                                "es": "En invierno en Siberia suele hacer un <w>frío intenso</w>."
                            }
                        },
                        {
                            "text": "После снегопада ударил крепкий <w>мороз</w>, и все дороги обледенели.",
                            "target_lang_translations": {
                                "en": "After the snowfall, a hard <w>frost</w> hit, and all the roads iced over.",
                                "nl": "Na de sneeuwval viel er een strenge <w>vorst</w> in, en alle wegen raakten beijst.",
                                "pl": "Po opadach śniegu chwycił siarczysty <w>mróz</w> i wszystkie drogi oblodziły.",
                                "de": "Nach dem Schneefall setzte strenger <w>Frost</w> ein, und alle Straßen vereisten.",
                                "fr": "Après la chute de neige, une forte <w>gelée</w> est survenue et toutes les routes ont glacé.",
                                "it": "Dopo la nevicata è arrivato un forte <w>gelo</w> e tutte le strade si sono ghiacciate.",
                                "cs": "Po sněžení udeřil silný <w>mráz</w> a všechny silnice namrzly.",
                                "tr": "Kar yağışından sonra sert bir <w>dondurucu soğuk</w> bastırdı ve tüm yollar buz tuttu.",
                                "es": "Después de la nevada cayó una fuerte <w>helada</w> y todas las carreteras se congelaron."
                            }
                        },
                        {
                            "text": "Дети выбежали на <w>мороз</w> без шапок.",
                            "target_lang_translations": {
                                "en": "The children ran out into the <w>freezing cold</w> without hats.",
                                "nl": "De kinderen renden zonder muts de <w>vrieskou</w> in.",
                                "pl": "Dzieci wybiegły na <w>mróz</w> bez czapek.",
                                "de": "Die Kinder liefen ohne Mützen hinaus in die <w>Kälte</w>.",
                                "fr": "Les enfants ont couru dehors dans le <w>froid glacial</w> sans bonnet.",
                                "it": "I bambini sono corsi fuori al <w>freddo</w> senza cappello.",
                                "cs": "Děti vyběhly do <w>mrazu</w> bez čepic.",
                                "tr": "Çocuklar şapkasız bir şekilde <w>soğuğa</w> fırladılar.",
                                "es": "Los niños salieron corriendo al <w>frío</w> sin gorros."
                            }
                        }
