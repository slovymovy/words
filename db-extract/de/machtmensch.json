                        "glosses": [
                            "Person, die Macht haben will und sie gegebenenfalls ohne große Hemmungen auch ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399ad93b-a39c-4317-811e-377062d7436b",
                                "sense_id": "c9c24421-c897-3097-abb8-4c67ead22c23",
                                "text": "„Der kleine Horst hatte Angst vor Machtmenschen.“"
                            },
                            {
                                "example_id": "a84169a6-b4d5-42cd-9ccb-bbc01ea879ea",
                                "sense_id": "c9c24421-c897-3097-abb8-4c67ead22c23",
                                "text": "„Mit Mohammad Daud übernahm ein Machtmensch das höchste Regierungsamt, der einen autoritären Regierungsstil pflegte und die Modernisierung des Landes durch eine Stärkung des Staates anstrebte.“"
                            }
                        ],
