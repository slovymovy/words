                        "examples": [
                            {
                                "example_id": "1eaf317a-8bd2-4e95-9621-17376e7d18c0",
                                "sense_id": "419bb8fe-86eb-3e58-8b93-b25ce9bbbdad",
                                "text": "Le moment de sa barbification est, au reste, une joie pour les soldats qui passent, et découvrent à ras du sol une tête coiffée d’un calot, avec de la mousse de savon sur les joues, reflétée dans une glace minuscule, en équilibre sur une racine."
                            }
                        ]
