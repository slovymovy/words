                "senses": [
                    {
                        "sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                        "entry_id": "242e0787-1fc3-3795-91c7-b3cb21dcad7d",
                        "glosses": [
                            "südlichste Landschaft in Südamerika, in Chile sowie Argentinien gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bca5144-3fbf-42ed-b22f-fbdbbcd23163",
                                "sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                                "text": "Der Feuerlandarchipel, welcher südlich der Magellanstraße liegt, wird oft auch zu Patagonien gezählt."
                            },
                            {
                                "example_id": "1ac3bae7-0890-4ec5-84ce-6b4da2444da1",
                                "sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                                "text": "Getrennt durch die Anden setzt sich Patagonien aus Westpatagonien (befindet sich v.a. in Chile) und Ostpatagonien (befindet sich v.a. in Argentinien) zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3c1e3c8-0954-4160-ba89-6c915bcf43b5",
                        "source_entry_id": "242e0787-1fc3-3795-91c7-b3cb21dcad7d",
                        "source_sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                        "source_sense_description": "südlichste Landschaft in Südamerika, in Chile sowie Argentinien gelegen",
                        "target_lang_word": "Patagonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patagonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9392b9c-706c-394d-9fdd-b3090fc9a6b4",
                                        "entry_id": "ea334141-68bd-3071-a995-98c5a656fd92",
                                        "glosses": [
                                            "A geographical region in southern South America, including the southern parts of Chile and Argentina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aab9d1e-144f-4db4-a5d6-8421779e95c1",
                                                "sense_id": "d9392b9c-706c-394d-9fdd-b3090fc9a6b4",
                                                "text": "CHILI, a province of ſouth America, bounded by Peru on the north, by the province of La Plata on the eaſt, by Patagonia on the ſouth, and by the Pacific ocean on the weſt... But ſome comprehend Patagonia in Chili, extending it to cape Horn..."
                                            },
                                            {
                                                "example_id": "b2a65403-b010-40f0-a800-4e4234285fad",
                                                "sense_id": "d9392b9c-706c-394d-9fdd-b3090fc9a6b4",
                                                "text": "The pampas of Argentina and the chilly wastes of Patagonia, like the prairies and deserts of North America, were largely shunned by Spanish settlers until the 1870s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d75aff-85a4-3e68-b25a-10a9af417305",
                                        "entry_id": "ea334141-68bd-3071-a995-98c5a656fd92",
                                        "glosses": [
                                            "A town in Arizona."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60d8e20f-b5b6-41ae-a494-89f7305e1c02",
                        "source_entry_id": "242e0787-1fc3-3795-91c7-b3cb21dcad7d",
                        "source_sense_id": "3f4ffec6-5256-3fc3-a06f-2ac7ff28c8e5",
                        "source_sense_description": "südlichste Landschaft in Südamerika, in Chile sowie Argentinien gelegen",
                        "target_lang_word": "Patagonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patagonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5b8bf38-6311-3e79-b95a-25a0fedece01",
                                        "entry_id": "f1bf2008-8f06-385d-bc31-dcc9d01dc291",
                                        "glosses": [
                                            "Région géographique située dans le Sud du continent américain, partagée entre le Chili et l’Argentine, au sud des rios Limay et Negro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6dfd261-184c-4478-bd72-54f26087ccf5",
                                                "sense_id": "b5b8bf38-6311-3e79-b95a-25a0fedece01",
                                                "text": "Selon la suite de l’histoire, Magellan aurait dit: « Ah ! Patagon ! » c’est-à-dire « Grand-Pied » à cause de la taille des mocassins de l'Indien. Cette origine du mot « patagonie » est généralement acceptée sans autre interrogation. Mais bien que pata soit un « pied » en espagnol, le suffixe -gon ne signifie rien."
                                            },
                                            {
                                                "example_id": "1aabc614-56a1-4ebf-b796-775e931bfa4e",
                                                "sense_id": "b5b8bf38-6311-3e79-b95a-25a0fedece01",
                                                "text": "Remontant seul il n’y a pas si longtemps, à partir de Río Gallegos, aux confins de la Terre de Feu et au volant d’une voiture de location, la plaine immense de la Patagonie argentine vers la frontière du Chili et le fabuleux glacier du Perito Moreno, je me répétais, joyeux comme dans ce premier train vers Milan : « Je suis en Patagonie, je suis en Patagonie. »"
                                            },
                                            {
                                                "example_id": "69331557-6a2b-40d0-84ea-ac69fe3bc39f",
                                                "sense_id": "b5b8bf38-6311-3e79-b95a-25a0fedece01",
                                                "text": "Voici des photos d’une réplique de la découverte du scientifique Pablo A. Gallina, qui a notamment reçu une bourse de National Geographic en 2016 pour étudier «une époque mal comprise dans l’évolution des dinosaures dans la région de Patagonie»."
                                            },
                                            {
                                                "example_id": "e77bf707-1ad5-491a-aab9-7c5484873a23",
                                                "sense_id": "b5b8bf38-6311-3e79-b95a-25a0fedece01",
                                                "text": "Une nouvelle espèce de mammifère du crétacé supérieur, âgée de 72 à 74 millions d’années et nommée Orretherium tzen, a été découverte récemment en Patagonie chilienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
