                ],
                "senses": [
                    {
                        "sense_id": "1940779f-c7a7-32a1-bafa-530084141a19",
                        "entry_id": "11ff3390-42cb-357d-ad21-5968587006ed",
                        "glosses": [
                            "interdisziplinäre Forschungsrichtung, die sich mit dem Phänomen Wagnis, seinen historischen und zeittypischen Erscheinungsformen sowie den Persönlichkeitsstrukturen, Motiven und Verhaltensmustern von Menschen in selbst gewählten Extremsituationen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94eca2f0-35c5-4f33-bc29-d302b1129b63",
                                "sense_id": "1940779f-c7a7-32a1-bafa-530084141a19",
                                "text": "„Nach Erkenntnissen der Wagnisforschung kann ein Fehlen oder ein zu geringes Maß des Angsterlebens zu großen Risiken führen.“"
                            },
                            {
                                "example_id": "1c2fb12f-baa5-4175-9297-2ffeb15733d7",
                                "sense_id": "1940779f-c7a7-32a1-bafa-530084141a19",
                                "text": "„Wer etwas wagt, lebt gefährlich, sollte man meinen. Doch Erkenntnisse aus der Wagnisforschung legen das Gegenteil nahe.“"
                            },
                            {
                                "example_id": "7b9773d1-7950-4b6f-8bb1-2a6491b11898",
                                "sense_id": "1940779f-c7a7-32a1-bafa-530084141a19",
                                "text": "„Bezug genommen werden soll im Folgenden auf die Autoren Schleske, Neumann und Warwitz, welche als Wegbereiter der Wagnisforschung angesehen werden.“"
                            },
                            {
                                "example_id": "2b0b037c-76c2-45fd-9593-d238f121950f",
                                "sense_id": "1940779f-c7a7-32a1-bafa-530084141a19",
                                "text": "„Es gibt heute sogar eine wissenschaftliche Disziplin, die sich mit der menschlichen Bereitschaft, ein Risiko einzugehen, auseinandersetzt: die Wagnisforschung.“"
                            },
                            {
                                "example_id": "d87e6192-b871-4afc-9257-0c08b51ecb25",
                                "sense_id": "1940779f-c7a7-32a1-bafa-530084141a19",
                                "text": "„So wie es in der Wirtschaft Wagniskapital gibt, muss es in der Wissenschaft ein Mehr an Wagnisforschung geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
