                "senses": [
                    {
                        "sense_id": "d5366fd1-54d0-3562-a6d0-a639f217f894",
                        "entry_id": "756ec958-ac69-3d29-99b7-e3dfee20879c",
                        "glosses": [
                            "torture"
                        ],
                        "tags": [
                            "countable",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8a5d4624-e8d8-4cdd-9791-6f496e1b748b",
                                "sense_id": "d5366fd1-54d0-3562-a6d0-a639f217f894",
                                "text": "Der Gefangene ertrug die Quälereien.",
                                "translation": "The prisoner endured all torture.",
                                "english": "The prisoner endured all torture."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf07f75-b2e9-3fea-a040-fccef5d73773",
                        "entry_id": "756ec958-ac69-3d29-99b7-e3dfee20879c",
                        "glosses": [
                            "torture; psychological burden, mental strain"
                        ],
                        "tags": [
                            "countable",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "7419e6d5-1b3c-4d18-92eb-199fced9ee46",
                                "sense_id": "3bf07f75-b2e9-3fea-a040-fccef5d73773",
                                "text": "Die endlos jammernden Gören waren für alle eine Quälerei.",
                                "translation": "The incessantly whiny brats were a torture for everybody.",
                                "english": "The incessantly whiny brats were a torture for everybody."
                            }
                        ]
                    },
                    {
                        "sense_id": "153a2ebd-56a3-3a68-a70d-2bca5e4c1dc8",
                        "entry_id": "756ec958-ac69-3d29-99b7-e3dfee20879c",
                        "glosses": [
                            "torture; unpleasant, straining activity (usually for physical tasks)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5d4ae4b2-ea5c-4994-9e5b-cf24b5241ca8",
                                "sense_id": "153a2ebd-56a3-3a68-a70d-2bca5e4c1dc8",
                                "text": "Für ihn wurden selbst Alltagsaufgaben zur Quälerei.",
                                "translation": "Even mundane tasks have become a torture for him.",
                                "english": "Even mundane tasks have become a torture for him."
                            }
                        ]
                    }
