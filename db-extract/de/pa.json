                    {
                        "sense_id": "9cd1dea1-a92e-3613-91a0-01524f67e9cb",
                        "entry_id": "67687275-a2d3-31a2-b6a6-65aca6cd46a7",
                        "glosses": [
                            "Papa"
                        ],
                        "tags": [
                            "kindersprachlich",
