                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a070ef26-e345-42c9-abe9-4cf0ebd0a744",
                                                "sense_id": "44a2a7ea-3e2f-340b-b66a-eec7cb0cbaad",
                                                "text": "Il fait ensuite un examen plus approfondi de la méthode antipyrétique en général, et de son application à la pneumonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "312e19d2-93e2-4c30-ae17-482a7376c74e",
                        "source_entry_id": "a356fefb-6eca-3b42-84ca-3b92172f0238",
                        "source_sense_id": "f41945f8-58a4-3d57-af85-287a70f5a01d",
                        "source_sense_description": "that reduces fever",
                        "target_lang_word": "antipyretisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antipyretisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf99253e-1049-35d3-841b-80a9ea3d0a5c",
                                        "entry_id": "6024086c-81c0-3665-b2cd-bd6de0d7cc1d",
                                        "glosses": [
                                            "fiebersenkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f31b079-47de-4dcc-9879-72437a29073f",
                                                "sense_id": "bf99253e-1049-35d3-841b-80a9ea3d0a5c",
                                                "text": "Paracetamol ist ein Arzneistoff mit mäßigen analgetischen und guten antipyretischen Eigenschaften."
                                            },
                                            {
                                                "example_id": "8fd2a543-65e8-47b9-b564-4a893a44f606",
                                                "sense_id": "bf99253e-1049-35d3-841b-80a9ea3d0a5c",
                                                "text": "„Bei Kindern mit einfachen Fieberkrämpfen kann jedoch auch mittels systematischer antipyretischer Therapie (Paracetamol) das Auftreten von erneuten Krampfereignissen nicht verhindert, beziehungsweise deren Häufigkeit nicht reduziert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9bee0b3-0b26-4e3c-97c7-aa517258bb38",
                        "source_entry_id": "a356fefb-6eca-3b42-84ca-3b92172f0238",
                        "source_sense_id": "f41945f8-58a4-3d57-af85-287a70f5a01d",
                        "source_sense_description": "that reduces fever",
                        "target_lang_word": "fiebersenkend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiebersenkend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fda8bf98-3f7b-366f-99e4-fb6fb1e7df5f",
                                        "entry_id": "3e961d26-fba3-3454-bfd0-4d3131981d12",
                                        "glosses": [
                                            "die erhöhte Körpertemperatur, das Fieber senkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c64893-0883-45af-9480-fde94f1f7465",
                                                "sense_id": "fda8bf98-3f7b-366f-99e4-fb6fb1e7df5f",
                                                "text": "Wie wichtig Fieber für eine ausreichende Immunantwort ist, zeigen auch Studien an Kindern, nach denen manche Impfungen schlechter „angehen“, wenn Kinder nach der Impfung routinemäßig fiebersenkende Mittel bekommen (eine bis heute viel geübte Praxis)."
                                            },
                                            {
                                                "example_id": "590b6c63-30d7-4648-a6ce-71e7a6bf7ae6",
                                                "sense_id": "fda8bf98-3f7b-366f-99e4-fb6fb1e7df5f",
                                                "text": "Bereits ab einer Körperkerntemperatur von 38,5 Grad Celsius ist es ratsam, fiebersenkende Maßnahmen anzuwenden und es so für den Erkrankten erträglicher zu machen."
                                            },
                                            {
                                                "example_id": "39453928-4330-428f-ac91-bff64bed2486",
                                                "sense_id": "fda8bf98-3f7b-366f-99e4-fb6fb1e7df5f",
                                                "text": "Finger weg von fiebersenkenden Medikamenten, um dann in die Arbeit zu gehen: Wenn das körpereigene Abwehrsystem durch derartige Mittel gehemmt wird, dauert es auch länger bis das Fieber abklingt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
