                        "entry_id": "18d4bedc-69c0-3d85-bf85-2ce1b24e0a54",
                        "glosses": [
                            "Compositeur de morceaux instrumentaux pour rap, hip-hop ou RnB contemporain."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "1be43975-5629-45ea-9958-e72dd08a1637",
                                "sense_id": "709f561e-cb2f-3cb1-b173-88194d09ce72",
                                "text": "Ce beatmaker qui travaillait depuis sept ans avec Guru a mis en ligne une soi-disant lettre posthume du rappeur."
                            },
                            {
                                "example_id": "b0699ab9-6c3b-461d-a9dc-6ea211abfd7d",
                                "sense_id": "709f561e-cb2f-3cb1-b173-88194d09ce72",
                                "text": "La beatmaker Yaeji nous transporte dans un rêve doux pour sa pièce What We Drew, issue du mixtape du même nom. Entourée de ses amies, la DJ américano-coréenne vénère et chérit un bulbe dans son monde imaginaire."
                            }
                        ]
                    }
