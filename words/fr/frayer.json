        "frayure"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                    "sense_definition": "Ouvrir ou tracer une voie, rendre un passage praticable en écartant les obstacles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ouvrir_voie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs ont dû se <w>frayer</w> un passage à travers la forêt dense."
                        },
                        {
                            "text": "Malgré la foule compacte, elle parvient à se <w>frayer</w> un chemin vers la sortie."
                        }
                    ],
                    "synonyms": [
                        "ouvrir",
                        "tracer"
                    ],
                    "antonyms": [
                        "barrer",
                        "bloquer"
                    ],
                    "common_phrases": [
                        "se frayer un chemin",
                        "se frayer un passage"
                    ]
                },
                {
                    "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                    "sense_definition": "Fréquenter quelqu'un, avoir des relations habituelles ou du commerce avec lui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse catégoriquement de <w>frayer</w> avec des individus malhonnêtes ou corrompus."
                        },
                        {
                            "text": "Ce jeune artiste préfère <w>frayer</w> avec d'autres peintres et poètes du quartier."
                        }
                    ],
                    "synonyms": [
                        "fréquenter",
                        "côtoyer"
                    ],
                    "antonyms": [
                        "éviter",
                        "fuir"
                    ],
                    "common_phrases": [
                        "frayer avec quelqu'un"
                    ]
                },
                {
                    "sense_id": "0e5c0a0c-55ce-360b-9035-6142e1adf186",
                    "sense_definition": "Faciliter l'accès, ouvrir la voie à quelqu'un ou à quelque chose au sens figuré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ouvrir_voie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses découvertes scientifiques majeures ont <w>frayé</w> la voie à de nombreux chercheurs."
                        },
                        {
                            "text": "Le directeur a <w>frayé</w> le chemin à son adjoint pour lui succéder."
                        }
                    ],
                    "synonyms": [
                        "faciliter",
                        "préparer"
                    ],
                    "antonyms": [
                        "entraver",
                        "empêcher"
                    ],
                    "common_phrases": [
                        "frayer le chemin",
                        "frayer la voie"
                    ]
                },
                {
                    "sense_id": "9b896ebc-f72d-3bc2-b2b4-210288203b1e",
                    "sense_definition": "Déposer ses œufs ou les féconder, en parlant des poissons et des batraciens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au printemps, les saumons remontent le courant pour <w>frayer</w> dans les eaux calmes."
                        },
                        {
                            "text": "Les truites <w>fraient</w> généralement dans des rivières peu profondes au fond graveleux."
                        }
                    ],
                    "synonyms": [
                        "se reproduire"
                    ],
                    "common_phrases": [
                        "remonter pour frayer"
                    ]
                },
                {
                    "sense_id": "30209a81-3fea-3ca7-8ce5-f625446bee8d",
                    "sense_definition": "Frôler, frotter légèrement contre quelque chose en passant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "frottement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En marchant dans le couloir étroit, son sac est venu <w>frayer</w> le mur peint."
                        },
                        {
                            "text": "Dans la pénombre, sa main a <w>frayé</w> la rambarde en bois sans s'y appuyer."
                        }
                    ],
                    "synonyms": [
                        "effleurer",
                        "frôler"
                    ]
                },
                {
                    "sense_id": "9fa65118-dc0c-3dd4-b08d-c974ce73760c",
                    "sense_definition": "S'altérer ou s'effacer par frottement, en parlant de pièces de monnaie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "frottement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force de circuler de main en main, ces anciennes pièces de monnaie finissent par se <w>frayer</w>."
                        },
                        {
                            "text": "Cette médaille en argent est tellement <w>frayée</w> que son inscription est devenue illisible."
                        }
                    ],
                    "synonyms": [
                        "s'user"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Principalement employé pour les pièces de monnaie."
                        }
                    ]
                },
                {
                    "sense_id": "af97ffd2-4cfe-37a1-8007-2ae2204c9c83",
                    "sense_definition": "Engendrer des dépenses importantes, occasionner des frais.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "depense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entretien d'une si vaste propriété de campagne <w>fraye</w> énormément chaque hiver."
                        },
                        {
                            "text": "Cet appareil défectueux ne sert plus à rien et <w>fraye</w> beaucoup trop en réparations."
                        }
                    ],
                    "synonyms": [
                        "coûter",
                        "dépenser"
                    ],
                    "antonyms": [
                        "rapporter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi vieilli."
                        }
                    ]
                }
            ]
        }
    ]
}