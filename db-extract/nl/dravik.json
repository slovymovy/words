                    {
                        "translation_id": "20d5b0bb-2b67-47c8-af58-36a4bb789a82",
                        "source_entry_id": "d228274c-454e-395b-b23a-d7e2f380943b",
                        "source_sense_id": "061632e1-57b2-3e31-b78e-9618e0658f8c",
