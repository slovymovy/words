                "senses": [
                    {
                        "sense_id": "24ddce7b-92e8-3adc-9358-f561bf3118c3",
                        "entry_id": "230ef325-37a1-3267-bfb3-e64ed30d1082",
                        "glosses": [
                            "Enjamber."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "4f0cd615-497b-405c-a353-e5ed75d0d2b7",
                                "sense_id": "24ddce7b-92e8-3adc-9358-f561bf3118c3",
                                "text": "Regarde-voir ; ça m’a regiclé jusqu’à la grille en gambant le ruisseau !"
                            },
                            {
                                "example_id": "c615ea32-645a-4982-8c74-e880ad9d4f5e",
                                "sense_id": "24ddce7b-92e8-3adc-9358-f561bf3118c3",
                                "text": "Son humeur va chercher, chicanner sur sa glisse\nL’écolier innocent qui prend de l’exercice ;\nS’il gambe une barrière, ou si, jambes en l’air,\nIl fait une cupesse, ah ! son délit est clair ;\n Il faut le censurer."
                            }
                        ]
                    }
