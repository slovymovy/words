                "senses": [
                    {
                        "sense_id": "88c2be61-035a-3f2b-94d9-aca51d3bbcce",
                        "entry_id": "e39f8235-7fa5-3b9c-a55d-7debef70fcfa",
                        "glosses": [
                            "Ensemble des moyens de transport pour les petits trajets, tels que la trottinette, le monoroue ou le gyropode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b500307-c98f-43b1-8e5c-e4a2db5fe719",
                                "sense_id": "88c2be61-035a-3f2b-94d9-aca51d3bbcce",
                                "text": "La micromobilité électrique qui atteint des vitesses de 25km/h sera autorisée à partager les infrastructures cyclables."
                            },
                            {
                                "example_id": "9184a823-59c0-47ed-b0b8-6e948005d5c0",
                                "sense_id": "88c2be61-035a-3f2b-94d9-aca51d3bbcce",
                                "text": "Nous allons aussi créer un observatoire national de ces micromobilités réunissant des membres politiques, associatifs et professionnels."
                            },
                            {
                                "example_id": "f89b840b-9d8a-4a39-919f-71c6bfd93ff6",
                                "sense_id": "88c2be61-035a-3f2b-94d9-aca51d3bbcce",
                                "text": "Prendre en compte la nature évolutive des transports et noter avec inquiétude les défis posés par ces changements, notamment le nombre croissant de décès parmi les piétons, les conducteurs de deux et trois roues motorisés, les vélos électriques et les dispositifs de micromobilité",
                                "translation": "Déclaration de Marrakech, Quatrième conférence ministérielle sur la sécurité routière : Un monde, une route, s'engager pour la vie, Marrakech, 18-20 février 2025"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee93134d-b66f-42bb-b1ee-69b0c08649b8",
                        "source_entry_id": "e39f8235-7fa5-3b9c-a55d-7debef70fcfa",
                        "source_sense_id": "88c2be61-035a-3f2b-94d9-aca51d3bbcce",
                        "target_lang_word": "micromobility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "micromobility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dcb8247-8214-3607-859d-c0d18a97d450",
                                        "entry_id": "4c59502a-8dc3-3094-bf38-e198d0b96a7a",
                                        "glosses": [
                                            "Transportation over short distances, provided by lightweight (usually single-person) vehicles."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f24d4dc-d173-4eb1-8b8e-606e65182b9a",
                                                "sense_id": "6dcb8247-8214-3607-859d-c0d18a97d450",
                                                "text": "The arrival of electric scooters and motor-assisted bicycles, backbones of a transportation mode known as micromobility, has been greeted as part of the solution to clogged roadways and unbearable travel delays."
                                            },
                                            {
                                                "example_id": "8ba6bb60-e0a8-446e-8861-db4e06a56e69",
                                                "sense_id": "6dcb8247-8214-3607-859d-c0d18a97d450",
                                                "text": "More cities around the country are expected to follow suit with year-long trials, as potential operators unveiled new technology in the race to tap into Britain’s new micromobility market."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
