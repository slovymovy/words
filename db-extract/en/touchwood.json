                                        "sense_id": "48bbddf5-4880-3fb7-bb9c-e6745967779f",
                                        "entry_id": "08552887-253e-37ee-81ac-30f79aa64c76",
                                        "glosses": [
                                            "drewno, które w wyniku rozkładu przez drobnoustroje stało się miękkie, suche i kruche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a229fb8-a431-49ea-b36b-625863570ae6",
                                                "sense_id": "48bbddf5-4880-3fb7-bb9c-e6745967779f",
                                                "text": "W szafach myszy gryzą królicze skórki, ubrania giną w przejrzystych pyskach moli, bezszelestnie łuszczy się wapno ze ścian, wirują w powietrzu strzępki próchna."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "4ead6f5c-3e97-392b-af0b-317f5b43a37f",
                                        "entry_id": "08552887-253e-37ee-81ac-30f79aa64c76",
                                        "glosses": [
                                            "stary, zniedołężniały człowiek"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "scornfully"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada14db7-6350-4248-af45-b85b7b3a220f",
                                                "sense_id": "4ead6f5c-3e97-392b-af0b-317f5b43a37f",
                                                "text": "Myślisz, że jak mam dwie dorosłe córki, to już ze mnie stare próchno, na którym nikt oka nie zawiesi?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
