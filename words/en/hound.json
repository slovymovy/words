                },
                {
                    "sense_id": "5495ea1a-1813-395e-b929-01ab04d5a87e",
                    "sense_definition": "Any canine animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild <w>hound</w> roamed the plains in search of food.",
                            "target_lang_translations": {
                                "nl": "De wilde <w>hond</w> zwierf over de vlaktes op zoek naar voedsel."
                            }
                        },
                        {
                            "text": "A lone <w>hound</w> howled at the moon during the quiet night.",
                            "target_lang_translations": {
                                "nl": "Een eenzame <w>hond</w> huilde naar de maan tijdens de stille nacht."
                            }
                        }
                    ],
                    "target_lang_definitions": {
