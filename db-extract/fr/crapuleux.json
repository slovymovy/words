                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99f05f3b-28d1-3a24-b24b-93646edfe0fd",
                                        "entry_id": "6c49051b-c078-368e-a329-66d786e88ad7",
                                        "glosses": [
                                            "Literal senses:",
                                            "Having a peculiar flavour supposed to be derived from the weeds growing among the vines; said of certain kinds of French brandy."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a894b8ac-e844-3782-a490-b986aae0f76f",
                                        "entry_id": "6c49051b-c078-368e-a329-66d786e88ad7",
                                        "glosses": [
                                            "Inferior in condition or quality.",
                                            "Shabby, run-down, possibly connected with bad, dishonest or illegal activities, somewhat disreputable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e74d4b-a9d5-4f1a-8d54-2df4f2d7d7bd",
                                                "sense_id": "a894b8ac-e844-3782-a490-b986aae0f76f",
                                                "text": "Sleazy city / Seedy films / Breathing so heavy / Next to my neighbour / Let’s get acquainted"
                                            },
                                            {
                                                "example_id": "439d6730-9af4-4e44-ad0d-5a1555b4c8fb",
                                                "sense_id": "a894b8ac-e844-3782-a490-b986aae0f76f",
                                                "text": "The healing power of alcohol / Only works on scrapes and nicks / And not on girls in seedy bars / Who drown themselves in it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e6e9fc7-55dc-3588-b021-c5dbaed2393b",
                                        "entry_id": "6c49051b-c078-368e-a329-66d786e88ad7",
                                        "glosses": [
                                            "Inferior in condition or quality.",
                                            "Untidy, unkempt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb1e1e4-8ed1-4bae-9592-bb9be3f10f53",
                                                "sense_id": "0e6e9fc7-55dc-3588-b021-c5dbaed2393b",
                                                "text": "His seedy, dirt-smudged visage caused her to look at him askance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1540303e-710b-37bf-8dc4-ba88d57792a5",
                                        "entry_id": "6c49051b-c078-368e-a329-66d786e88ad7",
                                        "glosses": [
                                            "Inferior in condition or quality.",
                                            "Infirm, unwell, gone to seed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08aac853-1ae8-4e9e-a8f9-47d8535240ec",
                                                "sense_id": "1540303e-710b-37bf-8dc4-ba88d57792a5",
                                                "text": "With her aching back and pronounced limp, she was feeling particularly seedy today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c290934-0b2b-33dd-9df0-8c0b766a8477",
                                        "entry_id": "6c49051b-c078-368e-a329-66d786e88ad7",
                                        "glosses": [
                                            "Inferior in condition or quality.",
                                            "Suffering the effects of a hangover."
                                        ],
                                        "tags": [
