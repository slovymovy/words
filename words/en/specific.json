                    "synonyms": [
                        "monosemous"
                    ],
                    "antonyms": [
                        "non-specific"
                    ],
                    "common_phrases": [
                        "specific test",
                        "specific symptoms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для идентификации конкретной вещи, например болезни, с минимальным риском ошибки."
