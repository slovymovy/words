                    {
                        "form_id": "1d2b970a-96a1-45d9-9561-0f1b65411a65",
                        "entry_id": "2f6525fc-6a0a-3ab6-a41f-3c556b5af363",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Brandschutz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76e48f0e-fadb-3e99-a0d0-8d79e311bbfb",
                        "entry_id": "2f6525fc-6a0a-3ab6-a41f-3c556b5af363",
                        "glosses": [
                            "Gesamtheit aller vorbeugenden Sicherheitsmaßnahmen, die das Entstehen eines Brandes (= Feuer und Rauch) verhindern oder dessen Auswirkungen begrenzen"
                        ],
                        "tags": [
                            "Schutzziel"
                        ],
                        "examples": [
                            {
                                "example_id": "f3ebe0e1-46e1-44b1-b9d3-ec1f73299f55",
                                "sense_id": "76e48f0e-fadb-3e99-a0d0-8d79e311bbfb",
                                "text": "„Eine gemeinsame Benutzung von Lüftungsleitungen zur Lüftung und zur Ableitung der Abgase von Feuerstätten ist zulässig, wenn keine Bedenken wegen der Betriebssicherheit und des Brandschutzes bestehen.“"
                            },
                            {
                                "example_id": "2f45da98-b941-4482-8759-0d045e77fc12",
                                "sense_id": "76e48f0e-fadb-3e99-a0d0-8d79e311bbfb",
                                "text": "„Hintergrund der Schließung der Wohnheime sind Mängel beim Brandschutz, die im Herbst bei einer Begehung durch die Feuerwehr festgestellt wurden.“"
                            },
                            {
                                "example_id": "64917773-5356-4798-b70a-33fe3b425450",
                                "sense_id": "76e48f0e-fadb-3e99-a0d0-8d79e311bbfb",
                                "text": "„Das Papier dient der Erläuterung und Klarstellung zweier in § 14 der Musterbauordnung (MBO) aufgeführten Ziele des Brandschutzes – insbesondere im Hinblick auf die Anforderungen zur Rauchableitung in den bauordnungsrechtlichen Vorschriften,“"
                            },
                            {
                                "example_id": "b4b8c4c0-728d-4ffa-9d96-aeb38678d00b",
                                "sense_id": "76e48f0e-fadb-3e99-a0d0-8d79e311bbfb",
                                "text": "„Diese Richtlinie gilt für den Brandschutz von Lüftungsanlagen, an die Anforderungen nach § 40 der Hamburgischen Bauordnung (HBauO) gestellt werden.“"
                            },
                            {
                                "example_id": "6335ab16-1731-4ca4-8212-43a851730c78",
                                "sense_id": "76e48f0e-fadb-3e99-a0d0-8d79e311bbfb",
                                "text": "„In der Brandschutzordnung sind die Verhaltensregeln zur Brandverhütung, die organisatorischen Maßnahmen des vorbeugenden Brandschutzes und die Verhaltensregeln im Brandfall festzulegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
