                "word": "timepiece",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f2246fb8-adc2-46e5-b233-2d6a84175d54",
                        "entry_id": "03e19e36-c054-3aa3-a5a0-2801b3655e1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "timepieces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7baa685a-c505-337c-97f8-b47a068c6f34",
                        "entry_id": "03e19e36-c054-3aa3-a5a0-2801b3655e1b",
                        "glosses": [
                            "A chronometer (any device used to tell the time of day), particularly a clock lacking a chime or similar sounding mechanism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6866edc-b3ae-4449-b106-142e3831ed46",
                                "sense_id": "7baa685a-c505-337c-97f8-b47a068c6f34",
                                "text": "The only timepiece she allowed in the house was a sundial. She usually kept the curtains pulled."
                            },
                            {
                                "example_id": "6a3e4bdf-d3f8-4d03-8dfe-c29c15d64034",
                                "sense_id": "7baa685a-c505-337c-97f8-b47a068c6f34",
                                "text": "An interesting feature of the church is the invisible clock, which you can hear thumping away as you enter. Constructed in 1525, it is one of the oldest timepieces in England. It chimes the hours and the quarters, and every three hours it plays a hymn. But it has no faces."
                            }
                        ]
                    },
                    {
                        "sense_id": "343101ad-bd2f-333b-8394-ab3b9ed4f42e",
                        "entry_id": "03e19e36-c054-3aa3-a5a0-2801b3655e1b",
                        "glosses": [
                            "A watch (a small portable device used to tell the time of day), particularly one lacking a chime or similar sounding mechanism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43fba8f2-87b3-4d1e-a1d5-483b70eca243",
                                "sense_id": "343101ad-bd2f-333b-8394-ab3b9ed4f42e",
                                "text": "His pocket watch was a beautiful timepiece."
                            },
                            {
                                "example_id": "1cd6f043-91c4-43fa-a39c-e222820586a6",
                                "sense_id": "343101ad-bd2f-333b-8394-ab3b9ed4f42e",
                                "text": "The spring-driven clock introduced the truly movable timepiece and, with further innovations in miniaturization, the object that came to be called the watch."
                            }
                        ]
                    }
                ],
