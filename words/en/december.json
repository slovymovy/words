                {
                    "sense_id": "58608a79-efc5-3304-b912-eb311b5e07b6",
                    "sense_definition": "The twelfth and last month of the year, coming after November and before January.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "My birthday is in <w>December</w>.",
                            "target_lang_translations": {
                                "ru": "Мой день рождения в <w>декабре</w>.",
                                "nl": "Mijn verjaardag is in <w>december</w>.",
                                "pl": "Moje urodziny są w <w>grudniu</w>.",
                                "de": "Mein Geburtstag ist im <w>Dezember</w>.",
                                "fr": "Mon anniversaire est en <w>décembre</w>.",
                                "it": "Il mio compleanno è a <w>dicembre</w>.",
                                "cs": "Moje narozeniny jsou v <w>prosinci</w>.",
                                "tr": "Doğum günüm <w>Aralık</w> ayında.",
                                "es": "Mi cumpleaños es en <w>diciembre</w>.",
                                "zh": "我的生日在<w>十二月</w>。"
                            }
                        },
                        {
                            "text": "We usually have a lot of snow in <w>December</w>.",
                            "target_lang_translations": {
                                "ru": "Обычно в <w>декабре</w> у нас много снега.",
                                "nl": "We hebben meestal veel sneeuw in <w>december</w>.",
                                "pl": "Zazwyczaj mamy dużo śniegu w <w>grudniu</w>.",
                                "de": "Wir haben normalerweise viel Schnee im <w>Dezember</w>.",
                                "fr": "Nous avons généralement beaucoup de neige en <w>décembre</w>.",
                                "it": "Di solito abbiamo molta neve a <w>dicembre</w>.",
                                "cs": "V <w>prosinci</w> máme obvykle hodně sněhu.",
                                "tr": "Genellikle <w>Aralık</w> ayında çok kar yağar.",
                                "es": "Normalmente tenemos mucha nieve en <w>diciembre</w>.",
                                "zh": "我们这里<w>十二月</w>通常雪很大。"
                            }
                        }
