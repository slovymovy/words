                        "examples": [
                            {
                                "example_id": "4bf45e91-4f71-4147-ac1d-2a0e860ed9bc",
                                "sense_id": "235c72cf-f2ed-3d87-9cca-3beba75edd1c",
                                "text": "Ce qui me rend heureux (-se)? Quand les instits nous laissaient jouer aux jeux de société pendant deux après-midis dans les jours qui précédaient les vacances de Noël.",
                                "translation": "Z čeho jsem byl šťastný? Když nás účy před vánočními prázdninami dvakrát nechaly hrát si odpoledne společenské hry."
                            },
                            {
                                "example_id": "c9c095ff-36c0-4dc9-95ac-b611c922fb6a",
                                "sense_id": "235c72cf-f2ed-3d87-9cca-3beba75edd1c",
                                "text": "Pour les instits aussi, la rentrée est un grand jour",
                                "translation": "Pro učitele a učitelky je začátek školního roku také významný den."
                            }
                        ]
