                "senses": [
                    {
                        "sense_id": "722d23b3-b0ab-3878-9fe4-c30244cd8780",
                        "entry_id": "1c757d2d-ea13-38d6-8e8e-cfd2cd464b5e",
                        "glosses": [
                            "действ. прич. прош. вр. от щебетать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "079459da-4470-4fd0-b5b8-8ef34ca7b70b",
                                "sense_id": "722d23b3-b0ab-3878-9fe4-c30244cd8780",
                                "text": "Смолкли в светлице долго и весело щебетавшие Настя с Фленушкой."
                            },
                            {
                                "example_id": "3fdf7300-7e7c-438d-ac3f-ec0f3c9eef74",
                                "sense_id": "722d23b3-b0ab-3878-9fe4-c30244cd8780",
                                "text": "А когда над зарослями появилась более крупная птица, похожая на коршуна, медленно планировавшая кругами на некоторой высоте, «рябчики», громко щебетавшие ранее, замолкли и попрятались."
                            }
                        ]
                    }
