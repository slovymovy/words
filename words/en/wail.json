{
    "word_family": [
        "wailer",
        "wailing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a2add35-b483-3b50-b5f1-a4986d78c41f",
                    "sense_definition": "to cry out with a long, high-pitched sound, especially because of grief, pain, or sadness",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal expression of grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>wail</w> loudly after he fell down and scraped his knee on the pavement.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал громко <w>реветь</w>, после того как упал и содрал коленку об асфальт.",
                                "cs": "Dítě začalo hlasitě <w>bulelet</w> poté, co spadlo a odřelo si koleno o chodník."
                            }
                        },
                        {
                            "text": "The mourners started to <w>wail</w> in grief as the funeral procession passed through the quiet village.",
                            "target_lang_translations": {
                                "ru": "Скорбящие начали <w>голосить</w> от горя, когда похоронная процессия проходила через тихую деревню.",
                                "cs": "Pozůstalí začali žalem <w>naříkat</w>, když smuteční průvod procházel tichou vesnicí."
                            }
                        }
                    ],
                    "synonyms": [
                        "cry",
                        "weep",
                        "keen",
                        "ululate",
                        "lament"
                    ],
                    "antonyms": [
                        "laugh",
                        "rejoice"
                    ],
                    "common_phrases": [
                        "wail in grief",
                        "wail with pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "громко и протяжно плакать или кричать, особенно от горя, боли или печали",
                        "cs": "hlasitě a táhle plakat nebo naříkat, zejména kvůli bolesti, zármutku či smutku"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выть",
                                "target_lang_sense_clarification": "издавать протяжные звуки от горя или боли"
                            },
                            {
                                "target_lang_word": "вопить",
                                "target_lang_sense_clarification": "громко и неистово кричать"
                            },
                            {
                                "target_lang_word": "голосить",
                                "target_lang_sense_clarification": "громко плакать, причитать"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "naříkat",
                                "target_lang_sense_clarification": "hlasitě truchlit nebo plakat"
                            },
                            {
                                "target_lang_word": "kvílet",
                                "target_lang_sense_clarification": "vydávat táhlé, usedavé zvuky"
                            },
                            {
                                "target_lang_word": "bulelet",
                                "target_lang_sense_clarification": "hlasitě a usedavě plakat (často o dětech)"
                            },
                            {
                                "target_lang_word": "úpět",
                                "target_lang_sense_clarification": "naříkat v bolesti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ed70fe8-c3a1-3b83-8b66-fb6341a67077",
                    "sense_definition": "to make a long, high-pitched sound similar to a cry of mourning",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind <w>wailed</w> through the narrow cracks of the old wooden cabin all night long.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>завывал</w> в узких щелях старой деревянной хижины всю ночь напролет.",
                                "cs": "Vítr úzkými škvírami staré dřevěné chaty <w>zavýval</w> celou noc."
                            }
                        },
                        {
                            "text": "We could hear the police sirens <w>wail</w> in the distance as they rushed toward the city center.",
                            "target_lang_translations": {
                                "ru": "Мы слышали, как вдалеке <w>воют</w> полицейские сирены, спешащие к центру города.",
                                "cs": "Slyšeli jsme, jak v dálce <w>houkají</w> policejní sirény, spěchající k centru města."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wind wailed",
                        "sirens wail"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать долгий, высокий звук, напоминающий плач или завывание",
                        "cs": "vydávat dlouhý, vysoký táhlý zvuk připomínající nářek či kvílení"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завывать",
                                "target_lang_sense_clarification": "о ветре или сирене"
                            },
                            {
                                "target_lang_word": "выть",
                                "target_lang_sense_clarification": "издавать протяжные звуки (о ветре, инструментах)"
                            },
                            {
                                "target_lang_word": "стенать",
                                "target_lang_sense_clarification": "издавать заунывные звуки (о сирене)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "výt",
                                "target_lang_sense_clarification": "o větru nebo siréně"
                            },
                            {
                                "target_lang_word": "kvílet",
                                "target_lang_sense_clarification": "pronikavě znít (o větru apod.)"
                            },
                            {
                                "target_lang_word": "zavývat",
                                "target_lang_sense_clarification": "vydávat táhlý zvuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a302c16-0f6e-3748-99c9-55e7a12fa4c3",
                    "sense_definition": "to lament or grieve over something specific",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vocal expression of grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is useless to <w>wail</w> your misfortunes when you could be working to improve your situation.",
                            "target_lang_translations": {
                                "ru": "Бесполезно <w>оплакивать</w> свои несчастья, когда можно работать над улучшением ситуации.",
                                "cs": "Je k ničemu <w>oplakávat</w> svá neštěstí, když místo toho můžete pracovat na zlepšení své situace."
                            }
                        },
                        {
                            "text": "The poet began to <w>wail</w> the loss of his youth in a series of melancholy verses.",
                            "target_lang_translations": {
                                "ru": "Поэт начал <w>оплакивать</w> утрату своей юности в серии меланхоличных стихов.",
                                "cs": "Básník začal v řadě melancholických veršů <w>oplakávat</w> ztrátu svého mládí."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewail",
                        "bemoan",
                        "deplore",
                        "mourn"
                    ],
                    "antonyms": [
                        "celebrate"
                    ],
                    "common_phrases": [
                        "wail one's fate",
                        "wail their woes"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or older contexts when used transitively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "оплакивать что-либо или сокрушаться по какому-либо поводу",
                        "cs": "oplakávat, žalostně naříkat nad něčím konkrétním"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплакивать",
                                "target_lang_sense_clarification": "выражать скорбь по поводу утраты"
                            },
                            {
                                "target_lang_word": "причитать",
                                "target_lang_sense_clarification": "жалобно жаловаться на судьбу"
                            },
                            {
                                "target_lang_word": "стенать",
                                "target_lang_sense_clarification": "тяжело страдать и жаловаться"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "oplakávat",
                                "target_lang_sense_clarification": "truchlit nad ztrátou"
                            },
                            {
                                "target_lang_word": "naříkat",
                                "target_lang_sense_clarification": "stěžovat si a bědovat nad něčím"
                            },
                            {
                                "target_lang_word": "bědovat",
                                "target_lang_sense_clarification": "lamentovat nad osudem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d942d50-299c-3fff-bd1a-47072d3f071a",
                    "sense_definition": "to perform music or an activity with great intensity, skill, and energy",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saxophone player started to <w>wail</w> during his solo, impressing everyone in the jazz club.",
                            "target_lang_translations": {
                                "ru": "Саксофонист начал по-настоящему <w>зажигать</w> во время своего соло, впечатлив всех в джаз-клубе.",
                                "cs": "Saxofonista to během svého sóla začal neuvěřitelně <w>válet</w> a ohromil všechny v jazzovém klubu."
                            }
                        },
                        {
                            "text": "The band was really <w>wailing</w> as the crowd danced enthusiastically to the fast tempo.",
                            "target_lang_translations": {
                                "ru": "Группа действительно <w>наяривала</w>, пока толпа с энтузиазмом танцевала под быстрый темп.",
                                "cs": "Kapela to vážně <w>solila</w>, zatímco dav nadšeně tancoval v rychlém tempu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "really wailing"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "primarily used in jazz and surfing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "исполнять музыку или заниматься какой-либо деятельностью с большой страстью, энергией и мастерством",
                        "cs": "hrát hudbu nebo provádět činnost s obrovským nasazením, energií a dovedností"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зажигать",
                                "target_lang_sense_clarification": "играть или выступать очень энергично"
                            },
                            {
                                "target_lang_word": "шпарить",
                                "target_lang_sense_clarification": "быстро и мастерски исполнять"
                            },
                            {
                                "target_lang_word": "наяривать",
                                "target_lang_sense_clarification": "увлеченно и громко играть на инструменте"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "válet",
                                "target_lang_sense_clarification": "hrát skvěle a energicky"
                            },
                            {
                                "target_lang_word": "solit",
                                "target_lang_sense_clarification": "hrát na plný plyn"
                            },
                            {
                                "target_lang_word": "rozjet to",
                                "target_lang_sense_clarification": "začít energicky a naplno hrát"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c334dcb9-03ed-36ee-ab18-65815db966da",
                    "sense_definition": "a dialectal form of <w>wale</w>; to choose or select",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant <w>wailed</w> the best fabrics from the shipment to show to his most important customers.",
                            "target_lang_translations": {
                                "ru": "Купец <w>отобрал</w> лучшие ткани из партии, чтобы показать их своим самым важным клиентам.",
                                "cs": "Kupec ze zásilky <w>vybral</w> ty nejlepší látky, aby je ukázal svým nejvýznamnějším zákazníkům."
                            }
                        },
                        {
                            "text": "They <w>wailed</w> wine and metes for the feast to ensure only the finest quality was served.",
                            "target_lang_translations": {
                                "ru": "Они <w>выбрали</w> вино и яства для пира, чтобы на стол подавали только самое лучшее.",
                                "cs": "Na hostinu <w>vybrali</w> víno a pokrmy, aby zajistili, že se bude podávat jen to nejvybranější."
                            }
                        }
                    ],
                    "synonyms": [
                        "wale"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "specifically Scots or Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "диалектная форма слова wale; выбирать или отбирать",
                        "cs": "nářeční tvar slova wale; vybrat nebo zvolit"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбирать",
                                "target_lang_sense_clarification": "отбирать лучшее"
                            },
                            {
                                "target_lang_word": "отбирать",
                                "target_lang_sense_clarification": "производить отбор"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vybírat",
                                "target_lang_sense_clarification": "provádět výběr"
                            },
                            {
                                "target_lang_word": "zvolit",
                                "target_lang_sense_clarification": "vybrat si z možností"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4295b66-6c47-3da2-b859-f8113b093a4a",
                    "sense_definition": "a long, high-pitched cry of pain, grief, or anger",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>wail</w> of anguish broke the silence of the hospital corridor late at night.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>вопль</w> муки нарушил тишину больничного коридора поздно ночью.",
                                "cs": "Náhlý <w>nářek</w> úzkosti prořízl ticho nemocniční chodby pozdě v noci."
                            }
                        },
                        {
                            "text": "She let out a loud <w>wail</w> when she realized that her favorite vase had been shattered.",
                            "target_lang_translations": {
                                "ru": "Она издала громкий <w>плач</w>, когда поняла, что её любимая ваза разбилась.",
                                "cs": "Vydala hlasitý <w>výkřik zoufalství</w>, když si uvědomila, že se její oblíbená váza roztříštila."
                            }
                        }
                    ],
                    "synonyms": [
                        "cry",
                        "howl"
                    ],
                    "antonyms": [
                        "laugh"
                    ],
                    "common_phrases": [
                        "loud wail",
                        "wail of anguish"
                    ],
                    "target_lang_definitions": {
                        "ru": "протяжный, высокий крик боли, горя или гнева",
                        "cs": "dlouhý, pronikavý výkřik bolesti, žalu nebo hněvu"
                    },
                    "translations": {
