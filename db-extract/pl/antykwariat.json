                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "46bdf128-eef9-49b1-be34-240ae04ba6d7",
                        "source_entry_id": "baf1a3a9-4138-3f47-9549-d38a662907de",
                        "source_sense_id": "646563c2-335e-3907-b887-dfdc1c9f2068",
                        "target_lang_word": "Antiquariat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiquariat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1565aae5-4d6e-3ad9-b470-1ab4407ba1b2",
                                        "entry_id": "7d6176ec-0967-3af7-8d75-2df5acfe2363",
                                        "glosses": [
                                            "ein Geschäft, das sich auf den Handel mit alten und gebrauchten Büchern spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa9612f-dc12-4910-a2f0-60a5edaf06a8",
                                                "sense_id": "1565aae5-4d6e-3ad9-b470-1ab4407ba1b2",
                                                "text": "Bei uns im Viertel ist ein Antiquariat, das sich auf wissenschaftliche Bücher konzentriert hat."
                                            },
                                            {
                                                "example_id": "bf6747dc-4629-4146-9882-10817df22422",
                                                "sense_id": "1565aae5-4d6e-3ad9-b470-1ab4407ba1b2",
                                                "text": "„Im übrigen versuchte er, seine alten Gänge durch die noch unverbauten Teile der Südstadt wieder aufzunehmen und in Antiquariaten nach interessanten Büchern zu suchen.“"
                                            },
                                            {
                                                "example_id": "58a121c3-4f21-492d-87ef-ad4e0c8d5b97",
                                                "sense_id": "1565aae5-4d6e-3ad9-b470-1ab4407ba1b2",
                                                "text": "„Es entspann sich ein schönes Gespräch über alte Handschriften, in dessen Verlauf etliche Faksimiles bedeutender Werke aus verborgenen Winkeln des Antiquariats zutage gefördert und hereinkommende Kunden recht unwirsch abgefertigt wurden.“"
                                            },
                                            {
                                                "example_id": "22c35a23-27d1-4b16-a0ae-fb28d9b45255",
                                                "sense_id": "1565aae5-4d6e-3ad9-b470-1ab4407ba1b2",
                                                "text": "„Unter den Beileidsschreiben zum Ableben seiner Frau fanden sich auch zwei Briefe von Antiquariaten, die dringend um das Begleichen offenstehender Bücherrechnungen anhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae3a411f-ef13-3e3a-a700-7557fa2229db",
                                        "entry_id": "7d6176ec-0967-3af7-8d75-2df5acfe2363",
                                        "glosses": [
                                            "der Handel mit alten Büchern"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20d15e2-9ac7-4912-a849-46890aa6afc9",
                                                "sense_id": "ae3a411f-ef13-3e3a-a700-7557fa2229db",
                                                "text": "Dieses Buch ist nur noch im Antiquariat zu finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
