    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd105478-2783-35c1-b277-bc1d2754306b",
                    "sense_definition": "Having an incorrect belief or opinion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you think I will agree to those terms, you are sadly <w>mistaken</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы думаете, что я соглашусь на эти условия, вы глубоко <w>ошибаетесь</w>.",
                                "zh": "如果你以为我会同意那些条款，那你可就大错特<w>错</w>了。"
                            }
                        },
                        {
                            "text": "He admitted he was <w>mistaken</w> about the final budget numbers.",
                            "target_lang_translations": {
                                "ru": "Он признал, что <w>ошибался</w> насчет окончательных цифр бюджета.",
                                "zh": "他承认自己在最终预算数字上<w>搞错</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wrong",
                        "incorrect"
                    ],
                    "antonyms": [
                        "correct",
                        "right"
                    ],
                    "common_phrases": [
                        "be mistaken",
                        "sadly mistaken",
                        "very much mistaken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий неверное мнение или убеждение.",
                        "zh": "指人持有错误的观点或看法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправый",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "заблуждающийся",
                                "target_lang_sense_clarification": "имеющий ложное представление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞错",
                                "target_lang_sense_clarification": "指人对某事有错误的认识"
                            },
                            {
                                "target_lang_word": "弄错",
                                "target_lang_sense_clarification": "指人对某事有错误的认识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f637eef-ab4b-34c0-97b5-d80db487a78d",
                    "sense_definition": "Incorrect or based on an error.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the innocent man due to a case of <w>mistaken</w> identity.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала невиновного человека из-за <w>ошибочного</w> опознания.",
                                "zh": "警方因为<w>误认</w>身份逮捕了那个无辜的人。"
                            }
                        },
                        {
                            "text": "She acted under the <w>mistaken</w> belief that she was the only heir.",
                            "target_lang_translations": {
                                "ru": "Она действовала, исходя из <w>ошибочного</w> убеждения, что она единственная наследница.",
                                "zh": "她是在<w>错误</w>地以为自己是唯一继承人的情况下采取行动的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "erroneous",
                        "false",
                        "wrong",
                        "inaccurate"
                    ],
                    "antonyms": [
                        "correct",
                        "accurate",
                        "valid"
                    ],
                    "common_phrases": [
                        "mistaken identity",
                        "mistaken belief",
                        "mistaken impression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неверный или основанный на ошибке.",
                        "zh": "指事物本身不正确，或基于错误的前提。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибочный",
                                "target_lang_sense_clarification": "содержащий ошибку"
                            },
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "не соответствующий истине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错误的",
                                "target_lang_sense_clarification": "指内容或判断不符合事实"
                            },
                            {
                                "target_lang_word": "误导的",
                                "target_lang_sense_clarification": "指基于错误信息而产生的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3560ee01-8596-3f5a-adc0-4933590a2c48",
                    "sense_definition": "Past participle of <w>mistake</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am frequently <w>mistaken</w> for my twin brother by strangers.",
                            "target_lang_translations": {
                                "ru": "Незнакомцы часто <w>принимают</w> меня за моего брата-близнеца.",
                                "zh": "陌生人经常把我<w>误认</w>成我的双胞胎哥哥。"
                            }
                        },
                        {
                            "text": "He has <w>mistaken</w> my silence for agreement.",
                            "target_lang_translations": {
                                "ru": "Он <w>принял</w> мое молчание за согласие.",
                                "zh": "他把我的沉默<w>误以为</w>是同意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mistaken for"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола mistake.",
                        "zh": "动词 mistake 的过去分词，指将某人或某物误认为是其他对象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принятый (за)",
                                "target_lang_sense_clarification": "ошибочно посчитанный кем-то другим"
                            },
                            {
                                "target_lang_word": "неправильно понятый",
                                "target_lang_sense_clarification": "истолкованный неверно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误认",
                                "target_lang_sense_clarification": "将某人或某物错当成另一个"
                            },
                            {
                                "target_lang_word": "误以为",
                                "target_lang_sense_clarification": "错误地认为某事是某种情况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
