            {
                "entry_id": "825ddb0f-39b9-3dbd-ab8f-c8ba39bb88b6",
                "word": "ramille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e89a7b5-efe4-4bef-bbe4-56fe25729929",
                        "entry_id": "825ddb0f-39b9-3dbd-ab8f-c8ba39bb88b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "ramilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb51c24e-a6c3-3add-afd0-272f273d8b17",
                        "entry_id": "825ddb0f-39b9-3dbd-ab8f-c8ba39bb88b6",
                        "glosses": [
                            "Ensemble des petites branches d’un arbre."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "46b731ff-b8d9-462b-8c69-846a005906b9",
                                "sense_id": "fb51c24e-a6c3-3add-afd0-272f273d8b17",
                                "text": "La ramille d’un buisson touffu."
                            },
                            {
                                "example_id": "d30739bd-9ff0-42b4-ab52-d1707e988789",
                                "sense_id": "fb51c24e-a6c3-3add-afd0-272f273d8b17",
                                "text": "je suis cette ramille qui frémit\nau bout du vide\ntrace un invisible chemin\nvers l’horizon\nchaque souffle\nme dépouille d’un feuillage\nme laisse vacante\ncomme la lumière qui va\nelle aussi vers le soir"
                            }
                        ]
                    },
                    {
                        "sense_id": "b2d37126-f83a-3ef4-8d7a-01c1c3f78ba0",
                        "entry_id": "825ddb0f-39b9-3dbd-ab8f-c8ba39bb88b6",
                        "glosses": [
                            "Ramification du rameau, petite branche, brindille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7aecfe2-6a26-482d-858f-4e7973e77991",
                                "sense_id": "b2d37126-f83a-3ef4-8d7a-01c1c3f78ba0",
                                "text": "Beaucoup de plantes et d’arbres inconnus dont pourtant j’aurais voulu savoir le nom. De chacun d’eux je cueille une ramille pour me les faire nommer, au déjeuner."
                            },
                            {
                                "example_id": "c328a7fd-8cc7-4108-9f8b-7c6c9d39af5d",
                                "sense_id": "b2d37126-f83a-3ef4-8d7a-01c1c3f78ba0",
                                "text": "Malgré les soleillées qui précisaient les dessins délicats des ramilles s’enchevêtrant, la forêt de la Côte, dominant le village, restait maussade et grise."
                            },
                            {
                                "example_id": "c494545d-0e74-4210-993d-3c893ceeb421",
                                "sense_id": "b2d37126-f83a-3ef4-8d7a-01c1c3f78ba0",
                                "text": "La poche droite contient des ramilles de ce calcaire rosâtre que ses parents nomment, Dieu sait pourquoi, lithotamnium, quand il est si simple de l’appeler corail. « Mais ce n’est pas du corail, Bel-Gazou. » Pas du corail ? Et qu’en savent-ils, ces malheureux ?"
                            },
                            {
                                "example_id": "f70d72dc-b80c-429d-873f-81ddfb4abfd9",
                                "sense_id": "b2d37126-f83a-3ef4-8d7a-01c1c3f78ba0",
                                "text": "Je sentis sous ma paume, à travers le tapis de ramilles de pin, quelque chose de dur qui n’était pas une pierre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3acc490-9f97-4b35-a14b-485ba0cc4714",
                        "source_entry_id": "825ddb0f-39b9-3dbd-ab8f-c8ba39bb88b6",
                        "source_sense_description": "petit rameau",
                        "target_lang_word": "Reis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3781ad-f3a4-34b4-9cbf-d73d77f80825",
                                        "entry_id": "9c8a7e65-2e64-32ff-bbbc-8a846cf3e274",
                                        "glosses": [
                                            "weißes, gekocht gegessenes Getreide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f4c873-2193-4c50-a12f-954b389c2771",
                                                "sense_id": "7a3781ad-f3a4-34b4-9cbf-d73d77f80825",
                                                "text": "Soll ich lieber polierten Reis oder Naturreis nehmen?"
                                            },
                                            {
                                                "example_id": "174ca3ce-936b-49eb-b2a4-97de9f3e2420",
                                                "sense_id": "7a3781ad-f3a4-34b4-9cbf-d73d77f80825",
                                                "text": "Wünschen Sie als Beilage Reis oder Kartoffeln?"
                                            },
                                            {
                                                "example_id": "989380c5-ad23-41bf-ab44-018efdbaf5cf",
                                                "sense_id": "7a3781ad-f3a4-34b4-9cbf-d73d77f80825",
                                                "text": "Reis schmeckt mir am besten mit Soja-Sauce."
                                            },
                                            {
                                                "example_id": "5f1b5c55-50b5-40ad-abbb-1405b9b6bce1",
                                                "sense_id": "7a3781ad-f3a4-34b4-9cbf-d73d77f80825",
                                                "text": "„Ich wünsche mir eine warme Kugel Reis im Bauch, löffle besonders viel in mich hinein, während sich meine Mutter und Ramin über Politik unterhalten.“"
                                            },
                                            {
                                                "example_id": "e96b1ce1-a102-4482-bfa9-163b9a3ee2bf",
                                                "sense_id": "7a3781ad-f3a4-34b4-9cbf-d73d77f80825",
                                                "text": "„Heinz lud mich zum Abendessen ein, zu Reis und Fioliwurst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e89a39cc-c42c-3054-a97f-30ed91c28fb8",
                                        "entry_id": "9c8a7e65-2e64-32ff-bbbc-8a846cf3e274",
                                        "glosses": [
                                            "Pflanze, an der das gleichnamige Getreide wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa52327-a77a-46cf-a9cb-dcda0773241f",
                                                "sense_id": "e89a39cc-c42c-3054-a97f-30ed91c28fb8",
                                                "text": "Hier wird seit Jahrhunderten Reis angebaut."
                                            },
                                            {
                                                "example_id": "899ed1c1-b125-4cc8-ab3f-4879c8584b5e",
                                                "sense_id": "e89a39cc-c42c-3054-a97f-30ed91c28fb8",
                                                "text": "„Reis und Getreide füllten seine Speicher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Reis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e742ab6a-eb07-353b-9adb-7933759ba86d",
                                        "entry_id": "ebf9d992-54f5-3379-b8bf-547ad34d8875",
                                        "glosses": [
                                            "junger, leicht beweglicher Zweig eines Baumes oder Strauchs"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9e860e-ded9-4a96-873c-51b62a0c4469",
                                                "sense_id": "e742ab6a-eb07-353b-9adb-7933759ba86d",
                                                "text": "Am Barbaratag werden Reiser von den Obstbäumen geschnitten."
                                            },
                                            {
                                                "example_id": "59cf8445-5170-473a-86ad-39326c740b96",
                                                "sense_id": "e742ab6a-eb07-353b-9adb-7933759ba86d",
                                                "text": "„Schnell, zünde ein Bündel Reiser an und gib uns irgend etwas, um dazu eine Flasche Champagner zu trinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
