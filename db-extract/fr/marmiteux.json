                ],
                "senses": [
                    {
                        "sense_id": "dd8cee03-7fba-34e3-8591-c89251395bb5",
                        "entry_id": "b0bf9c9e-7152-3735-988c-17e016b9bd0b",
                        "glosses": [
                            "Personne misérable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92f1a906-f6e3-4502-83d6-fbf0e0463454",
                                "sense_id": "dd8cee03-7fba-34e3-8591-c89251395bb5",
                                "text": "— Ils se terrent, les marmiteux ! Feste-Dieu, je m’en vais leur mordre les fesses !"
                            },
                            {
                                "example_id": "f9a34ae5-87cf-47f4-831f-7e60245ced80",
                                "sense_id": "dd8cee03-7fba-34e3-8591-c89251395bb5",
                                "text": "Un pauvre marmiteux."
                            },
                            {
                                "example_id": "665aefbd-0909-4c65-a5a0-1814433e3476",
                                "sense_id": "dd8cee03-7fba-34e3-8591-c89251395bb5",
                                "text": "Un marmiteux, au sens le plus généralement admis, est un homme dont l’infortune et la maladie sont telles qu’il en est misérable et qu’à bon droit il s’en plaint."
                            }
                        ]
                    }
