                ],
                "senses": [
                    {
                        "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                        "entry_id": "e3c211d3-34d4-38a0-8d72-3ba76cec19bd",
                        "glosses": [
                            "Any of the many small insects of the order Thysanoptera, especially those that attack useful plants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ff2e9e6-0278-410d-a967-1b2585dc4f53",
                                "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                "text": "The turnrows and margins of the fields should be cultivated often enough to prevent the growth of weeds, many forms of which harbor the onion thrips."
                            },
                            {
                                "example_id": "778032c5-ee30-48ed-b621-2b314cc3733e",
                                "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                "text": "2002, Thrips, article in International Wildlife Encyclopedia Volume 19, Picture caption, page 2676,\nThe thousands of thrips species include among their number the smallest of all winged insects."
                            },
                            {
                                "example_id": "f1d28e8e-9b6b-46e0-9c33-7e300154294e",
                                "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                "text": "Bleaching and stippling on viburnum foliage infested with greenhouse thrips. Because this sluggish thrips feeds openly on the underside of leaves, it is controlled by thorough coverage with insecticidal soap or oil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7ef14bb-ac1e-4c7e-b5b5-5b82538a8044",
                        "source_entry_id": "e3c211d3-34d4-38a0-8d72-3ba76cec19bd",
                        "source_sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                        "source_sense_description": "insect of the order Thysanoptera",
                        "target_lang_word": "thrips",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrips",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab60470c-fb06-36da-9c56-01564647989f",
                                        "entry_id": "ca89c0f2-58b7-3b5e-8e38-934e0f3db6cb",
                                        "glosses": [
                                            "Insecte piqueur-suceur, de l’ordre des Thysanoptères (Thysanoptera), ptérygotes hétérométaboles de taille minuscule, au corps allongé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c9d1f3-a390-472f-a265-fc6db7023f5f",
                                                "sense_id": "ab60470c-fb06-36da-9c56-01564647989f",
                                                "text": "Pourtant, ces insectes pourraient remplir ce rôle pollinisateur de longue date puisque des thrips portant des grains de pollen (de Cycadales ou Ginkgoales) ont été observés dans de l’ambre provenant d’Espagne et datée du début du Crétacé."
                                            },
                                            {
                                                "example_id": "3ce48926-5876-416e-9764-d0ef92f086ae",
                                                "sense_id": "ab60470c-fb06-36da-9c56-01564647989f",
                                                "text": "Des fleurs de plus en plus rares chaque année, les pommes attaquées par les thrips et dévorées par les vers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "066776a3-fc78-4e7c-91fe-cb098d967a0e",
                        "source_entry_id": "e3c211d3-34d4-38a0-8d72-3ba76cec19bd",
                        "source_sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                        "source_sense_description": "insect of the order Thysanoptera",
                        "target_lang_word": "thrip",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrip",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b27e106-8be8-33f5-ae36-4b155b5f85bc",
                                        "entry_id": "2d3d9c06-3978-3cc9-8680-6908a65918a2",
                                        "glosses": [
                                            "Variante de thrips."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4320ef7d-9188-4ea7-8096-fe0bcaeaa0fa",
                                                "sense_id": "5b27e106-8be8-33f5-ae36-4b155b5f85bc",
                                                "text": "Il existe différentes espèces de thrips (des céréales, du riz, du blé, du lin, etc)."
                                            },
                                            {
                                                "example_id": "6b653739-0efe-4c36-8ef3-4b45229149c2",
                                                "sense_id": "5b27e106-8be8-33f5-ae36-4b155b5f85bc",
                                                "text": "Je n’espérais guère pouvoir reconnaître celui que les thrips, les abeilles, les bourdons, les papillons porteraient sur eux, et savoir si c’était celui qui pouvait féconder la fleur où ils allaient s’arrêter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
