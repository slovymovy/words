                ],
                "senses": [
                    {
                        "sense_id": "95f96843-a275-3761-b516-1e06ec1f221f",
                        "entry_id": "8501a57f-1aca-31e9-ba34-eeac17ae524c",
                        "glosses": [
                            "so, dass es aufgehalten werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "498330ff-3e27-46df-af90-db4bf6952fa0",
                                "sense_id": "95f96843-a275-3761-b516-1e06ec1f221f",
                                "text": "Diese Entwicklung könnte noch aufhaltbar sein."
                            },
                            {
                                "example_id": "2e719311-db29-4664-a3ba-5504a4aaeee6",
                                "sense_id": "95f96843-a275-3761-b516-1e06ec1f221f",
                                "text": "„Die europäische Linke sei falsch mit der Finanzkrise umgegangen, sagt der britische Labour-Chef in einem Interview. Den Brexit hält er für nicht mehr aufhaltbar.“"
                            },
                            {
                                "example_id": "211899e4-82ac-4f6d-823f-1b0f78214834",
                                "sense_id": "95f96843-a275-3761-b516-1e06ec1f221f",
                                "text": "„Denn sie zeigt einen Verlauf, der aufhaltbar gewesen wäre, hätte man rechtzeitig reagiert.“"
                            },
                            {
                                "example_id": "04627ba0-d9fc-416b-8c69-a59e2accd9b3",
                                "sense_id": "95f96843-a275-3761-b516-1e06ec1f221f",
                                "text": "„Sein Aufstieg ist also aufhaltbar, wenngleich nur mit erheblicher Mobilisierung der Wähler und ihres demokratischen Bewußtseins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
