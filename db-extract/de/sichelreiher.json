                "senses": [
                    {
                        "sense_id": "1a0e2901-6414-37c8-a9c1-dafb0f14d279",
                        "entry_id": "ea121a5e-1e6f-314b-b71f-8c1c03f4f934",
                        "glosses": [
                            "europäischer Ibis, ein bis zu 60 cm langer, brauner Storchvogel mit sichelförmigem Schnabel"
                        ],
                        "tags": [
                            "Trivialname"
                        ],
                        "examples": [
                            {
                                "example_id": "d52cf03f-351f-4339-928b-6dfd98e59b9e",
                                "sense_id": "1a0e2901-6414-37c8-a9c1-dafb0f14d279",
                                "text": "Außerdem gibt er als einziger an anderer Stelle noch den Namen \"Sichelreiher\" (Kamasagi) an, der dem Japanibis aufgrund seines gebogenen Schnabels gegeben worden sei."
                            },
                            {
                                "example_id": "adc38bf6-eaaa-4e35-85fc-43b17026bf10",
                                "sense_id": "1a0e2901-6414-37c8-a9c1-dafb0f14d279",
                                "text": "Erheblich seltener scheint zu uns ein Verwandter des heiligen Ibis der Aegypter, der braune Ibis oder Sichelreiher, Falcinellus igneus Gray, zu kommen, der im südöstlichen Europa, in den Donautiefländern, Südrußland, sowie in Nordafrika und im südwestlichen Asien heimisch ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
