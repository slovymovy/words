                                        "examples": [
                                            {
                                                "example_id": "d7d4d377-0a0a-4c8b-bf51-2691bdbf4305",
                                                "sense_id": "4f9436a9-01a3-3004-942b-01eb69eeb622",
                                                "text": "La canitie désigne le blanchissement des poils et des cheveux qui survient au cours de l’existence, dont la forme universelle est le grisonnement puis le blanchissement de la chevelure avec l’âge."
                                            },
                                            {
                                                "example_id": "fda1b3ef-fb33-4f2a-87fe-5e6728814eaa",
                                                "sense_id": "4f9436a9-01a3-3004-942b-01eb69eeb622",
                                                "text": "Le blanchissement corallien est le phénomène produisant la mort du corail due à l’expulsion des zooxanthelles symbiotiques s’abritant dans les coraux ; produisant ainsi une décoloration de l’animal, et, à cause de l’insuffisance en apports nutritifs, la mort de ce dernier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382c5863-13fe-3818-adde-2f868a21f81a",
                                        "entry_id": "c897f713-213e-3183-be13-673b9c621b0f",
                                        "glosses": [
                                            "Action de maquiller les défauts des esclaves pour les rendre plus présentables à la vente."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73cf6faa-c296-43b6-9660-c8ec9ab2304a",
                                                "sense_id": "382c5863-13fe-3818-adde-2f868a21f81a",
                                                "text": "Il s’agit avant tout de rendre la \"marchandise\" présentable. Les cheveux sont coupés, le corps est enduit d’huile de palme, le goudron noircit les plaies purulentes. Ces opérations s’appellent le \"blanchissement\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "629a9a75-b283-46f2-bc38-d8e21cf2f1fd",
                        "source_entry_id": "693bcf76-97ad-39ed-849c-13b9dc7c5119",
                        "source_sense_id": "4869a7b8-3e05-3367-bf92-cf5ed71746f5",
                        "target_lang_word": "carte blanche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carte blanche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "835ef281-fa47-3234-b6aa-aef63bf2f7a8",
                                        "entry_id": "db76a92e-ef44-3425-926c-cb6bc195c231",
                                        "glosses": [
                                            "Pouvoir illimité d’agir à sa guise, plein pouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4de13b-2ec5-4b41-a145-d5a695f81cb7",
                                                "sense_id": "835ef281-fa47-3234-b6aa-aef63bf2f7a8",
                                                "text": "[…], mais il ne put pas s'empêcher non plus de lui en savoir gré, et il s'affermit dans la résolution qu'il venait de prendre de lui laisser carte blanche."
                                            },
                                            {
                                                "example_id": "b319c641-e955-48a1-b5d2-cf57717d0aa8",
                                                "sense_id": "835ef281-fa47-3234-b6aa-aef63bf2f7a8",
                                                "text": "Les auteurs du génocide attendaient désormais que les Français viennent les sauver et pensaient avoir carte blanche pour achever leur macabre besogne."
                                            },
                                            {
                                                "example_id": "3173b9f1-f791-4935-b70a-ca88665fa471",
                                                "sense_id": "835ef281-fa47-3234-b6aa-aef63bf2f7a8",
                                                "text": "Le gouvernement a donné carte blanche à ce général."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3107133f-eda8-4920-bfed-c329d33f527e",
                        "source_entry_id": "693bcf76-97ad-39ed-849c-13b9dc7c5119",
                        "source_sense_id": "4869a7b8-3e05-3367-bf92-cf5ed71746f5",
                        "target_lang_word": "document",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "document",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82b149df-e333-3e53-accb-37a7d25c0649",
                                        "entry_id": "3f556f46-302e-32bb-aa88-e70d2c8c7965",
                                        "glosses": [
                                            "Écrit qui sert de preuve ou de renseignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b801df4-d4e3-45b6-aab2-5852a95273d4",
                                                "sense_id": "82b149df-e333-3e53-accb-37a7d25c0649",
                                                "text": "Tout ce qui existe de documents, sa piété fureteuse, sa curiosité passionnée l'ont rassemblé."
                                            },
                                            {
                                                "example_id": "61b83be7-68c9-465a-a67f-b617946d8474",
                                                "sense_id": "82b149df-e333-3e53-accb-37a7d25c0649",
                                                "text": "L’historien ne recueille que des choses mortes. […].\nEn fait la réalité importe peu à l’historien, ce qu'il veut c'est des documents."
                                            },
                                            {
                                                "example_id": "0ac196bc-c371-4ccf-b3db-593c024095e0",
                                                "sense_id": "82b149df-e333-3e53-accb-37a7d25c0649",
                                                "text": "D’ailleurs, ne lui avait-il pas posé une sorte d’ultimatum en ordonnant qu’elle lui procurât les documents détenus par Brunof dans un délai d’une semaine ?…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "513d9367-abb2-30cd-8ed1-649dea79ffea",
                                        "entry_id": "3f556f46-302e-32bb-aa88-e70d2c8c7965",
                                        "glosses": [
                                            "Source de renseignement ou de preuve, quel que soit le support matériel (film, photographie, disquette, etc.)"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ed051d-7d4c-4353-a472-c381f47e0f17",
                                                "sense_id": "513d9367-abb2-30cd-8ed1-649dea79ffea",
                                                "text": "Malheureusement nous avons rarement des éléments suffisants pour reconstituer cette histoire avec vraisemblance. Les documents fossiles tertiaires sont assez rares […]."
                                            },
                                            {
                                                "example_id": "c3fc8f87-202e-4513-8fde-4f7ab7281b78",
                                                "sense_id": "513d9367-abb2-30cd-8ed1-649dea79ffea",
                                                "text": "Aujourd’hui, tout, ou presque, est document archéologique, archive : les objets de tous types, les ossements, les arêtes des poissons, les pépins de pomme, les épis de blé, le torchis des murs, les planches des ponts, etc."
                                            },
                                            {
                                                "example_id": "bc7a4622-6f7f-405c-9992-6faeb15b8029",
                                                "sense_id": "513d9367-abb2-30cd-8ed1-649dea79ffea",
                                                "text": "La vidéo de surveillance a été utilisée comme document."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab89a8e-3e15-3945-8520-d00b521b1408",
                                        "entry_id": "3f556f46-302e-32bb-aa88-e70d2c8c7965",
                                        "glosses": [
                                            "Pièce justificative qui permet d’identifier une marchandise ou une personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4724d5e7-c0a0-4a23-a68e-165c72ae8cfb",
                                                "sense_id": "cab89a8e-3e15-3945-8520-d00b521b1408",
                                                "text": "Il n’a pas ses documents sur lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1607ef20-0a66-38f6-a85d-2fb3d528dd51",
                                        "entry_id": "3f556f46-302e-32bb-aa88-e70d2c8c7965",
                                        "glosses": [
                                            "Fichier informatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff902cd1-2b70-46b7-904f-980e3c32c8ce",
                                                "sense_id": "1607ef20-0a66-38f6-a85d-2fb3d528dd51",
                                                "text": "Je ne retrouve plus mon document LibreOffice dans le répertoire !"
                                            },
                                            {
                                                "example_id": "f61955ee-84ab-458b-b331-2383edb2aee1",
                                                "sense_id": "1607ef20-0a66-38f6-a85d-2fb3d528dd51",
                                                "text": "Pourquoi se limiter à un fond blanc, comme un vulgaire document Word, quand le Web offre tant de possibilités ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0446030-2556-395a-bbe5-a159a165a258",
                                        "entry_id": "3f556f46-302e-32bb-aa88-e70d2c8c7965",
                                        "glosses": [
                                            "Réalisation définitive avant reproduction."
                                        ],
                                        "tags": [
                                            "Publicité"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
