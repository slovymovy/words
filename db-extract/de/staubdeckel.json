                "senses": [
                    {
                        "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                        "entry_id": "55524db4-6cb9-3cff-aebb-4714543ad041",
                        "glosses": [
                            "Abdeckung zum Schutz vor Staub/Verschmutzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25970d58-b3e1-4681-aec1-4c1a3f57bbfb",
                                "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                                "text": "„Er schob den Daumennagel unter den Staubdeckel der Buchse, fummelte ihn ab und legte ihn neben sich auf den Kunststoffsitz.“"
                            },
                            {
                                "example_id": "3376cf42-d809-493e-9c78-6ae02e8ca939",
                                "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                                "text": "„Finn Warne rollt das Kabel aus, klappt den Staubdeckel hoch und stöpselt sich ein.“"
                            },
                            {
                                "example_id": "0f644558-0694-4aad-8511-2fb01d3fe70c",
                                "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                                "text": "„Als er das oberste Buch des Stapels von seinem Staubdeckel befreite, entpuppte es sich als Gartenkatalog.“"
                            },
                            {
                                "example_id": "ddc70eed-0aed-4629-bad7-2b1007a84d30",
                                "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                                "text": "„Die bisher besprochenen Luftdruckhämmer haben alle den Zylinder oben offen oder nur durch einen Staubdeckel geschlossen.“"
                            },
                            {
                                "example_id": "6d4fb947-4248-4111-b4ac-ca94a4958b4c",
                                "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                                "text": "„Über der Kammer der Waffe hatte er ein großes Zielfernrohr montiert, dessen vordere Linse mit einem Staubdeckel verschlossen war.“"
                            },
                            {
                                "example_id": "3b7e102f-da76-4f32-9abe-ea53c907f6c1",
                                "sense_id": "4f9133dd-acdf-38da-a682-b5a35672c718",
                                "text": "„Die entwendete Taschenuhr ist eine silberne Anereuhr mit Staubdeckel, Kapsel, römischen Ziffern und Secundenscheibe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
