                "senses": [
                    {
                        "sense_id": "629ef2d9-01af-3fc0-8816-1b6bf24514d1",
                        "entry_id": "fe75e03a-27cd-399a-a1d8-5c97cc67d587",
                        "glosses": [
                            "dunne, magere benen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727e843e-79cd-4b03-b0bd-1cca52d10560",
                                "sense_id": "629ef2d9-01af-3fc0-8816-1b6bf24514d1",
                                "text": "In de duinen kwamen drie wandelaars ons tegemoet: een man met spierwitte spillebeentjes in een korte broek, een vrouw en een jongere vrouw. De man had een zware baard."
                            },
                            {
                                "example_id": "9fd331ab-fb92-43e3-adcc-dc6bf36e339a",
                                "sense_id": "629ef2d9-01af-3fc0-8816-1b6bf24514d1",
                                "text": "Steeds als Caroline hem met Max vergeleek, maakte ze dezelfde opmerking. 'Krijgt die jongen van jou wel genoeg te eten, wat een spillebeentjes, geen grammetje vet op de botten.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "b1c40a3c-f72b-336c-acb8-86f734b7fd15",
                        "entry_id": "fe75e03a-27cd-399a-a1d8-5c97cc67d587",
                        "glosses": [
                            "een persoon met dunne benen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d83a7c-b030-411f-b137-e3e597621a12",
                                "sense_id": "b1c40a3c-f72b-336c-acb8-86f734b7fd15",
                                "text": "Vier uur na de triomftocht van Ireen Wst verbleef een vertwijfeld Tsjechisch gezelschap nog steeds in het verlaten ijsstadion van Calgary. Schaatscoach Petr Novak zat aan de ene kant van de deur te treuren op een bankje. Aan de andere kant van de deur, in het kamertje van de dopingcontrole, bevond zich Martina Sablikova, de onttroonde wereldkampioene allround. De Tsjechische spillebeen kon maar geen plas produceren."
                            },
                            {
                                "example_id": "ae2fddcd-d867-4358-9652-878987c7078a",
                                "sense_id": "b1c40a3c-f72b-336c-acb8-86f734b7fd15",
                                "text": "Ik liep op 23 oktober in het bos.En daar zag ik een hele grote paddestoel.De steel was 14 centimeter en de hoed 25 centimeter.Maar hij was bruin en niet rood met witte stippenanders was het mischien wel de paddestoel van kabouter spillebeen"
                            }
                        ]
                    }
