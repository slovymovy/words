                                        "sense_id": "8a009068-f210-30bb-89c9-5d51329fc579",
                                        "entry_id": "d546c427-77ba-3af9-95e4-03a803b9de80",
                                        "glosses": [
                                            "The exact likeness (of someone); speaking image."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0365d96-0d26-446a-850e-288b7894c87d",
                                                "sense_id": "8a009068-f210-30bb-89c9-5d51329fc579",
                                                "text": "You're the spitting image of my brother."
                                            },
                                            {
                                                "example_id": "d208a8d0-32ac-4e37-8893-40d0cf1cab6a",
                                                "sense_id": "8a009068-f210-30bb-89c9-5d51329fc579",
                                                "text": "I swear my grandson is the spitting image of my Jeffrey when he was a baby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
