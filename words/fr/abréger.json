    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac71460a-e3f7-3da5-81fc-af68e609abb1",
                    "sense_definition": "Rendre plus court dans sa durée ou son étendue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie torrentielle nous a forcés à <w>abréger</w> notre promenade en forêt."
                        },
                        {
                            "text": "Le vétérinaire a pris la décision d'<w>abréger</w> les souffrances du pauvre animal."
                        }
                    ],
                    "synonyms": [
                        "écourter",
                        "raccourcir"
                    ],
                    "antonyms": [
                        "rallonger"
                    ],
                    "common_phrases": [
                        "abréger les souffrances",
                        "abréger une réunion"
                    ]
                },
                {
                    "sense_id": "05840840-c5ce-3fbf-ad0e-08ea41e6402e",
                    "sense_definition": "Écrire un mot sous une forme raccourcie et convenue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "langue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves apprennent à <w>abréger</w> certains termes pour prendre des notes plus vite."
                        },
                        {
                            "text": "On <w>abrège</w> généralement le mot boulevard sous la forme bd."
                        }
                    ],
                    "antonyms": [
                        "développer"
                    ],
                    "common_phrases": [
                        "abréger un mot"
                    ]
                },
                {
                    "sense_id": "c92c03de-80a2-3d0e-bc71-d1baf6a3643d",
                    "sense_definition": "Écourter son discours pour aller plus rapidement à l'essentiel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "langue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous manquons de temps, veuillez <w>abréger</w> votre présentation s'il vous plaît."
                        },
                        {
                            "text": "Pour <w>abréger</w>, disons simplement que le projet a été totalement annulé."
                        }
                    ],
                    "synonyms": [
                        "écourter"
                    ],
                    "antonyms": [
                        "développer"
                    ],
                    "common_phrases": [
                        "pour abréger",
                        "abréger son propos"
                    ]
                },
                {
                    "sense_id": "d9a6dc27-d818-3361-9191-db4256103067",
                    "sense_definition": "Faire paraître le temps ou une distance moins long.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une discussion passionnante permet souvent d'<w>abréger</w> un long voyage en train."
                        },
                        {
                            "text": "La musique agréable a contribué à <w>abréger</w> cette interminable attente chez le médecin."
                        }
                    ],
                    "synonyms": [
                        "raccourcir"
                    ],
                    "antonyms": [
                        "rallonger"
                    ],
                    "common_phrases": [
                        "abréger le trajet",
                        "abréger le temps"
                    ]
                }
            ]
        }
    ]
