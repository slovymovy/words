                ],
                "senses": [
                    {
                        "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                        "entry_id": "19b6edb7-044f-38d3-8084-1d333c266427",
                        "glosses": [
                            "aus Papier hergestellte Laterne mit einer Kerze im Inneren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0abea2c-44b4-471a-ae47-c5c072a71720",
                                "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                "text": "Die Kinder nahmen mit ihren Lampions am Umzug teil."
                            },
                            {
                                "example_id": "8ca85238-70e8-463e-b99e-987257e47da0",
                                "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                "text": "„Die Liegeterrasse und Teile des Parks waren mit Lampions und bunten Bändern geschmückt.“"
                            },
                            {
                                "example_id": "89e416f5-da81-48b1-8640-178b1f1e91d8",
                                "sense_id": "7f97824b-0569-3c66-b860-0141fb80ec4e",
                                "text": "„Allmählich dunkelte es; da ließ Simen Thing die Lampions im Oberstock anzünden, auch vor dem Hause an jeder Seite eine Pergament-Laterne, ein wundershöner Anblick.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
