                    {
                        "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                        "entry_id": "07118536-0883-36fb-a256-401b2c5b39ad",
                        "glosses": [
                            "whose, of which (in dialects that require a human antecedent for 'whose')"
                        ],
                        "tags": [
                            "Northern-Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "93e6716b-51da-4c0c-b5fa-39b1f88333b3",
                                "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                                "text": "He had in his pocket an old flick-knife that's spring was slow and temperamental."
                            },
                            {
                                "example_id": "faafcfa3-b94c-4098-8909-07ae01be7e0f",
                                "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                                "text": "\"[…] we want them to bring a product to market that's time had not yet come,\" said Ray Farhung, a Southern California Edison official."
                            },
                            {
                                "example_id": "6346bcdf-4c1f-4653-9e60-6db415ea432d",
                                "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                                "text": "1995, Aimo Seppänen & Göran Kjellmer. The dog that's leg was run over: On the genitive of the relative pronoun. English Studies 76, 389–400."
                            },
                            {
                                "example_id": "5c6a0861-532d-43cb-88d7-6fa9d6f0a784",
                                "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                                "text": "[…] the only one that's title has been released […]"
                            },
                            {
                                "example_id": "51cba3ab-6aa7-4b5d-9295-af8c84fd8ef0",
                                "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                                "text": "that's is perfectly possible in my Northern Irish English dialect, e.g. \"The cow that's calf was lost\" is fine; \"The cow whose calf was lost\" is not so good as my dialect seems to require human reference for who, […]"
                            },
                            {
                                "example_id": "d7f51c2d-f91e-4ba9-a7cc-347b2c9d6665",
                                "sense_id": "16f400b2-6918-3f89-ad8c-7f932d9d091d",
                                "text": "It had products like a WiFi light bulb that's brightness and even color can be controlled via Smartphone."
                            }
                        ]
                    }
