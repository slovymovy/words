        "fr-extract.jsonl": [
            {
                "entry_id": "3c4ef56f-ac01-32d7-bd1a-3bafddcbf065",
                "word": "outremer",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6cf229bf-c0b2-3949-8149-5797d9afde1f",
                        "entry_id": "3c4ef56f-ac01-32d7-bd1a-3bafddcbf065",
                        "glosses": [
                            "De la couleur bleu soutenu. #2B009A"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e130f553-b205-42ad-b2a3-cf20d411f7c4",
                                "sense_id": "6cf229bf-c0b2-3949-8149-5797d9afde1f",
                                "text": "Tout au fond, il y aurait un lit étroit, tendu de velours outremer, garni de coussins de toutes couleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5c71837-ce8c-48e4-987d-648365beb698",
                        "source_entry_id": "3c4ef56f-ac01-32d7-bd1a-3bafddcbf065",
                        "source_sense_id": "6cf229bf-c0b2-3949-8149-5797d9afde1f",
                        "source_sense_description": "De la couleur (1)",
                        "target_lang_word": "ultramarine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultramarine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca84b0de-94d1-365c-ad0b-29dede58ae64",
                                        "entry_id": "3a17a659-43e4-3297-a093-720d5ce828af",
                                        "glosses": [
                                            "Beyond the sea."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "622e28f1-1721-44d7-9bee-ca5c8eb71061",
                                                "sense_id": "ca84b0de-94d1-365c-ad0b-29dede58ae64",
                                                "text": "[I]n England we ſhall never be taught to look upon the annihilation of our trade, the ruin of our credit, the defeat of our armies, and the loſs of our ultramarine dominions (whatever the author may think of them), to be the high road to proſperity and greatneſs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "295c4679-82e4-3af0-b3a1-e76fd4fc1096",
                                        "entry_id": "3a17a659-43e4-3297-a093-720d5ce828af",
                                        "glosses": [
                                            "Of a brilliant dark blue or slightly purplish color like that of the pigment (noun sense 1)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ultramarine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a07a27-8c8d-35bb-9261-f786bc9633ba",
                                        "entry_id": "73f89cd3-4e88-38dc-b517-59b7d8eeb1e0",
                                        "glosses": [
                                            "In full ultramarine blue: a brilliant blue pigment traditionally made from ground-up lapis lazuli, and now usually either extracted from mineral deposits or made synthetically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0b82c24-1c3a-30f0-95c4-50b52c8f5608",
                                        "entry_id": "73f89cd3-4e88-38dc-b517-59b7d8eeb1e0",
                                        "glosses": [
                                            "A brilliant dark blue or slightly purplish colour like that of the pigment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8cbd03-6525-4408-969a-dcee47d75629",
                                                "sense_id": "e0b82c24-1c3a-30f0-95c4-50b52c8f5608",
                                                "text": "The atmosphere beneath is languorous, and is so tinged with azure that what artists call the middle distance partakes also of that hue, while the horizon beyond is of the deepest ultramarine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
