                "senses": [
                    {
                        "sense_id": "11926ddf-3c50-33da-9b82-cf7d8de881f6",
                        "entry_id": "1ff279b3-680d-3840-ab04-a311323e6beb",
                        "glosses": [
                            "festliches Essen zur Feier einer Hochzeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "3509665a-6eb0-4eb7-8fe9-de39408fbc64",
                                "sense_id": "11926ddf-3c50-33da-9b82-cf7d8de881f6",
                                "text": "„Beim Hochzeitsmahl hatte Hammershaimb jedenfalls eine sonderbare Rede über einen schwarzen Ochsen gehalten, und es überraschte Tóvó nicht, dass auch diese Geschichte von der Nólsoy stammte.“"
                            },
                            {
                                "example_id": "469714f9-3562-46e2-8b78-9641b422184b",
                                "sense_id": "11926ddf-3c50-33da-9b82-cf7d8de881f6",
                                "text": "„Bei dem Hochzeitsmahl war mein einziges Vergnügen das Interesse, das ich daran nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
