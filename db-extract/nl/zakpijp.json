                            {
                                "example_id": "1ec1fc5b-2af5-46ee-b4d7-7daa4e195264",
                                "sense_id": "e74dde9f-c7c0-35e2-a50d-acb47cc74bf0",
                                "text": "In voorbije eeuwen was de zakpijp een belangrijk instrument in de muziek van de Lage Landen."
                            }
                        ]
                    },
                    {
                        "sense_id": "271ab557-7902-34f2-9a12-3fdd98690e71",
