                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6656fd4d-479c-33f1-b45e-77e03d9f5c05",
                                        "entry_id": "38f7dc48-7617-362b-a5b5-79387da74c49",
                                        "glosses": [
