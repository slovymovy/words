                    {
                        "translation_id": "c3631b06-30f8-458c-a0db-ad976d68312c",
                        "source_entry_id": "2ab278ae-3747-3f79-820d-2f8a2c2f39eb",
                        "source_sense_id": "7fbbb971-e596-3285-8fcb-a7656b1868d9",
                        "source_sense_description": "autonome Republik in Südrussland",
                        "target_lang_word": "Чечня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Чечня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "37ccee56-f258-3935-b553-405ee789da0d",
                                        "entry_id": "b9cf1fad-6555-35f4-a448-e8d67fe54dca",
                                        "glosses": [
                                            "геогр. республика (субъект) в составе Российской Федерации на Северном Кавказе, в долинах рек Терек и Сунжа со столицей в Грозном, граничащая на западе — с Ингушетией, на северо-западе — с Северной Осетией и Ставропольским краем, на северо-востоке и востоке — с Дагестаном, на юге — с Грузией"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150d1531-acd8-4854-8d1d-96f0bdb69c5e",
                                                "sense_id": "37ccee56-f258-3935-b553-405ee789da0d",
                                                "text": "Вешний полдень сиял над высью Кавказа, и громкие клики мулл звали жителей Чечни к молитве."
                                            },
                                            {
                                                "example_id": "06cef1f6-130b-46ee-b884-41b612c40ccc",
                                                "sense_id": "37ccee56-f258-3935-b553-405ee789da0d",
                                                "text": "Из гор Ичкерии далекой // Уже в Чечню на братний зов // Толпы стекались удальцов."
                                            },
                                            {
                                                "example_id": "17372a53-6402-4c6d-ba16-f4b37093c054",
                                                "sense_id": "37ccee56-f258-3935-b553-405ee789da0d",
                                                "text": "Рукопашные схватки в Чечне были, а значит, нужно людей готовить к этому, и притом тщательно."
                                            },
                                            {
                                                "example_id": "8b3c99f6-6199-4f08-acc1-d14dff534cb1",
                                                "sense_id": "37ccee56-f258-3935-b553-405ee789da0d",
                                                "text": "С самого начала, когда он [Путин] устроил геноцид в Чечне. По оценке журнала «The Wall Street Journal» тех лет, российская армия убила в Чечне от 100 до 200 тысяч человек. При том, что чеченская нация насчитывает едва один миллион человек. То есть, 10–20 процентов чеченцев уничтожено. Это ли не геноцид?"
                                            },
                                            {
                                                "example_id": "510146bb-5b3e-431a-af9f-392a3920aa1f",
                                                "sense_id": "37ccee56-f258-3935-b553-405ee789da0d",
                                                "text": "Во время двух войн в Чечне солдат российской армии не раз называли ответственными за убийства мирных жителей во время зачисток. Самые известные случаи — это Самашки в 1995 году (103 убитых) и Новые Алды в 2000-м (56 убитых). Последствия этих зачисток расследовали правозащитники из «Мемориала» — об этой работе «Медиазоне» рассказал Олег Орлов."
                                            }
                                        ]
