                "senses": [
                    {
                        "sense_id": "18edc7bf-00b4-3d42-9b16-615480c633cf",
                        "entry_id": "7dc82b73-3f7e-359e-83c1-fd838682c8ef",
                        "glosses": [
                            "Urlaub, der an/um Weihnachten verbracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7afb359a-79bd-4f00-a78b-0a7fe004bb6e",
                                "sense_id": "18edc7bf-00b4-3d42-9b16-615480c633cf",
                                "text": "„Fabiola erwähnte noch einmal, wie enttäuscht sie sei, dass der gemeinsame Weihnachtsurlaub wegen der Urlaubsperre nun nicht stattfinden könne, und hoffte auf das nächste Jahr.“"
                            },
                            {
                                "example_id": "9cad629c-6032-4860-84b2-f76c015405d4",
                                "sense_id": "18edc7bf-00b4-3d42-9b16-615480c633cf",
                                "text": "„Die meisten Offiziere sind schon im Weihnachtsurlaub, aber das wissen die Türken natürlich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
