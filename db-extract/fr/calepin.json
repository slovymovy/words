                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0c622bfb-f99a-4cbf-b85d-5564b9f38e27",
                        "entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "tags": [
                            "plural"
                        ],
                        "form": "calepins"
                    },
                    {
                        "form_id": "eb67df70-589b-4ce0-a0f2-99a8cfb7ff3c",
                        "entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "tags": [],
                        "form": "calpin"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9648bbc-5085-3830-adc0-216f7f82f793",
                        "entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "glosses": [
                            "Carnet de poche où l’on note des indications, des renseignements, des impressions, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b394482-ac2d-47f5-8b59-f9edcc64fa61",
                                "sense_id": "e9648bbc-5085-3830-adc0-216f7f82f793",
                                "text": "Le uhlan mettait pied à terre, ouvrait tranquillement une carte ou un calepin, prenait des notes."
                            },
                            {
                                "example_id": "3b956267-e964-47d0-b724-d0dca7cc0b0f",
                                "sense_id": "e9648bbc-5085-3830-adc0-216f7f82f793",
                                "text": "Des employés en casquette écrivaient sur des calepins, à la lueur du gaz."
                            },
                            {
                                "example_id": "8bbef9ff-2fec-40c5-8293-45ae8b741806",
                                "sense_id": "e9648bbc-5085-3830-adc0-216f7f82f793",
                                "text": "Comme, au sommet, il essaie de noter des indications sur son calepin et éprouve des difficultés à maintenir son équilibre, Arlette, légère, escalade l’autre côté de l’échelle."
                            },
                            {
                                "example_id": "c10bc681-ac09-431d-a439-645a1cb062f4",
                                "sense_id": "e9648bbc-5085-3830-adc0-216f7f82f793",
                                "text": "Maillat s’assit, le dos contre l’arbre, et alluma une cigarette. Pierson avait sorti de sa poche un petit calepin noir à élastique qui ne le quittait jamais.\n— Craque une allumette, veux-tu ?\nLa flamme, de nouveau, brilla. Pierson griffonna quelque chose sur son carnet, fit claquer l’élastique, remit le carnet dans sa poche."
                            }
                        ]
                    },
                    {
                        "sense_id": "47aa547b-b3e9-3e28-81b4-e3c398c3258f",
                        "entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "glosses": [
                            "Dessin représentant le travail à exécuter, sur lequel les dimensions de chaque pierre sont indiquées."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "00a30935-24e9-3abe-998c-0506e29f8817",
                        "entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "glosses": [
                            "Cartable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "364fc661-a8c4-41ce-b2c7-de2f0128c2e3",
                                "sense_id": "00a30935-24e9-3abe-998c-0506e29f8817",
                                "text": "Mal lui en prit, un jour qu'il avait fait choir de cette manière un élève de septième latine qui se rendait à l'athénée, le calepin sur le dos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5582721b-89bb-4b49-b0a4-40c14ff57637",
                        "source_entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "source_sense_description": "Carnet de poche",
                        "target_lang_word": "Notizblock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notizblock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                        "entry_id": "54b36f3c-9b33-39b1-ae4c-df1e5978c457",
                                        "glosses": [
                                            "kleiner Schreibblock aus Papier, der zum Aufschreiben von Notizen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19eb9ee0-9ecf-4576-8834-ba85e74db939",
                                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                                "text": "Vielleicht haben Sie jedoch auch einen ganz anderen Spieler auf Ihrem Notizblock, wenn es darum geht, den besten Akteur der FIFA Klub-WM 2009 zu suchen."
                                            },
                                            {
                                                "example_id": "92cdc9ae-f314-4d11-bfe2-23b86e150aa2",
                                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                                "text": "„Der Notizblock lag bereits geöffnet auf dem Tisch.“"
                                            },
                                            {
                                                "example_id": "77cef619-ff62-46c6-b323-765f9ada1c8c",
                                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                                "text": "„Mit Notizblock und Stift begaben sie die 15- und 16-Jährigen auf dem Schulhof, in der U-Bahn oder in den Straßen von Berlin-Kreuzberg auf die Suche nach Wörtern, die typisch für Kiezdeutsch sind.“"
                                            },
                                            {
                                                "example_id": "60cbc45e-094f-4644-809f-ae2fad79d88b",
                                                "sense_id": "c0abde93-ff52-30be-8e74-43df952f7b9b",
                                                "text": "„Ich habe dann auch meinen Notizblock aus dem Rucksack geholt und die gerade gelesenen Fremdworte aufgeschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb0653c2-9ced-4d9b-a641-eb18945cb3bc",
                        "source_entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
                        "source_sense_description": "Carnet de poche",
                        "target_lang_word": "notebook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "A book in which notes or memoranda are written."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f661450-213c-41fc-a3b8-9206f8e320a5",
                                                "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                                "text": "With an unquenchable enthusiasm for locomotives and their work, at an early age I had commenced to keep engine and traffic-recording notebooks, compiled in a schoolboy's round hand."
                                            },
                                            {
                                                "example_id": "0157a3e9-dd49-4ada-8d39-fe4dc6d334b8",
                                                "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                                "text": "For Caſſius is a-weary of the World: / Hated by one he loues, brau'd by his Brother, / Check'd like a bondman, all his faults obſeru'd, / Set in a Note-booke, learn'd, and con'd by roate / To caſt into my Teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7f7f95-836f-3b9d-8f39-47f35b6926ec",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "A kind of user interface in literate programming, allowing calculations to be interspersed with human-readable comments, diagrams, etc."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd2549f-63de-4550-a6fc-2f2b9a683248",
                                                "sense_id": "cf7f7f95-836f-3b9d-8f39-47f35b6926ec",
                                                "text": "We have found the use of Jupyter notebooks to be a convenient way of sharing work and code in a compact and reproducible manner. Jupyter notebooks are easy to update and adapt over time compared to a static CD-ROM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898cce50-6c35-3728-82a1-b1dc45f9598d",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "Ellipsis of notebook computer (“laptop computer”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "599f9bba-fd5d-4e01-9848-9aeb3a34ff61",
                                                "sense_id": "898cce50-6c35-3728-82a1-b1dc45f9598d",
                                                "text": "Over time, the difference in size between laptops and notebooks became a matter of no more than an inch or two in length and width, and a fraction of an inch in thickness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19b0fcce-a980-4c63-bc24-f7a98e882024",
                        "source_entry_id": "ec48a022-3a85-3538-a283-0240db06b297",
