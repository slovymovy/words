                ],
                "senses": [
                    {
                        "sense_id": "d28df40d-fb88-31c0-9d29-46ce9804eabc",
                        "entry_id": "84e83a9d-2ed7-3e37-817f-3bf6aa6beb39",
                        "glosses": [
                            "Eigenschaft einer Person, gut informiert zu sein, ein umfassendes Wissen über etwas zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653bad83-c793-4035-b9a9-471bd72ae1e2",
                                "sense_id": "d28df40d-fb88-31c0-9d29-46ce9804eabc",
                                "text": "„Die Aufgeklärtheit der Verbraucher und deren Kommunikations- und Zeigefreudigkeit (z. B. in Instagram) bringt neue Herausforderungen für Marken.“"
                            },
                            {
                                "example_id": "8b7cf6a4-7a8b-488c-ae09-fb455f0d75b0",
                                "sense_id": "d28df40d-fb88-31c0-9d29-46ce9804eabc",
                                "text": "„Aufgeklärtheit sieht man den Leuten nur selten gleich mit dem ersten Eindruck an.“"
                            },
                            {
                                "example_id": "e97de861-a327-46d7-97fc-70d4cd213f45",
                                "sense_id": "d28df40d-fb88-31c0-9d29-46ce9804eabc",
                                "text": "„Der Grad der Durchlässigkeit und der Grad der Gestaltungskraft der Psyche für den geistig-seelischen Impuls der Humanität entspricht dem Grad der Aufgeklärtheit des Individuums.“"
                            },
                            {
                                "example_id": "d2cf7bee-de7c-4cdb-9794-a9b62c552a35",
                                "sense_id": "d28df40d-fb88-31c0-9d29-46ce9804eabc",
                                "text": "„Die politische Selbständigkeit des Volkes und die mitbürgerliche Verantwortung jedes einzelnen setzen allgemeine Aufgeklärtheit voraus.“"
                            },
                            {
                                "example_id": "f37840c9-6691-4e1a-a572-b302263a2fd6",
                                "sense_id": "d28df40d-fb88-31c0-9d29-46ce9804eabc",
                                "text": "„Um nun diese platonische Neigung zur Aufgeklärtheit stellenweise auch durch die Tat zu beweisen, verfällt sie auf die seltsamsten Mittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4069803-a8e5-3a60-8d81-b62784d49f11",
                        "entry_id": "84e83a9d-2ed7-3e37-817f-3bf6aa6beb39",
                        "glosses": [
                            "Geisteshaltung, die von der Ideologie der Aufklärung geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c303e4e9-2804-419d-8578-7a2ede11812e",
                                "sense_id": "a4069803-a8e5-3a60-8d81-b62784d49f11",
                                "text": "„Aufgeklärtheit sieht man den Leuten nur selten gleich mit dem ersten Eindruck an.“"
                            },
                            {
                                "example_id": "7a350680-403b-4151-a028-496122c7026c",
                                "sense_id": "a4069803-a8e5-3a60-8d81-b62784d49f11",
                                "text": "„Der Grad der Durchlässigkeit und der Grad der Gestaltungskraft der Psyche für den geistig-seelischen Impuls der Humanität entspricht dem Grad der Aufgeklärtheit des Individuums.“"
                            },
                            {
                                "example_id": "f285bed9-457b-49e1-9e8d-f7de92932b6c",
                                "sense_id": "a4069803-a8e5-3a60-8d81-b62784d49f11",
                                "text": "„Die politische Selbständigkeit des Volkes und die mitbürgerliche Verantwortung jedes einzelnen setzen allgemeine Aufgeklärtheit voraus.“"
                            },
                            {
                                "example_id": "385518ec-cbed-4080-abf7-a364074e87b8",
                                "sense_id": "a4069803-a8e5-3a60-8d81-b62784d49f11",
                                "text": "„Um nun diese platonische Neigung zur Aufgeklärtheit stellenweise auch durch die Tat zu beweisen, verfällt sie auf die seltsamsten Mittel.“"
                            },
                            {
                                "example_id": "a5747fbb-4fb3-4ce1-860f-f585db4e6b6e",
                                "sense_id": "a4069803-a8e5-3a60-8d81-b62784d49f11",
                                "text": "„So wirkten all die verschiedenartigen Strömungen dieses Jahrhunderts – der Absolutismus des Staates und die Aufgeklärtheit der Gesellschaft, der Rationalismus und der Pietismus Freimaurertum und mystischer Spiritualismus — in der Richtung: auf die Schwächung und Verflüchtigung der strengen Kirchlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
