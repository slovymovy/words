                                    },
                                    {
                                        "sense_id": "418e24f2-2b6a-3895-b429-5b26d4beb94a",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Partie distincte d’un tout.",
                                            "chacune des parties grandes ou petites qui entrent dans la composition d’un ouvrage d’architecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a8c5a4-0daf-426a-8039-259058fc1c71",
                                                "sense_id": "418e24f2-2b6a-3895-b429-5b26d4beb94a",
                                                "text": "La frise est un membre de l’entablement. - Le larmier est le principal membre de la corniche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb7c275-ee19-37b0-846d-a00219060d26",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Partie distincte d’un tout.",
                                            "Une des grosses pièces de bois qui forment les côtes ou les couples d’un navire."
                                        ],
                                        "tags": [],
