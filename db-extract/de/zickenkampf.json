                "senses": [
                    {
                        "sense_id": "59d751d6-b4b9-3832-9646-68ff54a2da3b",
                        "entry_id": "e1fa3a27-57ed-3396-9451-199cff1281c0",
                        "glosses": [
                            "heftige verbale oder handgreifliche Auseinandersetzung zwischen weiblichen Personen (= Zicken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2075cf6-bd7a-4d11-858b-60147cd07159",
                                "sense_id": "59d751d6-b4b9-3832-9646-68ff54a2da3b",
                                "text": "„Ich sah, wie Jacques sich angesichts der Gefahr eines weiteren Zickenkampfes leicht verkrampfte und er sich damit beschäftigte, winzige Schmutzpartikel vom Wagenboden aufzusammeln.“"
                            },
                            {
                                "example_id": "cdb74254-a2fa-40ce-abce-062e93c30a01",
                                "sense_id": "59d751d6-b4b9-3832-9646-68ff54a2da3b",
                                "text": "„Die Vermutung, hier werde also offenbar ein zwischen Alexandra Merz und Barbara Knoflach tobender ‚Zickenkampf‘ nun auf anderer Ebene fortgeführt, weist Scope-Analystin Merz von sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
