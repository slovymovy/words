                    },
                    {
                        "sense_id": "9e68e255-782a-3496-8ade-73b86e274aa7",
                        "entry_id": "df0f7922-7e75-3c6c-8fbc-5c65503a19dd",
                        "glosses": [
                            "The study of martyrs and martyrdom; the names and stories of martyrs, particularly",
                            "A liturgical calendar of days for the commemoration of formally recognized saints, usually including some biographical notes."
                        ],
                        "tags": [
                            "capitalized",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "bb7f11c9-67bb-444b-bb75-34798f589a3a",
                                "sense_id": "9e68e255-782a-3496-8ade-73b86e274aa7",
                                "text": "... we know that Augustine, a monk in the time of Gregory the Great, took with him into England the martyrology of the Roman Church."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c965c15-4cdc-3e49-bbe7-9a3a772d9037",
