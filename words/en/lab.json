{
    "word_family": [
        "laboratory",
        "Labrador"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                    "sense_definition": "A short form of <w>laboratory</w>; a room or building equipped for scientific experiments, research, or teaching.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "science_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students are conducting an experiment in the science <w>lab</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты проводят эксперимент в научной <w>лаборатории</w>.",
                                "zh": "学生们正在科学<w>实验室</w>里做实验。"
                            }
                        },
                        {
                            "text": "She wears a white coat when she works in the <w>lab</w>.",
                            "target_lang_translations": {
                                "ru": "Она носит белый халат, когда работает в <w>лаборатории</w>.",
                                "zh": "她在<w>实验室</w>工作时会穿白大褂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "science lab",
                        "computer lab",
                        "in the lab",
                        "lab coat",
                        "lab rat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for laboratory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"laboratory\"; комната или здание, оборудованное для научных экспериментов, исследований или обучения.",
                        "zh": "“laboratory”的缩写；用于科学实验、研究或教学的房间或建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаборатория",
                                "target_lang_sense_clarification": "помещение для исследований"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实验室",
                                "target_lang_sense_clarification": "进行科学研究或实验的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                    "sense_definition": "A practical lesson or session conducted in a laboratory.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "science_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a chemistry <w>lab</w> this afternoon, so I cannot go home early.",
                            "target_lang_translations": {
                                "ru": "У меня сегодня днем <w>лабораторная</w> по химии, поэтому я не могу пойти домой рано.",
                                "zh": "我今天下午有化学<w>实验课</w>，所以不能早回家。"
                            }
                        },
                        {
                            "text": "We need to write a report about what we did during the <w>lab</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно написать отчет о том, что мы делали во время <w>лабораторной работы</w>.",
                                "zh": "我们需要写一份关于<w>实验课</w>内容的报告。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemistry lab",
                        "physics lab",
                        "biology lab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "academic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практическое занятие или урок, проводимый в лаборатории.",
                        "zh": "在实验室进行的实践课程或环节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабораторная работа",
                                "target_lang_sense_clarification": "учебное занятие"
                            },
                            {
                                "target_lang_word": "лабораторная",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实验课",
                                "target_lang_sense_clarification": "学校里的实践性课程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cea53ab4-a93d-3fac-9f47-022952ae1def",
                    "sense_definition": "A short form of <w>Labrador</w> retriever; a breed of dog with a short coat, often used as a guide dog or family pet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dog_breed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My neighbor has a friendly black <w>lab</w> that loves to play fetch.",
                            "target_lang_translations": {
                                "ru": "У моего соседа есть дружелюбный черный <w>лабрадор</w>, который любит играть в \"принеси\".",
                                "zh": "我的邻居养了一只友好的黑色<w>拉布拉多</w>，它特别喜欢玩捡球游戏。"
                            }
                        },
                        {
                            "text": "We took our <w>lab</w> for a long walk in the park.",
                            "target_lang_translations": {
                                "ru": "Мы взяли нашего <w>лабрадора</w> на долгую прогулку в парк.",
                                "zh": "我们带着我们的<w>拉布拉多</w>去公园走了很长一段路。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "black lab",
                        "yellow lab",
                        "chocolate lab"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for Labrador"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"Labrador retriever\"; порода собак с короткой шерстью, часто используемая как собака-поводырь или домашний питомец.",
                        "zh": "“Labrador retriever”的缩写；一种短毛犬品种，常被用作导盲犬或家庭宠物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабрадор",
                                "target_lang_sense_clarification": "порода собаки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉布拉多",
                                "target_lang_sense_clarification": "犬类品种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "336ccbf6-901b-3e75-8de9-3876112c4a61",
                    "sense_definition": "Initialism of lactic acid bacterium; a type of bacteria often used in food fermentation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology_acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study focused on the role of <w>LAB</w> in yogurt production.",
                            "target_lang_translations": {
                                "ru": "Исследование было посвящено роли <w>молочнокислых бактерий</w> в производстве йогурта.",
                                "zh": "这项研究聚焦于<w>乳酸菌</w>在酸奶生产中的作用。"
                            }
                        },
                        {
                            "text": "Certain types of <w>LAB</w> are beneficial for gut health.",
                            "target_lang_translations": {
                                "ru": "Определенные виды <w>молочнокислых бактерий</w> полезны для здоровья кишечника.",
                                "zh": "某些种类的<w>乳酸菌</w>对肠道健康有益。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"lactic acid bacterium\" (молочнокислые бактерии); тип бактерий, часто используемых при ферментации пищевых продуктов.",
                        "zh": "乳酸菌（lactic acid bacterium）的首字母缩写；常用于食品发酵的一类细菌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молочнокислые бактерии",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳酸菌",
                                "target_lang_sense_clarification": "生物学名词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2fc35392-6e92-3be9-b2fe-88cdcba98d5c",
                    "sense_definition": "Abbreviation of the <w>Labour</w> Party, a major center-left political party in the United Kingdom and other countries.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>Lab</w> candidate promised to improve public transport if elected.",
                            "target_lang_translations": {
                                "ru": "<w>Лейбористский</w> кандидат пообещал улучшить общественный транспорт в случае избрания.",
                                "zh": "<w>工党</w>候选人承诺如果当选，将改善公共交通。"
                            }
                        },
                        {
                            "text": "Recent polls show a slight increase in support for <w>Lab</w>.",
                            "target_lang_translations": {
                                "ru": "Недавние опросы показывают небольшой рост поддержки <w>лейбористов</w>.",
                                "zh": "最近的民调显示对<w>工党</w>的支持率略有上升。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"Labour Party\" (Лейбористская партия), крупной левоцентристской политической партии в Великобритании и других странах.",
                        "zh": "工党（Labour Party）的缩写，英国及其他国家的主要中左翼政党。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лейбористы",
                                "target_lang_sense_clarification": "члены партии"
                            },
                            {
                                "target_lang_word": "Лейбористская партия",
                                "target_lang_sense_clarification": "политическая организация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工党",
                                "target_lang_sense_clarification": "政治组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1daaf00-f95e-3eca-9e6a-dafc112e55a7",
