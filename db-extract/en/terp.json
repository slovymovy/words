                        "entry_id": "3f3a02ef-7f15-30aa-9304-60e859b545ba",
                        "glosses": [
                            "Dance."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "be77eda4-3928-4ab2-9940-9d05cd52a498",
                                "sense_id": "6b7b984d-5a82-3640-bb7e-41823a2a8300",
                                "text": "In the terp section, Barbara Perry, last here in a straight role in Swan Song, scores smartly as a dancer, and lanky Jack Williams holds down the other lead stepping slot with his intricate tap routines. Dancing is overall excellent, but as noted above, there is too much of it."
                            }
                        ]
                    }
