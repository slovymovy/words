                    {
                        "form_id": "0d38ec0c-a3d1-4947-978d-fa686dd34413",
                        "entry_id": "4d9b54d9-29ec-3283-af49-2f92335e59df",
                        "tags": [],
                        "form": "Don Quichottisme"
                    },
                    {
                        "form_id": "16923089-6006-4841-ade6-d1f013d34b3a",
                        "entry_id": "4d9b54d9-29ec-3283-af49-2f92335e59df",
                        "tags": [],
                        "form": "quichottisme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "065a40bf-c9d9-3cd8-8bea-7abfdcd8338a",
                        "entry_id": "4d9b54d9-29ec-3283-af49-2f92335e59df",
                        "glosses": [
                            "Attitude militante déterminée mais peu réaliste, voire délirante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92439520-c020-4e55-bdb1-1565c7261117",
                                "sense_id": "065a40bf-c9d9-3cd8-8bea-7abfdcd8338a",
                                "text": "A la tranquille certitude dont le romancier naturaliste ou réaliste fait preuve à cet égard, le donquichottisme oppose un doute qu’il ne peut mieux exprimer qu’en y conformant sa manière d’écrire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07bf64e1-e1ce-4a35-8913-e443a0295563",
                        "source_entry_id": "4d9b54d9-29ec-3283-af49-2f92335e59df",
                        "source_sense_id": "065a40bf-c9d9-3cd8-8bea-7abfdcd8338a",
                        "source_sense_description": "Disposition d’esprit",
                        "target_lang_word": "Donquichotterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Donquichotterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                                        "entry_id": "636e4314-7b3d-33d6-b68f-e065577b324f",
                                        "glosses": [
                                            "lächerliches Vorhaben, das von vornherein zum Scheitern verurteilt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df00c600-a166-4918-b4d8-737bb42af1b2",
                                                "sense_id": "77ac4a9d-4822-3b70-a1ce-e0361c710520",
                                                "text": "„Die Resolution fordert die Beendigung der militärischen Kämpfe – vor allem von der Hisbollah –, eine von der UNO gesicherte ‚Pufferzone‘ allein auf libanesischem Gebiet, den Rückzug Israels, die gegenseitige Respektierung der Grenze sowie die Entwaffnung der Milizen im Libanon und das Verbot von Waffenlieferungen an diese. Hierin spiegelt sich die Donquichotterie des ‚Krieges gegen den Terror‘ wider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44297a1b-b485-4125-a0f6-f834dd8da4a7",
                        "source_entry_id": "4d9b54d9-29ec-3283-af49-2f92335e59df",
                        "source_sense_id": "065a40bf-c9d9-3cd8-8bea-7abfdcd8338a",
                        "source_sense_description": "Disposition d’esprit",
                        "target_lang_word": "quixotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quixotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10f1bd46-268f-3eee-9706-3189dd594996",
                                        "entry_id": "e23ecf58-85d3-31f3-bc03-817af8aed721",
                                        "glosses": [
                                            "Resembling or characteristic of the Spanish chivalric hero Don Quixote; possessed with or resulting from the desire to do noble and romantic deeds, without thought of realism and practicality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c2aac2-9eaf-4ce9-a825-a3783ebea4ca",
                                                "sense_id": "10f1bd46-268f-3eee-9706-3189dd594996",
                                                "text": "Olivier, as you know, was quixotic, and would not permit a secret service and spies."
                                            },
                                            {
                                                "example_id": "0ca5e4fd-8225-4d0f-bc7c-8062a87ef0dc",
                                                "sense_id": "10f1bd46-268f-3eee-9706-3189dd594996",
                                                "text": "The message is not subliminal. […] Characters aren’t just quixotic, they cite Cervantes to one another."
                                            },
                                            {
                                                "example_id": "23e55bc7-66e9-4f1d-b487-ab9001b31408",
                                                "sense_id": "10f1bd46-268f-3eee-9706-3189dd594996",
                                                "text": "The war triggered in [Miguel de] Unamuno the realization that, in hopeless times, quixotic lunacy could save people from the paralysis that often accompanies defeatism."
                                            },
                                            {
                                                "example_id": "8260578a-d4d2-4764-800c-3ccebf57ff61",
                                                "sense_id": "10f1bd46-268f-3eee-9706-3189dd594996",
                                                "text": "In the digital age, building a new library filled with old-fashioned printed books seems idealistic, almost quixotic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9902a7a4-86d7-33ab-89ae-1e61ff90fa80",
                                        "entry_id": "e23ecf58-85d3-31f3-bc03-817af8aed721",
                                        "glosses": [
                                            "Overly optimistic and moralistic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fce54a93-25d5-3b86-a98a-75f89c7449f9",
                                        "entry_id": "e23ecf58-85d3-31f3-bc03-817af8aed721",
                                        "glosses": [
                                            "Exceedingly idealistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff63206b-67f1-41d9-8206-16acf14e5dd1",
                                                "sense_id": "fce54a93-25d5-3b86-a98a-75f89c7449f9",
                                                "text": "Call it a brain freeze, another 'Aleppo moment,' or a mere campaign stumble, but Gary Johnson has stumbled again in his quixotic presidential campaign."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quixotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07d657f3-45b6-31fd-bdf3-0d5dabc37369",
                                        "entry_id": "08b141f4-ba5d-37de-863f-572cdde9ab69",
                                        "glosses": [
                                            "A quixotic person or sentiment."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6edfa9c-92b1-48d7-a407-3413c2744962",
                                                "sense_id": "07d657f3-45b6-31fd-bdf3-0d5dabc37369",
                                                "text": "The cultural quixotics attribute the change to inscrutable \"cultural factors,\" which is tantamount to abandoning altogether the search for explanation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
