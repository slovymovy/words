                "senses": [
                    {
                        "sense_id": "3e4ed40a-601d-3336-ba21-690353ed7c3c",
                        "entry_id": "e9bfbd59-0b2b-3abf-b499-e9b28f7f314b",
                        "glosses": [
                            "Couch, die auch als Bett genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a948f4-52a9-4de8-a7cb-daa14696ef6c",
                                "sense_id": "3e4ed40a-601d-3336-ba21-690353ed7c3c",
                                "text": "„Es war ohne hausbackenen Zierat mit allem Notwendigen eingerichtet, Tisch, Bettcouch, kleinen Sesseln, Wandschank, Waschständer, Bücherbord.“"
                            },
                            {
                                "example_id": "44931a73-ae31-449b-ba90-eaaae70fba3b",
                                "sense_id": "3e4ed40a-601d-3336-ba21-690353ed7c3c",
                                "text": "„Aber die Mama hat es ihm verleidet, indem sie die Zimmer oben, nur das Bad ausgenommen, vollgestellt hat mit ausrangierten handgearbeiteten Büfetts aus Eiche, mit von Untermietern zerschlissenen Bettcouchen und Polstergarnituren, fleckigen Sofatischen, Kleiderschränken, die mit unmodischen Sachen vollgestopft sind, mit ihrer Nähmaschine und einem Kühlschrank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
