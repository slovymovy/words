                    },
                    {
                        "translation_id": "99c781e7-1110-4a1f-b8a9-4347681bcf60",
                        "source_entry_id": "8388222e-47eb-3ae1-ad27-9411d8a90eed",
                        "source_sense_id": "4b670152-57b5-3b99-8415-0323e9cc9922",
                        "target_lang_word": "concept album",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concept album",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f7699a0-e945-3cbe-8d77-e8df5a72ecff",
                                        "entry_id": "c8c17d74-b5d6-3edc-a4de-c4556dc377cc",
                                        "glosses": [
                                            "An album of music where the content follows an overall theme or narrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73dafa4f-36b3-4819-86c9-0277d484fd3e",
                                                "sense_id": "6f7699a0-e945-3cbe-8d77-e8df5a72ecff",
                                                "text": "Rather than merely a collection of unrelated songs, their new LP (which was nine months in the making) is a concept album, “an integrated and ethereal experience with a cosmic quality.”"
                                            },
                                            {
                                                "example_id": "855c0cb7-5dc5-4271-99d1-2446630d6da0",
                                                "sense_id": "6f7699a0-e945-3cbe-8d77-e8df5a72ecff",
                                                "text": "[…] while the consistent use of lengthy forms such as the programmatic song cycle of the concept album and the multimovement suite underscores the hippies' new, drug-induced conception of time."
                                            },
                                            {
                                                "example_id": "225a1121-b546-4957-a7aa-931974424447",
                                                "sense_id": "6f7699a0-e945-3cbe-8d77-e8df5a72ecff",
                                                "text": "Moore relates the concept album to the ideals of progressive rock in the 1970s, building on Sgt. Pepper 's appeal to unity at the album level (through packaging, characters, and a simulated stage performance) and articulating a \"desire to establish a degree of aesthetic [that is, musical] unity greater than that of the individual song,\"[…]"
                                            },
                                            {
                                                "example_id": "2c7c78b5-cb01-4b62-8c09-62ea68661402",
                                                "sense_id": "6f7699a0-e945-3cbe-8d77-e8df5a72ecff",
                                                "text": "They gave the Beatles' ‘Sgt. Pepper's Lonely Hearts Club Band’ as an example of a concept album."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
