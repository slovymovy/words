{
    "word_family": [
        "shiver",
        "shiveringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f58822d-7735-3237-8d6b-a83ab77a82f6",
                    "sense_definition": "Present participle and gerund of <w>shiver</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trembling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy was <w>shivering</w> uncontrollably after falling into the icy lake.",
                            "target_lang_translations": {
                                "ru": "Мальчик <w>дрожал</w> от холода, не в силах остановиться, после того как упал в ледяное озеро.",
                                "de": "Der Junge <w>zitterte</w> unkontrolliert, nachdem er in den eisigen See gefallen war."
                            }
                        },
                        {
                            "text": "She could not stop <w>shivering</w> from the piercing cold wind.",
                            "target_lang_translations": {
                                "ru": "Она не могла перестать <w>дрожать</w> от пронизывающего холодного ветра.",
                                "de": "Sie konnte wegen des schneidend kalten Windes nicht aufhören zu <w>zittern</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "trembling",
                        "quaking",
                        "shaking"
                    ],
                    "common_phrases": [
                        "shivering cold",
                        "start shivering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дрожание или тряска тела, обычно вызванные холодом, страхом или болезнью.",
                        "de": "Partizip Präsens und Gerundium von 'shiver'; zittern oder frösteln vor Kälte, Angst oder Krankheit."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожащий",
                                "target_lang_sense_clarification": "причастие, описывающее состояние человека"
                            },
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "процесс дрожания"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zittern",
                                "target_lang_sense_clarification": "vor Kälte oder Angst beben"
                            },
                            {
                                "target_lang_word": "frösteln",
                                "target_lang_sense_clarification": "leicht vor Kälte zittern"
                            },
                            {
                                "target_lang_word": "zitternd",
                                "target_lang_sense_clarification": "als Partizip / Adjektiv"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdbb4056-2bc4-33bc-a85f-0ae5515c68c4",
                    "sense_definition": "The act of trembling or shaking, often due to cold, fear, or illness.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trembling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shivering</w> in his hands made it difficult to hold the cup.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>дрожи</w> в руках ему было трудно держать чашку.",
                                "de": "Das <w>Zittern</w> in seinen Händen machte es schwer, die Tasse zu halten."
                            }
                        },
                        {
                            "text": "A sudden <w>shivering</w> took over her body as the fever began to rise.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>дрожь</w> охватила её тело, когда начала подниматься температура.",
                                "de": "Ein plötzlicher <w>Schüttelfrost</w> erfasste ihren Körper, als das Fieber zu steigen begann."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremor",
                        "shudder",
                        "quiver"
                    ],
                    "common_phrases": [
                        "violent shivering",
                        "constant shivering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или акт непроизвольного дрожания тела.",
                        "de": "Das unwillkürliche Zittern oder Schütteln des Körpers, meist verursacht durch Kälte, Fieber oder Angst."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "непроизвольное сотрясение тела"
                            },
                            {
                                "target_lang_word": "озноб",
                                "target_lang_sense_clarification": "дрожь, вызванная болезнью или холодом"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Zittern",
                                "target_lang_sense_clarification": "körperliches Beben"
                            },
                            {
                                "target_lang_word": "der Schüttelfrost",
                                "target_lang_sense_clarification": "krankheitsbedingtes oder starkes Kältezittern"
                            },
                            {
                                "target_lang_word": "das Frösteln",
                                "target_lang_sense_clarification": "leichtes Zittern vor Kälte"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}