                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd5eadcb-e73f-3d79-82f8-4f7e5e1071d8",
                    "sense_definition": "voltooid deelwoord van <w>ontroeren</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling was <w>ontroerd</w> en aangeslagen door wat er vanmiddag in de klas was gebeurd.",
                            "target_lang_translations": {
                                "en": "The student was <w>moved</w> and shaken by what had happened in class this afternoon.",
                                "ru": "Ученик был <w>взволнован</w> и потрясен тем, что произошло сегодня днем в классе.",
                                "fr": "L'élève était <w>ému</w> et bouleversé par ce qui s'était passé cet après-midi en classe."
                            }
                        },
                        {
                            "text": "Ik was erg <w>ontroerd</w> door haar bezorgdheid, maar ook door haar praktische advies.",
                            "target_lang_translations": {
                                "en": "I was very <w>touched</w> by her concern, but also by her practical advice.",
                                "ru": "Я был очень <w>тронут</w> ее заботой, а также ее практическим советом.",
                                "fr": "J'ai été très <w>touché</w> par son inquiétude, mais aussi par ses conseils pratiques."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'ontroeren' (to move/touch emotionally)",
                        "ru": "причастие прошедшего времени от глагола «трогать» (вызывать душевное волнение)",
                        "fr": "participe passé du verbe « ontroeren » (émouvoir)"
                    },
