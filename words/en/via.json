    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "10c8e830-9808-3763-98f7-0801a51ff575",
                    "sense_definition": "By way of; passing through a specific place on a journey.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prep_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They drove from New York to Los Angeles <w>via</w> Omaha.",
                            "target_lang_translations": {
                                "ru": "Они ехали из Нью-Йорка в Лос-Анджелес <w>через</w> Омаху.",
                                "zh": "他们开车从纽约出发，<w>经</w>奥马哈前往洛杉矶。"
                            }
                        },
                        {
                            "text": "You can enter the building <w>via</w> the western gate.",
                            "target_lang_translations": {
                                "ru": "Вы можете войти в здание <w>через</w> западные ворота.",
                                "zh": "你可以<w>通过</w>西门进入大楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "through",
                        "by way of"
                    ],
                    "common_phrases": [
                        "via London",
                        "fly via",
                        "travel via"
                    ],
                    "target_lang_definitions": {
                        "ru": "Через; проезжая через определенное место во время путешествия.",
                        "zh": "经由；在旅途中经过某个特定地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "че́рез",
                                "target_lang_sense_clarification": "сквозь, пересекая пространство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经",
                                "target_lang_sense_clarification": "经过，通过"
                            },
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "经过某地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07dd2d69-e6f0-3ee6-8ed4-82af5d8a7617",
                    "sense_definition": "By means of; using a specific system, person, or medium to send or achieve something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "prep_method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will send you the information <w>via</w> e-mail later today.",
                            "target_lang_translations": {
                                "ru": "Я отправлю вам информацию <w>по</w> электронной почте сегодня позже.",
                                "zh": "我今天晚些时候会<w>通过</w>电子邮件把信息发给你。"
                            }
                        },
                        {
                            "text": "The two leaders communicated <w>via</w> intermediaries to avoid a direct conflict.",
                            "target_lang_translations": {
                                "ru": "Два лидера общались <w>через</w> посредников, чтобы избежать прямого конфликта.",
                                "zh": "两位领导人<w>经由</w>中间人进行沟通，以避免直接冲突。"
                            }
                        }
                    ],
                    "synonyms": [
                        "using",
                        "through",
                        "by means of"
                    ],
                    "common_phrases": [
                        "via email",
                        "via the internet",
                        "contact via"
                    ],
                    "target_lang_definitions": {
                        "ru": "С помощью; используя определенную систему, человека или средство для передачи или достижения чего-либо.",
                        "zh": "借由；使用特定的系统、人员或媒介来发送或达成某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "че́рез",
                                "target_lang_sense_clarification": "используя посредника или средство"
                            },
                            {
                                "target_lang_word": "посре́дством",
                                "target_lang_sense_clarification": "формально: при помощи"
                            },
                            {
                                "target_lang_word": "по",
                                "target_lang_sense_clarification": "о каналах связи (по почте, по радио)"
                            },
                            {
                                "target_lang_word": "с по́мощью",
                                "target_lang_sense_clarification": "при содействии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "借由某种手段或媒介"
                            },
                            {
                                "target_lang_word": "经由",
                                "target_lang_sense_clarification": "通过某人或某渠道"
                            },
                            {
                                "target_lang_word": "用",
                                "target_lang_sense_clarification": "使用某种方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e1cd0c2-641d-346b-b3ad-97d01ddcc924",
                    "sense_definition": "A small hole or electrical connection in a printed circuit board that connects different layers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer inspected the <w>via</w> to ensure the circuit layers were properly connected.",
                            "target_lang_translations": {
                                "ru": "Инженер осмотрел <w>переходное отверстие</w>, чтобы убедиться, что слои схемы соединены правильно.",
                                "zh": "工程师检查了<w>过孔</w>，以确保电路层连接正确。"
                            }
                        },
                        {
                            "text": "Designing a complex board requires placing each <w>via</w> carefully to save space.",
                            "target_lang_translations": {
                                "ru": "Проектирование сложной платы требует тщательного размещения каждого <w>переходного отверстия</w> для экономии места.",
                                "zh": "设计复杂的电路板需要仔细放置每一个<w>过孔</w>以节省空间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое отверстие или электрическое соединение в печатной плате, соединяющее различные слои.",
                        "zh": "印刷电路板上的小孔或电气连接，用于连接不同的层。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переходное отверстие",
                                "target_lang_sense_clarification": "эл.: межслойное соединение в печатной плате (via)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过孔",
                                "target_lang_sense_clarification": "电子工程术语，指电路板层间连接孔"
                            }
                        ]
                    }
