                                                "sense_id": "d71560cf-48c9-3450-a73f-65172b370374",
                                                "text": "All diesen Leuten ist die Muttersprache Deutsch gemein."
                                            },
                                            {
                                                "example_id": "9d1c2286-7443-42ef-a2d1-3cb8bb29d384",
                                                "sense_id": "d71560cf-48c9-3450-a73f-65172b370374",
                                                "text": "Hier wächst eine Gemeine Schlüsselblume."
                                            },
