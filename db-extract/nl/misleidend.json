                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "misleading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "862e8200-b646-3c34-9f2d-1e7d66fb2512",
                                        "entry_id": "39a1f7b1-bea0-310b-a25e-b224238756bc",
                                        "glosses": [
                                            "A deception that misleads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb6b6024-864a-49bd-8f6f-e785b96f3523",
                                                "sense_id": "862e8200-b646-3c34-9f2d-1e7d66fb2512",
                                                "text": "According to this tradition, acts of deception that are mere misleadings are morally better than acts of deception that are lies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ed4b3c9-5179-4555-8d51-98c0121b024d",
                        "source_entry_id": "c1ecf683-9e1c-3473-863d-1e5f0acce43f",
                        "source_sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                        "target_lang_word": "deceptive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deceptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                        "entry_id": "84bba890-4bca-31d3-992a-27b7e857d9f9",
                                        "glosses": [
                                            "Likely or attempting to deceive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03acf1f4-11bb-4023-8e17-28c0bc73c263",
                                                "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                                "text": "deceptive practices"
                                            },
                                            {
                                                "example_id": "cb61f51a-8eca-4ef8-950f-cb4a11736bd3",
                                                "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                                "text": "Appearances can be deceptive."
                                            },
                                            {
                                                "example_id": "1710de6b-01dc-482f-81a4-ac5926a328b3",
                                                "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                                "text": "[…] others declare that no Creature can be made or transmuted into a better or worse, or transformed into another species […] and Martinus Delrio the Jesuit accounts this degeneration of Man into a Beast to be an illusion, deceptive and repugnant to Nature;"
                                            },
                                            {
                                                "example_id": "6156aa4a-ae56-4ea9-9d30-52da5c90c950",
                                                "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                                "text": "[…] at the opening of the campaign, the French, after various deceptive attempts on different places, suddenly invested Tournay."
                                            },
                                            {
                                                "example_id": "5cf3fe89-4389-4fc4-bfb9-95ecd164483d",
                                                "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                                "text": "1846, Richard Chenevix Trench, Notes on the Miracles of Our Lord, London: John W. Parker, 2nd ed., 1847, Preliminary Essay, Chapter 2, p. 10,\nlanguage altogether deceptive, and hiding the deeper reality from our eyes"
                                            },
                                            {
                                                "example_id": "b5b89f95-797e-42a2-9e7f-fc7d73f5fd09",
                                                "sense_id": "7a2be40a-4337-3f76-be2a-9283e6b99dfa",
                                                "text": "[…] it is characteristic of TB that many of its symptoms are deceptive—liveliness that comes from enervation, rosy cheeks that look like a sign of health but come from fever—and an upsurge of vitality may be a sign of approaching death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
