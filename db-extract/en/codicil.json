                                            {
                                                "example_id": "88b69951-8ad2-47f7-a138-a38308af2373",
                                                "sense_id": "588b03d6-e9c5-32cb-b24d-36a6cc30e596",
                                                "text": "De juiste antwoorden op de vragen zijn gegeven in het aanhangsel achter in het boek."
                                            }
                                        ]
