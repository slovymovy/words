{
    "word_family": [
        "perception",
        "perceptible",
        "imperceptible",
        "percepteur",
        "perceptif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9e45a01-2df4-363b-a147-0556e8e5ea91",
                    "sense_definition": "Saisir ou distinguer par l'un des sens, en particulier la vue ou l'ouïe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sensory_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le silence de la nuit, on pouvait <w>percevoir</w> un léger bruit au rez-de-chaussée."
                        },
                        {
                            "text": "De loin, le randonneur <w>perçoit</w> une faible lueur entre les grands arbres."
                        }
                    ],
                    "synonyms": [
                        "discerner",
                        "distinguer",
                        "entendre"
                    ],
                    "common_phrases": [
                        "percevoir un bruit",
                        "percevoir une lueur"
                    ]
                },
                {
                    "sense_id": "1d5e9c87-43f8-3abb-9af3-55eca8725075",
                    "sense_definition": "Comprendre, appréhender ou interpréter intellectuellement une situation ou une idée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cognitive_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque témoin <w>perçoit</w> la réalité de cet accident selon son propre point de vue."
                        },
                        {
                            "text": "Il n'a pas réussi à <w>percevoir</w> le danger avant qu'il ne soit trop tard."
                        }
                    ],
                    "synonyms": [
                        "appréhender",
                        "comprendre",
                        "concevoir",
                        "saisir"
                    ],
                    "common_phrases": [
                        "percevoir le danger",
                        "percevoir la réalité"
                    ]
                },
                {
                    "sense_id": "5300af9b-93ff-31a4-8994-2dba5358e5c4",
                    "sense_definition": "Recevoir ou encaisser une somme d'argent qui est due, comme des impôts ou une rémunération.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'administration fiscale est chargée de <w>percevoir</w> les impôts auprès des contribuables."
                        },
                        {
                            "text": "Chaque début de mois, cet employé modèle <w>perçoit</w> un salaire directement sur son compte."
                        }
                    ],
                    "synonyms": [
                        "encaisser",
                        "prélever",
                        "recouvrer",
                        "toucher"
                    ],
                    "antonyms": [
                        "débourser",
                        "payer",
                        "verser"
                    ],
                    "common_phrases": [
                        "percevoir des impôts",
                        "percevoir un salaire"
                    ]
                }
            ]
        }
    ]
}