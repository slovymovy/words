                "senses": [
                    {
                        "sense_id": "6f95304e-25b5-30a9-adfc-d0e94b2d82a9",
                        "entry_id": "9e5dbe1a-b6d2-34ab-a2d3-831bb736bfdc",
                        "glosses": [
                            "Waren aus Stoff für die Innenausstattung und Innendekoration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722d0c03-7b8c-4041-bbca-77b1848c2c1c",
                                "sense_id": "6f95304e-25b5-30a9-adfc-d0e94b2d82a9",
                                "text": "„Alleinstehende ältere Menschen können durch solche Sensoren in der Kleidung telemedizinisch betreut werden. In Heimtextilien eingearbeitet, soll Bettwäsche bald gut riechen und gesund machen, Gardinen sollen Zigarettenmief schlucken und vor Elektrosmog schützen, Markisen sollen keine Algen mehr anhaften können, und sie sollen sich bei starker Sonneneinstrahlung automatisch verdunkeln können. In so genannten technischen Textilien stecken mit die größten Wachstumpotenziale (siehe Interview). Zu ihnen zählen Gewebe für Airbags und Autoreifen, Papiermaschinenfilze und Förderbänder, Filter und Kunststoffverbundstoffe, aus denen Flugzeugteile und Fahrradrahmen gefertigt werden. “"
                            },
                            {
                                "example_id": "7d915aa3-70a4-4145-898e-41a13c288520",
                                "sense_id": "6f95304e-25b5-30a9-adfc-d0e94b2d82a9",
                                "text": "„Die vielfältigen Wohnaccessoires der Abteilungen Boutique, Haushaltswaren, Lampen, Heimtextilien oder Baby runden das perfekte Einkaufserlebnis für das Wohlfühl-Zuhause ab. (Quelle: www.pressetext.at, )“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
