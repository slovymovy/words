                            {
                                "example_id": "6ab6b06f-0f29-4faf-b363-f98aa46b265f",
                                "sense_id": "1cbf5239-d7eb-3f06-a961-305546901849",
                                "text": "tradycyjne garncarstwo",
                                "translation": "traditional pottery",
                                "english": "traditional pottery"
                            },
                            {
                                "example_id": "8c95cc19-793e-4d30-82bf-f52e45fcb08f",
