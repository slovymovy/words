{
    "word_family": [
        "reconciliation",
        "reconciler",
        "reconcilable",
        "irreconcilable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f574f881-9060-3e04-9486-44b66c2771c2",
                    "sense_definition": "To find a way in which two situations or beliefs that are opposed to each other can agree and exist together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is sometimes difficult to <w>reconcile</w> career ambitions with the desire to spend time with family.",
                            "target_lang_translations": {
                                "ru": "Иногда бывает трудно <w>совместить</w> карьерные амбиции с желанием проводить время с семьей."
                            }
                        },
                        {
                            "text": "The committee is trying to <w>reconcile</w> differences between the two versions of the bill.",
                            "target_lang_translations": {
                                "ru": "Комитет пытается <w>сгладить</w> разногласия между двумя версиями законопроекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmonize",
                        "coordinate",
                        "resolve"
                    ],
                    "antonyms": [
                        "clash",
                        "differ"
                    ],
                    "common_phrases": [
                        "reconcile differences",
                        "reconcile competing interests",
                        "reconcile conflicting views"
                    ],
                    "target_lang_definitions": {
                        "ru": "Найти способ, при котором две противоположные ситуации или убеждения могут соответствовать друг другу и сосуществовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примирить",
                                "target_lang_sense_clarification": "противоречия или разные взгляды"
                            },
                            {
                                "target_lang_word": "согласовать",
                                "target_lang_sense_clarification": "разные интересы или планы"
                            },
                            {
                                "target_lang_word": "увязать",
                                "target_lang_sense_clarification": "противоположные концепции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2ac7bda-e671-3a10-9c30-d15f2c1094ae",
                    "sense_definition": "To restore friendly relations between people who have argued or disagreed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of not speaking, the two brothers finally managed to <w>reconcile</w> their relationship.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев молчания двум братьям наконец удалось <w>восстановить</w> свои отношения."
                            }
                        },
                        {
                            "text": "The mediator worked hard to <w>reconcile</w> the parties involved in the dispute.",
                            "target_lang_translations": {
                                "ru": "Посредник упорно трудился, чтобы <w>примирить</w> стороны, участвующие в споре."
                            }
                        }
                    ],
                    "synonyms": [
                        "reunite",
                        "pacify",
                        "make up"
                    ],
                    "antonyms": [
                        "estrange",
                        "alienate"
                    ],
                    "common_phrases": [
                        "reconcile with someone",
                        "reconcile a quarrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить дружеские отношения между людьми после ссоры или разногласий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помирить",
                                "target_lang_sense_clarification": "кого-либо между собой"
                            },
                            {
                                "target_lang_word": "примирить",
                                "target_lang_sense_clarification": "враждующие стороны"
                            },
                            {
                                "target_lang_word": "помириться",
                                "target_lang_sense_clarification": "с кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb2f260-d630-3f93-95fc-67b33560f4e4",
                    "sense_definition": "To compare two sets of records, such as a bank statement and a checkbook, to ensure they are consistent and accurate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "accounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant needs to <w>reconcile</w> the accounts at the end of every month.",
                            "target_lang_translations": {
                                "ru": "Бухгалтеру необходимо <w>сверять</w> счета в конце каждого месяца."
                            }
                        },
                        {
                            "text": "It took several hours to <w>reconcile</w> the bank statement with our internal financial records.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько часов, чтобы <w>сопоставить</w> банковскую выписку с нашими внутренними финансовыми отчетами."
                            }
                        }
                    ],
                    "synonyms": [
                        "balance",
                        "square",
                        "settle"
                    ],
                    "common_phrases": [
                        "reconcile the accounts",
                        "reconcile a bank statement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in accounting and finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнить два набора записей, чтобы убедиться в их соответствии и точности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверять",
                                "target_lang_sense_clarification": "отчеты или счета"
                            },
                            {
                                "target_lang_word": "сопоставлять",
                                "target_lang_sense_clarification": "данные для проверки"
                            },
                            {
                                "target_lang_word": "проводить сверку",
                                "target_lang_sense_clarification": "бухгалтерских записей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}