{
    "word_family": [
        "agregacja",
        "agregatowy",
        "agregować",
        "zagregować"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e065f507-ea09-3192-9d3b-dd23fc042298",
                    "sense_definition": "zespół połączonych ze sobą maszyn lub urządzeń działających wspólnie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "urządzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W razie nagłej awarii prądu w szpitalu od razu włącza się <w>agregat</w> prądotwórczy.",
                            "target_lang_translations": {
                                "ru": "В случае внезапного отключения электричества в больнице сразу же включается генераторный <w>агрегат</w>."
                            }
                        },
                        {
                            "text": "Do pracy na budowie kupiliśmy nowy, bardzo wydajny <w>agregat</w>.",
                            "target_lang_translations": {
                                "ru": "Для работы на стройке мы купили новый, очень производительный <w>агрегат</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agregat prądotwórczy",
                        "agregat chłodniczy",
                        "agregat malarski"
                    ],
                    "target_lang_definitions": {
                        "ru": "комплекс соединённых между собой машин или устройств, работающих совместно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агрегат",
                                "target_lang_sense_clarification": "машина или комплекс устройств"
                            },
                            {
                                "target_lang_word": "генератор",
                                "target_lang_sense_clarification": "в контексте выработки электроэнергии"
                            },
                            {
                                "target_lang_word": "установка",
                                "target_lang_sense_clarification": "техническое оборудование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b510ecac-10ce-3fe0-8135-e5594abf45a9",
                    "sense_definition": "nietuzinkowy człowiek, często zachowujący się w sposób zabawny, dziwaczny lub sprytny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "człowiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten twój brat to niezły <w>agregat</w>, rozbawił wszystkich swoimi opowieściami.",
                            "target_lang_translations": {
                                "ru": "Твой брат — тот ещё <w>кадр</w>, рассмешил всех своими историями."
                            }
                        },
                        {
                            "text": "Z niego jest prawdziwy <w>agregat</w>, potrafi wyjść z każdej opresji bez szwanku.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>фрукт</w>, умудряется выходить сухим из любой передряги."
                            }
                        }
                    ],
                    "synonyms": [
                        "aparat",
                        "model"
                    ],
                    "common_phrases": [
                        "niezły agregat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie osoby"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "неординарный, комичный или хитрый человек с необычным поведением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "чудной, забавный человек"
                            },
                            {
                                "target_lang_word": "фрукт",
                                "target_lang_sense_clarification": "своеобразный или хитрый тип"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "необычный персонаж"
                            },
                            {
                                "target_lang_word": "экземпляр",
                                "target_lang_sense_clarification": "неординарный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "724d5415-71eb-37be-aa95-470e1827cb52",
                    "sense_definition": "zbiór powiązanych ze sobą elementów tworzących pewną całość",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zbiór",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W analizie statystycznej traktujemy te zmienne jako jeden spójny <w>agregat</w>.",
                            "target_lang_translations": {
                                "ru": "В статистическом анализе мы рассматриваем эти переменные как один целостный <w>агрегат</w>."
                            }
                        },
                        {
                            "text": "Badacze wyodrębnili nowy <w>agregat</w> danych do dalszych testów laboratoryjnych.",
                            "target_lang_translations": {
                                "ru": "Исследователи выделили новую <w>совокупность</w> данных для дальнейших лабораторных испытаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbiór"
                    ],
                    "common_phrases": [
                        "agregat danych",
                        "agregat makroekonomiczny"
                    ],
                    "target_lang_definitions": {
                        "ru": "совокупность взаимосвязанных элементов, составляющих единое целое"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агрегат",
                                "target_lang_sense_clarification": "совокупность элементов, система"
                            },
                            {
                                "target_lang_word": "совокупность",
                                "target_lang_sense_clarification": "множество объединённых элементов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5ea56d5-ab2e-35ea-a76e-c4cf00274ea6",
                    "sense_definition": "skupienie cząstek tworzących większą bryłę lub strukturę geologiczną czy chemiczną",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "materia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pod mikroskopem było widać, jak pojedyncze minerały łączą się w większy <w>agregat</w>.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом было видно, как отдельные минералы объединяются в более крупный <w>агрегат</w>."
                            }
                        },
                        {
                            "text": "Gleba o dobrej strukturze składa się z trwałych <w>agregatów</w> gruzełkowatych.",
                            "target_lang_translations": {
                                "ru": "Почва с хорошей структурой состоит из прочных комковатых <w>агрегатов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agregat glebowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "скопление частиц, образующее единое тело или геологическую структуру"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агрегат",
                                "target_lang_sense_clarification": "скопление частиц, минеральное срастание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d85f5ca8-8edd-3d3d-8f49-1c6625b4db15",
                    "sense_definition": "samoręcznie zrobiona grzałka elektryczna do gotowania wody",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przedmiot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W celi więziennej woda była podgrzewana przez prowizoryczny <w>agregat</w> z żyletek.",
                            "target_lang_translations": {
                                "ru": "В тюремной камере воду грели самодельным <w>кипятильником</w> из бритвенных лезвий."
                            }
                        },
                        {
                            "text": "Więźniowie zrobili prosty <w>agregat</w>, aby zaparzyć sobie herbatę.",
                            "target_lang_translations": {
                                "ru": "Заключённые смастерили простой <w>кипятильник</w>, чтобы заварить себе чай."
                            }
                        }
                    ],
                    "synonyms": [
                        "gwara więzienna buzała"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gwara więzienna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "самодельный электрический кипятильник для воды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кипятильник",
                                "target_lang_sense_clarification": "самодельное устройство для кипячения воды"
                            },
                            {
                                "target_lang_word": "бульбулятор",
                                "target_lang_sense_clarification": "тюремный самодельный кипятильник из лезвий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}