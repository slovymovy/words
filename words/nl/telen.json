                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "general term for plants"
                            },
                            {
                                "target_lang_word": "cultivate",
                                "target_lang_sense_clarification": "on a professional or large scale"
                            },
                            {
                                "target_lang_word": "farm",
                                "target_lang_sense_clarification": "as an agricultural activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef1e71f0-038f-30e8-a008-4b68151fdd64",
                    "sense_definition": "met veel zorg en aandacht planten of bloemen laten groeien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>teelt</w> al jaren prachtige orchideeën in zijn warme kas.",
                            "target_lang_translations": {
                                "en": "He has been <w>growing</w> beautiful orchids in his greenhouse for years."
                            }
                        },
                        {
                            "text": "Het is een kunst om zulke zeldzame bloemen succesvol te <w>telen</w>.",
                            "target_lang_translations": {
                                "en": "It is an art to successfully <w>cultivate</w> such rare flowers."
                            }
                        }
                    ],
                    "synonyms": [
                        "kweken"
                    ],
                    "common_phrases": [
                        "bloemen telen",
                        "orchideeën telen"
                    ],
                    "target_lang_definitions": {
                        "en": "Growing plants or flowers with great care and attention."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cultivate",
                                "target_lang_sense_clarification": "nurturing plants carefully"
                            },
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "tending to plants"
                            },
                            {
                                "target_lang_word": "breed",
                                "target_lang_sense_clarification": "developing specific plant varieties"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21e6f39f-3adf-3580-8eed-ea7f61826f4e",
                    "sense_definition": "het houden en vermeerderen van dieren, of figuurlijk het voortbrengen van nageslacht",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voortplanting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>telen</w> bijen voor honing en de bestuiving van de fruitbomen.",
                            "target_lang_translations": {
                                "en": "They <w>keep</w> bees for honey and the pollination of the fruit trees."
                            }
                        },
                        {
                            "text": "Op de boerderij <w>telen</w> ze koeien voor melk en vleesproductie.",
                            "target_lang_translations": {
                                "en": "On the farm, they <w>breed</w> cows for milk and meat production."
                            }
                        }
                    ],
                    "synonyms": [
                        "kweken",
                        "verbouwen"
                    ],
                    "common_phrases": [
                        "bijen telen",
                        "vee telen"
