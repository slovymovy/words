                                        "entry_id": "361b12f4-16ba-3098-a9eb-808d75032a5d",
                                        "glosses": [
                                            "Not applicable; that does not apply or cannot be applied; unsuitable or irrelevant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd51e10-8e43-47c6-8396-b21aa8581860",
                                                "sense_id": "f8a61f5e-fc0a-35a3-8148-e08a7da83b7d",
                                                "text": "The argument is inapplicable to the case."
                                            },
                                            {
                                                "example_id": "dd4f349c-b258-4d34-b226-f4ed75831f94",
                                                "sense_id": "f8a61f5e-fc0a-35a3-8148-e08a7da83b7d",
                                                "text": "In this case, y(#92;cdot) is not single-valued at any price vector allowing for nonzero production, making Hotelling's lemma inapplicable at these prices."
                                            }
                                        ]
                                    }
