                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицо",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "grammatical category (first, second, third person)"
                            }
                        ]
