            {
                "entry_id": "c7c35586-2b38-3a91-87c3-bf44cb561eef",
                "word": "berthe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ade1386-a3dd-4090-bbde-2d6ece9fe21d",
                        "entry_id": "c7c35586-2b38-3a91-87c3-bf44cb561eef",
                        "tags": [
