                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56a25891-3855-4525-a856-1040deb43600",
                                "sense_id": "7d9d1f99-7a25-3fc9-be48-93db3029fba2",
                                "text": "Wzdłuż esplanady magnat wystawił część z 3 tys. dzieł sztuki, które tu zdążył zwieźć ze świata"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "52141c2d-30fe-3fb4-9140-c2e847ffee3d",
                        "entry_id": "f14b7ea7-0051-3c5b-a212-7d6d8c409a23",
                        "glosses": [
                            "plac przed dużym budynkiem, najczęściej sakralnym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ef46cb-95ec-477d-b8fb-acc413a7e404",
                                "sense_id": "52141c2d-30fe-3fb4-9140-c2e847ffee3d",
                                "text": "Ogromny plac, przed wybudowaną w 1953 roku neobarokową bazyliką, zwany esplanadą, może jednorazowo pomieścić nawet milion wiernych"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
