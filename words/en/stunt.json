{
    "word_family": [
        "stuntman",
        "stuntwoman",
        "stunter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b684a13c-1d6d-304f-abb3-c46598347b96",
                    "sense_definition": "A daring or dangerous action, usually performed to entertain people or show skill.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_feat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The action movie features incredible car <w>stunts</w> that look very realistic.",
                            "target_lang_translations": {
                                "ru": "В этом боевике показаны невероятные автомобильные <w>трюки</w>, которые выглядят очень реалистично.",
                                "zh": "这部动作片里有看起来非常逼真的惊人汽车<w>特技</w>。"
                            }
                        },
                        {
                            "text": "Please do not try this dangerous <w>stunt</w> at home.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не пытайтесь повторить этот опасный <w>трюк</w> дома.",
                                "zh": "请不要在家里尝试这种危险的<w>特技</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feat",
                        "exploit",
                        "trick"
                    ],
                    "common_phrases": [
                        "perform a stunt",
                        "dangerous stunt",
                        "movie stunt",
                        "daring stunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смелое или опасное действие, обычно выполняемое для развлечения публики или демонстрации мастерства.",
                        "zh": "一种大胆或危险的动作，通常是为了娱乐大众或展示技巧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "опасный или зрелищный прием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特技",
                                "target_lang_sense_clarification": "电影或表演中的高难度动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3741813-bfc4-3bed-9dd9-d3cd278d5237",
                    "sense_definition": "Something done mainly to attract attention or publicity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_feat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people believe the scandal was just a <w>stunt</w> to sell more records.",
                            "target_lang_translations": {
                                "ru": "Многие считают, что этот скандал был всего лишь <w>трюком</w> для увеличения продаж пластинок.",
                                "zh": "许多人认为这起丑闻只是为了多卖唱片而搞的<w>噱头</w>。"
                            }
                        },
                        {
                            "text": "The politician's speech was dismissed as a mere campaign <w>stunt</w>.",
                            "target_lang_translations": {
                                "ru": "Речь политика отвергли как простой предвыборный <w>пиар-ход</w>.",
                                "zh": "这位政客的演讲被认为仅仅是一场竞选<w>炒作</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gimmick"
                    ],
                    "common_phrases": [
                        "publicity stunt",
                        "political stunt",
                        "media stunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, совершаемое главным образом для привлечения внимания или рекламы.",
                        "zh": "主要为了吸引注意力或进行宣传而采取的行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиар-ход",
                                "target_lang_sense_clarification": "рекламный ход"
                            },
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "уловка для привлечения внимания"
                            },
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "噱头",
                                "target_lang_sense_clarification": "为了招徕顾客或吸引注意而搞的花招"
                            },
                            {
                                "target_lang_word": "炒作",
                                "target_lang_sense_clarification": "通过宣传手段制造舆论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2252b52d-76b3-3b52-8065-1b35c33f32ca",
                    "sense_definition": "A stupid or annoying trick or action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_feat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you pull another <w>stunt</w> like that, you will be fired.",
                            "target_lang_translations": {
                                "ru": "Если ты выкинешь еще одну такую <w>выходку</w>, тебя уволят.",
                                "zh": "如果你再搞这种<w>把戏</w>，你就会被解雇。"
                            }
                        },
                        {
                            "text": "Hiding my keys was a childish <w>stunt</w> that made us late.",
                            "target_lang_translations": {
                                "ru": "Прятать мои ключи было ребяческой <w>выходкой</w>, из-за которой мы опоздали.",
                                "zh": "藏起我的钥匙是一种幼稚的<w>胡闹</w>，导致我们迟到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "prank"
                    ],
                    "common_phrases": [
                        "pull a stunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупая или раздражающая выходка или поступок.",
                        "zh": "愚蠢或令人恼火的恶作剧或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "неразумный поступок"
                            },
                            {
                                "target_lang_word": "номер",
                                "target_lang_sense_clarification": "разг., неожиданный поступок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "把戏",
                                "target_lang_sense_clarification": "不光彩的手段或恶作剧"
                            },
                            {
                                "target_lang_word": "胡闹",
                                "target_lang_sense_clarification": "不负责任的捣乱行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33b1480c-5f82-3e77-96b6-258acf884787",
                    "sense_definition": "To prevent or slow down the growth or development of someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of proper nutrition can <w>stunt</w> a child's physical growth.",
                            "target_lang_translations": {
                                "ru": "Недостаток правильного питания может <w>задержать</w> физический рост ребенка.",
                                "zh": "缺乏适当的营养会<w>阻碍</w>儿童的身体发育。"
                            }
                        },
                        {
                            "text": "The economic crisis threatened to <w>stunt</w> the progress of the new project.",
                            "target_lang_translations": {
                                "ru": "Экономический кризис грозил <w>затормозить</w> прогресс нового проекта.",
                                "zh": "经济危机威胁到了新项目的进展，可能会<w>抑制</w>其发展。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hinder",
                        "impede",
                        "hamper",
                        "inhibit"
                    ],
                    "antonyms": [
                        "encourage",
                        "foster",
                        "promote"
                    ],
                    "common_phrases": [
                        "stunt growth",
                        "stunt development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предотвращать или замедлять рост или развитие кого-либо или чего-либо.",
                        "zh": "阻碍或减缓某人或某事物的生长或发展。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "рост или развитие"
                            },
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "препятствовать прогрессу"
                            },
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "мешать развитию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻碍",
                                "target_lang_sense_clarification": "使发展受阻"
                            },
                            {
                                "target_lang_word": "抑制",
                                "target_lang_sense_clarification": "压制生长或发展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8f95c39-798e-3aec-86f0-e8aac638c952",
                    "sense_definition": "To show off or flaunt one's wealth, success, or possessions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "show_off",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loves to <w>stunt</w> in his expensive new car whenever he visits his hometown.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>понтоваться</w> своей новой дорогой машиной, когда приезжает в родной город.",
                                "zh": "他每次回老家都喜欢开着那辆昂贵的新车到处<w>炫耀</w>。"
                            }
                        },
                        {
                            "text": "There is no need to <w>stunt</w> on us just because you got a promotion.",
                            "target_lang_translations": {
                                "ru": "Не нужно перед нами <w>выпендриваться</w> только потому, что ты получил повышение.",
                                "zh": "没必要因为你升职了就在我们面前<w>显摆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "show off",
                        "flaunt",
                        "posture"
                    ],
                    "common_phrases": [
                        "stunt on someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in hip-hop culture and AAVE"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выставлять напоказ свое богатство, успех или имущество; хвастаться.",
                        "zh": "炫耀自己的财富、成就或所有物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понтоваться",
                                "target_lang_sense_clarification": "жарг., хвастаться"
                            },
                            {
                                "target_lang_word": "выпендриваться",
                                "target_lang_sense_clarification": "разг., вести себя вызывающе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炫耀",
                                "target_lang_sense_clarification": "夸耀自己的长处或所有物"
                            },
                            {
                                "target_lang_word": "显摆",
                                "target_lang_sense_clarification": "口语，指炫耀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db38d9f5-ca6d-3962-97c0-638a3b42fd8b",
                    "sense_definition": "To perform a daring action or trick.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_feat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot <w>stunted</w> above the crowd, performing loops and rolls.",
                            "target_lang_translations": {
                                "ru": "Пилот <w>делал трюки</w> над толпой, выполняя мертвые петли и бочки.",
                                "zh": "飞行员在人群上方<w>表演特技</w>，做出了翻滚和盘旋动作。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>stunting</w> on his skateboard at the park.",
                            "target_lang_translations": {
                                "ru": "Он провел день, <w>выполняя трюки</w> на скейтборде в парке.",
                                "zh": "他整个下午都在公园里玩滑板<w>表演特技</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять смелые действия или трюки.",
                        "zh": "表演大胆的动作或特技。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать трюки",
                                "target_lang_sense_clarification": "исполнять акробатические номера"
                            },
                            {
                                "target_lang_word": "трюкачить",
                                "target_lang_sense_clarification": "разг., лихачить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表演特技",
                                "target_lang_sense_clarification": "展示高难度动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}