                                            {
                                                "example_id": "ed0228ce-b309-41f1-b864-07a15d7f1bd9",
                                                "sense_id": "5bf01a0a-71be-3b66-82ee-fa0c153627ad",
                                                "text": "We're gonna make the stars come out tonight. So why don't you reload,reload, re reload the music?"
                                            },
                                            {
                                                "example_id": "d3eaeeb0-fc4e-42f5-b65b-359e6597324c",
                                                "sense_id": "5bf01a0a-71be-3b66-82ee-fa0c153627ad",
                                                "text": "[Verse 2:Kano]:[…]Mad, reload ting. Pop, pop, pop that's a reload ting. And when I say \"It's Kano in the house\", everybody knows that's a reload ting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reload",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "052d894e-384a-3aaf-8ed3-944927afe706",
                                        "entry_id": "d931f9d2-1372-3d84-a5ac-aee9955ce797",
                                        "glosses": [
                                            "The process by which something is reloaded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca06f8d4-916b-468a-9d0e-16d58133e868",
                                                "sense_id": "052d894e-384a-3aaf-8ed3-944927afe706",
                                                "text": "Each reload of the weapon took about 30 seconds."
                                            },
                                            {
                                                "example_id": "dd58f0b9-b75d-4f15-b46c-fe23c340d9b8",
                                                "sense_id": "052d894e-384a-3aaf-8ed3-944927afe706",
                                                "text": "Waddicor will be here for a while. The double shunts take an hour. But it's a scheduled four-hour reload and layover, ahead of his return train back to Didcot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5332906f-0cd7-3aba-8289-54babc49bafa",
                                        "entry_id": "d931f9d2-1372-3d84-a5ac-aee9955ce797",
                                        "glosses": [
                                            "An ammunition cartridge prepared from previously fired ammunition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68cf191e-086e-3df4-ae45-58e308e9822b",
                                        "entry_id": "d931f9d2-1372-3d84-a5ac-aee9955ce797",
                                        "glosses": [
                                            "A repeated track on a DJ set."
                                        ],
