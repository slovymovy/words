                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccaa62ea-0267-375c-a179-b31fd87d587d",
                        "entry_id": "d55f0e88-a771-35ca-a749-218692dad6c7",
                        "glosses": [
                            "Art qui fait des lettres la matière première de la création, sans relation avec son utilité de représentation sonore ou sémantique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82419ba-3e9d-45d5-945c-9c4c7557d406",
                                "sense_id": "ccaa62ea-0267-375c-a179-b31fd87d587d",
                                "text": "Les anarchistes sont concernés dans la mesure où les anarchistes s’intéressent à l'art, parce que le lettrisme est à la pointe du plaisir en art, en fait à la pointe de la culture."
                            },
                            {
                                "example_id": "bd5f5954-2188-407e-ba5d-bde371403ae8",
                                "sense_id": "ccaa62ea-0267-375c-a179-b31fd87d587d",
                                "text": "Le lettrisme apporte, en 1950, l’hypergraphie (d’abord nommée « métagraphie »), art basé sur l’organisation des lettres et des signes, et considérée comme un dépassement à la fois de l’art plastique figuratif et abstrait, et aussi du roman à mots."
                            },
                            {
                                "example_id": "96254650-29f6-4413-ac72-9c8ebca023d9",
                                "sense_id": "ccaa62ea-0267-375c-a179-b31fd87d587d",
                                "text": "Cette passion l’a conduit à se concentrer sur le lettrisme, mouvement d’avant-garde théorisé en 1946 par Isidore Isou et Gabriel Pomerand, qui s’attache non au sens des mots mais à la poésie des sons."
                            }
                        ]
                    },
                    {
                        "sense_id": "562c2e8c-3a2e-31e7-925c-23ec357bd2a5",
                        "entry_id": "d55f0e88-a771-35ca-a749-218692dad6c7",
                        "glosses": [
                            "Capacité d’une personne, dans les situations de la vie courante, à lire un texte en le comprenant, ainsi qu’à utiliser et à communiquer une information écrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494bee7b-a127-4978-a0bd-cd9e9068521e",
                                "sense_id": "562c2e8c-3a2e-31e7-925c-23ec357bd2a5",
                                "text": "Lutter pour le lettrisme."
                            },
                            {
                                "example_id": "152e636c-c353-446b-88d6-5ac0de7ff299",
                                "sense_id": "562c2e8c-3a2e-31e7-925c-23ec357bd2a5",
                                "text": "Le lettrisme se voit défini comme la « capacité d'une personne, dans les situations de la vie courante, à lire un texte. »"
                            }
                        ]
                    }
                ],
