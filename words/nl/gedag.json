                        },
                        {
                            "text": "Ik moet nu echt gaan, dus ik kom even snel <w>gedag</w> zeggen.",
                            "target_lang_translations": {
                                "en": "I really have to go now, so I'm just coming to say a quick <w>goodbye</w>."
                            }
