                "senses": [
                    {
                        "sense_id": "88b5d2e4-0097-30c9-91d5-944dac5dc9c5",
                        "entry_id": "c8818f36-6962-3e45-bb01-fbb715f98b8b",
                        "glosses": [
                            "(männliche^☆) Person, die sach- und/oder fachkundig Geruchsstoffe und deren Geruch prüft; Geruchsprüfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9e5e6d-98bf-4da8-986b-2f6f31b5f5fa",
                                "sense_id": "88b5d2e4-0097-30c9-91d5-944dac5dc9c5",
                                "text": "„Blatt 1 der Richtlinie beschäftigt sich mit den Bewertungsmethoden sowie den Kriterien und Mindestanforderungen an die Geruchsprüfer, mit denen die Raumluft bezüglich der Akzeptanz, der Intensität und der Hedonik sensorisch beurteilt werden kann.“"
                            },
                            {
                                "example_id": "cb8dd10b-3d94-4e30-a193-c351de44f238",
                                "sense_id": "88b5d2e4-0097-30c9-91d5-944dac5dc9c5",
                                "text": "„Geruchsprüfer haben nicht nur die Aufgabe, toxisch relevante Wohnungsgerüche zu finden, sondern auch mindergiftige aber allergisierende Risikopotentiale aufzuspüren.“"
                            },
                            {
                                "example_id": "d0f4e0e7-9e12-4d17-bd98-ae3460ae1950",
                                "sense_id": "88b5d2e4-0097-30c9-91d5-944dac5dc9c5",
                                "text": "„Wenn es Bürgern stinkt, kommen Geruchsprüfer zum Einsatz.“"
                            },
                            {
                                "example_id": "fb377e8b-54db-4638-8e8a-0b16d8d33928",
                                "sense_id": "88b5d2e4-0097-30c9-91d5-944dac5dc9c5",
                                "text": "„Ob es etwas gebracht hat, haben nun regelmäßig geschulte Geruchsprüfer untersucht.“"
                            },
                            {
                                "example_id": "088d08f4-3292-4b36-b540-ced21f37e87a",
                                "sense_id": "88b5d2e4-0097-30c9-91d5-944dac5dc9c5",
                                "text": "„Dafür stehen dem Unternehmen rund 100 Probanden „Achselschweißlieferanten“ (Maxeiner) – und 30 ausgebildete Geruchsprüfer zur Verfügung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
