                                    {
                                        "sense_id": "4650c294-1ce4-3a9f-9517-922110b6f948",
                                        "entry_id": "82857171-bc0a-366a-9b6a-b3e4b88654c4",
                                        "glosses": [
                                            "Poema tradicional japonés, breve y sin rima, que suele tener tres versos de cinco, siete y cinco moras respectivamente, y basarse en la emoción de contemplar el mundo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0aef3a6-d737-4a52-9acd-c19cdf4e6a93",
                                                "sense_id": "4650c294-1ce4-3a9f-9517-922110b6f948",
                                                "text": "Los maestros de haiku nos enseñan que el poeta debe eliminarse de su poesía para que sus versos capten la esencia dinámica de la realidad."
                                            },
                                            {
                                                "example_id": "ea9ae317-c326-4110-8d40-df11e90b539a",
                                                "sense_id": "4650c294-1ce4-3a9f-9517-922110b6f948",
                                                "text": "Un haikú de uno de sus maestros del siglo XIII."
                                            },
                                            {
                                                "example_id": "472b6fc5-3abb-4a32-a724-298cf87800c2",
                                                "sense_id": "4650c294-1ce4-3a9f-9517-922110b6f948",
                                                "text": "Mikazuki ni chi wa oboro nari soba no hana."
                                            },
                                            {
                                                "example_id": "6210ce0a-fc10-4fc6-a9a9-1641051467dc",
                                                "sense_id": "4650c294-1ce4-3a9f-9517-922110b6f948",
                                                "text": "Con una luna naciente\nla tierra convertida en pura niebla\nde flor blanca de soba.)."
                                            },
                                            {
                                                "example_id": "e043492b-71fd-4dba-986e-102514a3b2fe",
                                                "sense_id": "4650c294-1ce4-3a9f-9517-922110b6f948",
                                                "text": "2 Poesía: Poema breve de tres líneas en cualquier lengua, casi siempre con énfasis en temas del entorno natural., que a menudo contiene siete sílabas en el segundo verso y cinco en el primero y tercero."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
