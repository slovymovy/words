                "senses": [
                    {
                        "sense_id": "e4290250-6fd7-30c7-9646-154c715ab87e",
                        "entry_id": "4b47b045-a8c6-3994-84dc-b00624a74ff8",
                        "glosses": [
                            "eine Person, die längere Zeit im Ausland arbeitet; die aus der Heimat fortgegangen ist"
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "e1df1376-f3e3-484a-bd4a-039a0d837932",
                                "sense_id": "e4290250-6fd7-30c7-9646-154c715ab87e",
                                "text": "„Von den 390 Angestellten (Oktober 2010) sind 282 Guineer und 108 Expatriates, davon die meisten aus Israel und Südamerika.“"
                            },
                            {
                                "example_id": "e7e9b214-3d7b-4d81-bc12-890d0aa99fc0",
                                "sense_id": "e4290250-6fd7-30c7-9646-154c715ab87e",
                                "text": "Auch andere Varianten beschreibt er, die zunächst paradox klingen – beispielsweise das Leben von Job-Nomaden, die sich bewusst dazu entschieden haben, als Expatriate eine Weile im Ausland zu leben."
                            },
                            {
                                "example_id": "753c1501-91c0-4062-8a30-95565064b59a",
                                "sense_id": "e4290250-6fd7-30c7-9646-154c715ab87e",
                                "text": "Doch der Traum vom Leben in der Ferne endet für viele mit Enttäuschungen: Laut einer Studie des Expatriate-Portals Just Landed empfinden 68 Prozent aller Auswanderer den Neustart im Ausland als \"schwieriger als erwartet\", 71 Prozent möchten irgendwann nach Deutschland zurück."
                            },
                            {
                                "example_id": "8b0335ec-d770-4e3c-a9e6-a878f612d6ef",
                                "sense_id": "e4290250-6fd7-30c7-9646-154c715ab87e",
                                "text": "Denn viele Expatriates scheitern nicht an der beruflichen Aufgabe, sondern an der neuen Lebenssituation im Ausland."
                            },
                            {
                                "example_id": "dfefc266-be13-40df-8a94-e49d7d3ff472",
                                "sense_id": "e4290250-6fd7-30c7-9646-154c715ab87e",
                                "text": "Ehemalige Expatriates berichten von einem Kulturschock - oft ist der alte Schreibtisch weg, die Kollegen sind einem fremd geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
