                        "glosses": [
                            "geld waarvoor nog geen bestemming is vastgesteld; geld dat men vrij kan gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "521e5857-89b3-4221-bff2-697bc67866b0",
                                "sense_id": "74ada1fc-0605-32cf-b3ef-17b6e977c170",
                                "text": "De grotere zakken geld die zij dit jaar binnen hopen te halen, verwachten de meeste Europese dealmakers via dividend weer uit te keren. Het overnemen van fondsen en het gebruiken van geldreserves voor organische groei hebben daarna prioriteit. Meer salaris en meer werknemers in dienst nemen staan onderaan de lijst."
                            },
                            {
                                "example_id": "12a5b042-8bb5-4ffa-a271-c86022daf547",
                                "sense_id": "74ada1fc-0605-32cf-b3ef-17b6e977c170",
                                "text": "Sluit u een kredietopening af, dan krijgt u een geldreserve ter beschikking die u vrij kunt besteden en terugbetalen op uw eigen tempo. Deze drie tips helpen de situatie onder controle te houden."
                            }
                        ]
