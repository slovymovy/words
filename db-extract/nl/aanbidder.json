                    {
                        "translation_id": "66a2ea81-61e9-457c-9a8b-6cb53e1b7de8",
                        "source_entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "source_sense_id": "cf0ec194-d0a8-3a49-a643-9b06ed06e720",
                        "source_sense_description": "vereerder van een goddelijk wezen",
                        "target_lang_word": "adorateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adorateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a41aa2cf-12c8-34f2-a4c1-f515979ffce3",
                                        "entry_id": "efeaafae-2c96-3536-b4be-61e6ccb77316",
                                        "glosses": [
                                            "Personne qui adore une divinité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f072a75-5a40-457f-95b2-7aa94dd67f18",
                                                "sense_id": "a41aa2cf-12c8-34f2-a4c1-f515979ffce3",
                                                "text": "L’autel préféré du roi était, sur le terrain du parc, un petit temple dédié à Démêtêr et Perséphone. Les deux déesses n’ayant plus d’adorateurs sur la terre, écoutaient avec bienveillance celui-ci, qui se souvenait d’elles."
                                            },
                                            {
                                                "example_id": "1dab1a60-79e1-4d83-9f41-72963ec58f82",
                                                "sense_id": "a41aa2cf-12c8-34f2-a4c1-f515979ffce3",
                                                "text": "[…]; et pourtant je vous étonnerais bien en vous disant qu'il existe encore dans les Vosges des adorateurs du soleil."
                                            },
                                            {
                                                "example_id": "0308292d-8ebc-4afe-93c1-73aa8baf5118",
                                                "sense_id": "a41aa2cf-12c8-34f2-a4c1-f515979ffce3",
                                                "text": "Vous avez, docteur, de bien curieuses fréquentations, dit-il d'un ton un peu méprisant, un représentant de ces mauvais moines adorateurs du démon ! Que les Chinois sérieux estiment un peu plus qu'un soldat, mais un peu moins qu'une prostituée !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb4e61f-25ff-3620-88ec-3afbe8a408d4",
                                        "entry_id": "efeaafae-2c96-3536-b4be-61e6ccb77316",
                                        "glosses": [
                                            "Personne qui admire au plus haut point (une autre personne)."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc3d8b8-738d-44ce-9e6d-706b6dedb219",
                                                "sense_id": "3eb4e61f-25ff-3620-88ec-3afbe8a408d4",
                                                "text": "Elle le rendit heureux d’ailleurs. Il ne voyait qu’elle au monde, ne pensait qu’à elle, la regardait sans cesse avec des yeux d’adorateur prosterné."
                                            },
                                            {
                                                "example_id": "ee4a1861-0143-4b6e-bda0-4068ab17e94e",
                                                "sense_id": "3eb4e61f-25ff-3620-88ec-3afbe8a408d4",
                                                "text": "« Je ne l’aime plus, je ne l’aime plus.\nJe n’ai plus besoin de lui, mes adorateurs me suffisent. …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adorateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23c172b2-3c29-30d6-a4be-84c6befc16f6",
                                        "entry_id": "be8d8044-b4ad-3940-aae6-9ee6e9c9b5de",
                                        "glosses": [
                                            "Qui adore, qui porte une adoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a4186f-8e06-48cc-aabb-61f5f6a2adea",
                                                "sense_id": "23c172b2-3c29-30d6-a4be-84c6befc16f6",
                                                "text": "La pratique la plus neuve et la plus pertinente pour notre propos fut la création de groupes d’enfants adorateurs."
                                            },
                                            {
                                                "example_id": "3db288d2-7e49-4da0-9872-7238ca28fa60",
                                                "sense_id": "23c172b2-3c29-30d6-a4be-84c6befc16f6",
                                                "text": "…le danger des artistes, des génies, — car ce sont bien là les juifs errants, — réside dans la femme : les femmes adoratrices sont leur perte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32cbb00a-9076-4983-96d5-e1bb378ecb5e",
                        "source_entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "source_sense_id": "1f6d59a2-eef4-3297-acdd-e0f1fb17f77d",
                        "source_sense_description": "verliefd persoon, die een ander het hof maakt",
                        "target_lang_word": "Verehrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                        "entry_id": "45f0bedd-45e1-374d-9919-3f736c21e7f6",
                                        "glosses": [
                                            "jemand, der jemanden anderen (oft heimlich) liebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc8fd43-e6b0-44f1-9030-4b34a33a14b3",
                                                "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                                "text": "Sie zur Freundin: „Ich habe einen heimlichen Verehrer - und er dichtet mir in seinen Liebesbriefen!“"
                                            },
                                            {
                                                "example_id": "b881aa30-5b3a-496c-8caf-ae1d08bb6c3a",
                                                "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                                "text": "„Der Oberarzt kannte niemanden namens Hamsun und glaubte, es wäre ein Verehrer von ihr.“"
                                            },
                                            {
                                                "example_id": "e020a4b9-5574-4680-8581-1dcee3f5fd04",
                                                "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                                "text": "übertragen: „Nun war dieser brave Lehrer / Auch dem Tobak ein Verehrer.“ -(Wilhelm Busch, „Max und Moritz“)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18f9ce44-7324-3c52-8406-acbe368d1e8d",
                                        "entry_id": "45f0bedd-45e1-374d-9919-3f736c21e7f6",
                                        "glosses": [
                                            "jemand, der jemand anderen bewundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb41ed7-5c6f-4f50-bac9-6fe64cf4354a",
                                                "sense_id": "18f9ce44-7324-3c52-8406-acbe368d1e8d",
                                                "text": "„Ich bin ein Verehrer dieses Autors.“"
                                            },
                                            {
                                                "example_id": "b968fcd2-59e5-46eb-93ae-a913c5a0fbab",
                                                "sense_id": "18f9ce44-7324-3c52-8406-acbe368d1e8d",
                                                "text": "übertragen: „Nun war dieser brave Lehrer / Auch dem Tobak ein Verehrer.“ -(Wilhelm Busch, „Max und Moritz“)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
