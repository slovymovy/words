    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0118c2c7-a1ec-3144-ae4c-3436f26fd28c",
                    "sense_definition": "Een instelling waar mensen wonen die verzorging of opvang nodig hebben.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opvang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn grootmoeder woont sinds vorig jaar in een modern <w>tehuis</w> voor ouderen.",
                            "target_lang_translations": {
                                "en": "My grandmother has been living in a modern <w>home</w> for the elderly since last year."
                            }
                        },
                        {
                            "text": "Het <w>tehuis</w> biedt onderdak aan mensen die nergens anders terecht kunnen.",
                            "target_lang_translations": {
                                "en": "The <w>shelter</w> provides housing for people who have nowhere else to go."
                            }
                        }
                    ],
                    "synonyms": [
                        "opvangcentrum",
                        "instelling",
                        "tehuis"
                    ],
                    "common_phrases": [
                        "medisch tehuis",
                        "tehuis voor ouderen"
                    ],
                    "target_lang_definitions": {
                        "en": "An institution where people live who need care or shelter."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "home",
                                "target_lang_sense_clarification": "a place of care or refuge, such as a nursing home"
                            },
                            {
                                "target_lang_word": "care home",
                                "target_lang_sense_clarification": "a residential facility for people needing assistance"
                            },
                            {
                                "target_lang_word": "institution",
                                "target_lang_sense_clarification": "a facility providing specialized care"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "731c7fe1-77b4-3055-996c-b59067689d1f",
                    "sense_definition": "Een tehuis specifiek bedoeld voor de opvang en verzorging van weeskinderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opvang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kinderen in <w>tehuizen</w> worden drie tot vier keer vaker slachtoffer van seksueel misbruik.",
                            "target_lang_translations": {
                                "en": "Children in <w>orphanages</w> are three to four times more likely to be victims of sexual abuse."
                            }
                        },
                        {
                            "text": "Na de oorlog werden veel wezen ondergebracht in een katholiek <w>tehuis</w>.",
                            "target_lang_translations": {
                                "en": "After the war, many orphans were placed in a Catholic <w>home</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "weeshuis"
                    ],
                    "common_phrases": [
                        "kinderen in tehuizen"
                    ],
                    "target_lang_definitions": {
                        "en": "A home specifically intended for the care and housing of orphans."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "orphanage",
                                "target_lang_sense_clarification": "a residential institution for orphans"
                            },
                            {
                                "target_lang_word": "children's home",
                                "target_lang_sense_clarification": "a facility for the care of children without parents"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5a5b3d8-ab8c-347a-a55d-f62dd938a570",
                    "sense_definition": "Een vaste verblijfplaats of plek waar men zich thuis voelt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verblijf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van reizen vond hij eindelijk een permanent <w>tehuis</w> in deze stad.",
                            "target_lang_translations": {
                                "en": "After years of traveling, he finally found a permanent <w>home</w> in this city."
                            }
                        },
                        {
                            "text": "Zij zochten een veilig <w>tehuis</w> voor de verwaarloosde dieren.",
                            "target_lang_translations": {
                                "en": "They were looking for a safe <w>home</w> for the neglected animals."
                            }
                        }
                    ],
                    "synonyms": [
                        "thuis",
                        "onderkomen",
                        "verblijfplaats"
                    ],
                    "common_phrases": [
                        "veilig tehuis",
                        "vast tehuis"
                    ],
                    "target_lang_definitions": {
                        "en": "A permanent residence or place where one feels at home."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "home",
                                "target_lang_sense_clarification": "one's own dwelling or place of belonging"
                            },
                            {
                                "target_lang_word": "abode",
                                "target_lang_sense_clarification": "a place of residence"
                            },
                            {
                                "target_lang_word": "habitat",
                                "target_lang_sense_clarification": "a natural home for animals"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a2cf1961-9ac7-310d-82eb-d934f8822040",
                    "sense_definition": "Een verouderde of formele variant van <w>thuis</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude geschriften leest men vaak dat men <w>tehuis</w> bleef tijdens de feestdagen.",
                            "target_lang_translations": {
                                "en": "In old writings, one often reads that people stayed <w>home</w> during the holidays."
                            }
                        },
                        {
                            "text": "De reiziger keerde na een lange tocht eindelijk weer <w>tehuis</w>.",
                            "target_lang_translations": {
                                "en": "The traveler finally returned <w>home</w> after a long journey."
                            }
                        }
                    ],
                    "synonyms": [
                        "thuis"
                    ],
                    "antonyms": [
                        "buitenshuis"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "wordt tegenwoordig bijna uitsluitend als 'thuis' geschreven"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An archaic or formal variant of 'thuis' (at home)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "home",
                                "target_lang_sense_clarification": "to one's place of residence"
                            },
                            {
                                "target_lang_word": "at home",
                                "target_lang_sense_clarification": "being in one's own house"
                            }
                        ]
                    }
                }
            ]
        }
    ]
