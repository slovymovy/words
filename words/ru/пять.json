                                "zh": "我们家有<w>五</w>口人，包括奶奶。"
                            }
                        },
                        {
                            "text": "Я звонил тебе <пять> раз, но ты не ответил.",
                            "target_lang_translations": {
                                "en": "I called you <five> times, but you didn't answer.",
                                "zh": "我给你打了<w>五</w>次电话，但你没接。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "пять раз",
                        "пять минут",
                        "пять пальцев",
                        "пять копеек"
