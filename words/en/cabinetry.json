{
    "word_family": [
        "cabinet",
        "cabinetmaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00d4363c-33ab-34c9-b5f8-01e002f32474",
                    "sense_definition": "Cabinets built into a room or set of furniture as a collective unit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen was renovated with high-quality wooden <w>cabinetry</w>. ",
                            "target_lang_translations": {
                                "tr": "Mutfak, yüksek kaliteli ahşap <w>dolaplarla</w> yenilendi."
                            }
                        },
                        {
                            "text": "Custom <w>cabinetry</w> was installed along the entire wall of the dining room.",
                            "target_lang_translations": {
                                "tr": "Yemek odasının tüm duvarı boyunca özel yapım <w>dolap sistemi</w> kuruldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "cabinetwork"
                    ],
                    "common_phrases": [
                        "custom cabinetry",
                        "wooden cabinetry",
                        "kitchen cabinetry"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir odaya veya mobilya takımına sabitlenmiş, toplu halde bulunan dolaplar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dolaplar",
                                "target_lang_sense_clarification": "mutfak veya banyo dolapları bütünü"
                            },
                            {
                                "target_lang_word": "dolap sistemleri",
                                "target_lang_sense_clarification": "özel yapım modüler dolap grubu"
                            },
                            {
                                "target_lang_word": "dolap doğramaları",
                                "target_lang_sense_clarification": "ahşap sabit dolap yapısı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef6244de-0760-3f2e-859b-4b5251d182a6",
                    "sense_definition": "The craft, trade, or skill of making cabinets and fine furniture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He studied fine woodworking and specialized in traditional <w>cabinetry</w>.",
                            "target_lang_translations": {
                                "tr": "İnce ahşap işçiliği okudu ve geleneksel <w>dolapçılık</w> alanında uzmanlaştı."
                            }
                        },
                        {
                            "text": "The workshop is known for its exceptional skill in fine <w>cabinetry</w>.",
                            "target_lang_translations": {
                                "tr": "Atölye, kaliteli <w>ince marangozluk</w> konusundaki üstün yeteneğiyle tanınır."
                            }
                        }
                    ],
                    "synonyms": [
                        "cabinetmaking"
                    ],
                    "common_phrases": [
                        "fine cabinetry"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dolap ve ince mobilya yapma zanaatı, ticareti veya becerisi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dolapçılık",
                                "target_lang_sense_clarification": "dolap yapma zanaatı ve mesleği"
                            },
                            {
                                "target_lang_word": "ince marangozluk",
                                "target_lang_sense_clarification": "kaliteli ahşap mobilya yapım zanaatı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}