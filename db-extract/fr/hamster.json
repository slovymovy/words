                        "target_lang_word": "хомяк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хомяк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79cc35a3-87eb-393c-8999-091e936356d7",
                                        "entry_id": "835a7337-48c5-316f-ae40-8b6f57ad392d",
                                        "glosses": [
                                            "зоол. небольшой короткохвостый пушистый грызун семейства хомяковых (cricetidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a5d023-546c-46b8-adf8-b6c53e2c9e47",
                                                "sense_id": "79cc35a3-87eb-393c-8999-091e936356d7",
                                                "text": "К семейству хомяков относятся небольшие, плотно сложенные грызуны с короткими конечностями, маленькими ушами и короткими хвостами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2fdd0fd-eb92-3ac5-a140-284aade4e81f",
                                        "entry_id": "835a7337-48c5-316f-ae40-8b6f57ad392d",
                                        "glosses": [
                                            "интернет. то же, что лемминг; недалёкий человек, бездумно следующий за толпой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c450955e-a88c-4cc2-9db8-bac692305807",
                                                "sense_id": "f2fdd0fd-eb92-3ac5-a140-284aade4e81f",
                                                "text": "А там как пошло бы ― если мирно бы не получилось, они были бы готовы и на кровавую кашу, причём досталось бы и их группе поддержки-хомякам."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "хомяк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f42b033a-b1d4-3041-9aec-9855991a160f",
                                        "entry_id": "b19cda6e-3e75-3f74-89b6-25b0da6334c7",
                                        "glosses": [
                                            "сленг, интернет. то же, что домашняя страница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e157789d-fde6-463c-ac88-44c3a7643918",
                                                "sense_id": "f42b033a-b1d4-3041-9aec-9855991a160f",
                                                "text": "Это позволит тебе разнообразить свой хомяк, например, сделать форму отправки мыла на твой адрес из формы на сайте, голосование какое-нибудь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56a2e456-ad1d-4f06-b123-72513538294b",
                        "source_entry_id": "3ef5ffdb-45f2-3f97-9dfa-0a12074d55b2",
                        "target_lang_word": "křečka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "360b3696-9178-4dbc-8933-d0ef30f60213",
                        "source_entry_id": "3ef5ffdb-45f2-3f97-9dfa-0a12074d55b2",
                        "target_lang_word": "křeček",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "křeček",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "35e5662c-2869-321b-bc0d-5eeb8db48fe2",
                                        "entry_id": "37f7ba2b-e6fc-3805-80d7-9daba1211689",
                                        "glosses": [
                                            "drobný hlodavec z rodu Cricetus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5bfbeaa-3a22-47a5-bd5a-7488155e4d5a",
                                                "sense_id": "35e5662c-2869-321b-bc0d-5eeb8db48fe2",
                                                "text": "Dnes jsou křečci chráněni."
                                            },
                                            {
                                                "example_id": "4ad8e0c8-8970-4000-96bc-86bfb0c82c00",
                                                "sense_id": "35e5662c-2869-321b-bc0d-5eeb8db48fe2",
                                                "text": "Chvíli se na to díval, jak křeček ostentativně vykukuje občas z pohovky a drze prská, pak dal pohlavek synovi, vynadal všem sprostě, oblekl se a kvapně odešel do jedné vinárny, kde po čtvrté čtvrtce započal s neznámým pánem rozhovor: „Tak vám mně syn, sekundán, nasadil do pohovky…“"
                                            },
                                            {
                                                "example_id": "50aef7b2-b365-4a30-8d18-9e806d5b1af2",
                                                "sense_id": "35e5662c-2869-321b-bc0d-5eeb8db48fe2",
                                                "text": "Ozvalo se odtamtud zlostné prskání a pištění, nad otvorem objevila se hlava rozčileného křečka, jako by se chtěla zeptat, co to za pořádek, a zmizela za chvíli opět uvnitř, kde zatím ježkové zalezli na dno pohovky, nestarajíce se ani o vretky, ani o křečka, ani o morčata."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
