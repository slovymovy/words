                                    {
                                        "sense_id": "5cfcd46b-ffc0-38b0-9eb0-1fc43231c69d",
                                        "entry_id": "ac013125-36c1-38d6-b805-03d516243422",
                                        "glosses": [
                                            "Chose apparemment menaçante, mais en réalité inoffensive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "974cd572-3625-4f99-9e8f-ca1daa836940",
                                                "sense_id": "5cfcd46b-ffc0-38b0-9eb0-1fc43231c69d",
                                                "text": "L’armée iranienne: puissance ou tigre de papier."
                                            },
                                            {
                                                "example_id": "9e5c1c5c-0d3f-4894-9953-7822d8ab7ab9",
                                                "sense_id": "5cfcd46b-ffc0-38b0-9eb0-1fc43231c69d",
                                                "text": "L’histoire a retenu quelques expressions presque oubliées qui ont marqué leur temps, comme ces « tigres de papier » décriés par Mao Ze Dong pour dénoncer la fausse puissance de l’Occident et du capitalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
