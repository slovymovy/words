                ],
                "senses": [
                    {
                        "sense_id": "3687ca60-7be9-3eac-baa7-16781003cbdb",
                        "entry_id": "a2959952-5e52-3beb-b98f-d24f1a4eeef7",
                        "glosses": [
                            "een met een halve toon verlaagde toon \\\"c"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86aaf947-e209-42c6-9cdc-8795c15bfdb3",
                                "sense_id": "3687ca60-7be9-3eac-baa7-16781003cbdb",
                                "text": "De toon “ces” klinkt in de getempereerde stemming, gelijk aan de toon “aïsis”."
                            }
                        ]
                    },
                    {
                        "sense_id": "ceb9c69f-0101-326f-a03f-42e130d318ac",
                        "entry_id": "a2959952-5e52-3beb-b98f-d24f1a4eeef7",
                        "glosses": [
                            "de grondtoon (tonica) van de “ces-mineurtoonladder”, een toonladder met tien mollen als voortekens, tevens een korte aanduiding van die toonladder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767ad29d-36b5-48e8-9e1f-4391ecea8f33",
                                "sense_id": "ceb9c69f-0101-326f-a03f-42e130d318ac",
                                "text": "Een muziekstuk in ces wordt daargaans genoteerd in het gelijkklinkende b-mineur dat slechts twee kruisen als voortekens heeft."
                            }
                        ]
                    },
                    {
                        "sense_id": "75e7e418-ec04-39bc-a127-630be9799ef9",
                        "entry_id": "a2959952-5e52-3beb-b98f-d24f1a4eeef7",
                        "glosses": [
                            "de grondtoon van het “ces-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d01461f3-2b02-485b-944f-3661e63a9f58",
                                "sense_id": "75e7e418-ec04-39bc-a127-630be9799ef9",
                                "text": "De drie tonen van het ces-mineurakkoord (symbool: C♭m) in grondligging, zijn: ces - eses - ges."
                            }
                        ]
                    }
                ],
