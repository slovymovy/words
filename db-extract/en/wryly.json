                    {
                        "sense_id": "ff1193e9-1280-3f96-b30d-8efe80d4ad63",
                        "entry_id": "d3d3a714-f764-3c54-8a18-3b9e88e82e24",
                        "glosses": [
                            "In a wry or sarcastic manner; ironically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca3f6eda-ef9b-45fd-b618-12b18d7eb5db",
                                "sense_id": "ff1193e9-1280-3f96-b30d-8efe80d4ad63",
                                "text": "The sins of the father, she thought wryly. Well, they had visited Tony, all right—only he didn't know it."
                            },
                            {
                                "example_id": "6d9f8a75-d431-4ccd-b846-0dad1eabeb3f",
                                "sense_id": "ff1193e9-1280-3f96-b30d-8efe80d4ad63",
                                "text": "‘The king is displeased with it, but he has to be patient,’ Chapuys wryly commented."
                            },
                            {
                                "example_id": "efed35dd-63c6-458a-a1db-f2e22e532cb6",
                                "sense_id": "ff1193e9-1280-3f96-b30d-8efe80d4ad63",
                                "text": "A Ukrainian presidential adviser wrote that Kyiv had nothing to do with the attacks but then wryly compared them to Russia’s past use of proxy forces to fight in Ukraine."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cf95772-de10-356d-9bb8-b15e73e52a96",
                        "entry_id": "d3d3a714-f764-3c54-8a18-3b9e88e82e24",
                        "glosses": [
                            "Contortedly."
                        ],
                        "tags": [
                            "of a facial expression"
                        ],
                        "examples": [
                            {
                                "example_id": "ca799e08-4b00-4c01-91b7-5fd8cc5c0bd2",
                                "sense_id": "6cf95772-de10-356d-9bb8-b15e73e52a96",
                                "text": "It was Joe, who had taken the gloves when the wicket-keeper went on to bowl.\nMike grinned, wryly but gratefully."
                            },
                            {
                                "example_id": "20bf1909-a924-401e-94fb-dc7601c7a4f1",
                                "sense_id": "6cf95772-de10-356d-9bb8-b15e73e52a96",
                                "text": "“Only your Virginie,” she laughed.\n“Virginie enough,” he smiled wryly. “No, I don’t want her either.”"
                            }
                        ]
                    }
                ],
