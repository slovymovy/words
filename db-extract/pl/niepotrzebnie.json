        "pl-extract.jsonl": [
            {
                "entry_id": "dde0ea72-af66-30b1-b68c-161665f56eb8",
                "word": "niepotrzebnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                        "entry_id": "dde0ea72-af66-30b1-b68c-161665f56eb8",
                        "glosses": [
                            "w sposób niepotrzebny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a731d6-1313-43e0-9a1a-d8b7277ccfc7",
                                "sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                                "text": "Stanisław nie pływa zbyt dobrze i zawsze niepotrzebnie wzbija wokół siebie fontanny wody."
                            },
                            {
                                "example_id": "9f5e7026-7e89-4448-a942-2093ce690cbb",
                                "sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                                "text": "Znowu kran niezakręcony i woda leje się niepotrzebnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7520b37a-945f-4bbd-b9cc-15247f48306e",
                        "source_entry_id": "dde0ea72-af66-30b1-b68c-161665f56eb8",
                        "source_sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                        "target_lang_word": "unnecessarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unnecessarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                        "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                                        "glosses": [
                                            "In an unnecessary way; not by necessity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c4c1570-d3ce-453f-8bff-609f2da93627",
                                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                                "text": "He unnecessarily repeated much of what others had covered."
                                            },
                                            {
                                                "example_id": "049bc9b1-4bde-43df-a288-2d0af478cb57",
                                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                                "text": "There be […] lords that can prate\nAs amply and unnecessarily\nAs this Gonzalo;"
                                            },
                                            {
                                                "example_id": "5050b18a-adb8-4177-8bb9-1dbb658c3c33",
                                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                                "text": "Pray let not any-body unnecessarily be acquainted with this shocking affair;"
                                            },
                                            {
                                                "example_id": "ca43e540-657a-487f-b4e8-c5ba1d232890",
                                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                                "text": "“Wait a moment,” said he, quite unnecessarily, for she could not have stirred;"
                                            },
                                            {
                                                "example_id": "14286408-27b9-4c21-844b-f4766eec5389",
                                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                                "text": "[…] they made good laws and kept the peace and saved good trees from being unnecessarily cut down,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                        "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                                        "glosses": [
                                            "To an extent beyond what is needed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d8da69-692d-4183-a3f0-6f7fcaa91299",
                                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                                "text": "The food provided was unnecessarily generous, especially for an event meant to raise money for the hungry."
                                            },
                                            {
                                                "example_id": "850834bd-aa6e-4893-a78e-9e57d7b23ddc",
                                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                                "text": "In the days of their [the Roman armies’] grandeur, when no enemy appeared capable of opposing them, their heavy armour was laid aside as unnecessarily burdensome, their laborious exercises were neglected as unnecessarily toilsome."
                                            },
                                            {
                                                "example_id": "a2f1d25f-fa3e-466b-b5c9-cf1c4f1581ab",
                                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                                "text": "His absence was unnecessarily long."
                                            },
                                            {
                                                "example_id": "18d387b7-5f98-48e3-b579-228c8258cbb4",
                                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                                "text": "About the turn of the century, the company had several ambitious and costly plans in hand—including direct lines to the West Country, South Wales and Birmingham—and so had no wish to incur additional expenditure unnecessarily."
                                            },
                                            {
                                                "example_id": "42c799f1-6d96-4c28-bea3-50a941561a29",
                                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                                "text": "[…] it seemed that she used his name unnecessarily often,"
                                            },
                                            {
                                                "example_id": "79466a47-61c9-499c-b307-3ad3acff4b6e",
                                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                                "text": "The pregame crew then showed a pair of faux-Super Bowl ads, including an unnecessarily woke Cheez-It commercial and a Papa John’s ad that fully embraces Pizzagaters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cb778c7-cc9b-472b-8463-4ecffb05dccd",
                        "source_entry_id": "dde0ea72-af66-30b1-b68c-161665f56eb8",
                        "source_sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                        "target_lang_word": "unnötig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unnötig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffb8f199-81a5-35d9-afc5-c319aeee97eb",
                                        "entry_id": "043a47d7-f819-33fc-af85-b407bef81f7f",
                                        "glosses": [
                                            "nicht nötig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fac3112-bb6a-46f8-b85a-d7f000c8481a",
                                                "sense_id": "ffb8f199-81a5-35d9-afc5-c319aeee97eb",
                                                "text": "Das war doch vollkommen unnötig!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb43bffc-3c27-4097-87f6-f3adf4ab6381",
                        "source_entry_id": "dde0ea72-af66-30b1-b68c-161665f56eb8",
                        "source_sense_id": "8ddf97c0-714d-3689-9f11-40abcaf7c06a",
                        "target_lang_word": "überflüssig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überflüssig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                        "entry_id": "57421a3c-218a-37b2-acd4-98c02042cbf2",
                                        "glosses": [
                                            "nicht nötig, über das notwendige Maß hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b2753c-c6f5-4112-b84c-ba6459d8f16e",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "Deine Kommentare finde ich überflüssig."
                                            },
                                            {
                                                "example_id": "802364c2-b57b-485b-842c-e827f2dc6c2f",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Bei Prolaktinomen zeigt eine medikamentöse Therapie oft Erfolg und eine Operation ist überflüssig.“"
                                            },
                                            {
                                                "example_id": "b564eb12-24c7-451a-b54b-b01546f4bb26",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Ausgangspunkt ist dabei die Frage, ob der Erste Weltkrieg im Grunde überflüssig war.“"
                                            },
                                            {
                                                "example_id": "edd61bf1-1cd4-4421-b06e-bda3420c232e",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Die riesige Wärmepumpe soll einen wesentlichen Teil dazu beitragen, das alte Kohlekraftwerk in der Stadt überflüssig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
