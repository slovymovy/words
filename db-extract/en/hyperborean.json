                "word": "hyperborean",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0880589b-e71f-46a4-8f39-3406ed215d5f",
                        "entry_id": "887859ca-d802-3df2-b07c-777c846a0be1",
