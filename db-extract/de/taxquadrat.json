                "senses": [
                    {
                        "sense_id": "328c0931-23d5-3d6a-a8ba-23193a8933f2",
                        "entry_id": "ef14eb0d-eae0-3e93-b1a7-64dff7ec3f2a",
                        "glosses": [
                            "Quadrat auf einer Vermessungskarte zur Bestimmung der Entfernung im Postverkehr"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "443c4f3c-106b-418e-acc6-3e9e12e7ac0f",
                                "sense_id": "328c0931-23d5-3d6a-a8ba-23193a8933f2",
                                "text": "„Ein Taxquadrat war also ca. 30 x 30 km groß, und die Gebühren für ein Fahrpoststück, also z. B. ein Paket, waren für alle Aufgabe- und Ziel-Orte innerhalb des jeweiligen Taxquadrates gleich.“"
                            },
                            {
                                "example_id": "01d6ebcc-5b8a-4d06-b949-e5896863c3eb",
                                "sense_id": "328c0931-23d5-3d6a-a8ba-23193a8933f2",
                                "text": "„Die Taxquadrate bildeten seit Einführung zur Zeit des Deutsch-Österreichischen Postvereins (Festlegung vom 26.2.1857) die Grundlage für die Berechnung der Fahrposttarife; sie teilten das gesamte Vereinsgebiet gleichmäßig ein und waren fortlaufend numeriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
