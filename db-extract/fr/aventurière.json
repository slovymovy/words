            {
                "entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                "word": "aventurière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0f64c47-3f89-4406-8368-97a111d510eb",
