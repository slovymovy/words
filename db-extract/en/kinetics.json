                                                "sense_id": "5f8e9f54-b334-3393-9d1f-3511ddab4e81",
                                                "text": "La nature cinétique ou vibratoire des rayons."
                                            },
                                            {
                                                "example_id": "a43cd1be-56bc-4f87-8ec4-e456d2b8f638",
                                                "sense_id": "5f8e9f54-b334-3393-9d1f-3511ddab4e81",
                                                "text": "Énergie cinétique, énergie liée au mouvement d'un corps."
                                            },
                                            {
                                                "example_id": "ee86c0ff-a0d5-432b-bbda-8b3a2346b1b5",
                                                "sense_id": "5f8e9f54-b334-3393-9d1f-3511ddab4e81",
                                                "text": "Art cinétique, art plastique comprenant des œuvres en mouvement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cinétique",
                                "target_lang_code": "fr",
                                "target_senses": [
