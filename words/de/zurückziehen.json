{
    "word_family": [
        "Zurückziehung",
        "Rückzug",
        "ziehen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f77f897-12c2-3482-888e-1659e43986b3",
                    "sense_definition": "sich an einen ruhigen Ort begeben oder soziale Kontakte meiden, um für sich zu sein",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "absondern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einem anstrengenden Arbeitstag <w>zieht</w> er sich gern in sein Zimmer <w>zurück</w>."
                        },
                        {
                            "text": "Die Künstlerin hat sich vor vielen Jahren vollständig aus der Öffentlichkeit <w>zurückgezogen</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich ins Privatleben zurückziehen",
                        "sich auf sein Zimmer zurückziehen"
                    ]
                },
                {
                    "sense_id": "9b1ef01a-2b79-3029-aaf8-9516ffcfb806",
                    "sense_definition": "etwas oder jemanden in die Ausgangsrichtung oder nach hinten ziehen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Erschrocken <w>zieht</w> das Kind die Hand von der heißen Herdplatte <w>zurück</w>."
                        },
                        {
                            "text": "Er <w>zog</w> den Vorhang ein Stück <w>zurück</w>, um das Tageslicht hereinzulassen."
                        }
                    ],
                    "common_phrases": [
                        "die Hand zurückziehen",
                        "den Vorhang zurückziehen"
                    ]
                },
                {
                    "sense_id": "ff0b850f-c751-320d-b47e-c0a29a1ed2cf",
                    "sense_definition": "eine offizielle Erklärung, einen Antrag oder ein Angebot für ungültig erklären",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "widerruf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach gründlicher Überlegung entschied sich die Bewerberin, ihre Bewerbung <w>zurückzuziehen</w>."
                        },
                        {
                            "text": "Der Politiker weigerte sich standhaft, seine umstrittenen Aussagen <w>zurückzuziehen</w>."
                        }
                    ],
                    "synonyms": [
                        "zurücknehmen"
                    ],
                    "common_phrases": [
                        "einen Antrag zurückziehen",
                        "eine Bewerbung zurückziehen"
                    ]
                },
                {
                    "sense_id": "53e81eac-7767-3bde-b977-a836c22d3bee",
                    "sense_definition": "Truppen oder militärische Einheiten aus einem Einsatzgebiet wieder abziehen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aufgrund des Friedensabkommens <w>zieht</w> die Armee alle Truppen aus dem Grenzgebiet <w>zurück</w>."
                        },
                        {
                            "text": "Der General befahl den Einheiten, sich unverzüglich hinter den Fluss <w>zurückzuziehen</w>."
                        }
                    ],
                    "synonyms": [
                        "reterieren"
                    ],
                    "common_phrases": [
                        "die Truppen zurückziehen",
                        "Soldaten zurückziehen"
                    ]
                }
            ]
        }
    ]
}