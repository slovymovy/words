                                        "entry_id": "2209b0b4-1a42-3dcc-8fa0-c0979e1bfd88",
                                        "glosses": [
                                            "tragbare Motorsäge mit umlaufender Kette, die kleine Metallzähne als Glieder hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08436b3-d30b-4b84-803c-0b5a81a9053e",
                                                "sense_id": "ff34a453-8f26-3cab-8511-0c4c6e5181ce",
                                                "text": "Die Kettensäge wird mit biologisch abbaubarem Öl geschmiert."
                                            },
                                            {
                                                "example_id": "73bd7730-1dff-4505-b554-70b41b5c1309",
                                                "sense_id": "ff34a453-8f26-3cab-8511-0c4c6e5181ce",
                                                "text": "„Als Werkzeug kamen ein Nothammer und eine Kettensäge zum Einsatz.“"
                                            },
                                            {
                                                "example_id": "7031b5f5-45a7-4c49-b3cb-384f20ae5709",
                                                "sense_id": "ff34a453-8f26-3cab-8511-0c4c6e5181ce",
                                                "text": "„Zum insgesamt vierten Mal werden die Fachleute mit Kettensägen und schwerem Gerät anrücken, 180 Bäume werden fallen, darunter mancher Riese, der Jahrzehnte im Garten eines Hauses überdauert hat.“"
                                            }
                                        ],
