                        "target_lang_word": "rescue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rescue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5536b8-951e-34db-9666-b85c4e69a92b",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To save from any violence, danger or evil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc01c0a8-ec5f-4a48-84b1-026ded704867",
                                                "sense_id": "5f5536b8-951e-34db-9666-b85c4e69a92b",
                                                "text": "The well-trained team rescued everyone after the avalanche."
                                            },
                                            {
                                                "example_id": "3c0c8862-129a-4651-8c98-404ffe22d650",
                                                "sense_id": "5f5536b8-951e-34db-9666-b85c4e69a92b",
                                                "text": "Soon after rescuing some silly children from the local caves, the alien prangs his vessel and dies."
                                            },
                                            {
                                                "example_id": "36706be1-b08b-4a72-8cbb-2c79f835a72f",
                                                "sense_id": "5f5536b8-951e-34db-9666-b85c4e69a92b",
                                                "text": "The students’ final mission was their longest: a trip across the Nile to the city of Omdurman, at the request of Rwandan diplomats, to rescue a woman who, unlike the first they rescued, really was pregnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44c5dae-06a5-3596-8191-86ae66bb8822",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To free or liberate from confinement or other physical restraint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3caea1f9-28e5-4a24-b99f-fc9a44665ed7",
                                                "sense_id": "d44c5dae-06a5-3596-8191-86ae66bb8822",
                                                "text": "to rescue a prisoner from the enemy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ae0591-2a1f-35a9-a091-040a6d62e1eb",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To recover forcibly, especially from a siege."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a807fd23-c7ab-3b7b-a593-82254cad35f6",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To remove or withdraw from a state of exposure to evil and sin."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783482de-7280-4322-937d-b3688fbbd7aa",
                                                "sense_id": "a807fd23-c7ab-3b7b-a593-82254cad35f6",
                                                "text": "Traditionally missionaries aim to rescue many ignorant heathen souls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abf702ae-fd3e-3476-a3d8-c08cd867c436",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To achieve something positive under difficult conditions."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db93768f-05de-429e-a93f-a2a3245566c8",
                                                "sense_id": "abf702ae-fd3e-3476-a3d8-c08cd867c436",
                                                "text": "Jews rescued some normalcy from increasingly difficult times by assuaging their constant Angst in the family and community and making do with less."
                                            },
                                            {
                                                "example_id": "a51ccdd2-c484-416d-be99-f82145d0b831",
                                                "sense_id": "abf702ae-fd3e-3476-a3d8-c08cd867c436",
                                                "text": "Arsenal's hopes of starting their Champions League campaign with an away win were dashed when substitute Ivan Perisic's superb late volley rescued a point for Borussia Dortmund."
                                            },
                                            {
                                                "example_id": "ddf0a12f-0faa-4e6d-9b61-cfe6183d2d01",
                                                "sense_id": "abf702ae-fd3e-3476-a3d8-c08cd867c436",
                                                "text": "Over the course of the season, on 15 occasions the team had rescued a draw or better after falling behind, such that even against Juventus, there was an air of inevitability about the comeback."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d832bba-d778-35ed-b2f5-dc8ee7855b91",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To restore a particular trait in an organism that was lost or altered, especially where this loss was as the consequence of some experimental manipulation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "698e50b6-9681-45a1-ba58-bdb61186b0a5",
                                                "sense_id": "4d832bba-d778-35ed-b2f5-dc8ee7855b91",
                                                "text": "Mecp2^(R255X/+) [mice] developed an overweight body weight phenotype by 10 weeks age and increased liver and heart weight by 8 months age. Abnormal body, liver and heart weight in Mecp2^(R255X/+) was rescued by MECP2ᵀᵍ¹ allele."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78328d03-ce98-38bc-b927-70bf3f434d9e",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To salvage and restore something that has been discarded."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4ae17af-f2d6-44af-8d3f-c8a35a91c4b1",
                                                "sense_id": "78328d03-ce98-38bc-b927-70bf3f434d9e",
                                                "text": "I rescued a set of antique dining chairs."
                                            },
                                            {
                                                "example_id": "5e3f1001-f13b-4b0a-980c-7fce802298af",
                                                "sense_id": "78328d03-ce98-38bc-b927-70bf3f434d9e",
                                                "text": "She had rescued a sofa once, had managed to locate the dealer who had bought it from under her nose while she perused a junk shop, and offered to buy it from him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7f1127a-8d84-39ec-a77d-fac6500727b7",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To fix a mistake made while preparing something, especially in cooking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c3919bb-040c-4787-b6b1-8caa6f8f3b35",
                                                "sense_id": "b7f1127a-8d84-39ec-a77d-fac6500727b7",
                                                "text": "The cook rescued the sauce after it began to curdle."
                                            },
                                            {
                                                "example_id": "1e1c2b08-a91e-4978-95ca-bc4a1fa794c9",
                                                "sense_id": "b7f1127a-8d84-39ec-a77d-fac6500727b7",
                                                "text": "To rescue whipped cream that has been overwhipped and appears grainy, add a little more liquid cream and whip it briefly or until very smooth and soft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6225b5ec-f7dc-3327-9ef4-764079f8ffbb",
                                        "entry_id": "2d5742ca-5050-3305-b213-1eb3c627b812",
                                        "glosses": [
                                            "To adopt (an animal)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b52798-784f-448e-b39f-d5ff55b1c8da",
                                                "sense_id": "6225b5ec-f7dc-3327-9ef4-764079f8ffbb",
                                                "text": "We rescued a dog, Dylan, which would begin my lifelong love of animals, especially dogs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rescue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d578c570-b7a1-3415-adbb-7325989e3508",
                                        "entry_id": "c562f60e-f79f-3911-9789-6d0c763cfd98",
                                        "glosses": [
                                            "An act or episode of rescuing, saving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf50f10-1103-4ee7-8aa1-412de26b6bdd",
                                                "sense_id": "d578c570-b7a1-3415-adbb-7325989e3508",
                                                "text": "Guests marveled that they kept making more rescues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36dcd4e7-ce41-355f-bbc1-6a1aeea79e22",
                                        "entry_id": "c562f60e-f79f-3911-9789-6d0c763cfd98",
