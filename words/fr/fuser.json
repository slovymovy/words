                    ],
                    "synonyms": [
                        "gicler",
                        "jaillir"
                    ]
                },
                {
                    "sense_id": "bdda87ba-2e72-328f-b558-530fd1552b5c",
                    "sense_definition": "Fondre ou se liquéfier progressivement sous l'effet d'une source de chaleur.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fonte_chaleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous la chaleur intense de la flamme, le bloc de cire commence doucement à <w>fuser</w>."
                        },
                        {
                            "text": "Lorsqu'on le place sur des braises ardentes, le salpêtre pur <w>fuse</w> très rapidement."
                        }
                    ],
                    "synonyms": [
                        "fondre",
                        "se liquéfier"
                    ],
                    "antonyms": [
                        "durcir",
                        "figer"
                    ]
                },
                {
                    "sense_id": "7660ee7a-edef-3c03-9ebc-6efe33eda4a6",
                    "sense_definition": "Se consumer lentement et silencieusement sans produire de détonation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "combustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison de l'humidité excessive, la poudre a simplement <w>fusé</w> sans déclencher de véritable explosion."
                        },
                        {
                            "text": "L'artificier constata avec soulagement que la charge avait <w>fusé</w> sans causer de dégâts majeurs."
                        }
                    ],
                    "synonyms": [
                        "se consumer"
                    ],
                    "antonyms": [
                        "détoner",
                        "exploser"
                    ]
                },
                {
                    "sense_id": "13f265bb-ad8f-3661-8d11-37fba8ff9687",
                    "sense_definition": "Tomber en langueur, dépérir ou s'éteindre à petit feu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infortuné convalescent semblait <w>fuser</w> lentement sur son lit d'hôpital, sans force ni vigueur."
