                    {
                        "sense_id": "6ecf92d7-af4c-3104-b2fa-d56c320a7320",
                        "entry_id": "fb784c82-ea13-32e8-8916-a5ca8532baa6",
                        "glosses": [
                            "Turn- oder Leichtathletik-Wettbewerb, der aus acht Teildisziplinen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6acdd2e-fb1f-4a41-bddb-7cf3acd41fdb",
                                "sense_id": "6ecf92d7-af4c-3104-b2fa-d56c320a7320",
                                "text": "„Nadja wurde souverän Olympiasiegerin im Olympischen Achtkampf und holte obendrein noch zwei weitere Goldmedaillen und ein Mal Bronze.“"
                            },
                            {
                                "example_id": "18dcb4f1-6c39-4c94-a25b-49ba29958384",
                                "sense_id": "6ecf92d7-af4c-3104-b2fa-d56c320a7320",
                                "text": "„Er schaffte seine Norm im Achtkampf mit 4575 Punkten und Platz 9 bei der Deutschen Schülermeisterschaft in Hannover.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
