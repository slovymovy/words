                    {
                        "translation_id": "eae470c5-76f4-46ad-ba42-5dbc658c16e0",
                        "source_entry_id": "a37cb44c-d304-3d81-875c-fdfcabde45b4",
                        "source_sense_id": "37098c6c-2515-35fb-adfc-9dd95f16a9b5",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Margery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Margery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a36df166-504c-30db-a0ab-8f8c81d8d789",
                                        "entry_id": "61b7eefa-b5a3-338f-80ae-ec8115d0ca80",
                                        "glosses": [
                                            "A medieval vernacular form of Margaret, A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75522d6c-b642-4caf-b21f-1f77bdde5c9e",
                                                "sense_id": "a36df166-504c-30db-a0ab-8f8c81d8d789",
                                                "text": "Margery is her name, sounds like sweet butter on Kansas corn."
                                            },
                                            {
                                                "example_id": "554accb5-736f-49e5-ad67-65e326aaf55b",
                                                "sense_id": "a36df166-504c-30db-a0ab-8f8c81d8d789",
                                                "text": "I know not what I shall think of that; but I am Launcelot, the Jew's man, and I am sure Margery your wife is my mother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "713c6965-3899-460e-9105-7cb6e4b39973",
                        "source_entry_id": "a37cb44c-d304-3d81-875c-fdfcabde45b4",
                        "source_sense_id": "37098c6c-2515-35fb-adfc-9dd95f16a9b5",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Marjorie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marjorie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1805612-0531-3906-9fd9-4a1d7183c40a",
                                        "entry_id": "4360c5ed-41f5-3334-a881-84923ef8fcd0",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec2ed9e-61a1-4748-b5f7-ccf9484b4702",
                                                "sense_id": "a1805612-0531-3906-9fd9-4a1d7183c40a",
                                                "text": "The daughter is called Marjorie--Marjorie Daw. Sounds odd at first, doesn't it? But after you say it over to yourself half a dozen times, you like it. There's a pleasing quaintness to it, something prim and violet-like. Must be a nice sort of girl to be called Marjorie Daw."
                                            },
                                            {
                                                "example_id": "29b10fb4-641e-4786-b580-f9887907af09",
                                                "sense_id": "a1805612-0531-3906-9fd9-4a1d7183c40a",
                                                "text": "Sponsored by Trump ally Rep. Marjorie Taylor Greene and backed by House GOP leadership, the bill would require federal agencies to update all maps and documents with the name Gulf of America."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae81910d-33b2-49bb-90fd-86666970b3cf",
                        "source_entry_id": "a37cb44c-d304-3d81-875c-fdfcabde45b4",
                        "source_sense_id": "37098c6c-2515-35fb-adfc-9dd95f16a9b5",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Marjory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marjory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11ee3baa-9c70-304d-b58d-b17b91cc8a8d",
                                        "entry_id": "dba64617-c016-32dd-8284-5a065d5e680c",
                                        "glosses": [
                                            "A female given name from Ancient Greek, variant of Margery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e44724d-a12a-4b8a-a85c-91412a9e664e",
                                                "sense_id": "11ee3baa-9c70-304d-b58d-b17b91cc8a8d",
                                                "text": "If Barbara Gordon was like a name from a Scottish ballad, Marjory Taylor was the kind of name he heard on the radio sometimes, in English pop songs. Jennifer Eccles. Angela Jones. Marjory Taylor."
                                            },
                                            {
                                                "example_id": "945f2550-02d3-40d9-a252-bc847ad0d489",
                                                "sense_id": "11ee3baa-9c70-304d-b58d-b17b91cc8a8d",
                                                "text": "The gunman, Nikolas Cruz, has been sentenced to life in prison without the possibility of parole. A school resource officer faces charges after allegedly failing to confront the gunman at Marjory Stoneman Douglas High School."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
