                    {
                        "translation_id": "6464348a-3080-453a-b535-d5724b003410",
                        "source_entry_id": "1618164d-0445-3a22-af98-0ac2cd9d3dbe",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Ма́рья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ма́рья",
