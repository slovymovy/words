                                "target_senses": [
                                    {
                                        "sense_id": "f495a743-3291-3e3c-b480-d05db9c8b148",
                                        "entry_id": "055a8c81-5a39-3c1d-b3b8-cb83b7e4e827",
                                        "glosses": [
                                            "Sans motif ni raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f45321-d479-43e3-8693-51ba9ddc83c6",
                                                "sense_id": "f495a743-3291-3e3c-b480-d05db9c8b148",
                                                "text": "C’est maintenant le tour des trois frères de Fernande, bons garçons en ce moment un peu bus, avec des rires pour rien et des poignées de main fracassantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5f76ae-5b09-391d-a80a-072f784510ee",
                                        "entry_id": "055a8c81-5a39-3c1d-b3b8-cb83b7e4e827",
                                        "glosses": [
                                            "Pas cher, dérisoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be01140f-03db-4df3-bc31-8ab791da3a58",
                                                "sense_id": "bf5f76ae-5b09-391d-a80a-072f784510ee",
                                                "text": "Non ! non ! ne me rendez pas la monnaie… trois cents francs, c’est pour rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
