                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43709e0-ff86-4ccf-88ec-8145b623e8ba",
                                "sense_id": "6360cfe5-21cc-3896-817c-44a55d9a5421",
                                "text": "Au fil des mois d’été, les visiteurs sont conviés à des concerts-rencontres sur une thématique instrumentale comme le clavecin ou encore l’orgue, ou bien sur les œuvres d’un compositeur comme Domenico Scarlatti, Olivier Messiaen ou Jean-Sébastien Bach."
                            },
                            {
                                "example_id": "21622ccb-b9be-4121-913a-c6b8e6bf9928",
                                "sense_id": "6360cfe5-21cc-3896-817c-44a55d9a5421",
                                "text": "Dans le cadre de l’accueil de personnes sans-abri dans les locaux de la Mairie du 4ᵉ pendant la période hivernale, trois musiciens de l’orchestre proposent un concert-rencontre pour les bénéficiaire et les bénévoles."
                            },
                            {
                                "example_id": "9152fcf4-3a9b-4662-bedb-1c9603c292ba",
                                "sense_id": "6360cfe5-21cc-3896-817c-44a55d9a5421",
                                "text": "Panayiotis Kokoras : Concert-rencontre avec le compositeur."
                            }
