                    {
                        "translation_id": "7384371d-3d5a-4817-969c-5eac7b587ab5",
                        "source_entry_id": "7b4c4cff-1357-35bb-b918-b75f7ba2ffd1",
                        "source_sense_id": "84e02336-5bc9-3480-aad1-4f6088bd2b2f",
                        "source_sense_description": "Substance agricole de lutte contre des organismes nuisibles",
                        "target_lang_word": "Pestizid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pestizid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                        "entry_id": "7172a1a2-7800-38ac-9c3b-536073a84edb",
                                        "glosses": [
                                            "Mittel (Flüssigkeit), dessen Wirkstoff die als schädlich empfundenen Lebewesen abtöten oder vertreiben soll (Wildkräuter, Pilze, Insekten und Ähnliches)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e248fd1-081a-4046-8c67-8c40c43dea82",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Der Einsatz von Pestiziden wird in Deutschland von den Verbrauchern kritisch gesehen."
                                            },
                                            {
                                                "example_id": "2c929d94-a7ff-40be-81a7-92a277123811",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Macht das Pestizid Glyphosat krank? Experten kommen in Studien zu widersprüchlichen Ergebnissen."
                                            },
                                            {
                                                "example_id": "8852c86d-439d-4a86-90b3-48a13b1eccdd",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Landwirte, die Pestizide einsetzen, sind einem doppelt so hohen Risiko ausgesetzt, an Parkinson zu erkranken wie Berufskollegen, die auf solche chemischen Keulen verzichten."
                                            },
                                            {
                                                "example_id": "aa6b147c-613a-4db7-a832-89511abe0141",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "Nach der Zika-Epidemie im vergangenen Jahr ist die Zahl der Fälle in Brasilien um mehr als 95 Prozent gesunken. Das Militär war mit Pestiziden und Austrocknungsmaßnahmen gegen die Überträger-Mücken vorgegangen."
                                            },
                                            {
                                                "example_id": "5d6f5ebc-ad84-4463-bcb0-9d3dd6e5144e",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "„Das Fleisch der Wale ist hoch mit giftigem Quecksilber, krebserregendem PCB (polychlorierte Biphenyle) und Pestiziden belastet – so stark, dass die Gesundheitsbehörde der Färöer 2008 die Empfehlung aussprach, kein Walfleisch und keinen Walspeck mehr zu essen.“"
                                            },
                                            {
                                                "example_id": "b5601338-3505-4a0f-bf51-4113b56b826e",
                                                "sense_id": "0a36142e-f263-316b-bb20-8957e4d0c7cd",
                                                "text": "„Einer der Gründe […] für den Verlust unserer Biodiversität ist der zunehmende Einsatz von Pestiziden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
