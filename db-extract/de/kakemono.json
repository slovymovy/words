                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kakémono",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90ceaf50-1bde-350e-b52a-2b3852613345",
                                        "entry_id": "f3a9b606-f742-33cb-967d-b8e9a6e02e37",
                                        "glosses": [
                                            "Rouleau de papier ou de tissu avec des baguettes de bambou à ses extrémités, permettant d’afficher estampes et calligraphies, apparu en Chine à l’époque de la dynastie Tang et développé au Japon à l’époque de Heian (794-1192), afin de décorer les maisons ou les lieux d’évènements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb00657-21c0-4009-a345-3832e96a0f52",
                                                "sense_id": "90ceaf50-1bde-350e-b52a-2b3852613345",
                                                "text": "Un kakémono orne traditionnellement la pièce où se déroule la cérémonie du thé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f9c5282-adda-3668-a72b-823d03cf0a2c",
                                        "entry_id": "f3a9b606-f742-33cb-967d-b8e9a6e02e37",
                                        "glosses": [
                                            "Panneau plus long que large et pouvant être déroulé, outil de communication visuelle ou support d’expositions à l’infrastructure légère. → voir kakémono publicitaire"
                                        ],
                                        "tags": [
                                            "Publicité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69ea45c4-2c37-4c61-8867-60d9cd4b92df",
                                                "sense_id": "8f9c5282-adda-3668-a72b-823d03cf0a2c",
                                                "text": "Enfin, « deux kakémonos [affiche enroulable] orneront la façade du bâtiment avec le message suivant : \"Mairie solidaire avec le mouvement social\" »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fafd64c2-142e-421e-8654-55a695316293",
                        "source_entry_id": "ca7f6e88-d4b3-3f35-bb80-b180b2fe41c5",
                        "source_sense_id": "a181f4ea-449c-3a40-93b1-3fb4b2b17fd9",
                        "target_lang_word": "kakemono",
