                "senses": [
                    {
                        "sense_id": "e01d136c-1d67-3035-8089-500ed9715e66",
                        "entry_id": "01d879f3-aa19-3c30-9145-3d2398aacf4f",
                        "glosses": [
                            "Vérifier par une deuxième validation des résultats obtenus par une première."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61fa0f0c-b28e-4109-88a8-f4306ff243c1",
                                "sense_id": "e01d136c-1d67-3035-8089-500ed9715e66",
                                "text": "Il semblait donc utile de reprendre ces hypothèses, de contrevalider ces résultats et de regrouper toutes ces liaisons jusque-là disparates autour d'une interprétation cohérente."
                            },
                            {
                                "example_id": "a1ae4671-f695-4356-abf1-69ba1c1fb0c3",
                                "sense_id": "e01d136c-1d67-3035-8089-500ed9715e66",
                                "text": "En ce qui concerne la validité de critère de la WCC (validité divergente), quelques tendances intéressantes sont observées, qui seront à contrevalider sur des groupes plus étendus."
                            }
                        ]
                    }
