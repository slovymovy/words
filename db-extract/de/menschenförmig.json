                ],
                "senses": [
                    {
                        "sense_id": "d5412759-2091-38ea-a536-6cd07043fcef",
                        "entry_id": "c09292eb-3672-329d-9ae4-54a699319dd8",
                        "glosses": [
                            "die Form eines Menschen habend, wie ein Mensch geformt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7c8792-b521-492d-ab22-aaf156ebbe7c",
                                "sense_id": "d5412759-2091-38ea-a536-6cd07043fcef",
                                "text": "„Der menschenförmige Schimmelfleck auf dem Boden, die Form des gelblichen Dunstes und die Krümmung der Baumwurzeln in den alten Geschichten, all dies sprach für eine zumindest entfernte Verbindung zur menschlichen Gestalt; doch wie groß oder unveränderlich diese Ähnlichkeit sein mochte, das konnte niemand auch nur halbwegs sicher sagen.“"
                            },
                            {
                                "example_id": "525f56a2-d26c-48e6-8dbd-b4a7fc8ad022",
                                "sense_id": "d5412759-2091-38ea-a536-6cd07043fcef",
                                "text": "„Sie passierten einen Treppenhauseingang rechter Hand; Court spähte ins Dunkel, konnte jedoch keinen menschengroßen, menschenförmigen Umriss erkennen.“"
                            },
                            {
                                "example_id": "c40379d7-b1b0-43ef-9eac-ba408dfdfb11",
                                "sense_id": "d5412759-2091-38ea-a536-6cd07043fcef",
                                "text": "„Wenn jemand gesehen hätte, wie wir ein menschenförmiges Bündel herumschleppen, würde diese Befragung nicht in der Geborgenheit unseres eigenen Zuhauses stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
