                                    {
                                        "sense_id": "b59d70bc-ec91-3eca-88ac-9fe5c0dd5154",
                                        "entry_id": "9fc830b1-0499-316d-95f6-0f3a0f6124e7",
                                        "glosses": [
                                            "художественная стрижка деревьев и кустарников"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6771d4a-284f-4c20-88c3-1b98deaab244",
                                                "sense_id": "b59d70bc-ec91-3eca-88ac-9fe5c0dd5154",
