            "senses": [
                {
                    "sense_id": "3b24cd64-dec5-3ab8-ab01-5afbebfa8691",
                    "sense_definition": "z tego miejsca; określenie kierunku od miejsca, w którym znajduje się mówiący",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy jak najszybciej <w>stąd</w> uciekać.",
                            "target_lang_translations": {
                                "ru": "Мы должны как можно скорее бежать <w>отсюда</w>.",
                                "en": "We must escape <w>from here</w> as soon as possible.",
                                "nl": "We moeten zo snel mogelijk <w>hier vandaan</w> vluchten.",
                                "de": "Wir müssen so schnell wie möglich <w>von hier</w> verschwinden.",
                                "fr": "Nous devons fuir <w>d'ici</w> le plus vite possible.",
                                "it": "Dobbiamo scappare <w>da qui</w> il prima possibile.",
                                "cs": "Musíme <w>odsud</w> co nejrychleji utéct.",
                                "tr": "En kısa sürede <w>buradan</w> kaçmalıyız.",
                                "es": "Tenemos que huir <w>de aquí</w> lo antes posible.",
                                "zh": "我们必须尽快<w>从这儿</w>逃走。"
                            }
                        },
                        {
                            "text": "Mieszkam niedaleko <w>stąd</w>, więc pójdę pieszo.",
                            "target_lang_translations": {
                                "ru": "Я живу недалеко <w>отсюда</w>, поэтому пойду пешком.",
                                "en": "I live not far <w>from here</w>, so I will walk.",
                                "nl": "Ik woon niet ver <w>hier vandaan</w>, dus ik ga te voet.",
                                "de": "Ich wohne nicht weit <w>von hier</w>, also gehe ich zu Fuß.",
                                "fr": "J'habite non loin <w>d'ici</w>, donc j'irai à pied.",
                                "it": "Abito non lontano <w>da qui</w>, quindi andrò a piedi.",
                                "cs": "Bydlím nedaleko <w>odsud</w>, takže půjdu pěšky.",
                                "tr": "<w>Buraya</w> yakın oturuyorum, bu yüzden yürüyerek gideceğim.",
                                "es": "Vivo cerca <w>de aquí</w>, así que iré caminando.",
                                "zh": "我住的地方离<w>这儿</w>不远，所以我走着去。"
                            }
                        }
                    ],
                    "antonyms": [
                        "stamtąd"
                    ],
                    "common_phrases": [
                        "daleko stąd",
                        "niedaleko stąd",
                        "wyjdź stąd",
                        "chodźmy stąd"
                    ],
                    "target_lang_definitions": {
                        "ru": "из этого места; направление движения от говорящего",
                        "en": "From this place; indicating the direction of movement away from the speaker.",
                        "nl": "van deze plek; aanduiding van de richting vanaf de plek waar de spreker zich bevindt",
                        "de": "von diesem Ort; eine Richtung von dem Ort aus, an dem sich der Sprecher befindet",
                        "fr": "de cet endroit; indique une direction à partir du lieu où se trouve le locuteur",
                        "it": "da questo luogo; indica la direzione di movimento a partire dal punto in cui si trova chi parla",
                        "cs": "z tohoto místa; vyjádření směru od místa, kde se nachází mluvčí",
                        "tr": "Bulunulan yerden, bu noktadan; konuşmacının bulunduğu yerden uzaklaşma yönünü belirtir.",
                        "es": "desde este lugar; indica la dirección desde donde se encuentra el hablante",
                        "zh": "从这个地方；指代从说话人所在位置出发的方向"
                    },
