                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Montenegriner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc7e4925-c2df-322d-82c4-df532c8ead2a",
                                        "entry_id": "80bc2638-a09c-3714-a927-411970b659af",
                                        "glosses": [
                                            "ein Staatsbürger Montenegros"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5462e9c0-3145-46fc-bb9c-7d54b7f279b6",
                                                "sense_id": "cc7e4925-c2df-322d-82c4-df532c8ead2a",
                                                "text": "„Da war Dejan Savicevic, der Montenegriner, den jeder, der ihn an guten Tagen sah, für einen Magier hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7735a768-8394-3de0-ab4b-e552533bc819",
                                        "entry_id": "80bc2638-a09c-3714-a927-411970b659af",
                                        "glosses": [
                                            "ein Angehöriger des Volkes, das vom Balkan stammt und Montenegrinisch spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f1955e-e22e-42df-a6b4-d5c9e1adb2c2",
                                                "sense_id": "7735a768-8394-3de0-ab4b-e552533bc819",
                                                "text": "„Montenegriner leben vor allem in Montenegro, aber auch in Bosnien und Herzegowina, Kroatien und Serbien.“"
                                            },
                                            {
                                                "example_id": "731861f8-8fca-4024-a4bc-7bf792c85a40",
                                                "sense_id": "7735a768-8394-3de0-ab4b-e552533bc819",
                                                "text": "„Selbst heute noch können die meisten Montenegriner und Montenegrinerinnen darüber Auskunft geben, welchem Stamm und welcher Sippe sie angehören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
