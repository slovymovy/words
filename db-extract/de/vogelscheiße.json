                "senses": [
                    {
                        "sense_id": "7e0016e7-0703-3696-8091-587bf60a6c0c",
                        "entry_id": "1f99fdec-08ef-36d6-9e85-7bbd5daf0bbf",
                        "glosses": [
                            "Scheiße, die von einem Vogel stammt"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "5b469f17-3b4f-4bcf-a449-f138dc1e9bb7",
                                "sense_id": "7e0016e7-0703-3696-8091-587bf60a6c0c",
                                "text": "„Badger selbst hat ein gefaltetes Handtuch auf der Schulter, damit der Papagei sich festhalten kann, und das Handtuch ist hinten ganz mit gelblicher Vogelscheiße bekleckert.“"
                            },
                            {
                                "example_id": "5b63b04b-b149-4838-ba84-2224790b1a47",
                                "sense_id": "7e0016e7-0703-3696-8091-587bf60a6c0c",
                                "text": "„Ich kann mich an dich erinnern, Onkel Milo. Verschollen unter dem Wendekreis des Steinbocks, alle Mann an Bord eines Kahns voller Vogelscheiße, in einer Nebelnacht vor der chilenischen Kalkküste.“"
                            },
                            {
                                "example_id": "c37f7481-b081-4f15-8faf-b0073800df5e",
                                "sense_id": "7e0016e7-0703-3696-8091-587bf60a6c0c",
                                "text": "„Ich laufe die dreißig Meter zum Eingang des botanischen Gartens. Seine Vorderseite wird von einem grünen, in Stein und Mörtel eingelassenen Gitterzaun gesäumt, der mit Vogelscheiße überzogen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
