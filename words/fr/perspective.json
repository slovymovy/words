    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab61e8c1-91be-3248-acbe-62b4d8e9ceaf",
                    "sense_definition": "Événement ou évolution future prévisible ; probabilité ou attente d'une situation à venir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "futur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle était très heureuse à la <w>perspective</w> de commencer ses études universitaires l'année prochaine."
                        },
                        {
                            "text": "Les <w>perspectives</w> de croissance économique pour l'année à venir restent encourageantes."
                        }
                    ],
                    "synonyms": [
                        "horizon",
                        "prévision",
                        "avenir"
                    ],
                    "common_phrases": [
                        "en perspective",
                        "perspectives d'avenir",
                        "perspective de carrière"
                    ]
                },
                {
                    "sense_id": "7fa9d558-ca87-354a-97d1-ecda2085ea10",
                    "sense_definition": "Technique géométrique ou artistique consistant à représenter des objets à trois dimensions sur une surface plane en donnant l'illusion de la profondeur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "art_vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur d'arts plastiques nous a enseigné les lois fondamentales de la <w>perspective</w>."
                        },
                        {
                            "text": "Ce tableau de la Renaissance respecte parfaitement les règles de la <w>perspective</w> linéaire."
                        }
                    ],
                    "common_phrases": [
                        "règles de la perspective",
                        "point de perspective"
                    ]
                },
                {
                    "sense_id": "82109105-1bc8-3c68-82f3-b2fd7c25d6d6",
                    "sense_definition": "Manière particulière d'envisager, d'évaluer ou d'interpréter une situation ; point de vue.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut prendre du recul pour garder une bonne <w>perspective</w> sur les événements récents."
                        },
                        {
                            "text": "Le sociologue a proposé une nouvelle <w>perspective</w> afin d'analyser les comportements des consommateurs."
                        }
                    ],
                    "synonyms": [
                        "point de vue",
                        "optique",
                        "angle"
                    ],
                    "common_phrases": [
                        "mettre en perspective",
                        "garder en perspective",
                        "changer de perspective"
                    ]
                },
                {
                    "sense_id": "1c214922-8d49-339e-859c-049b77e2e2f9",
                    "sense_definition": "Aspect qu'offre un paysage ou un ensemble d'édifices observés à distance, en particulier dans un alignement régulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art_vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le belvédère du parc, la <w>perspective</w> sur le fleuve et les collines est splendide."
                        },
                        {
                            "text": "Cette longue avenue rectiligne ouvre une belle <w>perspective</w> sur le monument historique."
                        }
                    ],
                    "synonyms": [
                        "panorama",
                        "vue",
                        "échappée"
                    ]
                },
                {
