                "senses": [
                    {
                        "sense_id": "32dc5ab6-6bd9-349e-acb4-2e371eaa94fb",
                        "entry_id": "3ccccc37-9a55-326e-8910-5564e182f442",
                        "glosses": [
                            "Actionneur : dispositif produisant une action mécanique à partir d’une source d’énergie, principalement électrique, hydraulique ou pneumatique (air comprimé)."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "3192e5f6-05b1-4ddf-969a-bae96d2a163c",
                                "sense_id": "32dc5ab6-6bd9-349e-acb4-2e371eaa94fb",
                                "text": "Dank der starken Entwicklung der Leistungselektronik gewinnen elektromechanische Aktoren immer mehr an Bedeutung.",
                                "translation": "Grâce à l’important développement de l’électronique de puissance, les actionneurs électromécaniques prennent toujours plus d’importance."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f155a8a-5131-3900-b29d-76efeca3d592",
                        "entry_id": "3ccccc37-9a55-326e-8910-5564e182f442",
                        "glosses": [
                            "Acteur : personne, individu ou entité collective prenant part, ayant un rôle dans un certain contexte social, politique ou économique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb06301-1c91-4b1a-ba5b-837d6507519b",
                                "sense_id": "4f155a8a-5131-3900-b29d-76efeca3d592",
                                "text": "Nach langen Verhandlungen sind die verschiedenen Aktoren (Politik, Industrie, Gewerkschaften) zu einem Kompromiss gekommen.",
                                "translation": "Après de longues négociations, les différents acteurs (politique, industrie et syndicats) sont arrivés à un compromis."
                            }
                        ]
                    }
                ],
