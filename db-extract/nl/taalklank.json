                    {
                        "translation_id": "3cd094a5-eeaf-42ca-911d-546b55d09664",
                        "source_entry_id": "37242687-b59d-3ada-924c-90293b7457e1",
                        "source_sense_id": "4a4007a4-3ce5-3aa0-8222-45a73f6e17b6",
                        "source_sense_description": "(taalkunde) een klank die betekenisonderscheidend werkt in een taal",
                        "target_lang_word": "Phonem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phonem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                        "entry_id": "03685094-2286-33b1-badd-cfe6eda71739",
                                        "glosses": [
                                            "die kleinste bedeutungsunterscheidende sprachliche Einheit (Langue)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b3ac9a-14dc-40e4-bb47-deb393963769",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "/r/ : /f/ => rein : fein. In diesem Minimalpaar zeigt sich, dass /r/ und /f/ zu verschiedenen Phonemen gehören müssen. Weiteres Beispiel:"
                                            },
                                            {
                                                "example_id": "4cf2042c-158a-4af8-9b90-1c3f2f6125f4",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "/h/ : /m/ => Haus : Maus"
                                            },
                                            {
                                                "example_id": "885a568e-0329-411a-acf3-c4d4e5667904",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "Zungenspitzen-[r] und Zäpfchen-[ʁ] sind beide freie Varianten (Allophone) des Phonems /r/; man kann mit ihnen allein kein Minimalpaar bilden."
                                            },
                                            {
                                                "example_id": "1856f62b-4fa4-49ac-b03f-b7b75213e108",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Jedes Wort in dieser Strophe entspricht den phonotaktischen Baugesetzen der englischen Sprache, d. h. die Phoneme, die kleinsten bedeutungsdifferenzierenden Einheiten des Englischen sind richtig kombiniert worden.“"
                                            },
                                            {
                                                "example_id": "800a8998-995d-4214-a55e-a5fd9697f412",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Was den Lautstand anbelangt, so bezeichnen wir die Bestandteile der Wortform als Laute; betrachten wir die Laute vom Lautsystem her (z. B. danach, ob sie Bedeutungen differenzieren können oder nicht), dann sprechen wir von Phonemen.“"
                                            },
                                            {
                                                "example_id": "d0a623d8-13f8-439d-947f-2afe9f440d11",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Ein Phonem mit erheblicher allophonischer Variation ist der š-Laut im Schwedischen.“"
                                            },
                                            {
                                                "example_id": "2f460094-db0e-4142-8f59-7abec0eff1c0",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Aber wenn sie in der Vorlesung auch nur das Wort »Phonem« erwähne, berichtet Valtin, »ist bei vielen Studenten sofort die Aufmerksamkeit weg«.“"
                                            },
                                            {
                                                "example_id": "d26af33a-46b4-4e95-a09f-16a5d4bc6501",
                                                "sense_id": "702442db-69bf-36e7-8380-4856d170c336",
                                                "text": "„Der regelrechten Realisierung eines Phonems gehen viele einzelne Schritte voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e273667a-6c4e-44ec-b0fc-b43f519c6cdb",
                        "source_entry_id": "37242687-b59d-3ada-924c-90293b7457e1",
                        "source_sense_id": "4a4007a4-3ce5-3aa0-8222-45a73f6e17b6",
                        "source_sense_description": "(taalkunde) een klank die betekenisonderscheidend werkt in een taal",
                        "target_lang_word": "phoneme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phoneme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "602f4e10-6353-3c72-9870-0f86d87cf99a",
                                        "entry_id": "484ac76d-4cf5-34c8-9ab1-bbee43bbacab",
                                        "glosses": [
                                            "An indivisible unit of sound in a given language. A phoneme is an abstraction of the physical speech sounds (phones) and may encompass several different phones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc5c275-1579-4dd5-b6f6-0abefa2422da",
                                                "sense_id": "602f4e10-6353-3c72-9870-0f86d87cf99a",
                                                "text": "It is crucial for the phoneme structure of Finnish — traditionally /d/ has not been included in the Finnish phonotax, but it fulfils the criteria of a phoneme (Karlsson, 1983: 66-7)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55a5cd0b-7f29-4465-a917-adf33f433129",
                        "source_entry_id": "37242687-b59d-3ada-924c-90293b7457e1",
                        "source_sense_id": "4a4007a4-3ce5-3aa0-8222-45a73f6e17b6",
                        "source_sense_description": "(taalkunde) een klank die betekenisonderscheidend werkt in een taal",
                        "target_lang_word": "phonème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phonème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27f8eb99-1b96-3839-9816-0d83890aaee9",
                                        "entry_id": "4061134f-9c0a-360f-8b50-01e70e7b894c",
                                        "glosses": [
                                            "Unité distinctive de prononciation dans une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cba0d55-b72b-4021-b7cd-8ec4aab7eaa3",
                                                "sense_id": "27f8eb99-1b96-3839-9816-0d83890aaee9",
                                                "text": "Deux sons sont des phonèmes si, dans un mot, la substitution de l’un par l’autre entraîne un changement de sens : exemple dans « chat » et « rat », le son « ch » est le phonème \\ʃ\\ et le son « r » est le phonème \\ʁ\\."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89383af0-7cb8-33cc-9224-523c60765f82",
                                        "entry_id": "4061134f-9c0a-360f-8b50-01e70e7b894c",
                                        "glosses": [
                                            "Désigne, pour Carl Wernicke, les hallucinations auditives durant lesquelles le sujet entend des mots."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f63c9aba-78cb-4561-bdd9-776e18f2986c",
                                                "sense_id": "89383af0-7cb8-33cc-9224-523c60765f82",
                                                "text": "… une acception de phonème en pathologie qui se définit comme une « Hallucination auditive dans laquelle le sujet entend des voix» (les spécialistes que j'ai consultés ignorent pourtant cet emploi, dont le professeur Réné Tissot me dit qu'il est attesté sans indication de source dans l'édition de 1972 du dictionnaire de médecine …)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67561202-6218-4136-abb8-92388a39247f",
                        "source_entry_id": "37242687-b59d-3ada-924c-90293b7457e1",
                        "source_sense_id": "4a4007a4-3ce5-3aa0-8222-45a73f6e17b6",
                        "source_sense_description": "(taalkunde) een klank die betekenisonderscheidend werkt in een taal",
                        "target_lang_word": "φώνημα",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "φώνημα",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "5025106a-3524-38f2-bb55-1d5ff34e08f0",
                                        "entry_id": "10cfeccd-09fe-3466-a847-d5e2eef4d099",
                                        "glosses": [
                                            "στοιχειώδης οντότητα του προφορικού λόγου που παρέχει διακριτική / διαφοροποιητική λειτουργία στο φωνητικό επίπεδο και στο γλωσσικό νόημα"
                                        ],
                                        "tags": [
                                            "φωνολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3151e3a9-9e85-4147-accc-8476e3e827b0",
                                                "sense_id": "5025106a-3524-38f2-bb55-1d5ff34e08f0",
                                                "text": "Στα ελληνικά, οι φθόγγοι [p], [t] διαφοροποιούν τη σημασία, όπως «πόνος» [ˈponos] «τόνος» [ˈtonos], έχουν φωνηματική αξία, είναι φωνήματα. Λέμε ότι οι λέξεις «πόνος» και «τόνος» αποτελούν ένα ελάχιστο ζεύγος."
                                            },
                                            {
                                                "example_id": "d55f0386-6610-46b7-9528-974ce6563bc6",
                                                "sense_id": "5025106a-3524-38f2-bb55-1d5ff34e08f0",
                                                "text": "Σε βόρεια ιδιώματα, όπως στη Θεσσαλονίκη, ακούμε το [ɫ] αλλόφωνο του [l] όταν ακολουθεί [a, o ή u] όπως «χαλαρά» [xaɫaˈɾa]. Αλλά το [ɫ] δεν είναι φώνημα γιατί δε διαφοροποιεί τη σημασία με την κοινή προφορά [xalaˈɾa]. Δεν μεταβάλλει το νόημα. Σε άλλες γλώσσες, όπως τα αραβικά, τα δύο αυτά είναι διαφορετικά φωνήματα."
                                            },
                                            {
                                                "example_id": "0b47f1b0-2b59-4c75-b370-5cd8c5e27890",
                                                "sense_id": "5025106a-3524-38f2-bb55-1d5ff34e08f0",
                                                "text": "Το φώνημα /x/ της νεοελληνικής έχει τη μορφή φθόγγου [x] όπως στο «χώνει» [ˈxoni] κι έχει αλλόφωνο το [ç] όπως στο «χιόνι» [ˈçoni]. To [ç] όμως, δεν είναι φώνημα επειδή διαφοροποιεί τη σημασία μόνο υπό προϋποθέσεις (όταν ακολουθεί [i] ή [e])."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
