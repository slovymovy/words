                "senses": [
                    {
                        "sense_id": "cee5558e-473c-3abf-ae92-56563756f182",
                        "entry_id": "e013a83f-e5de-36be-bec0-249617bd53b9",
                        "glosses": [
                            "Revenir en arrière par rapport à un amendement de (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267d3cd4-550d-4022-ad35-cae2da776d3c",
                                "sense_id": "cee5558e-473c-3abf-ae92-56563756f182",
                                "text": "Avec le Projet de Loi de M. Villemain désamendé (tel que le fait votre Rapport), que devient, par exemple, la liberté des méthodes ?"
                            },
                            {
                                "example_id": "ab53bf20-cc39-4f9e-9ad0-d9bf0f26dd3d",
                                "sense_id": "cee5558e-473c-3abf-ae92-56563756f182",
                                "text": "De la doctrine amendée, réamendée, désamendée, taillée et retaillée sans arrêt depuis un an, on sait ce qui reste."
                            }
                        ]
                    }
