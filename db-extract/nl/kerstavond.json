                "senses": [
                    {
                        "sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                        "entry_id": "8dee587a-004c-3869-83e7-6c00841a62a1",
                        "glosses": [
                            "de avond voor kerst op 24 december"
                        ],
                        "tags": [
                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "cd7f7a31-9aa0-4276-afb5-a673767e0c01",
                                "sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                                "text": "Op kerstavond komen er vrienden bij ons eten."
                            },
                            {
                                "example_id": "08726373-b2fe-4dc0-90b1-ffdacff92a0c",
                                "sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                                "text": "Het is natuurlijk een zonde om op kerstavond te applaudisseren, gelukkig dat ik niet de moraal van mijn grootmoeder heb geërfd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428d5938-5bad-4405-9d30-834d31176b8f",
                        "source_entry_id": "8dee587a-004c-3869-83e7-6c00841a62a1",
                        "source_sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                        "target_lang_word": "Heiligabend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiligabend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                        "entry_id": "7cc471cf-d2d5-31d3-aee9-33eaa4b5c4bf",
                                        "glosses": [
                                            "religiöser Feiertag; der 24. Dezember; Vorabend und Auftakt des Weihnachtsfestes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5c0b5a-0fe4-4c4b-bc56-05ba2842cf70",
                                                "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                                "text": "An/Zu Heiligabend findet traditionell die Bescherung statt."
                                            },
                                            {
                                                "example_id": "21102d99-7574-4dea-ac31-934b0b402ba8",
                                                "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                                "text": "„Weihnachten ist das Fest der Familie. An keinem anderen Tag im Jahr wird Gemeinschaft und Zusammensein so zelebriert wie in der Zeit um Heiligabend.“"
                                            },
                                            {
                                                "example_id": "c32953d5-e8d4-4cb1-b168-659840dfe541",
                                                "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                                "text": "„Am Heiligabend lockt ein gewisser Mister Dick, ein Nachbar, sie mit einer Lüge in ein Bordell, wo er sie mit Hilfe der Puffmutter vergewaltigt.“"
                                            },
                                            {
                                                "example_id": "0875608c-cf70-4527-8ffc-60c554c6e3e3",
                                                "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                                "text": "„An Heiligabend fuhren wir mit dem Peugeot nach Vallendar zum Gottesdienst.“"
                                            },
                                            {
                                                "example_id": "f00f0a52-db17-453d-95bc-9fc7c39aed6c",
                                                "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                                "text": "„Kurz vor Heiligabend mauerte das Kölner Straßentheater den Eingang von Karstadt zu.“"
                                            },
                                            {
                                                "example_id": "14cdd7ef-0f9c-48ed-98bc-3410dadd3dca",
                                                "sense_id": "97465d6c-0cf7-35bc-8409-de2dc49e975d",
                                                "text": "„Mir fällt ein, dass Heiligabend ist, und auf einmal bin ich hellwach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54b6431d-2f73-4524-ba8d-da8c64259d4b",
                        "source_entry_id": "8dee587a-004c-3869-83e7-6c00841a62a1",
                        "source_sense_id": "c921d700-8798-3c85-894c-27ab3a039abe",
                        "target_lang_word": "Christmas Eve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christmas Eve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fafb242a-0771-3117-afd6-c5140bd57395",
                                        "entry_id": "2f69bc12-ec2b-36df-ba20-89dabd2f05dd",
                                        "glosses": [
                                            "The evening before Christmas Day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                        "entry_id": "2f69bc12-ec2b-36df-ba20-89dabd2f05dd",
                                        "glosses": [
                                            "The day before Christmas Day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d22bd3-b93f-4bf9-b6b2-383128702613",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "This Collect is to be repeated every day with the other Collects in Advent, until Christmas-Eve."
                                            },
                                            {
                                                "example_id": "972ebf89-cde5-4c61-abce-1fa45cf73673",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "With trembling fingers did we weave\n⁠The holly round the Chrismas hearth;\n⁠A rainy cloud possess’d the earth,\nAnd sadly fell our Christmas-eve."
                                            },
                                            {
                                                "example_id": "d01780cf-1603-4579-b8f0-414b47654ade",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "Why was the cock supposed to crow all Christmas Eve (\"The bird of dawning singeth all night long\")?"
                                            },
                                            {
                                                "example_id": "fd067689-b964-4159-aa33-1fb2bea0ffde",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "The family celebrated Christmas Eves together in the military stockade, sleeping on mattresses on the floor of Ninoy’s cell."
                                            },
                                            {
                                                "example_id": "e186699d-d9e4-4acf-bd04-f9dbc6b5e721",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "Brad led Matthew into the family room where they celebrated Christmas Eves and told Matthew, “Papa’s gone. He’s in heaven, and we’ll never see him again.”"
                                            },
                                            {
                                                "example_id": "eca0f13a-e9e2-4693-93ea-b40d66aa9bc5",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "And I was mourning the future, too. That Wally wouldn’t spend Christmas Eves with both of his parents, dressed up like a Santa or a Christmas pudding, overindulged in the morning."
                                            },
                                            {
                                                "example_id": "7a6cebe3-77a8-483d-9fb2-2975043487ca",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "In 1965, all Coventry's banks closed at noon on Christmas Eve for the first time, to \"enable bank staff to get away at a reasonable time\". […] On Christmas Day itself there will be no trains, for recent experience has shown that few wish to travel then, even on services which had been drastically reduced: earlier closing of shops and offices on Christmas Eve is the chief reason for this change in the pattern of travel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
