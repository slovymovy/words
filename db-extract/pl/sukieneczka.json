                "translations": [
                    {
                        "translation_id": "26eb4062-052a-4fd6-9c0c-20cc046a12e0",
                        "source_entry_id": "9366e23e-e6f8-3016-8058-a1155fe11673",
                        "source_sense_id": "4f4bae41-1154-3f1e-b336-746d0711c5fb",
                        "target_lang_word": "Kleidchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleidchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e34d8980-85e6-3202-8c3d-2846a8fd42c0",
                                        "entry_id": "321a18f6-2b39-3c2b-bbe7-4de8124929a5",
                                        "glosses": [
                                            "kleines und/oder besonders dünnes/leichtes Kleid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c484871c-d6e6-47eb-98f9-1c22a2ffbaa1",
                                                "sense_id": "e34d8980-85e6-3202-8c3d-2846a8fd42c0",
                                                "text": "„Ihre Arme und Beine wogten in wahren Fleischklumpen aus dem blauen Kleidchen hervor und glichen Vanille-Eis-Gebirgen, die zu schmelzen anfangen.“"
                                            },
                                            {
                                                "example_id": "5fc66cbc-581a-438d-9cde-6a576170939c",
                                                "sense_id": "e34d8980-85e6-3202-8c3d-2846a8fd42c0",
                                                "text": "„Madame Page erschien in einem Kleidchen, das man sogar noch im Dämmerlicht des Vorzimmers als verwirrend durchsichtig bezeichnen mußte.“"
                                            },
                                            {
                                                "example_id": "c0ecbc5f-869a-45c2-9d31-2804db7c8715",
                                                "sense_id": "e34d8980-85e6-3202-8c3d-2846a8fd42c0",
                                                "text": "„Ein kleines Mädchen, das barfuß in Holzpantinen lief und dessen Körper man durch das zerlumpte Kleidchen hindurch sehen konnte, brachte den Frauen zu trinken und goß ihnen Apfelmost aus einem Krug ein, den es gegen die Hüfte stützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
