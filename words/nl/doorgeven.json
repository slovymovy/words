                        "overhandigen"
                    ],
                    "antonyms": [
                        "houden"
                    ],
                    "common_phrases": [
                        "het zout doorgeven",
                        "de bal doorgeven"
                    ],
                    "target_lang_definitions": {
                        "en": "To give something you are holding to someone else, often after receiving it yourself",
                        "ru": "Передавать предмет из рук в руки, часто после получения его от кого-то другого",
                        "de": "Etwas, das man in den Händen hält, an eine andere Person weitergeben, oft nachdem man es selbst erhalten hat.",
                        "pl": "Przekazywanie przedmiotu z rąk do rąk, często po otrzymaniu go od kogoś innego.",
                        "fr": "Donner à quelqu'un d'autre quelque chose que vous tenez, souvent après l'avoir reçu vous-même.",
                        "it": "Passare un oggetto che si ha in mano a qualcun altro, spesso dopo averlo ricevuto a propria volta.",
                        "cs": "Předat někomu věc, kterou držíte v rukou, často poté, co jste ji sami dostali.",
                        "tr": "Elinizde tuttuğunuz bir şeyi, genellikle kendiniz aldıktan sonra başka birine vermek.",
                        "es": "Entregar algo que tienes en tus manos a otra persona, a menudo después de haberlo recibido tú mismo.",
                        "zh": "将手中的东西交给另一个人，通常是在自己收到之后。"
