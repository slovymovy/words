                ],
                "senses": [
                    {
                        "sense_id": "28de5849-72db-3404-b669-1034e6c18017",
                        "entry_id": "985e4530-4d62-311a-b1c8-5149228b934b",
                        "glosses": [
                            "имеющий вид струи, струй"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f82c785b-531c-4bf3-a58d-8dcf66ab2ab5",
                                "sense_id": "28de5849-72db-3404-b669-1034e6c18017",
                                "text": "Такое струйное течение жидкости осуществляется в известном приборе Хиль-Шоу, и окрашенные струйки проектируются на экран."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6fda98-8275-31bb-9101-bc17a61a9af1",
                        "entry_id": "985e4530-4d62-311a-b1c8-5149228b934b",
                        "glosses": [
                            "основанный на использовании движения струи (жидкости, газа и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6f3891-983c-4730-b43f-2bf29309c69c",
                                "sense_id": "3b6fda98-8275-31bb-9101-bc17a61a9af1",
                                "text": "Эта трубка вместе с патрубком вдоха образует эжектор или, как его ещё иначе называют, струйный насос."
                            }
                        ]
                    }
