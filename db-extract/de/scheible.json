                ],
                "senses": [
                    {
                        "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                        "entry_id": "616b9671-ed57-35f8-a1b2-21a20dea29f2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b19d5974-158d-468a-9a75-7a5b38d022f3",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Die Scheibles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9709acda-8ba2-4ca7-b913-617f7570373d",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Frau Scheible ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7907d98f-1bcc-4c6e-b60c-eaaff4882492",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Herr Scheible wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a55be544-b8bd-4d72-b751-664f918c0656",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Der Scheible trägt nie die Pullover, die die Scheible ihm strickt."
                            },
                            {
                                "example_id": "1d869b3f-6315-41bb-acc2-e31e11cf4fdf",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheible kommt, geht der Herr Scheible.“"
                            },
                            {
                                "example_id": "1a161ca8-d47b-4b3a-9aa0-8b769ae5cc9c",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Scheible kommt und geht."
                            },
                            {
                                "example_id": "f147d5ec-e92a-4cd0-9499-d5023616dba2",
                                "sense_id": "34f5f7ab-0f0a-32c4-9304-56430d7f95ab",
                                "text": "Scheibles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
