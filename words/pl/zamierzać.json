                    }
                },
                {
                    "sense_id": "6e6d2895-999f-315b-9eb1-767903dce94a",
                    "sense_definition": "przygotowywać się do wykonania rzutu lub uderzenia",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przygotowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawodnik <w>zamierzał</w> się do silnego rzutu piłką.",
                            "target_lang_translations": {
                                "ru": "Спортсмен <w>замахнулся</w> для сильного броска мяча."
                            }
                        },
                        {
                            "text": "Kiedy <w>zamierzasz</w> się do uderzenia, pamiętaj o odpowiedniej postawie.",
                            "target_lang_translations": {
                                "ru": "Когда <w>замахиваешься</w> для удара, помни о правильной стойке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zamierzać się do uderzenia"
                    ],
                    "target_lang_definitions": {
