                "senses": [
                    {
                        "sense_id": "dc2fba11-64a9-35d6-8b9f-4813957f7adf",
                        "entry_id": "70bb6fc3-9161-37dd-9dfb-5e9ce9fbd485",
                        "glosses": [
                            "Person, die regelmäßig und systematisch falsch geparkte Fahrzeuge dokumentiert und den Behörden meldet – meistens aus eigenem Antrieb, ohne offizielles Mandat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5c5f3e24-4b77-4639-b3b2-4b1e14f69303",
                                "sense_id": "dc2fba11-64a9-35d6-8b9f-4813957f7adf",
                                "text": "Falschparkerjäger Niclas M., der sich selbst den Titel Anzeigenhauptmeister gegeben hat, hat am Sonntag bei Instagram ein neues Video veröffentlicht.“"
                            },
                            {
                                "example_id": "36068c91-fccd-4df4-8871-63099d1aebc7",
                                "sense_id": "dc2fba11-64a9-35d6-8b9f-4813957f7adf",
                                "text": "„Einer der aktivsten Falschparkerjäger in der Stadt ist der Stadtverordnete Falko Görres (Die PARTEI).“"
                            },
                            {
                                "example_id": "ba5e15b6-2ddc-4c83-8c51-9d51f842b145",
                                "sense_id": "dc2fba11-64a9-35d6-8b9f-4813957f7adf",
                                "text": "„Falschparkerjäger Niclas M. (18) veröffentlichte bei Instagram am Sonntag (14. April) einen Clip.“"
                            },
                            {
                                "example_id": "94de110a-9bea-4b74-b58a-00537ec8ea86",
                                "sense_id": "dc2fba11-64a9-35d6-8b9f-4813957f7adf",
                                "text": "„Ich habe immer mal wieder eine Behinderung beim Amt in Wismar angezeigt (bin ja kein notorischer Falschparkerjäger).“"
                            },
                            {
                                "example_id": "a716609c-468a-4d49-9ab1-39065df78088",
                                "sense_id": "dc2fba11-64a9-35d6-8b9f-4813957f7adf",
                                "text": "„Ein als ‚Knöllchenhorst‘ berüchtigter privater Falschparkerjäger aus der Nähe von Osterode hat sein Aktionsgebiet vergrößert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
