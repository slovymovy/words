                                        "glosses": [
                                            "The muscle in the back of the leg below the knee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fac26dc-8481-47f3-9daa-90f0f555a1de",
                                                "sense_id": "ee0d79bb-9dc8-3075-9892-51ceea7dce91",
                                                "text": "Sure, his calves are a little weak, but the rest of his physique is so overwhelming, he should place high."
                                            }
