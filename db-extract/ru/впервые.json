                                        "entry_id": "f5f1e738-0a0e-38f9-ac42-dfa762c9d123",
                                        "glosses": [
                                            "frühestes Zutreffen oder Eintreffen bestimmter Umstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19073e0-4407-4870-8721-ed6c1a3596ba",
                                                "sense_id": "240908c9-f091-3c31-b3c4-8ee4bf873d1c",
                                                "text": "Erstmals 1961 gelangte ein Mensch in die Erdumlaufbahn."
                                            },
                                            {
                                                "example_id": "d5b92840-ce21-4100-8cb5-ea4c32316dda",
                                                "sense_id": "240908c9-f091-3c31-b3c4-8ee4bf873d1c",
                                                "text": "„Jetzt liegen der Kommission erstmals konkrete Zahlen vor.“"
                                            },
                                            {
                                                "example_id": "fac8ec6e-f8d0-4dd5-9507-904e2e453733",
                                                "sense_id": "240908c9-f091-3c31-b3c4-8ee4bf873d1c",
                                                "text": "„Zusammen mit Kollegen aus Grossbritannien hat der Forscher im Jahr 2006 in einem vielzitierten Artikel erstmals eine wiederaufladbare Lithium-Luft-Batterie vorgestellt.“"
                                            },
                                            {
                                                "example_id": "82e968bf-0bc9-4730-9266-7244ce56d75e",
                                                "sense_id": "240908c9-f091-3c31-b3c4-8ee4bf873d1c",
                                                "text": "„Zur ISS wollen in diesem Jahr auch die Europäer aufbrechen, und zwar erstmals mit einem eigenen Fluggerät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
