                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to scare",
                                "target_lang_sense_clarification": "to frighten someone"
                            },
                            {
                                "target_lang_word": "to startle",
                                "target_lang_sense_clarification": "to cause someone to jump or feel sudden alarm"
                            },
                            {
                                "target_lang_word": "to frighten",
                                "target_lang_sense_clarification": "to make someone afraid"
                            }
                        ]
