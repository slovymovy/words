{
    "word_family": [
        "inlet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd62cd76-fe73-3a68-9302-deaff8c1fd3e",
                    "sense_definition": "A shop that sells the products of a particular manufacturer or supplier, often at a discounted price.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought these designer shoes at a discount from the factory <w>outlet</w>.",
                            "target_lang_translations": {
                                "ru": "Мы купили эти дизайнерские туфли со скидкой в заводском <w>аутлете</w>.",
                                "zh": "我们在工厂<w>折扣店</w>以折扣价买了这些名牌鞋。"
                            }
                        },
                        {
                            "text": "The company opened a new retail <w>outlet</w> in the city center to sell its clothing.",
                            "target_lang_translations": {
                                "ru": "Компания открыла новую розничную <w>торговую точку</w> в центре города для продажи своей одежды.",
                                "zh": "该公司在市中心开设了一家新的服装<w>直销店</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "shop",
                        "retailer",
                        "branch"
                    ],
                    "common_phrases": [
                        "factory outlet",
                        "retail outlet",
                        "outlet mall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Магазин, продающий товары конкретного производителя или поставщика, часто по сниженным ценам.",
                        "zh": "销售特定制造商或供应商产品（通常以折扣价）的商店。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аутлет",
                                "target_lang_sense_clarification": "магазин распродаж брендовых товаров"
                            },
                            {
                                "target_lang_word": "фирменный магазин",
                                "target_lang_sense_clarification": "магазин от производителя"
                            },
                            {
                                "target_lang_word": "торговая точка",
                                "target_lang_sense_clarification": "место розничной продажи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折扣店",
                                "target_lang_sense_clarification": "以折扣价销售商品的商店"
                            },
                            {
                                "target_lang_word": "品牌直销店",
                                "target_lang_sense_clarification": "厂家直销的门店"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc77eda-aba0-39e6-a1be-041b63d97908",
                    "sense_definition": "A wall-mounted device connected to an electrical power supply where appliances can be plugged in.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to find an electrical <w>outlet</w> to charge my phone before the battery dies.",
                            "target_lang_translations": {
                                "ru": "Мне нужно найти электрическую <w>розетку</w>, чтобы зарядить телефон, пока не села батарея.",
                                "zh": "我得在手机没电前找个<w>插座</w>充电。"
                            }
                        },
                        {
                            "text": "Please do not overload the power <w>outlet</w> by plugging in too many devices at once.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не перегружайте <w>розетку</w>, подключая слишком много устройств одновременно.",
                                "zh": "请不要一次插入太多设备，以免造成<w>插座</w>过载。"
                            }
                        }
                    ],
                    "synonyms": [
                        "socket",
                        "power point",
                        "wall plug"
                    ],
                    "common_phrases": [
                        "power outlet",
                        "electrical outlet",
                        "wall outlet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настенное устройство, подключенное к электросети, для подключения бытовых приборов.",
                        "zh": "安装在墙上并连接到电源的装置，用于插入电器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розетка",
                                "target_lang_sense_clarification": "электрический разъем"
                            },
                            {
                                "target_lang_word": "штепсельная розетка",
                                "target_lang_sense_clarification": "техническое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "插座",
                                "target_lang_sense_clarification": "连接电器的电源接口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd31947-6400-3a6d-8d64-c77fe4523381",
                    "sense_definition": "A means of expressing strong feelings, energy, or talents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Painting became a creative <w>outlet</w> for her to express her hidden emotions.",
                            "target_lang_translations": {
                                "ru": "Живопись стала для неё творческой <w>отдушиной</w>, позволяющей выразить скрытые эмоции.",
                                "zh": "绘画成了她表达内心隐秘情感的一种创造性<w>宣泄口</w>。"
                            }
                        },
                        {
                            "text": "Regular exercise provides a healthy <w>outlet</w> for stress and excess energy.",
                            "target_lang_translations": {
                                "ru": "Регулярные физические упражнения дают здоровый <w>выход</w> стрессу и избыточной энергии.",
                                "zh": "经常锻炼是释放压力和多余精力的健康<w>途径</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "channel",
                        "vent"
                    ],
                    "common_phrases": [
                        "creative outlet",
                        "emotional outlet",
                        "outlet for stress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ выражения сильных чувств, энергии или талантов.",
                        "zh": "表达强烈情感、精力或才华的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдушина",
                                "target_lang_sense_clarification": "средство успокоения, выражения эмоций"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "разрядка для энергии или чувств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宣泄口",
                                "target_lang_sense_clarification": "释放情绪或压力的途径"
                            },
                            {
                                "target_lang_word": "途径",
                                "target_lang_sense_clarification": "发挥才华或表达情感的渠道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9f2258d-d969-3af6-a549-c840be2763f2",
                    "sense_definition": "An opening or passage that allows something, such as liquid or gas, to escape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water flows through a small <w>outlet</w> at the bottom of the tank.",
                            "target_lang_translations": {
                                "ru": "Вода вытекает через небольшое <w>отверстие</w> на дне резервуара.",
                                "zh": "水通过水箱底部的一个小<w>出口</w>流出。"
                            }
                        },
                        {
                            "text": "You should check the air <w>outlet</w> regularly to ensure it is not blocked by dust.",
                            "target_lang_translations": {
                                "ru": "Вам следует регулярно проверять <w>выпускное отверстие</w> для воздуха, чтобы убедиться, что оно не забито пылью.",
                                "zh": "你应该定期检查通风<w>排出口</w>，确保没有被灰尘堵塞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vent",
                        "opening",
                        "exit"
                    ],
                    "antonyms": [
                        "inlet"
                    ],
                    "common_phrases": [
                        "water outlet",
                        "air outlet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отверстие или канал, позволяющий чему-либо (например, жидкости или газу) выходить наружу.",
                        "zh": "允许液体或气体等物质排出的开口或通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходное отверстие",
                                "target_lang_sense_clarification": "техническое отверстие"
                            },
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "место выхода газа или жидкости"
                            },
                            {
                                "target_lang_word": "сток",
                                "target_lang_sense_clarification": "отверстие для слива жидкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出口",
                                "target_lang_sense_clarification": "气体或液体的排放口"
                            },
                            {
                                "target_lang_word": "排出口",
                                "target_lang_sense_clarification": "用于排出的通道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "521467fe-3118-39b8-ad13-bf9892149858",
                    "sense_definition": "A stream or river that flows out of a lake or pond.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geographical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We fished near the <w>outlet</w> of the lake where the current was particularly strong.",
                            "target_lang_translations": {
                                "ru": "Мы рыбачили у <w>стока</w> озера, где течение было особенно сильным.",
                                "zh": "我们在湖泊<w>出水口</w>附近钓鱼，那里的水流特别急。"
                            }
                        },
                        {
                            "text": "The <w>outlet</w> carries fresh water from the reservoir down to the valley below.",
                            "target_lang_translations": {
                                "ru": "<w>Сток</w> несет пресную воду из водохранилища вниз в долину.",
                                "zh": "这条<w>出水口</w>将水库的淡水输送到下方的山谷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outflow"
                    ],
                    "antonyms": [
                        "inlet"
                    ],
                    "common_phrases": [
                        "lake outlet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток или река, вытекающая из озера или пруда.",
                        "zh": "从湖泊或池塘中流出的河流或溪流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сток",
                                "target_lang_sense_clarification": "место вытекания воды из водоема"
                            },
                            {
                                "target_lang_word": "исток",
                                "target_lang_sense_clarification": "начало реки (вытекающей из озера)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出水口",
                                "target_lang_sense_clarification": "湖泊水流出的地方"
                            },
                            {
                                "target_lang_word": "河口",
                                "target_lang_sense_clarification": "河流流出的源头"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}