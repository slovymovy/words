                    {
                        "sense_id": "7c3f8f1b-6f6b-3388-9e1a-f68bbc0c7bb5",
                        "entry_id": "fcf95d6c-de40-3ae5-ba43-aacda632ec51",
                        "glosses": [
                            "lijden veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0452183f-ac09-4bfa-a743-78b16f1bb226",
                                "sense_id": "7c3f8f1b-6f6b-3388-9e1a-f68bbc0c7bb5",
                                "text": "De smartelijke dood van de geliefde vorstin zou nog lang de gemoederen in beweging houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "300af31b-be3f-4229-8d50-599672cf34a0",
                        "source_entry_id": "fcf95d6c-de40-3ae5-ba43-aacda632ec51",
                        "source_sense_id": "7c3f8f1b-6f6b-3388-9e1a-f68bbc0c7bb5",
                        "source_sense_description": "lijden veroorzakend",
                        "target_lang_word": "schlimm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlimm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "274784e9-e113-39fc-8362-344663a7876d",
                                        "entry_id": "b4049609-027b-3ef0-80e0-c454b516ddd2",
                                        "glosses": [
                                            "sehr negativ; nicht gut"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a71515-7752-4866-a4f2-5ce303a21d5e",
                                                "sense_id": "274784e9-e113-39fc-8362-344663a7876d",
                                                "text": "Deine schlimme Handschrift kann kein Mensch lesen."
                                            },
                                            {
                                                "example_id": "4630286f-66e9-4278-b611-bb3b5d41d5c6",
                                                "sense_id": "274784e9-e113-39fc-8362-344663a7876d",
                                                "text": "„Seine Träger haben ihn im Stich gelassen und der feindlichen Natur ausgeliefert - ein schlimmer Schock, dessen Tragweite nachträglich zu schildern fast unmöglich ist.“"
                                            },
                                            {
                                                "example_id": "32129467-a90d-4eeb-a5e7-958d5bc45935",
                                                "sense_id": "274784e9-e113-39fc-8362-344663a7876d",
                                                "text": "„Über fünf Jahre liegt die Barschel-Affäre zurück – das schlimmste politische Bubenstück der westdeutschen Nachkriegsgeschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c77bf0a7-d271-3b24-bb10-f47dd45d7f73",
                                        "entry_id": "b4049609-027b-3ef0-80e0-c454b516ddd2",
                                        "glosses": [
                                            "gegen anerkannte Werte verstoßend"
                                        ],
                                        "tags": [
                                            "sittlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f84266-a068-4e85-a8d4-0f18686576a0",
                                                "sense_id": "c77bf0a7-d271-3b24-bb10-f47dd45d7f73",
                                                "text": "„Über fünf Jahre liegt die Barschel-Affäre zurück – das schlimmste politische Bubenstück der westdeutschen Nachkriegsgeschichte.“"
                                            },
                                            {
                                                "example_id": "90e33e74-01f9-4395-8d1d-3824c590327f",
                                                "sense_id": "c77bf0a7-d271-3b24-bb10-f47dd45d7f73",
                                                "text": "Sie kann diese schlimmen Taten niemals vergessen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9946df5b-07ad-3a34-8915-447fc029033a",
                                        "entry_id": "b4049609-027b-3ef0-80e0-c454b516ddd2",
                                        "glosses": [
                                            "(Stelle des Körpers) nicht gesund, (chronisch) krank oder entzündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1189f3f4-1ae3-473a-b288-465b962d5441",
                                                "sense_id": "9946df5b-07ad-3a34-8915-447fc029033a",
                                                "text": "Dein Opa hat ein schlimmes Bein und kann nicht so schnell laufen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7146085c-c57a-3ea4-a457-e2b0e6015f4a",
                                        "entry_id": "b4049609-027b-3ef0-80e0-c454b516ddd2",
                                        "glosses": [
                                            "(Krankheiten, Verletzungen, etc.) bedrohlich oder ernsthaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66dbc6e3-bee4-4a5b-b7ac-31c75510ffa5",
                                                "sense_id": "7146085c-c57a-3ea4-a457-e2b0e6015f4a",
                                                "text": "Ich wurde verletzt, aber es ist nicht so schlimm."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64c7b6fb-5557-4390-b95e-29cba4a69fcf",
                        "source_entry_id": "fcf95d6c-de40-3ae5-ba43-aacda632ec51",
                        "source_sense_id": "7c3f8f1b-6f6b-3388-9e1a-f68bbc0c7bb5",
