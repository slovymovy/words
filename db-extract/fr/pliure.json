                    {
                        "translation_id": "433e18e0-a400-4d2e-8e5a-35163ea44609",
                        "source_entry_id": "493110c6-25f1-3924-ad74-cd43fc6b2713",
                        "source_sense_id": "f8448fdb-189b-3e52-ba9a-6aaf6a0c4b1f",
                        "target_lang_word": "Falte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                        "entry_id": "17e688dd-af9d-3f30-b068-580774b5b0e2",
                                        "glosses": [
                                            "längliche Unebenheit in ebenen, glatten Oberflächen insbesondere bei textilen Stoffen, Papier, Haut und Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b64e9e6-2a44-488a-b7bc-5a4851f3dc6d",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "Er hat schon viele Falten im Gesicht."
                                            },
                                            {
                                                "example_id": "88978f23-6e0f-4737-b18c-64311eee1d67",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "Ich muss die Bluse noch einmal bügeln, am Kragen sind noch lauter kleine Falten."
                                            },
                                            {
                                                "example_id": "df79f202-2301-4a60-b581-b4d43b6c9e4e",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "„Sie trug nichts darunter, und ihre Brustwarzen stießen spitz durch den leichten Stoff und ließen ihn in zwei schmalen, abstehenden Falten bis zum Saum fallen.“"
                                            },
                                            {
                                                "example_id": "ff3a76e6-f3fd-4d43-8603-b418173cbcd6",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "„Darunter lagen schneeweiße Linnenlaken mit frischen Falten.“"
                                            },
                                            {
                                                "example_id": "08d78647-d0c2-4986-a1d1-11d2b831deed",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "„Die kleinen Falten um seine funkelnden Augen vertieften sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15728c7d-3bf1-448a-9ffc-3f429fe697cd",
                        "source_entry_id": "493110c6-25f1-3924-ad74-cd43fc6b2713",
