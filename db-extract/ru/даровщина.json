                "senses": [
                    {
                        "sense_id": "5fe895e7-c18e-3786-9882-14c9337d2793",
                        "entry_id": "b99891de-ac24-3e84-8407-253ef2cd2193",
                        "glosses": [
                            "прост. то же, что дармовщина; то, что достаётся даром или за чужой счёт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296cd94c-dfea-4102-8322-23fd80b84f73",
                                "sense_id": "5fe895e7-c18e-3786-9882-14c9337d2793",
                                "text": "Им бы все как-нибудь деньги за даровщину получить, только у них и на уме…"
                            },
                            {
                                "example_id": "8b4366e5-f95f-4170-9a87-fb5470b67ac8",
                                "sense_id": "5fe895e7-c18e-3786-9882-14c9337d2793",
                                "text": "Тогда Ланко и понял: обделила ею голубая змейка за то, что пожадничал на даровщину."
                            }
                        ]
                    }
                ],
