                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510a6fc8-dda6-4311-9d82-ac9c023a4338",
                                                "sense_id": "3b69953b-744a-34f6-a9ac-59d38dcaa08d",
                                                "text": "Hast du schon mit den Tessins besprochen, wann die Geburtstagsfeier stattfinden soll?"
                                            },
                                            {
                                                "example_id": "283dd1b4-00f1-4660-b97b-4b2458e1c24a",
                                                "sense_id": "3b69953b-744a-34f6-a9ac-59d38dcaa08d",
                                                "text": "Frau Tessin befindet sich derzeit auf einer Bohrinsel im Atlantik."
                                            },
                                            {
                                                "example_id": "45d1d34e-2297-422e-8d6e-b0367ec1a857",
                                                "sense_id": "3b69953b-744a-34f6-a9ac-59d38dcaa08d",
                                                "text": "Stimmt es, dass der alte Tessin ein neues Hüftgelenk hat?"
                                            },
                                            {
                                                "example_id": "95e06ec8-aeb5-4243-beac-541d21424aab",
                                                "sense_id": "3b69953b-744a-34f6-a9ac-59d38dcaa08d",
                                                "text": "Gertrud rief ihrer Freundin Jutta über die Straße zu: „Hallo Tessin! Lange nicht gesehen!“"
                                            },
                                            {
                                                "example_id": "83fee6fe-61e6-4c2c-a7c8-67e869cc7800",
                                                "sense_id": "3b69953b-744a-34f6-a9ac-59d38dcaa08d",
                                                "text": "Tessins neuestes Hobby ist das Laubsägen."
                                            },
                                            {
                                                "example_id": "b7876981-304f-41c3-be43-0ffdbf718814",
                                                "sense_id": "3b69953b-744a-34f6-a9ac-59d38dcaa08d",
                                                "text": "Herrn Tessins Karriere ist ins Stocken geraten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
