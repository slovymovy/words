                                            {
                                                "example_id": "c11252b7-4229-4e68-83bf-6080cfe76852",
                                                "sense_id": "ff91511d-e5bc-3ed2-826c-1949594d81a8",
                                                "text": "our souls, not yet prepared for upper light"
