                        "sense_id": "f6203aed-63d2-3edd-b23f-d77ccf26e31f",
                        "entry_id": "1b3ac34d-14b6-3440-bf8b-dc2521df603f",
                        "glosses": [
                            "To consecrate."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ca672b-5e35-4e5f-963d-5d6ad306a4bf",
                                "sense_id": "f6203aed-63d2-3edd-b23f-d77ccf26e31f",
                                "text": "c.''' 1382-1395, John Wycliffe, Bible (Wycliffe), Exodus 28:41,\nAnd thou schalt clothe Aaron, thi brother, with alle these, and hise sones with hym. And thou schalt sacre the hondis of alle; and thou schalt halewe hem, that thei be set in preesthood to me."
                            },
                            {
                                "example_id": "a81b7028-b078-4a31-aafc-977ddee87e8f",
                                "sense_id": "f6203aed-63d2-3edd-b23f-d77ccf26e31f",
                                "text": "And I purpose this night to sacre you all with the Holy Incense."
                            },
                            {
                                "example_id": "43413661-862d-4bd7-a681-9ed879cd6aa9",
                                "sense_id": "f6203aed-63d2-3edd-b23f-d77ccf26e31f",
                                "text": "From the coronation of Louis the Pious in 813 until that of Ferdinand I. in 1531 the sacring of the German kings took place at Aix, and as many as thirty-two emperors and kings were here crowned."
                            }
                        ]
                    }
