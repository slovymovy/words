                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627d2b1e-0b84-4aff-9f25-8350988186dd",
                                                "sense_id": "fb4973a7-40b0-3625-9e95-feda7eb3de6b",
                                                "text": "Жена его была настоящая «дама», и по первому взгляду в ней трудно было признать еврейку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e8b8c3-e16b-3f9c-882f-6955ae083b13",
                                        "entry_id": "a7151aa0-d831-3342-ae31-c62cc7c5b4cb",
                                        "glosses": [
                                            "объявить, вынести официальное заключение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b17f9de-1012-48f5-a8f8-fb7b138f5ce2",
                                                "sense_id": "27e8b8c3-e16b-3f9c-882f-6955ae083b13",
                                                "text": "Чаадаев хочет оправдать свое письмо, за которое признан был сумасшедшим."
                                            },
                                            {
                                                "example_id": "07103999-ebf8-470e-a1d6-c1e1a65ee934",
                                                "sense_id": "27e8b8c3-e16b-3f9c-882f-6955ae083b13",
                                                "text": "Кадеты были официально признаны «врагами народа», а некоторые из них были заключены в тюрьму."
                                            }
                                        ]
                                    }
                                ]
                            }
