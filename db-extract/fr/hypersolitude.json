                "senses": [
                    {
                        "sense_id": "2d21c6fd-2db3-3b84-ac5e-44d845605545",
                        "entry_id": "20942515-23f1-324a-9ea1-cfd7ae5206cf",
                        "glosses": [
                            "Solitude extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a7647de-b067-4ead-89ec-bb3c3e1c3ca9",
                                "sense_id": "2d21c6fd-2db3-3b84-ac5e-44d845605545",
                                "text": "Le Dr Michel Craplet, lui, dénonce l’«hypersolitude» de ces personnes qui s’autosoignent."
                            },
                            {
                                "example_id": "0f8e4573-be06-4775-a4a6-54fdb9f67660",
                                "sense_id": "2d21c6fd-2db3-3b84-ac5e-44d845605545",
                                "text": "Nous menons en ce moment une série d'entretiens avec des joueurs, […], et leurs propos nous captivent, qui décrivent en creux les contours avec Philipe Vasset, un auteur dont nous aimons de l’hypersolitude contemporaine mais aussi beaucoup le travail."
                            },
                            {
                                "example_id": "efcd6760-e2b9-4cda-9040-7c14a1e5fe93",
                                "sense_id": "2d21c6fd-2db3-3b84-ac5e-44d845605545",
                                "text": "Les années quatre-vingt ont consacré l’enfant-roi mais aussi travaillé en profondeur les mentalités vers toujours plus d’individualisme, cet état ambivalent de l’autonomie et de l’hypersolitude."
                            }
                        ]
                    }
