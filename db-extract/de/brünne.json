                ],
                "senses": [
                    {
                        "sense_id": "ba1d2c7b-a954-3069-b94a-51b582c1557e",
                        "entry_id": "52a70b9f-b6b9-359a-b471-206f454f9ef1",
                        "glosses": [
                            "Rüstung oder Teil einer Rüstung"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f50fd77d-f40d-4831-8653-55fcc601b05a",
                                "sense_id": "ba1d2c7b-a954-3069-b94a-51b582c1557e",
                                "text": "„Niemand weiß bis heute, weshalb es Harald seinen Kriegern erlaubt, ihre Brünnen und Lederpanzer zurückzulassen.“"
                            },
                            {
                                "example_id": "46db1e04-4490-42eb-8a9c-c81d351ed378",
                                "sense_id": "ba1d2c7b-a954-3069-b94a-51b582c1557e",
                                "text": "„Laut Siecke sei die Brünne nicht anders zu beurteilen als die nur dem Peliden von Hephaistos geschmiedete Rüstung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d09ff463-10f9-3c92-955c-ea83ada72112",
                        "entry_id": "52a70b9f-b6b9-359a-b471-206f454f9ef1",
                        "glosses": [
                            "Nackenschutz der mittelalterlichen Ritterrüstung"
                        ],
                        "tags": [
                            "historical",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "734e9c65-535d-45b7-be05-19666b9bcda9",
                                "sense_id": "d09ff463-10f9-3c92-955c-ea83ada72112",
                                "text": "„Niemand weiß bis heute, weshalb es Harald seinen Kriegern erlaubt, ihre Brünnen und Lederpanzer zurückzulassen.“"
                            },
                            {
                                "example_id": "482aa624-43a8-4f53-9fad-e395055bb1d3",
                                "sense_id": "d09ff463-10f9-3c92-955c-ea83ada72112",
                                "text": "„Halsberk und Brünne haben eine Art Kapuze, das Hersenier, auch Gupfe, die über den Kopf gezogen wurde, nachdem man vorher eine gepolsterte Haube […] aufgesetzt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dfb3cbf6-5b51-31be-b2ed-eacc60a34e89",
                        "entry_id": "52a70b9f-b6b9-359a-b471-206f454f9ef1",
                        "glosses": [
                            "Panzerhemd"
                        ],
                        "tags": [
                            "historical",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "fbf21ac9-ff58-4581-9bac-79e4f793cb5d",
                                "sense_id": "dfb3cbf6-5b51-31be-b2ed-eacc60a34e89",
                                "text": "„Niemand weiß bis heute, weshalb es Harald seinen Kriegern erlaubt, ihre Brünnen und Lederpanzer zurückzulassen.“"
                            },
                            {
                                "example_id": "770640f8-d2d1-4690-a450-79cad663dd22",
                                "sense_id": "dfb3cbf6-5b51-31be-b2ed-eacc60a34e89",
                                "text": "„Halsberk und Brünne haben eine Art Kapuze, das Hersenier, auch Gupfe, die über den Kopf gezogen wurde, nachdem man vorher eine gepolsterte Haube […] aufgesetzt hatte.“"
                            },
                            {
                                "example_id": "6f347071-68f4-40e1-be42-09e62c084ab1",
                                "sense_id": "dfb3cbf6-5b51-31be-b2ed-eacc60a34e89",
                                "text": "„Die Brünne war fest als wär sie ans Fleisch gewachsen. Da ritzte er mit Gram die Brünne durch vom Haupt herab und darnach auch an beiden Armen. Darauf zog er ihr die Brünne ab; aber sie erwachte, richtete sich empor, sah den Sigurd an.“"
                            },
                            {
                                "example_id": "122b1358-7a8d-4896-bc0b-4e6fd218d597",
                                "sense_id": "dfb3cbf6-5b51-31be-b2ed-eacc60a34e89",
                                "text": "„Der Helm hatte kein Visier, die Brünne war ein Panzerhemd, welches den Nacken frei ließ.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
