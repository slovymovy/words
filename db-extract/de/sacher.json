                ],
                "senses": [
                    {
                        "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                        "entry_id": "be748fed-d3d0-359b-9fed-ef37c3f326da",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58aaebbe-3d14-4bf1-8072-f462972f1e84",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Sachers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "81ec7447-ac97-4289-8916-db380c5bab55",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Frau Sacher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5cdb3cc2-0485-4385-a905-d871e5340f21",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Herr Sacher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ba5bb1eb-1955-4119-a04d-b898da149f50",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Die Sachers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "aec57f7e-289a-4f37-b1a7-aabf8e7450a7",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Der Sacher trägt nie die Schals, die die Sacher ihm strickt."
                            },
                            {
                                "example_id": "a31c3e17-8b75-4419-a881-61f241365b8c",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sacher kommt, geht der Herr Sacher.“"
                            },
                            {
                                "example_id": "da852f07-af32-4f09-bfe2-9fa962df3476",
                                "sense_id": "6dd55ed3-2039-3802-87ac-1d828430b7fc",
                                "text": "Sacher kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
