{
    "word_family": [
        "pozwolenie",
        "pozwolony",
        "przyzwalać",
        "przyzwolenie",
        "dozwolony",
        "zezwolenie",
        "samowola"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1021bf59-3de9-3f3a-8e8e-3e09173283d5",
                    "sense_definition": "dawać komuś zgodę lub zezwolenie na zrobienie czegoś, nie stawiać przeszkód",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pozwolenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama nie <w>pozwala</w> mi wracać do domu po zmroku.",
                            "target_lang_translations": {
                                "ru": "Мама не <w>разрешает</w> мне возвращаться домой затемно."
                            }
                        },
                        {
                            "text": "Nauczyciel rzadko <w>pozwala</w> uczniom korzystać ze słowników podczas ważnego egzaminu.",
                            "target_lang_translations": {
                                "ru": "Учитель редко <w>позволяет</w> ученикам пользоваться словарями во время важного экзамена."
                            }
                        }
                    ],
                    "synonyms": [
                        "dozwalać",
                        "przyzwalać",
                        "zezwalać"
                    ],
                    "antonyms": [
                        "zabraniać",
                        "zakazać"
                    ],
                    "common_phrases": [
                        "pozwalać dzieciom na wszystko",
                        "nie pozwalać na hałas"
                    ],
                    "target_lang_definitions": {
                        "ru": "давать кому-либо согласие или разрешение сделать что-либо, не препятствовать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "давать согласие, разрешение"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "не препятствовать, допускать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5729d7c9-ad75-373c-bbab-92d152c99840",
                    "sense_definition": "tworzyć warunki sprzyjające zaistnieniu czegoś, czynić coś możliwym do wykonania",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "umożliwianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nowoczesny kurs <w>pozwala</w> szybko nabrać biegłości w codziennej obsłudze komputera.",
                            "target_lang_translations": {
                                "ru": "Этот современный курс <w>позволяет</w> быстро освоить повседневную работу на компьютере."
                            }
                        },
                        {
                            "text": "Dobra pogoda <w>pozwalała</w> turystom na długie wędrówki po stromych górskich szlakach.",
                            "target_lang_translations": {
                                "ru": "Хорошая погода <w>давала возможность</w> туристам совершать долгие походы по крутым горным тропам."
                            }
                        }
                    ],
                    "synonyms": [
                        "umożliwiać"
                    ],
                    "common_phrases": [
                        "pozwalać zaoszczędzić czas",
                        "pozwalać uniknąć błędów"
                    ],
                    "target_lang_definitions": {
                        "ru": "создавать благоприятные условия для чего-либо, делать что-либо возможным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "давать возможность"
                            },
                            {
                                "target_lang_word": "давать возможность",
                                "target_lang_sense_clarification": "делать возможным осуществление чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55d5e06c-3d3e-3bc1-9644-a973e9debe0a",
                    "sense_definition": "dawać samemu sobie prawo do zachowania niestosownego, zuchwałego lub zbyt swobodnego (w połączeniu z «sobie»)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pozwolenie_sobie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten arogancki pracownik zdecydowanie zbyt wiele sobie <w>pozwala</w> w rozmowach z dyrektorem.",
                            "target_lang_translations": {
                                "ru": "Этот высокомерный сотрудник определенно слишком много себе <w>позволяет</w> в разговорах с директором."
                            }
                        },
                        {
                            "text": "Nie powinniście sobie <w>pozwalać</w> na takie złośliwe komentarze wobec obcych ludzi.",
                            "target_lang_translations": {
                                "ru": "Вам не следует <w>позволять себе</w> такие язвительные замечания в адрес незнакомых людей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zbyt wiele sobie pozwalać",
                        "pozwalać sobie na zbyt wiele"
                    ],
                    "target_lang_definitions": {
                        "ru": "допускать в отношении себя неподобающее, дерзкое или слишком вольное поведение (в сочетании с «sobie»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позволять себе",
                                "target_lang_sense_clarification": "вести себя слишком вольно или дерзко"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb2e6e0d-025d-3bf2-88ae-7a672e02f627",
                    "sense_definition": "użyczać czegoś, obdarzać kogoś czymś (często w odniesieniu do odpoczynku, spokoju lub łaski)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "udzielanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medycyna wreszcie <w>pozwalała</w> cierpiącym pacjentom zaznać odrobiny upragnionego spokoju.",
                            "target_lang_translations": {
                                "ru": "Медицина наконец-то <w>давала</w> страдающим пациентам почувствовать немного желанного покоя."
                            }
                        },
                        {
                            "text": "Los rzadko <w>pozwalał</w> im na chwile wytchnienia od ciężkiej pracy.",
                            "target_lang_translations": {
                                "ru": "Судьба редко <w>позволяла</w> им урвать минуты передышки от тяжелого труда."
                            }
                        }
                    ],
                    "synonyms": [
                        "dawać",
                        "udzielać",
                        "użyczać"
                    ],
                    "common_phrases": [
                        "pozwalać zaznać spokoju"
                    ],
                    "target_lang_definitions": {
                        "ru": "предоставлять что-либо, даровать (часто об отдыхе, покое, передышке)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "предоставлять возможность испытать что-либо"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "давать передышку, покой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}