                    {
                        "translation_id": "8bf218b5-cf3a-4ad4-b62b-1ebd5309b06f",
                        "source_entry_id": "4a688218-77f7-3bfc-9614-b52b27432fed",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Graf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a306afe-fe76-3b8b-b2f0-cfde816e05f9",
                                        "entry_id": "0f216a16-ad4e-39d9-8ec5-e86c3ab2629a",
                                        "glosses": [
                                            "Adelstitel im Rang unter dem Fürsten und über dem Freiherrn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7224a39b-bd0f-4ce6-bdcf-1cef69add134",
                                                "sense_id": "6a306afe-fe76-3b8b-b2f0-cfde816e05f9",
                                                "text": "Der König ernannte ihn zum Grafen."
                                            },
                                            {
                                                "example_id": "fcb9f04f-d898-4e62-9d68-17c9155ba148",
                                                "sense_id": "6a306afe-fe76-3b8b-b2f0-cfde816e05f9",
                                                "text": "„Der Markgraf der Nordmark, Wilhelm, der selbst den Angriff leitete, fiel am 10. Sept. 1056 mit einer großen Zahl seiner Mitkämpfer, darunter Graf Dietrich von Katlenburg.“"
                                            },
                                            {
                                                "example_id": "80c9b5fe-f53f-49e3-b89d-4ae4cd68b5bd",
                                                "sense_id": "6a306afe-fe76-3b8b-b2f0-cfde816e05f9",
                                                "text": "„Am 1. Juli 1900 wagte Graf Zeppelin den ersten Flug mit dem nach ihm benannten Fluggerät über den Bodensee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                        "entry_id": "0f216a16-ad4e-39d9-8ec5-e86c3ab2629a",
                                        "glosses": [
                                            "Mann mit Grafentitel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4045ca7-accd-47b9-beb5-0bca1ae18b2d",
                                                "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                                "text": "Der Graf ist heute nicht anwesend."
                                            },
                                            {
                                                "example_id": "829f0ea6-e9d7-45df-992a-b54c9b13b67e",
                                                "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                                "text": "„Die Bostontische wurden aufgestellt, es bildeten sich Gruppen von Spielern, und die Gäste des Grafen verteilten sich auf die beiden Salons, das Diwanzimmer und die Bibliothek.“"
                                            },
                                            {
                                                "example_id": "6f9ab909-6a3c-4922-a628-98356d9490e6",
                                                "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                                "text": "„Der Obrist war ein vornehmer und hochgelahrter Edelmann, Graf und Baron und Junker aus dem Lande Pommern und residierte hier auf einem Rittergut in der Nachbarschaft.“"
                                            },
                                            {
                                                "example_id": "6de039f0-d318-4971-8603-5e0786838710",
                                                "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                                "text": "„Aber schon öffnete der Graf die Tür.“"
                                            },
                                            {
                                                "example_id": "602b6e62-275e-47be-b74d-eeed6608b79c",
                                                "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                                "text": "„Auch wenn die meisten Gutsherren in den 1930er Jahren keine Grafen und Freiherrn mehr waren, verhielten sie sich oft so.“"
                                            },
                                            {
                                                "example_id": "223d2cba-1725-46c5-a308-a4c1f596109a",
                                                "sense_id": "fba4e4bf-a9fe-36a8-a02b-a9420bbb6c2c",
                                                "text": "„Am 1. Juli 1900 wagte Graf Zeppelin den ersten Flug mit dem nach ihm benannten Fluggerät über den Bodensee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f6c598ca-1237-3fbb-a44b-e5cfd54ded4b",
                                        "entry_id": "0f216a16-ad4e-39d9-8ec5-e86c3ab2629a",
                                        "glosses": [
                                            "Darstellung einer mathematischen Funktion"
                                        ],
                                        "tags": [
                                            "andere Schreibweise für Graph"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd0e7456-4c6d-4a36-93fc-ba50f493fc01",
                                                "sense_id": "f6c598ca-1237-3fbb-a44b-e5cfd54ded4b",
                                                "text": "„Diese Definition verwendet direkt die in der Grafentheorie gebräuchlichen Begriffe Pfad und stark zusammenhängend. Man kann deshalb die in der Grafentheorie entwickelten Algorithmen für die Bestimmung stark zusammenhängender Knoten verwenden, wenn man das Blcokschaltbild als gerichteten Grafen interpretiert.“"
                                            },
                                            {
                                                "example_id": "582cde7c-455b-4f15-ac09-fb8a18f828ed",
                                                "sense_id": "f6c598ca-1237-3fbb-a44b-e5cfd54ded4b",
                                                "text": "„Den Funktionsgraf einer Umkehrfunktion erhält man durch Spiegelung des originalen Grafen an der Winkelhalbierenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Graf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52c00c78-d2e8-3460-ba84-9c0582b2b486",
                                        "entry_id": "c6dd7e84-e55c-3f76-8945-54cdbeeeed41",
                                        "glosses": [
