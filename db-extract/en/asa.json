                        "entry_id": "7eabf436-3566-3448-9f0f-823d09dab52b",
                        "glosses": [
                            "The third king of Judah mentioned in the Books of Kings who succeeded his father Abijah; the father of King Jehoshaphat. (Matthew calls him \\\"Asaph\\\" in Matthew 1:7.)"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "316bcf51-47c4-4065-a06d-7e425de6aac4",
                                "sense_id": "a04ef234-96d9-301f-9ca3-471c8752602e",
                                "text": "And in the twentieth year of Jeroboam king of Israel reigned Asa over Judah. And forty and one years reigned he in Jerusalem. And his mother's name was Maachah, the daughter of Abishalom. And Asa did that which was right in the eyes of the LORD, as did David his father."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2f478e6-85a1-3a66-a7c2-48908cce0d5e",
                        "entry_id": "7eabf436-3566-3448-9f0f-823d09dab52b",
                        "glosses": [
                            "A male given name from Hebrew first used by Puritans."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
