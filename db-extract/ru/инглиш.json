                                            {
                                                "example_id": "29494c2c-57cb-4eeb-a155-eff70ac296d9",
                                                "sense_id": "cbff8bf9-9d0d-32e6-b1f4-a6120fe7e6e6",
                                                "text": "Cricket—a game which the English, not being a spiritual people, have invented in order to give themselves some conception of eternity."
                                            },
                                            {
                                                "example_id": "ece04378-73c9-4817-9e6b-4a2325a71a40",
                                                "sense_id": "cbff8bf9-9d0d-32e6-b1f4-a6120fe7e6e6",
                                                "text": "The English and the ROTW have a long history of conflict, periodically interrupted for tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1688dc9-b66b-3f75-9bfe-8a191cd751e3",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "The non-Amish, people outside the Amish faith and community."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ebb4f25-0965-33b7-8c42-1b4c7a4a492a",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "Facility with the English language, ability to employ English correctly and idiomatically."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea9dcf37-20b0-4804-bbb1-808dcc74e2d7",
                                                "sense_id": "0ebb4f25-0965-33b7-8c42-1b4c7a4a492a",
                                                "text": "Sorry, my English isn't very good. I wish I had better English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c4d981-781b-3b21-aa12-0517d282d2c9",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "A particular instance of the English language, including:",
                                            "The English term or expression for some thing or idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e47bbb19-54c2-4991-b03f-8641e3a7a4d4",
                                                "sense_id": "30c4d981-781b-3b21-aa12-0517d282d2c9",
                                                "text": "What's the English for 'à peu près'? It depends: how is it being used?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7961ca8-65c1-3076-a744-1ddc745f76ce",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "A particular instance of the English language, including:",
                                            "The English text or phrasing of some spoken or written communication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c982f4fd-267f-4365-8224-f5c8504634a9",
                                                "sense_id": "a7961ca8-65c1-3076-a744-1ddc745f76ce",
                                                "text": "The specs are all correct, but the English in the instructions isn't as clear as it should be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4ef31f-deee-3680-a7b8-bb2dfecf9b0a",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "A particular instance of the English language, including:",
                                            "A clear and readily understandable expression of some idea in English."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df06857-b046-4c6e-b2f1-87dd01cb4dd0",
                                                "sense_id": "5d4ef31f-deee-3680-a7b8-bb2dfecf9b0a",
                                                "text": "Thank you, doctor. Now, please say that again in English."
                                            },
                                            {
                                                "example_id": "7e64575e-5851-49c5-bdf8-5696319f1ce3",
                                                "sense_id": "5d4ef31f-deee-3680-a7b8-bb2dfecf9b0a",
                                                "text": "Data: I have completed my analysis of the anomaly. It appears to be a multi-phasic temporal convergence in the space-time continuum.\nDr. Crusher: In English, Data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ce6c4e4-c1b8-3a0d-945d-06ae245125bb",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "A particular instance of the English language, including:",
                                            "Synonym of language arts, the class dedicated to improving primary and secondary school students' mastery of English and the material taught in such classes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52243797-9850-4299-994b-58605257575d",
                                                "sense_id": "2ce6c4e4-c1b8-3a0d-945d-06ae245125bb",
                                                "text": "I loved reading until 7th grade English."
                                            },
                                            {
                                                "example_id": "d2e3adf1-28aa-4692-a250-8bf2c4111b98",
                                                "sense_id": "2ce6c4e4-c1b8-3a0d-945d-06ae245125bb",
                                                "text": "This reflects that in English, students learn a range of text types, such as procedures, editorials, poetry, and not just academic essays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31e7952-9499-3654-8537-f5d6f4cec070",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "A size of type between pica (12 point) and great primer (18 point), standardized as 14-point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "118e1840-b0d5-3d61-84df-867b8fd6e317",
                                        "entry_id": "a2ec98c5-694c-34df-9412-1ac6b2c5edea",
                                        "glosses": [
                                            "Alternative form of english."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c2e151-3cd4-4d70-9f92-82ad221837ae",
                                                "sense_id": "118e1840-b0d5-3d61-84df-867b8fd6e317",
                                                "text": "You are putting too much English on the ball."
