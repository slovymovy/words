                "senses": [
                    {
                        "sense_id": "3841afad-862b-33c8-b70c-a2a5218a0fc5",
                        "entry_id": "dc606a13-3711-3df6-acfb-e8100f2e6bd8",
                        "glosses": [
                            "Speiseeis, das durch ein spezielles Herstellungsverfahren eine besonders cremige Konsistenz hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eebcbd7-6cf4-40df-8fb3-bcc2e69110de",
                                "sense_id": "3841afad-862b-33c8-b70c-a2a5218a0fc5",
                                "text": "Softeis ist durch hygienische Bedenken in die Diskussion geraten."
                            },
                            {
                                "example_id": "32404bed-4e95-448c-9cae-c5fa65812ba9",
                                "sense_id": "3841afad-862b-33c8-b70c-a2a5218a0fc5",
                                "text": "„Es gab drei Sorten Softeis und monströse Eisbecher mit Sprühsahne und neonbunten Toppings.“"
                            },
                            {
                                "example_id": "dd1cc027-624d-4058-90cb-e9fbc35a7b42",
                                "sense_id": "3841afad-862b-33c8-b70c-a2a5218a0fc5",
                                "text": "„Zur Feier des Tages spendierte Leonie uns ein riesiges Softeis, das gerade noch so auf das Waffelhörnchen passte.“"
                            },
                            {
                                "example_id": "b2ec378a-de85-4d7b-b8a1-a827a83fb6d2",
                                "sense_id": "3841afad-862b-33c8-b70c-a2a5218a0fc5",
                                "text": "„Vater und Sohn sind ein tolles Gespann, wenn es darum geht, das supercremige Softeis in vielen Geschmacksvariationen aus der Eismaschine zu ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
