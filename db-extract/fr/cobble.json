                        "examples": [
                            {
                                "example_id": "24fd648d-5b10-4da4-b1a3-e3af115fd9f9",
                                "sense_id": "b20681eb-4a0f-3dab-8c27-ad6e436601fa",
                                "text": "J’fais des maisons en cobble\nÇa rend pas si mal\nJe fais une base en stone brick\nC’est vraiment d’la balle\nMais oui, vous m’avez reconnu\nJe suis Sean-Kévin\nHey, j’suis Sean-Kévin\nHey, j’suis Sean-Kévin"
                            },
                            {
                                "example_id": "2b15361b-e23a-42a7-b1dc-7ef57d2dc702",
                                "sense_id": "b20681eb-4a0f-3dab-8c27-ad6e436601fa",
                                "text": "Le fort vue de l'interieur mais ne vous inquieter pas toute la cobble du chateau va disparaitre normalement :)"
                            },
                            {
                                "example_id": "97c4d081-ceb4-425e-942c-59fcec6d195e",
                                "sense_id": "b20681eb-4a0f-3dab-8c27-ad6e436601fa",
                                "text": "Ce mec a de l'uranium et du diamant mais il vie dans cette maison en cobble ! Welcome to Minecraft !"
                            },
                            {
                                "example_id": "d58f7752-6e0b-4c96-8f51-438608c0f9f4",
                                "sense_id": "b20681eb-4a0f-3dab-8c27-ad6e436601fa",
                                "text": "J'ai fait... UN GÉNÉRATEUR DE COBBLE ! ET OUAIS ! On est ensemble jusqu'à minuit !"
                            },
                            {
                                "example_id": "b840abab-c833-4d8d-9242-ab7a3d633061",
                                "sense_id": "b20681eb-4a0f-3dab-8c27-ad6e436601fa",
                                "text": "il a trop raison mon mec m’a dit qu’il voulait qu’on fasse construire une maison, jlui ai dit de commencer à farmer la cobble il a pas compris du coup tué à l’arc et je l’ai loot"
                            }
                        ]
                    }
                ],
                "translations": [
