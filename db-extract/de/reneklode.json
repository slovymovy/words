                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greengage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b16699-ab5c-34b3-9eea-d7c3747109da",
                                        "entry_id": "e6edb456-2ac2-3147-89d1-03d06f8a2ceb",
                                        "glosses": [
                                            "A plum cultivar with greenish-yellow flesh and skin, Prunus domestica subsp. italica var. claudiana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d1834c-b35a-45ce-9df2-c599cb514a0e",
                                                "sense_id": "e7b16699-ab5c-34b3-9eea-d7c3747109da",
                                                "text": "The apricot rarely produces any fruit, except in a few places, and then very scantily. The greengage plum is nearly equally unproductive."
                                            },
                                            {
                                                "example_id": "71825c3a-a6e7-4d20-889d-1cadd168d3b5",
                                                "sense_id": "e7b16699-ab5c-34b3-9eea-d7c3747109da",
                                                "text": "Just where the horse trams trundled across the market was a row of fruit stalls, with fruit blazing in the sun—apples and piles of reddish oranges, small greengage plums and bananas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc90af18-fcf0-4579-95f1-d3943d998db0",
                        "source_entry_id": "9abc9774-1b7c-3e60-b508-dba3f485a7a4",
                        "source_sense_id": "bcd88821-13cb-3c98-a1ab-abacd962b64c",
                        "source_sense_description": "Pflaumenbaum mit kugeligen Früchten",
                        "target_lang_word": "reine-claude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reine-claude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b10fdbe-add9-3912-984d-b287c46f8c4d",
                                        "entry_id": "e70f33f9-573b-333d-a2ec-1cbc520744d8",
                                        "glosses": [
                                            "Variété de prune d’un vert tirant sur le jaune produite par certains pruniers (Prunus domestica subsp. domestica groupe reine-claude)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d04f3b-316e-4acf-a104-1056c93d2882",
                                                "sense_id": "1b10fdbe-add9-3912-984d-b287c46f8c4d",
                                                "text": "Je me réfugiai derrière ma grand-mère ; elle criait, elle riait même, elle que je ne voyais jamais sourire, et, l’air avenant, toute persuasion, toute bonne volonté éperdue, tendait une poignée de madeleines ou de reines-claudes."
                                            },
                                            {
                                                "example_id": "c60f1c6f-4a19-4bbc-a998-26faa15e9e7c",
                                                "sense_id": "1b10fdbe-add9-3912-984d-b287c46f8c4d",
                                                "text": "Elle me tendait une soucoupe pleine de reines-claudes, échaudait la théière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
