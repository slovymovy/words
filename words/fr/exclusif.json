{
    "word_family": [
        "exclure",
        "exclusion",
        "exclusivement",
        "exclusivisme",
        "exclusivité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8beb1faf-7586-306c-9141-30950ec70309",
                    "sense_definition": "Qui appartient à une seule personne ou entité, à l'exclusion de toutes les autres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "monopole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise a obtenu le droit <w>exclusif</w> de distribuer ce produit dans toute l'Europe."
                        },
                        {
                            "text": "L'auteur conserve la propriété <w>exclusive</w> de tous ses textes et images."
                        }
                    ],
                    "synonyms": [
                        "unique",
                        "réservé"
                    ],
                    "antonyms": [
                        "inclusif"
                    ],
                    "common_phrases": [
                        "droit exclusif",
                        "contrat exclusif",
                        "usage exclusif"
                    ]
                },
                {
                    "sense_id": "079371bb-b5c6-3f51-9767-a3f761b12254",
                    "sense_definition": "Réservé à un petit nombre de personnes privilégiées, très sélect ou haut de gamme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "select",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont organisé une soirée privée dans un club <w>exclusif</w> au centre de la capitale."
                        },
                        {
                            "text": "Cette marque de luxe propose des créations <w>exclusives</w> à une clientèle restreinte."
                        }
                    ],
                    "synonyms": [
                        "sélect",
                        "fermé",
                        "privilégié"
                    ],
                    "common_phrases": [
                        "club exclusif",
                        "cercle exclusif"
                    ]
                },
                {
                    "sense_id": "cd62e16f-5e7a-3006-9c6a-d928350cebe4",
                    "sense_definition": "Qui n'admet aucun partage, très possessif dans ses affections ou intransigeant dans ses idées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa jalousie maladive et son amour <w>exclusif</w> ont fini par détruire leur relation."
                        },
                        {
                            "text": "Ce collectionneur <w>exclusif</w> refuse d'écouter d'autres avis que les siens sur l'art moderne."
                        }
                    ],
                    "synonyms": [
                        "possessif",
                        "intolérant",
                        "intransigeant"
                    ],
                    "common_phrases": [
                        "amour exclusif",
                        "passion exclusive"
                    ]
                },
                {
                    "sense_id": "942f369b-325b-3aa0-8a33-2696711029dd",
                    "sense_definition": "En linguistique, qualifie un pronom qui n'inclut pas l'interlocuteur dans le groupe désigné.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans certaines langues, on utilise un pronom <w>exclusif</w> pour désigner un groupe excluant la personne qui écoute."
                        },
                        {
                            "text": "Le linguiste explique la différence entre la forme inclusive et la forme <w>exclusive</w> du pronom."
                        }
                    ],
                    "antonyms": [
                        "inclusif"
                    ],
                    "common_phrases": [
                        "pronom exclusif",
                        "nous exclusif"
                    ]
                },
                {
                    "sense_id": "82b1059b-5dca-3a59-93f3-77431ce9e98d",
                    "sense_definition": "En écologie ou botanique, qualifie une espèce végétale qui ne se développe que dans un habitat déterminé.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante rare est une espèce <w>exclusive</w> des tourbières acides de montagne."
                        },
                        {
                            "text": "Les biologistes ont identifié une flore <w>exclusive</w> qui ne pousse nulle part ailleurs."
                        }
                    ],
                    "common_phrases": [
                        "espèce exclusive"
                    ]
                }
            ]
        }
    ]
}