                        "tags": [
                            "Kunsthandwerk",
                            "Volkskunst"
                        ],
                        "examples": [
                            {
                                "example_id": "5dbae0ec-8b26-43ae-bb85-dd1cb7863e3d",
                                "sense_id": "09c379be-b67f-3a4d-ac54-b5e584d55610",
                                "text": "Ich knacke jetzt mit dem Nussknacker die Walnüsse."
                            },
                            {
                                "example_id": "8f7ad067-2891-4540-98d9-7c59c90b87c8",
                                "sense_id": "09c379be-b67f-3a4d-ac54-b5e584d55610",
                                "text": "Stehen bei dir die Nussknacker im Fenster?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
