                                "sense_id": "061fd2b2-af09-30c4-8e39-39adaa93a536",
                                "text": "Jak zrobić polewkę na zsiadłym mleku?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e6e6d8e9-fdce-3cb2-9399-302d4654024c",
                        "entry_id": "0f5710be-49b5-3ce4-bc29-39db14bc2834",
                        "glosses": [
                            "radość z kogoś lub czegoś, nabijanie się"
                        ],
                        "tags": [
                            "slang",
                            "youth"
                        ],
                        "examples": [
                            {
                                "example_id": "d216e9f1-2e8f-4fe2-9dd5-af5165d9a4d9",
                                "sense_id": "e6e6d8e9-fdce-3cb2-9399-302d4654024c",
                                "text": "Maciek chciał wyrwać tę laskę przy barze, a okazało się, że to jego ciotka. Niezła polewka!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
