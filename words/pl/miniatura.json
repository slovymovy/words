                {
                    "sense_id": "7c846ac4-384d-3572-9bbd-ad63e6e798a7",
                    "sense_definition": "przedmiot lub model przedstawiający coś w znacznie pomniejszonej skali",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scale_model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W muzeum rzemiosła można obejrzeć dokładną <w>miniaturę</w> średniowiecznego zamku.",
                            "target_lang_translations": {
                                "ru": "В музее ремёсел можно увидеть точную <w>миниатюру</w> средневекового замка."
                            }
                        },
                        {
                            "text": "Dostał na urodziny wierną <w>miniaturę</w> zabytkowego samochodu.",
                            "target_lang_translations": {
                                "ru": "На день рождения он получил точную <w>миниатюру</w> старинного автомобиля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "w miniaturze"
                    ],
                    "target_lang_definitions": {
                        "ru": "предмет или модель, изображающие что-либо в сильно уменьшенном масштабе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миниатюра",
                                "target_lang_sense_clarification": "уменьшенная копия"
                            },
                            {
                                "target_lang_word": "уменьшенная копия",
                                "target_lang_sense_clarification": "модель в масштабе"
                            }
                        ]
