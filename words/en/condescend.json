{
    "word_family": [
        "condescension",
        "condescendingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7552f533-4b32-348c-8b02-86a8a07fc41c",
                    "sense_definition": "To treat someone as though they are inferior or less intelligent than oneself.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "patronize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is rude to <w>condescend</w> to your colleagues just because you have more experience."
                        },
                        {
                            "text": "She felt that her boss was <w>condescending</w> to her during the meeting."
                        }
                    ],
                    "synonyms": [
                        "belittle"
                    ],
                    "antonyms": [
                        "discondescend"
                    ],
                    "common_phrases": [
                        "condescend to someone"
                    ]
                },
                {
                    "sense_id": "bb88bdba-7257-3e00-a6a8-c7c88000b6b2",
                    "sense_definition": "To agree to do something that one feels is beneath one's dignity or social status.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity finally <w>condescended</w> to sign autographs for the waiting fans."
                        },
                        {
                            "text": "He would not <w>condescend</w> to answer such a trivial question."
                        }
                    ],
                    "common_phrases": [
                        "condescend to do"
                    ]
                }
            ]
        }
    ]
}