                ],
                "senses": [
                    {
                        "sense_id": "65d8e4dc-e0b3-3179-bf49-51f88d14881a",
                        "entry_id": "f11bf1ff-3f09-3b31-b27c-4077036f5ff6",
                        "glosses": [
                            "нар.-поэт., трад.-поэт. и рег. луг, поле, пастбище с густой, сочной травой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6925def2-48e7-4e61-8aca-41365ff5ae98",
                                "sense_id": "65d8e4dc-e0b3-3179-bf49-51f88d14881a",
                                "text": "Пред ним уже днепровски волны // В знакомых пажитях шумят.."
                            },
                            {
                                "example_id": "cc2845fa-1d0d-4929-9694-ae064a1b1eb6",
                                "sense_id": "65d8e4dc-e0b3-3179-bf49-51f88d14881a",
                                "text": "Около деревушки по пажитям бродили рыжие коровы."
                            },
                            {
                                "example_id": "221191ec-2288-4654-b6cb-64dfdba74105",
                                "sense_id": "65d8e4dc-e0b3-3179-bf49-51f88d14881a",
                                "text": "Тогда сквозь неё проступали, как через матовое стекло, туманные видения вековых ракит на берегах, увядшие пажити и полосы изумрудных озимей."
                            },
                            {
                                "example_id": "7b74936a-b2c3-4d9a-9a79-882d23cf4f45",
                                "sense_id": "65d8e4dc-e0b3-3179-bf49-51f88d14881a",
                                "text": "Я есмь дверь: кто войдет Мною, тот спасется, и войдет, и выйдет, и пажить найдет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b0bf37d-133b-4aa9-b7ac-0c9cfabf1262",
                        "source_entry_id": "f11bf1ff-3f09-3b31-b27c-4077036f5ff6",
                        "source_sense_id": "65d8e4dc-e0b3-3179-bf49-51f88d14881a",
                        "target_lang_word": "pasture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da566e72-e3cb-3ee6-8062-7374e3649648",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Land, specifically, an open field, on which livestock is kept for feeding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Ground covered with grass or herbage, used or suitable for the grazing of livestock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce31ecdc-f187-4dda-a6ca-6833159b8184",
                                                "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                                "text": "He maketh me to lie down in green pastures."
                                            },
                                            {
                                                "example_id": "2804240b-4694-41ab-bc8b-1b9e20409095",
                                                "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                                "text": "So graze as you find pasture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Food, nourishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820ebeb7-8205-44db-a028-394edba85baa",
                                                "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                                "text": "Ne euer is he wont on ought to feed, / But toades and frogs, his pasture poysonous […]."
                                            },
                                            {
                                                "example_id": "2907fc8d-b9f2-42d0-80d5-4bab96695d15",
                                                "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                                "text": "It was reserved for Christians to torture bread, the staff of life, bread for which children in whole districts wail, bread, the gift of pasture to the poor, bread, for want of which thousands of our fellow beings annually perish by famine; it was reserved for Christians to torture the material of bread by fire, to create a chemical and maddening poison, burning up the brain and brutalizing the soul, and producing evils to humanity, in comparison of which, war, pestilence, and famine, cease to be evils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pasture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d219c39-6963-307b-ac84-2ca52fb1157a",
                                        "entry_id": "8b7e77a4-6036-3f4c-9a59-645b6fde08d2",
                                        "glosses": [
                                            "To move animals into a pasture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5f63990-354d-3260-a6da-c51b958bccfc",
                                        "entry_id": "8b7e77a4-6036-3f4c-9a59-645b6fde08d2",
                                        "glosses": [
                                            "To graze."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                                        "entry_id": "8b7e77a4-6036-3f4c-9a59-645b6fde08d2",
                                        "glosses": [
                                            "To feed, especially on growing grass; to supply grass as food for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2329087-b9a4-4e3a-9608-871249f7c212",
                                                "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                                                "text": "The farmer pastures fifty oxen."
                                            },
                                            {
                                                "example_id": "7bf52949-0d87-4802-9378-fd1bfa049b35",
                                                "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                                                "text": "The land will pasture forty cows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
