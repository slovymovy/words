        "fr-extract.jsonl": [
            {
                "entry_id": "866be4e3-ffec-3bd3-9d76-ef2a50aff3fa",
                "word": "cauteleusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2568116d-529a-369b-8c78-22c8d3e233f8",
                        "entry_id": "866be4e3-ffec-3bd3-9d76-ef2a50aff3fa",
                        "glosses": [
                            "D’une manière cauteleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6dcc57d-badf-47ea-a65b-8d01327e05dc",
                                "sense_id": "2568116d-529a-369b-8c78-22c8d3e233f8",
                                "text": "Le premier écuyer sourdement et cauteleusement était attaché au duc du Maine."
                            },
                            {
                                "example_id": "6dae300f-5227-4854-ae65-2693fa5305ff",
                                "sense_id": "2568116d-529a-369b-8c78-22c8d3e233f8",
                                "text": "L’orgueil ! […] il s’insinue si cauteleusement, si perfidement, qu’il vous enlace et vous lie, avant même que l’on ait pu soupçonner sa présence ; […]."
                            },
                            {
                                "example_id": "c5c8615f-27f4-47c5-9cda-904405bcd228",
                                "sense_id": "2568116d-529a-369b-8c78-22c8d3e233f8",
                                "text": "L'instant d'après le docteur Robson entra, s'avança cauteleusement vers sa cliente et s'inclina."
                            },
                            {
                                "example_id": "e5d3510b-66b8-445c-bcb8-8cdee2422743",
                                "sense_id": "2568116d-529a-369b-8c78-22c8d3e233f8",
                                "text": "Elle avait peur d'Alban et Alban avait peur d'elle, et il était anxieux et faraud. \"Jaca! jaca!\" lui murmurait-il cauteleusement"
                            },
                            {
                                "example_id": "1fe4247b-11d7-43bd-a76c-57f934cfc344",
                                "sense_id": "2568116d-529a-369b-8c78-22c8d3e233f8",
                                "text": "— […], mais le navire imperturbable cingle vers l'immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                            }
                        ]
                    }
                ],
