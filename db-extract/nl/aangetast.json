        "nl-extract.jsonl": [
            {
                "entry_id": "5bebd830-c1a4-3120-9fd4-c31e9447d657",
                "word": "aangetast",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ca3cee2d-8e81-3dd6-b21d-f29a666f8e5a",
                        "entry_id": "5bebd830-c1a4-3120-9fd4-c31e9447d657",
                        "glosses": [
                            "beschadigd door inwerking van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "926ce8ac-2fbd-4157-b848-48ccf2c35407",
                                "sense_id": "ca3cee2d-8e81-3dd6-b21d-f29a666f8e5a",
                                "text": "De door de iepenziekte aangetaste bomen werden gerooid."
                            },
                            {
                                "example_id": "2053f9a9-099f-4d43-b607-c812d5cba135",
                                "sense_id": "ca3cee2d-8e81-3dd6-b21d-f29a666f8e5a",
                                "text": "De moderniteit had onze geestelijke gezondheid aangetast en de natuur bood enkele remedies. Maar waarin kwamen die therapeutische weldaden tot uiting? Er dienden zich minstens vijf thema's aan."
                            },
                            {
                                "example_id": "5002ae27-ee3c-476b-b70c-90979eb0824f",
                                "sense_id": "ca3cee2d-8e81-3dd6-b21d-f29a666f8e5a",
                                "text": "Olive liet zich op een afgedankte schommelstoel zakken, voorzichtig, bang dat de lijm was aangetast door het vocht en de verbindingsstukken aangevreten door houtwormen."
                            },
                            {
                                "example_id": "0ecf0202-c8ee-44b4-a542-508e0ff4083b",
                                "sense_id": "ca3cee2d-8e81-3dd6-b21d-f29a666f8e5a",
                                "text": "Ze heeft opvallend mooie borsten. Klein, maar stevig. Een beetje breed. Nauwelijks aangetast door de tijd. Het was me niet eerder opgevallen door de wijde T-shirts die ze meestal aanheeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
