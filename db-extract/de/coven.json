                "senses": [
                    {
                        "sense_id": "46c5a1ae-4a2c-382c-83b3-92f3527d0754",
                        "entry_id": "f803cecb-18a6-36c9-832f-862a69668876",
                        "glosses": [
                            "Gemeinschaft von Hexen, oder Gruppe innerhalb des Wicca, die meist aus drei bis dreizehn Personen besteht, die – gegebenenfalls bis auf die Führungsperson – zu gleichen Teilen männlich und weiblich sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b936de-7b6b-46df-be70-cad5fb0fa68f",
                                "sense_id": "46c5a1ae-4a2c-382c-83b3-92f3527d0754",
                                "text": "„Aber im Winter 2018 hatte ich erneut das Gefühl, wieder Teil eines formelleren Coven sein zu müssen.“"
                            },
                            {
                                "example_id": "0c29b4a9-8d0f-4715-af17-f9b809fceb5a",
                                "sense_id": "46c5a1ae-4a2c-382c-83b3-92f3527d0754",
                                "text": "„So gelingt es, mit Hilfe ihrer – im Coven gemeinsam gebündelten – ‚emotionalen Energie‘ ebenso zu heilen und bei psychischen und materiellen Problemen zu helfen, wie aber auch – entgegen der hexerischen Ethik – durch Fluch und Verwünschung zu schaden.“"
                            },
                            {
                                "example_id": "3e11f034-6390-4d3a-ae70-795465e60d48",
                                "sense_id": "46c5a1ae-4a2c-382c-83b3-92f3527d0754",
                                "text": "„Ob Sie einem Coven beitreten möchten oder nicht, ist eine Entscheidung, die nur Sie allein treffen können.“"
                            },
                            {
                                "example_id": "57aaa715-0d80-4c4a-892e-135c500d3b23",
                                "sense_id": "46c5a1ae-4a2c-382c-83b3-92f3527d0754",
                                "text": "„Die Struktur des Covens ist charakteristisch für die Wicca – auch wenn sich manche ›modernen‹ Hexengruppen als ›Coven‹ bezeichnen.“"
                            },
                            {
                                "example_id": "9bec98b7-724d-421e-8eef-5de9e0f1b229",
                                "sense_id": "46c5a1ae-4a2c-382c-83b3-92f3527d0754",
                                "text": "„Dort gebe es oft feste Kreise von Hexen, sogenannte ‚Coven‘, in denen feste Hierarchien herrschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
