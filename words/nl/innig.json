                },
                {
                    "sense_id": "47c262b2-8972-3e3d-bd49-8eba338f85c0",
                    "sense_definition": "zeer nauw verbonden of met elkaar verweven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbondenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Korstmossen zijn in werkelijkheid de <w>innige</w> symbiose van een schimmel en een alg.",
                            "target_lang_translations": {
                                "en": "Lichens are actually the <w>intimate</w> symbiosis of a fungus and an alga."
                            }
                        },
                        {
                            "text": "Er bestaat een <w>innige</w> samenwerking tussen de verschillende afdelingen van het bedrijf.",
                            "target_lang_translations": {
                                "en": "There is <w>close</w> cooperation between the different departments of the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "nauw",
                        "verweven"
                    ],
                    "antonyms": [
