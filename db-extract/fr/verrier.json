                                            {
                                                "example_id": "da5665c5-1e52-4387-bdd4-bbeb2480ca6a",
                                                "sense_id": "cb73eb26-5742-3d7f-a69d-64255f982ff3",
                                                "text": "a resin tabletop with a glassy polish"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6505c339-6873-3c36-ad37-c2e1ac24342e",
                                        "entry_id": "3995890d-4abd-3207-9602-7dc2228ad4d2",
                                        "glosses": [
                                            "Of or like glass, especially in being smooth and somewhat reflective.",
                                            "Lacking any chop; smooth and mostly flat."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6034c632-4d6b-47c0-b8e3-1686c8a10337",
                                                "sense_id": "6505c339-6873-3c36-ad37-c2e1ac24342e",
                                                "text": "a fair day on a glassy sea"
                                            },
                                            {
                                                "example_id": "1376d517-7279-4145-aec3-5a6afd934ca6",
                                                "sense_id": "6505c339-6873-3c36-ad37-c2e1ac24342e",
                                                "text": "It was blowing about 15 knots, which is considered fairly glassy for the west Coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0118d5c-35be-35ca-87de-c785068cd9aa",
                                        "entry_id": "3995890d-4abd-3207-9602-7dc2228ad4d2",
                                        "glosses": [
                                            "Including a lot of glass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bafff17-159a-3dee-8448-945706d83be3",
                                        "entry_id": "3995890d-4abd-3207-9602-7dc2228ad4d2",
                                        "glosses": [
                                            "Including a lot of glass.",
                                            "Extensively glazed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c4b52b-6f85-4546-a108-6c84e42d56cc",
                                                "sense_id": "2bafff17-159a-3dee-8448-945706d83be3",
                                                "text": "architecture enamored of glass and steel, where glassier meant classier"
                                            },
                                            {
                                                "example_id": "945e68bf-5206-4dc3-a840-f4b9129b0a74",
                                                "sense_id": "2bafff17-159a-3dee-8448-945706d83be3",
                                                "text": "Every time there's a major technological outage, […] speculation quickly erupts blaming a possible cyberattack. […] mostly, the sentiment of cyber observers is that it's a bad idea to jump to conclusions, especially publicly. ¶ \"If we keep crying wolf, then we lose the ability to educate and solve real problems,\" Bryson Bort, founder of the cybersecurity company Scythe, told me. \"We live in the glassiest house in the world with our reliance on information systems.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563b72fa-027d-3bca-a96d-000f3b1feff3",
                                        "entry_id": "3995890d-4abd-3207-9602-7dc2228ad4d2",
                                        "glosses": [
                                            "Dull; expressionless; lifeless."
                                        ],
                                        "tags": [
                                            "of eyes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8cb998-ce87-4618-8149-1bc6d0a77c9b",
                                                "sense_id": "563b72fa-027d-3bca-a96d-000f3b1feff3",
                                                "text": "the glassy eyes of a person in a trance"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glassy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b10e88d-26cb-34e4-82c3-879d9f7b52ea",
                                        "entry_id": "159e7c26-92a4-3d34-8326-98ce9549f825",
                                        "glosses": [
                                            "A glass marble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf6a786-3f29-4608-a5d4-a99ebafe7589",
                                                "sense_id": "9b10e88d-26cb-34e4-82c3-879d9f7b52ea",
                                                "text": "Then suddenly she ceased to hear, having caught sight of a glassie rolled into a corner."
                                            }
