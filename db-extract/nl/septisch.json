                                    },
                                    {
                                        "sense_id": "001095cf-4e7f-3b22-92bf-8012fc69cde9",
                                        "entry_id": "0a007c72-8789-3be1-9e5d-96bdb5533bf9",
                                        "glosses": [
                                            "Of or pertaining to sewage or the disposal of sewage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439845a0-fc0a-4139-8101-4415fb438ead",
