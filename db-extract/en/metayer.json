                "senses": [
                    {
                        "sense_id": "4273cef6-b707-3ffe-8e3d-bd39ca8df2ad",
                        "entry_id": "2d2f0d91-19cc-316a-a687-bab3ff7f2ee0",
                        "glosses": [
                            "One who cultivates land for a share (usually half) of its yield, receiving stock, tools, and seed from the landlord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09cac50-31ee-413d-b759-0723503df438",
                                "sense_id": "4273cef6-b707-3ffe-8e3d-bd39ca8df2ad",
                                "text": "The metayer furnishes his labour, his ignorance, and his good appetite; the proprietor supplying an exhausted soil[…]"
                            },
                            {
                                "example_id": "bffb28fc-c24c-4c43-93ee-4c35c437cba0",
                                "sense_id": "4273cef6-b707-3ffe-8e3d-bd39ca8df2ad",
                                "text": "A majority of the properties are so small as not to afford a subsistence to the proprietors, of whom, according to some computations, as many as three millions are obliged to eke out their means of support either by working for hire, or by taking additional land, generally on metayer tenure."
                            },
                            {
                                "example_id": "4434bd35-4d89-473c-9ad3-698a13516f79",
                                "sense_id": "4273cef6-b707-3ffe-8e3d-bd39ca8df2ad",
                                "text": "A \"submerged tenth\" of croppers, with a few paupers; forty per cent who are metayers and thirty-nine per cent of semi-metayers and wage-laborers"
                            }
                        ]
                    }
                ],
