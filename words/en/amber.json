                        "zh": [
                            {
                                "target_lang_word": "安珀",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8721b43-1fb6-3245-b7fb-083680994c06",
                    "sense_definition": "A river in Derbyshire, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Amber</w> flows through the beautiful countryside of Derbyshire.",
                            "target_lang_translations": {
                                "ru": "Река <w>Эмбер</w> протекает через красивую сельскую местность Дербишира.",
                                "zh": "<w>安珀河</w>流经德比郡美丽的乡村。"
                            }
                        },
                        {
                            "text": "Local fishermen often visit the banks of the <w>Amber</w> on weekends.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки часто посещают берега <w>Эмбер</w> по выходным.",
                                "zh": "当地渔民经常在周末光顾<w>安珀河</w>岸边。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Дербишире, Англия.",
                        "zh": "英国德比郡的一条河流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмбер",
                                "target_lang_sense_clarification": "река"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安珀河",
                                "target_lang_sense_clarification": "河流"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6639beb-f56a-3d82-b8f2-0ef462911cad",
                    "sense_definition": "A city in Rajasthan, India, also known as Amer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Tourists flock to see the magnificent fort located in <w>Amber</w>.",
                            "target_lang_translations": {
                                "ru": "Туристы стекаются посмотреть на великолепный форт, расположенный в <w>Амбере</w>.",
                                "zh": "游客们蜂拥而至，参观位于<w>安珀</w>的宏伟堡垒。"
                            }
                        },
                        {
                            "text": "The historic city of <w>Amber</w> is famous for its stunning architecture.",
                            "target_lang_translations": {
                                "ru": "Исторический город <w>Амбер</w> славится своей потрясающей архитектурой.",
                                "zh": "历史名城<w>安珀</w>以其令人惊叹的建筑而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в штате Раджастхан, Индия, также известный как Амер.",
                        "zh": "印度拉贾斯坦邦的一座城市，也称为阿梅尔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Амбер",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安珀",
                                "target_lang_sense_clarification": "城市"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e610c1e6-8f61-31df-ba50-074e7ccfb7ae",
                    "sense_definition": "To cause to take on the yellow colour of amber, or to become amber in colour.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun was <w>ambering</w> the clouds as evening approached.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце <w>окрашивало в янтарный цвет</w> облака с приближением вечера.",
                                "zh": "随着傍晚临近，落日将云彩<w>染成琥珀色</w>。"
                            }
                        },
                        {
                            "text": "In the autumn, the leaves start <w>ambering</w> before they fall from the trees.",
                            "target_lang_translations": {
                                "ru": "Осенью листья начинают <w>становиться янтарными</w> перед тем, как опасть с деревьев.",
                                "zh": "秋天，树叶在从树上落下之前开始<w>变成琥珀色</w>。"
                            }
