                ],
                "senses": [
                    {
                        "sense_id": "0ff8f1bc-a21a-3aee-8906-5d7e2bf6a2a6",
                        "entry_id": "1d03960c-7469-3d23-83bc-d6ab464c9ea7",
                        "glosses": [
                            "Qui est partout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754e6399-de8b-445c-98fe-f88693c3df97",
                                "sense_id": "0ff8f1bc-a21a-3aee-8906-5d7e2bf6a2a6",
                                "text": "On ne peut imaginer le Mexique sans l’ombre portée, omniprésente, du grand frère américain. Les deux nations partagent une « impossible frontière » de plus de 3 000 km, pour l'essentiel de déserts, entre le Pacifique et l'Atlantique."
                            },
                            {
                                "example_id": "57989610-bccb-42b7-9d17-cf2ae6ceabcd",
                                "sense_id": "0ff8f1bc-a21a-3aee-8906-5d7e2bf6a2a6",
                                "text": "Les croix de fer siglées West Coast Chopper sont omniprésentes. Elles n’ont rien de nazi, autant lever l’ambiguïté."
                            },
                            {
                                "example_id": "82a43288-eaf3-4b6d-a475-4622a97492a1",
                                "sense_id": "0ff8f1bc-a21a-3aee-8906-5d7e2bf6a2a6",
                                "text": "Le Myanmar est un de ces États où l’institution militaire est omniprésente et où, directement ou indirectement, elle a occupé le pouvoir politique, mais aussi économique depuis des temps immémoriaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e17c4b68-af82-4d50-8708-4babd75f8bf4",
                        "source_entry_id": "1d03960c-7469-3d23-83bc-d6ab464c9ea7",
                        "source_sense_id": "0ff8f1bc-a21a-3aee-8906-5d7e2bf6a2a6",
                        "target_lang_word": "omnipresent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omnipresent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c15c30-da39-3794-8af0-2a51d0b15a47",
                                        "entry_id": "de82cc28-fa66-3e0c-aaa5-d4f23efc5ff9",
                                        "glosses": [
                                            "Being everywhere simultaneously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bb95ef6-a39e-4798-9699-f662866974c8",
                                                "sense_id": "73c15c30-da39-3794-8af0-2a51d0b15a47",
                                                "text": "In 1975, China was emerging from the Cultural Revolution, its government’s effort to purify and revitalize society. Communist officials had set up indoctrination programs, broadcast propaganda over omnipresent loudspeakers, and sought to stamp out any evidence of China’s ancient history."
                                            },
                                            {
                                                "example_id": "202a6029-ac78-49f6-973b-1b2707519660",
                                                "sense_id": "73c15c30-da39-3794-8af0-2a51d0b15a47",
                                                "text": "Another most notable change concerns rolling stock liveries. Back then, corporate Rail Blue was omnipresent, whereas now there is a kaleidoscope of colours and styles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e9262cb-98c4-4402-b885-2ce9d2c785dc",
                        "source_entry_id": "1d03960c-7469-3d23-83bc-d6ab464c9ea7",
                        "source_sense_id": "0ff8f1bc-a21a-3aee-8906-5d7e2bf6a2a6",
