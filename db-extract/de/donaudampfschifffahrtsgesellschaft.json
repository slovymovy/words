                "senses": [
                    {
                        "sense_id": "908839c8-d5de-33e1-bc60-6682af2aeff0",
                        "entry_id": "9f7f6726-542c-3949-b025-5d9a700ae9dc",
                        "glosses": [
                            "alternative Bezeichnung für eine ehemalige österreichische Schifffahrtsgesellschaft zur Beschiffung der Donau und ihrer Nebenflüsse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ff89675-c1e4-4338-9729-c8ac4f7873e7",
                                "sense_id": "908839c8-d5de-33e1-bc60-6682af2aeff0",
                                "text": "„Kurze Zeit später, im Jahre 1829, gründete sich die erste Donaudampfschifffahrtsgesellschaft.“"
                            },
                            {
                                "example_id": "9b689b10-f558-4df2-8a5e-e46d41e9680c",
                                "sense_id": "908839c8-d5de-33e1-bc60-6682af2aeff0",
                                "text": "„Im Baubüro von Ludwig von Förster führte er erste selbständige Planungen durch, von denen die Synagogen in Budapest und Temeswar sowie das Verwaltungsgebäude der Donaudampfschifffahrtsgesellschaft in Budapest zu nennen sind.“"
                            },
                            {
                                "example_id": "4ed5b590-2e36-4fba-944a-f2605a4af6f6",
                                "sense_id": "908839c8-d5de-33e1-bc60-6682af2aeff0",
                                "text": "„Allein unter Männern: Stefanie Oberlechner, die einzige Kapitänin bei der altehrwürdigen Donaudampfschifffahrtsgesellschaft, steuert seit Kurzem den Twin City Liner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
