                                "nl": "Het sneeuwt hier vaak in <w>januari</w>.",
                                "pl": "Często pada tu śnieg w <w>styczniu</w>.",
                                "de": "Hier schneit es oft im <w>Januar</w>.",
                                "fr": "Il neige souvent ici en <w>janvier</w>.",
                                "it": "Qui nevica spesso a <w>gennaio</w>.",
