                "senses": [
                    {
                        "sense_id": "4cceb532-e009-377b-8257-b94cec44947d",
                        "entry_id": "8e5284f4-06f8-3c00-a766-e1a97896f107",
                        "glosses": [
                            "voorzien van parels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acea3d22-52e9-4c62-aeca-39ffa0878df0",
                                "sense_id": "4cceb532-e009-377b-8257-b94cec44947d",
                                "text": "‘Er is wel degelijk een verschil tussen de outfits’, zegt Edouard Vermeulen, couturier van modehuis Natan en de favoriete ontwerper van koningin Mathilde. Zo koos Mathilde voor een fluwelen broek van Armani, en werkte ze de outfit af met een geparelde ceintuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "4533c770-d241-3853-8780-7158ac5c518c",
                        "entry_id": "8e5284f4-06f8-3c00-a766-e1a97896f107",
                        "glosses": [
                            "met bolvormige uitsteeksels aan de basis van een gewei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15556c48-c533-416f-8c4a-aad2f6f9e049",
                                "sense_id": "4533c770-d241-3853-8780-7158ac5c518c",
                                "text": "Dit gewei van een 1-jarige bok geschoten in uit het rivierengebied nabij Beesd is uitzonderlijk sterk gepareld en komt hier vaker . Ook opvallend is dat de gewichten van vooral de jaarlingen van het rivierenland ongeveer 50% hoger liggen dan die van de Veluwe"
                            },
                            {
                                "example_id": "ca77fe98-996e-486a-a0ee-67aadae0090f",
                                "sense_id": "4533c770-d241-3853-8780-7158ac5c518c",
                                "text": "Tegenwoordig gebeurt het echt in natuurgebied Denderbelle Broek. Vier reeën werden er de voorbije maanden illegaal geschoten. Het trieste dieptepunt volgde gisternacht. ‘Het was een van de oudste bokken in de streek’, zegt jager Lieven Busschaert. ‘Een prachtbeest, met een geparelde kroon."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d38c0de-ad72-3363-a86e-f2e4176402ec",
                        "entry_id": "8e5284f4-06f8-3c00-a766-e1a97896f107",
                        "glosses": [
                            "glinsterend, flonkerend, schitterend, sprankelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de08d03a-66b1-4285-bf58-508dc404cfde",
                                "sense_id": "2d38c0de-ad72-3363-a86e-f2e4176402ec",
                                "text": ",,Stof dus die (...) een klassieke uitstraling heeft. De ronde voet is gemaakt van perenhout en de mast van gepareld roestvrij staal\", meldt de website van de Tweede Kamer."
                            }
                        ]
                    }
