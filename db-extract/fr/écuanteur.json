                                            {
                                                "example_id": "62e605ac-f91b-4243-b505-101b708123a0",
                                                "sense_id": "44390c2d-981b-33a4-ba6e-ec1246a417f9",
                                                "text": "this dish is filling and easily made"
                                            },
                                            {
                                                "example_id": "1faade8e-c1a2-4888-9ed3-04fa475887c9",
                                                "sense_id": "44390c2d-981b-33a4-ba6e-ec1246a417f9",
                                                "text": "Let's carve him a dish fit for the gods"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef2b63ec-8fdf-3b1f-9520-304b7132da81",
                                        "entry_id": "df8b61f6-0504-3ca4-abf0-5fa3bbf96057",
                                        "glosses": [
                                            "Tableware (including cutlery, etc, as well as crockery) that is to be or is being washed after being used to prepare, serve and eat a meal."
                                        ],
                                        "tags": [
