                "senses": [
                    {
                        "sense_id": "efd57838-69ff-301a-af12-9eba1184cc42",
                        "entry_id": "2c981dc4-982a-3d76-a9fa-69844927486b",
                        "glosses": [
                            "Person/Personen, die jemanden oder etwas begleiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef2476b-86e8-48cb-bf25-a13d696a6695",
                                "sense_id": "efd57838-69ff-301a-af12-9eba1184cc42",
                                "text": "„Die Begleitschaft gehorchte und entfernte sich bis auf zwei Diener, die zur Aufwartung zurückblieben.“"
                            },
                            {
                                "example_id": "702b0c55-97fb-4ab3-8796-e32a1377b694",
                                "sense_id": "efd57838-69ff-301a-af12-9eba1184cc42",
                                "text": "„Nach einem scharfen Nachtritte in zahlreicher Begleitschaft langte J. am Morgen des 25. Februar 1621 auf Schloß Rietberg an und Pompejus fiel unter den Axthieben seiner politischen und religiösen Gegner.“"
                            },
                            {
                                "example_id": "15b41b47-f9f2-4625-b487-8158362317a3",
                                "sense_id": "efd57838-69ff-301a-af12-9eba1184cc42",
                                "text": "„Auch in diesem besonderen Jahr ließ es sich der Nikolaus nicht nehmen, mit einer aus Hygieneschutzgründen zwar recht kleinen aber feinen himmlischen Begleitschaft, die 5. und 6. Klassen des Gymnasiums zu besuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
