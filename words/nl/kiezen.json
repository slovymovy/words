                    "synonyms": [
                        "prefereren",
                        "verkiezen"
                    ],
                    "common_phrases": [
                        "kiezen voor"
                    ],
                    "target_lang_definitions": {
                        "en": "To prefer a certain course of action or possibility over all others.",
                        "de": "Eine bestimmte Vorgehensweise oder Möglichkeit gegenüber allen anderen bevorzugen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "opt for",
                                "target_lang_sense_clarification": "to make a choice between methods"
                            },
