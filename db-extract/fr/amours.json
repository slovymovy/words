                    {
                        "sense_id": "e1c9d4b7-e8a3-3b8d-968b-f5863c7dc2b4",
                        "entry_id": "ad6c908a-91e7-37b4-8d88-f34c518625fd",
                        "glosses": [
                            "Pluriel d’amour."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4d5e199b-2bac-4545-b1e4-cef7f180d494",
                                "sense_id": "e1c9d4b7-e8a3-3b8d-968b-f5863c7dc2b4",
                                "text": "On n’a jamais raconté, à son propos, les fortunes disparues, les captivités de la prison pour dettes, et les trahisons qui sont l’accompagnement ordinaire des ténébreuses amours."
                            },
                            {
                                "example_id": "11d96c7c-82a2-4206-875d-1e69fd88c1e2",
                                "sense_id": "e1c9d4b7-e8a3-3b8d-968b-f5863c7dc2b4",
                                "text": "J'imagine que, tout au long de leurs amours intermittentes, toujours traversées et toujours renaissantes, Romain et Meg, puis Romain et Margault avaient eu, l'un et l'autre, chacun de son côté, beaucoup à se pardonner et à se faire pardonner."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d489573-f4c2-3859-98f2-ac8081fc2245",
                        "entry_id": "ad6c908a-91e7-37b4-8d88-f34c518625fd",
                        "glosses": [
                            "Les dernières gouttes dans une bouteille de vin."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f417d55d-68a6-428e-ab09-d0b69074db38",
                                "sense_id": "7d489573-f4c2-3859-98f2-ac8081fc2245",
                                "text": "Je te verse les amours."
                            }
                        ]
                    }
