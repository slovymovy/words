                {
                    "sense_id": "1fbad680-3f70-3288-9ed1-b63245dd4aa4",
                    "sense_definition": "verschiedene Vorgänge, Aktivitäten oder Beteiligte planvoll aufeinander abstimmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstimmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen in der Zukunft unsere Pläne besser <w>koordinieren</w>, um unnötige Doppelarbeit zu vermeiden."
                        },
                        {
                            "text": "Die Rettungsdienste müssen ihre Einsätze bei einem schweren Unwetter genau <w>koordinieren</w>."
                        }
                    ],
                    "common_phrases": [
                        "Abläufe koordinieren",
                        "Termine koordinieren"
                    ]
                },
                {
                    "sense_id": "73f36638-5e6c-304c-a3c2-3e7c067c9971",
                    "sense_definition": "sprachliche Einheiten wie Wörter oder Teilsätze gleichrangig miteinander verbinden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Konjunktionen wie „und“ oder „oder“ dienen dazu, gleichrangige Sätze miteinander zu <w>koordinieren</w>."
                        },
                        {
                            "text": "Im Satz „Ich lese, und sie schreibt“ werden zwei Hauptsätze durch „und“ <w>koordiniert</w>."
                        }
                    ],
                    "synonyms": [
                        "beiordnen",
                        "nebenordnen"
                    ],
                    "antonyms": [
                        "subordinieren"
                    ],
                    "common_phrases": [
                        "Sätze koordinieren"
                    ]
                }
            ]
        }
