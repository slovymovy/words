{
    "word_family": [
        "Scandinavia"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "79336606-1ff1-3079-8f3f-d1abf391939a",
                    "sense_definition": "Relating to the region of Scandinavia, its people, or its culture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Scandinavian</w> countries are known for their beautiful landscapes and high quality of life.",
                            "target_lang_translations": {
                                "zh": "<w>斯堪的纳维亚</w>国家以其美丽的风景和高质量的生活而闻名。"
                            }
                        },
                        {
                            "text": "Many people enjoy the minimalist style of <w>Scandinavian</w> design in their homes.",
                            "target_lang_translations": {
                                "zh": "许多人喜欢在家里使用<w>斯堪的纳维亚</w>风格的极简设计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Nordic"
                    ],
                    "common_phrases": [
                        "Scandinavian design",
                        "Scandinavian countries"
                    ],
                    "target_lang_definitions": {
                        "zh": "与斯堪的纳维亚地区、其人民或文化相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯堪的纳维亚的",
                                "target_lang_sense_clarification": "指代地理区域或文化属性的形容词。"
                            },
                            {
                                "target_lang_word": "北欧的",
                                "target_lang_sense_clarification": "在日常语境中常用来指代该地区的通用说法。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7dfa587-aa2d-350c-b29e-62a7d284623c",
                    "sense_definition": "Relating to the North Germanic group of languages, including Swedish, Danish, and Norwegian.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linguists often study the historical development of <w>Scandinavian</w> languages.",
                            "target_lang_translations": {
                                "zh": "语言学家经常研究<w>斯堪的纳维亚</w>语言的历史演变。"
                            }
                        },
                        {
                            "text": "There are many similarities between the different <w>Scandinavian</w> languages.",
                            "target_lang_translations": {
                                "zh": "不同的<w>斯堪的纳维亚</w>语言之间有很多相似之处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "North Germanic"
                    ],
                    "common_phrases": [
                        "Scandinavian languages"
                    ],
                    "target_lang_definitions": {
                        "zh": "与北日耳曼语支相关的，包括瑞典语、丹麦语和挪威语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯堪的纳维亚语的",
                                "target_lang_sense_clarification": "专门指代该语支的语言学形容词。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67e7b00d-95ad-3875-9dbb-49394231a0bd",
                    "sense_definition": "A person who comes from Scandinavia.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Scandinavian</w> was very friendly and spoke excellent English.",
                            "target_lang_translations": {
                                "zh": "那位<w>斯堪的纳维亚人</w>非常友好，英语说得很好。"
                            }
                        },
                        {
                            "text": "Many <w>Scandinavians</w> are fluent in at least two languages.",
                            "target_lang_translations": {
                                "zh": "许多<w>斯堪的纳维亚人</w>至少能流利地说两种语言。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "来自斯堪的纳维亚的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯堪的纳维亚人",
                                "target_lang_sense_clarification": "指代该地区居民的名词。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "792e6c35-8dfd-3762-a960-34483cfd0a89",
                    "sense_definition": "A specific opening move sequence in the game of chess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chess",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "The grandmaster decided to play the <w>Scandinavian</w> to surprise his opponent.",
                            "target_lang_translations": {
                                "zh": "这位特级大师决定使用<w>斯堪的纳维亚防御</w>来给对手一个惊喜。"
                            }
                        },
                        {
                            "text": "Learning the <w>Scandinavian</w> can be a great way to challenge white's control of the center.",
                            "target_lang_translations": {
                                "zh": "学习<w>斯堪的纳维亚防御</w>是挑战白方对中心控制权的好方法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play the Scandinavian"
                    ],
                    "target_lang_definitions": {
                        "zh": "国际象棋中的一种特定开局走法。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯堪的纳维亚防御",
                                "target_lang_sense_clarification": "国际象棋术语，指代该开局。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}