                    "frequency": "Middle",
                    "semantic_group_id": "baiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux adolescents se sont isolés derrière l'arbre pour rouler un <w>patin</w>."
                        },
                        {
                            "text": "Elle lui a donné un grand <w>patin</w> avant de monter dans le train."
                        }
                    ],
                    "synonyms": [
                        "galoche",
                        "palot",
                        "pelle"
