                "senses": [
                    {
                        "sense_id": "8ee14647-c45a-39f0-af7d-573e96e7f983",
                        "entry_id": "d19351ae-627c-3957-a1f0-ede3b5adadf0",
                        "glosses": [
                            "Doter d’un code-barre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7f49a1-095e-416e-bce8-3d05b3d7a23a",
                                "sense_id": "8ee14647-c45a-39f0-af7d-573e96e7f983",
                                "text": "Comme dit Antonin il vaut mieux passer du temps à persuader les producteurs de codebarriser leurs produits, il y a un réel intérêt pour eux à le faire s’ils veulent travailler avec des boutiques !"
                            },
                            {
                                "example_id": "d1f43f77-e922-4576-83ee-b8fcda46ecda",
                                "sense_id": "8ee14647-c45a-39f0-af7d-573e96e7f983",
                                "text": "Il faut donner des preuves visibles et mesurables, évaluer, « codebarriser »."
                            },
                            {
                                "example_id": "f9b1761b-f7e1-4533-a2f3-538f694be76e",
                                "sense_id": "8ee14647-c45a-39f0-af7d-573e96e7f983",
                                "text": "Déspiritualiser la carcasse pour mieux la désosser, la piercer, la codebarriser, la livrer aux marchands."
                            }
                        ]
                    }
