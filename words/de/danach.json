                    "frequency": "High",
                    "semantic_group_id": "zeitlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zuerst frühstücken wir gemeinsam, und <w>danach</w> gehen wir im Park spazieren."
                        },
                        {
                            "text": "Er beendete die Schule und begann kurz <w>danach</w> eine Ausbildung im Betrieb seines Vaters."
                        }
                    ],
                    "synonyms": [
                        "anschließend",
                        "dann",
                        "hernach",
                        "nachher",
                        "später"
                    ],
                    "antonyms": [
                        "davor",
                        "vorher"
                    ],
                    "common_phrases": [
                        "kurz danach",
                        "gleich danach",
                        "direkt danach"
                    ]
                },
                {
                    "sense_id": "ca06874f-1cf3-3095-8352-c18aac3fd31d",
                    "sense_definition": "auf einen zuvor genannten Sachverhalt bezogen; demgemäß oder in Übereinstimmung damit",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kausal_modal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Himmel zieht sich dunkel zu, und es sieht ganz <w>danach</w> aus, dass es bald regnet."
                        },
                        {
                            "text": "Wenn du die genaue Adresse nicht weißt, solltest du an der Information <w>danach</w> fragen."
                        }
                    ],
                    "common_phrases": [
                        "sieht ganz danach aus"
                    ]
                },
                {
                    "sense_id": "ed94116d-baa5-335b-97da-9dd31999161b",
                    "sense_definition": "in einer räumlichen Abfolge oder Reihenfolge hinter einer bestimmten Sache liegend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "raeumlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem Lageplan steht zuerst das Rathaus, direkt <w>danach</w> folgt die alte Kirche."
