    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6e470ae8-8c37-30ad-b323-29fa07da0e87",
                "word": "Valencian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c806a94-0994-387a-8d3c-8b1787fa88b1",
                        "entry_id": "6e470ae8-8c37-30ad-b323-29fa07da0e87",
                        "glosses": [
                            "From or relating to Valencia, its people, or its language."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ccd30355-8c82-4c15-bd46-99292229a53c",
                                "sense_id": "4c806a94-0994-387a-8d3c-8b1787fa88b1",
                                "text": "Fr. Felipe Císcar Puig was a Valencian priest who is also also considered a martyr of the sacramental seal because he was martyred after keeping confessions secret during the religious persecution of the Spanish Civil War."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f147d3a-e72d-4271-a9dd-e2961e6d8ef2",
                        "source_entry_id": "6e470ae8-8c37-30ad-b323-29fa07da0e87",
                        "source_sense_id": "4c806a94-0994-387a-8d3c-8b1787fa88b1",
                        "source_sense_description": "from or relating to Valencia",
                        "target_lang_word": "valencien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valencien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6260d1b8-138b-33df-a0e6-78fd5965b487",
                                        "entry_id": "f03f131e-11db-336b-b683-03847f041549",
                                        "glosses": [
                                            "Relatif à Valence, commune du Tarn-et-Garonne, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e841eb56-9b09-4048-bb75-cb3afb424ece",
                                                "sense_id": "6260d1b8-138b-33df-a0e6-78fd5965b487",
                                                "text": "Les conditions de réception de l’un des favoris de la saison ne sont pas les meilleures pour les Tarn-et-Garonnais aujourd’hui. […] Si la venue de Rodez est prise avec beaucoup de sérieux du côté valencien, cette fois encore le groupe des « ciel en blanc » va être sérieusement diminué avec de nombreuses absences pour blessure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7b298a-8655-318f-a9ce-883a69a666c7",
                                        "entry_id": "f03f131e-11db-336b-b683-03847f041549",
                                        "glosses": [
                                            "Relatif à Valence, capitale de la Communauté valencienne, en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfde22b8-89d0-469a-8c01-397c1d639f3d",
                                                "sense_id": "dd7b298a-8655-318f-a9ce-883a69a666c7",
                                                "text": "Bien qu’elles se servissent entre elles du dialecte valencien, elles entendaient et parlaient correctement l’espagnol."
                                            },
                                            {
                                                "example_id": "4cfd3dce-8d42-426e-8460-524bf47a1274",
                                                "sense_id": "dd7b298a-8655-318f-a9ce-883a69a666c7",
                                                "text": "Les paysans valenciens ont un costume d’une étrangeté caractéristique, qui ne doit pas avoir varié beaucoup depuis l’invasion des Arabes, et qui ne diffère que très-peu du costume actuel des Mores d’Afrique."
                                            },
                                            {
                                                "example_id": "3a7c4800-bb50-40e5-833e-4a5f05f93ece",
                                                "sense_id": "dd7b298a-8655-318f-a9ce-883a69a666c7",
                                                "text": "Le théâtre espagnol doit ses plus notables progrès à la ville de Valence, ou plutôt à l’école littéraire qui s’y était formée. Les meilleurs poëtes dramatiques de l’Espagne, à l'époque des débuts de Lope dans la carrière, étaient tous des poëtes valenciens."
                                            },
                                            {
                                                "example_id": "9f3548da-bb6e-4d3e-bab5-04f957994cc4",
                                                "sense_id": "dd7b298a-8655-318f-a9ce-883a69a666c7",
                                                "text": "Une large ceinture de laine rouge lui sanglait les reins, et il en avait tiré une navaja valencienne qui, ouverte, atteignait la longueur d’un sabre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b3b524-3a4c-39d5-a79f-7dbcd44c51b2",
                                        "entry_id": "f03f131e-11db-336b-b683-03847f041549",
                                        "glosses": [
                                            "Relatif à Valence, capitale de la Communauté valencienne, en Espagne.",
                                            "Relatif à la province de Valence, en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "392c6175-61bf-36aa-913d-a4a2e6466f16",
                                        "entry_id": "f03f131e-11db-336b-b683-03847f041549",
                                        "glosses": [
                                            "Relatif à Valence, capitale de la Communauté valencienne, en Espagne.",
