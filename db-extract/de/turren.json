                "senses": [
                    {
                        "sense_id": "9f58fbd1-dade-3238-94e1-c56ab3b7b22e",
                        "entry_id": "3b39f074-da96-365c-8c16-c56a09a79c1a",
                        "glosses": [
                            "den Mut haben, etwas zu tun, etwas wagen"
                        ],
                        "tags": [
                            "veraltet; Modalverb (mit Infinitiv)"
                        ],
                        "examples": [
                            {
                                "example_id": "e0554c35-fd5e-4564-b4b6-820c24b48e61",
                                "sense_id": "9f58fbd1-dade-3238-94e1-c56ab3b7b22e",
                                "text": "„Vnd ich woltjn warlich gelobt haben als einen frommen man / der da meine yrthumb (dafür er doch will gehalten seyn) omb seines gewissens willen nicht hette geturst den Teutschen fürtragen.“ (1527)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b497403e-863c-41f0-adde-ab3b7b8cd428",
                        "source_entry_id": "3b39f074-da96-365c-8c16-c56a09a79c1a",
                        "source_sense_id": "9f58fbd1-dade-3238-94e1-c56ab3b7b22e",
                        "source_sense_description": "veraltet; Modalverb (mit Infinitiv): den Mut haben, etwas zu tun, etwas wagen",
                        "target_lang_word": "dare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                                        "entry_id": "818b3fa9-60ad-3202-97be-a422efe66fff",
                                        "glosses": [
                                            "To have enough courage (to do something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c3501dc-ec71-40e3-b206-b902e1521e19",
                                                "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                                                "text": "Don't back away just yet / From destinations set / I dare you to be proud / To dare to shout aloud / For convictions that you feel / Like sound from bells to peal"
                                            },
                                            {
                                                "example_id": "3cc3b12a-5935-430e-b4d1-a8fea694381a",
                                                "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                                                "text": "I wouldn't dare (to) argue with my boss."
                                            },
                                            {
                                                "example_id": "6e815a3a-91b4-468e-b77c-409a877f133d",
                                                "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                                                "text": "No one dares (to) criticize his decisions."
                                            },
                                            {
                                                "example_id": "5109e7f6-bd7d-416f-aeb3-e60fcb51a9c9",
                                                "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                                                "text": "The fellow dares not deceive me."
                                            },
                                            {
                                                "example_id": "c3dcff3e-0152-4da1-ae26-560e5079c027",
                                                "sense_id": "8b815d33-9f58-3e93-b8da-607367d054b2",
                                                "text": "Why then did not the ministers use their new law? Because they durst not, because they could not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890fdbd0-9fec-30d3-84a9-3d6b5a5f5aa3",
                                        "entry_id": "818b3fa9-60ad-3202-97be-a422efe66fff",
                                        "glosses": [
                                            "To defy or challenge (someone to do something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470d49e5-13a1-4b2e-a179-91dc081af3d8",
                                                "sense_id": "890fdbd0-9fec-30d3-84a9-3d6b5a5f5aa3",
                                                "text": "I dare you to kiss that girl."
                                            },
                                            {
                                                "example_id": "cfcdd990-ca9a-4fe5-9d76-354ddc43a9ea",
                                                "sense_id": "890fdbd0-9fec-30d3-84a9-3d6b5a5f5aa3",
                                                "text": "Don't back away just yet / From destinations set / I dare you to be proud / To dare to shout aloud / For convictions that you feel / Like sound from bells to peal"
                                            },
                                            {
                                                "example_id": "f0a08219-48b6-4f36-a24d-78928233857d",
                                                "sense_id": "890fdbd0-9fec-30d3-84a9-3d6b5a5f5aa3",
                                                "text": "Particular note, in this period, should be made of the actions of Joseph Denman, commander of the Northern Division of the Squadron, who went on an absolutely ruthless and systematic campaign along the African coast, burning so-called \"slaving factories\" to the ground and openly daring anyone who objected to try and stop him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f891a3a6-2d28-361e-849b-727498eddbcb",
                                        "entry_id": "818b3fa9-60ad-3202-97be-a422efe66fff",
                                        "glosses": [
                                            "To have enough courage to meet or do something, go somewhere, etc.; to face up to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d3dd91-5ca1-4d16-b9ab-22520e5f5e05",
                                                "sense_id": "f891a3a6-2d28-361e-849b-727498eddbcb",
                                                "text": "Will you dare death to reach your goal?"
                                            },
                                            {
                                                "example_id": "3e0794fb-ba6e-4d3f-b6f7-cccdd509b727",
                                                "sense_id": "f891a3a6-2d28-361e-849b-727498eddbcb",
                                                "text": "To wrest it from barbarism, to dare its solitudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9307093-5b24-38d4-9de3-a0f810ec9be4",
                                        "entry_id": "818b3fa9-60ad-3202-97be-a422efe66fff",
                                        "glosses": [
                                            "To terrify; to daunt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617f4abc-b6d4-4a0c-82c1-08d94d92dbc2",
                                                "sense_id": "a9307093-5b24-38d4-9de3-a0f810ec9be4",
                                                "text": "For I have done those follies, those mad mischiefs, Would dare a woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "602435af-c3c8-346b-9fd6-206b8b2dbb68",
                                        "entry_id": "818b3fa9-60ad-3202-97be-a422efe66fff",
                                        "glosses": [
                                            "To drive larks to the ground by scaring them (for instance, with mirrors or hawks) so they can be caught in nets."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c1af48-6d92-4618-9959-348962d1f871",
                                                "sense_id": "602435af-c3c8-346b-9fd6-206b8b2dbb68",
                                                "text": "I have an hobby can make larks to dare"
                                            },
                                            {
                                                "example_id": "7b3868c2-3065-443f-9d56-5baa115db98b",
                                                "sense_id": "602435af-c3c8-346b-9fd6-206b8b2dbb68",
                                                "text": "dare us, like larks"
                                            },
                                            {
                                                "example_id": "56087299-2bc8-4539-866b-8ba7d07db210",
                                                "sense_id": "602435af-c3c8-346b-9fd6-206b8b2dbb68",
                                                "text": "How, think you, would that godly prince (if he were now living) handle our idols, set up against God's commandment directly, and being figures of nothing but folly, and for fools to gaze on, till they become as wise as the blocks themselves which they stare on, and so fall down as dared larks in that gaze, and being themselves alive, worship a dead stock or stone, gold or silver, and so become idolaters […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "391ab8d5-6d8d-3f55-a129-c0c97ccb80a0",
                                        "entry_id": "6ca46720-1774-36dc-b2c9-692bc41502e6",
                                        "glosses": [
                                            "A challenge to prove courage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276d4b20-c866-4c62-9c64-3432d7c3232f",
                                                "sense_id": "391ab8d5-6d8d-3f55-a129-c0c97ccb80a0",
                                                "text": "I did it just for a dare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a37653-a934-3dcf-aa96-f8c2b5dccd97",
                                        "entry_id": "6ca46720-1774-36dc-b2c9-692bc41502e6",
                                        "glosses": [
                                            "The quality of daring; venturesomeness; boldness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f3a311f-0740-413c-bbb3-c2fc2c6c07ef",
                                                "sense_id": "d0a37653-a934-3dcf-aa96-f8c2b5dccd97",
                                                "text": "It lends a lustre […] / A large dare to our great enterprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6836573f-d41c-354e-9f2e-6418a7cc0ef2",
                                        "entry_id": "6ca46720-1774-36dc-b2c9-692bc41502e6",
                                        "glosses": [
                                            "Defiance; challenge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d2d3bf-397d-4494-9783-10d38b985b70",
                                                "sense_id": "6836573f-d41c-354e-9f2e-6418a7cc0ef2",
                                                "text": "Childish, unworthy dares / Are not enough to part our powers."
                                            },
                                            {
                                                "example_id": "5cfba1c2-e088-464d-acde-b74828370398",
                                                "sense_id": "6836573f-d41c-354e-9f2e-6418a7cc0ef2",
                                                "text": "Sextus Pompeius / Hath given the dare to Caesar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f942eb32-6c47-39de-bf5e-e3f724b92b24",
                                        "entry_id": "6ca46720-1774-36dc-b2c9-692bc41502e6",
                                        "glosses": [
                                            "In the game truth or dare, the choice to perform a dare set by the other players."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff33b00-3a7b-4ef3-b063-ab58637d2d8f",
                                                "sense_id": "f942eb32-6c47-39de-bf5e-e3f724b92b24",
                                                "text": "When asked truth or dare, she picked dare."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eae0ebde-dbe4-3430-8645-633307847329",
