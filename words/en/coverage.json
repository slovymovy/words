{
    "word_family": [
        "cover",
        "covering",
        "uncover",
        "recover",
        "undercover",
        "cover-up"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a073c1c5-bcc3-3c9e-9d16-2136defdcf3e",
                    "sense_definition": "The reporting of news, events, or topics in newspapers, on television, radio, or the internet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The election received massive media <w>coverage</w> across all major channels.",
                            "target_lang_translations": {
                                "ru": "Выборы получили широкое <w>освещение</w> в СМИ по всем основным каналам.",
                                "zh": "这次选举在各大频道都得到了媒体的广泛<w>报道</w>。"
                            }
                        },
                        {
                            "text": "We provide live <w>coverage</w> of sports events from around the world.",
                            "target_lang_translations": {
                                "ru": "Мы обеспечиваем <w>освещение</w> спортивных событий со всего мира в прямом эфире.",
                                "zh": "我们提供全球体育赛事的现场<w>报道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reporting",
                        "reportage",
                        "press"
                    ],
                    "common_phrases": [
                        "media coverage",
                        "press coverage",
                        "live coverage",
                        "news coverage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информирование о новостях, событиях или темах в газетах, на телевидении, радио или в интернете.",
                        "zh": "指报纸、电视、广播或互联网对新闻、事件或话题的报道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освещение",
                                "target_lang_sense_clarification": "событий в СМИ"
                            },
                            {
                                "target_lang_word": "репортаж",
                                "target_lang_sense_clarification": "с места событий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "报道",
                                "target_lang_sense_clarification": "媒体对事件的叙述"
                            },
                            {
                                "target_lang_word": "新闻覆盖",
                                "target_lang_sense_clarification": "媒体报道的广度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91329ff6-f130-3178-b662-19186f8f1e71",
                    "sense_definition": "The geographic area where a mobile phone network, radio station, or other service is available and effective.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mobile phone <w>coverage</w> is often poor in remote mountain areas.",
                            "target_lang_translations": {
                                "ru": "Мобильное <w>покрытие</w> часто бывает плохим в отдаленных горных районах.",
                                "zh": "在偏远山区，手机的<w>覆盖范围</w>通常很差。"
                            }
                        },
                        {
                            "text": "The company is working to expand its network <w>coverage</w> to rural towns.",
                            "target_lang_translations": {
                                "ru": "Компания работает над расширением зоны <w>покрытия</w> своей сети в сельских городах.",
                                "zh": "该公司正致力于将其网络<w>覆盖范围</w>扩大到农村城镇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reception",
                        "signal"
                    ],
                    "common_phrases": [
                        "network coverage",
                        "mobile coverage",
                        "satellite coverage",
                        "poor coverage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическая зона, где доступна и эффективно работает мобильная сеть, радиостанция или другая услуга.",
                        "zh": "移动电话网络、广播电台或其他服务可用且有效的地理区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрытие",
                                "target_lang_sense_clarification": "сети, сигнала"
                            },
                            {
                                "target_lang_word": "зона действия",
                                "target_lang_sense_clarification": "сети"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "覆盖范围",
                                "target_lang_sense_clarification": "信号或服务的区域"
                            },
                            {
                                "target_lang_word": "信号覆盖",
                                "target_lang_sense_clarification": "网络连接的有效性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4cebdec-1701-36ce-950f-7d749349b2a9",
                    "sense_definition": "The financial protection provided by an insurance policy against specific risks or losses.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Does your policy provide <w>coverage</w> for flood damage?",
                            "target_lang_translations": {
                                "ru": "Предоставляет ли ваш полис <w>покрытие</w> на случай ущерба от наводнения?",
                                "zh": "你的保单提供针对洪水损失的<w>保险范围</w>吗？"
                            }
                        },
                        {
                            "text": "The new job offers excellent health <w>coverage</w> for the entire family.",
                            "target_lang_translations": {
                                "ru": "Новая работа предлагает отличное медицинское <w>страховое покрытие</w> для всей семьи.",
                                "zh": "这份新工作为全家人提供了极好的医疗<w>保险范围</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "protection",
                        "insurance",
                        "indemnity"
                    ],
                    "common_phrases": [
                        "insurance coverage",
                        "health coverage",
                        "full coverage",
                        "medical coverage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовая защита от определенных рисков или убытков, предоставляемая страховым полисом.",
                        "zh": "保险单针对特定风险或损失提供的财务保障。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страховое покрытие",
                                "target_lang_sense_clarification": "объем страховки"
                            },
                            {
                                "target_lang_word": "страховка",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保险范围",
                                "target_lang_sense_clarification": "保单涵盖的损失项目"
                            },
                            {
                                "target_lang_word": "承保",
                                "target_lang_sense_clarification": "保险公司承担的责任"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e5bf43f-ae20-3240-85b6-723dfb741bf3",
                    "sense_definition": "The defensive tactic of marking an opponent or guarding a specific area of the field in sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linebacker dropped back into pass <w>coverage</w> to intercept the ball.",
                            "target_lang_translations": {
                                "ru": "Лайнбекер отошел назад в <w>защиту</w> от паса, чтобы перехватить мяч.",
                                "zh": "线卫后撤进行传球<w>防守</w>，试图拦截球。"
                            }
                        },
                        {
                            "text": "Their defensive <w>coverage</w> was too tight for the opposing team to score easily.",
                            "target_lang_translations": {
                                "ru": "Их оборонительная <w>опека</w> была слишком плотной, чтобы команда противника могла легко забить.",
                                "zh": "他们的防守<w>盯防</w>太严密了，以至于对方球队很难得分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defense",
                        "marking"
                    ],
                    "common_phrases": [
                        "defensive coverage",
                        "zone coverage",
                        "man-to-man coverage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборонительная тактика опеки соперника или защиты определенной зоны поля в спорте.",
                        "zh": "体育运动中盯防对手或防守场地特定区域的战术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "игрока"
                            },
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "зоны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "防守",
                                "target_lang_sense_clarification": "对区域的保护"
                            },
                            {
                                "target_lang_word": "盯防",
                                "target_lang_sense_clarification": "对球员的贴身防守"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff9ba5ab-5ef4-30b2-8ef5-c556fb6249d7",
                    "sense_definition": "The number of times a specific DNA sequence is read during the sequencing process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High <w>coverage</w> is required to accurately detect mutations in the genome.",
                            "target_lang_translations": {
                                "ru": "Для точного выявления мутаций в геноме требуется высокое <w>покрытие</w>.",
                                "zh": "要准确检测基因组中的突变，需要高<w>覆盖度</w>。"
                            }
                        },
                        {
                            "text": "The study utilized deep sequencing <w>coverage</w> to identify rare variants.",
                            "target_lang_translations": {
                                "ru": "В исследовании использовалось глубокое <w>покрытие</w> секвенирования для выявления редких вариантов.",
                                "zh": "该研究利用深度测序<w>覆盖度</w>来识别罕见变异。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depth"
                    ],
                    "common_phrases": [
                        "sequence coverage",
                        "high coverage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество прочтений определенной последовательности ДНК в процессе секвенирования.",
                        "zh": "在测序过程中，特定DNA序列被读取的次数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрытие",
                                "target_lang_sense_clarification": "генома"
                            },
                            {
                                "target_lang_word": "глубина покрытия",
                                "target_lang_sense_clarification": "секвенирования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "覆盖度",
                                "target_lang_sense_clarification": "测序深度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}