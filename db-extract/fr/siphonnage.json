                        "glosses": [
                            "Action de siphonner, de puiser un liquide à l’aide de siphons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876e5f42-d4a7-4831-96a2-316bc3332a31",
                                "sense_id": "0ae047f1-3132-366c-8366-1d9d4a585116",
                                "text": "Le principe de l'emplissage par siphonnage est celui des vases communicants, ce qui confère aux becs un avantage incontestable : celui d'être simples, les plus simples becs de remplissage."
                            }
                        ]
                    },
