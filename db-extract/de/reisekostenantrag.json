                ],
                "senses": [
                    {
                        "sense_id": "44763bf4-f969-31d9-9d20-9e29ebe42604",
                        "entry_id": "c84bd5bb-ceb1-3196-9e77-c5276c05c012",
                        "glosses": [
                            "Antrag an jemanden, die durch eine Reise verursachten Kosten zu übernehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af25ca2-85d4-4aec-924d-328f9268f011",
                                "sense_id": "44763bf4-f969-31d9-9d20-9e29ebe42604",
                                "text": "„Jeder Soldat ist verpflichtet, in einem Reisekostenantrag wahrheitsgemäße Angaben über den tatsächlichen Reiseverlauf und die tatsachlich entstandenen dienstbedingten Aufwendungen zu machen.“"
                            },
                            {
                                "example_id": "bf88eea8-53d1-4848-9224-a6ff6751800a",
                                "sense_id": "44763bf4-f969-31d9-9d20-9e29ebe42604",
                                "text": "„Durch die Beauftragung eines Mitarbeiters mit der Ausfüllung eines Reisekostenantrags kann sich der Bedienstete nicht von seiner Eigen- und Letztverantwortung hinsichtl. der Richtigkeit seiner Angaben freizeichnen.“"
                            },
                            {
                                "example_id": "b402a489-e90b-4673-b524-db7ca41d5607",
                                "sense_id": "44763bf4-f969-31d9-9d20-9e29ebe42604",
                                "text": "„Die Mitarbeiter bekamen zudem zahlreiche Funktionen zur Verfügung gestellt, um künftig Urlaubsanträge, Zeitbuchungsnachweise, Stammdatenanträge und Reisekostenanträge selbstständig ausfüllen zu können.“"
                            },
                            {
                                "example_id": "e45401fc-616c-49f7-8fb0-b687230cae9b",
                                "sense_id": "44763bf4-f969-31d9-9d20-9e29ebe42604",
                                "text": "„Dem Gericht ist im Übrigen kein Fall bekannt, wonach das Landesamt bei Reisekostenanträgen mit der entsprechend vorgegebenen Adressierung nicht auf den Eingang bei der Beschäftigungsbehörde, sondern beim Landesamt direkt abgestellt und das Erlöschen von Ansprüchen angenommen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
