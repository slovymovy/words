                        "examples": [
                            {
                                "example_id": "08e57a21-0cde-486e-a9b3-8bb3073143f7",
                                "sense_id": "9ae41d9a-12fe-3afd-b164-cab778d9d2f9",
                                "text": "De schilderijencollectie van zijn grootvader had zelfs in een museum ondergebracht moeten worden, omdat er in het kleine huurhuis waar Paul met zijn moeder naartoe had moeten verhuizen geen plek voor was."
                            },
                            {
                                "example_id": "797654bc-c28c-4a23-bc02-305bf78748d9",
                                "sense_id": "9ae41d9a-12fe-3afd-b164-cab778d9d2f9",
                                "text": "Twee derde van de schilderijencollectie van het Boijmans is toen verloren gegaan."
                            },
                            {
                                "example_id": "cbe9ac7f-bbf4-444b-bd7b-7208dd8bc898",
                                "sense_id": "9ae41d9a-12fe-3afd-b164-cab778d9d2f9",
                                "text": "In Buckingham Palace is de koninklijke staf wel wat gewend. Toch worden ook daar alle zeilen bijgezet, om te zorgen dat de huwelijksreceptie perfect verloopt. Ongeveer 600 mensen zijn uitgenodigd voor de receptie op het paleis dat Koningin Victoria in de 19de eeuw als eerste bewoonde. \"Het paleis ademt geschiedenis\", zegt Jennifer Scott, curator van de schilderijencollectie van het paleis."
                            }
                        ]
                    }
