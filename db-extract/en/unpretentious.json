                    {
                        "sense_id": "dbba83d5-502c-31eb-8ae4-19b296d2771e",
                        "entry_id": "7a8da244-50c8-3c57-9c8c-80c75ad50456",
                        "glosses": [
                            "Simple, humble, not pretentious, plain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "645cdd08-009a-4e4b-bdf9-7f6cf822995d",
                                "sense_id": "dbba83d5-502c-31eb-8ae4-19b296d2771e",
                                "text": "Cheltenham Spa station had opened in June 1840 as Cheltenham, being renamed Cheltenham Spa (Lansdown) in February 1925 and taking on its modern name of Cheltenham Spa in January 1948 - an oddity in itself as its town is plain, unpretentious Cheltenham."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29b7ea97-cb1e-4172-8114-2409da1d373e",
                        "source_entry_id": "7a8da244-50c8-3c57-9c8c-80c75ad50456",
                        "source_sense_id": "dbba83d5-502c-31eb-8ae4-19b296d2771e",
                        "source_sense_description": "not pretentious",
                        "target_lang_word": "unprätentiös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unprätentiös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7801e8d-a3da-3954-b084-3d82deb3d577",
                                        "entry_id": "4247ebf1-93ed-3e07-bb51-130f0f3323e1",
                                        "glosses": [
                                            "nicht prätentiös, unauffällig, nicht eingebildet, sondern redlich und bescheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94aaae54-1f8b-4f4d-b6b5-05ddd5ff0a1d",
                                                "sense_id": "b7801e8d-a3da-3954-b084-3d82deb3d577",
                                                "text": "Unprätentiös, aber ohne Einschränkung im entspannt souveränen Tonfall eines Menschen, der sich seines Standes sehr wohl bewusst ist, erzählt die Autorin von ihren Jahren in einem der kunstgeschichtlich bedeutsamsten Schlösser des Landes – „schöner als Versailles“, zitiert sie einen Gast."
                                            },
                                            {
                                                "example_id": "cea974b8-1720-45d2-8b9b-cf6e7d3438f5",
                                                "sense_id": "b7801e8d-a3da-3954-b084-3d82deb3d577",
                                                "text": "Er ist ein sympathischer Mann mit unprätentiösem Auftreten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
