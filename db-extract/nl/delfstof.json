                                    },
                                    {
                                        "sense_id": "cf60b790-84b4-3f40-95c3-004cf96d1b4a",
                                        "entry_id": "394fb000-4192-315e-bb47-96246d086c95",
                                        "glosses": [
                                            "A mine or mineral deposit."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8d8437-954d-41c6-83f2-10d275914528",
                                                "sense_id": "cf60b790-84b4-3f40-95c3-004cf96d1b4a",
                                                "text": "O'er whom his very madness, like some ore / Among a mineral of metals base, / Shows itself pure;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c1ff265-df47-3d93-81e7-44696ed18db9",
                                        "entry_id": "394fb000-4192-315e-bb47-96246d086c95",
                                        "glosses": [
                                            "A poisonous or dangerous substance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f9fddc0-247c-4f83-a84e-0c3e1aa508db",
                                                "sense_id": "4c1ff265-df47-3d93-81e7-44696ed18db9",
                                                "text": "...Thou hast... / Abused her delicate youth with drugs or minerals[…]"
                                            }
                                        ]
