                "senses": [
                    {
                        "sense_id": "be2caadd-ee49-399e-bae9-329efe7b470a",
                        "entry_id": "41b1edd4-bb82-31ce-b437-3a45c2bb4d25",
                        "glosses": [
                            "een toetsinstrument met een of meer reeksen van afgestemde pijpen waardoor lucht wordt geblazen. Voor de toonopwekking zijn de pijpen voorzien van een labium zodat, op dezelfde wijze als bij een blokfluit, een trillende luchtkolom ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd16875-59dc-4c9b-ab81-31c1c91c7331",
                                "sense_id": "be2caadd-ee49-399e-bae9-329efe7b470a",
                                "text": "Een kerkorgel is meestal een pijporgel ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e255bd34-d334-4d7a-8f25-c7481b1caa61",
                        "source_entry_id": "41b1edd4-bb82-31ce-b437-3a45c2bb4d25",
                        "source_sense_id": "be2caadd-ee49-399e-bae9-329efe7b470a",
                        "target_lang_word": "Orgel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orgel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "574b68d5-91c2-39c7-aa6c-ad358e61dc4c",
                                        "entry_id": "9b2be97f-8332-3699-be5f-3c5a1c4fe537",
                                        "glosses": [
                                            "ein großes, häufig in Kirchen zu findendes, Musikinstrument mit Manualen und einer Klaviatur für die Füße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb1b41e-cb8f-43ae-a7d2-314100a21cbc",
                                                "sense_id": "574b68d5-91c2-39c7-aa6c-ad358e61dc4c",
                                                "text": "\"Über der Haupttür, dort, wo eigentlich die Orgel sein müßte, befindet sich eine Empore für die Männer; es führt eine Wendeltreppe hinauf, die unter den Holzschuhen hallt.\""
                                            },
                                            {
                                                "example_id": "ad4f31c5-3c0b-49ed-9c27-f849d7b7039c",
                                                "sense_id": "574b68d5-91c2-39c7-aa6c-ad358e61dc4c",
                                                "text": "„Und er berichtete, daß er bald nach seiner Ankunft in eine Kirchenruine gegangen sei, um Orgel zu spielen.“"
                                            },
                                            {
                                                "example_id": "47c9d788-2241-4e3e-81bc-6feec92f93ce",
                                                "sense_id": "574b68d5-91c2-39c7-aa6c-ad358e61dc4c",
                                                "text": "„Sie liegt still und sonntäglich da, Vögel zwitschern in den Bäumen, und ich gehe hin, um in der kleinen Kirche der Anstalt für die Sonntagsmesse die Orgel zu spielen.“"
                                            },
                                            {
                                                "example_id": "5d77a652-51cd-4254-9c4c-5a67c07c8182",
                                                "sense_id": "574b68d5-91c2-39c7-aa6c-ad358e61dc4c",
                                                "text": "„Als Restaurator von Orgeln verdiente er sein täglich Brot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c95a4ab-2c91-32d6-b50b-7c1dacc73c2d",
                                        "entry_id": "9b2be97f-8332-3699-be5f-3c5a1c4fe537",
                                        "glosses": [
                                            "Ziehharmonika"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da67ecd5-9491-4381-a029-e15042d703e6",
                                                "sense_id": "3c95a4ab-2c91-32d6-b50b-7c1dacc73c2d",
                                                "text": "Eine Orgel ist kein Akkordeon, sie sieht ihm nur ähnlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
