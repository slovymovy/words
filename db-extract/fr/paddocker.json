                "senses": [
                    {
                        "sense_id": "709ba39c-4a75-3a9d-bdd3-3b3ea5e30cb1",
                        "entry_id": "df7094dc-07d4-3262-8760-61e8ef927a42",
                        "glosses": [
                            "Se mettre au lit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3dbb1c2-35c2-4fac-bc72-21e13bca8c7b",
                                "sense_id": "709ba39c-4a75-3a9d-bdd3-3b3ea5e30cb1",
                                "text": "En réalité, il n’y avait pas deux heures que je m’y étais pagé dans cette cabine, voulant pas, avec toutes les manigances en cours, paddocker chez moi."
                            },
                            {
                                "example_id": "6bf6404b-50fc-4214-a4be-70b6dd35b25e",
                                "sense_id": "709ba39c-4a75-3a9d-bdd3-3b3ea5e30cb1",
                                "text": "L'envie de me paddocker me reprenait, insistante."
                            },
                            {
                                "example_id": "4f70a7e1-a5dd-433c-8208-c472a9b3cf08",
                                "sense_id": "709ba39c-4a75-3a9d-bdd3-3b3ea5e30cb1",
                                "text": "Sa machine ronronnait encore que j'étais depuis longtemps paddockée et les doigts de pied en éventail!"
                            }
                        ]
                    }
