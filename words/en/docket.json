{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d56d259-7f62-33d2-8b11-702638127756",
                    "sense_definition": "An official calendar or list of legal cases awaiting trial or hearing in a court.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge examined the court <w>docket</w> to see how many trials were scheduled for tomorrow.",
                            "target_lang_translations": {
                                "zh": "法官查看了法院的<w>待审案件目录</w>，看看明天安排了多少起庭审。"
                            }
                        },
                        {
                            "text": "Several complex corporate lawsuits were placed on the <w>docket</w> for the upcoming spring term.",
                            "target_lang_translations": {
                                "zh": "几起复杂的公司诉讼已被列入即将到来的春季开庭期的<w>诉讼案件表</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "court docket",
                        "on the docket"
                    ],
                    "target_lang_definitions": {
                        "zh": "法院待审或待听审案件的官方日程表或诉讼案件表。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "待审案件目录",
                                "target_lang_sense_clarification": "法院排期的案件表"
                            },
                            {
                                "target_lang_word": "诉讼案件表",
                                "target_lang_sense_clarification": "法院日程"
                            },
                            {
                                "target_lang_word": "庭审日程表",
                                "target_lang_sense_clarification": "开庭审理时间表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00df3e3c-199b-3a18-9c88-3f58dde39a41",
                    "sense_definition": "An agenda, list, or schedule of matters or tasks to be addressed or completed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_agenda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have several important topics on the <w>docket</w> for our quarterly team meeting.",
                            "target_lang_translations": {
                                "zh": "我们季度的团队会议上有几个重要议题排在<w>议程</w>上。"
                            }
                        },
                        {
                            "text": "Renovating the kitchen is the next big project on my personal <w>docket</w>.",
                            "target_lang_translations": {
                                "zh": "翻修厨房是我个人<w>日程表</w>上的下一个大项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agenda",
                        "schedule"
                    ],
                    "common_phrases": [
                        "on the docket"
                    ],
                    "target_lang_definitions": {
                        "zh": "待处理或待完成事项的议事日程、清单或计划表。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "日程表",
                                "target_lang_sense_clarification": "待办事项安排"
                            },
                            {
                                "target_lang_word": "议程",
                                "target_lang_sense_clarification": "会议或工作安排"
                            },
                            {
                                "target_lang_word": "待办清单",
                                "target_lang_sense_clarification": "需要处理的事情列表"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7fb58cd-98d1-3b4d-a4ad-b65c76fad19e",
                    "sense_definition": "An official register containing a brief summary or record of court proceedings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_record",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court clerk entered the details of the hearing directly into the official <w>docket</w>.",
                            "target_lang_translations": {
                                "zh": "法庭书记员将听证会的细节直接输入了官方<w>诉讼记录簿</w>。"
                            }
                        },
                        {
                            "text": "Lawyers can view the digital <w>docket</w> to review every action taken on the case.",
                            "target_lang_translations": {
                                "zh": "律师可以查看数字化<w>案卷摘要簿</w>，以审查该案件采取的每项诉讼行动。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "记录诉讼程序简要摘要或过程的法院官方诉讼记录簿、登记册。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "诉讼记录簿",
                                "target_lang_sense_clarification": "记录诉讼全过程的法院档案"
                            },
                            {
                                "target_lang_word": "案卷摘要簿",
                                "target_lang_sense_clarification": "案件进程登记册"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef638a40-6535-3cad-b8e7-6a4c6bbeb055",
                    "sense_definition": "A label, ticket, or voucher attached to a package or document detailing its contents or delivery instructions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shipping_ticket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delivery driver checked the <w>docket</w> to verify the contents of the shipment.",
                            "target_lang_translations": {
                                "zh": "送货司机核对了<w>送货单</w>，以确认货物的具体内容。"
                            }
                        },
                        {
                            "text": "A printed <w>docket</w> was securely attached to the shipping crate before transport.",
                            "target_lang_translations": {
                                "zh": "运输前，一张打印好的<w>标签</w>被牢牢附在包装木箱上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "delivery docket"
                    ],
                    "target_lang_definitions": {
                        "zh": "附在包裹或文件上，注明其内容或递送说明的标签、签条或单据。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "单据",
                                "target_lang_sense_clarification": "货运送货凭单"
                            },
                            {
                                "target_lang_word": "送货单",
                                "target_lang_sense_clarification": "标明货物信息的清单"
                            },
                            {
                                "target_lang_word": "标签",
                                "target_lang_sense_clarification": "包裹上的附签"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b37c4743-8051-3ebf-a6d1-3601b0d659bf",
                    "sense_definition": "A document serving as a receipt or proof of delivery or purchase.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shipping_ticket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please sign the <w>docket</w> once you have confirmed receipt of the materials.",
                            "target_lang_translations": {
                                "zh": "一旦确认收到材料，请在<w>签收单</w>上签字。"
                            }
                        },
                        {
                            "text": "The storekeeper retained the signed <w>docket</w> as proof that the order arrived safely.",
                            "target_lang_translations": {
                                "zh": "仓库管理员保留了签字的<w>收据</w>，作为订单安全送达的凭单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "receipt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Australia, New Zealand, and the UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用作交货或购买凭证的收据、凭单（主要用于英澳新英语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "签收单",
                                "target_lang_sense_clarification": "确认收货的凭证"
                            },
                            {
                                "target_lang_word": "收据",
                                "target_lang_sense_clarification": "付款或提货凭证"
                            },
                            {
                                "target_lang_word": "提货凭单",
                                "target_lang_sense_clarification": "交货收据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542361bc-d836-38ba-ae33-a3e92fc8c346",
                    "sense_definition": "A concise summary or digest of a longer document or text.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assistant prepared a brief <w>docket</w> outlining the main findings of the extensive report.",
                            "target_lang_translations": {
                                "zh": "助手准备了一份简短的<w>摘要</w>，概述了这份冗长报告的主要结论。"
                            }
                        },
                        {
                            "text": "He read through the written <w>docket</w> before opening the full legal agreement.",
                            "target_lang_translations": {
                                "zh": "在打开完整的法律协议之前，他仔细阅读了书面<w>概要</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "digest",
                        "summary"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical legal and administrative use"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "较长文件或文本的简明摘要或大意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摘要",
                                "target_lang_sense_clarification": "内容梗概"
                            },
                            {
                                "target_lang_word": "概要",
                                "target_lang_sense_clarification": "文本简要概述"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d88ef961-1ae6-33f5-b06f-7c30894a39bc",
                    "sense_definition": "To enter or schedule a legal case in an official court calendar or record.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court clerk promptly <w>docketed</w> the new lawsuit for a preliminary hearing.",
                            "target_lang_translations": {
                                "zh": "法庭书记员迅速将这起新诉讼<w>编入诉讼案件表</w>以安排预备庭审。"
                            }
                        },
                        {
                            "text": "All civil disputes are formally <w>docketed</w> upon the filing of the complaint.",
                            "target_lang_translations": {
                                "zh": "所有的民事纠纷在提起诉状后都会被正式<w>登记入册</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将诉讼案件载入官方诉讼案件表或排入开庭日程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "编入诉讼案件表",
                                "target_lang_sense_clarification": "排入法庭审理程序"
                            },
                            {
                                "target_lang_word": "登记入册",
                                "target_lang_sense_clarification": "将案件记入法庭案卷"
                            },
                            {
                                "target_lang_word": "排期审理",
                                "target_lang_sense_clarification": "安排开庭日程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ec72507-88e0-358b-8d2f-78ae4f1ce85f",
                    "sense_definition": "To attach a label or ticket to an item, package, or consignment detailing its destination or contents.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shipping_ticket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warehouse staff carefully <w>docketed</w> each crate before loading it onto the transport truck.",
                            "target_lang_translations": {
                                "zh": "仓库人员在将每个木箱装上运输卡车前，都仔细地为其<w>贴上标签</w>。"
                            }
                        },
                        {
                            "text": "Please ensure that every outbound parcel is properly <w>docketed</w> with handling instructions.",
                            "target_lang_translations": {
                                "zh": "请确保每个出库包裹都妥善<w>附上送货单</w>并注明搬运说明。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在包裹或货物上系上标签或附上单据，注明目的地或内容。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "附上送货单",
                                "target_lang_sense_clarification": "随包裹附上清单"
                            },
                            {
                                "target_lang_word": "贴上标签",
                                "target_lang_sense_clarification": "附带标签或说明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370cdbe2-ab0a-3ec2-bae2-5fc2ebd15964",
                    "sense_definition": "To write a brief summary, title, or index on the back or cover of a document.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archivist <w>docketed</w> each manuscript with its date and author before placing it in the folder.",
                            "target_lang_translations": {
                                "zh": "档案管理员在将每份手稿放入文件夹之前，都在其背面<w>背书摘要</w>注明日期和作者。"
                            }
                        },
                        {
                            "text": "He neatly <w>docketed</w> the bundle of letters so that any particular item could be found easily.",
                            "target_lang_translations": {
                                "zh": "他整齐地为这束信件<w>加注标签</w>，以便能轻松找到其中的特定信件。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical administrative and clerical practice"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在文件背面或封面上注明摘要、标题或索引批注。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "背书摘要",
                                "target_lang_sense_clarification": "在文件背面加注概要"
                            },
                            {
                                "target_lang_word": "加注标签",
                                "target_lang_sense_clarification": "在封面上做摘要标记"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41b9bd04-e02e-3f77-90d1-4d470607f79d",
                    "sense_definition": "To summarize a document or legal judgment and record it officially into a register or book.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_record",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official judgments were formally <w>docketed</w> in the town hall ledger.",
                            "target_lang_translations": {
                                "zh": "正式判决被正式<w>记入登记簿</w>并保存在市政厅的总账册中。"
                            }
                        },
                        {
                            "text": "The clerk quickly <w>docketed</w> the decree to maintain a complete historical record.",
                            "target_lang_translations": {
                                "zh": "书记员迅速将法令<w>摘录登记</w>，以保留完整的历史记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Pertaining to historical court administration"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将文件或法律判决简要摘录并正式载入登记簿中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摘录登记",
                                "target_lang_sense_clarification": "录入官方簿册"
                            },
                            {
                                "target_lang_word": "记入登记簿",
                                "target_lang_sense_clarification": "正式备案记录"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}