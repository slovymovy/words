                        "glosses": [
                            "État d’une personne susceptible de développer des obsessions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf7125c-b1a5-4c78-8c6e-62e016fd0f7b",
                                "sense_id": "16e5acb5-1f35-354e-b62b-6e1712aa9634",
                                "text": "En grosse partie constitutionnelle, et partiellement aussi acquise par l’éducation, par l’hygiène morale de la vie, par les épreuves diverses dont celle-ci a pu être semée, la mentalité du sujet capable de devenir neurasthénique se résume en deux mots : Émotivité, obsédabilité."
                            },
                            {
                                "example_id": "b888e336-645b-4685-97cb-55f46ae59cff",
                                "sense_id": "16e5acb5-1f35-354e-b62b-6e1712aa9634",
                                "text": "Dégénérescence dans les psychonévroses : émotivité, paraboulie, obsédabilités passagères."
                            },
                            {
                                "example_id": "705db78e-a9f8-4347-8cdb-5c8f4cded182",
                                "sense_id": "16e5acb5-1f35-354e-b62b-6e1712aa9634",
                                "text": "Il ne s’agit pas de combattre telle ou telle obsession, mais la disposition à être obsédable, l’obsédabilité."
                            }
                        ]
                    }
