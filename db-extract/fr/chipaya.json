                    {
                        "sense_id": "d8fcc38d-7402-35d7-8773-c50b92b19fc6",
                        "entry_id": "0676ed00-e5d8-36ad-9646-6e8ea9c1350b",
                        "glosses": [
                            "Langue amérindienne de la famille uru-chipaya parlée par les Chipaya en Bolivie, autour du lac Titicaca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140c54d0-a504-488e-bc99-50bc232368cc",
                                "sense_id": "d8fcc38d-7402-35d7-8773-c50b92b19fc6",
                                "text": "Un peu plus au sud, le chipaya, parlé dans le seul village du même nom, est à peu près tout ce qui subsiste d'une autre très ancienne famille de langues et de cultures : les Quechuas et les Aymaras assimilaient les locuteurs de cette langue à des « débris des chullpas », des êtres qui auraient peuplé le monde avant les hommes, et même avant l'apparition du soleil."
                            }
                        ]
                    }
