                "senses": [
                    {
                        "sense_id": "466fe2d7-affe-309b-ad0b-757f59750a64",
                        "entry_id": "59a51e8e-7dd4-3eed-a6c1-1fcb0ba954eb",
                        "glosses": [
                            "Frau in der Phase der praktischen Ausbildung zur Pastoralreferentin"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "58265c58-a01f-4e59-9361-839af8600c79",
                                "sense_id": "466fe2d7-affe-309b-ad0b-757f59750a64",
                                "text": "„Wenn das Pastoralpraktikum erfolgreich abgeschlossen wurde, kann die Übernahme der Pastoralassistentin oder des Pastoralassistenten in den Dienst in einem Pfarrverband erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cd16c51-a078-3ec7-9392-81835038f74b",
                        "entry_id": "59a51e8e-7dd4-3eed-a6c1-1fcb0ba954eb",
                        "glosses": [
                            "Laien-Seelsorgerin mit Hochschul- oder Berufsfachschul-Ausbildung"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "1d8ec871-b4bf-4fe5-b4ec-7ec5e71324ed",
                                "sense_id": "3cd16c51-a078-3ec7-9392-81835038f74b",
                                "text": "„Dieser kirchliche Beruf entspringt der Vielfalt der Berufungen, Charismen und Dienste, die uns die Bibel berichtet […]. Er findet sich bereits in den 1920er Jahren im Berufsstand der Seelsorgehelferinnen und hat sich durch das II. Vatikanische Konzil zu dem des Pastoralassistenten/der Pastoralassistentin entfaltet. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "208b5c35-6746-3bbf-9eef-d4e7786f2792",
                        "entry_id": "59a51e8e-7dd4-3eed-a6c1-1fcb0ba954eb",
                        "glosses": [
                            "Laien-Seelsorgerin mit Hochschul-Ausbildung"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "33f1b202-3db6-48a6-8a5e-07e429deaf03",
                                "sense_id": "208b5c35-6746-3bbf-9eef-d4e7786f2792",
                                "text": "„Pastoralassistenten und Pastoralassistentinnen sind in der allgemeinen Seelsorge von römisch-katholischen Kirchgemeinden tätig.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d6abeea-19d1-4a35-8ec3-924d7a66db10",
                        "source_entry_id": "59a51e8e-7dd4-3eed-a6c1-1fcb0ba954eb",
                        "source_sense_id": "208b5c35-6746-3bbf-9eef-d4e7786f2792",
                        "source_sense_description": "Schweiz, Katholizismus: Laien-Seelsorgerin mit Hochschul-Ausbildung",
                        "target_lang_word": "assistante pastorale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assistante pastorale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "845388aa-aa13-314e-a076-6d5dad860591",
                                        "entry_id": "7ccb5f15-e58b-301c-9343-39a4975efa22",
                                        "glosses": [
                                            "Théologienne laïque de formation universitaire servant d’agent pastoral dans l’Église catholique romaine."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "734e2bbc-3424-472e-912b-8bad2e7c7138",
                                                "sense_id": "845388aa-aa13-314e-a076-6d5dad860591",
                                                "text": "L’assistant pastoral ou l’assistante pastorale sont chargés d'annoncer le message de Jésus Christ, de former à la foi, d'animer les communautés chrétiennes catholiques et de contribuer à leur unité."
                                            },
                                            {
                                                "example_id": "b470d93d-b924-4d74-9d4f-fc42e88f7dbe",
                                                "sense_id": "845388aa-aa13-314e-a076-6d5dad860591",
                                                "text": "Je fais partie d’une équipe pastorale de six personnes très diverses : trois prêtres, un diacre, une assistante pastorale et moi."
                                            },
                                            {
                                                "example_id": "18c3dc4f-4382-417c-b590-930a00338169",
                                                "sense_id": "845388aa-aa13-314e-a076-6d5dad860591",
                                                "text": "Les autorités paroissiales et l’équipe pastorale, formée par les abbés Claude Nicoulin et Jean-Noël Theurillat, les Pères Marie-Bernard Farine, Imier Montavon et Jean Humair, le diacre Jean-François Lovis et l’assistante pastorale Marie-Josèphe Lachat, ont chaleureusement souhaité la bienvenue au nouvel assistant pastoral, Noël Pedreira, au cours de la messe célébrée à l’église de Corban, samedi 25 septembre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
