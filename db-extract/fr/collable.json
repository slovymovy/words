                        "sense_id": "e782a774-f1eb-3cd9-943d-43c8e75983e5",
                        "entry_id": "41a3de54-34b2-37b0-a9a3-00ee09d1c4d2",
                        "glosses": [
                            "Que l'on peut coller ; qui est susceptible d'être collé."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "5bc67378-340a-49d2-ae81-a90befaa8600",
                                "sense_id": "e782a774-f1eb-3cd9-943d-43c8e75983e5",
                                "text": "Le polypropylène est difficilement collable. La technique adoptée est la soudure au miroir ou par rotation."
                            },
                            {
                                "example_id": "2aa6e0a6-44b9-4c8c-81a6-28a755f0864d",
                                "sense_id": "e782a774-f1eb-3cd9-943d-43c8e75983e5",
                                "text": "La « norme statistique » impose non seulement des comportements normalisés, mais aussi le fait même d’aplanir la vie et de la réduire à une série de modules collables et décollables à merci."
                            }
                        ]
                    },
                    {
                        "sense_id": "29df0c6e-c651-3dcb-9038-25484fb495be",
                        "entry_id": "41a3de54-34b2-37b0-a9a3-00ee09d1c4d2",
                        "glosses": [
                            "Collant."
                        ],
                        "tags": [
                            "Parfois"
                        ],
                        "examples": [
                            {
                                "example_id": "538e44cd-4bfc-4f32-8ccd-74f5e1762899",
                                "sense_id": "29df0c6e-c651-3dcb-9038-25484fb495be",
                                "text": "Et bien non, les deux échoppes que j’ai pu fréquenter embaumaient le cuir, le caoutchouc et la furieuse colle néoprène. Celle qui a la particularité d’être collable alors qu’elle semble sèche !"
                            }
                        ]
                    }
