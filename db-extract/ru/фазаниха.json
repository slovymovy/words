                "senses": [
                    {
                        "sense_id": "67e14a94-1d72-3f33-86f1-354305181a58",
                        "entry_id": "f3d2e7c2-e553-3545-aa44-9832854f038d",
                        "glosses": [
                            "орнитол., разг. самка фазана"
                        ],
