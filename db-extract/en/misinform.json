                                "target_senses": [
                                    {
                                        "sense_id": "841fdc2b-b428-3dee-80a3-8e4db4c1dbaf",
                                        "entry_id": "ad0228b8-237e-3fe4-9fd9-adba57e531a0",
                                        "glosses": [
                                            "Informer mal, en donnant des informations fausses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9003627-1fbf-43b4-a112-b7535aaece03",
                                                "sense_id": "841fdc2b-b428-3dee-80a3-8e4db4c1dbaf",
                                                "text": "Et deux communiqués officiels se chargeront de désinformer et mésinformer le public, auquel on cache tout autant les manœuvres criminelles des magistrats de 1932-1933 que le fiasco du procureur de 1984."
                                            },
                                            {
                                                "example_id": "681e1276-dd55-4bf3-92ba-2451cc1fabd0",
                                                "sense_id": "841fdc2b-b428-3dee-80a3-8e4db4c1dbaf",
                                                "text": "Après s’être interrogé sur les dimensions sociales et culturelles du comportement expressif, Goffman en vient à se dire que cette « expression » de soi, qui devient une « impression » pour l’autre, il est possible de la manipuler tactiquement, afin de « mésinformer » son interlocuteur, qui peut lui-même agir de façon identique tout en interprétant les messages qui lui arrivent comme transparents ou codés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a5f41c-5402-47ab-a814-22d6df88d4d4",
                        "source_entry_id": "15300d15-f130-3be2-8c0d-6b8dece5c524",
                        "source_sense_id": "abd437a6-8bac-3fc7-8181-201d489eddc7",
                        "source_sense_description": "give or deliver false, fake, or misleading information",
                        "target_lang_word": "induire en erreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "induire en erreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82937a8f-fcc5-3a83-ad3b-f4641f503cce",
                                        "entry_id": "a88e5d66-188f-31e4-9f87-29b59620f00f",
                                        "glosses": [
                                            "Tromper volontairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "240f85d8-44e0-477b-9935-e5c034cffa9c",
                                                "sense_id": "82937a8f-fcc5-3a83-ad3b-f4641f503cce",
                                                "text": "Son apparence totalement anodine, hormis sa moustache fournie, l’induisait peut-être en erreur."
                                            },
                                            {
                                                "example_id": "e2cee22f-f3d4-4cfd-aac4-3951bb2fd04b",
                                                "sense_id": "82937a8f-fcc5-3a83-ad3b-f4641f503cce",
                                                "text": "Il serait préférable que le Japon s’excuse des crimes qu’il a commis à l’encontre de la Corée et des autres peuples d’Asie et offre de réparer son passé plutôt que d’induire en erreur l’opinion publique internationale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ba43574-9801-48e2-babe-cebd24d8e956",
                        "source_entry_id": "15300d15-f130-3be2-8c0d-6b8dece5c524",
                        "source_sense_id": "abd437a6-8bac-3fc7-8181-201d489eddc7",
                        "source_sense_description": "give or deliver false, fake, or misleading information",
                        "target_lang_word": "désinformer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désinformer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca1f065-4610-3e40-8a4b-a92111f53e7c",
                                        "entry_id": "21313bc6-250c-3b1c-88eb-34ce70d13c49",
                                        "glosses": [
                                            "Communiquer sciemment de l’information fausse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5c1103-073b-4e7a-8829-214eabcaec1c",
                                                "sense_id": "6ca1f065-4610-3e40-8a4b-a92111f53e7c",
                                                "text": "Communication n'est pas synonyme de transparence: on communique tout autant pour désinformer, manipuler, jeter de la poudre aux yeux, construire une façade, sauver les apparences."
                                            },
                                            {
                                                "example_id": "cd8180ed-1364-4b65-9e83-f2378b1601b8",
                                                "sense_id": "6ca1f065-4610-3e40-8a4b-a92111f53e7c",
                                                "text": "L’industrie laitière française, nos deux géants en tête, est accusée, comme l’industrie du tabac, d’avoir désinformé l’opinion publique pour masquer les effets pas toujours fameux sur la santé de certains de ses produits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
