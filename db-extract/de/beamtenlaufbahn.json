                    {
                        "sense_id": "3713239d-2cb8-36c1-9b14-30a38f7fb347",
                        "entry_id": "4e4e0f19-281f-3521-89d9-af928b98b350",
                        "glosses": [
                            "benannte Verkehrsfläche in Norderstedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e43a013-ae0f-4e39-aa5e-b9b3b0271075",
                                "sense_id": "3713239d-2cb8-36c1-9b14-30a38f7fb347",
                                "text": "„In Norderstedt (bei Hamburg) gibt es eine Straße namens ‚Beamtenlaufbahn‘. Die Straße ist eine Sackgasse.“"
                            },
                            {
                                "example_id": "366a0d5a-817b-40c8-992a-70b59ad42264",
                                "sense_id": "3713239d-2cb8-36c1-9b14-30a38f7fb347",
                                "text": "„Als ich mit diesem Gedanken vor einem Straßenschild mit der Aufschrift ‚Beamtenlaufbahn‘ stehe, muss ich nicht nur schmunzeln, sondern lache laut los.“"
                            },
                            {
                                "example_id": "b024c78e-5eab-47ea-a768-e3210ff1e382",
                                "sense_id": "3713239d-2cb8-36c1-9b14-30a38f7fb347",
                                "text": "„In Norderstedt bei Hamburg gibt es eine Straße mit dem Namen Beamtenlaufbahn. Bezeichnenderweise handelt es sich dabei um eine Sackgasse.“"
                            }
                        ],
