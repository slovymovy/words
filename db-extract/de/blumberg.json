                ],
                "senses": [
                    {
                        "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                        "entry_id": "723e37fb-37ab-3108-bf3e-a9de3aa8c137",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8aee84a-52d6-4b43-adb6-f9e039a7597e",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Frau Blumberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f54e0258-39a0-4f4f-a486-4929884b4ded",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Herr Blumberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c6b1d6ae-f921-4f72-9feb-80e86def0646",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Die Blumbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1098c610-695a-4052-a117-1214ab62e99d",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Der Blumberg trägt nie die Schals, die die Blumberg ihm strickt."
                            },
                            {
                                "example_id": "b4ee171b-ed4d-4f5b-9d5d-0dccd85e5072",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Blumberg kommt, geht der Herr Blumberg.“"
                            },
                            {
                                "example_id": "7e894575-2180-4b41-94e4-033be8010d42",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Blumberg kommt und geht."
                            },
                            {
                                "example_id": "e1c7ee67-86fb-43bd-a366-d86a6e0d53bd",
                                "sense_id": "c4bff016-5a3a-3d75-8795-4da388e11eef",
                                "text": "Blumbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
