                        "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                        "entry_id": "40d5aeba-bd34-366e-a87e-9758025ab3af",
                        "glosses": [
                            "A best friend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bacd733-b9be-44f8-9041-32639871fd97",
                                "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                                "text": "You're supposed to be my bestie, Mel. We used to tell each other everything. So what's this Toby secret you can't tell me?"
                            },
                            {
                                "example_id": "fe96589e-6107-421d-a01a-1dc72586e628",
                                "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                                "text": "Even back then, a party just wasn't a party without my bestie, and I was miserable for the last eight frames."
                            },
                            {
                                "example_id": "a4bc6c5a-bf3d-4bfe-a49e-39863a027496",
                                "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                                "text": "On the way home, I got a joke text from my bestie."
                            },
                            {
                                "example_id": "6c346b07-efe0-4c76-bf54-20b119b89cc0",
                                "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                                "text": "Gave me a cryptic, mostly frustrated-seeming look. Went upstairs with her bestie. To re-up, probably."
                            },
                            {
                                "example_id": "bca9e57d-f7f0-4df7-961e-43d365b6034f",
                                "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                                "text": "After an oddly-placed sponsored All State commercial starring the Please Don’t Destroy boys, a group of gal pals surprise their pregnant bestie Kelsie (Chloe Fineman) and her long-suffering husband Matt (Andrew Dismukes) at their baby shower […]"
                            }
                        ]
