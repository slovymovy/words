                        "glosses": [
                            "Prozentzahl, die das Ausmaß der Inflation angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a412b6d-6cb7-4512-9fc8-9cdeb905cedf",
                                "sense_id": "1d4c37ed-6fc8-3d21-93a2-01694de6c00c",
                                "text": "„Teurere Kleidung sowie höhere Kosten für Wohnung, Wasser und Energie ließen die Inflationsrate auf 1,7 Prozent steigen.“"
                            },
                            {
                                "example_id": "46135cb1-3da2-4830-abda-7bfa9c959df2",
                                "sense_id": "1d4c37ed-6fc8-3d21-93a2-01694de6c00c",
                                "text": "„Viele Ökonomen sehen sinkende Teuerungsraten kritisch: Die Europäische Zentralbank (EZB) strebt eine Inflationsrate von zwei Prozent an.“"
                            }
                        ],
