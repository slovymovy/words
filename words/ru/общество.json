{
    "word_family": [
        "общественный",
        "сообщество",
        "общительный",
        "общественность",
        "сообщник",
        "общежитие"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b5525db-6dd2-36ef-8d99-2018e6b55f57",
                    "sense_definition": "Совокупность людей, объединённых исторически обусловленными социальными формами совместной жизни и деятельности.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_people_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Современное <w>общество</w> зависит от технологий.",
                            "target_lang_translations": {
                                "en": "Modern <w>society</w> depends on technology.",
                                "zh": "现代<w>社会</w>依赖于科技。"
                            }
                        },
                        {
                            "text": "Каждый человек должен приносить пользу <w>обществу</w>.",
                            "target_lang_translations": {
                                "en": "Every person should be of benefit to <w>society</w>.",
                                "zh": "每个人都应该为<w>社会</w>做出贡献。"
                            }
                        }
                    ],
                    "synonyms": [
                        "социум"
                    ],
                    "antonyms": [
                        "индивидуум"
                    ],
                    "common_phrases": [
                        "современное общество",
                        "человеческое общество",
                        "развитие общества"
                    ],
                    "target_lang_definitions": {
                        "en": "A collection of people united by historically determined social forms of joint life and activity.",
                        "zh": "由历史上形成的社会生活和活动形式所结合的人群集合。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "society",
                                "target_lang_sense_clarification": "community of people"
                            },
                            {
                                "target_lang_word": "community",
                                "target_lang_sense_clarification": "general public"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社会",
                                "target_lang_sense_clarification": "人类群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9787f0f-1721-31cc-a0f7-b29a51e6f623",
                    "sense_definition": "Добровольное объединение людей для какой-либо общей цели (научной, благотворительной, спортивной и т.п.).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Русское географическое <w>общество</w> организовало новую экспедицию.",
                            "target_lang_translations": {
                                "en": "The Russian Geographical <w>Society</w> organized a new expedition.",
                                "zh": "俄罗斯地理<w>学会</w>组织了一次新的考察。"
                            }
                        },
                        {
                            "text": "Она вступила в <w>общество</w> защиты животных.",
                            "target_lang_translations": {
                                "en": "She joined the <w>society</w> for the protection of animals.",
                                "zh": "她加入了动物保护<w>协会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "организация",
                        "союз"
                    ],
                    "common_phrases": [
                        "тайное общество",
                        "научное общество",
                        "спортивное общество"
                    ],
                    "target_lang_definitions": {
                        "en": "A voluntary union of people for a common goal (scientific, charitable, sports, etc.).",
                        "zh": "为共同目标（科学、慈善、体育等）而自愿组成的团体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "society",
                                "target_lang_sense_clarification": "organization"
                            },
                            {
                                "target_lang_word": "association",
                                "target_lang_sense_clarification": "organization"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "协会",
                                "target_lang_sense_clarification": "组织"
                            },
                            {
                                "target_lang_word": "学会",
                                "target_lang_sense_clarification": "学术组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b18889f4-6c05-316e-a3e2-afc8af3cf902",
                    "sense_definition": "Группа людей, проводящих время вместе; чьё-либо присутствие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне всегда приятно находиться в вашем <w>обществе</w>.",
                            "target_lang_translations": {
                                "en": "It is always pleasant for me to be in your <w>company</w>.",
                                "zh": "能有您的<w>陪伴</w>我总是感到很愉快。"
                            }
                        },
                        {
                            "text": "Он избегал шумного <w>общества</w> и предпочитал тишину.",
                            "target_lang_translations": {
                                "en": "He avoided noisy <w>company</w> and preferred silence.",
                                "zh": "他避开喧闹的<w>交际</w>，更喜欢安静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "компания"
                    ],
                    "antonyms": [
                        "одиночество"
                    ],
                    "common_phrases": [
                        "в обществе друзей",
                        "приятное общество",
                        "дамское общество"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of people spending time together; someone's presence.",
                        "zh": "在一起消磨时间的一群人；某人的在场。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "company",
                                "target_lang_sense_clarification": "presence of others"
                            },
                            {
                                "target_lang_word": "circle",
                                "target_lang_sense_clarification": "group of acquaintances"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陪伴",
                                "target_lang_sense_clarification": "在场"
                            },
                            {
                                "target_lang_word": "交际",
                                "target_lang_sense_clarification": "社交圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecd82ee4-2738-39e6-8529-fdd20e9a8462",
                    "sense_definition": "Коммерческое предприятие, фирма (обычно в официальных названиях организационно-правовых форм).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Акционерное <w>общество</w> объявило о выплате дивидендов.",
                            "target_lang_translations": {
                                "en": "The joint-stock <w>company</w> announced the payment of dividends.",
                                "zh": "这家股份<w>公司</w>宣布了股息支付。"
                            }
                        },
                        {
                            "text": "Это страховое <w>общество</w> работает на рынке уже десять лет.",
                            "target_lang_translations": {
                                "en": "This insurance <w>company</w> has been working on the market for ten years.",
                                "zh": "这家保险<w>公司</w>已经在市场上经营了十年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "фирма",
                        "предприятие",
                        "компания",
                        "товарищество"
                    ],
                    "common_phrases": [
                        "акционерное общество",
                        "страховое общество"
                    ],
                    "target_lang_definitions": {
                        "en": "A commercial enterprise or firm (usually in official names of legal forms).",
                        "zh": "商业企业或公司（通常用于法律形式的正式名称中）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "company",
                                "target_lang_sense_clarification": "business entity"
                            },
                            {
                                "target_lang_word": "corporation",
                                "target_lang_sense_clarification": "business entity"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公司",
                                "target_lang_sense_clarification": "商业实体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca107770-90e2-3bd9-871f-8220c0412f0f",
                    "sense_definition": "Школьный предмет, изучающий развитие человеческого общества (сокращение от «обществознание»).",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "group_subject",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завтра у нас контрольная работа по <w>обществу</w>.",
                            "target_lang_translations": {
                                "en": "Tomorrow we have a test in <w>social studies</w>.",
                                "zh": "明天我们要进行<w>社会课</w>测验。"
                            }
                        },
                        {
                            "text": "Я не успел сделать домашнее задание по <w>обществу</w>.",
                            "target_lang_translations": {
                                "en": "I didn't have time to do my <w>social studies</w> homework.",
                                "zh": "我没来得及做<w>社会课</w>作业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "обществознание"
                    ],
                    "common_phrases": [
                        "урок общества",
                        "учебник по обществу"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "school slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A school subject studying the development of human society (short for 'social studies').",
                        "zh": "研究人类社会发展的学校科目（“社会科学”的口语缩写）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "social studies",
                                "target_lang_sense_clarification": "school subject"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社会课",
                                "target_lang_sense_clarification": "学校科目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "342d9917-fc5d-3d59-a531-5cadeb7ee77f",
                    "sense_definition": "Узкий круг избранных людей, обычно аристократия или элита.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_people_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодую актрису тепло приняли в высшее <w>общество</w>.",
                            "target_lang_translations": {
                                "en": "The young actress was warmly received into high <w>society</w>.",
                                "zh": "这位年轻的女演员受到了<w>上流社会</w>的热烈欢迎。"
                            }
                        },
                        {
                            "text": "В этом <w>обществе</w> существуют строгие правила этикета.",
                            "target_lang_translations": {
                                "en": "Strict rules of etiquette exist in this <w>society</w>.",
                                "zh": "在这个<w>上流社会</w>里存在着严格的礼仪规则。"
                            }
                        }
                    ],
                    "synonyms": [
                        "класс"
                    ],
                    "common_phrases": [
                        "высшее общество",
                        "светское общество"
                    ],
                    "target_lang_definitions": {
                        "en": "A narrow circle of chosen people, usually aristocracy or elite.",
                        "zh": "一小群被选中的人，通常指贵族或精英阶层。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "society",
                                "target_lang_sense_clarification": "high society"
                            },
                            {
                                "target_lang_word": "high society",
                                "target_lang_sense_clarification": "elite"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上流社会",
                                "target_lang_sense_clarification": "精英阶层"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}