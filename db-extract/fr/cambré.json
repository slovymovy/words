                "senses": [
                    {
                        "sense_id": "6644a018-51da-3fa8-b0e7-5307ca6afa2c",
                        "entry_id": "cd178d96-8523-352b-9ea9-454331934237",
                        "glosses": [
                            "Qui présente une cambrure, en parlant d'une partie du corps humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099655eb-3729-474f-80af-2bf3ddfd5ad8",
                                "sense_id": "6644a018-51da-3fa8-b0e7-5307ca6afa2c",
                                "text": "Une taille cambrée, taille qui présente une concavité en arrière."
                            },
                            {
                                "example_id": "12e01b9f-ea50-4be4-a995-bc21f1de685a",
                                "sense_id": "6644a018-51da-3fa8-b0e7-5307ca6afa2c",
                                "text": "Jambes cambrées, celles dont la courbure naturelle est exagérée, de sorte que les genoux sont distants l’un de l’autre quand les talons se touchent."
                            },
                            {
                                "example_id": "38bab771-35d6-4f07-8e2e-26a2c620d19a",
                                "sense_id": "6644a018-51da-3fa8-b0e7-5307ca6afa2c",
                                "text": "On dit dans le même sens qu’un homme est cambré."
                            },
                            {
                                "example_id": "aa2997d6-eed7-442c-aa70-313e2fb5ad65",
                                "sense_id": "6644a018-51da-3fa8-b0e7-5307ca6afa2c",
                                "text": "Cambrée à outrance, comme elle l’était pour accrocher son chapeau à cette patère placée très haut, elle déployait la taille superbe d’une danseuse qui se renverse, et cette taille était prise (c’est le mot, tant elle était lacée !) dans le corselet luisant d’un spencer de soie verte à franges qui retombaient sur sa robe blanche, une de ces robes du temps d’alors, qui serraient aux hanches et qui n’avaient pas peur de les montrer, quand on en avait…"
                            }
                        ]
                    }
