                            {
                                "example_id": "9751a64e-d3ff-41c5-8693-4572b6bc0227",
                                "sense_id": "a03272b1-0b58-3d3a-86f6-c88e100c3c94",
                                "text": "Die Köchin lobte ihr fleißiges Lehrmädchen."
                            },
                            {
