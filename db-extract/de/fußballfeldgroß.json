                "senses": [
                    {
                        "sense_id": "c238616c-cecb-3813-8fb6-8f314a533b5c",
                        "entry_id": "b1b99dee-b30c-3101-b3db-5898ee79d742",
                        "glosses": [
                            "die Ausmaße eines Fußballfeldes habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a64065-135b-4eb0-9063-c1709050f976",
                                "sense_id": "c238616c-cecb-3813-8fb6-8f314a533b5c",
                                "text": "„Der Schatz der argentinischen Puna liegt in fußballfeldgroßen Wasserbecken.“"
                            },
                            {
                                "example_id": "1a41ddc7-7a55-4551-bc62-6281459b3f6f",
                                "sense_id": "c238616c-cecb-3813-8fb6-8f314a533b5c",
                                "text": "„Derzeit bauen die Japaner in Yokohama einen ‚Erdsimulator‘, eine fußballfeldgroße Anlage für eine halbe Milliarde Dollar, die etwa 100-mal leistungsfähiger ist als unsere Maschinen in Europa.“"
                            },
                            {
                                "example_id": "635d0aa5-211f-4fb7-b187-9172cbea6dea",
                                "sense_id": "c238616c-cecb-3813-8fb6-8f314a533b5c",
                                "text": "„Vergangenen Dienstag explodierte die Plattform, die dem Spezialunternehmen Transocean gehört. Zwei Tage später versank die mehr als fußballfeldgroße Konstruktion komplett.“"
                            }
                        ],
