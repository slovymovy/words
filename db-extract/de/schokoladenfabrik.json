                        "sense_id": "404888e0-e0e9-3ae3-abad-4224c8ffb769",
                        "entry_id": "eb33c66d-93d6-3940-90e2-62ea33fab676",
                        "glosses": [
                            "Industriebetrieb, in dem aus Kakaobohnen und anderen Zutaten ein bestimmtes Genussmittel hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318a6d28-3d0d-4c29-a6e8-9b0b74f21ba4",
                                "sense_id": "404888e0-e0e9-3ae3-abad-4224c8ffb769",
                                "text": "„Der schweizerische Nahrungsmittelkonzern Nestlé fusioniert mit den renommierten Schokoladenfabriken Peter Kohler und Cailler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
