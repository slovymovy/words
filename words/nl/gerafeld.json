            "senses": [
                {
                    "sense_id": "09265638-604d-3bc3-a941-a76ce1ba9a4b",
                    "sense_definition": "voltooid deelwoord van <w>rafelen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stof is na veelvuldig wassen helemaal <w>gerafeld</w>.",
                            "target_lang_translations": {
                                "pl": "Tkanina po wielokrotnym praniu zupełnie się <w>postrzępiła</w>."
                            }
                        },
                        {
                            "text": "Het touw heeft te veel langs de scherpe steen geschuurd en is <w>gerafeld</w>.",
                            "target_lang_translations": {
                                "pl": "Lina za mocno ocierała o ostry kamień i się <w>wystrzępiła</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
