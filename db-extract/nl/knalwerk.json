                    {
                        "sense_id": "829e4e9d-a429-3cf7-89f6-e32b153fda29",
                        "entry_id": "10ddac29-601b-3d41-9964-bca16de9fe12",
                        "glosses": [
                            "vuurwerk dat vooral een harde knal geeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ffe34e-048c-4c42-be54-c0a1fbc9ac41",
                                "sense_id": "829e4e9d-a429-3cf7-89f6-e32b153fda29",
                                "text": "Een aanzienlijk deel van de gevonden partij valt in de zwaarste categorie verboden knalwerk, zo meldde een woordvoerder vrijdag."
                            },
                            {
                                "example_id": "65d1b42b-ca2d-45fd-9dfd-55fb630400fc",
                                "sense_id": "829e4e9d-a429-3cf7-89f6-e32b153fda29",
                                "text": "Politie en justitie jagen volgens een woordvoerder intensief op illegaal vuurwerk, omdat daarmee ernstige ongelukken kunnen gebeuren. Vorig jaar raakten ruim 200 mensen ernstig gewond door illegale knallers. Bezit van illegaal knalwerk is een misdrijf."
                            },
                            {
                                "example_id": "a3930ad1-43c3-4203-bf02-d8eb2450c045",
                                "sense_id": "829e4e9d-a429-3cf7-89f6-e32b153fda29",
                                "text": "De hoeveelheid in beslag genomen vuurwerk steeg mondjesmaat tot aan het begin van december, maar sindsdien wordt er meer voornamelijk illegaal knalwerk ingenomen door politie, VROM-inspectie en het OM."
                            }
                        ]
                    }
