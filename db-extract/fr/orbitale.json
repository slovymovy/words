                                        "sense_id": "7dae845e-840a-3e48-b16c-13a6265cc1b4",
                                        "entry_id": "227156c7-892f-3f32-84eb-afc5874a357d",
                                        "glosses": [
                                            "Ellipsis of orbital motorway."
