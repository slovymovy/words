            "senses": [
                {
                    "sense_id": "fae90546-9149-3c72-bdc8-c87ad430b2f0",
                    "sense_definition": "Chanter à demi-voix, entre ses dents ou la bouche fermée, sans articuler nettement les paroles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En préparant le dîner, elle <w>fredonne</w> souvent un air joyeux qu'elle a entendu à la radio."
                        },
                        {
                            "text": "Il marchait tranquillement dans la rue tout en <w>fredonnant</w> une chanson entraînante."
                        }
                    ],
                    "synonyms": [
                        "chantonner"
                    ],
                    "common_phrases": [
                        "fredonner un air",
                        "fredonner une chanson"
                    ]
                },
                {
                    "sense_id": "b30af282-d442-399f-a2fe-a36c0a90ef19",
                    "sense_definition": "Faire des ornements vocaux rapides ou des fioritures musicales appelés fredons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soliste <w>fredonnait</w> avec agilité sur les fins de phrases pour enrichir son interprétation baroque."
                        },
                        {
                            "text": "Le maître de chant apprenait à ses élèves à <w>fredonner</w> avec légèreté sur les cadences finales."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme de musique vocale ancienne"
                        }
                    ]
                },
                {
                    "sense_id": "5a3bf3b4-800d-3a66-b841-6d31a15e0875",
                    "sense_definition": "Pousser son cri ou chanter de manière douce et légère, en parlant de la fauvette.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tôt le matin, une fauvette <w>fredonne</w> discrètement au milieu des buissons fleuris."
                        },
                        {
                            "text": "On pouvait entendre le petit oiseau qui <w>fredonnait</w> au sommet de la haie printanière."
