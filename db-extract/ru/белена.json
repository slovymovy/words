                            {
                                "example_id": "524e2cce-98e2-4854-8fd5-95c1e3853d8e",
                                "sense_id": "0d9b1be3-ed45-3dc9-ae3e-3d9b35cf09d4",
                                "text": "белены́ объе́лся?",
                                "translation": "are you crazy?",
                                "english": "are you crazy?"
                            },
                            {
                                "example_id": "90b84db7-73a5-4e3e-9bd6-a83df53c97b1",
                                "sense_id": "0d9b1be3-ed45-3dc9-ae3e-3d9b35cf09d4",
                                "text": "Ру́тилов наклони́лся, оторва́л шерсти́стый сте́бель белены́, ско́мкал его́ вме́сте с ли́стьями и гря́зно-бе́лыми цвета́ми и, растира́я всё э́то па́льцами, поднёс к но́су Передо́нова.",
                                "translation": "Routilov bent down, broke off a fleecy stalk of henbane, crumpled it up in his hand, together with the leaves and dirty white flowers, and crushing it all between his fingers, put it under Peredonov's nose.",
                                "english": "Routilov bent down, broke off a fleecy stalk of henbane, crumpled it up in his hand, together with the leaves and dirty white flowers, and crushing it all between his fingers, put it under Peredonov's nose."
                            }
                        ]
                    }
