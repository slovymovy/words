    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd17ee69-797e-3a3d-8165-96b51966c42f",
                    "sense_definition": "przestawać być całym na skutek powstania rysy, szczeliny lub otworu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pod wpływem mrozu rura w piwnicy <w>pękła</w>.",
                            "target_lang_translations": {
                                "ru": "Под воздействием мороза труба в подвале <w>лопнула</w>."
                            }
                        },
                        {
                            "text": "Szklanka <w>pęka</w>, gdy wlejesz do niej wrzątek.",
                            "target_lang_translations": {
                                "ru": "Стакан <w>трескается</w>, если налить в него кипяток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pękać w szwach"
                    ],
                    "target_lang_definitions": {
                        "ru": "переставать быть целым из-за появления трещины, щели или отверстия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трескаться",
                                "target_lang_sense_clarification": "о твердых предметах, покрывающихся трещинами"
                            },
                            {
                                "target_lang_word": "лопаться",
                                "target_lang_sense_clarification": "о хрупких предметах, которые разбиваются или трескаются"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa1be739-8a4a-327d-aaea-ef8540e3e77e",
                    "sense_definition": "o czymś naciągniętym lub napiętym: rozrywać się na części",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spodnie były tak ciasne, że <w>pękały</w> w pasie.",
                            "target_lang_translations": {
                                "ru": "Брюки были такими тесными, что <w>рвались</w> по швам."
                            }
                        },
                        {
                            "text": "Balon <w>pęka</w> pod wpływem zbyt dużego ciśnienia powietrza.",
                            "target_lang_translations": {
                                "ru": "Воздушный шар <w>лопается</w> под воздействием слишком высокого давления воздуха."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "о чем-то натянутом или напряженном: разрываться на части"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопаться",
                                "target_lang_sense_clarification": "о надутых или натянутых предметах (шар, ткань)"
                            },
                            {
                                "target_lang_word": "рваться",
                                "target_lang_sense_clarification": "о ткани или материале под давлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad5d330-db31-3490-8289-029eb36951b5",
                    "sense_definition": "odczuwać strach lub niepokój",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie <w>pękaj</w>, poradzimy sobie z tym zadaniem.",
                            "target_lang_translations": {
                                "ru": "Не <w>трусь</w>, мы справимся с этим заданием."
                            }
                        },
                        {
                            "text": "Kiedy zobaczył policję, zaczął <w>pękać</w>.",
                            "target_lang_translations": {
                                "ru": "Когда он увидел полицию, он начал <w>трусить</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать страх или беспокойство"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трусить",
                                "target_lang_sense_clarification": "разговорное, проявлять трусость"
                            },
                            {
                                "target_lang_word": "бояться",
                                "target_lang_sense_clarification": "испытывать страх"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}