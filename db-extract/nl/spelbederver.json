                ],
                "senses": [
                    {
                        "sense_id": "4f4834fa-6cbc-3f42-b2c2-ff4eba8b2823",
                        "entry_id": "3e9cb4a6-da53-3f00-b5f9-5f7103e83131",
                        "glosses": [
                            "een onsportieve sporter die ervoor zorgt dat het spel niet meer leuk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61861737-9a95-40b7-b725-543809b38799",
                                "sense_id": "4f4834fa-6cbc-3f42-b2c2-ff4eba8b2823",
                                "text": "Ons land behoort tot de oprichters van de unie maar heeft nu het imago van 'spelbederver'. In 2005 verwierp Nederland ook al de Europese grondwet, herinnert de krant haar lezers."
                            },
                            {
                                "example_id": "ab957844-9ff3-4ae8-99e4-690f906fc8e5",
                                "sense_id": "4f4834fa-6cbc-3f42-b2c2-ff4eba8b2823",
                                "text": "In de internationale euforie rondom de democratische hervormingen riskeren zij het te worden weggezet als spelbedervers. Juist nu is het echter belangrijk om verschillende geluiden over Myanmars vooruitgang te laten horen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed10dcb1-b3ae-4906-a4ac-02d43d947768",
                        "source_entry_id": "3e9cb4a6-da53-3f00-b5f9-5f7103e83131",
                        "source_sense_id": "4f4834fa-6cbc-3f42-b2c2-ff4eba8b2823",
                        "target_lang_word": "spoilsport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoilsport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                        "entry_id": "e74eeec6-7fc9-35b4-8340-a3abf6ccc16e",
                                        "glosses": [
                                            "Someone who puts an end to others' fun, especially harmless fun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff96a45-3c60-42c7-984e-76d918f931de",
                                                "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                                "text": "I know I am a sad spoilsport, but it would make me wretched."
                                            },
                                            {
                                                "example_id": "1bfd4711-224c-4fa2-9b43-b2d1fc5a3e78",
                                                "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                                "text": "He looks a spoilsport. There are men in whose presence it is impossible to have any fun: men who are a sort of walking conscience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spoilsport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79922354-9271-35ed-bc2f-f85f2d67a8c3",
                                        "entry_id": "8546e938-6784-36d5-9635-8fdabfb829f3",
                                        "glosses": [
                                            "Like a spoilsport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec26bf3-4914-435d-a907-5ceb71439328",
                                                "sense_id": "79922354-9271-35ed-bc2f-f85f2d67a8c3",
                                                "text": "It may seem somewhat spoilsport to focus in on this negative after another important victory but to ignore it would be delusion. Southgate will not be letting it escape his attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
