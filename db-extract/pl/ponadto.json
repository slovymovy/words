                        ]
                    },
                    {
                        "translation_id": "1cd84e07-3def-4d74-bb6d-4d4bc235a9ba",
                        "source_entry_id": "bc0c802d-9fd7-3fc1-be25-40c3bf1968b5",
                        "source_sense_id": "21726323-26f2-35bd-aee1-7f1a44024f19",
                        "target_lang_word": "en plus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb5d499-75c9-31e1-af97-4bf8a57e18fd",
                                        "entry_id": "9f3bff8e-c30c-3438-801e-d14a5fd74b9f",
                                        "glosses": [
                                            "De plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "facbaa60-cba4-443e-abe2-0484c6ac5a13",
                                                "sense_id": "2eb5d499-75c9-31e1-af97-4bf8a57e18fd",
                                                "text": "Va donc faire des gnards avec une chic fille. Tu promets de m'en faire un en plus, rien que pour moi qui peux plus en avoir ?"
                                            },
                                            {
                                                "example_id": "d0aae774-4396-4d1b-b83a-c00d8f01f6d0",
                                                "sense_id": "2eb5d499-75c9-31e1-af97-4bf8a57e18fd",
                                                "text": "Dans le centre-ville, elle est heureuse comme un poisson dans l'eau. Elle a son petit atelier, un beau salon, une chambre et une minuscule cuisine qui lui suffit pour elle toute seule. En plus, elle est à deux pas du théâtre et de tous les cinémas, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c3a3faa-43fb-4733-b4e7-90bb89255ab7",
                        "source_entry_id": "bc0c802d-9fd7-3fc1-be25-40c3bf1968b5",
                        "source_sense_id": "21726323-26f2-35bd-aee1-7f1a44024f19",
                        "target_lang_word": "de plus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abd4ac19-26c9-38f6-bdf9-6869ea86545a",
                                        "entry_id": "24713880-07a2-313e-9c3e-ea286520e311",
                                        "glosses": [
                                            "En outre, qui plus est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c23fa4-3195-4c8c-a4c3-290baca1418c",
                                                "sense_id": "abd4ac19-26c9-38f6-bdf9-6869ea86545a",
                                                "text": "Cette corne est très-recherchée pour la fabrication des peignes, parce qu’elle est douce et facile à travailler, et est de plus d’une extrême blancheur à l’intérieur."
                                            },
                                            {
                                                "example_id": "7519f5ac-837c-4a4f-a2d8-f25eafe523d8",
                                                "sense_id": "abd4ac19-26c9-38f6-bdf9-6869ea86545a",
                                                "text": "Ils sont, de plus, obligés de fournir aux troupes qui passent dans le voisinage de leurs douars, le blé, le beurre, le miel et la viande."
                                            },
                                            {
                                                "example_id": "85dd601a-822f-4d72-8320-50e113c4011a",
                                                "sense_id": "abd4ac19-26c9-38f6-bdf9-6869ea86545a",
                                                "text": "“De plus, il est important de noter que la réunion a été avancée d’une heure.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edd506bf-2eb6-3bed-a980-a25d25da5608",
                                        "entry_id": "24713880-07a2-313e-9c3e-ea286520e311",
                                        "glosses": [
                                            "En excédent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536ba8eb-c2bd-4ca3-a699-eaee56630ba2",
                                                "sense_id": "edd506bf-2eb6-3bed-a980-a25d25da5608",
                                                "text": "Il a eu mille francs de plus à payer qu’il ne pensait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e423808f-e2fb-44db-af49-b533eebdf25e",
                        "source_entry_id": "bc0c802d-9fd7-3fc1-be25-40c3bf1968b5",
                        "source_sense_id": "21726323-26f2-35bd-aee1-7f1a44024f19",
                        "target_lang_word": "кроме того",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кроме того",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "627eb3e1-ff30-3033-b7c9-9adb6a491832",
                                        "entry_id": "44b69b35-28df-3d7f-8024-fe01eb4bb44b",
                                        "glosses": [
                                            "к тому же, вдобавок, сверх того"
                                        ],
                                        "tags": [
                                            "вводит фразу, дополняющую ранее упомянутое обстоятельство"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d101ac0d-ea31-4d6e-9a55-99281fdfb37b",
                                                "sense_id": "627eb3e1-ff30-3033-b7c9-9adb6a491832",
                                                "text": "Кроме того, чувствовалось счастье, что новый день уподобится вчерашнему и оттого терзаний жизни не причинит."
                                            },
                                            {
                                                "example_id": "7a1028b1-facf-4620-badd-e6b9cdebda41",
                                                "sense_id": "627eb3e1-ff30-3033-b7c9-9adb6a491832",
                                                "text": "Чиклин снял с себя всю верхнюю одежду, кроме того отобрал ватные пиджаки у Жачева и активиста и всем этим тёплым веществом закутал Настю."
                                            },
                                            {
                                                "example_id": "04dd7d5a-a2aa-49b4-8175-3c33e87b5c66",
                                                "sense_id": "627eb3e1-ff30-3033-b7c9-9adb6a491832",
                                                "text": "Кроме того, невыясненные звонили по казенным телефонам между собой, играли в шашки с ночными сторожами, читали от скорби архивы и писали письма родственникам на бланках отношений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e1a071-abca-3ebe-9aed-285e07011cc5",
                                        "entry_id": "44b69b35-28df-3d7f-8024-fe01eb4bb44b",
                                        "glosses": [
                                            "за исключением, сверх чего-либо, вдобавок к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9af1a44-9fad-4f48-8656-3680e1d6aa2f",
                                                "sense_id": "80e1a071-abca-3ebe-9aed-285e07011cc5",
                                                "text": "Однако она пошла, не взяв ничего с собою из жилища, кроме того, что ей дал сын, ― и то потому, что эти вещи находились у нее в руках."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91a1a539-fdfb-4e20-8560-ad8dc10e181a",
                        "source_entry_id": "bc0c802d-9fd7-3fc1-be25-40c3bf1968b5",
