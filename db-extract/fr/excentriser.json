                ],
                "senses": [
                    {
                        "sense_id": "71d08ecd-1484-3bde-9492-db37ec891755",
                        "entry_id": "f5edb6d9-ed95-30ab-9934-54efe5c8c27d",
                        "glosses": [
                            "Rendre excentrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69564e48-cebb-4bd9-b18b-2c09ecb073be",
                                "sense_id": "71d08ecd-1484-3bde-9492-db37ec891755",
                                "text": "Je peux aussi excentriser le cylindre sur le côté de la sortie d’eau, pour faciliter une plus grande aspiration, chose très-importante pour le perfectionnement du système de la pompe."
                            },
                            {
                                "example_id": "8b234f8e-7831-48c2-a2c9-0077bc357294",
                                "sense_id": "71d08ecd-1484-3bde-9492-db37ec891755",
                                "text": "Cette rondelle est mise en mouvement par d’autres, combinées entr’elles de manière à excentriser les mouvements excentriques du cœur même."
                            },
                            {
                                "example_id": "486d2d23-587d-48de-bec8-a935e9dd7cc5",
                                "sense_id": "71d08ecd-1484-3bde-9492-db37ec891755",
                                "text": "il le fait en vertu de la tendance à se distinguer, à s’excentriser, qui s’accuse déjà chez Rousseau comme une directive principale de la philosophie romantique."
                            }
                        ]
                    }
