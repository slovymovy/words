                        "examples": [
                            {
                                "example_id": "9b5b5994-b4c3-4fbc-934a-786f531d531f",
                                "sense_id": "f0144b4f-3728-37e1-9bbf-4c46e16d4add",
                                "text": "„Selbstverständlich geleitete sie am nächsten Tage den alten Schelm schon in aller Morgenfrühe durch das Hauptportal nach den inneren Gemächern.“"
                            },
                            {
                                "example_id": "e98c3a57-3bac-4652-84bc-a1d5a6818ccf",
                                "sense_id": "f0144b4f-3728-37e1-9bbf-4c46e16d4add",
                                "text": "„Es dunkelte bereits, als Fürst Andrej und Pierre am Hauptportal des Herrenhauses von Lysyja Gory vorfuhren.“"
                            }
                        ],
