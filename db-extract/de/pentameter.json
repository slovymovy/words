                    {
                        "sense_id": "96cdec1d-717a-3814-be45-db597be69b54",
                        "entry_id": "ea7bb524-6ec3-3a7e-a26a-8f777aed4f42",
                        "glosses": [
                            "antiker, in der Regel daktylischer Vers mit insgesamt sechs Hebungen, der aus zwei metrisch gleichen Kola ( – ⏑ ⏑ – ⏑ ⏑ – | – ⏑ ⏑ – ⏑ ⏑ – ) besteht, wobei nur die ersten zwei Daktylen durch Spondeen ersetzt werden dürfen"
                        ],
                        "tags": [
                            "Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "7784f4e6-eadd-453f-8bc6-0b818545b99e",
                                "sense_id": "96cdec1d-717a-3814-be45-db597be69b54",
                                "text": "Ein elegisches Distichon besteht aus einem Hexameter und einem Pentameter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
