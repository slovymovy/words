                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "237162f8-a9d2-4de6-8dfd-dc5521899478",
                                "sense_id": "6b026aef-1085-3e40-93eb-7d8ebd4f0103",
                                "text": "Alleen in landen tussen beide keerkringen staat de zon soms in het zenit."
                            }
                        ]
                    },
                    {
                        "sense_id": "946ee615-e3d3-3bea-8dd4-0066cd358345",
                        "entry_id": "dcd94ce2-db3c-34c6-9865-53d17945ac58",
