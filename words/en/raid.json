{
    "word_family": [
        "raider"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                    "sense_definition": "A sudden unexpected visit by the police or other authorities to search a place, seize property, or make arrests.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police conducted a dawn <w>raid</w> on the suspected criminal hideout.",
                            "target_lang_translations": {
                                "ru": "Полиция провела <w>рейд</w> на рассвете в предполагаемом убежище преступников.",
                                "zh": "警方在黎明时分对犯罪嫌疑人的藏身处进行了<w>突击搜查</w>。"
                            }
                        },
                        {
                            "text": "Officers arrested five people during the drug <w>raid</w>.",
                            "target_lang_translations": {
                                "ru": "Офицеры арестовали пять человек во время <w>рейда</w> по борьбе с наркотиками.",
                                "zh": "警官在这次缉毒<w>突袭</w>中逮捕了五个人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "police raid",
                        "dawn raid",
                        "drug raid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный визит полиции или властей для обыска помещения, изъятия имущества или проведения арестов.",
                        "zh": "警方或其他执法部门突然造访某地，进行搜查、扣押财物或实施逮捕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облава",
                                "target_lang_sense_clarification": "операция по поимке преступников"
                            },
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "внезапная проверка"
                            },
                            {
                                "target_lang_word": "налёт",
                                "target_lang_sense_clarification": "внезапное силовое вторжение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突击搜查",
                                "target_lang_sense_clarification": "警方行动"
                            },
                            {
                                "target_lang_word": "突袭",
                                "target_lang_sense_clarification": "突然的行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                    "sense_definition": "A quick surprise attack or invasion, usually by a small military force, intended to cause damage or steal something rather than to occupy territory.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers launched a surprise <w>raid</w> on the enemy camp.",
                            "target_lang_translations": {
                                "ru": "Солдаты совершили внезапный <w>налёт</w> на вражеский лагерь.",
                                "zh": "士兵们对敌军营地发动了突然<w>袭击</w>。"
                            }
                        },
                        {
                            "text": "Civilians rushed to the shelters when the air <w>raid</w> siren sounded.",
                            "target_lang_translations": {
                                "ru": "Мирные жители бросились в убежища, когда зазвучала сирена о воздушном <w>налёте</w>.",
                                "zh": "当<w>空袭</w>警报响起时，平民们纷纷冲向避难所。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "incursion",
                        "foray"
                    ],
                    "common_phrases": [
                        "air raid",
                        "bombing raid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое внезапное нападение или вторжение, обычно небольшими силами, с целью нанесения ущерба или захвата трофеев, а не оккупации территории.",
                        "zh": "通常由小规模军事力量发起的快速突袭或入侵，旨在破坏或掠夺，而非占领领土。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налёт",
                                "target_lang_sense_clarification": "внезапная атака, часто с воздуха"
                            },
                            {
                                "target_lang_word": "набег",
                                "target_lang_sense_clarification": "вторжение с целью грабежа"
                            },
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "военная операция в тылу врага"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突袭",
                                "target_lang_sense_clarification": "军事行动"
                            },
                            {
                                "target_lang_word": "袭击",
                                "target_lang_sense_clarification": "攻击行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71c84ab9-8871-3f8c-b42c-3d8bf694b38b",
                    "sense_definition": "A mission in a video game where a large group of players work together to defeat a powerful enemy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our guild is organizing a <w>raid</w> to defeat the final boss tonight.",
                            "target_lang_translations": {
                                "ru": "Наша гильдия организует <w>рейд</w>, чтобы победить финального босса сегодня вечером.",
                                "zh": "我们的公会今晚正在组织一次<w>副本</w>挑战，以击败最终BOSS。"
                            }
                        },
                        {
                            "text": "You need high-level gear to participate in this <w>raid</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно снаряжение высокого уровня, чтобы участвовать в этом <w>рейде</w>.",
                                "zh": "你需要高级装备才能参加这个<w>团本</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "video games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Миссия в видеоигре, где большая группа игроков объединяется для победы над сильным противником.",
                        "zh": "电子游戏中，由一大群玩家协作以击败强大敌人的任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "игровой термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副本",
                                "target_lang_sense_clarification": "游戏术语"
                            },
                            {
                                "target_lang_word": "团本",
                                "target_lang_sense_clarification": "大型团队副本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                    "sense_definition": "An action on a live streaming platform where a broadcaster sends their viewers to another channel at the end of their stream.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The streamer ended the broadcast with a <w>raid</w> on a smaller channel.",
                            "target_lang_translations": {
                                "ru": "Стример закончил трансляцию <w>рейдом</w> на канал поменьше.",
                                "zh": "主播在直播结束时对一个小频道进行了<w>查房</w>。"
                            }
                        },
                        {
                            "text": "We received a huge <w>raid</w> of viewers from a popular gamer.",
                            "target_lang_translations": {
                                "ru": "Мы получили огромный <w>рейд</w> зрителей от популярного геймера.",
                                "zh": "我们收到了来自一位人气游戏主播带来的大量<w>查房</w>观众。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие на стриминговой платформе, когда ведущий перенаправляет своих зрителей на другой канал в конце трансляции.",
                        "zh": "直播平台上的行为，指主播在直播结束时将观众引导至另一个频道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "сленг стримеров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "查房",
                                "target_lang_sense_clarification": "直播术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5751eb3d-44e4-3d93-a9e2-5d7812897c15",
                    "sense_definition": "A quick attacking movement into the opponent's territory in sports.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winger made a quick <w>raid</w> down the right flank.",
                            "target_lang_translations": {
                                "ru": "Вингер совершил быстрый <w>рейд</w> по правому флангу.",
                                "zh": "边锋沿着右路进行了一次快速<w>突击</w>。"
                            }
                        },
                        {
                            "text": "Their defense struggled to stop the constant <w>raids</w> by the opposing team.",
                            "target_lang_translations": {
                                "ru": "Их защита с трудом сдерживала постоянные <w>набеги</w> команды противника.",
                                "zh": "他们的防线难以阻挡对方球队不断的<w>突破</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attack"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое атакующее движение на территорию соперника в спорте.",
                        "zh": "体育运动中，快速冲入对方阵地的进攻动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейд",
                                "target_lang_sense_clarification": "индивидуальный проход"
                            },
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "атакующее движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突击",
                                "target_lang_sense_clarification": "进攻动作"
                            },
                            {
                                "target_lang_word": "突破",
                                "target_lang_sense_clarification": "个人进攻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75930ce3-ec30-3ccb-87e1-e0a4e366449d",
                    "sense_definition": "A method of storing the same data on multiple hard disks to improve performance or reliability (Redundant Array of Independent Disks).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We configured the server with <w>RAID</w> 5 to prevent data loss.",
                            "target_lang_translations": {
                                "ru": "Мы настроили сервер с <w>RAID</w> 5, чтобы предотвратить потерю данных.",
                                "zh": "我们配置了RAID 5<w>磁盘阵列</w>以防止数据丢失。"
                            }
                        },
                        {
                            "text": "The technician replaced a failed drive in the <w>RAID</w> array.",
                            "target_lang_translations": {
                                "ru": "Техник заменил неисправный диск в <w>RAID</w>-массиве.",
                                "zh": "技术员更换了<w>磁盘阵列</w>中一块损坏的硬盘。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод хранения одних и тех же данных на нескольких жестких дисках для повышения производительности или надежности.",
                        "zh": "一种将相同数据存储在多个硬盘上以提高性能或可靠性的技术（独立磁盘冗余阵列）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "RAID-массив",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁盘阵列",
                                "target_lang_sense_clarification": "计算机术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                    "sense_definition": "To attack a place suddenly in order to cause damage, steal things, or make arrests.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>raided</w> the house looking for evidence.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>нагрянула</w> в дом в поисках улик.",
                                "zh": "警方<w>突击搜查</w>了那所房子以寻找证据。"
                            }
                        },
                        {
                            "text": "Bandits used to <w>raid</w> the village for food and supplies.",
                            "target_lang_translations": {
                                "ru": "Бандиты раньше <w>совершали набеги</w> на деревню ради еды и припасов.",
                                "zh": "强盗过去常<w>袭击</w>村庄以掠夺食物和补给。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attack"
                    ],
                    "common_phrases": [
                        "raid a village",
                        "raid a house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно нападать на место с целью нанесения ущерба, кражи или ареста.",
                        "zh": "突然袭击某地以造成破坏、窃取财物或进行逮捕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать налёт",
                                "target_lang_sense_clarification": "атаковать"
                            },
                            {
                                "target_lang_word": "устраивать облаву",
                                "target_lang_sense_clarification": "о полиции"
                            },
                            {
                                "target_lang_word": "нагрянуть",
                                "target_lang_sense_clarification": "внезапно появиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突击搜查",
                                "target_lang_sense_clarification": "警方行动"
                            },
                            {
                                "target_lang_word": "突袭",
                                "target_lang_sense_clarification": "攻击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26ee00d4-79d4-31d6-bce8-eff2ad6f5a58",
                    "sense_definition": "To take food or supplies from a storage place, often secretly or greedily.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>raided</w> the fridge late at night for a snack.",
                            "target_lang_translations": {
                                "ru": "Я <w>совершил набег</w> на холодильник поздно ночью, чтобы перекусить.",
                                "zh": "我深夜<w>扫荡</w>了冰箱找零食吃。"
                            }
                        },
                        {
                            "text": "The hungry children <w>raided</w> the cookie jar after school.",
                            "target_lang_translations": {
                                "ru": "Голодные дети <w>опустошили</w> банку с печеньем после школы.",
                                "zh": "放学后，饥肠辘辘的孩子们<w>搜刮</w>了饼干罐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "raid the fridge",
                        "raid the pantry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать еду или припасы из места хранения, часто тайком или жадно.",
                        "zh": "从储藏处拿取食物或补给，通常是偷偷地或贪婪地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать набег",
                                "target_lang_sense_clarification": "шутливое использование"
                            },
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "съедать всё подчистую"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扫荡",
                                "target_lang_sense_clarification": "幽默用法"
                            },
                            {
                                "target_lang_word": "搜刮",
                                "target_lang_sense_clarification": "大量拿取"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d415cfe3-e8d2-300c-a52f-e04ed2ab2866",
                    "sense_definition": "To entice people to leave an organization or company to join another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>raided</w> its rival for top engineering talent.",
                            "target_lang_translations": {
                                "ru": "Компания <w>переманила</w> лучших инженеров у конкурента.",
                                "zh": "该公司从竞争对手那里<w>挖角</w>了顶尖的工程人才。"
                            }
                        },
                        {
                            "text": "They tried to <w>raid</w> our staff by offering higher salaries.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>переманить</w> наших сотрудников, предлагая более высокие зарплаты.",
                                "zh": "他们试图通过提供更高的薪水来<w>挖角</w>我们的员工。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переманивать людей из одной организации или компании в другую.",
                        "zh": "诱使人员离开原组织或公司加入另一方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переманивать",
                                "target_lang_sense_clarification": "сотрудников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖角",
                                "target_lang_sense_clarification": "商业术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}