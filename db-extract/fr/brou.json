            {
                "entry_id": "645246ce-7cee-328b-82d0-dcf90b0f3593",
                "word": "brou",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "afb824d2-736c-4eeb-bd52-25dbb21e70e5",
                        "entry_id": "645246ce-7cee-328b-82d0-dcf90b0f3593",
                        "tags": [
                            "plural"
                        ],
                        "form": "brous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c887bac-9a85-3b64-99f7-e652698e39be",
                        "entry_id": "645246ce-7cee-328b-82d0-dcf90b0f3593",
                        "glosses": [
                            "Enveloppe (constituée de l’épicarpe et du mésocarpe) verte et coriace qui recouvre les noix jusqu’à la récolte en automne et dont la sève, colorante, est employée pour divers usages de consommation et comme teinture, le brou de noix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d426e64c-1a0d-4c4d-ade3-6f0ef222e1a6",
                                "sense_id": "5c887bac-9a85-3b64-99f7-e652698e39be",
                                "text": "Des noix confites avec leur brou."
                            },
                            {
                                "example_id": "83943b83-0dec-4ef7-b539-19b6653d9c61",
                                "sense_id": "5c887bac-9a85-3b64-99f7-e652698e39be",
                                "text": "Ratafia de brou de noix, (liqueur faite avec cette écale et qui a des vertus stomachiques)."
                            },
                            {
                                "example_id": "91597f7a-30e6-4e80-9566-e60ecc32be04",
                                "sense_id": "5c887bac-9a85-3b64-99f7-e652698e39be",
                                "text": "L’autre a les mains brunies par le brou des noix qu'il vient de ramasser en Corrèze."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca4f7cbd-985a-48d3-8e50-d23e3ffd7d53",
                        "source_entry_id": "645246ce-7cee-328b-82d0-dcf90b0f3593",
                        "source_sense_id": "5c887bac-9a85-3b64-99f7-e652698e39be",
                        "target_lang_word": "husk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
