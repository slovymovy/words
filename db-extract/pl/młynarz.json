                    },
                    {
                        "translation_id": "7bff18cd-1a18-4a54-be73-0654185067a9",
                        "source_entry_id": "6f919dfd-1c64-3855-8a2a-3bc671e30a02",
                        "source_sense_id": "aeb85684-5b03-3ebb-8a44-19361bfffaa3",
                        "target_lang_word": "Müller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4411f60b-928f-33f9-88e6-73688892a8f3",
                                        "entry_id": "f7b0f102-4801-3b7e-9fb9-76be45b54d6e",
                                        "glosses": [
                                            "meist selbstständiger Handwerker, Gewerbetreibender, aber auch Arbeiter, der in einer Mühle das Getreide oder anderes Mahlgut, zum Beispiel ölhaltige Pflanzenteile ( Ölmüller), lagert, reinigt und mahlt; einer, der Mehl herstellt"
                                        ],
                                        "tags": [
                                            "siehe dazu"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d408b4c7-bbd0-44f4-9d2a-1cdb3c75ad55",
                                                "sense_id": "4411f60b-928f-33f9-88e6-73688892a8f3",
                                                "text": "„Das Wandern ist des Müllers Lust / Das Wandern / Das muss ein schlechter Müller sein / Dem niemals fiel das Wandern ein / Das Wandern / Das Wandern…“"
                                            },
                                            {
                                                "example_id": "464b4017-00ae-4fe4-b45a-3d342ca7257c",
                                                "sense_id": "4411f60b-928f-33f9-88e6-73688892a8f3",
                                                "text": "„Der Müller mahlt auf seiner Windmühle nicht nur Roggen und Weizen; er schrotet auch Hafer, stampft Buchweizen und bäckt vor allem im Haus unter der Mühle Brot.“"
                                            },
                                            {
                                                "example_id": "158d9fbc-a4d6-42aa-bb52-49a57ad45207",
                                                "sense_id": "4411f60b-928f-33f9-88e6-73688892a8f3",
                                                "text": "„Der Müller Bachmann war der einzige Freund dieser Art in seinem Leben.“"
                                            },
                                            {
                                                "example_id": "3c1e5f9f-4bdb-46af-a1b6-5f753e723cfa",
                                                "sense_id": "4411f60b-928f-33f9-88e6-73688892a8f3",
                                                "text": "„Das Öl kam vom Müller, der damit die Bucheckern bezahlte, die alle im Wald suchen gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Müller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                        "entry_id": "cebbc63c-8c70-3811-a50b-785e816a932e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname, unter Berücksichtigung von Mueller mit etwa 10,6 % Anteil und über 600.000 Namenträgern häufigster Familienname in Deutschland und der Schweiz. In Österreich ist es der vierthäufigste Nachname. Nach Angaben aus, welcher die Festnetz-Telefonanschlüsse analysiert hat, sind es in Deutschland etwa 270.000 (9,5 ‰), in Österreich etwa 10.500 und in der Schweiz etwa 35.400"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f7ff252-ced9-431e-9d89-4dcd9aef2593",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Frau Müller ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "eaf00c31-8955-488f-902f-18564dfbd49f",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Herr Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "424201e4-925c-4292-bf3d-f86c6271ee1d",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Die Müllers fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "f86d8410-55bf-45ca-a5ea-a3a8ecdde909",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Der Müller trägt nie die Pullover, die die Müller ihm strickt."
                                            },
                                            {
                                                "example_id": "d64c32e9-2134-42e3-a9ef-fc3a600174c7",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Müller kommt, geht der Herr Müller.“"
                                            },
                                            {
                                                "example_id": "77d2da08-e1b8-4153-b021-1c9994859def",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Müller kommt und geht."
                                            },
                                            {
                                                "example_id": "421842c0-4ed0-4636-97ec-e9330a854908",
                                                "sense_id": "04207b99-27ca-3302-9bf5-32702880fea1",
                                                "text": "Müllers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1c82d41-1228-4275-8726-ee60b5c36e20",
                        "source_entry_id": "6f919dfd-1c64-3855-8a2a-3bc671e30a02",
                        "source_sense_id": "aeb85684-5b03-3ebb-8a44-19361bfffaa3",
                        "target_lang_word": "ме́льник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ме́льник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0f755b4a-690b-3236-943f-849fc2f49f8b",
                                        "entry_id": "50f49750-3467-35a3-91c7-8ac93033b7e9",
                                        "glosses": [
                                            "владелец мельницы или работник на мельнице"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be8456c-fe7f-48df-903a-2f60eda18332",
                                                "sense_id": "0f755b4a-690b-3236-943f-849fc2f49f8b",
                                                "text": "Над несколькими мельницами заведовал один мельник, а мальчики сторожили их."
                                            },
                                            {
                                                "example_id": "d933f04f-6c65-4806-a92f-1a1aa54808ac",
                                                "sense_id": "0f755b4a-690b-3236-943f-849fc2f49f8b",
                                                "text": "На верхней площадке наружной лестницы стоял человек, весь белый от мучной пыли, и что-то кричал мужикам; но грохот падающей воды и гуденье мельницы были настолько сильны, что голоса мельника нельзя было расслышать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa792e6-9f50-3e87-91be-4cf5f6db4b8e",
                                        "entry_id": "50f49750-3467-35a3-91c7-8ac93033b7e9",
                                        "glosses": [
                                            "мн. ч. разновидность карточной игры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66119b3a-9b5c-4aa9-b12e-6645e2ce0eef",
                                                "sense_id": "0fa792e6-9f50-3e87-91be-4cf5f6db4b8e",
                                                "text": "В этом доме неизбежно и постоянно была игра в мельники, которая продолжалась бесконечно, что крайне утомляло нас, хотя все другие партнеры играли с наслаждением."
                                            },
                                            {
                                                "example_id": "b950f7bf-5423-4ad7-9a82-7ced0aca9015",
                                                "sense_id": "0fa792e6-9f50-3e87-91be-4cf5f6db4b8e",
                                                "text": "Пробило уже двенадцать часов, но никто не ложился спать. Играли в карты, в мельники, но игра не шла."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
