                "senses": [
                    {
                        "sense_id": "22495024-9ffd-39d4-97de-e7a92b43a791",
                        "entry_id": "f38b82fc-d0d3-3e12-a485-bd6d106bb827",
                        "glosses": [
                            "brak odczuwania upływu czasu lub stan niezależny od ograniczeń czasowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee840ae-034c-4d4e-b8c3-0880a1ed7cf9",
                                "sense_id": "22495024-9ffd-39d4-97de-e7a92b43a791",
                                "text": "Filozofowie, tacy jak Platon, rozważali bezczasowość w kontekście świata idei, gdzie wszystko istnieje w doskonałej formie, poza czasem i przestrzenią."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "738302ca-2d19-44f0-a7f1-8d4783246f02",
                        "source_entry_id": "f38b82fc-d0d3-3e12-a485-bd6d106bb827",
                        "source_sense_id": "22495024-9ffd-39d4-97de-e7a92b43a791",
                        "target_lang_word": "timelessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timelessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fa3ab5-3ecf-317b-bdc7-9855fa56a2a3",
                                        "entry_id": "ba6090c1-cc1a-337a-925b-6b4c97f00dce",
                                        "glosses": [
                                            "The property of being timeless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b1c55ab-777b-4393-aa2d-652646f736d2",
                                                "sense_id": "d3fa3ab5-3ecf-317b-bdc7-9855fa56a2a3",
                                                "text": "Of all the things that attracted her to the park, the timelessness of the ever-flowing river was most pleasing."
                                            },
                                            {
                                                "example_id": "891d7248-019a-458d-9303-df9a4bffb0e5",
                                                "sense_id": "d3fa3ab5-3ecf-317b-bdc7-9855fa56a2a3",
                                                "text": "A sense of timelessness prevails in the little Derbyshire village of Repton, which was once the capital of the Saxon kingdom of Mercia."
                                            },
                                            {
                                                "example_id": "be37ec28-9af7-462b-90be-df90b1453074",
                                                "sense_id": "d3fa3ab5-3ecf-317b-bdc7-9855fa56a2a3",
                                                "text": "In the Larghetto slow movement Mr. Tetzlaff played the wistful melodic phrases with arching lyricism and radiantly penetrating pianissimos, while in the orchestra Mr. Levine achieved an uncanny balance between timelessness and subdued intensity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
