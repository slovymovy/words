                    },
                    {
                        "translation_id": "b07c96e7-aed4-4a55-857b-69335ab1e4b8",
                        "source_entry_id": "9dbea3fe-625c-3f35-b241-af086c50b0df",
                        "source_sense_id": "f3d23982-4cfd-30c6-87bf-daf691f28c6f",
                        "source_sense_description": "Frau, die berufsmäßig Tierhufe beschlägt",
                        "target_lang_word": "blacksmith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blacksmith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                        "entry_id": "da3e2202-c3ca-3927-af89-247fb44f1322",
                                        "glosses": [
                                            "A person who forges iron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3639645-6cc1-4a08-b0f8-fb47eec6a4ec",
                                                "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                                "text": "The blacksmith may forge what Religion he pleases."
                                            },
                                            {
                                                "example_id": "8bc2279f-b644-4e99-ab0e-b57bcc51bef8",
                                                "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "1a8105e1-54ca-456a-8e9c-d5c7c8be17fb",
                                                "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                                                "text": "Close to the hump-backed bridge on the lane leading into the Hambleden Valley is a mid-19th-century smithy, its inside walls hung with tools of the blacksmith's trade, though decorative wrought-ironwork is now the main product from its glowing forge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33afd6f0-b5f2-363f-8323-8e4778d96e6d",
                                        "entry_id": "da3e2202-c3ca-3927-af89-247fb44f1322",
                                        "glosses": [
                                            "A person who shoes horses."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0481bb3a-1a39-3550-9832-2c8a79fe51ad",
                                        "entry_id": "da3e2202-c3ca-3927-af89-247fb44f1322",
                                        "glosses": [
                                            "A blackish fish of the Pacific coast (Chromis punctipinnis)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blacksmith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3267a127-f1ab-39cd-8db8-785d2314603f",
                                        "entry_id": "29601631-b8bb-304d-b60f-1bcbab81bab5",
