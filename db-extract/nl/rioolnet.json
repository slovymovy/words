                    {
                        "sense_id": "5a6651ed-a8eb-3925-b699-2c20983b50cf",
                        "entry_id": "72da5b19-e154-32a8-a45f-bd6376a84308",
                        "glosses": [
                            "het samenhangend systeem van met elkaar verbonden buizen waardoor afval water wordt weggevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb2e752-cb24-46d9-ae5d-41f5d0e35f98",
                                "sense_id": "5a6651ed-a8eb-3925-b699-2c20983b50cf",
                                "text": "Er is sinds 2001 gewerkt aan het afkoppelen van regenpijpen van het riool. Inmiddels is ruim 26 hectare verhard oppervlak, een derde van het totaal, niet meer op de riolering aangesloten. In nieuwbouwwijken wordt de regenafvoer van de woningen al standaard niet meer op het rioolnet aangesloten."
                            },
                            {
                                "example_id": "289a110d-c56a-405c-baf8-d82ed11f5152",
                                "sense_id": "5a6651ed-a8eb-3925-b699-2c20983b50cf",
                                "text": "Het rioolnet van Enschede is 800 kilometer lang."
                            },
                            {
                                "example_id": "3188eaeb-7d8e-44a8-bbb6-7ff284c0fad9",
                                "sense_id": "5a6651ed-a8eb-3925-b699-2c20983b50cf",
                                "text": "De demissionair VVD-bewindsman wil beheerders van energie-, telecom-, data-, water- en rioolnetten verplichten om informatie over alle aansluitingen van woningen en bedrijven op deze netten inzichtelijk te maken, zodat bij graafwerkzaamheden minder kans op ongelukken is."
                            }
                        ]
                    }
