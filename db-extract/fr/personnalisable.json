                "senses": [
                    {
                        "sense_id": "ace6e03a-a289-3ce8-ab68-56352376e45b",
                        "entry_id": "93d1e21c-a49b-3a5f-b3ef-e776073b7f39",
                        "glosses": [
                            "Qui peut être personnalisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d18180-f4b9-4c8f-8be4-2692e9199827",
                                "sense_id": "ace6e03a-a289-3ce8-ab68-56352376e45b",
                                "text": "Les éditions Catënfred vous proposent ce livre personnalisable . Chaque texte est illustré de façon provisoire . Il vous appartient de coller vos propres photos pour parachever ce livre."
                            },
                            {
                                "example_id": "b15b86c2-5ee8-42f0-bc02-47bfb07d1534",
                                "sense_id": "ace6e03a-a289-3ce8-ab68-56352376e45b",
                                "text": "Écologique, léger, solide, résistant, fonctionnel, économique, personnalisable, le mobilier en carton a tout pour plaire."
                            },
                            {
                                "example_id": "4f7a75b7-48ae-46b2-aee6-b5896f72d2cc",
                                "sense_id": "ace6e03a-a289-3ce8-ab68-56352376e45b",
                                "text": "Votre réseau n'attirera que peu d'utilisateurs si un site n'y est pas personnalisable, que ce soit grâce à de nombreux de thèmes disponibles, et ou aux outils que peuvent lui apporter les extensions que vous aurez installées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95b6913e-470c-4bca-af62-e458494f6fbd",
                        "source_entry_id": "93d1e21c-a49b-3a5f-b3ef-e776073b7f39",
                        "source_sense_id": "ace6e03a-a289-3ce8-ab68-56352376e45b",
                        "source_sense_description": "Qui peut être personnalisé",
                        "target_lang_word": "personenbezogen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personenbezogen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb42a9bb-7cf3-3d9e-a580-ab90b53d8ac0",
                                        "entry_id": "f414551d-2dfc-32a9-9502-13eaddbe6b10",
                                        "glosses": [
                                            "sich auf ein Individuum zurückführen lassend; sich genau einer Person zuordnen lassend; auf (genau) eine Person bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bffd585-3f1b-4cb4-8c98-c10057918c6f",
                                                "sense_id": "cb42a9bb-7cf3-3d9e-a580-ab90b53d8ac0",
                                                "text": "Der Name, das Geburtsdatum, die Adresse, der Beruf, auch Bilder sind personenbezogene Daten, wenn die abgebildete Person identifizierbar ist."
                                            },
                                            {
                                                "example_id": "6f3ff238-164d-48b9-9382-31c5924fc61c",
                                                "sense_id": "cb42a9bb-7cf3-3d9e-a580-ab90b53d8ac0",
                                                "text": "„Es steht zu vermuten, dass im Geschäftskundenbereich ein ganzheitliches personenbezogenes Angebot nach wie vor einen Mehrwert hat. Je länger die Geschäftsbeziehung besteht, desto häufiger steht ein Filialbesuch auf der Agenda.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4693b33c-506d-32eb-9fa3-36c1bacfeacb",
                                        "entry_id": "f414551d-2dfc-32a9-9502-13eaddbe6b10",
                                        "glosses": [
                                            "sich auf eine bestimmte Art von Angelegenheiten beziehend, für die die belgische Verfassung die Zuständigkeit der Ebene der Gemeinschaften zuspricht, insbesondere in der Gesundheitspolitik, beim Personenbeistand und bei Familienleistungen"
                                        ],
                                        "tags": [
                                            "Belgien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1607f0a4-eab8-4b77-b593-01e6e9c0a93e",
                                                "sense_id": "4693b33c-506d-32eb-9fa3-36c1bacfeacb",
                                                "text": "„Die Deutschsprachige Gemeinschaft ist im Wesentlichen für die Gemeinschaftsangelegenheiten zuständig, die sich in kulturelle Angelegenheiten, personenbezogene Angelegenheiten und Unterrichtswesen gliedern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
