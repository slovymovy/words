    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9904855f-6279-33ca-89bb-40b722df54bd",
                    "sense_definition": "Een stuk landbouwgrond waar druivenplanten worden gekweekt voor de productie van wijn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toeristen wandelen in de zomer graag door de uitgestrekte <w>wijngaard</w>.",
                            "target_lang_translations": {
                                "en": "In the summer, tourists enjoy walking through the vast <w>vineyard</w>."
                            }
                        },
                        {
                            "text": "Deze Franse <w>wijngaard</w> produceert al meer dan honderd jaar de beste rode wijnen.",
                            "target_lang_translations": {
                                "en": "This French <w>vineyard</w> has been producing the best red wines for over a hundred years."
                            }
                        }
                    ],
                    "synonyms": [
                        "wingerd"
                    ],
                    "common_phrases": [
                        "een Franse wijngaard",
                        "werken in de wijngaard"
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of agricultural land where grapevines are grown for the production of wine."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vineyard",
                                "target_lang_sense_clarification": "a plantation of grapevines"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b06cc2-a5e7-32dd-9dfc-943a9f8c7532",
                    "sense_definition": "De druivenplant zelf of een van de klimmende takken daarvan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>wijngaard</w> groeide helemaal over het hek van de tuin heen.",
                            "target_lang_translations": {
                                "en": "The old <w>grapevine</w> grew completely over the garden fence."
                            }
                        },
                        {
                            "text": "In de herfst verkleuren de bladeren van de <w>wijngaard</w> prachtig rood en geel.",
                            "target_lang_translations": {
                                "en": "In autumn, the leaves of the <w>vine</w> turn a beautiful red and yellow."
                            }
                        }
                    ],
                    "synonyms": [
                        "druivelaar",
                        "wingerd",
                        "druivenstok"
                    ],
                    "common_phrases": [
                        "de bloeiende wijngaard"
                    ],
                    "target_lang_definitions": {
                        "en": "The grapevine plant itself or one of its climbing branches."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grapevine",
                                "target_lang_sense_clarification": "the plant that produces grapes"
                            },
                            {
                                "target_lang_word": "vine",
                                "target_lang_sense_clarification": "a climbing or trailing woody-stemmed plant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2ed7bbf-55ff-3abc-8b3e-e20e0b7c1ccb",
                    "sense_definition": "Een andere soort klimplant die lijkt op de druivelaar, zoals de bosrank.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten wordt de bosrank soms aangeduid als een wilde <w>wijngaard</w>.",
                            "target_lang_translations": {
                                "en": "In old texts, the clematis is sometimes referred to as a wild <w>vine</w>."
                            }
                        },
                        {
                            "text": "Niet elke plant die men een <w>wijngaard</w> noemt draagt ook daadwerkelijk eetbare vruchten.",
                            "target_lang_translations": {
                                "en": "Not every plant called a <w>vine</w> actually bears edible fruit."
                            }
                        }
                    ],
                    "synonyms": [
                        "bosrank"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vroeger vaker gebruikt voor diverse klimplanten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Another type of climbing plant that resembles a grapevine, such as clematis."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "creeper",
                                "target_lang_sense_clarification": "a climbing plant"
                            },
                            {
                                "target_lang_word": "vine",
                                "target_lang_sense_clarification": "general term for climbing plants"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}