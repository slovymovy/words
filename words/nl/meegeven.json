                            },
                            {
                                "target_lang_word": "leave with",
                                "target_lang_sense_clarification": "to give a thought or advice to consider"
                            },
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "to offer advice or a lesson"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0642065b-65bc-37a7-9ee7-b124d0a04039",
                    "sense_definition": "buigen of inveren onder druk of bij een botsing",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het aantal gymblessures zal waarschijnlijk afnemen nu we de muren van de gymzaal hebben laten bekleden en die <w>meegeven</w>.",
                            "target_lang_translations": {
                                "en": "The number of gym injuries will likely decrease now that we have padded the gym walls and they <w>give</w> a little."
                            }
                        },
                        {
                            "text": "Het materiaal is erg veilig omdat het een beetje <w>meegeeft</w> als je ertegenaan valt.",
                            "target_lang_translations": {
                                "en": "The material is very safe because it <w>yields</w> a bit if you fall against it."
                            }
