                "senses": [
                    {
                        "sense_id": "1659199f-1f85-38a4-a7f0-51bc36112af6",
                        "entry_id": "a09d16b0-b59e-3e6b-bac9-36801b53b951",
                        "glosses": [
                            "Druckschrift mit Serifen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6750425a-f663-49d5-a1a9-b587c28abe38",
                                "sense_id": "1659199f-1f85-38a4-a7f0-51bc36112af6",
                                "text": "„Aus diesem Grund gelten Serifenschriften für längere gedruckte Texte (nicht für Bildschirmtexte, da die Serifen dort verschwimmen) als geeigneter als Groteskschriften, da man glaubt, dass die Serifen das Auge in der Zeile führen - eine These, die allerdings bislang noch nicht empirisch belegt werden konnte (…).“"
                            },
                            {
                                "example_id": "a2803cae-1972-4e67-ae40-c2436da9119b",
                                "sense_id": "1659199f-1f85-38a4-a7f0-51bc36112af6",
                                "text": "„In der Informatik wird zwischen zwei Schrifttypen unterschieden: serifenloser Schrift und Serifenschrift. Der Unterschied ist leicht erkennbar: serifenlose Schrift hat keine \"Schnörkel\" an den Enden der Buchstaben, Serifenschrift hingegen schon.“"
                            },
                            {
                                "example_id": "2260a3b1-6162-4ab3-82cd-7a07022f5a38",
                                "sense_id": "1659199f-1f85-38a4-a7f0-51bc36112af6",
                                "text": "„Er vermengte eine Serifenschrift für »America« mit einer serifenlosen Schrift für »make great again«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
