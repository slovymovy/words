                    "sense_id": "a15923ea-cbae-3500-b80d-640c8e23c37c",
                    "sense_definition": "een afzonderlijk deel of een eigenschap van een groter geheel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het belangrijkste <w>element</w> van dit plan is de samenwerking tussen de teams.",
                            "target_lang_translations": {
                                "en": "The most important <w>element</w> of this plan is the cooperation between the teams."
                            }
                        },
                        {
                            "text": "Vanaf de klassieke periode is het centrale <w>element</w> de palaestra, een open vierkante hof.",
                            "target_lang_translations": {
                                "en": "From the classical period, the central <w>element</w> is the palaestra, an open square courtyard."
                            }
