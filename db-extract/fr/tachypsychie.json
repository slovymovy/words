                        "sense_id": "464eac5c-ce51-31d7-a00c-4d4faf4e5c01",
                        "entry_id": "f8148d46-1c02-3800-9ba1-c2a590a2af11",
                        "glosses": [
                            "Symptôme psychopathologique caractérisé par une accélération anormale du rythme de la pensée créant un état de surexcitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ef6d68-a7ff-4b54-80c9-ae9f4a10fcd5",
                                "sense_id": "464eac5c-ce51-31d7-a00c-4d4faf4e5c01",
                                "text": "La tachypsychie est, d'un point de vue sémiologique, un symptôme psychiatrique manifestant une véritable « fuite des idées », une extrême rapidité du cours de la pensée, entraînant dans la plupart des cas le sujet dans un discours très rapide et souvent incohérent, se mêlant au paralogisme qui, s’il est de bonne foi, reste souvent faux ou inapproprié voire confus."
                            }
                        ]
                    }
                ],
