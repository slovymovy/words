                                                "sense_id": "89ecaa2f-ad00-3761-990e-8a21955b89c8",
                                                "text": "Auf der Tanzfläche bewegte er sich noch etwas ungelenk."
                                            },
                                            {
                                                "example_id": "bc266489-3afe-4db4-83f9-b14388584bb7",
                                                "sense_id": "89ecaa2f-ad00-3761-990e-8a21955b89c8",
