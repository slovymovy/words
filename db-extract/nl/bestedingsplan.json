                    {
                        "sense_id": "6e67b06a-907a-31df-997b-a40d67f8d0e8",
                        "entry_id": "a35b3fa5-2e9e-3326-afb6-3744618ffe86",
                        "glosses": [
                            "voorgenomen manier om geld uit te geven"
