                "senses": [
                    {
                        "sense_id": "ea7f1e0d-b66f-399a-b170-8b285045f003",
                        "entry_id": "82e635d6-2d66-32bc-9829-3c2a230926e8",
                        "glosses": [
                            "ein Baby, das nach einer Fehlgeburt, Totgeburt oder plötzlichem Kindstod geboren oder adoptiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214c37f2-0c3a-49f5-8c79-054b7ca16d5d",
                                "sense_id": "ea7f1e0d-b66f-399a-b170-8b285045f003",
                                "text": "„Kinder, die nach einem Sternenkind zur Welt kommen, nennt man Regenbogenbabys.“"
                            },
                            {
                                "example_id": "304f2a79-ff48-4d9e-996b-0b2ddf51562e",
                                "sense_id": "ea7f1e0d-b66f-399a-b170-8b285045f003",
                                "text": "„Jede Schwangerschaft ist einmalig, aber ein Regenbogenbaby unter dem Herzen zu tragen, ist etwas ganz besonderes.“"
                            },
                            {
                                "example_id": "a22893b1-1d9c-4962-8cd2-88e03bd58fd3",
                                "sense_id": "ea7f1e0d-b66f-399a-b170-8b285045f003",
                                "text": "„Noch immer fotografiert sie außerdem sogenannte Regenbogenbabys. Das sind Babys, die zur Welt kommen, nachdem die Eltern zuvor bereits eine Fehlgeburt hatten.“"
                            },
                            {
                                "example_id": "b056e94f-d21a-4971-b2d2-b02c7d677039",
                                "sense_id": "ea7f1e0d-b66f-399a-b170-8b285045f003",
                                "text": "„Nach dem Stillgeborenen folgte nämlich ein Regenbogenbaby, so nennt man Geschwisterkinder, die auf ein Sternenkind folgen.“"
                            },
                            {
                                "example_id": "40f6f8ed-e4bc-400b-9298-a9edc9434475",
                                "sense_id": "ea7f1e0d-b66f-399a-b170-8b285045f003",
                                "text": "„Sie wollte sie bei einer Babyparty für ihre Freundin fliegen lassen, sagte sie – die Freundin mit den Regenbogenbabys, den Zwillingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
