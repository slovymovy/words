                "senses": [
                    {
                        "sense_id": "66ec4e0d-f50b-307c-baf7-238081957b6c",
                        "entry_id": "5b8386e7-e5f9-3b93-9d01-23446728f141",
                        "glosses": [
                            "eine Frau, die an einer Schule Geografie unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a645dbf1-a800-46e6-b42d-17033c6ade8d",
                                "sense_id": "66ec4e0d-f50b-307c-baf7-238081957b6c",
                                "text": "Die Geografielehrerin unterrichtete gleichzeitig Sport."
                            },
                            {
                                "example_id": "298856d8-f035-4470-a747-d1f5cbd692ea",
                                "sense_id": "66ec4e0d-f50b-307c-baf7-238081957b6c",
                                "text": "„Ich erinnere mich, […] dass Frau Huhn, unsere Geografielehrerin, uns in der letzten Stunde vor den Ferien Edgar Allan Poe vorlas, was ich liebte.“"
                            },
                            {
                                "example_id": "5ae380e2-0a0b-41a2-9191-276c5a195c47",
                                "sense_id": "66ec4e0d-f50b-307c-baf7-238081957b6c",
                                "text": "„Mit dieser Frage bist du bei mir genau an die Richtige geraten, denn ich war ja auch mal Geografielehrerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
