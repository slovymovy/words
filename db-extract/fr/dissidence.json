        "fr-extract.jsonl": [
            {
                "entry_id": "c721a6f8-50e2-3b0e-a57d-ca8d4a9b6d01",
                "word": "dissidence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4cce4096-de3f-4660-bda5-62394d5dbb9a",
                        "entry_id": "c721a6f8-50e2-3b0e-a57d-ca8d4a9b6d01",
                        "tags": [
                            "plural"
                        ],
                        "form": "dissidences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9031275f-54d1-39ed-9a3e-fab737d25c26",
                        "entry_id": "c721a6f8-50e2-3b0e-a57d-ca8d4a9b6d01",
                        "glosses": [
                            "Action ou état de ceux qui s’éloignent de la doctrine ou de l’opinion majoritairement admise, surtout en matière religieuse et politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7ee52d-b771-4a9a-9c79-4f7c49aeaf17",
                                "sense_id": "9031275f-54d1-39ed-9a3e-fab737d25c26",
                                "text": "Dissidence d’opinions."
                            },
                            {
                                "example_id": "bffdcedd-d5de-49d2-8ee3-832df2df7fd5",
                                "sense_id": "9031275f-54d1-39ed-9a3e-fab737d25c26",
                                "text": "L’assemblée paraissait unanime, cette proposition y a fait naître une dissidence fâcheuse."
                            },
                            {
                                "example_id": "cbeacfd5-9512-456a-913c-010d30c2d8bb",
                                "sense_id": "9031275f-54d1-39ed-9a3e-fab737d25c26",
                                "text": "J’ai eu depuis des maîtres autrement brillants et sagaces ; je n’en ai pas eu de plus vénérables, et voilà ce qui cause souvent des dissidences entre moi et quelques-uns de mes amis."
                            },
                            {
                                "example_id": "f4c40596-dfa8-4728-b2f9-05c0ead223ef",
                                "sense_id": "9031275f-54d1-39ed-9a3e-fab737d25c26",
                                "text": "L'organisation basée aux États-Unis affirme qu'un modèle mondial de violence et d'intimidation destiné à étouffer la dissidence peut être observé dans une étude de 31 pays ciblant des centaines de victimes dans 79 autres États. Le rapport nomme six pays qui nuisent à la démocratie : la Chine, le Rwanda, l'Arabie saoudite, l'Iran, la Russie et la Turquie, alliée du Canada à l'OTAN."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac88a4d8-3aef-37c4-a9f9-25787515fa6b",
                        "entry_id": "c721a6f8-50e2-3b0e-a57d-ca8d4a9b6d01",
                        "glosses": [
                            "Territoire peuplé de rebelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f4c6a4-6f9a-45ed-ae43-440edb2c46b0",
                                "sense_id": "ac88a4d8-3aef-37c4-a9f9-25787515fa6b",
                                "text": "Ni cette nuit vécue en dissidence et dont le souvenir me revient.\nNous étions trois équipages de l'Aéropostale échoués à la tombée du jour sur la côte de Rio de Oro. Mon camarade Riguelle s'était posé d'abord, à la suite d'une rupture de bielle; …."
                            },
                            {
                                "example_id": "47102f15-0115-49bf-ab25-1575e9a96deb",
                                "sense_id": "ac88a4d8-3aef-37c4-a9f9-25787515fa6b",
                                "text": "Au cours des premières années de la ligne Casablanca-Dakar, à l'époque où le matériel était fragile, les pannes, les recherches et les sauvetages nous ont contraints d'atterrir souvent en dissidence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2812d583-a5b3-4798-ab72-f7a6cec16746",
                        "source_entry_id": "c721a6f8-50e2-3b0e-a57d-ca8d4a9b6d01",
                        "target_lang_word": "dissidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8aedb27-0bb4-3cbc-96f3-8e79808793ee",
                                        "entry_id": "765adca9-4adc-3412-bb21-52ca579fdc68",
                                        "glosses": [
                                            "The state of being dissident; dissent"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43260ea9-8c2c-4578-b1be-b2fcf642a105",
                                                "sense_id": "d8aedb27-0bb4-3cbc-96f3-8e79808793ee",
                                                "text": "[…]and it ſome Way neceſſitateth them in a divided Way to endeavour ſome other Way of entering, and to increaſe their Diſſidence of them who ſo partially (in their Eſteem at leaſt) manages Matters, and prefers the ſtrengthening of a Side, to the Edification of the Church[…]"
                                            },
                                            {
                                                "example_id": "e260e646-aa86-49ce-9a90-7377353f2417",
                                                "sense_id": "d8aedb27-0bb4-3cbc-96f3-8e79808793ee",
                                                "text": "I home Mr. L’s diſſidence will not be hurt if I juſt ſuggeſt that his difficulty in the golden verſes, communicated to you laſt May, p. 224, is no difficulty at all."
                                            },
                                            {
                                                "example_id": "17c9d3d6-43c0-4d16-a8c4-eb28e958a595",
                                                "sense_id": "d8aedb27-0bb4-3cbc-96f3-8e79808793ee",
                                                "text": "All proteſtantiſm, even the moſt cold and paſſive, is a fort of diſſent. But the religion moſt prevalent in our northern colonies is a refinement on the principle of reſiſtance ; it is the diſſidence of diſſent ; and the proteſtantiſm of the proteſtant religion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
