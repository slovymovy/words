{
    "word_family": [
        "provident",
        "providential",
        "providently",
        "providentially",
        "improvident"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aba05032-7060-3ee6-89fa-41efbdb376c2",
                    "sense_definition": "The careful governance, guidance, and protective care of God, a deity, or nature over the world and its creatures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divine_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They trusted in <w>providence</w> to guide them safely through the harsh winter.",
                            "target_lang_translations": {
                                "ru": "Они уповали на <w>провидение</w>, которое должно было благополучно провести их через суровую зиму."
                            }
                        },
                        {
                            "text": "Many believed that the sudden rain was a sign of divine <w>providence</w> saving their crops.",
                            "target_lang_translations": {
                                "ru": "Многие верили, что внезапный дождь был знаком божественного <w>промысла</w>, спасшего их урожай."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trust in providence",
                        "divine providence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заботливое руководство, покровительство и забота Бога, божества или природы над миром и его творениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провидение",
                                "target_lang_sense_clarification": "божественное руководство и забота"
                            },
                            {
                                "target_lang_word": "промысл",
                                "target_lang_sense_clarification": "божественная воля, заботящаяся о мире"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55a55338-e88f-3bad-bdf2-ab76d6d15707",
                    "sense_definition": "The quality of being provident; timely preparation for future needs, foresight, or wise governance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foresight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her remarkable <w>providence</w> in planning the budget saved the company from bankruptcy.",
                            "target_lang_translations": {
                                "ru": "Ее поразительная <w>предусмотрительность</w> при планировании бюджета спасла компанию от банкротства."
                            }
                        },
                        {
                            "text": "Showing great <w>providence</w>, he stored extra supplies long before the storm was announced.",
                            "target_lang_translations": {
                                "ru": "Проявив большую <w>предусмотрительность</w>, он сделал дополнительные запасы задолго до того, как было объявлено о буре."
                            }
                        }
                    ],
                    "synonyms": [
                        "Divine Providence"
                    ],
                    "antonyms": [
                        "improvidence"
                    ],
                    "common_phrases": [
                        "show providence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество предусмотрительности; своевременная подготовка к будущим потребностям, предвидение или мудрое управление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предусмотрительность",
                                "target_lang_sense_clarification": "заблаговременная подготовка к будущему"
                            },
                            {
                                "target_lang_word": "прозорливость",
                                "target_lang_sense_clarification": "способность предвидеть будущее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1b62ba9-aca9-38b8-815c-3974eac3aee3",
                    "sense_definition": "The prudent care and management of resources; thriftiness or frugality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foresight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>providence</w> in saving for his old age is exemplary.",
                            "target_lang_translations": {
                                "ru": "Его <w>бережливость</w> при накоплении средств на старость достойна подражания."
                            }
                        },
                        {
                            "text": "Through careful <w>providence</w> and avoiding unnecessary expenses, they bought their first home.",
                            "target_lang_translations": {
                                "ru": "Благодаря разумной <w>бережливости</w> и избеганию ненужных трат они купили свой первый дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "Divine Providence"
                    ],
                    "antonyms": [
                        "extravagance"
                    ],
                    "common_phrases": [
                        "financial providence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разумное отношение к ресурсам и управление ими; бережливость или экономность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бережливость",
                                "target_lang_sense_clarification": "экономное расходование ресурсов"
                            },
                            {
                                "target_lang_word": "предусмотрительность",
                                "target_lang_sense_clarification": "забота о будущем финансовом положении"
                            },
                            {
                                "target_lang_word": "расчетливость",
                                "target_lang_sense_clarification": "практичность в тратах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00579b1b-91e2-302f-bfb8-1eb13b12a659",
                    "sense_definition": "An event or circumstance regarded as an instance of divine intervention or a manifestation of divine care.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "divine_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survivors looked upon their rescue as a miraculous <w>providence</w>.",
                            "target_lang_translations": {
                                "ru": "Выжившие смотрели на свое спасение как на чудесное <w>провидение</w>."
                            }
                        },
                        {
                            "text": "He recorded every unexpected blessing in his journal as a special <w>providence</w>.",
                            "target_lang_translations": {
                                "ru": "Каждое неожиданное благословение он записывал в свой дневник как особое <w>проявление провидения</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие или обстоятельство, рассматриваемое как проявление божественного вмешательства или заботы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провидение",
                                "target_lang_sense_clarification": "проявление божественной воли или заботы"
                            },
                            {
                                "target_lang_word": "перст судьбы",
                                "target_lang_sense_clarification": "знак свыше"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "991af400-76fa-360e-bc5e-cbadeb266fb5",
                    "sense_definition": "God or a deity conceived as the power sustaining and guiding human destiny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divine_care",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "They resigned themselves to the will of <w>Providence</w> during the crisis.",
                            "target_lang_translations": {
                                "ru": "Во время кризиса они покорились воле <w>Провидения</w>."
                            }
                        },
                        {
                            "text": "We must put our faith in <w>Providence</w> and hope for a better tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мы должны довериться <w>Провидению</w> и надеяться на лучшее завтра."
                            }
                        }
                    ],
                    "synonyms": [
                        "Divine Providence"
                    ],
                    "common_phrases": [
                        "will of Providence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бог или божество, понимаемое как сила, направляющая человеческую судьбу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Провидение",
                                "target_lang_sense_clarification": "высшая сила, Бог"
                            },
                            {
                                "target_lang_word": "Промысл Божий",
                                "target_lang_sense_clarification": "божественная сила, управляющая судьбой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53e23823-e002-3aa5-8f27-552c9798c5bf",
                    "sense_definition": "The capital city of the state of Rhode Island in the United States.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "She moved to <w>Providence</w> to attend university and fell in love with the city.",
                            "target_lang_translations": {
                                "ru": "Она переехала в <w>Провиденс</w>, чтобы учиться в университете, и влюбилась в этот город."
                            }
                        },
                        {
                            "text": "The historic streets of <w>Providence</w> are famous for their beautiful architecture.",
                            "target_lang_translations": {
                                "ru": "Исторические улицы <w>Провиденса</w> знамениты своей красивой архитектурой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Столица штата Род-Айленд в Соединенных Штатах Америки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Провиденс",
                                "target_lang_sense_clarification": "город в США"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}