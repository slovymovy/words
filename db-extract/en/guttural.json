                                                "sense_id": "9a40fe3d-cee9-38aa-92e4-8d7c314c97f5",
                                                "text": "Er hat ein furchtbar kehliges Lachen."
                                            },
                                            {
                                                "example_id": "dce07855-82d1-49f5-a36a-17931f06ef7c",
                                                "sense_id": "9a40fe3d-cee9-38aa-92e4-8d7c314c97f5",
                                                "text": "„Steiner schreit kurz und kehlig, dann liegt er seltsam verdreht auf seinem Bauch und macht, von der Hantelstange eingeklemmt, gar nichts mehr.“"
                                            }
                                        ],
