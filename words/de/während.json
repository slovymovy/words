            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "0c848e35-712d-37ec-bb89-9159a055a057",
                    "sense_definition": "drückt Gleichzeitigkeit aus; im Verlauf oder zu einem Zeitpunkt einer Zeitspanne (mit Genitiv, umgangssprachlich auch mit Dativ)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temporal_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man darf <w>während</w> des Unterrichts kein Smartphone benutzen."
                        },
                        {
                            "text": "<w>Während</w> der Fahrt mit dem Zug lese ich gerne ein Buch."
                        }
                    ],
                    "antonyms": [
                        "nach",
                        "vor"
                    ],
                    "common_phrases": [
                        "während der Fahrt",
                        "während des Tages"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "0389daab-ba4a-3da5-b8ee-171a3e74c31b",
                    "sense_definition": "leitet einen Temporalsatz ein, der die Gleichzeitigkeit eines Geschehens mit dem Hauptsatz angibt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temporal_conj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hörte Musik, <w>während</w> er seine Hausaufgaben machte."
                        },
                        {
                            "text": "<w>Während</w> wir auf den Bus warteten, begann es plötzlich stark zu regnen."
                        }
                    ],
                    "antonyms": [
                        "bevor",
                        "nachdem"
                    ]
                },
                {
                    "sense_id": "21ca2b03-5143-3df6-9823-b334cb8ef4e4",
                    "sense_definition": "leitet einen Adversativsatz ein, der einen inhaltlichen Gegensatz zum Hauptsatz ausdrückt; wohingegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adversative_conj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie mag klassische Musik, <w>während</w> ihr Bruder lieber Rock hört."
                        },
                        {
                            "text": "<w>Während</w> ihr Vater sehr groß ist, ist sie eher klein."
                        }
                    ],
                    "synonyms": [
                        "wohingegen"
                    ]
                }
            ]
        },
