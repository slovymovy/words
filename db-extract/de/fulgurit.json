                    {
                        "translation_id": "21d65fcb-c884-48fb-a793-35a8cc3a1d30",
                        "source_entry_id": "131a1500-5c8c-314c-b09c-fae91640310b",
                        "source_sense_id": "1821a54a-3928-3064-ad06-5e6d5fb788b1",
