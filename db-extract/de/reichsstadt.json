                ],
                "senses": [
                    {
                        "sense_id": "63cc8a0e-78d9-332b-ac12-0d041657336b",
                        "entry_id": "2bad8e00-2028-3041-8ec5-3c61c2d756d5",
                        "glosses": [
                            "Stadt, die dem Reich und Kaiser direkt untersteht"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8c04e5cd-adbf-4be9-88a7-ed5769d99b94",
                                "sense_id": "63cc8a0e-78d9-332b-ac12-0d041657336b",
                                "text": "„Gelnhausen wurde im Jahr 1170 von Kaiser Friedrich I. Barbarossa im Rahmen seiner Reichslandpolitik in der Wetterau als Reichsstadt gegründet.“"
                            },
                            {
                                "example_id": "5f1f1e0a-c657-400e-9548-b724df37f967",
                                "sense_id": "63cc8a0e-78d9-332b-ac12-0d041657336b",
                                "text": "„Die Reichsstadt Frankfurt hatte bereits im Jahre 1622 um die Währungsstabilität gekämpft, die hier vor allem durch die Heckenmünzen der umliegenden Herrschaften gefährdet wurde.“"
                            },
                            {
                                "example_id": "32655504-94e2-4bd0-8389-a846808227a0",
                                "sense_id": "63cc8a0e-78d9-332b-ac12-0d041657336b",
                                "text": "„Eger (Cheb), die alte Reichsstadt, an den böhmischen König nur verpfändet und fest in deutscher Hand, war eine Hochburg des Widerstands gegen die Ausgleiche aller Art, wie die Wiener Regierungen zwischen Tschechen und Deutschen zu organisieren versuchten.“"
                            },
                            {
                                "example_id": "165797ef-353f-4e6e-a8ac-1e3139baa108",
                                "sense_id": "63cc8a0e-78d9-332b-ac12-0d041657336b",
                                "text": "„Wielands Diogenes ist keine programmatische Gestalt, sondern die gedankenspielerische Erkundung einer Möglichkeit, die in einer antiken Polis tatsächlich gewisse Realisierungsmöglichkeiten hatte, anders als in einer freien Reichs- oder einer Universitätsstadt im Deutschland des 18. Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
