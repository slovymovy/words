        "nl-extract.jsonl": [
            {
                "entry_id": "1f221f35-3d77-3182-993d-e4021596337e",
                "word": "nicotine",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb024755-7360-3c6b-a690-78722324b222",
                        "entry_id": "1f221f35-3d77-3182-993d-e4021596337e",
                        "glosses": [
                            "vloeibaar, scherp en vluchtig alkaloïde in tabak, een zeer krachtig vergif, dat eerst opwekt en later verlammend werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768f9545-4478-4022-96d1-301b0fa0dac8",
                                "sense_id": "fb024755-7360-3c6b-a690-78722324b222",
                                "text": "Nicotine is de oorzaak voor veel hart- en vaatklachten en kanker; een kwart van de stevige rokers (meer dan twintig sigaretten per dag) haalt de 65 jaar niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "069f865e-a2ca-48b8-ba97-a736a1027d5c",
                        "source_entry_id": "1f221f35-3d77-3182-993d-e4021596337e",
                        "source_sense_id": "fb024755-7360-3c6b-a690-78722324b222",
                        "target_lang_word": "nicotine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nicotine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7c734d-c0e1-394f-be81-ae408db6eed1",
                                        "entry_id": "40724a98-8fd4-33d5-9d50-d384b6e1bcb5",
                                        "glosses": [
                                            "An alkaloid (C₁₀H₁₄N₂), commonly occurring in the tobacco plant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dac448b-0d49-4e7d-821b-45443e78db56",
                                                "sense_id": "ec7c734d-c0e1-394f-be81-ae408db6eed1",
                                                "text": "She is addicted to nicotine."
                                            },
                                            {
                                                "example_id": "b78f0ccd-98d2-4ab2-ad03-c6125c50b9aa",
                                                "sense_id": "ec7c734d-c0e1-394f-be81-ae408db6eed1",
                                                "text": "The nicotine in tobacco has been held to produce anaphrodisiac effects, in spite of such literary commendation as J.M. Barrie's My Lady Nicotine."
                                            },
                                            {
                                                "example_id": "f4cbf20b-bc18-4efd-9e07-cd86e38bc577",
                                                "sense_id": "ec7c734d-c0e1-394f-be81-ae408db6eed1",
                                                "text": "The website calls a vote for Alyona a vote against \"beauties who do not look natural and who cannot be distinguished from each other\" and rails against the \"imposed standards\" of 90-60-90 vital statistics, and \"cigarettes with out nicotine and coffee without caffeine\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d2e2723-07a5-370f-854b-bd5f60a7e387",
                                        "entry_id": "40724a98-8fd4-33d5-9d50-d384b6e1bcb5",
                                        "glosses": [
                                            "Tobacco or cigarettes."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c012299-6979-43d8-9851-1e6e7c87cb1d",
                                                "sense_id": "7d2e2723-07a5-370f-854b-bd5f60a7e387",
                                                "text": "He's got nicotine stains on his fingers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c27dbe-7ee9-4cb7-a0f5-b3d2e77789e4",
                        "source_entry_id": "1f221f35-3d77-3182-993d-e4021596337e",
                        "source_sense_id": "fb024755-7360-3c6b-a690-78722324b222",
                        "target_lang_word": "nicotine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nicotine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                        "entry_id": "ecfc0672-3642-3cea-a663-f7e81a9e2d39",
                                        "glosses": [
                                            "Composé hétérocyclique très toxique, dérivé de la pyridine, qu’on extrait du tabac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf0b613-57c9-491f-a674-3d4f9eabda49",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "Demande à un fumeur que la nicotine empoisonne s’il peut renoncer à son habitude délicieuse et mortelle. Il te dira qu’il a essayé cent fois sans y parvenir."
                                            },
                                            {
                                                "example_id": "61e4d3db-92c8-4436-8738-9ea171bc8c40",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "Sa moustache blanche en partie jaunie par la nicotine s’abaissa un instant vers son menton proéminent tout piqueté de poils gris."
                                            },
                                            {
                                                "example_id": "61241406-20ea-4814-8dc8-51b72a41a06c",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "[…], les dents sont souvent jaunes, voire brunes, jamais brossées, et comme ravagées de nicotine. Les Chinois fument comme des cheminées."
                                            },
                                            {
                                                "example_id": "90b689b6-964f-4dad-8d1b-3b9aec114153",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "Voici un homme qui fumait comme un pompier depuis vingt ans, qui ne fume pratiquement plus grâce à son e-cigarette, et qui se soucie maintenant de se désintoxiquer de la nicotine…"
                                            },
                                            {
                                                "example_id": "85b54ded-cd55-467c-8fba-1748db2d32c1",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "Les accros à la nicotine ont du mal à croire à l'existence de cette étrange créature : la fumeuse occasionnelle. Si vous appartenez à cette catégorie, vous n'en êtes pourtant guère satisfaite. Sinon, vous ne seriez pas en train de lire ce livre."
                                            },
                                            {
                                                "example_id": "0a233e20-9ded-44d9-91e8-adfbf230ef0a",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "Certains mâchent du chewing-gum pour compenser le manque de nicotine, moi je lèche des sucettes pour compenser le manque de sérotonine."
                                            },
                                            {
                                                "example_id": "e0663dc3-5465-4780-ae03-fb8fdbe4de26",
                                                "sense_id": "a4741b69-3b54-3dcb-b7ad-2dd3a590545d",
                                                "text": "La nicotine est une drogue parfaite, une drogue simple et dure, qui n’apporte aucune joie, qui se définit entièrement par le manque, et par la cessation du manque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21534a95-2ab2-3c5f-bdfb-b77624d6a884",
                                        "entry_id": "ecfc0672-3642-3cea-a663-f7e81a9e2d39",
                                        "glosses": [
                                            "Sulfate de nicotine utilisé comme aphicide."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nicotine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "901bca29-48c9-371c-9d5d-25d8949e9316",
                                        "entry_id": "e61e83fa-7254-316f-8264-3f735962e6a9",
                                        "glosses": [
