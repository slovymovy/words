                "senses": [
                    {
                        "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                        "entry_id": "beec9a2d-8017-335c-b623-18f621a0eded",
                        "glosses": [
                            "Urlaub am Meer oder einem Strand an einem See"
                        ],
                        "tags": [
                            "Tourismus"
                        ],
                        "examples": [
                            {
                                "example_id": "59acc781-f0fd-4e14-9c52-7a3aed4a9fc5",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Sommer, Sonne, Strand - wenn Deutsche Urlaub machen, dann am liebsten Badeurlaub.“"
                            },
                            {
                                "example_id": "5907f1db-05b1-4d96-97e8-641281271e79",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Wenn man eine entspannte und ruhige Insel für einen Badeurlaub sucht, ist man hier genau richtig.“"
                            },
                            {
                                "example_id": "3af3dd80-0ae9-4b54-afb7-2d87c3cef0e1",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Badeurlaub ist am besten möglich im Frühjahr und im Herbst.“"
                            },
                            {
                                "example_id": "93d98f18-b08c-4f13-8102-4259ee0c74dd",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Ob Badeurlaub an den Traumstränden der Adriaküste, Aktivurlaub in Südtirol oder Sightseeing-Urlaub in Rom, ein Urlaub in Italien wird mit Sicherheit nicht langweilig.“"
                            },
                            {
                                "example_id": "57477ab9-37b1-48a2-a825-55054140e57a",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Ein typischer Urlaub an der Ostsee ist der Badeurlaub in den Sommermonaten in einem der zahlreichen Seebädern.“"
                            },
                            {
                                "example_id": "f2e101e9-bd8e-4c49-a6de-a22fb9bfb2fa",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Die Nordsee ist eines der beliebtesten Urlaubsziele der Menschen in Deutschland, für Badeurlaub und Strandvergnügen, aber auch für aktive und sportliche Unternehmungen.“"
                            },
                            {
                                "example_id": "65413a57-7cf8-44c0-ab2f-fb14c4f471ce",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Badetourismus verliert an Bedeutung – Die Kärnten Werbung will weiterhin mit Wandern und Radfahren auf „Natur aktiv“ setzen. Der reine Badeurlaub liegt nur noch auf Platz drei.“"
                            },
                            {
                                "example_id": "17b19a7f-366d-4b08-b09f-a0284e90019b",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„[…] der Balaton sowie der Velencer See bieten sich im Sommer für Badeurlaub und Wassersport aller Art an.“"
                            },
                            {
                                "example_id": "83de15f9-3496-456f-9eed-a2d4ba64ed73",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Heute ist Ahrenshoop sowohl für Gäste, die gern Badeurlaub machen oder lange Spaziergänge am Wasser unternehmen, als auch für Kunstfreunde ein interessantes Ziel.“"
                            },
                            {
                                "example_id": "4848a37b-5c4f-47a6-a8b8-c2721b62a4d7",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Rund 65 Milliarden Euro haben die Deutschen 2017 für ihre Urlaubs- und Privatreisen ausgegeben. Damit lagen die Umsätze satte acht Prozent über denen des Vorjahrs. Gemessen an den Ausgaben wiesen Badeurlaube und Städtereisen das größte Wachstum auf.“"
                            },
                            {
                                "example_id": "c3dac7a8-6446-458c-aa9a-7367e032f22e",
                                "sense_id": "5400db8c-c400-3cb0-a88b-4bdbd3739dd7",
                                "text": "„Neben dem klassischen Badeurlaub setzt der Tourismussektor jetzt verstärkt auf Kultur-, Öko- und Abenteuertourismus sowie Sport-, Luxus- und Medizintourismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
