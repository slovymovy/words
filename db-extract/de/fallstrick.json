                        "form": "den Fallstrick"
                    },
                    {
                        "form_id": "761db4a6-f598-4463-a430-769c325668cc",
                        "entry_id": "f300070b-af81-35d4-a1c4-eb747cfb0257",
                        "tags": [
                            "accusative",
