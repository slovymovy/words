                        "sense_id": "98e18f81-2be1-3087-970a-30de8cbd5051",
                        "entry_id": "23cabcca-8b08-3f7f-b002-ebaafed5e1c1",
                        "glosses": [
                            "A type of cellular organelle which is enclosed by a membrane."
