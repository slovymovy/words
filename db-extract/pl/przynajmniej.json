                                    },
                                    {
                                        "sense_id": "ab2e7e30-cece-3ca5-a73e-ab86e74ac7a8",
                                        "entry_id": "3f1c1f58-79ef-35a3-ba7a-acf44ea9ca10",
                                        "glosses": [
                                            "velmi malou měrou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2205ee1b-ae62-4cc0-9b1b-6e0d8b90066b",
                                                "sense_id": "ab2e7e30-cece-3ca5-a73e-ab86e74ac7a8",
                                                "text": "Mohli to stihnout, ale snažili se jen minimálně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8aef063-ead3-3831-9cf5-907cb5cda93d",
                                        "entry_id": "3f1c1f58-79ef-35a3-ba7a-acf44ea9ca10",
