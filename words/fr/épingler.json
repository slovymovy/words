    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e98966d5-74cb-3f73-bb65-8b96bf2dc292",
                    "sense_definition": "Fixer ou attacher avec une ou plusieurs épingles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière va <w>épingler</w> l'ourlet de la robe avant de commencer à coudre."
                        },
                        {
                            "text": "Il a voulu <w>épingler</w> une note importante sur le tableau d'affichage du bureau."
                        }
                    ],
                    "synonyms": [
                        "fixer",
                        "attacher",
                        "agrafer"
                    ],
                    "antonyms": [
                        "dépingler",
                        "détacher"
                    ],
                    "common_phrases": [
                        "épingler une note"
                    ]
                },
                {
                    "sense_id": "8c782fe3-09f3-341b-b407-5c4121726828",
                    "sense_definition": "Surprendre ou attraper quelqu'un en train de commettre une faute ou une infraction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur roulait trop vite et s'est fait <w>épingler</w> par la police sur l'autoroute."
                        },
                        {
                            "text": "L'étudiant qui trichait pendant l'examen espérait ne pas se faire <w>épingler</w>."
                        }
                    ],
                    "synonyms": [
                        "attraper",
                        "coincer",
                        "pincer",
                        "choper"
                    ],
                    "common_phrases": [
                        "se faire épingler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "7afc9bb3-0d15-3018-80ae-aee085d99ef4",
                    "sense_definition": "Mettre en évidence et critiquer publiquement des erreurs, des abus ou des manquements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cour des comptes vient d'<w>épingler</w> plusieurs ministères pour des dépenses jugées excessives."
                        },
                        {
                            "text": "Le journaliste a décidé d'<w>épingler</w> les fausses déclarations faites par les candidats."
                        }
                    ],
                    "synonyms": [
                        "critiquer",
                        "blâmer",
                        "fustiger",
                        "pointer"
                    ],
                    "antonyms": [
                        "féliciter",
                        "encenser"
                    ],
                    "common_phrases": [
                        "épingler les abus"
                    ]
                }
            ]
        }
    ]
