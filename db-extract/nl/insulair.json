                                        "sense_id": "c7a1eed9-41bc-3540-886d-957034e7b586",
                                        "entry_id": "0c9ed186-405f-36bc-99ea-65f60c14ed86",
                                        "glosses": [
                                            "An islander."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6d0e58-962b-490f-a992-84d2d15fc253",
                                                "sense_id": "c7a1eed9-41bc-3540-886d-957034e7b586",
                                                "text": "these insulars in general live in a gross saline air , and their vessels being less elastic are consequently less able to subdue and cast off what their bodies as sponges draw in"
                                            }
                                        ]
