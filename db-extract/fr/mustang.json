            {
                "entry_id": "63a0d972-12f2-3210-96a1-10ccc41ac86d",
                "word": "Mustang",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e936ca9-4d0d-3f8d-877e-088d3797854c",
                        "entry_id": "63a0d972-12f2-3210-96a1-10ccc41ac86d",
                        "glosses": [
                            "Modèle de voitures de la marque Ford."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16203849-ed9d-4635-b83b-8e8a90506f25",
                                "sense_id": "5e936ca9-4d0d-3f8d-877e-088d3797854c",
                                "text": "Il croit être quelqu’un avec ses immeubles, ses cinémas et sa Mustang rouge décapotable, mais ce n’est qu’un gros poisson dans une petite mare, et encore, pas si gros que ça."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "68eb76f0-eb22-3291-af2e-75eb6f8b0394",
                "word": "mustang",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e1326217-0271-4d72-826a-2cb9488ade29",
                        "entry_id": "68eb76f0-eb22-3291-af2e-75eb6f8b0394",
                        "tags": [
                            "plural"
                        ],
                        "form": "mustangs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a65161bc-a9bb-387b-97d9-1d365ff54ea6",
                        "entry_id": "68eb76f0-eb22-3291-af2e-75eb6f8b0394",
                        "glosses": [
                            "Nom des chevaux sauvages de la pampa de la Sud-Amérique."
                        ],
                        "tags": [
                            "Zootechnie"
                        ],
                        "examples": [
                            {
                                "example_id": "51e6537d-3e9f-4465-8437-e86fca2508c0",
                                "sense_id": "a65161bc-a9bb-387b-97d9-1d365ff54ea6",
                                "text": "Alors il lança son cheval dans les magueys, et l'un et l'autre furent en un instant hors de vue ; mais en m'approchant j'entendis les feuilles épaisses craquer sous le sabot du mustang ; il fallait l'imiter ou abandonner la poursuite."
                            },
                            {
                                "example_id": "741b49fb-4588-4f23-bc38-ab7b83d7629f",
                                "sense_id": "a65161bc-a9bb-387b-97d9-1d365ff54ea6",
                                "text": "Avec des rations qui empêcheraient à peine nos chevaux de mourir, les mustangs de la pampa vivent et prospèrent parfaitement."
                            },
                            {
                                "example_id": "e24dd55b-0cca-4f4c-bd06-f6c71865fc40",
                                "sense_id": "a65161bc-a9bb-387b-97d9-1d365ff54ea6",
                                "text": "Quand aux Mustangs du Paraguay, ce sont des chevaux élevés en semi-liberté et presque sans soins."
                            }
                        ]
                    },
                    {
                        "sense_id": "db9c9fef-3b30-31c0-abcd-0e3113660125",
                        "entry_id": "68eb76f0-eb22-3291-af2e-75eb6f8b0394",
                        "glosses": [
                            "Race de cheval de travail, cheval sauvage originaire du Nord-Ouest de l’Amérique du Nord et du Canada, descendant de chevaux domestiques revenus à l'état sauvage du fait du phénomène du marronnage, dont la taille au garrot est de 1,35 à 1,55 m, utilisés pour le travail du bétail, le rodéo et la randonnée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6c37cbf1-40b3-41e6-b84d-fec9518836d3",
                                "sense_id": "db9c9fef-3b30-31c0-abcd-0e3113660125",
                                "text": "[…], il fut un temps où comme tout autre enfant des prairies, je passais à chasser des journées entières, sur un mustang fougueux et indompté ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c32f9b1c-6b26-4b5a-a996-2010f1f536b8",
                        "source_entry_id": "68eb76f0-eb22-3291-af2e-75eb6f8b0394",
                        "target_lang_word": "mustang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2fdf6c09-fb0b-4012-a325-4e5d5d4e073a",
                        "source_entry_id": "68eb76f0-eb22-3291-af2e-75eb6f8b0394",
                        "target_lang_word": "mustang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mustang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26e8149-7720-3d9b-a829-bb8ad91f2583",
                                        "entry_id": "84e24852-1010-30c1-9cf5-4f97c168f77e",
                                        "glosses": [
                                            "A small, hardy, naturalized (feral) horse of the North American west."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51917f68-18ed-43c9-991e-b52fbb9ba57f",
                                                "sense_id": "d26e8149-7720-3d9b-a829-bb8ad91f2583",
                                                "text": "The mustang pony, the invariable companion of the inhabitant of the prairie, whether he is rich or poor, is a little creature, apparently narrow-chested, and small across the loins."
                                            },
                                            {
                                                "example_id": "2906133a-6c43-4660-81ae-27a8821d57d7",
                                                "sense_id": "d26e8149-7720-3d9b-a829-bb8ad91f2583",
                                                "text": "Having ridden a distance of two or three miles, Garey slackened his pace, and put the mustang to a slow walk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e548cd97-5319-3561-9e83-27379b1680f0",
                                        "entry_id": "84e24852-1010-30c1-9cf5-4f97c168f77e",
                                        "glosses": [
                                            "A merchant marine who joined the U.S. Navy as a commissioned officer during the American Civil War."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584ac3f2-d7d9-4f0b-a762-1cdbe586b8a6",
                                                "sense_id": "e548cd97-5319-3561-9e83-27379b1680f0",
                                                "text": "He is a product of the merchant marine and is one of the officers called \"Mustangs\" who entered the navy during the Civil War."
                                            },
                                            {
                                                "example_id": "83c8e392-b822-475a-9b5a-b2771adffc2a",
                                                "sense_id": "e548cd97-5319-3561-9e83-27379b1680f0",
                                                "text": "He was the son of a famous artist, and was what we termed a \"mustang\" officer, who had come into the navy from the merchant service during the Civil War."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1aa500-5a62-3f17-8db6-e16de3cd9e7f",
                                        "entry_id": "84e24852-1010-30c1-9cf5-4f97c168f77e",
                                        "glosses": [
                                            "A commissioned officer who started military service as an enlisted person."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebff9ed6-216a-4ec2-aa95-c31e59902b87",
                                                "sense_id": "3e1aa500-5a62-3f17-8db6-e16de3cd9e7f",
                                                "text": "[…] and the chief engineer is a \"mustang\" — that is, an officer who has risen from the ranks of enlisted men."
                                            },
                                            {
                                                "example_id": "01acccd7-27b9-48c4-b410-6e96580f4db7",
                                                "sense_id": "3e1aa500-5a62-3f17-8db6-e16de3cd9e7f",
                                                "text": "Mustang— Officer who came up through the ranks. None better."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mustang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7971ae4-3b67-3766-9603-6521745d35dc",
                                        "entry_id": "1383155e-aeb5-3d2d-875e-03dfc0e53633",
                                        "glosses": [
                                            "To hunt mustangs (wild horses), either for military use or for slaughter as pet food."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
