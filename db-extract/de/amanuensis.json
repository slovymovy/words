                                        "sense_id": "2e8c04a6-77ef-3548-9b57-bd1f72d4af12",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "A journalist."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6c556ec-5b63-3cee-8dbe-67f839410a5a",
                                        "entry_id": "f3e33b8d-83c6-3142-bf38-39ae99fc5d60",
                                        "glosses": [
                                            "A writer and doctor of the law; one skilled in the law and traditions; one who read and explained the law to the people."
                                        ],
                                        "tags": [
