                        "entry_id": "8f148d11-2043-3cad-a167-3e322d4e72d8",
                        "glosses": [
                            "Homme convaincu de l’innocence de Dreyfus et prenant son parti."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "e4a1a320-1d91-40c5-bd39-e508bc0bf511",
                                "sense_id": "f8962f54-a820-39d7-8543-d0a56801b489",
                                "text": "Jaurès et beaucoup d’autres éminents dreyfusards approuvèrent le général André et Combes d’avoir organisé un système régulier de délation."
                            },
                            {
                                "example_id": "a9025e09-735c-4d56-b872-24b20210d2f1",
                                "sense_id": "f8962f54-a820-39d7-8543-d0a56801b489",
                                "text": "J’ai beaucoup lu sur Péguy, ce fils de rempailleuse de chaises devenu Normalien, dreyfusard acharné, socialiste de sang et de flammes, polémiste frontal."
                            }
                        ]
                    }
