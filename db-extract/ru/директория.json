                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "directory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ddd51b-ec26-3239-a450-6c66e2331ecb",
                                        "entry_id": "01e02508-8c29-3685-9801-6300fbdf9cce",
                                        "glosses": [
                                            "A list of names, addresses etc, of specific classes of people or organizations, often in alphabetical order or in some classification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f4c4c0-aa1c-411b-a55f-414be623d0db",
                                                "sense_id": "48ddd51b-ec26-3239-a450-6c66e2331ecb",
                                                "text": "look up an address in the directory"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1cea784-2794-3a34-b280-ad35f3bf1ddc",
                                        "entry_id": "01e02508-8c29-3685-9801-6300fbdf9cce",
                                        "glosses": [
                                            "A structured listing of the names and characteristics of the files on a storage device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "000f8b58-24ed-3cae-9242-469db02bd44d",
                                        "entry_id": "01e02508-8c29-3685-9801-6300fbdf9cce",
                                        "glosses": [
                                            "A virtual container in a computer's file system, in which files and other directories may be stored. The files and subdirectories in a directory are usually related."
                                        ],
