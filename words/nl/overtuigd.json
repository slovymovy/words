            "senses": [
                {
                    "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                    "sense_definition": "voltooid deelwoord van <w>overtuigen</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben ervan <w>overtuigd</w> dat een beetje ruimte veel relaties goed zou doen.",
                            "target_lang_translations": {
