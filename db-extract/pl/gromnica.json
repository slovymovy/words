                "senses": [
                    {
                        "sense_id": "7f476ad2-818f-335e-be46-ae874af11174",
                        "entry_id": "646a8f45-59c9-3a79-b182-21000df058a8",
                        "glosses": [
                            "świeca święcona w dzień Matki Boskiej Gromnicznej, 2 lutego, tradycyjnie zapalana przy umierających, zmarłych oraz podczas niektórych uroczystości kościelnych, jak też podczas burzy dla odwrócenia piorunów; ; zob. też gromnica w Encyklopedii staropolskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9127852c-1703-4c65-8226-e7c20fe2c9e5",
                                "sense_id": "7f476ad2-818f-335e-be46-ae874af11174",
                                "text": "Gromnica to świeca inna niż wszystkie. Jest ona związana z jednym z najstarszych świąt w chrześcijaństwie – Ofiarowaniem Pańskim"
                            },
                            {
                                "example_id": "38fd2092-aaaf-4e07-8451-f035d89e5c7d",
                                "sense_id": "7f476ad2-818f-335e-be46-ae874af11174",
                                "text": "W domu gromnica zazwyczaj wisiała na ścianie, uwiązana na krzyż z palmą."
                            },
                            {
                                "example_id": "3a1c0531-8e6f-481a-b487-93193925bd8e",
                                "sense_id": "7f476ad2-818f-335e-be46-ae874af11174",
                                "text": "W czasie burzy moja babcia stawia w oknie zapaloną gromnicę."
                            },
                            {
                                "example_id": "9970d322-6623-4b9e-8e04-ad1aa4adae5d",
                                "sense_id": "7f476ad2-818f-335e-be46-ae874af11174",
                                "text": "Dawniej z zapaloną gromnicą obchodzono całe obejście, przyklękając na każdym progu i na każdym rogu, by złe moce nie miały dostępu do domu"
                            },
                            {
                                "example_id": "14e50abc-5daa-46de-a788-5d91fd658558",
                                "sense_id": "7f476ad2-818f-335e-be46-ae874af11174",
                                "text": "W dzień Matki Boskiej Gromnicznej święcone są gromnice."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0a21621b-7c84-3d49-be97-5ca39c74a102",
                        "entry_id": "646a8f45-59c9-3a79-b182-21000df058a8",
