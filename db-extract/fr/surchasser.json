                                        "sense_id": "8cd613c3-dd1b-3c37-b597-06cb026d5cfa",
                                        "entry_id": "f5620fa8-0498-3d36-a61a-00c5c35fa9a6",
                                        "glosses": [
                                            "To hunt (an animal, a piece of land, etc.) too much."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27efe90-7c76-4a84-9bad-87bac9bdaa11",
                                                "sense_id": "8cd613c3-dd1b-3c37-b597-06cb026d5cfa",
                                                "text": "Steller's sea cow was overhunted and became extinct in the 18th century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
