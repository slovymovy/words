                "senses": [
                    {
                        "sense_id": "7d9ff039-c0d2-3775-a801-795de9c54e61",
                        "entry_id": "2f8cde7c-f7b8-3ada-9fda-dbf3057c4040",
                        "glosses": [
                            "Munitionsbehältnis eines Revolvers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32953c1-3855-4503-bfe8-fdaf9a490f8c",
                                "sense_id": "7d9ff039-c0d2-3775-a801-795de9c54e61",
                                "text": "„Eine alte Schaufel lag dort; er hob damit ein zweites, kleineres Becken aus, wusch im einsickernden Wasser die Revolvertrommel aus, reinigte den Lauf und schob mit einem Stecken den Hemdzipfel durch, bis er sauber war.“"
                            },
                            {
                                "example_id": "72cb85d4-e26b-441e-a3c4-a3438eff07b0",
                                "sense_id": "7d9ff039-c0d2-3775-a801-795de9c54e61",
                                "text": "„Schulga verstand genug von Schusswaffen, um sicher zu sein, auch das Drehgeräusch einer Revolvertrommel gehört zu haben, denn obwohl er offiziell der Geschäftsführer einer großen Londoner Frachtfirma war, arbeitete er in Wahrheit für die SWR.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
