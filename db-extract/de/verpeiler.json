                        "examples": [
                            {
                                "example_id": "cb3f2d7c-043a-4a8f-80cc-0057bb95f625",
                                "sense_id": "8b70878c-a5e6-31cf-8c41-3a3db8c6f12b",
                                "text": "„Der Verpeiler kommt meist aus der Provinz, ist herzensgut, droht aber täglich im akademischen Betrieb unterzugehen.“"
                            },
                            {
                                "example_id": "172db434-c6a1-4cf2-a7a3-624dac7794e9",
                                "sense_id": "8b70878c-a5e6-31cf-8c41-3a3db8c6f12b",
                                "text": "„Aber nun hängt der Verpeiler in der Schule und soll diesen Halbstarken die Berechnung von Masse im freien Fall beibringen.“"
                            }
                        ],
