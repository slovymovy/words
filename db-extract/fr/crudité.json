                                        "sense_id": "d7d8d2b9-1f99-3fd0-a4b4-b8ef623f8c19",
                                        "entry_id": "be65a6ec-2d72-3765-ba5d-f6b2224263c6",
                                        "glosses": [
                                            "The property of being raw."
                                        ],
