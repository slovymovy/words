                    {
                        "translation_id": "acd88697-a633-489b-9e10-522a2c017dff",
                        "source_entry_id": "911b16c4-dac2-35ec-b27f-8d04bf999fb5",
                        "source_sense_id": "5fbefe8b-2a49-3813-8a7f-44ba334266d8",
