                "senses": [
                    {
                        "sense_id": "f8ddc78b-b241-334b-b32c-9552b4e9b9ca",
                        "entry_id": "4c9d0ce7-6f2b-3b9d-9b08-87571670b879",
                        "glosses": [
                            "ununterbrochenes, zügiges Reden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2500d91b-e025-425d-851a-cce6ee5e5ce8",
                                "sense_id": "f8ddc78b-b241-334b-b32c-9552b4e9b9ca",
                                "text": "Durch das ständige Gehuste des Prüfers war mein Redefluss während der Prüfung arg gestört."
                            },
                            {
                                "example_id": "7e893cdb-fb9b-4088-8463-5be63f8f9d7d",
                                "sense_id": "f8ddc78b-b241-334b-b32c-9552b4e9b9ca",
                                "text": "„Als er es merkte, drosselte er seinen Redefluss so weit, dass wir ihm zwar immer noch nicht richtig folgen konnten, aber zumindest ahnten, was er von uns wollte.“"
                            },
                            {
                                "example_id": "c7a506cb-cf4b-4fa5-a03d-626dbfc84404",
                                "sense_id": "f8ddc78b-b241-334b-b32c-9552b4e9b9ca",
                                "text": "„Almuth hörte ihm amüsiert zu, sie wirkte gelöst, scherzte, spottete sogar; wobei sie ihm jedoch ab und zu deutlich zu verstehen gab, dass sie sich von seinem Redefluss überflutet fühlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
