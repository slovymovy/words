                "senses": [
                    {
                        "sense_id": "2261f472-24b9-3c8c-b999-4c94d710632c",
                        "entry_id": "e85e1271-d39e-345d-ba75-061517d6aa68",
                        "glosses": [
                            "młody pasterz wypasający latem owce w Tatrach i Karpatach, pomocnik bacy"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "6c3c9ada-5f16-4467-a7f6-a5973591d0b6",
                                "sense_id": "2261f472-24b9-3c8c-b999-4c94d710632c",
                                "text": "Juhas huknął; po turniach odhuknęły jary"
                            },
                            {
                                "example_id": "2c06b33a-8a97-4612-997c-ba583082a80e",
                                "sense_id": "2261f472-24b9-3c8c-b999-4c94d710632c",
                                "text": "Pewien juhas z Pęksowego Brzyzku • ujrzał przyszłość w proroczym błysku: • szumi piknie Dunajec, • a na mostku baca Kitajec • Jasinecka pierze po pysku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
