    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "74b96872-d46c-360a-b8a2-6075c37dcd7b",
                "word": "unfenced",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "21f71268-5ab1-338f-921b-d79e52cf7457",
                        "entry_id": "74b96872-d46c-360a-b8a2-6075c37dcd7b",
                        "glosses": [
                            "Not fenced.",
                            "Not enclosed by a fence and thus free to roam over a wider area."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b163d3dd-00e9-4eaf-b33f-0e07ccfcf298",
                                "sense_id": "21f71268-5ab1-338f-921b-d79e52cf7457",
                                "text": "Near-synonym: free-range"
                            },
                            {
                                "example_id": "1b0a05cc-d501-4123-8314-eef8ff7d6f04",
                                "sense_id": "21f71268-5ab1-338f-921b-d79e52cf7457",
                                "text": "Ireland must have remained utterly unfenced and, therefore, uncultivated, for many a century; and the sparse tribes that inhabited the country must have principally subsisted venatically."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4e73928-80a5-3c68-8218-2dfb40174535",
                        "entry_id": "74b96872-d46c-360a-b8a2-6075c37dcd7b",
                        "glosses": [
                            "Not fenced.",
                            "Not enclosed by a fence and thus more easily approachable, visitable, encroachable, attackable, and so on."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9facd0a6-e4d7-4454-8deb-54b70cfcd0ea",
                                "sense_id": "b4e73928-80a5-3c68-8218-2dfb40174535",
                                "text": "The line is unfenced, except in the vicinity of stations, and runs across the treeless Mesaorian plain for the whole distance between Famagusta and Nicosia."
                            },
                            {
                                "example_id": "a7bdc51a-8b98-432d-a7cc-17e60ce5aef0",
                                "sense_id": "b4e73928-80a5-3c68-8218-2dfb40174535",
                                "text": "It was a rural railway that served the fertile Fens of Cambridgeshire and Norfolk. But because it flanked public roads and was unfenced (to save costs), it was deemed a tramway and its locomotives had to be fitted with a cowcatcher."
                            }
                        ]
                    },
                    {
                        "sense_id": "095e5026-3294-3360-a6e7-55bfefd44e9d",
                        "entry_id": "74b96872-d46c-360a-b8a2-6075c37dcd7b",
                        "glosses": [
                            "Not fenced.",
                            "Without protection."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c1bf3051-5176-4ac6-952d-f70e5eb831e2",
                                "sense_id": "095e5026-3294-3360-a6e7-55bfefd44e9d",
                                "text": "She [Nature] has made the hinder part of the Head, more strong, as being otherwise unfenced against falls and other casualties."
                            }
                        ]
                    }
                ],
