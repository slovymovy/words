            {
                "entry_id": "674b903f-f386-30ed-91c9-ba1ae66031f2",
                "word": "correlative",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fe4c528a-4a1a-4071-89b5-506d459811ff",
                        "entry_id": "674b903f-f386-30ed-91c9-ba1ae66031f2",
                        "tags": [
                            "plural"
                        ],
