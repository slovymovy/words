                "senses": [
                    {
                        "sense_id": "d2234d19-266d-3bb7-b7c8-62fa34c286db",
                        "entry_id": "a8f21643-dfa9-31ff-93f7-45a410a34e02",
                        "glosses": [
                            "Vorrichtung, mittels der ein Kessel über einer Feuerstelle aufgehängt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946e1976-1e57-4298-9ea5-970e27acaccc",
                                "sense_id": "d2234d19-266d-3bb7-b7c8-62fa34c286db",
                                "text": "„Der Kesselgalgen mit Wendebaum (»Kesselreidn«) befindet sich linker Hand.“"
                            },
                            {
                                "example_id": "cee73012-8cfa-4e9f-bf56-8402c071f8ec",
                                "sense_id": "d2234d19-266d-3bb7-b7c8-62fa34c286db",
                                "text": "„An ihrem linken vorderen Eck ist ein kleiner Kesselgalgen, entlang der Wand rundum gibt es teils wandfeste, teils mobile Bänke.“"
                            },
                            {
                                "example_id": "8da1d037-46be-469f-a5b3-56c51bae06da",
                                "sense_id": "d2234d19-266d-3bb7-b7c8-62fa34c286db",
                                "text": "„Dazu diente ein aus Holz gefertigter, drehbarer Kesselgalgen (Herdgalgen), an dessen waagrechtem Arm man den Käsekessel aufhängte.“"
                            },
                            {
                                "example_id": "7ca31706-12fb-44be-afa8-42cbb78321bd",
                                "sense_id": "d2234d19-266d-3bb7-b7c8-62fa34c286db",
                                "text": "„Lukas rümpfte angewidert die Nase und wagte einen verstohlenen Blick durch den schmalen Spalt einer Tür, die ins Innere einer Schenke führte, doch außer einem Lehmboden, einer Herdstelle mit Kesselgalgen und zwei Bänken, auf denen Strohsäcke lagen, entdeckte er nichts von Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
