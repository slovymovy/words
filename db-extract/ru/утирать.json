                "senses": [
                    {
                        "sense_id": "096c5674-4f43-3784-ba22-90a9840d6db7",
                        "entry_id": "f9d9abf7-4d10-346e-8097-740bbf1c4389",
                        "glosses": [
                            "to wipe, to dry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8deeed-49f3-41b5-8751-74d888226ac5",
                                "sense_id": "096c5674-4f43-3784-ba22-90a9840d6db7",
                                "text": "утира́ть пот с лица",
                                "translation": "to wipe sweat from one's face",
                                "english": "to wipe sweat from one's face"
                            },
                            {
                                "example_id": "460fc9dc-4f3e-4c6c-bbff-8862551a221c",
                                "sense_id": "096c5674-4f43-3784-ba22-90a9840d6db7",
                                "text": "утира́ть себе́ нос",
                                "translation": "to wipe one's nose",
                                "english": "to wipe one's nose"
                            },
                            {
                                "example_id": "e79a62ae-6ac0-4fb6-ba01-2d1db6490d77",
                                "sense_id": "096c5674-4f43-3784-ba22-90a9840d6db7",
                                "text": "утере́ть нос кому́-либо",
                                "translation": "to beat someone; win out over someone; outdo someone; outclass someone",
                                "english": "to beat someone; win out over someone; outdo someone; outclass someone"
                            },
                            {
                                "example_id": "7190cabb-fdf2-45fc-a121-8b1b4526ef50",
                                "sense_id": "096c5674-4f43-3784-ba22-90a9840d6db7",
                                "text": "Слёзы зака́пали по щека́м Ма́рьи Дми́триевны; она́ не утира́ла их: она́ люби́ла пла́кать.",
                                "translation": "The tears were trickling down Marya Dmitrievna's cheeks: she did not wipe them away, she was fond of weeping.",
                                "english": "The tears were trickling down Marya Dmitrievna's cheeks: she did not wipe them away, she was fond of weeping."
                            }
                        ]
                    }
                ],
