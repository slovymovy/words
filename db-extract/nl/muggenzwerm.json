                        "examples": [
                            {
                                "example_id": "68dec2fe-06d8-4ad8-9dd1-3a4feb4cab65",
                                "sense_id": "9039681f-bb4e-32be-846c-aeaa007413ca",
                                "text": "Enorme muggenzwermen teisteren IJsselmeerkust: Zwarte wolken dansmuggen zorgen voor overlast in het zuidwesten van Friesland en op andere plekken langs het IJsselmeer. Het fenomeen doet zich elk voorjaar voor maar zo erg als dit jaar was het niet eerder, blijkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ca2502a-1832-356f-84e6-0c6fc84320e7",
                        "entry_id": "cef7d500-18d1-31af-b837-a34c88b5da89",
                        "glosses": [
                            "een groep van zeer veel kleine vliegende voorwerpen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7346f293-2426-4a27-958e-199f9b07ade3",
                                "sense_id": "4ca2502a-1832-356f-84e6-0c6fc84320e7",
                                "text": "'Ik zal in staat zijn de vloot te instrueren een muggenzwerm te vormen en naar het strijdperk te vliegen, en hem daar te vertellen uiteen te gaan en zich weer in formatie op te stellen."
                            },
                            {
                                "example_id": "841ea881-5988-42ac-81c8-bfd3f4f4d55f",
                                "sense_id": "4ca2502a-1832-356f-84e6-0c6fc84320e7",
                                "text": "Een drone die mensen met dementie helpt om op tijd hun medicijn in te nemen. Of honderden minidrones, die als een muggenzwerm door een ingestort gebouw vliegen om te kijken of er nog slachtoffers zijn. Nu misschien nog niet voor te stellen, maar als het aan drone-ontwikkelaars ligt, is dit over een paar jaar de realiteit."
                            }
                        ]
                    }
