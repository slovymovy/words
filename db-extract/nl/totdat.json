                                    {
                                        "sense_id": "929df420-ee4c-395e-ad41-d2f7539aea3f",
                                        "entry_id": "293bed07-ff09-3cce-ad2d-e2cc7a9eb711",
                                        "glosses": [
                                            "To work or cultivate or plough (soil); to prepare for growing vegetation and crops."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57da4eee-74df-48f0-90a0-c1315197983d",
                                                "sense_id": "929df420-ee4c-395e-ad41-d2f7539aea3f",
                                                "text": "Therefore the Lord God sent him forth from the garden of Eden, to till the ground from whence he was taken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b95ec989-e988-3ca3-b5fe-f453711aacac",
                                        "entry_id": "293bed07-ff09-3cce-ad2d-e2cc7a9eb711",
                                        "glosses": [
                                            "To cultivate soil."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f0e1153-4d3d-3c40-8b83-c8292bbbade5",
                                        "entry_id": "293bed07-ff09-3cce-ad2d-e2cc7a9eb711",
