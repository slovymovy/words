                                        "entry_id": "0d268d34-cea3-3f70-ad6c-d23631ba4459",
                                        "glosses": [
                                            "so, dass man Daten nicht mehr lesen kann, eine Datei nicht mehr mit dem dafür vorgesehenen Programm öffnen kann oder eine verschlüsselte Nachricht nicht mehr entschlüsseln kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5aaf5b4-3391-4f91-90d4-25eeb6693fbb",
                                                "sense_id": "0e2da766-a435-3226-9a14-fa16accadf75",
                                                "text": "Während bei der Steganografie Angreifer möglichst gar nicht erst wissen sollen, dass eine geheime Nachricht übermittelt wird, ist dies bei der Kryptografie im Grunde egal. Denn dort ist die Nachricht für Unbefugte eh unlesbar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
