                        "examples": [
                            {
                                "example_id": "b9dcb587-e054-4a03-b8f4-fe1da49f4376",
                                "sense_id": "48418b68-6039-3bb8-8784-8cd915ec353a",
                                "text": "Der sogenannte Mund-Nasen-Schutz (MNS) verhindert vor allem, dass Speichel- oder Schleimtröpfchen des Infizierten in die Luft gelangen – sofern er sie eng anliegend am Gesicht trägt."
