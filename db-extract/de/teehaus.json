                "senses": [
                    {
                        "sense_id": "5f477d5d-49ea-3bb8-94df-eefe02410f46",
                        "entry_id": "02a004c2-01b9-363b-a2be-21054cb09200",
                        "glosses": [
                            "Gaststätte, in der hauptsächlich Tee serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ddb6371-b2a4-41f0-bb5a-141f12c91160",
                                "sense_id": "5f477d5d-49ea-3bb8-94df-eefe02410f46",
                                "text": "„Die flüsternden Teegläser, von denen Elsa an einem Platz wie diesem vernahm, waren das Geschenk eines alten Derwisches an den gutherzigen Betreiber eines winzigen Teehauses im Basar.“"
                            },
                            {
                                "example_id": "bc2762df-1d90-433c-a81c-8f4ea2f33a9a",
                                "sense_id": "5f477d5d-49ea-3bb8-94df-eefe02410f46",
                                "text": "„Ich saß in Bandirma in einem türkischen Teehaus, nippte an meinem Mokka und sinnierte über die Türkei, den Glauben und die Gastfreundschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4b73f79-2aaf-3593-9966-ba72e2c1e87b",
