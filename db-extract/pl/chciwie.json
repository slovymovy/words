                                        "sense_id": "1c7326de-eeb1-30fe-ae6e-95b99c43f3ce",
                                        "entry_id": "4462028c-2756-30be-941d-6f3fb7aa9171",
                                        "glosses": [
                                            "nach Besitz, Genuss, Freude verlangend, begehrend"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebfee2d2-cf6d-4f72-ad86-e88a99879f4b",
                                                "sense_id": "1c7326de-eeb1-30fe-ae6e-95b99c43f3ce",
                                                "text": "Der Tisch war gedeckt mit begehrlichen und exotischen Köstlichkeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c42d92-7a75-4d7c-8e58-82fd6c8d39e2",
                        "source_entry_id": "e04e960f-9167-3eae-8112-9328538778f2",
                        "source_sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                        "source_sense_description": "voller Begierde; begehrlich, gierig, habgierig, habsüchtig",
                        "target_lang_word": "gierig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gierig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                        "entry_id": "91688a52-5b34-3db2-8dfc-6330f86422e9",
                                        "glosses": [
                                            "triebartig danach verlangend, etwas zu bekommen oder zu besitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38389943-1c68-435d-8a0a-eef27b1e7a72",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Pirat starrte gierig auf die Schätze."
                                            },
                                            {
                                                "example_id": "ca0167e2-23bb-4c68-bb3f-2db963b21e8a",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Gierig verschlang der Gefangene einen Teller Suppe."
                                            },
                                            {
                                                "example_id": "cc1612ff-8850-4e79-8a3b-77b9a4c60456",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Mann saß an der Bar und verschlang die Stripperin mit gierigem Blick."
                                            },
                                            {
                                                "example_id": "017944bc-c030-4b74-b3db-6c6b62bee8f4",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Die Mannschaft ist gieriger auf den Titel als auf die Prämie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20d84fac-8e87-4e95-a955-14ce22ea5080",
                        "source_entry_id": "e04e960f-9167-3eae-8112-9328538778f2",
                        "source_sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                        "source_sense_description": "voller Begierde; begehrlich, gierig, habgierig, habsüchtig",
                        "target_lang_word": "habgierig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habgierig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59b8896f-6d5e-30f7-bb4e-ce136c96d55f",
                                        "entry_id": "7e2bb272-9d4e-37e2-841d-05bc5b21ead7",
                                        "glosses": [
                                            "stark am materiellen Besitz interessiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f53130a-3ae7-4492-9dd0-e0dba879fa0d",
                                                "sense_id": "59b8896f-6d5e-30f7-bb4e-ce136c96d55f",
                                                "text": "Wie habgierig wollen wir noch werden?"
                                            },
                                            {
                                                "example_id": "6ada3d8b-b21a-462a-a891-af4045f0f33c",
                                                "sense_id": "59b8896f-6d5e-30f7-bb4e-ce136c96d55f",
                                                "text": "„Der Bösewicht ist der habgierige Wilderer, der Nashörnern, Elefanten oder Tigern nachstellt, um aus ihnen Trophäen oder irgendeine obskure medizinische Zutat zu machen.“"
                                            },
                                            {
                                                "example_id": "d5018dee-6ad7-4c8b-8fca-04bdd484cd5d",
                                                "sense_id": "59b8896f-6d5e-30f7-bb4e-ce136c96d55f",
                                                "text": "„Wir müssen nicht diese habgierige Generation sein, die einfach damit weitermacht, die Grundlagen des Lebens zu zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "256c9ac8-7e9e-4668-8013-b99e1ee14557",
                        "source_entry_id": "e04e960f-9167-3eae-8112-9328538778f2",
                        "source_sense_id": "a2091c3b-8c66-374c-bd47-c533244388df",
                        "source_sense_description": "voller Begierde; begehrlich, gierig, habgierig, habsüchtig",
                        "target_lang_word": "habsüchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habsüchtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ce0d3df-11ca-367c-9649-f1560c81296b",
                                        "entry_id": "267d5b59-fe0d-3f25-9f73-5f4683ce0441",
                                        "glosses": [
                                            "so, dass man danach strebt, immer noch mehr Besitz oder Geld zu haben / anzuhäufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e9ab77-7e8f-45a8-9ec8-645aa254d75a",
                                                "sense_id": "2ce0d3df-11ca-367c-9649-f1560c81296b",
                                                "text": "„[Der frühere thüringische Landesbischof Ingo] Braecklein zieht [in Stasi-Protokollen] ungeniert über Amtsbrüder her. Etwa […] über seinen Thüringer Kollegen und späteren Nachfolger im Bischofsamt Werner Leich. Der sei zu fromm, geizig und habsüchtig.“"
                                            },
                                            {
                                                "example_id": "b6f090f9-b1b2-4688-83b1-d8b466f2d244",
                                                "sense_id": "2ce0d3df-11ca-367c-9649-f1560c81296b",
                                                "text": "„Lynn Nesbitt, bis zum Schluss seine [des Schriftstellers Tom Wolfes] Agentin, telegrafiert im Dezember 1963: 'Wo bist du - wie geht es dir - warum höre ich nichts von dir? Ich will dich dringend vor all diesen habsüchtigen Verlegern beschützen, die jetzt mit dir ausgehen wollen.'“"
                                            },
                                            {
                                                "example_id": "4f4e4a39-d877-4c2f-80e3-4f43adc95604",
                                                "sense_id": "2ce0d3df-11ca-367c-9649-f1560c81296b",
