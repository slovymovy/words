{
    "word_family": [
        "prodigious",
        "prodigiously",
        "prodigiousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bca5f80-2850-314e-b00d-a16172ea1f57",
                    "sense_definition": "A person, especially a child, who has exceptional abilities or qualities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mozart was recognized as a musical <w>prodigy</w> at a very early age.",
                            "target_lang_translations": {
                                "zh": "莫扎特在很小的时候就被公认为音乐<w>神童</w>。"
                            }
                        },
                        {
                            "text": "The young chess <w>prodigy</w> defeated several grandmasters in the international tournament.",
                            "target_lang_translations": {
                                "zh": "这位年轻的国际象棋<w>奇才</w>在国际锦标赛中击败了数位特级大师。"
                            }
                        }
                    ],
                    "synonyms": [
                        "child prodigy",
                        "wunderkind",
                        "boy wonder",
                        "girl wonder",
                        "boy-genius",
                        "girl-genius"
                    ],
                    "common_phrases": [
                        "child prodigy",
                        "musical prodigy",
                        "chess prodigy",
                        "math prodigy"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指儿童或年轻人的）奇才，天才，神童"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "神童",
                                "target_lang_sense_clarification": "指在年幼时即显现非凡才能的儿童"
                            },
                            {
                                "target_lang_word": "奇才",
                                "target_lang_sense_clarification": "指具备罕见才能的人"
                            },
                            {
                                "target_lang_word": "天才",
                                "target_lang_sense_clarification": "指极具天赋的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13889f40-7205-3902-b7a3-1516e6153109",
                    "sense_definition": "An amazing, marvellous, or impressive event or thing; a wonder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marvel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive bridge was hailed as a <w>prodigy</w> of modern engineering.",
                            "target_lang_translations": {
                                "zh": "这座庞大的桥梁被誉为现代工程的<w>奇迹</w>。"
                            }
                        },
                        {
                            "text": "Tales and legends described many prodigies performed by the ancient heroes.",
                            "target_lang_translations": {
                                "zh": "传说和神话描述了古代英雄所创下的许多<w>奇迹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prodigy of"
                    ],
                    "target_lang_definitions": {
                        "zh": "令人惊叹的事物，奇观，奇迹"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "奇迹",
                                "target_lang_sense_clarification": "指令人惊叹、不可思议的成就或事件"
                            },
                            {
                                "target_lang_word": "奇观",
                                "target_lang_sense_clarification": "指令人赞叹的罕见壮观事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "912a78cb-5411-3bde-98b3-764d43cf93ed",
                    "sense_definition": "A wonderful, prominent, or extreme example of a particular quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marvel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Throughout his long career, he remained a true <w>prodigy</w> of patience and diplomacy.",
                            "target_lang_translations": {
                                "zh": "在他漫长的职业生涯中，他始终是耐心与外交手腕的真正<w>典范</w>。"
                            }
                        },
                        {
                            "text": "The library is a <w>prodigy</w> of scholarly learning and historical preservation.",
                            "target_lang_translations": {
                                "zh": "这座图书馆是学术知识与历史留存的绝佳<w>典范</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prodigy of learning"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有某种特质的非凡典范，极致代表"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "典范",
                                "target_lang_sense_clarification": "指展现某特质达到极致的榜样或代表"
                            },
                            {
                                "target_lang_word": "化身",
                                "target_lang_sense_clarification": "指某种非凡品质的集中体现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa6fd94-a8b5-363f-b11b-3007d8328241",
                    "sense_definition": "An extraordinary event or sign interpreted as an omen; a portent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "omen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden eclipse was viewed by the superstitious villagers as a dark <w>prodigy</w>.",
                            "target_lang_translations": {
                                "zh": "迷信的村民将这突如其来的日食视为不祥的<w>异兆</w>。"
                            }
                        },
                        {
                            "text": "Ancient historians often recorded unnatural signs and prodigies before major battles.",
                            "target_lang_translations": {
                                "zh": "古代历史学家常在重大战役前记录下反常的迹象和<w>预兆</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "portents and prodigies"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语、文语）预兆，凶兆，征兆"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "预兆",
                                "target_lang_sense_clarification": "预示未来的异常征候"
                            },
                            {
                                "target_lang_word": "异兆",
                                "target_lang_sense_clarification": "预示重大事件的罕见异常天象或迹象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23217189-3491-32c3-8f8b-634eda011592",
                    "sense_definition": "An unnatural or abnormal occurrence or creature; a monstrous anomaly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "omen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medieval bestiaries frequently depicted two-headed calves and other strange prodigies.",
                            "target_lang_translations": {
                                "zh": "中世纪的兽带图谱经常描绘双头牛犊和其他怪异的<w>畸形怪物</w>。"
                            }
                        },
                        {
                            "text": "The superstitious crowd recoiled from the bizarre creature as if it were a terrifying <w>prodigy</w>.",
                            "target_lang_translations": {
                                "zh": "迷信的人群从这奇特的生物前退缩，仿佛它是一个可怕的<w>怪异怪物</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语、文语）怪事，畸形事物，怪异现象或怪物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "畸形怪异之物",
                                "target_lang_sense_clarification": "反常或怪异的生物或怪物"
                            },
                            {
                                "target_lang_word": "怪异现象",
                                "target_lang_sense_clarification": "违背常理的反常事物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}