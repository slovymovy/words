                            {
                                "example_id": "5ffbd327-092f-485d-9ccb-c0dc08c16cef",
                                "sense_id": "29adc850-5d83-3ee5-a3d9-8dd2e9fe01b2",
                                "text": "Innsbruck übernahm 2005 von Salzburg die Rolle als Sitz der seit 1966 bestehenden Diözese Salzburg und Tirol."
                            },
                            {
                                "example_id": "7e258684-f4eb-4546-a1d1-abc9b0d77560",
                                "sense_id": "29adc850-5d83-3ee5-a3d9-8dd2e9fe01b2",
                                "text": "„Bei großen Räumvorhaben auf der Arlbergbahn kann eine in Innsbruck stationierte selbstfahrende Schneefräse System Beilhack zur Verstärkung angefordert werden.“"
                            }
                        ],
