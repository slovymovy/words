                ],
                "senses": [
                    {
                        "sense_id": "8631e782-4622-3516-9349-3a4ddc5e39ce",
                        "entry_id": "3f9832c6-7a31-3e58-b897-9d373279de3b",
                        "glosses": [
                            "En chasse sous-marine, s’allonger discrètement au fond de l’eau en restant immobile pour que les poissons s’approchent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f6c690-874a-48e8-9444-547129187437",
                                "sense_id": "8631e782-4622-3516-9349-3a4ddc5e39ce",
                                "text": "Le hic étant toujours la profondeur car il faudra vraiment ajuster son lestage si l'on veut agachonner dans 2-3m d’eau maxi."
                            },
                            {
                                "example_id": "24b931b5-4fd1-4136-aa02-3dc968366314",
                                "sense_id": "8631e782-4622-3516-9349-3a4ddc5e39ce",
                                "text": "Mais la progression est très difficile dans un courant très fort, et je décide d’agachonner là où il y a le plus de \"jus\"."
                            },
                            {
                                "example_id": "17c93b91-2b85-4d44-aae3-6fd47eb7aac7",
                                "sense_id": "8631e782-4622-3516-9349-3a4ddc5e39ce",
                                "text": "J’entame une première descente mais pas assez d’eau pour agachonner."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8761e46-43f3-3825-8de5-c098e84e3337",
                        "entry_id": "3f9832c6-7a31-3e58-b897-9d373279de3b",
                        "glosses": [
                            "Attraper en utilisant cette technique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c109056b-3c81-483a-af43-9ab1f13c44ab",
                                "sense_id": "b8761e46-43f3-3825-8de5-c098e84e3337",
                                "text": "Thierry a agachonné une sériole de 30 kilos."
                            }
                        ]
                    }
