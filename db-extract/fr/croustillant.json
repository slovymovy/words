                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0354c1-da4d-4703-9377-c4ac8e8b0ab0",
                                                "sense_id": "e77ff157-52fe-39e6-b022-40f5a6543c8c",
                                                "text": "The Bawdies were girls who danced naked on a ramp in the middle of a room full of tables with tops the size of pie plates."
                                            },
                                            {
                                                "example_id": "ace91689-f5f2-4a2c-aba1-1fa69b81f24c",
                                                "sense_id": "e77ff157-52fe-39e6-b022-40f5a6543c8c",
                                                "text": "Our scholarly studies and discoveries about bodies and bawdies and the forbidden mysteries of S-E-X proved that participatory education had to be the very best."
