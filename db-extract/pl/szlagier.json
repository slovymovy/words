                        "glosses": [
                            "bardzo popularny utwór muzyczny, podbijająca listy przebojów; przebój"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85defbef-84ba-4e61-b598-14bff6b670ac",
                                "sense_id": "ee606177-13db-3946-b245-6f5493d7fc7e",
                                "text": "Większość stacji nadawała popularną muzykę, powtarzała te same szlagiery"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3bdf00fa-cf9d-3f07-9f68-116dd6fb10c5",
                        "entry_id": "4f623757-32fb-3e1b-bbaf-4bf98e1b0279",
                        "glosses": [
                            "gatunek muzyki popularnej, charakteryzujący się sentymentalnymi tekstami i prostą, chwytliwą melodią"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "72cd3b68-9531-31a5-971e-d7a7034a476f",
                        "entry_id": "4f623757-32fb-3e1b-bbaf-4bf98e1b0279",
                        "glosses": [
                            "nowość w swojej dziedzinie, która szybko staje się bardzo popularna i modna; hit"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "e97b5bfe-071e-49b7-a4eb-828bd5f6b864",
                                "sense_id": "72cd3b68-9531-31a5-971e-d7a7034a476f",
                                "text": "W latach 60. szlagierem spółdzielni były pluszowe misie, kaczki i słoniki"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "703d1ba3-afaf-4675-83dd-3e9c2515e5f9",
                        "source_entry_id": "4f623757-32fb-3e1b-bbaf-4bf98e1b0279",
                        "source_sense_id": "ee606177-13db-3946-b245-6f5493d7fc7e",
                        "target_lang_word": "Schlager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4908c214-c967-31ac-bfae-5c569c875d24",
                                        "entry_id": "85baeb51-6f4d-347b-b3b5-db2111c62b40",
                                        "glosses": [
                                            "ein erfolgreiches, viel gehört und gesungenes Musikstück der leichten Unterhaltungsmusik"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26288731-c8df-493b-8ca6-5e1d05cb9ad1",
                                                "sense_id": "4908c214-c967-31ac-bfae-5c569c875d24",
                                                "text": "Der deutsche Schlager war in den 70er Jahren besonders erfolgreich."
                                            },
                                            {
                                                "example_id": "1a8a587e-3b64-436a-a63e-569961137b06",
                                                "sense_id": "4908c214-c967-31ac-bfae-5c569c875d24",
                                                "text": "Ich liebe den Schlager der 20er Jahre."
                                            },
                                            {
                                                "example_id": "7dfed84c-43dd-46ec-8f32-fe6f306cb495",
                                                "sense_id": "4908c214-c967-31ac-bfae-5c569c875d24",
                                                "text": "„Schlagertexter E. A. Franz (…) meint, daß gerade der Schlager es häufig ermöglicht, mit Musik und Text das auszudrücken, was der einfache Mensch denkt und empfindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c593752e-5aa7-3f06-be10-b0cbb3511fe8",
                                        "entry_id": "85baeb51-6f4d-347b-b3b5-db2111c62b40",
                                        "glosses": [
                                            "ein erfolgreich und viel verkauftes Produkt"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3323158-1b02-447e-9f82-5ef5e77b6656",
                                                "sense_id": "c593752e-5aa7-3f06-be10-b0cbb3511fe8",
                                                "text": "Dieses Produkt ist ein absoluter Schlager."
                                            },
                                            {
                                                "example_id": "72b2f23e-ac6f-457a-be16-902090d0c86a",
                                                "sense_id": "c593752e-5aa7-3f06-be10-b0cbb3511fe8",
                                                "text": "„Die Teams wurden mit Unterstützung der Unterhaltungsindustrie zu globalen Marken, die Baseballcaps zu einem der größten Schlager der Modeindustrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "443dd13e-e570-3946-b5ab-53f2bcdaeb9e",
                                        "entry_id": "85baeb51-6f4d-347b-b3b5-db2111c62b40",
                                        "glosses": [
                                            "alles, was durchschlagenden Erfolg hat und außerordentlich schnell und leicht Verbreitung findet (ein guter Witz, ein guter Einfall)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64563519-1c60-4186-9129-d1be7f9e8e55",
                                                "sense_id": "443dd13e-e570-3946-b5ab-53f2bcdaeb9e",
                                                "text": "Die Riesen-Party am Strand war wirklich DER Schlager der Saison!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
