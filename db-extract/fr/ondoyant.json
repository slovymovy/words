                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Vagues ondoyantes."
                            },
                            {
                                "example_id": "4559ac62-2dc2-40b8-bbe2-b75d95c1d31f",
                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Fumée ondoyante."
                            },
                            {
                                "example_id": "4712bead-7aff-4bfc-b097-84429f6ced24",
                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Les moissons, les plaines ondoyantes."
                            },
                            {
