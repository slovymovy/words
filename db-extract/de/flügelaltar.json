                ],
                "senses": [
                    {
                        "sense_id": "61ac4e3a-ecc2-33ac-907f-2c6d899809ef",
                        "entry_id": "e440a1fb-c700-3aab-9fc3-1badbb81f6ed",
                        "glosses": [
                            "eine bis zum ausgehenden Mittelalter vor allem im deutschsprachigen Kulturraum verbreitete Altaraufsatzform, die aus einem Kasten mit Türen besteht. Im geöffneten Zustand stehen die oft kunstvoll bemalten Türen wie Flügel ab."
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "725ca8ab-34e7-4f73-ae92-6bfa039b5407",
                                "sense_id": "61ac4e3a-ecc2-33ac-907f-2c6d899809ef",
                                "text": "Flügelaltare hatten im 15. Jahrhundert ihre größte Blüte, eine Zeit, in der die Verbindung von Gemäldezyklen und Schnitzwerk typisch ist."
                            },
                            {
                                "example_id": "0402ae3d-6c4d-4526-9d6c-10355ad99e7d",
                                "sense_id": "61ac4e3a-ecc2-33ac-907f-2c6d899809ef",
                                "text": "Berühmte Beispiele für Flügelaltäre sind der Genter Altar, der Isenheimer Altar, der Pacher Altar in Sankt Wolfgang und der Veit-Stoß-Altar in Krakau."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
