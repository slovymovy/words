                    }
                ],
                "senses": [
                    {
                        "sense_id": "150cb27a-3d47-30e9-9031-7829efddc4a4",
                        "entry_id": "481f99d6-eea8-3c4f-9d75-6156505133de",
                        "glosses": [
                            "Sicht- und/oder Lichtschutz an Fenstern, der aufgerollt oder gerafft werden kann"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "aeaef77b-46f1-48bd-8beb-14830fa1a2ef",
                                "sense_id": "150cb27a-3d47-30e9-9031-7829efddc4a4",
                                "text": "„Ein Schweizer Hersteller bietet eine Wärmeschutzverglasung mit Lamellen- oder Gewebestoren im Scheibenzwischenraum an. Das Heben und Senken des Storens bzw. die Drehung der Lamellen erfolgt über einen Magnetantrieb, so dass der Scheibenzwischenraum hermetisch verschlossen bleibt. In der Schutzwirkung entspricht diese Konstruktion annähernd einem äusseren Sonnenstoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9da8ae85-f89e-39ad-958d-37b6056c9885",
                        "entry_id": "481f99d6-eea8-3c4f-9d75-6156505133de",
                        "glosses": [
                            "Sonnendach vor Fenstern, auf Balkonen/Terrassen, das aufgerollt oder gerafft werden kann"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "4a03bf9b-4c20-44f2-9d40-e3aa65d4ccec",
                                "sense_id": "9da8ae85-f89e-39ad-958d-37b6056c9885",
                                "text": "Wenn man den orangefarbenen Storen auf unserer Terrasse ausrollt, dann erscheinen die Gartenmöbel in ganz anderen Farben."
                            },
                            {
                                "example_id": "aa4303e3-c17a-4901-8bab-62857a50a4b2",
                                "sense_id": "9da8ae85-f89e-39ad-958d-37b6056c9885",
                                "text": "„Draussen sind [am heissen Nachmittag] die Schaufenster der Bäckereien und Metzgereien halb verhängt oder hinter Storen verborgen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
