{
    "word_family": [
        "scrambler",
        "unscramble",
        "scrambling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                    "sense_definition": "to move hurriedly to a location, especially by using all limbs against a surface",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children had to <w>scramble</w> up the steep hill to reach the playground.",
                            "target_lang_translations": {
                                "ru": "Детям пришлось <w>карабкаться</w> вверх по крутому холму, чтобы добраться до игровой площадки."
                            }
                        },
                        {
                            "text": "When the rain started, everyone began to <w>scramble</w> for cover under the trees.",
                            "target_lang_translations": {
                                "ru": "Когда начался дождь, все начали <w>спешить</w> в поисках укрытия под деревьями."
                            }
                        }
                    ],
                    "synonyms": [
                        "clamber",
                        "scurry",
                        "rush",
                        "climb",
                        "struggle"
                    ],
                    "common_phrases": [
                        "scramble for cover",
                        "scramble up",
                        "scramble back"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро перемещаться, используя все конечности для опоры на поверхность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабкаться",
                                "target_lang_sense_clarification": "взбираться, цепляясь руками и ногами"
                            },
                            {
                                "target_lang_word": "пробираться",
                                "target_lang_sense_clarification": "двигаться через препятствия"
                            },
                            {
                                "target_lang_word": "спешить",
                                "target_lang_sense_clarification": "торопливо направляться куда-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "012881f6-0a81-3226-9b63-d470d4168610",
                    "sense_definition": "to thoroughly combine and cook as a loose mass, typically eggs",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>scramble</w> some eggs with spinach and cheese for our breakfast.",
                            "target_lang_translations": {
                                "ru": "Я <w>приготовлю болтунью</w> из яиц со шпинатом и сыром на завтрак."
                            }
                        },
                        {
                            "text": "She learned how to <w>scramble</w> the mixture over low heat to keep it fluffy.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>взбалтывать</w> смесь на медленном огне, чтобы она оставалась пышной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scramble eggs"
                    ],
                    "target_lang_definitions": {
                        "ru": "тщательно перемешивать и готовить в виде рыхлой массы, обычно яйца"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать болтунью",
                                "target_lang_sense_clarification": "готовить яйца, перемешивая их"
                            },
                            {
                                "target_lang_word": "взбалтывать",
                                "target_lang_sense_clarification": "перемешивать ингредиенты перед жаркой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "454150ce-14b1-3840-bf85-f989b39d39ba",
                    "sense_definition": "to process telecommunication signals to make them unintelligible to an unauthorized listener",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military uses advanced technology to <w>scramble</w> their radio communications.",
                            "target_lang_translations": {
                                "ru": "Военные используют передовые технологии, чтобы <w>шифровать</w> свои радиопереговоры."
                            }
                        },
                        {
                            "text": "The cable company will <w>scramble</w> the signal if the bill is not paid.",
                            "target_lang_translations": {
                                "ru": "Кабельная компания <w>закодирует</w> сигнал, если счет не будет оплачен."
                            }
                        }
                    ],
                    "synonyms": [
                        "encrypt",
                        "encode"
                    ],
                    "antonyms": [
                        "unscramble",
                        "decode"
                    ],
                    "common_phrases": [
                        "scramble the signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "обрабатывать телекоммуникационные сигналы, чтобы сделать их непонятными для несанкционированного слушателя"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шифровать",
                                "target_lang_sense_clarification": "кодировать сигнал"
                            },
                            {
                                "target_lang_word": "засекречивать",
                                "target_lang_sense_clarification": "делать информацию недоступной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa3f2f4-b923-33ff-a18d-69d691d5e7d4",
                    "sense_definition": "to quickly deploy aircraft or vehicles to a destination in response to an alert",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air force had to <w>scramble</w> the jets as soon as the radar detected the intrusion.",
                            "target_lang_translations": {
                                "ru": "Военно-воздушным силам пришлось <w>поднять по тревоге</w> истребители, как только радар обнаружил вторжение."
                            }
                        },
                        {
                            "text": "They decided to <w>scramble</w> the emergency response team after the alarm went off.",
                            "target_lang_translations": {
                                "ru": "Они решили экстренно <w>направить</w> группу быстрого реагирования после того, как сработала сигнализация."
                            }
                        }
                    ],
                    "synonyms": [
                        "deploy",
                        "dispatch"
                    ],
                    "common_phrases": [
                        "scramble the jets"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро направлять самолеты или транспортные средства в пункт назначения в ответ на сигнал тревоги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать по тревоге",
                                "target_lang_sense_clarification": "срочно отправлять на задание"
                            },
                            {
                                "target_lang_word": "взлетать по тревоге",
                                "target_lang_sense_clarification": "о самолетах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "624bc014-25ae-3f02-bcfe-4fa06636c2a6",
                    "sense_definition": "to permute parts of a puzzle, like a Rubik's Cube, until it is ready to be solved",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>scramble</w> the cube thoroughly before you give it to me to solve.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, хорошенько <w>перемешай</w> кубик, прежде чем давать его мне собирать."
                            }
                        },
                        {
                            "text": "It only takes a few seconds to <w>scramble</w> the puzzle into a difficult state.",
                            "target_lang_translations": {
                                "ru": "Требуется всего несколько секунд, чтобы <w>запутать</w> головоломку до сложного состояния."
                            }
                        }
                    ],
                    "synonyms": [
                        "mix up",
                        "jumble",
                        "shuffle",
                        "rearrange"
                    ],
                    "antonyms": [
                        "solve"
                    ],
                    "target_lang_definitions": {
                        "ru": "перемешивать части головоломки, пока она не будет готова к решению"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "запутывать детали головоломки"
                            },
                            {
                                "target_lang_word": "разбирать",
                                "target_lang_sense_clarification": "приводить пазл в исходное состояние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44ffdd1c-8e03-336d-83a7-7037485542c5",
                    "sense_definition": "a rush or hurry, especially making use of the limbs against a surface",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a last-minute <w>scramble</w> to the finish line as the runners neared the end.",
                            "target_lang_translations": {
                                "ru": "На последней минуте у финишной черты началась <w>спешка</w>, когда бегуны приблизились к концу дистанции."
                            }
                        },
                        {
                            "text": "The hikers faced a difficult <w>scramble</w> over the rocks to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Туристам предстояло трудное <w>карабканье</w> по скалам, чтобы достичь вершины."
                            }
                        }
                    ],
                    "synonyms": [
                        "clamber",
                        "rush",
                        "climb",
                        "struggle"
                    ],
                    "common_phrases": [
                        "last-minute scramble"
                    ],
                    "target_lang_definitions": {
                        "ru": "спешка или поспешное движение, особенно с использованием рук и ног"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карабканье",
                                "target_lang_sense_clarification": "подъем по крутой поверхности"
                            },
                            {
                                "target_lang_word": "спешка",
                                "target_lang_sense_clarification": "торопливое движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82f83c66-cdf4-3675-99fa-4cb16be2e0e5",
                    "sense_definition": "any frantic period of competitive activity",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalmouth <w>scramble</w> resulted in a surprising point for the home team.",
                            "target_lang_translations": {
                                "ru": "<w>Свалка</w> у ворот принесла неожиданное очко домашней команде."
                            }
                        },
                        {
                            "text": "There was an unseemly <w>scramble</w> for the remaining tickets to the concert.",
                            "target_lang_translations": {
                                "ru": "Начался неприглядный <w>ажиотаж</w> из-за оставшихся билетов на концерт."
                            }
                        }
                    ],
                    "synonyms": [
                        "struggle",
                        "free-for-all"
                    ],
                    "common_phrases": [
                        "goalmouth scramble",
                        "scramble for tickets"
                    ],
                    "target_lang_definitions": {
                        "ru": "любой период лихорадочной конкурентной деятельности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ажиотаж",
                                "target_lang_sense_clarification": "повышенный спрос или борьба интересов"
                            },
                            {
                                "target_lang_word": "свалка",
                                "target_lang_sense_clarification": "беспорядочная борьба за что-то"
                            },
                            {
                                "target_lang_word": "запарка",
                                "target_lang_sense_clarification": "напряженная деятельность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac0b0fa8-4037-37e3-941d-746e69e10cf1",
                    "sense_definition": "a dish involving scrambled eggs and a variety of other ingredients",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diner's menu features a delicious farmer's <w>scramble</w> with potatoes and ham.",
                            "target_lang_translations": {
                                "ru": "В меню закусочной есть вкусная фермерская <w>болтунья</w> с картофелем и ветчиной."
                            }
                        },
                        {
                            "text": "I ordered a vegetable <w>scramble</w> for brunch at the local cafe.",
                            "target_lang_translations": {
                                "ru": "Я заказал овощную <w>яичницу-болтунью</w> на бранч в местном кафе."
                            }
                        }
                    ],
                    "synonyms": [
                        "hash"
                    ],
                    "target_lang_definitions": {
                        "ru": "блюдо из яиц-болтуньи с добавлением различных ингредиентов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтунья",
                                "target_lang_sense_clarification": "яичница из перемешанных яиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "04e54d26-d8b4-3a73-b921-76941d229b72",
                    "sense_definition": "shouted when something desirable is thrown into a group of people to cause a rush for it",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man threw the coins into the crowd and yelled \"<w>scramble</w>!\" to start the fun.",
                            "target_lang_translations": {
                                "ru": "Мужчина бросил монеты в толпу и крикнул «<w>налетай</w>!», чтобы начать веселье."
                            }
                        },
                        {
                            "text": "As the candy was tossed from the float, the children heard the cry of \"<w>scramble</w>!\"",
                            "target_lang_translations": {
                                "ru": "Когда с платформы посыпались конфеты, дети услышали крик «<w>хватай</w>!»."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a command or exclamation in specific social contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "возглас, когда что-то желанное бросают в толпу, чтобы вызвать борьбу за это"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хватай!",
                                "target_lang_sense_clarification": "призыв ловить брошенное"
                            },
                            {
                                "target_lang_word": "налетай!",
                                "target_lang_sense_clarification": "призыв к толпе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}