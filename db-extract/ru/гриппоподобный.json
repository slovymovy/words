                                        "sense_id": "50788cc0-77c9-377b-93ab-bdfdd3c344f4",
                                        "entry_id": "42fdfcc0-6802-366e-8d00-14df43939d7c",
                                        "glosses": [
                                            "Resembling or characteristic of influenza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9965d7d8-8536-4cd0-b689-8708e3fdfdec",
                                                "sense_id": "50788cc0-77c9-377b-93ab-bdfdd3c344f4",
                                                "text": "The patient presented with flulike symptoms."
                                            }
