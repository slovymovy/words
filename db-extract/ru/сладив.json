        "ru-extract.jsonl": [
            {
                "entry_id": "209b6eba-5c92-3d29-92a3-59cbf9ff3033",
                "word": "сладив",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3737f9f7-e1d4-3414-9ba9-753a80234aff",
                        "entry_id": "209b6eba-5c92-3d29-92a3-59cbf9ff3033",
                        "glosses": [
                            "сделав, смастерив"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9f5293-ca5e-4489-b698-c0a35a7fc6e2",
                                "sense_id": "3737f9f7-e1d4-3414-9ba9-753a80234aff",
                                "text": "Сладив клиентке стайл-хаер в модном тренде, куафер с гордостью передал её кавалеру."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d8ef997-2d4c-382e-94c6-21aecbbca306",
                        "entry_id": "209b6eba-5c92-3d29-92a3-59cbf9ff3033",
                        "glosses": [
                            "настроив, подобрав"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d5ab15-ea77-45a3-a428-63fd75bfdd0c",
                                "sense_id": "5d8ef997-2d4c-382e-94c6-21aecbbca306",
                                "text": "Сладив строй бедного инструмента своего, он заиграл швейцарскую песню: Rance de vache."
                            }
                        ]
                    },
                    {
                        "sense_id": "eebb77fa-55a6-384b-860e-fc8a83fe8bd3",
                        "entry_id": "209b6eba-5c92-3d29-92a3-59cbf9ff3033",
                        "glosses": [
                            "устроив, уладив"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942578e5-86b7-4e5e-af61-b702c2b4219b",
                                "sense_id": "eebb77fa-55a6-384b-860e-fc8a83fe8bd3",
                                "text": "Сладив дело, все возвратились на дачу."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c25a0ca-b680-3041-aa6c-9b51663ed01e",
                        "entry_id": "209b6eba-5c92-3d29-92a3-59cbf9ff3033",
                        "glosses": [
                            "совладав, одолев, осилив"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "688a2e35-9dac-4db6-8a51-f766aee7e896",
                                "sense_id": "0c25a0ca-b680-3041-aa6c-9b51663ed01e",
                                "text": "Не сладив с замком, Мила переключилась мыслями на мужчин, что прошли мимо нее вверх по лестнице…"
                            }
                        ]
                    }
                ],
