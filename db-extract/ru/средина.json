                                            {
                                                "example_id": "010cbd96-fa10-4412-8ec5-08aa1ffb87c6",
                                                "sense_id": "c6a182bc-d245-39f4-b7cc-600f875e978b",
                                                "text": "Passing through the silent village, he heard the clock tell the mid hour of night."
                                            }
                                        ]
