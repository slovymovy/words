                        "examples": [
                            {
                                "example_id": "ccb31af1-14c2-4596-ab06-99d724be8d5a",
                                "sense_id": "5a25c1cc-9947-37c0-9bbe-49b477b3fd23",
                                "text": "De versierselen bestaan uit een zilveren dubbelgepunte achtarmige ster met een medaillon aan een lint, die Rieu voortaan op de linkerborst mag dragen. Rieu krijgt de prijs wegens het uitdragen en populair maken van de klassieke muziek in de hele wereld, en met name in Frankrijk."
                            },
                            {
                                "example_id": "c92c8492-3896-45a0-b6e2-c0acf8e42f7d",
                                "sense_id": "5a25c1cc-9947-37c0-9bbe-49b477b3fd23",
                                "text": "Tijdens Chanoeka herdenken de joden de herinwijding van de Tempel in Jeruzalem in 164 voor Christus. Elke avond van het Chanoekafeest wordt een extra kaars aangestoken van de Chanoekia, de achtarmige kandelaar."
                            },
                            {
                                "example_id": "61702a4b-aa0a-40a5-9165-34c379f06cfd",
                                "sense_id": "5a25c1cc-9947-37c0-9bbe-49b477b3fd23",
                                "text": "De kat dankt zijn rol aan enkele juiste voorspellingen bij de Confederations Cup vorig jaar en treedt zo in de sporen van dierlijke visionairs als octopus Paul, het achtarmige beest uit een Duits aquarium dat bij het WK 2010 werd gehyped als voorspeller van juiste scores."
                            }
                        ]
