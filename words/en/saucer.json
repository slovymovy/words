{
    "word_family": [
        "sauce",
        "saucy",
        "saucepan"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "129cf02e-8c51-3603-8948-82243118b0ed",
                    "sense_definition": "A small shallow dish to hold a cup and catch drips.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dishware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed the tea cup carefully back onto the <w>saucer</w> after taking a sip.",
                            "target_lang_translations": {
                                "ru": "Сделав глоток, она осторожно поставила чайную чашку обратно на <w>блюдце</w>."
                            }
                        },
                        {
                            "text": "The waiter brought a clean cup and <w>saucer</w> to the table for the guest.",
                            "target_lang_translations": {
                                "ru": "Официант принес гостю чистую <w>чайную пару</w> (чашку с блюдцем)."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup and saucer",
                        "matching saucer",
                        "ceramic saucer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая неглубокая тарелочка, на которую ставят чашку, чтобы капли не попадали на стол."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блюдце",
                                "target_lang_sense_clarification": "подставка под чашку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "912571fa-56b3-3cee-bcee-9f88eea48247",
                    "sense_definition": "An object round and gently curved, shaped like a saucer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness described seeing a flying <w>saucer</w> hovering silently above the trees.",
                            "target_lang_translations": {
                                "ru": "Свидетель описал, как видел летающую <w>тарелку</w>, бесшумно парящую над деревьями."
                            }
                        },
                        {
                            "text": "The architect designed a roof that looked like a giant <w>saucer</w> from above.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал крышу, которая сверху выглядела как гигантское <w>блюдце</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disk"
                    ],
                    "common_phrases": [
                        "flying saucer",
                        "saucer shaped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглый и слегка изогнутый объект, по форме напоминающий блюдце."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блюдце",
                                "target_lang_sense_clarification": "о предмете круглой формы"
                            },
                            {
                                "target_lang_word": "диск",
                                "target_lang_sense_clarification": "плоский круглый объект"
                            },
                            {
                                "target_lang_word": "тарелка",
                                "target_lang_sense_clarification": "в контексте НЛО"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a808b16-7b49-3f7f-85a6-e0f0a8dde4c4",
                    "sense_definition": "A circular sled without runners.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children grabbed their plastic <w>saucer</w> and ran to the top of the snowy hill.",
                            "target_lang_translations": {
                                "ru": "Дети схватили свою пластиковую <w>ледянку</w> и побежали на вершину заснеженного холма."
                            }
                        },
                        {
                            "text": "It is much harder to steer a <w>saucer</w> than a traditional wooden sled.",
                            "target_lang_translations": {
                                "ru": "Управлять <w>ледянкой-тарелкой</w> гораздо сложнее, чем традиционными деревянными санками."
                            }
                        }
                    ],
                    "synonyms": [
                        "sled"
                    ],
                    "common_phrases": [
                        "snow saucer",
                        "plastic saucer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглые санки без полозьев для катания с гор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ледянка",
                                "target_lang_sense_clarification": "круглые санки-тарелка"
                            },
                            {
                                "target_lang_word": "тарелка",
                                "target_lang_sense_clarification": "пластиковые санки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c85243e1-c8d2-3273-a375-676250be0c68",
                    "sense_definition": "A small pan or other vessel-like food container in which sauce was set on a table.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dishware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical exhibit, they displayed an ornate silver <w>saucer</w> used for gravy.",
                            "target_lang_translations": {
                                "ru": "В исторической экспозиции было представлено богато украшенное серебряное <w>блюдце</w> для подливки."
                            }
                        },
                        {
                            "text": "The old recipe suggested serving the condiment in a small <w>saucer</w> beside the meat.",
                            "target_lang_translations": {
                                "ru": "В старом рецепте предлагалось подавать приправу в маленьком <w>соуснике</w> рядом с мясом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical use for sauce containers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая емкость или сосуд для подачи соуса на стол."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соусник",
                                "target_lang_sense_clarification": "сосуд для соуса"
                            },
                            {
                                "target_lang_word": "блюдце",
                                "target_lang_sense_clarification": "историческая посуда для соуса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26299dbf-46d2-3c84-a4b9-7e9186e359bd",
                    "sense_definition": "A shallow socket for the pivot of a capstan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer inspected the <w>saucer</w> to ensure the capstan would rotate smoothly.",
                            "target_lang_translations": {
                                "ru": "Инженер осмотрел <w>подпятник</w>, чтобы убедиться, что кабестан будет вращаться плавно."
                            }
                        },
                        {
                            "text": "Grease was applied to the <w>saucer</w> to reduce friction during the heavy lifting.",
                            "target_lang_translations": {
                                "ru": "На <w>опору</w> нанесли смазку, чтобы уменьшить трение при подъеме тяжестей."
                            }
                        }
                    ],
                    "synonyms": [
                        "socket"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical nautical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неглубокое гнездо или опора для оси кабестана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпятник",
                                "target_lang_sense_clarification": "техническая опора вала"
                            },
                            {
                                "target_lang_word": "гнездо",
                                "target_lang_sense_clarification": "углубление для оси"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f343b0c-4ef7-31f2-89a6-f8fe5129e18a",
                    "sense_definition": "A flat, shallow caisson for raising sunken ships.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salvage crew positioned the <w>saucer</w> beneath the hull of the wrecked vessel.",
                            "target_lang_translations": {
                                "ru": "Спасательная команда установила <w>кессон</w> под корпусом затонувшего судна."
                            }
                        },
                        {
                            "text": "Using a specialized <w>saucer</w>, they managed to lift the ship from the seabed.",
                            "target_lang_translations": {
                                "ru": "С помощью специального <w>подъемного понтона</w> им удалось поднять корабль с морского дна."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical maritime term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоский неглубокий кессон, используемый для подъема затонувших судов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кессон",
                                "target_lang_sense_clarification": "устройство для подъема судов"
                            },
                            {
                                "target_lang_word": "понтон",
                                "target_lang_sense_clarification": "плавучая опора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1242e67-fda6-3505-be28-d8726ee67c2c",
                    "sense_definition": "Of the eyes: to become large and round.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His eyes <w>saucered</w> with surprise when he saw the size of the birthday cake.",
                            "target_lang_translations": {
                                "ru": "Его глаза <w>округлились</w> от удивления, когда он увидел размер праздничного торта."
                            }
                        },
                        {
                            "text": "The child's eyes <w>saucered</w> in fear as the shadow moved across the wall.",
                            "target_lang_translations": {
                                "ru": "Глаза ребенка <w>стали как блюдца</w> от страха, когда по стене метнулась тень."
                            }
                        }
                    ],
                    "synonyms": [
                        "widen"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "eyes saucered"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "descriptive of facial expressions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О глазах: становиться большими и круглыми от удивления или страха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "округлиться",
                                "target_lang_sense_clarification": "стать круглым (о глазах)"
                            },
                            {
                                "target_lang_word": "стать как блюдца",
                                "target_lang_sense_clarification": "сильно расшириться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f31e096-ffce-3a77-a060-a7445e16222b",
                    "sense_definition": "To pour tea or other liquids from the cup into the saucer in order to cool it before drinking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man would <w>saucer</w> his tea just like his grandfather used to do.",
                            "target_lang_translations": {
                                "ru": "Старик <w>пил чай из блюдца</w>, совсем как его дед в свое время."
                            }
                        },
                        {
                            "text": "She watched him <w>saucer</w> the hot liquid to avoid burning his tongue.",
                            "target_lang_translations": {
                                "ru": "Она наблюдала, как он <w>наливает в блюдце</w> горячую жидкость, чтобы не обжечь язык."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saucer tea"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "an old-fashioned custom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наливать чай или другую жидкость из чашки в блюдце, чтобы она быстрее остыла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пить из блюдца",
                                "target_lang_sense_clarification": "наливать в блюдце для охлаждения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}