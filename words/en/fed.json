    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "852134be-e9ed-3735-8078-6e1e97bfcb8a",
                    "sense_definition": "The simple past tense and past participle of <w>feed</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>fed</w> the dog before I left for work this morning.",
                            "target_lang_translations": {
                                "ru": "Я <w>покормил</w> собаку перед уходом на работу сегодня утром.",
                                "tr": "Bu sabah işe gitmeden önce köpeği <w>besledim</w>."
                            }
                        },
                        {
                            "text": "The baby has already been <w>fed</w> and is sleeping now.",
                            "target_lang_translations": {
                                "ru": "Ребенок уже <w>накормлен</w> и сейчас спит.",
                                "tr": "Bebek çoktan <w>beslendi</w> ve şu an uyuyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fed up",
                        "well fed",
                        "force-fed",
                        "spoon-fed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола feed (кормить).",
                        "tr": "Feed (beslemek) fiilinin geçmiş zaman ve geçmiş zaman ortacı hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормил",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "покормил",
                                "target_lang_sense_clarification": "прошедшее время, совершенный вид"
                            },
                            {
                                "target_lang_word": "накормлен",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "besledi",
                                "target_lang_sense_clarification": "geçmiş zaman"
                            },
                            {
                                "target_lang_word": "beslenmiş",
                                "target_lang_sense_clarification": "geçmiş zaman ortacı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "50a299a8-dd58-3aef-bde1-f4b827b7f18e",
                    "sense_definition": "The central banking system of the United States; short for the Federal Reserve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Investors are waiting to see if the <w>Fed</w> will raise interest rates again.",
                            "target_lang_translations": {
                                "ru": "Инвесторы ждут, повысит ли <w>ФРС</w> процентные ставки снова.",
                                "tr": "Yatırımcılar <w>FED</w>'in faiz oranlarını tekrar artırıp artırmayacağını görmek için bekliyor."
                            }
                        },
                        {
                            "text": "The report suggests that the <w>Fed</w> is concerned about inflation.",
                            "target_lang_translations": {
                                "ru": "В отчете говорится, что <w>ФРС</w> обеспокоена инфляцией.",
                                "tr": "Rapor, <w>FED</w>'in enflasyon konusunda endişeli olduğunu gösteriyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Fed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральная банковская система США; сокращение от Федеральной резервной системы.",
                        "tr": "Amerika Birleşik Devletleri'nin merkez bankacılık sistemi; Federal Rezerv'in kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ФРС",
                                "target_lang_sense_clarification": "аббревиатура"
                            },
                            {
                                "target_lang_word": "Федрезерв",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "FED",
                                "target_lang_sense_clarification": "kısaltma"
                            },
                            {
                                "target_lang_word": "Amerikan Merkez Bankası",
                                "target_lang_sense_clarification": "resmi karşılık"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d3cb86f-093d-3538-bd27-fba9c67debbb",
                    "sense_definition": "An officer or official of the federal government, particularly a federal law enforcement agent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was worried that the <w>feds</w> were monitoring his phone calls.",
                            "target_lang_translations": {
                                "ru": "Он беспокоился, что <w>федералы</w> прослушивают его телефонные звонки.",
                                "tr": "Telefon görüşmelerinin <w>federal ajanlar</w> tarafından izlendiğinden endişeleniyordu."
                            }
                        },
                        {
                            "text": "The local police had to hand the investigation over to the <w>feds</w>.",
                            "target_lang_translations": {
                                "ru": "Местной полиции пришлось передать расследование <w>федералам</w>.",
                                "tr": "Yerel polis, soruşturmayı <w>federal ajanlara</w> devretmek zorunda kaldı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо федерального правительства, в частности федеральный агент правоохранительных органов.",
                        "tr": "Federal hükümetin bir görevlisi, özellikle federal bir kolluk kuvveti ajanı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "федерал",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "агент ФБР",
                                "target_lang_sense_clarification": "контекстуальное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "federal ajan",
                                "target_lang_sense_clarification": "kolluk kuvveti"
                            },
                            {
                                "target_lang_word": "federal görevli",
                                "target_lang_sense_clarification": "resmi görevli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdd9a05d-c54e-3296-bfc5-85b568797d6f",
                    "sense_definition": "A police officer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "law_enforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone scattered when they saw the <w>feds</w> turn the corner.",
                            "target_lang_translations": {
                                "ru": "Все разбежались, когда увидели, что из-за угла вышли <w>легавые</w>.",
                                "tr": "<w>Polislerin</w> köşeyi döndüğünü görünce herkes dağıldı."
                            }
                        },
                        {
                            "text": "He got arrested by the <w>feds</w> for causing a disturbance downtown.",
                            "target_lang_translations": {
                                "ru": "Его арестовали <w>копы</w> за нарушение порядка в центре города.",
                                "tr": "Şehir merkezinde huzursuzluk çıkardığı için <w>polisler</w> tarafından tutuklandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "cop",
                        "police",
                        "fuzz",
                        "flatfoot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский.",
                        "tr": "Polis memuru."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легавый",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "коп",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "polis",
                                "target_lang_sense_clarification": "genel"
                            },
                            {
                                "target_lang_word": "memur",
                                "target_lang_sense_clarification": "kolluk kuvveti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56dfaec8-690e-3634-8efc-535cbbbdcb7e",
                    "sense_definition": "Short for federation, often used in sports or organizations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She plans to compete in a different wrestling <w>fed</w> next season.",
                            "target_lang_translations": {
                                "ru": "В следующем сезоне она планирует выступать в другой рестлинг-<w>федерации</w>.",
                                "tr": "Gelecek sezon farklı bir güreş <w>federasyonunda</w> yarışmayı planlıyor."
                            }
                        },
                        {
                            "text": "The local <w>fed</w> organizes tournaments for amateur players.",
                            "target_lang_translations": {
                                "ru": "Местная <w>федерация</w> организует турниры для любителей.",
                                "tr": "Yerel <w>federasyon</w> amatör oyuncular için turnuvalar düzenliyor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"федерация\", часто используется в спорте или организациях.",
                        "tr": "Federasyon kelimesinin kısaltması, genellikle spor veya organizasyonlarda kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
