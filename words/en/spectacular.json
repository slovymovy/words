{
    "word_family": [
        "spectacle",
        "spectator",
        "spectacularly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd9679ff-12c6-3ab5-89d3-45c48b782c02",
                    "sense_definition": "Amazing, impressive, or worthy of special notice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the mountain top was absolutely <w>spectacular</w>.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был совершенно <w>потрясающим</w>.",
                                "tr": "Dağın tepesinden manzara kesinlikle <w>muhteşemdi</w>."
                            }
                        },
                        {
                            "text": "Despite the rain, the team achieved a <w>spectacular</w> victory in the final game.",
                            "target_lang_translations": {
                                "ru": "Несмотря на дождь, команда одержала <w>эффектную</w> победу в финальной игре.",
                                "tr": "Yağmura rağmen takım, final maçında <w>görkemli</w> bir galibiyet elde etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "impressive",
                        "breathtaking",
                        "stunning",
                        "magnificent",
                        "striking",
                        "amazing"
                    ],
                    "antonyms": [
                        "unimpressive",
                        "ordinary",
                        "dull"
                    ],
                    "common_phrases": [
                        "spectacular view",
                        "spectacular scenery",
                        "spectacular success",
                        "spectacular failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поразительный, впечатляющий или заслуживающий особого внимания.",
                        "tr": "Harika, etkileyici veya özel olarak dikkat çekmeye değer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "ошеломляющий, великолепный"
                            },
                            {
                                "target_lang_word": "впечатляющий",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            },
                            {
                                "target_lang_word": "эффе́ктный",
                                "target_lang_sense_clarification": "броский, производящий эффект"
                            },
                            {
                                "target_lang_word": "захва́тывающий",
                                "target_lang_sense_clarification": "увлекательный, перехватывающий дыхание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muhteşem",
                                "target_lang_sense_clarification": "olağanüstü, görkemli ve harika"
                            },
                            {
                                "target_lang_word": "etkileyici",
                                "target_lang_sense_clarification": "derin iz bırakan, dikkat çekici"
                            },
                            {
                                "target_lang_word": "göz alıcı",
                                "target_lang_sense_clarification": "güzelliğiyle büyüleyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c473719b-d4fa-3cc8-8b3e-fa7c2b313490",
                    "sense_definition": "Relating to or characteristic of a large-scale public show or entertainment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director is famous for his <w>spectacular</w> style of filmmaking.",
                            "target_lang_translations": {
                                "ru": "Режиссёр известен своим <w>зрелищным</w> стилем киносъёмки.",
                                "tr": "Yönetmen, <w>görkemli</w> film yapım tarzıyla tanınır."
                            }
                        },
                        {
                            "text": "The circus provided a <w>spectacular</w> entertainment experience for the whole family.",
                            "target_lang_translations": {
                                "ru": "Цирк обеспечил <w>зрелищное</w> развлечение для всей семьи.",
                                "tr": "Sirk, tüm aile için <w>seyirlik</w> bir eğlence deneyimi sundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "theatrical",
                        "dramatic"
                    ],
                    "common_phrases": [
                        "spectacular effects",
                        "spectacular production"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к масштабному публичному шоу или развлечению; характерный для спектакля.",
                        "tr": "Büyük ölçekli halka açık bir gösteri veya eğlence ile ilgili ya da buna özgü olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зре́лищный",
                                "target_lang_sense_clarification": "красочный, театральный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seyirlik",
                                "target_lang_sense_clarification": "izlemeye değer, gösteri niteliğinde olan"
                            },
                            {
                                "target_lang_word": "görkemli",
                                "target_lang_sense_clarification": "gösterişli ve büyüleyici"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f67d694-5aa0-3032-b7cb-76e3c7147a33",
                    "sense_definition": "A large-scale, impressive public show or display.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The television <w>spectacular</w> was watched by millions of people around the world.",
                            "target_lang_translations": {
                                "ru": "Это телевизионное <w>шоу</w> смотрели миллионы людей по всему миру.",
                                "tr": "Televizyon <w>şovu</w> dünya çapında milyonlarca kişi tarafından izlendi."
                            }
                        },
                        {
                            "text": "We bought tickets to see the holiday <w>spectacular</w> at the grand theater.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты на праздничное <w>представление</w> в большом театре.",
                                "tr": "Büyük tiyatrodaki tatil <w>gösterisini</w> izlemek için bilet aldık."
                            }
                        }
                    ],
                    "synonyms": [
                        "extravaganza",
                        "spectacle",
                        "show"
                    ],
                    "common_phrases": [
                        "holiday spectacular",
                        "musical spectacular",
                        "television spectacular"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масштабное, впечатляющее публичное шоу или представление.",
                        "tr": "Büyük ölçekli, etkileyici halka açık gösteri veya sahne oyunu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоу",
                                "target_lang_sense_clarification": "развлекательное представление"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "спектакль, выступление"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gösteri",
                                "target_lang_sense_clarification": "büyük ve etkileyici şov veya sahne performansı"
                            },
                            {
                                "target_lang_word": "şov",
                                "target_lang_sense_clarification": "eğlenceli ve görkemli halk gösterisi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}