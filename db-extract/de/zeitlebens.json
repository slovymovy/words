                        "sense_id": "462988a5-e165-3ba9-b2a8-e4a13fc7b5e8",
                        "entry_id": "2a18260e-27de-3250-9255-e59ebfee9140",
                        "glosses": [
                            "all of one’s life; throughout one’s life (now usually referring to a deceased person)"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7f350914-4aab-414a-bf69-463b9c352c05",
                                "sense_id": "462988a5-e165-3ba9-b2a8-e4a13fc7b5e8",
                                "text": "Er hat sich zeitlebens für unterdrückte Völker eingesetzt.",
                                "translation": "He was a champion of oppressed peoples all his life.",
                                "english": "He was a champion of oppressed peoples all his life."
                            },
                            {
                                "example_id": "457d223d-e71c-4ba6-9b77-15d10b53043f",
                                "sense_id": "462988a5-e165-3ba9-b2a8-e4a13fc7b5e8",
                                "text": "Wenn ich einen Menschen kennenlerne, frage ich sogleich: womit beschäftigt er sich? und wie? und in welcher Folge? und mit der Beantwortung der Frage ist auch mein Interesse an ihm auf zeitlebens entschieden.",
                                "translation": "Wilhelm Meister's Apprenticeship",
                                "english": "Wilhelm Meister's Apprenticeship"
                            },
                            {
                                "example_id": "2cc65dc0-39de-4f3e-a2b0-c8fc3d8ab5dc",
                                "sense_id": "462988a5-e165-3ba9-b2a8-e4a13fc7b5e8",
                                "text": "Zeitlebens litt Hall unter Depressionen, seine Selbstmedikation war Alkohol. So erklärten sich die traurigen Augen von Terry Hall."
                            }
                        ]
                    }
