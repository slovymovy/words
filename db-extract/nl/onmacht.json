        "nl-extract.jsonl": [
            {
                "entry_id": "6e10e0ac-9731-3c1c-9a1b-989f676b8c57",
                "word": "onmacht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                        "entry_id": "6e10e0ac-9731-3c1c-9a1b-989f676b8c57",
                        "glosses": [
                            "het niet kunnen doen wat je graag wilt of nodig hebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89510c97-c0d4-4b86-982c-cf0426b62075",
                                "sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                                "text": "Zij schreeuwde uit woede en onmacht."
                            },
                            {
                                "example_id": "8db0fa7c-5a4a-4390-a286-a7d59fb756e3",
                                "sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                                "text": "Trump is uit ander hout gesneden – eerder dat van keizer Nero. Zijn corruptie komt niet voort uit onmacht (Harding) of politieke paranoia (Nixon), het is een geloofsartikel. Trump maakt van het presidentschap zijn bezit, een merk – het ideale verdienmodel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9c68063-e12f-44d4-bd6d-190219382aa0",
                        "source_entry_id": "6e10e0ac-9731-3c1c-9a1b-989f676b8c57",
                        "source_sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                        "target_lang_word": "Ohnmacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohnmacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f715f87-db1e-3e29-b195-325b8e2d64f0",
                                        "entry_id": "642b1af9-7eb3-3ebb-8b87-0360f7ce1594",
                                        "glosses": [
                                            "vorübergehende Bewusstlosigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7682baa4-47c4-4788-9150-7ebbd3efc9c0",
                                                "sense_id": "1f715f87-db1e-3e29-b195-325b8e2d64f0",
                                                "text": "Er fiel in Ohnmacht. Die Sinne schwanden ihm, und er lag lange in tiefer Ohnmacht und kam dann auch nur langsam zu sich."
                                            },
                                            {
                                                "example_id": "7fdbefa9-3c14-4c2f-84b0-8e5e4ff0d792",
                                                "sense_id": "1f715f87-db1e-3e29-b195-325b8e2d64f0",
                                                "text": "„Die Ohnmacht verließ ihn nur so weit, daß sich allein der Rauschzustand in seinem Bewußtsein bewegte.“"
                                            },
                                            {
                                                "example_id": "f6ca9bdc-95c9-4ae3-8855-65a2af5c59dd",
                                                "sense_id": "1f715f87-db1e-3e29-b195-325b8e2d64f0",
                                                "text": "„Schon als er im Wald dem Bauern begegnet war, hatte Benjamin als Familienvater um Gnade gebeten, bevor er in Ohnmacht fiel.“"
                                            },
                                            {
                                                "example_id": "03bb7bd4-ca55-4513-87d2-bf805d322f0d",
                                                "sense_id": "1f715f87-db1e-3e29-b195-325b8e2d64f0",
                                                "text": "„Das waren meine Gedanken nach ihrer Ohnmacht, und sie konnten in mir erst wirksam werden, als sie ausreiften.“"
                                            },
                                            {
                                                "example_id": "9b2e5559-af1b-4308-bd59-660cbda8d32c",
                                                "sense_id": "1f715f87-db1e-3e29-b195-325b8e2d64f0",
                                                "text": "„Aber ehe sie's erreichen konnte, wurde sie wie von einer Ohnmacht überrascht und sank auf der Schwelle des Balkons nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "980ee439-4acc-3097-a144-bca87e14e227",
                                        "entry_id": "642b1af9-7eb3-3ebb-8b87-0360f7ce1594",
                                        "glosses": [
                                            "Unfähigkeit, etwas zu tun"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af35bd37-105a-45f0-a5dd-a624c4821b10",
                                                "sense_id": "980ee439-4acc-3097-a144-bca87e14e227",
                                                "text": "Die Ohnmacht Liechtensteins lag auf der Hand, und so musste es auf europäischen Druck sein Bankgeheimnis lüften."
                                            },
                                            {
                                                "example_id": "5660588c-897e-4e4b-9aca-aa614ab87ae0",
                                                "sense_id": "980ee439-4acc-3097-a144-bca87e14e227",
                                                "text": "„Diese Ohnmacht verschärft für viele die Lage nur noch weiter.“"
                                            },
                                            {
                                                "example_id": "023f3c01-be57-4d1e-922c-0a3becb78d03",
                                                "sense_id": "980ee439-4acc-3097-a144-bca87e14e227",
                                                "text": "„Aber die Ohnmacht lähmt.“"
                                            },
                                            {
                                                "example_id": "da5c11c9-f4f8-465f-8aff-61a84042c8f1",
                                                "sense_id": "980ee439-4acc-3097-a144-bca87e14e227",
                                                "text": "„Sie wurden ihm zu einem Maßstab seiner Ohnmacht und zu einem Vorwurf.“"
                                            },
                                            {
                                                "example_id": "5333894e-c57e-453a-bec0-34072a465fa6",
                                                "sense_id": "980ee439-4acc-3097-a144-bca87e14e227",
                                                "text": "„Für diesen bedeutete die Verurteilung Galileis eine höchst peinliche Blamage, weil sie seine absolute Ohnmacht gegenüber klerikalen Eingriffen offenbar machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f7cd361-b75b-4dc9-a1eb-4c6c69b7473f",
                        "source_entry_id": "6e10e0ac-9731-3c1c-9a1b-989f676b8c57",
                        "source_sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                        "target_lang_word": "powerlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "powerlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1272f5d-e736-3f01-a382-471ec75e242f",
                                        "entry_id": "37f00ab7-a5b7-3c7f-b62f-a9752a5c635b",
                                        "glosses": [
                                            "The state or character of being powerless; absence or lack of power."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78840afb-0bde-4383-8c63-ddf7ef9012c6",
                                                "sense_id": "c1272f5d-e736-3f01-a382-471ec75e242f",
                                                "text": "Near-synonym: helplessness"
                                            },
                                            {
                                                "example_id": "f9ef7ef0-8d05-4c11-8a40-5a8699093894",
                                                "sense_id": "c1272f5d-e736-3f01-a382-471ec75e242f",
                                                "text": "In July 1717, a commission established by Orléans to adjudicate the issue had emphatically denied the successoral claims of the two brothers, and the Regent declared himself in a state of ‘happy powerlessness to alienate the crown's domain’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74c21002-ab35-4b2d-88bd-d16e0b7b7711",
                        "source_entry_id": "6e10e0ac-9731-3c1c-9a1b-989f676b8c57",
                        "source_sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                        "target_lang_word": "impuissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impuissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3fecdf-ccb2-3780-9608-5260618147b7",
                                        "entry_id": "be47f0a7-d659-3161-bf9f-2d4ee5f1cc29",
                                        "glosses": [
                                            "Manque de pouvoir, de moyens pour faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8391b74-81e8-44d6-99b6-eb1c0e0cd0d3",
                                                "sense_id": "bd3fecdf-ccb2-3780-9608-5260618147b7",
                                                "text": "L’impuissance intellectuelle aboutit souvent au fractionnement de l’objet d’étude, à la transformation en salami de l’histoire humaine."
                                            },
                                            {
                                                "example_id": "7d372e46-467a-4d79-a531-447349f84a95",
                                                "sense_id": "bd3fecdf-ccb2-3780-9608-5260618147b7",
                                                "text": "Les délinquants s’amusèrent à comploter des délits inconstatables, et la vieille moustache enragea de son impuissance."
                                            },
                                            {
                                                "example_id": "b9e7ef95-7415-4bc7-a9b2-2fe3897f31e3",
                                                "sense_id": "bd3fecdf-ccb2-3780-9608-5260618147b7",
                                                "text": "Convaincu de son immense impuissance à régler les problèmes de la planète, il n’en considérait pas moins comme un devoir civique de se tenir au courant de l’actualité nationale et internationale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da890e89-f55e-32a0-9dfe-bf6c7e4a850c",
                                        "entry_id": "be47f0a7-d659-3161-bf9f-2d4ee5f1cc29",
                                        "glosses": [
                                            "Incapacité sexuelle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b04cd15-1205-4d50-96f7-59b79ed61f14",
                                                "sense_id": "da890e89-f55e-32a0-9dfe-bf6c7e4a850c",
                                                "text": "Cependant, malgré les soins prodigieux que le seigneur don Juan Belvidéro donnait à sa personne, les jours de la décrépitude arrivèrent ; avec cet âge de douleur, vinrent les cris de l’impuissance, cris d’autant plus déchirants que plus riches étaient les souvenirs de sa bouillante jeunesse et de sa voluptueuse maturité."
                                            },
                                            {
                                                "example_id": "d4757c32-06cb-450b-9e3d-b19ec6b4d77e",
                                                "sense_id": "da890e89-f55e-32a0-9dfe-bf6c7e4a850c",
                                                "text": "Il avait beau se dire que cela était passager sans doute, qu’une cause morbide devait être au fond : le sentiment de son impuissance ne l’en déprimait pas moins ; et il était, devant les femmes, comme les garçons trop jeunes que le désir fait bégayer."
                                            },
                                            {
                                                "example_id": "1355519d-b068-4788-901f-4e25d91ed672",
                                                "sense_id": "da890e89-f55e-32a0-9dfe-bf6c7e4a850c",
                                                "text": "En s’imposant brutalement dans les officialités, le congrès réveille et déchaîne les passions les plus grossières. Dès le XVIᵉ siècle et grâce à lui, les procès en impuissance occupent le devant de la scène. Générateur de paradoxes, il marque l’âge d’or de la répression."
                                            },
                                            {
                                                "example_id": "448049e3-0f4a-4889-b939-8dc3446e5a52",
                                                "sense_id": "da890e89-f55e-32a0-9dfe-bf6c7e4a850c",
                                                "text": "Il en résulte que la consommation du mariage demeure une notion clef. C’est pourquoi, outre l’impuberté, l’impuissance de l’un ou l’autre des époux constitue un empêchement dirimant, absolu et est une cause incontestable d’annulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28738e70-92a7-3a14-a764-98a95b9a1c83",
                                        "entry_id": "be47f0a7-d659-3161-bf9f-2d4ee5f1cc29",
                                        "glosses": [
                                            "Sentiment d’impuissance, impression de n’avoir aucun pouvoir ou levier d’action."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bfdd99b-44c9-4167-9d46-8db98ee2eac6",
                        "source_entry_id": "6e10e0ac-9731-3c1c-9a1b-989f676b8c57",
                        "source_sense_id": "2d2bf368-acac-3749-a623-992415cc6e20",
                        "target_lang_word": "impotencia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impotencia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9476fc82-fa3e-354f-8965-9f1b3a3e7583",
                                        "entry_id": "64c63c90-2fe2-37aa-8e02-71a93c81368c",
                                        "glosses": [
                                            "Falta de poder para hacer una cosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9e7c0b-48b7-4dee-8204-628d5918be44",
                                                "sense_id": "9476fc82-fa3e-354f-8965-9f1b3a3e7583",
                                                "text": "«Ramón comenta la magnitud de la tragedia con una expresión a caballo entre la impotencia y la rabia: “Cuando nosotros plantamos pinos, se trata de árboles enanos: miden pocos centímetros, y al cabo de seis años alcanzan una altura de sólo metro y medio”»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa4f3004-e8a2-35ed-b4f2-d80470c9d11f",
                                        "entry_id": "64c63c90-2fe2-37aa-8e02-71a93c81368c",
                                        "glosses": [
                                            "Incapacidad para engendrar o concebir."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1fdfc4ce-55ab-3d7f-86de-bb4951a8c6f8",
                                        "entry_id": "64c63c90-2fe2-37aa-8e02-71a93c81368c",
                                        "glosses": [
                                            "Disfunción eréctil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fd54ff-99da-4414-8430-231bdb6aa819",
                                                "sense_id": "1fdfc4ce-55ab-3d7f-86de-bb4951a8c6f8",
                                                "text": "«Además, la alteración del funcionamiento de estas arterias es causa de disfunción eréctil en el varón, por lo que el estudio podría ser utilizado para el desarrollo de diferentes fármacos para el tratamiento de la impotencia y también para la prevención de problemas cardiovasculares»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
