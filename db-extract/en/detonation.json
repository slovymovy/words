                                "sense_id": "f42a894f-cef4-3db8-9cb8-c48da900e0f6",
                                "text": "a nuclear detonation"
                            },
                            {
                                "example_id": "3aaf66ef-2fe3-4758-bf4e-15e69054b27e",
                                "sense_id": "f42a894f-cef4-3db8-9cb8-c48da900e0f6",
