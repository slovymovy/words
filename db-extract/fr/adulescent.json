                    {
                        "sense_id": "e4383a28-7713-3064-b795-5817fbb6104b",
                        "entry_id": "4b8c3d02-385c-3426-999f-d9df40ac66ed",
                        "glosses": [
                            "Relatif aux personnes adultes exprimant des traits de personnalité associés à l’adolescence."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "5727cd38-9554-4b82-a020-3a81e00cdd39",
                                "sense_id": "e4383a28-7713-3064-b795-5817fbb6104b",
                                "text": "En quoi s’afficher blasphématoire et sataniste fera-t-il avancer la cause féminine ? Qui a envie d’un féminisme hystérique dont le satanisme affiché ressemble à une crise adulescente ?"
                            },
                            {
                                "example_id": "59984c20-293e-462f-8185-12b07d2bb9d0",
                                "sense_id": "e4383a28-7713-3064-b795-5817fbb6104b",
                                "text": "Le péril adulescent."
                            },
                            {
                                "example_id": "daa25e6f-986f-4794-8589-6ca6233ad5ef",
                                "sense_id": "e4383a28-7713-3064-b795-5817fbb6104b",
                                "text": "L’auteur du livre Le marketing adulescent décrypte ce phénomène générationnel."
                            }
                        ]
                    }
