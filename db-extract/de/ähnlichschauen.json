                                "sense_id": "78ee010d-d03d-3e1a-a1ab-3e2050b52d8f",
                                "text": "Solche Lügen schauen dir gar nicht ähnlich.",
                                "translation": "Such lies are so unlike you.",
                                "english": "Such lies are so unlike you."
                            }
                        ]
