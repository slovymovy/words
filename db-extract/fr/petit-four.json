                        "entry_id": "46863d80-a28a-3dac-81b8-5ffe70994dfa",
                        "glosses": [
                            "Petite pâtisserie légère pour desserts, pour soirées, etc."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "517cd58e-e89a-45bd-bf5b-80e5a548b68b",
                                "sense_id": "02b47f58-5f47-3d94-a547-999cf5c50b80",
                                "text": "On applaudit bien fort les mécènes, puis on les oublia vite, de même que le proviseur sur son podium pour retourner vers le buffet s’emparer des petits-fours rescapés et siroter un dernier verre d’alcool."
                            },
                            {
                                "example_id": "0f083838-5830-4b76-b466-3befae926afa",
                                "sense_id": "02b47f58-5f47-3d94-a547-999cf5c50b80",
                                "text": "Il s’était arrêté près d’un des buffets et s’amusait à compter le nombre de petits-fours qu’arrivait à ingurgiter le chef de l’administration communale quand son talkie grésilla."
                            }
                        ]
                    }
