                        "examples": [
                            {
                                "example_id": "3399e808-0c9f-4bb8-9add-aea1cddcba44",
                                "sense_id": "3881553c-85d9-369b-a066-1ddd800c4ecc",
                                "text": "Onder de ondertekenaars is een groot aantal vooraanstaande hoogleraren en economen, zoals Rick van der Ploeg, Arnoud Boot, Coen Teulings, Bas Jacobs en Sweder van Wijnbergen. Zij vinden dat het conceptakkoord teleurstelt en willen dat de industrie meteen in actie komt. Een boetesysteem is volgens de economen niet effectief."
                            },
                            {
                                "example_id": "ab242a64-6581-49de-ada0-aa41b9bb3d2c",
                                "sense_id": "3881553c-85d9-369b-a066-1ddd800c4ecc",
                                "text": "RTL Nieuws en het AD melden details uit een conceptakkoord tussen het kabinet, het bedrijfsleven en maatschappelijke organisaties. Die voorstellen gaan het naar alle waarschijnlijkheid wel halen, zo melden bronnen aan de NOS."
                            },
                            {
                                "example_id": "a8e2c4bd-0a5c-49c6-881b-cbcdda0e04d6",
                                "sense_id": "3881553c-85d9-369b-a066-1ddd800c4ecc",
                                "text": "Hoewel May haar ministers dus achter zich heeft gekregen, kunnen de komende dagen toch nog ministers opstappen omdat ze het niet eens zijn met het conceptakkoord."
                            }
                        ]
                    }
