                    {
                        "sense_id": "1fa22335-4cb9-37fa-8df1-86f31465e364",
                        "entry_id": "f43fd3dc-e2a7-3ea6-939b-d1e8195f35ee",
                        "glosses": [
                            "Plan über alle zukünftigen Einnahmen und Ausgaben eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92beef7-8012-4a43-9ea1-af5d4be5b7f4",
                                "sense_id": "1fa22335-4cb9-37fa-8df1-86f31465e364",
                                "text": "„Denn so üppig, dass man auf die Einnahmen verzichten könnte, sei das Staatsbudget nicht.“"
                            },
                            {
                                "example_id": "0ca6b7ce-97a5-44fa-b6de-e6724e1dacb0",
                                "sense_id": "1fa22335-4cb9-37fa-8df1-86f31465e364",
                                "text": "„Sócrates hatte in seiner Amtszeit das letzte Wort bei großen Infrastrukturvorhaben, deren Finanzierung allerdings riesige Löcher in das Staatsbudget gerissen hat.“"
                            }
                        ],
