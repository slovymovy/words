            {
                "entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                "word": "smutno",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
                        "entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                        "glosses": [
                            "ze smutkiem; nie powodując radości, ale przygnębienie, zadumę, żal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93d8493-df39-4548-86c0-05ab00a28a30",
                                "sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
                                "text": "Smutno to brzmi, prawda?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5e2d705-13c3-4c77-9a44-a20e1e83a02c",
                        "source_entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                        "source_sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
                        "target_lang_word": "sadly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "In a sad manner; sorrowfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529f1844-2e6e-4fc6-af81-edb289395b38",
                                                "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                                                "text": "“Only when we climb up can we see it,” he said sadly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Unfortunately, sad to say."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0964bd-27ae-4666-aca3-d3b7d7c36207",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "If you think you’re getting out of this place alive, you are sadly mistaken, my friend."
                                            },
                                            {
                                                "example_id": "b17756d0-749d-4bc4-94db-7bf904012daa",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "Sadly, the two were never to meet again."
                                            },
                                            {
                                                "example_id": "9f744ee0-d37f-4e15-aa05-6060b3696a8d",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "Before kick-off, a section of Chelsea's support sadly let themselves and their club down by noisily interrupting the silence held in memory of the Hillsborough disaster and for Livorno midfielder Piermario Morosini, who collapsed and died after suffering a heart attack during a Serie B game on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "In a manner to cause sadness; badly; terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b263d3-18b1-402b-8f1a-5c52c1e0f944",
                                                "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                                                "text": "The people of Ebeltoft were once sadly plagued by them, as they plundered their pantries in a most unconscionable manner; so they consulted a very wise and pious man and his advice was, that they should hang a bell in the steeple of the church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Very much (of a desire etc.); dearly; urgently."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e7a445-8b43-4025-b3e1-a631670ef28e",
                                                "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                                                "text": "\"Don't ask me: don't make me talk of it,\" she answered. \"I'm not fit now. I have been cruelly used and cruelly wronged. You will be kinder than ever, if you will walk on fast, and not speak to me. I sadly want to quiet myself, if I can.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Deeply, completely."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e242634e-fe64-471a-bceb-4c71f169fdc8",
                                                "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                                                "text": "By my feythe sayd syre launcelot in that pauelione wil I lodge alle this nyghte / and soo there he alyghte doune and tayed his hors to the pauelione / and there he vnarmed hym / and there he fond a bedde / and layd hym theryn / and felle on slepe sadly"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11a51203-4d77-40fe-a019-78d739435074",
                        "source_entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                        "source_sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
                        "target_lang_word": "dully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec9311f-4ab1-34d7-8a59-9e180e197f14",
                                        "entry_id": "0fa686b8-1ed0-3eb4-84f6-defe2337d9bd",
                                        "glosses": [
                                            "In a dull manner; without liveliness; without lustre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dcc75d8-59e9-492b-9be5-c1869f16787d",
                                                "sense_id": "dec9311f-4ab1-34d7-8a59-9e180e197f14",
                                                "text": "The parson, all unaware, dully pursued his calling, perched above the exquisite derision of their glances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3899ffdf-b132-4c6e-b459-589652e050ef",
                        "source_entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                        "source_sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
                        "target_lang_word": "piteously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piteously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                        "entry_id": "1e16bc43-0cd8-3a95-9ebc-645f85798cec",
                                        "glosses": [
                                            "In a piteous manner; pathetically; plaintively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57556413-9a8f-419a-b392-2638bdd96dfd",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "He had been quite familiar with one old ghost, in a white waistcoat, with a monstrous iron safe attached to its ankle, who cried piteously at being unable to assist a wretched woman with an infant, whom it saw below, upon a door-step."
                                            },
                                            {
                                                "example_id": "ff8c839f-05c6-4c5e-b80c-75a0bfe0608a",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "Across her mind, and bowing over him,\nLow to her own heart piteously she said:"
                                            },
                                            {
                                                "example_id": "55859dc0-7584-41d8-a231-4f4f4f00793b",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "Little Sea and Desire would wail piteously over my body for a day, and then I should be quickly forgotten."
                                            },
                                            {
                                                "example_id": "e581c89c-926e-4ccb-9d89-8ea56a8ac95e",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "Adam himself bewildered and Eveless outside the garden; a Minotaur howling piteously in a labyrinth of money-worries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25017e67-7da4-45dd-be97-1537522e09c2",
                        "source_entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                        "source_sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
                        "target_lang_word": "ruefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2ebf48-72b3-3b01-b45a-1ae81f00eb03",
                                        "entry_id": "64787a87-ed52-3fb5-b60a-00c51ebbd119",
                                        "glosses": [
                                            "In a rueful manner; causing, feeling, or expressing regret or sorrow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a92e395-d0ef-4184-8c9d-cbb01b375423",
                                                "sense_id": "6f2ebf48-72b3-3b01-b45a-1ae81f00eb03",
                                                "text": "He smiled ruefully at me."
                                            },
                                            {
                                                "example_id": "ff0a261b-8363-41bb-8663-af68722bd2e0",
                                                "sense_id": "6f2ebf48-72b3-3b01-b45a-1ae81f00eb03",
                                                "text": "He pushed his straw hat back, scratched his head, and laughed ruefully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "570b223d-18af-4db4-bf1b-bd62dd337db3",
                        "source_entry_id": "78ee83e3-f72f-351b-af59-327d7a9d3812",
                        "source_sense_id": "f66d3897-004f-3461-85d8-d797f2cf435d",
