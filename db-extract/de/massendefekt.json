                ],
                "senses": [
                    {
                        "sense_id": "ca732f96-ee3a-3b94-a80d-9ec4055af830",
                        "entry_id": "6b04214e-3218-3df5-bac1-6a5611e68016",
                        "glosses": [
                            "Unterschied zwischen der Summe der Massen aller Nukleonen, aus denen ein Atomkern besteht, und der tatsächlich gemessenen, stets kleineren Masse des Atomkerns"
                        ],
                        "tags": [
                            "Kernphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8e9ace-7b22-4095-958c-fe9dfc98a040",
                                "sense_id": "ca732f96-ee3a-3b94-a80d-9ec4055af830",
                                "text": "„Der Atomkern des Eisenisotops ⁵⁶Fe weist einen der größten Massendefekte und damit eine der höchsten Bindungsenergien pro Nukleon aller Atomkerne auf.“"
                            },
                            {
                                "example_id": "cfb5c3d3-c3c8-403f-9124-fc7bb8e9fd2e",
                                "sense_id": "ca732f96-ee3a-3b94-a80d-9ec4055af830",
                                "text": "„Bei der Sonne bedeutet das, dass in jeder Sekunde etwa 564 Millionen Tonnen Wasserstoff zu 560 Millionen Tonnen Helium ‚verschmolzen‘ werden, der Massendefekt also 4 Millionen Tonnen beträgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
