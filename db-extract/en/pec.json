                        ],
                        "examples": [
                            {
                                "example_id": "675d44d3-716d-4675-aa47-5f45d02b3608",
                                "sense_id": "8ab68a4a-1acb-33ba-bd9f-c8a9921933e5",
                                "text": "He's flexing his pecs at anyone who'll look."
                            },
                            {
                                "example_id": "78f352d0-a921-47fc-a3af-5af13ae8f33f",
                                "sense_id": "8ab68a4a-1acb-33ba-bd9f-c8a9921933e5",
                                "text": "The quest for perfect pecs is so strong that psychiatrists now sometimes refer to it as “bigorexia,” a form of muscle dysmorphia exhibited mostly by men and characterized by excessive weight lifting, a preoccupation with not feeling muscular enough and a strict adherence to eating foods that lower weight and build muscle."
                            }
                        ]
                    },
                    {
                        "sense_id": "c28676da-a643-3840-8faa-bae8b1eff737",
                        "entry_id": "02bda8d2-3a11-3e5b-93d7-741bd7e63b2b",
                        "glosses": [
                            "Clipping of pectoral sandpiper."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping"
                        ],
                        "examples": [
                            {
                                "example_id": "9cffb5a7-e3c0-4b1d-b6c6-116c10eb1516",
                                "sense_id": "c28676da-a643-3840-8faa-bae8b1eff737",
                                "text": "Greenshank, dunlins, common sand, snipe and blackwits accompanied the pec."
                            },
                            {
                                "example_id": "f19df47f-a20c-40a8-94a4-e4f4f144d5a0",
                                "sense_id": "c28676da-a643-3840-8faa-bae8b1eff737",
                                "text": "I went back into my photos, and yes, on 13 Nov, I photographed both Sharpie and the Pec."
                            }
                        ]
                    }
