                "senses": [
                    {
                        "sense_id": "3bac3b49-de92-3b87-a5f1-d163be9575ed",
                        "entry_id": "f8a7a307-da28-3817-a290-b41721aed884",
                        "glosses": [
                            "an eine Maschine erinnernd, einer Maschine ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a4538e-6a3d-483d-a223-a6a4a3d7a4e0",
                                "sense_id": "3bac3b49-de92-3b87-a5f1-d163be9575ed",
                                "text": "„Die vier maschinenartigen Retter unternehmen nichts, obwohl sie sehen, wie er uns anglotzt.“"
                            },
                            {
                                "example_id": "00ab9cf4-298c-42e0-b750-88a1d202565f",
                                "sense_id": "3bac3b49-de92-3b87-a5f1-d163be9575ed",
                                "text": "„Von der maschinenartigen, entschlossenen Gangart, die er vor der Begegnung mit dem Polizisten gezeigt hat, fehlt jede Spur.“"
                            }
                        ],
