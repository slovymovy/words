                "senses": [
                    {
                        "sense_id": "5f8dbf51-f536-360c-83d5-d9f2e23dd0aa",
                        "entry_id": "c4047128-02df-3ce3-ab3b-752d323ac27d",
                        "glosses": [
                            "Planet, von dem jemand oder etwas stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad89d514-9c31-4af9-9148-5c57ae9fc1be",
                                "sense_id": "5f8dbf51-f536-360c-83d5-d9f2e23dd0aa",
                                "text": "Die Erde ist der Heimatplanet der Menschen."
                            },
                            {
                                "example_id": "50ae5a14-670c-4ba5-a7d0-a1f19c979f61",
                                "sense_id": "5f8dbf51-f536-360c-83d5-d9f2e23dd0aa",
                                "text": "„Die nun entdeckte Super-Erde hat mindestens die 4,5-fache Masse unseres Heimatplaneten.“"
                            },
                            {
                                "example_id": "d9f240ab-bc21-41c7-91c6-7c90d75cf63c",
                                "sense_id": "5f8dbf51-f536-360c-83d5-d9f2e23dd0aa",
                                "text": "„Vor der grauen Mondoberfläche und dem kosmischen Schwarz aber tauchte unerwartet der Heimatplanet in seiner überwältigenden Einzigartigkeit auf.“"
                            },
                            {
                                "example_id": "5b3d291e-0598-4e80-9a94-612d04c16f8a",
                                "sense_id": "5f8dbf51-f536-360c-83d5-d9f2e23dd0aa",
                                "text": "„Astronomisch gesehen ist die Sonne ein recht durchschnittlicher Stern, für das Leben auf der Erde ist sie hingegen von überragender Bedeutung. Seit Jahrmilliarden liefert sie unserem Heimatplaneten Licht und Wärme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
