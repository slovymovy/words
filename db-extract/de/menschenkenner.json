                "senses": [
                    {
                        "sense_id": "a27476e5-8b65-3a15-ac42-d0f7c52b2419",
                        "entry_id": "5927b7aa-5424-39bd-9065-24b365b7e0b8",
                        "glosses": [
                            "Person, die die Verfassung und das Verhalten anderer Menschen gut einzuschätzen weiß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe26d7d7-d246-42d0-b35b-a91a8cfaffa9",
                                "sense_id": "a27476e5-8b65-3a15-ac42-d0f7c52b2419",
                                "text": "Er war noch nie ein besonders guter Menschenkenner."
                            },
                            {
                                "example_id": "075a86cc-d367-4a17-97c3-b4a2e3361b78",
                                "sense_id": "a27476e5-8b65-3a15-ac42-d0f7c52b2419",
                                "text": "„Aber es überraschte ihn nicht, denn er war ein Menschenkenner.“"
                            },
                            {
                                "example_id": "5ca4714d-dc36-411e-b13e-440c616fd9cf",
                                "sense_id": "a27476e5-8b65-3a15-ac42-d0f7c52b2419",
                                "text": "„Schefold, der kein Menschenkenner war, hielt es für selbstverständlich, daß Reidel den Karabiner über die Schulter hängte, ihm vorausging.“"
                            },
                            {
                                "example_id": "ac963bb6-acd5-4eb6-b1e6-a65ba728eb5f",
                                "sense_id": "a27476e5-8b65-3a15-ac42-d0f7c52b2419",
                                "text": "„Der Menschenkenner konnte unschwer auf eine Natur schließen, die nach jeder Art Sinnengenuß lechzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d1453cd-e358-4890-8c2a-0affd9f5f8b2",
                        "source_entry_id": "5927b7aa-5424-39bd-9065-24b365b7e0b8",
