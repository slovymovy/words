                "senses": [
                    {
                        "sense_id": "5230d16c-1716-32e0-946f-0923207fb432",
                        "entry_id": "58dfda7e-94d0-3f48-ad6d-2545d3cf6d0b",
                        "glosses": [
                            "elektrische Energie, die mit einer Windkraftanlage aus der Energie des Windes gewonnen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "86999b83-0519-4a27-b21d-9e6e57dba299",
                                "sense_id": "5230d16c-1716-32e0-946f-0923207fb432",
                                "text": "„Durch steigende konventionelle Strompreise und sinkende Vergütung für Windstrom nähern sich die Preise immer weiter an.“"
                            },
                            {
                                "example_id": "ee361058-1cdb-4944-b75f-4067dbd9736c",
                                "sense_id": "5230d16c-1716-32e0-946f-0923207fb432",
                                "text": "„Windstrom aus Norddeutschland zum Beispiel kann mangels Leitungen oft nicht komplett in den industriereichen Süden des Landes transportiert werden.“"
                            },
                            {
                                "example_id": "995e09f9-ff3a-49b3-9c44-40fa960cf37f",
                                "sense_id": "5230d16c-1716-32e0-946f-0923207fb432",
                                "text": "„Der Überschuss an Windstrom an windreichen Tagen wird hier auch für die Wärmezeugung im Fernwärmenetz eingesetzt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05438c94-ef6d-3a38-bad8-0471ca44b9ac",
                        "entry_id": "58dfda7e-94d0-3f48-ad6d-2545d3cf6d0b",
                        "glosses": [
                            "Luftzug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af414975-4737-48ae-ac22-a19594a18b76",
                                "sense_id": "05438c94-ef6d-3a38-bad8-0471ca44b9ac",
                                "text": "„Wie es Mitternacht wurde, erhob sich ein lebhafter Windstrom über dem See, und den jungen Arzt überschauerte ein Frösteln, da die Fenster weit offen standen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
