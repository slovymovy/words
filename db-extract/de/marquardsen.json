                                "example_id": "5c5e8190-61bb-49c7-8e3b-f0f2117c1f53",
                                "sense_id": "0cf09b5a-7ad7-3341-95f0-259c18a93758",
                                "text": "Heute trat der junge Marquardsen seine neue Stelle an."
                            },
                            {
                                "example_id": "f6c007ec-a261-42cb-822d-3083fa9145ed",
                                "sense_id": "0cf09b5a-7ad7-3341-95f0-259c18a93758",
                                "text": "Der Marquardsen ist nicht mehr zu helfen."
                            }
