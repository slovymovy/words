{
    "word_family": [
        "gepopel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87ea2a9c-90d6-3bc3-82d2-8273ded602a7",
                    "sense_definition": "Iets zo graag willen dat je hart bonst en je niet stil kunt blijven staan.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enthousiasme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij staat te <w>popelen</w> om zijn vrouw te kussen.",
                            "target_lang_translations": {
                                "en": "He is <w>eager</w> to kiss his wife."
                            }
                        },
                        {
                            "text": "De kinderen staan te <w>popelen</w> om eindelijk aan hun vakantie te beginnen.",
                            "target_lang_translations": {
                                "en": "The children are <w>itching</w> to finally start their holiday."
                            }
                        }
                    ],
                    "synonyms": [
                        "branden",
                        "trappelen"
                    ],
                    "common_phrases": [
                        "staan te popelen",
                        "popelen van ongeduld"
                    ],
                    "target_lang_definitions": {
                        "en": "To want something so much that your heart pounds and you cannot stand still."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be eager",
                                "target_lang_sense_clarification": "showing keen interest or intense desire"
                            },
                            {
                                "target_lang_word": "to be itching",
                                "target_lang_sense_clarification": "having a restless desire to do something"
                            },
                            {
                                "target_lang_word": "to be raring",
                                "target_lang_sense_clarification": "very enthusiastic and eager to start"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a7b9066-9bc8-3726-b06a-621de60a3e9a",
                    "sense_definition": "Een sterk verlangen of hunkering naar iets of iemand voelen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verlangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn hart bleef <w>popelen</w> naar de verre landen waarover ik had gelezen.",
                            "target_lang_translations": {
                                "en": "My heart continued to <w>yearn</w> for the distant lands I had read about."
                            }
                        },
                        {
                            "text": "Zij kon alleen maar <w>popelen</w> naar een teken van leven van haar familie.",
                            "target_lang_translations": {
                                "en": "She could only <w>long</w> for a sign of life from her family."
                            }
                        }
                    ],
                    "synonyms": [
                        "hunkeren",
                        "smachten",
                        "verlangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To feel a strong desire or yearning for something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to yearn",
                                "target_lang_sense_clarification": "to have an intense feeling of longing"
                            },
                            {
                                "target_lang_word": "to long",
                                "target_lang_sense_clarification": "to have a strong wish or desire"
                            },
                            {
                                "target_lang_word": "to pine",
                                "target_lang_sense_clarification": "to suffer from a deep longing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}