            {
                "entry_id": "737cea07-54a6-3717-885b-bd2eab23f1f8",
                "word": "protéomique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1032c5e6-5f32-3a75-86bb-3f0cdfcdb99c",
                        "entry_id": "737cea07-54a6-3717-885b-bd2eab23f1f8",
                        "glosses": [
                            "Discipline qui identifie et caractérise les protéines d’une cellule ou de l’un de ses compartiments, et analyse leur expression, leur fonction et leurs interactions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d59f359-78d0-4c82-809a-325636693d14",
                                "sense_id": "1032c5e6-5f32-3a75-86bb-3f0cdfcdb99c",
                                "text": "Le progrès viendra de l’imagerie fonctionnelle, de la génomique et de la protéomique pour lesquelles les systèmes d’études, tant biologiques, robotiques, statistiques, qu’informatiques, commencent à se mettre en place."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69f7204f-f23a-456a-84c0-395e71899ae8",
                        "source_entry_id": "737cea07-54a6-3717-885b-bd2eab23f1f8",
                        "source_sense_id": "1032c5e6-5f32-3a75-86bb-3f0cdfcdb99c",
                        "target_lang_word": "Proteomik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proteomik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "018b0e2f-b963-3300-91d9-65441e80ae54",
                                        "entry_id": "bffea12d-7262-3bd9-a1b9-e008ef7d2bf6",
                                        "glosses": [
                                            "diejenige wissenschaftliche Disziplin, die die Gesamtheit aller Proteine eines Organismus erfasst und ordnet"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92000f71-f620-4070-8e6a-a533fdde84a5",
                                                "sense_id": "018b0e2f-b963-3300-91d9-65441e80ae54",
                                                "text": "Ein neuer Zweig der Biochemie ist die Proteomik […].\""
                                            },
                                            {
                                                "example_id": "4da44b85-8774-4057-9342-97a4679268ed",
                                                "sense_id": "018b0e2f-b963-3300-91d9-65441e80ae54",
                                                "text": "Die Proteomik hat in den Zellen des menschlichen Gehirns mehr als zehntausend Proteine gefunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5172ffe-7f17-4abc-b7bb-454288d65cd5",
                        "source_entry_id": "737cea07-54a6-3717-885b-bd2eab23f1f8",
                        "source_sense_id": "1032c5e6-5f32-3a75-86bb-3f0cdfcdb99c",
                        "target_lang_word": "proteomics",
