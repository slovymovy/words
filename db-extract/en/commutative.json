                                        "entry_id": "b7502319-5089-3568-9029-2780e4d7c2b8",
                                        "glosses": [
                                            "Qualifie une structure algébrique muni d'une loi de composition interne commutative."
                                        ],
                                        "tags": [],
                                        "examples": [
