                },
                {
                    "sense_id": "8adba335-d391-3278-9b0f-6be717058f01",
                    "sense_definition": "A rotating, funnel-shaped cloud extending from a storm cloud toward the ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meteorologist warned that a <w>funnel</w> was spotted near the town."
