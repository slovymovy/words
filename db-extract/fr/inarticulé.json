                                "target_senses": [
                                    {
                                        "sense_id": "6a98d295-c141-3c7a-adce-26c37d970e37",
                                        "entry_id": "4a648aa6-fa2d-3017-aa65-46b1860211df",
                                        "glosses": [
                                            "Not articulated in normal words."
                                        ],
                                        "tags": [
                                            "of speech"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c87d8d53-0999-43e0-97d6-d855596434e7",
                                                "sense_id": "6a98d295-c141-3c7a-adce-26c37d970e37",
                                                "text": "Major Johnstone strove to speak, but the words died in an inarticulate gurgle low in his throat; and Evelyn had only time to start from his knee, and save the dying man from falling to the earth."
                                            },
                                            {
                                                "example_id": "7c5bbd09-c1fe-4d1b-8ac1-ad696d707e82",
                                                "sense_id": "6a98d295-c141-3c7a-adce-26c37d970e37",
                                                "text": "Pensak made an inarticulate shout of surprise, and O stepped away from the sudden precipice so hard that she collided with the back of the elevator, and yelped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1ae6787-74e0-3f06-bf1c-42dd6375908b",
                                        "entry_id": "4a648aa6-fa2d-3017-aa65-46b1860211df",
                                        "glosses": [
                                            "Speechless."
                                        ],
