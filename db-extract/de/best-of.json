                                    {
                                        "sense_id": "e217f9a6-4d37-35d9-a180-6cf0ca83852a",
                                        "entry_id": "df8e4cb2-eac3-3132-9ebb-35970ab75df3",
                                        "glosses": [
                                            "Compilation des chansons à succès d’un chanteur ou d’un groupe musical."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6171a10-0b51-4323-9696-728d9fa427d5",
                                                "sense_id": "e217f9a6-4d37-35d9-a180-6cf0ca83852a",
                                                "text": "Le 31 décembre 2007, après l’émission Happy Rock Hours, le best of de 2007, Europe 2 a cessé d’exister en terminant par la chanson Take Me Out de Franz Ferdinand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90b438c0-27aa-31bc-8653-d8e30d842eef",
                                        "entry_id": "df8e4cb2-eac3-3132-9ebb-35970ab75df3",
                                        "glosses": [
                                            "Compilation des meilleures choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff666e4b-a0b8-4568-9ffe-c584fdf4d4d6",
                                                "sense_id": "90b438c0-27aa-31bc-8653-d8e30d842eef",
                                                "text": "Règle générale, on en réinvente pas, pour un débat, ses arguments. On présente ses meilleurs. Comme on dit en France, son best of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cb90486-f821-3f31-b60e-5a98d2f5564f",
                                        "entry_id": "df8e4cb2-eac3-3132-9ebb-35970ab75df3",
                                        "glosses": [
                                            "Compilation des pires choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73499364-9c3c-4805-9991-1c56c9a01a98",
                                                "sense_id": "7cb90486-f821-3f31-b60e-5a98d2f5564f",
                                                "text": "RT manifeste un goût prononcé pour la contestation, y compris sociale, en Occident, en particulier lorsqu’elle fournit des images spectaculaires d’affrontements avec la police, de vitres brisées ou d’incendies, qui peuvent donner lieu à des « best of » de « vidéos-chocs » (30 décembre 2016)."
                                            }
                                        ]
                                    }
