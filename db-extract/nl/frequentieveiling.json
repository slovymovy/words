                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1893dc-13f5-46e2-8a2a-39c7bc9f6cef",
                                "sense_id": "79683ebd-7f20-31c3-806a-d629151c66df",
                                "text": "Komende dinsdag zetten KPN en T-Mobile hun 5G-netwerken aan. Deze week werd de frequentieveiling voor het nieuwe mobiele netwerk afgerond, waardoor de providers van start kunnen."
                            },
                            {
                                "example_id": "3143b7f1-b84f-4e3b-ad5e-6b68c822e69f",
                                "sense_id": "79683ebd-7f20-31c3-806a-d629151c66df",
                                "text": "Het kabinet heeft ook besloten dat telecombedrijven die straks mobiel internet via 5G willen gaan aanbieden verplicht worden vrijwel landelijke dekking te bieden. Bij de komende frequentieveiling wordt er een dekkingsverplichting opgelegd van 98 procent."
                            },
                            {
                                "example_id": "5642a254-f419-49ff-b2dd-b4e5640ff04f",
                                "sense_id": "79683ebd-7f20-31c3-806a-d629151c66df",
                                "text": "4G is de opvolger van 3G. Mobiel internet kan daardoor vrijwel net zo snel zijn als de vaste internetverbinding thuis. Eind 2012 leverde de frequentieveiling, waar onder meer frequenties voor 4G werden geveild, 3,8 miljard euro op. KPN betaalde ruim 1,4 miljard euro."
                            }
                        ]
                    }
