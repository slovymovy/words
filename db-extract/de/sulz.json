                "senses": [
                    {
                        "sense_id": "76e2b95c-ebe8-3a47-b889-f0adbb97364b",
                        "entry_id": "09d2b782-5bce-33a5-8c3e-b0401c50655d",
                        "glosses": [
                            "Stücke von Fleisch, Fisch oder Gemüse in eingedickter Brühe (Aspik/Gallert/Gelee), welche auch als Sulz bezeichnet wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "17b08824-859f-4bcc-8a9a-82365c8e395b",
                                "sense_id": "76e2b95c-ebe8-3a47-b889-f0adbb97364b",
                                "text": "„Das Wasser darf nur leicht köcheln, nicht wallen, sonst wird die Sulz trüb.“"
                            },
                            {
                                "example_id": "c1bfd11f-7d9f-44e1-b57d-e333a204da12",
                                "sense_id": "76e2b95c-ebe8-3a47-b889-f0adbb97364b",
                                "text": "„Fein und sehr gut abgeschmeckt, wurde die Sulz mit reichlich Ganserlfleisch serviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
