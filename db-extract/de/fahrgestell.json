                "senses": [
                    {
                        "sense_id": "4259cb64-205b-32fc-9871-e811cd414f5c",
                        "entry_id": "220a483b-da02-306b-80ad-1855534f062b",
                        "glosses": [
                            "Teil eines Fahrzeugs, an dem die Achsen befestigt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6b828d7-e434-43c8-ab29-4349f389aa08",
                                "sense_id": "4259cb64-205b-32fc-9871-e811cd414f5c",
                                "text": "Die meisten Fahrgestelle werden aus Stahl hergestellt."
                            },
                            {
                                "example_id": "b7b4788e-3cb5-4f7e-a000-e801c779b706",
                                "sense_id": "4259cb64-205b-32fc-9871-e811cd414f5c",
                                "text": "„Allan meinte, die Lösung könnte in einem wohldosierten Sprengsatz unten am Fahrgestell des Wagens liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "956c6af5-cee0-36d3-bd8a-441ce1a4f7e2",
                        "entry_id": "220a483b-da02-306b-80ad-1855534f062b",
                        "glosses": [
                            "die Beine eines Menschen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3a634066-a9bb-43fa-8bdf-9e76b7226627",
                                "sense_id": "956c6af5-cee0-36d3-bd8a-441ce1a4f7e2",
                                "text": "Der da hat echt ein tolles Fahrgestell."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
