{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10efc133-55f6-378d-9bb4-440700a78b09",
                    "sense_definition": "A small, compact chunk or lump, especially of a precious metal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_lump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prospector was thrilled to find a large gold <w>nugget</w> shining in the riverbed.",
                            "target_lang_translations": {
                                "ru": "Старатель был в восторге, найдя крупный золотой <w>самородок</w>, сияющий в русле реки."
                            }
                        },
                        {
                            "text": "He kept a small <w>nugget</w> of silver in his pocket as a good luck charm.",
                            "target_lang_translations": {
                                "ru": "Он носил в кармане маленький серебряный <w>самородок</w> в качестве талисмана на удачу."
                            }
                        }
                    ],
                    "synonyms": [
                        "lump",
                        "chunk",
                        "clump"
                    ],
                    "common_phrases": [
                        "gold nugget"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой плотный кусок или комок, особенно драгоценного металла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самородок",
                                "target_lang_sense_clarification": "драгоценного металла"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "небольшой комок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89e59433-50fd-30b2-8835-a53aa467d62c",
                    "sense_definition": "A small, bite-sized piece of chicken that is battered, breaded, and fried.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a box of chicken <w>nuggets</w> with sweet and sour sauce for lunch.",
                            "target_lang_translations": {
                                "ru": "На обед она заказала коробку куриных <w>наггетсов</w> с кисло-сладким соусом."
                            }
                        },
                        {
                            "text": "Kids usually prefer eating a crispy chicken <w>nugget</w> over a healthy salad.",
                            "target_lang_translations": {
                                "ru": "Дети обычно предпочитают хрустящий куриный <w>наггетс</w> полезному салату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chicken nugget"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кусочек курицы в панировке, обжаренный во фритюре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наггетс",
                                "target_lang_sense_clarification": "куриный наггетс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a4a1bb8-d5e1-3ada-9a97-1cff4d36b99b",
                    "sense_definition": "A small but highly valuable or interesting piece of information, truth, or advice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her speech was filled with many a <w>nugget</w> of wisdom that inspired the graduates.",
                            "target_lang_translations": {
                                "ru": "Ее речь была полна <w>крупиц</w> мудрости, которые вдохновили выпускников."
                            }
                        },
                        {
                            "text": "The journalist uncovered a fascinating <w>nugget</w> of truth hidden deep within the old reports.",
                            "target_lang_translations": {
                                "ru": "Журналист раскопал удивительную <w>крупицу</w> правды, спрятанную глубоко в старых отчетах."
                            }
                        }
                    ],
                    "synonyms": [
                        "tidbit"
                    ],
                    "common_phrases": [
                        "nugget of wisdom",
                        "nugget of truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая, но очень ценная или интересная мысль, крупица информации или совет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "мудрости, правды"
                            },
                            {
                                "target_lang_word": "ценные сведения",
                                "target_lang_sense_clarification": "полезная информация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e14eb787-40e6-341c-9b2c-eb016d8fef64",
                    "sense_definition": "A small piece of tasty food; a tidbit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef offered us a delicious <w>nugget</w> of cheese to sample before dinner.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар предложил нам попробовать вкусный <w>кусочек</w> сыра перед ужином."
                            }
                        },
                        {
                            "text": "She tossed a small <w>nugget</w> of meat to the waiting dog.",
                            "target_lang_translations": {
                                "ru": "Она бросила ждущей собаке маленький <w>кусочек</w> мяса."
                            }
                        }
                    ],
                    "synonyms": [
                        "morsel",
                        "tidbit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький лакомый кусочек еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусочек",
                                "target_lang_sense_clarification": "лакомый кусочек еды"
                            },
                            {
                                "target_lang_word": "ломтик",
                                "target_lang_sense_clarification": "небольшая порция еды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b65f74-c6ba-3e54-8452-559a4eb37bba",
                    "sense_definition": "A bud from the Cannabis sativa plant, especially one that is potent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed his friends a dense, green <w>nugget</w> he had recently purchased.",
                            "target_lang_translations": {
                                "ru": "Он показал друзьям плотную зеленую <w>шишку</w>, которую недавно купил."
                            }
                        },
                        {
                            "text": "The quality of the herb was evident from the sticky texture of each <w>nugget</w>.",
                            "target_lang_translations": {
                                "ru": "Качество травы было очевидно по липкой текстуре каждой <w>шишки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bud"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in cannabis culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шишка (соцветие) конопли, особенно крепкая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шишка",
                                "target_lang_sense_clarification": "соцветие конопли"
                            },
                            {
                                "target_lang_word": "бошка",
                                "target_lang_sense_clarification": "сленг, соцветие конопли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d08933c4-b57c-36a9-acaa-b36eb470c7be",
                    "sense_definition": "An inexperienced, newly trained military fighter pilot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran pilot gave some useful landing tips to the nervous <w>nugget</w>.",
                            "target_lang_translations": {
                                "ru": "Опытный пилот дал несколько полезных советов по посадке нервничающему <w>желторотику</w>."
                            }
                        },
                        {
                            "text": "Every <w>nugget</w> on the aircraft carrier has to undergo rigorous initial evaluations.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>новичок</w> на авианосце должен пройти строгую первоначальную аттестацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "rookie"
                    ],
                    "antonyms": [
                        "veteran"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military aviation slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопытный, только что обученный военный летчик-истребитель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желторотик",
                                "target_lang_sense_clarification": "неопытный летчик"
                            },
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "неопытный пилот"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0d23b66-dc5c-3951-8fd9-53cccf1cb27b",
                    "sense_definition": "To search for or find valuable nuggets, especially of gold.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire summer trying to <w>nugget</w> along the shallow mountain creeks.",
                            "target_lang_translations": {
                                "ru": "Все лето они пытались <w>добывать самородки</w> вдоль мелководных горных ручьев."
                            }
                        },
                        {
                            "text": "He managed to <w>nugget</w> several ounces of gold after weeks of hard labor.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>намыть</w> несколько унций золота после недель тяжелого труда."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать или находить ценные самородки, особенно золота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добывать самородки",
                                "target_lang_sense_clarification": "искать золото"
                            },
                            {
                                "target_lang_word": "мыть золото",
                                "target_lang_sense_clarification": "искать золотые самородки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}