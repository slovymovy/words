                "senses": [
                    {
                        "sense_id": "f438ff50-e30a-34d8-bceb-7cd0f7862a25",
                        "entry_id": "0acd613c-9289-3921-b07c-5e3bbc4a9671",
                        "glosses": [
                            "die kontrollierte Vermehrung und Aufzucht von Fischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b395496-1f74-4c63-a8f2-f1f4bcc0858b",
                                "sense_id": "f438ff50-e30a-34d8-bceb-7cd0f7862a25",
                                "text": "„Seit zwei Jahren liefert Waldland seine Fischcontainer an Bauern in der Region, damit diese die Fischzucht ein Jahr lang ausprobieren können.“"
                            },
                            {
                                "example_id": "a3851e6e-a654-4c65-879b-848e925ad59c",
                                "sense_id": "f438ff50-e30a-34d8-bceb-7cd0f7862a25",
                                "text": "„Für Oliver Krischer, Bundestagsabgeordneter von Bündnis 90/Die Grünen, sind die Ergebnisse ein deutlicher Hinweis darauf, dass in der Fischzucht Medikamente, im Falle von Malachitgrün sogar illegal, ins Futter gemischt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
