                            "past"
                        ],
                        "form": "у́мствовавши"
                    },
                    {
                        "form_id": "6e9fffb4-8bf0-45f3-a9df-3b62250d441f",
                        "entry_id": "cba487b9-3cfb-36bd-9b8c-3f314c84104a",
