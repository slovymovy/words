                        "den Pinsel eintauchen"
                    ]
                },
                {
                    "sense_id": "aaf019de-0783-3dfa-b4fe-cffe1ba4ccfe",
                    "sense_definition": "unter die Oberfläche einer Flüssigkeit geraten oder sich ganz hineinbegeben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fluessigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Schwimmer holte tief Luft, bevor er lautlos ins kalte Wasser <w>eintauchte</w>."
                        },
                        {
                            "text": "Die Kinder beobachteten begeistert, wie der Vogel kopfüber in den See <w>eintauchte</w>."
                        }
                    ],
                    "synonyms": [
                        "abtauchen",
                        "untertauchen",
                        "tauchen"
                    ],
                    "antonyms": [
