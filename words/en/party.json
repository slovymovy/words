{
    "word_family": [
        "part",
        "partisan",
        "partisanship",
        "party-goer",
        "multiparty",
        "bipartisan"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e116a696-9693-3610-913e-b448dbe54e6f",
                    "sense_definition": "A social gathering of invited guests for entertainment, eating, and drinking, often to celebrate an occasion.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "social_gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am planning to throw a huge <w>party</w> for my twenty-first birthday next month.",
                            "target_lang_translations": {
                                "ru": "Я планирую устроить огромную <w>вечеринку</w> на свой двадцать первый день рождения в следующем месяце."
                            }
                        },
                        {
                            "text": "The host invited everyone to the <w>birthday</w> <w>party</w> at the local park.",
                            "target_lang_translations": {
                                "ru": "Хозяин пригласил всех на <w>празднование</w> дня рождения в местном парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "bash",
                        "do",
                        "get-together",
                        "shindig"
                    ],
                    "common_phrases": [
                        "birthday party",
                        "throw a party",
                        "dinner party",
                        "house party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Социальное собрание приглашенных гостей для развлечения, еды и питья, часто по случаю какого-либо события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечери́нка",
                                "target_lang_sense_clarification": "дружеское собрание для отдыха"
                            },
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "торжественное официальное мероприятие"
                            },
                            {
                                "target_lang_word": "тусо́вка",
                                "target_lang_sense_clarification": "разговорное, неформальное мероприятие"
                            },
                            {
                                "target_lang_word": "па́ти",
                                "target_lang_sense_clarification": "молодежный сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                    "sense_definition": "An organized political group that seeks to influence government policy and contest elections.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "political_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The green <w>party</w> managed to take twelve percent of the total vote this year.",
                            "target_lang_translations": {
                                "ru": "Партии <w>зеленых</w> удалось набрать двенадцать процентов голосов в этом году."
                            }
                        },
                        {
                            "text": "She decided to join a <w>political</w> <w>party</w> to help campaign for better schools.",
                            "target_lang_translations": {
                                "ru": "Она решила вступить в политическую <w>партию</w>, чтобы помочь в кампании за улучшение школ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political party",
                        "ruling party",
                        "opposition party",
                        "party leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованная политическая группа, стремящаяся влиять на государственную политику и участвовать в выборах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́ртия",
                                "target_lang_sense_clarification": "политическая организация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                    "sense_definition": "A group of people gathered together for a specific purpose, such as travel, dining, or a task.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant manager asked if we had a table available for a <w>party</w> <w>of</w> <w>four</w>.",
                            "target_lang_translations": {
                                "ru": "Менеджер ресторана спросил, есть ли у нас свободный столик на <w>компанию</w> из четырех человек."
                            }
                        },
                        {
                            "text": "A large <w>party</w> of tourists arrived at the museum early in the morning.",
                            "target_lang_translations": {
                                "ru": "Большая <w>группа</w> туристов прибыла в музей рано утром."
                            }
                        }
                    ],
                    "common_phrases": [
                        "party of four",
                        "search party",
                        "tourist party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, собравшихся вместе для определенной цели, такой как путешествие, обед или выполнение задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гру́ппа",
                                "target_lang_sense_clarification": "несколько человек вместе"
                            },
                            {
                                "target_lang_word": "компа́ния",
                                "target_lang_sense_clarification": "круг людей, проводящих время вместе"
                            },
                            {
                                "target_lang_word": "отря́д",
                                "target_lang_sense_clarification": "группа для выполнения задачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4519b715-4f36-3752-8f25-edb801720ef7",
                    "sense_definition": "A person or group of people forming one side in a legal agreement, contract, or dispute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract requires that the <w>party</w> of the first part pay the full fee.",
                            "target_lang_translations": {
                                "ru": "Контракт требует, чтобы <w>сторона</w>, именуемая «Первой стороной», выплатила полную сумму вознаграждения."
                            }
                        },
                        {
                            "text": "Both <w>interested</w> <w>parties</w> must sign the document before the deal is finalized.",
                            "target_lang_translations": {
                                "ru": "Обе заинтересованные <w>стороны</w> должны подписать документ до завершения сделки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "third party",
                        "interested party",
                        "guilty party",
                        "contracting party"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или группа лиц, представляющих одну из сторон в юридическом соглашении, контракте или споре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторона́",
                                "target_lang_sense_clarification": "участник договора или спора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba5701fa-32c8-3eef-8c62-975166227d8a",
                    "sense_definition": "A small detachment of troops or personnel assigned to a specific military or official duty.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "military_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The settlers were attacked early next morning by a <w>scouting</w> <w>party</w> from the hills.",
                            "target_lang_translations": {
                                "ru": "Рано утром на поселенцев напал разведывательный <w>отряд</w> с холмов."
                            }
                        },
                        {
                            "text": "A <w>boarding</w> <w>party</w> was sent to inspect the suspicious vessel in the harbor.",
                            "target_lang_translations": {
                                "ru": "Абордажная <w>группа</w> была отправлена для досмотра подозрительного судна в гавани."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scouting party",
                        "boarding party",
                        "landing party",
                        "advance party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой отряд войск или персонала, назначенный для выполнения конкретной военной или служебной обязанности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отря́д",
                                "target_lang_sense_clarification": "воинское подразделение"
                            },
                            {
                                "target_lang_word": "гру́ппа",
                                "target_lang_sense_clarification": "специальное подразделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce25f57f-9d1d-30ad-b7e1-1564314730dc",
                    "sense_definition": "Someone who takes part in or is an accessory to an action or affair.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "participant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot possibly be a <w>party</w> <w>to</w> that kind of reckless and dangerous behavior.",
                            "target_lang_translations": {
                                "ru": "Я никак не могу быть <w>причастным</w> к такому безрассудному и опасному поведению."
                            }
                        },
                        {
                            "text": "He was accused of being a <w>party</w> to the conspiracy to defraud the company.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он был <w>участником</w> заговора с целью обмана компании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "party to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто принимает участие в каком-либо деле или является соучастником действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уча́стник",
                                "target_lang_sense_clarification": "лицо, участвующее в чем-либо"
                            },
                            {
                                "target_lang_word": "соуча́стник",
                                "target_lang_sense_clarification": "причастный к какому-либо делу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b903ab9b-0920-3523-8633-424a58726883",
                    "sense_definition": "A person or individual.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "individual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was described by his neighbors as a rather queer <w>party</w>.",
                            "target_lang_translations": {
                                "ru": "Соседи описывали старика как довольно странного <w>субъекта</w>."
                            }
                        },
                        {
                            "text": "He is a strange <w>party</w> who rarely leaves his house during the day.",
                            "target_lang_translations": {
                                "ru": "Он странный <w>тип</w>, который редко выходит из дома днем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used humorously or old-fashionedly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или личность (часто используется в ироничном или устаревшем смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ли́чность",
                                "target_lang_sense_clarification": "индивидуум"
                            },
                            {
                                "target_lang_word": "субъе́кт",
                                "target_lang_sense_clarification": "ироничное обозначение человека"
                            },
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "разговорное о человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "315b27ec-a5e8-33ff-a610-308590ed8953",
                    "sense_definition": "To celebrate at a party, have fun, or enjoy oneself in a social setting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "celebrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>partied</w> until the early hours of the morning to celebrate our graduation.",
                            "target_lang_translations": {
                                "ru": "Мы <w>веселились</w> до раннего утра, празднуя выпускной."
                            }
                        },
                        {
                            "text": "They love to <w>party</w> <w>hard</w> every time they go on vacation together.",
                            "target_lang_translations": {
                                "ru": "Они обожают <w>отрываться</w> на полную катушку каждый раз, когда едут в отпуск вместе."
                            }
                        }
                    ],
                    "synonyms": [
                        "rave"
                    ],
                    "common_phrases": [
                        "party hard",
                        "party all night"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "standard informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Праздновать на вечеринке, веселиться или наслаждаться общением в социальной обстановке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусова́ться",
                                "target_lang_sense_clarification": "разговорное, проводить время в компании"
                            },
                            {
                                "target_lang_word": "пра́здновать",
                                "target_lang_sense_clarification": "отмечать событие"
                            },
                            {
                                "target_lang_word": "развлека́ться",
                                "target_lang_sense_clarification": "весело проводить время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e61ebb87-b29e-3280-95a6-5e0f5a80608d",
                    "sense_definition": "To form a group with others, especially in a cooperative game or activity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you want to beat that monster, you should <w>party</w> <w>with</w> a healer.",
                            "target_lang_translations": {
                                "ru": "Если хочешь победить этого монстра, тебе стоит <w>объединиться</w> с целителем."
                            }
                        },
                        {
                            "text": "The players decided to <w>party</w> up before entering the difficult dungeon.",
                            "target_lang_translations": {
                                "ru": "Игроки решили <w>собраться</w> в группу перед входом в сложное подземелье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "party with",
                        "party up"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формировать группу с другими, особенно в кооперативной игре или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собира́ться в па́ти",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "объединя́ться",
                                "target_lang_sense_clarification": "вступать в группу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "38df581d-c945-39fb-bcef-878db80fabe0",
                    "sense_definition": "Favoring one specific side or group; partisan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "partisan_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee's decision was criticized for being based on <w>party</w> interests rather than facts.",
                            "target_lang_translations": {
                                "ru": "Решение комитета подверглось критике за то, что оно основывалось на <w>партийных</w> интересах, а не на фактах."
                            }
                        },
                        {
                            "text": "He avoided <w>party</w> politics to remain objective in his role as a judge.",
                            "target_lang_translations": {
                                "ru": "Он избегал <w>межпартийной</w> политики, чтобы оставаться объективным в своей роли судьи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "party politics",
                        "party line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживающий одну конкретную сторону или группу; пристрастный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парти́йный",
                                "target_lang_sense_clarification": "относящийся к политической партии"
                            },
                            {
                                "target_lang_word": "предвзя́тый",
                                "target_lang_sense_clarification": "защищающий интересы одной группы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}