                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not <w>big</w> on the idea of going out tonight.",
                            "target_lang_translations": {
                                "ru": "Я не <w>в восторге</w> от идеи куда-то идти сегодня вечером."
                            }
