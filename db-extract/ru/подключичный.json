                                "target_senses": [
                                    {
                                        "sense_id": "913b3902-0ac7-3da0-ace0-5429395c9f6a",
                                        "entry_id": "e170a694-f538-30fd-b4b1-cb94f297463d",
                                        "glosses": [
                                            "Que está debajo de la clavícula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8745ccab-9123-4b6a-b945-1a3c6e06cea6",
                                                "sense_id": "913b3902-0ac7-3da0-ace0-5429395c9f6a",
                                                "text": "Allí, una bala jezail me hirió en el hombro. La bala destrozó el hueso y rozó la vena subclavia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
