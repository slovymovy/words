                                "target_senses": [
                                    {
                                        "sense_id": "eaa0be1d-84bb-3611-9dde-5f5767772f54",
                                        "entry_id": "562e5e8e-f28b-359e-9258-e2e6a764e994",
                                        "glosses": [
                                            "Alternative form of timeserver."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "740f5927-0229-411a-94d2-163577afe3ad",
                                                "sense_id": "eaa0be1d-84bb-3611-9dde-5f5767772f54",
                                                "text": "Many railway officers complain that the deep interest of the old-school railwaymen in their job is dying; the B.T.C.'s new approach seems calculated to hasten its death and breed thousands more time-servers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
