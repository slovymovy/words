                    },
                    {
                        "translation_id": "d9f8c651-7b88-47b1-8103-0ae5f8f42797",
                        "source_entry_id": "255e6f7f-5036-3c87-9020-f40efea86958",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Heimlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1dd8b9-72ac-391c-84f6-08f698f57dd7",
                                        "entry_id": "6a30860d-4b7f-3c1d-a2e3-6ade7248b131",
                                        "glosses": [
                                            "Eigenschaft, unbekannt/verborgen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e05b7b-da47-4fef-9ecf-3b8d6ec12f36",
                                                "sense_id": "ce1dd8b9-72ac-391c-84f6-08f698f57dd7",
                                                "text": "„Dass die Heimlichkeit zudem gesetzwidrig ist, erhöht noch einmal das Wohlgefühl.“"
                                            },
                                            {
                                                "example_id": "cfb90f47-c06a-4a28-ab05-be2bf9c5eab1",
                                                "sense_id": "ce1dd8b9-72ac-391c-84f6-08f698f57dd7",
                                                "text": "„Die arabischstämmige Fernsehmoderatorin Lucy Aharish und der israelische Fernsehstar und Sänger Zachi Halevi haben am Mittwoch in aller Heimlichkeit geheiratet.“"
                                            },
                                            {
                                                "example_id": "6c7e716f-063a-4826-9c5a-4a81a48abdf5",
                                                "sense_id": "ce1dd8b9-72ac-391c-84f6-08f698f57dd7",
                                                "text": "„Er war ein Freigeist wie sie, doch in größter Heimlichkeit, denn in Salerno hatte niemand Geist; so lebte er mit seiner Frau und seiner Schwiegermutter als guter Christ und fügte sich allen Vorurteilen seiner Landsleute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e2bd89e-7459-3a63-bc55-491b08217f1c",
                                        "entry_id": "6a30860d-4b7f-3c1d-a2e3-6ade7248b131",
                                        "glosses": [
                                            "etwas, das man für sich behält/nicht weitergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b32d0e-83d7-4003-b9fb-a59de768fe4a",
                                                "sense_id": "0e2bd89e-7459-3a63-bc55-491b08217f1c",
                                                "text": "„Dann gab sie alle Heimlichkeit auf und hatte das Bedürfnis, sich ihrer Finten offen zu rühmen, und beschrieb sie mit solcher Fröhlichkeit, daß es ihre Zuhörer abstieß.“"
                                            },
                                            {
                                                "example_id": "895925c1-580e-4769-a324-08384435dcce",
                                                "sense_id": "0e2bd89e-7459-3a63-bc55-491b08217f1c",
                                                "text": "„Seit dieser Zeit wußten alle, daß Schneeholdchen und Lai-wang Heimlichkeiten hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
