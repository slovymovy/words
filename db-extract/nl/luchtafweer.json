                        "examples": [
                            {
                                "example_id": "701c97e0-0322-4554-99d3-5184b7f172bd",
                                "sense_id": "740a1d72-0feb-3156-b3c0-e8551d74db86",
                                "text": "Het Russische leger heeft maandag gewaarschuwd dat alle vliegtuigen en drones van de internationale coalitie die ten westen van de Eufraat vliegen, ‘zullen worden gevolgd’. Ze zullen ook als ‘doelwit gelden’ voor de Russische luchtafweer en luchtmacht in Syrië."
                            },
                            {
                                "example_id": "8aa0a730-a873-44a8-84aa-3f7feeb8dbf8",
                                "sense_id": "740a1d72-0feb-3156-b3c0-e8551d74db86",
                                "text": "Dat Noord-Korea lanceerbases bouwt voor de kust is ongewoon, want die liggen er traditioneel in de bergen. Ze zouden wel ideaal zijn om luchtafweer te bouwen voor projectielen die van schepen of vliegtuigen komen."
                            }
                        ]
                    }
