                                        "sense_id": "bcc2927a-8d43-3dba-8079-6754a3ff7cf4",
                                        "entry_id": "0c5ea519-f2b6-38d6-8856-52c27afc7631",
                                        "glosses": [
                                            "Gegenstand von Sagen seiend; in vielen Sagen vorkommend, auch sehr bedeutend, aber im Dunkeln liegend"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1458121-929b-4cea-a3b2-cc8f60512610",
                                                "sense_id": "bcc2927a-8d43-3dba-8079-6754a3ff7cf4",
                                                "text": "„Unterhalb der sagenumwobenen Burgruine gelegen, war sicherlich ein Gasthaus auch schon damals für seine deftigen Speisen und bequemen Betten landläufig bekannt.“."
                                            },
                                            {
                                                "example_id": "c16ad519-5f58-41cb-9823-f697120bbf7e",
                                                "sense_id": "bcc2927a-8d43-3dba-8079-6754a3ff7cf4",
                                                "text": "Der König wohnte in einem sagenumwobenen Schloss."
                                            },
                                            {
                                                "example_id": "53009be5-cbea-42d9-8734-1eac4a336a48",
                                                "sense_id": "bcc2927a-8d43-3dba-8079-6754a3ff7cf4",
                                                "text": "Die Familie gelangte durch Ostindien-Handel zu sagenumwobenem Reichtum."
                                            },
                                            {
                                                "example_id": "b0254942-8e2c-4d4d-9163-0727265c36da",
                                                "sense_id": "bcc2927a-8d43-3dba-8079-6754a3ff7cf4",
                                                "text": "„Um 183 v.Chr. rückte Demetrios in einem sagenumwobenen Feldzug bis vor die Tore der Maurya-Hauptstadt Puschyamitra in der Gangesebene vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
