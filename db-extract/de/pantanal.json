                "senses": [
                    {
                        "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                        "entry_id": "9d68994d-ddfd-3d27-a936-eecfcab1485c",
                        "glosses": [
                            "unter Naturschutz stehendes Feuchtbiotop in Südamerika, das sich in den brasilianischen Bundesstaaten Mato Grosso, Mato Grosso do Sul und dem Mato-Grosso-Plateau sowie in Teilen von Bolivien und Paraguay befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a52f79-93c6-42b9-b14b-137bf93e7bd1",
                                "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                                "text": "Obwohl das Pantanal im Jahr 2000 zum Weltnaturerbe durch die UNESCO erklärt wurde, ist es dennoch stark durch die Industrialisierung und Rodungen gefährdet."
                            },
                            {
                                "example_id": "aac7e3a8-9e70-4d32-9f12-f5da8a4db538",
                                "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                                "text": "Das Symbol und Wappentier des Pantanals ist der Vogel Jabiru, ein Riesenstorch, bei welchem vor allem die gelben Augen der Weibchen und dunklen Augen der Männchen auffallend sind."
                            },
                            {
                                "example_id": "e15f57c4-a6e5-4026-8a88-772be58aef25",
                                "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                                "text": "Auf dem Gebiet von Mato Grosso wurden schon rund zwei Millionen Hektar oder mehr als zehn Prozent der Vegetation des Pantanal zerstört."
                            },
                            {
                                "example_id": "43cf638e-9abd-466d-8bef-51d3ecc1709f",
                                "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                                "text": "Biologen sprechen von einer Katastrophe, handelt es sich beim Pantanal doch um eines der artenreichsten Naturgebiete, das viele seltene Tierarten beheimatet."
                            },
                            {
                                "example_id": "8eeff31b-5865-4946-b464-753ebfc949d3",
                                "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                                "text": "Weiter südlich im Pantanal verdreifachte sich die Zahl der Brände im Vergleich zum August 2019."
                            },
                            {
                                "example_id": "618ebbeb-ccfe-4ca1-b085-0cdf7dbfc2c4",
                                "sense_id": "5282e630-85a1-32e1-9c5f-8c523302c50e",
                                "text": "Das Pantanal ist nun offiziell von der Unesco zum Biosphärenreservat ausgewiesen worden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
