                            {
                                "target_word": "charpoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb0faba-02df-32e2-8e04-6c13a199f8c0",
                                        "entry_id": "30c44f9b-b09a-3615-8544-5035b392e654",
                                        "glosses": [
                                            "A traditional bedstead used in South Asia, consisting of a wooden frame bordering a set of knotted ropes."
                                        ],
                                        "tags": [
                                            "South-Asia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424d062c-2191-42f2-bd67-1a776b46e880",
                                                "sense_id": "bbb0faba-02df-32e2-8e04-6c13a199f8c0",
                                                "text": "Here is a charpoy on which two can sit, and it is possible that there may, from time to time, be food in that platter."
                                            },
                                            {
                                                "example_id": "682605e1-cbd8-4dd5-b387-fa7e20451600",
                                                "sense_id": "bbb0faba-02df-32e2-8e04-6c13a199f8c0",
                                                "text": "Flory crossed the brick-like earth of the yard between the hospital sheds. All down the wide verandas, on sheetless charpoys, rows of grey-faced men lay silent and moveless."
                                            },
                                            {
                                                "example_id": "63dda25f-aee9-48a5-9e0e-c885f1ed163c",
                                                "sense_id": "bbb0faba-02df-32e2-8e04-6c13a199f8c0",
                                                "text": "There, every morning, tens of thousands of young men sit in the tea shops, reading the newspaper, or lie on a charpoy humming a tune, or sit in their rooms talking to a photo of a film actress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
