                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3799548-9903-4149-8f73-9f2acea56836",
                        "source_entry_id": "412279c9-32fd-34d8-b8e5-633773e8df1d",
                        "source_sense_id": "93f5f3f6-5fc2-3d91-a9c5-ddf4b10b4783",
                        "target_lang_word": "at the same time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at the same time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "At the same instant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8608ac4d-459e-4321-b493-1dec99f23cd7",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "Their departures were at the same time."
                                            },
                                            {
                                                "example_id": "a7b7000e-ee3d-4ca2-b9fe-798afda0fbbd",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "They departed at the same time."
                                            },
                                            {
                                                "example_id": "dc26530c-95a2-47f9-8796-0dd73f7729e6",
                                                "sense_id": "77a86f5b-671d-3d35-8b7c-2dcb3dcf117a",
                                                "text": "I bid him come towards me and give me his letter, at the same time throwing down, carelessly, a book I had in my hands.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "Overlapping or coinciding in duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab6badd-fad5-4e15-b6f4-981e7eca78b4",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "His service as chairman was at the same time as his board membership"
                                            },
                                            {
                                                "example_id": "b5a99962-f54f-4efd-9f8f-a31ba212df61",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "I'm working. But at the same time, I'm exercising too."
                                            },
                                            {
                                                "example_id": "4a8eed97-83df-40cb-9413-c8406b41a943",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                                            },
                                            {
                                                "example_id": "39aa47fe-7058-49cd-b2dd-c5672a051261",
                                                "sense_id": "e26a4312-252d-3b3e-b101-c7e908c6cca9",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cb6b64-bab6-37aa-85a4-083be4581f2f",
                                        "entry_id": "73bfff3f-ec81-3182-9d3a-f79647229543",
                                        "glosses": [
                                            "On the other hand (introducing an opposing viewpoint)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20eef6ec-fea7-48e1-81a8-8f5eab5ccaa6",
                        "source_entry_id": "412279c9-32fd-34d8-b8e5-633773e8df1d",
                        "source_sense_id": "93f5f3f6-5fc2-3d91-a9c5-ddf4b10b4783",
                        "target_lang_word": "also",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "also",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "352fa140-03ae-315e-827f-2b5a8c95e0fd",
                                        "entry_id": "628d03c4-0c58-34a7-962e-1ae62556d773",
                                        "glosses": [
                                            "In addition; besides; as well; further; too."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "focus",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16510371-d936-4c02-828c-b86d7ae7615a",
                                                "sense_id": "352fa140-03ae-315e-827f-2b5a8c95e0fd",
                                                "text": "Everyone had eggs for breakfast, but Alice also had toast."
                                            },
                                            {
                                                "example_id": "9e7b076d-78c2-4fbb-ba7b-8f2fc7455519",
                                                "sense_id": "352fa140-03ae-315e-827f-2b5a8c95e0fd",
                                                "text": "The subject of denoting is of very great importance, not only in logic and mathematics, but also in the theory of knowledge."
                                            },
                                            {
                                                "example_id": "419679a3-d1be-4a92-a3f2-ab843acfa2f6",
                                                "sense_id": "352fa140-03ae-315e-827f-2b5a8c95e0fd",
                                                "text": "Thus the red damask curtains which now shut out the fog-laden, drizzling atmosphere of the Marylebone Road, had cost a mere song, and yet they might have been warranted to last another thirty years. A great bargain also had been the excellent Axminster carpet which covered the floor;[…]."
                                            },
                                            {
                                                "example_id": "4459fcc2-8c73-412d-86af-72445f788e65",
                                                "sense_id": "352fa140-03ae-315e-827f-2b5a8c95e0fd",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a1176a0-d3a3-320f-81d2-83bb63b4b0ab",
                                        "entry_id": "628d03c4-0c58-34a7-962e-1ae62556d773",
                                        "glosses": [
                                            "To the same degree or extent; so, as."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec55e70-fa13-4169-a990-e7afaacaf74a",
                                                "sense_id": "9a1176a0-d3a3-320f-81d2-83bb63b4b0ab",
                                                "text": "[…] thereupon the queen's majesty […] did send a solemn ambassade of her privy-counsellors, whereof one was an ancient earl of the realm, the other also an ancient baron of the same, and others of the council of her state […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
