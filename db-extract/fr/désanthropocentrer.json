                ],
                "senses": [
                    {
                        "sense_id": "189058e4-e01b-32a7-86cd-7b57792d6afe",
                        "entry_id": "e9c9a95b-24e1-33e8-a84d-55f15ee306bc",
                        "glosses": [
                            "Faire perdre son caractère centré sur l’être humain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6725b310-83c8-49c6-b4c3-cdd97509d4e1",
                                "sense_id": "189058e4-e01b-32a7-86cd-7b57792d6afe",
                                "text": "Méditant sur ces limitations congrues de la pensée, il apparaît que c’est moins la logique humaine qui conduit le savoir, que notre environnement imposant des raisons de progressivement désanthropocentrer les lois à le modéliser."
                            },
                            {
                                "example_id": "57a24844-e11a-4b83-9534-d037f4bf930a",
                                "sense_id": "189058e4-e01b-32a7-86cd-7b57792d6afe",
                                "text": "Il serait aussi nécessaire que cette élite ait appris à pouvoir, à volonté, désanthropocentrer sa vision des choses."
                            },
                            {
                                "example_id": "39a1b185-f778-4aa0-a45d-4e811ba53075",
                                "sense_id": "189058e4-e01b-32a7-86cd-7b57792d6afe",
                                "text": "La nature va alors se « désanthropocentrer », et subir une approche plus scientifique."
                            }
                        ]
                    }
                ],
                "translations": [
