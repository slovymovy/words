        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf7774c9-1990-3e2a-a379-0d3c27bde57f",
                    "sense_definition": "Het vermogen of de eigenschap om moed te tonen en iets te doen wat eng of gevaarlijk is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had de <w>durf</w> om zijn baas tegen te spreken tijdens de vergadering.",
                            "target_lang_translations": {
                                "ru": "У него хватило <w>смелости</w> возразить начальнику во время собрания.",
                                "en": "He had the <w>courage</w> to contradict his boss during the meeting.",
                                "de": "Er hatte den <w>Mut</w>, seinem Chef während der Besprechung zu widersprechen."
                            }
                        },
                        {
                            "text": "Er is veel <w>durf</w> nodig om zo'n groot risico te nemen.",
                            "target_lang_translations": {
                                "ru": "Нужна большая <w>смелость</w>, чтобы пойти на такой большой риск.",
                                "en": "A lot of <w>daring</w> is needed to take such a big risk.",
                                "de": "Es ist viel <w>Mut</w> erforderlich, um ein so großes Risiko einzugehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "moed",
                        "lef",
                        "dapperheid"
                    ],
                    "antonyms": [
                        "lafheid",
                        "angst"
                    ],
                    "common_phrases": [
                        "de durf hebben",
                        "gebrek aan durf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность или качество проявлять смелость и делать что-то страшное или опасное",
                        "en": "The ability or quality to show courage and do something scary or dangerous",
                        "de": "Die Fähigkeit oder Eigenschaft, Mut zu zeigen und etwas zu tun, das beängstigend oder gefährlich ist"
                    },
