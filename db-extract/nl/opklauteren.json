                            {
                                "example_id": "9ece796c-058c-4915-a1d4-3f68e38ed650",
                                "sense_id": "14a3e79f-a51c-3b35-9201-0c74e5a6490b",
                                "text": "Het dijkje opklauteren ging prima, afdalen is lastiger. Zelfs tussen Faye en Ruby blijft hij met moeite overeind."
                            },
                            {
                                "example_id": "05bc6ea8-aa00-4f42-a3b7-f8a851b7d4da",
                                "sense_id": "14a3e79f-a51c-3b35-9201-0c74e5a6490b",
                                "text": "Zo zien we zwaarbewapende eenheden in de buurt van de bezette joodse supermarkt wat onwennig een dijkje opklauteren en rustig tegen een muurtje leunen. \"Misschien zijn die jongens al wel 24 uur in touw en proberen ze een klein beetje rust te pakken\", schetst Van Buuren."
                            }
                        ]
                    }
