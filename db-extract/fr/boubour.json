                        ],
                        "examples": [
                            {
                                "example_id": "74f60dda-8b59-402e-af72-841748b53eea",
                                "sense_id": "2bcc858d-79eb-3d49-87bd-fcc1b7b89ee5",
                                "text": "Aucun sociologue ne s’accorde sur la réalité sociologique du bobo, et c’est le même problème pour le boubour."
                            },
                            {
                                "example_id": "e2032687-a858-46e2-96e1-0209e170a917",
                                "sense_id": "2bcc858d-79eb-3d49-87bd-fcc1b7b89ee5",
                                "text": "Le boubour a fait des seventies son âge d’or –on peut voir dans l’adulation ironique de Chirac jeune, la marque Le Slip français ou les films de Jean Dujardin des indices de ce rétro-masculinisme désormais à la mode."
                            },
                            {
                                "example_id": "91cf3faf-93ca-495b-9afd-6a22cd504e16",
                                "sense_id": "2bcc858d-79eb-3d49-87bd-fcc1b7b89ee5",
                                "text": "Celui que Sarah considérait avec amusement comme un « boubour » (un bourgeois bourrin, sorte d’antithèse du bobo) se transforme rapidement en tyran domestique."
                            }
                        ]
                    }
