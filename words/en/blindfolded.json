{
    "word_family": [
        "blind",
        "blindfold"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b283fbd1-d584-3ceb-8061-901ce394c82e",
                    "sense_definition": "Having the eyes covered with a cloth or similar material to prevent seeing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played a game while <w>blindfolded</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "Дети играли в игру <w>с завязанными глазами</w> в саду."
                            }
                        },
                        {
                            "text": "She stood <w>blindfolded</w> while waiting for her surprise party to begin.",
                            "target_lang_translations": {
                                "ru": "Она стояла <w>с завязанными глазами</w>, ожидая начала вечеринки-сюрприза."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoodwinked"
                    ],
                    "common_phrases": [
                        "remain blindfolded",
                        "stay blindfolded"
                    ],
                    "target_lang_definitions": {
                        "ru": "С закрытыми повязкой глазами, что лишает человека возможности видеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с завязанными глазами",
                                "target_lang_sense_clarification": "описание состояния человека, у которого глаза закрыты повязкой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74f829d3-3675-370f-ab2f-3d841eda9a98",
                    "sense_definition": "Simple past and past participle of <w>blindfold</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>blindfolded</w> the prisoner before moving him to a new location.",
                            "target_lang_translations": {
                                "ru": "Они <w>завязали глаза</w> заключенному перед тем, как перевезти его в другое место."
                            }
                        },
                        {
                            "text": "He was <w>blindfolded</w> by his friends for the surprise.",
                            "target_lang_translations": {
                                "ru": "Друзья <w>завязали ему глаза</w> ради сюрприза."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время или причастие от глагола «завязывать глаза» (кому-либо)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завязал глаза",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            },
                            {
                                "target_lang_word": "с завязанными глазами",
                                "target_lang_sense_clarification": "краткое причастие в пассивном залоге"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}