    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f51def11-a762-31e3-a1ab-06acdff6b878",
                    "sense_definition": "Fixer attentivement et obstinément quelque chose, en parlant du regard ou de l'attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant gardait les yeux <w>rivés</w> sur l'écran pendant toute la soirée."
                        },
                        {
                            "text": "Elle <w>riva</w> son regard sur son interlocuteur pour tenter de deviner ses intentions réelles."
                        }
                    ],
                    "synonyms": [
                        "fixer"
                    ],
                    "antonyms": [
                        "détourner"
                    ],
                    "common_phrases": [
                        "yeux rivés sur",
                        "river ses yeux",
                        "river son regard"
                    ]
                },
                {
                    "sense_id": "cc4ec47d-2bec-3754-81bf-1f2a815df21d",
                    "sense_definition": "Attacher, lier étroitement ou assujettir fortement une personne ou une chose à un état, un lieu ou une fonction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis plusieurs années, ses responsabilités semblent le <w>river</w> à son bureau sans répit."
                        },
                        {
                            "text": "Une maladie soudaine l'a <w>rivé</w> au lit pendant plus de trois semaines."
                        }
                    ],
                    "synonyms": [
                        "assujettir",
                        "enchaîner"
                    ],
                    "antonyms": [
                        "délier",
                        "libérer"
                    ],
                    "common_phrases": [
                        "être rivé à",
                        "se trouver rivé"
                    ]
                },
                {
                    "sense_id": "ae154464-05de-3580-95c1-eb025d555083",
                    "sense_definition": "Assembler des pièces métalliques ou des tôles au moyen de rivets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier doit soigneusement <w>river</w> chaque plaque de métal avec une machine adaptée."
                        },
                        {
                            "text": "Les charpentiers ont choisi de <w>river</w> les poutres pour garantir la solidité du pont."
                        }
                    ],
                    "synonyms": [
                        "riveter"
                    ],
                    "common_phrases": [
                        "river des tôles",
                        "river des plaques"
                    ]
                },
                {
                    "sense_id": "47cf5494-b807-3c68-bbce-92c2265848ef",
                    "sense_definition": "Rabattre et aplatir la pointe d'un clou qui dépasse pour consolider une fixation en menuiserie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan frappe au marteau afin de <w>river</w> la pointe du clou qui traverse la planche."
                        },
                        {
                            "text": "Il faut d'abord bien enfoncer puis <w>river</w> les pointes pour bloquer les volets."
                        }
                    ],
                    "common_phrases": [
                        "river un clou"
                    ]
                }
            ]
        },
