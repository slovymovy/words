                        "examples": [
                            {
                                "example_id": "f6b14222-98dc-4d03-94b5-ca1d6a0bdf9d",
                                "sense_id": "16ae5455-d749-3019-b544-58482717e702",
                                "text": "Dit jaar won Moonlight als eerste LGBT-film een Oscar voor beste film. Daarvoor werd Brokeback Mountain (2006) wel voor deze ultieme filmprijs genomineerd. Ian McKellen (1998, Gods and Monsters) en Jaye Davison (1992, The Crying Game) zijn de enige LHBT-acteurs die een Oscarnominatie kregen voor het spelen van een LHBT-rol. “Heel goed dat Moonlight die Oscar wint”, reageert Borkes. “Maar qua LHBT-film is er nog zoveel meer. Het moet niet bij één film blijven.”"
                            },
                            {
                                "example_id": "f4f68953-9b03-49d0-a5e5-489e22f53b83",
                                "sense_id": "16ae5455-d749-3019-b544-58482717e702",
                                "text": "De serie, wereldwijd te zien op Netflix, draait om de dagelijkse beslommeringen van een groep middelbare scholieren in Australië. In dat land werd het eerste seizoen vorig jaar al bekroond met zes AACTA-prijzen, de belangrijkste Australische filmprijzen. Netflix heeft aangekondigd dat er een tweede seizoen komt."
                            }
                        ]
