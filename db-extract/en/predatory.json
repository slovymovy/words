    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                "word": "predatory",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6c5749bb-03ef-41a9-9b84-defd14db3871",
                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more predatory"
                    },
                    {
                        "form_id": "e5938557-56c1-4645-a952-295a4a86288b",
                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most predatory"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "glosses": [
                            "Of, or relating to a predator."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade8d4e7-309a-468a-9ad7-3bbca8ffc171",
                                "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                                "text": "Harry Kane was back to his predatory best after struggling in the group stage, following up his goal against Germany by poking home a superb pass from Raheem Sterling after only four minutes."
                            },
                            {
                                "example_id": "7b5721da-3b26-45f9-ba5e-41fa54a8cf77",
                                "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                                "text": "And while there are plenty of benches, there's little shelter from the wind (or predatory seagulls the size of dogs) out on the platforms."
                            }
                        ]
                    },
                    {
                        "sense_id": "119774da-9bf6-3681-83f8-2ac48881fdc5",
                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "glosses": [
                            "Living by preying on other living animals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20cc03b1-6a35-4b24-9865-fae78e24cb4c",
                                "sense_id": "119774da-9bf6-3681-83f8-2ac48881fdc5",
                                "text": "The mark of his father’s early life was strong upon him and enhanced by months of association with beasts, from whom the imitative faculty of youth had absorbed a countless number of little mannerisms of the predatory creatures of the wild."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "glosses": [
                            "Exploiting or victimizing others for personal gain."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c48debe3-a3f5-4edb-af0d-a2949968855d",
                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                "text": "predatory lending"
                            },
                            {
                                "example_id": "5d7cd6e0-338e-4f09-8bbb-f4d136f05e5f",
                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                "text": "predatory inclusion"
                            },
                            {
                                "example_id": "47056a90-4b37-4070-b77d-990f0d6a3c5a",
                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                "text": "One very important section of the denizens of Darkest England are the criminals and the semi-criminals. They are more or less predatory, and are at present shepherded by the police and punished by the gaoler."
                            },
                            {
                                "example_id": "d83f9ab4-ded5-452f-9be0-08fedb7ece9f",
                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                "text": "The purpose of government was the guarding of property-rights, the perpetuation of ancient force and modern fraud. Or was it marriage? Marriage and prostitution were two sides of one shield, the predatory man’s exploitation of the sex-pleasure."
                            },
                            {
                                "example_id": "cd3087ba-0751-4ce2-865e-29d5678ec53f",
                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                "text": "Francis had promised to take the matter seriously, recruiting victims of predatory priests to a Vatican commission he set up to stamp out abuse, but several resigned soon afterwards, judging that he was not prepared to make the changes needed and hand oversight of the church’s handling of such cases to a completely independent body."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bf2166c-99d5-4ecb-b754-7ad1b9da9881",
                        "source_entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "source_sense_description": "relating to predators",
                        "target_lang_word": "roofachtig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "da12132b-a1ec-407e-93e4-2abf7c9b6d5d",
                        "source_entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "source_sense_description": "relating to predators",
                        "target_lang_word": "prédateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07e4461d-58c9-3475-9e37-3bddc361ffc4",
                                        "entry_id": "d47ddbed-e292-3812-94a7-9163d3e9e1d1",
                                        "glosses": [
                                            "Animal qui capture un autre animal, sa proie, pour s’en nourrir ou pour alimenter sa progéniture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f17d5b9-5e3b-4087-b6e9-4ae3b54c6e63",
                                                "sense_id": "07e4461d-58c9-3475-9e37-3bddc361ffc4",
                                                "text": "Les laboratoires ne savent plus quoi inventer, […]. Mais rien de tout cela n'est décisif, la vraie solution serait d'enseigner au cafard à être son propre prédateur, Pinchard y croit dur comme fer, il sélectionne l'agressivité, prépare la guerre civile, la blatte germanique contre le zyzzyva ou beattle yankee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1478f3d3-f649-343d-80b8-c3bb070fe0a4",
                                        "entry_id": "d47ddbed-e292-3812-94a7-9163d3e9e1d1",
                                        "glosses": [
                                            "Personne qui abuse d’une autre, plus vulnérable qu’elle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d368d203-03b8-416e-88e3-99dc7da30fa6",
                                                "sense_id": "1478f3d3-f649-343d-80b8-c3bb070fe0a4",
                                                "text": "[Titre] Pédophilie dans le foot anglais : quarante ans après, Chelsea reconnaît que son recruteur était un prédateur"
                                            },
                                            {
                                                "example_id": "0ddac309-4b5d-4f88-8939-1966a0c5feda",
                                                "sense_id": "1478f3d3-f649-343d-80b8-c3bb070fe0a4",
                                                "text": "[…] Meilan et Maringil furent les derniers à se retirer. Dans leur perplexité, ils ne s’étaient même pas aperçus qu’ils se tenaient côte à côte. Un beau duo de prédateurs au regard de charognard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prédateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d893ebf0-51d2-3f54-a7cc-899d7bd86feb",
                                        "entry_id": "45bf6bb8-e386-35f1-8f99-484831472fcf",
                                        "glosses": [
                                            "Qui se nourrit d'espèces animales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b437e8c2-1b86-428b-93ab-1f38da9bb813",
                                                "sense_id": "d893ebf0-51d2-3f54-a7cc-899d7bd86feb",
                                                "text": "A l’exception de quelques espèces lichénivores, fongivores ou occasionnellement voire exclusivement prédatrices, les larves sont phytophages (généralement oligophage ou monophage). Parmi les espèces nuisibles rencontrées en serres, la majorité sont polyphages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "165ad098-bc65-3ff6-9472-d24aa68e316b",
                                        "entry_id": "45bf6bb8-e386-35f1-8f99-484831472fcf",
                                        "glosses": [
                                            "Qui est de nature à détruire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77a44fb-4730-4850-908d-f23f46c3fba3",
                                                "sense_id": "165ad098-bc65-3ff6-9472-d24aa68e316b",
                                                "text": "Elle implique que soit brisé le lien infernal qui constitue des masses populaires fragmentées et désagrégées en majorités potentiellement prédatrices et en minorités ennemies."
                                            },
                                            {
                                                "example_id": "4494ffcb-0419-4b23-904d-8a5da8c1f4c6",
                                                "sense_id": "165ad098-bc65-3ff6-9472-d24aa68e316b",
                                                "text": "Il y a donc des langues prédatrices, en somme, qui dévorent les autres. – Prédatrices, grâce à leur prestige."
                                            },
                                            {
                                                "example_id": "4b484ec0-1fbc-4625-aba7-bd535898857e",
                                                "sense_id": "165ad098-bc65-3ff6-9472-d24aa68e316b",
                                                "text": "[…] plasticage à Rennes du « monument de la honte », installé en 1911 dans une niche de la mairie, qui montrait Anne de Bretagne humblement agenouillée devant un roi de France prédateur, un événement dont a retenti toute mon enfance."
                                            },
                                            {
                                                "example_id": "27eeb7b3-82a0-4ea7-b744-0b370dc1ce73",
                                                "sense_id": "165ad098-bc65-3ff6-9472-d24aa68e316b",
                                                "text": "Mais il s’agit du modèle économique le plus prédateur que nous ayons jamais connu ! Il est question d’identifier l’humain uniquement et continuellement comme une cible marchande, en collectant tous les flux du réel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e32c323-40db-4acf-a53b-73a17501304d",
                        "source_entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                        "source_sense_description": "relating to predators",
                        "target_lang_word": "räuberisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "räuberisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a42b51e-afc8-3f2e-8401-38d32f7810af",
                                        "entry_id": "85b92984-9d8b-30b7-9db3-e095d2a17e31",
                                        "glosses": [
                                            "von Raub, Raubgier gekennzeichnet, darin begründet; in der Art und Weise eines Räubers handelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439c31ad-94a7-4dc8-9624-f8271cf32f2f",
                                                "sense_id": "0a42b51e-afc8-3f2e-8401-38d32f7810af",
                                                "text": "„Diese Mapimi ist ein wahrer Mehlwürmertopf, aus welchem zu allen Zeiten die wilden Völkerschaften hervorgebrochen sind, um sich räuberisch auf die angrenzenden Länder zu werfen.“"
                                            },
                                            {
                                                "example_id": "f6667b66-122b-48e6-be75-98f6f69f2bf6",
                                                "sense_id": "0a42b51e-afc8-3f2e-8401-38d32f7810af",
                                                "text": "„Warum sollte dieser Mann, der sich stets räuberisch alle Vorteile zuzuschanzen wußte, nicht sich auch räuberisch sein Leben nehmen, ehe die Polizei zugreifen konnte?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53363f23-8616-3624-8ced-7e2f3e292c54",
                                        "entry_id": "85b92984-9d8b-30b7-9db3-e095d2a17e31",
                                        "glosses": [
                                            "als Prädator, Raubtier lebend; auf Beutefang gehend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63bd1f1d-cc64-4f1f-93d6-ab7954152bf4",
                                                "sense_id": "53363f23-8616-3624-8ced-7e2f3e292c54",
                                                "text": "„[Groppen] sind am Boden lebende Fische. Sie haben einen abgeflachten, breiten Körper, große Augen ein breites Maul und sitzen am Gewässergrund, wo sie sich räuberisch von Kleintieren ernähren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
