                "senses": [
                    {
                        "sense_id": "42ee7a01-6a01-317b-b216-3db94790269f",
                        "entry_id": "47252a60-0f2a-3a7f-951f-b2bbf5401dc5",
                        "glosses": [
                            "drankje dat men gebruikt om het hoesten te verlichten en te verminderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e08c319-3399-4b98-8f1c-3a0d7726ab5a",
                                "sense_id": "42ee7a01-6a01-317b-b216-3db94790269f",
                                "text": "Inmiddels is een apotheek die de hoestdrank verkocht, gesloten. De hoestdrank is zonder recept te krijgen en kost zo'n 33 eurocent per fles. Het lijkt erop dat de mensen die het goedje dronken, al langer verslaafd waren aan het goedje. Het medicijn kan, wanneer het in grote hoeveelheden wordt gedronken, ervoor zorgen dat je high wordt."
                            },
                            {
                                "example_id": "ede039b2-b88d-49b5-83d8-6fe29592cd34",
                                "sense_id": "42ee7a01-6a01-317b-b216-3db94790269f",
                                "text": "Op bijna alle medicijnen die zonder recept verkrijgbaar zijn, zoals hoestdrank, komt binnenkort te staan tot wanneer het middel is te gebruiken als het is aangebroken. Dat meldt het College ter Beoordeling van Geneesmiddelen (CBG). Het college had de medicijnfabrikanten hiertoe opgeroepen."
                            }
                        ]
                    }
