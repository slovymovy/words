                        "sense_id": "e1ff4675-5464-3c4d-9cad-35d23cb9a6fb",
                        "entry_id": "c409ef65-462e-3834-b0bc-1691b60ed345",
                        "glosses": [
                            "Mauvais cheval."
                        ],
