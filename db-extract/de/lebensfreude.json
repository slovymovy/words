                        "form": "der Lebensfreude"
                    },
                    {
                        "form_id": "dde0a645-5ae4-4fb6-bf37-811870a4799a",
                        "entry_id": "dae86779-cdaa-32f8-b40f-ea170ae9465a",
                        "tags": [
                            "accusative",
