                                "target_senses": [
                                    {
                                        "sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                                        "entry_id": "f7aba54a-0967-3abf-87d1-d603a3c05852",
                                        "glosses": [
                                            "A fluid that has exuded from somewhere; especially one that has exuded from a pore of an animal or plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dcdb9fa-e8f8-47e7-aa17-6b2ba91fe963",
                                                "sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                                                "text": "The whitish lines of exudate seem at times to penetrate even between the straight tubes . . ."
                                            },
                                            {
                                                "example_id": "30142722-d2ea-44a2-93ca-5859e07c1af8",
                                                "sense_id": "7038f302-d3ea-30df-80ab-a9b1710ae1fc",
                                                "text": "When this is done, one should leave the poppy for some time, then return to it and gather any further exudate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exudate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd515eef-521f-3232-9597-e618b72a6a70",
                                        "entry_id": "caa1f748-0397-3d85-8eac-207d564e1d10",
                                        "glosses": [
                                            "To exude."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7452c7ad-e682-47e7-a6b1-aa4516d1a05c",
                                                "sense_id": "bd515eef-521f-3232-9597-e618b72a6a70",
                                                "text": "There is, hereto, no derivation of the seminal parts, nor any passage from hence, unto the vessels of ejaculation: some perforations only in the part itself, through which the humour included doth exudate"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
