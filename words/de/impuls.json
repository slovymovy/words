                        "wichtige Impulse erhalten"
                    ]
                },
                {
                    "sense_id": "4d3b1466-def1-3b73-8a77-5fc2010cb254",
                    "sense_definition": "plötzliche seelische Regung oder spontaner innerer Drang, etwas Bestimmtes zu tun",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie widerstand dem ersten <w>Impuls</w>, wütend auf die ungerechte Anschuldigung zu reagieren."
                        },
                        {
                            "text": "Er kaufte das teure Gemälde aus einem spontanen <w>Impuls</w> heraus."
                        }
                    ],
                    "synonyms": [
                        "Drang",
                        "Trieb",
                        "Regung"
                    ],
                    "common_phrases": [
                        "einem Impuls folgen",
                        "spontaner Impuls"
                    ]
                },
                {
                    "sense_id": "8c40253c-4d8d-368a-8327-d6a6a4dd8e68",
                    "sense_definition": "physikalische Größe, die das Produkt aus Masse und Geschwindigkeit eines bewegten Körpers beschreibt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim elastischen Stoß zweier Kugeln bleibt der gesamte <w>Impuls</w> erhalten."
                        },
                        {
                            "text": "In der klassischen Mechanik berechnet man den <w>Impuls</w> durch Multiplikation von Masse und Geschwindigkeit."
