                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diabetes can often cause damage to the <w>peripheral</w> nerves in the feet.",
                            "target_lang_translations": {
