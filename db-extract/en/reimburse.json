                        "translation_id": "950f37a5-37cb-4ca6-9d14-fd80f97cf37b",
                        "source_entry_id": "6b36b1a1-e717-3a20-a2db-d63399a7ce9a",
                        "source_sense_id": "a7ef2fd5-f6b1-384d-9f5b-852af8349553",
                        "source_sense_description": "to compensate with pay or money; especially, to repay money spent on one's behalf",
