                    "examples": [
                        {
                            "text": "I <w>generally</w> have a walk in the park during the afternoon.",
                            "target_lang_translations": {
                                "ru": "Я <w>обычно</w> гуляю в парке днём.",
                                "zh": "我下午<w>通常</w>会去公园散步。",
                                "nl": "Ik ga <w>meestal</w> 's middags wandelen in het park.",
                                "pl": "<w>Zwykle</w> chodzę po południu na spacer do parku.",
                                "de": "Ich mache <w>üblicherweise</w> am Nachmittag einen Spaziergang im Park.",
                                "fr": "Je vais <w>généralement</w> me promener au parc l'après-midi.",
                                "it": "<w>Di solito</w> faccio una passeggiata al parco durante il pomeriggio.",
                                "cs": "Odpoledne <w>obvykle</w> chodím na procházku do parku.",
                                "tr": "Öğleden sonraları <w>genellikle</w> parkta yürüyüş yaparım.",
                                "es": "<w>Por lo general</w>, doy un paseo por el parque durante la tarde."
                            }
                        },
                        {
                            "text": "<w>Generally</w> speaking, it takes about an hour to get there by train.",
                            "target_lang_translations": {
                                "ru": "<w>Вообще говоря</w>, дорога туда на поезде занимает около часа.",
                                "zh": "<w>总的来说</w>，坐火车去那里大约需要一个小时。",
                                "nl": "<w>Over het algemeen</w> duurt het ongeveer een uur om er met de trein te komen.",
                                "pl": "<w>Ogólnie</w> rzecz biorąc, dojazd pociągiem na miejsce zajmuje około godziny.",
                                "de": "<w>Im Allgemeinen</w> dauert die Fahrt mit dem Zug dorthin etwa eine Stunde.",
                                "fr": "<w>En général</w>, il faut environ une heure pour s'y rendre en train.",
                                "it": "<w>In generale</w>, ci vuole circa un'ora per arrivare lì in treno.",
                                "cs": "<w>Obecně řečeno</w>, cesta vlakem tam trvá asi hodinu.",
                                "tr": "<w>Genel olarak</w> konuşmak gerekirse, oraya trenle gitmek yaklaşık bir saat sürer.",
                                "es": "<w>En términos generales</w>, se tarda aproximadamente una hora en llegar allí en tren."
                            }
                        }
