                        "sense_id": "43ce6758-3342-3a00-813a-f35fd3e0bff9",
                        "entry_id": "d0ab4b77-3990-3ff8-8ba9-4b8a7a9e7cdf",
                        "glosses": [
                            "Conscience immédiate ; sentiment intérieur, intime, de sa propre conscience."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "feb16876-c144-43bf-989e-1bb557fdc211",
                                "sense_id": "43ce6758-3342-3a00-813a-f35fd3e0bff9",
                                "text": "On lui fait donc passer les tests habituels (Test de Rorschach, Test d’aperception thématique) sans aucune réaction de sa part."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9da5f65-38a9-3a9b-ba2d-3a8df571e57d",
                        "entry_id": "d0ab4b77-3990-3ff8-8ba9-4b8a7a9e7cdf",
                        "glosses": [
                            "Action de percevoir clairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f542b8-46d1-4f63-b3b0-3d95220117f2",
                                "sense_id": "a9da5f65-38a9-3a9b-ba2d-3a8df571e57d",
                                "text": "[…], une aperception nouvelle de l’espace et du temps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f98e7b1-764f-4568-8506-81d0c5c2e24f",
                        "source_entry_id": "d0ab4b77-3990-3ff8-8ba9-4b8a7a9e7cdf",
