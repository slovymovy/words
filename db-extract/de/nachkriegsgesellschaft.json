                "senses": [
                    {
                        "sense_id": "e1d80e5c-663e-372b-bc80-af393266775d",
                        "entry_id": "3e205096-f04d-33e6-a8cd-eeb0dcbad057",
                        "glosses": [
                            "die nach dem Ende eines Krieges existierende Gesellschaft in einem Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a2d54c-0235-4234-b179-c94397471d51",
                                "sense_id": "e1d80e5c-663e-372b-bc80-af393266775d",
                                "text": "„Groener seinerseits würde alles tun, um von der alten Armee zu retten, was zu retten war, und Zeit zu gewinnen, damit sie sich in der deutschen Nachkriegsgesellschaft als Machtfaktor etablieren konnte.“"
                            },
                            {
                                "example_id": "203102d6-2987-44a4-ab70-da938f0d7bef",
                                "sense_id": "e1d80e5c-663e-372b-bc80-af393266775d",
                                "text": "„Sie kennt ihre Vergangenheit, weiß, dass sie Hitler verehrt und dies auch öffentlich geäußert hat und dass sie dafür in der deutschen Nachkriegsgesellschaft wenig Verständnis erwarten kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
