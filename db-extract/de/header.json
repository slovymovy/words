                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ab70ad3-e7a3-3735-91cd-0472d7bb29e3",
                        "entry_id": "f9374008-f6f2-3f1b-bbfd-8deb8b954eb6",
                        "glosses": [
                            "Kopfzeile mit den Metadaten einer E-Mail, einer Datei oder Ähnlichem, zu der unter Umständen die Empfänger- und Absenderadresse und der Betreff gehören können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8a2b4e-43e0-4ab6-b87b-7217254f3d8c",
                                "sense_id": "9ab70ad3-e7a3-3735-91cd-0472d7bb29e3",
                                "text": "Der Header ist eine Art Metatext, der bei der Kommunikation zwischen Browser und Server ausgetauscht wird."
                            },
                            {
                                "example_id": "021a47b6-9b5c-4d76-8aa8-0d2b46e0da50",
                                "sense_id": "9ab70ad3-e7a3-3735-91cd-0472d7bb29e3",
                                "text": "Nicht immer sind E-Mails vertrauenswürdig, weshalb Sie hier besondere Vorsicht walten lassen sollten. Der Header kann zum Beispiel einen Hinweis darauf bieten, ob der Absender wirklich derjenige ist, der er vorgibt zu sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f97fb15f-9524-44bf-a94b-44a6f1f4b6c4",
                        "source_entry_id": "f9374008-f6f2-3f1b-bbfd-8deb8b954eb6",
                        "source_sense_id": "9ab70ad3-e7a3-3735-91cd-0472d7bb29e3",
                        "target_lang_word": "header",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "header",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fafb28e-c896-3925-8657-3b436e347aa9",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "The upper portion of a page (or other) layout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff5fb0ea-97ad-4242-b798-447a8d057dc0",
                                                "sense_id": "7fafb28e-c896-3925-8657-3b436e347aa9",
                                                "text": "If you reduce the header of this document, the body will fit onto a single page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1f0ba4e-1389-33ab-90bf-cd68f689750f",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "Text, or other visual information, used to mark off a quantity of text, often titling or summarizing it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb0e3bd-d384-44fa-aacb-512a46f97efa",
                                                "sense_id": "c1f0ba4e-1389-33ab-90bf-cd68f689750f",
                                                "text": "Your header is too long; \"Local Cannibals\" will suffice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48abed2d-ff5d-309c-a5e0-f56e0e102373",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "Text, or other visual information, that goes at the top of a column of information in a table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b5f553-7991-4c2e-8548-e712079c346c",
                                                "sense_id": "48abed2d-ff5d-309c-a5e0-f56e0e102373",
                                                "text": "That column should have the header \"payment status\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900189e6-0b3e-37e1-8ea8-cf4e51ca0126",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A font, text style, or typesetting used for any of the above."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311ab116-f15a-4b1f-9a93-7a6003c5ba4f",
                                                "sense_id": "900189e6-0b3e-37e1-8ea8-cf4e51ca0126",
                                                "text": "Parts of speech belong in a level-three header. Level-two headers are reserved for the name of the language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d247b5e-ec35-39a0-aaa5-4646afc33926",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "The first part of a file or record that describes its contents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d414dbc-f15f-499f-a089-6475a5c67997",
                                                "sense_id": "9d247b5e-ec35-39a0-aaa5-4646afc33926",
                                                "text": "The header includes an index, an identifier, and a pointer to the next entry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4358c83d-5e68-306a-9b6f-85c23c3b667e",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "Clipping of header file."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a011d755-4cdb-3275-9f72-d2cf9d99a80e",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "the first part of a packet or stream, often containing its address and descriptors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32c0afa-edb2-443d-be7e-94c990d261bb",
                                                "sense_id": "a011d755-4cdb-3275-9f72-d2cf9d99a80e",
                                                "text": "The encapsulation layer adds an eight-byte header and a two-byte trailer to each packet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2c7dd5-6554-31e5-8da1-32c058ecb97c",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A brick that is laid sideways (on its largest face), for example at the top of a wall or within the brickwork, with its smallest side showing (oriented so that that side is wider than it is tall)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "234496f8-10f2-42d3-95c9-e525f7461c3b",
                                                "sense_id": "7e2c7dd5-6554-31e5-8da1-32c058ecb97c",
                                                "text": "This wall has four header courses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40982897-2e00-3083-a4d6-5d6c3ca76bc2",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A horizontal structural or finish piece over an opening."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b260549f-75c8-3782-8020-641a9aaca84d",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A machine that separates and gathers the heads of grain etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a870d3-297f-4fd8-9f80-82bc05a8c16c",
                                                "sense_id": "b260549f-75c8-3782-8020-641a9aaca84d",
                                                "text": "They fed the bale into the header."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35da1a76-333e-3513-8478-089c35385cd8",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "The act of hitting the ball with the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b05d546-6bb1-4fa3-93e6-718178e96fc7",
                                                "sense_id": "35da1a76-333e-3513-8478-089c35385cd8",
                                                "text": "His header for the goal followed a perfect corner kick."
                                            },
                                            {
                                                "example_id": "f782f0d8-5110-497c-b705-8ec2402ec073",
                                                "sense_id": "35da1a76-333e-3513-8478-089c35385cd8",
                                                "text": "The Black Cats had a mountain to climb after James Morrison's header and Shane Long's neat side-foot finish gave Albion a 2-0 lead five minutes in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4897231-6161-36a9-bdb0-38bb461bcc66",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "Someone who heads the ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f3c8fe9-a60e-3489-95d9-697ab591e364",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A headlong fall, jump or dive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7e6f20-6993-494a-b888-5fe5944bf7e2",
                                                "sense_id": "1f3c8fe9-a60e-3489-95d9-697ab591e364",
                                                "text": "The clown tripped over the other clown and took a header."
                                            },
                                            {
                                                "example_id": "2fae0a2a-05fd-498e-af48-0f1f2bfebbb7",
                                                "sense_id": "1f3c8fe9-a60e-3489-95d9-697ab591e364",
                                                "text": "\"When the rest are in, you see one or two shiverin' on the bank, envyin' the others that have taken the plunge. It's the last that have the worst of it. I'm all for a header and have done with it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5baef4fb-fa98-3d23-bf63-f95b2aaf03c9",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A raised tank that supplies water at constant pressure, especially to a central heating and hot water system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a0d0cb2-cf5f-37be-9412-8aa3a606476d",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A pipe which connects several smaller pipes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695185ec-86af-4429-a4d6-49842a6da5a7",
                                                "sense_id": "0a0d0cb2-cf5f-37be-9412-8aa3a606476d",
                                                "text": "Common practice is to use plastic pipes with iron headers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "450984cd-f016-3674-a89c-21d1fd90c966",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "The rodeo performer who drives the steer toward the heeler to be tied."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b87aca3-0291-3af2-b44b-752a39d17b24",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "One who puts a head on something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48452dd7-3d5d-3bee-941a-5f1deed3e76f",
                                        "entry_id": "573b5bd3-fe1f-3bc5-86c3-aa258c146dba",
                                        "glosses": [
                                            "A headcase; a nutjob (mentally unbalanced, unpredictable person)."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
