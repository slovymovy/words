{
    "word_family": [
        "stuiten",
        "stuiting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "601ecf94-f304-35d8-a6c3-f7b091e18b0e",
                    "sense_definition": "Moreel zeer verwerpelijk, afkeurenswaardig of sterke aanstoot gevend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aanstootgevend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De excuses die de politicus uitsprak werden door veel burgers <w>stuitend</w> gevonden.",
                            "target_lang_translations": {
                                "pl": "Przeprosiny wygłoszone przez polityka zostały uznane przez wielu obywateli za <w>oburzające</w>."
                            }
                        },
                        {
                            "text": "Ik vind het ronduit <w>stuitend</w> hoe zij met kwetsbare mensen omgaan.",
                            "target_lang_translations": {
                                "pl": "Uważam za po prostu <w>odrażające</w>, jak traktują oni osoby bezbronne."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanstootgevend",
                        "weerzinwekkend",
                        "stotend"
                    ],
                    "common_phrases": [
                        "stuitend gebrek",
                        "ronduit stuitend",
                        "stuitende arrogantie"
                    ],
                    "target_lang_definitions": {
                        "pl": "Moralnie wysoce naganny, odrażający lub budzący ogromne oburzenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oburzający",
                                "target_lang_sense_clarification": "wywołujący silne zgorszenie lub sprzeciw"
                            },
                            {
                                "target_lang_word": "odrażający",
                                "target_lang_sense_clarification": "budzący wstręt moralny"
                            },
                            {
                                "target_lang_word": "skandaliczny",
                                "target_lang_sense_clarification": "zasługujący na potępienie, szokujący"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "686b458f-e5f9-3cc3-8384-eba88122d9af",
                    "sense_definition": "Onvoltooid deelwoord van <w>stuiten</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deelwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bal kwam <w>stuitend</w> over het grasveld naar ons toe gerold.",
                            "target_lang_translations": {
                                "pl": "Piłka potoczyła się w naszą stronę po trawniku, <w>odbijając się</w>."
                            }
                        },
                        {
                            "text": "<w>Stuitend</w> op onverwachte weerstand moesten de onderhandelaars hun plannen herzien.",
                            "target_lang_translations": {
                                "pl": "<w>Natrafiając</w> na nieoczekiwany opór, negocjatorzy musieli zrewidować swoje plany."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów przymiotnikowy lub przysłówkowy czynny od czasownika 'stuiten' (odbijać się, natrafiać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odbijając się",
                                "target_lang_sense_clarification": "o przedmiocie, np. o piłce"
                            },
                            {
                                "target_lang_word": "natrafiając",
                                "target_lang_sense_clarification": "w przenośni: napotykając na przeszkodę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}