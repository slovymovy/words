                "senses": [
                    {
                        "sense_id": "42441023-0367-3014-a21c-8e1e232e8b8d",
                        "entry_id": "346370ac-f75e-3c91-8fb4-2a483287ff7a",
                        "glosses": [
                            "organisiertes Trainingsprogramm oder eine Unterrichtseinheit, die darauf abzielt, den Teilnehmern zu helfen, ihre Lauftechnik zu verbessern und ihr Leistungsniveau beim Laufen zu steigern"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "247f727b-28a2-49b8-8875-428430bdc00f",
                                "sense_id": "42441023-0367-3014-a21c-8e1e232e8b8d",
                                "text": "„Die VHS Henstedt-Ulzburg bietet einen Laufkurs für Einsteiger an, der perfekt für den Start oder Wiedereinstieg ins Laufen geeignet ist.“"
                            },
                            {
                                "example_id": "c3f54586-b239-45b0-afc8-8b1289844f8c",
                                "sense_id": "42441023-0367-3014-a21c-8e1e232e8b8d",
                                "text": "„Erfahrungsgemäß melden diese sich nach Abschluss ihrer Laufkurse kurz vor den Sommerferien an.“"
                            },
                            {
                                "example_id": "6e99edc3-a192-4632-b40c-0c5297abb9e0",
                                "sense_id": "42441023-0367-3014-a21c-8e1e232e8b8d",
                                "text": "„Auch einen Laufkurs zur Vorbereitung auf den B2Run im Juli haben wir im Programm.“"
                            },
                            {
                                "example_id": "ea18b964-c93d-4928-85b1-c510cdf9e7c3",
                                "sense_id": "42441023-0367-3014-a21c-8e1e232e8b8d",
                                "text": "„Sollten Sie einen BMI von über 30 haben, dann empfehlen wir Ihnen zunächst den Anfänger Laufkurs B und als Folgekurs diesen Laufanfänger Laufkurs A.“"
                            },
                            {
                                "example_id": "3bc6bbe1-a8bd-4baf-9d8a-6e5ed0da7487",
                                "sense_id": "42441023-0367-3014-a21c-8e1e232e8b8d",
                                "text": "„Etwa 30 Teilnehmer hatten sich für den Laufkurs »Von 0 auf 30 Minuten« unter der Leitung von Mies Müller angemeldet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                        "entry_id": "346370ac-f75e-3c91-8fb4-2a483287ff7a",
                        "glosses": [
                            "festgelegte/geplante Strecke oder Route für ein bestimmtes Vorhaben (zum Beispiel Lauf, Spaziergang oder eine Fahrt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814e8dac-c1f8-4f19-8096-48b53292e083",
                                "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                                "text": "„Auf dem abwechslungsreichen Laufkurs, der gespickt war mit Strohballenhindernissen und verschiedenen Untergründen, konnten die Athleten durch den Regen der vergangenen Tage, ihr wahres Lauf-können unter Beweis stellen.“"
                            },
                            {
                                "example_id": "97494aaf-8e75-4567-b3d0-362af897986e",
                                "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                                "text": "„Aber ich musste feststellen, dass der Laufkurs noch über einen Umweg durch die kleine Innenstadt mit Kopfsteinpflaster führte… warum dauern denn 2 Kilometer soooo lang????“"
                            },
                            {
                                "example_id": "6e7ba5e2-ac56-4b30-9e05-049b8f33c6c1",
                                "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                                "text": "„An der Christophoruskirche, erbaut zu Beginn unseres Jahrhunderts, ändern wir wiederum den Laufkurs Richtung Rahnsdorfer Straße, gelangen bis zur Werlseestraße und schließlich nach rechts an den Müggelseedämm.“"
                            },
                            {
                                "example_id": "084c508e-2afd-44fc-a799-a51b0b6e05b8",
                                "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                                "text": "„Der Laufkurs führte gleich über eine Holzbrücke, ‚da wusste man sofort, ob sich der ein oder andere Muskel vom Radfahren schon macht‘.“"
                            },
                            {
                                "example_id": "2476b87f-55f3-4b23-b8d6-e8d55b7c887e",
                                "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                                "text": "„‚Mit einer Zeit von 1:30 Minuten auf dem schweren Laufkurs bin ich sehr zufrieden.“"
                            },
                            {
                                "example_id": "9326aa57-2d3a-4274-b575-e69278526f7e",
                                "sense_id": "df4e0622-5a3f-3727-a71e-1edf7007b556",
                                "text": "„Schwimmen im kleinen See, eine hügelige Radstrecke und ein schneller Laufkurs sorgten für gute Bedingungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f86ac3d5-d895-3d78-b39a-0dff2d1d06d2",
                        "entry_id": "346370ac-f75e-3c91-8fb4-2a483287ff7a",
                        "glosses": [
                            "ein auf einer Smartwatch, einem Laufband oder Ähnlichem verfügbares Programm für das Laufen mit Anweisungen/Anleitungen für den Läufer"
                        ],
                        "tags": [
                            "Laufsport",
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "c544f6f0-fcf1-4527-8d56-5c6f963bf65a",
                                "sense_id": "f86ac3d5-d895-3d78-b39a-0dff2d1d06d2",
                                "text": "„Es gibt unter anderem 13 verschiedene Laufkurse unterschiedlicher Schwierigkeitsarten.“"
                            },
                            {
                                "example_id": "a9e17992-fa21-4ce3-9377-cd51d5ac2867",
                                "sense_id": "f86ac3d5-d895-3d78-b39a-0dff2d1d06d2",
                                "text": "„Das Gerät bietet zehn Laufkurse am Handgelenk, die während des Trainings eine wissenschaftliche und intuitive Laufanleitung bereitstellen.“"
                            },
                            {
                                "example_id": "2926fbd8-5910-40c1-bb17-87011e54ab34",
                                "sense_id": "f86ac3d5-d895-3d78-b39a-0dff2d1d06d2",
                                "text": "„Auch auf diesem Gerät bietet Huawei wieder Laufkurse an, mit verschiedenen Geschwindigkeiten und Längen, die dem eigenen Schwierigkeitsgrad entsprechen.“"
                            },
                            {
                                "example_id": "105825e7-abf6-4619-b026-ab244d3c280a",
                                "sense_id": "f86ac3d5-d895-3d78-b39a-0dff2d1d06d2",
                                "text": "„Wer sich wirklich auf Trainingseinheiten und nicht nur eine Trainingsart konzentrieren möchte, nutzt einfach die Laufkurse der Watch GT.“"
                            },
                            {
                                "example_id": "b5df68f2-c441-4da5-9f3c-ae92521a3fc1",
                                "sense_id": "f86ac3d5-d895-3d78-b39a-0dff2d1d06d2",
                                "text": "„Auf der Watch GT 3 finden sich 13 vorinstallierte Laufkurse.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
