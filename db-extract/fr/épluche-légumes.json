                "senses": [
                    {
                        "sense_id": "bfea556e-936b-3a2e-a0ae-9332f029372b",
                        "entry_id": "4ab9464f-9a03-3bae-b7fb-25befe36b551",
                        "glosses": [
                            "Ustensile de cuisine destiné à éplucher les pommes de terre ou tous légumes entourés d’une peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c62cd9-2c5d-4577-98b1-3af03a63be28",
                                "sense_id": "bfea556e-936b-3a2e-a0ae-9332f029372b",
                                "text": "Pour rien au monde, il n’aurait manqué la démonstration du bateleur vantant les mérites « exceptionnels » de l’épluche-légumes « Vitleg » que les ménagères ont si bien en main."
                            },
                            {
                                "example_id": "1f9274ce-4559-46f6-8f31-e1540abc4e96",
                                "sense_id": "bfea556e-936b-3a2e-a0ae-9332f029372b",
                                "text": "Non, la conversation va se mitonner dans la cuisine – tiens, si tu veux m’aider à éplucher les pommes de terre ! Un épluche-légumes à la main, on se dit des choses plus profondes et naturelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35abbb41-daa4-41b4-83d8-595e250e189a",
                        "source_entry_id": "4ab9464f-9a03-3bae-b7fb-25befe36b551",
                        "source_sense_id": "bfea556e-936b-3a2e-a0ae-9332f029372b",
                        "target_lang_word": "Sparschäler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sparschäler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07f3de90-2a33-3eb9-8eb4-c33e726e30f8",
                                        "entry_id": "5ff1e265-7787-3f86-97e1-cdc857d768da",
                                        "glosses": [
                                            "Küchengerät zum Schälen von Obst oder Gemüse (Kartoffeln, Spargel und so weiter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbafe31-9b42-4a64-a834-6db5999f658b",
                                                "sense_id": "07f3de90-2a33-3eb9-8eb4-c33e726e30f8",
                                                "text": "„Hartschaliges Obst lässt sich mit einem Sparschäler dünn schälen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75053a0e-5c63-4f4a-9fe4-e9893c493324",
                        "source_entry_id": "4ab9464f-9a03-3bae-b7fb-25befe36b551",
                        "source_sense_id": "bfea556e-936b-3a2e-a0ae-9332f029372b",
                        "target_lang_word": "peeler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peeler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                        "entry_id": "436ae7b5-2649-31e5-903d-a684cace62c3",
                                        "glosses": [
                                            "A police officer."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bec98ea-c59d-48f9-9471-50e9493a866d",
                                                "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                                "text": "A peeler man who heard the din came in to see the show;\nHe tried to run the bushman in, but he refused to go.\nAnd when at last the barber spoke, and said \"'Twas all in fun—\n'Twas just a little harmless joke, a trifle overdone.\""
                                            },
                                            {
                                                "example_id": "7a4a4ae5-d2e7-4786-80f9-dbfde09dca5b",
                                                "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                                "text": "I’d covered pretty nearly two miles before I came across a peeler, — and when I did the man was cracked — and he thought me mad, or drunk, or both. By the time I’d got myself within nodding distance of being run in for obstructing the police in the execution of their duty, […] Holt was out of sight."
                                            },
                                            {
                                                "example_id": "98756378-23d9-4122-9344-f7622aec8694",
                                                "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                                "text": "I was standin' there and the car came down the street with the two peelers comin' after them and I'm standin' here with [my son] in my arms."
                                            },
                                            {
                                                "example_id": "79ba3033-e174-4d2e-9bc6-91970f181bdc",
                                                "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                                "text": "How do you fight back to get your right back to walk free down the street when your name and address singles you out for every Peeler on the beat?"
                                            },
                                            {
                                                "example_id": "839ccc58-1c19-456b-9c62-d4e14d397557",
                                                "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                                "text": "Special Irish Branch was looking for Fenians in South Kensington; going from there to a Catholic church for Easter Mass was very nearly the stupidest thing Eliza could do, short of walking into Scotland Yard and cursing the peelers out in Irish."
                                            },
                                            {
                                                "example_id": "b89d5f5b-53cb-453b-93c7-f1ce8f7dcd47",
                                                "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                                                "text": "It was Jem and Georgie that was in mortal danger, true, but there was not one of us that wanted the peelers asking us questions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peeler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a6ab4f-8ebc-37fd-8981-e980fd2c2008",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "One who peels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2838811-f811-428e-960c-cd0b72730e28",
                                                "sense_id": "e7a6ab4f-8ebc-37fd-8981-e980fd2c2008",
                                                "text": "According to another superstition, the longer the peel, the longer the peeler's life would be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e550f390-62c6-3eeb-845e-17cfb32c47b9",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "One who peels.",
                                            "A person whose job it is to peel fruit or vegetable produce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee6f024-0479-4c80-b8fe-19c7936490dd",
                                                "sense_id": "e550f390-62c6-3eeb-845e-17cfb32c47b9",
                                                "text": "She and I took a few minutes together once the belts began rolling with red tomatoes and with the shiny cans which clanked their hollow wind-chime twang as they paraded down the chute on the way to their own conveyor belts which ran parallel to the wide ones the tomatoes rode on. In order to get these few minutes she'd had to implement a schedule for the peelers, who were always fighting like schoolchildren to get to the front of the line to claim their places, vying for the best spots where they could grab the biggest tomatoes to fill their cans faster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a72aa9-72dd-3fb2-af95-c6488720f258",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "One who peels.",
                                            "A person who works by peeling the bark off trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1955a382-46d1-43f0-a106-87f9e4885499",
                                                "sense_id": "56a72aa9-72dd-3fb2-af95-c6488720f258",
                                                "text": "From about this time, it became customary to permit the peelers to appear annually before the government, immediately after the termination of the cinnamon-harvest."
                                            },
                                            {
                                                "example_id": "3b803882-bf11-43ca-9d14-c688a1d3815c",
                                                "sense_id": "56a72aa9-72dd-3fb2-af95-c6488720f258",
                                                "text": "Women cooked and cleaned in the larger camps, where the peelers stayed for a month or more. A good peeler could make two cords of bark a day, felling hemlocks and peeling the bark off only the trunk below the first branch."
                                            },
                                            {
                                                "example_id": "558c24c2-2dd6-4963-ac92-8592dcba8b82",
                                                "sense_id": "56a72aa9-72dd-3fb2-af95-c6488720f258",
                                                "text": "Females trained in household arts received good pay, while males sought jobs on large farms, as bark peelers at lumber mills or axmen for logging companies, and as track hands for the railroads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "741b0876-a8d5-3d53-a786-b48ccf100e1f",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "One who peels.",
                                            "A stripper; one who disrobes for entertainment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "003b48e7-b681-3aa4-8c70-986692468073",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "One who peels.",
                                            "One who peels or pillages."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b46df234-a0be-34ad-b1ed-544d57aacad3",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "A device for peeling fruit or vegetables.",
                                            "A household utensil for peeling fruit or vegetables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb0510c-09ae-41d9-95f7-62682a11b680",
                                                "sense_id": "b46df234-a0be-34ad-b1ed-544d57aacad3",
                                                "text": "What the Romans didn't have was anything like the ergonomic vegetable peeler."
                                            },
                                            {
                                                "example_id": "a241128e-5277-47fb-a075-9f52ce34a4c7",
                                                "sense_id": "b46df234-a0be-34ad-b1ed-544d57aacad3",
                                                "text": "I like to use a swivel peeler on my apples, mainly because a good peeler removes the skin only, without hacking off the flesh underneath the way a knife will, even in dept hands."
                                            },
                                            {
                                                "example_id": "958c5888-3e69-4ea8-9788-760fc5519085",
                                                "sense_id": "b46df234-a0be-34ad-b1ed-544d57aacad3",
                                                "text": "The OXO peeler was a game-changer. More than 10 million have been sold to date, and it threw open the entire market in peelers, causing numerous rivals to be invented: serrated fruit peelers, vegetable peelers with curved blades, Y-shaped and C-shaped and U-shaped peelers in any colour you desire (and many you don't)."
                                            },
                                            {
                                                "example_id": "d8af3750-da6e-4594-8dc9-5eea927c3920",
                                                "sense_id": "b46df234-a0be-34ad-b1ed-544d57aacad3",
                                                "text": "potato peeler"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e620780b-c65a-3767-a4c3-1e32dec144fe",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "A device for peeling fruit or vegetables.",
                                            "An industrial food-processing machine for removing the peels or skins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a2dc11-9b8e-4605-8110-529923eb63b3",
                                                "sense_id": "e620780b-c65a-3767-a4c3-1e32dec144fe",
                                                "text": "Fish-processing equipment consists of 33, 181, 189, 188, 694 Baader machines and others which would be replaced for six months by krill peelers with associated devices."
                                            },
                                            {
                                                "example_id": "780093c4-5739-46ee-aead-e81085ef6651",
                                                "sense_id": "e620780b-c65a-3767-a4c3-1e32dec144fe",
                                                "text": "Peelers with knife blades mounted in the outside walls of a revolving drum in which the product is tumbled have a similar effect as an abrasion peeler."
                                            },
                                            {
                                                "example_id": "f70a23fc-21de-4660-80f0-ed9bb7a7b3c5",
                                                "sense_id": "e620780b-c65a-3767-a4c3-1e32dec144fe",
                                                "text": "The peels are removed mostly with wet peelers, using lye solutions or high-pressure steam."
                                            },
                                            {
                                                "example_id": "1ba0cdb7-5797-4e8a-9208-41e61cdab114",
                                                "sense_id": "e620780b-c65a-3767-a4c3-1e32dec144fe",
                                                "text": "Washers and peelers usually are cleaned in place, either with dedicated clean-in-place systems, or, more commonly, the equipment is simply filled with water and operated for a short period of time, followed by rinsing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a93344-3760-36a4-87ea-77a336dc6a8e",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "Something to be peeled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1534600-793c-44a9-a6cb-caea9af67953",
                                                "sense_id": "85a93344-3760-36a4-87ea-77a336dc6a8e",
                                                "text": "To prepare the vignette, the limits of all control areas are scribed as thin lines on one sheet of coated plastic, and a mask is prepared for each of the two colors on plastic sheets with a peeler coating."
                                            },
                                            {
                                                "example_id": "6ca78c0a-c1c8-4bda-ab2b-eb66db7f7f23",
                                                "sense_id": "85a93344-3760-36a4-87ea-77a336dc6a8e",
                                                "text": "Canning apples (\"peelers\") must be over 2-1/2 inches in diameter; peelers may have surface damage since they will be peeled in the process of making apple sauce or slices, but they must be round for the peeling machines to handle them properly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eed6966-2edc-3714-8552-3788cac89759",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "Something that is peeling, about to peel, or prone to peeling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04103151-25bb-43a7-b56b-28dacc19ed04",
                                                "sense_id": "7eed6966-2edc-3714-8552-3788cac89759",
                                                "text": "Xanthan gum was introduced into a traditional, wax-based coating formulation for easy peelers."
                                            },
                                            {
                                                "example_id": "e25d5899-ad4f-4bf4-9ace-7dfb6849dbdf",
                                                "sense_id": "7eed6966-2edc-3714-8552-3788cac89759",
                                                "text": "It will be necessary to continually monitor the holes for voids and the plating for peelers -- but this is a good idea for any plating operation which uses dry film photoresist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ceb7cb-de02-3135-90cd-2a9069bf7424",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "Something that is peeling, about to peel, or prone to peeling.",
                                            "An edible crab that is about to shed its shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41f75b1-0021-4c8c-b315-264c2f3622ac",
                                                "sense_id": "15ceb7cb-de02-3135-90cd-2a9069bf7424",
                                                "text": "They bought peelers [crabs that would soon shed] and kept them in large wooden floats until the crabs shed."
                                            },
                                            {
                                                "example_id": "24e14674-6301-434c-8557-eed95d5a55f7",
                                                "sense_id": "15ceb7cb-de02-3135-90cd-2a9069bf7424",
                                                "text": "Once the crab has molted, the new shell takes about four days to harden. Just after shedding, the blue crab's shell is soft enough to eat. Watermen harvest soft shell crabs as peelers (about to shed), rank peelers (within hours of shedding) and busters (in the process of shedding)."
                                            },
                                            {
                                                "example_id": "72e88e97-51d6-4a0d-8b5e-01cabe1a33ff",
                                                "sense_id": "15ceb7cb-de02-3135-90cd-2a9069bf7424",
                                                "text": "It is rarer to find paired edible crabs, and potential peelers need to be tested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b11586-5ca8-3a57-aa8a-427971da9089",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "An ideal wave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1a3b74-07a5-46cb-ab15-e1446f411f5e",
                                                "sense_id": "60b11586-5ca8-3a57-aa8a-427971da9089",
                                                "text": "Fancy a wave, one of those little peelers?"
                                            },
                                            {
                                                "example_id": "eff50edf-33ad-490a-be49-f2a03bad144e",
                                                "sense_id": "60b11586-5ca8-3a57-aa8a-427971da9089",
                                                "text": "If he could ride a trend as well as he could ride a First Point Malibu peeler—well, that's how the game was played."
                                            },
                                            {
                                                "example_id": "1c0b5cf5-2b88-40b6-a009-78608cdb4e91",
                                                "sense_id": "60b11586-5ca8-3a57-aa8a-427971da9089",
                                                "text": "As the next five-foot peeler rolled by, Lee grasped his board and clenched his teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a238b6a-0257-38ed-b57e-f34e584706b5",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "A plant which impoverishes the soil by demanding high value nutrients and so requires the use of fertilizers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a918c6a-8bc2-35ea-9d2f-90ea407f59cf",
                                        "entry_id": "7a22684e-7916-35ed-a1c8-c8bd13eac961",
                                        "glosses": [
                                            "Someone who breaks horses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "571526c2-3602-49b1-acd1-cc6c3d5ba64c",
                                                "sense_id": "0a918c6a-8bc2-35ea-9d2f-90ea407f59cf",
                                                "text": "It took a real good bronc peeler ( horse breaker ) to handle those big 79 broncs ;"
                                            },
                                            {
                                                "example_id": "757557cc-4843-43db-bdd2-40ab1ba8707c",
                                                "sense_id": "0a918c6a-8bc2-35ea-9d2f-90ea407f59cf",
                                                "text": "My old daddy always said that the purpose of breakin a horse was to ride it and if you got one to break you just as well to saddle up and climb aboard and get on with it. John Grady grinned. Was your old daddy a certified peeler?"
                                            },
                                            {
                                                "example_id": "afcb71ee-1848-4ce9-91eb-cbe842a04397",
                                                "sense_id": "0a918c6a-8bc2-35ea-9d2f-90ea407f59cf",
                                                "text": "\"Where do you keep your horse?” Snakeroot flushed. “Ain't got one. Never did. I can't ride.” “Can't . . . ? You said you were a horse peeler.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
