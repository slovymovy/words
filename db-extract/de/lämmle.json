                ],
                "senses": [
                    {
                        "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                        "entry_id": "e774b896-f4ae-3537-9ec4-fde6eec3b06f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e9916a1-4b10-4b21-a6fe-ab8ac8d54abf",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Lämmle kommt und geht."
                            },
                            {
                                "example_id": "c25a3999-72e5-4017-b5c4-b536f15124a7",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Lämmles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a2ae362d-6a14-4342-874f-65d3f63d6f77",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Frau Lämmle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2d998bc8-f7f2-42e3-8171-f7c9d540be8c",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Herr Lämmle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e3d5dd19-c60a-4ac9-821e-8293785c00bf",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Die Lämmles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1c40db13-18d6-42be-b893-5867111bff45",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Der Lämmle trägt nie die Schals, die die Lämmle ihm strickt."
                            },
                            {
                                "example_id": "dd363123-465f-4e95-83c2-5400a6334afc",
                                "sense_id": "e0fb12b0-885a-3584-aa91-425f390f5512",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lämmle kommt, geht der Herr Lämmle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
