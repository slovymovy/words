                "senses": [
                    {
                        "sense_id": "84ef453e-be3b-361a-8799-680c61f5e1af",
                        "entry_id": "6a7450a8-faa1-3650-84cb-66460f0f9c2b",
                        "glosses": [
                            "längliches Gebäckstück, das vor dem Backen mit Natriumhydroxidlösung (Natronlauge) benetzt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fad03d1-aa81-4d40-8be8-23da543fbb78",
                                "sense_id": "84ef453e-be3b-361a-8799-680c61f5e1af",
                                "text": "„Eva Mummenbrauer schmierte sich gerade Konfitüre auf eine mit Butter bestrichene Laugenstange.“"
                            },
                            {
                                "example_id": "0a3852b1-18fe-49ae-b0f5-4fa7be08898d",
                                "sense_id": "84ef453e-be3b-361a-8799-680c61f5e1af",
                                "text": "„Er prustet vor Lachen, und speit dabei die Krümel der Laugenstange aufs Tischtuch.“"
                            },
                            {
                                "example_id": "aca49971-9e36-4d0a-a468-3e84bcf7954b",
                                "sense_id": "84ef453e-be3b-361a-8799-680c61f5e1af",
                                "text": "„Für Dich Unser Abend beginnt mit Wein, und natürlich Frauenthemen, Laugenstange darf es sein, warm aus dem Backofen.“"
                            },
                            {
                                "example_id": "a1b98c73-4d18-4b75-9452-90bcc5b746db",
                                "sense_id": "84ef453e-be3b-361a-8799-680c61f5e1af",
                                "text": "„Weil es außerhalb von Hamburg ihre geliebten Franzbrötchen nicht zu geben scheint, kauft sie sich eine Laugenstange.“"
                            },
                            {
                                "example_id": "e0340cb2-e236-49bb-9626-1735428d0c62",
                                "sense_id": "84ef453e-be3b-361a-8799-680c61f5e1af",
                                "text": "„Marta nagte gerade an einer Laugenstange, während ich versuchte, mein Jackett fleckenfrei zu halten, als plötzlich ein Mann zu uns an den Tisch kam und Patrizia vertraut von hinten umarmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
