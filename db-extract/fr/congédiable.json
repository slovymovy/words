                        "examples": [
                            {
                                "example_id": "ce3b7c10-b61b-4683-ad6a-ca13df05872e",
                                "sense_id": "5da3fa15-6a5d-3d83-92e5-28bd03304ae2",
                                "text": "Dès qu'en France la Religion a été déposée en des mains séculières, il étoit indispensable que ses Ministres prissent la livrée des Hôtels-de-Ville, et fussent aussi congédiables que les Bedeaux et les Sonneurs …"
                            },
                            {
                                "example_id": "79891f10-fba3-43c0-b56e-e4f22173c657",
                                "sense_id": "5da3fa15-6a5d-3d83-92e5-28bd03304ae2",
                                "text": "Le seul homme entaché de crime deviendrait donc congédiable par le capitaine.... encore celui-ci serait-il souvent réduit à plaider la validité du motif de ce renvoi ; …"
                            },
                            {
                                "example_id": "596c2ceb-1e83-41db-a31f-672158cd2347",
                                "sense_id": "5da3fa15-6a5d-3d83-92e5-28bd03304ae2",
                                "text": "Cet ombrageux n’était jamais qu’un homme à ses gages. Et depuis quand un domestique, même favorisé, cessait-il d’être congédiable à merci ?"
                            }
                        ]
                    }
