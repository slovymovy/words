                "senses": [
                    {
                        "sense_id": "532aeda4-162e-3757-90c2-591f71fb85cf",
                        "entry_id": "742259e7-2c51-382b-a81b-32e555654a18",
                        "glosses": [
                            "weibliche Person, die sich sehr gut mit dem Thema Vögel auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9866b0ac-18fe-4111-a1dd-a128e9142f26",
                                "sense_id": "532aeda4-162e-3757-90c2-591f71fb85cf",
                                "text": "„Mit manch anderen Hühnerkrankheiten fuhr ich zu einer vierzig Kilometer entfernten Vogelspezialistin, die auch dann oft weiterwusste, wenn ein normaler Tierarzt ratlos war.“"
                            },
                            {
                                "example_id": "0211059c-e274-4397-b0f5-f05436a2c6c6",
                                "sense_id": "532aeda4-162e-3757-90c2-591f71fb85cf",
                                "text": "„Da fiel mir die Vogelspezialistin Sally Blanchard ein, der genau dasselbe passiert war. Sie hatte ihren Papagei von »Bongo« in »Bongo Marie« umbenannt.“"
                            },
                            {
                                "example_id": "6701ec87-afcc-426e-9dba-199c882c0378",
                                "sense_id": "532aeda4-162e-3757-90c2-591f71fb85cf",
                                "text": "„«Ich könnte da eine sehr aufwändige, kostspielige Operation machen», sagte die Vogelspezialistin, in deren Praxis wir nach anderthalb Stunden Fahrt schließlich landeten.“"
                            },
                            {
                                "example_id": "3d500e64-2008-4fe2-839d-330127e545dc",
                                "sense_id": "532aeda4-162e-3757-90c2-591f71fb85cf",
                                "text": "„Unter ihnen ist eine Frau mit einer Baskenmütze auf dem Kopf, die zufällig Vogelspezialistin ist, Ornithologin.“"
                            },
                            {
                                "example_id": "8f36b059-031b-4728-9ff8-f68e783e763d",
                                "sense_id": "532aeda4-162e-3757-90c2-591f71fb85cf",
                                "text": "„Die Tierärztin am Telefon, die Vogelspezialistin vom veterinärpathologischen Institut, hatte mir verraten, der Doktor sei unter den Amateuren so etwas wie ein Trappen-Balz-Spezialist […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
