                    },
                    {
                        "translation_id": "db46e6a6-5e52-43d6-a88e-6ad8700778d6",
                        "source_entry_id": "12a281f7-6553-3cdc-9351-eab57b33dc2a",
                        "source_sense_id": "dcf38978-83b3-304e-bc45-f6f37bffb2d1",
                        "target_lang_word": "carcinogenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carcinogenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b07cd4f9-f224-3cd4-b192-05daf16f753e",
                                        "entry_id": "c6928de4-394b-385f-b048-7a47fad3605f",
                                        "glosses": [
                                            "Causing or tending to cause cancer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d809af9-5024-4998-824f-45f526f99bb4",
                                                "sense_id": "b07cd4f9-f224-3cd4-b192-05daf16f753e",
                                                "text": "Although BHA (butylated hydroxyanisole) and BHT (butylated hydroxytoluene) are avoided by some consumers because several studies have suggested they may be toxic or carcinogenic (they are banned in Britain), these antioxidants have also been shown to inhibit the action of cancer-causing chemicals, and BHT has been shown to suppress the growth of harmful viruses."
                                            },
                                            {
                                                "example_id": "607ee078-8675-4de7-894b-d3d835ccdb65",
                                                "sense_id": "b07cd4f9-f224-3cd4-b192-05daf16f753e",
                                                "text": "The disadvantage of the underfired grill is the potential for flareups, which can cause a burned spot or carbonization. Not only do these taste bad, but they are also carcinogenic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carcinogenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27b25fc9-ffc0-3170-8395-a6af6175f698",
                                        "entry_id": "3d4a60cc-2b7b-3789-b80b-1f712eaef01b",
                                        "glosses": [
                                            "Synonym of carcinogen."
                                        ],
