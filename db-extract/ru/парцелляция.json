                "senses": [
                    {
                        "sense_id": "b57b1c60-a488-3321-86f5-ad4d71117d2d",
                        "entry_id": "5a3b888a-5867-3997-a1f9-512ea9a06aa0",
                        "glosses": [
                            "истор., экон. дробление земли на мелкие участки (парцеллы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f5ecd5-19c2-4df1-bc71-69471901f7b6",
                                "sense_id": "b57b1c60-a488-3321-86f5-ad4d71117d2d",
                                "text": "Процесс парцелляции лесов увеличивается по мере продвижения к югу."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ef646db-c012-346a-afb6-8749c2da4efd",
                        "entry_id": "5a3b888a-5867-3997-a1f9-512ea9a06aa0",
                        "glosses": [
                            "лингв., филол. разделение единой синтаксической конструкции на несколько отдельных фраз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a86b688-25f3-4e55-9fe5-7d12ee6263b9",
                                "sense_id": "2ef646db-c012-346a-afb6-8749c2da4efd",
                                "text": "Ряд исследований и наши наблюдения дают достаточные основания считать, что явление парцелляции свойственно не только французскому и русскому языкам, но и немецкому, английскому, испанскому, итальянскому и другим."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "645937d5-300f-405c-8079-e295c4c0f14b",
                        "source_entry_id": "5a3b888a-5867-3997-a1f9-512ea9a06aa0",
                        "source_sense_description": "разделение земельных участков",
                        "target_lang_word": "parcelling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parcelling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d48765-e79e-3a53-8040-9c44b7fad87a",
                                        "entry_id": "578ab492-90ce-33e3-b6ec-de6b5251e763",
                                        "glosses": [
                                            "present participle and gerund of parcel"
                                        ],
                                        "tags": [
                                            "British",
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "parcelling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28dda497-ea72-3acb-889c-fe7fe15c5a4f",
                                        "entry_id": "f49d34f6-abdc-30a5-9997-bd0da399d3ca",
                                        "glosses": [
                                            "One of the long, narrow slips of canvas daubed with tar and wound about a rope like a bandage, before it is served; used also in mousing on the stays, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c420103-52d1-4a22-a466-ff55e9b181ef",
                                                "sense_id": "28dda497-ea72-3acb-889c-fe7fe15c5a4f",
                                                "text": "The wind continuing very light; all hands were sent aloft to strip off the chafing gear; and battens, parcellings, roundings, hoops, mats, and leathers, came flying from aloft, and left the rigging neat and clean, stripped of all its sea bandaging."
                                            },
                                            {
                                                "example_id": "baea5609-8de0-4191-866e-4ac68017e2ca",
                                                "sense_id": "28dda497-ea72-3acb-889c-fe7fe15c5a4f",
                                                "text": "This effectively prepares the way for the parcelling to produce a smooth finish, prior to serving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84d33e4-c4f0-3952-b842-f75bc90f1f4d",
                                        "entry_id": "f49d34f6-abdc-30a5-9997-bd0da399d3ca",
                                        "glosses": [
                                            "A system for dividing something up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "270d6ff3-001a-410a-b7ad-84af42a6566c",
                                                "sense_id": "c84d33e4-c4f0-3952-b842-f75bc90f1f4d",
                                                "text": "[…] these are posterior Divisions, fallen upon as Brandenburg (under Albert chiefly) enlarged itself, and needed new Official parcellings into departments."
                                            },
                                            {
                                                "example_id": "2493444c-3b4f-4df1-9bcb-de14465bbd50",
                                                "sense_id": "c84d33e4-c4f0-3952-b842-f75bc90f1f4d",
                                                "text": "That many different parcellings of phenomena for the purposes of theoretical explanation are conceivable does not however show that these parcellings can be quite arbitrary."
                                            },
                                            {
                                                "example_id": "c14db9c3-73fd-4b52-be7d-676bf63ad65c",
                                                "sense_id": "c84d33e4-c4f0-3952-b842-f75bc90f1f4d",
                                                "text": "Spaces of the imagination rather than tidy parcellings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b687487-ef1e-3d52-bfdc-b4aa612ddaac",
                                        "entry_id": "f49d34f6-abdc-30a5-9997-bd0da399d3ca",
                                        "glosses": [
                                            "The division of land into parcels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8dd50a4-ef4a-4257-83f1-211446683eca",
                                                "sense_id": "7b687487-ef1e-3d52-bfdc-b4aa612ddaac",
                                                "text": "The parcelling of large estates into smaller agricultural units swelled the area of peasants' land by 1,759,000 acres."
                                            },
                                            {
                                                "example_id": "285657a3-9963-412a-b35d-10d8fec7a6cf",
                                                "sense_id": "7b687487-ef1e-3d52-bfdc-b4aa612ddaac",
                                                "text": "Another category of norms is valid for parcellings taking place after 2 December 1966 , but preceding the date ( 1 September 1967) when the Lege Ponte entered into force; while a third category of norms applies to parcellings carried out after 1 September 1967."
                                            },
                                            {
                                                "example_id": "a39ff632-1d3f-4cdc-b7d8-b8499a239d15",
                                                "sense_id": "7b687487-ef1e-3d52-bfdc-b4aa612ddaac",
                                                "text": "Near the coast, tidal creeks and high marshland formed a landscape with irregular parcellings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdeafa55-f916-3389-91c2-1ac43b1a042a",
                                        "entry_id": "f49d34f6-abdc-30a5-9997-bd0da399d3ca",
                                        "glosses": [
                                            "The manner in which something is structured or packaged for sale, including the use of a specific size, material, color, font, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af7281a-2a6a-4f0a-8c83-3485d395e220",
                                                "sense_id": "cdeafa55-f916-3389-91c2-1ac43b1a042a",
                                                "text": "Most of the commodities have their own special parcellings, in the absence of which its market would be impeded and prices would have a tendency to become artificial."
                                            },
                                            {
                                                "example_id": "44c9606b-6071-4f63-b119-e8953ee956d8",
                                                "sense_id": "cdeafa55-f916-3389-91c2-1ac43b1a042a",
                                                "text": "They may have special shades of paper stamps or \"chops,\" tickets, tapes, ribbons, and parcellings."
                                            },
                                            {
                                                "example_id": "fa90dba8-48f5-4909-ac21-231fdf259881",
                                                "sense_id": "cdeafa55-f916-3389-91c2-1ac43b1a042a",
                                                "text": "The smallest number of parcellings are found in the group of small volume texts—in 1.5% of cases. In advertising of medium volume, parcellings are used in 14% of texts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
