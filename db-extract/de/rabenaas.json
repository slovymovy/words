                        "source_sense_id": "0459b6b3-b025-3b1b-9a9e-9e2d293fdea3",
                        "source_sense_description": "abwertend: eine unangenehme, fiese Person",
                        "target_lang_word": "bastard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bastard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65cb58f7-badd-3c01-b126-4a8bb065a043",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A person who was born out of wedlock, and hence often considered an illegitimate descendant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a165d84-ebc5-4322-88d7-f22835824441",
                                                "sense_id": "65cb58f7-badd-3c01-b126-4a8bb065a043",
                                                "text": "Jarrod: Who are you?\nHeath: Your father’s bastard son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391c98b0-7d1b-3d78-9e78-ac95208fc080",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A mongrel (biological cross between different breeds, groups or varieties)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b44b19-6d1b-3ca6-b8f7-1f47d4cf89c4",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A contemptible, inconsiderate, overly or arrogantly rude or spiteful person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "offensive",
                                            "uncountable",
                                            "usually",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "182248a1-92e7-453c-b977-ada440820454",
                                                "sense_id": "54b44b19-6d1b-3ca6-b8f7-1f47d4cf89c4",
                                                "text": "Some bastard stole my car while I was helping an injured person."
                                            },
                                            {
                                                "example_id": "fad82634-3bf1-4b3a-9e48-ad48aeb2fe89",
                                                "sense_id": "54b44b19-6d1b-3ca6-b8f7-1f47d4cf89c4",
                                                "text": "You sick bastard!"
                                            },
                                            {
                                                "example_id": "5a3d386f-3154-4642-9ae0-ea427a45b792",
                                                "sense_id": "54b44b19-6d1b-3ca6-b8f7-1f47d4cf89c4",
                                                "text": "Don't be such a bastard already!"
                                            },
                                            {
                                                "example_id": "21210978-0882-494a-88f6-55fada3672a0",
                                                "sense_id": "54b44b19-6d1b-3ca6-b8f7-1f47d4cf89c4",
                                                "text": "I assume that bastard won't be seen again."
                                            },
                                            {
                                                "example_id": "5147b7e5-566e-43cf-b779-a5a483ed3238",
                                                "sense_id": "54b44b19-6d1b-3ca6-b8f7-1f47d4cf89c4",
                                                "text": "“Oh my God, they killed Kenny!” “You bastards!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6068d2b9-40a5-3189-81ff-9241aea1debd",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A man, a fellow, a male friend."
                                        ],
                                        "tags": [
                                            "countable",
                                            "endearing",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9efab08-d25b-4da6-9939-8cff56056f28",
                                                "sense_id": "6068d2b9-40a5-3189-81ff-9241aea1debd",
                                                "text": "lucky bastard"
                                            },
                                            {
                                                "example_id": "1bf613c2-42e3-42d3-a868-92f976df655d",
                                                "sense_id": "6068d2b9-40a5-3189-81ff-9241aea1debd",
                                                "text": "funny bastard"
                                            },
                                            {
                                                "example_id": "fd8b02b8-72c5-41a1-8b25-1906bc43d718",
                                                "sense_id": "6068d2b9-40a5-3189-81ff-9241aea1debd",
                                                "text": "Get over here, you old bastard!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee4dda38-ad67-3429-a5a0-bba73c0a6430",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A suffering person deemed deserving of compassion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d15a66d-d50d-4ef5-996f-c73857afd384",
                                                "sense_id": "ee4dda38-ad67-3429-a5a0-bba73c0a6430",
                                                "text": "Poor bastard, I feel so sorry for him."
                                            },
                                            {
                                                "example_id": "00290ca7-e4d6-42ad-bc5f-3b55000a9ce3",
                                                "sense_id": "ee4dda38-ad67-3429-a5a0-bba73c0a6430",
                                                "text": "These poor bastards started out life probably in bad or broken homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41fd2f2c-fd14-38fc-873d-7f2aecc64f02",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A child who does not know its father."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4243434b-5e36-3204-a933-8e90f1e79cd9",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "Something extremely difficult or unpleasant to deal with."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84bb7597-159f-4869-8ffe-597468739412",
                                                "sense_id": "4243434b-5e36-3204-a933-8e90f1e79cd9",
                                                "text": "Life can be a real bastard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be5f920-8582-3c7e-a122-6146255c5d8f",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A variation that is not genuine; something irregular or inferior or of dubious origin, fake or counterfeit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e70e88b1-0165-4ad0-9929-4d0901203536",
                                                "sense_id": "2be5f920-8582-3c7e-a122-6146255c5d8f",
                                                "text": "The architecture was a kind of bastard, suggesting Gothic but not being true Gothic."
                                            },
                                            {
                                                "example_id": "28fa2b8c-3491-4667-a240-fbc64cd0ccc1",
                                                "sense_id": "2be5f920-8582-3c7e-a122-6146255c5d8f",
                                                "text": "There were also made good and politic laws that parliament, against usury, which is the bastard use of money..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd9c2df-1816-3b19-9494-c71513b04ffc",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A bastard file."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fff61ad-1a65-3be0-b876-78caa8bc8f8d",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A kind of sweet wine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d989162-58b7-412c-a30f-2e1e90de3b9d",
                                                "sense_id": "9fff61ad-1a65-3be0-b876-78caa8bc8f8d",
                                                "text": "[…] we ſhall haue all the world drinke browne & white baſtard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "917d2db2-40fe-3d78-b487-eb261e80bcd1",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A sword that is midway in length between a short-sword and a long sword; also bastard sword."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69a4dc97-74f2-3ece-b8c9-81af69687ebd",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "An inferior quality of soft brown sugar, obtained from syrups that have been boiled several times."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "827b17a1-3482-35bc-bd46-532020dc9b61",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A large mould for straining sugar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6da80f57-2cea-34a2-8dd6-cd9dcdcb825d",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A writing paper of a particular size."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e60efdb-0ee8-3c9b-bb5a-94468e6da4d2",
                                        "entry_id": "ea83d33e-9b77-30c0-968e-ff54a5c6630d",
                                        "glosses": [
                                            "A Eurosceptic Conservative MP, especially in the government of John Major."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765113c1-2a37-4ac6-99f8-ca03ebe68ec1",
                                                "sense_id": "8e60efdb-0ee8-3c9b-bb5a-94468e6da4d2",
                                                "text": "If you are a politician, you make sure that you know all such references in case an interviewer suddenly asks, 'Are you one of the bastards in Mr Major's cabinet?'"
                                            },
                                            {
                                                "example_id": "7853c21e-8e17-40c4-bef3-17f802347353",
                                                "sense_id": "8e60efdb-0ee8-3c9b-bb5a-94468e6da4d2",
                                                "text": "While John Major managed to get the Maastricht Treaty through parliament, despite the efforts of the “bastards” in his cabinet, the 2001 Conservative General Election campaign was fought on entirely eurosceptic lines."
                                            },
                                            {
                                                "example_id": "5187f361-62c2-4a2a-9ea3-ceeeb3a9b715",
                                                "sense_id": "8e60efdb-0ee8-3c9b-bb5a-94468e6da4d2",
                                                "text": "In the UK, Conservative Maastricht rebels (the 'bastards') almost brought down Conservative Prime Minister John Major's government."
                                            },
                                            {
                                                "example_id": "8696fd15-766b-4d3b-a397-f4e72b5431e5",
                                                "sense_id": "8e60efdb-0ee8-3c9b-bb5a-94468e6da4d2",
                                                "text": "One “bastard,” the Minister for Wales, John Redwood (who mounted an unsuccessful campaign to displace the Tory chief, John Major), was removed in a Cabinet reshuffle; but was his young successor William Hague any more reliable?"
                                            },
                                            {
                                                "example_id": "231cc104-20f7-451b-9a83-93d9bba4e809",
                                                "sense_id": "8e60efdb-0ee8-3c9b-bb5a-94468e6da4d2",
                                                "text": "But there is no doubt that the “bastards,” who had tormented so many Tory leaders over the years, had won. The longed-for break with “Europe” had finally come, but at the same price that Americans paid for Trump's takeover of the Republican Party."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bastard",
