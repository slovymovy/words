                "translations": [
                    {
                        "translation_id": "6d43f782-8f88-4716-b340-74020ff57f00",
                        "source_entry_id": "7cf6947b-baf5-3efe-bf4b-4f2d739dda75",
                        "source_sense_id": "daa97577-1a4d-3d78-9841-249c6aa93a06",
                        "target_lang_word": "lexicographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexicographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                        "entry_id": "10fc14db-2675-32cb-b410-f78a010b20e1",
                                        "glosses": [
                                            "One who writes or compiles a dictionary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0197e66-dfec-471c-aa28-37ee7734e3ac",
                                                "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                                "text": "Lexico′grapher. […] A writer of dictionaries; a harmleſs drudge, that buſies himſelf in tracing the original, and detailing the ſignification of words."
                                            },
                                            {
                                                "example_id": "79cd4bc7-7c82-4cb9-b6f9-95f394130897",
                                                "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                                "text": "Pitt has furnish'd us a word or two / Which lexicographers declined to do."
                                            },
                                            {
                                                "example_id": "8f11f384-6002-49b9-9915-2b20b027c481",
                                                "sense_id": "bd80b182-a3ca-32e5-8c65-a4878da386bc",
                                                "text": "The best lexicographer may well be content if his productions are received by the world with cold esteem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5e21625-3093-49fc-817f-b1ab30238525",
                        "source_entry_id": "7cf6947b-baf5-3efe-bf4b-4f2d739dda75",
                        "source_sense_id": "daa97577-1a4d-3d78-9841-249c6aa93a06",
                        "target_lang_word": "lexicógrafo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lexicógrafo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                        "entry_id": "76e159f2-9832-3d6f-be91-f8f5f90c3382",
                                        "glosses": [
                                            "Persona versada en lexicografía, y que se encarga de copilar los vocablos que han de entrar en un léxico."
                                        ],
                                        "tags": [
                                            "Ocupaciones",
                                            "oficios"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d96a7aa1-a9c0-450f-b120-e86554eabd45",
                                                "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                                "text": "«El lexicógrafo no ha de ver en la palabra más que la representación sensible del concepto, pero teniendo siempre en cuenta de que, supuesta la mutua y necesaria cooperación que se prestan pensamiento y lenguaje —sin la cual ni este sería otra cosa que un rudimentario sistema de señales ni aquel habría logrado sobrepasar las formas elementales de conocimiento— no es lícito en modo desvincular el signo y el significado cual si fuesen dos realidades con existencia propia e independiente»."
                                            },
                                            {
                                                "example_id": "dcfc91a1-a427-4937-bf26-536d4dd64ca9",
                                                "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                                "text": "«El entomólogo de las palabras es el lexicógrafo, al que no es raro ver en las esquinas armado de una red con que atrapa voces que luego ordena, a modo de una colección de insectos, en el interior de un volumen»."
                                            },
                                            {
                                                "example_id": "4badb9e1-7988-41b3-a172-3b219d981703",
                                                "sense_id": "34ec3064-5bd7-3395-bc7d-621378eae552",
                                                "text": "«El lexicógrafo georgiano del siglo xvii, Sulhan Saba Orbeliani, en su Diccionario Enciclopédico, dice con respecto al propóleo, que es una sustancia resinosa y similar a la cera que se utiliza con fines medicinales»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
