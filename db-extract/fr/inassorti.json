                                    {
                                        "sense_id": "7a7ec44e-b878-34ab-89cb-0310d104258c",
                                        "entry_id": "d752afce-f6ac-3780-a8f1-a408a62253a3",
                                        "glosses": [
                                            "unsorted, unordered; miscellaneous"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b297ec92-fe18-4207-ae14-bcbc95e250b5",
                                                "sense_id": "7a7ec44e-b878-34ab-89cb-0310d104258c",
                                                "text": "Some of the State institutions, however, burdened as they are with a large and unassorted mass of pupils, have made most encouraging progress in this direction."
                                            },
                                            {
                                                "example_id": "1e8688ad-54d7-48f1-a8ce-a0b9eadb81ca",
                                                "sense_id": "7a7ec44e-b878-34ab-89cb-0310d104258c",
                                                "text": "Out of sorts means mixed, unclassified, unassorted, having one's functions disordered."
                                            },
                                            {
                                                "example_id": "8d272483-9fff-4ca7-b6b0-e93805565667",
                                                "sense_id": "7a7ec44e-b878-34ab-89cb-0310d104258c",
                                                "text": "The sexual tragedy of modern life lies, not in the fact that woman as such is tending to differ fundamentally from man as such; but that, in the unassorted confusion of our modern life, it is continually the modified type of man or woman who is thrown into the closest personal relations with the antiquated type of the opposite sex[…]"
                                            }
                                        ]
