        "fr-extract.jsonl": [
            {
                "entry_id": "65a51cd0-3305-3b7b-8086-06a01a477e09",
                "word": "keinesfalls",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d308dfc0-2c13-3b9e-8ff0-94ac31d1d81c",
                        "entry_id": "65a51cd0-3305-3b7b-8086-06a01a477e09",
                        "glosses": [
                            "Pas du tout, en aucun cas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07f8e7c-bb1b-4b77-b3be-97f550c7f447",
                                "sense_id": "d308dfc0-2c13-3b9e-8ff0-94ac31d1d81c",
                                "text": "Wenn der Sonnenbrand heilt, dann juckt die verbrannte Stelle, und man darf keinesfalls daran kratzen.",
                                "translation": "Lorsque le coup de soleil se guérit, la zone brûlée démange et il ne faut en aucun cas pas la gratter."
                            },
                            {
                                "example_id": "8ee18ec6-3c9b-4578-a5c8-94081bf5b428",
                                "sense_id": "d308dfc0-2c13-3b9e-8ff0-94ac31d1d81c",
                                "text": "Und nun noch etwas zu Schuhspannern. Sie sind eine Philosophie für sich. (...) Keinesfalls sollte man mit übergroßen Streckern die Schuhe überdehnen.",
                                "translation": "Et maintenant, un mot sur les embauchoirs. Ils sont une philosophie en soi. (...) Il ne faut en aucun cas trop distendre les chaussures avec des embauchoirs surdimensionnés."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "e55aab08-aae0-3ceb-b07d-297ca95a4ae2",
                "word": "keinesfalls",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                        "entry_id": "e55aab08-aae0-3ceb-b07d-297ca95a4ae2",
                        "glosses": [
                            "unter gar keinen Umständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6939cef9-777b-48fb-866a-63435b5ac706",
                                "sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                                "text": "Das dürfen wir keinesfalls akzeptieren."
                            },
                            {
                                "example_id": "b12c268c-a580-4398-b731-dc0063269fca",
                                "sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                                "text": "„Ihre Namen dürfen dabei keinesfalls bürgerlich oder anderswie piefig klingen.“"
                            },
                            {
                                "example_id": "9e68121a-8fd8-48b7-96a0-09d5d758c3b9",
                                "sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                                "text": "„Ein Mobiltelefon muss aber nicht nur funktionieren, es soll auch hübsch und möglichst aktuell sein, und es darf keinesfalls in Sachen Robustheit den Kampf gegen Schlüsselbund, Parfumfläschchen und Konsorten in der Handtasche verlieren.“"
                            },
                            {
                                "example_id": "b1f7becd-8f68-4f9f-9fdb-06cb6809f644",
                                "sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                                "text": "„Leider konnten mich seine weltmännischen Erkenntnisse nicht trösten und mir war bewusst, dass meine Schuldgefühle gegenüber dem Eichsfeld keinesfalls durch globale Denkansätze gemildert würden.“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b25db062-b701-491a-b2eb-0d524e28d8ad",
                        "source_entry_id": "e55aab08-aae0-3ceb-b07d-297ca95a4ae2",
                        "source_sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                        "source_sense_description": "unter gar keinen Umständen",
                        "target_lang_word": "no way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47bd69d7-3656-3c38-bc80-4b6914a68c2c",
                                        "entry_id": "a6223fc5-9538-3b9e-a332-c8ee0b86ebd7",
                                        "glosses": [
                                            "in no way; not at all"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a748e84c-7f6d-4b9a-a4bb-ac33daebdaf6",
                                                "sense_id": "47bd69d7-3656-3c38-bc80-4b6914a68c2c",
                                                "text": "I suppose that meanes meerely humane can no way be capable of it[…]."
                                            },
                                            {
                                                "example_id": "62b1fb74-2104-454f-909e-3ad1f3072d88",
                                                "sense_id": "47bd69d7-3656-3c38-bc80-4b6914a68c2c",
                                                "text": "I get it. No way can me and Mickie talk to Rodrigo about what just happened up at the bench he's standing in the big holding cell, other mopes standing around waiting for their cases to be called, eavesdropping on what we're telling him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "no way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b48af7-113f-309b-b441-a171907436d9",
                                        "entry_id": "2a4352a1-7cab-33bd-89d4-438ac0af7f1c",
                                        "glosses": [
                                            "Absolutely not; under no circumstances."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe69e94e-3659-4a57-ad89-8755d2d48e9a",
                                                "sense_id": "02b48af7-113f-309b-b441-a171907436d9",
                                                "text": "Touch that weird rock over there, I dare you! —No way!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ac27ac-7662-3b7e-89be-6643110499f1",
                                        "entry_id": "2a4352a1-7cab-33bd-89d4-438ac0af7f1c",
                                        "glosses": [
                                            "Indicates astonished disbelief."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc288301-d19f-4672-a103-d15527694d20",
                                                "sense_id": "99ac27ac-7662-3b7e-89be-6643110499f1",
                                                "text": "You failed your exam again? No way!"
                                            },
                                            {
                                                "example_id": "1e4791b8-692d-42f8-8ae7-8eac3e9c2366",
                                                "sense_id": "99ac27ac-7662-3b7e-89be-6643110499f1",
                                                "text": "He's hitting 400 for two months? Uh-uh! No way!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "no way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6637506-b482-3f59-830a-60ef6436a74e",
                                        "entry_id": "52318705-d6f9-3049-a989-6d4b120c5191",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see no, way.; not any possibility."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ae98af2-08c5-4e3f-926e-a77f396f9976",
                                                "sense_id": "d6637506-b482-3f59-830a-60ef6436a74e",
                                                "text": "There is no way that I would trust him."
                                            },
                                            {
                                                "example_id": "31217e21-8290-4a15-b5ea-042687665cee",
                                                "sense_id": "d6637506-b482-3f59-830a-60ef6436a74e",
                                                "text": "Miranda: I'll admit it, Shepard. I'm impressed. You got us here. Are you ready?\nShepard: We're going in blind, and we don't even know if we'll survive the trip. No way in hell we're ready... but we don't have a choice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea408952-fc0e-4ab3-8899-b0cbae02abe9",
                        "source_entry_id": "e55aab08-aae0-3ceb-b07d-297ca95a4ae2",
                        "source_sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                        "source_sense_description": "unter gar keinen Umständen",
                        "target_lang_word": "en aucun cas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en aucun cas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "266cf647-5fe5-374d-8546-e10994e3f5d9",
                                        "entry_id": "76830bef-8434-3fac-b101-2d038b8ee0bf",
                                        "glosses": [
                                            "Jamais ; sans aucune acceptabilité ou possibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120cc751-f00d-40b2-bd1b-5b4957755780",
                                                "sense_id": "266cf647-5fe5-374d-8546-e10994e3f5d9",
                                                "text": "Avoir des doutes après avoir pris une décision importante ne signifie en aucun cas que vous avez pris la mauvaise décision."
                                            },
                                            {
                                                "example_id": "b5e27d17-15ab-4573-abca-6ca15b3579d0",
                                                "sense_id": "266cf647-5fe5-374d-8546-e10994e3f5d9",
                                                "text": "En aucun cas, des différences significatives de rendement n’ont pu être mises en évidence entre l’association diméfuron + carbétamide, même à dose double de la normale, et les témoins."
                                            },
                                            {
                                                "example_id": "2a9b9183-ce05-4bc5-b12e-1686a8c64462",
                                                "sense_id": "266cf647-5fe5-374d-8546-e10994e3f5d9",
                                                "text": "Lena, trente-cinq ans, n'est pas en mal de maternité. Au contraire. Elle a deux jeunes neveux qu'elle aime. Mais en aucun cas elle ne veut être mère. En aucun cas — elle m'en a clairement informé — elle ne souhaite un enfant entre nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "171b6fe9-cb1b-4529-b839-62781f1cf218",
                        "source_entry_id": "e55aab08-aae0-3ceb-b07d-297ca95a4ae2",
                        "source_sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
                        "source_sense_description": "unter gar keinen Umständen",
                        "target_lang_word": "en aucune façon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en aucune façon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adb3c5e6-59d5-3c2c-aee7-0bbfedbced1b",
                                        "entry_id": "36130068-5f46-3969-b28b-24ae6724d012",
                                        "glosses": [
                                            "Jamais, sans aucune acceptabilité ou possibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd739704-40f7-443b-8fe1-60f2e5b63c70",
                                                "sense_id": "adb3c5e6-59d5-3c2c-aee7-0bbfedbced1b",
                                                "text": "Le matelot qu’on nous avait laissé ne nous renseigna en aucune façon; il ne parlait qu’un esclavon inintelligible, et, comme Marco l’avait un peu raillé en mer, il ne voulait plus répondre à nos questions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49c2fe98-e711-490e-8a44-c26dc3f9819c",
                        "source_entry_id": "e55aab08-aae0-3ceb-b07d-297ca95a4ae2",
                        "source_sense_id": "9f4c2c16-23a0-3797-9e1f-cd38e0f32136",
