                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb8e765f-c1e7-4798-8afb-eaaf96fadba9",
                                                "sense_id": "cb1eee25-72a8-3d7e-834c-325296985b7a",
                                                "text": "1825 June 25, \"My Village Bells\", in The Circulator of Useful Knowledge, Literature, Amusement, and General Information number XXVI, available in, 1825, The Circulator of Useful Amusement, Literature, Science, and General Information, page 401,\nOh ! still for me let merry bells peel out their holy chime;"
                                            },
                                            {
                                                "example_id": "437063aa-ea05-416d-918c-a40e8355a680",
                                                "sense_id": "cb1eee25-72a8-3d7e-834c-325296985b7a",
                                                "text": "1901 January 1, \"Twentieth Century's Triumphant Entry\", The New York Times, page 1,\nThe lights flashed, the crowds sang,... bells peeled, bombs thundered,... and the new Century made its triumphant entry."
                                            },
                                            {
                                                "example_id": "abd03de2-a25f-4fcf-9518-414652af7909",
                                                "sense_id": "cb1eee25-72a8-3d7e-834c-325296985b7a",
                                                "text": "As the tiny Virgin... approaches one of the barrio churches, bells peel vigorously, a brass band launches into a fast-paced tune, and large rockets zoom... ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
