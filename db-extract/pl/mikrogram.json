                                "target_senses": [
                                    {
                                        "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                        "entry_id": "687c510a-783a-31f5-93a2-e57699255429",
                                        "glosses": [
                                            "An SI unit of mass equal to 10⁻⁶ grams. Symbol: μg A unit of mass equal to one millionth of a gram, or 0.000 001 grams."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d060793b-7b0b-4fe0-bc06-5912354efbc3",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "Holonyms: milligram < gram < kilogram < megagram < gigagram"
                                            },
                                            {
                                                "example_id": "b68f151c-6b73-4416-b920-2675a5a35349",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "Meronyms: picogram < nanogram"
                                            },
                                            {
                                                "example_id": "734a2744-dee8-460f-ac2b-f08b1d40f9ea",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "All seven cities saw an increase in air pollution during January-May. Readings assessed showed an average concentration of hazardous airborne particles - known as PM2.5 - up by as much as 14.8% in Taiyuan, the provincial capital, and by 16.3% in Shuozhou.[…]\nAccording to the latest data, average rates of PM2.5 in 337 cities nationwide stood at 44 micrograms per cubic meter in the first five months of the year, unchanged from 2018, with 118 cities reaching the national standard of 35 micrograms or below."
                                            },
                                            {
                                                "example_id": "b0905ac1-3737-46cf-8e26-a946738e808a",
                                                "sense_id": "cc2a1ea6-e6f7-35be-8944-7d981b851c24",
                                                "text": "In the United States, there was a daily mortality increase of 0.79 percent for each 10 micrograms per cubic meter increase in PM 10 and a 1.58 percent increase for each 10 microgram increase in PM 2.5."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84ccaacb-c403-4cb8-a311-90503a49d0ba",
                        "source_entry_id": "a1c47167-bc54-3fa2-b9e6-f8be82c7ac08",
                        "source_sense_id": "4de560aa-2355-3694-831d-5b2525610690",
