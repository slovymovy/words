            "senses": [
                {
                    "sense_id": "c9cf13f4-52d2-3508-86e6-38759888442e",
                    "sense_definition": "The quality of being ridiculous, unreasonable, or lacking sound judgment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not help but laugh at the <w>absurdity</w> of the entire situation."
                        },
                        {
                            "text": "The <w>absurdity</w> of his argument was clear to everyone in the room."
                        }
                    ],
                    "synonyms": [
                        "ridiculousness",
                        "irrationality",
                        "foolishness"
                    ],
                    "antonyms": [
                        "reasonableness",
                        "logic"
                    ],
                    "common_phrases": [
                        "sheer absurdity",
                        "total absurdity"
                    ]
                },
                {
                    "sense_id": "a13f5940-913c-319d-b520-c4ef12a05a55",
                    "sense_definition": "An action, statement, or idea that is completely illogical or nonsensical.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plan was filled with so many <w>absurdities</w> that it was impossible to take seriously."
                        },
                        {
                            "text": "He pointed out the <w>absurdity</w> of expecting a machine to solve such a complex human problem."
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "folly",
                        "paradox"
                    ],
                    "common_phrases": [
                        "point out an absurdity"
                    ]
                },
                {
                    "sense_id": "7bfe2b79-ddea-3a1d-a88e-f999e4669313",
                    "sense_definition": "A state of harsh, clashing, or disagreeable sounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>absurdity</w> of the discordant notes ruined the entire musical performance."
                        },
                        {
                            "text": "The constant <w>absurdity</w> of the city traffic noise made it hard to sleep."
                        }
                    ],
                    "synonyms": [
