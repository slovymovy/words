                                        "sense_id": "6f23627d-ff03-3dc4-bc15-e6c7ce515f85",
                                        "entry_id": "07908b72-bb13-3f0f-80c4-e4b22f994f19",
                                        "glosses": [
                                            "To rapidly grow out of proportion or control, from an initially smaller state."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b18ab8-a227-42da-801d-3a4ed058a0c4",
                                                "sense_id": "6f23627d-ff03-3dc4-bc15-e6c7ce515f85",
                                                "text": "The high unemployment rates quickly snowballed into a major budget problem for the government."
                                            },
                                            {
                                                "example_id": "990275be-6684-4709-999e-cf48db7f8ef5",
                                                "sense_id": "6f23627d-ff03-3dc4-bc15-e6c7ce515f85",
                                                "text": "There's a further knock-on effect from cancelling trains. It's not unusual for train crew diagrams to include a period 'on the cushions', travelling as a passenger to get staff from one train to the next. Cancel this train and it's likely the crew won't reach their next train, so this too is cancelled. Disruption snowballs and diagrams become harder to deliver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e5cf12d-befe-3c32-974b-da571068f965",
                                        "entry_id": "07908b72-bb13-3f0f-80c4-e4b22f994f19",
                                        "glosses": [
                                            "To play at throwing snowballs."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28359eda-b53a-39a8-a101-eba4e34ff634",
                                        "entry_id": "07908b72-bb13-3f0f-80c4-e4b22f994f19",
                                        "glosses": [
                                            "To pelt with snowballs; to throw snowballs at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77f3057b-d2ef-36dc-8554-f3c9c1695866",
                                        "entry_id": "07908b72-bb13-3f0f-80c4-e4b22f994f19",
                                        "glosses": [
                                            "To receive ejaculated semen in one's mouth, and to then pass it back and forth between one’s mouth and another person’s mouth."
