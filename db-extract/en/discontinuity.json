                "senses": [
                    {
                        "sense_id": "88afc45f-6f46-34f0-acaa-b9082c0eecae",
                        "entry_id": "fccd0aa6-b740-3326-8cb7-65f6e17b0392",
                        "glosses": [
                            "A lack of continuity, regularity or sequence; a break or gap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a564db1-a7f9-4e02-b8d1-37576971b542",
                                "sense_id": "88afc45f-6f46-34f0-acaa-b9082c0eecae",
                                "text": "Shock waves are sudden discontinuities propagated in compressible media – usually air."
                            }
                        ]
                    },
                    {
                        "sense_id": "6300512a-6cd8-3bea-a5e3-a345df20fb76",
                        "entry_id": "fccd0aa6-b740-3326-8cb7-65f6e17b0392",
                        "glosses": [
                            "A point in the range of a function at which it is undefined or discontinuous."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9fb3ad44-d2e6-3742-a13b-7f8f551cfc58",
                        "entry_id": "fccd0aa6-b740-3326-8cb7-65f6e17b0392",
                        "glosses": [
                            "a subterranean interface at which seismic velocities change"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
