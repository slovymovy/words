            {
                "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                "word": "berlingot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0f816ade-05fb-48f0-9ecd-ee6bca9ee76f",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "tags": [
                            "plural"
                        ],
                        "form": "berlingots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be863ce7-28ee-3453-8f06-579ff6872d8e",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "glosses": [
                            "Bonbon de sucre en forme de tétraèdre."
                        ],
                        "tags": [
                            "Confiserie"
                        ],
                        "examples": [
                            {
                                "example_id": "9278f87a-0d01-4e8c-b0bd-07392bef4b3c",
                                "sense_id": "be863ce7-28ee-3453-8f06-579ff6872d8e",
                                "text": "Martin admire l’accortise du marchand de berlingots, du juif qui débite de la galette rekaka et des ronds à l'anis, du rôtisseur qui fait fumer sur brasier, dans une caisse de tôle, des brochettes de foie ou des merguez, saucisses à la viande de mouton."
                            }
                        ]
                    },
                    {
                        "sense_id": "e98bd452-79be-30de-948e-e984c0ae2277",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "glosses": [
                            "Conditionnement de cette forme pour certains liquides, en plastique ou en carton."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca9ee80-9da0-450f-969e-7f140c49f389",
                                "sense_id": "e98bd452-79be-30de-948e-e984c0ae2277",
                                "text": "On me lavait les cheveux avec du shampoing Dop. On l’achetait en berlingots. J’aimais bien."
                            },
                            {
                                "example_id": "d23f70c7-b0d3-4c95-a809-b29f68dee1c9",
                                "sense_id": "e98bd452-79be-30de-948e-e984c0ae2277",
                                "text": "Henriette vide un berlingot Dop de couleur vanille sur le crâne de Lélia. Le shampooing coûte cher mais Henriette ne lésine pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "778172eb-3a48-36a5-bb7a-c6c929ff4f95",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "glosses": [
                            "Emballage de carton ciré pour le lait, la crème, etc., de forme (parallélépipède surmonté d'un \\\"toit\\\" à deux versants) et contenu (200 et 500 millilitres) standardisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71212df2-1406-4717-b7c4-cd01bbcb3fd5",
                                "sense_id": "778172eb-3a48-36a5-bb7a-c6c929ff4f95",
                                "text": "Elle vendait aussi des berlingots de lait, du beurre au quart ou à la motte, du fromage."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a3e2e87-8b27-3150-9b2c-8abe433d405d",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "glosses": [
                            "Pénis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5f82595c-94eb-3c4a-9630-3c89a151879c",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "glosses": [
                            "Balle d'arme à feu."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "72236fa5-b35c-4dbb-8e0f-9d4e69039cb9",
                                "sense_id": "5f82595c-94eb-3c4a-9630-3c89a151879c",
                                "text": "Je lui flanquai un berlingot dans la paillasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2936f68-d1fa-3f23-b658-149687e1a647",
                        "entry_id": "fcb5599a-31ee-394b-8ad2-eb3806d1b5af",
                        "glosses": [
                            "Hymen, virginité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f9dd1669-3a76-4433-adf0-f75f85996ee0",
                                "sense_id": "f2936f68-d1fa-3f23-b658-149687e1a647",
                                "text": "Elle a perdu son berlingot."
                            }
                        ]
                    }
                ],
