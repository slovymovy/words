                "senses": [
                    {
                        "sense_id": "5210a8c6-3caa-34e3-be7b-5f81f53d7256",
                        "entry_id": "1a1a991f-51e1-3570-b462-8fc5be652020",
                        "glosses": [
                            "To prance or frolic; of a horse, to canter easily."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca43fcf-cf7a-43df-bb44-8f4875cfd072",
                                "sense_id": "5210a8c6-3caa-34e3-be7b-5f81f53d7256",
                                "text": "I felt a fool and was much relieved when I saw the back of Mr Bellerby as he tit-tupped away to Cowslake Manor after pressing me to accept a cheroot about eight inches long out of a crocodile-skin case."
                            },
                            {
                                "example_id": "d281f288-63ed-4f8d-af9f-4a8ead6c2d19",
                                "sense_id": "5210a8c6-3caa-34e3-be7b-5f81f53d7256",
                                "text": "After this he began to go outside [the pub], many coats and yellow, thin overcoats opening willingly for him to pass, until he was out, or his legs had carried him there. He was tittuping."
                            },
                            {
                                "example_id": "42e0059b-6efe-408c-9228-3dc5d50b2e02",
                                "sense_id": "5210a8c6-3caa-34e3-be7b-5f81f53d7256",
                                "text": "1958, T. H. White, The Once and Future King, New York: Berkley, Book 3, Chapter 25, p. 424,\nThere were urbane abbots, titupping along on ambling palfreys, in furred hoods which were against the rules of their orders,"
                            }
                        ]
                    }
