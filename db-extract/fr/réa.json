                                        "entry_id": "54e3a0c0-3257-3c3b-8b5c-708b49763e4b",
                                        "glosses": [
                                            "A wheel having a groove in the rim for a rope to work in, and set in a block, mast, or similar; the wheel of a pulley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4138c2b7-032d-4719-ae22-e0f74e4322a5",
                                                "sense_id": "69b36776-3f06-3085-8aa5-70bcb2814e70",
                                                "text": "To an exceptional degree the duties on these inclines have been passed on from father to son; many a boy has begun his working life in oiling the sheaves and, after passing through every grade, has reached the age of retirement in the responsible position of brakesman."
                                            }
                                        ]
                                    },
