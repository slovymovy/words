                    }
                ],
                "senses": [
                    {
                        "sense_id": "705d2914-2e5a-3c8c-b05c-5f8e770cfa78",
                        "entry_id": "6b153414-6963-31ff-84c5-c36e26d9a77b",
                        "glosses": [
                            "Qualifie une personne qui est attirée, sentimentalement ou sexuellement, par un individu de n'importe quel genre ou sexe, tout en ayant des préférences envers certains genres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6957581b-c6bb-4f2f-bac5-e96ec22e3a0f",
                                "sense_id": "705d2914-2e5a-3c8c-b05c-5f8e770cfa78",
                                "text": "Je suis homosexuel, ou plutôt «omnisexuel», je suis attiré par tout les genres de manière générale, mais j'ai l'habitude de me dire homosexuel car j'ai un plus fort penchant pour les personnes du même sexe que le miens."
                            },
                            {
                                "example_id": "73dc30d4-55c7-443b-8b7d-e07204f3a621",
                                "sense_id": "705d2914-2e5a-3c8c-b05c-5f8e770cfa78",
                                "text": "Son unique ambition était de mettre en évidence au sein d'une fabuleuse diversité quelques caractères récurrents de la monogamie qui se retrouveront chez l'homme, animal omnivore et omnisexuel."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "468cc52a-1bcb-35f9-912b-39342629e9a3",
