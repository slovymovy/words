                        "target_lang_word": "Teehaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teehaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f477d5d-49ea-3bb8-94df-eefe02410f46",
                                        "entry_id": "02a004c2-01b9-363b-a2be-21054cb09200",
                                        "glosses": [
                                            "Gaststätte, in der hauptsächlich Tee serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ddb6371-b2a4-41f0-bb5a-141f12c91160",
                                                "sense_id": "5f477d5d-49ea-3bb8-94df-eefe02410f46",
                                                "text": "„Die flüsternden Teegläser, von denen Elsa an einem Platz wie diesem vernahm, waren das Geschenk eines alten Derwisches an den gutherzigen Betreiber eines winzigen Teehauses im Basar.“"
                                            },
                                            {
                                                "example_id": "bc2762df-1d90-433c-a81c-8f4ea2f33a9a",
                                                "sense_id": "5f477d5d-49ea-3bb8-94df-eefe02410f46",
                                                "text": "„Ich saß in Bandirma in einem türkischen Teehaus, nippte an meinem Mokka und sinnierte über die Türkei, den Glauben und die Gastfreundschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4b73f79-2aaf-3593-9966-ba72e2c1e87b",
                                        "entry_id": "02a004c2-01b9-363b-a2be-21054cb09200",
                                        "glosses": [
                                            "Geschäft für Tee und Teezubehör"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e27c60f9-067b-3b0e-bd38-44cf20bf618b",
                                        "entry_id": "02a004c2-01b9-363b-a2be-21054cb09200",
                                        "glosses": [
                                            "Pavillon für den zeremoniellen Teegenuss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af7cf35-2a75-454c-820d-bd69ddca3c2f",
                                                "sense_id": "e27c60f9-067b-3b0e-bd38-44cf20bf618b",
                                                "text": "In China gibt es viele Teehäuser."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11f5970b-d4b2-4e5e-be52-ed6bf4a5e0dd",
                        "source_entry_id": "cf0caa18-f531-3cc3-81e5-cb9849ca20cf",
                        "source_sense_id": "188fbaed-59b7-3eba-a691-2523e5c40676",
                        "target_lang_word": "Teestube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teestube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                        "entry_id": "1fc68e72-7917-33db-a05a-e0b7d7e6444f",
                                        "glosses": [
                                            "Raum, in dem Tee serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e94be37-c25e-49ba-b53b-e86eb44f56c0",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "In der Teestube gab es nicht nur Tee, sondern auch Kekse."
                                            },
                                            {
                                                "example_id": "6d081ef7-df0f-4a13-ba06-fa688c2c379e",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "Sie trafen sich jeden Mittwoch zum Kartenspielen und Reden in der Teestube."
                                            },
                                            {
                                                "example_id": "8680e822-cca4-4239-9b91-cf12aee5b9cf",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "Teestuben haben im türkischen Kulturkreise die Bedeutung des europäischen Cafés."
                                            },
                                            {
                                                "example_id": "555a3ee3-5da3-4bd0-8223-566709fe3af1",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "„Val sah, wie die Touristen im Innern der Teestube sie anstarrten.“"
                                            },
                                            {
                                                "example_id": "55d18e87-94d1-4355-9e62-d0ac735d4c49",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "„Es war Zeit für eine Pause und ich steuerte mein beladenes Rad durch das Gewirr an Menschen und Autos zu einer Teestube.“"
                                            },
                                            {
                                                "example_id": "4d833475-f4b9-4d8d-8eec-16c1e43ec98f",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "„Er verabschiedete sich darauf von ihr und verließ die Teestube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
