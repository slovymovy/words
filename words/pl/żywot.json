                {
                    "sense_id": "87630899-e0d8-3397-91a4-ef939c6016ee",
                    "sense_definition": "Całokształt procesów życiowych; czas trwania życia lub sposób, w jaki ktoś żyje (często w stylu podniosłym lub literackim).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "life_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek wiódł spokojny i uczciwy <w>żywot</w> na wsi.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка вел спокойную и честную <w>жизнь</w> в деревне.",
                                "en": "My grandfather led a quiet and honest <w>life</w> in the countryside."
                            }
                        },
                        {
                            "text": "Stary zegar w końcu dokonał swego <w>żywota</w> i przestał działać.",
                            "target_lang_translations": {
                                "ru": "Старые часы наконец окончили свою <w>жизнь</w> и перестали работать.",
                                "en": "The old clock finally reached the end of its <w>life</w> and stopped working."
                            }
                        }
                    ],
                    "synonyms": [
                        "życie",
                        "byt"
                    ],
                    "common_phrases": [
                        "dokonać żywota",
                        "wieść żywot",
                        "kres żywota"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизнь, существование; жизненный путь (часто в высоком или литературном стиле).",
                        "en": "Life, existence, or life span; way of living (often in a literary or elevated style)."
                    },
                    "translations": {
                        "ru": [
                            {
