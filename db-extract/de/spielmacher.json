                ],
                "senses": [
                    {
                        "sense_id": "bb1c2730-a32a-3b2f-8a20-50b78cf6b12c",
                        "entry_id": "1c5c83de-bbd8-3e1f-a5d5-91178f4d09c1",
                        "glosses": [
                            "Spieler innerhalb eines Teams, der die praktischen Spielabläufe koordiniert und die taktischen Spielzüge seiner Mannschaft maßgeblich beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a73b1bd-43f7-4b9a-8bdb-ce701c660fea",
                                "sense_id": "bb1c2730-a32a-3b2f-8a20-50b78cf6b12c",
                                "text": "„Der Spielmacher hat im Football eine elementare Rolle.“"
                            },
                            {
                                "example_id": "b1d8220b-4533-416c-9db3-4bb048316209",
                                "sense_id": "bb1c2730-a32a-3b2f-8a20-50b78cf6b12c",
                                "text": "„Jeder Spielmacher trägt Verantwortung für Defensive wie Offensive, doch Schröder ist auch der einzige Star im Team.“"
                            },
                            {
                                "example_id": "a36fc448-00e1-4a85-a5c8-9351fe428580",
                                "sense_id": "bb1c2730-a32a-3b2f-8a20-50b78cf6b12c",
                                "text": "„Der 45-Jährige war Spielmacher beim Wintermärchen 2007, als er die Nationalmannschaft im eigenen Land zum WM-Titel führte.“"
                            },
                            {
                                "example_id": "6ab4472f-dcb9-414c-af94-e96e2fcbe0d6",
                                "sense_id": "bb1c2730-a32a-3b2f-8a20-50b78cf6b12c",
                                "text": "„Der deutsche Spielmacher führte beim 117:96 (59:48) gegen die Philadelphia 76ers erneut glänzend Regie und kam neben 17 Punkten auch auf acht Assists und fünf Rebounds.“"
                            },
                            {
                                "example_id": "712e1d2c-079c-4e09-b3a4-78723e38ad18",
                                "sense_id": "bb1c2730-a32a-3b2f-8a20-50b78cf6b12c",
                                "text": "„Dem Spielmacher, der erst nach 50 Minuten überhaupt ins Spiel fand, gelang beim 14:21 bei den Baltimore Ravens lediglich ein Touchdown-Pass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
