                        "translation_id": "251c77c5-eee0-4dbe-bf7e-197afc70e90c",
                        "source_entry_id": "97b078c1-e14f-32aa-8c9d-d469fe45e45b",
                        "source_sense_id": "ac8c49fd-bbbe-3be7-95d2-2e4c16398491",
                        "target_lang_word": "Desiderat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Desiderat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e0d09f-522c-3433-bc8f-f5adbc2d3931",
                                        "entry_id": "1cee38ba-4647-3e7c-bda8-4b3c289007a1",
                                        "glosses": [
                                            "gewünschtes Objekt oder abstraktes Ding, wie ein fehlendes Buch in Bibliotheken, fehlende Sammelobjekte, Forschungsgegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cfb3f5-5357-4e8c-9711-d62db8f933a7",
                                                "sense_id": "d3e0d09f-522c-3433-bc8f-f5adbc2d3931",
                                                "text": "Die Erforschung dieses Sachverhalts ist ein Desiderat."
                                            },
                                            {
                                                "example_id": "e86d88a4-b86e-4c6c-9955-6046bfea3e86",
                                                "sense_id": "d3e0d09f-522c-3433-bc8f-f5adbc2d3931",
                                                "text": "„Eine Siedlungsgeschichte des Westteils der Leipziger Tieflandsbucht ist bis heute ein Desiderat der Forschung.“"
                                            },
                                            {
                                                "example_id": "8a41193f-6040-4070-a8e6-c01c31efc177",
                                                "sense_id": "d3e0d09f-522c-3433-bc8f-f5adbc2d3931",
                                                "text": "„Eine Kritik der Grenzen des Menschen […] scheint mir heute, da sein Produzieren alle Grenzen gesprengt zu haben scheint, und da diese spezielle Grenzsprengung die noch immer bestehenden Grenzen der anderen Vermögen […] deutlich sichtbar gemacht hat, geradezu das Desiderat der Philosophie geworden zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
