                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e5ce05d-f2c3-4226-abbb-97534e0a6170",
                        "entry_id": "e760df6c-18d4-396d-9b9c-a40db5cf0a46",
                        "tags": [
                            "plural"
                        ],
                        "form": "macaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cedaad4c-7d6a-3039-aeed-2d652a55c5f0",
                        "entry_id": "e760df6c-18d4-396d-9b9c-a40db5cf0a46",
                        "glosses": [
                            "Genre de singes originaires d'Asie, de la sous-famille des cercopithécinés à tête plate et à queue courte."
                        ],
                        "tags": [
                            "Primatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b5b73c6c-d6b5-4e4b-b5e0-5b7c55397edf",
                                "sense_id": "cedaad4c-7d6a-3039-aeed-2d652a55c5f0",
                                "text": "— Merci, dit-elle en grimaçant un refus à désespérer un macaque."
                            },
                            {
                                "example_id": "1b74eae8-2433-409a-83d0-9fd126d783c7",
                                "sense_id": "cedaad4c-7d6a-3039-aeed-2d652a55c5f0",
                                "text": "Une étude menée par un chercheur de l’Université de Lethbridge, en Alberta, révèle que certains macaques à longue queue sont capables de prendre des décisions économiques rudimentaires."
                            },
                            {
                                "example_id": "f3a5ae6b-30de-49f4-92ce-98cda34f544c",
                                "sense_id": "cedaad4c-7d6a-3039-aeed-2d652a55c5f0",
                                "text": "Ces « hommes-singes » auront pour mission d’imiter les cris des singes langur, ennemis naturels des macaques rhésus qui ont envahi la capitale, et ainsi les empêcher de perturber le sommet du G20 qui va s’y tenir d’ici quelques jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a30ec4f-03d2-4995-8e84-0f1e73d04c58",
                        "source_entry_id": "e760df6c-18d4-396d-9b9c-a40db5cf0a46",
                        "source_sense_id": "cedaad4c-7d6a-3039-aeed-2d652a55c5f0",
                        "target_lang_word": "Makak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
