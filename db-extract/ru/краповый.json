                ],
                "senses": [
                    {
                        "sense_id": "104a4dbe-5c65-3100-8eae-95bb61d38bac",
                        "entry_id": "8490e8ee-5cdf-382a-b43d-9f052464b633",
                        "glosses": [
                            "окрашенный краской, получаемой из корня краппа (марены красильной); имеющий такой цвет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492a2072-dcca-4976-b7c9-a27266505603",
                                "sense_id": "104a4dbe-5c65-3100-8eae-95bb61d38bac",
                                "text": "На ногах были щегольские гусарские краповые чакчиры и отличные сапоги с розетками."
                            },
                            {
                                "example_id": "d093d5e4-2013-4982-a3af-c134bc659086",
                                "sense_id": "104a4dbe-5c65-3100-8eae-95bb61d38bac",
                                "text": "Не будь я краповый чёрт, если я на радостях в монастыре кого-нибудь не повешу!"
                            },
                            {
                                "example_id": "ee42402a-ed12-4d52-94d6-4728f6102674",
                                "sense_id": "104a4dbe-5c65-3100-8eae-95bb61d38bac",
                                "text": "Знак представляет собой вышитый на краповом сукне овал с мечом, серпом и молотом в центре."
                            }
                        ]
                    }
                ],
