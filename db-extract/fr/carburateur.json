        "fr-extract.jsonl": [
            {
                "entry_id": "fd88924c-e7c9-3e3a-a969-c0517ad0d4cb",
                "word": "carburateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0ceb310-e562-4f32-9ebc-1eab7b7f9f25",
                        "entry_id": "fd88924c-e7c9-3e3a-a969-c0517ad0d4cb",
                        "tags": [
                            "plural"
                        ],
                        "form": "carburateurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                        "entry_id": "fd88924c-e7c9-3e3a-a969-c0517ad0d4cb",
                        "glosses": [
                            "Appareil dans lequel se mélangent l’air atmosphérique et l’essence pour former le gaz qui fait fonctionner les moteurs à explosion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e13304-08f9-4d87-a78b-1501c47360b7",
                                "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                "text": "Parmi les modifications importantes, il faut encore citer la mise en place d'un système de réchauffage pour empêcher les carburateurs de givrer, […]."
                            },
                            {
                                "example_id": "4b2364d0-8688-4448-b8f7-6749a70c6bf1",
                                "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                "text": "Ce qui signifie que la structure retenue pour contrôler le moteur réalise également les fonctions autrefois assurées par le carburateur, l’injection électronique analogique ou l’allumeur électromécanique."
                            },
                            {
                                "example_id": "c22878a3-7e57-42b2-9961-2da69b7c3f24",
                                "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                "text": "Après avoir totalement désossé l'engin, j'avais savamment vidé le pot d'échappement en supprimant les chicanes et adapté un carburateur récupéré sur la vieille mobylette d'un copain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e351a4af-540c-475c-87f6-4f9eec29377f",
                        "source_entry_id": "fd88924c-e7c9-3e3a-a969-c0517ad0d4cb",
                        "source_sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                        "target_lang_word": "Vergaser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergaser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b11d923-d8a2-3182-b9b0-9dc1d0d83465",
                                        "entry_id": "22976ef8-6b8b-3962-b966-88e58615fc7e",
                                        "glosses": [
                                            "Teil eines Verbrennungsmotors, der ein brennfertiges Kraftstoff-Luft-Gemisch herstellt"
                                        ],
                                        "tags": [
                                            "Kraftfahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c2abbd-63da-414f-ab54-e29e8f2fca4e",
                                                "sense_id": "1b11d923-d8a2-3182-b9b0-9dc1d0d83465",
                                                "text": "Er hat das Motorrad in die Werkstatt gebracht, weil die Drosselklappe am Vergaser wieder kaputt ist."
                                            },
                                            {
                                                "example_id": "7ace5b4e-652e-4228-8bb8-223d7f91aa50",
                                                "sense_id": "1b11d923-d8a2-3182-b9b0-9dc1d0d83465",
                                                "text": "„Das Gehäuse der Benzineinspritzung sieht aus wie die Vergaser aus früheren Jahrzehnten, und den Abgaskatalysator haben die Ingenieure geschickt unter dem Triebwerk versteckt, um den klassischen Schwung der Auspuffrohre nicht zu ruinieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "395eaa57-9ca3-45cd-8341-6925dda80f68",
                        "source_entry_id": "fd88924c-e7c9-3e3a-a969-c0517ad0d4cb",
                        "source_sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                        "target_lang_word": "carburetor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carburetor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4266ca02-d6d1-3eb6-a353-7fcc231bcf9f",
                                        "entry_id": "ecece2f0-1c1f-3595-b6c9-095d77158a35",
                                        "glosses": [
                                            "A device in an internal combustion engine where fuel is vaporized and mixed with air prior to ignition."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a49b11f5-ec8b-4991-b898-ff5036114bc6",
                                                "sense_id": "4266ca02-d6d1-3eb6-a353-7fcc231bcf9f",
                                                "text": "Near-synonym: gasifier"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae1f639d-bf07-3d04-91be-418ab501177a",
                                        "entry_id": "ecece2f0-1c1f-3595-b6c9-095d77158a35",
                                        "glosses": [
                                            "A device for enhancing illuminating gas by mixing in carbon-rich fuel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2fa9561-0445-4181-8f09-ab44c01f490d",
                                                "sense_id": "ae1f639d-bf07-3d04-91be-418ab501177a",
                                                "text": "Second, the employment of a current of air between the carburettor and the tube leading to the burner, is described.\nThe Mechanics' Magazine, July 25, 1862."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f457fd48-85e6-3ca5-8f50-e52b97c9efed",
                                        "entry_id": "ecece2f0-1c1f-3595-b6c9-095d77158a35",
                                        "glosses": [
                                            "A water pipe or bong; a device or contrivance for mixing air with burning cannabis or cocaine."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6adcff2-f388-4fd9-878f-c0e4191568ec",
                                                "sense_id": "f457fd48-85e6-3ca5-8f50-e52b97c9efed",
                                                "text": "Variations on the bong included air-driven pipes, electric pipes, ice pipes (chillers), mask pipes, chamber pipes, and carburetor pipes."
                                            },
                                            {
                                                "example_id": "dbd448f1-6a6c-47cd-83da-ede0b4df07e2",
                                                "sense_id": "f457fd48-85e6-3ca5-8f50-e52b97c9efed",
                                                "text": "Some pipes feature a “carburetor,” which is a small hole in the air chamber located past the bowl. The carburetor is held shut while the bowl is being lit and the smoke drawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
