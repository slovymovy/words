                        "source_sense_id": "1e40f823-7819-368b-bcf3-245e846034ea",
                        "source_sense_description": "een militair vliegveld",
                        "target_lang_word": "Militärflugplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
