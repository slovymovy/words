                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9159b259-b865-4f82-9287-e1c186f96c76",
                                "sense_id": "617fea39-ca5e-33e1-85ed-3342f99d504b",
                                "text": "First two duratives to express our practice of judging and measuring, then two punctiliars (aorists) to state God’s reciprocations."
                            },
                            {
                                "example_id": "b204c9c0-df72-45ee-ace8-b7c9b939111e",
                                "sense_id": "617fea39-ca5e-33e1-85ed-3342f99d504b",
                                "text": "Many researchers observe similar generalizations: that children seem unwilling to mark activity verbs like walk or unbounded punctiliars like jump with an -ed ending, even though this is a tense marker in the adult language that applies to all types of events."
                            }
                        ]
                    }
