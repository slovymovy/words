                    {
                        "translation_id": "87d735d4-92ea-464b-ace2-bbd1281e7b8b",
                        "source_entry_id": "a16f957c-4b77-365b-97b9-3d424579d688",
                        "source_sense_id": "a63210ca-91a1-3210-980a-85483ef49910",
                        "target_lang_word": "Exhumierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exhumierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5787e0da-3a78-3478-a4a3-073390dfe1ea",
                                        "entry_id": "ac5789a0-6dcd-3931-96c8-b130f81c8a63",
                                        "glosses": [
                                            "Ausgrabung einer bereits bestatteten Leiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eddccb4-b14f-4e9b-bbcc-8806d0763339",
                                                "sense_id": "5787e0da-3a78-3478-a4a3-073390dfe1ea",
                                                "text": "„Eine Exhumierung der angeblich am 13. Juni 1919 in einem Zinksarg beigesetzten Märtyrerin verspricht keine Hoffnung auf Aufklärung: 1935 fielen die Nazis über die Grabstätte von Rosa Luxemburg und Karl Liebknecht her und ließen offenkundig die dort bestatteten Gebeine verschwinden.“"
                                            },
                                            {
                                                "example_id": "5428b6f2-8a66-495b-a6d6-f85a6650cf43",
                                                "sense_id": "5787e0da-3a78-3478-a4a3-073390dfe1ea",
                                                "text": "„Zuerst konnte er ihn nicht richtig zuordnen, diesen säuerlich erdigen Gestank, doch je länger der Mann vor ihnen stand, desto mehr roch es wie bei einer Exhumierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "002303b6-5a38-4c0e-8642-6b9af08c95f4",
                        "source_entry_id": "a16f957c-4b77-365b-97b9-3d424579d688",
                        "source_sense_id": "a63210ca-91a1-3210-980a-85483ef49910",
                        "target_lang_word": "эксгума́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эксгума́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                        "entry_id": "200c8a7d-aab9-3c04-baee-8fa798b42f57",
                                        "glosses": [
                                            "офиц., юр. извлечение (выкапывание) уже погребенного трупа (останков) из земли (места погребения), для проведения судебно-медицинской экспертизы, научного исследования, повторного перезахоронения в другом месте, или с преступной целью разграбления могилы (могил)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a50d06e-0cd8-4b8f-9057-a64c07c5aea3",
                                                "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                                "text": "Что касается экспертизы по обнаружению амитал-натрия, то она проводилась после эксгумации трупа через 5 месяцев после захоронения, и эксперты отметили в своем акте, что современная наука не располагает данными о сроках сохранения яда в трупе, к тому же находившемся длительное время в воде, а затем в земле."
                                            },
                                            {
                                                "example_id": "73d73888-cd27-4402-8a60-5afbd1020038",
                                                "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                                "text": "Изучив документы, связанные с эксгумацией писателя, могу подтвердить, что народу при вскрытии могилы на кладбище Даниловского монастыря было много."
                                            },
                                            {
                                                "example_id": "a521cf01-afb9-4ab6-97a1-897eb3bb5016",
                                                "sense_id": "606e9ace-e4ca-3b0f-9419-609b02985c8d",
                                                "text": "Но в 1952 году была проведена эксгумация и останки погибших были перезахоронены в братских могилах на кладбище в Хойне."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
