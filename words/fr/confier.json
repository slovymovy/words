{
    "word_family": [
        "confiance",
        "confiant",
        "confidence",
        "confident",
        "confidentiel",
        "confidentiellement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33a60a33-08ba-3c91-acef-ad0a75038659",
                    "sense_definition": "Remettre une personne, un bien ou une responsabilité à la garde de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "garde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant nos vacances, nous <w>confions</w> notre chat à une voisine très attentionnée."
                        },
                        {
                            "text": "La directrice a décidé de <w>confier</w> une mission importante à ce jeune ingénieur."
                        }
                    ],
                    "synonyms": [
                        "déléguer",
                        "remettre"
                    ],
                    "common_phrases": [
                        "confier une tâche",
                        "confier une mission",
                        "confier ses enfants"
                    ]
                },
                {
                    "sense_id": "4377eeaa-9a7c-336d-be91-6f6554e2e819",
                    "sense_definition": "Dire un secret, exprimer une pensée intime ou un sentiment à une personne de confiance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>confier</w> son secret à sa meilleure amie hier soir."
                        },
                        {
                            "text": "Le musicien a <w>confié</w> ses doutes quant à la sortie de son nouvel album."
                        }
                    ],
                    "synonyms": [
                        "dévoiler",
                        "révéler"
                    ],
                    "antonyms": [
                        "cacher",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "confier un secret",
                        "confier ses doutes"
                    ]
                },
                {
                    "sense_id": "1df5c9e4-7204-34ef-bdc2-30a43f1eb65a",
                    "sense_definition": "S'en remettre à quelqu'un, lui ouvrir son cœur ou faire reposer son espoir sur lui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette rude journée, il avait besoin de se <w>confier</w> à un ami proche."
                        },
                        {
                            "text": "Elle ne sait pas toujours vers qui se tourner pour se <w>confier</w> librement."
                        }
                    ],
                    "synonyms": [
                        "s'épancher"
                    ],
                    "common_phrases": [
                        "se confier à un proche"
                    ]
                },
                {
                    "sense_id": "2ecd0590-e91d-39c4-b621-16b52f53aed6",
                    "sense_definition": "Déposer ou consigner quelque chose dans un support physique, moral ou abstrait.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "garde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain préfère <w>confier</w> ses pensées au papier chaque matin dès le réveil."
                        },
                        {
                            "text": "Le voyageur refuse d'abandonner ses projets et de <w>confier</w> son avenir au hasard."
                        }
                    ],
                    "synonyms": [
                        "consigner",
                        "remettre"
                    ],
                    "common_phrases": [
                        "confier au hasard",
                        "confier au papier"
                    ]
                }
            ]
        }
    ]
}