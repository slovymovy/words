{
    "word_family": [
        "senile",
        "senescence",
        "senescent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3670a3b0-3b48-3211-a73b-a76b640beb93",
                    "sense_definition": "The loss of mental faculties, such as memory and judgment, associated with old age.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "aging_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to show early signs of <w>senility</w> after his eightieth birthday.",
                            "target_lang_translations": {
                                "nl": "Na zijn tachtigste verjaardag begon hij vroege tekenen van <w>seniliteit</w> te vertonen."
                            }
                        },
                        {
                            "text": "The doctor explained that her forgetfulness was a normal part of aging rather than <w>senility</w>.",
                            "target_lang_translations": {
                                "nl": "De dokter legde uit dat haar vergeetachtigheid een normaal onderdeel van veroudering was in plaats van <w>ouderdomsdementie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dementia",
                        "dotage"
                    ],
                    "antonyms": [
                        "juvenility"
                    ],
                    "common_phrases": [
                        "signs of senility",
                        "onset of senility",
                        "early senility"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het verlies van verstandelijke vermogens, zoals geheugen en beoordelingsvermogen, als gevolg van hoge ouderdom."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "seniliteit",
                                "target_lang_sense_clarification": "geestelijke aftakeling door ouderdom"
                            },
                            {
                                "target_lang_word": "ouderdomsdementie",
                                "target_lang_sense_clarification": "medische toestand van dementie bij ouderen"
                            },
                            {
                                "target_lang_word": "kindsheid",
                                "target_lang_sense_clarification": "verouderd of informeel voor geestelijke aftakeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46904569-6b23-3164-8e62-a8b5a004b2c6",
                    "sense_definition": "The physical and mental deterioration caused by old age; old age itself.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aging_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Exercise can help prevent the physical decline often linked with <w>senility</w>.",
                            "target_lang_translations": {
                                "nl": "Lichaamsbeweging kan helpen de fysieke achteruitgang te voorkomen die vaak in verband wordt gebracht met <w>seniliteit</w>."
                            }
                        },
                        {
                            "text": "He was entering his years of <w>senility</w> and not liking it a bit.",
                            "target_lang_translations": {
                                "nl": "Hij trad zijn jaren van <w>ouderdomszwakte</w> tegemoet en vond het helemaal niets."
                            }
                        }
                    ],
                    "synonyms": [
                        "senescence"
                    ],
                    "antonyms": [
                        "juvenescence"
                    ],
                    "common_phrases": [
                        "years of senility"
                    ],
                    "target_lang_definitions": {
                        "nl": "De lichamelijke en geestelijke aftakeling veroorzaakt door ouderdom; de ouderdomsperiode zelf."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "seniliteit",
                                "target_lang_sense_clarification": "algehele lichamelijke en geestelijke ouderdomsafbraak"
                            },
                            {
                                "target_lang_word": "ouderdomszwakte",
                                "target_lang_sense_clarification": "fysieke en mentale verzwakking door leeftijd"
                            },
                            {
                                "target_lang_word": "hoge ouderdom",
                                "target_lang_sense_clarification": "de levensfase van ouderdom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed7cbb4f-2e65-364f-a88e-d1c304a75176",
                    "sense_definition": "An elderly or mentally infirm person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was no need for him to speak as if they were doddering <w>senilities</w>.",
                            "target_lang_translations": {
                                "nl": "Er was geen enkele reden voor hem om te praten alsof ze wankele <w>oude knarren</w> waren."
                            }
                        },
                        {
                            "text": "The young managers dismissed the older board members as irrelevant <w>senilities</w>.",
                            "target_lang_translations": {
                                "nl": "De jonge managers deden de oudere bestuursleden af als irrelevante <w>fossielen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dotard"
                    ],
                    "common_phrases": [
                        "doddering senilities"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used disparagingly to refer to people"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een bejaard of geestelijk verzwakt persoon (minachtend of verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "oude knar",
                                "target_lang_sense_clarification": "informeel/minachtend voor een bejaard persoon"
                            },
                            {
                                "target_lang_word": "fossiel",
                                "target_lang_sense_clarification": "figuurlijk en geringschattend voor een oud persoon"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}