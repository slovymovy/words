                        "glosses": [
                            "makaron krajany na bardzo cienkie nitki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1afc0a5-a138-4b3f-9fb7-640f64b2aa51",
                                "sense_id": "79953fa3-6023-35e4-a8ee-5c479a27f3e3",
                                "text": "Babciny rosół z wermiszlem bardzo mi smakował, nie ukrywam."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
