{
    "word_family": [
        "поэтому",
        "притом",
        "причём"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "bb3f0cc4-cf4c-3d70-ac6e-878f79a82ac9",
                    "sense_definition": "Указательное местоимение, используемое для обозначения предмета, лица, явления или ситуации, находящихся в поле зрения или обсуждаемых в данный момент.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "demonstrative_substantive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Это> мой новый компьютер, который я купил вчера.",
                            "target_lang_translations": {
                                "en": "<This> is my new computer, which I bought yesterday.",
                                "cs": "<To> je můj nový počítač, který jsem včera koupil.",
                                "zh": "<这>是我昨天买的新电脑。"
                            }
                        },
                        {
                            "text": "Посмотри в окно, <это> наша школа.",
                            "target_lang_translations": {
                                "en": "Look out the window, <that>'s our school.",
                                "cs": "Podívej se z okna, <to> je naše škola.",
                                "zh": "看窗外，<那>是我们的学校。"
                            }
                        },
                        {
                            "text": "— Что <это> такое? — <Это> подарок для тебя.",
                            "target_lang_translations": {
                                "en": "— What is <this>? — <It>'s a gift for you.",
                                "cs": "— Co <to> je? — <To> je dárek pro tebe.",
                                "zh": "— <这>是什么？— <这>是给你的礼物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "всё это",
                        "вот это",
                        "кто это",
                        "что это"
                    ],
                    "target_lang_definitions": {
                        "en": "Demonstrative pronoun indicating an object, person, or situation nearby or under discussion.",
                        "cs": "Ukazovací zájmeno používané k označení předmětu, osoby, jevu nebo situace, které jsou v dohledu nebo o kterých se právě mluví.",
                        "zh": "指示代词，用于指代当前视野内或正在讨论的物体、人、现象或情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "this",
                                "target_lang_sense_clarification": "indicating something nearby or present"
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "indicating something further away"
                            },
                            {
                                "target_lang_word": "it",
                                "target_lang_sense_clarification": "referring to a specific object or situation"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "ukazuje na věc nebo situaci v blízkosti či v kontextu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这",
                                "target_lang_sense_clarification": "指代近处或当前的事物"
                            },
                            {
                                "target_lang_word": "那",
                                "target_lang_sense_clarification": "指代远处的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7542ea6c-03d5-3d98-b905-a67a46b5c6d5",
                    "sense_definition": "Связка, используемая для присоединения определения или разъяснения к подлежащему (часто заменяет глагол «быть» или стоит после тире).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "copula",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя семья — <это> самое главное в моей жизни.",
                            "target_lang_translations": {
                                "en": "My family <is> the most important thing in my life.",
                                "cs": "Moje rodina — <to> je to nejdůležitější v mém životě.",
                                "zh": "我的家人<是>我生命中最重要的人。"
                            }
                        },
                        {
                            "text": "Москва — <это> столица и крупнейший город России.",
                            "target_lang_translations": {
                                "en": "Moscow <is> the capital and largest city of Russia.",
                                "cs": "Moskva — <to> je hlavní a největší město Ruska.",
                                "zh": "莫斯科<是>俄罗斯的首都和最大城市。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "это значит"
                    ],
                    "target_lang_definitions": {
                        "en": "Linking word used to connect a subject to its definition or explanation (often replaces 'to be').",
                        "cs": "Sponové slovo používané k propojení podmětu s jeho definicí nebo vysvětlením (často nahrazuje sloveso „být“).",
                        "zh": "系词，用于连接主语及其定义或解释（常用于破折号后，起强调作用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "is",
                                "target_lang_sense_clarification": "linking subject and predicate"
                            },
                            {
                                "target_lang_word": "means",
                                "target_lang_sense_clarification": "signifies or implies"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "je",
                                "target_lang_sense_clarification": "spojuje podmět a přísudek"
                            },
                            {
                                "target_lang_word": "znamená",
                                "target_lang_sense_clarification": "vyjadřuje význam nebo definici"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "是",
                                "target_lang_sense_clarification": "连接主语和谓语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2213190-2111-395a-a9b0-e1ee265b7034",
                    "sense_definition": "Местоимение, замещающее ранее упомянутую ситуацию, мысль, факт или целое предложение.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reference_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он много работает, и <это> помогает ему добиваться успеха.",
                            "target_lang_translations": {
                                "en": "He works a lot, and <this> helps him achieve success.",
                                "cs": "Hodně pracuje a <to> mu pomáhá dosahovat úspěchu.",
                                "zh": "他工作很努力，<这>有助于他取得成功。"
                            }
                        },
                        {
                            "text": "Я не знал, что ты приедешь, <это> стало для меня сюрпризом.",
                            "target_lang_translations": {
                                "en": "I didn't know you were coming; <it> was a surprise for me.",
                                "cs": "Nevěděl jsem, že přijedeš, <to> pro mě bylo překvapením.",
                                "zh": "我不知道你会来，<这>对我来说是个惊喜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "при всём этом",
                        "кроме этого"
                    ],
                    "target_lang_definitions": {
                        "en": "Pronoun referring back to a previously mentioned situation, fact, or idea.",
                        "cs": "Zájmeno odkazující zpět na dříve zmíněnou situaci, fakt nebo myšlenku.",
                        "zh": "代词，指代前文提到的情况、事实或观点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "this",
                                "target_lang_sense_clarification": "referring to the previous statement"
                            },
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "referring to a past event or fact"
                            },
                            {
                                "target_lang_word": "it",
                                "target_lang_sense_clarification": "general reference to a situation"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "odkazuje na předchozí tvrzení nebo událost"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这",
                                "target_lang_sense_clarification": "指代前文提到的内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33b5ab09-b440-3aea-83f6-08eb1de6bd86",
                    "sense_definition": "Форма именительного или винительного падежа единственного числа среднего рода местоимения <w>этот</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу примерить <это> пальто.",
                            "target_lang_translations": {
                                "en": "I want to try on <this> coat.",
                                "cs": "Chci si vyzkoušet <toto> kabát.",
                                "zh": "我想试穿<这>件大衣。"
                            }
                        },
                        {
                            "text": "<Это> здание было построено в прошлом веке.",
                            "target_lang_translations": {
                                "en": "<This> building was built in the last century.",
                                "cs": "<Tato> budova byla postavena v minulém století.",
                                "zh": "<这>座建筑建于上个世纪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Neuter singular form of the demonstrative pronoun 'this'.",
                        "cs": "Tvar středního rodu jednotného čísla ukazovacího zájmena „tento“.",
                        "zh": "指示代词“这个”的中性单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "this",
                                "target_lang_sense_clarification": "determiner for neuter nouns"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "toto",
                                "target_lang_sense_clarification": "ukazovací zájmeno pro střední rod"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "zkrácený tvar pro střední rod"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这",
                                "target_lang_sense_clarification": "用于修饰名词的指示代词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ab2cd33-4875-32d7-a481-ada4451748c5",
                    "sense_definition": "Эвфемизм, используемый для обозначения интимных отношений или тем, о которых не принято говорить прямо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "euphemism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой книге много написано про <это>.",
                            "target_lang_translations": {
                                "en": "There is a lot written about <it> in this book.",
                                "cs": "V této knize je hodně napsáno o <tom>.",
                                "zh": "这本书里有很多关于<那个>的内容。"
                            }
                        },
                        {
                            "text": "Родители стеснялись говорить с сыном про <это>.",
                            "target_lang_translations": {
                                "en": "The parents were shy to talk to their son about <it>.",
                                "cs": "Rodiče se styděli mluvit se synem o <tom>.",
                                "zh": "父母不好意思和儿子谈论<那个>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "половой акт"
                    ],
                    "common_phrases": [
                        "про это"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Euphemism referring to intimate relations or taboo subjects.",
                        "cs": "Eufemismus označující intimní vztahy nebo tabuizovaná témata.",
                        "zh": "委婉语，指代亲密关系或不便直说的禁忌话题。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "it",
                                "target_lang_sense_clarification": "euphemism for sex"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "eufemismus pro sex"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那个",
                                "target_lang_sense_clarification": "指代性行为的委婉说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "65c1f48b-34c2-3f4b-93d4-817ee064f496",
                    "sense_definition": "Усилительная частица, выделяющая слово или члена предложения, на который падает логическое ударение (часто в значении «именно»).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Это> я должен извиниться перед вами.",
                            "target_lang_translations": {
                                "en": "<It is> I who should apologize to you.",
                                "cs": "<Právě> já se vám musím omluvit.",
                                "zh": "<正是>我应该向您道歉。"
                            }
                        },
                        {
                            "text": "<Это> мой брат помог мне решить проблему.",
                            "target_lang_translations": {
                                "en": "<It was> my brother who helped me solve the problem.",
                                "cs": "<Právě> můj bratr mi pomohl vyřešit ten problém.",
                                "zh": "<就是>我哥哥帮我解决了这个问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "именно"
                    ],
                    "target_lang_definitions": {
                        "en": "Emphatic particle used to highlight the word carrying logical stress.",
                        "cs": "Zdůrazňovací částice používaná k vyzdvihnutí slova, na které dopadá logický důraz.",
                        "zh": "强调语气词，用于突出逻辑重音所在的词或句子成分。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "it is",
                                "target_lang_sense_clarification": "used in cleft sentences for emphasis"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "právě",
                                "target_lang_sense_clarification": "zdůraznění konkrétní osoby nebo věci"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "zdůraznění v rámci větné konstrukce"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正是",
                                "target_lang_sense_clarification": "用于强调特定的人或事"
                            },
                            {
                                "target_lang_word": "就是",
                                "target_lang_sense_clarification": "用于强调主语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f5b6068-b908-3585-bb49-aa91ff31d107",
                    "sense_definition": "Частица, используемая в вопросительных предложениях для усиления вопроса, выражения удивления, недоумения или нетерпения.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "question_intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Куда <это> вы так спешите?",
                            "target_lang_translations": {
                                "en": "Where <on earth> are you rushing to?",
                                "cs": "Kam <vlastně> tak spěcháte?",
                                "zh": "你们<到底>这么急着去哪儿？"
                            }
                        },
                        {
                            "text": "Где <это> ты был так поздно?",
                            "target_lang_translations": {
                                "en": "Where <on earth> were you so late?",
                                "cs": "Kde <proboha> jsi byl tak pozdě?",
                                "zh": "你<到底>去哪儿了，这么晚才回来？"
                            }
                        }
                    ],
                    "synonyms": [
                        "же"
                    ],
                    "common_phrases": [
                        "где это",
                        "куда это"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Intensifying particle used in questions to express surprise or impatience.",
                        "cs": "Částice používaná v otázkách k vyjádření překvapení, údivu nebo netrpělivosti.",
                        "zh": "疑问句中的语气词，用于加强语气，表达惊讶、困惑或不耐烦。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "on earth",
                                "target_lang_sense_clarification": "intensifier for questions"
                            },
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "asking for specific details with emphasis"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vlastně",
                                "target_lang_sense_clarification": "vyjádření údivu v otázce"
                            },
                            {
                                "target_lang_word": "proboha",
                                "target_lang_sense_clarification": "vyjádření netrpělivosti nebo údivu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底",
                                "target_lang_sense_clarification": "用于疑问句中加强追问语气"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c0d3b4b2-bbd0-32be-9928-4b5ee4507679",
                    "sense_definition": "Слово-паразит, используемое при заминке в речи, когда говорящий подбирает нужные слова или колеблется.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я, <это>, совсем забыл купить хлеб.",
                            "target_lang_translations": {
                                "en": "I, <uh>, totally forgot to buy bread.",
                                "cs": "Já, <teda>, jsem úplně zapomněl koupit chleba.",
                                "zh": "我，<那个>，完全忘了买面包。"
                            }
                        },
                        {
                            "text": "Мы, <это>, не сможем прийти завтра.",
                            "target_lang_translations": {
                                "en": "We, <um>, won't be able to come tomorrow.",
                                "cs": "My, <prostě>, nebudeme moct zítra přijít.",
                                "zh": "我们，<那个>，明天没法来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "это самое"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Filler word used when hesitating or searching for words.",
                        "cs": "Výplňkové slovo používané při váhání nebo hledání správných slov.",
                        "zh": "口语中的填充词，用于说话卡顿时寻找词汇或表示犹豫。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uh",
                                "target_lang_sense_clarification": "hesitation filler"
                            },
                            {
                                "target_lang_word": "um",
                                "target_lang_sense_clarification": "hesitation filler"
                            },
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "colloquial filler"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "teda",
                                "target_lang_sense_clarification": "výplňkové slovo při váhání"
                            },
                            {
                                "target_lang_word": "prostě",
                                "target_lang_sense_clarification": "hovorová výplň"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那个",
                                "target_lang_sense_clarification": "说话时的停顿填充词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}