                "forms": [],
                "senses": [
                    {
                        "sense_id": "a455cd94-11f2-38a2-a666-03df03614378",
                        "entry_id": "8c5c9aa0-a150-3d1c-8b23-fa02eb9629fb",
                        "glosses": [
                            "De manière fragmentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b63b294-d5e7-4129-a9a9-8fad8152da87",
                                "sense_id": "a455cd94-11f2-38a2-a666-03df03614378",
                                "text": "« Les mathématiciens connaissent plusieurs procédés graphiques au moyen desquels une figure plane — ou même solide — est fragmentairement représentée par une série de nombres.\n« Réciproquement ils savent traduire une série de nombres en une figure construite par points.\n« Les divers moyens graphiques doivent donc être classés de manière à ce qu’on choisisse tout d’abord le plus simple.\n« Là encore, les Martiens évidemment plus élevés que nous intellectuellement saisirent à merveille."
                            },
                            {
                                "example_id": "013eb46b-63e2-4d3d-b8ed-200bc1bdc7be",
                                "sense_id": "a455cd94-11f2-38a2-a666-03df03614378",
                                "text": "J’ai un peu remanié « l’Incident d’Antioche », pièce ancienne écrite pour Antoine Vitez qui en donna lecture en 1989. Elle été traduite en anglais, jouée fragmentairement en Allemagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebf6d69b-6349-4bf4-9ae5-924032cd2aba",
                        "source_entry_id": "8c5c9aa0-a150-3d1c-8b23-fa02eb9629fb",
                        "source_sense_id": "a455cd94-11f2-38a2-a666-03df03614378",
                        "target_lang_word": "fragmentarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragmentarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7ddcac-5436-3ddc-8fad-917ddc20a047",
                                        "entry_id": "4d692105-0a29-3ead-930a-9ad720d03939",
                                        "glosses": [
                                            "In a fragmentary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103588dd-1ea0-4099-ab50-67c291b9f471",
                                                "sense_id": "6d7ddcac-5436-3ddc-8fad-917ddc20a047",
                                                "text": "So he got his flute, propped up the book against a vase, and played the tune, whilst she hummed it fragmentarily."
                                            },
                                            {
                                                "example_id": "149a01bc-79b3-404d-870c-f6f4f89f02e1",
                                                "sense_id": "6d7ddcac-5436-3ddc-8fad-917ddc20a047",
                                                "text": "In the working-class quarters the barricades were being pulled down, rather fragmentarily, for it is a lot easier to build a barricade than to put the stones back."
                                            },
                                            {
                                                "example_id": "0d6439bb-3cdb-4a18-b612-72423d4c88bb",
                                                "sense_id": "6d7ddcac-5436-3ddc-8fad-917ddc20a047",
                                                "text": "Two were ramshackle old men—droolers as toothless as carp. They were irregulars, armed and clothed fragmentarily with junk taken from real soldiers who were newly dead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
