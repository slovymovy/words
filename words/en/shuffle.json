{
    "word_family": [
        "shuffler",
        "shuffling",
        "reshuffle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac6892f4-3f0c-348b-b1be-08464cfca98f",
                    "sense_definition": "To mix playing cards, tiles, or other items to put them in a random order.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "randomize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>shuffle</w> the cards thoroughly before you deal them to the players.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, тщательно <w>перетасуйте</w> карты, прежде чем раздавать их игрокам.",
                                "zh": "在发牌给玩家之前，请务必把牌<w>洗</w>匀。"
                            }
                        },
                        {
                            "text": "It is your turn to <w>shuffle</w> the deck for the next round.",
                            "target_lang_translations": {
                                "ru": "Твоя очередь <w>тасовать</w> колоду для следующего раунда.",
                                "zh": "轮到你为下一轮<w>洗牌</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shuffle the cards",
                        "shuffle the deck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемешивать игральные карты, фишки или другие предметы, чтобы расположить их в случайном порядке.",
                        "zh": "指将扑克牌、麻将牌或其他物品混合，使其顺序随机化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тасовать",
                                "target_lang_sense_clarification": "карты"
                            },
                            {
                                "target_lang_word": "перетасовать",
                                "target_lang_sense_clarification": "карты"
                            },
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "карты или фишки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洗牌",
                                "target_lang_sense_clarification": "特指扑克牌"
                            },
                            {
                                "target_lang_word": "洗",
                                "target_lang_sense_clarification": "指混合牌类"
                            },
                            {
                                "target_lang_word": "打乱",
                                "target_lang_sense_clarification": "指混合物品顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2d6b714-34d6-312a-82c1-32c53aa3dedb",
                    "sense_definition": "To walk by dragging one's feet slowly along the ground rather than lifting them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dragging_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired old man began to <w>shuffle</w> slowly down the corridor.",
                            "target_lang_translations": {
                                "ru": "Уставший старик начал медленно <w>шаркать</w> по коридору.",
                                "zh": "那位疲惫的老人开始沿着走廊缓慢地<w>拖着脚</w>走。"
                            }
                        },
                        {
                            "text": "I heard him <w>shuffle</w> his feet nervously while waiting for the interview.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как он нервно <w>шаркал</w> ногами в ожидании собеседования.",
                                "zh": "我听到他在等待面试时紧张地<w>蹭着</w>脚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shamble"
                    ],
                    "common_phrases": [
                        "shuffle feet",
                        "shuffle along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти медленно, волоча ноги по земле, вместо того чтобы поднимать их.",
                        "zh": "指走路时脚不完全抬起，拖着脚缓慢移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаркать",
                                "target_lang_sense_clarification": "ногами при ходьбе"
                            },
                            {
                                "target_lang_word": "волочить ноги",
                                "target_lang_sense_clarification": "идти медленно"
                            },
                            {
                                "target_lang_word": "шаркать ногами",
                                "target_lang_sense_clarification": "издавать шорох при ходьбе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖着脚走",
                                "target_lang_sense_clarification": "描述动作"
                            },
                            {
                                "target_lang_word": "蹭着走",
                                "target_lang_sense_clarification": "描述动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1e0fdf3-e9b3-3293-bf4e-2ddd7e0943ec",
                    "sense_definition": "To rearrange, reorganize, or change the order of a group of things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rearrange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>shuffle</w> the schedule to accommodate the new project.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>перестроить</w> график, чтобы освободить место для нового проекта.",
                                "zh": "经理决定<w>调整</w>日程安排以适应新项目。"
                            }
                        },
                        {
                            "text": "We had to <w>shuffle</w> the papers on the desk to find the missing contract.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>перерыть</w> бумаги на столе, чтобы найти пропавший контракт.",
                                "zh": "我们不得不<w>重新整理</w>桌上文件的顺序，才找到丢失的合同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shuffle papers",
                        "shuffle the schedule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переставлять, реорганизовывать или менять порядок группы вещей.",
                        "zh": "指对一组事物进行重新排列、重组或改变顺序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перетасовывать",
                                "target_lang_sense_clarification": "менять порядок, реорганизовывать"
                            },
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "менять местами документы, планы"
                            },
                            {
                                "target_lang_word": "перераспределять",
                                "target_lang_sense_clarification": "менять график или обязанности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重新安排",
                                "target_lang_sense_clarification": "指计划或日程"
                            },
                            {
                                "target_lang_word": "调整",
                                "target_lang_sense_clarification": "指顺序或结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cab6ced-8736-3a6d-99db-afd3f9eb8cf0",
                    "sense_definition": "To behave in an evasive or deceitful manner; to shift ground or prevaricate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked directly about the missing funds, the politician began to <w>shuffle</w> and avoid the question.",
                            "target_lang_translations": {
                                "ru": "Когда политика прямо спросили о пропавших средствах, он начал <w>юлить</w> и избегать вопроса.",
                                "zh": "当被直接问及失踪资金时，这位政客开始<w>推诿</w>并回避问题。"
                            }
                        },
                        {
                            "text": "Do not <w>shuffle</w> when you are expected to give a straightforward answer.",
                            "target_lang_translations": {
                                "ru": "Не <w>виляй</w>, когда от тебя ждут прямого ответа.",
                                "zh": "当人们期待你给出直接回答时，不要<w>支吾</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя уклончиво или нечестно; уходить от прямого ответа или юлить.",
                        "zh": "指行为闪烁其词或欺骗；通过转移话题来推诿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юлить",
                                "target_lang_sense_clarification": "уклоняться от ответа"
                            },
                            {
                                "target_lang_word": "выкручиваться",
                                "target_lang_sense_clarification": "избегать прямоты"
                            },
                            {
                                "target_lang_word": "вилять",
                                "target_lang_sense_clarification": "говорить уклончиво"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推诿",
                                "target_lang_sense_clarification": "指逃避责任"
                            },
                            {
                                "target_lang_word": "支吾",
                                "target_lang_sense_clarification": "指说话不直接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60b28f77-1d95-3836-af4b-ee6def709b80",
                    "sense_definition": "To get by with difficulty; to make shift or manage through clever expedients.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With very little money left, they had to <w>shuffle</w> through the winter as best they could.",
                            "target_lang_translations": {
                                "ru": "Оставшись почти без денег, им пришлось <w>выкручиваться</w> зимой как только могли.",
                                "zh": "剩下的钱很少，他们只能尽力<w>凑合</w>着过冬。"
                            }
                        },
                        {
                            "text": "We must <w>shuffle</w> for ourselves now that the funding has been cut.",
                            "target_lang_translations": {
                                "ru": "Теперь, когда финансирование урезали, мы должны <w>выкручиваться</w> сами.",
                                "zh": "既然资金被削减了，我们必须自己<w>想办法</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shuffle for oneself"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of making shift or managing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Справляться с трудностями; перебиваться или выкручиваться с помощью хитрых уловок.",
                        "zh": "指在困难中勉强维持；通过权宜之计设法应付。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкручиваться",
                                "target_lang_sense_clarification": "справляться с трудностями"
                            },
                            {
                                "target_lang_word": "перебиваться",
                                "target_lang_sense_clarification": "с трудом сводить концы с концами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勉强应付",
                                "target_lang_sense_clarification": "指处理困难"
                            },
                            {
                                "target_lang_word": "凑合",
                                "target_lang_sense_clarification": "指勉强过日子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c160cde-df59-3592-83d3-5d611d929dd4",
                    "sense_definition": "To push or shove something rapidly from one position or person to another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pushing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They watched him <w>shuffle</w> money from hand to hand with incredible speed.",
                            "target_lang_translations": {
                                "ru": "Они наблюдали, как он с невероятной скоростью <w>перекладывал</w> деньги из руки в руку.",
                                "zh": "他们看着他以惊人的速度将钱在手中<w>来回挪动</w>。"
                            }
                        },
                        {
                            "text": "The clerks would <w>shuffle</w> documents across the counter all day long.",
                            "target_lang_translations": {
                                "ru": "Клерки целый день <w>пересовывали</w> документы через стойку.",
                                "zh": "职员们整天都在柜台上<w>传递</w>文件。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро перекладывать или пересовывать что-то из одного положения в другое или от одного человека к другому.",
                        "zh": "指迅速地将某物从一个位置或人手中移到另一个位置或人手中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекладывать",
                                "target_lang_sense_clarification": "быстро перемещать туда-сюда"
                            },
                            {
                                "target_lang_word": "пересовывать",
                                "target_lang_sense_clarification": "быстро двигать предметы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快速挪动",
                                "target_lang_sense_clarification": "指移动物品"
                            },
                            {
                                "target_lang_word": "来回传递",
                                "target_lang_sense_clarification": "指在人之间传递"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a98234dc-6e0b-31b1-b21d-ea2a1920e97f",
                    "sense_definition": "To introduce or remove something secretly or deceptively through artificial confusion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer accused the opposition of trying to <w>shuffle</w> false evidence into the official files.",
                            "target_lang_translations": {
                                "ru": "Адвокат обвинил оппонентов в попытке тайно <w>подсунуть</w> ложные улики в официальные материалы дела.",
                                "zh": "律师指责对方试图将伪证<w>偷偷塞入</w>官方档案中。"
                            }
                        },
                        {
                            "text": "He managed to <w>shuffle</w> his own proposal into the stack of approved documents.",
                            "target_lang_translations": {
                                "ru": "Ему удалось незаметно <w>подложить</w> свое предложение в стопку утвержденных документов.",
                                "zh": "他设法将自己的提案<w>混入</w>了已批准的文件堆中。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно или обманным путем подсовывать или убирать что-либо, создавая искусственную путаницу.",
                        "zh": "指通过制造混乱，秘密地或欺骗性地引入或移除某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсовывать",
                                "target_lang_sense_clarification": "незаметно внедрять"
                            },
                            {
                                "target_lang_word": "подтасовывать",
                                "target_lang_sense_clarification": "незаметно подменять документы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偷偷塞入",
                                "target_lang_sense_clarification": "指混入物品"
                            },
                            {
                                "target_lang_word": "暗中调换",
                                "target_lang_sense_clarification": "指欺骗性替换"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74e1b908-e89b-3da9-92c5-ddaa8ff0ea11",
                    "sense_definition": "The act of mixing playing cards or tiles to randomize their order.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "randomize_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the deck a good <w>shuffle</w> before you deal the next hand.",
                            "target_lang_translations": {
                                "ru": "Хорошенько <w>перетасуй</w> колоду, прежде чем сдавать следующую сдачу.",
                                "zh": "在发下一手牌之前，先好好<w>洗牌</w>。"
                            }
                        },
                        {
                            "text": "After a quick <w>shuffle</w>, the game was ready to begin.",
                            "target_lang_translations": {
                                "ru": "После быстрой <w>тасовки</w> игра была готова к началу.",
                                "zh": "经过快速<w>洗牌</w>后，游戏准备开始了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick shuffle",
                        "good shuffle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемешиванию игральных карт или фишек для случайного изменения их порядка.",
                        "zh": "指混合扑克牌或牌类以随机化其顺序的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тасование",
                                "target_lang_sense_clarification": "карт"
                            },
                            {
                                "target_lang_word": "перемешивание",
                                "target_lang_sense_clarification": "карт"
                            },
                            {
                                "target_lang_word": "тасовка",
                                "target_lang_sense_clarification": "разговорное обозначение процесса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洗牌",
                                "target_lang_sense_clarification": "指动作过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb8a6769-efb9-337b-86ca-aba13a6e0650",
                    "sense_definition": "The act of reordering items, such as music tracks on a media player, or a mode that plays them in random order.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "randomize_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I put my playlist on <w>shuffle</w> so I wouldn't hear the songs in the same order.",
                            "target_lang_translations": {
                                "ru": "Я включил плейлист в <w>случайном порядке</w>, чтобы не слушать песни в одной и той же последовательности.",
                                "zh": "我把播放列表设为<w>随机播放</w>，这样就不会总是按同样的顺序听歌了。"
                            }
                        },
                        {
                            "text": "The media player has a convenient <w>shuffle</w> feature for music lovers.",
                            "target_lang_translations": {
                                "ru": "В медиаплеере есть удобная функция <w>перемешивания</w> для любителей музыки.",
                                "zh": "这款媒体播放器为音乐爱好者提供了便捷的<w>随机播放</w>功能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on shuffle",
                        "shuffle mode"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт изменения порядка элементов (например, музыкальных треков в плеере) или режим, воспроизводящий их в случайном порядке.",
                        "zh": "指重新排序项目的行为，例如媒体播放器中的音乐曲目，或以随机顺序播放的模式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный порядок",
                                "target_lang_sense_clarification": "режим воспроизведения"
                            },
                            {
                                "target_lang_word": "шаффл",
                                "target_lang_sense_clarification": "режим перемешивания музыки"
                            },
                            {
                                "target_lang_word": "перемешивание",
                                "target_lang_sense_clarification": "треков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随机播放",
                                "target_lang_sense_clarification": "指播放模式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092fd5bf-0850-381b-b999-4e74ca50b00f",
                    "sense_definition": "A slow, dragging walk where the feet are not lifted fully from the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dragging_movement_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the distinctive <w>shuffle</w> of his slippers coming down the hallway.",
                            "target_lang_translations": {
                                "ru": "Мы слышали отчетливое <w>шарканье</w> его тапочек, приближающихся по коридору.",
                                "zh": "我们能听到他拖鞋在走廊里<w>拖沓的脚步</w>声。"
                            }
                        },
                        {
                            "text": "She walked with a tired <w>shuffle</w> after working a double shift at the hospital.",
                            "target_lang_translations": {
                                "ru": "Она шла усталой, <w>шаркающей походкой</w> после двойной смены в больнице.",
                                "zh": "在医院上了两班倒后，她拖着疲惫的<w>步态</w>走着。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tired shuffle"
