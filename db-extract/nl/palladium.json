                    {
                        "translation_id": "8b65df67-7ee0-42af-9a20-456bacd4708b",
                        "source_entry_id": "d7f6af4d-8212-3a05-9427-1fc604c1816c",
                        "source_sense_id": "92497ec8-03e7-3907-b640-c676c63f00cf",
