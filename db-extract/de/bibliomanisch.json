                                                "example_id": "4b286e8b-eb14-482f-b075-92fd5f127eb4",
                                                "sense_id": "4375742d-1dae-3afc-a578-dbde5d7aa2a7",
                                                "text": "The small local library was not enough to satisfy our bibliomaniacal thirst."
                                            },
                                            {
                                                "example_id": "120f9a5f-23d4-47e0-a895-e891ab0e0e07",
                                                "sense_id": "4375742d-1dae-3afc-a578-dbde5d7aa2a7",
                                                "text": "Before breakfast I employed myself in airing my old bibliomaniacal hobby, entering all the books lately acquired into a temporary catalogue, so as to have them shelved and marked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
