                "senses": [
                    {
                        "sense_id": "be913ed1-a068-38bf-ba30-a50f30dc9f38",
                        "entry_id": "b82a1050-c6f9-336a-a11b-4873430227a7",
                        "glosses": [
                            "skandinavische Form des Namens Donar (= ein germanischer Gott)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915fe242-c08d-4197-9176-6af2b4c9ea4a",
                                "sense_id": "be913ed1-a068-38bf-ba30-a50f30dc9f38",
                                "text": "„Der zweite und nächst Wodan-Odin berühmteste Gott war Thor, der über Wolken und Regen gebot, sich durch den leuchtenden Blitz und durch den rollenden Donner kund gab, dessen Keil durch die Lüfte fuhr und auf Erden einschlug.“"
                            },
                            {
                                "example_id": "e929d83c-2fe1-4f37-bcc6-5946c9ef4ee5",
                                "sense_id": "be913ed1-a068-38bf-ba30-a50f30dc9f38",
                                "text": "Odin hat Thors Frau Sif die Haare abgeschnitten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f74fa76-293a-4912-9e64-fc3af67fb890",
                        "source_entry_id": "b82a1050-c6f9-336a-a11b-4873430227a7",
                        "source_sense_id": "be913ed1-a068-38bf-ba30-a50f30dc9f38",
                        "target_lang_word": "Thor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d1a191-7520-3a9f-a728-0028ae0fd2e4",
                                        "entry_id": "8dfe0985-a5a6-3a09-8741-a16c0fa11e1a",
                                        "glosses": [
                                            "A hammer-wielding god associated with thunder, lightning, storms, sacred groves and trees, strength, and the protection of mankind."
                                        ],
                                        "tags": [
                                            "Norse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4077e105-e698-4de7-91fa-edbb2493ad34",
                                                "sense_id": "78d1a191-7520-3a9f-a728-0028ae0fd2e4",
                                                "text": "So likewise a day comes when the Runic Thor, with his Eddas, must withdraw into dimness; and many an African Mumbo-Jumbo and Indian Pawpaw be utterly abolished."
                                            },
                                            {
                                                "example_id": "3cfcdc4e-9f78-460c-b940-993494438a48",
                                                "sense_id": "78d1a191-7520-3a9f-a728-0028ae0fd2e4",
                                                "text": "There’s the Thor fly in tribute of the God of Thunder, played in Marvel by Chris Hemsworth. Its scientific name is “Daptolestes bronteflavus,” which is derived from Latin like most scientific names – and translates to “blond thunder.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba82d80-9059-303a-a65c-f2d2b3f248cf",
                                        "entry_id": "8dfe0985-a5a6-3a09-8741-a16c0fa11e1a",
                                        "glosses": [
                                            "A male given name from the Germanic languages occasionally borrowed from Scandinavia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce0d98e-66c4-3071-96ce-7ae2e8f8be32",
                                        "entry_id": "8dfe0985-a5a6-3a09-8741-a16c0fa11e1a",
                                        "glosses": [
                                            "A mountain on Baffin Island, Canada."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
