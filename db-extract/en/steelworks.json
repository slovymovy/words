                        ]
                    },
                    {
                        "translation_id": "8e59c121-508e-4442-a90e-130095c9ac5a",
                        "source_entry_id": "78b6af92-8893-3e0b-b07f-9b225f240b1b",
                        "source_sense_id": "13802137-a8ba-30e3-a21a-6eee971ccf79",
