    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6716a378-03b0-3f90-a390-0c47d3f3f47b",
                    "sense_definition": "spreken met een zeer zachte, gedempte stem zodat anderen het niet kunnen horen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>fluisterden</w> zachtjes om de kinderen niet wakker te maken.",
                            "target_lang_translations": {
                                "en": "They <w>whispered</w> softly so as not to wake the children."
                            }
                        },
                        {
                            "text": "In de bibliotheek moet je <w>fluisteren</w> om de andere mensen niet te storen.",
                            "target_lang_translations": {
                                "en": "In the library, you must <w>whisper</w> so as not to disturb other people."
                            }
                        }
                    ],
                    "synonyms": [
                        "smoezen",
                        "zachtjes praten"
                    ],
                    "antonyms": [
                        "schreeuwen",
                        "roepen"
                    ],
                    "common_phrases": [
                        "zachtjes fluisteren",
                        "in iemands oor fluisteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to speak with a very soft, muffled voice so that others cannot hear it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whisper",
                                "target_lang_sense_clarification": "to speak softly without using vocal cords"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f71f355a-6f19-3a3d-bec4-2652f75ed948",
                    "sense_definition": "iets met een gedempte stem tegen iemand zeggen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het juiste antwoord werd stiekem in zijn oor <w>gefluisterd</w>.",
                            "target_lang_translations": {
                                "en": "The correct answer was secretly <w>whispered</w> in his ear."
                            }
                        },
                        {
                            "text": "Zij <w>fluisterde</w> een geheim tegen haar beste vriendin tijdens de les.",
                            "target_lang_translations": {
                                "en": "She <w>whispered</w> a secret to her best friend during class."
                            }
                        }
                    ],
                    "synonyms": [
                        "toefluisteren"
                    ],
                    "common_phrases": [
                        "een geheim fluisteren",
                        "woorden fluisteren"
                    ],
                    "target_lang_definitions": {
                        "en": "to say something to someone with a muffled voice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whisper",
                                "target_lang_sense_clarification": "to say something quietly to a specific person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}