    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0aa44720-2578-3ce2-994b-c2c4e96854cb",
                "word": "contactless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2b9d88c2-818a-392a-a34c-55ebd5a7393f",
                        "entry_id": "0aa44720-2578-3ce2-994b-c2c4e96854cb",
                        "glosses": [
                            "That does not use or require contact in order to happen or operate.",
                            "Conducted without human-to-human contact to improve ease of use or reduce the potential spread of a contagious disease; contact-free."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "85f5e8c2-1b22-47af-a695-7fb2007a4ba2",
                                "sense_id": "2b9d88c2-818a-392a-a34c-55ebd5a7393f",
                                "text": "Contactless commerce, of which Amazon Go is at the extreme end, was of course already by the autumn of 2019 a growing trend, what with increasing numbers of self-checkout counters and websites and apps that allowed us to have everything from groceries to pet supplies to prescription medication delivered right to our doorsteps."
                            },
                            {
                                "example_id": "7328cdf2-73e4-49d7-a69b-cd90b1344a80",
                                "sense_id": "2b9d88c2-818a-392a-a34c-55ebd5a7393f",
                                "text": "Please stay in touch with me / In this contactless society / Anywhere that you may be"
                            }
                        ]
                    },
                    {
                        "sense_id": "182cb6d7-dfd2-353b-a687-564cc64c886a",
                        "entry_id": "0aa44720-2578-3ce2-994b-c2c4e96854cb",
                        "glosses": [
                            "That does not use or require contact in order to happen or operate.",
                            "Happening without physical contact at the point of sale."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2886cad2-31b7-4ae5-a73f-2264b3fa3ad2",
                                "sense_id": "182cb6d7-dfd2-353b-a687-564cc64c886a",
                                "text": "TfL has been saying for a few years that Oyster will eventually be withdrawn, but not until contactless payments can offer railcard discounts."
                            }
                        ]
                    },
                    {
                        "sense_id": "99ca79b7-2ea5-36fd-9101-dde42ba64474",
                        "entry_id": "0aa44720-2578-3ce2-994b-c2c4e96854cb",
                        "glosses": [
                            "That has no contact or contacts."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "619f0036-f3de-4be7-9aa1-ad6d17400102",
                        "source_entry_id": "0aa44720-2578-3ce2-994b-c2c4e96854cb",
                        "source_sense_description": "not needing contact",
                        "target_lang_word": "kontaktlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kontaktlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27d6ed69-7f84-39a9-9d16-029f64f8636f",
                                        "entry_id": "10c85a9e-63f4-395d-a550-a1edb148baa5",
                                        "glosses": [
                                            "ohne Berührung; ohne physischen Kontakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5c1c4d-bd07-4f5b-af67-0ffc689f5f43",
                                                "sense_id": "27d6ed69-7f84-39a9-9d16-029f64f8636f",
                                                "text": "„Bereits in den vergangenen zehn Jahren hat laut Tojner ein Transformationsprozess beim Payment eingesetzt. Von der reinen Kartenzahlung über kontaktloses und mobiles Bezahlen bis zu Wearables (etwa Ringe oder Armbänder mit eingebauten Chips), die bei den Konsumenten mittlerweile angekommen seien – aber was kommt danach?“"
                                            },
                                            {
                                                "example_id": "7445d086-8934-406b-8d38-25514528419f",
                                                "sense_id": "27d6ed69-7f84-39a9-9d16-029f64f8636f",
                                                "text": "„35 Prozent der Gesamttransaktionen wurden im Jahr 2017 bereits kontaktlos abgewickelt.“"
                                            },
                                            {
                                                "example_id": "8727f0ed-8186-4aa0-9193-7ed660f75300",
                                                "sense_id": "27d6ed69-7f84-39a9-9d16-029f64f8636f",
                                                "text": "„Der Weg in eine aseptisch reine Welt des kontaktlosen Bezahlens birgt allerdings erhebliche Risiken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20a4d9c9-f9d6-406b-9a53-b532acf2c04d",
