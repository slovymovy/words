                                                "sense_id": "6289b2c7-f2e1-3233-83cd-15578416258d",
                                                "text": "„Immer wieder [wird] – und das auch gerne von Politikern – die Rolle der Medien hochgespielt.“"
                                            },
                                            {
                                                "example_id": "8461bc95-e007-404f-8c08-b6208d1e18a4",
                                                "sense_id": "6289b2c7-f2e1-3233-83cd-15578416258d",
                                                "text": "„Diese ganze Angelegenheit wurde außerhalb jeder Proportion hochgespielt.“"
                                            }
                                        ],
