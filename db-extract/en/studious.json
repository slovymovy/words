                                                "sense_id": "00b1c3d7-2112-30a1-a821-e4dbf4a5634f",
                                                "text": "Denke lieber besonnen als unbedacht."
                                            },
                                            {
                                                "example_id": "848a64be-b172-45e7-bf6a-769503a1317e",
                                                "sense_id": "00b1c3d7-2112-30a1-a821-e4dbf4a5634f",
