                    {
                        "sense_id": "cb03b978-8f55-3bb3-a961-685f2c73c2f2",
                        "entry_id": "3dc12ce6-9a92-36f0-896c-ba4ac6faf369",
                        "glosses": [
                            "Bewohner des Schwarzwaldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea2b8cb-ae4b-4974-82d7-d287e95f42a2",
                                "sense_id": "cb03b978-8f55-3bb3-a961-685f2c73c2f2",
                                "text": "Kurt, mein Chef, ist ein Schwarzwälder."
