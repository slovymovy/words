                    },
                    {
                        "translation_id": "87799afb-07a5-4621-a961-8fedcdabf7cb",
                        "source_entry_id": "4d249985-4e47-3f69-adf5-3fe4246ed9e1",
                        "source_sense_id": "c0eb7825-ecdb-34e0-8404-4f6aa6f5f890",
