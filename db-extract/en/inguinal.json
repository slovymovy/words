                    },
                    {
                        "translation_id": "379959f6-e5a6-4392-bc7a-59f57a97fb96",
                        "source_entry_id": "413d5721-57dc-3ce3-a3a1-0ca13da7abb4",
                        "source_sense_id": "0d90f94d-617d-3cff-9d2c-b3aa5bbcbac9",
                        "source_sense_description": "of or pertaining to the groin",
                        "target_lang_word": "inguinal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inguinal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9da0083d-90b0-3144-8de4-a5fd53c20452",
                                        "entry_id": "b82bdbd4-07fa-3f3b-b9b1-ccd70927611b",
                                        "glosses": [
                                            "in der Leistengegend; zur Leistengegend gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95eb4915-f044-43a5-b92c-437a1017209b",
                                                "sense_id": "9da0083d-90b0-3144-8de4-a5fd53c20452",
                                                "text": "Lymphknotenschwellungen ausschließlich im oberen oder mittleren Halsbereich oder inguinal lassen an eine akut entzündliche Genese denken (akute unspezifische Lymphadenitis bzw. Lymphadenitis ohne erkennbare Spezifität, Lymphknoten-Tbc, Trypanosomiasis, Lymphogranuloma inguinale)."
                                            },
                                            {
                                                "example_id": "5590bb65-55d1-4c67-a89e-ca9010d8db3c",
                                                "sense_id": "9da0083d-90b0-3144-8de4-a5fd53c20452",
                                                "text": "Ein weiterer Keim, der häufiger Schwarze als Weiße befällt, ist ein Bakterium, das die \"Donovaniose\" verursacht, eine Geschwürbildung an Haut und Schleimhäuten, auch Granuloma inguinale genannt."
                                            },
                                            {
                                                "example_id": "ef7e68d7-33c9-4cb7-b0c1-904ced193a59",
                                                "sense_id": "9da0083d-90b0-3144-8de4-a5fd53c20452",
                                                "text": "In einer Unterbauch-Computertomographie wurde rechts inguinal ein ausgedehnter, ca. 10 cm messender, teils solider, teils nekrotischer Prozess, bis an die großen Gefäße heranreichend, beschrieben."
                                            },
                                            {
                                                "example_id": "b3bbc80a-6709-4b73-889e-fe678d07f946",
                                                "sense_id": "9da0083d-90b0-3144-8de4-a5fd53c20452",
                                                "text": "Doch schon ein Monat später bestand sowohl sonographisch als auch radiologisch der Verdacht auf rasch wachsende Lymphknotenmetastasen links inguinal, die daraufhin auch exstirpiert und histologisch bestätigt wurden."
                                            },
                                            {
                                                "example_id": "e5118d62-4ca1-4835-89b1-3cf416a0d013",
                                                "sense_id": "9da0083d-90b0-3144-8de4-a5fd53c20452",
                                                "text": "Nach Punktion des Gefäßsystems, meist inguinal über die A. femoralis, wird mittels eines Ballonkatheters eine Verengung (Stenose) in einem arteriellen Gefäß erweitert (dilatiert) und gegebenenfalls ein Metallgitter (Stent) implantiert, um das Gefäß offenzuhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
