                "senses": [
                    {
                        "sense_id": "d201de88-851f-330a-aef0-7c4d2fcb2b8e",
                        "entry_id": "1e1f74cb-966b-3357-acc1-46bb9bbc01da",
                        "glosses": [
                            "bestuurder van een vliegtuig of luchtschip"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "1118d8c3-e021-42f4-a599-8f0d8c14fe07",
                                "sense_id": "d201de88-851f-330a-aef0-7c4d2fcb2b8e",
                                "text": "De Britse piloten van Ryanair hebben ingestemd met loonsverhogingen tot wel 20 procent. Dat is via geheime stemmingen gebeurd en vliegeniers van de prijsvechter kunnen op de loonstrook van deze maand al een hoger bedrag tegemoetzien."
                            },
                            {
                                "example_id": "c0e461ab-4c83-44da-986d-001084d370e8",
                                "sense_id": "d201de88-851f-330a-aef0-7c4d2fcb2b8e",
                                "text": "Hansen was voor zijn acteercarrière vliegenier bij de Amerikaanse marine en vocht mee in Azië tijdens de Tweede Wereldoorlog. Na de oorlog volgt hij zijn droom en begint hij met acteren. Hij krijgt zijn eerste grote rol in 1950 in de speelfilm Branded met Alan Ladd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53624749-f6be-4abb-ba07-362d2e80204e",
                        "source_entry_id": "1e1f74cb-966b-3357-acc1-46bb9bbc01da",
                        "source_sense_id": "d201de88-851f-330a-aef0-7c4d2fcb2b8e",
                        "target_lang_word": "aviator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aviator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6537503f-7dfc-34ab-8e51-8df1dc81b97f",
                                        "entry_id": "5e692344-740f-3400-bf45-8180aa32d73a",
                                        "glosses": [
                                            "An aircraft pilot, especially a military pilot. The use of the word may imply claims of superior airmanship, as in navy aviator vs. air force pilot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6381ace8-3212-4685-8472-2b17216d6465",
                                                "sense_id": "6537503f-7dfc-34ab-8e51-8df1dc81b97f",
                                                "text": "Ruth Elder was known for her beauty and acting, but her real dream was to become the female version of transatlantic aviator Charles Lindbergh."
                                            },
                                            {
                                                "example_id": "c7009f45-65d6-4702-857a-0e2203634034",
                                                "sense_id": "6537503f-7dfc-34ab-8e51-8df1dc81b97f",
                                                "text": "Two missing US Navy aviators have been declared dead, several days after their aircraft crashed near Mount Rainier, Washington, during a training flight, the Navy said Sunday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21fdf55b-ad32-354e-a11b-76c1bab0a3d5",
                                        "entry_id": "5e692344-740f-3400-bf45-8180aa32d73a",
                                        "glosses": [
                                            "An experimenter in aviation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61e8cb36-2be6-3119-a95e-b695466b781d",
                                        "entry_id": "5e692344-740f-3400-bf45-8180aa32d73a",
                                        "glosses": [
                                            "A flying machine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
