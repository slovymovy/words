                "senses": [
                    {
                        "sense_id": "7199be49-d88b-351d-b3d0-5b175690c9c7",
                        "entry_id": "73015b04-06d5-3071-a948-904674d73b9f",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b507f1bb-a25c-4094-8a24-0dd86f1f7b85",
                        "source_entry_id": "73015b04-06d5-3071-a948-904674d73b9f",
                        "source_sense_id": "7199be49-d88b-351d-b3d0-5b175690c9c7",
                        "target_lang_word": "Unrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                        "entry_id": "78a2106d-31d9-3a3e-868e-a9337ce7b249",
                                        "glosses": [
                                            "Verletzung des Rechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508cb045-2404-427b-a605-c3f8591f3cff",
                                                "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                                "text": "Er kann Recht nicht von Unrecht unterscheiden."
                                            },
                                            {
                                                "example_id": "9103350a-0740-4e56-a5b9-8550915ce41a",
                                                "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                                "text": "Ihr widerfuhr himmelschreiendes Unrecht."
                                            },
                                            {
                                                "example_id": "ebad81f9-8678-4ee2-877d-4076ddf40527",
                                                "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                                "text": "„Mit dem Fall der Mauer wurde dieses Unrecht über Nacht beendet.“"
                                            },
                                            {
                                                "example_id": "c1f39529-9ee0-40fd-b4e3-88ef56b9a8a4",
                                                "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                                "text": "„Ich habe vielen Menschen Unrecht getan.“"
                                            },
                                            {
                                                "example_id": "68e2a7c9-fa38-4c20-a83d-c3c027cb4f31",
                                                "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                                "text": "„In der heutigen russischen Literatur gibt es vom Gymnasiasten bis zum gelehrten Historiker keinen Menschen, der nicht sein Steinchen auf Alexander wegen alles in dieser Periode seiner Regierung getanen Unrechts würfe.“"
                                            },
                                            {
                                                "example_id": "09097b22-d046-46a0-aa95-7f6e62e2d712",
                                                "sense_id": "0b2d0997-fab8-3b12-bfba-a0f640304a51",
                                                "text": "„Er saß still da und atmete ruhig und spürte die unpersönliche, tröstliche Wärme, die weder Recht noch Unrecht kannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64553f35-5028-4f2d-b6f8-ffcd1aebbf9d",
                        "source_entry_id": "73015b04-06d5-3071-a948-904674d73b9f",
                        "source_sense_id": "7199be49-d88b-351d-b3d0-5b175690c9c7",
                        "target_lang_word": "injustice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injustice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873cf038-f02a-3ebb-a8fa-b0687ba06af9",
                                        "entry_id": "42cb7e5e-e2da-347c-af14-5f426d617843",
                                        "glosses": [
                                            "Absence of justice; unjustice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52f58547-56b1-32fe-bc98-85bb46637c55",
                                        "entry_id": "42cb7e5e-e2da-347c-af14-5f426d617843",
                                        "glosses": [
                                            "Violation of the rights of another person or people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "951d5303-af10-402c-a0f2-bcc3511c9a15",
                                                "sense_id": "52f58547-56b1-32fe-bc98-85bb46637c55",
                                                "text": "Silence in the face of gross injustice, or support for it, or even active involvement therein, comes at a price."
                                            },
                                            {
                                                "example_id": "f1258f0a-673d-4799-8a1b-5fc29ffab58e",
                                                "sense_id": "52f58547-56b1-32fe-bc98-85bb46637c55",
                                                "text": "I was not just the President of Southern Americans or white Americans. I was the President of all Americans. I believed that a huge injustice had been perpetrated for hundreds of years on every black man, woman, and child in the United States. I did not think that our nation could endure much longer as a viable democracy if that injustice were allowed to continue."
                                            },
                                            {
                                                "example_id": "7cb66ecd-cfed-4269-bdd1-cc8062ab05f3",
                                                "sense_id": "52f58547-56b1-32fe-bc98-85bb46637c55",
                                                "text": "The movie delivers a critical and analytical 'unfolding of the circumstances of Reality [Winner]’s life, starting with her childhood in Texas, in order to reveal her sense of deceptions and injustices that pass largely unchallenged in everyday American life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cce5ccc-a10d-3372-9d2b-1d73cd607183",
                                        "entry_id": "42cb7e5e-e2da-347c-af14-5f426d617843",
                                        "glosses": [
                                            "Unfairness; the state of not being fair or just."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b212935-3213-47d9-a7a5-ac75803a2808",
                                                "sense_id": "3cce5ccc-a10d-3372-9d2b-1d73cd607183",
                                                "text": "The game was engulfed in controversy when Rodwell appeared to win the ball cleanly in a midfield challenge with Suarez. The tackle drew an angry response from Liverpool's players- Lucas in particular as Suarez writhed in agony - but it was an obvious injustice when the England Under-21 midfielder was shown the red card."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd9f45aa-0323-4786-8114-312e2da8b93d",
                        "source_entry_id": "73015b04-06d5-3071-a948-904674d73b9f",
                        "source_sense_id": "7199be49-d88b-351d-b3d0-5b175690c9c7",
                        "target_lang_word": "injustice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injustice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e71586-1a35-3e6b-a8fc-83dac3d66183",
                                        "entry_id": "91da3077-2f15-39d4-82c6-ddfb97ea681b",
                                        "glosses": [
                                            "Manque de justice ou d’équité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bcdc02c-bbef-4c00-a5bc-c6c09f8b60da",
                                                "sense_id": "d5e71586-1a35-3e6b-a8fc-83dac3d66183",
                                                "text": "Aussi l’injustice est-elle le défaut capital des natures féminines. Cela vient du peu de bon sens et de réflexion que nous avons signalé, […]."
                                            },
                                            {
                                                "example_id": "6d8ba8f9-530f-4bbd-b02b-2f8acc50aab1",
                                                "sense_id": "d5e71586-1a35-3e6b-a8fc-83dac3d66183",
                                                "text": "Il venait de songer, comme à un aspect spécial de l’injustice irrationnelle du destin, que ces deux hommes vivaient, alors que Kurt était mort."
                                            },
                                            {
                                                "example_id": "0e48a70b-7157-4372-bdfe-5afa5b92a8f6",
                                                "sense_id": "d5e71586-1a35-3e6b-a8fc-83dac3d66183",
                                                "text": "Son procédé est plein d’injustice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e51be2a7-87d4-3c1b-b4b4-02b3e21f9cef",
                                        "entry_id": "91da3077-2f15-39d4-82c6-ddfb97ea681b",
                                        "glosses": [
                                            "Situation contraire à la justice, à l'équité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ea311a-3f12-423f-9ceb-1d83ddb85e05",
                                                "sense_id": "e51be2a7-87d4-3c1b-b4b4-02b3e21f9cef",
                                                "text": "La richesse ne fait pas le bonheur; c'est un dicton qui court et que répètent volontiers les pauvres diables, pour se consoler des injustices de la fortune."
                                            },
                                            {
                                                "example_id": "4197c132-5948-46e2-ba1e-7e81977b70f7",
                                                "sense_id": "e51be2a7-87d4-3c1b-b4b4-02b3e21f9cef",
                                                "text": "Comme mon guide me conduit à la buanderie commune, une rougeaude aux manches retroussées l'interpelle, élève la voix, dénonce des injustices."
                                            },
                                            {
                                                "example_id": "3ebd306d-9f5e-4aff-830f-8afc7a4022d8",
                                                "sense_id": "e51be2a7-87d4-3c1b-b4b4-02b3e21f9cef",
                                                "text": "— Il est étrange que pour nos chrétiens les prétendus désordres de la chair constituent le mal par excellence, dit méditativement Zénon. Personne ne punit avec rage et dégoût la brutalité, la sauvagerie, la barbarie, l’injustice. Nul demain ne s’avisera de trouver obscènes les bonnes gens qui viendront regarder mes tressautements dans les flammes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e8a921-cc0b-36c7-bb1a-6a1e07bfd69e",
                                        "entry_id": "91da3077-2f15-39d4-82c6-ddfb97ea681b",
                                        "glosses": [
                                            "Acte contraire à la justice, à l'équité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18952b94-bf9d-41dc-a101-695c7a9c2465",
                                                "sense_id": "d8e8a921-cc0b-36c7-bb1a-6a1e07bfd69e",
                                                "text": "Toutes les fois qu'un Indien peau-rouge n'a pas été froissé par l’injustice, l’accueil qu'il fait à son frère blanc est un exemple touchant de cette hospitalité qu'on ne rencontre que chez les peuples sauvages."
                                            },
                                            {
                                                "example_id": "d635081c-5d32-4bf0-ac95-f7b0fd8576e4",
                                                "sense_id": "d8e8a921-cc0b-36c7-bb1a-6a1e07bfd69e",
                                                "text": "La cause de ces insurrections est presque toujours la même : les exactions, les extorsions et mille autres injustices commises par les caïds (gouverneurs) qui, ayant acheté leur poste, ne songent qu'à rentrer dans leurs fonds et à s'enrichir aux dépens de leurs administrés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5630dff-d952-4723-bea4-b2033329cf39",
                        "source_entry_id": "73015b04-06d5-3071-a948-904674d73b9f",
                        "source_sense_id": "7199be49-d88b-351d-b3d0-5b175690c9c7",
