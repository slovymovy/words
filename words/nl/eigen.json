                                "target_lang_sense_clarification": "not for public use or shared"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "собственный",
                                "target_lang_sense_clarification": "принадлежащий лично кому-либо"
                            },
                            {
                                "target_lang_word": "свой",
                                "target_lang_sense_clarification": "принадлежащий субъекту действия"
                            },
                            {
                                "target_lang_word": "личный",
                                "target_lang_sense_clarification": "касающийся отдельного лица"
