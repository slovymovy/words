                "senses": [
                    {
                        "sense_id": "f7862533-c435-3b12-b80b-956ffa24b482",
                        "entry_id": "09e4978e-dad0-3616-9ea7-20544919ab81",
                        "glosses": [
                            "Tätigkeit, Ort oder Gegenstand, Tier oder Mensch, an dem Ansteckung (Infektion) mit einer Infektionskrankheit erstmals geschieht"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ae671e97-8436-424f-9c7a-b8d065ff4319",
                                "sense_id": "f7862533-c435-3b12-b80b-956ffa24b482",
                                "text": "„Es ist natürlich unmöglich, alle als Infektionsquelle in Betracht kommenden Personen, die oft nur zufällig und nur einmal verkehrt haben, zu erfassen und auf ihren Gesundheitszustand zu untersuchen.“"
                            },
                            {
                                "example_id": "07e11cfd-faa9-4468-806c-a1c4cf79cf2c",
                                "sense_id": "f7862533-c435-3b12-b80b-956ffa24b482",
                                "text": "Barfußgehen in Dusch- und Umkleideräumen kann eine Infektionsquelle für Fußpilz darstellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
