                    {
                        "sense_id": "ee80efea-0c26-36ba-a50b-17ffaf092cef",
                        "entry_id": "023dfc87-2433-32ec-8ad1-d39efd6b0408",
                        "glosses": [
                            "schip dat gebruikt wordt voor het uitdiepen van waterwegen"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "51144c07-966c-454f-ae7c-6c2fbf0321d2",
                                "sense_id": "ee80efea-0c26-36ba-a50b-17ffaf092cef",
                                "text": "Of de Chinezen ook de Nederlandse schepen hebben laten verdwijnen, is niet duidelijk. De Indonesische marine had de bemanning van het Chinese baggerschip al eens gearresteerd."
                            },
                            {
                                "example_id": "eb7c3e46-5235-4457-80f9-22a2923c717c",
                                "sense_id": "ee80efea-0c26-36ba-a50b-17ffaf092cef",
                                "text": "De daad is inmiddels bij het woord gevoegd, want sinds twee weken is een Nederlands baggerschip bezig de haven uit te diepen."
                            }
                        ]
                    }
                ],
