                        "form": "goinfresse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc8cea02-98b9-38b2-9af8-6d031b5a3783",
                        "entry_id": "fe6128c6-a407-3229-9a43-f210599c2129",
                        "glosses": [
                            "Celui qui a l’habitude de manger gloutonnement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5b74dd25-65d4-4151-aaa1-e2cf008f2658",
                                "sense_id": "dc8cea02-98b9-38b2-9af8-6d031b5a3783",
                                "text": "Ces espèces de petits goinfres emplumés viennent de faire de moi leur plus mortel ennemi!"
                            },
                            {
                                "example_id": "3ebb3f12-8358-4c58-96b1-4b3e894d815e",
                                "sense_id": "dc8cea02-98b9-38b2-9af8-6d031b5a3783",
                                "text": "Et il n’y a pas que le homard qui fait les frais de ce goinfre dont la voracité n’a rien à envier à celle de nuées de sauterelles !"
                            },
                            {
                                "example_id": "ce02b01a-71fb-42d6-8243-aef2e2951e64",
                                "sense_id": "dc8cea02-98b9-38b2-9af8-6d031b5a3783",
                                "text": "C’est un goinfre."
                            }
                        ]
                    },
                    {
                        "sense_id": "864f182e-cf7a-3893-a1df-f7160068ee3d",
                        "entry_id": "fe6128c6-a407-3229-9a43-f210599c2129",
                        "glosses": [
                            "Parasite."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "585166d0-f8d9-4f0a-8a11-1e25da3c1e36",
                        "source_entry_id": "fe6128c6-a407-3229-9a43-f210599c2129",
                        "source_sense_id": "dc8cea02-98b9-38b2-9af8-6d031b5a3783",
                        "source_sense_description": "(Familier) Celui qui a l’habitude de manger gloutonnement.",
                        "target_lang_word": "glutton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glutton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b66c902d-af11-310e-be07-2c7abbf05575",
                                        "entry_id": "43d670b5-170e-31f9-9cdb-5690ce7ae223",
                                        "glosses": [
                                            "Gluttonous; greedy; gormandizing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81756650-c654-41ab-8742-738544129a4e",
                                                "sense_id": "b66c902d-af11-310e-be07-2c7abbf05575",
                                                "text": "A glutton monastery in former ages makes a hungry ministry in our days."
                                            },
                                            {
                                                "example_id": "1b98e51c-7ef3-41bc-8555-2b6e6ee0fde3",
                                                "sense_id": "b66c902d-af11-310e-be07-2c7abbf05575",
                                                "text": "So, so, thou common dog, didst thou disgorge\nThy glutton bosom of the royal Richard?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glutton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc215df2-814c-3812-8cd6-090ed9393392",
                                        "entry_id": "67651d71-bbfc-3a95-9dae-bbd5f4910507",
                                        "glosses": [
                                            "One who eats voraciously, obsessively, or to excess; a gormandizer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b46e99b-2ad4-49d9-982d-39e45502a974",
                                                "sense_id": "cc215df2-814c-3812-8cd6-090ed9393392",
                                                "text": "Such a glutton would eat until his belly hurts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cab413-18b8-3708-bd51-78bd807783ad",
                                        "entry_id": "67651d71-bbfc-3a95-9dae-bbd5f4910507",
                                        "glosses": [
                                            "One who consumes anything voraciously, obsessively, or to excess."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dceafdf-d226-43ef-892d-e0e48e2569ef",
                                                "sense_id": "03cab413-18b8-3708-bd51-78bd807783ad",
                                                "text": "\"Gluttons in murder, wanton to destroy.\""
                                            },
                                            {
                                                "example_id": "9e0c258a-0c59-459f-81dd-8a0f01eff157",
                                                "sense_id": "03cab413-18b8-3708-bd51-78bd807783ad",
                                                "text": "\"A good few indeed, my man,\" replied the captain. \"Yes, you may make away with a deal of money and be neither drunkard nor glutton.\""
                                            },
                                            {
                                                "example_id": "4d0e4523-285e-42c5-ac2a-b847dd7208cb",
                                                "sense_id": "03cab413-18b8-3708-bd51-78bd807783ad",
                                                "text": "Hope is a subtle glutton; / He feeds upon the fair;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5137901b-a8f3-3930-ad46-1434353ecada",
                                        "entry_id": "67651d71-bbfc-3a95-9dae-bbd5f4910507",
                                        "glosses": [
                                            "The wolverine, Gulo gulo."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5f8e94-eb35-43e4-874a-62287562ab35",
                                                "sense_id": "5137901b-a8f3-3930-ad46-1434353ecada",
                                                "text": "[A] civil establishment […] is the animal called a glutton, which falling from a tree (in which it generally conceals itself) upon some noble animal, immediately begins to tear it, and suck its blood […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3a3759-acf3-3657-9e07-27b3d6eaacb9",
                                        "entry_id": "67651d71-bbfc-3a95-9dae-bbd5f4910507",
                                        "glosses": [
                                            "A giant petrel."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glutton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e34e4844-4951-3ef0-b328-ced819891eb1",
                                        "entry_id": "0c7cdeca-7c0c-3ecd-a4ab-6f6597d665e7",
                                        "glosses": [
                                            "To glut; to satisfy (especially an appetite) by filling to capacity."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ef21aa1-7632-427b-be62-45e192e0359f",
                                                "sense_id": "e34e4844-4951-3ef0-b328-ced819891eb1",
                                                "text": "Glutton'd at last, return at home to pine."
                                            },
                                            {
                                                "example_id": "0a7559d3-f5af-446c-b307-2b6a89e9324a",
                                                "sense_id": "e34e4844-4951-3ef0-b328-ced819891eb1",
                                                "text": "In some cities their [local branches] have become gluttoned with success, and in their misguided overzealous ambition they are 'killing the goose that lays the golden egg.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb69c9b-ff8b-3b3c-ac77-ac57d08ca464",
                                        "entry_id": "0c7cdeca-7c0c-3ecd-a4ab-6f6597d665e7",
                                        "glosses": [
                                            "To glut; to eat voraciously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a806b72d-0971-485d-924e-98c3aa0263ed",
                                                "sense_id": "efb69c9b-ff8b-3b3c-ac77-ac57d08ca464",
                                                "text": "Whereon in Egypt gluttoning they fed."
                                            },
                                            {
                                                "example_id": "78121759-529c-4710-b346-ab0564317819",
                                                "sense_id": "efb69c9b-ff8b-3b3c-ac77-ac57d08ca464",
                                                "text": "Thus do I pine and surfeit day by day, / Or gluttoning on all, or all away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
