                "senses": [
                    {
                        "sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                        "entry_id": "28e69812-f23b-376c-8ea8-1ffac7a7ad80",
                        "glosses": [
                            "Kirchenschiff, das sich quer zum Hauptschiff befindet oder das Hauptschiff kreuzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461a8983-10ce-4e8b-b846-b5ec601ea1b7",
                                "sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                                "text": "„Erst einige Zeit später hätten die Christen begonnen, andere Kirchen zu bauen, Kirchen mit einem Altar in der Mitte und einer großen Kuppel darüber, oder Kirchen in Kreuzform mit einem großen Hauptschiff und einem Querschiff.“"
                            },
                            {
                                "example_id": "9d96c804-379c-49d4-8e21-0a2cf02fcfda",
                                "sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                                "text": "„Robert, der langsam in Richtung auf die Apsis durch die Leere des Längsraums geschritten war, sah sich unvermutet an der Stelle, wo ein breit ausladendes Querschiff die Raumanlage kreuzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e098fe0-859a-4860-aa6a-cbf4d79cd2d5",
                        "source_entry_id": "28e69812-f23b-376c-8ea8-1ffac7a7ad80",
                        "source_sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                        "source_sense_description": "Kirchenschiff, das sich quer zum Hauptschiff befindet oder das Hauptschiff kreuzt",
                        "target_lang_word": "transept",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transept",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                        "entry_id": "9b6b4238-efb6-3948-8558-cd08cb8607b6",
                                        "glosses": [
                                            "Partie transversale d’une église qui coupe à angle droit la nef. Elle donne ainsi à l’édifice religieux la forme d’une croix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb8d686-74f2-4c42-9e13-885ddd05c963",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "Cette église se compose d’une nef […], et d’un transept avec abside et chapelles, datant du commencement du XIVᵉ siècle."
                                            },
                                            {
                                                "example_id": "43596ba3-3741-41d1-943e-de6d97ade014",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "Au XIIIᵉ siècle, on éventra les murs latéraux du chœur, comme à Laffaux (Aisne), pour établir un transept voûté d’ogives."
                                            },
                                            {
                                                "example_id": "aff618a9-ef63-49e0-8a85-cd5d83aead85",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "À sa gauche et à sa droite, deux minuscules galeries dessinaient les bras de croix d’un petit transept."
                                            },
                                            {
                                                "example_id": "28a7b904-08ea-43e1-9d05-dc0b09661ee6",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "[…] ; la forme de l’église est celle de la basilique ancienne à croix latine, au transept visible seulement par les voûtes ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
