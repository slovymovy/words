                        "form": "die Dispute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                        "entry_id": "4502da3c-f293-3ff5-a47e-1ad776db0d51",
                        "glosses": [
                            "Gespräch oder (seltener schriftlicher) Gedankenaustausch zwischen zwei oder mehr Personen, mit dem Ziel, die jeweilige Gegenseite von den eigenen Argumenten zu überzeugen"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "2c4bf646-9b6e-48d6-a177-a890f2da3023",
                                "sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                                "text": "Der Baden-Badener Disput ist relativ populär."
                            },
                            {
                                "example_id": "f3c8bf07-7511-44de-994b-0d385a48a539",
                                "sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                                "text": "„Hier sollen kurz die Argumente in dem sich über den Aufsatz zwischen Schiller und Fichte entspannenden Disput beleuchtet werden.“"
                            },
                            {
                                "example_id": "a2c0cf81-2aa0-4762-b2e8-4c5863a53063",
                                "sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                                "text": "„In der Einleitung zu Reason and Rhetoric macht Skinner deutlich, dass sein Verhältnis zum Disput ein entscheidender Punkt für Hobbes' prinzipielle Absage an die Rhetorik gewesen ist.“"
                            },
                            {
                                "example_id": "f2eb75d0-17f6-48bf-bb75-d3769ff940ca",
                                "sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                                "text": "„Zwischen dem Vorarbeiter und Lucie entwickelte sich ein heftiger Disput um einen Scheck.“"
                            },
                            {
                                "example_id": "d22b1234-8653-46fe-8028-3a3797f2fb4d",
                                "sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                                "text": "„Wallace hatte derweil keine Ahnung von diesem ganzen Disput.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3e645e0-29c1-408d-a106-84fe8d663fa7",
                        "source_entry_id": "4502da3c-f293-3ff5-a47e-1ad776db0d51",
                        "source_sense_id": "ee8e49a8-0192-3efc-a414-97189f0aff7a",
                        "source_sense_description": "Gespräch oder Gedankenaustausch zwischen zwei oder mehr Personen",
                        "target_lang_word": "dispute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dispute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f870b4fb-daff-3383-80e6-8898140c6929",
                                        "entry_id": "55143ab6-2afe-324c-a600-8753f9afe143",
                                        "glosses": [
                                            "An argument or disagreement, a failure to agree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac48592-962a-4a31-a2fb-e746cc613162",
                                                "sense_id": "f870b4fb-daff-3383-80e6-8898140c6929",
                                                "text": "A \"who-does-what\" labour dispute at Swindon works during April led to a stoppage of work on the construction of the new 0-6-0 Type 1 diesel-hydraulic locomotives of the D9500 series and work had not been resumed as we closed for press."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2697075-8d6a-3675-a1d2-d5d84c2c2b6d",
                                        "entry_id": "55143ab6-2afe-324c-a600-8753f9afe143",
                                        "glosses": [
                                            "Verbal controversy or disagreement; altercation; debate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4057ab8-0d77-4f1e-86c9-dcb987cbefa5",
                                                "sense_id": "f2697075-8d6a-3675-a1d2-d5d84c2c2b6d",
                                                "text": "Addicted more / To contemplation and profound dispute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dispute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19eabe30-4e1b-3304-8bd1-ebe742b57877",
                                        "entry_id": "9e60f1b4-04ee-3e07-9db0-9619ac83836f",
                                        "glosses": [
                                            "to contend in argument; to argue against something maintained, upheld, or claimed, by another."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3520a458-e889-40b4-aa57-42ea887fe2b8",
                                                "sense_id": "19eabe30-4e1b-3304-8bd1-ebe742b57877",
                                                "text": "\"Now, though thy thoughts are green and tender, as becometh one so young, yet are they those of a thinking brain, and in truth thou dost bring back to my mind certain of those old philosophers with whom in days bygone I have disputed at Athens, and at Becca in Arabia, for thou hast the same crabbed air and dusty look, as though thou hadst passed thy days in reading ill-writ Greek, and been stained dark with the grime of manuscripts.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f83c5e6e-f584-3681-abfb-f7a210e24da5",
                                        "entry_id": "9e60f1b4-04ee-3e07-9db0-9619ac83836f",
                                        "glosses": [
                                            "to make a subject of disputation; to argue pro and con; to discuss"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746084a6-f9cd-4d4d-b233-8c532627fdd8",
                                                "sense_id": "f83c5e6e-f584-3681-abfb-f7a210e24da5",
                                                "text": "Some residents disputed the proposal, saying it was based more on emotion than fact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f9ae66a-3181-3a23-bcb6-3e70faf32b30",
                                        "entry_id": "9e60f1b4-04ee-3e07-9db0-9619ac83836f",
                                        "glosses": [
                                            "to oppose by argument or assertion; to controvert; to express dissent or opposition to; to call in question; to deny the truth or validity of"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a455e0c-5fc4-40db-abac-2697897028a9",
                                                "sense_id": "0f9ae66a-3181-3a23-bcb6-3e70faf32b30",
                                                "text": "to dispute assertions or arguments"
                                            },
                                            {
                                                "example_id": "00bf7e95-6ea3-4ea7-8824-c573b80ba393",
                                                "sense_id": "0f9ae66a-3181-3a23-bcb6-3e70faf32b30",
                                                "text": "to seize goods under the disputed authority of writs of assistance"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d76cab59-24b7-3afb-9a32-7875aa25390e",
                                        "entry_id": "9e60f1b4-04ee-3e07-9db0-9619ac83836f",
