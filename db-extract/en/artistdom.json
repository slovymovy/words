                        "glosses": [
                            "The class or estate of artists."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2a1b6a-4200-4fbf-9e98-2ff2437af250",
                                "sense_id": "e965790a-169a-3c26-9152-52cff35607f7",
                                "text": "Since then I have learned there is no royal road to artistdom."
                            },
                            {
                                "example_id": "9f36bc94-f8c7-4ebf-a886-90d78dfa0dc1",
                                "sense_id": "e965790a-169a-3c26-9152-52cff35607f7",
                                "text": "To claim his artistdom and his individuality Baldwin eventually fled the racially divided United States, as several other Black artists did. Many of the true artists' art suffered when they were part of the \"Black\" group, instead of being seen as an individual: as an artist, as opposed to the Black artist."
                            },
                            {
                                "example_id": "7c39bd71-a3c1-4ba1-8a22-03f1918f5724",
                                "sense_id": "e965790a-169a-3c26-9152-52cff35607f7",
                                "text": "[...] it is hardly surprising that this vision of a mode of governance aiming to surpass even the classical Athenian polis model has been largely forgotten — or, at most, vaguely glimpsed through intervening practices largely relegated to artistdoms (Kunstlertum, artistisme), bohemias, and countercultures."
                            }
                        ]
                    }
