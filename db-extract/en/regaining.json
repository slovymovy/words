                        "examples": [
                            {
                                "example_id": "21fffeaf-c8ea-44ef-abd8-5a0445367ab7",
                                "sense_id": "b398b4ef-cf6d-3bcf-b632-d36f35b2aa4b",
                                "text": "We conceive that an alternation of such losings and regainings will continue to be presented in England, until the whole business is set on a new and more stable basis by a revolution which shall not be moral only."
                            },
                            {
                                "example_id": "a0605596-c70e-4b19-ba97-b7f85f61ccda",
                                "sense_id": "b398b4ef-cf6d-3bcf-b632-d36f35b2aa4b",
                                "text": "The left knee is placed as far back and as near the median line as possible; the spine is strongly bent to the right. The creeping consists of forward locomotion by a series of reversals and regainings of the position described."
                            }
                        ]
                    }
