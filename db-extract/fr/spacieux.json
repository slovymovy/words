                                                "sense_id": "972ff44d-0d4c-3657-82c8-2623517c25b1",
                                                "text": "Das Haus war, für den mittelmäßigen Ort geräumig, geschmackvoll verziert und glänzend erleuchtet."
                                            },
                                            {
                                                "example_id": "da3767d9-8c71-4e5a-aba6-86a5512f1d1c",
                                                "sense_id": "972ff44d-0d4c-3657-82c8-2623517c25b1",
                                                "text": "Ich besaß ein fabelhaftes Bett und das Wunder eines Diwans, geräumig, mit weichen, kosenden, indischen Decken belegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
