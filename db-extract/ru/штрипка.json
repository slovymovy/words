                "senses": [
                    {
                        "sense_id": "666da36f-6d3b-3bf8-92d3-a4265e5c2c30",
                        "entry_id": "cbf9dadb-24de-3075-bd27-56eecd73c3e3",
                        "glosses": [
                            "тесьма, пришитая снизу к штанине брюк, к гетре и т. п., проходящая под ступней и оттягивающая вниз край штанины, гетры и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7256ec2f-b70f-47f5-93ac-f7ab6cb57b47",
                                "sense_id": "666da36f-6d3b-3bf8-92d3-a4265e5c2c30",
                                "text": "Сапоги, панталоны и весь левый бок его были совершенно в грязи, штрипка на правой ноге оторвана, а фрак даже разорван во многих местах."
                            },
                            {
                                "example_id": "3038b05f-bf82-4908-9b23-03361e24cf74",
                                "sense_id": "666da36f-6d3b-3bf8-92d3-a4265e5c2c30",
                                "text": "Она решительно подошла, стала на колени и из-под одеяла за штрипки вытащила рейтузы и унесла."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6df28bcf-267b-4018-be5b-6e3d66e1362e",
                        "source_entry_id": "cbf9dadb-24de-3075-bd27-56eecd73c3e3",
                        "source_sense_id": "666da36f-6d3b-3bf8-92d3-a4265e5c2c30",
                        "target_lang_word": "Strippe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "980e212f-54b5-3452-97c2-7a632fc6f0be",
                                        "entry_id": "fd74e4cc-c3ca-3e1d-96d7-4983faf31e07",
                                        "glosses": [
                                            "ein Stück Seil oder Schnur"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dadcd5e0-715d-4a44-ad7b-e162736226ef",
                                                "sense_id": "980e212f-54b5-3452-97c2-7a632fc6f0be",
                                                "text": "„Danach wird das freie Ende der Strippe zurückgebogen und in den Kanal des Plombenkörpers eingeführt, wo sich Verfangorgane der Strippe irreversibel in den Sperrorganen im Plombenkörper verfangen, sodass ein Oeffnen des in dieser Weise plombierten Verschlusses nur unter Zerstörung der Plombe erfolgen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd8101bd-171b-3923-a18f-cc0308d4c186",
                                        "entry_id": "fd74e4cc-c3ca-3e1d-96d7-4983faf31e07",
                                        "glosses": [
                                            "Leitungsdraht, besonders des Telefons"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b636c07-97b1-44d0-b7e8-a8de61b1334f",
                                                "sense_id": "dd8101bd-171b-3923-a18f-cc0308d4c186",
                                                "text": "Inge hängt dauernd an der Strippe. Unsere Telefonrechnung ist immens hoch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
