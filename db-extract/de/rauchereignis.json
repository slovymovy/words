                "senses": [
                    {
                        "sense_id": "173a0e99-384b-3531-865f-955dd1dc069c",
                        "entry_id": "4b7c733e-7f5a-3620-a770-70d7e12491f4",
                        "glosses": [
                            "meist bedeutsames Geschehen oder Erlebnis im Zusammenhang mit Rauch"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "d81b65a6-85f6-469f-b3b4-f1ebe23fd917",
                                "sense_id": "173a0e99-384b-3531-865f-955dd1dc069c",
                                "text": "„Die Null-Sicht beschreibt das Rauchereignis eines Schadenfeuers, wodurch die Rauchkonzentration so hoch ist, dass man nichts sieht, daher \"Null-Sicht\" vergleichbar mit \"Keine-Sicht\".“"
                            },
                            {
                                "example_id": "15236c56-5846-4a6a-8487-8f9a2bff7d0d",
                                "sense_id": "173a0e99-384b-3531-865f-955dd1dc069c",
                                "text": "„Wie viele dieser Rauchereignisse enthalten wirklich Öldampf und somit TCP?“"
                            },
                            {
                                "example_id": "6571e3b7-3152-4ba5-89a0-d701417df02a",
                                "sense_id": "173a0e99-384b-3531-865f-955dd1dc069c",
                                "text": "„In Stufe 1 wird ein Rauchereignis über die Brandmeldeanlage detektiert und eine Alarmierung findet statt.“"
                            },
                            {
                                "example_id": "9a3d35c9-aa43-4579-96bd-87abb819ee5e",
                                "sense_id": "173a0e99-384b-3531-865f-955dd1dc069c",
                                "text": "„Dazu wurde ein Rauchereignis simuliert (der Versuchsaufbau sieht einen Gasbrenner zur Erhitzung des Rauchs sowie Nebelmaschinen vor).“"
                            },
                            {
                                "example_id": "7ddfec07-09b6-42d7-a32f-20891b4060db",
                                "sense_id": "173a0e99-384b-3531-865f-955dd1dc069c",
                                "text": "„Das heißt, registriert einer der fast 2000 Brandmelder ein Feuer- oder Rauchereignis, rückt automatisch auch die Kritzendorfer Ortsfeuerwehr in die Klinik aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
