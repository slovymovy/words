                        "examples": [
                            {
                                "example_id": "1d4ca371-ce7f-414e-8dc6-8f403cf64da5",
                                "sense_id": "db980c31-1647-3ba3-b1d7-2d55a7f36ab2",
                                "text": "„Thomas Behringer war ein Erotiker, der sich locker und schnell in die Betten plauderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0aca9629-cc36-3257-be24-0415237488ad",
                        "entry_id": "04edd06c-4051-3a72-8982-734b44a35812",
