                                            {
                                                "example_id": "c400c84c-0e39-4113-8cb3-d7567d5ef9a0",
                                                "sense_id": "46fae6c9-8f60-3619-8115-55662a9f2399",
                                                "text": "Did I actually back a winner and finish in front on the punt?"
                                            },
                                            {
                                                "example_id": "191d4d06-8421-4af9-ba8e-fc17851ead2e",
                                                "sense_id": "46fae6c9-8f60-3619-8115-55662a9f2399",
                                                "text": "Wishing you all happy new year and a prosperous one on the punt."
                                            }
                                        ]
