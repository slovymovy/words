                    }
                ],
                "senses": [
                    {
                        "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                        "entry_id": "1969883a-03ad-3ff0-817f-dd3d002cbb30",
                        "glosses": [
                            "Maßnahme gegen nachhaltige Veränderungen des Klimas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19664c0e-efed-45b3-9674-7be9401f4aa9",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "Ist es wirklich sinnvoll, für den Klimaschutz Atomkraftwerke zu betreiben?"
                            },
                            {
                                "example_id": "98993c33-c9d0-4261-b233-3cf0cf507e8b",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "Der Klimaschutz ist ohne die Vernunft der Verbraucher nicht umzusetzen."
                            },
                            {
                                "example_id": "a078c61e-a246-4a23-8237-f2058fb7101c",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "„»Vom Klimaschutz aus wissenschaftlicher Sicht kann überhaupt keine Rede sein.«“"
                            },
                            {
                                "example_id": "ddce0869-ded5-4977-87de-7dbe7d3c883a",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "[Im Frühjahr 2021] „erklärte das Bundesverfassungsgericht den Klimaschutz zum Staatsziel“ […]."
                            },
                            {
                                "example_id": "a32e953a-5463-41b7-9eb3-590fb4853ead",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "„Klimaschutz war lange ein Thema der Außenseiter, der ewigen Warner.“"
                            },
                            {
                                "example_id": "c12a974b-6796-4956-9454-8040381e373a",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "„Wenn wir jetzt unsere fossile Abhängigkeit von Putin mit einer Art Schocktherapie lösen würden, werde das den Klimaschutz auf mittlere Sicht eher beschleunigen.““"
                            },
                            {
                                "example_id": "a734277a-8341-4919-9e97-8310031dd8f2",
                                "sense_id": "d828dbc7-fd9d-3899-a583-f74f28316c00",
                                "text": "„Klimaschutz ist das medial stärkste Thema, daher fließt dort auch das meiste Geld hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
