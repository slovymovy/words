                    {
                        "translation_id": "cb40b6b9-aabc-42f4-955f-47eb61d50650",
                        "source_entry_id": "045df505-d32d-365e-b2eb-9e9c6f2ab58e",
                        "source_sense_id": "8d6d68f9-b52b-3aa3-84a4-5e1ad34854ff",
                        "source_sense_description": "een lid van een uitgestorven groep van reptielen, waartoe de grootste landdieren behoren die ooit bestaan hebben",
                        "target_lang_word": "dinosaure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dinosaure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d85b83ca-7fc4-34a0-8c51-f2f772b2f919",
                                        "entry_id": "13dc4434-dd5c-3706-b0bc-fc2848246f32",
                                        "glosses": [
                                            "Membre d'un super-ordre d’archosaures qui a connu son apogée durant le Mésozoïque (ou ère secondaire), dont les représentants actuels sont les oiseaux et comprenant tous les descendants du plus récent ancêtre commun du tricératops et des oiseaux modernes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257f5d2d-29a2-4a05-a121-4c38841fc893",
                                                "sense_id": "d85b83ca-7fc4-34a0-8c51-f2f772b2f919",
                                                "text": "Aux côtés des nombreux restes de poissons littoraux, les tétrapodes sont représentés par des chéloniens, crocodiliens, ophidiens, plésiosaures, ptérosaures et dinosaures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641fb4d9-d249-38b1-a118-117a4e9f8ae2",
                                        "entry_id": "13dc4434-dd5c-3706-b0bc-fc2848246f32",
                                        "glosses": [
                                            "Personne en place depuis très longtemps."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc2862b3-a401-405d-b0e5-70e383510d32",
                                                "sense_id": "641fb4d9-d249-38b1-a118-117a4e9f8ae2",
                                                "text": "Dans la famille des dinosaures français du rock, on pourra toujours préférer le caractère intello cinéphile d’Eddy Mitchell ou la mèche du crooner de proximité Dick Rivers."
                                            },
                                            {
                                                "example_id": "bbd7e6db-2db8-4181-99c9-f6d1cdedaf04",
                                                "sense_id": "641fb4d9-d249-38b1-a118-117a4e9f8ae2",
                                                "text": "Notre chef de service est un dinosaure : il est là depuis la création de l’entreprise."
                                            },
                                            {
                                                "example_id": "b4ebe5b6-fb7e-430c-bdcf-f07f6f4a4260",
                                                "sense_id": "641fb4d9-d249-38b1-a118-117a4e9f8ae2",
                                                "text": "Les éléphants et les dinosaures du parti."
                                            },
                                            {
                                                "example_id": "08266c33-c76f-45ab-877d-de3e92808348",
                                                "sense_id": "641fb4d9-d249-38b1-a118-117a4e9f8ae2",
                                                "text": "Paul McCartney, dinosaure du rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd2fa39b-6aa7-3698-92ed-98293fd2b315",
                                        "entry_id": "13dc4434-dd5c-3706-b0bc-fc2848246f32",
                                        "glosses": [
                                            "Individu ou entreprise autrefois influent dépassé par la modernité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311bff1f-26e2-4806-89e0-575c5837cc84",
                                                "sense_id": "cd2fa39b-6aa7-3698-92ed-98293fd2b315",
                                                "text": "Je ne suis pas un dinosaure."
                                            },
                                            {
                                                "example_id": "bb9f0345-881f-43c1-9efc-859cb5823ec3",
                                                "sense_id": "cd2fa39b-6aa7-3698-92ed-98293fd2b315",
                                                "text": "[Titre] En Afrique du Sud, l’industrie minière est un « dinosaure en voie d’extinction »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5906b4-7791-3414-ae3b-e8de23bb2cea",
                                        "entry_id": "13dc4434-dd5c-3706-b0bc-fc2848246f32",
                                        "glosses": [
                                            "Appareil déjà très ancien en regard du monde moderne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f042ead7-d158-41b5-be1d-92ba6432a468",
                                                "sense_id": "8c5906b4-7791-3414-ae3b-e8de23bb2cea",
                                                "text": "Ton ordi, c’est un dinosaure !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
