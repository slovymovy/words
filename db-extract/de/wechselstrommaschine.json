                "senses": [
                    {
                        "sense_id": "6405c7af-f05d-38ba-a844-2f8d4a76b650",
                        "entry_id": "f2446b49-8792-3533-8785-ffba0f16e241",
                        "glosses": [
                            "rotierende elektrische Maschine, die mit Wechselstrom betrieben wird (und somit als Motor arbeitet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6ebcf5-9e5f-4d84-a47d-4fcb809d0d8c",
                                "sense_id": "6405c7af-f05d-38ba-a844-2f8d4a76b650",
                                "text": "„Das Lehrbuch vermittelt die Grundlagen der Wechselstrommaschinen und ihrer Steuerschaltungen.“"
                            },
                            {
                                "example_id": "5b4216c5-5045-4cae-bf85-984236bec5b8",
                                "sense_id": "6405c7af-f05d-38ba-a844-2f8d4a76b650",
                                "text": "„Die Asynchronmaschine ist die Maschine der Zukunft! Besonders der frequenzumrichtergespeiste, wartungsarme Käfigläufermotor ersetzt in zunehmendem Maße die Gleichstrom- sowie die Wechselstrommaschine.“"
                            },
                            {
                                "example_id": "d7c10e4d-5e41-4ea0-bb2f-ba8674bf9f80",
                                "sense_id": "6405c7af-f05d-38ba-a844-2f8d4a76b650",
                                "text": "„Im Prinzip können alle Wechselstrommaschinen als Generator oder als Motor arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06a9d597-7dc0-3b8e-8245-cb7b8da0b5b7",
                        "entry_id": "f2446b49-8792-3533-8785-ffba0f16e241",
                        "glosses": [
                            "rotierende elektrische Maschine, die Wechselstrom erzeugt (und somit als Generator arbeitet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc433050-05f6-4127-b03d-aaf8a13c75f8",
                                "sense_id": "06a9d597-7dc0-3b8e-8245-cb7b8da0b5b7",
                                "text": "„Im Prinzip können alle Wechselstrommaschinen als Generator oder als Motor arbeiten.“"
                            },
                            {
                                "example_id": "5698738e-7b5d-40f0-bbd0-595eb81ab931",
                                "sense_id": "06a9d597-7dc0-3b8e-8245-cb7b8da0b5b7",
                                "text": "„Die Wechselstrommaschine hat die Funktion, die mechanische Energie des Antriebsaggregats in Wechselstrom zu wandeln.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
