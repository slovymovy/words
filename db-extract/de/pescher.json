                ],
                "senses": [
                    {
                        "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                        "entry_id": "202c6cfc-f371-3a43-a963-d58507be1eb0",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88303e1c-1357-4544-97e4-9dccf0558513",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Frau Pescher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f041aaaa-7dba-48c8-b455-79e9f88c6f62",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Herr Pescher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cd3a10eb-a956-4ee1-9d70-8f9955afeeb0",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Die Peschers kommen heute aus Hannover."
                            },
                            {
                                "example_id": "35911394-eb60-408a-853d-6b7a123e7fd5",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Der Pescher trägt nie die Schals, die die Pescher ihm strickt."
                            },
                            {
                                "example_id": "affef027-352e-41b1-b47e-9a11c4039de3",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pescher kommt, geht der Herr Pescher.“"
                            },
                            {
                                "example_id": "ecf59ddf-f296-4025-8591-285e45fe1ddc",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Pescher kommt und geht."
                            },
                            {
                                "example_id": "5e2b69a0-9b13-41b2-9403-ec59bf1b8451",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "Peschers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a98abeac-f6b2-464f-a294-8d2ae8e072e5",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "An verregneten Herbsttagen ist Familie Peschers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "83b99a44-a1c6-4b49-9dfa-2c4c1ebdfa1c",
                                "sense_id": "c7a61475-f16f-338e-8eb8-b68d3f5bdc08",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Pescher das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
