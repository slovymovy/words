                                "target_senses": [
                                    {
                                        "sense_id": "916149fa-64b7-3ef2-a4cb-558e1e42e2fa",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "Someone who shoots something; a gunner, archer, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "722007f0-4df1-482a-a419-6d9043546318",
                                                "sense_id": "916149fa-64b7-3ef2-a4cb-558e1e42e2fa",
                                                "text": "The shooter put a bullet clean through her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1be3ead5-164a-38eb-89ab-de9eb7063bf4",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "The player throwing the dice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95a7f180-20ea-4149-b711-2012f2450ed6",
                                                "sense_id": "1be3ead5-164a-38eb-89ab-de9eb7063bf4",
                                                "text": "Craps involves someone rolling the dice (a shooter) and additional bettors. The game works like this: The first roll is called a come out roll. There are three conditions: 1. If the dice total is 7 or 11, the shooter wins. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd962e6-c414-3b92-86b2-a330c420bed3",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "A device for shooting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2430974f-90a3-3459-89c7-938f41071379",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "A firearm."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3babd2-9ba4-43f9-9e6d-985377e55643",
                                                "sense_id": "2430974f-90a3-3459-89c7-938f41071379",
                                                "text": "Now all we need to establish is what a shooter belonging to one of Maitland's goons is doing in a polisman's locker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8707bb57-150c-3b2d-aa69-7c06c47d01c0",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "An associate willing to act in one's defence or to act against one's enemies, especially by force."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb55da8d-51c2-3f08-bdd7-3ad154477809",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "A loyal advocate or fan."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecc97b69-9b3d-3be6-9d85-91eb10b83608",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "A video game in which shooting enemies (or targets) is the main objective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e272b7bc-be50-40a2-8bec-ca295dd810bc",
                                                "sense_id": "ecc97b69-9b3d-3be6-9d85-91eb10b83608",
                                                "text": "I love shooters, RPGs, and pretty much anything with free-roam or gore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63f1113-75b1-3160-8a95-2f1d1fbaed9d",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "A professional wrestler who uses actual fighting moves as part of his style, or who speaks his mind during a live or televised event (instead of speaking from a script)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f885766-4934-36e7-8b35-fdc10e651bef",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "A large marble used for knocking smaller marbles out of a chalk circle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87a5d2f-0401-4626-8a82-a4dd6c151b8f",
                                                "sense_id": "7f885766-4934-36e7-8b35-fdc10e651bef",
                                                "text": "You separate the marbles by color until you have four groups, but then you notice that some of the marbles are regulars, some are shooters, and some are peewees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b776d89f-b558-3063-ac8b-d57810db87e7",
                                        "entry_id": "81b95639-4f59-3fb3-8a93-647d949d88c4",
                                        "glosses": [
                                            "An alcoholic beverage typically served in a shot glass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2844bfb8-2cd7-4cea-91e2-c5f81d8462c3",
                                                "sense_id": "b776d89f-b558-3063-ac8b-d57810db87e7",
                                                "text": "We drink tequila as a shooter, but prefer to sip gin slowly to appreciate the flavour."
                                            }
                                        ]
