                            },
                            {
                                "target_lang_word": "mastik çekmek",
                                "target_lang_sense_clarification": "boşlukları dolgu/sızdırmazlık malzemesiyle kapatmak"
                            },
                            {
                                "target_lang_word": "yalıtmak",
                                "target_lang_sense_clarification": "genel olarak sızdırmaz hâle getirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a3f61c6-8b7d-3874-8e8a-911226b22e16",
