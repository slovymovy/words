                                    {
                                        "sense_id": "c22a9ba4-d2a0-3bd9-937b-b8e4efa53862",
                                        "entry_id": "6e092a4a-38a7-3c23-b6b7-bb17b8074bf2",
                                        "glosses": [
                                            "To fill (one's mouth or cheeks) with food."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
