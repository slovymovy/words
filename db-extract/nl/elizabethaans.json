                "senses": [
                    {
                        "sense_id": "26015bb8-b60a-3fdd-89c7-a65b55aebfc0",
                        "entry_id": "27e7adb9-5c04-3e06-bc9c-f75735ba65e9",
                        "glosses": [
                            "volgens de Engelse stijl in cultuur en architectuur die opgang deed gedurende de regeringsperiode van Elizabeth I 1551 tot 1603"
                        ],
                        "tags": [],
