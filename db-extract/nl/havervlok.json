                        "examples": [
                            {
                                "example_id": "c0c57655-3460-48bc-9756-fd4dd5e768e1",
                                "sense_id": "00f977fe-b28b-30b4-90db-5c99ebf013c5",
                                "text": "Op een doordeweekse ochtend eet Vincent niet alleen pap van havervlokken, gegarneerd met sesampasta en geroosterde sesamolie, geroosterde zonnebloemzaden, jam en ingemaakte gember. Hij neemt ook een misosoepje, gefermenteerde groente en gestoomde paksoi met citroen. Bij dit alles drinkt hij lever- en galthee en eet hij die zoutzure pruim. Eigenlijk gewoon macrobiotische tapas."
                            },
                            {
                                "example_id": "7241df86-8b7c-440e-93e9-3a560a373fec",
                                "sense_id": "00f977fe-b28b-30b4-90db-5c99ebf013c5",
                                "text": "Roer de havervlokken, het gedroogde fruit en driekwart van de zaden goed door het botermengsel tot alles goed vermengd is."
                            }
                        ]
                    }
