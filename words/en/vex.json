                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm winds <w>vex</w> the surface of the dark ocean.",
                            "target_lang_translations": {
                                "ru": "Штормовые ветры <w>волнуют</w> поверхность темного океана.",
                                "tr": "Fırtına rüzgârları karanlık okyanusun yüzeyini <w>çalkalıyor</w>."
