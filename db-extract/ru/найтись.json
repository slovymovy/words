                        "examples": [
                            {
                                "example_id": "b5c2d6eb-aac4-42b5-806e-f8e326548049",
                                "sense_id": "e8cbf0d2-68c5-32b9-b729-6873870bc202",
                                "text": "Наконе́ц-то нашла́сь моя́ кни́га. Она́ была́ у меня́ под крова́тью.",
                                "translation": "Finally, my book was found. It was under my bed.",
                                "english": "Finally, my book was found. It was under my bed."
                            }
                        ]
                    }
