                "senses": [
                    {
                        "sense_id": "578f1286-1055-3684-ac56-20386418b1f0",
                        "entry_id": "95b5acf9-64b9-341c-857b-b657c575c4c6",
                        "glosses": [
                            "Celui qui dispense, qui distribue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8737aef1-6bb9-4409-90ff-0e24716f6447",
                                "sense_id": "578f1286-1055-3684-ac56-20386418b1f0",
                                "text": "Dieu, dit Rébecca, est le dispensateur de tout ; il peut mettre fin à la captivité de Juda, même en employant l’instrument le plus faible."
                            },
                            {
                                "example_id": "22d56a39-25fb-402b-9502-25a85396c112",
                                "sense_id": "578f1286-1055-3684-ac56-20386418b1f0",
                                "text": "Dehors, il y a le dieu Soleil. Je te salue Phœbus, dispensateur de vie et de lumière, toi, de qui nous vient toute Beauté; maître de la Forme, et des Couleurs."
                            },
                            {
                                "example_id": "1a189fff-0291-4f68-a154-9d9cd67cd798",
                                "sense_id": "578f1286-1055-3684-ac56-20386418b1f0",
                                "text": "De même, j’ignore si Mithridate ne serait pas lui-même le généreux dispensateur de ces cadeaux en nature et en espèces."
                            }
                        ]
                    }
                ],
                "translations": [
