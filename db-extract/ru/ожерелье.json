                ],
                "senses": [
                    {
                        "sense_id": "99ddddd5-fb62-3766-8741-90d99510cf09",
                        "entry_id": "c45fda1d-9023-36f8-ac02-f8680b2b0f0f",
                        "glosses": [
                            "шейное украшение из драгоценных камней, жемчуга, монет и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb57257-1f41-4a24-952c-a24fba7e6d5c",
                                "sense_id": "99ddddd5-fb62-3766-8741-90d99510cf09",
                                "text": "Золотые серьги, жемчужное ожерелье и разные перстни и кольца довершали великолепие её наряда."
                            },
                            {
                                "example_id": "40bedfcd-be8b-4582-b86f-cb35cc8569b7",
                                "sense_id": "99ddddd5-fb62-3766-8741-90d99510cf09",
                                "text": ".. на ней не было никаких украшений, кроме красного ожерелья на шее и чёрного пояса с стальной пряжкою."
                            },
                            {
                                "example_id": "085028bb-ffad-4f90-8bd1-af6d9b2bc905",
                                "sense_id": "99ddddd5-fb62-3766-8741-90d99510cf09",
                                "text": ".. она сидела прямо, посматривая изредка то на свою полную красивую руку, .. то на ещё более красивую грудь, на которой она поправляла брильянтовое ожерелье .."
                            },
                            {
                                "example_id": "75dac398-484f-4cb3-b42e-e8ab0cb170b1",
                                "sense_id": "99ddddd5-fb62-3766-8741-90d99510cf09",
                                "text": "Она была в чёрном бархатном платье, по-модному длинном, почти до земли, и на открытой шее виднелось агатовое ожерелье — нарочно, чтобы подчеркнуть белизну прямой красивой шеи."
                            },
                            {
                                "example_id": "0d1b074f-18f8-485f-86c5-8a7d756faa36",
                                "sense_id": "99ddddd5-fb62-3766-8741-90d99510cf09",
                                "text": "Цыпа, впервые в жизни получившая подарок, тотчас надела ожерелье, и Гавана задумчиво отметила стройность и красивый изгиб её шеи."
                            }
                        ]
                    },
                    {
                        "sense_id": "a51a299e-751b-3773-8e77-f88604d99a17",
                        "entry_id": "c45fda1d-9023-36f8-ac02-f8680b2b0f0f",
                        "glosses": [
                            "перен. шейное оперение птиц"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d47e7a-f6b4-449a-a363-b61d170d8ba8",
                                "sense_id": "a51a299e-751b-3773-8e77-f88604d99a17",
                                "text": "Брюхо [гагары], от ног до самого хохла или ожерелья, покрыто белыми, мелкими, серебристыми перьями .."
                            },
                            {
                                "example_id": "badd9707-4172-45f2-95ae-374adbd55bee",
                                "sense_id": "a51a299e-751b-3773-8e77-f88604d99a17",
                                "text": "Старый красный петух и две курицы, подёргивая ожерельями и постукивая ногтями, расхаживали по полу и лавкам."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d65d6b84-4bea-4356-95aa-911e914b79ce",
                        "source_entry_id": "c45fda1d-9023-36f8-ac02-f8680b2b0f0f",
                        "source_sense_description": "шейное украшение из драгоценных камней, жемчуга, монет и т. п.",
                        "target_lang_word": "necklace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necklace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afbb5b5-dcaa-3f73-82e6-b5415ed9db87",
                                        "entry_id": "4e0dc6e2-0b9b-32eb-a0e4-30290d58bef7",
                                        "glosses": [
                                            "An article of jewelry that is worn around the neck, most often made of a string of precious metal, pearls, gems, beads or shells, and sometimes having a pendant attached."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a84ce647-69e6-32a2-8dca-2010910a0335",
                                        "entry_id": "4e0dc6e2-0b9b-32eb-a0e4-30290d58bef7",
                                        "glosses": [
                                            "Anything resembling a necklace in shape."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c7363b-f81c-4e87-989f-0415086cffa8",
                                                "sense_id": "a84ce647-69e6-32a2-8dca-2010910a0335",
                                                "text": "a necklace of coral islands"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56ae19a0-b27e-38a1-bfad-db6812963ace",
                                        "entry_id": "4e0dc6e2-0b9b-32eb-a0e4-30290d58bef7",
                                        "glosses": [
                                            "A device used in necklacing (an informal execution); a rubber tyre that is filled with petrol. It is placed around the victim's chest and arms, and set on fire."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33c4446-6b2b-4222-a866-610fdae40e62",
                                                "sense_id": "56ae19a0-b27e-38a1-bfad-db6812963ace",
                                                "text": "Necklacing on Wikipedia.Wikipedia"
                                            },
                                            {
                                                "example_id": "99adc864-2946-4826-b154-4a43384eeea0",
                                                "sense_id": "56ae19a0-b27e-38a1-bfad-db6812963ace",
                                                "text": "Seven people have been arrested in connection with Saturday's \"necklace\" murder of three men in the Tjokville informal settlement at Jeffrey's Bay."
                                            },
                                            {
                                                "example_id": "d73820fa-a293-4a61-88fe-e6c48c3b1e6d",
                                                "sense_id": "56ae19a0-b27e-38a1-bfad-db6812963ace",
                                                "text": "Several of the alledged witches in Apel and GaNkaone were also subjected to a necklace execution"
                                            },
                                            {
                                                "example_id": "7368cb50-9fa1-4b28-bb29-2c4423004931",
                                                "sense_id": "56ae19a0-b27e-38a1-bfad-db6812963ace",
                                                "text": "In the fluidly unfolding events of a necklace murder, was there time and space to stop the killing?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "necklace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7014ea9e-1ab3-39a6-8a51-a4a764743605",
                                        "entry_id": "9a9fdd73-b013-3b8b-ab72-26bf4a0e9bcf",
                                        "glosses": [
                                            "To informally execute by necklacing; by setting on fire a petrol-filled rubber tyre which has been put around the bound victim's neck."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4cff97b-3a60-4926-b79b-225d5b3dc730",
                                                "sense_id": "7014ea9e-1ab3-39a6-8a51-a4a764743605",
                                                "text": "Frustrated residents tied the hands of two suspected criminals, put tyres around their necks and then set them alight. In a manifestation of growing disillusionment with the criminal justice system, residents of Bramfischerville, west of Johannesburg, on Tuesday abducted and necklaced two suspected burglars."
                                            },
                                            {
                                                "example_id": "a01420cc-d26e-4096-933b-13db4a653220",
                                                "sense_id": "7014ea9e-1ab3-39a6-8a51-a4a764743605",
                                                "text": "2002 Buthelezi: A Biography by Ben Temkin\nInkatha members have been hacked to death and necklaced, and their houses have been destroyed"
                                            },
                                            {
                                                "example_id": "9f7b1213-15ec-4225-a6a1-170959c93e13",
                                                "sense_id": "7014ea9e-1ab3-39a6-8a51-a4a764743605",
                                                "text": "2000 Beyond Our Wildest Dreams: The United Democratic Front and the Transformation of South Africa by Ineke Van Kessel\nThe first instance of necklacing occurred in March 1985 in the Eastern Cape township of KwaNobuhle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10194ddf-fd52-46e0-b68f-a5781f2589b5",
                        "source_entry_id": "c45fda1d-9023-36f8-ac02-f8680b2b0f0f",
                        "source_sense_description": "шейное украшение из драгоценных камней, жемчуга, монет и т. п.",
                        "target_lang_word": "Halskette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halskette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b742ba9-e960-3ea8-b7ba-bd38159ec95c",
                                        "entry_id": "ff60b2b3-512c-36af-bf05-edebed9fea75",
                                        "glosses": [
                                            "Schmuckstück, das um den Hals getragen wird und in der Regel ein kunsthandwerkliches Produkt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf01c16-52c0-4337-97ee-305a228fbe43",
                                                "sense_id": "6b742ba9-e960-3ea8-b7ba-bd38159ec95c",
                                                "text": "In Kombination mit der silbernen Halskette und den mit Perlen und Korallen verzierten Silberohrringen ist die schöne Festkönigin auch eine Huldigung an die ruhmreiche Vergangenheit der Hafenstadt, die einst zu den reichsten Städten Europas gehörte."
                                            },
                                            {
                                                "example_id": "66ea3b67-1831-4cbd-8cba-bdc63af540f2",
                                                "sense_id": "6b742ba9-e960-3ea8-b7ba-bd38159ec95c",
                                                "text": "Aber wer kauft überhaupt Halsketten mit original Mauerkrümeln?"
                                            },
                                            {
                                                "example_id": "bc213a95-918f-4f36-9be3-611c31eabaaf",
                                                "sense_id": "6b742ba9-e960-3ea8-b7ba-bd38159ec95c",
                                                "text": "Grüne Hose, Bluse mit Blumenmuster, an einer silbernen Halskette baumelt ein türkisfarbenes Amulett."
                                            },
                                            {
                                                "example_id": "99472865-28ae-4eb3-8905-964f64869f1a",
                                                "sense_id": "6b742ba9-e960-3ea8-b7ba-bd38159ec95c",
                                                "text": "„Abbas rutscht aus und stürzt, dabei verliert er eine Halskette mit einem Kreuzanhänger aus Diamanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
