                    },
                    {
                        "translation_id": "01904a3b-7332-4b73-b541-99df84271ea1",
                        "source_entry_id": "2e6e3931-6cf4-3bc6-b425-13412db6f113",
                        "target_lang_word": "biker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                        "entry_id": "401d2f42-13b1-3c65-9b0d-d9fcb49700eb",
                                        "glosses": [
                                            "A person whose lifestyle is centered on motorcycles, sometimes a member of a motorcycle club."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b07fb8-dc32-4561-a675-758345643199",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "Others, mostly behelmeted casual bikers whose enthusiasm for motorcycling is a monthly Sunday morning ride, also took in the gleam of the chrome and outrageous styling, but were confused that it had a Honda badge on it rather than Harley’s winged logo."
                                            },
                                            {
                                                "example_id": "977e5324-5ac7-468a-8796-4f1b30256fa0",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "There’s a wonderful sketch of a formidable biker called “Roundhouse,” who is “humongously fat and hasn’t had a haircut since third grade.”"
                                            },
                                            {
                                                "example_id": "7c5c9fe1-878b-439f-ba6f-dd2be809f9f4",
                                                "sense_id": "74635f8f-253e-388c-9d65-49f0e235febc",
                                                "text": "Bikers did what bikers do. They raced around and popped wheelies. The state police were called in to clear the town.\nThe event got big play in Life magazine and inspired the 1953 film “The Wild One,” starring Marlon Brando. His leather jacket and brooding demeanor gave a face to the bad-boy biker image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dbc6b0c-0ff6-3eac-b7e3-5b07071d9325",
                                        "entry_id": "401d2f42-13b1-3c65-9b0d-d9fcb49700eb",
                                        "glosses": [
                                            "A cyclist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f200aa1d-1ecd-4147-a520-0db31f4edbf1",
                                                "sense_id": "4dbc6b0c-0ff6-3eac-b7e3-5b07071d9325",
                                                "text": "Lots of pockets help with a commute, a storm hood is great if you get caught in a storm on a hike, weight and packability are essential for backpackers and if you’re a climber or biker, you’ll want a helmet-compatible hood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
