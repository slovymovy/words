                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "846d92bb-7695-3009-b9bd-f6b5d5576a15",
                                        "entry_id": "80684ddb-1c27-33a0-9679-8197701c02c3",
                                        "glosses": [
                                            "een lichtbron bestaande uit een krans van lichtbronnen"
                                        ],
                                        "tags": [],
                                        "examples": [
