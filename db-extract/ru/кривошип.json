                                        "sense_id": "a55df63c-fd6b-3ca4-af75-f74ed5ecdbff",
                                        "entry_id": "f10230a0-e144-3048-9e38-ad7ebceff9f7",
                                        "glosses": [
                                            "Hard; difficult."
                                        ],
