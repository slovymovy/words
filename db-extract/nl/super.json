                                "target_senses": [
                                    {
                                        "sense_id": "9c4aab3c-17e3-35d1-9ae6-1c1dc8db5087",
                                        "entry_id": "261b3d23-e7a4-3dac-93e7-991d74919041",
                                        "glosses": [
