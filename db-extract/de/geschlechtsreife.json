                            {
                                "example_id": "cdafc834-0c1d-4d0f-8e59-8f611353ac21",
                                "sense_id": "8be3332a-f766-39bb-b1b7-26facf2bf70f",
                                "text": "„Die Geschlechtsreifung findet jedoch mit dem Erreichen der Geschlechtsreife in aller Regel nicht ihren endgültigen Abschluss.“"
