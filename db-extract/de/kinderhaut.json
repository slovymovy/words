                            {
                                "example_id": "5e40bd1e-6d7c-4788-bf9a-9dcf1a9988af",
                                "sense_id": "0bcffb8a-951b-395f-a18d-86ae17767250",
                                "text": "„Als Sonkyong die Wärme der weichen Kinderhaut spürt, läuft es ihr eiskalt den Rücken hinunter.“"
                            },
                            {
                                "example_id": "13c16d9d-9219-4097-ac15-3b9810ba7bdb",
                                "sense_id": "0bcffb8a-951b-395f-a18d-86ae17767250",
                                "text": "„Schüler, die gerade vom Sportunterricht kamen, liefen lachend und sich unterhaltend an ihm vorbei zur Treppe. Ein nicht unangenehmer Duft von erhitzter Kinderhaut und Schweiß streifte seine Nase.“"
                            }
                        ],
