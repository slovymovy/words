{
    "word_family": [
        "tekenen",
        "tekening",
        "aftekenen",
        "aantekenen",
        "uittekenen",
        "overtekenen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d553b88d-6a78-3f3d-9924-3ee5a9f76556",
                    "sense_definition": "een bestaand contract, meestal een arbeidscontract, verlengen door opnieuw te tekenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De populaire voetballer besloot voor drie jaar <w>bij</w> te <w>tekenen</w> bij zijn huidige club.",
                            "target_lang_translations": {
                                "en": "The popular football player decided to <w>re-sign</w> for three years with his current club."
                            }
                        },
                        {
                            "text": "Als de resultaten goed blijven, mag de coach aan het eind van het seizoen <w>bijtekenen</w>.",
                            "target_lang_translations": {
                                "en": "If the results remain good, the coach will be allowed to <w>renew</w> his contract at the end of the season."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlengen"
                    ],
                    "antonyms": [
                        "opzeggen",
                        "vertrekken"
                    ],
                    "common_phrases": [
                        "voor drie jaar bijtekenen",
                        "een nieuw contract bijtekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "to extend an existing contract, usually an employment contract, by signing again"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sign a new contract",
                                "target_lang_sense_clarification": "to extend an existing agreement"
                            },
                            {
                                "target_lang_word": "to re-sign",
                                "target_lang_sense_clarification": "to sign again with the same team or employer"
                            },
                            {
                                "target_lang_word": "to renew",
                                "target_lang_sense_clarification": "to extend the duration of a contract"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f37cf9-bff9-3120-b67b-464279691312",
                    "sense_definition": "extra details of lijnen toevoegen aan een bestaande tekening om deze te verbeteren of aan te vullen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tekenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar moest de schaduwen nog een beetje <w>bijtekenen</w> om meer diepte te creëren.",
                            "target_lang_translations": {
                                "en": "The artist still had to <w>touch up</w> the shadows a bit to create more depth."
                            }
                        },
                        {
                            "text": "Je kunt de ontbrekende details op de kaart gemakkelijk zelf <w>bijtekenen</w>.",
                            "target_lang_translations": {
                                "en": "You can easily <w>add</w> the missing details to the map yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijwerken",
                        "aanvullen"
                    ],
                    "common_phrases": [
                        "details bijtekenen",
                        "met potlood bijtekenen"
                    ],
                    "target_lang_definitions": {
                        "en": "to add extra details or lines to an existing drawing to improve or complete it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to touch up",
                                "target_lang_sense_clarification": "to make small improvements to a drawing"
                            },
                            {
                                "target_lang_word": "to add to a drawing",
                                "target_lang_sense_clarification": "to draw additional details"
                            },
                            {
                                "target_lang_word": "to fill in",
                                "target_lang_sense_clarification": "to add missing parts to a sketch or map"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}