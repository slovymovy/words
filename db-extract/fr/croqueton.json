                        "examples": [
                            {
                                "example_id": "0f088b70-ee1c-46bd-b0be-8ccce09593f5",
                                "sense_id": "001eec24-0c00-301b-bcb7-c52b98fa9c40",
                                "text": "Porel et le décorateur ne tiendront compte ni de mes croquetons, ni de mes notes."
                            },
                            {
                                "example_id": "6c251813-b863-4caf-8dc4-7ea76f782a37",
                                "sense_id": "001eec24-0c00-301b-bcb7-c52b98fa9c40",
                                "text": "Trois croquetons et c’est râpé, t’as campé ta scène."
                            },
                            {
                                "example_id": "5d18d0c2-09c5-417e-8f7c-9f8ae13af21c",
                                "sense_id": "001eec24-0c00-301b-bcb7-c52b98fa9c40",
                                "text": "La femme japonaise est petite, petite, petite et rondelette. De cette femme, Outamaro a fait la femme élancée, la femme svelte de ses impressions : une femme qui a les longueurs des pensées, des croquetons d’avant midi de Watteau."
                            }
