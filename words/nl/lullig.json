                {
                    "sense_id": "4b109f20-56e5-3bdc-9fed-8568e52a525d",
                    "sense_definition": "teleurstellend, onbeduidend of van weinig waarde",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbeduidend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vond het maar een <w>lullig</w> showtje voor zoveel geld.",
                            "target_lang_translations": {
                                "en": "I thought it was just a <w>pathetic</w> little show for that much money.",
                                "de": "Ich fand es eine ziemlich <w>armselige</w> kleine Show für so viel Geld."
                            }
                        },
                        {
                            "text": "Hij kreeg slechts een <w>lullig</w> bedrag als vergoeding voor de schade.",
                            "target_lang_translations": {
                                "en": "He only received a <w>paltry</w> amount as compensation for the damage.",
                                "de": "Er erhielt nur einen <w>mickrigen</w> Betrag als Entschädigung für den Schaden."
                            }
                        }
                    ],
