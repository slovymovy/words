                    {
                        "translation_id": "36ca4ba6-8405-4326-a046-c70879cdb96f",
                        "source_entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                        "source_sense_description": "a device that measures, and indicates the current speed of a vehicle",
                        "target_lang_word": "compteur de vitesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compteur de vitesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b361cf05-796c-3da8-90d7-a2512b6cc700",
                                        "entry_id": "e9ce0096-3c7f-35df-91b9-230149c42994",
                                        "glosses": [
                                            "Appareil destiné à mesurer la vitesse d’un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b9e485-3735-42e8-9e2e-748aa568e095",
                                                "sense_id": "b361cf05-796c-3da8-90d7-a2512b6cc700",
                                                "text": "Dans le Point-d'Interrogation, […], nous avons toujours quelque chose à faire. […]. Les niveaux d'essence, le compte-tours, le thermomètre intérieur, le compteur de vitesse et le spiro-bloc d'huile à inspecter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e5f3235-b0bb-4dbb-8ca2-6c8fcda8ecf5",
                        "source_entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                        "source_sense_description": "a device that measures, and indicates the current speed of a vehicle",
                        "target_lang_word": "Geschwindigkeitsmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschwindigkeitsmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9148f2-db07-3f19-bda0-f779c3d7188e",
                                        "entry_id": "c980a27c-844e-3f68-98d9-395e98446aef",
                                        "glosses": [
                                            "Gerät, um die Geschwindigkeit zu messen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7522a129-29a1-46e0-9be7-3a36ccc8f51a",
                                                "sense_id": "bc9148f2-db07-3f19-bda0-f779c3d7188e",
                                                "text": "„Sie sah nicht auf den Geschwindigkeitsmesser.“"
                                            },
                                            {
                                                "example_id": "cfdf4ac5-ac06-445d-80f6-44b9c5f06f0f",
                                                "sense_id": "bc9148f2-db07-3f19-bda0-f779c3d7188e",
                                                "text": "„Die Passagiere besaßen nicht nur keinen Geschwindigkeitsmesser, sondern spürten auch nicht das mindeste von dem Sturm, der sie entführte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c237b084-175b-4605-859f-34945d584cf6",
                        "source_entry_id": "997f59bc-69da-383c-a44a-4db96d71f57a",
                        "source_sense_description": "a device that measures, and indicates the current speed of a vehicle",
                        "target_lang_word": "Tachometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tachometer",
