                    {
                        "sense_id": "26e0810a-eae8-366e-b634-fde847b5ba5e",
                        "entry_id": "7b277fb6-154f-3850-8889-12e5054df1ab",
                        "glosses": [
                            "toxicology (the study of poisons and treatments of poisoning)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "10bc016e-992b-40a5-8528-885f0895dfae",
                                "sense_id": "26e0810a-eae8-366e-b634-fde847b5ba5e",
                                "text": "Oznacza to m.in. ponowne przesłuchanie biegłych z zakresu toksykologii i medycyny sądowej.",
                                "translation": "This means, among other things, the re-examination of toxicology and forensic medicine experts.",
                                "english": "This means, among other things, the re-examination of toxicology and forensic medicine experts."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f00a9e8-d2d3-381b-970e-5bdbf25fcb4a",
                        "entry_id": "7b277fb6-154f-3850-8889-12e5054df1ab",
                        "glosses": [
                            "toxicology department (hospital department specializing in the treatment of poisonings)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "126bb8d4-2f33-451b-95ea-eb7f47462a76",
                                "sense_id": "4f00a9e8-d2d3-381b-970e-5bdbf25fcb4a",
                                "text": "Ewakuowano około dwudziestu osób, a jedną z nich pogotowie przewiozło do szpitala na toksykologię.",
                                "translation": "About twenty people were evacuated, and one of them was transported to the toxicology department by the emergency services.",
                                "english": "About twenty people were evacuated, and one of them was transported to the toxicology department by the emergency services."
                            }
                        ]
