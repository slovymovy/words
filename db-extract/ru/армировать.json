                        "sense_id": "346930bd-30ca-3a44-aa68-37c512b34170",
                        "entry_id": "d8be4c46-fc18-3954-be4a-df03d7f71916",
                        "glosses": [
                            "увеличивать прочность конструкции или материала путем введения арматуры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a82254-0a4f-4530-84f1-ad256166cc93",
                                "sense_id": "346930bd-30ca-3a44-aa68-37c512b34170",
                                "text": "Нелишним будет армировать раствор внутри трубы стержнями из проволоки диаметром 5-6 мм и длиной 100-150 см."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b574595e-f414-4206-980c-98b49d46fe94",
                        "source_entry_id": "d8be4c46-fc18-3954-be4a-df03d7f71916",
                        "source_sense_id": "346930bd-30ca-3a44-aa68-37c512b34170",
                        "target_lang_word": "reinforce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reinforce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef4bead-a006-3d1a-b7d1-2a537a14616c",
                                        "entry_id": "85dc3de1-d9b9-3c47-96ff-71c9666c9d92",
                                        "glosses": [
                                            "To strengthen, especially by addition or augmentation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee063965-9b8c-467a-b603-17c07d3e159c",
                                                "sense_id": "3ef4bead-a006-3d1a-b7d1-2a537a14616c",
                                                "text": "He reinforced the handle with a metal rod and a bit of tape."
                                            },
                                            {
                                                "example_id": "ecf8bf8e-a8f6-479e-94c9-554aa6acb7d7",
                                                "sense_id": "3ef4bead-a006-3d1a-b7d1-2a537a14616c",
                                                "text": "[T]hey [the English] valiantly, and vvith the ſlaughter of many, put backe the enemy: vvhich vvas ſo farre from daunting the Normans, that by it they vvere more vvhetted to re-enforce themſelues vpon them: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f6803b-41a2-3c15-a421-bbb86370c19b",
                                        "entry_id": "85dc3de1-d9b9-3c47-96ff-71c9666c9d92",
                                        "glosses": [
                                            "To emphasize or review."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d728bf3f-d987-4a2b-ab83-366dfd375ad1",
                                                "sense_id": "f2f6803b-41a2-3c15-a421-bbb86370c19b",
                                                "text": "The right homework will reinforce and complement the lesson!"
                                            },
                                            {
                                                "example_id": "58402c30-a478-4fcf-bf68-4fa8e59fdb62",
                                                "sense_id": "f2f6803b-41a2-3c15-a421-bbb86370c19b",
                                                "text": "The accident was also one of several since Clapham [...] that demonstrated the role of breakable windows in the death toll. RSSB research would later confirm and reinforce the need for laminated glass to protect passengers and increase survivability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86681d6-72ce-3df0-9619-3473239778cf",
                                        "entry_id": "85dc3de1-d9b9-3c47-96ff-71c9666c9d92",
                                        "glosses": [
                                            "To encourage (a behavior or idea) through repeated stimulus."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9dfcfb-5d27-4c4e-8379-01cca55576ae",
                                                "sense_id": "b86681d6-72ce-3df0-9619-3473239778cf",
                                                "text": "Advertising for fast food can reinforce unhealthy dietary tendencies."
                                            },
                                            {
                                                "example_id": "35c80e31-405c-467d-ac10-4f173fc73cf2",
                                                "sense_id": "b86681d6-72ce-3df0-9619-3473239778cf",
                                                "text": "Mr. Schlossberg’s rant angered activists for immigrant rights, who said it reinforced stereotypes that Spanish speakers are not citizens. And they worried that it perpetuated fear within immigrant communities of ICE’s aggressive tactics to deport those who are undocumented."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48dba483-bb57-4845-a635-34d096e9deeb",
                        "source_entry_id": "d8be4c46-fc18-3954-be4a-df03d7f71916",
