{
    "word_family": [
        "fugit",
        "fugacity",
        "fugacious",
        "refuge",
        "refugee",
        "subterfuge"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aeb01681-1a0a-3201-8156-3c31b9458486",
                    "sense_definition": "A person who flees or escapes, especially from the law, to avoid arrest or prosecution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person fleeing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are searching for the <w>fugitive</w> who escaped from the local prison last night.",
                            "target_lang_translations": {
                                "ru": "Полиция разыскивает <w>беглеца</w>, который прошлой ночью сбежал из местной тюрьмы."
                            }
                        },
                        {
                            "text": "He lived as a <w>fugitive</w> from justice for ten years before he was finally caught.",
                            "target_lang_translations": {
                                "ru": "Он десять лет жил как <w>скрывающийся</w> от правосудия, прежде чем его наконец поймали."
                            }
                        }
                    ],
                    "synonyms": [
                        "runaway"
                    ],
                    "common_phrases": [
                        "fugitive from justice",
                        "wanted fugitive",
                        "fleeing fugitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который скрывается или находится в бегах, особенно от правосудия, чтобы избежать ареста или судебного преследования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беглец",
                                "target_lang_sense_clarification": "человек, совершивший побег"
                            },
                            {
                                "target_lang_word": "скрывающийся",
                                "target_lang_sense_clarification": "от правосудия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9b770c0d-0ad1-3f31-924d-546d280d62a0",
                    "sense_definition": "Running away or escaping from something, such as a duty or a place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fugitive</w> slave sought safety in the northern states during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "<w>Беглый</w> раб искал убежища в северных штатах в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "The company struggled to replace a succession of <w>fugitive</w> employees who left without notice.",
                            "target_lang_translations": {
                                "ru": "Компания с трудом находила замену череде <w>непостоянных</w> сотрудников, которые увольнялись без предупреждения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fugitive slave",
                        "fugitive thoughts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в бегах или уклоняющийся от чего-либо, например, от обязанностей или места пребывания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беглый",
                                "target_lang_sense_clarification": "совершивший побег"
                            },
                            {
                                "target_lang_word": "скрывающийся",
                                "target_lang_sense_clarification": "находящийся в розыске"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1f6e62e-d823-32a1-9134-ced82b630787",
                    "sense_definition": "Lasting for only a very short time; fleeting or ephemeral.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist tried to capture the <w>fugitive</w> light of the setting sun on his canvas.",
                            "target_lang_translations": {
                                "ru": "Художник пытался запечатлеть на холсте <w>мимолётный</w> свет заходящего солнца."
                            }
                        },
                        {
                            "text": "She felt a <w>fugitive</w> sense of joy that vanished as soon as she remembered her troubles.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>мимолётную</w> радость, которая исчезла, как только она вспомнила о своих проблемах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fugitive moments",
                        "fugitive colors"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длящийся лишь очень короткое время; мимолётный или эфемерный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мимолётный",
                                "target_lang_sense_clarification": "быстро проходящий"
                            },
                            {
                                "target_lang_word": "преходящий",
                                "target_lang_sense_clarification": "временный, не вечный"
                            },
                            {
                                "target_lang_word": "скоротечный",
                                "target_lang_sense_clarification": "быстротечный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1573bfa-540b-32ee-be7c-9581923365ef",
                    "sense_definition": "Difficult to capture, retain, or define; elusive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "elusive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet struggled to find words for the <w>fugitive</w> emotions he was experiencing.",
                            "target_lang_translations": {
                                "ru": "Поэт изо всех сил пытался подобрать слова для <w>неуловимых</w> эмоций, которые он испытывал."
                            }
                        },
                        {
                            "text": "The scent of the flowers was <w>fugitive</w> and hard to identify in the breeze.",
                            "target_lang_translations": {
                                "ru": "Аромат цветов был <w>едва уловимым</w>, и его было трудно распознать на ветру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fugitive idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудноуловимый, трудно поддающийся определению или сохранению; неуловимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуловимый",
                                "target_lang_sense_clarification": "трудно поддающийся фиксации"
                            },
                            {
                                "target_lang_word": "едва уловимый",
                                "target_lang_sense_clarification": "о запахе или чувстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e79546cf-4d1a-3ffa-8fa2-c65e89adccf7",
                    "sense_definition": "To force someone to become a fugitive or to drive them into exile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forcing escape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political leader was <w>fugitived</w> during the violent persecution of his party.",
                            "target_lang_translations": {
                                "ru": "Политический лидер был <w>изгнан</w> во время жестоких преследований его партии."
                            }
                        },
                        {
                            "text": "The regime sought to <w>fugitive</w> any citizens who spoke out against the new laws.",
                            "target_lang_translations": {
                                "ru": "Режим стремился <w>обратить в бегство</w> любых граждан, выступавших против новых законов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо стать беглецом или отправить в изгнание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изгонять",
                                "target_lang_sense_clarification": "вынуждать к бегству"
                            },
                            {
                                "target_lang_word": "обращать в бегство",
                                "target_lang_sense_clarification": "заставлять скрываться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}