                "senses": [
                    {
                        "sense_id": "bc2c082e-0771-33e9-8b19-25878aece938",
                        "entry_id": "88f3e3b4-cca2-36c9-9565-be4bcce9052a",
                        "glosses": [
                            "individuell anpassbare Seite eines angemeldeten Benutzers innerhalb der Internetplattform YouTube, auf der dieser zum Beispiel Videos hochladen und veröffentlichen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a41daa77-d51f-4b03-9943-09c2ce6e5955",
                                "sense_id": "bc2c082e-0771-33e9-8b19-25878aece938",
                                "text": "„Der YouTube-Kanal ist das Profil einer Person oder eines Unternehmens auf YouTube.“"
                            },
                            {
                                "example_id": "be8db611-c33b-473e-b583-dca03414e65c",
                                "sense_id": "bc2c082e-0771-33e9-8b19-25878aece938",
                                "text": "„Er hat ganz einfach seinen eigenen YouTube-Kanal gegründet und will dort in genüsslichen Fünf-Minuten-Videos über alles Mögliche reden: über Stücke, die ihm am Herzen liegen, über Politisches, Soziales und Absurdes.“"
                            },
                            {
                                "example_id": "ced6c376-4285-4e1d-be50-72339c4b2aba",
                                "sense_id": "bc2c082e-0771-33e9-8b19-25878aece938",
                                "text": "„Für das Personalmarketing ist ein YouTube-Kanal besonders interessant, da man die Videos, anders als bei Xing oder Facebook, auch ohne eine Anmeldung anschauen kann.“"
                            },
                            {
                                "example_id": "651500e4-b81b-4300-a990-0e4705cbcc8b",
                                "sense_id": "bc2c082e-0771-33e9-8b19-25878aece938",
                                "text": "„‚Die Bundesregierung will auf ihrem YouTube-Kanal in Bild und Wort über ihre Arbeit informieren.‘“"
                            },
                            {
                                "example_id": "f98f4b69-6619-4248-a2ab-eb2d60dfb864",
                                "sense_id": "bc2c082e-0771-33e9-8b19-25878aece938",
                                "text": "„Jugendkultureller Raum umfasst digitale und territoriale Orte, zum Beispiel persönliche YouTube-Kanäle, Performance- und Drehorte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
