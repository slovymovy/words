                "translations": [
                    {
                        "translation_id": "cbf358a1-68f8-4ad8-bd3f-58fb5e32038b",
                        "source_entry_id": "2ad246a1-540c-3ba7-b7bb-d7cb93f70f01",
                        "source_sense_id": "4f706260-598b-31cd-bedf-8c557b9be8b4",
                        "source_sense_description": "Medizin: Alzheimer, Alzheimerkrankheit, Alzheimer-Krankheit",
                        "target_lang_word": "Alzheimer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alzheimer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75583540-b30f-387b-a23c-1e4ec35efb6b",
                                        "entry_id": "44604256-4f46-3919-8030-0da95a612eb1",
                                        "glosses": [
                                            "Alzheimerkrankheit"
                                        ],
                                        "tags": [
                                            "Kurzform",
                                            "für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d157ac48-cbda-49f2-aeb1-b1a3ecf2b635",
                                                "sense_id": "75583540-b30f-387b-a23c-1e4ec35efb6b",
                                                "text": "Die Angst vor dem Vergessen prägt unsere Gesellschaft: Eine aktuelle Studie belegt, dass Alzheimer nach Krebs die am meisten gefürchtete Krankheit der westlichen Welt ist."
                                            },
                                            {
                                                "example_id": "1557566a-eaa7-4429-8995-0627dd7e7b89",
                                                "sense_id": "75583540-b30f-387b-a23c-1e4ec35efb6b",
                                                "text": "Körperlich und geistig fit bleiben bis ins hohe Alter und ohne Alzheimer - das ist der Traum, den wohl jeder hat."
                                            },
                                            {
                                                "example_id": "e2e99e8f-d5ce-469d-91ee-3863d1f0b06e",
                                                "sense_id": "75583540-b30f-387b-a23c-1e4ec35efb6b",
                                                "text": "Seine Mutter war an Alzheimer erkrankt, und sein Vater nahm sich daraufhin, aus Gram und Trauer, dem geistigen und körperlichen Verfall seiner Frau tatenlos zusehen zu müssen, das Leben."
                                            },
                                            {
                                                "example_id": "9147cf46-0813-426d-8210-1009df8ce158",
                                                "sense_id": "75583540-b30f-387b-a23c-1e4ec35efb6b",
                                                "text": "Heidelbeeren naschen, zwei bis drei Gläser Rotwein pro Woche trinken, Kartoffel und Co. mit Curry würzen, tanzen und sich bei Karten- oder Gesellschaftsspielen amüsieren – das sind nur fünf von 50 „Hirnkultur-Tipps“, die Vergesslichkeit und vielleicht bis zu einem gewissen Grad auch Alzheimer vorbeugen sollen."
                                            },
                                            {
                                                "example_id": "22324ade-a02d-4fa8-abb1-23024d422a92",
                                                "sense_id": "75583540-b30f-387b-a23c-1e4ec35efb6b",
                                                "text": "Eines Tages könnten Elektroden im Gehirn neuronale Ausfälle bei Menschen ausgleichen, zum Beispiel nach einem Schlaganfall oder wenn durch Parkinson oder Alzheimer Nervenzellen abgestorben sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
