                                "target_senses": [
                                    {
                                        "sense_id": "8f3b9b1e-07f2-318f-8c7a-03f9148a9add",
                                        "entry_id": "097b511a-d5da-3e48-8227-52c01ba73265",
                                        "glosses": [
                                            "Qui fait uriner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2238aef-82c8-48c3-ba77-170bb05867d9",
                                                "sense_id": "8f3b9b1e-07f2-318f-8c7a-03f9148a9add",
                                                "text": "Le vin blanc, les asperges, l’ail et le cerfeuil sont diurétiques."
                                            },
                                            {
                                                "example_id": "c0f50ee1-edd1-440b-a94f-16c241dcc6d4",
                                                "sense_id": "8f3b9b1e-07f2-318f-8c7a-03f9148a9add",
                                                "text": "Remède diurétique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diurétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                        "entry_id": "556cf564-0e69-3bf4-8621-6ab762e79372",
                                        "glosses": [
                                            "Substance qui provoque et augmente l’excrétion urinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6dd8ba-1082-4007-b887-779194b99d15",
                                                "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                                "text": "Diurétique minéral, végétal."
                                            },
                                            {
                                                "example_id": "79d86e25-246c-4d60-b7e4-02a63c3de836",
                                                "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                                "text": "Les médicaments agissant comme diurétiques sont nombreux : certains acidifiants (chlorure d’ammonium), les sels de potassium, les diurétiques osmotiques, (…), les diurétiques mercuriels."
                                            },
                                            {
                                                "example_id": "e721b85b-6261-4e33-acf8-0fada26933a8",
                                                "sense_id": "06b41944-4267-3454-bae6-7ac44eae963e",
                                                "text": "On sait aujourd’hui que l’asperge est un diurétique, mais qu’elle peut avoir une action irritante sur les reins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2f70899-8104-4259-8bbc-a10827f971a9",
                        "source_entry_id": "122a0437-bd09-3cc3-aad6-9f8aa21c724f",
                        "source_sense_id": "a3fa0f8e-d997-3ab6-9954-cc493a424557",
                        "source_sense_description": "increasing urination",
                        "target_lang_word": "harntreibend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harntreibend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3429c0e8-8573-381e-bb63-3d12c536b517",
                                        "entry_id": "bdf6d769-ed4f-39a9-94c8-5e0315351ed9",
                                        "glosses": [
                                            "dafür sorgend, dass Urin (Harn) aus dem Körper ausgeschieden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b47964-598a-4c51-aaab-d83a58dc9fa6",
                                                "sense_id": "3429c0e8-8573-381e-bb63-3d12c536b517",
                                                "text": "Koffein und Alkohol haben eine harntreibende Wirkung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0830f5ac-261f-4957-802c-4f3de2d6458b",
                        "source_entry_id": "122a0437-bd09-3cc3-aad6-9f8aa21c724f",
                        "source_sense_id": "a3fa0f8e-d997-3ab6-9954-cc493a424557",
                        "source_sense_description": "increasing urination",
                        "target_lang_word": "diuretisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diuretisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                        "entry_id": "e66c1e07-0ae2-3ce0-88d6-06587112c22d",
                                        "glosses": [
                                            "die Ausscheidung von Harn fördernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d42d80-19bf-432d-adef-c23d42b4732c",
                                                "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                                "text": "Grundsätzlich gilt: Je weiter distal ein Diuretikum angreift, umso geringer ist der diuretische Effekt."
                                            },
                                            {
                                                "example_id": "6a550d4e-36a4-46a2-9292-3733538be5ab",
                                                "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                                "text": "Tatsächlich wird ein erheblicher Teil der Patienten mit chronischer Herzinsuffizienz dauerhaft diuretisch behandelt."
                                            },
                                            {
                                                "example_id": "cf6969ec-24e3-4496-9a9b-d91e6fc56f26",
                                                "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                                "text": "Die Befunde an normalen Hunden bestätigen die Ergebnisse anderer Autoren: Bei kleinem Harnfluß in den Vorperioden wirkt Oxytocin schwach diuretisch, während einer Wasserdiurese dagegen fast gar nicht."
                                            },
                                            {
                                                "example_id": "0a330ff9-4197-4aa7-aba7-f1e072eb0892",
                                                "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                                "text": "Eine Metaanalyse aus 2014 bestätigte dies: Koffein hatte zwar einen minimalen diuretischen Effekt, der aber durch das Training aufgehoben wurde."
                                            },
                                            {
                                                "example_id": "c45d59d0-4e76-4e17-bc06-51480d8a5a52",
                                                "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                                "text": "Entwässerungstabletten sind sogenannte diuretische (harntreibende) Medikamente, welche die Ausscheidung von Wasser verstärken und Mineralstoffe ausschwemmen, indem sie die Wasserrückresorption in den Nieren einschränken."
                                            },
                                            {
                                                "example_id": "59d3da1e-4707-4bfe-bb07-9d0fcc3b904e",
                                                "sense_id": "24a9d1f8-68d0-365f-bcad-405865f91349",
                                                "text": "Man hält dieses Oel für eines der diuretischsten, und wendet es in dieser Hinsicht in der Medicin an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
