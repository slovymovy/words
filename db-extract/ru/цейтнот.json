                                "target_senses": [
                                    {
                                        "sense_id": "cd441f34-5972-3659-8b31-8742c1255fc4",
                                        "entry_id": "21f62ce8-fe14-3a8b-8b76-6245a070ab54",
                                        "glosses": [
                                            "sytuacja w partii szachowej, kiedy jednemu lub obydwojgu graczom grozi przegrana z powodu przekroczenia limitu czasu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af691adb-148c-4853-bd14-64261bb35253",
                                                "sense_id": "cd441f34-5972-3659-8b31-8742c1255fc4",
                                                "text": "W ogromnym niedoczasie zobaczył wieczniaka, ale wieczniaka nie było"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "111db880-3fb8-3b27-9c76-b8db30a5d832",
                                        "entry_id": "21f62ce8-fe14-3a8b-8b76-6245a070ab54",
                                        "glosses": [
                                            "nienadążanie, opóźnianie się"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6bc98da-ebed-422a-8713-3767cb4b54c2",
                                                "sense_id": "111db880-3fb8-3b27-9c76-b8db30a5d832",
                                                "text": "…wielu kursantów to przedstawiciele handlowi, którzy w wiecznym niedoczasie krążą po kraju"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
