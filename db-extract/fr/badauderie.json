        "fr-extract.jsonl": [
            {
                "entry_id": "3b7562b2-2c30-36e4-8f03-ee92b32053e0",
                "word": "badauderie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35812093-01e1-41f4-9c0c-44fb9bb08b46",
                        "entry_id": "3b7562b2-2c30-36e4-8f03-ee92b32053e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "badauderies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5e9343b-feb1-3af2-bf81-09bf574b1df0",
                        "entry_id": "3b7562b2-2c30-36e4-8f03-ee92b32053e0",
                        "glosses": [
                            "Action ou propos de badaud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28969825-767d-446a-9b58-2d02b75219e3",
                                "sense_id": "b5e9343b-feb1-3af2-bf81-09bf574b1df0",
                                "text": "Grande est la badauderie de la foule."
                            },
                            {
                                "example_id": "907e9021-61fb-4674-bb47-618be1c186b3",
                                "sense_id": "b5e9343b-feb1-3af2-bf81-09bf574b1df0",
                                "text": "Un peu de badauderie ne messied point au voyageur nouveau débarqué."
                            },
                            {
                                "example_id": "3851bf88-26ce-46f1-a0ab-516a6195c6c7",
                                "sense_id": "b5e9343b-feb1-3af2-bf81-09bf574b1df0",
                                "text": "Les allégories emportent des potentats au ciel comme de fastueuses machines d'opéra. Les sanglants martyres et les violentes scènes de chasse assouvissent noblement leur fringale de spectacles et leur goût pour la mise à mort. Il s'agit toujours de plaire à la badauderie des foules, mais cette fois d'une foule de princes."
                            },
                            {
                                "example_id": "4543443d-7e22-4fdc-af06-d148c1168496",
                                "sense_id": "b5e9343b-feb1-3af2-bf81-09bf574b1df0",
                                "text": "Il l’avait revue à l’enterrement de sa mère auquel assistaient la moitié des habitants, par vaine badauderie."
                            },
                            {
                                "example_id": "b607b145-825b-4ab5-9ecc-e6964b2a21f2",
                                "sense_id": "b5e9343b-feb1-3af2-bf81-09bf574b1df0",
                                "text": "Le fléau du scepticisme et de la badauderie a dilué toute ardeur, détruit l’enthousiasme et la foi."
                            }
                        ]
                    }
                ],
