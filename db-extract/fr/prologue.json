                                    {
                                        "sense_id": "c281d097-d15b-39a1-9bf5-600e9c02008f",
                                        "entry_id": "056165f7-f3b2-3104-ad54-5b253d438c0c",
                                        "glosses": [
                                            "A speech or section used as an introduction, especially to a play or novel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd56790-5115-4b5d-8e9b-d25b60365ce3",
                                                "sense_id": "c281d097-d15b-39a1-9bf5-600e9c02008f",
                                                "text": "“H'm !” he said, “so, so—it is a tragedy in a prologue and three acts. I am going down this afternoon to see the curtain fall for the third time on what […] will prove a good burlesque ; but it all began dramatically enough. It was last Saturday […] that two boys, playing in the little spinney just outside Wembley Park Station, came across three large parcels done up in American cloth. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50be696-b8e7-305b-b6c3-b2305e4cfffb",
                                        "entry_id": "056165f7-f3b2-3104-ad54-5b253d438c0c",
                                        "glosses": [
                                            "One who delivers a prologue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ed1760-b76b-4aa3-9c73-230cab5c05e0",
                                                "sense_id": "a50be696-b8e7-305b-b6c3-b2305e4cfffb",
                                                "text": "And hither am I come, / A Prologue arm’d, but not in confidence / Of Authors pen, or Actors voyce;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be1b33a-e59c-37ca-a32b-1da44d18799c",
