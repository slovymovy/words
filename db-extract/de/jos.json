                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e57c5a7-aec9-4432-9394-48862287a33d",
                                "sense_id": "eb01a3ef-f9c0-3ee6-b3aa-a5ce60daec2b",
                                "text": "„Abdulkareem war groß und hellhäutig und hatte auf der Brust, den Händen und Beinen sagenhaft viele Haare; seine Eltern und Brüder sind in Jos bei den Unruhen ums Leben gekommen.“"
                            },
                            {
                                "example_id": "2dbc2af7-3d83-4b91-81dc-730534a012e7",
                                "sense_id": "eb01a3ef-f9c0-3ee6-b3aa-a5ce60daec2b",
                                "text": "„Vor ein paar Jahren kam es zu mehreren gewaltsamen Zusammenstößen zwischen religiösen Gruppen in Jos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
