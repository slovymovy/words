                                "target_senses": [
                                    {
                                        "sense_id": "0758dc99-9fca-357b-b9d2-656ace8decce",
                                        "entry_id": "47cc9da8-0ec5-3aa9-8ab2-5afac67c16ca",
                                        "glosses": [
                                            "amtliche Beglaubigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd65f1c4-f2a6-4388-bc74-81710c5fa442",
                                                "sense_id": "0758dc99-9fca-357b-b9d2-656ace8decce",
                                                "text": "Die Legalisierung der Urkunden konnte auch der Standesbeamte vornehmen."
                                            },
                                            {
                                                "example_id": "d460c7e5-1b8a-46a1-83ac-fbd7744222c2",
                                                "sense_id": "0758dc99-9fca-357b-b9d2-656ace8decce",
                                                "text": "„Glücklich schritt Fred Asbert mit ihr durch die Straßen, enthielt sie in begreiflichem Stolz weder seiner Verwandtschaft noch seinen Freunden vor, ja zeigte sich plötzlich sogar imstande, mehrere Sätze fließend hintereinander auszusprechen, während er sonst doch die Wortkargheit in Person war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb32fa3b-8eca-322e-99c3-6f9f8e2dbab5",
                                        "entry_id": "47cc9da8-0ec5-3aa9-8ab2-5afac67c16ca",
                                        "glosses": [
                                            "Umsetzung in ein Gesetz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b69d57-deda-48b4-a2d1-e33d3d9a441d",
                                                "sense_id": "cb32fa3b-8eca-322e-99c3-6f9f8e2dbab5",
                                                "text": "Die Legalisierung der Zuwanderung wurde von der Opposition abgelehnt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f640b58e-5f3b-38ea-9825-372a754cd311",
                                        "entry_id": "47cc9da8-0ec5-3aa9-8ab2-5afac67c16ca",
                                        "glosses": [
                                            "Aufhebung eines Verbotes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23350aaf-1f70-4328-8b12-5a57a828f2d8",
                                                "sense_id": "f640b58e-5f3b-38ea-9825-372a754cd311",
                                                "text": "Die Legalisierung der Drogen ist sehr umstritten."
                                            },
                                            {
                                                "example_id": "425bdb86-a8a4-4d64-a36f-f66b580e4ae9",
                                                "sense_id": "f640b58e-5f3b-38ea-9825-372a754cd311",
                                                "text": "„Denis Dawydow mit seiner feinen russischen Witterung hatte als erster die Bedeutung dieses furchtbaren Knüppels begriffen, der die Franzosen vernichtete, ohne nach den Regeln der Kriegskunst zu fragen, und ihm gebührt der Ruhm, den ersten Schritt zur Legalisierung der Kriegführung getan zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
