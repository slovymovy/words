                        "examples": [
                            {
                                "example_id": "2b10d0e8-d75c-4e21-88cd-d2ad1e7b7599",
                                "sense_id": "5f8def68-3a4e-3b55-8d61-2765b32b8f01",
                                "text": "So, in virtue of this last appeal, convictism had established a tacit right to converse in whispers, and to move about inside its oaken cage."
                            },
                            {
                                "example_id": "a88ded81-8d61-45c8-a228-2ed2d8e5e932",
                                "sense_id": "5f8def68-3a4e-3b55-8d61-2765b32b8f01",
                                "text": "It was the simple expression of a necessity for clearing away from home a pressing amount of convictism, and of thus giving to this corrupt portion of society a means of regeneration"
                            }
                        ]
