                ],
                "senses": [
                    {
                        "sense_id": "e083cc54-43b2-31fb-b44d-7e6fbfb2a494",
                        "entry_id": "b3767cb2-e104-34e5-85c1-a00f15f876ba",
                        "glosses": [
                            "Aufstellung des in einem Jagdrevier abzuschießenden Wildes"
                        ],
                        "tags": [
                            "Jagdwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ba8879-6c80-4dab-b63d-9777bcc8bc0e",
                                "sense_id": "e083cc54-43b2-31fb-b44d-7e6fbfb2a494",
                                "text": "Auf der Abschussliste stehen in dieser Saison fünf Hirschkühe und zwei Hirsche, darunter ein stattlicher Vierzehnender."
                            },
                            {
                                "example_id": "963a61d0-9909-4bfe-8225-d1be3ae74ec8",
                                "sense_id": "e083cc54-43b2-31fb-b44d-7e6fbfb2a494",
                                "text": "Die Abschussliste war zwar lang, der tatsächliche Abschuss jedoch kümmerlich und die Strecke kurz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e00885e0-bd50-3e41-a925-25c748993973",
                        "entry_id": "b3767cb2-e104-34e5-85c1-a00f15f876ba",
                        "glosses": [
                            "im übertragenen Sinne, umgangssprachlich: Aufstellung der Personen, die eine für sie sehr nachteilige Behandlung zu gewärtigen haben: Sanktion, Entfernung aus einer Gruppe, Entlassung, Ermordung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d48fe11-336e-464e-84c1-07cc0fdca598",
                                "sense_id": "e00885e0-bd50-3e41-a925-25c748993973",
                                "text": "Der Amokläufer arbeitete geradezu eine persönliche Abschussliste ab."
                            },
                            {
                                "example_id": "abcd9c1f-e8e5-4dd6-8cfc-73e1b940766a",
                                "sense_id": "e00885e0-bd50-3e41-a925-25c748993973",
                                "text": "Nach dem groben Schnitzer, den er sich gegenüber dem Hauptkunden erlaubt hat, steht Müller jetzt ganz oben auf der Abschussliste des Chefs."
                            },
                            {
                                "example_id": "3a8b6f2e-75b8-4b02-826c-fc3ab9f5673c",
                                "sense_id": "e00885e0-bd50-3e41-a925-25c748993973",
                                "text": "„Da sowieso die meisten Menschen auf meiner Abschussliste stehen, gefiele mir das Prinzip des Zufallsschießens ganz besonders gut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95d6a1ea-5400-43e8-a65b-bedbe914c892",
                        "source_entry_id": "b3767cb2-e104-34e5-85c1-a00f15f876ba",
                        "source_sense_id": "e00885e0-bd50-3e41-a925-25c748993973",
                        "source_sense_description": "Auflistung der Personen, die benachteiligt werden sollen",
                        "target_lang_word": "hit list",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hit list",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d16f6e24-be89-3a14-b97e-007492bbc572",
                                        "entry_id": "dfe95d21-585b-3579-81e9-ab46f939b78f",
                                        "glosses": [
                                            "A roster of potential victims, especially a list of people to be killed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83443d3e-d198-4ad9-a858-b553991971a5",
                                                "sense_id": "d16f6e24-be89-3a14-b97e-007492bbc572",
                                                "text": "After all this time, the little girl who watched her father get beheaded, who was captured and impressed as her enemy’s servant, who was captured again and taken to the site of her family’s massacre, who enrolled at assassin school, who went blind, who dropped out to pursue vengeance, the woman who endured all that by focusing on her hit list can be swayed from her course by the prospect of her family and her home."
                                            },
                                            {
                                                "example_id": "f659da70-afef-43d9-b2b0-546a4355bfb1",
                                                "sense_id": "d16f6e24-be89-3a14-b97e-007492bbc572",
                                                "text": "London's Marylebone station was also on the Minister of Transport's hit-list for closure, with High Wycombe/Aylesbury services diverted to Paddington and closure of the Northolt-Neasden link via Wembley Park. (Both Marylebone and the lines to it are still open in 2020)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f3423d9-2b74-3195-b283-8d181f9edad2",
                                        "entry_id": "dfe95d21-585b-3579-81e9-ab46f939b78f",
                                        "glosses": [
                                            "A similar list of people to be approached for a charitable donation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31189a08-da44-3b97-b84a-e551bea84dde",
                                        "entry_id": "dfe95d21-585b-3579-81e9-ab46f939b78f",
                                        "glosses": [
                                            "Any list of things to be acquired or conquered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b9a482f-f3b1-4aa1-84cb-d7b7af1af153",
                                                "sense_id": "31189a08-da44-3b97-b84a-e551bea84dde",
                                                "text": "Three of these were highly unexpected and narrow: Kettering, Wellingborough and Northampton South. Two were high on Labour's hit list and won by five-figure majorities, Corby and Northampton North – in the latter case by exactly 10,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff78190b-17eb-3627-937f-90bbe6351961",
                                        "entry_id": "dfe95d21-585b-3579-81e9-ab46f939b78f",
                                        "glosses": [
                                            "Synonym of hotlist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
