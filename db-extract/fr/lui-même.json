                "senses": [
                    {
                        "sense_id": "880f8f7c-36cc-318c-ba24-e69afd5cdef1",
                        "entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "glosses": [
                            "Lui comme le sujet naturellement ou directement responsable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6432864-ee95-4365-828d-c0304331ca57",
                                "sense_id": "880f8f7c-36cc-318c-ba24-e69afd5cdef1",
                                "text": "Lui-même chaussa en un tournemain ses vieux croquenots mal cirés, avachis et trop grands, […]."
                            },
                            {
                                "example_id": "5aec2e0d-d58b-46a6-bf42-d10241f31fc2",
                                "sense_id": "880f8f7c-36cc-318c-ba24-e69afd5cdef1",
                                "text": "Le lecteur lui-même sera tenu dans l'incertitude, sachant de moins en moins au fur et à mesure qu’il avance dans le texte, si les événements qu'on lui rapporte sont réels ou illusoires, […]."
                            },
                            {
                                "example_id": "ea4c6205-1848-4b67-a79c-8d8e1547b0f4",
                                "sense_id": "880f8f7c-36cc-318c-ba24-e69afd5cdef1",
                                "text": "Nous avons même vu le Prince lui-même au volant de ce \"colosse illégal\" en Europe, ce qui montre l'engouement même des figures royales pour ce véhicule avant-gardiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fe709bb-9814-313a-bac9-40d37f90a786",
                        "entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "glosses": [
                            "Lui comme l’objet, et aussi comme soit le sujet, le possesseur ou le créateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ce252c-44d2-4c2f-bc6d-5da83b2307b2",
                                "sense_id": "3fe709bb-9814-313a-bac9-40d37f90a786",
                                "text": "Pendant que le nouveau venu se débitait à lui-même ce monologue, un autre cavalier, […], s’arrêtait et demeurait aussi en extase devant l’enseigne de la Belle-Étoile."
                            },
                            {
                                "example_id": "97e25dab-54ee-464e-a656-02e5b3935e69",
                                "sense_id": "3fe709bb-9814-313a-bac9-40d37f90a786",
                                "text": "Lui que j’ai connu si sûr de lui-même, d’une fatuité toute naturelle, […], le voici devant moi […], tel un petit garçon qui craint d'être grondé."
                            },
                            {
                                "example_id": "43770343-4dfa-4781-988f-5db4041ea074",
                                "sense_id": "3fe709bb-9814-313a-bac9-40d37f90a786",
                                "text": "L’air maussade, il portait un jean et un tee-shirt orné d’un vélociraptor qui montrait les crocs, à cheval sur un chat géant arborant lui-même un tee-shirt sur lequel était écrit « XPTDR »."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd9a3d4b-a237-3d94-a443-e42224c2d263",
                        "entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "glosses": [
                            "Naturellement ou directement par celui-ci."
                        ],
                        "tags": [
                            "Nom masculin + lui-même"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8a7bd6b-d4c4-485d-8b9a-96c994d7d23d",
                        "source_entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "target_lang_word": "selbst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selbst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f65beb85-5c26-3f9b-8e3a-47efce57c284",
                                        "entry_id": "2aee0c73-95ed-3dc1-b421-20c00f868637",
                                        "glosses": [
                                            "persönlich (immer in Kontrast zu anderen Möglichkeiten, die im Kontext enthalten sind)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "83c1a1c2-c72f-316b-8fb8-c8935385bd74",
                                        "entry_id": "2aee0c73-95ed-3dc1-b421-20c00f868637",
                                        "glosses": [
                                            "allein, ohne fremde Hilfe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138838da-749b-4b04-9a52-78bb9e90511c",
                                                "sense_id": "83c1a1c2-c72f-316b-8fb8-c8935385bd74",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                        "entry_id": "2aee0c73-95ed-3dc1-b421-20c00f868637",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b1dbe7-0faf-48a3-a24c-d67539ac5c49",
                                                "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                                "text": "Ich selbst habe das Essen gekocht."
                                            },
                                            {
                                                "example_id": "4eed98ec-e18c-4de1-a5f1-86f1ca5d59ea",
                                                "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                                "text": "Ich habe das Essen selbst gekocht."
                                            },
                                            {
                                                "example_id": "6aa90c3f-a30b-4912-9b96-e7011934e780",
                                                "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                                "text": "„Es waren die Tunesier selbst, die sich ihres Despoten entledigten …“"
                                            },
                                            {
                                                "example_id": "59495a9b-00f8-4891-8e93-44c3c5df0eab",
                                                "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                                "text": "„Natürlich weiß Töpfer selbst, dass Merkels Arbeitskreis aus der Not geboren war.“"
                                            },
                                            {
                                                "example_id": "c212ebec-5988-4937-b799-dc8ee44adf5f",
                                                "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                                "text": "„Mitunter stoßen die Fahnder bei dem Procedere auch auf Steuersünder, die sich selbst angezeigt haben - ein Beleg für die Authentizität des Materials.“"
                                            },
                                            {
                                                "example_id": "578380b0-8c44-48d9-b1a9-c5d281fab7bb",
                                                "sense_id": "86f4f251-601f-3bac-ae4d-634b3bcaa34b",
                                                "text": "„Vieles, was ihr bislang in ihrer Biografie und in ihrem Verhalten als sonderbar erschienen war, was sie sich selbst auch übel genommen hatte, macht nun Sinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "selbst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                        "entry_id": "096675ec-17fd-397d-9d10-6b7562254f54",
                                        "glosses": [
                                            "auch, sogar (auch hier ist immer Kontrast zu anderen Möglichkeiten nötig)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e351c0b-9eb2-4da0-9a02-73b454d3bdbc",
                                                "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                                "text": "Selbst wenn du mir nicht glaubst,… (Fokuspartikel)"
                                            },
                                            {
                                                "example_id": "75376db8-ab28-47ef-ac0c-3c62d6b1f5cb",
                                                "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                                "text": "Selbst der König kam zu unserem Haus. (Fokuspartikel)"
                                            },
                                            {
                                                "example_id": "4661ba70-2ec6-49a0-bb04-0e6acb1dbb4e",
                                                "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                                "text": "„Selbst in den Bundesländern wird inzwischen indirekt eingeräumt, dass die Bahn in der Vergangenheit großzügig bedacht wurde.“"
                                            },
                                            {
                                                "example_id": "b737a5d9-1270-4b00-98f3-117dca62616d",
                                                "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                                "text": "„Selbst wenn man wie ich der Meinung ist, man könnte diese Tiere auch gern einfach in Ruhe lassen, ist der Anblick eines Wales, der an seiner Schwanzflosse, der Fluke, langsam an Land gezogen wird, überwältigend.“"
                                            },
                                            {
                                                "example_id": "e12502bc-66bf-4c48-b01d-7ad947ec466f",
                                                "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                                "text": "„Selbst der Steinbruch in der Eifel ist bekannt, aus dem der Mühlstein stammt, mit dem Legionäre in Hedemünden ihr Getreide mahlten.“"
                                            },
                                            {
                                                "example_id": "2636027d-501e-4a2f-8262-3572a39c2f6b",
                                                "sense_id": "8ae6167b-0b10-392a-abeb-187e25e335e0",
                                                "text": "„Doch selbst wer weniger als 20 Zigaretten täglich raucht, riskiert eine Lungenfunktionsstörung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24ef85db-02f1-4459-8202-25b443ebb431",
                        "source_entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
