                "senses": [
                    {
                        "sense_id": "1bb0b01d-dd6c-33b5-b55a-5f01166791f1",
                        "entry_id": "738be2f0-7996-3e32-ad9f-a741e233fefd",
                        "glosses": [
                            "Qui civilise, qui répand la civilisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0416f29-4cd5-43fe-bf5b-bb06fd06b60d",
                                "sense_id": "1bb0b01d-dd6c-33b5-b55a-5f01166791f1",
                                "text": "En effet, la mission de la Compagnie n’était pas civilisatrice. Au contraire. Dans son propre intérêt, elle devait maintenir à l’état de terrains vagues son immense domaine."
                            },
                            {
                                "example_id": "53e5b23e-03df-4ef8-8238-412bf569a499",
                                "sense_id": "1bb0b01d-dd6c-33b5-b55a-5f01166791f1",
                                "text": "Jacques avait rêvé du rôle civilisateur de la France, il avait cru qu’il trouverait dans le ksar des hommes conscients de leurs missions, préoccupés d’améliorer ceux que, si entièrement, ils administraient… (Isabelle Eberhardt, Le Major, 1903)"
                            }
                        ]
                    }
                ],
