                "translations": [
                    {
                        "translation_id": "19e4827e-e33f-4cd3-97a0-63579070cf66",
                        "source_entry_id": "6963c99d-fe45-39d9-b34d-32231f503c80",
                        "source_sense_id": "b2c7682c-4305-35de-a194-3aeebea576e2",
                        "target_lang_word": "observant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ce4fdb7-da92-3ece-b43c-96466a7cced7",
                                        "entry_id": "9fd326ff-58c1-3596-adf2-44c41ca68157",
                                        "glosses": [
                                            "Alert and paying close attention; watchful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea197723-0097-463e-b6c9-e0ff1a1cea94",
                                                "sense_id": "4ce4fdb7-da92-3ece-b43c-96466a7cced7",
                                                "text": "The observant police officer noticed that my tax disk was out-of-date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                        "entry_id": "9fd326ff-58c1-3596-adf2-44c41ca68157",
                                        "glosses": [
                                            "Diligently attentive in observing a law, custom, duty or principle; regardful; mindful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f8b700-d75a-4b95-9446-08c0ca46e61b",
                                                "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                                "text": "I was normally observant of the local parking restrictions."
                                            },
                                            {
                                                "example_id": "dc82bbc7-658f-4a5f-85c1-deca393b18b1",
                                                "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                                "text": "We are told how observant Alexander was of his master Aristotle."
                                            },
                                            {
                                                "example_id": "f4ed88f1-1d7c-42b6-b3c8-4df166acf343",
                                                "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                                "text": "They also profess Buddhism, but are not so observant of its customs, nor are there so many monasteries and Lamas to be met with as in the other part of Bhutan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293d08be-8e74-3d60-8287-692531d754a5",
                                        "entry_id": "9fd326ff-58c1-3596-adf2-44c41ca68157",
                                        "glosses": [
                                            "Practicing a religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03faf73-e252-4f94-a49e-855adff60c4d",
                                                "sense_id": "293d08be-8e74-3d60-8287-692531d754a5",
                                                "text": "She is an observant Catholic who goes to church regularly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
