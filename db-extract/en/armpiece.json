                        "entry_id": "7d8fcb5c-db29-3f76-9458-a8f5c3f7942f",
                        "glosses": [
                            "A piece of armour that protects the arm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10af6abb-ea7c-4641-a99e-90a586c0dee5",
                                "sense_id": "cd5d0b20-9c03-3d44-bfd3-4d39cb820187",
                                "text": "“Go, my good St. John,—in an arm-piece of the Milanese armor that hangs on the wall, thou’lt find the Seal!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "fa79bf73-bc46-35ad-9a72-ff8bc9eb9997",
                        "entry_id": "7d8fcb5c-db29-3f76-9458-a8f5c3f7942f",
                        "glosses": [
                            "A decorative companion."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3ff42081-6972-49d3-89c9-bb9f7253b925",
                                "sense_id": "fa79bf73-bc46-35ad-9a72-ff8bc9eb9997",
                                "text": "He'd decided to take her because she was the best looking armpiece of all, and as long as she kept her mouth shut, he'd be the envy of every man there."
                            },
                            {
                                "example_id": "0b2fe4cb-927a-4a6d-b1bb-aa2ca8adc637",
                                "sense_id": "fa79bf73-bc46-35ad-9a72-ff8bc9eb9997",
                                "text": "Years of being his armpiece have taught her exactly how to handle this situation; she is suddenly sure of it."
                            },
                            {
                                "example_id": "1c5e6634-c5d8-4bdd-87e3-7a58699e2ba5",
                                "sense_id": "fa79bf73-bc46-35ad-9a72-ff8bc9eb9997",
                                "text": "Madeline was in on the routine, and shortly after Louise exited, the swain and his armpiece departed for their outing to Little's Music Shop."
                            }
                        ]
                    }
                ],
