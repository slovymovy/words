                "senses": [
                    {
                        "sense_id": "c37b8eaa-6d8b-3b8e-a8d7-b2f468076619",
                        "entry_id": "50479a6f-5920-3d55-b953-cbc27acdc558",
                        "glosses": [
                            "Zeitpunkt, zu dem die Sonne im Laufe eines Sonnenjahres die größte nördliche oder südliche Deklination erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b4c3f6-2a2e-47e8-bb69-a3db0c7e38a9",
                                "sense_id": "c37b8eaa-6d8b-3b8e-a8d7-b2f468076619",
                                "text": "„Als Humboldt kurz darauf seine Instrumente einpackte, wußte er, daß die Sonne am Tag des Solstitiums von der Chaussee aus gesehen genau über der Spitze der größten Pyramide auf- und durch die Spitze der zweitgrößten unterging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41aabcf4-8ad9-4f46-93e3-defa2d1e1c88",
                        "source_entry_id": "50479a6f-5920-3d55-b953-cbc27acdc558",
                        "source_sense_id": "c37b8eaa-6d8b-3b8e-a8d7-b2f468076619",
                        "source_sense_description": "Zeitpunkt, zu dem die Sonne im Laufe eines Sonnenjahres die größte nördliche oder südliche Deklination erreicht",
                        "target_lang_word": "solstice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solstice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6578368-b32a-331b-8bf7-a569a81d4ee6",
                                        "entry_id": "296670da-84ca-3988-bdbd-4c9ce570f168",
                                        "glosses": [
                                            "One of the two points in the ecliptic at which the sun is furthest from the celestial equator. This corresponds to one of two days in the year when the day is either longest or shortest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820a4c2a-8b7c-4916-89cb-24809f458a95",
                                                "sense_id": "b6578368-b32a-331b-8bf7-a569a81d4ee6",
                                                "text": "The point at which the sun is nearest to the south pole we call the winter solstice, and the opposite point, the summer solstice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02e9d5eb-e8fa-4c66-902a-cdae02d9f551",
                        "source_entry_id": "50479a6f-5920-3d55-b953-cbc27acdc558",
                        "source_sense_id": "c37b8eaa-6d8b-3b8e-a8d7-b2f468076619",
                        "source_sense_description": "Zeitpunkt, zu dem die Sonne im Laufe eines Sonnenjahres die größte nördliche oder südliche Deklination erreicht",
                        "target_lang_word": "solstice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solstice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a591db3-6c6e-39dd-aa8d-82260330d176",
                                        "entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                                        "glosses": [
                                            "Chacune des deux époques où le Soleil est arrivé à son plus grand éloignement de l’équateur et paraît être stationnaire pendant quelques jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c8838e-be22-4380-a751-68a7a9bf8e2b",
                                                "sense_id": "7a591db3-6c6e-39dd-aa8d-82260330d176",
                                                "text": "Les solstices marquent les moments de l’année où les hémisphères reçoivent des quantités de lumière solaire les plus contrastées – et que les jours et les nuits sont les plus inégaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22e5ce60-3f4b-3baa-bf00-ecd7abc7c7af",
                                        "entry_id": "11a28497-352b-3e01-81c4-7db2098ca4b6",
                                        "glosses": [
                                            "Jour comprenant cet évènement, dont le jour (par opposition à la nuit) est le plus long ou le plus court dans une année."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fa40612-4335-4cc3-b22a-ec5d2a9c5fe6",
                                                "sense_id": "22e5ce60-3f4b-3baa-bf00-ecd7abc7c7af",
                                                "text": "Le calendrier chinois est luni-solaire, c’est-à-dire qu’il est basé sur l’année solaire débutant au solstice d’hiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
