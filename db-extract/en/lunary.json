                                "sense_id": "2812f106-4559-3989-9f15-21fa5f591a30",
                                "text": "Accordingly she visits the witch, Dipsas, by whose magic aid the youth, found resting on a bank of lunary, is bewitched to sleep until old age."
                            }
                        ]
                    },
                    {
                        "sense_id": "67f48a5d-838a-3a2a-9391-25a47935cd4c",
                        "entry_id": "81d6361d-e1bc-360e-afd2-4e0319de208b",
                        "glosses": [
                            "honesty, any plant in the genus Lunaria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e12569-7f5e-4295-9ef7-aa9e7dc75149",
                                "sense_id": "67f48a5d-838a-3a2a-9391-25a47935cd4c",
                                "text": "[10] The aloe, by the Egyptians, is reputed to resist any baleful influence, and the lunary or \"honesty\" is by our own country people said to put every evil influence to flight."
                            }
                        ]
                    }
