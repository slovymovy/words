                "senses": [
                    {
                        "sense_id": "8a2a44c8-80ed-31fd-a519-ca4f3ad3f427",
                        "entry_id": "46904303-047e-3241-9033-605083b75490",
                        "glosses": [
                            "untergeordneter Teilsatz, der ein vom Verb gefordertes Satzglied vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ee6880-bf57-410f-bfc4-c6a415bb56f5",
                                "sense_id": "8a2a44c8-80ed-31fd-a519-ca4f3ad3f427",
                                "text": "„Es handelt sich also um Hauptsätze in der ersten Person Singular oder Plural (ich/wir), denen sich ein Komplementsatz anschließt, der mit »dass« eingeleitet wird.“"
                            },
                            {
                                "example_id": "193f6e1e-38c0-4407-bbff-d01367cf6290",
                                "sense_id": "8a2a44c8-80ed-31fd-a519-ca4f3ad3f427",
                                "text": "„Viele Grammatiken nennen diese drei als wichtigste Typen von Komplementsätzen. … Der reine Inhaltssatz ist der dass-Satz. Ihm stehen die ob- und w-Sätze als indirekte Fragesätze gegenüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
