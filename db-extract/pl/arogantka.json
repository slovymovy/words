                                        "glosses": [
                                            "chi \\\"si fa forza\\\" ingiustamente contro qualcuno, talvolta sfavorendolo, basandosi su qualcosa per la quale ha certezza o sospetto e/o presume l'altrui \\\"non-conoscenza\\"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
