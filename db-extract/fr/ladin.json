            {
                "entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                "word": "ladin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "26165ae3-eb3e-4b62-8bec-bd06c98769e9",
                        "entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "ladins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85b5195b-3b2b-3f61-9d03-04e403688add",
                        "entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                        "glosses": [
                            "Groupe de langues romanes proches du romanche et du frioulan parlées dans les Dolomites, pour l’essentiel dans le Frioul, le Trentin-Haut-Adige et en Vénétie. Il s’agit de l’une des langues les plus rares d’Europe. Il en existe deux variétés : le ladin du Val Badia (lld-bad) et le ladin du Val Gardena (lld-grd)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0576d1-1d2c-4f19-87a9-3f3fd19be1d5",
                                "sense_id": "85b5195b-3b2b-3f61-9d03-04e403688add",
                                "text": "Le ladin actuel comprend cinq dialectes : le maréo ou badiot, le gherdëina, le fascian, l’anpezan et le fodom ; il existe une langue écrite standard, le ladin standard ou ladin dolomitan."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a1d72a7-9d52-3a0a-891b-2e099366e60f",
                        "entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                        "glosses": [
                            "Dialectes romanches parlés en Engadine, dans le canton des Grisons, en Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9100244-21f1-4c16-bf36-720e6a3abe11",
                                "sense_id": "5a1d72a7-9d52-3a0a-891b-2e099366e60f",
                                "text": "Le ladin regroupe le dialecte romanche de Haute-Engadine, aussi appelé le puter et celui de Basse-Engadine, le vallader."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fac663ca-0461-4073-b4c7-f8524c18e2d4",
                        "source_entry_id": "6381454e-2d17-3b51-a1ab-233ff969a7f0",
                        "target_lang_word": "ladinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ladinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c62c567-4d36-3f52-979e-5f8f9d7664f1",
                                        "entry_id": "6e9936a5-7f57-3d8f-9eba-6ecacfed9510",
                                        "glosses": [
                                            "die Ladiner betreffend, zu den Ladinern gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263d51d9-ab0f-4586-9146-850812bcbfa5",
                                                "sense_id": "1c62c567-4d36-3f52-979e-5f8f9d7664f1",
                                                "text": "Zu den ladinischen Sagen gehören auch viele Erzählungen über die „ganes“ und „salvans“, die guten Waldmenschen."
                                            },
                                            {
                                                "example_id": "efa3c1c4-02fc-4a2b-8741-f370649ac3a2",
                                                "sense_id": "1c62c567-4d36-3f52-979e-5f8f9d7664f1",
                                                "text": "Berühmt ist Gröden, ein ladinisches Sprachgebiet, aber nicht nur wegen des Bergsports, sondern auch wegen seiner Holzschnitzereien."
                                            },
                                            {
                                                "example_id": "8012ec71-996a-451a-bb53-0848d5da7785",
                                                "sense_id": "1c62c567-4d36-3f52-979e-5f8f9d7664f1",
                                                "text": "Im Gleichklang mit dem europäischen Zeitgeist des 19. Jahrhunderts entwickelte die ladinische Bevölkerung in dieser Zeit ein besonderes „Nationalbewußtsein“."
                                            },
                                            {
                                                "example_id": "c59054d2-46d0-4324-b9a0-363294d069e0",
                                                "sense_id": "1c62c567-4d36-3f52-979e-5f8f9d7664f1",
                                                "text": "Das erste vollständige Buch in ladinischer Sprache ist die Storia d’S. Genofefa von Jan Matî Delcara aus dem Jahr 1878."
                                            },
                                            {
                                                "example_id": "b80200e1-9cbf-4836-bc7e-3ce65bcf819c",
                                                "sense_id": "1c62c567-4d36-3f52-979e-5f8f9d7664f1",
                                                "text": "Darauf deuten beispielsweise die Kunsthandwerksläden hin, die ladinische Schnitzereien und Schmiedearbeiten anbieten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
