                    {
                        "sense_id": "c2f962fb-4949-353d-b98c-36bf3ba2a203",
                        "entry_id": "79cc2a5e-83ce-3a71-9983-d2652ee100d6",
                        "glosses": [
                            "A female given name, related to Maeve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7e03c6-c366-4f13-98ca-a19b2bdb9ac4",
                                "sense_id": "c2f962fb-4949-353d-b98c-36bf3ba2a203",
                                "text": "\"Good-bye, Mab,\" said Mr. Ford, stretching out his arm, and gathering her to his heart. \"Good-bye, darling - you will think of the old man, eh?\" Tears and kisses were Mab's only reply."
                            },
                            {
                                "example_id": "6acac69e-a169-46e8-a6eb-b06c2a611b85",
                                "sense_id": "c2f962fb-4949-353d-b98c-36bf3ba2a203",
                                "text": "“Consider,” Mab said, “that I have done something for her that you never could have.” “What's that, exactly?” “I have put her beyond the reach of the White Council and their Wardens,” Mab said, again […]"
                            }
                        ]
                    }
