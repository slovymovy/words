                                            {
                                                "example_id": "593480d5-44eb-4ea8-be0d-3f2c4c6e471f",
                                                "sense_id": "342cf277-44bd-3a3c-917b-63cbf3525dbd",
                                                "text": "[…] and the modern reader, who finds that races, boxing-matches, and wrestlings do in truth supply the chief occasions of Pindar's poetry […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9759729-d65c-3274-81bd-6ca675939c3c",
                                        "entry_id": "2d227302-eb5b-37e7-9a40-ea6d322b6bdf",
                                        "glosses": [
