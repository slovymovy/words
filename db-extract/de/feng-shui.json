                    {
                        "sense_id": "7769b8d8-5938-356e-a7df-01c968f0e223",
                        "entry_id": "6153fc40-4bc0-3871-a93d-64bb2d649312",
                        "glosses": [
                            "eine ganzheitliche Lehre, die Räume in Harmonie mit den darin lebenden und arbeitenden Menschen und ihrer Umgebung zu bringen versucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab80b41-1b26-4294-b9e3-952d61abe698",
                                "sense_id": "7769b8d8-5938-356e-a7df-01c968f0e223",
                                "text": "Der Raum ist nach den Regeln des Feng-Shui eingerichtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
