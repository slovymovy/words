                "senses": [
                    {
                        "sense_id": "9798e5cb-2e41-3a22-a2ca-cd896af62af2",
                        "entry_id": "9f148e6a-da48-3144-8005-75f2c347e417",
                        "glosses": [
                            "eine Art der Makaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b001baf7-e312-437b-8d56-8195218dbb11",
                                "sense_id": "9798e5cb-2e41-3a22-a2ca-cd896af62af2",
                                "text": "„Die Bartaffen sind auf Grund der Zerstörung ihres Lebensraums und der Jagd auf ihr Fleisch stark bedroht.“"
                            },
                            {
                                "example_id": "bfb78e91-216a-4566-a823-5b4ee47f2caf",
                                "sense_id": "9798e5cb-2e41-3a22-a2ca-cd896af62af2",
                                "text": "„Bartaffen nennt man auch Wanderus und gehören genauso wie die Rhesusaffen zu den Makaken.“"
                            },
                            {
                                "example_id": "66da0b9b-f0a2-48b8-b881-263809155205",
                                "sense_id": "9798e5cb-2e41-3a22-a2ca-cd896af62af2",
                                "text": "„Seit Ostersonntag wurde im Zoo Leipzig ein Bartaffe nach einem Einbruch in das Gehege vermisst. Das Bangen um das Schicksal des gestohlenen Affen hat nun ein Ende. Ein Jogger entdeckte das Tier und meldete es der Polizei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
