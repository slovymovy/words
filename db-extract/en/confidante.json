    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                "word": "confidante",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0b79d6a4-deee-42bc-a6bf-cbcc0f7477c7",
                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                        "tags": [
                            "plural"
                        ],
                        "form": "confidantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c7634cb-7cb3-3319-b5c0-2eb649a42ef0",
                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                        "glosses": [
                            "A female confidant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "122ca842-0f8a-4508-a1b2-206705d7b7fc",
                                "sense_id": "1c7634cb-7cb3-3319-b5c0-2eb649a42ef0",
                                "text": "Dany’s descent into madness is coming, of that there’s no doubt, especially given that the episode ends with the execution of her confidante Missandei."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c883e5a-9fdb-394a-80a0-476300de6db2",
                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                        "glosses": [
                            "A type of settee having a seat at each end at right angles to the main seats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961096f6-3c46-4b17-9032-a434dda33e96",
                                "sense_id": "9c883e5a-9fdb-394a-80a0-476300de6db2",
                                "text": "Meanwhile, Sally peels herself from the stage's only prop – a green-velvet confidante – and staggers off into the wings."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                        "glosses": [
                            "Nonstandard spelling of confidant (male)."
                        ],
                        "tags": [
                            "alt-of",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "40d610a4-eed6-4522-aac4-c74c2ceecdba",
                                "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                "text": "To Major Smiley, as his friend, his adviser, and his confidante, Adolphus Fitzopal had opened his heart […]"
                            },
                            {
                                "example_id": "48bd7a1c-3d76-493f-a031-926ff3bd3bc8",
                                "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                "text": "Henry Wilberforce was one of his few confidantes, certainly the one of longest standing, now that Bowden and Froude were gone and Rogers declined to correspond with him."
                            },
                            {
                                "example_id": "95ec25cc-0030-4aba-b206-e6fd23de4636",
                                "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                "text": "The fortunate confidante is lost in anonymity. He is a character who has always intrigued biographers […] [but] nothing is known about his name or his personal history."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbfc69c6-bc62-4569-820d-c84670c70221",
                        "source_entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                        "source_sense_description": "female confidant",
                        "target_lang_word": "Vertraute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertraute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08198db2-4d4b-3a49-9caa-649299305e30",
                                        "entry_id": "08754d85-e72e-3b0d-8e1e-40c13ff003e3",
                                        "glosses": [
                                            "weibliche Person, der man vertraut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e78c6f3-f063-4644-9148-4efeef3461ec",
                                                "sense_id": "08198db2-4d4b-3a49-9caa-649299305e30",
                                                "text": "„Die Vernehmer sprechen von Pasternaks Tod, um die Vertraute des Dichters zu brechen.“"
                                            },
                                            {
                                                "example_id": "6f84550b-74ad-4089-9a5b-987c1ceafe87",
                                                "sense_id": "08198db2-4d4b-3a49-9caa-649299305e30",
                                                "text": "„Die frühere Vertraute von Wolfgang Schüssel war von Molterer installiert worden.“"
                                            },
                                            {
                                                "example_id": "b9139381-3f0b-4652-bac8-33e0ee030d1a",
                                                "sense_id": "08198db2-4d4b-3a49-9caa-649299305e30",
                                                "text": "„Hintergrund ist ein Korruptionsskandal um eine enge Vertraute der konservativen Politikerin.“"
                                            },
                                            {
                                                "example_id": "245fcf35-14da-4667-a642-5367c159cd03",
                                                "sense_id": "08198db2-4d4b-3a49-9caa-649299305e30",
                                                "text": "„Merkel selbst hat ebenfalls ein paar Getreue von einst einladen dürfen. Möglicherweise auch ihre Freundin und Vertraute, die ehemalige Bildungsministerin Annette Schavan.“"
                                            },
                                            {
                                                "example_id": "f40d0579-513b-41db-ade8-44080213b3f2",
                                                "sense_id": "08198db2-4d4b-3a49-9caa-649299305e30",
                                                "text": "„Lady Rochford, der nachgesagt wird, schon bei dem Prozess gegen Anne Boleyn sehr belastende Aussagen gemacht zu haben und die die Vertraute von Catherine war, spielte auch in diesem Prozess eine Schlüsselrolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
