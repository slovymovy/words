                        "examples": [
                            {
                                "example_id": "eebcbe2e-20d8-4f36-b598-6797b4ca917b",
                                "sense_id": "6b4c7a78-9ded-3b6f-9545-8440b60ec24f",
                                "text": "„Einer im November 1998 vom Parlament verabschiedeten Generalamnestie entsprechend, wird die Strafe um ein Drittel verkürzt.“"
                            },
                            {
                                "example_id": "f8a9cf86-49e4-4fae-b713-6bcdf0700136",
                                "sense_id": "6b4c7a78-9ded-3b6f-9545-8440b60ec24f",
                                "text": "„Er sprach eine Generalamnestie für alle Einwohner Afghanistans, die unter ʿAbdur Rahman das Land verlassen hatten, aus.“"
                            },
                            {
                                "example_id": "a724ee00-9d2e-4670-80e7-9b1215857346",
                                "sense_id": "6b4c7a78-9ded-3b6f-9545-8440b60ec24f",
                                "text": "„Ein Vertrags wurde unterzeichnet, eine Generalamnestie für alle früheren Feinde Roms erlassen, und ein Ehevertrag wurde aufgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
