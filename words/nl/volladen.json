                    "common_phrases": [
                        "de vrachtwagen volladen",
                        "het ruim volladen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fill the cargo space of a vehicle or vessel to its maximum capacity."
                    },
                    "translations": {
