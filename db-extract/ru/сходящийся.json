                "senses": [
                    {
                        "sense_id": "ef0f6035-e097-3ac0-80e2-bafb1ed9f3d8",
                        "entry_id": "e51b312d-58c1-30dd-982e-a5cfaf9b8efa",
                        "glosses": [
                            "действ. прич. наст. вр. от сходиться"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "030a456c-2ab1-3293-9a46-f5ddd71cf96b",
                        "entry_id": "e51b312d-58c1-30dd-982e-a5cfaf9b8efa",
                        "glosses": [
                            "матем. стремящийся, приближающийся к какому-либо пределу"
                        ],
                        "tags": [
                            "о ряде, интеграле"
                        ],
                        "examples": [
                            {
                                "example_id": "a429cb4b-91cd-4368-97a4-ca754a82f928",
                                "sense_id": "030a456c-2ab1-3293-9a46-f5ddd71cf96b",
                                "text": "Важным средством исследования служит при этом сходящаяся бесконечная геометрич. прогрессия."
                            },
                            {
                                "example_id": "2a741669-d0e3-4733-a5d7-99be622ab36c",
                                "sense_id": "030a456c-2ab1-3293-9a46-f5ddd71cf96b",
                                "text": "Стандартным приёмом измерения различных площадей и объёмов, не поддающихся определению элементарными средствами, стал исчерпывания метод, состоящий в приближении искомой величины сходящимися к ней снизу и сверху последовательностями известных величин."
                            }
                        ]
                    }
