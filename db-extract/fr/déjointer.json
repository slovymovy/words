                "senses": [
                    {
                        "sense_id": "9a62ac72-4eac-387f-93dc-4411a066deda",
                        "entry_id": "0c383a95-8fd5-3d7c-8b78-cf2ece7d379b",
                        "glosses": [
                            "Rendre indépendant, séparer d’un ensemble ce qui était joint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9146ae3-0c7c-4064-8f6f-da6a0bd32cea",
                                "sense_id": "9a62ac72-4eac-387f-93dc-4411a066deda",
                                "text": "Ciseaux et masses pour déjointer les pierres des remparts, merlins d’acier pour briser les serrures, grands filets à mailles solides que l’on porte à deux cavaliers pour \"capter\" des prisonniers en rase campagne, lacets - sortes de lassos - pour \"jeter bas\" cavaliers ou sentinelles, lourds poignards dont le manche peut servir de matraque."
                            },
                            {
                                "example_id": "00057cc4-fc86-49aa-939e-13779f781637",
                                "sense_id": "9a62ac72-4eac-387f-93dc-4411a066deda",
                                "text": "Pour les volailles, déjointer la pièce de viande de la carcasse."
                            },
                            {
                                "example_id": "8be07bc8-d80c-4d59-be55-d16ad45e3322",
                                "sense_id": "9a62ac72-4eac-387f-93dc-4411a066deda",
                                "text": "Cette robuste machine sert à défaïencer, rainurer, déjointer en créant de petites ouvertures et de reprise de fers à béton."
                            }
                        ]
                    }
                ],
