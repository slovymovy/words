                "senses": [
                    {
                        "sense_id": "ef634ca6-5c99-3ae7-bf7e-f22849b94708",
                        "entry_id": "79900c80-7d76-3903-aee3-fa0c37992c70",
                        "glosses": [
                            "Verletzung eines Menschen in seiner Würde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5688f86-edf4-4dc0-84ec-84b95cc47eff",
                                "sense_id": "ef634ca6-5c99-3ae7-bf7e-f22849b94708",
                                "text": "„Die Zeit der Rassentrennung und Entwürdigung, der fortlaufenden Kränkungen müsse endlich vorbei sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc6808fe-575a-431e-b5fe-69b5ca245627",
                        "source_entry_id": "79900c80-7d76-3903-aee3-fa0c37992c70",
                        "source_sense_id": "ef634ca6-5c99-3ae7-bf7e-f22849b94708",
                        "source_sense_description": "Verletzung eines Menschen in seiner Würde",
                        "target_lang_word": "debasement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debasement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94dd7975-79d9-3096-8502-95f76d1dae99",
                                        "entry_id": "7f1c81b5-be66-3f7e-b870-0b37678191d5",
                                        "glosses": [
                                            "The act of debasing or the state of being debased; a lowering or degradation, especially in character or quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "889a8b7f-0ab6-4ff0-8e78-cb1c7022eafe",
                                                "sense_id": "94dd7975-79d9-3096-8502-95f76d1dae99",
                                                "text": "His large water-dog was acquainted with the fact, and upon the approach of his master, betrayed his sense of inferiority by a sanctity of deportment, a debasement of the ears, and a dropping of the lower jaw not altogether unworthy of a dog."
                                            },
                                            {
                                                "example_id": "8d701857-e1ed-40ae-a6e1-f19b0cf2e284",
                                                "sense_id": "94dd7975-79d9-3096-8502-95f76d1dae99",
                                                "text": "She had given herself to Darrow, and concealed the episode from Owen Leath, with no more apparent sense of debasement than the vulgarest of adventuresses."
                                            },
                                            {
                                                "example_id": "6c5735fc-1f83-4582-9dd0-74a48e959735",
                                                "sense_id": "94dd7975-79d9-3096-8502-95f76d1dae99",
                                                "text": "There's something ugly and fascinating about reading such intimate tales of debasement and depression and failure and self-doubt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1608bbb0-07d9-3ebc-9d84-44b038fb3351",
                                        "entry_id": "7f1c81b5-be66-3f7e-b870-0b37678191d5",
                                        "glosses": [
                                            "The lowering of the value of a currency by reducing the amount of valuable metal in the coins."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
