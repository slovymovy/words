                    {
                        "sense_id": "032e26f7-3fa4-3129-bf98-4ce9ff96161c",
                        "entry_id": "6ac664ce-7d5b-342a-876c-9fb97dbc48d5",
                        "glosses": [
                            "Variante orthographique de moyenâgeux (qui se rapporte au Moyen Âge, médiéval)."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "912f6399-3dc0-42b6-8d15-28655f1407d2",
                                "sense_id": "032e26f7-3fa4-3129-bf98-4ce9ff96161c",
                                "text": "Ces jugements contradictoires font écho à la complexité du personnage, à la fois batailleur, cupide, aveuglé par des chimères “ moyennageuses ” et pourtant d’une lucidité désespérée, rêvant de noblesse et se prêtant à des vilenies, contradictoire au point de finir sa vie dans un état semidélirant."
                            },
                            {
                                "example_id": "4b94a144-2ac1-4e09-b14f-e34cff716d98",
                                "sense_id": "032e26f7-3fa4-3129-bf98-4ce9ff96161c",
                                "text": "L’usage moyennageux de donner la préséance au prénom s’est conservé jusqu’à nos jours pour les saints, les papes, les évêques, les religieux ainsi que pour les princes régnants et les membres des maisons régnantes."
                            },
                            {
                                "example_id": "710b36c9-69ea-47b5-a260-02b238497025",
                                "sense_id": "032e26f7-3fa4-3129-bf98-4ce9ff96161c",
                                "text": "Nous appelons château le monument situé sur le tènement du Lébous, dans la commune de Saint-Mathieu de Tréviers pour la simple raison qu’il a, sur plan, exactement la forme d’une forteresse moyennageuse."
                            }
                        ]
                    }
                ],
