            "senses": [
                {
                    "sense_id": "a8a887d4-8059-305b-ae66-8dcd369f571b",
                    "sense_definition": "Provoquer de l'irritation, de l'agacement ou de l'impatience chez quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bruit incessant finit par m'<w>énerver</w> et m'empêche de me concentrer sur mon travail."
                        },
                        {
                            "text": "Ses remarques continuelles finissent par <w>énerver</w> tout le monde dans le bureau."
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "irriter",
                        "exaspérer"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "énerver tout le monde",
                        "commencer à énerver"
                    ]
                },
                {
                    "sense_id": "5df47c6a-f60a-38b3-a99f-a0284bb7007c",
                    "sense_definition": "Perdre patience ou manifester une vive agitation colérique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas s'<w>énerver</w> pour des broutilles sans aucune importance."
                        },
                        {
                            "text": "Elle s'<w>énerve</w> souvent contre ses collègues quand un projet prend du retard."
                        }
                    ],
                    "synonyms": [
                        "s'agacer",
                        "se fâcher",
                        "s'emporter"
                    ],
                    "antonyms": [
                        "se calmer",
                        "s'apaiser"
                    ],
                    "common_phrases": [
