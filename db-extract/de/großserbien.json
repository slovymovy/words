                "senses": [
                    {
                        "sense_id": "ee1c5cf1-4364-34b1-b397-324c6947fc98",
                        "entry_id": "5cbc42d3-328a-39cb-9c73-58e24a5b6b6c",
                        "glosses": [
                            "von serbischen Nationalisten forcierter, theoretischer Staat, der alle Gebiete, in denen Serben leben, vereinigen sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3146bf0b-2718-4eb7-90d5-28822b42b060",
                                "sense_id": "ee1c5cf1-4364-34b1-b397-324c6947fc98",
                                "text": "„Die UN-Menschenrechtskommission (seit 2006 UN-Menschenrechtsrat, UNHRC) verknüpft das Bestreben eines Staates oder eines Regimes, einem gemischten Gebiet eine ethnische Herrschaft aufzuzwingen (wie die Schaffung Großserbiens), mit dem Einsatz von Vetreibung und anderen Zwangsmaßnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
