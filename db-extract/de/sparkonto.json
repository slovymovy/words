                                "sense_id": "49d48ee2-bc5f-377c-ad18-36c52a7c78d9",
                                "text": "Geld auf das Sparkonto einzahlen.",
                                "translation": "Verser de l'argent sur le compte d'épargne."
                            }
                        ]
                    }
