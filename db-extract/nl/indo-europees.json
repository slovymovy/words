                "senses": [
                    {
                        "sense_id": "6718b9b5-9c8b-352e-8f84-e3cf95ef0adf",
                        "entry_id": "e7ef98fe-fb20-3c42-8fa3-febf7dc8b940",
                        "glosses": [
                            "groep van onderling verwante talen die zich historisch in Europa en het westen en zuiden van Azië hebben ontwikkeld"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1a85bafb-f218-467f-bd01-a1a446a67652",
                                "sense_id": "6718b9b5-9c8b-352e-8f84-e3cf95ef0adf",
                                "text": "Het Indo-Europees is de familie waartoe bijna alle Europese talen – inclusief het Nederlands – en flink wat West-Aziatische talen behoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "e83baca1-d4ad-3502-92b6-8ab74bdb66cb",
                        "entry_id": "e7ef98fe-fb20-3c42-8fa3-febf7dc8b940",
                        "glosses": [
                            "gereconstrueerde taal die de verre voorganger is van veel talen die zich historisch in Europa en het westen en zuiden van Azië hebben ontwikkeld"
                        ],
                        "tags": [
                            "linguistics"
                        ],
                        "examples": [
                            {
                                "example_id": "0c3cb417-5d2b-4c09-8ea0-5bd13fb18b71",
                                "sense_id": "e83baca1-d4ad-3502-92b6-8ab74bdb66cb",
                                "text": "In zeven hoofdstukken beschrijft zij hoe het Nederlands uit het Indo-Europees is ontstaan."
                            }
                        ]
                    }
                ],
