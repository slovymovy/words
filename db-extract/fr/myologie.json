                        "glosses": [
                            "Partie de l’anatomie qui traite des muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88cab13-11db-4e53-aba7-d9ade2efcbfe",
                                "sense_id": "dbe34c0a-dfd9-3d0e-bddf-153ac556f968",
                                "text": "La myologie (myologia) est la science qui étudie les muscles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c74229b0-8f09-4310-8cc4-69b1ceb7683f",
                        "source_entry_id": "848f37e1-72ba-3159-8530-58310c588da4",
