                                "target_senses": [
                                    {
                                        "sense_id": "6e4818a9-e0da-3d3e-9c54-ba3767038e59",
                                        "entry_id": "a01608bc-c6ca-34b6-b3bf-f4234adc0fe2",
                                        "glosses": [
                                            "festliches Kleid, das nur zu bestimmten Anlässen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6477df1a-3499-4f45-9bc7-0939d4ec6b3b",
                                                "sense_id": "6e4818a9-e0da-3d3e-9c54-ba3767038e59",
                                                "text": "Die junge Dame hatte eine prunkvolle rosa Robe an und zog alle Blicke auf sich."
                                            },
                                            {
                                                "example_id": "51223d2e-7a69-4642-a87f-a9788173c680",
                                                "sense_id": "6e4818a9-e0da-3d3e-9c54-ba3767038e59",
                                                "text": "„Eine Frau in einer weißen Robe mit weißem Pelzkragen hatte die Bildfläche betreten.“"
                                            },
                                            {
                                                "example_id": "badac65e-7702-4fde-a515-b50e76ff1eeb",
                                                "sense_id": "6e4818a9-e0da-3d3e-9c54-ba3767038e59",
                                                "text": "„Nun erwartete er nur noch die Ankunft der alten Dame, die versprochenermaßen ihm in die neue Robe der Miß Käte zu verhelfen gedachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01f8a6ae-de84-3315-8cbe-d45e8e0cc441",
                                        "entry_id": "a01608bc-c6ca-34b6-b3bf-f4234adc0fe2",
                                        "glosses": [
                                            "Talar"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b343c270-4680-4ef0-93cd-b9eada648484",
                                                "sense_id": "01f8a6ae-de84-3315-8cbe-d45e8e0cc441",
                                                "text": "Die Richter haben bereits in ihren schwarzen Roben Platz genommen."
                                            },
                                            {
                                                "example_id": "62d52db3-c021-4d9c-90f8-1538eb6ecaf4",
                                                "sense_id": "01f8a6ae-de84-3315-8cbe-d45e8e0cc441",
                                                "text": "„Dr. Grüner trägt einen blauen Pullover und eine helle Windjacke und wirkt deutlich jünger als in seiner Robe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
