                "senses": [
                    {
                        "sense_id": "ab51b6f6-dd9c-32ef-8482-6ceb081a9872",
                        "entry_id": "f895e070-b3fa-38cb-b96d-1addd275fa5a",
                        "glosses": [
                            "Cruche ou vase de terre cuite, poreux, dans lequel l’eau ou l’alcool ou le vin se rafraîchit par évaporation au travers la terre cuite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6718a55e-38d1-48ab-b355-24d43fbfcd89",
                                "sense_id": "ab51b6f6-dd9c-32ef-8482-6ceb081a9872",
                                "text": "Le carreau suintait comme un alcarazas."
                            },
                            {
                                "example_id": "581a122c-abc4-4649-ab5b-d51c3c553537",
                                "sense_id": "ab51b6f6-dd9c-32ef-8482-6ceb081a9872",
                                "text": "Le zir est un vase ventru, pétri dans une terre à la fois fine et poreuse comme celle des alcarazas."
                            },
                            {
                                "example_id": "542e0cc4-0b47-4192-976a-49c9489fff7e",
                                "sense_id": "ab51b6f6-dd9c-32ef-8482-6ceb081a9872",
                                "text": "L’évaporation qui se fait à la surface de l’éponge et à la surface de l’alcarazas leur enlève donc plus de chaleur que la tendance à l’équilibre de température avec le milieu ne leur en communique."
                            }
                        ]
                    }
                ],
