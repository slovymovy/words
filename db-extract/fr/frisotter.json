                "senses": [
                    {
                        "sense_id": "417e42ea-6d93-35bb-a1fc-6b4d63ba8b5f",
                        "entry_id": "61343ab3-9cb4-393b-af7e-ca2fb074e587",
                        "glosses": [
                            "Friser souvent et par menues boucles. Il ne se dit guère que par plaisanterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e43a11a5-db3e-4500-81f8-33c3f34110fa",
                                "sense_id": "417e42ea-6d93-35bb-a1fc-6b4d63ba8b5f",
                                "text": "Elle cherchait son souffle, se tamponnant le front avec un mouchoir de coton, les cheveux frisottés d'humidité, l'air effaré."
                            },
                            {
                                "example_id": "f9604447-8a2e-457a-abe6-9234abfcda4b",
                                "sense_id": "417e42ea-6d93-35bb-a1fc-6b4d63ba8b5f",
                                "text": "Elle s’amuse à frisotter sa fille. — Elle perd bien du temps à se frisotter."
                            }
                        ]
                    }
