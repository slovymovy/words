                "senses": [
                    {
                        "sense_id": "dbc04954-9438-3bde-8f5e-7d9fe1a0f3e1",
                        "entry_id": "4922d706-a9b9-3d08-bd0c-a55641a70777",
                        "glosses": [
                            "tendencja do zakładania, że wydarzenia potoczą się najgorszym z możliwych scenariuszy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75433e6d-c985-422d-ab88-857d0ae105f4",
                                "sense_id": "dbc04954-9438-3bde-8f5e-7d9fe1a0f3e1",
                                "text": "Z powodu wrodzonego pesymizmu Rozalia nie kupiła nigdy losu na żadną loterię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
