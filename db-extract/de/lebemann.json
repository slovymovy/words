                            "singular"
                        ],
                        "form": "den Lebemann"
                    },
                    {
                        "form_id": "0de8f905-2097-4eb1-9811-a28c5f3c6f8a",
                        "entry_id": "02a91e48-e94f-30a3-9356-e051396cf6b2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lebemänner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                        "entry_id": "02a91e48-e94f-30a3-9356-e051396cf6b2",
                        "glosses": [
                            "Mann, der möglichst viele Genüsse jeglicher Art für sich in Anspruch nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6210874-e2b1-42b6-857e-da3c24209716",
                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                "text": "„Er war ein Lebemann und kannte sich aus.“"
                            },
                            {
                                "example_id": "1cae14e4-62cc-4272-9e5d-3529442171d8",
                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                "text": "„Pückler bewundert ihn sehr dafür, aber auch, daß Barras es geschafft hat, als Lebemann und homme à femme die schwierigsten Zeitläufte zu überstehen.“"
                            },
                            {
                                "example_id": "cf55bfc0-9175-4596-bde2-d4cec084d54b",
                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                "text": "„Im Park von Sanssouci machte der große Friedrich dem großen Lebemann seine Aufwartung und weckte in ihm die Hoffnung auf eine Anstellung bei Hofe.“"
                            },
                            {
                                "example_id": "ee157aac-c5d5-4fce-82e7-86af1e45f6f3",
                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                "text": "„Der Dichter setzte sich als flamboyanter Lebemann in Szene.“"
                            },
                            {
                                "example_id": "d9fc8972-b33e-44f7-ae73-6334f3e063b2",
                                "sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                                "text": "„Trotz des Eintretens für einen Staat der Muslime auf dem Indischen Subkontinent war Jinnah selbst ein überzeugter Säkularist, privat war er nicht besonders religiös und galt eher als Lebemann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21ff2131-ab8b-4e12-910f-60e14aebbdfe",
                        "source_entry_id": "02a91e48-e94f-30a3-9356-e051396cf6b2",
                        "source_sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                        "source_sense_description": "Mann, der möglichst viele Genüsse jeglicher Art für sich in Anspruch nimmt",
                        "target_lang_word": "noceur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                        "entry_id": "4b88547e-96bc-3b60-a8b5-d8a15f055bd8",
                                        "glosses": [
                                            "Celui qui a une vie déréglée, qui fait trop la fête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abeb1e5a-eb7f-45dd-889d-514a3b903f9a",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "– Quel noceur ! se dit Joseph en employant une expression populaire passée dans les ateliers."
                                            },
                                            {
                                                "example_id": "5899014a-04f8-46be-918c-349e37bcb77a",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Paillardin. — Qu’est-ce que tu veux !… je ne suis pas un noceur, moi !… Je ne l’ai jamais été ! C’est même pour ça que je me suis marié ! Je n’avais pas de tempérament."
                                            },
                                            {
                                                "example_id": "7086e8f9-3a00-4c16-ae62-b64739f7199c",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Mongicourt.– Tiens ! moi, je suis un noceur réglé ! Je coordonne ma noce ! tout est là !… Savoir concilier ses plaisirs avec son travail !…"
                                            },
                                            {
                                                "example_id": "5de93acf-0647-469c-9e0d-7400ceabe7cc",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Certains caboulots, ici, ne ferment jamais réellement, et quel que soit l’heure, vous apercevez toujours, […], des noceurs, des gens en goguette."
                                            },
                                            {
                                                "example_id": "b63c7960-c3af-4d65-bea7-baf4dbf65b79",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Nous nous faisions la même idée mystique de l’amour – que nous ne concevions que sous la forme d’un amour unique, but et substance de toute une vie – et professions le même dégoût pour ces êtres volages que représentaient les « noceurs »."
                                            },
                                            {
                                                "example_id": "544c5e60-aec7-4795-aefa-5d6569984020",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Le matin du premier mai (qui, par ironie, se trouve être le jour de ma fête : el día de mi Santo) la rue que je devais prendre pour aboutir à la bouche du métro était jalonnée de vendeurs de muguet pour qui, à six heures du matin, j’étais le seul client avec un ou deux noceurs en smoking."
                                            },
                                            {
                                                "example_id": "367dea3b-3c97-4d49-ac7c-6abffa55d35b",
                                                "sense_id": "3cbbc10e-9229-32c2-bf9e-a86d3c638f5c",
                                                "text": "Bref, me voilà en route avec mes huit grosses valises, mes cinq tubars, le banquier Chauvassut, le noceur Clergerie, l’industriel Montagnoux, le poète Bois-Méard et le petit jeune homme de bonne famille, Gabriel Duplessis-Tournel. J’aurais très bien vu ces cinq cocos-là en uniforme bleu horizon avec un flingue baïonnette au canon, là bas, à Craonne, avec les copains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f59d95-50aa-35d1-85f2-192785ea3556",
                                        "entry_id": "4b88547e-96bc-3b60-a8b5-d8a15f055bd8",
                                        "glosses": [
                                            "Celui qui est invité à une noce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "noceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc2a3e71-cef4-32f3-859e-330dc719cc75",
                                        "entry_id": "aa0379f2-8c8b-3df0-86e5-153d2d8c9e7f",
                                        "glosses": [
                                            "Qui a une vie déréglée ; qui fait trop la fête."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4d6088-cd78-4bfc-a0f7-4d2e30038455",
                                                "sense_id": "cc2a3e71-cef4-32f3-859e-330dc719cc75",
                                                "text": "C’est un certain Méderic Gautruche, « ouvrier, noceur, gouapeur, rigoleur, faisant de la vie un lundi, rempli de la joie du vin, les lèvres perpétuellement humides d’une dernière goutte, […]. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f1e96ab-0bc7-4e31-884b-46db03ad7cef",
                        "source_entry_id": "02a91e48-e94f-30a3-9356-e051396cf6b2",
                        "source_sense_id": "595cdf0e-06bb-32b2-98e2-9482abaa308a",
                        "source_sense_description": "Mann, der möglichst viele Genüsse jeglicher Art für sich in Anspruch nimmt",
                        "target_lang_word": "bon-vivant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bon-vivant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f2a32a1-00a3-30f4-9e22-800d8d9cedf9",
                                        "entry_id": "94ba2591-c67d-3883-a7ca-402e13f98a33",
                                        "glosses": [
                                            "Se dit d'une personne qui apprécie les plaisirs de la vie, notamment les plaisirs de la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7c3155-c6f3-4ae3-a717-f1c558f2024d",
                                                "sense_id": "5f2a32a1-00a3-30f4-9e22-800d8d9cedf9",
                                                "text": "Les gens tenaient farouchement à leur liberté. Ils étaient vivants. Bien vivants. Et bons-vivants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
