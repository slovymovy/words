                            {
                                "example_id": "b660fe00-8a09-49d8-b9a2-7268418df159",
                                "sense_id": "d838a2c0-8192-3139-847f-8c6af853be78",
                                "text": "The original surgical antibiotic prophylaxis experiments were performed 40 years ago in pigs."
