                                    {
                                        "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A device with a mesh, grate, or otherwise perforated bottom to separate, in a granular material, larger particles from smaller ones, or to separate solid objects from a liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb9cc06-c413-4a8d-a967-5d8bf0429b78",
                                                "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                                "text": "Near-synonyms: sifter, strainer, temse"
                                            },
                                            {
                                                "example_id": "c8f3aec2-2bd7-4352-832c-c50cd547dafd",
                                                "sense_id": "61bd576a-6d98-3c3a-a046-6cc63054ad96",
                                                "text": "Use the sieve to get the pasta from the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8117a8-6233-39cb-b791-2e0ec5a4579a",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A process, physical or abstract, that arrives at a final result by filtering out unwanted pieces of input from a larger starting set of input."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfb78d8-1475-4a43-82e5-1e732dca0a6d",
                                                "sense_id": "bb8117a8-6233-39cb-b791-2e0ec5a4579a",
                                                "text": "Given a list of consecutive numbers starting at 1, the Sieve of Eratosthenes algorithm will find all of the prime numbers."
                                            },
                                            {
                                                "example_id": "e9d545f4-2a16-417b-846b-4705cedab97f",
                                                "sense_id": "bb8117a8-6233-39cb-b791-2e0ec5a4579a",
                                                "text": "Among, ^([sic]) his other achievements, Matiyasevich and his colleague Boris Stechkin also developed an interesting “visual sieve” for prime numbers, which effectively “crosses out” all the composite numbers, leaving only the primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d5b0c34-d573-3812-b28f-60ee2e91f203",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A kind of coarse basket."
                                        ],
