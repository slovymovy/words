                "senses": [
                    {
                        "sense_id": "99fc17e5-b69b-37c7-bccf-152f3624747d",
                        "entry_id": "a225f68f-272a-31fd-92f7-fe6b153eb5ac",
                        "glosses": [
                            "The space between the top of the contents of a container (such as a jar) and its seal (such as a lid)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc9a1b8-8d94-4e7c-8c43-4eb95f325f84",
                                "sense_id": "99fc17e5-b69b-37c7-bccf-152f3624747d",
                                "text": "Control of headspace is important for economic and technical reasons. Underfilling will contravene Weights and Measures legislation and may cause rusting in the headspace […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c37c077d-ab07-3daa-a486-6bb07eba9db2",
                        "entry_id": "a225f68f-272a-31fd-92f7-fe6b153eb5ac",
                        "glosses": [
                            "One's capacity for mental activity modeled as a physical space with limits; one's mental state or state of mind."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d52404-151c-4dda-a6ad-e29d5d38ceab",
                                "sense_id": "c37c077d-ab07-3daa-a486-6bb07eba9db2",
                                "text": "Meronym: mindshare"
                            },
                            {
                                "example_id": "d4736527-714c-419d-bc6f-fa189cf20f85",
                                "sense_id": "c37c077d-ab07-3daa-a486-6bb07eba9db2",
                                "text": "It's like, I need to clear my headspace but I can't do that with him around because he's just ego, you know? He dumps on me. So that's it."
                            },
                            {
                                "example_id": "1d87d4b1-214b-41c0-88c8-7c7779e13b79",
                                "sense_id": "c37c077d-ab07-3daa-a486-6bb07eba9db2",
                                "text": "Harry looked pained. \"Please don't let me out of here. I really don't have the headspace for the moral implications of any of that right now. But as I was saying,\" he did so hate to be interrupted, it was the lecturing academic in him, \"if I wanted a third girlfriend, I'd choose from the pool of non-murderers.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "a39d9e88-f141-393c-83fd-f34872e58d84",
                        "entry_id": "a225f68f-272a-31fd-92f7-fe6b153eb5ac",
                        "glosses": [
                            "Time and opportunity for reflection and thinking."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd65e59-80ae-4b14-bc34-dc7f984f2dc3",
                                "sense_id": "a39d9e88-f141-393c-83fd-f34872e58d84",
                                "text": "As a business owner, a truly effective business owner that is building a profitable business machine, you need headspace, thinking time, planning time, brainstorming time, education time, decision making time, questioning time and more thinking time."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7d87dc2-7ef0-3f67-b81c-c9d9f3033f79",
                        "entry_id": "a225f68f-272a-31fd-92f7-fe6b153eb5ac",
                        "glosses": [
