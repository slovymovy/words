                        "sense_id": "7c2cdf69-ed47-33d1-8f35-47010bde89fb",
                        "entry_id": "a7d6a7fd-ee74-327b-9484-9294e59bea2f",
                        "glosses": [
                            "Clipping of dictionary."
                        ],
                        "tags": [
                            "abbreviation",
