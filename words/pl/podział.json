                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiele prostych bakterii rozmnaża się przez prosty <w>podział</w> komórki w sprzyjających warunkach.",
                            "target_lang_translations": {
                                "ru": "Многие простые бактерии размножаются простым <w>делением</w> клетки при благоприятных условиях."
                            }
                        },
                        {
                            "text": "Na lekcji biologii obserwowaliśmy pod mikroskopem <w>podział</w> komórkowy u pierwotniaków.",
                            "target_lang_translations": {
                                "ru": "На уроке биологии мы наблюдали под микроскопом клеточное <w>деление</w> у простейших."
                            }
                        }
