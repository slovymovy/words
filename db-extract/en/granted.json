            {
                "entry_id": "4785213b-6aef-3df9-ae80-c7a5c8f6ff04",
                "word": "granted",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                        "entry_id": "4785213b-6aef-3df9-ae80-c7a5c8f6ff04",
                        "glosses": [
                            "Used to concede a point or to express acknowledgment or awareness, often before stating some contrasting or competing information; used as an expression of respect to the point in question."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2fa8c054-ee64-4b58-8089-f45bc891aa62",
                                "sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                                "text": "He's a good student and usually does well. Granted, he did fail that one test, but I think there were good reasons for that."
                            },
                            {
                                "example_id": "52745b65-6b63-492d-bda9-33ac3fea290a",
                                "sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                                "text": "\"You haven't been a very good father.\" \"Granted.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a23095-ee66-4e7a-8551-678b144153f8",
                        "source_entry_id": "4785213b-6aef-3df9-ae80-c7a5c8f6ff04",
                        "source_sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                        "source_sense_description": "used to concede a point",
                        "target_lang_word": "zugegebenermaßen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugegebenermaßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                        "entry_id": "50735600-047c-358b-90c6-6390497af765",
                                        "glosses": [
                                            "etwas eingestehend; klein beigebend; eventuell kleinlaut seiend; wohl tatsächlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "386b1c15-6555-4e79-8aab-1b5f446c74ba",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "Ich habe zugegebenermaßen zu viel Schokolade gekauft."
                                            },
                                            {
                                                "example_id": "ba3e42cf-067a-4ffc-8239-40cbe1658fc8",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "„Die Eigner des Schiffes betrachteten die Todesfälle und die Tatsache, dass das Leben so vieler Menschen zerstört wurde, als normale Begleiterscheinung eines zugegebenermaßen schmutzigen Geschäfts.“"
                                            },
                                            {
                                                "example_id": "e97b5bb2-03f2-431b-9175-a2e90f6e4f66",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "„Dies war meine zugegebenermaßen spießbürgerliche Vorstellung davon, wie mein Leben nach meinem Studium aussehen sollte.“"
                                            },
                                            {
                                                "example_id": "edeaa06c-6484-4697-808f-7d00156fc158",
                                                "sense_id": "a3a5bd6a-503a-3626-8984-59b2deb1e764",
                                                "text": "„Abschalten, entspannen, zu sich kommen in der Zürcher Innenstadt − das klingt zugegebenermassen wie ein Widerspruch in sich selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee3776f2-38a6-4364-ac58-39a7d1bcd9dd",
                        "source_entry_id": "4785213b-6aef-3df9-ae80-c7a5c8f6ff04",
                        "source_sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                        "source_sense_description": "used to concede a point",
                        "target_lang_word": "freilich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freilich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ced74ff-534d-3cf2-9844-86e1366fb74e",
                                        "entry_id": "975bdb6f-a374-304a-8051-2e2d9c87cabd",
                                        "glosses": [
                                            "indessen, jedoch"
                                        ],
                                        "tags": [
                                            "eine Einschränkung beschreibend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7450c6d7-3339-4c8c-b8b9-2fa952f8651e",
                                                "sense_id": "1ced74ff-534d-3cf2-9844-86e1366fb74e",
                                                "text": "„Ein halbwegs bequemer und gerader Wasserweg ist der Rhein freilich nicht immer gewesen.“"
                                            },
                                            {
                                                "example_id": "e78b6d96-6af1-47d2-a138-60651e019144",
                                                "sense_id": "1ced74ff-534d-3cf2-9844-86e1366fb74e",
                                                "text": "Man muss die Leistung Kramniks gegen Deep Fritz anerkennen, auch wenn er das Match hoch verloren hat. Freilich muss man auch bemerken, dass er in keiner Partie auf Sieg stand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb3e5bf4-b3f9-3f22-8086-296867efcf7f",
                                        "entry_id": "975bdb6f-a374-304a-8051-2e2d9c87cabd",
                                        "glosses": [
                                            "klare Zustimmung, selbstverständlich"
                                        ],
                                        "tags": [
                                            "South-German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d310cf-ef4f-4f4d-84a8-5d34ac905800",
                                                "sense_id": "fb3e5bf4-b3f9-3f22-8086-296867efcf7f",
                                                "text": "Freilich mache ich kein Hehl daraus, dass ich meine Frau liebe."
                                            },
                                            {
                                                "example_id": "8f516fac-8830-425f-856c-52d8bc6d4df6",
                                                "sense_id": "fb3e5bf4-b3f9-3f22-8086-296867efcf7f",
                                                "text": "Auf die Frage, ob sie ihm beim Umzug helfen würde, antwortete sie nur: „Freilich!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b8da0cd-a384-4b4f-8191-b7d66a9d9b24",
                        "source_entry_id": "4785213b-6aef-3df9-ae80-c7a5c8f6ff04",
                        "source_sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                        "source_sense_description": "used to concede a point",
                        "target_lang_word": "po prawdzie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ed557c3d-b975-439e-a36c-50b089fcd65d",
                        "source_entry_id": "4785213b-6aef-3df9-ae80-c7a5c8f6ff04",
                        "source_sense_id": "c221432a-d867-3d23-b264-4b5d79151530",
                        "source_sense_description": "used to concede a point",
                        "target_lang_word": "пра́вда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пра́вда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "54c79fc9-5a95-3863-8fb8-2922b0371c0e",
                                        "entry_id": "1ccf5a41-4221-303e-9f15-80c5a5b0db34",
                                        "glosses": [
                                            "верное утверждение; то, что соответствует представлениям об истине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdcc850-917f-4d03-9e67-78bbd566e58f",
                                                "sense_id": "54c79fc9-5a95-3863-8fb8-2922b0371c0e",
                                                "text": "Сказать правду"
                                            },
                                            {
                                                "example_id": "57d56db7-b38f-47c5-98cd-95346db96e93",
                                                "sense_id": "54c79fc9-5a95-3863-8fb8-2922b0371c0e",
                                                "text": "Если стремиться к подлинности, к правде — язык будет беден, скуден."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6448ecb1-924c-3401-90cd-2176c89ec0d8",
                                        "entry_id": "1ccf5a41-4221-303e-9f15-80c5a5b0db34",
                                        "glosses": [
                                            "правота, справедливость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc6c339-e783-4f79-b177-aefa50b13219",
                                                "sense_id": "6448ecb1-924c-3401-90cd-2176c89ec0d8",
                                                "text": "Твоя правда!"
                                            },
                                            {
                                                "example_id": "629a324b-0bd7-47e1-8e46-8f8b8883e8f6",
                                                "sense_id": "6448ecb1-924c-3401-90cd-2176c89ec0d8",
                                                "text": "Судить его надо по правде."
                                            },
                                            {
                                                "example_id": "4e529ba1-078b-4cd5-a817-3f4554c59071",
                                                "sense_id": "6448ecb1-924c-3401-90cd-2176c89ec0d8",
                                                "text": "Нет на Земле правды!"
                                            },
                                            {
                                                "example_id": "fc1c54f3-18cb-4e57-9c42-b32be7371aff",
                                                "sense_id": "6448ecb1-924c-3401-90cd-2176c89ec0d8",
                                                "text": "Правда, в душе человека есть та же кость — его подзаборное «я». В целой личности эти кости, повитые крепкими мускулами души и цветущей кожей, незаметно держат всю душу, а когда душа обеднеет и показывается эта её кость, то невыносимо становится жить около неё: всё колет в том человеке, во всём претензия на власть и шипучая злость в бессилии радоваться, и везде «я» и «я»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5e85522-e3fe-3271-87c3-dd308fc23104",
                                        "entry_id": "1ccf5a41-4221-303e-9f15-80c5a5b0db34",
                                        "glosses": [
                                            "истор. свод законов в раннефеодальных государствах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269c11dd-d984-4d8a-80d1-25d5a5bbb6a3",
                                                "sense_id": "e5e85522-e3fe-3271-87c3-dd308fc23104",
                                                "text": "Русская правда"
                                            },
                                            {
                                                "example_id": "b01df5a5-c3af-4dfb-bbe1-28ac87dd22fc",
                                                "sense_id": "e5e85522-e3fe-3271-87c3-dd308fc23104",
                                                "text": "Салическая правда"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пра́вда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a65b34-4929-3ee3-88c6-f3e0b95978b2",
                                        "entry_id": "a5b153b3-8047-34bc-af92-549f72dc1752",
                                        "glosses": [
                                            "соответствуя по значению словам: действительно, в самом деле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "348d1bd7-f14d-41e9-a722-6eebd1f9713d",
                                                "sense_id": "f2a65b34-4929-3ee3-88c6-f3e0b95978b2",
                                                "text": "И главное, в пароходстве начнут талдычить: «Почему именно с тобой это случилось?» А правда, почему именно с ним?"
                                            },
                                            {
                                                "example_id": "77fd6d53-29c7-47bc-8d3d-ad64338c61fc",
                                                "sense_id": "f2a65b34-4929-3ee3-88c6-f3e0b95978b2",
                                                "text": "И это, наверно, опять он звонит. Слышите? И правда, в квартире всё ещё раздавались телефонные звонки."
                                            },
                                            {
                                                "example_id": "54d12baf-cbc9-4590-8514-259732260f7e",
                                                "sense_id": "f2a65b34-4929-3ee3-88c6-f3e0b95978b2",
                                                "text": "Были, правда, попытки спросить шампанского, но старшие из гостей остановили младших."
                                            },
                                            {
                                                "example_id": "ede67eca-6dce-4176-bb7e-a44fc6331b31",
                                                "sense_id": "f2a65b34-4929-3ee3-88c6-f3e0b95978b2",
                                                "text": "Сократ, правда, говорил своим судьям, что смерть, может быть, есть только сон без сновидений."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пра́вда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "02a9a90e-919b-39e4-b9e7-a28647d49f4c",
                                        "entry_id": "f29d78a3-957c-3d2c-83d5-94dee874c899",
                                        "glosses": [
                                            "употребляется при выражении уступительности; соответствует по значению словам: хотя, хотя и, следует признать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b781b74-9e7d-4721-b763-18cf3e26d0e0",
                                                "sense_id": "02a9a90e-919b-39e4-b9e7-a28647d49f4c",
                                                "text": "И вот иногда, правда, редко, они приходят сюда, спрашивают, как и ты, дорогу к храму и идут туда вопрошать старого бога."
                                            },
                                            {
                                                "example_id": "1355ced8-7797-4611-8811-90d85394201f",
                                                "sense_id": "02a9a90e-919b-39e4-b9e7-a28647d49f4c",
                                                "text": "В кратких словах я изложил причину моего прихода и даже назвал крупную сумму, с которой мой друг был готов расстаться, хотя, правда, он просил меня её не называть, а дождаться условий музея."
                                            },
                                            {
                                                "example_id": "3fe0b84d-e7c4-4975-92ae-5f3883b5d507",
                                                "sense_id": "02a9a90e-919b-39e4-b9e7-a28647d49f4c",
                                                "text": "Однако это может случиться и с любым из нас, правда, в обстоятельствах необыкновенных."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пра́вда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6127573b-0d11-3d75-ba58-04254707170a",
                                        "entry_id": "2b45bb31-3dda-3b69-95f9-ed6c757aac4e",
                                        "glosses": [
                                            "употребляется при выражении утверждения, уверенного подтверждения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2fb189-067b-487a-ae8a-c8f33593129e",
                                                "sense_id": "6127573b-0d11-3d75-ba58-04254707170a",
                                                "text": "Она и правда была тогда совсем молоденькая и очень хорошенькая."
                                            },
                                            {
                                                "example_id": "edc8e5f9-cdb0-414b-a121-b9cfdc49a50b",
                                                "sense_id": "6127573b-0d11-3d75-ba58-04254707170a",
                                                "text": "Слушай, ты че, и правда чистый спирт не пил?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34b558e3-db59-3f72-b4e1-188aa9f0fd9c",
                                        "entry_id": "2b45bb31-3dda-3b69-95f9-ed6c757aac4e",
                                        "glosses": [
                                            "употребляется при выражении согласия со словами собеседника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5deab56-679f-44b2-9ed7-806adc653144",
                                                "sense_id": "34b558e3-db59-3f72-b4e1-188aa9f0fd9c",
                                                "text": "— А может быть, я и правда старше тебя!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
