                    {
                        "sense_id": "a0258673-8fa7-318b-ab97-6e08bc71103c",
                        "entry_id": "d5681280-5fd2-3e2c-bd94-1fa324c1a76a",
                        "glosses": [
                            "muzhik (pre-Revolutionary Russian peasant); muzhik's"
                        ],
                        "tags": [
                            "dated",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "33a3ac7a-6b9c-4457-966a-6938db867bff",
                                "sense_id": "a0258673-8fa7-318b-ab97-6e08bc71103c",
                                "text": "Склад мелкопоме́стной дворя́нской жи́зни, кото́рый тепе́рь стал сбива́ться уже́ на меща́нский, в пре́жние года́, да ещё́ и на мое́й па́мяти, — о́чень неда́вно, — име́л мно́го о́бщего со скла́дом бога́той мужи́цкой жи́зни по свое́й домови́тости и се́льскому, старосве́тскому благополу́чию.",
                                "translation": "Ivan Bunin",
                                "english": "Ivan Bunin"
                            }
                        ]
                    },
