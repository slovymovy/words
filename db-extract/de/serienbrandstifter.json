                "senses": [
                    {
                        "sense_id": "fcc0cb06-8ac3-3934-84fc-0ad5cbab8baf",
                        "entry_id": "3a1c8a0e-59d5-304c-aeb9-cfadd7096eb3",
                        "glosses": [
                            "Brandstifter, der mehrere Brände in einer Serie legt oder gelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55de2c9-9c64-4b3c-9c90-fd7cd960d50f",
                                "sense_id": "fcc0cb06-8ac3-3934-84fc-0ad5cbab8baf",
                                "text": "„Der Druck, endlich einen konkreten Hinweis auf den Serienbrandstifter zu finden, schien an ihm zu zehren.“"
                            },
                            {
                                "example_id": "290087bb-e998-4a66-924f-98ff85389575",
                                "sense_id": "fcc0cb06-8ac3-3934-84fc-0ad5cbab8baf",
                                "text": "„Zuerst waren es nur ein oder zwei Fernsehteams, aber dann kamen auch alle anderen Sender sowie ein paar Auswärtige, die wegen der Story vom Serienbrandstifter in der Stadt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
