                ],
                "senses": [
                    {
                        "sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                        "entry_id": "655afa87-6ac8-38c8-b538-17d58159fb17",
                        "glosses": [
                            "een legendarisch monster met de bijnaam 'de verschrikkelijke sneeuwman' die voor zou komen in de Himalaya"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8caea7c-ac2e-46e6-998e-b4fb3a98557d",
                                "sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                                "text": "Ik geloof niet in de yeti in de Himalaya."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7da5dc1-bc91-4a82-b500-7d78461f92ca",
                        "source_entry_id": "655afa87-6ac8-38c8-b538-17d58159fb17",
                        "source_sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                        "source_sense_description": "een legendarisch monster met de bijnaam 'de verschrikkelijke sneeuwman' die voor zou komen in de Himalaya",
                        "target_lang_word": "Yeti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yeti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                        "entry_id": "9591864e-71ce-36e9-9358-53f808199508",
                                        "glosses": [
                                            "ein legendenhafter, menschenähnlicher Großprimat, der in den Hochgebirgsregionen Asiens (Himalaya, Pamir) leben soll, bisher aber nur aus Fußspuren, Exkrementen und behaupteten Begegnungen erschlossen ist. Die Existenz des Yeti ist wissenschaftlich nicht nachgewiesen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1997ca0-20e5-4408-94c9-90bdabd2c9f8",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "Möglicherweise ist der Yeti nur eine Erfindung phantasiebegabter Menschen."
                                            },
                                            {
                                                "example_id": "e2f00738-3ba4-495e-89b4-f7ec093fcc33",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "„In einer chinesischen Apotheke fand ein deutscher Paläontologe Zähne eines Riesenprimaten. Vielleicht waren frühe Menschen dem Giganten noch begegnet - und schufen die Legende vom Yeti.“"
                                            },
                                            {
                                                "example_id": "b517559f-096a-4c3f-ad70-5a7c6dfe98bc",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "„… Was es hingegen mit dem Yeti auf sich hat, ob Gigantopithecus für ihn Modell stand, wird sich wohl nie klären lassen - auch wenn Einzelne unserer Zeitgenossen den Riesen in einsamen Gegenden des Himalayas gesehen haben wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "209abfef-dd9f-4335-848c-991f75675dce",
                        "source_entry_id": "655afa87-6ac8-38c8-b538-17d58159fb17",
                        "source_sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                        "source_sense_description": "een legendarisch monster met de bijnaam 'de verschrikkelijke sneeuwman' die voor zou komen in de Himalaya",
                        "target_lang_word": "yeti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yeti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                        "entry_id": "34e283c6-c49b-3b5a-a522-a4f20d078f81",
                                        "glosses": [
                                            "An unidentified humanoid animal said to live in the Himalayas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f53c57-8600-4b02-9e62-97b8b4ad4f50",
                                                "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                                "text": "There is no doubt that the Sherpas accept the fact that the Yeti really exists. But then they believe just as confidently that their gods live in comfort on the summit of Mount Everest. We found it quite impossible to divorce the Yeti from the supernatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8be3f5e-dfee-4871-a443-090bee7345d6",
                        "source_entry_id": "655afa87-6ac8-38c8-b538-17d58159fb17",
                        "source_sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                        "source_sense_description": "een legendarisch monster met de bijnaam 'de verschrikkelijke sneeuwman' die voor zou komen in de Himalaya",
                        "target_lang_word": "abominable snowman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abominable snowman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00f012c5-7c66-35c7-a944-fbe401049180",
                                        "entry_id": "e137c13c-7a76-3aac-96b5-ad040f31fec8",
                                        "glosses": [
                                            "A humanoid or apelike animal said to exist in the Himalayas."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca9da8f-96b3-43f9-9c7b-1d67edb6dfd2",
                                                "sense_id": "00f012c5-7c66-35c7-a944-fbe401049180",
                                                "text": "The Abominable Snowman – existing and not existing, flickering at the edges of blizzards, apelike man or manlike ape, stealthy, elusive, known only through rumours and through its backward-pointing footprints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7161ee7d-cea1-479d-be84-5dfe5266adaf",
                        "source_entry_id": "655afa87-6ac8-38c8-b538-17d58159fb17",
                        "source_sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                        "source_sense_description": "een legendarisch monster met de bijnaam 'de verschrikkelijke sneeuwman' die voor zou komen in de Himalaya",
                        "target_lang_word": "yéti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yéti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                                        "entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                                        "glosses": [
                                            "Animal mythologique censé vivre dans les montagnes du Tibet, conformé comme un primate velu au poil blanc, avec un visage ressemblant à celui de l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea10dc28-6459-4ae3-a634-ffd5b17edaaa",
                                                "sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                                                "text": "Les cryptides les plus célèbres sont le monstre du loch Ness ou le yéti."
                                            },
                                            {
                                                "example_id": "63680112-de56-4b2d-822c-053b4d5b2f33",
                                                "sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                                                "text": "Une analyse d’ADN de 30 échantillons de poils de plusieurs continents lève le voile sur le yéti. S’il existe bien un étrange animal, qui pourrait être un ours préhistorique, dans l’Himalaya, les autres créatures ne sont que des espèces connues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b16c8f32-fdf0-4d88-a253-220c79a3bca0",
                        "source_entry_id": "655afa87-6ac8-38c8-b538-17d58159fb17",
                        "source_sense_id": "48b9fc75-bab9-30e7-b3e8-ff3aef7333a5",
                        "source_sense_description": "een legendarisch monster met de bijnaam 'de verschrikkelijke sneeuwman' die voor zou komen in de Himalaya",
                        "target_lang_word": "abominable homme des neiges",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abominable homme des neiges",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42572086-d59c-3eb7-b2fb-cc5fbd785e3b",
                                        "entry_id": "224f7ece-441c-332e-a068-d16901e5ea88",
                                        "glosses": [
                                            "Animal mythologique censé vivre dans les montagnes du Tibet. Ce serait un primate velu au poil blanc, ayant un visage ressemblant à celui de l’être humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9ce6a1-bccc-48af-a6cd-3f30832fc2d2",
                                                "sense_id": "42572086-d59c-3eb7-b2fb-cc5fbd785e3b",
                                                "text": "De nombreuses personnes disent avoir vu l’abominable homme des neiges."
                                            },
                                            {
                                                "example_id": "f48eaea4-ed0d-4e61-a2cc-d232794ee6ad",
                                                "sense_id": "42572086-d59c-3eb7-b2fb-cc5fbd785e3b",
                                                "text": "Connaissez-vous l’abominable homme des neiges, cette créature mythique mi-homme, mi-singe que les habitants de l’Himalaya nomment aussi «yéti» ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
