                    {
                        "sense_id": "30dc12cf-8296-3dac-9dc8-f03ac2d1a957",
                        "entry_id": "17af40c2-9a45-36a6-86ed-5fe5c3e0725f",
                        "glosses": [
                            "Relatif aux courtisanes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "978a6069-34cc-4dfc-a021-b2d3120bd1ec",
                                "sense_id": "30dc12cf-8296-3dac-9dc8-f03ac2d1a957",
                                "text": "Nous aurions doté notre époque d’une de ces magnifiques figures aspasiennes sans lesquelles il n’y a pas de grand siècle."
                            },
                            {
                                "example_id": "68c8c606-59a7-48e7-817b-c56dc04670eb",
                                "sense_id": "30dc12cf-8296-3dac-9dc8-f03ac2d1a957",
                                "text": "De cet amour trop pusillanime, car Dieu veut qu’on ose aussi, et le seul qu’elle n’ait pas couronné, Géraldine fut toujours hantée, même et surtout aux heures brillantes de sa carrière aspasienne."
                            },
                            {
                                "example_id": "0d0d0e39-894b-4c84-9682-adcbd52dd12d",
                                "sense_id": "30dc12cf-8296-3dac-9dc8-f03ac2d1a957",
                                "text": "Toutes les sympathies d’un milieu ne vont pas nécessairement à la même femme, fût-elle d’une beauté et d’une intelligence aspasiennes."
                            }
                        ]
                    }
