                                "example_id": "fe9a0584-fa0c-4604-8cb5-1b70d1a308eb",
                                "sense_id": "7ee870d7-d7c4-3322-a59b-01827c1f50f1",
                                "text": "Als je niet tevreden bent over de bezorging van de krant en telefoontjes hebben niet geholpen, kun je een klachtbrief schrijven."
                            }
                        ]
                    }
