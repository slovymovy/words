                "senses": [
                    {
                        "sense_id": "db0dae6a-ad5e-39dd-b120-e4f8aa2b7eb9",
                        "entry_id": "b4fb3fe9-9c58-336f-b90f-91353131f3ba",
                        "glosses": [
                            "spoilsport, killjoy"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "fd4db03d-d282-43d7-91c1-0d1ab45ad0f6",
                                "sense_id": "db0dae6a-ad5e-39dd-b120-e4f8aa2b7eb9",
                                "text": "den Spielverderber spielen"
                            },
                            {
                                "example_id": "94fc0b92-6aee-4ab9-9f8c-1e7e0c04e954",
                                "sense_id": "db0dae6a-ad5e-39dd-b120-e4f8aa2b7eb9",
                                "text": "ein Spielverderber sein"
                            },
                            {
                                "example_id": "28a02e24-62c2-4eed-b242-0b836c32dcd4",
                                "sense_id": "db0dae6a-ad5e-39dd-b120-e4f8aa2b7eb9",
                                "text": "Er hatte bloß einen Schein des Rechts auf seiner Seite. Daß es Interessen neben den seinigen gab, leuchtete ihm nicht ein; wir waren einfach Spielverderber. Er gehörte ganz in die Klasse der naiven Egoisten."
                            },
                            {
                                "example_id": "89fc295d-577c-4987-b6b7-3129cb2e6387",
                                "sense_id": "db0dae6a-ad5e-39dd-b120-e4f8aa2b7eb9",
                                "text": "Vor wenigen Minuten wäre er selbst fast neuerlich in den Bann dieses kosmischen Spielverderbers geraten, der ärger war als alle Beichtväter und alle eifernden Mönche. Leibniz sollte aber bald sehen, daß er nur ein halber Mensch war."
                            }
                        ]
                    }
                ],
