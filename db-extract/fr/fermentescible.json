                                        "entry_id": "163565ce-d0e9-3f04-89f3-71988cc7b2bd",
                                        "glosses": [
                                            "Able to ferment or be fermented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbca544f-c450-455d-85e6-019d5b9d1a08",
                                                "sense_id": "579a4246-3b5f-34ed-bffa-65e2fc0a7b80",
                                                "text": "“You need to convert the starches in the corn into fermentable sugars,” the always entertaining Mr. Calagione said by phone from his headquarters in Rehoboth Beach."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fermentable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74b6a91b-0f0b-31d3-b08e-15fef1a82f9d",
                                        "entry_id": "c55e3353-500a-30fd-a93c-17c62667ac50",
                                        "glosses": [
                                            "Any substance that can be fermented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9f007c-1f38-4cd1-a882-c8f604897fe3",
                                                "sense_id": "74b6a91b-0f0b-31d3-b08e-15fef1a82f9d",
                                                "text": "Purchase other fermentables (more fermentables mean more alcohol) like dry malt extract, rice syrup, brewers' sugar, liquid malt extract, Belgian candi sugar, or demera sugar or any combination of the above."
                                            }
