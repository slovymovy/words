                "senses": [
                    {
                        "sense_id": "cff0fc83-4892-3b55-9c8b-94bcd00ff82b",
                        "entry_id": "1c2dfcb5-625c-332c-b02e-80097a7f7c8e",
                        "glosses": [
                            "ergebnisorientiertes Fachgespräch der verantwortlichen Bauleitung zu einem bestimmten Bauvorhaben direkt vor Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa280e0a-65e8-48f8-adff-2ff1a04884aa",
                                "sense_id": "cff0fc83-4892-3b55-9c8b-94bcd00ff82b",
                                "text": "„Um die Baumaßnahmen zu koordinieren, gibt es wöchentliche Baustellenbesprechungen.“"
                            },
                            {
                                "example_id": "16c5ee46-192b-4330-8ef9-d6be24a5fa75",
                                "sense_id": "cff0fc83-4892-3b55-9c8b-94bcd00ff82b",
                                "text": "„Die Baustellenbesprechung dient auch dazu, die Arbeiten sämtlicher am Bau Beteiligter aufeinander abzustimmen und letzte Ausführungsdetails bzw. auftretende Probleme gemeinsam zu lösen.“"
                            },
                            {
                                "example_id": "4a7e8651-847f-4696-9bca-25750bd1a5cd",
                                "sense_id": "cff0fc83-4892-3b55-9c8b-94bcd00ff82b",
                                "text": "„Dass es gut mit den Bauarbeiten im künftigen Biebernheimer Feuerwehrgerätehaus voran geht, davon konnte sich Stadtbürgermeister Walter Mallmann anlässlich einer Baustellenbesprechung vor Ort überzeugen.“"
                            },
                            {
                                "example_id": "27aedb31-1e0a-4000-ab28-07b06b5f22d4",
                                "sense_id": "cff0fc83-4892-3b55-9c8b-94bcd00ff82b",
                                "text": "„Sie können z.B. Angebote, Auftragsbestätigungen und Nachkalkulationen in TopKontor Handwerk auslagern und auf dem Laptop für die Baustellenbesprechung einlagern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
