                "senses": [
                    {
                        "sense_id": "94b423dd-345a-34e4-b613-b8fe87ff5554",
                        "entry_id": "2b11a1e0-c0ba-399c-ba56-bb10cf39fd43",
                        "glosses": [
                            "Jahr, in dem ein Buch, eine Zeitschrift oder sonstiges Druckwerk erscheint/erschien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916b0a7b-eedd-4a6f-8697-2196016e7120",
                                "sense_id": "94b423dd-345a-34e4-b613-b8fe87ff5554",
                                "text": "„Von den handschriftlich weit verbreiteten Provinzialstatuten von 1310 erschienen im 15. Jahrhundert ohne Angaben zum Druckort und Erscheinungsjahr nachweislich vier Ausgaben.“"
                            },
                            {
                                "example_id": "7ae14ac2-cc01-4308-b93e-588f3e46e001",
                                "sense_id": "94b423dd-345a-34e4-b613-b8fe87ff5554",
                                "text": "„Bis 1522, dem Erscheinungsjahr von Luthers Übersetzung des Neuen Testaments, erschienen außerdem vierzehn oberdeutsche und vier niederdeutsche Bibeln, des Weiteren eine niederrheinische und eine niedersächsische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
