                "senses": [
                    {
                        "sense_id": "ebd83605-19ab-3ca8-84b8-935406bb32af",
                        "entry_id": "dc7a3ff0-14b1-3b8e-92ce-f552e748d038",
                        "glosses": [
                            "Muster der Abfolge von Reimen in einer Strophe"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "326d370f-5467-4393-b784-2d02a967472f",
                                "sense_id": "ebd83605-19ab-3ca8-84b8-935406bb32af",
                                "text": "„Alle solchen Reimschemata und Reimtraditionen stehen unter gewissen Moden: Sie kommen auf, klingen wieder ab, kehren unter Umständen später einmal wieder.“"
                            },
                            {
                                "example_id": "3b0aec59-688d-4c0c-a421-b185acf7331f",
                                "sense_id": "ebd83605-19ab-3ca8-84b8-935406bb32af",
                                "text": "„So hat Busch in diesem Gedicht seine virtuose Reimkunst auf überraschende Weise variiert, denn der Sinn des Lebens schien ihm wohl zu fragwürdig, als daß der ihn durch ein übersichtliches Reimschema hätte vortäuschen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
