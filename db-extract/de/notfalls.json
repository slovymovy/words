                "senses": [
                    {
                        "sense_id": "e396e084-44ec-3378-9279-d6392d9dde95",
                        "entry_id": "4e3d5f9d-dd62-3773-8992-f1963a09e5df",
                        "glosses": [
                            "wenn es keine andere Möglichkeit mehr gibt; als Notlösung; wenn es notwendig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f36dfd6-52b1-47fc-98fc-ca01e0be793b",
                                "sense_id": "e396e084-44ec-3378-9279-d6392d9dde95",
                                "text": "Wir müssen notfalls das Bein amputieren, um das Leben des Patienten zu retten."
                            },
                            {
                                "example_id": "8baf7406-0a8f-4caa-bb12-c3e1df82b240",
                                "sense_id": "e396e084-44ec-3378-9279-d6392d9dde95",
                                "text": "Notfalls müssen wir zu Fuß nach Hause gehen."
                            },
                            {
                                "example_id": "5b45e547-28bf-4b49-8c2a-92e8c67f9911",
                                "sense_id": "e396e084-44ec-3378-9279-d6392d9dde95",
                                "text": "„Darf ein Staat notfalls Unschuldige opfern, wenn dies zur Terrorabwehr erforderlich ist?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
