                "senses": [
                    {
                        "sense_id": "2f5397c5-e59d-3620-9f05-c4049fe7dfdf",
                        "entry_id": "59660a65-b213-3434-a002-6018dc8a8abc",
                        "glosses": [
                            "schöne, ansprechende Gestalt"
                        ],
                        "tags": [
                            "gehoben",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "8ebd6bf4-4276-4e0b-aa22-65d936dd52b8",
                                "sense_id": "2f5397c5-e59d-3620-9f05-c4049fe7dfdf",
                                "text": "„Erblickt ein Schürzenjäger ein Mädchen oder eine Frau, die sich einer gewissen Wohlgestalt erfreut, so stellt er ihr auf alle erdenkliche Art und Weise nach, um ihr die Sprödigkeit zu nehmen und sie sich geneigt zu machen.“"
                            },
                            {
                                "example_id": "fae210d0-cec5-4b46-a44c-7274dbde7395",
                                "sense_id": "2f5397c5-e59d-3620-9f05-c4049fe7dfdf",
                                "text": "„Doch um auf unsere Sache zurückzukommen, muß ich noch sagen, daß, wo innere und äußere Wohlgestalt und Schönheit sich gatten, ein unwillkürlich Wohlgefallen entsteht und ein Trieb, diesem Menschen wohlgefällig zu werden, und wenn er leidet, ihm zu helfen geistig oder leiblich.“"
                            },
                            {
                                "example_id": "55740018-1d98-4581-8319-6349f2771822",
                                "sense_id": "2f5397c5-e59d-3620-9f05-c4049fe7dfdf",
                                "text": "„Und so sprechen heute andere Wohlgestalten unseren Sehsinn an als etwa vor 30, 40 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
