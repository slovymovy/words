                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b6ae803-e432-438a-9a4c-46ee3c0b976b",
                        "source_entry_id": "0a5cba96-e735-3b2e-bd85-ae781febfad3",
                        "source_sense_description": "складная кровать",
                        "target_lang_word": "Feldbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                        "entry_id": "29a6e77b-36e8-3762-ad1a-f590195ea6a0",
                                        "glosses": [
                                            "einfaches, meist aus Eisen bestehendes, zusammenklappbares Bett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b90cd544-c936-4dcd-972c-3876a7309c0a",
                                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                                "text": "Er hatte Schmerzen im Nacken, weil er auf einem harten Feldbett geschlafen hatte."
                                            },
                                            {
                                                "example_id": "bdf66e21-11f5-40de-a968-19d57869a6c9",
                                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                                "text": "„Hier brachte er mich in einem kahlen Zimmer unter, an dessen Wänden eine Reihe von Feldbetten aufgestellt war.“"
                                            },
                                            {
                                                "example_id": "a548b6ac-490c-44f7-93ff-8f14231b4d69",
                                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                                "text": "„Das Feldbett ähnelte Wenzel Hainstocks Feldbett wie ein Ei den anderen.“"
                                            },
                                            {
                                                "example_id": "a95ccd63-2c9c-4d18-aecc-738486dca0cf",
                                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                                "text": "„Danach mussten wir uns zum Mittagsschlaf auf Feldbetten niederlassen und schweigen.“"
                                            },
                                            {
                                                "example_id": "25dae05c-5a3f-40f0-95ae-8a226d469a61",
                                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                                "text": "„Als er endlich auf dem Feldbett lag, da hielt er die Augen lange geschlossen und rührte sich nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd97e0e4-7879-4662-814b-2c2410ab2318",
                        "source_entry_id": "0a5cba96-e735-3b2e-bd85-ae781febfad3",
                        "source_sense_description": "складная кровать",
                        "target_lang_word": "lit pliant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lit pliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d3bd184-14e2-36a4-b2aa-782eff152509",
                                        "entry_id": "583fca47-7069-3fbb-a8de-3d6dd8b0f82b",
                                        "glosses": [
                                            "Lit repliable pour en faciliter le rangement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1286a036-647c-4e16-a1a5-c8c89ff623a6",
                                                "sense_id": "1d3bd184-14e2-36a4-b2aa-782eff152509",
                                                "text": "Lit pliant pratique et économique"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2f92d1d-cc30-4207-a78b-ecc2bce76d76",
                        "source_entry_id": "0a5cba96-e735-3b2e-bd85-ae781febfad3",
                        "source_sense_description": "складная кровать",
                        "target_lang_word": "lit de camp",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lit de camp",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff966a5d-4bd8-3acb-9aee-0ccb8d0db69b",
                                        "entry_id": "10e36d2a-6d9b-34b6-95fe-46a3f5a4ae10",
                                        "glosses": [
                                            "Sorte de lit qui se replie pour être transporté facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7d29d2-9273-4718-b5d6-c71c9f93b5a4",
                                                "sense_id": "ff966a5d-4bd8-3acb-9aee-0ccb8d0db69b",
                                                "text": "Je n'emportais ni remèdes contre le choléra-morbus, ni pacotille, ni tromblon, ni tente, ni lit de camp, rien enfin des mille choses inutiles aux voyageurs. Je comprenais admirablement que, vivre ici, vivre là, l'acte de vivre devait être partout le même ; et que, moins j'aurais de haillons, mieux j'irais."
                                            },
                                            {
                                                "example_id": "58c514d8-b4db-4827-9943-1fb3c57be374",
                                                "sense_id": "ff966a5d-4bd8-3acb-9aee-0ccb8d0db69b",
                                                "text": "Au nord [de la Chine], le k’ang est un remplaçant très insuffisant des poêles occidentaux. C’est une sorte de lit de camp en briques chauffé intérieurement sur lequel couchent tous les habitants de la maison."
                                            },
                                            {
                                                "example_id": "d6774111-bbc3-4a36-a665-40a99f7a6b5f",
                                                "sense_id": "ff966a5d-4bd8-3acb-9aee-0ccb8d0db69b",
                                                "text": "[…], je passe une nuit excellente dans mon lit de camp, et mon long sommeil réparateur n’est interrompu que pendant quelques instants par des aboiements furibonds répondant aux glapissements lointains d’un chacal."
                                            },
                                            {
                                                "example_id": "f8caba10-2097-46ca-9187-60a089c36b54",
                                                "sense_id": "ff966a5d-4bd8-3acb-9aee-0ccb8d0db69b",
                                                "text": "Il ne se retourne pas pour me voir m’entasser sur un lit de camp près de la balustrade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
