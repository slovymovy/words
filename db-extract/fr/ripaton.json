            {
                "entry_id": "46440863-c48a-3812-a90d-6c2593d4f81e",
                "word": "ripaton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98d27cbd-7dad-4694-a6ab-7a452dcbb843",
                        "entry_id": "46440863-c48a-3812-a90d-6c2593d4f81e",
                        "tags": [
                            "plural"
                        ],
                        "form": "ripatons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "361b5d65-a3d8-37a1-ba59-650bac638d28",
                        "entry_id": "46440863-c48a-3812-a90d-6c2593d4f81e",
                        "glosses": [
                            "Pied."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5d996d1f-efae-4b4a-aa5b-113831375116",
                                "sense_id": "361b5d65-a3d8-37a1-ba59-650bac638d28",
                                "text": "La marche faisait partie depuis toujours de sa vie - non en tant qu’exercice puisqu’il abhorrait autant le sport que Churchill -, parce qu’il ne réfléchissait bien qu’en collant tranquillos un ripaton devant l’autre…"
                            },
                            {
                                "example_id": "c7a6cc88-8454-4646-bb92-13715b81224a",
                                "sense_id": "361b5d65-a3d8-37a1-ba59-650bac638d28",
                                "text": "« Ah ! vous ne trouverez rien, mon p’tit monsieur. Y n’ont rien trouvé… Et puis maintenant, c’est trop sale… Il est entré trop de gens ! Ils veulent point que je lave le carreau… mais, le jour du crime, j’avais lavé tout ça à grande eau, moi, père Jacques… et, si l’assassin avait passé par là avec ses « ripatons », on l’aurait bien vu ; il a assez laissé la marque de ses godillots dans la chambre de mademoiselle !… »"
                            },
                            {
                                "example_id": "d1f83a56-bf03-4c36-8514-38494f433c78",
                                "sense_id": "361b5d65-a3d8-37a1-ba59-650bac638d28",
                                "text": "Il avait de ces ripatons, il devait bien chausser du quarante-six fillette !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c388596-212d-4b4e-9f6c-638924048a40",
                        "source_entry_id": "46440863-c48a-3812-a90d-6c2593d4f81e",
                        "source_sense_id": "361b5d65-a3d8-37a1-ba59-650bac638d28",
                        "target_lang_word": "Flosse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flosse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87112a97-02f8-3732-a9fd-eaaed0dafd01",
                                        "entry_id": "31736ca1-1b86-32ec-960e-874c4086aba4",
                                        "glosses": [
                                            "Antriebs- und Stabilisierungsorgan bei im Wasser lebenden Tieren"
                                        ],
                                        "tags": [
                                            "Tieranatomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5926d570-cf7b-4c0f-933c-91ee6cc62951",
                                                "sense_id": "87112a97-02f8-3732-a9fd-eaaed0dafd01",
                                                "text": "Haifischen werden oft bei lebendigem Leibe die Flossen abgeschnitten, um den Rohstoff für Haifischflossensuppe zu liefern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e98bb9c-e2ec-3e20-905d-167bba87534c",
                                        "entry_id": "31736ca1-1b86-32ec-960e-874c4086aba4",
                                        "glosses": [
                                            "Kurzform für Schwimm- oder Taucherflossen"
                                        ],
                                        "tags": [
                                            "Wassersport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b05c570b-0d05-4354-be5f-740a373db31e",
                                                "sense_id": "8e98bb9c-e2ec-3e20-905d-167bba87534c",
                                                "text": "Sich an Land mit Flossen fortzubewegen ist schwierig."
                                            },
                                            {
                                                "example_id": "ca36e45c-4138-4b13-8cc7-0ae4a9beeb8a",
                                                "sense_id": "8e98bb9c-e2ec-3e20-905d-167bba87534c",
                                                "text": "Die Flosse hat eine 12- bis 15-mal größere Vortriebsfläche als die menschlichen Füße."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4c733acd-2277-3963-9463-5d522b63e2fa",
                                        "entry_id": "31736ca1-1b86-32ec-960e-874c4086aba4",
                                        "glosses": [
                                            "Hand"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, scherzhaft, abwertend oder derb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac524fe-ed53-41ad-9d93-85d3afcb8df0",
                                                "sense_id": "4c733acd-2277-3963-9463-5d522b63e2fa",
                                                "text": "Reich mir die Flosse, Genosse!"
                                            },
                                            {
                                                "example_id": "d56836df-bb1c-43ad-8039-af6e02e7f351",
                                                "sense_id": "4c733acd-2277-3963-9463-5d522b63e2fa",
                                                "text": "„An den Plastikhüllen, aus denen man die heißen Klöße herausfingern mußte, verbrühte ich mir die Flossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "837128c1-18e5-304d-ad3f-3daddaee56cd",
                                        "entry_id": "31736ca1-1b86-32ec-960e-874c4086aba4",
                                        "glosses": [
                                            "Fuß"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, scherzhaft, abwertend oder derb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3df0851b-9158-4152-a1ab-840ec6814f30",
                                                "sense_id": "837128c1-18e5-304d-ad3f-3daddaee56cd",
                                                "text": "Er tritt mir beim Tanzen immer auf die Flossen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb445dfd-e254-4298-a02d-5ff7910dbc9a",
                        "source_entry_id": "46440863-c48a-3812-a90d-6c2593d4f81e",
