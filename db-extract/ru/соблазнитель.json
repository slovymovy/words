                        "sense_id": "c12e5a87-caa3-37f1-9827-1c7c9ac19378",
                        "entry_id": "6e77c96f-7d37-3af9-b526-83c0cbc13317",
                        "glosses": [
                            "тот, кто соблазняет или соблазнил кого-либо"
