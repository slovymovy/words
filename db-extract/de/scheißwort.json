                        "examples": [
                            {
                                "example_id": "7716aaab-a749-4842-9e11-1fcf0da0cbd7",
                                "sense_id": "22ee27ba-2044-3126-af4e-2bf152602988",
                                "text": "„Er achtet nicht auf den warnenden Summton, rammt die Stereoanlage auf Taxiscan, das sämtliche Frequenzen der Taxifahrer nach interessanten Verkehrsmeldungen absucht. Kann kein Scheißwort verstehen.“"
                            },
                            {
                                "example_id": "92f2620d-2338-4d06-973f-98207669acf9",
                                "sense_id": "22ee27ba-2044-3126-af4e-2bf152602988",
                                "text": "„›Court heißt Violator, und ich ... Ich kriege diesen ... Ich kann das Scheißwort gar nicht aussprechen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
