                                "target_senses": [
                                    {
                                        "sense_id": "f2179283-701b-3eed-b2ab-66e6ccf49512",
                                        "entry_id": "ce3b27f3-1f07-3791-a915-497cab4ae2c5",
                                        "glosses": [
                                            "Aktion, etwas in sich/in den eigenen Bereich aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d51ab7-5dff-4c66-a888-aaf642faa508",
                                                "sense_id": "f2179283-701b-3eed-b2ab-66e6ccf49512",
                                                "text": "„Diese Einverleibung kam dann auch.“"
                                            },
                                            {
                                                "example_id": "b638edb8-0609-41e4-9a28-f384d9c16cfa",
                                                "sense_id": "f2179283-701b-3eed-b2ab-66e6ccf49512",
                                                "text": "„Für die Kolonie begann seit dieser Einverleibung eine neue Ära, und mit Riesenschritten schien sie nun einholen zu wollen, was sie mehr als hundert Jahre hindurch verschlummert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "189a4ef5-4bd5-4006-925d-5a4daa945135",
                        "source_entry_id": "06d2df80-43e9-3589-ac9e-42a4b6a59180",
