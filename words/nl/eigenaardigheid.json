            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e61ca27-6088-3edb-87c0-460fa4f34d62",
                    "sense_definition": "Een vreemde of opvallende eigenschap die kenmerkend is voor een bepaald persoon of een bepaalde zaak.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karaktertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn gewoonte om altijd met zijn vingers te trommelen is een vreemde <w>eigenaardigheid</w>.",
                            "target_lang_translations": {
                                "en": "His habit of always drumming his fingers is a strange <w>quirk</w>."
                            }
                        },
                        {
                            "text": "Ieder mens heeft wel een kleine <w>eigenaardigheid</w> die hem uniek maakt.",
                            "target_lang_translations": {
                                "en": "Every person has some small <w>peculiarity</w> that makes them unique."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiosyncrasie",
                        "rariteit",
                        "bizarheid",
                        "merkwaardigheid",
                        "singulariteit"
                    ],
                    "antonyms": [
                        "normaliteit",
                        "gewoonte"
                    ],
                    "common_phrases": [
                        "een vreemde eigenaardigheid",
                        "kleine eigenaardigheid"
                    ],
                    "target_lang_definitions": {
                        "en": "A strange or striking characteristic that is typical of a particular person or thing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quirk",
                                "target_lang_sense_clarification": "a peculiar aspect of a person's character or behavior"
                            },
                            {
                                "target_lang_word": "peculiarity",
                                "target_lang_sense_clarification": "an odd or unusual feature or habit"
                            },
                            {
                                "target_lang_word": "eccentricity",
                                "target_lang_sense_clarification": "an unconventional or strange habit"
                            },
                            {
                                "target_lang_word": "idiosyncrasy",
                                "target_lang_sense_clarification": "a structural or behavioral characteristic peculiar to an individual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95a91a3b-bc18-3f79-ace7-5c08aa2c3e81",
                    "sense_definition": "Een bijzondere, specifieke of opmerkelijke hoedanigheid of eigenschap.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "karaktertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vond jij dat ook zo'n <w>eigenaardigheid</w> van dit oude gebouw?",
                            "target_lang_translations": {
                                "en": "Did you also think that was such a <w>peculiarity</w> of this old building?"
                            }
                        },
                        {
                            "text": "De specifieke <w>eigenaardigheid</w> van deze taal is de complexe grammatica.",
                            "target_lang_translations": {
                                "en": "The specific <w>peculiarity</w> of this language is its complex grammar."
                            }
                        }
                    ],
