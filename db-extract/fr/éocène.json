                    {
                        "sense_id": "a3bf3434-ce89-3b21-bf7c-f7899144de46",
                        "entry_id": "a8bdf0a4-5c5f-301a-86c1-6768c2049f42",
                        "glosses": [
                            "Deuxième période du Paléogène, comprise entre –55,8 et –33,9 millions d’années."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38f211c4-e0c4-43fd-9bfb-72c26128535f",
                                "sense_id": "a3bf3434-ce89-3b21-bf7c-f7899144de46",
                                "text": "Superposition et succession chronologique des couches fossilifères\nQuaternaire :\n[…]\nTertiaire :\n[…]\nMiocène inférieur. Molasse.\nÉocène supérieur. Gypse.\nÉocène moyen. Calcaire grossier.\nÉocène inférieur. Sables et argiles.\nSecondaire :\n[…]"
                            },
                            {
                                "example_id": "dd0a78d7-745e-4213-ac76-5d7e24c7f54b",
                                "sense_id": "a3bf3434-ce89-3b21-bf7c-f7899144de46",
                                "text": "Des communications fréquentes, sinon continues, existaient à l’Éocène entre les contrées du Sud de l’Europe et le continent africain."
                            }
                        ]
                    }
                ],
