                "senses": [
                    {
                        "sense_id": "9b4c3801-441f-3927-919c-805fab9e578c",
                        "entry_id": "88d4d8ad-dcfd-335e-8ffb-8bdd079f9f17",
                        "glosses": [
                            "Donner un caractère universitaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b71dd3b-812c-431d-a3cd-0758075fd36a",
                                "sense_id": "9b4c3801-441f-3927-919c-805fab9e578c",
                                "text": "Universitariser la filière infirmière, une priorité qui fait consensus"
                            },
                            {
                                "example_id": "0b6923c0-2798-47bb-8a1f-9977c4cc21b1",
                                "sense_id": "9b4c3801-441f-3927-919c-805fab9e578c",
                                "text": "D’abord, les deux processus semblent aller en partie de pair : la création de diplômes professionnels par les universitaires ne fait pas que contribuer à la professionnalisation de l'université; elle universitarise en même temps la formation des professionnels du secteur concerné."
                            },
                            {
                                "example_id": "909a372d-0c33-44dd-9f2b-64279ba247e8",
                                "sense_id": "9b4c3801-441f-3927-919c-805fab9e578c",
                                "text": "Il faut universitariser le lycée."
                            }
                        ]
                    }
