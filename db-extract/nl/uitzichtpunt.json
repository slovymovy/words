                        "glosses": [
                            "plek van waaraf men een goed uitzicht heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d935d9e-cdc1-46e7-b271-382305d2da01",
                                "sense_id": "30be2a43-8cc9-32ad-8194-7466f914c4cf",
                                "text": "Verder dwaalde ik af en toe voor een hele tijd van de trail af om te genieten van een beter uitzichtpunt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaf4cd81-4870-4a39-96a6-150f8a79bfd3",
