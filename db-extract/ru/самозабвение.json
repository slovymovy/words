                                            {
                                                "example_id": "555130cc-4f2a-4424-887e-4ef98e4a7b9c",
                                                "sense_id": "88b6837a-f63f-30b3-9e2a-6bdfd865f3eb",
                                                "text": "Vrchol sebezapření je, když matka připustí, že i jiné matky mají hezké, chytré a hodné děti."
                                            }
                                        ]
                                    },
