                                        "glosses": [
                                            "Lieu où l’on recueille du soufre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ce9d4c-53c9-4acc-9efd-3cbcff63103c",
                                                "sense_id": "e95bbfb5-beea-31a1-835d-6085811eb679",
                                                "text": "Dépôts d'acide borique et, fréquemment, de soufre qui peut constituer un véritable gisement dans les « solfatares » ou « soufrières »."
                                            }
                                        ]
                                    }
                                ]
