                "word": "hylozoïsme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08d1b8b0-7850-4940-8531-37092a1ca4f6",
                        "entry_id": "f4085c67-8071-3116-96fa-1ff9f377e0a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "hylozoïsmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3834e249-379f-3d6b-afa2-874a86668770",
                        "entry_id": "f4085c67-8071-3116-96fa-1ff9f377e0a0",
                        "glosses": [
                            "Doctrine philosophique qui soutient que la matière est douée de vie par elle-même, sans qu’interviennent des principes extrinsèques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641198c3-540c-4ad1-bb61-33ac9df8cefb",
                                "sense_id": "3834e249-379f-3d6b-afa2-874a86668770",
                                "text": "Kant pense que l’hylozoïsme est une doctrine qui « fonde les fins de la nature sur l’analogon d’un pouvoir, agissant selon une intention, sur la vie de la matière référence nécessaire (résoudre le problème)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af39058e-7dde-4d7a-91b0-5c0dd4edac99",
                        "source_entry_id": "f4085c67-8071-3116-96fa-1ff9f377e0a0",
                        "source_sense_id": "3834e249-379f-3d6b-afa2-874a86668770",
                        "target_lang_word": "Hylozoismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hylozoismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ecc9990-f4b9-34e2-aa39-1415cb011703",
                                        "entry_id": "a39dad38-a868-3f8a-8c29-d1172c0b070a",
                                        "glosses": [
                                            "die Lehre der ionischen Naturphilosophen von einem belebten Urstoff aller Dinge in der Welt"
                                        ],
                                        "tags": [
                                            "Naturphilosophie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cad39faa-1e52-4db0-940f-bf374ead31e6",
                                                "sense_id": "9ecc9990-f4b9-34e2-aa39-1415cb011703",
                                                "text": "„Hylozoismus ist jene – erstmals 1678 von R. CUDWORTH so bezeichnete – hauptsächlich der älteren ionischen Naturphilosophie zugeschriebene Lehre von einem Grundstoff, aus dem alle Dinge derart entstanden sind, daß mit dem Urstoff dessen Entwicklung zu den Dingen infolge seiner ewigen Bewegung und seiner Lebendigkeit ohne weiteres gegeben ist, ohne daß ein zweites dem Stoffe gegenüberstehendes bewegendes und ordnendes Prinzip (etwa ein göttlicher Intellekt) dafür anzusetzen wäre.“"
                                            },
                                            {
                                                "example_id": "f91d0059-368a-4aa0-bf0e-3314109a83f5",
                                                "sense_id": "9ecc9990-f4b9-34e2-aa39-1415cb011703",
                                                "text": "„Der Hylozoismus belebt alles, der Materialismus dagegen, wenn er genau erwogen wird, tödtet alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2c39b85-f17c-4ebd-b223-c84af775bbaf",
                        "source_entry_id": "f4085c67-8071-3116-96fa-1ff9f377e0a0",
                        "source_sense_id": "3834e249-379f-3d6b-afa2-874a86668770",
                        "target_lang_word": "hylozoism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hylozoism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09b74ec4-5774-39e4-bbd7-ac14cdce53c2",
                                        "entry_id": "e38ee0be-8df5-300e-a9f5-ad508311c472",
                                        "glosses": [
                                            "A philosophical doctrine espousing that all or some material things possess life, or that all life is inseparable from matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9bbee4-f1f2-46b6-a5ef-caf593726b35",
                                                "sense_id": "09b74ec4-5774-39e4-bbd7-ac14cdce53c2",
                                                "text": "[…] is it not melancholy to hear a man like Steffens somniloquise in such a mystifying cant of Hylozoism, of Pickism, a hodge-podge of the grossest materialism, and the most fantastic yet maudlin moonery?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
