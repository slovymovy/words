                    {
                        "translation_id": "b029ac9f-363e-4005-85de-6ac49f8d32de",
                        "source_entry_id": "5bca861c-a38f-3752-bec0-2751b9eaf343",
                        "source_sense_id": "e497153c-4fe4-392f-981b-8bb390e8de4c",
