                                "target_senses": [
                                    {
                                        "sense_id": "81fc58ce-257d-3ebc-be1e-a89bb219b8ab",
                                        "entry_id": "59e02c5b-d86e-3d41-b472-6170db8cd527",
                                        "glosses": [
                                            "That which girds, encircles, or encloses; a circumference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcfc77b9-21df-419c-bbff-4f684104ee50",
                                                "sense_id": "81fc58ce-257d-3ebc-be1e-a89bb219b8ab",
                                                "text": "the girdle of the world",
                                                "translation": "the equator",
                                                "english": "the equator"
                                            },
                                            {
                                                "example_id": "b5eb0b1d-0948-45e6-956f-130109875ba0",
                                                "sense_id": "81fc58ce-257d-3ebc-be1e-a89bb219b8ab",
                                                "text": "Suppose within the girdle of these walls\nAre now confin'd two mighty monarchies"
                                            },
                                            {
                                                "example_id": "bfcada1b-4afa-4848-b509-c457586f7009",
                                                "sense_id": "81fc58ce-257d-3ebc-be1e-a89bb219b8ab",
                                                "text": "from the world's girdle to the frozen pole"
                                            },
                                            {
                                                "example_id": "498da289-71b3-4601-b98b-0e73de8db46d",
                                                "sense_id": "81fc58ce-257d-3ebc-be1e-a89bb219b8ab",
                                                "text": "In yonder pensile orb, and every sphere\nthat gems the starry girdle of the year"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c37183-be28-33ed-b878-a1736d8751ca",
                                        "entry_id": "59e02c5b-d86e-3d41-b472-6170db8cd527",
                                        "glosses": [
                                            "A belt or sash at the waist, often used to support stockings or hosiery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "201d4088-7eb4-488c-bbd6-4f13e974e998",
                                                "sense_id": "e3c37183-be28-33ed-b878-a1736d8751ca",
                                                "text": "And the seven angels came out of the temple, having the seven plagues, clothed in pure and white linen, and having their breasts girded with golden girdles"
                                            },
                                            {
                                                "example_id": "dae2fb15-ef40-4f5f-a630-6146e831ca3c",
                                                "sense_id": "e3c37183-be28-33ed-b878-a1736d8751ca",
                                                "text": "O Queen, most exalted of Persia's deep-girdled women, venerable mother of Xerxes, wife of Darius, all hail!"
                                            },
                                            {
                                                "example_id": "d7f26a8c-9d2c-4454-bb92-e9e49f065fbf",
                                                "sense_id": "e3c37183-be28-33ed-b878-a1736d8751ca",
                                                "text": "She therefore assumed the novice's garb, so universally worn by young Italians—a robe of black silk, only fastened round the waist by a girdle."
                                            },
                                            {
                                                "example_id": "76ecac83-5e31-4702-a5ff-ec20a814bc8d",
                                                "sense_id": "e3c37183-be28-33ed-b878-a1736d8751ca",
                                                "text": "Tradition credits John the Baptist with wearing a girdle fashioned of wormwood, while he was in the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e63dfb5-747d-3b81-bd6c-2e2ab8385cf0",
                                        "entry_id": "59e02c5b-d86e-3d41-b472-6170db8cd527",
                                        "glosses": [
                                            "A garment used to hold the abdomen, hips, buttocks, and/or thighs in a particular shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08650527-ff93-34ba-a4fe-c515e5ab7038",
                                        "entry_id": "59e02c5b-d86e-3d41-b472-6170db8cd527",
                                        "glosses": [
                                            "The line of greatest circumference of a brilliant-cut diamond, at which it is grasped by the setting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f54581e-c95c-3c61-bb54-006941da42e9",
                                        "entry_id": "59e02c5b-d86e-3d41-b472-6170db8cd527",
