                                    {
                                        "sense_id": "c10f9bf5-ae80-3267-a82f-2fe28b4aac6a",
                                        "entry_id": "b7f2d69b-16b1-3301-bf13-5ea049ab81ab",
                                        "glosses": [
                                            "A kind; a stylistic category or sort, especially of literature or other artworks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72001dcc-8fe9-4f10-8f13-a57c26926a69",
                                                "sense_id": "c10f9bf5-ae80-3267-a82f-2fe28b4aac6a",
                                                "text": "The still life has been a popular genre in painting since the 17th century."
                                            },
                                            {
                                                "example_id": "56539874-d131-4312-962e-a0fcccde96da",
                                                "sense_id": "c10f9bf5-ae80-3267-a82f-2fe28b4aac6a",
                                                "text": "This film is a cross-genre piece, dark and funny at the same time."
                                            },
                                            {
                                                "example_id": "f85b1c4f-6432-4ee2-b7b9-f611bc09d945",
                                                "sense_id": "c10f9bf5-ae80-3267-a82f-2fe28b4aac6a",
                                                "text": "The computer game Half-Life redefined the first-person shooter genre."
                                            },
                                            {
                                                "example_id": "ff91ad94-1730-435f-8d69-8223f6ebebba",
                                                "sense_id": "c10f9bf5-ae80-3267-a82f-2fe28b4aac6a",
                                                "text": "One of the difficulties that plague conversations about industrial music is that the genre has come to include (to the chagrin and outright denial of some purists) anything from gentle synthesized droning to metal-inspired riffage."
                                            }
                                        ]
                                    }
                                ]
                            },
