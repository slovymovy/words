                    {
                        "form_id": "9a578871-a007-4a12-9044-43bc2e8f8555",
                        "entry_id": "c0fc2d45-a5b9-37aa-a508-27aeb47d92a2",
                        "tags": [
                            "accusative",
                            "plural"
