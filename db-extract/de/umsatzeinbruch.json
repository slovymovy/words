                ],
                "senses": [
                    {
                        "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                        "entry_id": "b7039871-631b-3e93-880b-0240ff477f57",
                        "glosses": [
                            "(plötzlicher und starker) Rückgang des Umsatzes einer Firma oder Branche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3023d6c-ce58-4ef4-ae51-1c9669731e22",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„Der Chemieriese kündigte an, nach dem Gewinn- und Umsatzeinbruch im zweiten Quartal nun deutlich die Kosten zu reduzieren.“"
                            },
                            {
                                "example_id": "1dd52eae-4f82-40da-962f-3d540f79b156",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„Am härtesten traf es die Ostschweizer Betriebe, die im Vergleich zur Vorjahresperiode einen Umsatzeinbruch von über 37 Prozent hinnehmen mussten.“"
                            },
                            {
                                "example_id": "5dc82499-bcc0-4fa4-bd21-c97a946a3cb1",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„Der FC Basel hat im vergangenen Jahr einen regelrechten Umsatzeinbruch erlebt, rund 44 Millionen Franken hat der Verein 2017 weniger eingenommen als im Vorjahr.“"
                            },
                            {
                                "example_id": "40f93f2d-8e1e-4a7a-9e15-f69d5108eb6f",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„Intel verzeichnet einen Umsatzeinbruch von gut einem Drittel (36 Prozent) und einen Nettoverlust von 2,8 Milliarden US-Dollar (2,54 Milliarden Euro).“"
                            },
                            {
                                "example_id": "2954cbf9-3833-44d9-9aa2-ab1cd561422c",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„Der Internetkonzern Yahoo! hat wegen des schwächelnden Werbegeschäfts erneut einen Umsatzeinbruch erlitten.“"
                            },
                            {
                                "example_id": "33ce5736-51a1-493b-88a2-bbf4aae19455",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„In Deutschland verbuchte der Handels- und Dienstleistungskonzern einen kräftigen Umsatzeinbruch.“"
                            },
                            {
                                "example_id": "4fc42468-b9ba-4f63-a0f1-4f6a1ff7a0e1",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„Der Verkauf von Küchen- und Haushaltsartikeln bildet zwar auch heute noch das Hauptgeschäft, doch musste Tupperware zwischen 1996 und 2006 in diesem Bereich einen Umsatzeinbruch von bis zu 26 % und einen noch stärkeren Gewinneinbruch hinnehmen.“"
                            },
                            {
                                "example_id": "d579cf7d-77c9-42e5-9db1-3b271d02ad16",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "„2001 hatte die Firma knapp 100 Mitarbeiter, aufgrund eines Umsatzeinbruches um 30 % im Folgejahr reduzierte sich diese Zahl jedoch um die Hälfte.“"
                            },
                            {
                                "example_id": "ca353163-3705-4070-b74c-c8880a638848",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "[Coronapandemie 2022:] „Die deutschen Einzelhändler haben das erste Halbjahr mit dem stärksten Umsatzeinbruch seit 28 Jahren beendet.\""
                            },
                            {
                                "example_id": "bdb3a361-1fec-4600-a209-cbbfd71aa8eb",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "[Coronapandemie 2021:] „Der Handelsverband Textil spricht mit Blick auf den monatelangen Lockdown von einem \"historischen Umsatzeinbruch\" in der Branche.“"
                            },
                            {
                                "example_id": "c755b4bf-eeb4-4cef-9934-0aad731aa327",
                                "sense_id": "078122f5-d4d8-3994-9478-f746a2c0bc99",
                                "text": "[Coronapandemie 2021:] „Sollte der harte Lockdown bis Anfang März dauern und es anschließend sukzessive Öffnungen für die Kultur geben, würde das einen voraussichtlichen Umsatzeinbruch von 11,5 Milliarden Euro bedeuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
