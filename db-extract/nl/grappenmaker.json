                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b022c0a1-c6ac-37a9-9abd-e15b7c146445",
                        "entry_id": "9bfe4e5d-7aca-3084-baa2-612eb99d6ad4",
                        "glosses": [
                            "someone who cannot be taken seriously; buffoon, clown, phony"
                        ],
                        "tags": [
                            "Suriname",
                            "derogatory",
                            "figuratively",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "297054c6-4bb0-4567-a3ad-d08456aaa11d",
                                "sense_id": "b022c0a1-c6ac-37a9-9abd-e15b7c146445",
                                "text": "De vele investeerders die in de rij zouden staan, bleken grappenmakers te zijn.",
                                "translation": "The many investors supposedly lining up turned out to be phonies.",
                                "english": "The many investors supposedly lining up turned out to be phonies."
                            },
                            {
                                "example_id": "ac7c8416-49f9-4e8c-bdf8-569c1167de41",
                                "sense_id": "b022c0a1-c6ac-37a9-9abd-e15b7c146445",
                                "text": "“(...) Vooral de minister van Sociale Zaken is een grappenmaker die niets goed kan doen. Daar heb je helemaal niets aan.”",
                                "translation": "\"The social affairs minister in particular is a buffoon who can't do anything right. He's no use at all.\"",
                                "english": "\"The social affairs minister in particular is a buffoon who can't do anything right. He's no use at all.\""
                            },
                            {
                                "example_id": "e5a95ff6-b98e-4f14-a020-648ccf140472",
                                "sense_id": "b022c0a1-c6ac-37a9-9abd-e15b7c146445",
                                "text": "Voor de kiezers moet nu duidelijk zijn dat ze te maken hebben met charlatans, ‘oplichters’ en grappenmakers die zonder blikken of blozen, bereid zijn je op te lichten met praatjes.",
                                "translation": "It should now be clear to voters that they are dealing with charlatans, ‘scammers’ and buffoons who, without batting an eyelid, are willing to rip them off with fancy talk.",
                                "english": "It should now be clear to voters that they are dealing with charlatans, ‘scammers’ and buffoons who, without batting an eyelid, are willing to rip them off with fancy talk."
                            }
                        ]
                    }
                ],
