                "senses": [
                    {
                        "sense_id": "175b6eb6-78b7-367a-958f-eb70d88b21ac",
                        "entry_id": "66957e88-a7ef-3392-99c1-e9a82f27775a",
                        "glosses": [
                            "The act by which something is dyed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8fd2df-e832-4527-ba80-fc9758087c20",
                                "sense_id": "175b6eb6-78b7-367a-958f-eb70d88b21ac",
                                "text": "Ninety per cent of the dyeings on silk, 72 per cent of the dyeings on rayon, 70 per cent of the dyeings on cotton showed no color change."
                            },
                            {
                                "example_id": "39f6fe90-bdad-4ce6-81d1-178a6302c686",
                                "sense_id": "175b6eb6-78b7-367a-958f-eb70d88b21ac",
                                "text": "In the traditional workshops of Surakarta, where the best quality batik tulis textiles are still created, low-paid women and girls use melted wax to meticulously hand-draw patterns before subsequent dyeings and rewaxings, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56d714c0-7271-4a45-a89f-17ed4163d37e",
                        "source_entry_id": "66957e88-a7ef-3392-99c1-e9a82f27775a",
                        "source_sense_id": "175b6eb6-78b7-367a-958f-eb70d88b21ac",
                        "source_sense_description": "Translations",
                        "target_lang_word": "teñido",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teñido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a94f78ce-52ce-3aed-8ace-79e3641c4d79",
                                        "entry_id": "25a5b800-3b78-3d00-bf42-ef1f2ec7c39a",
                                        "glosses": [
                                            "Acción o efecto de teñir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25e2c21-404c-49d0-8b18-14e2df58bf69",
                                                "sense_id": "a94f78ce-52ce-3aed-8ace-79e3641c4d79",
                                                "text": "Atúvose a esto, corrióse el teñido y deshízose el casamiento."
                                            },
                                            {
                                                "example_id": "befc5b1e-c031-4018-a423-eda2cc12c5a4",
                                                "sense_id": "a94f78ce-52ce-3aed-8ace-79e3641c4d79",
                                                "text": "El azafrán se prepara por infusión en agua para el teñido y en alcohol cuando se deba emplear con pincel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "teñido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "652d7b49-c131-3b52-9f8f-651f71e20c60",
                                        "entry_id": "9a45f86d-de64-3154-be50-c27b3f863a3f",
                                        "glosses": [
                                            "Participio de teñir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e437bd5f-0704-4d78-94df-cce6fed428ab",
                                                "sense_id": "652d7b49-c131-3b52-9f8f-651f71e20c60",
                                                "text": "por eso lo trayan vestido blanco, significando mundiçia, e de aquel colgados los ocho filos a cada angulo teñidos con sangre de ylazon."
                                            },
                                            {
                                                "example_id": "3089e5f8-88a8-4c5f-bdef-6a00416940b9",
                                                "sense_id": "652d7b49-c131-3b52-9f8f-651f71e20c60",
                                                "text": "no como el ambicioso entremetido,\nque con seso perdido\nanda tras el favor, tras la privanza,\nsin nunca haber teñido\nen turca o en mora sangre espada o lanza."
                                            },
                                            {
                                                "example_id": "17171533-02b7-434a-81db-576c9ab5ab6c",
                                                "sense_id": "652d7b49-c131-3b52-9f8f-651f71e20c60",
                                                "text": "Es necesario que llegues de pronto a la oficina con otro aspecto: nuevo corte de pelo, teñido de rubio, con lentes de contacto que te den ojos claros y diferente estilo de ropa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
