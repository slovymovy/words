                        "translation_id": "94447c80-5d30-49ae-b85d-dc3a833e4856",
                        "source_entry_id": "fd7d3ecd-8ada-3ceb-8730-b16aca26298e",
                        "source_sense_id": "bd3f0493-1e08-36f8-b09b-f0eba8e057e8",
