                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die ersten warmen Sonnenstrahlen <w>drangen</w> mühsam durch den dichten Nebel des Tals."
                        },
                        {
                            "text": "Trotz der geschlossenen Fenster <w>dringt</w> der laute Baustellenlärm direkt in die Wohnung."
                        }
                    ],
