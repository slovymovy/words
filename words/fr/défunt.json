                {
                    "sense_id": "e6acab16-2a4c-3a9e-83fb-a97432416a31",
                    "sense_definition": "Qui a cessé d'exister, qui appartient au passé ou qui est révolu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "passe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée retrace l'histoire économique et sociale de la <w>défunte</w> entreprise ferroviaire.",
                            "target_lang_translations": {
                                "en": "This museum traces the economic and social history of the <w>defunct</w> railway company.",
                                "ru": "Этот музей рассказывает об экономической и социальной истории <w>ликвидированной</w> железнодорожной компании.",
                                "de": "Dieses Museum zeichnet die Wirtschafts- und Sozialgeschichte der <w>aufgelösten</w> Eisenbahngesellschaft nach.",
                                "es": "Este museo recorre la historia económica y social de la <w>desaparecida</w> empresa ferroviaria.",
                                "zh": "这座博物馆追溯了这家<w>已停业的</w>铁路公司的经济与社会历史。"
                            }
                        },
                        {
                            "text": "Les historiens étudient les vestiges de cette <w>défunte</w> civilisation méditerranéenne.",
                            "target_lang_translations": {
                                "en": "Historians study the remains of this <w>extinct</w> Mediterranean civilisation.",
                                "ru": "Историки изучают остатки этой <w>исчезнувшей</w> средиземноморской цивилизации.",
                                "de": "Historiker erforschen die Überreste dieser <w>untergegangenen</w> mediterranen Zivilisation.",
                                "es": "Los historiadores estudian los vestigios de esta <w>extinta</w> civilización mediterránea.",
                                "zh": "历史学家正在研究这一<w>已消亡的</w>地中海文明的遗迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disparu",
                        "révolu"
                    ],
                    "common_phrases": [
                        "défunte république",
                        "défunte entreprise"
                    ],
                    "target_lang_definitions": {
