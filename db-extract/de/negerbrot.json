                "senses": [
                    {
                        "sense_id": "f6d94c81-ae87-3c60-a12b-80825653bbe5",
                        "entry_id": "81e2f95f-313e-3a73-b979-47e0ce90cadf",
                        "glosses": [
                            "eine Schokolade mit Aschantinüssen/Erdnüssen, die in den 1970er- und 1980er-Jahren in Österreich äußerst beliebt war (die Nussschokolade wurde etwa bei der Supermarktkette „Zielpunkt“ in „Schokotraum Erdnuss“ umbenannt, da die Verwendung des Begriffs Neger gegenüber anderen Menschen heutzutage als diskriminierend und rassistisch gilt)"
                        ],
                        "tags": [
                            "gemeinhin ohne Plural",
                            "ehemals die Bezeichnung für"
                        ],
                        "examples": [
                            {
                                "example_id": "c4350898-2c8d-4cd6-b41c-a9c99cd011ca",
                                "sense_id": "f6d94c81-ae87-3c60-a12b-80825653bbe5",
                                "text": "Mohr im Hemd, Zigeunerschnitzel und Negerbrot sind immer noch in den Wiener Geschäftslokalen zu haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e7f6d6d-3efc-3a90-b840-78dbd4cc81d7",
                        "entry_id": "81e2f95f-313e-3a73-b979-47e0ce90cadf",
                        "glosses": [
                            "ein Waffelgebäck (das nach Aufforderung der ISD (ISD Bund e.V. Initiative Schwarze Menschen in Deutschland) in „Knabberschnitten“ umbenannt wurde, da die Verwendung des Begriffs Neger gegenüber anderen Menschen heutzutage als diskriminierend und rassistisch gilt)"
                        ],
                        "tags": [
                            "ehemals ein von „Dr. Oetker“ unter diesem Namen veröffentlichtes Rezept für"
                        ],
                        "examples": [
                            {
                                "example_id": "28028061-4d53-4336-adf0-6c7a65ce2890",
                                "sense_id": "0e7f6d6d-3efc-3a90-b840-78dbd4cc81d7",
                                "text": "Das Unternehmen Dr. Oetker hatte sowohl in seinem Backbuch als auch im Internet ein Rezept unter dem Namen Negerbrot angeführt."
                            }
                        ],
