                                "target_senses": [
                                    {
                                        "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                        "entry_id": "72869c92-bfbd-36f5-b461-d6f22309a989",
                                        "glosses": [
                                            "einen hohen Preis oder hohe Kosten aufweisend oder verursachend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a1212e-95b9-4dfe-ba8a-df0252b91e65",
                                                "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                                "text": "Er hat ihr einen sehr teuren Ring geschenkt."
                                            },
                                            {
                                                "example_id": "c34a60a4-1d44-41e2-808b-1248cfdbab00",
                                                "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                                "text": "Eines sage ich dir jetzt schon: Das wird dich teuer zu stehen kommen."
                                            },
                                            {
                                                "example_id": "67ba15c3-0a9b-4998-883c-3f584e747d75",
                                                "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                                "text": "Um 50 Millionen Euro soll das neue Krankenhaus in Bremen-Mitte teurer werden und damit insgesamt etwa 350 Millionen Euro kosten"
                                            },
                                            {
                                                "example_id": "2ad7a0db-d17f-4e5d-bdb1-5a1472f65a88",
                                                "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                                "text": "Er ist einer der teuersten zeitgenössischen Fotografen der Welt. Seine Fotokunst hängt in Museen von München bis New York. […] Andreas Gursky"
                                            },
                                            {
                                                "example_id": "bdb15c40-1aa2-46f2-97c8-cc5de69e6ac1",
                                                "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                                "text": "Auch teure Textilien sind kein Garant für faire Herstellung."
                                            },
                                            {
                                                "example_id": "78b26cdc-f6f8-44f8-8745-a86a0c9d2fee",
                                                "sense_id": "b2563473-f224-30ee-b69f-404fd0c5f24f",
                                                "text": "Dass der Brexit für die Briten teuer wird, ist schon länger klar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "449990da-79cd-3e26-894d-b0cf19c1be01",
                                        "entry_id": "72869c92-bfbd-36f5-b461-d6f22309a989",
                                        "glosses": [
                                            "geliebt, von persönlichem Wert"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a145c077-5d95-4c86-92f7-d36dfa74ce3c",
                                                "sense_id": "449990da-79cd-3e26-894d-b0cf19c1be01",
                                                "text": "Teuerster Freund, wie schön ist es von Dir zu hören, da wir so lange nichts von einander hörten."
                                            },
                                            {
                                                "example_id": "0ded5142-2014-4636-a28f-c3ae9c28754a",
                                                "sense_id": "449990da-79cd-3e26-894d-b0cf19c1be01",
                                                "text": "Dieses alte Schmuckstück ist mir lieb und teuer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
