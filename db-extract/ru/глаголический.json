                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glagolitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d9c316-28ba-3bc9-921f-7381bac81f47",
                                        "entry_id": "2919a1c3-6a0e-3cfa-adc0-a4a098301bd5",
                                        "glosses": [
                                            "in der Schrift Glagoliza verfasst/geschrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52722228-6741-4671-a343-abff8dbb23ca",
                                                "sense_id": "a4d9c316-28ba-3bc9-921f-7381bac81f47",
                                                "text": "„863 reisten die Brüder nach Großmähren. Dort führten sie die glagolitische Schrift ein, brachten ihre Übersetzungen und das Doppelkreuz aus Byzanz mit.“"
                                            }
                                        ],
