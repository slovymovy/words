                                        "entry_id": "ab42b17e-0567-3a18-a1db-e7afb5347a4b",
                                        "glosses": [
                                            "in Bezug auf die Sinnenfreude; sich am sinnlichen Genuss erfreuend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95168730-a66b-42a7-8039-75eaa904f89d",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Norio riecht sinnenfreudig am Wein, kostet und dreht dann das Glas genüsslich in seiner Hand.“"
                                            },
                                            {
                                                "example_id": "b6b19116-be53-46aa-8b95-3f9dbda0d21a",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Sie ist empathisch, hilfsbereit und sinnenfreudig, sie hat Glück, dass sie einen Beruf findet, in dem sie diese Potenziale ausleben kann.“"
                                            },
                                            {
                                                "example_id": "2916d3b7-0525-432e-9aba-ba2b1b815ec5",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Am Abend machte Sophie es sich im Wohnzimmer bequem und schaute sinnenfreudig fern – ein Luxus, den sie sich in ihren fernsehlosen Unterkünften nicht leisten konnte.“"
                                            },
                                            {
                                                "example_id": "caacc156-ca6f-4f2f-a2dd-69e821de0fb6",
                                                "sense_id": "125aacc2-889e-31af-99b8-8c541d094b52",
                                                "text": "„Sie beobachtete eine Wespe, die sich sinnenfreudig an Sylvies frisch gepresstem Orangensaft delektierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
