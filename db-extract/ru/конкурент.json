                                    },
                                    {
                                        "sense_id": "5b1f74b1-2fd1-3071-96cf-5721d70ea05c",
                                        "entry_id": "a067cb6e-8fb5-309c-aba6-59ab26f4ef56",
                                        "glosses": [
                                            "Partner, associate, one working with another toward a common goal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cad4508-2796-473c-af52-3f61e5f7fd4a",
                                                "sense_id": "5b1f74b1-2fd1-3071-96cf-5721d70ea05c",
                                                "text": "Ioine with me now in this my meane eſtate, […]\nAnd when my name and honor ſhall be ſpread,\nAs far as Boreas claps his braſen wings,\nOr faire Botëes ſends his cheerefull light.\nThen ſhalt thou be Competitor with me,\nAnd ſit with Tamburlaine in all his maieſtie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c321ea1a-f767-4ff4-b04a-6abbef64ed91",
                        "source_entry_id": "b169cf67-51ef-3a22-8850-02fd50ffcefc",
                        "source_sense_id": "3d57ae28-80f9-3e99-b305-25dd9a70da5a",
                        "target_lang_word": "Konkurrent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konkurrent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b20989e-eb4a-3e10-877b-673c52063112",
                                        "entry_id": "f7f7cf1c-2a44-32ba-9d19-f5b2e3a09a4b",
                                        "glosses": [
                                            "jemand, der das gleiche Ziel wie sein(e) Mitbewerber verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e3318c-7ae9-4c50-be69-600402237dd3",
                                                "sense_id": "9b20989e-eb4a-3e10-877b-673c52063112",
                                                "text": "Durch Tricks hat er seine Konkurrenten ausgeschaltet."
                                            },
                                            {
                                                "example_id": "60b7d7e1-4ea5-4437-ad74-0d552463bc0f",
                                                "sense_id": "9b20989e-eb4a-3e10-877b-673c52063112",
                                                "text": "Auch der härteste Konkurrent ist immer auch eine Lehrer, der durch sein Tun auf Schwächen und Fehler hinweist."
                                            },
                                            {
                                                "example_id": "0fb4f469-2cbd-4de5-91f7-c0cabed7be9e",
                                                "sense_id": "9b20989e-eb4a-3e10-877b-673c52063112",
                                                "text": "„Fürst hatte einen Konkurrenten geklagt, der für seine Kugeln die gleiche Verpackungsart wählte, um am Erfolg teilzuhaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
