                ],
                "senses": [
                    {
                        "sense_id": "ee405599-1ac4-359a-9e0c-6201cc50270f",
                        "entry_id": "0bd032ab-274a-3f0e-9df1-ef12fcdc1992",
                        "glosses": [
                            "nur wenig oder kein Dotter enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e4cf57-ca70-459c-bc6e-5a720386f2cc",
                                "sense_id": "ee405599-1ac4-359a-9e0c-6201cc50270f",
                                "text": "„Alle Eier, auch die kleinsten und einfachsten, enthalten eine gewisse Menge von Deutoplasma, welches entweder gleichmäßig (alezithale, besser homolezithale Eier) oder ungleichmäßig (telolezithale Eier) verteilt ist.“"
                            },
                            {
                                "example_id": "c92313ce-1f88-4d17-b9a5-838d9017d1b2",
                                "sense_id": "ee405599-1ac4-359a-9e0c-6201cc50270f",
                                "text": "„Sie besitzen eine sehr zarte Dottermembran und gehören in bezug auf die Verteilung des Nahrungsdotters dem alezithalen Typus an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
