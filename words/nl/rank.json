{
    "word_family": [
        "ranken",
        "rankheid",
        "slank"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "619d7984-4996-3f00-aaae-4d77f990025d",
                    "sense_definition": "met een sierlijke, dunne en fijne lichaamsbouw",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft een <w>rank</w> figuur dat perfect past bij haar werk als danseres.",
                            "target_lang_translations": {
                                "en": "She has a <w>slender</w> figure that fits her work as a dancer perfectly."
                            }
                        },
                        {
                            "text": "De <w>ranke</w> dennenbomen staken hoog boven de rest van het bos uit.",
                            "target_lang_translations": {
                                "en": "The <w>slender</w> pine trees stood out high above the rest of the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "slank",
                        "tenger",
                        "fijngebouwd"
                    ],
                    "antonyms": [
                        "gezet",
                        "breed",
                        "lomp"
                    ],
                    "common_phrases": [
                        "ranke gestalte",
                        "rank figuur"
                    ],
                    "target_lang_definitions": {
                        "en": "having a graceful, thin, and fine physique"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slender",
                                "target_lang_sense_clarification": "gracefully thin"
                            },
                            {
                                "target_lang_word": "slim",
                                "target_lang_sense_clarification": "thin in an attractive way"
                            },
                            {
                                "target_lang_word": "lithe",
                                "target_lang_sense_clarification": "thin and graceful"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12042ca9-85c9-3cfc-82c1-9e2fac9e10ef",
                    "sense_definition": "een dunne, kronkelende stengel van een klimplant die zich ergens aan vasthecht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plantkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>rank</w> van de druivenplant wikkelde zich stevig om het houten hek.",
                            "target_lang_translations": {
                                "en": "The <w>tendril</w> of the grape plant wrapped itself firmly around the wooden fence."
                            }
                        },
                        {
                            "text": "Die <w>rank</w> zat echt om het hele hek heen gekruld.",
                            "target_lang_translations": {
                                "en": "That <w>tendril</w> was really curled around the entire fence."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitloper",
                        "hechtstengel"
                    ],
                    "common_phrases": [
                        "ranken van de wijnstok"
                    ],
                    "target_lang_definitions": {
                        "en": "a thin, winding stem of a climbing plant that attaches itself to something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tendril",
                                "target_lang_sense_clarification": "climbing plant stem"
                            },
                            {
                                "target_lang_word": "runner",
                                "target_lang_sense_clarification": "plant shoot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e16f35a-9941-33e7-b063-ec45918907cf",
                    "sense_definition": "een versiering of patroon dat lijkt op de kronkelende stengel van een plant",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rand van het antieke zilveren bord was versierd met fijne <w>ranken</w>.",
                            "target_lang_translations": {
                                "en": "The edge of the antique silver plate was decorated with fine <w>scrollwork</w>."
                            }
                        },
                        {
                            "text": "In het behang zag je een patroon van gouden <w>ranken</w> en bloemen.",
                            "target_lang_translations": {
                                "en": "In the wallpaper, you could see a pattern of golden <w>tendrils</w> and flowers."
                            }
                        }
                    ],
                    "synonyms": [
                        "arabesk",
                        "krul"
                    ],
                    "common_phrases": [
                        "bloemrijke ranken"
                    ],
                    "target_lang_definitions": {
                        "en": "a decoration or pattern resembling the winding stem of a plant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrollwork",
                                "target_lang_sense_clarification": "ornamental design"
                            },
                            {
                                "target_lang_word": "arabesque",
                                "target_lang_sense_clarification": "flowing pattern"
                            },
                            {
                                "target_lang_word": "tendril",
                                "target_lang_sense_clarification": "decorative motif"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c78b1978-a092-3941-847e-805dd892281b",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>ranken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rank</w> de planten langs de muur zodat ze omhoog kunnen groeien.",
                            "target_lang_translations": {
                                "en": "I <w>train</w> the plants along the wall so that they can grow upwards."
                            }
                        },
                        {
                            "text": "Ik <w>rank</w>.",
                            "target_lang_translations": {
                                "en": "I <w>train</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'ranken' (to train or guide a plant)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "train",
                                "target_lang_sense_clarification": "guiding plant growth"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}