                                "sense_id": "9fab879b-3730-3e7a-80c3-b0e2f9626e30",
                                "text": "Grote vrachtschepen meren aan in de zeehaven.",
                                "translation": "Large cargo ships dock at the seaport.",
                                "english": "Large cargo ships dock at the seaport."
                            },
                            {
                                "example_id": "74900794-9f28-4f1d-858f-e0fef4b9a477",
                                "sense_id": "9fab879b-3730-3e7a-80c3-b0e2f9626e30",
                                "text": "Het zeehaventje was een populaire plek voor toeristen.",
                                "translation": "The small seaport was a popular spot for tourists.",
