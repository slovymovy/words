                                                "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                                "text": "Zwei Schwimmer geben dem Wasserflugzeug den nötigen Auftrieb."
                                            },
                                            {
                                                "example_id": "eacbb05e-335d-40e8-9dab-1abad3c23285",
                                                "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                                "text": "„Der Schwimmer hüpfte hin und wieder an die Oberfläche, und die Leine wurde schlaff.“"
                                            }
                                        ],
