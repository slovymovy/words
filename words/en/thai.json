        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34203a43-0d66-36e2-9da6-eea8b9fac997",
                    "sense_definition": "Of or pertaining to Thailand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to a popular <w>Thai</w> restaurant for dinner last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы ходили ужинать в популярный <w>тайский</w> ресторан.",
                                "zh": "昨晚我们去了一家很受欢迎的<w>泰式</w>餐厅吃晚饭。"
                            }
                        },
                        {
                            "text": "A group of <w>Thai</w> researchers discovered a new species of spider.",
                            "target_lang_translations": {
                                "ru": "Группа <w>тайских</w> исследователей обнаружила новый вид пауков.",
                                "zh": "一群<w>泰国</w>研究人员发现了一种新的蜘蛛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Thai food",
                        "Thai massage",
                        "Thai boxing",
                        "Thai silk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Таиланду, его народу, языку или культуре.",
                        "zh": "与泰国有关的，或属于泰国的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "та́йский",
                                "target_lang_sense_clarification": "относящийся к культуре, народу или языку"
                            },
                            {
                                "target_lang_word": "таила́ндский",
                                "target_lang_sense_clarification": "относящийся к государству Таиланд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泰国的",
                                "target_lang_sense_clarification": "指代国家或地理位置"
                            },
                            {
                                "target_lang_word": "泰式的",
                                "target_lang_sense_clarification": "指代文化、风格或烹饪"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a1e2206-0357-31b0-8df8-5241e889cff6",
