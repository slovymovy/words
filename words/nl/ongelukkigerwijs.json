                    "sense_id": "71cbb900-12b2-395e-b765-82d33affee39",
                    "sense_definition": "op een betreurenswaardige of ongunstige manier; helaas",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ongelukkigerwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ongelukkigerwijs</w> kon de geplande bijeenkomst gisteravond niet doorgaan vanwege de plotselinge storm.",
                            "target_lang_translations": {
                                "en": "<w>Unfortunately</w>, the planned meeting could not take place last night due to the sudden storm."
                            }
                        },
                        {
                            "text": "Hij was <w>ongelukkigerwijs</w> zijn sleutels vergeten toen hij de deur achter zich dichttrok.",
                            "target_lang_translations": {
                                "en": "He had <w>unfortunately</w> forgotten his keys when he pulled the door shut behind him."
                            }
                        }
                    ],
                    "synonyms": [
                        "helaas",
                        "jammer genoeg",
                        "ongelukkig genoeg"
