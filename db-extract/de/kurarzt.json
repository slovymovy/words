                "senses": [
                    {
                        "sense_id": "aba03853-9112-3344-a77e-17531fbedf57",
                        "entry_id": "f6f5761b-43da-39fe-9331-e9bb9272dd37",
                        "glosses": [
                            "an einem Bade- und Kurort ansässiger Arzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c06978-04b7-48b4-96c5-5f84c33ab85a",
                                "sense_id": "aba03853-9112-3344-a77e-17531fbedf57",
                                "text": "„Beim Kurarzt angekommen, legte ich all meine Befunde sowie meine Medikamentenliste vor.“"
                            },
                            {
                                "example_id": "b91c7c1b-8d62-4fcf-8499-a9d5dff27d3c",
                                "sense_id": "aba03853-9112-3344-a77e-17531fbedf57",
                                "text": "„Die Patienten, bei denen der Kurarzt keine eindeutige Diagnose stellen konnte, suchte er auch bei einer drei- oder vierwöchigen Kur alle zwei Tage auf.“"
                            },
                            {
                                "example_id": "6b818b22-cb10-4fe5-9054-1dd48da0e04a",
                                "sense_id": "aba03853-9112-3344-a77e-17531fbedf57",
                                "text": "„Der Kurarzt kann hingegen in besonderen Fällen bei der Entlassung eine Empfehlung aussprechen, diesen Zeitraum zu verkürzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
