                "senses": [
                    {
                        "sense_id": "69f1c87a-d47e-3e00-a48b-583385bce624",
                        "entry_id": "b346f3ea-a2d3-3403-90aa-6ac213af5d23",
                        "glosses": [
                            "диал. резкий, холодный осенний ветер с дождём, часто и со снегом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f73f80b-2fe9-4084-b642-ef9fbce5ad2f",
                                "sense_id": "69f1c87a-d47e-3e00-a48b-583385bce624",
                                "text": "― Как тебя бог донес такую непуть? Ведь холод, чичер, а ты шел."
                            },
                            {
                                "example_id": "e8b588ba-cb0e-4d55-b4fd-93aea7a0b293",
                                "sense_id": "69f1c87a-d47e-3e00-a48b-583385bce624",
                                "text": "― Ты куда? Чичер, холод ― а она, накося! С мальчишками на пруд! Сейчас лезь на печь, а то смотри у меня, демоненок!"
                            }
                        ]
                    }
                ],
