        "fr-extract.jsonl": [
            {
                "entry_id": "d690d9db-440e-3add-8bed-458d2264a889",
                "word": "circonspection",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6c70218-74c8-48c2-8700-ceaf7845b539",
                        "entry_id": "d690d9db-440e-3add-8bed-458d2264a889",
                        "tags": [
                            "plural"
                        ],
                        "form": "circonspections"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                        "entry_id": "d690d9db-440e-3add-8bed-458d2264a889",
                        "glosses": [
                            "Manière d’agir ou de parler de celui qui est circonspect, qui fait attention aux circonstances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0f55cc-0d34-4142-88fb-33b460412cd4",
                                "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                                "text": "les Swann se distinguaient par leur fierté, leur puissance et leur circonspection."
                            },
                            {
                                "example_id": "9d081d84-5105-4e36-b0f4-7e49489e5310",
                                "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                                "text": "Ma foi, il me recommande d'avoir plus de circonspection, je n'en manque pas. Hé ! diantre, je suis notaire et membre de ma chambre."
                            },
                            {
                                "example_id": "371b58ad-308d-4058-9bad-670174c0c340",
                                "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                                "text": "— Songez, monsieur, que l’éducation des pauvres doit être faite avec beaucoup de circonspection et en vue de l’état de dépendance qu’ils doivent avoir dans la société."
                            },
                            {
                                "example_id": "db71c864-6f8a-475e-a2e1-0c757e974a4f",
                                "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                                "text": "Or, dans la triangulation anglo-russe qui allait être entreprise, le choix du méridien devait être fait avec une extrême circonspection."
                            },
                            {
                                "example_id": "ebaf3f37-7fd3-4941-a961-f02e74d827ea",
                                "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                                "text": "Et il fit pouët-pouët avec un klaxon en se tapant les cuisses de rire. Les deux agents secrets se regardèrent avec circonspection."
                            },
                            {
                                "example_id": "02974fdc-d4ce-4581-8c18-280ac70ef324",
                                "sense_id": "fab90929-1195-3fbd-8fc5-334f61a6bb91",
                                "text": "L’extrême petitesse de l’amortissement aux températures de la neige carbonique et de l’air liquide oblige à beaucoup de circonspections dans l’interprétation des résultats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcb2c573-0d45-4341-9274-1d415c9029c5",
                        "source_entry_id": "d690d9db-440e-3add-8bed-458d2264a889",
