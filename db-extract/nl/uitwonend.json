                            {
                                "example_id": "19566d66-225e-4029-9c80-3a3e8a151856",
                                "sense_id": "4d32ef58-9f26-3201-9410-651629e13df1",
                                "text": "De au pair en het gastgezin handelen in strijd met de regeling voor au pairs als de au pair niet woont bij het gastgezin in huis."
                            }
                        ]
                    },
                    {
                        "sense_id": "11a46ed1-6309-3592-aeab-10f9ea0ff503",
                        "entry_id": "cc18f5de-a8a3-3a6b-b11b-dd98e6f11801",
                        "glosses": [
                            "niet in het ouderlijk huis wonend"
