                                        "entry_id": "ee0fe624-8a81-3f21-852f-3f1155591ed6",
                                        "glosses": [
                                            "To separate and reserve something for a specific purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce06756-9aa5-4434-aec1-17baf86b1e45",
                                                "sense_id": "1cdac947-1357-3389-b9a4-bdd1ab3354d9",
                                                "text": "Plan to set aside three or four hours to see the museum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe0c129-b849-32c6-bf99-3d9d980c8a38",
                                        "entry_id": "ee0fe624-8a81-3f21-852f-3f1155591ed6",
                                        "glosses": [
                                            "To leave out of account; to omit or neglect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef25b57f-40b1-4b06-beb8-7f9d889f0a2d",
                                                "sense_id": "1fe0c129-b849-32c6-bf99-3d9d980c8a38",
                                                "text": "[…] therefore setting aside all other considerations, I will endeavour to know the truth, and yield to that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02ced22e-cc65-3eb9-be03-3d6309d6c9b1",
                                        "entry_id": "ee0fe624-8a81-3f21-852f-3f1155591ed6",
                                        "glosses": [
                                            "To disagree with something and reject or overturn it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "950a21d4-fdb9-3610-ae3d-f700328e09bc",
                                        "entry_id": "ee0fe624-8a81-3f21-852f-3f1155591ed6",
                                        "glosses": [
                                            "To declare something invalid or null and void."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f1dcc55-a1b8-44fe-a1ee-3ccd6df89ad3",
                                                "sense_id": "950a21d4-fdb9-3610-ae3d-f700328e09bc",
                                                "text": "As is well-known, pikuaḥ nefesh [saving a life], sets aside all the commandments in the Torah except for idol worship, forbidden sexual relationships and murder."
