                        "glosses": [
                            "половина щеки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18392830-a085-4af6-a91d-fc246b92d3de",
                                "sense_id": "a0b48b89-cc00-3030-89fa-0694b520ff2f",
                                "text": "Общие границы румян правильного лица таковы: на лбу они заходят на 1/2 пальца выше бровей, захватывают бока носа, огибают полщеки, подходят к нижней части уха и по виску соединяются с надбровной линией."
                            },
                            {
                                "example_id": "573cd3ba-5cb4-4187-a5ea-15c1dd8e09e9",
                                "sense_id": "a0b48b89-cc00-3030-89fa-0694b520ff2f",
                                "text": "Он носил бакенбарды в полщеки, а подбородок брил ежедневно, с синевой, и по пятницам приходила к нему маникюрша."
                            },
                            {
                                "example_id": "ab3bcba7-e1ad-4049-8e96-a3e5806b90e2",
                                "sense_id": "a0b48b89-cc00-3030-89fa-0694b520ff2f",
                                "text": "[Сосипатра Семеновна (жен, богатая дама)] Оно занимает половину лица: лоб, бровь, левый глаз и полщеки."
                            }
                        ]
                    }
