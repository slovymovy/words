                                                "example_id": "09149c49-3304-414d-a023-8ce4525433fa",
                                                "sense_id": "0515fb7e-564f-35cb-b9e2-5d857df21679",
                                                "text": "Dieser Sandmann geht mir dermaßen auf die Nerven!"
                                            },
                                            {
                                                "example_id": "d4a377c3-e65a-49a1-9f4c-9342d619ee3f",
                                                "sense_id": "0515fb7e-564f-35cb-b9e2-5d857df21679",
                                                "text": "Die Sandmanns kommen nachher zum Essen rüber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea66fd65-e47d-4155-b382-0dc9af433ea5",
                        "source_entry_id": "315ffe24-aab0-374f-8096-548d9f3cd755",
