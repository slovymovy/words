    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "22d683b1-bb89-34a6-a945-40fedf8ff12b",
                "word": "necessitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a152f03b-a008-4a20-b51a-338416da6aac",
                        "entry_id": "22d683b1-bb89-34a6-a945-40fedf8ff12b",
                        "tags": [
                            "plural"
                        ],
                        "form": "necessitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b3e7780-c772-3723-b7c4-bac14796654e",
                        "entry_id": "22d683b1-bb89-34a6-a945-40fedf8ff12b",
                        "glosses": [
                            "The state or characteristic of being in need; neediness."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "831e8d7a-83a0-4a8a-a6a9-590062ef7c6d",
                                "sense_id": "8b3e7780-c772-3723-b7c4-bac14796654e",
                                "text": "It had been of all things the most harassing and wearying—a life of dreary necessitude—a perpetual struggle with debt."
                            },
                            {
                                "example_id": "53311d77-1b14-4787-b650-5bc8eccf6e5a",
                                "sense_id": "8b3e7780-c772-3723-b7c4-bac14796654e",
                                "text": "Even if she could have faced life without him, she could not go through it all again, the bankruptcy and shame and necessitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "35ada2c4-ff10-33bc-8583-e393b890fafb",
                        "entry_id": "22d683b1-bb89-34a6-a945-40fedf8ff12b",
                        "glosses": [
                            "A circumstance or event which is necessary or unavoidable, especially because it is a requirement of a social role or natural state of affairs."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "efe5e0c6-3879-4069-86b6-b1c8e613e9c0",
                                "sense_id": "35ada2c4-ff10-33bc-8583-e393b890fafb",
                                "text": "The Americans. . . fear not the necessitudes of fortune."
                            },
                            {
                                "example_id": "28fdc7c5-a35b-4716-95a9-cc6a4a2323cf",
                                "sense_id": "35ada2c4-ff10-33bc-8583-e393b890fafb",
                                "text": "He lives with them in the isolated home of the tribe and enters into the mysterious communion with the domestic gods who still take part in the necessitudes of the family."
                            },
                            {
                                "example_id": "4b668817-ec61-4f07-97ff-c222eff2486b",
                                "sense_id": "35ada2c4-ff10-33bc-8583-e393b890fafb",
                                "text": "As Conor Cruise O'Brien has pointed out, this passage has a \"poignant ring,\" in light of the probable fact that Burke's father was one of those who betrayed his \"duty\" by sacrificing his \"opinion of eternal happiness\" to the necessitudes of legal practice."
                            }
                        ]
                    },
                    {
                        "sense_id": "99605042-7b75-3727-acfb-e7bee9682d0b",
                        "entry_id": "22d683b1-bb89-34a6-a945-40fedf8ff12b",
                        "glosses": [
                            "Necessity."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b6234dc8-0187-443b-856d-0ca48b1b1bd5",
                                "sense_id": "99605042-7b75-3727-acfb-e7bee9682d0b",
                                "text": "In Popperian terms, it demonstrates the necessitude of public debate."
                            }
                        ]
                    },
                    {
                        "sense_id": "53363e62-5494-3e95-8b21-d2ea9352b584",
                        "entry_id": "22d683b1-bb89-34a6-a945-40fedf8ff12b",
                        "glosses": [
                            "A relation or connection between people or things."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b737e8b7-cd90-44b0-8cac-ad1198074905",
                                "sense_id": "53363e62-5494-3e95-8b21-d2ea9352b584",
                                "text": "The relation and necessitude is trifling and loose, and they are all equally contemptible; because the mind entertains no loves or union."
                            }
                        ]
                    }
                ],
