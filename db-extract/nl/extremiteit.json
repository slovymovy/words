                    }
                ],
                "translations": [
                    {
                        "translation_id": "40b58c96-3144-4d04-a040-69ec88077d56",
                        "source_entry_id": "b5821175-91d3-37f6-9c95-14e01f77ebc2",
                        "source_sense_id": "c5da27c3-26d8-30b2-9ccc-e2041fe233de",
                        "source_sense_description": "een van de ledematen",
                        "target_lang_word": "extremity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47bd3d49-b0ea-3be2-b490-24f280567be5",
                                        "entry_id": "5a068bf4-cf0f-3cd8-aced-3c7717d678ff",
                                        "glosses": [
                                            "The most extreme or furthest point of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f421861-245f-4ac5-b314-968044bb398f",
                                                "sense_id": "47bd3d49-b0ea-3be2-b490-24f280567be5",
                                                "text": "[B]eſtowe your love on him, who, were it not to do you ſervice, would through the extremitie of love rather wiſh to die then live."
                                            },
                                            {
                                                "example_id": "89e1d56a-d531-4e43-ba89-227f6acaa5d3",
                                                "sense_id": "47bd3d49-b0ea-3be2-b490-24f280567be5",
                                                "text": "Any ſphere revolving as on an axis, muſt have two points on its ſurface at the extremities of its axis, that do not revolve at all; theſe points, with reſpect to the Earth, are called its poles."
                                            },
                                            {
                                                "example_id": "fa2b5503-ac1d-47df-bd05-751186bed779",
                                                "sense_id": "47bd3d49-b0ea-3be2-b490-24f280567be5",
                                                "text": "Scrooge said that he would see him—yes, indeed he did. He went the whole length of the expression, and said that he would see him in that extremity [i.e., hell] first."
                                            },
                                            {
                                                "example_id": "daf93965-f901-4298-9182-7cccbe8c1ce2",
                                                "sense_id": "47bd3d49-b0ea-3be2-b490-24f280567be5",
                                                "text": "Reference was made in the January-February issue to some of the optimistic railway titles of the past, such as the Manchester & Milford, and the Lancashire, Derbyshire & East Coast, neither of which got anywhere near the extremities indicated in their titles during their independent existence."
                                            },
                                            {
                                                "example_id": "5bf66baa-f5f3-4e19-b130-751abdf11177",
                                                "sense_id": "47bd3d49-b0ea-3be2-b490-24f280567be5",
                                                "text": "Sitting on the dockside at Oban, watching the to-ing and fro-ing in the harbour on a perfect summer's eve, I reflect on a trip which has taken me through our busiest cities to traverse the country's main lines, as well as explore some of the furthest extremities that were literally out on a limb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d7b5a2-368b-3ff2-b80d-f91effdf1e76",
                                        "entry_id": "5a068bf4-cf0f-3cd8-aced-3c7717d678ff",
                                        "glosses": [
                                            "An extreme measure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e904a5-f2cd-4c5b-99c0-ca5490635b8e",
                                                "sense_id": "66d7b5a2-368b-3ff2-b80d-f91effdf1e76",
                                                "text": "The Fort on the Mount St. Catherine after a Month's Siege was reduc'd to ſuch Extremitys, that they who defended it were forc'd to treat about a Surrender: and Aug. 29. 'twas agreed between the Engliſh Commiſſioners, Edward Earl of Mortaigne, Thomas Earl of Salisbury, and Fitz-Hugh, and the French Commiſſioners, the Sieur Nobles Lieutenant of Guy de Bouteil, which the Sieurs De Buſſon and de Graville, in the Name of the Gariſon, that they would deliver up the Abby and Fortreſs of St. Catherine on the Thurſday following, on condition of having only their Lives ſpar'd."
                                            },
                                            {
                                                "example_id": "0b0c9191-d700-4e03-8ef4-76584b77403f",
                                                "sense_id": "66d7b5a2-368b-3ff2-b80d-f91effdf1e76",
                                                "text": "But if they ſtill continue obſtinate, or offer to raiſe Inſurrections, he proceeds to the laſt Remedy, by letting the Iſland drop directly upon their Heads, which makes a universal Deſtruction both of Houſes and Men. However, this is an Extremity to which the Prince is ſeldom driven, neither indeed is he willing to put it in execution, nor dare his Miniſters adviſe him to an Action, which, as it would render them odious to the People, ſo it would be a great damage to their own Eſtates, which lie all below, for the Iſland is the King's Demeſn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccffe05-49f3-39fd-944a-66b0ddab322c",
                                        "entry_id": "5a068bf4-cf0f-3cd8-aced-3c7717d678ff",
                                        "glosses": [
                                            "A hand or foot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb878f1a-88d0-4447-bd01-f0b8d81c6497",
                                                "sense_id": "7ccffe05-49f3-39fd-944a-66b0ddab322c",
                                                "text": "Guillain–Barré syndrome causes one to not be able to move one’s extremities."
                                            },
                                            {
                                                "example_id": "716b4dc2-a3b3-448e-b598-0fb4254f3c58",
                                                "sense_id": "7ccffe05-49f3-39fd-944a-66b0ddab322c",
                                                "text": "Resection is preferable to amputation in the greater number of lesions of the upper extremities, as the principal function is that of mobility.—Sedillot. […] Resection of the phalanges, in whole or part, is occasionally required as the result of deep-seated inflammation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b4a46a-d05e-34de-ad63-077c9c20d295",
                                        "entry_id": "5a068bf4-cf0f-3cd8-aced-3c7717d678ff",
                                        "glosses": [
                                            "A limb (“major appendage of a human or animal such as an arm, leg, or wing”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766175f1-11a7-4f19-8e88-c4456f5ea61d",
                                                "sense_id": "a7b4a46a-d05e-34de-ad63-077c9c20d295",
                                                "text": "The danger of wounds of the extremities consists in the injury done to the blood-vessels, nerves, articulations, and bones."
                                            },
                                            {
                                                "example_id": "ba21bff8-8c43-4431-bd3d-f3ac077651e3",
                                                "sense_id": "a7b4a46a-d05e-34de-ad63-077c9c20d295",
                                                "text": "Congestive Chills.—Give from ten to fifteen drops of spirits of turpentine in a wineglass of toddy. Make a liniment of equal parts of turpentine and camphor. With this rub the spine, chest and extremities well; but not enough to blister. Rub the extremities until reaction takes place. A cloth saturated with the mixture should be applied to the chest."
                                            },
                                            {
                                                "example_id": "551bbe7c-8e55-4b77-9680-5033fb78b79f",
                                                "sense_id": "a7b4a46a-d05e-34de-ad63-077c9c20d295",
                                                "text": "On motor examination, she had normal bulk and tone throughout the upper and lower extremities. Her upper extremity strength appeared symmetric bilaterally and no drift in the left upper extremity was found. In the lower extremities, she had full strength in the right leg. In the left leg, there was some subtle weakness of left hip flexion, with 5/5 strength distally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87c27d6d-d6d5-4b86-b542-0000fd6e4813",
                        "source_entry_id": "b5821175-91d3-37f6-9c95-14e01f77ebc2",
                        "source_sense_id": "c5da27c3-26d8-30b2-9ccc-e2041fe233de",
                        "source_sense_description": "een van de ledematen",
                        "target_lang_word": "extrémité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrémité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f64e6e0f-d146-337b-b141-f0e81ab1641b",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Le bout d’une chose, la partie qui la termine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85e5174-7b84-4b63-82ef-85344eacb5e9",
                                                "sense_id": "f64e6e0f-d146-337b-b141-f0e81ab1641b",
                                                "text": "Les os du métacarpe ont la structure des os longs en général, c'est-à-dire, que leur corps est compacte & que leurs extrémités sont celluleuses. Ils sont creusés par un canal médullaire prononcé."
                                            },
                                            {
                                                "example_id": "96a99918-db7e-4a87-98dd-f5a0dda78f2a",
                                                "sense_id": "f64e6e0f-d146-337b-b141-f0e81ab1641b",
                                                "text": "Sur le bord du fleuve […] il rencontra un autre aéroplane qui lui parut à peine endommagé. […] Il reposait là, abandonné, et l’eau clapotait sur l’extrémité de sa longue queue."
                                            },
                                            {
                                                "example_id": "62c6b720-fdcb-48cb-971f-e895b2cf7037",
                                                "sense_id": "f64e6e0f-d146-337b-b141-f0e81ab1641b",
                                                "text": "Dans le choc très brutal de l’amerrissage, un croisillonnage céda et l’extrémité de l’aile gauche baignait dans l'écume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f388ac7-ac41-39d1-a213-c6badec73fe9",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Membres du corps humain."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3000734-aa9a-46d2-992e-9471c2fb7dc4",
                                                "sense_id": "3f388ac7-ac41-39d1-a213-c6badec73fe9",
                                                "text": "Lebrac, aux trois quarts enlisé, céda à leurs appels et voulut tourner bride. Impossible, ses extrémités inférieures jusqu’à mi-jambes étaient prises et il enfonçait toujours, toujours, lentement."
                                            },
                                            {
                                                "example_id": "e7eaa24f-5c44-464f-9792-9df2b646b45a",
                                                "sense_id": "3f388ac7-ac41-39d1-a213-c6badec73fe9",
                                                "text": "Les extrémités supérieures : Les bras."
                                            },
                                            {
                                                "example_id": "f34ba534-feac-4127-bc49-43e8a30dbfca",
                                                "sense_id": "3f388ac7-ac41-39d1-a213-c6badec73fe9",
                                                "text": "Le sang se porte aux extrémités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f49c6e-fe2f-3391-a524-ac94c9df6f16",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Se dit aussi surtout, dans le langage ordinaire, des pieds et des mains seulement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "213ff188-365d-4ccb-9a3c-0fc8adc22bb2",
                                                "sense_id": "c7f49c6e-fe2f-3391-a524-ac94c9df6f16",
                                                "text": "Il se meurt, car il a déjà les extrémités froides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9fe7c2a-6e99-3f70-a323-f7f2fd9f1c77",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Derniers moments de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae7c6b8b-3982-43b7-a3d7-2c0afd1254f2",
                                                "sense_id": "e9fe7c2a-6e99-3f70-a323-f7f2fd9f1c77",
                                                "text": "Madame Dufresnoi, attaquée d’une fièvre maligne, fut en peu de moments réduite à la dernière extrémité : elle mourut le cinquième jour de sa maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "467f1683-c91e-3e7b-9030-fec992c7201d",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Le plus triste état où l’on puisse être réduit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e260d33b-bbf6-43bb-b5c3-f99332c6a8c4",
                                                "sense_id": "467f1683-c91e-3e7b-9030-fec992c7201d",
                                                "text": "L’honneur voulait qu’on résistât jusqu’à la dernière extrémité."
                                            },
                                            {
                                                "example_id": "d1b04c6e-0dc6-429e-a159-d3fbb037d8e8",
                                                "sense_id": "467f1683-c91e-3e7b-9030-fec992c7201d",
                                                "text": "Moi, je suis une artiste, mais lui, tout ce qu'il a récolté, c'est d'être un bouif chez qui on ne met les pieds qu'à la toute dernière extrémité de la semelle !"
                                            },
                                            {
                                                "example_id": "b98c07b3-80f3-4ace-ae2b-73faf9699d3a",
                                                "sense_id": "467f1683-c91e-3e7b-9030-fec992c7201d",
                                                "text": "Il n’a pas de quoi vivre, il est réduit à l’extrémité, à la dernière extrémité."
                                            },
                                            {
                                                "example_id": "d0446746-6b80-486e-aa09-e84599d7d6cc",
                                                "sense_id": "467f1683-c91e-3e7b-9030-fec992c7201d",
                                                "text": "Cette place ne peut plus tenir : elle est à l’extrémité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1376250-1060-3e85-9b69-9442f7bd2136",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e51e4b-ade9-4b63-920e-001a3c58a4ad",
                                                "sense_id": "b1376250-1060-3e85-9b69-9442f7bd2136",
                                                "text": "Vous portez les choses aux dernières extrémités."
                                            },
                                            {
                                                "example_id": "5375cf70-7a4a-45fa-8ac5-774292606939",
                                                "sense_id": "b1376250-1060-3e85-9b69-9442f7bd2136",
                                                "text": "Passer d’une extrémité à l’autre."
                                            },
                                            {
                                                "example_id": "4c2e58dd-e8d0-40c1-8847-97e298b5640f",
                                                "sense_id": "b1376250-1060-3e85-9b69-9442f7bd2136",
                                                "text": "La parfaite raison fuit toute extrémité,\nEt veut que l’on soit sage avec sobriété."
                                            },
                                            {
                                                "example_id": "16426443-c806-4f9e-aad6-76421c3a836e",
                                                "sense_id": "b1376250-1060-3e85-9b69-9442f7bd2136",
                                                "text": "[…] elle dit : je n’aime pas ma vie à cause de mes extrémités. Tout d’abord j’ai pensé qu’elle parlait de ses mains et de ses pieds, mais elle parlait de ses sentiments extrêmes, des larmes, une tristesse extrême […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e9dcec9-c217-31e9-bd01-0639228aa37f",
                                        "entry_id": "72ff7286-7888-3d93-bb95-84bbe36373ca",
                                        "glosses": [
                                            "Excès de violence, d’emportement (souvent au pluriel)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237f8ce9-eda6-4b9b-b9c7-ce44a06c0cf0",
                                                "sense_id": "7e9dcec9-c217-31e9-bd01-0639228aa37f",
                                                "text": "Il s’est porté contre lui aux extrémités les plus odieuses."
                                            },
                                            {
                                                "example_id": "9e2e1644-e990-45c3-b59b-7fde9506a719",
                                                "sense_id": "7e9dcec9-c217-31e9-bd01-0639228aa37f",
                                                "text": "Pousser quelqu’un à l’extrémité : Le pousser à bout."
                                            },
                                            {
                                                "example_id": "87312192-9c81-4417-b8de-703ba220e6e7",
                                                "sense_id": "7e9dcec9-c217-31e9-bd01-0639228aa37f",
                                                "text": "Le roi, effrayé de la tournure que prenaient les choses, et craignant que l’on n’en vînt aux dernières extrémités, calma les esprits comme il put, et proposa aux Tolédans ce mezzo termine singulier et tout à fait dans l’esprit du temps, qui fut accepté avec enthousiasme de part et d’autre."
                                            },
                                            {
                                                "example_id": "1c8c5823-c96c-4302-aaa7-b55a3610854f",
                                                "sense_id": "7e9dcec9-c217-31e9-bd01-0639228aa37f",
