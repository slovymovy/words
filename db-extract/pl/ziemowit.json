                        "examples": [
                            {
                                "example_id": "e6fcd9b0-3d50-48d3-ab63-dec0a3226755",
                                "sense_id": "2293ca1b-73d0-3327-89ed-859208f304a0",
                                "text": "Ziemowit obchodzi imieniny 19 października."
                            },
                            {
                                "example_id": "d5c0099b-49bf-4991-8c9c-42bb819bf604",
                                "sense_id": "2293ca1b-73d0-3327-89ed-859208f304a0",
                                "text": "Po śmierci swej pierwszej żony pojął Ziemowit drugą, córkę Władysława, księcia ziembickiego, z dworu Karola, króla czeskiego a cesarza rzymskiego, niewiastę nader pięknego oblicza i powabnego ciała, z której spłodził trzech synów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
