                "word": "repine",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7014a894-d5a0-42b1-9299-87fc76a265b3",
                        "entry_id": "b16ea6a3-e828-3c06-b758-cb3a783a221d",
                        "tags": [
                            "plural"
                        ],
                        "form": "repines"
