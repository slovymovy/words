                    },
                    {
                        "sense_id": "4396f968-13de-3fa3-ba36-bfea91d8195d",
                        "entry_id": "85dd951f-3abc-3877-8f15-80163503d024",
                        "glosses": [
                            "Pertaining to an experience, perception, or interpretation that accurately represents reality."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405d4c3c-d0c7-40bf-9eaa-b0fdcc5a3351",
                                "sense_id": "4396f968-13de-3fa3-ba36-bfea91d8195d",
                                "text": "Few believe that all claimed religious experiences are veridical."
                            },
                            {
                                "example_id": "f5c55a6e-7c48-4b9e-a0cb-43d3bb568474",
                                "sense_id": "4396f968-13de-3fa3-ba36-bfea91d8195d",
                                "text": "There was great need for empirical research that would build a more veridical description of organizations and management."
                            },
                            {
                                "example_id": "ca8e35d4-6839-4ec5-82f4-98085242d7c1",
                                "sense_id": "4396f968-13de-3fa3-ba36-bfea91d8195d",
                                "text": "Searle himself notes that one way an experience might fail is for it to be a veridical hallucination: you might hallucinate a cat before you, and by accident there might be a cat before you."
                            }
                        ]
                    }
                ],
