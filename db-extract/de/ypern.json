                                "target_senses": [
                                    {
                                        "sense_id": "b063cbbc-daf5-335e-893c-5d5a5dac7a7f",
                                        "entry_id": "7ff5f0ba-2ebf-3792-b63a-24205395c6a9",
                                        "glosses": [
                                            "Commune et ville de la province de Flandre-Occidentale de la région flamande de Belgique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608542d1-6d9f-405a-a5ac-21bccd601060",
                                                "sense_id": "b063cbbc-daf5-335e-893c-5d5a5dac7a7f",
                                                "text": "Ce plan, ou plutôt cette vue à vol d'oiseau d’Ypres, fut tiré, en 1815, sur une ancienne planche conservée à l'hôtel de ville."
                                            },
                                            {
                                                "example_id": "4ece446c-20d4-4f13-a905-8c1a7eca9614",
                                                "sense_id": "b063cbbc-daf5-335e-893c-5d5a5dac7a7f",
                                                "text": "Avec Ypres les relations commerciales existent déjà en 1226."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839d0dce-3437-3148-8058-c76301b9f144",
                                        "entry_id": "7ff5f0ba-2ebf-3792-b63a-24205395c6a9",
                                        "glosses": [
                                            "Trois batailles qui s’y déroulèrent, entre les armées de l'Allemagne et une coalition de pays européens, durant la Première Guerre mondiale de 1914 à 1918."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf9e57b-1d3b-4bfe-a8bc-556440c4c0fe",
                                                "sense_id": "839d0dce-3437-3148-8058-c76301b9f144",
                                                "text": "L’apparition des gaz de combat remonte à un an déjà, au nord d’Ypres, sur le front de Steenstraat, et c’est pourquoi on baptise la trouvaille ypérite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
