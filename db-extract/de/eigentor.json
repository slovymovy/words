                "senses": [
                    {
                        "sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                        "entry_id": "64f2b5a2-c262-3238-a71f-93f351e6d3cb",
                        "glosses": [
                            "Bezeichnung bei einer Mannschaftssportart, wenn ein Spieler den Ball ins eigene Tor schießt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c549b140-0c74-4ce8-abbc-25a446e587aa",
                                "sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                                "text": "Eigentore sind für den Schützen besonders ärgerliche Vorkommnisse in einem Spiel."
                            },
                            {
                                "example_id": "96c2748d-d8b0-40e4-9147-c1388af50bdb",
                                "sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                                "text": "„Erwähnenswert in diesem Zusammenhang ist noch das Spiel gegen Mönchengladbach am 12. Dezember 2009, in dem Hannover drei Eigentore schoss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ed1922c-7d6c-44e7-a2bb-ccb276e699b9",
                        "source_entry_id": "64f2b5a2-c262-3238-a71f-93f351e6d3cb",
                        "source_sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                        "source_sense_description": "Bezeichnung bei einer Mannschaftssportart, wenn ein Spieler den Ball ins eigene Tor schießt",
                        "target_lang_word": "own goal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "own goal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac736d01-1608-30ad-84b6-2efa5a2ea28b",
                                        "entry_id": "2bbbbaa3-8772-3fbe-946e-8c7e433aae0e",
                                        "glosses": [
                                            "A goal that results from a player putting the ball or puck into the goal of their own team; the resulting goal being scored for the opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c0e296-3529-4aef-99a8-7c2efb4fe206",
                                                "sense_id": "ac736d01-1608-30ad-84b6-2efa5a2ea28b",
                                                "text": "It is 20 years to the day since Escobar was shot dead after scoring the own goal that effectively sealed Colombia’s elimination from USA ’94."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                        "entry_id": "2bbbbaa3-8772-3fbe-946e-8c7e433aae0e",
                                        "glosses": [
                                            "A blunder that damages one’s own prospects."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17163007-9e58-4780-806f-840eb6d633bf",
                                                "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                                "text": "In its penultimate year, for example, starting from when the Provos blew up Canary Wharf in February 1996, the IRA suffered its last 'own goal' when Wexford-born Ed O'Brien blew himself up on a London bus whilst transporting a bomb."
                                            },
                                            {
                                                "example_id": "58ba7ede-bde2-4cd1-a9d0-eb6a80bfa731",
                                                "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                                "text": "No doubt the buzz of army helicopters will sound again in the skies over Belfast tonight, as loyalists continue to score this series of bloody own goals."
                                            },
                                            {
                                                "example_id": "d614d3ea-6100-4934-a3b1-3641b0ef4999",
                                                "sense_id": "2fd2a44b-7dca-3651-9287-c94ae9de6804",
                                                "text": "These elections mark a personal humiliation for incumbent Ms. May, who ran a very personalized campaign as a “strong and stable” leader asking British voters to give her a clear mandate to negotiate Brexit. Ms. May scored an unforced own goal by reducing her party’s parliamentary seats and absolute majority."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d2c9c7d-4c69-498c-9d18-f911c8725372",
                        "source_entry_id": "64f2b5a2-c262-3238-a71f-93f351e6d3cb",
                        "source_sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                        "source_sense_description": "Bezeichnung bei einer Mannschaftssportart, wenn ein Spieler den Ball ins eigene Tor schießt",
                        "target_lang_word": "but contre son camp",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "but contre son camp",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7db5fa-fba5-3b32-a48d-7d5b7140364c",
                                        "entry_id": "e1491827-37fb-3479-ae30-66d2755f5cb1",
                                        "glosses": [
                                            "But marqué par un joueur dans ses propres buts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84078ecf-1a86-425d-9f6e-b5f5f7dd8656",
                                                "sense_id": "7f7db5fa-fba5-3b32-a48d-7d5b7140364c",
                                                "text": "La vidéo du but contre son camp le plus improbable de l’année nous vient d’Allemagne."
                                            },
                                            {
                                                "example_id": "a0ad64c8-0da4-4df0-9c3a-fd016d767355",
                                                "sense_id": "7f7db5fa-fba5-3b32-a48d-7d5b7140364c",
                                                "text": "Pour se donner une idée, l'édition 2021, la plus prolifique en termes de CSC, s'était terminée avec neuf buts contre son camp en 51 matchs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                        "entry_id": "e1491827-37fb-3479-ae30-66d2755f5cb1",
                                        "glosses": [
                                            "Parole ou acte qui se retourne contre la personne à son origine ou le groupe auquel la personne appartient."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad99abc3-75c2-431a-aafa-909ba4408b3c",
                                                "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                                "text": "Matteo Salvini, l’homme « qui a marqué un but contre son camp »"
                                            },
                                            {
                                                "example_id": "9aae04f8-0e63-4675-a8ae-d326010b6a56",
                                                "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                                "text": "Je le reproche un peu à Fabien, j'ai l'impression qu'il marque des buts contre son camp, en approuvant ce que dit monsieur Darmanin alors qu'il est en guerre contre la Nupes, nous criminalise, nous stigmatise, et fait de même avec monsieur Cazeneuve"
                                            },
                                            {
                                                "example_id": "c426fc34-8db0-4bf6-9ea0-f05f6b89db12",
                                                "sense_id": "4c8b5925-d71f-30c0-a7fd-0887aa612d24",
                                                "text": "Législatives 2024 : le « but contre son camp » de Macron continue à stupéfier l’Allemagne"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
