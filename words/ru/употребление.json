            "pos": "noun",
            "senses": [
                {
                    "sense_id": "310cc635-a6d0-3efb-abe8-460a34be4eb5",
                    "sense_definition": "Использование чего-либо для какой-либо цели, а также прием в пищу или внутрь.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "применение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это лекарство предназначено только для наружного <w>употребления</w>.",
                            "target_lang_translations": {
                                "pl": "Ten lek jest przeznaczony wyłącznie do <w>użytku</w> zewnętrznego."
                            }
                        },
                        {
                            "text": "Чрезмерное <w>употребление</w> сладкого может нанести серьёзный вред вашему здоровью.",
                            "target_lang_translations": {
                                "pl": "Nadmierne <w>spożycie</w> słodyczy może poważnie zaszkodzić twojemu zdrowiu."
                            }
                        }
                    ],
                    "synonyms": [
                        "использование",
                        "применение"
                    ],
                    "common_phrases": [
                        "для наружного употребления",
                        "для внутреннего употребления",
                        "употребление алкоголя",
                        "способ употребления"
                    ],
                    "target_lang_definitions": {
                        "pl": "Używanie czegoś w określonym celu, a także spożywanie czegoś w jedzeniu lub przyjmowanie leków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "użycie",
                                "target_lang_sense_clarification": "ogólne zastosowanie, wykorzystanie"
                            },
                            {
                                "target_lang_word": "spożycie",
                                "target_lang_sense_clarification": "jedzenie, picie lub przyjmowanie pokarmu/substancji"
                            },
                            {
                                "target_lang_word": "stosowanie",
                                "target_lang_sense_clarification": "aplikowanie, np. leków lub środków"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "930b6768-7e14-3f55-b7fe-91bac0e4e180",
                    "sense_definition": "Общепринятое или постоянное использование чего-либо в обществе, практике или языке.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "бытование",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие старинные слова со временем вышли из <w>употребления</w>.",
                            "target_lang_translations": {
                                "pl": "Wiele dawnych słów z czasem wyszło z <w>użycia</w>."
                            }
                        },
                        {
                            "text": "Новый удобный термин быстро вошёл в широкое <w>употребление</w> среди специалистов.",
                            "target_lang_translations": {
                                "pl": "Nowy, wygodny termin szybko wszedł do powszechnego <w>użycia</w> wśród specjalistów."
                            }
                        }
                    ],
                    "synonyms": [
                        "обиход",
                        "обращение"
                    ],
                    "common_phrases": [
                        "выйти из употребления",
                        "войти в употребление",
                        "быть в употреблении"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powszechne lub zwyczajowe stosowanie czegoś w społeczeństwie, praktyce lub języku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "użycie",
                                "target_lang_sense_clarification": "funkcjonowanie w języku lub powszechnej praktyce"
                            },
                            {
                                "target_lang_word": "użytek",
                                "target_lang_sense_clarification": "obieg, powszechne stosowanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e22feb1-6a55-3b37-9b11-d0dd1b78229b",
                    "sense_definition": "Практическое назначение, полезное приложение сил, средств или способностей.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "применение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой специалист долго пытался найти достойное <w>употребление</w> своим редким навыкам.",
                            "target_lang_translations": {
                                "pl": "Młody specjalista długo próbował znaleźć godne <w>zastosowanie</w> dla swoich rzadkich umiejętności."
                            }
                        },
                        {
                            "text": "Они смогли найти правильное <w>употребление</w> полученным средствам и вложили их в проект.",
                            "target_lang_translations": {
                                "pl": "Zdołali zrobić właściwy <w>użytek</w> z otrzymanych środków i zainwestowali je w projekt."
                            }
                        }
                    ],
                    "synonyms": [
                        "назначение",
                        "применение",
                        "приложение"
                    ],
                    "common_phrases": [
                        "найти употребление",
                        "дать употребление"
                    ],
                    "target_lang_definitions": {
                        "pl": "Praktyczne przeznaczenie, pożyteczne wykorzystanie sił, środków lub umiejętności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zastosowanie",
                                "target_lang_sense_clarification": "praktyczne wykorzystanie czegoś"
                            },
                            {
                                "target_lang_word": "pożytek",
                                "target_lang_sense_clarification": "wartościowe obrócenie czegoś na pożyteczny cel"
                            },
                            {
                                "target_lang_word": "użytek",
                                "target_lang_sense_clarification": "zrobienie użytku z czegoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
