                    {
                        "sense_id": "6460df0e-cae8-39c5-9084-d16a7c8ced82",
                        "entry_id": "3ae04c14-88e5-356b-947d-5867a61496ef",
                        "glosses": [
                            "Qualifie la partie de la trigonométrie relative aux triangles sphériques."
                        ],
