                                    {
                                        "sense_id": "0f5facfe-4612-36b4-97a1-1cd85c73b985",
                                        "entry_id": "808bd283-9d1b-32f3-a8ec-781c251d2cdd",
                                        "glosses": [
                                            "To make purple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87e37313-1ec6-4ecb-b8fa-d7e048d03425",
                                                "sense_id": "0f5facfe-4612-36b4-97a1-1cd85c73b985",
                                                "text": "Some [wines] deep empurpled as the Hyacine,\nSome as the rubine, laughing sweetly red,\nŞome like fair emerauds, not yet well ripened"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1daa3c-f28a-3618-b4da-fdfefbd17203",
                                        "entry_id": "808bd283-9d1b-32f3-a8ec-781c251d2cdd",
                                        "glosses": [
                                            "To enrage or anger, referring to making the face purple or red with blood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b340cfda-95c0-3335-8c81-8ba244770bb6",
