                                        "sense_id": "4fae3e1c-e8f5-3471-adb4-ac6669ee9de7",
                                        "entry_id": "e6db20ea-9aaa-3345-b28e-2adbb14508f0",
                                        "glosses": [
                                            "ein Thema mit jemandem wechselseitig besprechen, bereden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e82c42ba-1b14-4b8c-8d0b-8b55f1fc71e6",
                                                "sense_id": "4fae3e1c-e8f5-3471-adb4-ac6669ee9de7",
                                                "text": "Über dieses Thema müssen wir diskutieren."
                                            },
                                            {
                                                "example_id": "f5275633-3c45-45f8-bfb5-0bad035e6d3f",
                                                "sense_id": "4fae3e1c-e8f5-3471-adb4-ac6669ee9de7",
                                                "text": "Ja, darüber könnte man diskutieren. Mach doch mal einen Vorschlag, wie du dir das vorstellst, und dann sehen wir mal."
                                            },
                                            {
                                                "example_id": "3707d449-b633-4482-9b03-5974a2af34f9",
                                                "sense_id": "4fae3e1c-e8f5-3471-adb4-ac6669ee9de7",
                                                "text": "„So wie ich hörte, wurde auch über nichts anderes diskutiert als über Fisch, Wellhornschnecken, Preise und Wetter.“"
                                            },
                                            {
                                                "example_id": "45e719d9-e948-43b5-9a06-af3869753def",
                                                "sense_id": "4fae3e1c-e8f5-3471-adb4-ac6669ee9de7",
                                                "text": "„Bots und Messaging-Systeme werden heiß diskutiert und gelten als Mega-Trends der nächsten Jahre.“"
                                            },
                                            {
                                                "example_id": "978dbc70-92c0-4158-8b96-84e7c26f1ad2",
                                                "sense_id": "4fae3e1c-e8f5-3471-adb4-ac6669ee9de7",
                                                "text": "„Schon heute diskutieren Experten, ob Deutschland dieses Jahr erstmals die 45-Grad-Marke knacken könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
