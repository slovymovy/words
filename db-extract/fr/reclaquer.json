                "senses": [
                    {
                        "sense_id": "c016755c-5afb-341a-a233-a25fc2f520f4",
                        "entry_id": "1b7d4eec-3407-331d-a52d-b9850fe946c2",
                        "glosses": [
                            "Claquer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a35fff8-1abe-4bb5-98cb-70ebcd700ad9",
                                "sense_id": "c016755c-5afb-341a-a233-a25fc2f520f4",
                                "text": "Il reclaqua la portière sur lui."
                            },
                            {
                                "example_id": "844d60e1-d20d-4259-9396-ee538cb17d1c",
                                "sense_id": "c016755c-5afb-341a-a233-a25fc2f520f4",
                                "text": "Le latiniste en soutane s’enfuit, relevant ses jupes qui battaient contre ses jambes maigres ; des portes à intervalles réguliers divisaient le quadrangle ; on l’entendait les ouvrir à la volée, puis les reclaquer derrière lui, ouvertes et reclaquées ensuite par le poursuivant et sa meute."
                            },
                            {
                                "example_id": "44071b54-d067-46ef-9201-b6d063ce297b",
                                "sense_id": "c016755c-5afb-341a-a233-a25fc2f520f4",
                                "text": "Une porte latérale s’ouvrit et la petite Dominique, complètement nue, apparut un bref instant avant de reclaquer la porte en poussant un cri aigu."
                            }
                        ]
                    }
