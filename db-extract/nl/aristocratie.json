                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "25f2129c-ce88-42cd-a37b-894768855579",
                        "entry_id": "6225c6c6-9053-39df-9a91-598d172ae96d",
                        "tags": [
                            "plural"
                        ],
                        "form": "aristocratieën"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d89a5cc2-2057-3f67-9e38-0f5af9ef59dd",
                        "entry_id": "6225c6c6-9053-39df-9a91-598d172ae96d",
                        "glosses": [
                            "regeringsvorm waarbij de heerschappij in handen is van een kleine groep, de zogenaamde aristocraten, waarvan wordt verondersteld dat zij van nature de meest geschikte bestuurders zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d777a1a4-87a9-4a92-af87-0cf947bfc622",
                                "sense_id": "d89a5cc2-2057-3f67-9e38-0f5af9ef59dd",
                                "text": "Lange tijd hebben filosofen en politici gediscussieerd over de voor- en nadelen van een aristocratie tegenover een democratie."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e9ddc78-4874-38f8-8548-8a9544ea1f3b",
                        "entry_id": "6225c6c6-9053-39df-9a91-598d172ae96d",
                        "glosses": [
                            "groep van mensen die als superieur wordt gezien"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efd08e3c-1672-400a-abb1-d4807df4df44",
                        "source_entry_id": "6225c6c6-9053-39df-9a91-598d172ae96d",
                        "source_sense_id": "d89a5cc2-2057-3f67-9e38-0f5af9ef59dd",
                        "source_sense_description": "een regeringsvorm waarbij de heerschappij in handen is van een kleine groep, de zogenaamde aristocraten",
                        "target_lang_word": "Aristokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aristokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4344d70-0120-3b53-b3b4-49c672d11e3d",
                                        "entry_id": "94d418dd-4886-32fc-aa1d-0bbb4c5b636e",
                                        "glosses": [
                                            "eine Staatsform, in der der Adel die Herrschaft ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c83a8f2-f64f-4e30-931a-8dcca6dc1f8b",
                                                "sense_id": "c4344d70-0120-3b53-b3b4-49c672d11e3d",
                                                "text": "„Die gleichmäßige Verteilung der hellenistischen Turmgehöfte deutet auf eine weitgehende Kontrolle des Landgebiets durch eine Aristokratie hin, die zwar selbstbewußt und einflußreich, aber zugleich eine Gemeinschaft von Gleichen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b376d1b9-baef-3a8b-a6dc-4b10927a390c",
                                        "entry_id": "94d418dd-4886-32fc-aa1d-0bbb4c5b636e",
                                        "glosses": [
                                            "die aristokratische soziale Gruppe, die besondere Rechte besitzt"
                                        ],
                                        "tags": [
                                            "historical",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "720bb275-14ce-4261-bdda-e6c1c95fa3fa",
                                                "sense_id": "b376d1b9-baef-3a8b-a6dc-4b10927a390c",
                                                "text": "„Er war, wie viele Juden im Deutschland Wilhelms II., ein glühender Patriot gewesen, als Antisemitismus noch als vulgär angesehen wurde und Juden in die Aristokratie aufsteigen konnten.“"
                                            },
                                            {
                                                "example_id": "24d79014-2653-4803-a315-69a7b919f48f",
                                                "sense_id": "b376d1b9-baef-3a8b-a6dc-4b10927a390c",
                                                "text": "„Wer wie Akwa von der deutschen Aristokratie hofiert wurde, dürfe sich mit seiner Biografie als Adliger fühlen.“"
                                            },
                                            {
                                                "example_id": "502898ef-b484-4861-aad1-634576733ba1",
                                                "sense_id": "b376d1b9-baef-3a8b-a6dc-4b10927a390c",
                                                "text": "„Die Briten zogen aus dem Aufstand die Lehre, dass es galt, sich auf die indische Aristokratie zu stützen, die «natural leaders of the people», denen die Bauern zu folgen bereit waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b4be18-e48e-452e-a3ed-9dd9256cadf6",
                        "source_entry_id": "6225c6c6-9053-39df-9a91-598d172ae96d",
                        "source_sense_id": "d89a5cc2-2057-3f67-9e38-0f5af9ef59dd",
                        "source_sense_description": "een regeringsvorm waarbij de heerschappij in handen is van een kleine groep, de zogenaamde aristocraten",
                        "target_lang_word": "aristocracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aristocracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc03e0c4-20d2-3dcb-a842-303c8435ee13",
                                        "entry_id": "65874389-32a9-3992-afee-59df55003fb6",
                                        "glosses": [
                                            "The nobility, or the hereditary ruling class."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2510ea8e-71f2-4c8b-abed-390abf985c2d",
                                                "sense_id": "cc03e0c4-20d2-3dcb-a842-303c8435ee13",
                                                "text": "But when Nietzsche has the incredible lack of humour and lack of imagination to ask us to believe that his aristocracy is an aristocracy of strong muscles or an aristocracy of strong wills, it is necessary to point out the truth. It is an aristocracy of weak nerves."
                                            },
                                            {
                                                "example_id": "1e069279-8935-4742-b667-0d920ef362f6",
                                                "sense_id": "cc03e0c4-20d2-3dcb-a842-303c8435ee13",
                                                "text": "That, then, which is called aristocracy in some countries and nobility in others arose out of the governments founded upon conquest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27a1118-fac0-3706-88ea-29ab49659eb3",
                                        "entry_id": "65874389-32a9-3992-afee-59df55003fb6",
                                        "glosses": [
                                            "Government by such a class, or a state with such a government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b4ef6e-8f25-4c1d-8ef6-832cf800ab22",
                                                "sense_id": "f27a1118-fac0-3706-88ea-29ab49659eb3",
                                                "text": "How many false principles have been laid down, how much delusion supported, by reference to the glories of Athens and of Rome! It remained for a later time to observe that those so-called republics were but aristocracy in its most oppressive form; and what are now the people were then positive slaves;..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d947404-77ff-3ec0-b9ac-b31901fd9f0d",
                                        "entry_id": "65874389-32a9-3992-afee-59df55003fb6",
                                        "glosses": [
                                            "A class of people considered (not normally universally) superior to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc42fcfd-ae05-4c25-9ba2-4ffd37fa92b5",
                        "source_entry_id": "6225c6c6-9053-39df-9a91-598d172ae96d",
                        "source_sense_id": "d89a5cc2-2057-3f67-9e38-0f5af9ef59dd",
                        "source_sense_description": "een regeringsvorm waarbij de heerschappij in handen is van een kleine groep, de zogenaamde aristocraten",
                        "target_lang_word": "aristocratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aristocratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "960222b9-8214-3979-a146-c5cb757d200f",
                                        "entry_id": "88c58a88-0d7f-3155-a1cd-eac4f9ff713d",
                                        "glosses": [
                                            "Forme de gouvernement où le pouvoir n’est possédé que par un certain nombre de personnes constituant une classe privilégiée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45353abb-8d90-44f1-a67f-d466a73300dd",
                                                "sense_id": "960222b9-8214-3979-a146-c5cb757d200f",
                                                "text": "C'est plutôt le contraire qui est vrai ou qui du moins renferme la plus forte part de vérité : maintes fois l’aristocratie mérita le nom de « kakistocratie », dit-il, qu'il soit empereur ou chef de bureau, dont Léopold de Ranke se sert dans son histoire."
                                            },
                                            {
                                                "example_id": "ffa6c141-08cf-41b0-9abc-ccb73f868f6a",
                                                "sense_id": "960222b9-8214-3979-a146-c5cb757d200f",
                                                "text": "Sous Auguste, toutefois, une profonde réaction se produisit. En 27, on décida le rétablissement de la vieille république, c'est-à-dire, de l’aristocratie ; […]"
                                            },
                                            {
                                                "example_id": "65aadebe-2753-4968-b2e8-4a88af58c7e7",
                                                "sense_id": "960222b9-8214-3979-a146-c5cb757d200f",
                                                "text": "Dans l'esprit de tout le monde, l'aristocratie, c'est vieux, c'est mort, c'est fini, on dit « une autre époque ». On oublie volontiers, ou on ignore, qu'avant le gouvernement du peuple qui définit nos régimes occidentaux, il y avait le « gouvernement des meilleurs » (du bon vieux grec aristos)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23944ffa-3b7d-3738-97b5-c1610e03ce42",
                                        "entry_id": "88c58a88-0d7f-3155-a1cd-eac4f9ff713d",
                                        "glosses": [
                                            "Classe noble."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a38a22-216f-4c09-8753-a8245f5b3fec",
                                                "sense_id": "23944ffa-3b7d-3738-97b5-c1610e03ce42",
                                                "text": "[…] : non-seulement l’aristocratie presque partout s’était emparée du pouvoir; mais elle tenait sous le joug des hommes qui se voyaient privés de tout intérêt public, de toute place, de tous droits politiques."
                                            },
                                            {
                                                "example_id": "9ce1bac2-1e44-4ad2-8914-7a2374a6f694",
                                                "sense_id": "23944ffa-3b7d-3738-97b5-c1610e03ce42",
                                                "text": "[…], en Angleterre, c’est une aristocratie puissante qui élève le cheval de course, et elle est bien libre de dépenser son argent comme bon lui semble, personne, que nous sachions, ne s’est encore avisé de lui contester ce droit."
                                            },
                                            {
                                                "example_id": "62c96b50-ed91-48b0-a14a-dc52d2841f74",
                                                "sense_id": "23944ffa-3b7d-3738-97b5-c1610e03ce42",
                                                "text": "Il savait que les femmes de l’aristocratie devenaient après leur mariage des meubles de communauté pour la famille et les amis de leur mari. Elles sont d'ailleurs bien trop dévotes pour être sensuelles. Les étrangers n'ont pas beau jeu à ce train de galanterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6747af7f-7bcb-3ddc-97c0-51e71509f604",
                                        "entry_id": "88c58a88-0d7f-3155-a1cd-eac4f9ff713d",
                                        "glosses": [
                                            "Élite."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0396255-6d3f-4b2d-a5fd-85d5c72540a3",
                                                "sense_id": "6747af7f-7bcb-3ddc-97c0-51e71509f604",
                                                "text": "Trop souvent une aristocratie de notabilités locales a exploité à son profit les fonctions publiques, et fait sentir aux Anglais que son despotisme peut être plus intolérable encore que celui d’une administration centrale, […]."
                                            },
                                            {
                                                "example_id": "cc79d4e0-13c2-4103-82d1-bdc656298f60",
                                                "sense_id": "6747af7f-7bcb-3ddc-97c0-51e71509f604",
                                                "text": "La République des lettres est la seule qui doive être quelque peu imprégnée d'aristocratie, - car on ne contestera jamais celle de la science et du talent."
                                            },
                                            {
                                                "example_id": "f936fc25-4dda-435c-b6ca-ad41371e7c36",
                                                "sense_id": "6747af7f-7bcb-3ddc-97c0-51e71509f604",
                                                "text": "Et, en définitive, dans cette Bretagne qu'on nous disait si pauvre, nous observons une région où il y a grand afflux d'argent et où une sorte d’aristocratie paysanne exerce son influence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b15ed0f9-8a27-4c75-abfc-b0d968f6f9a8",
