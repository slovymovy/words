                                        "entry_id": "d2f8a832-9a52-3e43-8f9e-6f198a7a9c91",
                                        "glosses": [
                                            "Reue empfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b44386-fda9-4fc8-8f2f-5a21783d763a",
                                                "sense_id": "3b3f102c-b33f-3dd4-a47f-02415e31539a",
                                                "text": "„Ein reuiger Sünder ist besser als 999 Gerechte.“"
                                            },
                                            {
                                                "example_id": "d1332ca6-40d1-41f2-91d0-f8146c5b4fa4",
                                                "sense_id": "3b3f102c-b33f-3dd4-a47f-02415e31539a",
                                                "text": "„Einen reuigeren Sünder hat die Anklagebank des Aichacher Amtsgerichtes wohl schon lange nicht mehr getragen.“"
                                            },
                                            {
                                                "example_id": "416f3e76-929b-445b-9da7-0fa7d5d910a5",
                                                "sense_id": "3b3f102c-b33f-3dd4-a47f-02415e31539a",
                                                "text": "„Es war das reuigste Geständnis, das dieser Mann machen konnte, und Josepha verstand, Josepha dankte es ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
