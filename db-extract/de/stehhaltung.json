                ],
                "senses": [
                    {
                        "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                        "entry_id": "2fd6acd4-391a-3c07-8d3e-12029fb8f6c4",
                        "glosses": [
                            "Art und Weise, wie der Körper beim Stehen positioniert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b11faf1-6e1e-4e4f-b39e-87dab2c7aa97",
                                "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                                "text": "„Das verschafft jedem Angler und Segler perfekte Sitz- und Stehhaltungen.“"
                            },
                            {
                                "example_id": "5212bfdf-baa3-48c7-a6d1-8c66bc48cfca",
                                "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                                "text": "„Selbst Ihre Lebensdauer können Sie durch den Wechsel aus Sitz- und Stehhaltung positiv beeinflussen.“"
                            },
                            {
                                "example_id": "dc26ec11-143d-4826-9e10-fdb61d862508",
                                "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                                "text": "„So muss beispielsweise das Verschränken der Arme nicht zwingend negativ sein, es kann durchaus auch eine einfach nur gemütliche Sitz-/Stehhaltung des Kunden sein.“"
                            },
                            {
                                "example_id": "37d0f872-ff85-4e92-9197-c6f1c1e725ab",
                                "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                                "text": "Auf Dauer kann eine falsche Stehhaltung verschiedene Erkrankungen wie Durchblutungsstörungen, Beschwerden mit der Wirbelsäule und anderen Rückenpartien, Verspannungen im Schulter-Nacken-Bereich oder Krampfadern begünstigen.“"
                            },
                            {
                                "example_id": "658e50c0-bb95-4c4b-8618-dc435870e7eb",
                                "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                                "text": "„Dies ist natürlich der Schlüssel zu einer guten Stehhaltung, und es lohnt sich, dies zu wiederholen.“"
                            },
                            {
                                "example_id": "d773a51e-9798-4457-a978-82575d9a19d2",
                                "sense_id": "53b233b4-c145-3fc6-a5e4-e8f5b8ba1e15",
                                "text": "„Dabei solltest du ca. 20 Minuten in einer lockeren Stehhaltung stehen und ab und zu deine Haltung wechseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d67004c6-68d0-3d70-8421-0c26ef0a4676",
                        "entry_id": "2fd6acd4-391a-3c07-8d3e-12029fb8f6c4",
                        "glosses": [
                            "Asana, die im Stehen ausgeführt wird"
                        ],
                        "tags": [
                            "Yoga"
                        ],
                        "examples": [
                            {
                                "example_id": "7505b28e-2672-461c-8ca8-4ee0d79b2711",
                                "sense_id": "d67004c6-68d0-3d70-8421-0c26ef0a4676",
                                "text": "„Zu den verschiedenen Arten von Asanas gehören Stehhaltungen, Sitzhaltungen, Drehungen, Vorwärtsbeugen und Rückbeugen.“"
                            },
                            {
                                "example_id": "45f56fee-9c43-4732-aef4-3b11880a451a",
                                "sense_id": "d67004c6-68d0-3d70-8421-0c26ef0a4676",
                                "text": "„Tadasana gehört zu den Stehhaltungen und sieht von außen ganz einfach aus: Du stehst mit parallelen Füßen auf dem Boden, den Blick geradeaus, richtest dein Becken leicht auf und rollst die Schultern nach hinten.“"
                            },
                            {
                                "example_id": "19c2fbb1-f170-4092-a50b-15eb04406a61",
                                "sense_id": "d67004c6-68d0-3d70-8421-0c26ef0a4676",
                                "text": "„Eine erdende Asanapraxis mit Stehhaltungen und Vorwärtsbeugen bereitet uns darauf vor, uns mit unseren ureigenen Qualitäten von Stabilität und Dankbarkeit zu verbinden.“"
                            },
                            {
                                "example_id": "a51ef7ed-5a10-4ee3-92c9-7257872e0567",
                                "sense_id": "d67004c6-68d0-3d70-8421-0c26ef0a4676",
                                "text": "„Stehhaltungen werden häufig geübt, in denen man die grundlegende Ausrichtung und wichtigsten Korrekturen des Körpers lernt.“"
                            },
                            {
                                "example_id": "11c7571d-d546-4ff9-9073-03eebf20edb5",
                                "sense_id": "d67004c6-68d0-3d70-8421-0c26ef0a4676",
                                "text": "„Kräftigende Stehhaltungen geben Stabilität und Leichtigkeit, der ruhige Bodenteil gibt den nötigen Ausgleich, um mental abzuschalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
