                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "snelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sportwagen <w>raasde</w> met 180 km/uur over de snelweg.",
