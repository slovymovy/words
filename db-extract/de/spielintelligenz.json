                        "sense_id": "3569f816-3e62-3409-9d0f-3a88fb6e3922",
                        "entry_id": "30c9674a-37c4-36bf-bdf7-19f0c89c512f",
                        "glosses": [
                            "Fähigkeit, durch kreatives Denken und Handeln ein Spielgeschehen zweckmäßig zu beeinflussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b374144-8031-412e-b4c2-827bf987768a",
                                "sense_id": "3569f816-3e62-3409-9d0f-3a88fb6e3922",
                                "text": "„Bei der Charakterisierung des Typus Spieler wird meistens gesagt, er/sie verfüge über eine hohe Spielintelligenz.“"
                            },
                            {
                                "example_id": "1e92da25-b0e9-4327-bf81-70541b2feeae",
                                "sense_id": "3569f816-3e62-3409-9d0f-3a88fb6e3922",
                                "text": "„Und doch regieren Glück und Pech nicht absolut,- mit Spielintelligenz läßt sich das Schicksal lenken.“"
                            },
                            {
                                "example_id": "c62d4ec0-e53f-481a-a325-9d4a23e68e37",
                                "sense_id": "3569f816-3e62-3409-9d0f-3a88fb6e3922",
                                "text": "„Kentin ist ein schneller Spieler mit viel Spielintelligenz und auch Spielwitz.“"
                            },
                            {
                                "example_id": "cde1a495-c53a-44c1-9733-59b0cc0b0a37",
                                "sense_id": "3569f816-3e62-3409-9d0f-3a88fb6e3922",
                                "text": "„Wir brauchen ihn mit seiner Erfahrung und Spielintelligenz auf dem Platz.“"
                            },
                            {
                                "example_id": "c5417251-5d61-41f5-bdae-e25ae315157a",
                                "sense_id": "3569f816-3e62-3409-9d0f-3a88fb6e3922",
                                "text": "„Guardiola, der den FC Bayern am Saisonende nach drei Jahren verlassen und zu Manchester City wechseln wird, habe die Spielintelligenz seiner Spieler weiterentwickelt, sagte Kahn.“"
                            }
                        ],
