                            {
                                "example_id": "a73049e0-1bb3-4474-a9e6-35f78cc64b04",
                                "sense_id": "fc9477d4-51da-3683-92f7-a48bd44a0ac4",
                                "text": "Der Auerhahn ist der größte Hühnervogel Europas."
                            },
                            {
                                "example_id": "1eab934a-0130-4093-8d30-77c326e183dd",
                                "sense_id": "fc9477d4-51da-3683-92f7-a48bd44a0ac4",
                                "text": "„Vor allem in dem Waldstück am linken Ufer der Mercy, das sie Jacamar-Wald nannten, erwischten sie haufenweise Cabiais, Tauben, Hasen, Auerhähne und andere Tiere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
