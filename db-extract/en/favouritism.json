                                        "glosses": [
                                            "übermäßige Begünstigung von Verwandten, zum Beispiel bei der Verteilung von Geldern, der Vergabe von Aufträgen oder der Besetzung von Positionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
