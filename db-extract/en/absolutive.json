                "senses": [
                    {
                        "sense_id": "ae5a6999-e24a-3b1a-8e9b-e16713b1f6c2",
                        "entry_id": "f1165bb1-f79c-3ae4-9528-3f0f835bf8ff",
                        "glosses": [
                            "Of or pertaining to the grammatical case prototypically used to indicate the sole argument of an intransitive verb, and the more patientive argument of a transitive verb."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "56984237-6802-3f15-b4e2-f955e618ef9d",
                        "entry_id": "f1165bb1-f79c-3ae4-9528-3f0f835bf8ff",
                        "glosses": [
                            "Of, exhibiting, or pertaining to absolution; absolutory, absolving."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "297b53f4-1425-485c-ada4-1115ad197b88",
                                "sense_id": "56984237-6802-3f15-b4e2-f955e618ef9d",
                                "text": "(1) Absolution: The speaker says the act was not what was understood, and that it did not occur as charged anyway. [...] His repeated denials should be viewed as an absolutive strategy in which the facts themselves are disputed, [...]"
                            },
                            {
                                "example_id": "07dfd7b5-9aeb-4d33-8db8-ae3b85117b9c",
                                "sense_id": "56984237-6802-3f15-b4e2-f955e618ef9d",
                                "text": "[...], the forgiving process is easier because the full cathartic effect, in all its absolutive power, comes into play after a heightened awareness of sinfulness."
                            },
                            {
                                "example_id": "45720c4b-0b5f-4372-b3a9-eddc898cea6f",
                                "sense_id": "56984237-6802-3f15-b4e2-f955e618ef9d",
                                "text": "The absolutive appeal is exemplified in two Nixon statements. […] Absolution is a posture designed to clear fully the accused party from any hint of wrongdoing. […]"
                            }
                        ]
                    }
