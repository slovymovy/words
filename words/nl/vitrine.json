            "senses": [
                {
                    "sense_id": "9b173fb1-0e45-3d63-b881-653bacf952ef",
                    "sense_definition": "Glazen uitstalkast waarin kostbare of kwetsbare voorwerpen ter bezichtiging worden bewaard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het Rijksmuseum staan veel <w>vitrines</w> met waardevolle historische voorwerpen.",
                            "target_lang_translations": {
                                "en": "In the Rijksmuseum there are many <w>display cases</w> with valuable historical objects."
                            }
                        },
                        {
                            "text": "De juwelier bewaart de dure ringen veilig achter het slot van de <w>vitrine</w>.",
                            "target_lang_translations": {
                                "en": "The jeweller keeps the expensive rings safe under lock and key inside the <w>showcase</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vitrinekast",
                        "uitstalkast",
                        "toonkast"
                    ],
                    "common_phrases": [
                        "in de vitrine"
                    ],
                    "target_lang_definitions": {
                        "en": "A glass display cabinet in which valuable or fragile objects are kept for viewing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "display case",
                                "target_lang_sense_clarification": "glass cabinet for exhibits or goods"
                            },
                            {
                                "target_lang_word": "showcase",
                                "target_lang_sense_clarification": "glass enclosure used to show items"
                            },
                            {
                                "target_lang_word": "vitrine",
                                "target_lang_sense_clarification": "glass display case, especially in a museum or gallery"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d519ca55-55e3-3485-b65d-724a4527867d",
                    "sense_definition": "Grote glazen ruit van een winkel waarin artikelen worden getoond; etalage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "raam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe kledingcollectie werd op een prachtige manier in de <w>vitrine</w> getoond.",
                            "target_lang_translations": {
                                "en": "The new clothing collection was displayed beautifully in the <w>shop window</w>."
                            }
                        },
                        {
                            "text": "Tijdens het winkelen bleef zij even staan om naar de <w>vitrine</w> van de bakker te kijken.",
                            "target_lang_translations": {
                                "en": "While shopping, she paused for a moment to look into the bakery's <w>display window</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "etalage",
                        "uitstalraam"
                    ],
                    "common_phrases": [
                        "achter de vitrine"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Veelal gebruikt in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Large glass front window of a shop in which merchandise is displayed; shop window."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shop window",
                                "target_lang_sense_clarification": "front window of a store"
                            },
                            {
                                "target_lang_word": "store window",
                                "target_lang_sense_clarification": "window facing the street displaying goods"
                            },
                            {
                                "target_lang_word": "display window",
                                "target_lang_sense_clarification": "retail window display"
                            }
                        ]
                    }
                }
            ]
