                "senses": [
                    {
                        "sense_id": "ec26c7cc-4115-3f6d-942b-ed4a42251af6",
                        "entry_id": "cecffe8d-e4c7-3677-9e82-f30f4af21e28",
                        "glosses": [
                            "związany z samorządem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8771ddf9-fb28-469a-90c6-6e612390841f",
                                "sense_id": "ec26c7cc-4115-3f6d-942b-ed4a42251af6",
                                "text": "23 czerwca br. przedstawiciele Policji i władz samorządowych uroczyście otworzyli odnowiony gmach chełmżyńskiego komisariatu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddfb65d6-7fa7-4c48-9182-e17067b71f87",
                        "source_entry_id": "cecffe8d-e4c7-3677-9e82-f30f4af21e28",
                        "source_sense_id": "ec26c7cc-4115-3f6d-942b-ed4a42251af6",
                        "target_lang_word": "council",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "council",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40ef065a-6161-3d69-8b9b-29805c1ebcb7",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "A committee that leads or governs (e.g. city council, student council)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57289e31-1574-4545-b071-2559dfa3ed87",
                                                "sense_id": "40ef065a-6161-3d69-8b9b-29805c1ebcb7",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            },
                                            {
                                                "example_id": "8190b6c7-58c9-47b7-92b0-401849e7f194",
                                                "sense_id": "40ef065a-6161-3d69-8b9b-29805c1ebcb7",
                                                "text": "The comments were made at a council meeting last month, during which one councillor questioned whether changing the names would be pushing reconciliation efforts along too quickly. […] At a city council meeting on Oct. 8, Campbell River councillors discussed a letter sent by the B.C. Geographical Names Office inviting comments on the name changes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73631d56-d291-368d-aa7e-c7a9b19784fd",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "A committee that leads or governs (e.g. city council, student council).",
                                            "A local authority."
                                        ],
                                        "tags": [
                                            "UK",
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f750de5-783e-3791-9aaa-407dc96e42c5",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "Discussion or deliberation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d470148e-09ad-4c28-ae21-84d88c79db4d",
                                                "sense_id": "2f750de5-783e-3791-9aaa-407dc96e42c5",
                                                "text": "Satan […] void of rest, / His potentates to council called by night;"
                                            },
                                            {
                                                "example_id": "d497cb16-6994-46d0-be3d-3b597e5437ca",
                                                "sense_id": "2f750de5-783e-3791-9aaa-407dc96e42c5",
                                                "text": "O great in action and in council wise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd2b899-a6d1-3054-8220-1435f9d2f69d",
                                        "entry_id": "d8641cd9-aacb-3c89-bee0-9550a07b3b9e",
                                        "glosses": [
                                            "Short for church council"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ee4c6a-e099-48b5-acb3-a5fe5479d27e",
                                                "sense_id": "9bd2b899-a6d1-3054-8220-1435f9d2f69d",
                                                "text": "the First Council of Nicaea"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "062288f5-88c7-43e4-9f67-6d2ad6b2da9b",
                        "source_entry_id": "cecffe8d-e4c7-3677-9e82-f30f4af21e28",
                        "source_sense_id": "ec26c7cc-4115-3f6d-942b-ed4a42251af6",
                        "target_lang_word": "地方",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "地方",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                        "entry_id": "b82d1efe-bf2f-3375-8e2c-08242e7e4d7a",
                                        "glosses": [
                                            "區域；地區"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02a431d3-a864-4008-a1fe-d28dc406c62d",
                                                "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                                "text": "一個陌生的地方"
                                            },
                                            {
                                                "example_id": "25178821-ccdf-4778-9c5c-eb8f037105d7",
                                                "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                                "text": "一个陌生的地方"
                                            },
                                            {
                                                "example_id": "b1621078-d411-46ec-b498-26b61ac83e48",
                                                "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                                "text": "爾國震於天威，即獻阿爾泰山地方，中國受之，置驛設守有年矣。"
                                            },
                                            {
                                                "example_id": "f9102fee-ac6e-42de-9a7b-e04fbcc59dac",
                                                "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                                "text": "尔国震于天威，即献阿尔泰山地方，中国受之，置驿设守有年矣。"
                                            },
                                            {
                                                "example_id": "3a04ab83-fae6-4337-9c1f-c3a38fdb8ff9",
                                                "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                                "text": "我在蒙自住過五個月，我的家也在那裡住過兩個月。我現在常常想起這個地方，特別是在人事繁忙的時候。蒙自小得好，人少得好。"
                                            },
                                            {
                                                "example_id": "e4c278d1-7576-4092-890d-df109d55e015",
                                                "sense_id": "165e8b54-9e0d-36e1-aab0-bac7cbd69b63",
                                                "text": "我在蒙自住过五个月，我的家也在那里住过两个月。我现在常常想起这个地方，特别是在人事繁忙的时候。蒙自小得好，人少得好。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5640b882-8b99-3638-be53-b0141be23c81",
                                        "entry_id": "b82d1efe-bf2f-3375-8e2c-08242e7e4d7a",
                                        "glosses": [
                                            "某部份、部位"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48ce1c9-23f6-4e37-b98f-f635f9ccb7ac",
                                                "sense_id": "5640b882-8b99-3638-be53-b0141be23c81",
                                                "text": "我這個地方有點疼。"
                                            },
                                            {
                                                "example_id": "8db20beb-4319-4214-9e40-6baf48b856e4",
                                                "sense_id": "5640b882-8b99-3638-be53-b0141be23c81",
                                                "text": "我这个地方有点疼。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c433b4-faf4-3e7a-8ac3-b1e995d0e498",
                                        "entry_id": "b82d1efe-bf2f-3375-8e2c-08242e7e4d7a",
                                        "glosses": [
                                            "長處"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa3eacec-6306-4181-b0b5-e7666638685a",
                                                "sense_id": "44c433b4-faf4-3e7a-8ac3-b1e995d0e498",
                                                "text": "但這孩子卻也有可敬的地方：他的從容，他的沉默，他的獨斷獨行，他的一去不回頭，都是力的表現，都是強者適者的表現。決不婆婆媽媽的，決不粘粘搭搭的，一針見血，一刀兩斷，這正是白種人之所以為白種人。"
                                            },
                                            {
                                                "example_id": "5cd310c3-b496-40e9-8382-2dd52bfca6d0",
                                                "sense_id": "44c433b4-faf4-3e7a-8ac3-b1e995d0e498",
                                                "text": "但这孩子却也有可敬的地方：他的从容，他的沉默，他的独断独行，他的一去不回头，都是力的表现，都是强者适者的表现。决不婆婆妈妈的，决不粘粘搭搭的，一针见血，一刀两断，这正是白种人之所以为白种人。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14b4e1f-52ce-3d5f-83aa-ea8e874bbc26",
                                        "entry_id": "b82d1efe-bf2f-3375-8e2c-08242e7e4d7a",
                                        "glosses": [
                                            "處所，空間"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb50726-a249-42dd-9d23-b596a4c97122",
                                                "sense_id": "f14b4e1f-52ce-3d5f-83aa-ea8e874bbc26",
                                                "text": "騰出地方"
                                            },
                                            {
                                                "example_id": "0af2068f-5971-4e03-9d9e-df0d21362a53",
                                                "sense_id": "f14b4e1f-52ce-3d5f-83aa-ea8e874bbc26",
                                                "text": "腾出地方"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35820c6f-1791-3b2c-b33f-67bc2d2e4e32",
                                        "entry_id": "b82d1efe-bf2f-3375-8e2c-08242e7e4d7a",
                                        "glosses": [
                                            "地保"
                                        ],
                                        "tags": [
                                            "countable",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3303295f-d088-4f5f-bddc-cdceac66b03a",
                                                "sense_id": "35820c6f-1791-3b2c-b33f-67bc2d2e4e32",
                                                "text": "地方呈明，石知縣家財人口，變賣都盡。"
                                            },
                                            {
                                                "example_id": "76a1195e-1f1b-49d0-9978-340856954198",
                                                "sense_id": "35820c6f-1791-3b2c-b33f-67bc2d2e4e32",
                                                "text": "地方呈明，石知县家财人口，变卖都尽。"
                                            },
                                            {
                                                "example_id": "48bae948-57cc-4633-835b-b6f5ebbf572d",
                                                "sense_id": "35820c6f-1791-3b2c-b33f-67bc2d2e4e32",
                                                "text": "他為出了一個貢，拉人出賀禮，把總甲、地方都派分子。"
                                            },
                                            {
                                                "example_id": "89487bf8-b4ef-46b5-a832-255d288c0527",
                                                "sense_id": "35820c6f-1791-3b2c-b33f-67bc2d2e4e32",
                                                "text": "他为出了一个贡，拉人出贺礼，把总甲、地方都派分子。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f0d830-fa3b-3dee-a9c5-544815d107cc",
                                        "entry_id": "b82d1efe-bf2f-3375-8e2c-08242e7e4d7a",
                                        "glosses": [
                                            "中華民國早年一種與省平級的行政區劃，等同於中國現今的自治區。"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "地方",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "79db1b10-b027-331a-8c41-6d10d2cf9fae",
                                        "entry_id": "de37dbc1-0d91-374a-9cbc-4eba961441a4",
                                        "glosses": [
                                            "平民，百姓"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f523855f-2ef7-315c-80b7-8c8e8e3d699c",
                                        "entry_id": "de37dbc1-0d91-374a-9cbc-4eba961441a4",
                                        "glosses": [
                                            "各級行政區劃的統稱"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a029e0df-cdf9-450e-8acc-9da404bd74d2",
                                                "sense_id": "f523855f-2ef7-315c-80b7-8c8e8e3d699c",
                                                "text": "中央要發展工業，地方也要發展工業。"
                                            },
                                            {
                                                "example_id": "1f63d45a-60c2-45f4-bef1-186e05761c39",
                                                "sense_id": "f523855f-2ef7-315c-80b7-8c8e8e3d699c",
                                                "text": "中央要发展工业，地方也要发展工业。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "地方",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                        "entry_id": "e5fef063-b4d5-39c2-8c42-cf346a4608ca",
                                        "glosses": [
                                            "本地，當地"
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d24b743c-0354-43cf-8e51-0a4a5a2f9dff",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "地方官員"
                                            },
                                            {
                                                "example_id": "d5b69302-8ad6-49f1-9c82-8b9b5fb98ac7",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "地方官员"
                                            },
                                            {
                                                "example_id": "f4d69dc1-457f-475f-9f61-96a49383b1e4",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "布袋戲是一種地方戲劇。"
                                            },
                                            {
                                                "example_id": "395cd261-55b4-4dc8-a1a5-8cc03c9b26e8",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "布袋戏是一种地方戏剧。"
                                            },
                                            {
                                                "example_id": "767480dd-d673-48c7-9c33-5eba9c708f47",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "這一個水災，也不知傷了多少民田民命！地方大吏飛章入奏請帑，並請揀發知縣十二員到工差遣委用。"
                                            },
                                            {
                                                "example_id": "c52cee98-de99-4419-9ff1-e490937c626d",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "这一个水灾，也不知伤了多少民田民命！地方大吏飞章入奏请帑，并请拣发知县十二员到工差遣委用。"
                                            },
                                            {
                                                "example_id": "03e0a762-880f-49f1-8192-843414cd0e6a",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "議論之間，只見許多人牽羊擔酒，持花捧幣，盡是些地方鄰里親戚，來與大郎作賀稱慶。"
                                            },
                                            {
                                                "example_id": "d64b44f6-8162-48b6-b825-d4b2f5248123",
                                                "sense_id": "bea4c892-8ab8-3a46-8a7a-134adcc8c33a",
                                                "text": "议论之间，只见许多人牵羊担酒，持花捧币，尽是些地方邻里亲戚，来与大郎作贺称庆。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
