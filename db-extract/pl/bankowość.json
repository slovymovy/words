                                "sense_id": "0c944f29-0f5f-3bc6-90a6-70aad05f406d",
                                "text": "Jurek jest wykładowcą bankowości na naszej uczelni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e6ace3c0-c8cb-36e4-8ae1-9299e99a744a",
