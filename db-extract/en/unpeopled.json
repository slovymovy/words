    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5279df58-92ea-3263-89ea-6882b9d8baa8",
                "word": "unpeopled",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5502f62f-5eb3-3a91-8536-fca78bf70631",
                        "entry_id": "5279df58-92ea-3263-89ea-6882b9d8baa8",
                        "glosses": [
                            "Not inhabited by people."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7cf6275c-3423-42f3-8ca9-df969f243762",
                                "sense_id": "5502f62f-5eb3-3a91-8536-fca78bf70631",
                                "text": "Still, one mansion, which the time ought to have unpeopled, was evidently inhabited; and in one of its rooms—small, but luxurious enough for a sultana in the Arabian Nights, or a young gentleman of the present day—were seated two persons in earnest conversation."
                            },
                            {
                                "example_id": "24630126-3c2c-4f96-bb4c-c9e57e0b1951",
                                "sense_id": "5502f62f-5eb3-3a91-8536-fca78bf70631",
                                "text": "I look out at the sunrise--that fateful sunrise which will shine upon an unpeopled world."
                            }
                        ]
                    }
                ],
                "translations": [],
