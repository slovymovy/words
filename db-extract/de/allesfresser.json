                "senses": [
                    {
                        "sense_id": "bea5f5f8-c7bf-39f0-93da-5aa4c22b8275",
                        "entry_id": "029ab1ce-6781-3b9b-ae41-46c36feb246d",
                        "glosses": [
                            "ein Lebewesen, das aus pflanzlichen und tierischen Organismen seine Nahrung bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a925c94-22ab-4d5c-a9fa-430643a2c298",
                                "sense_id": "bea5f5f8-c7bf-39f0-93da-5aa4c22b8275",
                                "text": "Das Gebiss des Allesfressers hat sich angepasst."
                            },
                            {
                                "example_id": "1d8aab9d-6f91-4db5-9d0a-fa92422d3741",
                                "sense_id": "bea5f5f8-c7bf-39f0-93da-5aa4c22b8275",
                                "text": "Der Mensch ist ein Allesfresser, vermutlich weil seine Ahnen Aasfresser waren."
                            },
                            {
                                "example_id": "fe42c93c-4546-4055-8a74-71f7ce960400",
                                "sense_id": "bea5f5f8-c7bf-39f0-93da-5aa4c22b8275",
                                "text": "„Das war eine vorzügliche Lektüre für Kinder wie den Jungen auf Laxnes, der, was Bücher betraf, ein Allesfresser war.“"
                            },
                            {
                                "example_id": "14d308e6-bd06-442f-9116-5e02c350525c",
                                "sense_id": "bea5f5f8-c7bf-39f0-93da-5aa4c22b8275",
                                "text": "„Das Wildschwein ist ein Allesfresser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2222981-fcfd-4d53-bb5c-1dcf281ed775",
