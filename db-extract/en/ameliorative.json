                "forms": [
                    {
                        "form_id": "781e90a6-34cf-4e2c-8ede-f3bf2b2beb46",
                        "entry_id": "f3685a76-a00f-33ee-af5a-b728f96a6ca9",
                        "tags": [
                            "plural"
                        ],
                        "form": "amelioratives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2be9919-aeb1-336a-82db-227648060f06",
                        "entry_id": "f3685a76-a00f-33ee-af5a-b728f96a6ca9",
                        "glosses": [
                            "That which betters or improves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287d9239-9228-4dca-a373-cfd78e349f80",
                                "sense_id": "a2be9919-aeb1-336a-82db-227648060f06",
                                "text": "With such conventional Keynesian amelioratives, the economy normally recovers with output and employment on the rise, and, unfortunately, with inflation picking up too."
                            },
                            {
                                "example_id": "12cbf1db-7a04-4246-9707-c8a4aacbf5e6",
                                "sense_id": "a2be9919-aeb1-336a-82db-227648060f06",
                                "text": "It certainly means the stripping from Parliament of endless debates on niggling parsimonies and trivial amelioratives; the thousand and one unreal fights and distractions which has kept democracy from winning the other half of freedom."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5f19bf4-248b-3cb1-960a-f95366c8f369",
                        "entry_id": "f3685a76-a00f-33ee-af5a-b728f96a6ca9",
                        "glosses": [
                            "A linguistic unit (such as a word, morpheme) that implies a positive or approving evaluation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c8fa956c-e980-4f50-bdbc-c089d0a01f97",
                                "sense_id": "d5f19bf4-248b-3cb1-960a-f95366c8f369",
                                "text": "Moreover, diminutives, augmentatives, pejoratives and amelioratives have always been analysed as independent categories, neglecting the possible interrelations among them."
                            }
                        ]
                    }
                ],
