                    {
                        "sense_id": "460aeb19-be85-3cca-a65c-6544fe4f1290",
                        "entry_id": "9596d02a-62a3-37c9-86ec-0f27d77aa52c",
                        "glosses": [
                            "eine bestimmte Menge oder Anzahl von etwas"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac88d41-b877-4377-91a1-608e39527746",
                                "sense_id": "460aeb19-be85-3cca-a65c-6544fe4f1290",
                                "text": "Mit einem Quantum Glück kriegen wir das schon hin."
                            },
                            {
                                "example_id": "7507df00-1474-447c-8690-5fea42293fee",
                                "sense_id": "460aeb19-be85-3cca-a65c-6544fe4f1290",
                                "text": "„Vermischt mit einem bestimmten Quantum Sand, entstand ein sehr guter Kalkmörtel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c429b73b-dc24-4b23-8db6-57bf5026e1c1",
                        "source_entry_id": "9596d02a-62a3-37c9-86ec-0f27d77aa52c",
                        "source_sense_id": "460aeb19-be85-3cca-a65c-6544fe4f1290",
                        "source_sense_description": "umgangssprachlich: eine bestimmte Menge oder Anzahl von etwas",
                        "target_lang_word": "quantum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quantum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b85e08c4-266f-3708-a2ab-5248758f6e23",
                                        "entry_id": "982782a7-d9fb-3438-a373-2324187bbb91",
                                        "glosses": [
                                            "The total amount of something; quantity."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0c39f4-c53d-4253-b825-561f86ba4553",
                                                "sense_id": "b85e08c4-266f-3708-a2ab-5248758f6e23",
                                                "text": "The reader will perhaps be curious to know the quantum of this present, but we cannot satisfy his curiosity."
                                            },
                                            {
                                                "example_id": "49d3ce52-3c8f-484f-8957-b0c32295fe32",
                                                "sense_id": "b85e08c4-266f-3708-a2ab-5248758f6e23",
                                                "text": "A certain quantum of power must always exist in the community, in some hands, and under some appellation."
                                            },
                                            {
                                                "example_id": "1950a300-ea0d-45b8-9a09-06d8e4eeff41",
                                                "sense_id": "b85e08c4-266f-3708-a2ab-5248758f6e23",
                                                "text": "Otherwise I will have given the lie to my maxim that whether you work eight or twenty hours, the quantum of work that gets done on a normal day is the same."
                                            },
                                            {
                                                "example_id": "0fa3224d-e55e-483c-8fec-b13ab52f068e",
                                                "sense_id": "b85e08c4-266f-3708-a2ab-5248758f6e23",
                                                "text": "The Congress's core ministerial panel on Friday gave its green signal to raising motor fuel prices but the quantum of increase emerged as a hitch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0889310e-c6f6-3a37-970b-d3899e9f32f2",
                                        "entry_id": "982782a7-d9fb-3438-a373-2324187bbb91",
                                        "glosses": [
                                            "The total amount of something; quantity.",
                                            "The amount of compensation awarded to a successful party in a lawsuit."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81528851-57c6-32ca-b0eb-714f633c67ea",
                                        "entry_id": "982782a7-d9fb-3438-a373-2324187bbb91",
                                        "glosses": [
                                            "The total amount of something; quantity.",
                                            "The length or magnitude of the sentence handed down to someone who has been found guilty of a crime."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a23dfb8-bcc9-38a2-905a-47d6311eed94",
                                        "entry_id": "982782a7-d9fb-3438-a373-2324187bbb91",
                                        "glosses": [
                                            "The amount or quantity observably present, or available."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ae7cd05-03f2-4d63-b023-f7ab84bf4bb2",
                                                "sense_id": "4a23dfb8-bcc9-38a2-905a-47d6311eed94",
                                                "text": "Each man has only a quantum of compassion, he argued, and mine is used up for the day."
                                            },
                                            {
                                                "example_id": "a3ff856b-36a7-4226-967f-59ceb9aa151a",
                                                "sense_id": "4a23dfb8-bcc9-38a2-905a-47d6311eed94",
                                                "text": "The dream of flying, according to Strümpell, is the appropriate image used by the psyche to interpret the quantum of stimulus [translating Reizquantum] proceeding from the rise and fall of the lungs when the cutaneous sensation of the thorax has simultaneously sunk into unconsciousness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3fbf4ab-7139-3b51-acb8-23a3f2a63954",
                                        "entry_id": "982782a7-d9fb-3438-a373-2324187bbb91",
                                        "glosses": [
                                            "The smallest possible, and therefore indivisible, unit of a given quantity or quantifiable phenomenon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5170c737-4a0a-45af-aba9-08c2f006e43b",
                                                "sense_id": "e3fbf4ab-7139-3b51-acb8-23a3f2a63954",
                                                "text": "The quantum of light energy was later called a photon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70e19ce-8456-3d82-aa99-051b6f3fff84",
                                        "entry_id": "982782a7-d9fb-3438-a373-2324187bbb91",
                                        "glosses": [
                                            "The amount of time allocated for a thread to perform its work in a multithreaded environment."
                                        ],
