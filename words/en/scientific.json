                    "sense_id": "6c9541b3-8de8-3979-ad21-caaf7a4d5d53",
                    "sense_definition": "Relating to or connected with the study of science.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "science_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university is famous for its groundbreaking <w>scientific</w> research in medicine.",
                            "target_lang_translations": {
                                "ru": "Университет славится своими новаторскими <w>научными</w> исследованиями в области медицины."
                            }
                        },
                        {
                            "text": "She decided to pursue a <w>scientific</w> career after winning the chemistry prize.",
                            "target_lang_translations": {
                                "ru": "Она решила продолжить <w>научную</w> карьеру после получения премии по химии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scientific research",
                        "scientific community",
                        "scientific discovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к науке или связанный с изучением наук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "научный",
                                "target_lang_sense_clarification": "связанный с наукой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0d4b620-3aef-3d0b-9f69-b37e37fc1c60",
                    "sense_definition": "Based on or characterized by the methods and principles of science.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "science_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to use a <w>scientific</w> method to test our hypothesis accurately.",
                            "target_lang_translations": {
                                "ru": "Нам нужно использовать <w>научный</w> метод, чтобы точно проверить нашу гипотезу."
                            }
                        },
                        {
                            "text": "The study provides <w>scientific</w> evidence that climate change is accelerating.",
                            "target_lang_translations": {
                                "ru": "Исследование предоставляет <w>научные</w> доказательства того, что изменение климата ускоряется."
                            }
                        }
                    ],
                    "synonyms": [
                        "systematic",
                        "methodical"
                    ],
                    "antonyms": [
                        "unscientific"
                    ],
                    "common_phrases": [
                        "scientific method",
                        "scientific evidence",
                        "scientific approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на методах и принципах науки или характеризующийся ими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "научный",
                                "target_lang_sense_clarification": "основанный на методах науки"
                            },
                            {
                                "target_lang_word": "систематический",
                                "target_lang_sense_clarification": "упорядоченный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4237d4f-e234-3314-bbe8-00ea787dda5e",
                    "sense_definition": "In accordance with the strict procedures and accepted conventions of modern science.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From a <w>scientific</w> point of view, the experiment was a complete success.",
                            "target_lang_translations": {
                                "ru": "С <w>научной</w> точки зрения эксперимент прошел с полным успехом."
                            }
                        },
                        {
                            "text": "The data must be analyzed from a <w>scientific</w> point of view to ensure objectivity.",
                            "target_lang_translations": {
                                "ru": "Данные должны быть проанализированы с <w>научной</w> точки зрения для обеспечения объективности."
                            }
                        }
                    ],
                    "synonyms": [
                        "systematic",
                        "methodical"
                    ],
                    "common_phrases": [
                        "scientific point of view",
                        "scientific data",
                        "scientific analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий строгим процедурам и принятым конвенциям современной науки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "научный",
                                "target_lang_sense_clarification": "соответствующий стандартам науки"
                            },
                            {
                                "target_lang_word": "методический",
                                "target_lang_sense_clarification": "строго следующий методу"
                            }
                        ]
