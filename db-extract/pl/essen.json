                            {
                                "target_word": "Essen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8865b5-fe32-3b99-b94d-b3e5dd13b599",
                                        "entry_id": "157e87fe-bf3a-375f-ae17-042e927e5b12",
                                        "glosses": [
                                            "eine zubereitete Speise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc735259-93d1-4cb1-93a4-bc1ebd3e1000",
                                                "sense_id": "fe8865b5-fe32-3b99-b94d-b3e5dd13b599",
                                                "text": "Das war ein leckeres Essen."
                                            },
                                            {
                                                "example_id": "18c805af-491e-4427-894d-b7ec5a859df2",
                                                "sense_id": "fe8865b5-fe32-3b99-b94d-b3e5dd13b599",
                                                "text": "„Jedes Essen kostete je nach Angebot zwischen 25 und 45 Pfennigen, also zwischen einem knappen Stundenlohn einer Hilfsarbeiterin und dem Drittel eines Facharbeiterstundenlohns, außerdem natürlich entsprechende Lebensmittelmarken.“"
                                            },
                                            {
                                                "example_id": "0a7d60c9-a239-472c-9bb6-c7a75cd3dad8",
                                                "sense_id": "fe8865b5-fe32-3b99-b94d-b3e5dd13b599",
                                                "text": "„Hier blieben wir nicht weniger als drei volle Tage, bekamen außerordentlich gutes Essen und hatten, neben anderen gewöhnlichen Nahrungsmitteln, Fisch, Brot und Butter.“"
                                            },
                                            {
                                                "example_id": "cfd031f2-7c99-491d-8578-66002946c788",
                                                "sense_id": "fe8865b5-fe32-3b99-b94d-b3e5dd13b599",
                                                "text": "„Eine Dienerin trug nun das Essen auf.“"
                                            },
                                            {
                                                "example_id": "c37fcdff-8e59-48e8-9d2c-fee45feda2fd",
                                                "sense_id": "fe8865b5-fe32-3b99-b94d-b3e5dd13b599",
                                                "text": "„Einer der jungen Bücherpagen nämlich machte ihn darauf aufmerksam, daß er das Essen für den Herrn Archivar aus dem Gasthaus geholt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42f0f915-282e-3152-8520-683c084772a0",
                                        "entry_id": "157e87fe-bf3a-375f-ae17-042e927e5b12",
                                        "glosses": [
                                            "die Tätigkeit der Nahrungsaufnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b09a71-7883-4319-a952-7b040fcdace1",
                                                "sense_id": "42f0f915-282e-3152-8520-683c084772a0",
                                                "text": "Beim Essen kann man sich gut unterhalten."
                                            },
                                            {
                                                "example_id": "044979a2-d211-4f38-b0c4-09b12e284f61",
                                                "sense_id": "42f0f915-282e-3152-8520-683c084772a0",
                                                "text": "„Schon während des Essens hatten sich ihre Bedenken, ob einem jungen Mann aus gutem Hause eine so schlichte Mahlzeit schmecken würde, aufgelöst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a2d2d22a-48e8-3054-8628-8510306a6be2",
                                        "entry_id": "157e87fe-bf3a-375f-ae17-042e927e5b12",
                                        "glosses": [
                                            "Mahlzeit, festliche Mahlzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9c6d6-f635-4be8-b614-b27446f99271",
                                                "sense_id": "a2d2d22a-48e8-3054-8628-8510306a6be2",
                                                "text": "Er wurde von seinem Geschäftspartner zum Essen eingeladen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c3e391a9-5d74-3d71-9128-79f8eaf01986",
                                        "entry_id": "157e87fe-bf3a-375f-ae17-042e927e5b12",
                                        "glosses": [
                                            "Lebensmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7725ecb6-a362-49bb-b1fe-2b62e10be147",
                                                "sense_id": "c3e391a9-5d74-3d71-9128-79f8eaf01986",
                                                "text": "Man sollte zusammen mit den Kindern Essen einkaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
