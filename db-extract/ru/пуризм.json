                        "sense_id": "91c1a150-e6d2-3fe5-9d94-fab0a7c4780f",
                        "entry_id": "5751f2ed-d5dd-3426-a4dc-9d5c739edf3f",
                        "glosses": [
                            "стремление к чистоте и строгости нравов"
                        ],
                        "tags": [],
                        "examples": []
                    }
