                        "sense_id": "f27fc297-9fe0-37dc-bbb6-384929350ca7",
                        "entry_id": "4a4bc44b-882b-3b3d-b98c-6343e7558d6e",
                        "glosses": [
                            "Relatif à l’Union nationale des étudiants de France (Unef)."
                        ],
                        "tags": [
                            "France",
                            "Syndicalisme étudiant"
                        ],
                        "examples": [
                            {
                                "example_id": "28681ab0-5f72-4137-bc35-f1054de33696",
                                "sense_id": "f27fc297-9fe0-37dc-bbb6-384929350ca7",
                                "text": "L’approche historique, qui constitue la première partie du mémoire, rejoint le travail de Nathalie Luycks à Lyon … : rôle de la «mythologie «unefienne … entretenue par les agents eux-mêmes, qu’ils soient anciens dirigeants ou actuels responsables»."
                            },
                            {
                                "example_id": "b0e56821-0157-4a30-b0fa-eb8712565e6b",
                                "sense_id": "f27fc297-9fe0-37dc-bbb6-384929350ca7",
                                "text": "Cette manifestation unefienne d’étudiants sursitaires est un acte caractérisé de guerre subversive."
                            }
                        ]
                    }
                ],
