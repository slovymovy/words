                ],
                "senses": [
                    {
                        "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                        "entry_id": "3f6e7543-62b3-3fed-ae2c-e6dfd3ac5391",
                        "glosses": [
                            "материал, предназначенный для дальнейшей промышленной обработки и изготовления готового продукта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6727d2cc-8e15-4191-9883-8caa8c849ca1",
                                "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                "text": "Дело в том, что где-то в конце 20-х — начале 30-х годов всё оборудование и сырьё для этой фабрики было куплено у какой-то американской фирмы."
                            },
                            {
                                "example_id": "13c51fdf-6391-42fd-a952-9cb91734ebde",
                                "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                "text": "Способ привлечь интерес промышленности (заставить, если хотите) к переработке сырья в высокотехнологичные изделия, между прочим, давно известен ― это таможенное регулирование."
                            },
                            {
                                "example_id": "5d864815-ccb4-4181-9f7b-c5808cb0cd43",
                                "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                "text": "Качество древесного сырья, с одной стороны, зависит от условий произрастания древостоев, которые влияют на размерные характеристики хлыстов (диаметр и длину) и по которым определяются категория крупности и количество деловых сортиментов, с другой ― от наличия пороков, влияющих на сортность деловых сортиментов."
                            }
                        ]
                    },
                    {
                        "sense_id": "a88f80b5-06f3-3534-81d0-d627113cb6ee",
                        "entry_id": "3f6e7543-62b3-3fed-ae2c-e6dfd3ac5391",
                        "glosses": [
                            "перен., разг. то, что не до конца отделано, не обработано как следует"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4aa7f0d-c232-460d-87ab-3c4c2bc933e3",
                        "source_entry_id": "3f6e7543-62b3-3fed-ae2c-e6dfd3ac5391",
                        "target_lang_word": "raw material",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raw material",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f12b42d4-3838-3088-a4f8-e52bd27c278d",
                                        "entry_id": "70fcc15f-288f-3cb3-b5ca-f23f24df1fc4",
                                        "glosses": [
                                            "A material in its unprocessed, natural state considered usable for manufacture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f78cf81-28d6-46b5-b809-be2a7753521b",
                                                "sense_id": "f12b42d4-3838-3088-a4f8-e52bd27c278d",
                                                "text": "Petroleum is the raw material refined into various fuels and needed for countless chemicals."
                                            },
                                            {
                                                "example_id": "d52caf3e-a247-4f95-8c18-7860e966dbe7",
                                                "sense_id": "f12b42d4-3838-3088-a4f8-e52bd27c278d",
                                                "text": "The three main firms […] are increasing their output capacity and it is estimated that by 1964-5 railborne traffic will be about a third greater than the 1960 figure, reaching a total of something like 13½ million tons per annum, of which some 70 per cent will be inwards raw materials for these firms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc866688-578f-3f6d-bf76-56e571b85872",
                                        "entry_id": "70fcc15f-288f-3cb3-b5ca-f23f24df1fc4",
                                        "glosses": [
                                            "Any physical product serving as input to a factory or other installation which processes it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1d8b3ec-6410-4c79-953d-6871bb634f83",
                                                "sense_id": "bc866688-578f-3f6d-bf76-56e571b85872",
                                                "text": "The assembly plant's raw materials are finished parts from Asian suppliers."
                                            },
                                            {
                                                "example_id": "8196ab78-1e91-4f7c-b491-dcee087e2a80",
                                                "sense_id": "bc866688-578f-3f6d-bf76-56e571b85872",
                                                "text": "Teams will place all their unassembled raw materials and tools in the competition area along with two provided 5-gallon buckets of contaminated water and two provided stirring sticks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
