                        "form": "sie sind wesensmäßig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3f4be3e-8fe4-3377-bbfe-f5bb9c982b45",
                        "entry_id": "e68e7121-1972-3967-bc76-d29a2667bc37",
                        "glosses": [
                            "dem innewohnenden Kern/Wirkprinzip entsprechend, die eigentliche Natur einer Sache (Wesen) betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48ae9ee-8dde-47ef-938c-88d4a918b322",
                                "sense_id": "d3f4be3e-8fe4-3377-bbfe-f5bb9c982b45",
                                "text": "„Die wesensmäßige Einheit jedoch ergibt sich aus den innewohnenden Prinzipien eines Wesens.“"
                            },
                            {
                                "example_id": "a6f77ce3-ba58-4f9d-b1c3-2c4981510d28",
                                "sense_id": "d3f4be3e-8fe4-3377-bbfe-f5bb9c982b45",
                                "text": "„Die Gewissensäußerung muß aber wesensmäßig eine andere sein: vor, in und nach der moralisch guten oder schlechten Handlung.“"
                            },
                            {
                                "example_id": "1a28c465-972a-4203-8a12-bc21906a63b1",
                                "sense_id": "d3f4be3e-8fe4-3377-bbfe-f5bb9c982b45",
                                "text": "„Husserls Antwort ist, daß das Ding an sich als seine Selbigkeit wesensmäßig nie gegeben ist, und daß diese Selbigkeit des Wesens des Dinges nur eine regulative Idee bleibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d12e9a49-4b5f-3cdf-8ffb-2d2052cb8ba3",
                        "entry_id": "e68e7121-1972-3967-bc76-d29a2667bc37",
                        "glosses": [
                            "dem innewohnenden Kern/Charakter (eines Wesens) entsprechend"
                        ],
                        "tags": [],
                        "examples": [
                            {
