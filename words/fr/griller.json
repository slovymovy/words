                },
                {
                    "sense_id": "12e87e89-4c9b-3ce4-8013-b3a66484c14b",
                    "sense_definition": "Dessécher, brûler ou détériorer sous l'action d'une chaleur intense ou du soleil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chaleur",
                    "name_type": "no",
                    "examples": [
