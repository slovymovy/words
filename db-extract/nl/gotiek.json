                    },
                    {
                        "translation_id": "db110aa3-d803-4a26-a5a4-ef80976cd6e5",
                        "source_entry_id": "03d5dacc-1da7-3532-b1d5-a29b9db1977e",
                        "source_sense_id": "3384a0d7-ae7b-3a51-b03e-b46124cad42f",
                        "target_lang_word": "gothique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gothique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af097cf5-acf2-3c0c-a6f7-a76e558b1911",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Qui est relatif aux Goths et aux peuples qui leur ont succédé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce71680-e720-45e5-988a-85778baab61c",
                                                "sense_id": "af097cf5-acf2-3c0c-a6f7-a76e558b1911",
                                                "text": "La langue gothique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6672a20-d42e-3840-b4c0-dc8c9a514de9",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Qualifie l’alphabet formé au quatrième siècle par l’évêque Ulphilas et employé par lui à la transcription de la langue gothique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b504c435-6034-380a-81b9-012d4b960f17",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Qualifie le style des lettres inventées par Ulphilas et qualifie les anciens caractères d’imprimerie qui ont de la ressemblance avec ce genre d’écriture. → voir Fraktur"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644f044e-f259-47a2-873c-879707b6b9bb",
                                                "sense_id": "b504c435-6034-380a-81b9-012d4b960f17",
                                                "text": "Elle passa près de l’étudiant pour examiner un petit modèle de tapisserie dans un cadre noir accroché non loin du lit : on voyait un alphabet au-dessous duquel se lisait cette phrase en lettres gothiques : « Le Seigneur bénisse notre foyer ! »."
                                            },
                                            {
                                                "example_id": "4a268371-e9f4-410e-b3fe-50d95b3534e9",
                                                "sense_id": "b504c435-6034-380a-81b9-012d4b960f17",
                                                "text": "J’aime avec elle essayer de me rappeler l’allemand que j’ai appris autrefois en bavardant et elle me le fait lire dans l’écriture gothique…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "740f90ad-fdd3-3bf9-926b-66c0be28c496",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Qui est relatif au Moyen Âge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "725084cf-8c51-4ce9-a7af-b08075c4f369",
                                                "sense_id": "740f90ad-fdd3-3bf9-926b-66c0be28c496",
                                                "text": "Ce n’était pas encore tout à fait l’époque où une sorte d’intérêt préromantique pour le Moyen Âge allait devenir de vogue, et le mot gothique, naguère terme de dédain, commencer à échauffer les imaginations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8276075e-252f-385e-9cd1-686a250353e9",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Relatif à la dernière période de l'art du Moyen Âge (du XIIᵉ au XVIᵉ siècle)."
                                        ],
                                        "tags": [
                                            "Histoire de l’art"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe022f39-58b3-4bf8-ba85-2bf730e576e1",
                                                "sense_id": "8276075e-252f-385e-9cd1-686a250353e9",
                                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                                            },
                                            {
                                                "example_id": "3dcde3b0-ccec-454d-b10f-71690c2f64e2",
                                                "sense_id": "8276075e-252f-385e-9cd1-686a250353e9",
                                                "text": "[…], au fond, personne ne connaît au juste l’origine des formes gothiques d’une cathédrale. Les archéologues et les architectes ont vainement épuisé toutes les suppositions, tous les systèmes ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd4f47f0-03e6-313f-90c9-d784107714f3",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Ce qui paraît trop ancien, hors de mode, désuet."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41699768-360d-44ee-893b-12cf5216b018",
                                                "sense_id": "fd4f47f0-03e6-313f-90c9-d784107714f3",
                                                "text": "[…] on les trouvera dans ces petits livres gothiques qu’on vendait autrefois un sou, mais qu’on croit aujourd’hui payer bon marché en les couvrant d’or."
                                            },
                                            {
                                                "example_id": "2cd38e87-490d-4caa-af8c-724857afeea3",
                                                "sense_id": "fd4f47f0-03e6-313f-90c9-d784107714f3",
                                                "text": "Je connaissais les gothiques préjugés de ma bonne tante, qui ne parlait de mésalliance qu'avec une dédaigneuse hauteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c960bbc5-2776-322b-a9ef-0053f66afb11",
                                        "entry_id": "17acbacf-b34c-373d-8321-2e699e00252f",
                                        "glosses": [
                                            "Qui est relatif au mouvement culturel (notamment musical et vestimentaire), apparu à la fin du XXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a58246fd-35c3-4747-8a7d-de0cfbfcdda4",
                                                "sense_id": "c960bbc5-2776-322b-a9ef-0053f66afb11",
                                                "text": "Le rock gothique est un sous-genre du post punk né en Angleterre à la fin des années 1970 sur les cendres du mouvement punk, avec des groupes précurseurs comme Joy Division, Siouxsie and the Banshees et The Cure."
                                            },
                                            {
                                                "example_id": "924838bd-4a10-436c-a0aa-8a7f47a9a306",
                                                "sense_id": "c960bbc5-2776-322b-a9ef-0053f66afb11",
                                                "text": "Il existe ainsi un code vestimentaire, la mode gothique essentiellement basée sur le noir et les couleurs sombres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gothique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "753a2b48-e073-3581-8456-82ee37652ea9",
                                        "entry_id": "c0611089-0770-31ec-b914-6c5ce9484222",
                                        "glosses": [
                                            "Langue autrefois parlée par les Goths."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63084c07-41f7-4673-822f-cfc83b03b627",
                                                "sense_id": "753a2b48-e073-3581-8456-82ee37652ea9",
                                                "text": "Les Goths parlaient le gothique ou gotique."
                                            },
                                            {
                                                "example_id": "f5a3db55-06c1-4fd3-a536-bc36e97934c9",
                                                "sense_id": "753a2b48-e073-3581-8456-82ee37652ea9",
                                                "text": "Ulphilas traduisit la Bible en gothique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320eeac9-9534-3375-b4f7-4a71c8fa59ea",
                                        "entry_id": "c0611089-0770-31ec-b914-6c5ce9484222",
                                        "glosses": [
                                            "Architecture, peinture, etc. qui fut en usage du XIIᵉ siècle au XVᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6114d252-c156-429d-a2ca-073fbedde6ed",
                                                "sense_id": "320eeac9-9534-3375-b4f7-4a71c8fa59ea",
                                                "text": "J’appelle moyen-âge, dans l’histoire de la littérature française, les XIIᵉ, XIIIᵉ et XIVᵉ siècles. […] Le commencement de cette époque est marqué en Europe par une crise sociale, de laquelle sortent tout à la fois les communes, l’organisation complète de la féodalité et de la papauté, les idiomes modernes de l’Europe, l’architecture appelée gothique."
                                            },
                                            {
                                                "example_id": "12c4dd75-ae27-4742-b9c7-0cc0a5597acd",
                                                "sense_id": "320eeac9-9534-3375-b4f7-4a71c8fa59ea",
                                                "text": "La Bible, le livre inflexible de Jéhovah, le code terrible du Père, n’est-il pas traduit par le Roman dur et contrit et les Évangiles si consolants et si doux, par le Gothique plein d’effusions et de câlineries, plein d’humbles espoirs ?"
                                            },
                                            {
                                                "example_id": "94ed3d6d-41c4-4cbe-bfde-aa991f010a3d",
                                                "sense_id": "320eeac9-9534-3375-b4f7-4a71c8fa59ea",
                                                "text": "À première vue, on attribuerait au gothique flamboyant cette maîtresse œuvre où l’on découvre bientôt les volutes, les ornements, toutes les riches imaginations de la Renaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d34c821-7ca8-33b8-8001-b75ebb6a2f25",
                                        "entry_id": "c0611089-0770-31ec-b914-6c5ce9484222",
                                        "glosses": [
                                            "Mouvement culturel (en particulier musical et vestimentaire) apparu en Europe au début des années 1980."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gothique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f443fb2a-c9ce-3c61-b8fa-c0026ca636cd",
                                        "entry_id": "2501dfde-c089-33f7-a056-012589223a2a",
                                        "glosses": [
                                            "Ellipse de écriture gothique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a1faf0-2232-40ff-9905-d60aeac70ba6",
                                                "sense_id": "f443fb2a-c9ce-3c61-b8fa-c0026ca636cd",
                                                "text": "Avant l’arrivée de la gothique, il y avait les écritures dites carolines, desquelles découle la gothique primitive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3288e2e9-f9fb-4ecd-948b-f0d68b5ca6bd",
                        "source_entry_id": "03d5dacc-1da7-3532-b1d5-a29b9db1977e",
