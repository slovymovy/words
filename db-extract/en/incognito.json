                                        "entry_id": "0c4700f2-cb2e-36a4-8100-9a53cabdb0a8",
                                        "glosses": [
                                            "анонимно или под вымышленным именем; сохраняя тайну своей личности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a319a122-95b3-4225-9c37-c9d98c16e11d",
                                                "sense_id": "c5bdb397-1e80-3fbf-ab78-242d22583cfb",
                                                "text": "Во главе посольства стал Лефорт и Фёдор Головин; сам Пётр I был членом посольства и путешествовал инкогнито под именем Петра Михайлова."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "инко́гнито",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3392e2f-8601-3fd4-ac88-f9175ec79caa",
                                        "entry_id": "8123e8df-9a79-34fe-84cc-1e3edcef7836",
                                        "glosses": [
                                            "тот, чья личность сохраняется в тайне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b71051f-f6e6-41b4-a3f2-a9647b1bf7bb",
                                                "sense_id": "f3392e2f-8601-3fd4-ac88-f9175ec79caa",
                                                "text": "Наш инкогнито не был комедийным актером, но один смешной эксцентрический фильм с его участием известен всем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38fe8cab-c617-393e-b4fb-2a7c1c9a82b6",
                                        "entry_id": "8123e8df-9a79-34fe-84cc-1e3edcef7836",
                                        "glosses": [
                                            "тайна такой личности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498e3226-9d67-4ad4-bc6a-f22a8f64e646",
                                                "sense_id": "38fe8cab-c617-393e-b4fb-2a7c1c9a82b6",
                                                "text": "Адвокат обвинил власти в циничном пренебрежении достоинством Келли, поскольку они сначала раскрыли его инкогнито, а затем довели его разбирательствами до самоубийства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
