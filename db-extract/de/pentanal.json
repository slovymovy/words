                "senses": [
                    {
                        "sense_id": "d131a9d9-dafa-32b8-94a9-f8017c9e29d0",
                        "entry_id": "e4452ed3-3a06-35df-b71f-8efcbf5bb856",
                        "glosses": [
                            "farblose, stechend riechende Flüssigkeit, deren Moleküle aus fünf Kohlenstoffatomen und einer Aldehydgruppe bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46048879-b7d5-49bb-b707-dc87eec0ede3",
                                "sense_id": "d131a9d9-dafa-32b8-94a9-f8017c9e29d0",
                                "text": "„Natürlich kommt Pentanal in Färberdisteln, Sojabohnen, Echtem Lorbeer, Luzerne, Arabischem Bergkraut, Reis (Oryza sativavor), Schwarzen Johannisbeeren, Rosa damascena, Sesam und Kartoffeln vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d05d0d70-b086-30d7-b5cf-28047c77c7b0",
                        "entry_id": "e4452ed3-3a06-35df-b71f-8efcbf5bb856",
                        "glosses": [
                            "gesättigte Aldehyde, deren Moleküle aus fünf Kohlenstoffatomen und einer Aldehydgruppe bestehen"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3371d8ea-c0c4-4aef-8fdc-a2928a08762c",
                                "sense_id": "d05d0d70-b086-30d7-b5cf-28047c77c7b0",
                                "text": "„Die Pentanale sind eine Gruppe von vier isomeren gesättigten Aldehyden mit fünf Kohlenstoffatomen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
