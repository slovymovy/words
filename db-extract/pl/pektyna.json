                    },
                    {
                        "sense_id": "2508d8f9-67c0-34f7-8d13-179393eda37e",
                        "entry_id": "e470299b-6157-342c-98be-2aa7aef99e01",
                        "glosses": [
                            "dodatek do żywności, żelujący, zagęszczający i stablizujący, powstały na bazie pektyn (1.1), dostępny też w postaci produktu handlowego do użytku domowego"
                        ],
                        "tags": [],
