                        "examples": [
                            {
                                "example_id": "56017801-6436-4d2d-9d53-e746cce303ca",
                                "sense_id": "80c4ef7b-d28c-3542-85b2-03fe8b05855c",
                                "text": "BASIC était préinstallé dans pratiquement tous les ordinateurs personnels de l'époque. Thomson alla plus loin que presque tous ses compétiteurs en matière de langages de programmation."
                            },
                            {
                                "example_id": "31cdb088-1246-4d65-9d32-04d90bd0a677",
                                "sense_id": "80c4ef7b-d28c-3542-85b2-03fe8b05855c",
                                "text": "« Là , les enfants vont simuler le programme d'un jeu mis au point en langage Basic au cours des séances précédentes : le nombre mystérieux. »"
                            },
                            {
                                "example_id": "aa0ff29a-e131-4b5f-b1cd-a289af0eb7ba",
                                "sense_id": "80c4ef7b-d28c-3542-85b2-03fe8b05855c",
                                "text": "Le triomphe du BASIC a été amplifié encore par l'arrivée du micro-ordinateur."
                            },
                            {
                                "example_id": "cd530345-5e5c-496d-9204-5a8852047ac4",
                                "sense_id": "80c4ef7b-d28c-3542-85b2-03fe8b05855c",
                                "text": "Il faut réaliser des exercices pour maîtriser l'habilité mentale à programmer des algorithmes en BASIC. Les diverses implantations du langage BASIC disponibles commercialement ont en commun les mêmes structures"
                            }
                        ]
                    }
