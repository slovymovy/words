{
    "word_family": [
        "disobedience",
        "disobedient",
        "disobediently",
        "obedience",
        "obedient",
        "obediently",
        "obey"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccb9ae90-be51-30e7-aebc-3fa88c7f08f9",
                    "sense_definition": "To refuse or deliberately fail to obey a rule, law, order, or person in authority.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disobey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student was suspended after choosing to deliberately <w>disobey</w> school rules.",
                            "target_lang_translations": {
                                "tr": "Öğrenci, okul kurallarına kasten <w>uymamayı</w> seçtikten sonra okuldan uzaklaştırıldı."
                            }
                        },
                        {
                            "text": "He knew he would get into trouble if he decided to <w>disobey</w> his parents.",
                            "target_lang_translations": {
                                "tr": "Ailesine <w>karşı gelmeye</w> karar verirse başının belaya gireceğini biliyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "disregard",
                        "ignore"
                    ],
                    "antonyms": [
                        "obey",
                        "comply",
                        "conform",
                        "submit"
                    ],
                    "common_phrases": [
                        "disobey orders",
                        "disobey rules",
                        "disobey parents",
                        "disobey an instruction"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir kurala, yasaya, emre veya yetkili bir kişiye kasten uymayı reddetmek ya da uymamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "itaatsizlik etmek",
                                "target_lang_sense_clarification": "bir kişiye veya otoriteye karşı gelmek"
                            },
                            {
                                "target_lang_word": "uymamak",
                                "target_lang_sense_clarification": "kural, emir veya yasalara uymamak"
                            },
                            {
                                "target_lang_word": "karşı gelmek",
                                "target_lang_sense_clarification": "birinin sözünü veya emrini dinlememek"
                            },
                            {
                                "target_lang_word": "dinlememek",
                                "target_lang_sense_clarification": "bir otoritenin sözüne uymamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce6eab46-f2f8-3173-a90e-93f3e3347a4b",
                    "sense_definition": "To refuse or deliberately fail to follow instructions or submit to authority, used intransitively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disobey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier hesitated for a moment, knowing the severe consequences if he dared to <w>disobey</w>.",
                            "target_lang_translations": {
                                "tr": "Asker, <w>itaatsizlik etmeye</w> cüret ederse karşılaşacağı ağır sonuçları bildiğinden bir an tereddüt etti."
                            }
                        },
                        {
                            "text": "Although warned repeatedly about the risks, the workers chose to <w>disobey</w> in protest.",
                            "target_lang_translations": {
                                "tr": "Riskler konusunda defalarca uyarılmalarına rağmen işçiler protesto amacıyla <w>itaatsizlik etmeyi</w> seçti."
                            }
                        }
                    ],
                    "synonyms": [
                        "balk",
                        "refuse"
                    ],
                    "antonyms": [
                        "obey",
                        "comply",
                        "yield"
                    ],
                    "common_phrases": [
                        "dare to disobey",
                        "choose to disobey"
                    ],
                    "target_lang_definitions": {
                        "tr": "Talimatları uygulamayı veya otoriteye boyun eğmeyi kasten reddetmek (geçişsiz kullanım)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "itaatsizlik etmek",
                                "target_lang_sense_clarification": "otoriteye boyun eğmemek"
                            },
                            {
                                "target_lang_word": "itaat etmemek",
                                "target_lang_sense_clarification": "verilen emre uymamak"
                            },
                            {
                                "target_lang_word": "karşı gelmek",
                                "target_lang_sense_clarification": "başkaldırmak veya diretmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}