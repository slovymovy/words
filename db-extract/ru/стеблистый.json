                                        "examples": [
                                            {
                                                "example_id": "27b1cb38-3d34-4eb3-8974-a1bbd755c4e8",
                                                "sense_id": "26f54ebe-fe75-37fe-a8d8-9cef000ac7df",
                                                "text": "I peeped between the stalky parts of the Lindsays’ lilacs."
                                            },
                                            {
                                                "example_id": "3baaf4f1-3dad-4990-b3c2-95259b20fd28",
                                                "sense_id": "26f54ebe-fe75-37fe-a8d8-9cef000ac7df",
                                                "text": "An adorably gangly salesman with stalky black hair and a cough (“I’m giving up smoking, and it’s all coming up”) set up a dressing room for me, and I tried on a black tux shirt with a subtly embroidered bib ($185), a soft ivory-colored jersey ($135) and an olive-green button-front shirt ($165)."
                                            }
                                        ]
