                    {
                        "sense_id": "40a383d5-302d-3248-8e2e-4c9f325c1f0b",
                        "entry_id": "178e05ec-2718-391c-a7b4-7ca27a386191",
                        "glosses": [
                            "vrouw die wordt beschouwd als de eerste van een afstammingsreeks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c5474b-8361-45b0-86e5-cb0ac1d3b04a",
                                "sense_id": "40a383d5-302d-3248-8e2e-4c9f325c1f0b",
                                "text": "Eerder onderzoek suggereerde dat de oermoeder, de eva van het mitochondriaal DNA, een stuk vroeger leefde dan de adam van het Y-chromosoom."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ce07401-6752-391a-831c-8e0dcfde77de",
                        "entry_id": "178e05ec-2718-391c-a7b4-7ca27a386191",
                        "glosses": [
                            "smal schortje vanaf het middel"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6cea26a8-cfc5-477c-a44d-63b60b3afc44",
                                "sense_id": "0ce07401-6752-391a-831c-8e0dcfde77de",
                                "text": "Het duurde een minuut of wat alvorens een eigenaardig sloffen in het voorhuis de aankomst eener bejaarde keukenmeid verried, die eerst natuurlijk den aardappel, waaraan zij bezig was, had moeten afschillen, daarna den bak van haar schoot en haar beide voeten van haar stoof zetten, om vervolgens haar roode muilen aan te trekken, haar neus met het buitenste van haar hand af te vegen, haar eva in de schuinte op te slaan, en den langen weg te aanvaarden, die van de keukendeur tot aan den barometer twintig, en van den barometer tot de mat zes stappen vergde."
                            }
                        ]
                    }
