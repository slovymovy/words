                                "target_senses": [
                                    {
                                        "sense_id": "4c1b1d86-9896-3e37-a9b8-c2c761cf690d",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "Repetition of an activity to improve a skill."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f5cbf6-73a6-4a32-9ab4-5fd383bc947e",
                                                "sense_id": "4c1b1d86-9896-3e37-a9b8-c2c761cf690d",
                                                "text": "He will need lots of practice with the lines before he performs them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c93272-beea-312b-8536-856d26f6fee3",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "An organized event for the purpose of performing such repetition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7aab97c-d765-44bb-baeb-507697978add",
                                                "sense_id": "21c93272-beea-312b-8536-856d26f6fee3",
                                                "text": "Being on a team is hard: you're always having to go to practice while everyone else is taking it easy."
                                            },
                                            {
                                                "example_id": "17585ff3-ea30-431d-a03a-8c0dd0ddb8e3",
                                                "sense_id": "21c93272-beea-312b-8536-856d26f6fee3",
                                                "text": "I have choir practice every Sunday after church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c97f6ae-fc84-3c9a-905d-d7ea352e6b30",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "The ongoing pursuit of a craft or profession, particularly in medicine or the fine arts."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d517398-0a32-40d7-adb9-947ab65de794",
                                                "sense_id": "5c97f6ae-fc84-3c9a-905d-d7ea352e6b30",
                                                "text": "Which is the most demanding? I think that my practice as an artist is 'stronger' because it is the practice that best fuels and balances myself and that generates new knowledge for my other work as both arts educator and creative arts therapist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb7018d-576b-342f-9024-6b1879e217b6",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "A place where a professional service is provided, such as a general practice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904c7466-5022-4734-af7c-a3e9af61a02d",
                                                "sense_id": "3fb7018d-576b-342f-9024-6b1879e217b6",
                                                "text": "She ran a thriving medical practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "495cb0f9-d262-3383-8c4e-70da5422899a",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "The observance of religious duties that a church requires of its members."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214a550d-71da-374a-80e9-f93a1b03fe60",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "A customary action, habit, or behaviour; a manner or routine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d257be8a-1875-4fd7-80de-5b6ad2a95453",
                                                "sense_id": "214a550d-71da-374a-80e9-f93a1b03fe60",
                                                "text": "It is the usual practice of employees there to wear neckties only when meeting with customers."
                                            },
                                            {
                                                "example_id": "7722ad1d-2ffd-4401-af4b-6056874aa66f",
                                                "sense_id": "214a550d-71da-374a-80e9-f93a1b03fe60",
                                                "text": "It is good practice to check each door and window before leaving."
                                            },
                                            {
                                                "example_id": "7f1685bf-7e07-43d4-a0c9-f509035d502a",
                                                "sense_id": "214a550d-71da-374a-80e9-f93a1b03fe60",
                                                "text": "As a result, New Zealand locomotive design is a curious blend of English and American practice; certainly the American influence has always been much stronger than in Australia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77938b19-70f5-37f0-b4ef-dc8bec86db8f",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "Actual operation or experiment, in contrast to theory."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a7ad0e1-6dca-47b9-971d-2ae41a588011",
                                                "sense_id": "77938b19-70f5-37f0-b4ef-dc8bec86db8f",
                                                "text": "That may work in theory, but will it work in practice?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef94dcaa-fe66-3b35-93e1-d503e807d611",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "The form, manner, and order of conducting and carrying on suits and prosecutions through their various stages, according to the principles of law and the rules laid down by the courts."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99803648-3cb4-43f5-af47-3c7c0bb93c0c",
                                                "sense_id": "ef94dcaa-fe66-3b35-93e1-d503e807d611",
                                                "text": "This firm of solicitors is involved in family law practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900f0f2d-3bea-3a9f-b9f0-42a7cb7d3d8d",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "Skilful or artful management; dexterity in contrivance or the use of means; stratagem; artifice."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "493cb862-c446-4b0a-b2d4-c70033a6b325",
                                                "sense_id": "900f0f2d-3bea-3a9f-b9f0-42a7cb7d3d8d",
                                                "text": "He sought to have that by practice which he could not by prayer.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382e40f5-290f-3e7e-bb77-27613d3c22a0",
                                        "entry_id": "975cf41c-ff03-3cd9-9510-b1ad594d3d2c",
                                        "glosses": [
                                            "An easy and concise method of applying the rules of arithmetic to questions which occur in trade and business."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
