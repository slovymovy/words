                        "sense_id": "9e9bf152-a3aa-3d90-9a6e-76f89d71b65f",
                        "entry_id": "ff974061-c20d-3c8d-a5ac-fa3a13bfd7d2",
                        "glosses": [
                            "Able to form degrees or grades"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4858a920-8d9e-3c21-906e-8268f5676a47",
                        "entry_id": "ff974061-c20d-3c8d-a5ac-fa3a13bfd7d2",
                        "glosses": [
                            "Able to occur in varying degrees; able to be inflected or modified to express degrees of meaning."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ae8aac6e-0b3b-4d63-ac7b-4fc1498dba4b",
                                "sense_id": "4858a920-8d9e-3c21-906e-8268f5676a47",
                                "text": "Hot and cold are gradable antonyms."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ee5e232-c453-35e2-a520-2b40d741926a",
                        "entry_id": "ff974061-c20d-3c8d-a5ac-fa3a13bfd7d2",
                        "glosses": [
                            "steep, but still able to be climbed by a motor vehicle"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66e0a31c-0cce-4f0d-8db3-9df0f06ff234",
                        "source_entry_id": "ff974061-c20d-3c8d-a5ac-fa3a13bfd7d2",
