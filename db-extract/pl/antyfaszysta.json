                    },
                    {
                        "translation_id": "c7c5c1ea-345f-4127-aa5d-ddf10b0c5fe8",
                        "source_entry_id": "5ebd483e-e6f7-3131-b72b-e90b29ccf490",
                        "source_sense_id": "e3c82b5f-885e-3d8a-a95d-af7a56d251c1",
                        "target_lang_word": "Antifaschist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antifaschist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cecb1be7-6178-39d0-8905-b51e557ca764",
                                        "entry_id": "6fa28bf3-bbc0-31d5-99d1-1d133cf9cf07",
                                        "glosses": [
                                            "Vertreter des Antifaschismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb49e06-5fe4-4eae-9bac-17a4b091780b",
                                                "sense_id": "cecb1be7-6178-39d0-8905-b51e557ca764",
                                                "text": "„ ‚Da sind sie hingerichtet worden, die Antifaschisten, nicht wahr Herr Wachtmeister?‘ Er sah mich schräg an und nickte: ‚Ja, da hat der [Johann] Reichart gehaust …‘ “"
                                            },
                                            {
                                                "example_id": "dab4561c-9168-4631-804c-3a1918e83df3",
                                                "sense_id": "cecb1be7-6178-39d0-8905-b51e557ca764",
                                                "text": "„Nehru war ein entschlossener Antifaschist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89e01295-d009-4a2b-8e15-cf0ede37a553",
                        "source_entry_id": "5ebd483e-e6f7-3131-b72b-e90b29ccf490",
                        "source_sense_id": "e3c82b5f-885e-3d8a-a95d-af7a56d251c1",
                        "target_lang_word": "антифашист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антифашист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                                        "entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                                        "glosses": [
                                            "человек, ведущий борьбу с фашизмом, противник фашизма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f31aba7d-277d-4da4-94c4-eb8812d6556f",
                                                "sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                                                "text": "Штурмовые отряды, вооружённые до зубов, избивают антифашистов и евреев, производят повальные обыски и аресты."
                                            },
                                            {
                                                "example_id": "fa8ee040-cef0-4adf-a3ff-54c1bba12daf",
                                                "sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                                                "text": "Постепенно мне становилось ясно, что существовала какая-то группа немецких антифашистов, связанная с Бухом, они помогали военнопленным, которым удалось бежать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
