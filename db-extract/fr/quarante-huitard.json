                        "entry_id": "86e04a16-1934-3b75-bb96-54b95cd4af35",
                        "glosses": [
                            "Républicain de la révolution de 1848."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "872f6e47-b5d7-4f05-bc67-e94f25a366f4",
                                "sense_id": "4bdb16fa-b923-3a4f-a123-ce187ae6603d",
                                "text": "[…] ; aussi, malgré qu'il fût républicain, républicain comme l'étaient les quarante-huitards, dans un pays confit en religion, il avait été durant douze ans maire de son village, […]."
                            },
                            {
                                "example_id": "5615b246-2d10-4840-ac00-027af9b59728",
                                "sense_id": "4bdb16fa-b923-3a4f-a123-ce187ae6603d",
                                "text": "Ou bien le quarante-huitard a tourné le dos à la Commune et Lissagaray le tient pour un traître (Louis Blanc) ou pour une ganache (Schœlcher), ou bien il y a pris part en s'y faisant remarquer par sa verbeuse imbécillité (Félix Pyat, Miot et consorts.)"
                            }
                        ]
                    }
