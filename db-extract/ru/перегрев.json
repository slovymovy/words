                    }
                ],
                "translations": [
                    {
                        "translation_id": "d47ddb87-50f1-4e77-910f-7fa1e90dc68d",
                        "source_entry_id": "8af02431-399e-35b3-9693-529e1d386a32",
                        "source_sense_id": "afe202ac-7e03-30d5-88af-88ae3f75121d",
                        "target_lang_word": "surchauffe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surchauffe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "491214b4-bf19-3cc3-9563-67d9cf27e40d",
                                        "entry_id": "003686b4-7a3e-30fd-abd5-af03e6940580",
                                        "glosses": [
                                            "Action de surchauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980c3dc3-8b33-40ef-8d85-c6a33dd0cd32",
                                                "sense_id": "491214b4-bf19-3cc3-9563-67d9cf27e40d",
                                                "text": "Avant son discours, quinze bouteilles d'eau avaient été alignées devant la table des convives. Était-ce pour asperger nos amis en cas de surchauffe métabolitique?"
                                            },
                                            {
                                                "example_id": "2d39bbce-fe35-41f8-954e-3fe275f048ad",
                                                "sense_id": "491214b4-bf19-3cc3-9563-67d9cf27e40d",
                                                "text": "Mes enfants en rentrant de l’école me trouvaient hagarde, les paupières clignotantes, dans un état de surchauffe qui me rappelait Le joueur d’échecs de Zweig."
                                            },
                                            {
                                                "example_id": "e79c3374-3d94-4b69-8b3d-8daca8a95787",
                                                "sense_id": "491214b4-bf19-3cc3-9563-67d9cf27e40d",
                                                "text": "Il est permis de se demander quels pourraient être les impacts d’investissements aussi ambitieux, susceptibles de causer une surchauffe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df241a26-e687-39a2-ad22-9e506a301fdd",
                                        "entry_id": "003686b4-7a3e-30fd-abd5-af03e6940580",
                                        "glosses": [
                                            "État métastable d’un liquide chauffé dont la température est plus élevée que son point d’ébullition."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42707b8c-c4b3-36b5-8b45-5aca74bd7f45",
                                        "entry_id": "003686b4-7a3e-30fd-abd5-af03e6940580",
                                        "glosses": [
                                            "État d'une économie où la demande est supérieure à l'offre au point d'entraîner une hausse de l'inflation."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8befd8-2134-4336-a373-8fed094b2e3e",
                                                "sense_id": "42707b8c-c4b3-36b5-8b45-5aca74bd7f45",
                                                "text": "Dans une économie dont le taux de chômage est déjà faible, tout signe de surchauffe (que pourraient causer, par exemple, les réductions d’impôts envisagées) fera l’objet d’un resserrement de la politique monétaire."
                                            },
                                            {
                                                "example_id": "9f5a134c-2fa6-4d60-8348-0041f7aa7f21",
                                                "sense_id": "42707b8c-c4b3-36b5-8b45-5aca74bd7f45",
                                                "text": "La baisse ds nouveaux crédits accordés par les banques le mois dernier montre apparemment que les efforts de Pékin pour éviter la surchauffe de la troisième économie mondiale commencent à porter leurs fruits, même si les analystes s'inquiètent toujours des pressions inflationnistes."
                                            }
                                        ]
                                    }
                                ]
                            },
