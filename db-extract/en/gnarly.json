        "zh-extract.jsonl": [
            {
                "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                "word": "gnarly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fa0ce32a-c8e6-4f9b-9494-44828459a84a",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "tags": [
                            "comparative"
                        ],
                        "form": "gnarlier"
                    },
                    {
                        "form_id": "db1ca0fb-943a-40f2-ace8-b1efdb96853e",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "tags": [
                            "superlative"
                        ],
                        "form": "gnarliest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cc77378-4e33-3c05-bd28-f11423e6b2f9",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "glosses": [
                            "多瘤的，多木结的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342ab91e-89b8-4e29-a994-abe2d4ef6920",
                                "sense_id": "2cc77378-4e33-3c05-bd28-f11423e6b2f9",
                                "text": "Out of one window I can see the garden, those mysterious deep-shaded arbors, the riotous old-fashioned flowers, and bushes and gnarly trees."
                            }
                        ]
                    },
                    {
                        "sense_id": "abdb3fcd-735c-3ab3-bd44-47d55987e09b",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "glosses": [
                            "极佳的，很棒的，吸引人的"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e30bc37b-ce07-4123-8469-d8af22405535",
                                "sense_id": "abdb3fcd-735c-3ab3-bd44-47d55987e09b",
                                "text": "There ain't nothing gnarlier (apparently) than slapping on some brightly coloured sunblock to ward off the blinding spectre of dangerous, snow-reflected sunlight."
                            }
                        ]
                    },
                    {
                        "sense_id": "90bf59bb-92df-3314-a7f7-015ebac42bc2",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "glosses": [
                            "危险的，困难的"
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2ca679d8-2a59-49be-9d09-a0dec881ec65",
                                "sense_id": "90bf59bb-92df-3314-a7f7-015ebac42bc2",
                                "text": "a gnarly problem",
                                "translation": "棘手的问题"
                            },
                            {
                                "example_id": "4c4dd498-cfaf-412e-b7af-358f5aab862b",
                                "sense_id": "90bf59bb-92df-3314-a7f7-015ebac42bc2",
                                "text": "When the swell struck, the North Shore got gnarly, and the wise ones hit the outer islands where the energy was just as juicy but a bit more organized."
                            },
                            {
                                "example_id": "6e0f4f77-c62b-4467-b059-c8d3e16a1bcd",
                                "sense_id": "90bf59bb-92df-3314-a7f7-015ebac42bc2",
                                "text": "Work that makes you unhappy is what I mean by \"a gnarly problem.\" The trouble is, the market pays for solutions to gnarly problems, not solutions to easy problems. As the Yorkshire lads say, \"Where there's muck, there's brass.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "543652d1-ea98-3cf6-bde7-03ea076a2cda",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "glosses": [
                            "差劲的，讨厌的，难看的"
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f67417e3-d932-4a3d-a17f-5dc3d98bd391",
                                "sense_id": "543652d1-ea98-3cf6-bde7-03ea076a2cda",
                                "text": "We're not talking about a lame chick and a gnarly guy. We're talking about a couple of far-out dudes."
                            },
                            {
                                "example_id": "8dec75a8-1ce0-4061-8653-ecc0c242fcdb",
                                "sense_id": "543652d1-ea98-3cf6-bde7-03ea076a2cda",
                                "text": "Funky Kong: 'Those Snowmads are a gnarly bunch! I hear they're enjoyin' your island. Go get 'em, DK!'"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5cd4b88-bd8f-3f7d-8381-15beaf11b1f8",
                        "entry_id": "5407e30c-d24a-3a17-8f58-87dcff491041",
                        "glosses": [
                            "差劲的，讨厌的，难看的",
                            "刺耳的，难听的"
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7ee4ce14-393c-414f-ae56-fb2c1f530e29",
                                "sense_id": "a5cd4b88-bd8f-3f7d-8381-15beaf11b1f8",
                                "text": "We're not talking about a lame chick and a gnarly guy. We're talking about a couple of far-out dudes."
                            },
                            {
                                "example_id": "63334f71-9871-4475-80cb-28105cfc34bf",
                                "sense_id": "a5cd4b88-bd8f-3f7d-8381-15beaf11b1f8",
                                "text": "Funky Kong: 'Those Snowmads are a gnarly bunch! I hear they're enjoyin' your island. Go get 'em, DK!'"
                            },
                            {
                                "example_id": "c0ac021b-4570-45cf-a9af-a8b64f9dec9c",
                                "sense_id": "a5cd4b88-bd8f-3f7d-8381-15beaf11b1f8",
                                "text": "[She] displays the same love of gnarly fuzztones and shout-it-out-loud choruses that began back in her daze^([sic]) with local all-girl rockers the Runaways."
                            }
                        ]
                    }
                ],
