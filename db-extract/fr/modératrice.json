                    {
                        "sense_id": "c82461a5-5627-3bcb-8544-2470d0b902d7",
                        "entry_id": "603797da-4a71-354c-b0e1-f9ce7afeb2b1",
                        "glosses": [
                            "Féminin singulier de modérateur."
