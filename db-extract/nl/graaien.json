                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2467710-a458-35d3-b104-e645a8ae4e6e",
                        "entry_id": "86887f26-89f7-3528-9bc6-4ee9ad3af5ae",
                        "glosses": [
                            "met de handen ergens in rondtasten"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "f1f59cfa-0ee7-4b3f-beaf-bd43654368ef",
                                "sense_id": "e2467710-a458-35d3-b104-e645a8ae4e6e",
                                "text": "Grieken graaien in vuilnisbakken om aan eten te komen"
                            }
                        ]
                    },
                    {
                        "sense_id": "143dfcee-4cdf-3945-ae67-1309927a40cc",
                        "entry_id": "86887f26-89f7-3528-9bc6-4ee9ad3af5ae",
                        "glosses": [
                            "~ uit stelen, wegpakken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fda35174-9921-48ec-ba08-1d866881f2b4",
                                "sense_id": "143dfcee-4cdf-3945-ae67-1309927a40cc",
                                "text": "Logisch, als je weet dat het spul vers uit de vitrine is gegraaid."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b04bf82-c530-3eaf-a18e-69d4f9609f30",
                        "entry_id": "86887f26-89f7-3528-9bc6-4ee9ad3af5ae",
                        "glosses": [
                            "zich op oneerlijke of discutabele wijze verrijken bij de uitoefening van zijn functie"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "ecc2c300-5ba9-4f7a-a3a0-2974caa9f8d4",
                                "sense_id": "4b04bf82-c530-3eaf-a18e-69d4f9609f30",
                                "text": "Als we terugkijken wanneer het grote graaien is begonnen dan belanden we voor Nederland aan het eind van de jaren 90, in Amerika was er natuurlijk al veel eerder sprake van een uitgesproken graaicultuur"
                            },
                            {
                                "example_id": "9087d4e4-b9ca-49fb-b704-ceaa2f15c544",
                                "sense_id": "4b04bf82-c530-3eaf-a18e-69d4f9609f30",
                                "text": "het 'graaien' gaat dóór: Topman Air France KLM pakt €3 miljoen aan bonus terwijl de Franse Staat moest bijspringen en de tent technisch failliet is."
                            }
                        ]
                    }
                ],
