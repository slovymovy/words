                                    {
                                        "sense_id": "3fb0c27e-b826-3e26-bca2-7762391826ab",
                                        "entry_id": "8bf59d94-939d-3f14-9d29-8a3842061e8b",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 14, das zu den Halbmetallen zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ff5732-9255-45a2-82c1-9e1c3664939d",
                                                "sense_id": "3fb0c27e-b826-3e26-bca2-7762391826ab",
                                                "text": "Silizium gibt es wie Sand am Meer."
                                            },
                                            {
                                                "example_id": "f82b1623-bde7-4f3e-9d4f-b63fd8cdb865",
                                                "sense_id": "3fb0c27e-b826-3e26-bca2-7762391826ab",
                                                "text": "Elementares Silizium ist für den menschlichen Körper ungiftig und in gebundener silikatischer Form für den Menschen wichtig."
                                            },
                                            {
                                                "example_id": "d7bdeb70-927e-4329-86b4-074239f9ed1d",
                                                "sense_id": "3fb0c27e-b826-3e26-bca2-7762391826ab",
                                                "text": "Die gesamte Chemie des Siliziums ist eigentlich durch die hohe Affinität des Siliziums zum Sauerstoff geprägt."
                                            },
                                            {
                                                "example_id": "c4988e89-d8a8-4272-a2a5-cc6a3c9cd311",
                                                "sense_id": "3fb0c27e-b826-3e26-bca2-7762391826ab",
                                                "text": "Die Inversion der Bindungspolarität von Element-Wasserstoff-Bindungen beim Übergang von Kohlenstoff zum Silizium ist besonders erwähnenswert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f27be597-3fdc-4de4-95c2-b196851575fa",
                        "source_entry_id": "5d48ac82-984e-357c-9c4f-99b86b4d1607",
                        "source_sense_id": "6e822dcb-c123-39c4-a59b-5f4a6bbaf364",
                        "source_sense_description": "Scheikundig element met symbool Si en atoomnummer 14",
