                        "form": "неве́жествами"
                    },
                    {
                        "form_id": "70704e38-6947-44a0-9c60-2260f702f437",
                        "entry_id": "5fc93e43-2d8e-3b19-9971-276c1bc1aa26",
                        "tags": [
                            "singular",
