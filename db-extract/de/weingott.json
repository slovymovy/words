                "senses": [
                    {
                        "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                        "entry_id": "bb1c9690-634c-3c90-bfc8-91b1e8495699",
                        "glosses": [
                            "Gottheit, die in Verbindung mit dem Genuss von Wein und der Kultur des Weinbaus steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d06d1d-e5fb-43e8-82fd-654d15eb53b3",
                                "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                                "text": "„Dionysos (im griechischen Raum) und Bacchus (im römischen Raum) werden als Weingötter verherrlicht. Der Wein wird vom Heilgetränk zum Volksgetränk.“"
                            },
                            {
                                "example_id": "5bba648b-bb26-47f0-bdc2-a07674915908",
                                "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                                "text": "„Satyre waren die Begleiter des Weingottes Dionysos und verkörperten das üppige Leben in der Natur.“"
                            },
                            {
                                "example_id": "37b2256b-f469-4ecf-b66f-9e9e670ef7aa",
                                "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                                "text": "„Unter uns ein wunderschönes Mosaik, fast vollständig erhalten, zeigt es das Besäufnis des Weingottes Dionysius mit Herakles.“"
                            },
                            {
                                "example_id": "38169360-3e4e-4aa2-95b1-603bb8708c83",
                                "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                                "text": "„Die meisten Feste in der Antike waren bestimmten Göttern, wie dem Weingott Bacchus oder dem Ackergott Saturn gewidmet (Bacchanalien und Saturnalien) und fanden zu deren Ehren statt.“"
                            },
                            {
                                "example_id": "f9a94adb-3120-4660-87fc-d68af88879e8",
                                "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                                "text": "„Der kühne spanische Hofmaler versetzt in seinem Gemälde von 1628/29 den antiken Weingott in eine Gesellschaft von Bauern und Trinkern, die mit ihren Schlapphüten und Wämsern als Zeitgenossen des Malers und der damaligen Betrachter erscheinen.“"
                            },
                            {
                                "example_id": "cfe964f1-101f-46fd-b5d8-400a21f81e4a",
                                "sense_id": "151cc24f-694d-3c92-8005-7a345dc4bb40",
                                "text": "„Nicht umsonst setzten die Griechen Osiris mit ihrem ekstatischen Weingott Dionysos gleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
