                    },
                    {
                        "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                        "entry_id": "c326811c-d801-36c0-b665-ef3c2c8b700f",
                        "glosses": [
                            "because; Further details are uncertain."
                        ],
                        "tags": [
                            "Middle",
                            "Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "334edb54-4d2e-47b6-862f-5241fc251f14",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Enim, coniunctio causalis, Yż/ Bo"
                            },
                            {
                                "example_id": "0d8cd697-c68f-49a8-938b-415b8618bc56",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Nam, coniunctio causalis primum tantum locum sortitur, Bo, Iż."
                            },
                            {
                                "example_id": "66240a6e-dc4a-4151-ae42-912f3ca0f47c",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Quia coniunctio causalis, Iż/ dla tego yż."
                            },
                            {
                                "example_id": "c7b2ca81-3c33-41b7-92aa-fc8826f5a2ba",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Quod coniunctio causalis indicativo aliquando frequentius subiunctivo iungitur, Yſz/ co/ dla tego."
                            },
                            {
                                "example_id": "2129fde9-ec23-45d5-9bea-b386cbdd0688",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Quominus id est ut non, Aby nie yż nie."
                            },
                            {
                                "example_id": "99544f3b-391c-4701-991e-13837182f345",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Quoniam coniunctio causalis, A iż/ przeto iż/ dlatego iż."
                            },
                            {
                                "example_id": "4002fcbf-1b2a-4f14-8dc8-1d9fe504ea09",
                                "sense_id": "4b03697b-163e-36f5-a1f4-595257f504d1",
                                "text": "Quoad Donec, quandiu, quousque ‒ Iako długo, iz, az."
                            }
                        ]
                    }
