                        "examples": [
                            {
                                "example_id": "64ba3c2f-e141-4757-bbe6-1bbd94d85eea",
                                "sense_id": "d442843e-c693-31e4-b233-6e9a82107395",
                                "text": "[…] les Osmanides se contentèrent d’inquiéter les états de l’empereur en Asie […]"
                            },
                            {
                                "example_id": "ed0a4ee3-2a09-4326-9dc1-4c81b8e5920e",
                                "sense_id": "d442843e-c693-31e4-b233-6e9a82107395",
                                "text": "La confiance sympathique du sultan Abd-ul-Hamid, le plus honnête, le plus bienveillant, le plus réellement humain de tous les Osmanides, le prince Ferdinand la possède, l’a loyalement acquise et la gardera […]"
                            },
                            {
                                "example_id": "d6822bff-fc43-49e4-a795-f39a4da90d86",
                                "sense_id": "d442843e-c693-31e4-b233-6e9a82107395",
                                "text": "[…] les Osmanides se montrèrent plus cléments envers les esclaves grecs."
                            }
                        ]
                    }
