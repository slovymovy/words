                "senses": [
                    {
                        "sense_id": "95ff0efe-5760-389f-a949-4cdc1cd798b5",
                        "entry_id": "86523ee5-550c-3031-bb5c-1d63dafbedd3",
                        "glosses": [
                            "Qui usurpe."
                        ],
                        "tags": [
                            "Adjectivement"
                        ],
                        "examples": [
                            {
                                "example_id": "672190db-7933-4af0-a179-ab3c74776f00",
                                "sense_id": "95ff0efe-5760-389f-a949-4cdc1cd798b5",
                                "text": "Le peuple portait toute son attention sur le chevalier noir ; il remplissait l’air des cris de « Vive Richard Cœur-de-Lion ! À bas les templiers usurpateurs ! »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8087e366-2c89-3be1-a499-9869fd69e176",
                "word": "usurpateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1cbd86e5-919f-4eea-940f-4bec329e6bc4",
                        "entry_id": "8087e366-2c89-3be1-a499-9869fd69e176",
                        "tags": [
                            "plural"
                        ],
                        "form": "usurpateurs"
                    },
                    {
                        "form_id": "d74f66e6-227c-473d-9f88-676f81cd3b1d",
                        "entry_id": "8087e366-2c89-3be1-a499-9869fd69e176",
                        "tags": [
                            "feminine"
                        ],
                        "form": "usurpatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61744f25-ee48-3e6b-a93a-d39179786e2d",
                        "entry_id": "8087e366-2c89-3be1-a499-9869fd69e176",
                        "glosses": [
                            "Personne qui, par violence ou par ruse, s’empare d’un bien, d’une souveraineté, d’un pouvoir, d’une dignité, d’un titre, etc., qui ne lui appartient pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c37c5ab-9c07-4a10-8fb0-f0b8801e7c28",
                                "sense_id": "61744f25-ee48-3e6b-a93a-d39179786e2d",
                                "text": "Le jeune roi des forêts, victime de Tord-Chêne, - son oncle, usurpateur, - savait déjà quel était son rang, qu'on voulait lui cacher."
                            },
                            {
                                "example_id": "9b4f07e8-04fb-4ee7-83bb-453c844e7d14",
                                "sense_id": "61744f25-ee48-3e6b-a93a-d39179786e2d",
                                "text": "Une sourde lutte qui se traduit en toutes choses dans la vie quotidienne met sans cesse en présence les 85% de déshérités et les 15% de privilégiés, qui se sentent des usurpateurs, incultes au surplus, souvent incapables de diriger ce qu'ils devraient savoir diriger pour justifier leur existence. — (Victor Serge, Portrait de Staline -1940)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c167f4d8-01b0-4f61-9a90-7f57a5d614de",
                        "source_entry_id": "8087e366-2c89-3be1-a499-9869fd69e176",
                        "source_sense_id": "61744f25-ee48-3e6b-a93a-d39179786e2d",
                        "target_lang_word": "usurper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usurper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9066285-b6b2-3d7c-935e-99bb233245ae",
                                        "entry_id": "8bdaf719-0ba1-3c22-8225-b43084e12467",
                                        "glosses": [
                                            "One who usurps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4114cee5-629c-4dda-afbd-8cecee6f14bb",
                                                "sense_id": "d9066285-b6b2-3d7c-935e-99bb233245ae",
                                                "text": "The fact that the Yongle emperor was therefore a usurper, regicide and nepoticide (nephew-killer) made compiling the Veritable Record – or official history – of his reign a most dangerous scholarly post. The official given this ticklish task managed to survive several drafts, finally producing one that pleased his master as it omitted the dead nephew's reign altogether."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
