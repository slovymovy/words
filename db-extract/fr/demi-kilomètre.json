                "senses": [
                    {
                        "sense_id": "9154e0ad-f0e6-3ff2-bf3d-18c7b454d4e3",
                        "entry_id": "e80d21b9-5c5d-3544-8193-13bb4a46cd3e",
                        "glosses": [
                            "La moitié d’un kilomètre, c’est-à-dire 500 mètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d79d5c-aec9-46ea-8153-9bd8689cd418",
                                "sense_id": "9154e0ad-f0e6-3ff2-bf3d-18c7b454d4e3",
                                "text": "Devant eux, la route de Nice montait le versant opposé de la vallée ; mais ils ne pouvaient en voir qu’un bout assez court, car elle fait un coude brusque, à un demi-kilomètre du pont, et se perd entre des coteaux boisés."
                            },
                            {
                                "example_id": "05078841-1cfd-4d75-a455-fa5f7d0d8412",
                                "sense_id": "9154e0ad-f0e6-3ff2-bf3d-18c7b454d4e3",
                                "text": "Il parcourut de la sorte un demi-kilomètre et à cet instant il vit le petit vapeur stopper ses machines, car il était arrivé à une encâblure de la côte."
                            },
                            {
                                "example_id": "8c548db0-042f-40c8-8c20-dd1323aafb94",
                                "sense_id": "9154e0ad-f0e6-3ff2-bf3d-18c7b454d4e3",
                                "text": "Or, on entend mal le bruit d’une fête à un kilomètre et demi de distance ; on l’entend très bien à moins d’un demi-kilomètre."
                            },
                            {
                                "example_id": "75d9adbe-1f22-4c6c-a8d9-b2bad57a7096",
                                "sense_id": "9154e0ad-f0e6-3ff2-bf3d-18c7b454d4e3",
                                "text": "Les bornes indiquant les kilomètres sont plus grandes que celles qui indiquent les demi-kilomètres."
                            }
                        ]
                    }
                ],
