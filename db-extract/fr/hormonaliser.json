                "senses": [
                    {
                        "sense_id": "296df00b-16b6-383e-ba1d-15873ad77d8c",
                        "entry_id": "89ca6571-c0e1-3b51-9106-97608aed63d8",
                        "glosses": [
                            "Faire produire des hormones à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852f6afa-77d7-43f9-8cb1-960fb05d91cd",
                                "sense_id": "296df00b-16b6-383e-ba1d-15873ad77d8c",
                                "text": "Moi non plus, je ne me sens pas læ conscience propre, de devoir bientôt accueillir et hormonaliser des nourrissons. (sic)"
                            },
                            {
                                "example_id": "aaef72f7-d045-4a80-9e72-0c4714003903",
                                "sense_id": "296df00b-16b6-383e-ba1d-15873ad77d8c",
                                "text": "Les chiens prennent souvent leur caractère définitif entre 8 mois et 3 ans surtout au moment où ils s'hormonalisent (entre 8 mois et 1 an 1/2 pour les grands chiens) !"
                            },
                            {
                                "example_id": "e4864b6a-4161-4a4b-9d59-daf7e1e50a12",
                                "sense_id": "296df00b-16b6-383e-ba1d-15873ad77d8c",
                                "text": "Comment un blanc « hormonalisé » peut-il accepter que Toussaint Louverture, un ex-noble réduit en esclavage, ait osé les considérer, l’un et l’autre, dans le titre d’un écrit, comme « Le premier des Noirs » et « Le Premier des Blancs » ???"
                            }
                        ]
                    }
