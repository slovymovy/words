                "senses": [
                    {
                        "sense_id": "3ceda730-df8a-3c54-8344-544152192a8e",
                        "entry_id": "2aeec69f-4ba5-3630-9a06-df88577e33c6",
                        "glosses": [
                            "Brücke über den Fluss Dnjepr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7529f773-5460-42de-8b56-f8b0a8117fd6",
                                "sense_id": "3ceda730-df8a-3c54-8344-544152192a8e",
                                "text": "„Da bemerken wir, dass die große Dneprbrücke von den Russen bombardiert wurde und brennt.“"
                            },
                            {
                                "example_id": "98911cb5-3109-45c7-a1da-0c0519a80c82",
                                "sense_id": "3ceda730-df8a-3c54-8344-544152192a8e",
                                "text": "„Der seit Ende des Ersten Weltkrieges völlig gesperrte Verkehr zwischen Rumänien und der Sowjetunion wurde mit der Eisenbahnverbindung über eine neue Dneprbrücke bei Tiraspol ' wieder aufgenommen.“"
                            },
                            {
                                "example_id": "d3d0598a-866d-4cd2-b6c8-974efde4b0a9",
                                "sense_id": "3ceda730-df8a-3c54-8344-544152192a8e",
                                "text": "„Wir verabredeten am Fuße der größten der zerstörten Dneprbrücken, und dort traf ich ihn dann eines Morgens.“"
                            },
                            {
                                "example_id": "8ee053ad-0f8b-43be-93e9-ce38f90e0c0d",
                                "sense_id": "3ceda730-df8a-3c54-8344-544152192a8e",
                                "text": "„Einem gastfreundlichen Ukrainer verdankten wir es, in Kiew nicht unter eine Dneprbrücke schlafen zu müssen.“"
                            },
                            {
                                "example_id": "bfef6799-008a-41e3-93bd-d3fc00e7e1b0",
                                "sense_id": "3ceda730-df8a-3c54-8344-544152192a8e",
                                "text": "„Als mit dem Morgen sich in der Lage der Dinge vor Smolensk nichts ånderte, beschloß der Officier fich möglichst nahe an die Dneprbrücke zu begeben, um dort mit irgend einer Gelegenheit in die Stadt zu kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
