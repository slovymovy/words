                                        "examples": [
                                            {
                                                "example_id": "e8285594-dcb7-4f47-b10a-3e8d20b8a68e",
                                                "sense_id": "f17635c3-ebb6-37e2-b1f2-ea197076229a",
                                                "text": "Selon Victor, le tueur aurait assuré que son « réseau », ou peu importe le mot, les poursuivrait même si l’un d’eux le faisait entauler."
                                            },
                                            {
                                                "example_id": "eb709283-da47-4e01-bbe9-994aaa2fbc4d",
                                                "sense_id": "f17635c3-ebb6-37e2-b1f2-ea197076229a",
                                                "text": "Avec 76 points d’avance sur la fusée de DSM, Marianne Vos s’est quasiment assuré le maillot vert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
