                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac22867b-2938-317d-8be9-e8286de5a0cb",
                        "entry_id": "ace942e8-6a98-32c2-abd1-13712ea315db",
                        "glosses": [
                            "Schrift für blinde Personen, bei der die Buchstaben kombinatorisch auf je sechs erhabenen, meist in Papier eingeprägten Punkten abgebildet sind, und daher ertastet werden kann"
                        ],
                        "tags": [],
                        "examples": [],
