                    {
                        "translation_id": "02735d1a-dfa7-4bf6-869d-d975eb8281ac",
                        "source_entry_id": "ef79de60-32cd-3f73-9fd7-8c4073c3acf2",
                        "source_sense_id": "ceec83b9-5666-3ae2-8cdd-e408528159d0",
