                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinschloss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                                        "entry_id": "c734d844-f243-3dc5-ab9b-58d775e144e6",
                                        "glosses": [
                                            "Zündmechanismus in einer Feuerwaffe des Mittelalters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bcc2fc8-2ec7-4223-bcff-c040de5b7035",
                                                "sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                                                "text": "„Um dem vorzubeugen, wird hier die Funktionsweise des Steinschlosses erläutert, das bei vielen der verwendeten Gewehre und Pistolen im Fantasylarp den Zündmechanismus darstellt.“"
                                            },
                                            {
                                                "example_id": "964488be-cffa-416f-8ffa-41094d4dcd48",
                                                "sense_id": "2f54a17c-082b-3c97-a5b0-a7adf3b6bb72",
                                                "text": "„Ein Steinschloss muss eine kräftige Hauptfeder haben, und alle Schlossteile müssen mit minimaler Reibung laufen, damit möglichst wenig an Energie aufgezehrt wird – kräftige Funken brauchen eine Menge Energie!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
