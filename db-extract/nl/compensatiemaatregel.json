                "senses": [
                    {
                        "sense_id": "454f46c7-ca29-390c-9811-03891ce8b931",
                        "entry_id": "4e958837-52ed-397d-ba45-3605bdb4af22",
                        "glosses": [
                            "handelingen die er voor moeten zorgen dat de nadelige bijwerkingen van andere maatregelen worden teniet gedaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b07399ba-869f-4a19-bea6-ef65ea2ec588",
                                "sense_id": "454f46c7-ca29-390c-9811-03891ce8b931",
                                "text": "En de compensatiemaatregelen van staatssecretaris Jetta Klijnsma van Sociale Zaken voor mensen die getroffen worden door de eerdere AOW-verhoging, konden niet langer wachten. „De AOW-verhoging was al ingegaan. De wet was al in werking. De afspraak was niet om 3 maanden niet te regeren.”"
                            },
                            {
                                "example_id": "dae043de-62be-47a8-bd59-6bafcba8c08e",
                                "sense_id": "454f46c7-ca29-390c-9811-03891ce8b931",
                                "text": "Het moet een potje worden uit het vrijdag ter beschikking gestelde geld, voor snelle tijdelijke oplossingen in afwachting van structurele herstel- en compensatiemaatregelen, aldus GroenLinks. De partij denkt aan bijvoorbeeld „ouders die zo bang zijn dat hun huis instort dat zij hun kinderen niet meer thuis durven laten slapen”."
                            },
                            {
                                "example_id": "8236386f-95d1-4dca-bc91-dd8d9ee92440",
                                "sense_id": "454f46c7-ca29-390c-9811-03891ce8b931",
                                "text": "De toekomst van het dorp staat hevig ter discussie sinds voormalig minister Ed Nijpels constateerde dat het dorp de ontwikkeling van de haven in de weg zit. De gemeente is niet voor het idee om het dorp op te heffen, maar wil wel flink investeren in de leefbaarheid. De gemeente studeert bovendien op compensatiemaatregelen voor huizenbezitters. De plannen worden in april gepresenteerd."
                            }
                        ]
                    }
                ],
