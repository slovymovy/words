                ],
                "senses": [
                    {
                        "sense_id": "1c6d0e76-e91e-358c-8b89-84ba23b19e25",
                        "entry_id": "7fd7992e-0009-3f5d-94c1-f3e467f0ca7f",
                        "glosses": [
                            "металлический резервуар для измерения жидкостей методом налива и последующего слива"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c9e9b6b-6e43-4f30-b528-696f8f17bdf4",
                                "sense_id": "1c6d0e76-e91e-358c-8b89-84ba23b19e25",
                                "text": "В Сортировочном отделении для приёма спирта из цистерн имеются два мерника в 60 и 200 вёдер и третий — для спирта ретификационного отделения."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dd8487a-1502-3883-8eee-1c369ff354b3",
                        "entry_id": "7fd7992e-0009-3f5d-94c1-f3e467f0ca7f",
                        "glosses": [
                            "разг. мензурка, мерный стакан"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77b7be49-706a-4156-bc30-dd266c0470d6",
                                "sense_id": "2dd8487a-1502-3883-8eee-1c369ff354b3",
                                "text": "Если сделать лабораторный мерник с дном из фторопластовой перфорированной пленки, то не потребуется никаких делений на стенках сосуда."
                            }
                        ]
                    },
                    {
                        "sense_id": "157ae531-f096-3959-99fe-124d22108d1d",
                        "entry_id": "7fd7992e-0009-3f5d-94c1-f3e467f0ca7f",
                        "glosses": [
                            "истор. большая кадка, употреблявшаяся в XVI веке при закваске мёда и вмещавшая семь и более пудов жидкости."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94f04e3-6db0-449c-beaa-61c12be8f857",
                                "sense_id": "157ae531-f096-3959-99fe-124d22108d1d",
                                "text": "Боярский мёд отличался от обарного тем, что при рассычении мёда бралось медового сота в шесть раз больше, чем воды; он кис в мерниках неделю,"
                            }
                        ]
                    }
                ],
