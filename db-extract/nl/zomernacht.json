                "senses": [
                    {
                        "sense_id": "35d6cfda-e72f-3bbe-afa3-cde2403b315f",
                        "entry_id": "ec796dfe-f970-3966-bcae-fd2b2a05109d",
                        "glosses": [
                            "de uren van een dag tussen de nachtelijke uren en de middag, de ochtend van een dag in de zomer."
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "82fbcd9f-c233-433d-91ca-8f23cff09877",
                                "sense_id": "35d6cfda-e72f-3bbe-afa3-cde2403b315f",
                                "text": "Tijdens de frisse zomernacht maakten we een wandeling over het strand."
                            },
                            {
                                "example_id": "d3ec7da1-e059-45d8-a8c6-bc428277534c",
                                "sense_id": "35d6cfda-e72f-3bbe-afa3-cde2403b315f",
                                "text": "Geen enkel ander boek herinnerde ik me zo goed als dat, zelfs niet De kabouterkinderen met de afbeeldingen van de drie kleintjes die op de rug van de vleermuis door de noordse zomernacht reisden."
                            }
                        ]
                    },
                    {
                        "sense_id": "112347b5-6535-37ce-b1f2-8828f560b260",
                        "entry_id": "ec796dfe-f970-3966-bcae-fd2b2a05109d",
                        "glosses": [
                            "een nacht in juni, juli of augustus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc20a8b4-454c-408a-b30d-a616bbdd491c",
                        "source_entry_id": "ec796dfe-f970-3966-bcae-fd2b2a05109d",
                        "source_sense_id": "35d6cfda-e72f-3bbe-afa3-cde2403b315f",
                        "source_sense_description": "zomernacht",
                        "target_lang_word": "Sommernacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommernacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                        "entry_id": "7182cab2-501f-3cd7-8cf7-9783d85d5666",
                                        "glosses": [
                                            "eine Nacht im Sommer, der Zeitraum zwischen Abenddämmerung und Morgengrauen während der wärmsten Jahreszeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212f275f-9dc5-4518-97d1-667ffcd2fd3f",
                                                "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                                "text": "Sommernächten wohnt eine ganz eigene Magie inne."
                                            },
                                            {
                                                "example_id": "57976a82-9cfa-4562-81e3-8cc83dbd45d4",
                                                "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                                "text": "In dieser warmen, klaren Sommernacht legte er sich halbnackt auf den Balkon und beobachtete die Sterne."
                                            },
                                            {
                                                "example_id": "6ee1e9ec-22b1-478f-a7b5-72dd606eb623",
                                                "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                                "text": "Die Sommernacht senkte sich hernieder."
                                            },
                                            {
                                                "example_id": "ed4d5333-5adc-4a7d-8b98-61be5968a6f5",
                                                "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                                "text": "„Ich erinnere mich aus meiner Kindheit in Nordland einer seltsamen Nacht, einer stillen Sommernacht im Sonnenschein.“"
                                            },
                                            {
                                                "example_id": "06d649d9-e8d8-4449-b1a4-048b92ee03a6",
                                                "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                                "text": "„Sommernächte sind gut für Liebespaare.“"
                                            },
                                            {
                                                "example_id": "4529699f-7ebd-424a-926a-1e7291c8b496",
                                                "sense_id": "74dc1986-7c95-3c5a-b625-658a36fa2ea0",
                                                "text": "„Ein Bauernhof mit Torfdach ist nicht so, wie er in einer hellen Sommernacht im Juli von fern aussieht; nichts hat weniger mit einem Bauernhof zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
