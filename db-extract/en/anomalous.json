                                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                                        "glosses": [
                                            "ongewoon, bijzonder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52263b4c-b399-4455-8740-5c476a516e3a",
                                                "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                                "text": "Hij heeft een abnormaal grote interesse in alles wat met Napoleon te maken heeft."
                                            },
                                            {
                                                "example_id": "8b6a9d89-f9e6-4995-b71f-8d675995f0aa",
                                                "sense_id": "5fce4beb-f0fe-382d-a556-7d04b3abbc87",
                                                "text": "Elk geluid klonk abnormaal luid: het rammelen van haar sleutels, het zoemen van de koelkast, het blazen van Brontë."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                        "entry_id": "d521b521-949a-3b9f-a961-6374d83f4894",
                                        "glosses": [
                                            "licht gek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6cba79-d6b2-40b6-8658-e18556c90f20",
                                                "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                                "text": "Het meisje had altijd heel abnormale kleren aan, maar ze vond zichzelf heel bijzonder."
                                            },
                                            {
                                                "example_id": "66e5ffcb-aa26-4c0c-bb8c-123a9c30a82a",
                                                "sense_id": "f6b18452-2ce0-3f4c-9b15-88b7799e86d5",
                                                "text": "Ze verzachtte dat meteen: 'Ik bedoel niet dat er iets abnormaals aan was, alleen dat Adeline van mening leek te zijn dat de jongen exclusief van haar was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4722905b-17ef-440c-8620-65bf8dcbcbc6",
                        "source_entry_id": "093a59c7-bd8c-3ecb-9ea1-23808106fb7e",
                        "source_sense_description": "deviating from the normal",
                        "target_lang_word": "anormal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                        "entry_id": "a1240d0e-2ed7-3ce2-966f-263cf39a978e",
                                        "glosses": [
                                            "Qui est contraire aux règles qui paraissent régir son genre ou son espèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5eac26-585f-4f72-9cba-fe15c358e7a4",
                                                "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                                "text": "Les savants s’occupèrent de tout dans une paix profonde, depuis la végétation anormale d'un ognon de jacinthe jusqu'aux courants électriques."
                                            },
                                            {
                                                "example_id": "31a7c8fa-bf5e-4a2b-bc25-b47f785f9dc7",
                                                "sense_id": "9cea4a93-3bac-3c02-8172-c34068fed35f",
                                                "text": "L'inconscience règne parmi les autorités municipales qui ont laissé faire en fermant les yeux. Et ceux qui ont construit ou ont acheté ensuite sans s'interroger n'y ont rien vu d' anormal non plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                        "entry_id": "a1240d0e-2ed7-3ce2-966f-263cf39a978e",
                                        "glosses": [
                                            "Qui dépasse la mesure commune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659656f6-80d6-4d69-ba0c-e9fd1772bce7",
                                                "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                                "text": "Il n’est quand même pas anormal que la cellule interne qui s’occupe des violences sexuelles s’autosaisisse, quand elle est en copie, d’une lettre de suicide."
                                            },
                                            {
                                                "example_id": "e1720026-8c3c-478e-ad6e-0ffd8476feeb",
                                                "sense_id": "a888da64-0c92-324f-9ddc-1db65a2cf5f1",
                                                "text": "Ce n’est pas une simple question d’innovation technique, mais aussi une question de compréhension de l’organisation générale dans laquelle s’insère une telle définition d’un comportement anormal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                        "entry_id": "e39fe661-41e3-3723-92c4-aa606e8f8905",
                                        "glosses": [
                                            "Personne dont l’état ou le comportement n’est pas normal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528814da-f1a9-4fbf-9d6f-b986eec3825b",
                                                "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                                "text": "Un anormal."
                                            },
                                            {
                                                "example_id": "9f2d347d-a8d1-43c7-9511-bb6b84e78216",
                                                "sense_id": "15757827-8606-3317-8a7d-dd1841072048",
                                                "text": "Il se peut qu’un directeur qui a un anormal dans son école s’abstienne de le signaler."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anormal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf965f5b-c2c4-36e6-83b5-babd4b69f04e",
                                        "entry_id": "a27cbf9e-9c04-3e85-8fab-22d42b06f238",
                                        "glosses": [
                                            "Ce qui est contraire à la norme, à la règle habituelle ou commune."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3409415-3baf-4ffc-a90a-abd1bad6dad6",
                                                "sense_id": "cf965f5b-c2c4-36e6-83b5-babd4b69f04e",
                                                "text": "L’habitude est devenue ici une seconde nature. L’anormal est considéré ici comme le normal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
