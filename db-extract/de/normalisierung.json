                "senses": [
                    {
                        "sense_id": "d9acc1b9-2d20-3c87-9473-7bc2f2decf88",
                        "entry_id": "eaa1b27d-ea4d-3657-a41c-ab6602b7d2f9",
                        "glosses": [
                            "Vorgang, in dem etwas normal wird oder in einen normalen Zustand gebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0505b085-c408-4c5f-9e6d-d952def79b6a",
                                "sense_id": "d9acc1b9-2d20-3c87-9473-7bc2f2decf88",
                                "text": "Es wird noch lange dauern bis zu einer Normalisierung der Beziehungen zwischen Nord- und Südkorea."
                            },
                            {
                                "example_id": "7b2e6f87-4648-4d3b-bce8-37f8596a0c50",
                                "sense_id": "d9acc1b9-2d20-3c87-9473-7bc2f2decf88",
                                "text": "Wir sind auf dem besten Weg und können eine schrittweise Normalisierung konstatieren."
                            },
                            {
                                "example_id": "af1806d7-81d7-416a-b901-f9f76cc87031",
                                "sense_id": "d9acc1b9-2d20-3c87-9473-7bc2f2decf88",
                                "text": "Von Normalisierung kann hier keine Rede sein, die Fronten sind verhärtet wie eh und jeh."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37cbe8b4-bd09-3c6a-84be-fce12064c37e",
                        "entry_id": "eaa1b27d-ea4d-3657-a41c-ab6602b7d2f9",
                        "glosses": [
                            "Verfahren, das Redundanzen in relationalen Datenbanken schrittweise entfernt"
                        ],
                        "tags": [
                            "Datenbanken"
                        ],
                        "examples": [
                            {
                                "example_id": "2538956f-c694-4b2d-a024-c531c01a0a8f",
                                "sense_id": "37cbe8b4-bd09-3c6a-84be-fce12064c37e",
                                "text": "E.F. Codd, ehemals Forscher bei IBM, hat als erster das Konzept der Datenbank-Normalisierung in mehreren wichtigen Veröffentlichungen vorgestellt, die in den siebziger Jahren entstanden sind. Die Normalisierung erhöht die Klarheit des Datenmodells."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b10d3ba-87d8-4523-8d24-6e83c8d20e1d",
                        "source_entry_id": "eaa1b27d-ea4d-3657-a41c-ab6602b7d2f9",
                        "source_sense_id": "d9acc1b9-2d20-3c87-9473-7bc2f2decf88",
                        "source_sense_description": "Vorgang, in dem etwas normal wird oder in einen normalen Zustand gebracht wird",
                        "target_lang_word": "normalisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25d90ae5-02c8-3782-b55f-71a59126aeb3",
                                        "entry_id": "537d6fbf-cf85-3ab5-a266-cf8e0a2df0d2",
                                        "glosses": [
                                            "Action de normaliser, ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc866a2f-c95c-464b-8e81-e66f3569d805",
                                                "sense_id": "25d90ae5-02c8-3782-b55f-71a59126aeb3",
                                                "text": "La normalisation technique du type « normes ISO » a pris une importance considérable, pas uniquement en termes de quantité de normes produites, mais également quant au champ d’application de la normalisation. Celui-ci couvre désormais aussi bien les marchandises, les services, l’environnement, voire les responsabilités sociales des entreprises (ISO 26000) ou la lutte contre la corruption (ISO 37000). (...) En effet, la stratégie d’harmonisation « nouvelle approche », initiée dans les années 1980 par le président de la Commission européenne Jacques Delors, a placé la normalisation technique au cœur de la libre circulation des marchandises (le marquage « CE » que vous trouvez sur vos produits en témoigne) et a connu rapidement un succès manifeste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65bc7af-200f-3630-9774-482d85ff6ded",
                                        "entry_id": "537d6fbf-cf85-3ab5-a266-cf8e0a2df0d2",
                                        "glosses": [
                                            "Passage à la forme normale des entités d’une base de données."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd952ee-8120-49b3-bc45-c72305f0a1ef",
                                                "sense_id": "d65bc7af-200f-3630-9774-482d85ff6ded",
                                                "text": "Le but de la normalisation est d'avoir un \"bon\" modèle de données dans lequel les données seront bien organisées et consistantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aea0e1e2-a384-30b1-8e3b-99588cff41d8",
                                        "entry_id": "537d6fbf-cf85-3ab5-a266-cf8e0a2df0d2",
                                        "glosses": [
                                            "Aspect d’une politique linguistique consistant à normaliser l’usage d’une langue sur un territoire, à la rendre habituelle, à la mettre en avant dans sa variante normalisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d4c72a-702d-4bcf-995f-0d2c5fd54d02",
                                                "sense_id": "aea0e1e2-a384-30b1-8e3b-99588cff41d8",
                                                "text": "En fait, les langues connaissent au cours de leur vie une double tension entre une normalisation ou standardisation au cours de leur expansion et en même temps une tendance au fractionnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6ca4b2-7e6e-3cf4-bb18-a72a19e77c21",
                                        "entry_id": "537d6fbf-cf85-3ab5-a266-cf8e0a2df0d2",
                                        "glosses": [
                                            "Processus par lequel des comportements, des idées, des normes ou des pratiques sociales deviennent considérés comme « normaux » ou acceptables au sein d’une société ou d’un groupe social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236ca1fb-90ce-4dc7-b65f-ba47bbc6ff00",
                                                "sense_id": "6d6ca4b2-7e6e-3cf4-bb18-a72a19e77c21",
                                                "text": "Ainsi, la représentation sociale de la toxicomanie devient, en quelques années, plus clinique que morale, plus réalité vécue qu’infraction pénale. Cette transformation se repère dans les termes mêmes qui la véhiculent : dans le discours social actuel, le toxicomane est devenu usager de drogue. Il n’est plus délinquant mais malade. Ce qui traduit une espèce de « normalisation » de la conduite toxicomaniaque et la fin du toxicomane sauvage. L’ajustement social envisage aujourd’hui la légalisation du cannabis (plus ou moins sous prétexte thérapeutique)."
                                            },
                                            {
                                                "example_id": "89682d88-f480-477d-9e74-4a5d19ef5a5c",
                                                "sense_id": "6d6ca4b2-7e6e-3cf4-bb18-a72a19e77c21",
                                                "text": "Le fascisme-régime revêt quant à lui des accents conservateurs et traditionalistes. À partir de 1921, afin de parvenir au pouvoir, Mussolini passe un compromis avec les institutions et les forces sociopolitiques traditionnelles qui, de leur côté, espèrent utiliser le fascisme pour résoudre la crise italienne et misent sur sa normalisation."
                                            },
                                            {
                                                "example_id": "3e09cf38-8180-485d-8732-65ce7eaee3f7",
                                                "sense_id": "6d6ca4b2-7e6e-3cf4-bb18-a72a19e77c21",
                                                "text": "Aux États-Unis, l’organisation collective incluant communautés et personnes en soutien a permis de mettre en difficulté les expulsions massives commanditées par Trump. En France, les expulsions sont tout aussi expéditives et les centres de rétention en sont le sas. Nous pouvons lutter contre la normalisation de ces pratiques inhumaines, et les entreprises ont le choix d’être complices ou non."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d80cbbc-9dd5-3aad-84a9-edd7bed2bd6f",
                                        "entry_id": "537d6fbf-cf85-3ab5-a266-cf8e0a2df0d2",
                                        "glosses": [
                                            "Prescription ou recommandation d’un ensemble de règles pour le choix ou la représentation des toponymes, à appliquer au niveau régional, national ou international."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8175be47-871a-4345-aa52-4ed89d86bb05",
                        "source_entry_id": "eaa1b27d-ea4d-3657-a41c-ab6602b7d2f9",
                        "source_sense_id": "37cbe8b4-bd09-3c6a-84be-fce12064c37e",
                        "source_sense_description": "Informatik, Datenbanken: Verfahren, das Redundanzen in relationalen Datenbanken schrittweise entfernt",
                        "target_lang_word": "normalization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "normalization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba90b2e-197b-3056-966c-2ac4b3c3e5de",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "Any process that makes something more normal or regular, which typically means conforming to some regularity or rule, or returning from some state of abnormality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "396ee022-48ec-48fd-9520-526f7d4ff063",
                                                "sense_id": "2ba90b2e-197b-3056-966c-2ac4b3c3e5de",
                                                "text": "In the writings of Banfield, Wilson, and the New Progressives, the present-oriented, the wicked and the disorderly are portrayed as being abnormal―as being in need of normalization, control, and supervision. This makes it a lot easier for the rest of us […] to accept the aggressive policing and harsh punishment of the disorderly others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66da9ad-42df-3a58-b3d0-4166eec4e422",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "Standardization, act of imposing standards or norms or rules or regulations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4669bb80-ec60-3847-a125-609d919fcdd5",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "In relational database design, a process that breaks down data into record groups for efficient processing, by eliminating redundancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa296692-2c1a-46ee-bc20-1a045797e12c",
                                                "sense_id": "4669bb80-ec60-3847-a125-609d919fcdd5",
                                                "text": "Meronym: atomization"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c0454c-3141-3844-a7fe-e6c12e49cbb3",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "Process of establishing normal diplomatic relations between two countries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79142e1-d4e9-46d1-8798-36fde855614f",
                                                "sense_id": "52c0454c-3141-3844-a7fe-e6c12e49cbb3",
                                                "text": "Following the line pursued in recent months by President Mubarak, Mr. Ali said he was confident the peace treaty between the two former foes would presist^([sic]) and \"create a good atmosphere for normalizations of relations in the coming months and years.\""
                                            },
                                            {
                                                "example_id": "16f31bd0-6ea0-4824-b362-12a0981e8ac6",
                                                "sense_id": "52c0454c-3141-3844-a7fe-e6c12e49cbb3",
                                                "text": "On my first trip to China after normalization, I saw firsthand the possibility of leveraging Deng Xiaoping’s very real fear of the Soviets to gain specific intelligence aid from the People’s Republic of China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ed4ceac-9b42-33da-b60f-21e674e83e5d",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "Globalization, the process of making a worldwide normal and dominant model of production and consumption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "281648b1-6c63-34de-859d-20248bd0ac7b",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "Normalized production."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37e5e4af-397a-3bee-8dd2-c3800c50bcea",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "Sharing or enforcement of standard policies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5367ac1-1640-3582-ba54-837ad824f978",
                                        "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                                        "glosses": [
                                            "A process whereby artificial and unwanted norms of behaviour and models of behaviour are made to seem natural and wanted, through propaganda, influence, imitation and conformity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
