                        "glosses": [
                            "In a commensurate manner; so as to be equal or proportionate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faaebb3e-ca70-43fc-86db-55e99eef1881",
                                "sense_id": "00d4bd16-bb2d-342c-ab4d-934a400fcfb4",
                                "text": "Admiral Kurita has no identification charts for escort carriers, and so, assumes that the distant targets are fleet carriers. Commensurately, by scale, their escorts must either be battleships or cruisers. The Japanese forces therefore continue to load armor-piercing rounds, what will turn out to be a very fortuitous mistake for their targets for as long as it lasts."
                            },
                            {
                                "example_id": "d71b7ab3-d56b-4caf-9a19-4d5ea167f193",
                                "sense_id": "00d4bd16-bb2d-342c-ab4d-934a400fcfb4",
                                "text": "One thing heterofatalism reflects is a persistent lack of faith that those we desire will be able to recognize us as commensurately human."
                            }
                        ]
                    },
