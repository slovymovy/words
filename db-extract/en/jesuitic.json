                    {
                        "translation_id": "8b8f126d-cace-4804-b3af-d6e5799d1494",
                        "source_entry_id": "5b404cc0-c89e-364d-8b9f-39d35319e830",
                        "source_sense_description": "Translations",
                        "target_lang_word": "jesuita",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jesuita",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "378a5f47-f10e-317a-8675-e126e1ae8e1c",
                                        "entry_id": "79b51101-52b5-30a8-8410-7553e7140405",
                                        "glosses": [
                                            "Que pertenece o concierne a la orden religiosa católica Compañía de Jesús, orden fundada por San Ignacio de Loyola en 1534 y aprobada en 1540 por Pablo III."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6e5d12-2565-4fd6-89c2-a6f9c3c621f5",
                                                "sense_id": "378a5f47-f10e-317a-8675-e126e1ae8e1c",
                                                "text": "No sin causa los debe de haber dejado Su Majestad, y aunque volverá a ellos el segundo día de pascua, será de pascua para Aranjuez, yendo de camino a Alcalá a la dedicación de un colegio jesuita."
                                            },
                                            {
                                                "example_id": "97581e6b-a4f6-4f20-b9d5-3a74d0fb7fdc",
                                                "sense_id": "378a5f47-f10e-317a-8675-e126e1ae8e1c",
                                                "text": "‘¿Qué significa una larga temporada para Javier?’, se preguntó Max leyendo la carta que llevaba el sello de la orden jesuita en un extremo."
                                            },
                                            {
                                                "example_id": "704564e7-d744-4598-b31f-7f50cce3abbb",
                                                "sense_id": "378a5f47-f10e-317a-8675-e126e1ae8e1c",
                                                "text": "Los jesuitas —dice Scribener— supieron tomar venganza por la traición practicada con ellos, burlando la avaricia. Por eso se cree que hay fabulosas riquezas enterradas en San Pedro […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4385a864-c162-33af-8544-b5a9723c7ac8",
                                        "entry_id": "79b51101-52b5-30a8-8410-7553e7140405",
                                        "glosses": [
                                            "Que actúa con hipocresía."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed641fe5-a9cc-4af5-a00c-8e112779e595",
                                                "sense_id": "4385a864-c162-33af-8544-b5a9723c7ac8",
                                                "text": "Callate la boca, hipócrita. Buena jesuita sos vos… tisicona del diablo…."
                                            },
                                            {
                                                "example_id": "ffc1c5d5-1cba-49cd-9276-01bd3d8ee8ee",
                                                "sense_id": "4385a864-c162-33af-8544-b5a9723c7ac8",
                                                "text": "Por las mañanas al asistir a las clases de la Escuela de Bellas Artes, se indignaba contra sus compañeros, chiquillería irrespetuosa, educada en la calle, hijos de menestrales, que, apenas volvía la espalda el profesor, se bombardeaban con las migas del pan destinado a borrar los dibujos y execraban a don Rafael, llamándole ‘beato’ y ‘jesuita’."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "jesuita",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b40a6c22-68d4-339e-8f09-e420f24e4a4d",
                                        "entry_id": "288d7e22-598b-3dd3-9c7c-a76bfe5196df",
                                        "glosses": [
                                            "Miembro de la Compañía de Jesús₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183b53d9-e735-4a5e-a1e5-d2c188a1b809",
                                                "sense_id": "b40a6c22-68d4-339e-8f09-e420f24e4a4d",
                                                "text": "Acabé yo mis estudios de gramática, como refiero en la principal historia, con mucho disgusto de mis padres, y no poco de los Padres de la Compañía y mío, que querían fuese jesuita."
                                            },
                                            {
                                                "example_id": "9458249f-d5dd-4453-ac63-88d4340b2fc2",
                                                "sense_id": "b40a6c22-68d4-339e-8f09-e420f24e4a4d",
                                                "text": "Vacante Málaga en 1630, por muerte del cardenal Trejo, el rey propuso al entrometido jesuita Hernando de Salazar ‘con 24.000 ducados de pensión para el cardenal de Saboya, mi primo’."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8062f19d-8d42-3b46-9235-2f7522b47432",
                                        "entry_id": "288d7e22-598b-3dd3-9c7c-a76bfe5196df",
                                        "glosses": [
                                            "Bollo de masa de hojaldre relleno de jamón dulce y queso."
                                        ],
                                        "tags": [
                                            "Uruguay"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
