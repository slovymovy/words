                        "sense_id": "1405f0a7-10c2-31b1-b896-819659cbd72e",
                        "entry_id": "f4336de6-c4f5-3961-8313-14995c997bce",
                        "glosses": [
                            "zitmeubel voor één persoon, waarvan de zitting om een verticale as kan draaien vooral in gebruik in kantoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec14371-e4e2-44e5-a4cb-f0ed85ee025c",
                                "sense_id": "1405f0a7-10c2-31b1-b896-819659cbd72e",
                                "text": "Toen het gesprek geëindigd was bleef hij nog een tijdje achterovergeleund in zijn draaistoel zitten, de handen gevouwen op zijn vest met de vulpennen."
                            },
                            {
                                "example_id": "32821915-df8d-448a-97ba-ccf276b154f9",
                                "sense_id": "1405f0a7-10c2-31b1-b896-819659cbd72e",
                                "text": "In de draaistoel, achter het tafeltje met de telefoontoestellen, de drukknopjes en de microfoon zat monsieur Jacquard, de man met de zwarte hoornen bril, het borstelige haar en de rossige snor."
                            }
                        ]
                    },
                    {
                        "sense_id": "b691c900-2503-37c9-8081-59b72ec74b4c",
                        "entry_id": "f4336de6-c4f5-3961-8313-14995c997bce",
                        "glosses": [
                            "kleine draaibank in de fijnmechanica"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4e11be16-383f-44fd-8a59-06a64ff1dbaa",
                                "sense_id": "b691c900-2503-37c9-8081-59b72ec74b4c",
                                "text": "⧖ (…) men gebruikt ze als boren op de draaibank, kleine zelfs op den draaistoel der horlogemakers."
                            }
                        ]
                    }
                ],
