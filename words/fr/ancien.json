{
    "word_family": [
        "anciennement",
        "ancienneté"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bbc30785-7d38-3242-b9d6-eacd1d22f434",
                    "sense_definition": "Qui existe depuis longtemps, qui n'est pas récent ou neuf.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une maison <w>ancienne</w> au centre du village."
                        },
                        {
                            "text": "Ce pont très <w>ancien</w> traverse la rivière depuis plusieurs siècles."
                        }
                    ],
                    "synonyms": [
                        "antique",
                        "séculaire",
                        "vieux"
                    ],
                    "antonyms": [
                        "moderne",
                        "neuf",
                        "récent"
                    ],
                    "common_phrases": [
                        "maison ancienne",
                        "bâtiment ancien"
                    ]
                },
                {
                    "sense_id": "f1e4c971-0341-3339-a64e-443f6a3d3331",
                    "sense_definition": "Qui occupait auparavant une fonction ou une situation qu'il n'a plus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "statut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai croisé un <w>ancien</w> collègue de travail dans le train ce matin."
                        },
                        {
                            "text": "L'<w>ancien</w> président de l'association a prononcé un discours très émouvant."
                        }
                    ],
                    "antonyms": [
                        "actuel",
                        "nouveau"
                    ],
                    "common_phrases": [
                        "ancien collègue",
                        "ancien président",
                        "ancien élève"
                    ]
                },
                {
                    "sense_id": "9b77e1f9-5eb6-3525-be42-3e9d3817bd9c",
                    "sense_definition": "Qui appartient à une époque historique lointaine, notamment l'Antiquité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les professeurs étudient les textes en grec <w>ancien</w> avec leurs étudiants."
                        },
                        {
                            "text": "Dans l'Égypte <w>ancienne</w>, les pharaons faisaient construire de vastes tombeaux."
                        }
                    ],
                    "synonyms": [
                        "antique",
                        "reculé"
                    ],
                    "antonyms": [
                        "contemporain",
                        "moderne"
                    ],
                    "common_phrases": [
                        "grec ancien",
                        "Égypte ancienne"
                    ]
                },
                {
                    "sense_id": "5e8ea7ce-efd5-3aa6-8daa-44e45cbce02e",
                    "sense_definition": "Employé comme épithète pour distinguer un personnage historique d'un successeur ou parent portant le même nom.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "statut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pline l'<w>Ancien</w> est l'auteur d'une monumentale histoire naturelle."
                        },
                        {
                            "text": "Cette citation est souvent attribuée à Caton l'<w>Ancien</w>."
                        }
                    ],
                    "antonyms": [
                        "jeune"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bb750a0-9f27-30d2-af55-f4cb4f9059fc",
                    "sense_definition": "Personne qui appartient à une institution, une collectivité ou une entreprise depuis plus longtemps que d'autres, ou qui en a fait partie dans le passé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette entreprise, les <w>anciens</w> conseillent souvent les nouvelles recrues."
                        },
                        {
                            "text": "L'association regroupe les <w>anciens</w> de cette grande école d'ingénieurs."
                        }
                    ],
                    "synonyms": [
                        "aîné",
                        "doyen"
                    ],
                    "antonyms": [
                        "nouveau"
                    ],
                    "common_phrases": [
                        "anciens de l'école"
                    ]
                },
                {
                    "sense_id": "347b43a0-ba57-3ff4-aff7-1d7508b128fb",
                    "sense_definition": "Personne d'un âge avancé ; vieillard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans de nombreuses cultures, les <w>anciens</w> jouissent d'un grand respect."
                        },
                        {
                            "text": "Les décisions du village étaient autrefois soumises à la sagesse des <w>anciens</w>."
                        }
                    ],
                    "synonyms": [
                        "aîné"
                    ],
                    "antonyms": [
                        "jeune"
                    ],
                    "common_phrases": [
                        "conseil des anciens"
                    ]
                },
                {
                    "sense_id": "7373acb4-1e10-32bb-bf85-abf00f52c8b5",
                    "sense_definition": "Les peuples, philosophes ou écrivains des temps antiques, par opposition aux modernes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>anciens</w> croyaient que la Terre occupait le centre exact de l'univers."
                        },
                        {
                            "text": "Ce professeur consacre ses recherches aux écrits des grands <w>anciens</w>."
                        }
                    ],
                    "antonyms": [
                        "moderne"
                    ],
                    "common_phrases": [
                        "querelle des anciens et des modernes"
                    ]
                },
                {
                    "sense_id": "24fafb34-1647-31d5-9289-8e75b658bbc9",
                    "sense_definition": "Ce qui a déjà servi, ce qui n'est pas neuf (notamment en matière de biens immobiliers ou de commerce).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont préféré investir dans l'<w>ancien</w> plutôt que d'acheter un appartement neuf."
                        },
                        {
                            "text": "Le prix du mètre carré dans l'<w>ancien</w> a augmenté dans ce quartier."
                        }
                    ],
                    "antonyms": [
                        "neuf"
                    ],
                    "common_phrases": [
                        "dans l'ancien"
                    ]
                }
            ]
        }
    ]
}