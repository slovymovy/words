                                "target_senses": [
                                    {
                                        "sense_id": "6f0b412e-f050-3280-a571-425d4a3d7b00",
                                        "entry_id": "a114f1d1-acce-3df3-858c-72696cdd5034",
                                        "glosses": [
                                            "A person who breeds or trains hawks or other birds of prey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b4df1d-a016-43a6-bdef-d0d177864063",
                                                "sense_id": "6f0b412e-f050-3280-a571-425d4a3d7b00",
                                                "text": "And to add force to his remonstrances, he conferred a cuff or two on the negligent attendant of the hawks, who, shouting rather louder than was necessary under all the circumstances, brought the master falconer to his assistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b951b31e-0906-3d90-b53f-74eb576ea382",
                                        "entry_id": "a114f1d1-acce-3df3-858c-72696cdd5034",
                                        "glosses": [
                                            "One who follows the sport of fowling with hawks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74ae49a1-e51c-4af2-bbe3-49178c995053",
                        "source_entry_id": "05927590-f55a-3922-bb2a-1e9a6a7bc6ef",
