                        "source_sense_id": "ed8601ea-2163-31a2-b902-611bbfec19fc",
                        "source_sense_description": "Untersuchung von archäologischen Funden mit naturwissenschaftlichen Methoden und Verfahren",
                        "target_lang_word": "archéométrie",
