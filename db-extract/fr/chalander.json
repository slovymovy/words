                        "glosses": [
                            "Être exploitées à tour de rôle par les propriétaires, en parlant de différentes parties d’une terre en indivision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a1e8a2-df20-4754-9479-ac66d2092c0f",
                                "sense_id": "123f9c14-f2fe-3651-be3e-7865809d6fdf",
                                "text": "De même on voit huit soitures du seigneur de Genlis chalander avec huit soitures du seigneur de Magny-sur-Tille."
                            },
                            {
                                "example_id": "d61b83b0-f422-4d9a-bdce-6540eea28608",
                                "sense_id": "123f9c14-f2fe-3651-be3e-7865809d6fdf",
                                "text": "L’autre pré est signalé chalandant avec le premier, dans la reconnaissance du seigneur de Rouvray (Ibid., t° 128)"
                            },
                            {
                                "example_id": "8566ffc5-1579-488e-b4ef-560e8b202d13",
                                "sense_id": "123f9c14-f2fe-3651-be3e-7865809d6fdf",
                                "text": "D’ailleurs l’origine patrimoniale des biens qui chalandent se traduit souvent par la similitude des noms des co-possesseurs."
                            },
                            {
                                "example_id": "4ccb64d6-ea87-41b3-94b9-6ea01f0482dc",
                                "sense_id": "123f9c14-f2fe-3651-be3e-7865809d6fdf",
                                "text": "Bien des parcelles qui chalandent peuvent provenir d’un héritage et l’indivision a pu favoriser ce système."
                            }
                        ]
                    }
