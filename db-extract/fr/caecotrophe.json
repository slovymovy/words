                "senses": [
                    {
                        "sense_id": "bcfe2be7-bdd1-34ab-a8f0-63401e660b64",
                        "entry_id": "1ba0b32e-6015-32f2-9198-d4dad46cb008",
                        "glosses": [
                            "Réingérant certains déchets, pour des rongeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c95c8a-3f27-4f23-8c80-613b35c2a605",
                                "sense_id": "bcfe2be7-bdd1-34ab-a8f0-63401e660b64",
                                "text": "On dit que le lapin est caecotrophe et non pas scatophage ou coprophage."
                            },
                            {
                                "example_id": "556b40da-dd6c-45b8-a66b-c380770227cc",
                                "sense_id": "bcfe2be7-bdd1-34ab-a8f0-63401e660b64",
                                "text": "Comme le lapin, le castor est caecotrophe : il réingère les premières crottes qu’il a produites pour en achever la digestion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26fa4e4e-f6c6-4a36-b38b-a8a64822096b",
                        "source_entry_id": "1ba0b32e-6015-32f2-9198-d4dad46cb008",
                        "source_sense_id": "bcfe2be7-bdd1-34ab-a8f0-63401e660b64",
                        "target_lang_word": "caecotroph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caecotroph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c769f942-851e-3a9f-b045-f8fd67378615",
                                        "entry_id": "6477e5a7-5303-3086-80d2-9692d4e7a7a5",
                                        "glosses": [
                                            "In certain mammals, especially rabbits and some rodents, a cake or pellet of food which is produced by means of digestion and expulsion through the anus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0977655d-c090-4d0f-ad7f-d7342002ae22",
                                                "sense_id": "c769f942-851e-3a9f-b045-f8fd67378615",
                                                "text": "Vocalizations include food recruitment calls, high-pitched contact and aggressive chirps, a mating call, a toilet-assembly call, and vocalizations specific to pups, such as squawks when pups are stepped on and caecotroph-solicitation chirps."
                                            },
                                            {
                                                "example_id": "bac5c2f8-a005-4ea6-a6f4-c15464fda906",
                                                "sense_id": "c769f942-851e-3a9f-b045-f8fd67378615",
                                                "text": "He finds the caecotrophs revolting, consisting as they do of semi-digested herbage, discharged through the anus and reswallowed two or three times a week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
