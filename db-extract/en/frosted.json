                                                "example_id": "4fcccb58-e9fe-4b34-bba1-d58e05397945",
                                                "sense_id": "a4e59c0d-6206-38ea-abc0-ca66eaab4abc",
                                                "text": "„1630 war der Höhepunkt der kleinen Eiszeit, Schnee im Juni, erfrorenes Getreide, Missernten.“"
                                            },
                                            {
                                                "example_id": "b402f6ce-d9b6-4718-95a3-f3544c68e6f9",
                                                "sense_id": "a4e59c0d-6206-38ea-abc0-ca66eaab4abc",
                                                "text": "„Am 9. September 1302 erfroren die Weinstöcke im Elsass. Es folgte ein strenger Winter. Am 2. Mai 1303 standen in Deutschland die Bauern vor ihrem erfrorenen Saatgut. Noch ahnten sie nicht, wie hart die Zeiten werden sollten – die Kleine Eiszeit hatte begonnen.“"
                                            }
