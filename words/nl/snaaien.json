{
    "word_family": [
        "snaai",
        "snaaier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73da133e-dd7b-3a01-a077-c2b0468f6de1",
                    "sense_definition": "Tussendoor iets lekkers eten of snoepen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb de hele middag zitten <w>snaaien</w> in de keuken.",
                            "target_lang_translations": {
                                "en": "I have been <w>snacking</w> in the kitchen all afternoon."
                            }
                        },
                        {
                            "text": "Probeer niet te veel te <w>snaaien</w> voor het avondeten.",
                            "target_lang_translations": {
                                "en": "Try not to <w>snack</w> too much before dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "snoepen",
                        "snacken"
                    ],
                    "common_phrases": [
                        "lekker snaaien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To eat snacks or sweets between meals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snack",
                                "target_lang_sense_clarification": "General term for eating small amounts of food between meals."
                            },
                            {
                                "target_lang_word": "to nibble",
                                "target_lang_sense_clarification": "Eating small amounts of food, often sweets or snacks, in a casual way."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9250a8ed-f58e-375c-827a-48b9ddd927d1",
                    "sense_definition": "Iets stiekem of snel wegnemen; pikken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde een appel te <w>snaaien</w> van de markt.",
                            "target_lang_translations": {
                                "en": "He tried to <w>snatch</w> an apple from the market."
                            }
                        },
                        {
                            "text": "De dief wist de tas te <w>snaaien</w> en rende weg.",
                            "target_lang_translations": {
                                "en": "The thief managed to <w>snatch</w> the bag and ran away."
                            }
                        }
                    ],
                    "synonyms": [
                        "pikken",
                        "stelen",
                        "gappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informeel en soms negatief geladen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To take something quickly or secretly; to pilfer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snatch",
                                "target_lang_sense_clarification": "To take something quickly and often forcefully."
                            },
                            {
                                "target_lang_word": "to pilfer",
                                "target_lang_sense_clarification": "To steal small items, often in a sneaky or opportunistic way."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}