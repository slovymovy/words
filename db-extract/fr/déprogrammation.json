                "senses": [
                    {
                        "sense_id": "f525bb13-8f7d-3407-b886-75acc8aa3159",
                        "entry_id": "1a97c4d8-14d3-3843-aa92-4e081e6ac800",
                        "glosses": [
                            "Action de déprogrammer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c08b190-7e49-48a0-89ee-c6b35d074d87",
                                "sense_id": "f525bb13-8f7d-3407-b886-75acc8aa3159",
                                "text": "Ceci suggère donc des mécanismes moléculaires communs entre cette réactivation et la déprogrammation de l’expression des gènes."
                            },
                            {
                                "example_id": "efefeda8-51ac-4f6c-8a4e-e3f2922e98be",
                                "sense_id": "f525bb13-8f7d-3407-b886-75acc8aa3159",
                                "text": "Le collectif Informer n’est pas un délit, qui regroupe une cinquantaine de journalistes ainsi que l’association Reporters sans frontières, s’interroge sur la censure et la déprogrammation de pas moins de quatre documentaires qui devaient être diffusés par la chaîne Canal+, dont Vincent Bolloré est devenu le principal actionnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56f6a041-c567-4f61-a95a-3f0d20895cee",
                        "source_entry_id": "1a97c4d8-14d3-3843-aa92-4e081e6ac800",
                        "source_sense_id": "f525bb13-8f7d-3407-b886-75acc8aa3159",
