                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619cfcdf-80b9-4ff8-82ff-55a242261d09",
                                                "sense_id": "3af2d6b6-c12f-35a8-a22a-167146f8c558",
                                                "text": "Overigens stelt het college zich met de voorgenomen halvering voor een enorme en misschien wel onrealistische opgave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
