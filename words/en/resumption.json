{
    "word_family": [
        "resume"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e6bccb9-248c-385d-b58a-d6226bbc6558",
                    "sense_definition": "The act of starting something again after a pause or interruption.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>resumption</w> of the peace talks is scheduled for next Monday after a long break.",
                            "target_lang_translations": {
                                "ru": "<w>Возобновление</w> мирных переговоров запланировано на следующий понедельник после долгого перерыва."
                            }
                        },
                        {
                            "text": "The referee signaled the <w>resumption</w> of play immediately after the rain stopped.",
                            "target_lang_translations": {
                                "ru": "Судья дал сигнал к <w>возобновлению</w> игры сразу после того, как дождь прекратился."
                            }
                        }
                    ],
                    "synonyms": [
                        "restart"
                    ],
                    "antonyms": [
                        "suspension",
                        "interruption",
                        "cessation"
                    ],
                    "common_phrases": [
                        "resumption of play",
                        "resumption of talks",
                        "resumption of work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт начала чего-либо снова после паузы или перерыва."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возобновление",
                                "target_lang_sense_clarification": "процесса, переговоров или игры"
                            },
                            {
                                "target_lang_word": "продолжение",
                                "target_lang_sense_clarification": "после перерыва"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60b71274-59a4-3a65-8d46-620e9374a70c",
                    "sense_definition": "The legal right of a government to take private property for public use, also known as eminent domain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government exercised its power of <w>resumption</w> to acquire the land needed for the new highway.",
                            "target_lang_translations": {
                                "ru": "Правительство воспользовалось своим правом на <w>отчуждение</w> собственности, чтобы приобрести землю, необходимую для нового шоссе."
                            }
                        },
                        {
                            "text": "The property owners were compensated fairly following the <w>resumption</w> of their land by the state.",
                            "target_lang_translations": {
                                "ru": "Владельцы недвижимости получили справедливую компенсацию после <w>изъятия</w> их земли государством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "power of resumption",
                        "land resumption"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законное право правительства изымать частную собственность для общественного пользования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждение",
                                "target_lang_sense_clarification": "имущества государством"
                            },
                            {
                                "target_lang_word": "изъятие",
                                "target_lang_sense_clarification": "земельного участка или собственности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}