                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81b73d17-02a0-411d-b7d9-3ef08ada7044",
                        "source_entry_id": "2302f7e0-5fa4-3eed-bc70-4082a8283f9a",
                        "source_sense_id": "c9cdd77b-f49d-32f2-92ae-74380b85145e",
                        "target_lang_word": "skalar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skalar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc7cd23-3a81-3b49-922f-c5126dd24490",
                                        "entry_id": "e7beed4a-e69b-3802-a647-cecc25bbb793",
                                        "glosses": [
                                            "durch eine lediglich eindimensionale Angabe bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608c69ff-6c5c-4168-a37b-84bc798ee187",
                                                "sense_id": "2bc7cd23-3a81-3b49-922f-c5126dd24490",
                                                "text": "„Der Betrag eines Vektors ist eine skalare Größe und kann positiv, negativ oder gleich null sein.“"
                                            },
                                            {
                                                "example_id": "9d3b15cc-00cb-45a4-9419-683eadb08ca3",
                                                "sense_id": "2bc7cd23-3a81-3b49-922f-c5126dd24490",
                                                "text": "„Aber auch hier eröffnet die skalare Betrachtungsweise einen Ausweg.“"
                                            },
                                            {
                                                "example_id": "9b095238-810c-4a32-b313-f8ef00b396ba",
                                                "sense_id": "2bc7cd23-3a81-3b49-922f-c5126dd24490",
                                                "text": "„Dieser Polarisierung des Konjugationssystems im Deutschen wird exemplarisch das Westfriesische gegenübergestellt, das eines der skalarsten Systeme in der Germania entwickelt hat.“"
                                            },
                                            {
                                                "example_id": "dfe19361-b172-441a-8186-325ba4a27d67",
                                                "sense_id": "2bc7cd23-3a81-3b49-922f-c5126dd24490",
                                                "text": "„Die meisten anderen germ. Standardsprachen und Substandardvarietäten des Deutschen haben im Vergleich dazu skalarere Systeme entwickelt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
