                        "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                        "entry_id": "df887141-7dd4-34c9-8c15-5d4bc14d180f",
                        "glosses": [
                            "With syrup."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f21129-3eaf-4c68-873e-9877d3bb858d",
                                "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                                "text": "By eleven o’clock that morning we had fed hot, buttered, “syruped” waffles to a hungry hundred, so we treated ourselves to a little similar nourishment, a small celebration, you may call it, for having raised our share for the Social Service Fund."
                            },
                            {
                                "example_id": "e1525a2f-5719-42af-9dcc-caab8437ac13",
                                "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                                "text": "Mickey Kevin reported this important news as he chewed gooey, heavily syruped wads of toast."
                            },
                            {
                                "example_id": "e57b61dd-7a21-4997-a405-c398cea0193b",
                                "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                                "text": "In the house there is beer, there is good beer, / There are sweet beer and syruped cakes, (stretching) as far as the reed fence."
                            },
                            {
                                "example_id": "3497de84-8280-4e65-a91d-5e7cc294db6f",
                                "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                                "text": "After she’d seen Ronelle out the door, she fixed a tray for Molly. It was fun, making it up. A nice hot mug of coffee, a steaming stack of buttered, syruped pancakes."
                            },
                            {
                                "example_id": "120588b0-a01a-464f-8803-f22378c84bcf",
                                "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                                "text": "Mandelbaum had no teeth at all, his gums alone crunching peanuts and even Mame’s taygluch – syruped doughnuts baked candy hard – while he winked at Isaac, making him giggle."
                            },
                            {
                                "example_id": "3b40087b-5b7f-46f6-b8fb-ccc48aab8592",
                                "sense_id": "0d1c8497-7f6a-3ae3-a189-60f878a041d6",
                                "text": "He brought a big silver plate with a heap of 28 syruped cakes […]"
                            }
                        ]
                    }
