                "senses": [
                    {
                        "sense_id": "333b02e7-3e37-3326-b417-73b04433a176",
                        "entry_id": "b2407178-4173-330b-aacb-923056ae3ef6",
                        "glosses": [
                            "nach dem Bonner Phonetiker Paul Menzerath und dem Bochumer Quantitativen Linguisten Gabriel Altmann benanntes Sprachgesetz, das die Abhängigkeit der Größe der Bestandteile (Konstituenten) einer sprachlichen Einheit von der Größe dieser Einheit bestimmt"
                        ],
                        "tags": [
                            "Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "e2f686f0-16f5-471f-a1de-2b70d85e46e2",
                                "sense_id": "333b02e7-3e37-3326-b417-73b04433a176",
                                "text": "„Dieses Sprachgesetz ist daher auch verbreitet als Menzerath-Altmann-Gesetz bekannt.“."
                            },
                            {
                                "example_id": "81b412ba-85fa-4d74-ad85-c6307881b43f",
                                "sense_id": "333b02e7-3e37-3326-b417-73b04433a176",
                                "text": "„Die entsprechende mathematische Funktion, …, die auch die Hauptform des Menzerath-Altmann-Gesetzes ist, (…) wurde mit Hilfe eines Regressionsverfahrens an geeignete Daten angepaßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
