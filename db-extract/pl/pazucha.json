                "translations": [
                    {
                        "translation_id": "a4cbc42b-ec30-46ab-b9d1-3f8abb1718f3",
                        "source_entry_id": "9dfc400b-72ee-3e02-a51f-09d830051bab",
                        "source_sense_id": "6b36f086-6b06-31f3-8c56-034dabe1ed5f",
                        "target_lang_word": "bosom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bosom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f388248-9a93-3b8f-884a-642aab916f13",
                                        "entry_id": "af6841a9-1ecf-31c7-84d1-dcb1a7693cc8",
                                        "glosses": [
                                            "In a very close relationship."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab05715b-bab2-4a44-9549-51ab66523991",
                                                "sense_id": "8f388248-9a93-3b8f-884a-642aab916f13",
                                                "text": "bosom buddies"
                                            },
                                            {
                                                "example_id": "f5b1cf44-6433-4ee4-8082-2dca8b20659b",
                                                "sense_id": "8f388248-9a93-3b8f-884a-642aab916f13",
                                                "text": "Lieut. Creecy of the navy, who has been detailed to the aerial experiments at the fort, and who was a bosom companion of young Selfridge, was brokenhearted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bosom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06660090-4f14-39ba-8ada-2efc1afeeff3",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "The breast or chest of a human (or sometimes of another animal)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329287f0-1e80-414d-96f1-6a4b61e0eee2",
                                                "sense_id": "06660090-4f14-39ba-8ada-2efc1afeeff3",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes.[…]She put back a truant curl from her forehead where it had sought egress to the world, and looked him full in the face now, drawing a deep breath which caused the round of her bosom to lift the lace at her throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90c20e6c-1a4b-3f98-8b71-8377f71f62b5",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "The seat of one's inner thoughts, feelings, etc.; one's secret feelings; desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8dc1d6-80cd-4b47-a68a-7a349ba99fc8",
                                                "sense_id": "90c20e6c-1a4b-3f98-8b71-8377f71f62b5",
                                                "text": "my poor dear duke[…], in consequence of the excitement created in his august bosom by her frantic violence and grief, had a fit in which I very nigh lost him."
                                            },
                                            {
                                                "example_id": "bd90eda2-4429-4af8-a983-bdff749cbab9",
                                                "sense_id": "90c20e6c-1a4b-3f98-8b71-8377f71f62b5",
                                                "text": "His uncle, a Cardinal, engages a Spanish youth of Moorish descent called Diego, an expert singer and player on the virginal,[…]to cleanse his bosom of the perilous stuff, and cure him by the spell of his music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "717be032-575d-3e32-b75f-08d7e197f0e4",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "The protected interior or inner part of something; the area enclosed as by an embrace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d0d91e-ec04-4c90-8d4b-79170a50cb9d",
                                                "sense_id": "717be032-575d-3e32-b75f-08d7e197f0e4",
                                                "text": "… Mr Toodle … was refreshing himself with tea in the bosom of his family."
                                            },
                                            {
                                                "example_id": "9471675f-675e-4ef9-b55c-23cbb25d7379",
                                                "sense_id": "717be032-575d-3e32-b75f-08d7e197f0e4",
                                                "text": "there might be seen in districts far away among the lanes, or deep in the bosom of the hills, certain pallid undersized men, who, by the side of the brawny country-folk, looked like the remnants of a disinherited race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c515f27d-6fdd-3692-b72c-b95d60ff20e8",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "The part of a dress etc. covering the chest; a neckline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0bec96-17ba-4045-b0cb-c42108006c25",
                                                "sense_id": "c515f27d-6fdd-3692-b72c-b95d60ff20e8",
                                                "text": "And he put his hand into his boſome: and when hee tooke it out, behold, his hand was leprous as ſnowe."
                                            },
                                            {
                                                "example_id": "572ffe20-415e-4994-9255-c20be87e7226",
                                                "sense_id": "c515f27d-6fdd-3692-b72c-b95d60ff20e8",
                                                "text": "She was always in a fearful hurry, and the lower the bosom was cut the more it was to be gathered she was wanted elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418e1790-a1ab-304a-82c5-501779a0be7a",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "A breast, one of a woman's breasts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70756ea5-f1b1-46e8-b670-bf3b27ef785b",
                                                "sense_id": "418e1790-a1ab-304a-82c5-501779a0be7a",
                                                "text": "I dont [sic] know that her bosoms were fuller than usual."
                                            },
                                            {
                                                "example_id": "17461fe4-6b43-48b7-aadf-8dc6090e1690",
                                                "sense_id": "418e1790-a1ab-304a-82c5-501779a0be7a",
                                                "text": "The prevailing look at Aintree was of a well-upholstered woman wearing an outfit about three sizes too small for her; trouser suits so tight you could not only tell if the lady had a coin in her pocket but see if it was heads or tails, and skimpy tops proclaiming proudly that bosoms are back—and this time it's personal."
                                            },
                                            {
                                                "example_id": "52deb819-8629-47cf-9ca9-fc093bf76bc0",
                                                "sense_id": "418e1790-a1ab-304a-82c5-501779a0be7a",
                                                "text": "The baby was crammed against one of her bosoms. He was meant to be sucking milk out of it. The other bosom was hanging down, with a funny long red blob on the end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae4f8d3-f9c3-36fe-b2af-c301895ae1e6",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "Any thing or place resembling the breast; a supporting surface; an inner recess; the interior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ef74d1-7ed6-480e-8398-a8b5daf80c03",
                                                "sense_id": "2ae4f8d3-f9c3-36fe-b2af-c301895ae1e6",
                                                "text": "I observed, indeed, that the present war had filled the church with many of these uninhabited monuments, which had been erected to the memory of persons whose bodies were perhaps buried in the plains of Blenheim, or in the bosom of the ocean."
                                            },
                                            {
                                                "example_id": "efd21485-8c04-405a-9c0d-22c3ee736397",
                                                "sense_id": "2ae4f8d3-f9c3-36fe-b2af-c301895ae1e6",
                                                "text": "The appointed place was on the edge of a deep, rocky ravine, down in whose dark bosom brawled and foamed a little mountain torrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5be91e21-a998-370b-997d-9e0d548cc8c0",
                                        "entry_id": "5d1eb76f-3e56-3db9-9c56-be4bd51809d0",
                                        "glosses": [
                                            "A depression round the eye of a millstone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "013abb74-dfca-40fd-b434-6dfb5f26ac69",
                                                "sense_id": "5be91e21-a998-370b-997d-9e0d548cc8c0",
                                                "text": "The bosom of the mill-stone is a central depression, and the staff is adjustable to test the symmetry of the concavity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bosom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8208aa69-ff8c-3610-9deb-a7ee1818fffc",
                                        "entry_id": "e0fa4099-1305-3768-ba87-f5d0007c9280",
                                        "glosses": [
                                            "To enclose or carry in the bosom; to keep with care; to take to heart; to cherish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38d2629-2942-4b2f-8455-0423a8430bbe",
                                                "sense_id": "8208aa69-ff8c-3610-9deb-a7ee1818fffc",
                                                "text": "Bosom up my counsel,\nYou’ll find it wholesome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1593d179-9b60-3378-8014-732b49dfb987",
                                        "entry_id": "e0fa4099-1305-3768-ba87-f5d0007c9280",
                                        "glosses": [
                                            "To conceal; to hide from view; to embosom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44c5feb-6681-4760-baaa-3dc8ea009de9",
                                                "sense_id": "1593d179-9b60-3378-8014-732b49dfb987",
                                                "text": "To happy Convents bosom’d deep in Vines,\nWhere slumber Abbots, purple as their Wines;"
                                            },
                                            {
                                                "example_id": "2be05a86-3b0d-46d6-b93a-0673b914d6cb",
                                                "sense_id": "1593d179-9b60-3378-8014-732b49dfb987",
                                                "text": "Those whom you feared most are now bosoming themselves in the queen's grace; and though her highness signified displeasure in outward sort, yet did she like the marrow of your book."
                                            },
                                            {
                                                "example_id": "4706402a-5b38-4635-8fa4-30f9c193be96",
                                                "sense_id": "1593d179-9b60-3378-8014-732b49dfb987",
                                                "text": "Beyond were the pines, and a rugged road, flint-edged, full of dips and rises, turns and twists, hovering on edges, or bosoming itself in deep rock-strewn cuts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "849b5809-dba8-3317-bb02-78d9b7888ffc",
                                        "entry_id": "e0fa4099-1305-3768-ba87-f5d0007c9280",
                                        "glosses": [
                                            "To belly; to billow, swell or bulge."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a3e8668-c602-41ab-8c20-82e7a0538dde",
                                                "sense_id": "849b5809-dba8-3317-bb02-78d9b7888ffc",
                                                "text": "Just above the recess the cliff bosomed out with a full swell for some two or three feet, effectually preventing any one’s looking down into the nest from above […]"
                                            },
                                            {
                                                "example_id": "c1191c07-5d91-4971-b90a-7149867cfe46",
                                                "sense_id": "849b5809-dba8-3317-bb02-78d9b7888ffc",
                                                "text": "1905, Alex Macdonald, In Search of El Dorado, London: T. Fisher Unwin, Part II, “The Five-Mile Rush,” p. 92,\nWhat Stewart called a “langtailie coat” spread out behind him like streamers in a breeze, a “biled” collar had, in the same gentleman’s terse language, “burst its moorings” and projected in two miniature wings at the back of his ears, and a shirt that had once been white, bosomed out expansively through an open vest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8a5e549-c45f-3a43-bc75-c8bce880894b",
                                        "entry_id": "e0fa4099-1305-3768-ba87-f5d0007c9280",
                                        "glosses": [
                                            "To belly; to cause to billow, swell or bulge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efc74b8-94f9-4fd8-8f42-2e5b81b51751",
                                                "sense_id": "b8a5e549-c45f-3a43-bc75-c8bce880894b",
                                                "text": "1822, James Hogg, The Three Perils of Man, London: Longman, Hurst, Rees, Orme & Brown, Volume 3, Chapter 12, pp. 440-441,\nI looked again, and though I was sensible it must be a delusion brought on by the stroke of his powerful rod, yet I did see the appearance of a glorious fleet of ships coming bounding along the surface of the firmament of air, while every mainsail was bosomed out like the side of a Highland mountain."
                                            },
                                            {
                                                "example_id": "a451abb1-6c8b-450e-8874-f24d7a38458d",
                                                "sense_id": "b8a5e549-c45f-3a43-bc75-c8bce880894b",
                                                "text": "1855, The Scald [pseudonym of George Smellie], “Sketches of a Voyage to Hudson’s Bay” in The Sea: Sketches of a Voyage to Hudson’s Bay, and Other Poems, London: Hope & Co., p. 45,\nThus one by one they mount, and spreading wide,\nThe transverse wings extend on either side,\nAnd, lightly bosomed by the gentle gale,\nShe seems a moving pyramid of ail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18e8b6de-6328-4634-8252-037a2f2a6d94",
                        "source_entry_id": "9dfc400b-72ee-3e02-a51f-09d830051bab",
                        "source_sense_id": "6b36f086-6b06-31f3-8c56-034dabe1ed5f",
                        "target_lang_word": "пазуха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пазуха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "de01a4f3-e3a0-3977-8325-108b01c9519c",
                                        "entry_id": "32a9c155-8d7d-34a0-8bb8-6deb9ec2cec4",
                                        "glosses": [
                                            "пространство между грудью и прилегающей к ней одеждой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec6ffb8-362e-47f8-98c9-b44aeccc5b95",
                                                "sense_id": "de01a4f3-e3a0-3977-8325-108b01c9519c",
                                                "text": "Герасим поглядел на несчастную собачонку, подхватил её одной рукой, сунул её к себе в пазуху и пустился большими шагами домой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d8de005-dc59-3f09-aede-20e0d1566f80",
                                        "entry_id": "32a9c155-8d7d-34a0-8bb8-6deb9ec2cec4",
                                        "glosses": [
                                            "углубление, впадина, выемка в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa7dbc7-fbd2-479a-9a27-cfab8c3691e3",
                                                "sense_id": "7d8de005-dc59-3f09-aede-20e0d1566f80",
                                                "text": "Он подошел к ближайшему транспортеру, уверенно сунул руку в пазуху на его борту и вытащил нечто, похожее на гаечный ключ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81da204-6ebc-37b5-8666-0c4c536db407",
                                        "entry_id": "32a9c155-8d7d-34a0-8bb8-6deb9ec2cec4",
                                        "glosses": [
                                            "впадина, промежуток, образующийся во время строительства чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45fe13b7-d137-3fcf-894b-23b3c8591ea5",
                                        "entry_id": "32a9c155-8d7d-34a0-8bb8-6deb9ec2cec4",
                                        "glosses": [
                                            "анат. полость в некоторых органах тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1fc2d60-92fe-4c88-913e-0012364e4ff6",
                                                "sense_id": "45fe13b7-d137-3fcf-894b-23b3c8591ea5",
                                                "text": "На верхней стенке клиновидной пазухи в её средних отделах располагается турецкое седло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f445f13e-31aa-3b86-b2c7-f9bee53ee49b",
                                        "entry_id": "32a9c155-8d7d-34a0-8bb8-6deb9ec2cec4",
                                        "glosses": [
                                            "ботан. углубление между основанием листа и стеблем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668b6e12-249f-498d-a2ec-78f238777f4c",
                                                "sense_id": "f445f13e-31aa-3b86-b2c7-f9bee53ee49b",
                                                "text": "В пазухе листа может образоваться почка, цветок, соцветие."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bb22892-9998-3208-ad30-f790a02d9d46",
                                        "entry_id": "32a9c155-8d7d-34a0-8bb8-6deb9ec2cec4",
                                        "glosses": [
                                            "архит. пространство между двумя арками или между аркой и многоугольным перекрытием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea84050-5987-42bd-8bbc-05e9c91dc043",
                                                "sense_id": "5bb22892-9998-3208-ad30-f790a02d9d46",
                                                "text": "Застроенные пазухи сводов как правило украшаются орнаментом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
