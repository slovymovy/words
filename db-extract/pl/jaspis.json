                                "target_senses": [
                                    {
                                        "sense_id": "8597d424-2327-3a66-87d5-38a7f50b9b16",
                                        "entry_id": "93de3ac4-c170-3b5a-93f9-3611dfad0cb3",
                                        "glosses": [
                                            "A wasp."
                                        ],
                                        "tags": [
                                            "UK",
                                            "West-Country",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                        "entry_id": "93de3ac4-c170-3b5a-93f9-3611dfad0cb3",
                                        "glosses": [
                                            "A person, a guy, especially seen as naïve or simple."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0e8a72a-4b2f-4b47-b069-909cba47c1f3",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "And list'nin to some big out-a-town jasper / Hearin' him tell about horse-race gamblin' / Not a wholesome trottin' race, no!"
                                            },
                                            {
                                                "example_id": "16eadc3d-c386-4f0e-a6bd-4a2954e4bae9",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "\"I stood there through almost an hour of it before they called Rooster Cogburn to the stand. I had guessed wrong as to which one he was, picking out a younger and slighter man with a badge on his shirt. And I was surprised when an old one-eyed jasper that was built along the lines of Grover Cleveland went up and was sworn.\""
                                            },
                                            {
                                                "example_id": "e1f1970b-e6ed-485e-ab61-15e1daa816c7",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "Standing on the corner like a just-got-in-town jasper"
                                            },
                                            {
                                                "example_id": "41f27622-576d-4443-bd3f-0aa0ba6485eb",
                                                "sense_id": "b697fa46-9489-39e1-a5f2-1706b9a919e2",
                                                "text": "“That jasper,” sniggered Darby, “never pulled out his ‘dummy’ for nothing but pissing, I bet you!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8859146-00f2-39f6-b673-07b6d00a7b49",
                                        "entry_id": "93de3ac4-c170-3b5a-93f9-3611dfad0cb3",
                                        "glosses": [
                                            "A stranger."
                                        ],
                                        "tags": [
                                            "Appalachia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
