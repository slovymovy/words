                                        "glosses": [
                                            "zakwaszana zupa na wywarze z buraków"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31bf7aaa-914f-43fe-97eb-c5c941ef386b",
                                                "sense_id": "de4fabb8-9434-3f17-8e7e-f9471d61d33f",
                                                "text": "Najbardziej lubię barszcz cioci Danuty."
                                            },
                                            {
                                                "example_id": "45f070fe-92e5-4f4a-9945-96688cb41f62",
                                                "sense_id": "de4fabb8-9434-3f17-8e7e-f9471d61d33f",
                                                "text": "Burak jest powszechnie używany w kuchni słowiańskiej, np. w zupach takich jak barszcz czy botwinka."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
