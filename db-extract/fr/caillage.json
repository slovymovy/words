                        "tags": [
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9b344885-69fb-4a5a-88f6-3f254b492245",
                                "sense_id": "28e32af8-8c6e-39b2-81c4-c5a1d5cbd9c2",
                                "text": "Le caillage : pour obtenir la coagulation, on ajoute au lait de la présure, des ferments lactiques, ou les deux à la fois."
                            },
                            {
                                "example_id": "a913206b-0596-42ef-b4cd-f664d236e029",
                                "sense_id": "28e32af8-8c6e-39b2-81c4-c5a1d5cbd9c2",
                                "text": "Ils procédaient au caillage du lait à partir de présure, substance provenant de la caillette (partie de l’estomac entre panse & feuillet) de jeune veau qui n’a mangé que du lait."
                            }
                        ]
                    }
