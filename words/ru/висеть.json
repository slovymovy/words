{
    "word_family": [
        "виселица",
        "висячий",
        "повиснуть",
        "зависнуть",
        "нависнуть",
        "отвиснуть",
        "свеситься"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1d01f2f-93fd-388b-bd0e-75a05e79060a",
                    "sense_definition": "Находиться в подвешенном состоянии, удерживаясь за что-либо сверху или сбоку.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На стене <w>висит</w> красивая фотография.",
                            "target_lang_translations": {
                                "en": "A beautiful photograph <w>hangs</w> on the wall."
                            }
                        },
                        {
                            "text": "В шкафу <w>висят</w> мои любимые рубашки.",
                            "target_lang_translations": {
                                "en": "My favorite shirts <w>are hanging</w> in the closet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "висеть на стене",
                        "висеть в шкафу"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in a suspended position, held by something from above or the side."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "To be or remain suspended."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11b51227-d4da-381f-8e15-79b6d3cf245e",
                    "sense_definition": "Выдаваться вперед или нависать над чем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Над дорогой <w>висят</w> тяжелые скалы.",
                            "target_lang_translations": {
                                "en": "Heavy rocks <w>hang</w> over the road."
                            }
                        },
                        {
                            "text": "С крыши <w>висят</w> острые сосульки.",
                            "target_lang_translations": {
                                "en": "Sharp icicles <w>are hanging</w> from the roof."
                            }
                        }
                    ],
                    "synonyms": [
                        "нависать",
                        "свешиваться"
                    ],
                    "target_lang_definitions": {
                        "en": "To project forward or overhang something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "To be suspended or project over something."
                            },
                            {
                                "target_lang_word": "overhang",
                                "target_lang_sense_clarification": "To project or extend over something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa8cf6e4-7baa-3bf4-bad8-1b4127914898",
                    "sense_definition": "Находиться в воздухе, не касаясь земли, или оставаться неподвижным в пространстве.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вертолет <w>висит</w> над лесом, ожидая сигнала.",
                            "target_lang_translations": {
                                "en": "The helicopter <w>is hovering</w> over the forest, waiting for a signal."
                            }
                        },
                        {
                            "text": "Спутники <w>висят</w> на орбите уже много лет.",
                            "target_lang_translations": {
                                "en": "Satellites <w>have been hanging</w> in orbit for many years."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be in the air without touching the ground, or to remain stationary in space."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hover",
                                "target_lang_sense_clarification": "To remain in one place in the air."
                            },
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "To float or remain suspended in space."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "502dc1ba-4e48-3623-9bd8-fcca851fa176",
                    "sense_definition": "Быть нерешенной проблемой или тяжелым обязательством.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На компании <w>висят</w> огромные долги перед банком.",
                            "target_lang_translations": {
                                "en": "The company <w>is burdened with</w> huge debts to the bank."
                            }
                        },
                        {
                            "text": "Это важное дело <w>висит</w> на мне уже вторую неделю.",
                            "target_lang_translations": {
                                "en": "This important task <w>has been hanging over</w> me for two weeks now."
                            }
                        }
                    ],
                    "common_phrases": [
                        "висеть на плечах",
                        "висеть долгом"
                    ],
                    "target_lang_definitions": {
                        "en": "To be an unresolved problem or a heavy burden/obligation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang over",
                                "target_lang_sense_clarification": "To loom or threaten as a burden or worry."
                            },
                            {
                                "target_lang_word": "weigh on",
                                "target_lang_sense_clarification": "To be a source of worry or burden."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53988e71-2f3f-37d3-8539-adddc120ad4d",
                    "sense_definition": "О компьютере или программе: перестать реагировать на действия пользователя.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компьютер снова <w>висит</w>, придется его перезагрузить.",
                            "target_lang_translations": {
                                "en": "The computer <w>is hanging</w> again; I'll have to restart it."
                            }
                        },
                        {
                            "text": "Программа <w>висит</w> и не открывает нужный файл.",
                            "target_lang_translations": {
                                "en": "The program <w>is frozen</w> and won't open the required file."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "компьютерный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Of a computer or program: to stop responding to user actions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "To stop responding to manual input devices."
                            },
                            {
                                "target_lang_word": "freeze",
                                "target_lang_sense_clarification": "To become unresponsive due to a system error."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}