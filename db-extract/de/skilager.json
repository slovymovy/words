                ],
                "senses": [
                    {
                        "sense_id": "18a13ad5-a66c-3328-97e1-5f307f6b9ab1",
                        "entry_id": "543f9e6e-aee4-3fd2-86b7-86104424c016",
                        "glosses": [
                            "gemeinsame mehrtägige Unternehmung für Jugendliche im Winter mit sportlichem Charakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c64bc647-7b11-4966-9fcd-9747bba7c2da",
                                "sense_id": "18a13ad5-a66c-3328-97e1-5f307f6b9ab1",
                                "text": "„Eine Umfrage unter städtischen Schulen habe aber ergeben, dass nur noch die Hälfte der Realschulen ein Skilager anbiete.“"
                            },
                            {
                                "example_id": "d75dbf7c-6d53-41c4-8658-baa8ea055a4d",
                                "sense_id": "18a13ad5-a66c-3328-97e1-5f307f6b9ab1",
                                "text": "„Als der Lehrer nach den Herbstferien verkündete, dass sie mit der Klasse von Astrid ins Skilager fahren würden, war er so aufgewühlt, dass er zwei Nächte lang nicht schlafen konnte.“"
                            },
                            {
                                "example_id": "260ee7af-785c-408e-b81e-5c77be1defa3",
                                "sense_id": "18a13ad5-a66c-3328-97e1-5f307f6b9ab1",
                                "text": "„Im Hause Laurin waren heftige Diskussionen ausgetragen worden, als die Zwillinge Konstantin und Kaja mit der Nachricht heimkamen, dass sie mit ihrer Schulklasse ins Skilager in die Dolomiten fahren würden.“"
                            },
                            {
                                "example_id": "5146ab94-19e1-4ea4-a017-2fb90e6e4ff0",
                                "sense_id": "18a13ad5-a66c-3328-97e1-5f307f6b9ab1",
                                "text": "„Die Klägerin könne wegen dieser Unfallsfolgen weder Turnunterricht erteilen noch sei ihre Teilnahme an Schilagern und Wandertagen möglich.“"
                            },
                            {
                                "example_id": "36b6061f-f9f6-4779-bde4-15fe9ba251ca",
                                "sense_id": "18a13ad5-a66c-3328-97e1-5f307f6b9ab1",
                                "text": "„Als es am 11. Januar 1971 ins Skilager ging, nach Tirol, kam's freilich auch für ihn noch eine Spur härter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                        "entry_id": "543f9e6e-aee4-3fd2-86b7-86104424c016",
                        "glosses": [
                            "Teil der Sportwelt, der sich mit dem Skilauf befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda0db4e-5e67-4100-b643-1540bc27e23c",
                                "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                                "text": "„‚Viele frühere Snowboarder wechseln wieder ins Skilager‘, sagt Sport-Scheck-Chef Herzog.“"
                            },
                            {
                                "example_id": "ed632132-6ce1-46df-a781-9f6ffe95cd2f",
                                "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                                "text": "„Spürbar ist die angespannte Vorfreude im österreichischen Skilager.“"
                            },
                            {
                                "example_id": "18738e7f-4d15-4fc4-8235-c05058834070",
                                "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                                "text": "„Die nächste frohe Nachricht aus dem österreichischen Skilager: Nach den Hochzeiten von Michaela Kirchgasser, Anna Veith und die kirchliche Trauung von Marlies und Benjamin Raich traute sich auch Bernadette Schild, wie sie jetzt auf sozialen Netzwrken verkündete.“"
                            },
                            {
                                "example_id": "249fd1d5-7c35-4f08-8716-bf8666a6cc7d",
                                "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                                "text": "„Im alpinen Skilager musten nach den Slaloms in Levi (Finnland) auch die Slaloms in Zagreb (jeweils Damen und Herren) sowie die Damen-Speedrennen in St. Anton gestrichen werden.“"
                            },
                            {
                                "example_id": "3518a964-f45f-4b5d-ab3a-3fa2aeb559bc",
                                "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                                "text": "„Im heimischen Skilager liegen nach dem totalen Flop bei den Olympischen Winterspielen und nach einem Jahr ohne Abfahrtssieg die Nerven blank.“"
                            },
                            {
                                "example_id": "213bdf65-0e6e-4717-8e9b-515bf05f5241",
                                "sense_id": "4e5663d9-0173-3d6d-a4ff-fd547d44fd5e",
                                "text": "„Vor Ligety haben es mit Lindsey Vonn, Picabo Street and Tamara McKinney bisher nur Damen aus dem alpinen Skilager geschafft, in der seit 1974 stattfindenden Wahl zu US-Sportlern des Jahres gewählt zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6ede2918-eaf8-3214-8b4b-d843c2ad0f1c",
                        "entry_id": "543f9e6e-aee4-3fd2-86b7-86104424c016",
                        "glosses": [
                            "Raum zur Aufbewahrung von Wintersportgeräten beziehungsweise diese selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63db0565-6175-428c-8eb0-b77239862ce6",
                                "sense_id": "6ede2918-eaf8-3214-8b4b-d843c2ad0f1c",
                                "text": "„Die nach dem milden Winter 2006/07 vollen Skilager in den Geschäften seien etwas abgebaut worden – exakte Zahlen liegen noch nicht vor.“"
                            },
                            {
                                "example_id": "ee4f9930-aa1f-489e-86da-1530ad82a50b",
                                "sense_id": "6ede2918-eaf8-3214-8b4b-d843c2ad0f1c",
                                "text": "„Laut den Einreichunterlagen soll das Gebäude ein Erd- und ein Obergeschoss aufweisen, wobei im Erdgeschoss der Skiverleih samt Skilager, zwei weitere Lager, eine Werkstatt, ein Heizraum, ein WC für das Personal, ein Waschraum, ein Arbeitsraum und ein Vorhaus sowie im Obergeschoss ein Gastronomiebetrieb (Kaffeerestaurant) samt Küche, Windfang/Garderobe, je ein WC für Damen und Herren, ein Waschraum, ein Vorraum und ein Lager errichtet werden sollen.“"
                            },
                            {
                                "example_id": "4857a3b8-32c6-40f8-a27b-5f6f52eafc02",
                                "sense_id": "6ede2918-eaf8-3214-8b4b-d843c2ad0f1c",
                                "text": "„Im Kellergeschoß seien ein Heizraum, Tankraum, Schilager und weitere Lagerflächen vorgesehen.“"
                            },
                            {
                                "example_id": "f14a7c3e-cf42-47e6-a3f8-59aab2fb40c9",
                                "sense_id": "6ede2918-eaf8-3214-8b4b-d843c2ad0f1c",
                                "text": "„Zu Letzterer seien Flächen für Empfang, Hauswirtschaft und Reservierung, Verpflegung der Gäste (Küche, Restaurant, Bar, Etagenservice etc) und Nebenleistungen (Wellness-Angebote, Schilager u.dgl.) zu zählen.“"
                            },
                            {
                                "example_id": "3242dc19-0867-4b8b-bd8e-e163705dec59",
                                "sense_id": "6ede2918-eaf8-3214-8b4b-d843c2ad0f1c",
                                "text": "„Ich bin fest überzeugt, daß in fünfzig Jahren auf allen nur erdenklichen Punkten in unseren Alpen Schilager anzutreffen sein werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
