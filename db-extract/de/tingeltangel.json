                                        "entry_id": "6bb25a28-a2be-39ab-8828-addaa710ee13",
                                        "glosses": [
                                            "podrzędna kawiarnia lub restauracja, w której odbywały się występy artystów lub kabaretów wątpliwej reputacji"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be58c909-955e-402e-b039-c61c7a74111e",
                                                "sense_id": "ae7e363a-a2a6-3e14-804d-ee3b94f47974",
                                                "text": "Jako ekskapelmistrz teatrów ogródkowych czy też kelner, który zwiedził wszystkie stolice Europy, znał wszystkie hotele i tingel-tangle."
                                            },
                                            {
                                                "example_id": "4c8f810b-c5e6-429e-8740-b2cd1338ab06",
                                                "sense_id": "ae7e363a-a2a6-3e14-804d-ee3b94f47974",
                                                "text": "Przedwojenny Wiedeń to świat tak wytwornych kawiarni, jak i podrzędnych tingel-tangli ze striptizem i kabaretem, obskurnych knajp dla dorożkarzy, odrapanych kamienic"
                                            }
                                        ],
