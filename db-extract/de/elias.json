                                    {
                                        "sense_id": "59c00200-65cb-318b-950e-5fca453336bf",
                                        "entry_id": "27670a95-4b79-39e9-9e73-17bc2ce9ac9b",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3669835d-6098-4fb0-8bac-cab053398671",
                                                "sense_id": "59c00200-65cb-318b-950e-5fca453336bf",
                                                "text": "Some ſay that thou art John the Baptiſt, ſome Elias, and others Jeremias, or one of yͤ Prophets."
                                            },
                                            {
                                                "example_id": "430fbb54-a87f-4fdf-a736-2eb64ff5d9e4",
                                                "sense_id": "59c00200-65cb-318b-950e-5fca453336bf",
                                                "text": "In a 2017 GoFundMe page that included his photo, a testimonial attributed to Elias Rodriguez described how, when he was 11, his father’s deployment to Iraq sparked his political awakening and mobilized him to prevent “another generation of Americans coming home from genocidal imperialist wars.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfc6e61-64f1-32fa-b82b-7cec6ec656ee",
                                        "entry_id": "27670a95-4b79-39e9-9e73-17bc2ce9ac9b",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efbe86cb-299d-48a7-ab45-a54666c0121a",
                        "source_entry_id": "64858de0-f3bf-35ff-8304-b9c9dc213a75",
                        "source_sense_id": "eb47ea5e-0129-3362-bb9a-f1f821a5c584",
