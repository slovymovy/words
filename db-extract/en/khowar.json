                "senses": [
                    {
                        "sense_id": "288afafc-8f92-307f-83da-8f986355412e",
                        "entry_id": "e1ede4ff-cef2-3396-ba2b-b6a0df7241fc",
                        "glosses": [
                            "An Indo-Aryan language of the Dardic branch, spoken by the Kho people."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5273462a-de53-45dc-9aef-175e4b15086f",
                                "sense_id": "288afafc-8f92-307f-83da-8f986355412e",
                                "text": "In those languages are, (1) Boorishki or Khajuna, the language of the Boorish or Yeshkuns, which is spoken in Hunza, Nager, and Yassin, (2) Shina, the language of the Shins which is spoken in the Gilgit Valley, (3) Khowar, the language of Chitral."
                            },
                            {
                                "example_id": "228e098e-b67e-4abc-a219-932d980d6772",
                                "sense_id": "288afafc-8f92-307f-83da-8f986355412e",
                                "text": "Few people in Rowshan regularly read Khowar works, however, and their attitudes towards the value of written Khowar are ambivalent."
                            },
                            {
                                "example_id": "c4563582-cd33-48f6-9ec0-ab00e5022883",
                                "sense_id": "288afafc-8f92-307f-83da-8f986355412e",
                                "text": "Morgenstierne 1936 is a foundational article for Khowar etymological studies. It discusses four layers of historical accretion of Iranian lexical elements in Khowar: words from (a) unidentified Ir sources, (b) Pamir languages, mainly Wakhi, (c) Middle Ir. languages, and (4) numerous words from New Persia."
                            }
                        ]
                    }
