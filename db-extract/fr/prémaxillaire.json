                    {
                        "sense_id": "479c2d3a-2356-3cfd-92e2-f24759ce8ac1",
                        "entry_id": "07a63b50-bea8-36ed-b2d7-8daea9ab46a9",
                        "glosses": [
                            "Des os pairs situés à la partie antérieure de la mâchoire supérieure de nombreux animaux (reptiles, oiseaux, mammifères, etc.) tout comme chez l’homme, et portent souvent des dents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b1d655-200c-48c1-a128-df18c4d2d0db",
                                "sense_id": "479c2d3a-2356-3cfd-92e2-f24759ce8ac1",
                                "text": "Faites une écoute et définissez les mouvements intrinsèques du prémaxillaire et de cette portion par rapport au reste du maxillaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7367372b-2520-43ea-a55c-dabc29cbf532",
                        "source_entry_id": "07a63b50-bea8-36ed-b2d7-8daea9ab46a9",
                        "source_sense_id": "479c2d3a-2356-3cfd-92e2-f24759ce8ac1",
                        "target_lang_word": "Zwischenkiefer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwischenkiefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1b1b7e-8c45-3b7d-a1b3-2c698e3073e1",
                                        "entry_id": "273ab808-9f3a-3f2e-882c-d8b429282038",
                                        "glosses": [
                                            "beim Menschen mit dem Oberkiefer verwachsener Knochen, der die oberen Schneidezähne trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0e2af2-d216-453c-a132-b7a31006442b",
                                                "sense_id": "1b1b1b7e-8c45-3b7d-a1b3-2c698e3073e1",
                                                "text": "„Nun wollte es Goethe durchaus nicht in den Kopf, daß der Mensch, der in allen übrigen körperlichen Beziehungen offenbar nur ein höher entwickeltes Säugethier sei, diesen Zwischenkiefer entbehren solle.“"
                                            },
                                            {
                                                "example_id": "2bd3c0cf-2a66-4b08-91d5-1c417ccea6b4",
                                                "sense_id": "1b1b1b7e-8c45-3b7d-a1b3-2c698e3073e1",
                                                "text": "„Da das Zwischenkiefer, besonders in Vögeln (Gans) äußerlich die oberste Spitze des Kopfthorax, also das obere des Brustbeins oder eingeweidlich genommen der Kehlkopf ist, so sollten die Schneidezähne darauf Bezug haben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
