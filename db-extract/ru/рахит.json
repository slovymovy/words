                                        "sense_id": "f065c8d7-1eee-3848-b9d0-21d5db61159c",
                                        "entry_id": "c07de1a7-75f0-3cc4-b3a7-30bea01ab0ee",
                                        "glosses": [
                                            "Maladie du blé, qui empêche la tige de se développer et la rend noueuse."
