                                "target_senses": [
                                    {
                                        "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                        "entry_id": "89bf193b-4a6b-3f49-8e38-87822f7f5bad",
                                        "glosses": [
                                            "Qui a rapport à la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15184bb3-b03f-45da-8b80-d42670b9e91f",
                                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                                "text": "Toutes les parties de l’oranger, excepté les racines, sont fortifiantes, céphaliques, stomachiques, cordiales, anti-septiques ; les fleurs sont d'un fréquent usage, et les fruits sont très-sains lorsqu'ils sont bien mûrs."
                                            },
                                            {
                                                "example_id": "f2d5ea6c-58b6-484c-9423-d7f2e9afd669",
                                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                                "text": "— Ah ! nous y voici, madame. Je suis un épicier, un boutiquier, un ancien débitant de pâte d’amande, d’eau de Portugal, d’huile céphalique, on doit me trouver bien honoré d’avoir marié ma fille unique au fils de monsieur le baron Hulot d’Ervy, ma fille sera baronne."
                                            },
                                            {
                                                "example_id": "ec2a21c1-990d-45b6-9d3f-3f03cb6c00f5",
                                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                                "text": "Souffle céphalique, Léger souffle que l’on constate chez un nouveau-né."
                                            },
                                            {
                                                "example_id": "76abbf7d-8f71-4fdb-b2cb-5dd8cff09a5d",
                                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                                "text": "Artère céphalique, Autre nom de l’artère carotide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
