                            {
                                "target_word": "Ahmadiyya",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f13e3adf-1f14-33d9-ad9b-3adb5dd9d702",
                                        "entry_id": "afdb3aff-41b1-3baa-909d-7b35d923b131",
                                        "glosses": [
                                            "eine religiöse Konfession, etwa: Ahmad·tum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdfd598e-9024-413e-9c15-2b6a7acd1873",
                                                "sense_id": "f13e3adf-1f14-33d9-ad9b-3adb5dd9d702",
                                                "text": "Die Ahmadiyya ist eine in Qadian (Indien) gegründete islamische Konfession."
                                            },
                                            {
                                                "example_id": "67b806e1-2f72-4505-8196-297a2479f2dd",
                                                "sense_id": "f13e3adf-1f14-33d9-ad9b-3adb5dd9d702",
                                                "text": "„Der Islam der Ahmadiyya ist ein Bekenntnis zum Frieden unter den Mitmenschen und Frieden zwischen Mensch und Gott und nicht zuletzt Frieden mit sich selbst. Weit weg vom blinden Fanatismus und sich distanzierend von allen Terrorakten und Zwang, lehrt der Islam der Ahmadiyya echte Toleranz und die Wahrung der Menschenrechte auf jedem Gebiet des menschlichen Lebens.“"
                                            },
                                            {
                                                "example_id": "a8129d6e-113d-43c6-97fd-a99543c7c753",
                                                "sense_id": "f13e3adf-1f14-33d9-ad9b-3adb5dd9d702",
                                                "text": "„1889 gründete Mirza Ghulam Ahmad in Qadiyan (heute im indischen Punjab) die Gemeinschaft der Ahmadiyya (Jamaat-e-Ahmadiya)..“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
