                "senses": [
                    {
                        "sense_id": "9f1278e9-b608-3269-902c-8823a9918d42",
                        "entry_id": "4e37376d-3b22-38c8-9ac9-b9b82107485a",
                        "glosses": [
                            "de vorm hebbend van een (afgeknotte) kegel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "865e842c-21d5-4d3a-9611-5987e263cade",
                                "sense_id": "9f1278e9-b608-3269-902c-8823a9918d42",
                                "text": "Voor wie de advertentie die onder meer zaterdag in de krant stond, heeft gemist; de Phoenix-brandblusser bestaat uit een conische kunststof cilinder waarop een vogelkop zit bij wijze van dop (keuze uit wit en zwart)."
                            },
                            {
                                "example_id": "f2779326-f13d-429b-9d34-c8aae3aec112",
                                "sense_id": "9f1278e9-b608-3269-902c-8823a9918d42",
                                "text": "De nieuwste prothese van De Oliveira Barata’s is van haar grootste klant, model en singer/songwriter Viktoria Modesta, die drie protheses in bezit heeft. De prothese zit met tientallen schroefjes in elkaar. „De beenprothese heeft een realistisch ogende voet, maar het stuk tussen de enkels en de knie is een steampunk-achtige, conische staaf met een metalen kooi eromheen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96bb80bf-c327-4c54-a2dc-e35c8a365fe2",
                        "source_entry_id": "4e37376d-3b22-38c8-9ac9-b9b82107485a",
                        "source_sense_id": "9f1278e9-b608-3269-902c-8823a9918d42",
                        "source_sense_description": "de vorm hebbend van een (afgeknotte) kegel",
                        "target_lang_word": "conical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff7dc7d-c831-3128-85fb-96d21221dbe3",
                                        "entry_id": "c86a4cec-5a8f-34e0-a496-0b7e03125b04",
                                        "glosses": [
                                            "Of or relating to a cone or cones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8584eef1-f08f-496b-9194-a97ea0b30608",
                                                "sense_id": "8ff7dc7d-c831-3128-85fb-96d21221dbe3",
                                                "text": "He anſwers, That this Motion is Conical; and judgeth, that by the Conick path all the Phænomena of Comets can, without any inconveniency, be readily ſolved; even of that, which (by Hiſtory) in fifty days, paſſed through more then the 12 Signs of the Zodiack; And of that, which in two days run through eight Signs: and of another, which in 48 days poſted through all the Signs, contra ſeriem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854a9880-17ca-3267-a727-bb3e26787cf4",
                                        "entry_id": "c86a4cec-5a8f-34e0-a496-0b7e03125b04",
                                        "glosses": [
                                            "Shaped like a cone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62f5bcb2-d94c-4233-9008-81b75074c1b2",
                                                "sense_id": "854a9880-17ca-3267-a727-bb3e26787cf4",
                                                "text": "IN Planes neither equinoctiall nor polar, the equator will be a right line, the tropiques and other parallels of declination will be conicall ſections, ſome of them parabolicall, ſome ellipticall, but the moſt of them hyperbolicall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e030a32-bcc2-3efe-9dcf-ccc20ce0c51c",
                                        "entry_id": "c86a4cec-5a8f-34e0-a496-0b7e03125b04",
                                        "glosses": [
                                            "Describing a map projection in which meridians are mapped to equally spaced lines radiating out from the apex and parallels of latitude are mapped to circular arcs centred on the apex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
