                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3a8d95-83b1-4ce8-9c68-d20171e22dcc",
                                "sense_id": "32902691-1379-3a03-b797-b4d518f251a7",
                                "text": "Zingen is een fysieke sensatie en in die zin zelfs verslavend. Soms lukt het me met zo veel resonans te zingen dat mijn vingers meetrillen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf661c06-e4d5-3541-ad2f-cdc2fe36eed9",
                        "entry_id": "87d07ea3-1512-3099-b20a-c9bfb9707ded",
                        "glosses": [
                            "versterkte klank van een muziekinstrument door een klankkast"
