                "senses": [
                    {
                        "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                        "entry_id": "40aaaf07-c81b-3c82-8fe8-8ef46fa17521",
                        "glosses": [
                            "kugelartiges Zimmeraquarium zur Haltung von Zierfischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322de229-2715-4621-909c-5232cbeb3196",
                                "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                                "text": "„Ich wurde 1947 geboren; unseren ersten Fernseher bekamen wir 1958. Soweit ich mich erinnere, habe ich darin als erstes ‚Robot Monster‘ gesehen, einen Film, in dem ein Typ in einem Affenkostüm und einem Goldfischglas auf dem Kopf (er hiess Ro-Man) herumlief und versuchte, die letzten Überlebenden eines Atomkriegs zu vernichten.“"
                            },
                            {
                                "example_id": "8e8530f8-f8dc-487c-bdc7-b0b2b077529b",
                                "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                                "text": "„Sein Lieblingsfutter liegt neben dem Goldfischglas auf meinem Kühlschrank.“"
                            },
                            {
                                "example_id": "9b27ec11-7dd1-4eb5-af3b-117404dbd3f4",
                                "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                                "text": "„Auf dem kleinen Couchtisch in meinem kleinen Wohnzimmer, vor dem kleinen Sofa, das aussieht, als gehörte es in irgendein Hippie-Tonstudio, steht ein großes Goldfischglas mit meinen beiden besten Freunden darin, Pickle und Jehova.“"
                            },
                            {
                                "example_id": "6dd11180-ec9a-4e8f-898b-ae7052a64f2c",
                                "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                                "text": "„Seine Worte klingen jetzt, als würde er sie in einem Goldfischglas murmeln.“"
                            },
                            {
                                "example_id": "014ad945-ea56-47d5-8a1f-2c747aff8ecf",
                                "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                                "text": "„Es war unmöglich, sich zu entspannen und zu amüsieren, wenn man sich fühlte wie in einem Goldfischglas.“"
                            },
                            {
                                "example_id": "edaf1799-d3c0-4e45-84e1-cd78eaebc648",
                                "sense_id": "3888668f-0842-3d8c-b9c4-cfc93171e2e0",
                                "text": "„Ihre Augen sahen aus, als würden sie in einem Goldfischglas umherschwimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
