                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque État <w>souverain</w> a le droit de choisir librement son propre système politique."
                        },
                        {
                            "text": "Le tribunal applique la loi en exerçant son appréciation <w>souveraine</w> des faits."
                        }
                    ],
