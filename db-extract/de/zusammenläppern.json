                        "sense_id": "c90baf70-6dc3-3578-b23a-b4b3ebe15ef5",
                        "entry_id": "65f0c297-8ca9-380a-ac49-6f9acb581d0e",
                        "glosses": [
                            "sich aus kleinen Portionen/Beträgen ansammeln und so ein gemeinsames Größeres werden"
                        ],
                        "tags": [
                            "impersonal",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "d71bba51-f398-4453-b3f6-de319c16f2ca",
                                "sense_id": "c90baf70-6dc3-3578-b23a-b4b3ebe15ef5",
                                "text": "In unserem Sparschwein hat sich doch ganz schön was zusammengeläppert, so über die Monate."
                            },
                            {
                                "example_id": "93038d3b-8334-4d29-9312-5a68e7a30ca1",
                                "sense_id": "c90baf70-6dc3-3578-b23a-b4b3ebe15ef5",
                                "text": "Ein Kredit kam zum nächsten und plötzlich merkte man, dass sich da richtig unangenehme Schulden zusammenläpperten."
                            }
                        ],
