                    "sense_id": "e50f6cab-01a3-35fd-8b8a-7ea39316fe0f",
                    "sense_definition": "Volkomen duidelijk en gemakkelijk te begrijpen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De docent gaf een <w>glasheldere</w> uitleg over de moeilijke theorie.",
                            "target_lang_translations": {
                                "fr": "L'enseignant a donné une explication <w>limpide</w> sur cette théorie difficile."
                            }
                        },
                        {
                            "text": "Zijn standpunt over het nieuwe beleid was voor iedereen <w>glashelder</w>.",
                            "target_lang_translations": {
                                "fr": "Sa position sur la nouvelle politique était <w>claire comme de l'eau de roche</w> pour tout le monde."
                            }
                        }
                    ],
                    "synonyms": [
                        "overduidelijk",
                        "kristalhelder"
                    ],
                    "common_phrases": [
                        "glasheldere uitleg",
                        "glasheldere redenatie"
                    ],
                    "target_lang_definitions": {
                        "fr": "Parfaitement clair, évident et facile à comprendre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "clair comme de l'eau de roche",
                                "target_lang_sense_clarification": "très clair, limpide"
                            },
                            {
                                "target_lang_word": "limpide",
                                "target_lang_sense_clarification": "d'une clarté parfaite (pour un raisonnement, une explication)"
                            },
                            {
                                "target_lang_word": "parfaitement clair",
                                "target_lang_sense_clarification": "sans ambiguïté"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad8e2f9c-95db-3d0f-9f03-c4ee6f703cf6",
                    "sense_definition": "Zo helder en doorzichtig als glas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water in het bergmeer was zo <w>glashelder</w> dat je de vissen zag zwemmen.",
                            "target_lang_translations": {
                                "fr": "L'eau du lac de montagne était si <w>cristalline</w> qu'on voyait les poissons nager."
                            }
                        },
                        {
                            "text": "Door de <w>glasheldere</w> ruit scheen het zonlicht direct naar binnen.",
                            "target_lang_translations": {
                                "fr": "À travers la vitre <w>parfaitement transparente</w>, la lumière du soleil entrait directement."
                            }
                        }
                    ],
                    "synonyms": [
                        "kristalhelder"
                    ],
                    "common_phrases": [
                        "glashelder water"
                    ],
                    "target_lang_definitions": {
                        "fr": "Aussi clair et transparent que du verre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cristallin",
