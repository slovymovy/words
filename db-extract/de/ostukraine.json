                "senses": [
                    {
                        "sense_id": "45d5c6c9-70af-3a5e-922f-04b03ab0b164",
                        "entry_id": "f2d1da8e-38d5-36e6-befc-e3e0425ea772",
                        "glosses": [
                            "östlicher Teil der Ukraine mit hohem Anteil russischsprachiger Bevölkerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe513b6-62f9-4cab-8367-8ee539a9f926",
                                "sense_id": "45d5c6c9-70af-3a5e-922f-04b03ab0b164",
                                "text": "„In der Ostukraine ist der Anteil der russischsprachigen Bevölkerung hoch.“"
                            },
                            {
                                "example_id": "d015a189-f548-410e-98dd-88f234d3dd10",
                                "sense_id": "45d5c6c9-70af-3a5e-922f-04b03ab0b164",
                                "text": "„Die russischsprachigen Gebiete der Süd- und Ostukraine haben traditionell enge Bindungen an Russland.“"
                            },
                            {
                                "example_id": "6ffaa82a-c453-467a-8815-08d8d1922de1",
                                "sense_id": "45d5c6c9-70af-3a5e-922f-04b03ab0b164",
                                "text": "„Nach einer einstündigen Fahrt durch die ärmliche Nordzone Rios erreicht man den Campus – und wähnt sich in der Ostukraine.“"
                            },
                            {
                                "example_id": "9531e0ce-461c-4e9d-92fa-c831b4cef2f6",
                                "sense_id": "45d5c6c9-70af-3a5e-922f-04b03ab0b164",
                                "text": "[Russland-Ukraine-Krieg 2022:] „Im flachen Land der Ostukraine kämpfen russische und ukrainische Soldaten im Hagel der Geschosse um jeden Meter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
