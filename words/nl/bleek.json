                    "frequency": "Middle",
                    "semantic_group_id": "color_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muren van de woonkamer zijn in een <w>bleke</w> kleur geschilderd.",
                            "target_lang_translations": {
