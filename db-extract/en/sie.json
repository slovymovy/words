                "senses": [
                    {
                        "sense_id": "01cb59bc-e165-3a90-b187-c82f717f1236",
                        "entry_id": "9c7fcf79-e66e-3622-a887-e697675d47ad",
                        "glosses": [
                            "Gender-neutral subject pronoun, grammatically equivalent to the gendered pronouns he and she"
                        ],
                        "tags": [
                            "gender-neutral",
                            "nominative",
                            "nonstandard",
                            "rare",
                            "singular",
                            "third-person"
                        ],
                        "examples": [
                            {
                                "example_id": "1dc26225-6ff8-448b-b985-e852bcb0f6bd",
                                "sense_id": "01cb59bc-e165-3a90-b187-c82f717f1236",
                                "text": "If the child is about the intellectual equal of the parent, sie will eventually start holding hir own in discussions, […]"
                            },
                            {
                                "example_id": "621c9b77-13cb-4660-b507-95884ff5d929",
                                "sense_id": "01cb59bc-e165-3a90-b187-c82f717f1236",
                                "text": "\"You must be Ash,\" sie said, hir voice a shade deeper than Amaranth's."
                            },
                            {
                                "example_id": "c3d2fe80-c6fc-45ea-ae16-3829b5665b77",
                                "sense_id": "01cb59bc-e165-3a90-b187-c82f717f1236",
                                "text": "Sie may feel that hir actual identity of hir gender is supposed to be both/neither male or female, outside of gender, third gender, beyond gender, absence of gender, mixing gender, changing gender, or all genders."
                            },
                            {
                                "example_id": "11063dbc-7c62-48a0-b202-5d8596e4326c",
                                "sense_id": "01cb59bc-e165-3a90-b187-c82f717f1236",
                                "text": "When I asked hir about hir preferred self-identification in this scene, sie offered me this language, 'sie sharply performs the hotness of teasing all the audience from the edge-space of androgyny.'"
                            }
                        ]
                    }
                ],
