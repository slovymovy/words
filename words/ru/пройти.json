{
    "word_family": [
        "проход",
        "прохождение",
        "проходимость",
        "прохожий",
        "проходная",
        "проходка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cc4316b-4ec2-3120-b37c-72c60b6644d3",
                    "sense_definition": "Переместиться, преодолеть определённое расстояние пешком или на транспорте.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <прошли> пешком около пяти километров до станции.",
                            "target_lang_translations": {
                                "en": "We <walked> about five kilometers to the station.",
                                "zh": "我们步行<w>走</w>了大约五公里到达车站。"
                            }
                        },
                        {
                            "text": "Туристы <прошли> сложный маршрут за два дня.",
                            "target_lang_translations": {
                                "en": "The tourists <covered> a difficult route in two days.",
                                "zh": "游客们在两天内<w>走完</w>了这条复杂的路线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "преодолеть"
                    ],
                    "common_phrases": [
                        "пройти пешком",
                        "пройти путь",
                        "пройти расстояние"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or traverse a certain distance on foot or by transport.",
                        "zh": "指步行或乘车移动、跨越一定的距离。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk",
                                "target_lang_sense_clarification": "to move on foot"
                            },
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "to traverse a distance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走",
                                "target_lang_sense_clarification": "步行移动"
                            },
                            {
                                "target_lang_word": "走过",
                                "target_lang_sense_clarification": "跨越一段距离"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c8d5523-025d-35da-9d4e-08d7200ac57a",
                    "sense_definition": "Двигаясь, оставить кого-либо или что-либо позади или в стороне; миновать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он быстро <прошёл> мимо меня, не сказав ни слова.",
                            "target_lang_translations": {
                                "en": "He quickly <walked past> me without saying a word.",
                                "zh": "他一言不发地从我身边快速<w>经过</w>。"
                            }
                        },
                        {
                            "text": "Чтобы попасть в музей, нужно <пройти> через парк.",
                            "target_lang_translations": {
                                "en": "To get to the museum, you need to <go through> the park.",
                                "zh": "要去博物馆，你需要<w>穿过</w>公园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "миновать"
                    ],
                    "common_phrases": [
                        "пройти мимо",
                        "пройти через",
                        "пройти сквозь"
                    ],
                    "target_lang_definitions": {
                        "en": "To move past someone or something; to leave behind or go through.",
                        "zh": "移动时将某人或某物留在身后或一侧；经过。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to move past something"
                            },
                            {
                                "target_lang_word": "go through",
                                "target_lang_sense_clarification": "to move via an interior or area"
                            },
                            {
                                "target_lang_word": "walk past",
                                "target_lang_sense_clarification": "to go past on foot"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经过",
                                "target_lang_sense_clarification": "从某处通过"
                            },
                            {
                                "target_lang_word": "穿过",
                                "target_lang_sense_clarification": "从内部或区域中通过"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01ed668b-7451-350f-9c07-9650aab7af40",
                    "sense_definition": "О времени: протечь, миновать, закончиться.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С тех пор <прошло> уже три года.",
                            "target_lang_translations": {
                                "en": "Three years have <passed> since then.",
                                "zh": "从那时起已经<w>过去</w>三年了。"
                            }
                        },
                        {
                            "text": "Лето быстро <прошло>, и наступила холодная осень.",
                            "target_lang_translations": {
                                "en": "Summer <passed> quickly, and cold autumn arrived.",
                                "zh": "夏天很快<w>过去</w>了，寒冷的秋天随之而来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "миновать",
                        "уйти",
                        "минуть",
                        "истечь"
                    ],
                    "common_phrases": [
                        "время прошло",
                        "прошло много лет",
                        "прошёл год"
                    ],
                    "target_lang_definitions": {
                        "en": "Of time: to elapse, to go by, to end.",
                        "zh": "指时间流逝、过去或结束。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to elapse (of time)"
                            },
                            {
                                "target_lang_word": "go by",
                                "target_lang_sense_clarification": "to pass (of time)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过去",
                                "target_lang_sense_clarification": "时间流逝"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05471074-5f41-3c15-bc98-a22635b15946",
                    "sense_definition": "Прекратиться, кончиться, перестать (о боли, болезни, дожде и т.п.).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Выпей таблетку, и головная боль скоро <пройдёт>.",
                            "target_lang_translations": {
                                "en": "Take a pill, and the headache will soon <pass>.",
                                "zh": "吃片药，头痛很快就会<w>消失</w>。"
                            }
                        },
                        {
                            "text": "Сильный дождь наконец <прошёл>, и выглянуло солнце.",
                            "target_lang_translations": {
                                "en": "The heavy rain finally <stopped>, and the sun came out.",
                                "zh": "大雨终于<w>停止</w>了，太阳露出了头。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прекратиться",
                        "закончиться",
                        "исчезнуть"
                    ],
                    "common_phrases": [
                        "боль прошла",
                        "дождь прошёл",
                        "страх прошёл"
                    ],
                    "target_lang_definitions": {
                        "en": "To cease, to stop, or to go away (referring to pain, illness, rain, etc.).",
                        "zh": "指疼痛、疾病、雨水等停止、消失或结束。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to cease or fade (pain, state)"
                            },
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to end (rain, weather)"
                            },
                            {
                                "target_lang_word": "go away",
                                "target_lang_sense_clarification": "to disappear (pain, symptoms)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消失",
                                "target_lang_sense_clarification": "指疼痛或症状不再存在"
                            },
                            {
                                "target_lang_word": "停止",
                                "target_lang_sense_clarification": "指雨水或天气状况结束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a909597c-b89a-3e63-9ee1-9a7d9ee648bd",
                    "sense_definition": "Подвергнуться проверке, испытанию, досмотру и получить одобрение или допуск.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все пассажиры должны <пройти> паспортный контроль.",
                            "target_lang_translations": {
                                "en": "All passengers must <go through> passport control.",
                                "zh": "所有乘客都必须<w>通过</w>护照检查。"
                            }
                        },
                        {
                            "text": "Кандидат успешно <прошёл> собеседование на новую должность.",
                            "target_lang_translations": {
                                "en": "The candidate successfully <passed> the interview for the new position.",
                                "zh": "候选人成功<w>通过</w>了新职位的面试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сдать"
                    ],
                    "antonyms": [
                        "провалить"
                    ],
                    "common_phrases": [
                        "пройти контроль",
                        "пройти тест",
                        "пройти проверку",
                        "пройти собеседование"
                    ],
                    "target_lang_definitions": {
                        "en": "To undergo a check, test, or inspection and receive approval or clearance.",
                        "zh": "接受检查、测试或审查并获得批准或准入。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to succeed in a test or inspection"
                            },
                            {
                                "target_lang_word": "go through",
                                "target_lang_sense_clarification": "to undergo a check or control"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "在测试或检查中获得成功"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "经历某项检查或程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c4fee8d-6ee3-3aa9-a021-23c22a8f4953",
                    "sense_definition": "Состояться, произойти (о собрании, мероприятии, событии).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Встреча выпускников <прошла> в тёплой атмосфере.",
                            "target_lang_translations": {
                                "en": "The alumni meeting <went> well in a warm atmosphere.",
                                "zh": "校友聚会在温馨的气氛中<w>进行</w>。"
                            }
                        },
                        {
                            "text": "Вчера в городе <прошёл> концерт известной группы.",
                            "target_lang_translations": {
                                "en": "A concert by a famous band <took place> in the city yesterday.",
                                "zh": "昨天城里<w>举行</w>了一场著名乐队的音乐会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "состояться",
                        "произойти"
                    ],
                    "common_phrases": [
                        "встреча прошла",
                        "концерт прошёл",
                        "всё прошло хорошо"
                    ],
                    "target_lang_definitions": {
                        "en": "To take place or happen (referring to a meeting, event, or occasion).",
                        "zh": "指会议、活动或事件发生或进行。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take place",
                                "target_lang_sense_clarification": "to happen"
                            },
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "to proceed in a certain manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "举行",
                                "target_lang_sense_clarification": "指活动发生"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "指过程的开展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b55f759-9aef-3cee-96fd-dd525b1ff0c1",
                    "sense_definition": "Изучить что-либо, ознакомиться с чем-либо в процессе обучения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ещё не <проходили> эту тему на уроках физики.",
                            "target_lang_translations": {
                                "en": "We haven't <covered> this topic in physics class yet.",
                                "zh": "我们在物理课上还没<w>学习</w>这个主题。"
                            }
                        },
                        {
                            "text": "За этот семестр студенты <прошли> большой объём материала.",
                            "target_lang_translations": {
                                "en": "During this semester, the students <covered> a large amount of material.",
                                "zh": "这个学期学生们<w>学习</w>了大量的材料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "пройти тему",
                        "пройти курс",
                        "пройти материал"
                    ],
                    "target_lang_definitions": {
                        "en": "To study something or cover material during the learning process.",
                        "zh": "在学习过程中研究或学习某项内容。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "to deal with a topic"
                            },
                            {
                                "target_lang_word": "study",
                                "target_lang_sense_clarification": "to learn about"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学习",
                                "target_lang_sense_clarification": "掌握知识"
                            },
                            {
                                "target_lang_word": "讲授",
                                "target_lang_sense_clarification": "涵盖教学内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f439b3c-a2d3-3f12-b23c-2e5dad3a39fb",
                    "sense_definition": "Пролечь, протянуться в каком-либо направлении (о дороге, пути, линии).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новая скоростная трасса <пройдёт> через лес.",
                            "target_lang_translations": {
                                "en": "The new highway will <run> through the forest.",
                                "zh": "新的高速公路将<w>穿过</w>森林。"
                            }
                        },
                        {
                            "text": "Тропинка <прошла> вдоль берега реки и свернула в поле.",
                            "target_lang_translations": {
                                "en": "The path <ran> along the river bank and turned into the field.",
                                "zh": "小路沿着河岸<w>延伸</w>并转入了田野。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пролечь",
                        "протянуться"
                    ],
                    "common_phrases": [
                        "дорога пройдёт",
                        "путь пройдёт"
                    ],
                    "target_lang_definitions": {
                        "en": "To extend or stretch in a certain direction (referring to a road, path, or line).",
                        "zh": "指道路、路径或线路向某个方向延伸。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to extend in a direction"
                            },
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to go through an area"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "延伸",
                                "target_lang_sense_clarification": "向某方向伸展"
                            },
                            {
                                "target_lang_word": "经过",
                                "target_lang_sense_clarification": "穿过某区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "246473f1-a35c-3d4b-b6f8-449ab11df00f",
                    "sense_definition": "Распространиться, стать известным (о слухах, новостях, информации).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По всему городу <прошёл> слух о скором закрытии завода.",
                            "target_lang_translations": {
                                "en": "A rumor <spread> throughout the city about the factory's imminent closure.",
                                "zh": "工厂即将关闭的传闻在全城<w>流传</w>开来。"
                            }
                        },
                        {
                            "text": "В прессе <прошла> информация о новых налогах.",
                            "target_lang_translations": {
                                "en": "Information about new taxes <appeared> in the press.",
                                "zh": "关于新税收的消息在媒体上<w>传播</w>开来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "распространиться"
                    ],
                    "common_phrases": [
                        "прошёл слух",
                        "прошла новость"
                    ],
                    "target_lang_definitions": {
                        "en": "To spread or become known (referring to rumors, news, or information).",
                        "zh": "指谣言、新闻或信息传播开来或为人所知。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spread",
                                "target_lang_sense_clarification": "to become widely known"
                            },
                            {
                                "target_lang_word": "circulate",
                                "target_lang_sense_clarification": "to move around (rumors)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传播",
                                "target_lang_sense_clarification": "广为人知"
                            },
                            {
                                "target_lang_word": "流传",
                                "target_lang_sense_clarification": "在人群中传开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50cbe8b9-5cd2-317d-9fe3-1891845994f0",
                    "sense_definition": "Прорыть, прокопать (в горном деле или строительстве).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Шахтёры <прошли> новый штрек за рекордное время.",
                            "target_lang_translations": {
                                "en": "The miners <dug> a new drift in record time.",
                                "zh": "矿工们以创纪录的时间<w>开凿</w>了一条新巷道。"
                            }
                        },
                        {
                            "text": "Строителям удалось <пройти> тоннель сквозь гору.",
                            "target_lang_translations": {
                                "en": "The builders managed to <cut> a tunnel through the mountain.",
                                "zh": "建筑工人们成功地<w>挖掘</w>了一条穿过大山的隧道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "прорыть",
                        "пробурить",
                        "прокопать"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "горное дело"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To dig or excavate (in mining or construction).",
                        "zh": "在采矿或建筑中挖掘或开凿。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dig",
                                "target_lang_sense_clarification": "to excavate"
                            },
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to bore a tunnel"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挖掘",
                                "target_lang_sense_clarification": "开凿土石"
                            },
                            {
                                "target_lang_word": "开凿",
                                "target_lang_sense_clarification": "打通隧道"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}