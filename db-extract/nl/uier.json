                    {
                        "translation_id": "b0329051-4f6d-4db2-93f1-7f5fe72c900a",
                        "source_entry_id": "7c4ba11e-31cb-3f48-b383-8efb09971aab",
                        "source_sense_id": "30f842ab-a594-37ac-bef1-8332e01f7766",
