                                    {
                                        "sense_id": "7d579991-9eff-3877-ab58-192fc89f6a20",
                                        "entry_id": "4157a91e-7370-30ee-9517-02319dd735ca",
                                        "glosses": [
                                            "Annona muricata boom uit de familie Annonaceae die grote sappige vruchten voortbrengt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed496287-a4eb-44b5-b46f-41c5a8b6fc88",
                                                "sense_id": "7d579991-9eff-3877-ab58-192fc89f6a20",
                                                "text": "Cora groeide op in de schaduw van een zuurzakboom die eens in de zeven jaar vrucht droeg."
                                            },
                                            {
                                                "example_id": "0745e734-81f0-4800-ab64-15e6a356efa7",
                                                "sense_id": "7d579991-9eff-3877-ab58-192fc89f6a20",
                                                "text": "De knaap die pruimt, wisselt fluisterend een paar woorden met Ciríaco, gaat naar de schuur en komt terug met een voorhamer en een nog groen blok hout van een zuurzakboom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "271f13f9-4b09-4d20-b5a1-efc6839a0652",
                        "source_entry_id": "d552280d-431f-3e65-8d35-6c9d992bdd7c",
                        "source_sense_description": "tree",
