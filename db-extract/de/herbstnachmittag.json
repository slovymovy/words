                    {
                        "sense_id": "5bdcc05b-396d-3ef6-a1d7-bc74173dc5f6",
                        "entry_id": "e76b7ad3-cd3c-3b41-b1e8-7d2e8bd2f8af",
                        "glosses": [
                            "Nachmittag im Herbst"
