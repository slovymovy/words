                        "cross_references": [
                            {
                                "target_word": "Süßwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce735a80-fcf2-3f35-a292-232ac0e9eb4f",
                                        "entry_id": "c91e839f-4621-39a3-a2be-fd3db6a706f5",
                                        "glosses": [
                                            "natürlich vorkommendes Wasser ohne nennenswerten Salzgehalt; Regenwasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3aa60f-5a2f-4de8-a017-14628f7378e5",
                                                "sense_id": "ce735a80-fcf2-3f35-a292-232ac0e9eb4f",
                                                "text": "Viele Fische können nur im Süßwasser leben."
                                            },
                                            {
                                                "example_id": "8cb2fc59-59ae-4f08-9ee7-4cf3b00bbc07",
                                                "sense_id": "ce735a80-fcf2-3f35-a292-232ac0e9eb4f",
                                                "text": "„Bill Swett war an Bord, und wir begegneten uns damals zum ersten Mal auf Süßwasser.“"
                                            },
                                            {
                                                "example_id": "069c2520-b85d-4031-ac05-7daa2877b07b",
                                                "sense_id": "ce735a80-fcf2-3f35-a292-232ac0e9eb4f",
                                                "text": "„Zum Glück hatte sich am Südende des Grant-Sees noch ein kleines Wasserreservoir erhalten, sonst hätten die Siedler keinen Tropfen Süßwasser mehr gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5f28512-712c-4214-9b0b-ac38906fc0ae",
                        "source_entry_id": "9b18ce49-8fea-33b5-8bf1-170be516de7d",
                        "source_sense_id": "de6f039b-092f-3211-9d90-144452b75bd1",
