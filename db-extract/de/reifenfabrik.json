                "senses": [
                    {
                        "sense_id": "c17a33ec-b3c0-33c3-a187-60bff19194f4",
                        "entry_id": "a3b0a14e-4e6d-31bf-ae2c-f3a17eca3db7",
                        "glosses": [
                            "Fabrik, in der Reifen hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c251c6-4ecc-4467-bafd-2b6a5e887bb6",
                                "sense_id": "c17a33ec-b3c0-33c3-a187-60bff19194f4",
                                "text": "„Jede menschliche Unternehmung, von Reifenfabriken bis Gemüsefarmen, stand unter der Obhut des Lehens eines örtlichen Prinzen.“"
                            },
                            {
                                "example_id": "d21a8e77-2b6b-489e-a83e-81fc572b9f47",
                                "sense_id": "c17a33ec-b3c0-33c3-a187-60bff19194f4",
                                "text": "„Seine Wohnung ist ziemlich klein, mehr kann er sich nicht leisten. Sie stinkt nach Gummi, von der Reifenfabrik ein paar Blocks weiter, in der er die letzten sechs Wochen gearbeitet hat; das Geld hat er gespart, um sich den Wagen und das Handy zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
