{
    "word_family": [
        "karmic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aece5933-97fa-3b0b-b8cc-abf500086ea9",
                    "sense_definition": "A force or law of nature where a person's actions result in appropriate consequences; the idea of reaping what one sows.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spiritual_consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He believes that his recent string of bad luck is simply bad <w>karma</w> for his past mistakes.",
                            "target_lang_translations": {
                                "ru": "Он верит, что его недавняя череда неудач — это просто плохая <w>карма</w> за его прошлые ошибки."
                            }
                        },
                        {
                            "text": "Helping the stranger was a way to earn some good <w>karma</w> for the future.",
                            "target_lang_translations": {
                                "ru": "Помощь незнакомцу была способом заработать немного хорошей <w>кармы</w> на будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "fate",
                        "destiny",
                        "retribution"
                    ],
                    "common_phrases": [
                        "good karma",
                        "bad karma",
                        "instant karma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила или закон природы, согласно которому действия человека приводят к соответствующим последствиям; идея о том, что каждый пожинает то, что посеял."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карма",
                                "target_lang_sense_clarification": "причинно-следственная связь"
                            },
                            {
                                "target_lang_word": "возмездие",
                                "target_lang_sense_clarification": "за содеянное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f860eba-aeae-34d0-82c1-81b498570eb1",
                    "sense_definition": "In Eastern religions, the sum of a person's actions in this and previous states of existence, viewed as deciding their fate in future existences.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritual_consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many traditions, <w>karma</w> determines the form in which a soul is reborn.",
                            "target_lang_translations": {
                                "ru": "Во многих традициях <w>карма</w> определяет форму, в которой возродится душа."
                            }
                        },
                        {
                            "text": "The monk explained how the cycle of <w>karma</w> affects our journey through samsara.",
                            "target_lang_translations": {
                                "ru": "Монах объяснил, как цикл <w>кармы</w> влияет на наше путешествие через сансару."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cycle of karma"
                    ],
                    "target_lang_definitions": {
                        "ru": "В восточных религиях — совокупность действий человека в этом и предыдущих состояниях существования, определяющая его судьбу в будущих воплощениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карма",
                                "target_lang_sense_clarification": "религиозное понятие"
                            },
                            {
                                "target_lang_word": "закон кармы",
                                "target_lang_sense_clarification": "духовный закон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4a8657-3664-3fa6-aaba-8b4a71dc3a54",
                    "sense_definition": "A distinctive feeling, aura, or atmosphere associated with a person or place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer focused on the lighting to improve the <w>karma</w> of the room.",
                            "target_lang_translations": {
                                "ru": "Дизайнер сосредоточился на освещении, чтобы улучшить <w>ауру</w> комнаты."
                            }
                        },
                        {
                            "text": "You can often feel the <w>karma</w> of a place change when a confrontation is building up.",
                            "target_lang_translations": {
                                "ru": "Часто можно почувствовать, как меняется <w>энергетика</w> места, когда назревает конфликт."
                            }
                        }
                    ],
                    "synonyms": [
                        "vibe",
                        "aura",
                        "atmosphere",
                        "energy"
                    ],
                    "common_phrases": [
                        "karma of the room"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe vibes or energy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое чувство, аура или атмосфера, связанная с человеком или местом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аура",
                                "target_lang_sense_clarification": "атмосфера места или человека"
                            },
                            {
                                "target_lang_word": "энергетика",
                                "target_lang_sense_clarification": "вайб или настрой"
                            },
                            {
                                "target_lang_word": "карма",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6007817-9773-3efa-9ae6-f5394dea9464",
                    "sense_definition": "A score or points assigned to a user on online forums indicating their reputation or the popularity of their posts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "digital_reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a high <w>karma</w> score because he consistently provides helpful answers on the forum.",
                            "target_lang_translations": {
                                "ru": "У него высокий показатель <w>кармы</w>, потому что он постоянно дает полезные ответы на форуме."
                            }
                        },
                        {
                            "text": "Posting controversial comments can quickly lead to a loss of <w>karma</w> on this website.",
                            "target_lang_translations": {
                                "ru": "Публикация спорных комментариев на этом сайте может быстро привести к потере <w>кармы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reputation",
                        "points",
                        "score"
                    ],
                    "common_phrases": [
                        "reddit karma",
                        "earn karma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очки или баллы, присваиваемые пользователю на онлайн-форумах, указывающие на его репутацию или популярность его постов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карма",
                                "target_lang_sense_clarification": "рейтинг на форуме"
                            },
                            {
                                "target_lang_word": "репутация",
                                "target_lang_sense_clarification": "в цифровой среде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3f7b84dc-13d7-345b-927a-8a2156408ed4",
                    "sense_definition": "A female given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The teacher called on <w>Karma</w> to read her essay to the rest of the class.",
                            "target_lang_translations": {
                                "ru": "Учитель вызвал <w>Карму</w>, чтобы она прочитала свое эссе остальному классу."
                            }
                        },
                        {
                            "text": "I met a woman named <w>Karma</w> while I was traveling through the mountains.",
                            "target_lang_translations": {
                                "ru": "Во время путешествия по горам я встретил женщину по имени <w>Карма</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Карма",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}