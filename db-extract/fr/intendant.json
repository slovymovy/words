                                        "sense_id": "4bb292c4-695e-37a9-bc51-aa719baae27c",
                                        "entry_id": "5f717c71-9661-3e4e-8d93-5ca621a771a0",
                                        "glosses": [
                                            "One who administers affairs; one who directs, manages, executes, or dispenses, whether in civil, judicial, political, or ecclesiastical affairs; a manager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfc2b66-ca65-444c-ab19-475e66ad72a5",
                                                "sense_id": "4bb292c4-695e-37a9-bc51-aa719baae27c",
                                                "text": "Kraft Heinz said the new products will be available nationwide to all school administrators to procure and offer to students either for purchase in the lunchroom – though the company did not disclose the cost to schools – or for free through the National School Lunch Program (NSLP)."
                                            },
                                            {
                                                "example_id": "579c1f1e-cc66-449c-99f2-aab8aac5aea8",
                                                "sense_id": "4bb292c4-695e-37a9-bc51-aa719baae27c",
                                                "text": "Amy Gleason is the acting administrator of the US DOGE Service, the agency that houses the temporary Department of Government Efficiency, a White House official told CNN on Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b279c2c-f87f-3e76-ad01-95dd8869c72d",
                                        "entry_id": "5f717c71-9661-3e4e-8d93-5ca621a771a0",
                                        "glosses": [
                                            "A person who manages or settles the estate of an intestate, or of a testator when there is no competent executor; one to whom the right of administration has been committed by competent authority"
                                        ],
