                "senses": [
                    {
                        "sense_id": "98ba997b-1882-36f6-a902-6d5467340594",
                        "entry_id": "d188a51e-cbdd-3115-8afb-2d44b4d10e49",
                        "glosses": [
                            "Fleck aufgrund von Schimmelbefall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f1628f-52c6-459d-a46d-2315c944e851",
                                "sense_id": "98ba997b-1882-36f6-a902-6d5467340594",
                                "text": "„Es hatte Hausangestellte gegeben - vor allem Ann White -, die sich weigerten, die Küche im Keller zu benutzen, und mindestens drei Aussagen bezogen sich konkret auf die gleichsam menschlichen oder teuflischen Umrisse, die Baumwurzeln oder Schimmelflecken in diesem Bereich bildeten.“"
                            },
                            {
                                "example_id": "57663f4b-e401-46dc-9cd1-cb040e949a8f",
                                "sense_id": "98ba997b-1882-36f6-a902-6d5467340594",
                                "text": "„Als sie schließlich mit ihrem Koffer auf dem Zimmer war, einem deprimierenden kleinen Kabuff mit Schimmelflecken an der Decke, war es zwanzig nach zehn.“"
                            },
                            {
                                "example_id": "ee660977-45b1-45e9-8aa3-c72bed403ea0",
                                "sense_id": "98ba997b-1882-36f6-a902-6d5467340594",
                                "text": "„Auf seinen Knien eine silberne Mylar-Tüte mit Chicken Marsala, der blaue Teppich um ihn herum mit dunklen Schimmelflecken übersät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
