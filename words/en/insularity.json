                    "sense_id": "7013fc79-d05f-36bd-942d-a1b1a4e8c369",
                    "sense_definition": "The state of being narrow-minded or uninterested in ideas and cultures outside of one's own experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narrow-mindedness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>insularity</w> of the small village made it difficult for newcomers to feel welcome or accepted.",
                            "target_lang_translations": {
                                "ru": "<w>Замкнутость</w> маленькой деревни мешала новичкам чувствовать себя желанными гостями или принятыми в общество."
                            }
                        },
                        {
                            "text": "Critics often point to the <w>cultural</w> <w>insularity</w> of the film industry as a reason for its lack of diversity.",
                            "target_lang_translations": {
                                "ru": "Критики часто указывают на культурную <w>обособленность</w> киноиндустрии как на причину отсутствия в ней разнообразия."
                            }
                        }
                    ],
                    "synonyms": [
                        "narrow-mindedness",
                        "parochialism",
                        "isolationism",
                        "provincialism"
                    ],
                    "antonyms": [
                        "open-mindedness",
                        "cosmopolitanism",
                        "broad-mindedness"
                    ],
                    "common_phrases": [
                        "cultural insularity",
                        "academic insularity",
                        "degree of insularity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ограниченности или отсутствия интереса к идеям и культурам, выходящим за рамки собственного опыта."
                    },
