                                    },
                                    {
                                        "sense_id": "80518c61-ec19-38f4-880e-5f34b10074f2",
                                        "entry_id": "a08051e2-fc70-35f8-b7dc-13e8766d728b",
                                        "glosses": [
                                            "Based in a particular place; on hand; local."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8928b36-b8c1-4148-9311-c583b38ef0fa",
                                                "sense_id": "80518c61-ec19-38f4-880e-5f34b10074f2",
                                                "text": "He is our resident computer expert."
                                            },
                                            {
                                                "example_id": "a5013a1b-7498-4516-b4f5-27ccbe6b68b3",
                                                "sense_id": "80518c61-ec19-38f4-880e-5f34b10074f2",
                                                "text": "Across the country, around 180 Class 08/09s are still registered with main line operators and spot hire companies as well as at various industrial sites, while around 70 more are resident at heritage railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ca6bb4-1dc8-37b9-b284-991536230350",
                                        "entry_id": "a08051e2-fc70-35f8-b7dc-13e8766d728b",
                                        "glosses": [
                                            "Fixed; stable; certain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
