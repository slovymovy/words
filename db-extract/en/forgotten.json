                        ]
                    },
                    {
                        "translation_id": "648d4f62-fbb9-4c97-9005-b79e75a808dc",
                        "source_entry_id": "c6b509cd-0aac-3c3d-b272-0322d0b81513",
                        "source_sense_id": "e993654d-0afe-3225-b86a-6db971c8c660",
                        "source_sense_description": "of which knowledge has been lost, which is no longer remembered",
                        "target_lang_word": "vergessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dac4798a-0637-3c10-a1c7-38f95fcee952",
                                        "entry_id": "a355e1d3-dc50-30b3-8ba1-eee51848c9d4",
                                        "glosses": [
                                            "in Moment/bestimmter Situation nicht daran gedacht, nicht daran erinnert"
                                        ],
                                        "tags": [
                                            "kStg."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cf1ea19-2f56-4e4a-a722-3c02e7b93953",
                                                "sense_id": "dac4798a-0637-3c10-a1c7-38f95fcee952",
                                                "text": "„Jede ist für die andere da. Ob es mal ein vergessener Einkauf ist oder ein Auto in die Werkstatt muss.“"
                                            },
                                            {
                                                "example_id": "d4fb914b-2bc7-47ba-a00f-83cce042eefd",
                                                "sense_id": "dac4798a-0637-3c10-a1c7-38f95fcee952",
                                                "text": "„In meinem Handy ist der Schlüsselnotdienst meiner Heimatstadt Jülich an dritter Stelle programmiert - was wenig hilfreich ist, wenn sich der vergessene Schlüssel in meiner vergessenen Tasche mit dem vergessenen Handy befindet.“"
                                            },
                                            {
                                                "example_id": "1021b362-90aa-4fc5-b6d5-670ab08ac5a2",
                                                "sense_id": "dac4798a-0637-3c10-a1c7-38f95fcee952",
                                                "text": "„Dann gehören vergessene Schlüssel der Vergangenheit an – es sei denn, Ihr Unbewusstes will sie […] vergessen.“"
                                            },
                                            {
                                                "example_id": "566882ef-d6a4-4a86-86b6-07d7e9727e53",
                                                "sense_id": "dac4798a-0637-3c10-a1c7-38f95fcee952",
                                                "text": "„Ein Dritter, der sich vergessene Sachen zueignet, bricht also stets fremden Gewahrsam und verwirklicht so den objektiven Tatbestand de § 242.“"
                                            },
                                            {
                                                "example_id": "07732f58-9755-473a-a034-399dda52387f",
                                                "sense_id": "dac4798a-0637-3c10-a1c7-38f95fcee952",
                                                "text": "„Am Anfang stehen kleine Fehler wie vergessene Termine, der verlorene Schlüssel oder die Situation, in ein Zimmer zu kommen und nicht mehr zu wissen, was man dort eigentlich wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9323bdd2-6d44-31fd-9007-a2650087e122",
                                        "entry_id": "a355e1d3-dc50-30b3-8ba1-eee51848c9d4",
                                        "glosses": [
                                            "(lange) nicht mehr bekannt/beachtet/wahrgenommen, für längere Zeit ganz und gar aus dem Sinn gekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cb167d-595e-429a-8a40-7ddbc3452cf2",
                                                "sense_id": "9323bdd2-6d44-31fd-9007-a2650087e122",
                                                "text": "„Die Hälfte [des Weges] gehen Sie […] in vollem Bewusstsein und geben sich dem Vergnügen an Ihren kleinen, längst vergessenen Sinnesempfindungen hin.“"
                                            },
                                            {
                                                "example_id": "b7ce08df-8f17-4a02-a016-539fa66cf23d",
                                                "sense_id": "9323bdd2-6d44-31fd-9007-a2650087e122",
                                                "text": "„Der des Mordes an seinem Lehrer angeklagte Protagonist erklärt hier seine Tat vor Gericht mit vergessenen Kinheitserlebnissen.“"
                                            },
                                            {
                                                "example_id": "c52612d9-0b4f-4080-af2b-7d50b6165d43",
                                                "sense_id": "9323bdd2-6d44-31fd-9007-a2650087e122",
                                                "text": "„Und doch finden wir in Deutschland noch eine Fülle von Motiven in vergessenen Gegenden mit vergessenen Bauten, die unsere Aufmerksamkeit zu fesseln geeignet sind […]. Eine solche für die Architektur nahezu vergessene Gegend ist das Werrathal […].“"
                                            },
                                            {
                                                "example_id": "be3edf99-39fd-418d-b41c-1b8e9dec29aa",
                                                "sense_id": "9323bdd2-6d44-31fd-9007-a2650087e122",
                                                "text": "„Im Drucke gab er heraus den ‚Versuch einer Literargeschichte des österreichischen Privatrechts‘ (Wien 1804), das […] ein zwar schon vergessenes, aber noch immer brauchbares Handbuch ist.“"
                                            },
                                            {
                                                "example_id": "a135515a-79f6-4c30-b07b-559f72969703",
                                                "sense_id": "9323bdd2-6d44-31fd-9007-a2650087e122",
                                                "text": "Die Kenntniss dieser Dinge ist so sehr verdunkelt, dass selbst viele fromme Priester die alten Bilder in ihren eigenen Kirchen nicht mehr verstehen, und dass gerade die schönsten und geistreichsten Abhandlungen und Homilien der Kirchenväter und Mystiker […] zu den vergessensten Dingen im ganzen Bereiche des menschlichen Wissens gehören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "vergessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01f76116-1ae8-314f-80fa-29fd6873904d",
                                        "entry_id": "03bd78df-16f8-3fdc-bdda-52b80525acf4",
                                        "glosses": [
                                            "sich an etwas, jemanden nicht mehr erinnern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3470dea8-0061-4033-a55f-17114deea827",
                                                "sense_id": "01f76116-1ae8-314f-80fa-29fd6873904d",
                                                "text": "Unglücklicherweise vergaß er ihrer nach all den Jahren. (veraltend)"
                                            },
                                            {
                                                "example_id": "a622dac9-d2f5-4dbe-91ef-030cbe5c047b",
                                                "sense_id": "01f76116-1ae8-314f-80fa-29fd6873904d",
                                                "text": "Sie wollen sich andererseits betrinken, um zu vergessen, daß alles nicht so weiter geht, in infinitum."
                                            },
                                            {
                                                "example_id": "6efeaa6b-f1d2-4f0f-8379-10385d9ef337",
                                                "sense_id": "01f76116-1ae8-314f-80fa-29fd6873904d",
                                                "text": "Nach ein paar Augenblicken schon hatte er die Gesellschaft vergessen, die schnell hinter dem Vorgebirge verschwunden war, als er in seiner Nähe das Rascheln eines Kleides und leichte Tritte hörte."
                                            },
                                            {
                                                "example_id": "0d41ca39-e2df-42b5-bed1-eb872255d85b",
                                                "sense_id": "01f76116-1ae8-314f-80fa-29fd6873904d",
                                                "text": "Das Geld genügt, um Maria die Zukunft zu sichern, ihr späterhin ein Geschäft einzurichten und sie die Vergangenheit vergessen zu lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b1ce751-8993-3487-b336-a10e3644b095",
                                        "entry_id": "03bd78df-16f8-3fdc-bdda-52b80525acf4",
                                        "glosses": [
                                            "die Beherrschung verlieren"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "104c06b1-e8ab-48ec-99a2-1340c34365ab",
                                                "sense_id": "1b1ce751-8993-3487-b336-a10e3644b095",
                                                "text": "Die versteckte ist immer ein bißchen fies, ja fast anrüchig und eindeutig unfair, die offene Kamera aber, vor der gleichwohl der Mensch sich vergißt, weil, was ihn um die Beherrschung brachte, stärker war als der telegene Selbstzwang - erst sie liefert Dokumente von moralisch einwandfreier Allzumenschlichkeit."
                                            },
                                            {
                                                "example_id": "460e6e40-2589-4411-b7a8-2a1d070fd3df",
                                                "sense_id": "1b1ce751-8993-3487-b336-a10e3644b095",
                                                "text": "Als Günther Koch am letzten Spieltag der Saison 1998/99 sich vergaß und schrie: »Ich pack das nicht, ich halt das nicht mehr aus!«, da war das aus dem Augenblick heraus geboren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e2d071ea-2ddb-39d8-be51-a5c7d545bb0a",
                                        "entry_id": "03bd78df-16f8-3fdc-bdda-52b80525acf4",
                                        "glosses": [
                                            "an etwas, jemanden nicht denken"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "transitive",
                                            "with-accusative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb231a43-46ec-4dc8-96f1-ffbf2bf04b9a",
                                                "sense_id": "e2d071ea-2ddb-39d8-be51-a5c7d545bb0a",
                                                "text": "„Viele der 200.000 Pendler, die derzeit täglich mit dem Auto in die Stadt kommen und bisher teils kostenlos parken konnten, müssen bis zum kommenden Jahr zum Umstieg auf Öffis bewegt werden. Auf sie darf Wien nicht vergessen – und den Ausbau von öffentlichen Verkehrsmitteln und Park-&-ride-Anlagen nicht nur Niederösterreich überlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
