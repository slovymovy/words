                                "zh": "她每周二下午都<w>去</w>图书馆。"
                            }
                        },
                        {
                            "text": "My brother <goes> to school by bus.",
                            "target_lang_translations": {
                                "ru": "Мой брат <ездит> в школу на автобусе.",
                                "zh": "我弟弟乘公交车<w>去</w>上学。"
                            }
