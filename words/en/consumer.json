{
    "word_family": [
        "consume",
        "consumption",
        "consumerism",
        "consumable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4127e714-4004-3666-92e5-495310811437",
                    "sense_definition": "Someone who trades money for goods or services as an individual.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "economic_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new system favours the <w>consumer</w> over the producer.",
                            "target_lang_translations": {
                                "ru": "Эта новая система отдает предпочтение <w>потребителю</w> перед производителем.",
                                "zh": "这一新制度比起生产者更偏向<w>消费者</w>。"
                            }
                        },
                        {
                            "text": "Many <w>consumers</w> check online reviews before buying expensive electronic goods.",
                            "target_lang_translations": {
                                "ru": "Многие <w>потребители</w> проверяют отзывы в интернете перед покупкой дорогой электроники.",
                                "zh": "许多<w>消费者</w>在购买昂贵的电子产品前会查看在线评论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buyer",
                        "customer",
                        "shopper",
                        "purchaser",
                        "user",
                        "client"
                    ],
                    "antonyms": [
                        "producer"
                    ],
                    "common_phrases": [
                        "consumer goods",
                        "consumer protection",
                        "consumer rights",
                        "consumer spending",
                        "consumer demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который приобретает товары или услуги для личного пользования.",
                        "zh": "指购买商品或服务以供个人使用的个人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потребитель",
                                "target_lang_sense_clarification": "покупатель товаров и услуг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消费者",
                                "target_lang_sense_clarification": "购买商品或服务的人"
                            },
                            {
                                "target_lang_word": "顾客",
                                "target_lang_sense_clarification": "商店或服务的客户"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32d6b7e2-2219-3cca-bb4e-8de7f7d479b6",
                    "sense_definition": "An organism that feeds on other plants or animals to gain energy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a simple food chain, the rabbit is a primary <w>consumer</w> that eats grass.",
                            "target_lang_translations": {
                                "ru": "В простой пищевой цепи кролик является первичным <w>потребителем</w>, который питается травой.",
                                "zh": "在简单的食物链中，兔子是吃草的初级<w>消费者</w>。"
                            }
                        },
                        {
                            "text": "Plants act as producers, while animals function as <w>consumers</w> within the ecosystem.",
                            "target_lang_translations": {
                                "ru": "Растения выступают в роли производителей, тогда как животные функционируют как <w>потребители</w> в экосистеме.",
                                "zh": "在生态系统中，植物充当生产者，而动物则作为<w>消费者</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "producer"
                    ],
                    "common_phrases": [
                        "primary consumer",
                        "secondary consumer",
                        "tertiary consumer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организм, который питается другими растениями или животными для получения энергии.",
                        "zh": "指通过摄取其他植物或动物来获取能量的生物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потребитель",
                                "target_lang_sense_clarification": "организм в пищевой цепи"
                            },
                            {
                                "target_lang_word": "консумент",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消费者",
                                "target_lang_sense_clarification": "生态学中指异养生物"
                            },
                            {
                                "target_lang_word": "异养生物",
                                "target_lang_sense_clarification": "生物学专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dd7249d-0298-3910-8a84-02f735a7c34c",
                    "sense_definition": "A person or thing that uses a resource, such as fuel or energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old factories are often heavy <w>consumers</w> of electricity and water.",
                            "target_lang_translations": {
                                "ru": "Старые заводы часто являются крупными <w>потребителями</w> электроэнергии и воды.",
                                "zh": "老旧工厂往往是电力和水资源的大型<w>消耗者</w>。"
                            }
                        },
                        {
                            "text": "The large engine is a massive <w>consumer</w> of fuel compared to modern alternatives.",
                            "target_lang_translations": {
                                "ru": "Этот большой двигатель является огромным <w>потребителем</w> топлива по сравнению с современными альтернативами.",
                                "zh": "与现代替代品相比，这款大型发动机是燃料的巨大<w>消耗者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "user"
                    ],
                    "antonyms": [
                        "producer"
                    ],
                    "common_phrases": [
                        "energy consumer",
                        "heavy consumer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или устройство, потребляющее ресурсы, например топливо или энергию.",
                        "zh": "指使用燃料或能源等资源的人或设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потребитель",
                                "target_lang_sense_clarification": "пользователь ресурсов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消耗者",
                                "target_lang_sense_clarification": "指消耗资源的对象"
                            },
                            {
                                "target_lang_word": "用户",
                                "target_lang_sense_clarification": "指使用资源的主体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}