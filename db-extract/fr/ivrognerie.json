                                "target_senses": [
                                    {
                                        "sense_id": "a2b2ce8d-1d4a-37a3-987f-324b865ebad6",
                                        "entry_id": "04233f4e-2023-30ac-aa30-d41b8e754b4d",
                                        "glosses": [
                                            "разг., собир. неодобр. люди, регулярно употребляющие алкогольные напитки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded9d2b6-351e-452b-8af6-c5fe0eb11fd7",
                                                "sense_id": "a2b2ce8d-1d4a-37a3-987f-324b865ebad6",
                                                "text": "Но скоро люди научились бороться с цингой, наторели плавать на лодках и кунгасах, реже выпадали за борт, не лазили дуром по тундре, в бараке извелась пьянь и блатняки."
                                            },
                                            {
                                                "example_id": "e50048d1-eb33-4210-8fbc-da47f2bf97ac",
                                                "sense_id": "a2b2ce8d-1d4a-37a3-987f-324b865ebad6",
                                                "text": "Ловко ты сообразила, что семейство Симаковых, бабники и пьянь, не смогут отличить одних грузчиков от других!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8001b00e-22f0-3274-a82f-982fb997f454",
                                        "entry_id": "04233f4e-2023-30ac-aa30-d41b8e754b4d",
                                        "glosses": [
                                            "бран. алкоголик, пьянчуга (как обращение)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6639ff04-9200-4bd2-824b-5ed6d05920f4",
                                                "sense_id": "8001b00e-22f0-3274-a82f-982fb997f454",
                                                "text": "Думаешь, я не понимаю, что я пьянь и голь, и отец у меня был пьянь и голь, и дед…"
                                            },
                                            {
                                                "example_id": "c769537c-bffc-4dac-a010-a5d699a54e63",
                                                "sense_id": "8001b00e-22f0-3274-a82f-982fb997f454",
                                                "text": "Ослушаешься ― завтра же, пьянь тыловая, в строй переведу."
                                            },
                                            {
                                                "example_id": "866b549d-152e-4af5-88a3-9fed31ec62a6",
                                                "sense_id": "8001b00e-22f0-3274-a82f-982fb997f454",
                                                "text": "Чёрт знает какая пьянь в мою квартиру вперлась и ещё что-то требовать собирается!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пьянь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea96f05-b974-3de9-abd6-e968f752265d",
                                        "entry_id": "2d451029-1003-3d26-a08c-cd050d86a90b",
                                        "glosses": [
                                            "устар. то же, что опьянение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ff1f82-5a87-4513-a0d6-6ca162d0e035",
                                                "sense_id": "8ea96f05-b974-3de9-abd6-e968f752265d",
                                                "text": "Сладко жениху предчувствовать собственной свадьбы угарную пьянь."
                                            },
                                            {
                                                "example_id": "25944925-b9f5-446b-b41e-3884943bdb62",
                                                "sense_id": "8ea96f05-b974-3de9-abd6-e968f752265d",
                                                "text": "Сквозь пьянь его это раздражало."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
