                        "glosses": [
                            "интернет. я, меня, мне (используется вместо я во всех падежах, кроме творительного)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b241643e-2db0-40c8-bc56-670ac4bc6b72",
                                "sense_id": "6eb0829c-c0ef-3b25-a781-feb04af696d6",
                                "text": "Я не болтушка! Мну — коммуникабельная персона. Гы!"
                            },
                            {
                                "example_id": "78571e05-636c-4578-9f0f-c4d5cc1d93b2",
                                "sense_id": "6eb0829c-c0ef-3b25-a781-feb04af696d6",
                                "text": "А сессия — это фикня, ну подумаешь, 2 раза в год понервничать немного, да и не особо переживаю, ну натура у мну такая."
                            },
                            {
                                "example_id": "e848c1db-a1af-4312-b45e-f15f3c7e2f47",
                                "sense_id": "6eb0829c-c0ef-3b25-a781-feb04af696d6",
                                "text": "А мну как-то не нарвтиса с вибратором."
                            }
                        ]
                    }
