                    },
                    {
                        "form_id": "ae5b0f53-8110-4667-9235-9559dbde7593",
                        "entry_id": "75ca2d14-af4e-3665-a00b-74f8488a0b49",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "изре́кши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93397dfa-7fd3-3c03-a3e9-ebd9b21fa543",
                        "entry_id": "75ca2d14-af4e-3665-a00b-74f8488a0b49",
                        "glosses": [
                            "устар., поэт. произнести, сказать (обычно с важностью, торжественно или решительно)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721a971e-90d2-475d-a241-40a6e1238d00",
                                "sense_id": "93397dfa-7fd3-3c03-a3e9-ebd9b21fa543",
                                "text": "Недаром же сказано, что мысль изречённая есть ложь"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "775bda85-efe3-4e69-a11f-a4aa0c970dfd",
                        "source_entry_id": "75ca2d14-af4e-3665-a00b-74f8488a0b49",
                        "source_sense_id": "93397dfa-7fd3-3c03-a3e9-ebd9b21fa543",
                        "target_lang_word": "proférer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proférer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                        "entry_id": "ef9c6028-c212-3ffa-b05a-a88fca3dd421",
                                        "glosses": [
                                            "Énoncer à voix haute ; dire avec force, avec véhémence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88debea-24d8-4940-aea0-572e6fca102e",
                                                "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                                "text": "Le nommé Lechat, ouvrier à Bolmont, commune de Remilly, a été arrêté ces jours derniers pour avoir proféré, dans un cabaret à Sormonne, des propos offensants envers le Président de la République."
                                            },
                                            {
                                                "example_id": "0f7be851-2adb-401a-aa9d-1f987a01301d",
                                                "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                                "text": "Lorsqu’elles virent arriver Ourson donnant la main à une jolie petite fille richement vêtue, elles furent si surprises, que ni l’une ni l’autre ne put proférer une parole."
                                            },
                                            {
                                                "example_id": "ba9ae4fb-15f4-4bf1-b22d-b0359be88b9a",
                                                "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                                "text": "— Je ne me permettrai jamais de proférer une autre opinion que la vôtre, monsieur le Grand Doyen."
                                            },
                                            {
                                                "example_id": "19233554-76a9-494a-9580-0a12098f0c74",
                                                "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                                "text": "Pas tant de chichis, proféra la grosse voix de Tacherot. Appelle-la Carmen... Ça ne la gênera pas."
                                            },
                                            {
                                                "example_id": "aecd552f-e36d-4ad8-8a70-fb5c86eef5f2",
                                                "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                                "text": "On appelle maintenant Derbo, le grand ministre de Mamma. Celui-là fait quelques difficultés pour accepter son incarnation. C'est en vain que le chœur profère son pressant appel, en vain que les mains agitent les tambourins."
                                            },
                                            {
                                                "example_id": "acacd51f-b0f2-43ca-aee6-12bf9ec7ea5e",
                                                "sense_id": "16f7f8b3-3c6d-3bc8-88aa-a9b032d0563e",
                                                "text": "Personne n’arrivait à placer un mot ni à proférer une consolation, toute la ville avait avalé sa langue dépassée par le triste sort du jeune homme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
