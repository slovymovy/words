                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c318d19-f7f0-45f2-b52f-6c7316e98436",
                                "sense_id": "bf299d95-d053-31f4-a788-283af939616a",
                                "text": "J’ai chaque jour trente cravates « vivantes », que je collectionne, décollectionne et renouvelle."
                            },
