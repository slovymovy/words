                    {
                        "form_id": "686caaa3-5e15-43a3-9adf-be8f87abe6f9",
                        "entry_id": "229da115-d4ae-34da-8262-27f5d7e8ee00",
                        "tags": [
                            "feminine"
                        ],
                        "form": "arrière-grand-mère"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                        "entry_id": "229da115-d4ae-34da-8262-27f5d7e8ee00",
                        "glosses": [
                            "Le père de l’un des grands-parents."
                        ],
                        "tags": [
                            "Famille"
                        ],
                        "examples": [
                            {
                                "example_id": "8595ba08-6973-4ed1-82cf-01d55d40ac40",
                                "sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                                "text": "Rabalan était le dernier représentant d’une famille de sorciers qui, durant plus d’un siècle, régnèrent dans Trélotte. Son arrière-grand-père, son grand-père, son père, tous ses oncles et tous ses cousins avaient été sorciers, et l’on racontait d’eux des choses terribles et merveilleuses."
                            },
                            {
                                "example_id": "7c8f6d87-c35f-4fd6-8acc-f51c52b58fc4",
                                "sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                                "text": "Il avait eu huit enfants. Le dernier, qui s'appelait Claude-Etienne et qui était né à quelques kilomètres de Lemuy, au village de Supt, fut l’arrière-grand-père de Louis Pasteur."
                            },
                            {
                                "example_id": "2c5418fd-5ad4-4e43-b6ed-c64312d95360",
                                "sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                                "text": "Mon arrière-grand-mère juive et mon arrière-grand-père palestinien ont eu neuf enfants. Ma grand-mère était l’aînée. L’histoire s'est vraiment compliquée pendant la grande révolte arabe."
                            },
                            {
                                "example_id": "2778b2ad-1e1d-4328-a0d2-815e683d465c",
                                "sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                                "text": "Certaines familles présentent des aïeux prestigieux dans le champ militaire : deux ont un arrière-grand-père maréchal de France ou général de la guerre de 1914-1918."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c07a813-7137-4d7d-887a-bee264292fa6",
                        "source_entry_id": "229da115-d4ae-34da-8262-27f5d7e8ee00",
                        "source_sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                        "target_lang_word": "Urgrossvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fef4617a-e919-4b34-b791-c1929a4afa35",
                        "source_entry_id": "229da115-d4ae-34da-8262-27f5d7e8ee00",
                        "source_sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                        "target_lang_word": "Urahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b58a80d-340d-3724-b5dc-a129a4804f01",
                                        "entry_id": "37fe5adf-243d-3370-8ce2-47cfc95e7ffe",
                                        "glosses": [
                                            "ältester bekannter Vorfahre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd7b65d-ec20-4a85-8e1e-cbbc91f7f032",
                                                "sense_id": "4b58a80d-340d-3724-b5dc-a129a4804f01",
                                                "text": "Sie konnte ihre Urahnen bis ins 17. Jahrhundert zurückverfolgen."
                                            },
                                            {
                                                "example_id": "f8a9b6a8-fc2b-44fd-bea7-8f8f415d613d",
                                                "sense_id": "4b58a80d-340d-3724-b5dc-a129a4804f01",
                                                "text": "„Es ist der Urahn aller indogermanischen Sprachen und war einst eine echte Sprache, die von echten Menschen eine Zeitlang gesprochen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29012de7-fbb1-48b1-9b8a-cb498d81d801",
                        "source_entry_id": "229da115-d4ae-34da-8262-27f5d7e8ee00",
                        "source_sense_id": "792a2983-1146-3837-aec2-13d4fbfab959",
                        "target_lang_word": "Urgroßvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urgroßvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                        "entry_id": "d29bcd32-42bf-3dbc-a2d2-8fb929bd6d79",
                                        "glosses": [
                                            "Vater von Großmutter oder Großvater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a350fb-2c9f-4834-b60e-9a2b1c8d625a",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "Mein Urgroßvater hatte einen Bart."
                                            },
                                            {
                                                "example_id": "889210f2-ad8a-480a-85c6-930dce96d134",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Johnnys Großvater, Urgroßvater, Ururgroßvater und Urururgroßvater, alle waren Schauspieler, nur sein Vater nicht.“"
                                            },
                                            {
                                                "example_id": "d063bd58-e4c4-431b-80c7-96ceeb4c0b71",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Dort saß schon Urgroßvater Jacob, der zweite Mann von Horsts Urgroßmutter mütterlicherseits, mit seiner Machorka-Pfeife.“"
                                            },
                                            {
                                                "example_id": "c474a9b4-167d-4545-9fe1-bb9d4501552f",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Er servierte Kartoffeln dazu und meinte, sich zu erinnern, dass sein Urgroßvater einmal gesagt hatte, in Kartoffeln verberge sich das Licht gefallener Sterne.“"
                                            },
                                            {
                                                "example_id": "9e2810c3-0979-4235-aa92-c4d2ac60cbe7",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Ihr Urgroßvater kam um 1910 in die damalige Kolonie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "642699c6-8627-4a0c-8272-c36482b68f9a",
                        "source_entry_id": "229da115-d4ae-34da-8262-27f5d7e8ee00",
