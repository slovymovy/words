                "senses": [
                    {
                        "sense_id": "928482f8-b210-39b3-943a-fcd8ec374071",
                        "entry_id": "f85d1033-087c-3b32-a92f-52ebe4431b46",
                        "glosses": [
                            "Petit bulbe de remplacement que produit un bulbe déjà formé et mis en terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17de247f-5871-4ac5-8a8a-75315ab3dcaa",
                                "sense_id": "928482f8-b210-39b3-943a-fcd8ec374071",
                                "text": "De gros caïeux de lis de montagne déchaussés par les pluies, paraissaient à la surface de la terre."
                            },
                            {
                                "example_id": "054e8b55-d26a-4ea7-9058-1d1cf6eb9974",
                                "sense_id": "928482f8-b210-39b3-943a-fcd8ec374071",
                                "text": "L’échalote se multiplie de caïeux qui sont mis en terre dès le premier printemps, c’est-à-dire en février-mars. Ces caïeux doivent être bien formés et fermes."
                            },
                            {
                                "example_id": "d3b3014a-59fa-4411-86e8-6a5f40c80517",
                                "sense_id": "928482f8-b210-39b3-943a-fcd8ec374071",
                                "text": "Le mois d’octobre est également le moment idéal pour planter de l’ail en utilisant le caïeu qui doit être mis à 10 centimètres de profondeur dans la terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcff25fd-38d3-3e10-9135-2db6236da3a2",
                        "entry_id": "f85d1033-087c-3b32-a92f-52ebe4431b46",
                        "glosses": [
                            "Fleur qui naît d’un de ces bulbes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8694f9fc-11c1-4d73-aa9e-86b8ec28a8d6",
                                "sense_id": "dcff25fd-38d3-3e10-9135-2db6236da3a2",
                                "text": "Cette tulipe n’est qu’un caïeu de l’année."
                            }
                        ]
                    }
