                        "glosses": [
                            "Gesamtheit aller Leitungen und Anlagen, die für die Versorgung mit Fernwärme notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0210fdcb-42cd-45ff-9161-0201069e22c3",
                                "sense_id": "49faaac2-4fb1-3df2-848d-82a58230d7a7",
                                "text": "„Der Überschuss an Windstrom an windreichen Tagen wird hier auch für die Wärmezeugung im Fernwärmenetz eingesetzt […].“"
                            },
                            {
                                "example_id": "4aaad224-4654-4d33-a8cf-e7a0475952ea",
                                "sense_id": "49faaac2-4fb1-3df2-848d-82a58230d7a7",
                                "text": "„Der Schulkomplex soll eine Hackschnitzelheizung erhalten, die über ein Fernwärmenetz das Rathaus, die Gäste-Info, das ehemalige Hotel Post, der Alpenfestsaal und die Bücherei mitversorgen soll.“"
                            }
                        ],
