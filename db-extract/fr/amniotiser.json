                "senses": [
                    {
                        "sense_id": "58006336-06b1-3b29-84f6-dcb38ab3cb5f",
                        "entry_id": "592a92d4-ca4e-342a-a848-e0354b6c74b2",
                        "glosses": [
                            "Donner un caractère amniotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e260f2c-7ff4-4f4f-ac6f-64adf80f329a",
                                "sense_id": "58006336-06b1-3b29-84f6-dcb38ab3cb5f",
                                "text": "La musique qui coule doucement, vous enveloppe, amniotise..."
                            },
                            {
                                "example_id": "61ac5d2d-c15a-48b0-89bd-584321506187",
                                "sense_id": "58006336-06b1-3b29-84f6-dcb38ab3cb5f",
                                "text": "Tu fais un gros gros mélange, tu bois un bon coup, tu te plonges dans ta baignoire tiède, presque chaude et douillette pour être certaine de mourir noyée étouffée, « amniotisée » si les médocs ne suffisaient pas."
                            },
                            {
                                "example_id": "814efc7b-e1e4-4d74-8419-58f674179814",
                                "sense_id": "58006336-06b1-3b29-84f6-dcb38ab3cb5f",
                                "text": "Admettre la précipitation en abîme d'un monde comme un abri calculé, balisé, amniotisé."
                            },
                            {
                                "example_id": "ffeb55ba-d2e8-420a-9973-a76910052820",
                                "sense_id": "58006336-06b1-3b29-84f6-dcb38ab3cb5f",
                                "text": "L'eau apaise, l'eau mange les graisses ; dans l'eau on régresse, on amniotise, on pédale dans la semoule de quarante heures, on aquaJules, on aquaJim…"
                            }
                        ]
                    }
                ],
