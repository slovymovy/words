    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ba07229e-e290-33b2-b9d5-de74fa837a38",
                    "sense_definition": "Op een moment in de nabije toekomst; later vandaag of zo dadelijk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "future_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zullen <w>straks</w> de vragen doorlopen.",
                            "target_lang_translations": {
                                "ru": "Мы <w>позже</w> разберем вопросы.",
                                "en": "We will go through the questions <w>later</w>.",
                                "pl": "Przejdziemy przez pytania <w>później</w>."
                            }
                        },
                        {
                            "text": "Ik kom <w>straks</w> even bij je langs om te praten.",
                            "target_lang_translations": {
                                "ru": "Я <w>позже</w> загляну к тебе поговорить.",
                                "en": "I'll drop by <w>later</w> to talk.",
                                "pl": "Wpadnę do ciebie <w>później</w> porozmawiać."
                            }
                        },
                        {
                            "text": "Tot <w>straks</w>, ik zie je over een uurtje!",
                            "target_lang_translations": {
                                "ru": "<w>До скорого</w>, увидимся через час!",
                                "en": "See you <w>later</w>, I'll see you in an hour!",
                                "pl": "<w>Do zobaczenia wkrótce</w>, do zobaczenia za godzinę!"
                            }
                        }
                    ],
                    "synonyms": [
                        "later",
                        "strakjes",
                        "binnenkort",
                        "zo",
                        "zometeen"
                    ],
                    "common_phrases": [
                        "tot straks"
                    ],
                    "target_lang_definitions": {
                        "ru": "В момент в ближайшем будущем; позже сегодня или с минуты на минуту.",
                        "en": "At a moment in the near future; later today or in a bit.",
                        "pl": "W bliskiej przyszłości; później dzisiaj lub za chwilę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позже",
                                "target_lang_sense_clarification": "позднее сегодня"
                            },
                            {
                                "target_lang_word": "скоро",
                                "target_lang_sense_clarification": "в ближайшее время"
                            },
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "с минуты на минуту"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "later",
                                "target_lang_sense_clarification": "at a subsequent time today"
                            },
                            {
                                "target_lang_word": "in a bit",
                                "target_lang_sense_clarification": "very soon"
                            },
                            {
                                "target_lang_word": "soon",
                                "target_lang_sense_clarification": "in the near future"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "później",
                                "target_lang_sense_clarification": "w dalszej części dzisiejszego dnia"
                            },
                            {
                                "target_lang_word": "zaraz",
                                "target_lang_sense_clarification": "za chwilę, wkrótce"
                            },
                            {
                                "target_lang_word": "wkrótce",
                                "target_lang_sense_clarification": "niedługo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6e7d4d9-3f08-39ff-bad2-334aad5fe61c",
                    "sense_definition": "Misschien of mogelijk; wordt vaak gebruikt om te waarschuwen voor een ongewenste gebeurtenis die kan plaatsvinden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility_warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zet die vaas weg, want <w>straks</w> valt hij nog kapot.",
                            "target_lang_translations": {
                                "ru": "Убери вазу, а то <w>вдруг</w> она разобьется.",
                                "en": "Put that vase away, because <w>otherwise</w> it might break.",
                                "pl": "Odstaw ten wazon, bo <w>jeszcze</w> się rozbije."
                            }
                        },
                        {
                            "text": "<w>Straks</w> denken de buren nog dat we ruzie hebben.",
                            "target_lang_translations": {
                                "ru": "<w>Вдруг</w> соседи подумают, что мы ссоримся.",
                                "en": "<w>Next thing you know</w> the neighbors will think we are fighting.",
                                "pl": "Sąsiedzi <w>gotowi</w> pomyśleć, że się kłócimy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "straks nog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможно или может быть; часто используется для предупреждения о нежелательном событии.",
                        "en": "Maybe or possibly; often used to warn about an unwanted event that might occur.",
                        "pl": "Być może lub prawdopodobnie; często używane jako ostrzeżenie przed niepożądanym zdarzeniem, które może nastąpić."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдруг",
                                "target_lang_sense_clarification": "выражение опасения"
                            },
                            {
                                "target_lang_word": "а то",
                                "target_lang_sense_clarification": "иначе может случиться"
                            },
                            {
                                "target_lang_word": "чего доброго",
                                "target_lang_sense_clarification": "не дай бог"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "otherwise",
                                "target_lang_sense_clarification": "indicating a negative consequence"
                            },
                            {
                                "target_lang_word": "or else",
                                "target_lang_sense_clarification": "warning of a result"
                            },
                            {
                                "target_lang_word": "next thing you know",
                                "target_lang_sense_clarification": "predicting an undesirable event"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "jeszcze",
                                "target_lang_sense_clarification": "w ostrzeżeniach, np. 'jeszcze się przewrócisz'"
                            },
                            {
                                "target_lang_word": "gotów",
                                "target_lang_sense_clarification": "w znaczeniu 'gotów pomyśleć' (wyrażenie obawy)"
                            },
                            {
                                "target_lang_word": "bo inaczej",
                                "target_lang_sense_clarification": "wskazując na negatywne konsekwencje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07ba89ee-8bb3-339d-8d84-b4a64ffe657c",
                    "sense_definition": "Een korte tijd geleden; daarnet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "past_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Straks</w> deed de televisie het nog gewoon.",
                            "target_lang_translations": {
                                "ru": "Телевизор <w>только что</w> работал нормально.",
                                "en": "The television was working fine <w>just now</w>.",
                                "pl": "<w>Przed chwilą</w> telewizor jeszcze normalnie działał."
                            }
                        },
                        {
                            "text": "Ik heb hem <w>straks</w> nog gezien in de gang.",
                            "target_lang_translations": {
                                "ru": "Я <w>недавно</w> видел его в коридоре.",
                                "en": "I saw him in the hallway <w>just now</w>.",
                                "pl": "Widziałem go <w>przed chwilą</w> na korytarzu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Некоторое время назад; только что.",
                        "en": "A short time ago; just now.",
                        "pl": "Krótką chwilę temu; przed momentem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только что",
                                "target_lang_sense_clarification": "совсем недавно"
                            },
                            {
                                "target_lang_word": "недавно",
                                "target_lang_sense_clarification": "некоторое время назад"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "just now",
                                "target_lang_sense_clarification": "very recently"
                            },
                            {
                                "target_lang_word": "a moment ago",
                                "target_lang_sense_clarification": "short time past"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przed chwilą",
                                "target_lang_sense_clarification": "bardzo niedawno"
                            },
                            {
                                "target_lang_word": "dopiero co",
                                "target_lang_sense_clarification": "dosłownie przed momentem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5911817-2a7a-3100-9d78-f2332e02ac07",
                    "sense_definition": "De partitieve vorm van <w>strak</w> die wordt gebruikt na woorden als 'iets', 'niets', 'veel' of 'weinig'.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heb je iets <w>straks</w> om aan te trekken voor het sporten?",
                            "target_lang_translations": {
                                "ru": "У тебя есть что-нибудь <w>обтягивающее</w> для спорта?",
                                "en": "Do you have something <w>tight</w> to wear for sports?",
                                "pl": "Masz na sobie coś <w>obcisłego</w> do ćwiczeń?"
                            }
                        },
                        {
                            "text": "Er zit niets <w>straks</w> aan deze wijde broek.",
                            "target_lang_translations": {
                                "ru": "В этих широких брюках нет ничего <w>тугого</w>.",
                                "en": "There is nothing <w>tight</w> about these wide trousers.",
                                "pl": "W tych szerokich spodniach nie ma nic <w>obcisłego</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iets straks"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "partitief"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Партитивная форма прилагательного 'strak' (тугой, обтягивающий), используемая после неопределенных местоимений.",
                        "en": "The partitive form of 'strak' (tight), used after indefinite pronouns.",
                        "pl": "Forma partytywna przymiotnika 'strak' (obcisły, ciasny), używana po słowach takich jak 'coś', 'nic', 'dużo' lub 'mało'."
                    },
                    "translations": {
