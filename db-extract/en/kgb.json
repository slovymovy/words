                "word": "KGB",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5b0bf4b7-8006-43a0-8c76-9a0535a45feb",
                        "entry_id": "eaa435f0-d230-38cd-a9d4-0f37b6e114ee",
                        "tags": [
                            "canonical"
                        ],
                        "form": "the KGB"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "617938b5-ea50-333c-b546-bcdaedae01a0",
                        "entry_id": "eaa435f0-d230-38cd-a9d4-0f37b6e114ee",
                        "glosses": [
                            "The Committee for State Security of the Soviet Union (the Soviet security service)."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "293c4abe-bd6d-495e-84f9-d29e721042ea",
                                "sense_id": "617938b5-ea50-333c-b546-bcdaedae01a0",
                                "text": "President Putin's KGB roots have sadly informed a style of governance that is neither reformist nor particularly democratic. The common thread throughout his domestic and foreign policies is his effort to trade on fear -- the fears of Russians that their country is under attack from hostile external forces (Chechens, NATO or free marketeers); and the fears of Westerners that if not for a strong, pragmatic leader, Russia will again become unruly, unstable and potentially aggressive."
                            },
                            {
                                "example_id": "64cbeab6-01aa-46eb-8f98-eb10cb768cdf",
                                "sense_id": "617938b5-ea50-333c-b546-bcdaedae01a0",
                                "text": "But in 1967 Treholt's trenchant opposition to the Vietnam War attracted the attention of the KGB."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f2313d5-a400-32a3-bc3d-952a1adcdf41",
                        "entry_id": "eaa435f0-d230-38cd-a9d4-0f37b6e114ee",
                        "glosses": [
                            "The security service of Belarus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "194b8ed3-56f0-4772-bd65-33034aa3ec08",
