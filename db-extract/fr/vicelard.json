                                                "sense_id": "03cc5310-f206-3ed1-9842-080e4fed87f5",
                                                "text": "Was für ein fieses Wetter!"
                                            },
                                            {
                                                "example_id": "9b9714c3-75a8-4347-a94a-1117ae0b150f",
                                                "sense_id": "03cc5310-f206-3ed1-9842-080e4fed87f5",
                                                "text": "Das war eine ganz fiese Angelegenheit."
                                            },
                                            {
                                                "example_id": "769ea847-26f3-482f-b117-6fb672f1d6ee",
                                                "sense_id": "03cc5310-f206-3ed1-9842-080e4fed87f5",
                                                "text": "Dieses Mal habe ich mir eine wirklich fiese Erkältung aufgehalst."
                                            }
