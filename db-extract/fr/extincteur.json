                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1821e44-d87b-479c-92f7-ec8edc42cc01",
                        "entry_id": "8a0e3574-486b-3777-a505-8080544a9a85",
                        "tags": [
                            "plural"
                        ],
                        "form": "extincteurs"
