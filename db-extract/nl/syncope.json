                ],
                "senses": [
                    {
                        "sense_id": "3d500c87-1f1c-3993-a925-7ccf8f3ca48c",
                        "entry_id": "9dfeee48-0ee0-3714-a1c0-bd49473af4df",
                        "glosses": [
                            "plotseling bewustzijnsverlies"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bd72b405-601e-33c7-b3f0-dbf91bbb4dfb",
                        "entry_id": "9dfeee48-0ee0-3714-a1c0-bd49473af4df",
                        "glosses": [
                            "verlegging van de maataccenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64cc036-8424-45e7-b610-157222749a78",
                                "sense_id": "bd72b405-601e-33c7-b3f0-dbf91bbb4dfb",
                                "text": "Die syncopen rammelden een beetje, laten we het vanaf maat 13 opnieuw doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8837fecc-e81f-3a54-a41a-2accffb3bd56",
                        "entry_id": "9dfeee48-0ee0-3714-a1c0-bd49473af4df",
                        "glosses": [
                            "deletie van een of meer klanken of een lettergreep aan het woordmidden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3921a8b-b0ba-4222-96e0-1f6c2820660b",
                                "sense_id": "8837fecc-e81f-3a54-a41a-2accffb3bd56",
                                "text": "Als de elisie een klinker binnen het woord betreft, spreekt men van syncope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2adc9a0d-af24-4138-808e-ef790f91d823",
                        "source_entry_id": "9dfeee48-0ee0-3714-a1c0-bd49473af4df",
                        "source_sense_id": "3d500c87-1f1c-3993-a925-7ccf8f3ca48c",
                        "source_sense_description": "plotseling bewustzijnsverlies",
                        "target_lang_word": "syncope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syncope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "172ec838-ac24-398f-aa40-a5bdafd83004",
                                        "entry_id": "b1493e9e-8ed5-37f5-8b7e-fd19d1d802c9",
                                        "glosses": [
                                            "The elision or loss of a sound from the interior of a word, especially of a vowel sound with loss of a syllable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e8afaf-adfe-4751-932b-5509f3050764",
                                                "sense_id": "172ec838-ac24-398f-aa40-a5bdafd83004",
                                                "text": "[…]; on the contrary, all syllables subject in the same way to elision, apocope, syncope, and slurring must have the same degree of stress (i.e. they must be alike unaccented) whether preceded by short or by long root-syllables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "452d0adc-5994-3b01-8da8-4ee7cecd48f6",
                                        "entry_id": "b1493e9e-8ed5-37f5-8b7e-fd19d1d802c9",
                                        "glosses": [
                                            "A loss of consciousness when fainting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad364f9-45b7-447a-bab5-16f7bf3a4860",
                                                "sense_id": "452d0adc-5994-3b01-8da8-4ee7cecd48f6",
                                                "text": "Sometimes, without any apparent cause, I sank, little by little, into a condition of semi-syncope, or half swoon; and, in this condition, without pain, without ability to stir, or, strictly speaking, to think, but with a dull lethargic consciousness of life and of the presence of those who surrounded my bed, I remained, until the crisis of the disease restored me, suddenly, to perfect sensation."
                                            },
                                            {
                                                "example_id": "5dc11b39-18d3-4959-ba9b-35b8a068f145",
                                                "sense_id": "452d0adc-5994-3b01-8da8-4ee7cecd48f6",
                                                "text": "Schneider, the father of rhinology, mentions a woman in whom the odor of orange-flowers produced syncope."
                                            },
                                            {
                                                "example_id": "0314f71a-a786-4ae8-aaac-8c23b589c340",
                                                "sense_id": "452d0adc-5994-3b01-8da8-4ee7cecd48f6",
                                                "text": "[…]the rapidly-whitening face, the miserable fixed smile, meant a syncope within the next few bars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b3a124-9863-3697-a0ba-aa1bf429674d",
                                        "entry_id": "b1493e9e-8ed5-37f5-8b7e-fd19d1d802c9",
                                        "glosses": [
                                            "A missed beat or off-beat stress in music resulting in syncopation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce22999-e846-4256-aa3a-5aaf795e0ce4",
                                                "sense_id": "02b3a124-9863-3697-a0ba-aa1bf429674d",
                                                "text": "She was a volatile creature, full of mischievous surprise: at their first music practice, after playing over some hymns on the pipe-organ, she burst into jazz, filling the quiet grove with the clamorous syncope of Paddy-Paws, a favourite song that summer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
