                },
                {
                    "sense_id": "28c61693-5a5d-33cc-82cd-d55b99709cb9",
                    "sense_definition": "połączenie przestrzenne między miejscami umożliwiające przejście lub przejazd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowy most znacznie poprawi <w>komunikację</w> między dwiema częściami miasta.",
                            "target_lang_translations": {
                                "ru": "Новый мост значительно улучшит <w>сообщение</w> между двумя частями города.",
                                "en": "The new bridge will significantly improve the <w>connection</w> between the two parts of the city."
                            }
                        },
                        {
                            "text": "Te drzwi stanowią jedyną bezpośrednią <w>komunikację</w> kuchni z salonem.",
                            "target_lang_translations": {
                                "ru": "Эта дверь представляет собой единственное прямое <w>сообщение</w> кухни с гостиной.",
                                "en": "This door provides the only direct <w>access</w> between the kitchen and the living room."
                            }
                        }
                    ],
                    "synonyms": [
