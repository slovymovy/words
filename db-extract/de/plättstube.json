                        "glosses": [
                            "Raum, in dem gewaschene Wäsche geplättet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "917b36dd-158d-46ed-bf07-13f4936d738e",
                                "sense_id": "918e1af5-18c0-3a90-b244-c181a56a60c3",
                                "text": "„»Herr von Studmann liegt auf einer zerrissenen Chaiselongue in einer Plättstube«, klagte der Rittmeister erbittert.“"
                            },
                            {
                                "example_id": "c7a34a44-592b-4157-9653-4e6ad6342e7a",
                                "sense_id": "918e1af5-18c0-3a90-b244-c181a56a60c3",
                                "text": "„Waschküche, Roll- und Plättstube sind im Bodenraum untergebracht.“"
                            },
                            {
                                "example_id": "006c2691-44c9-4194-99f5-321033439616",
                                "sense_id": "918e1af5-18c0-3a90-b244-c181a56a60c3",
                                "text": "„Erforderlich seien 38 heizbare Zimmer mit Einschluss eines Speisesaals in der Größe wie der in Friedrichsthal befindliche, 25 Kammern und Kabinetts, eine Remise für vier Wagen, eine Stallung für acht Pferde, ein Waschhaus, eine Rollstube, eine Plättstube und ein Holzschuppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
