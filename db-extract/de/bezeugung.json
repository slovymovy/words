                        "form": "die Bezeugungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d654f42-81c6-3f3f-a1b4-b8fd94d5d16d",
                        "entry_id": "9e921da8-1dcb-30ed-9401-ff247cc1b352",
                        "glosses": [
                            "Handlung, etwas (als Zeuge) zu bestätigen, nachzuweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4247ad77-d442-410f-97d6-5b56e6add72c",
                                "sense_id": "0d654f42-81c6-3f3f-a1b4-b8fd94d5d16d",
                                "text": "„Die Bezeugung der Wahrheit ist daher die höchste Pflicht der Kirche und ihrer Diener.“"
                            },
                            {
                                "example_id": "d46c4e8b-1f78-44c3-899a-cb528902679b",
                                "sense_id": "0d654f42-81c6-3f3f-a1b4-b8fd94d5d16d",
                                "text": "„Da die äußere Bezeugung dafür nicht ausreicht, muß die Entscheidung bei der inneren Bezeugung fallen.“"
                            },
                            {
                                "example_id": "2da47a53-d1ac-447a-a690-c8035a7c5ac7",
                                "sense_id": "0d654f42-81c6-3f3f-a1b4-b8fd94d5d16d",
                                "text": "„Die ursprüngliche Rolle eines Trauzeugen (die Bezeugung der Trauung) steht heute nicht mehr im Vordergrund und ist eher überholt.“"
                            },
                            {
                                "example_id": "81edcec8-0394-4499-b28f-e282fae67d78",
                                "sense_id": "0d654f42-81c6-3f3f-a1b4-b8fd94d5d16d",
                                "text": "„Der Leitsatz des Malteserordens lautet ‚Bezeugung des Glaubens und Hilfe den Bedürftigen‘.“"
                            },
                            {
                                "example_id": "e172b995-0592-4f7d-b166-05ab46b75c59",
                                "sense_id": "0d654f42-81c6-3f3f-a1b4-b8fd94d5d16d",
                                "text": "„Wie bereits erwähnt, lassen sich keine äußeren Bezeugungen des Wiener Textes finden, die bei der Datierung des Textes helfen könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
