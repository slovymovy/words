                    {
                        "translation_id": "7f0c2213-660b-411b-b794-8f824af8ab2c",
                        "source_entry_id": "cb6f2af4-1e0e-31dc-be06-9f4218e84761",
                        "source_sense_id": "37c94784-191b-3adb-885c-ab0e6e643fc0",
                        "source_sense_description": "tending to persevere",
                        "target_lang_word": "beharrlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beharrlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                        "entry_id": "7bb60b0e-cb7f-35ee-9f63-7fb33c1c9888",
                                        "glosses": [
                                            "mit Ausdauer um etwas bemüht oder an etwas festhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69bf6e76-0de5-4fad-8537-9092a1960011",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "Der mutmaßliche Täter schweigt beharrlich."
                                            },
                                            {
                                                "example_id": "20e62fb0-7ad5-484c-a0b4-d0d59a40b026",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "Seid beharrlich im Gebet und wacht in ihm mit Danksagung."
                                            },
                                            {
                                                "example_id": "8d46dbab-38d6-461d-b93d-dcdb379aaea2",
                                                "sense_id": "64a2f463-9201-3ddc-a927-b2cae0646268",
                                                "text": "„Die beharrliche Strategie des Quintus Fabius Maximus, die Siege des Marcus Claudius Marcellus in Sizilien, die Erfolge des Publius Cornelius Scipio in Hispanien und das militärische Geschick des Marcus Livius Salinator und Gaius Claudius Nero in Italien brachten den immer noch unbesiegten Hannibal in Bedrängnis und zwangen ihn, aus Italien abzuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5813f5a5-c828-42ff-9678-2d9c2f7772e1",
                        "source_entry_id": "cb6f2af4-1e0e-31dc-be06-9f4218e84761",
                        "source_sense_id": "37c94784-191b-3adb-885c-ab0e6e643fc0",
                        "source_sense_description": "tending to persevere",
                        "target_lang_word": "ausdauernd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausdauernd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                        "entry_id": "1d805a18-30b1-3ee6-991e-18b3c9fb6fc9",
                                        "glosses": [
                                            "eine Belastung lange durchhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b96154-4113-4609-a415-ee17949838e0",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "Anstrengende Gartenarbeit macht mir nichts aus, ich bin ausdauerndes Arbeiten gewohnt."
                                            },
                                            {
                                                "example_id": "97bb411d-d461-4121-b1b4-17935bab43f9",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "[…] sie lächelt mich an und schüttelt mir die Hand, lange und ausdauernd.."
                                            },
                                            {
                                                "example_id": "3bfab101-f2a6-4110-942c-44e458332942",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "[…] in einem der alten Pavillons knutscht ausdauernd ein Pärchen."
                                            },
                                            {
                                                "example_id": "32ca377b-edf2-4938-a229-9ee2e90c5d42",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "[…] Es [wird] erst einmal laut und schrill, denn die Koboldmakis beginnen ausdauernd zu singen. Je ein Weibchen und ein Männchen, beide nicht größer als zwölf Zentimeter, rufen im Duett ihre Familie zusammen, um gemeinsam ihre Schlafbäume aufzusuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c14ccc2-7851-3167-9d4f-0c3d7ba525ed",
                                        "entry_id": "1d805a18-30b1-3ee6-991e-18b3c9fb6fc9",
                                        "glosses": [
                                            "in Bezug auf Pflanzen, insbesondere Beikräuter/Unkräuter: immer wieder austreibend, immer wieder nachwachsend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824311f2-2f08-4108-8a27-2b162cd6d80d",
                                                "sense_id": "9c14ccc2-7851-3167-9d4f-0c3d7ba525ed",
                                                "text": "Giersch ist ein wirklich ausdauerndes Unkraut, dem man auch mit der Giftspritze kaum beikommt."
                                            },
                                            {
                                                "example_id": "9cd3a5c8-5c2e-403a-a2ae-74d417c4038f",
                                                "sense_id": "9c14ccc2-7851-3167-9d4f-0c3d7ba525ed",
                                                "text": "„Beschreibung: Ausdauernde Kräuter aus der Familie der Doldengewächse (Apiaceae) mit spindelförmigen, unangenehm riechendem Wurzelstock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
