                    {
                        "sense_id": "35105212-472a-3f26-a6f4-060bf1a84dfe",
                        "entry_id": "678d414f-6092-3757-b9bf-91dc6defbb82",
                        "glosses": [
                            "een foneem dat uit twee klinkers bestaat die binnen één lettergreep in elkaar overgaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a610a2bd-8ac7-40f4-90a0-a61aea8a72b1",
                                "sense_id": "35105212-472a-3f26-a6f4-060bf1a84dfe",
                                "text": "Het hedendaagse Standaardnederlands is relatief arm aan tweeklanken: er worden in het overgrote deel van het Nederlandse taalgebied drie tweeklanken gerealiseerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d45875c-25b7-4d02-8275-7aa339346725",
                        "source_entry_id": "678d414f-6092-3757-b9bf-91dc6defbb82",
                        "source_sense_id": "35105212-472a-3f26-a6f4-060bf1a84dfe",
                        "source_sense_description": "een foneem dat uit twee klinkers bestaat die binnen één lettergreep in elkaar overgaan",
                        "target_lang_word": "Diphthong",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diphthong",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4635581-8a4d-3cca-9b46-dc0848951136",
                                        "entry_id": "ef0009c9-67ff-3f11-8180-fc7764b96ae0",
                                        "glosses": [
                                            "Folge von zwei Vokalen in einer Silbe, die phonetisch als Einheit aufgefasst werden"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f17fa1b-b77b-428a-b21d-0e0aa2f55f93",
                                                "sense_id": "b4635581-8a4d-3cca-9b46-dc0848951136",
                                                "text": "Im Deutschen gibt es folgende Diphthonge: [aɪ̯] (Hai, Ei), [aʊ̯] (Bau), [ɔɪ̯] (Heu, Gebräu) und [ʊɪ̯] (nur in Interjektionen und Fremdwörtern; z.B. hui, pfui, ui; Uigure)."
                                            },
                                            {
                                                "example_id": "f2c64a52-2276-4c70-96ad-2764805c657b",
                                                "sense_id": "b4635581-8a4d-3cca-9b46-dc0848951136",
                                                "text": "„Im Gegensatz zu den Monophthongen (einfachen Vokalen) bestehen Diphthonge (Zwielaute, Doppellaute) aus zwei Vokalen, von denen der eine silbisch und der andere unsilbisch ist, die also beide zur selben Silbe gehören.“"
                                            },
                                            {
                                                "example_id": "d15ff250-9248-4d57-9b79-1ad82dcd6561",
                                                "sense_id": "b4635581-8a4d-3cca-9b46-dc0848951136",
                                                "text": "„Die Krönung des Umlauts ist allerdings der Diphthong, was per se schon klingt, als wäre es ein Begriff aus dem Vietnamesischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86ac4d60-87a3-4420-a58d-f4097f902bfa",
                        "source_entry_id": "678d414f-6092-3757-b9bf-91dc6defbb82",
                        "source_sense_id": "35105212-472a-3f26-a6f4-060bf1a84dfe",
                        "source_sense_description": "een foneem dat uit twee klinkers bestaat die binnen één lettergreep in elkaar overgaan",
