                ],
                "senses": [
                    {
                        "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                        "entry_id": "6c0f7882-6f99-3d02-9b4c-f1379cfc2d55",
                        "glosses": [
                            "Sturm oder starker Wind, der Staub mit sich führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1433e583-a219-460d-88fd-95ea38511d6d",
                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                "text": "„Die Erosion wurde aufgehalten, Staubstürme sind selten geworden, aber ganz Island färbt sich jetzt violett.“"
                            },
                            {
                                "example_id": "113f6a41-eeed-452a-a126-2e075f02897c",
                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                "text": "„Trotz der Staubstürme, die nach allen Richtungen die Augen blendeten, ging der Streitmachtführer an der Spitze seines Heeres zum Angriff über.“"
                            },
                            {
                                "example_id": "26dc368e-f9b8-4b97-a29e-f87801a44c2a",
                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                "text": "„Kinder überstehen noch viel Schlimmeres, sagte Augie sich mit einem unbehaglichen Gefühl. Er dachte an die Staubstürme im Mittleren Westen zur Zeit der Weltwirtschaftskrise.“"
                            },
                            {
                                "example_id": "4642cceb-2821-40cf-9e41-b1eb354b1f4c",
                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                "text": "„Staubstürme, die Partikel aus der Sahara nach Europa tragen, kommen seit Jahren regelmäßig vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
