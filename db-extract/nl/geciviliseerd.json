                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civilized",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3066013-2ffe-3ba2-a427-ad5a913b8c75",
                                        "entry_id": "510528e4-ea9a-3912-8681-77ffd8af8672",
                                        "glosses": [
                                            "Having a highly developed society or culture; belonging to civilization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da2371a-91ca-438a-bd4c-98e04868bae6",
                                                "sense_id": "e3066013-2ffe-3ba2-a427-ad5a913b8c75",
                                                "text": "In the year 1521, when Cortez reached Anahuac, the American bison was seen for the first time by civilized Europeans, if we may be permitted to thus characterize the horde of blood thirsty plunder seekers who fought their way to the Aztec capital."
                                            },
                                            {
                                                "example_id": "46a9a65d-18af-4d8e-be4c-e0900127144a",
                                                "sense_id": "e3066013-2ffe-3ba2-a427-ad5a913b8c75",
                                                "text": "Like the wolf, man the hunter in killing the weak and unfit, actually works to maintain the health of the herd. But civilized man is quite a different animal, and when he wipes out an entire city or levels a forest, he is no longer working within the natural balance of things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e84781-da4d-374b-b186-69c03c249d8d",
                                        "entry_id": "510528e4-ea9a-3912-8681-77ffd8af8672",
                                        "glosses": [
                                            "Showing evidence of moral and intellectual advancement; humane, reasonable, ethical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c585a789-96cf-3be9-8e67-d7ed7cabd6c9",
                                        "entry_id": "510528e4-ea9a-3912-8681-77ffd8af8672",
                                        "glosses": [
                                            "Marked by refinement in taste and manners."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696455e6-dfce-4fb0-836c-02b2f3d91307",
                                                "sense_id": "c585a789-96cf-3be9-8e67-d7ed7cabd6c9",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed.\n ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […]‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
                                        ]
                                    }
                                ]
