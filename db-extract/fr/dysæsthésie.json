                    {
                        "sense_id": "177e3b5a-1aa8-32d2-be69-e055b314c040",
                        "entry_id": "348d1bf5-095f-37af-8e82-2668d30336fd",
                        "glosses": [
                            "Variante orthographique de dysesthésie"
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7367b6c1-defc-4a99-9749-005eb2168fea",
                                "sense_id": "177e3b5a-1aa8-32d2-be69-e055b314c040",
                                "text": "La dysæsthésie est d’autant plus dangereuse qu’elle est plus généralement répandue sur le corps ; que son principal siége ^([sic]) réside sur des parties plus importantes à la vie par la nature de leurs fonctions , et qu’elle est de plus longue durée."
                            },
                            {
                                "example_id": "b984f524-6f57-4a12-9bd4-994cce3d7fdc",
                                "sense_id": "177e3b5a-1aa8-32d2-be69-e055b314c040",
                                "text": "Il faut éviter d’une part , de méconnaitre les lésions locales et d’autre part de prendre pour lésion locale, ce qui n’est qu’un effet réflexe de la dysæsthésie."
                            }
                        ]
                    }
                ],
