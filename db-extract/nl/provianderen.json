                                "target_senses": [
                                    {
                                        "sense_id": "694f38d3-d0a6-3c82-ae40-35800f83796b",
                                        "entry_id": "43d62c24-c06c-38dc-86c1-39896ba229ba",
                                        "glosses": [
                                            "Supplely: in a supple manner, with suppleness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f7ccc61-1790-41e4-952b-d80298892751",
                                                "sense_id": "694f38d3-d0a6-3c82-ae40-35800f83796b",
                                                "text": "His voice was playful and full; his back was bent supply."
                                            },
                                            {
                                                "example_id": "1a9ca0cc-07e2-4644-a441-a70935495d90",
                                                "sense_id": "694f38d3-d0a6-3c82-ae40-35800f83796b",
                                                "text": "[…] the rain struck on her head as she bent supply to the movements of the pony, while it scrambled up the bank to the sheltering trees. For a couple of miles the path ran through woods alive with the varied voices of the rain, […]"
                                            },
                                            {
                                                "example_id": "25d99abf-46ee-4de3-805c-05433b84f858",
                                                "sense_id": "694f38d3-d0a6-3c82-ae40-35800f83796b",
                                                "text": "She swayed slightly in the gusts, bent supply to them and seemed at one with the force which Straup found so hostile."
                                            },
                                            {
                                                "example_id": "abeca389-0b53-4ac3-a324-2e93f9d67e72",
                                                "sense_id": "694f38d3-d0a6-3c82-ae40-35800f83796b",
                                                "text": "Grigory hesitantly took her in his arms to kiss her, but she held him off, bent supply backwards and shot a frightened glance at the windows.\n'They'll see!'\n'Let them!'\n'I'd be ashamed—'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6da89420-d3ac-4c53-9179-8b7687e9086c",
                        "source_entry_id": "f096e4e6-82a3-3854-894c-1a0da4da2f69",
