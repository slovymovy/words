    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b328f23-66ae-3ac5-996c-3aab30e44851",
                    "sense_definition": "met een lage dichtheid, vaak gezegd van lucht of gassen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dichtheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de bergen is er vaak een <w>ijle</w> lucht waardoor je sneller buiten adem raakt.",
                            "target_lang_translations": {
                                "en": "In the mountains there is often <w>thin</w> air, which makes you get out of breath faster."
                            }
                        },
                        {
                            "text": "De bergbeklimmers hadden veel last van de <w>ijle</w> lucht op deze grote hoogte.",
                            "target_lang_translations": {
                                "en": "The mountain climbers suffered a lot from the <w>rarefied</w> air at this high altitude."
                            }
                        }
                    ],
                    "synonyms": [
                        "dun",
                        "fijn"
                    ],
                    "antonyms": [
                        "dicht",
                        "dik"
                    ],
                    "common_phrases": [
                        "ijle lucht"
                    ],
                    "target_lang_definitions": {
                        "en": "having a low density, often said of air or gases"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thin",
                                "target_lang_sense_clarification": "of air or gas"
                            },
                            {
                                "target_lang_word": "rarefied",
                                "target_lang_sense_clarification": "scientific or formal term for low-density air"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de7b8776-0b14-374f-a82e-d0a4b6b9e099",
                    "sense_definition": "zeer slank of mager van gestalte",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft een <w>ijl</w> postuur dat haar een breekbare indruk geeft.",
                            "target_lang_translations": {
                                "en": "She has a <w>slender</w> stature that gives her a fragile impression."
                            }
                        },
                        {
                            "text": "De kunstenaar schilderde een <w>ijle</w> figuur die bijna in de mist verdween.",
                            "target_lang_translations": {
                                "en": "The artist painted a <w>wispy</w> figure that almost disappeared into the mist."
                            }
                        }
                    ],
                    "synonyms": [
                        "mager",
                        "tenger",
                        "slank"
                    ],
                    "antonyms": [
                        "gezet",
                        "fors"
                    ],
                    "common_phrases": [
                        "ijl postuur",
                        "ijle figuur"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "very slender or thin in stature"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slender",
                                "target_lang_sense_clarification": "gracefully thin"
                            },
                            {
                                "target_lang_word": "frail",
                                "target_lang_sense_clarification": "thin and delicate"
                            },
                            {
                                "target_lang_word": "wispy",
                                "target_lang_sense_clarification": "thin and faint"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "391410db-1623-38c8-8653-1efcb98fb0e6",
                    "sense_definition": "zonder inhoud of betekenis; leeg",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leegte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn woorden bleken slechts <w>ijle</w> beloften te zijn die nooit werden nagekomen.",
                            "target_lang_translations": {
                                "en": "His words turned out to be merely <w>hollow</w> promises that were never fulfilled."
                            }
                        },
                        {
                            "text": "Na het vertrek van zijn vrienden voelde hij een <w>ijle</w> leegte in het grote huis.",
                            "target_lang_translations": {
                                "en": "After his friends left, he felt an <w>empty</w> void in the large house."
                            }
                        }
                    ],
                    "synonyms": [
                        "leeg",
                        "inhoudsloos",
                        "nietig"
                    ],
                    "antonyms": [
                        "vol",
                        "betekenisvol"
                    ],
                    "common_phrases": [
                        "ijle beloften",
                        "ijle hoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "without content or meaning; empty"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hollow",
                                "target_lang_sense_clarification": "without real value or sincerity"
                            },
                            {
                                "target_lang_word": "empty",
                                "target_lang_sense_clarification": "void of meaning"
                            },
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "useless or without result"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91f9df43-2b17-37d2-8ee3-1ca47aced582",
                    "sense_definition": "een toestand van grote spoed of haast",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "snelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In alle <w>ijl</w> vergat hij zijn sleutels op de keukentafel te leggen.",
                            "target_lang_translations": {
                                "en": "In all the <w>haste</w>, he forgot to put his keys on the kitchen table."
                            }
                        },
                        {
                            "text": "De brandweer kwam met grote <w>ijl</w> ter plaatse om het vuur te blussen.",
                            "target_lang_translations": {
                                "en": "The fire department arrived on the scene with great <w>speed</w> to extinguish the fire."
                            }
                        }
                    ],
                    "synonyms": [
                        "haast",
                        "spoed",
                        "haastigheid"
                    ],
                    "antonyms": [
                        "traagheid",
                        "kalmte"
                    ],
                    "common_phrases": [
                        "in aller ijl",
                        "met grote ijl"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of great speed or haste"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haste",
                                "target_lang_sense_clarification": "speed of motion or action"
                            },
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "rushing to do something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91bd8d82-e078-3419-b7e2-d0c9edc57f27",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>ijlen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ijl</w> naar de bushalte omdat ik anders te laat kom voor mijn afspraak.",
                            "target_lang_translations": {
                                "en": "I <w>hurry</w> to the bus stop because otherwise I'll be late for my appointment."
                            }
                        },
                        {
                            "text": "Wanneer ik koorts heb, <w>ijl</w> ik soms en zeg ik vreemde dingen.",
                            "target_lang_translations": {
                                "en": "When I have a fever, I sometimes <w>rave</w> and say strange things."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'ijlen' (to hurry or to rave/delirium)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "moving quickly"
                            },
                            {
                                "target_lang_word": "rave",
                                "target_lang_sense_clarification": "talking incoherently due to fever"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c62cb93-68a4-3abc-90ca-861ad5b77b94",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>ijlen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>ijl</w> je zo hard door de gangen van het kantoor?",
                            "target_lang_translations": {
                                "en": "Why are you <w>rushing</w> so fast through the office corridors?"
                            }
                        },
                        {
                            "text": "<w>IJl</w> je nu weer over die oude gebeurtenissen van vroeger?",
                            "target_lang_translations": {
                                "en": "Are you <w>rambling</w> again about those old events from the past?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second person singular present tense of 'ijlen' (to hurry or to rave/delirium)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "moving quickly"
                            },
                            {
                                "target_lang_word": "rave",
                                "target_lang_sense_clarification": "talking incoherently due to fever"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e5ebd0-2d93-36ca-bcdb-a355e26891cc",
                    "sense_definition": "gebiedende wijs van <w>ijlen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>IJl</w> je naar huis voordat de zware storm begint te woeden!",
                            "target_lang_translations": {
                                "en": "<w>Hurry</w> home before the heavy storm begins to rage!"
                            }
                        },
                        {
                            "text": "<w>IJl</w> niet zo, we hebben nog meer dan genoeg tijd voor de trein.",
                            "target_lang_translations": {
                                "en": "Don't <w>rush</w> so much, we still have more than enough time for the train."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'ijlen' (to hurry)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "command to move fast"
                            },
                            {
                                "target_lang_word": "make haste",
                                "target_lang_sense_clarification": "formal command to hurry"
                            }
                        ]
                    }
                }
            ]
        }
