                ],
                "senses": [
                    {
                        "sense_id": "de473262-6e21-32c9-bdb0-fa95bebffc02",
                        "entry_id": "50628e68-0311-3631-8d48-c2cf7724b2e6",
                        "glosses": [
                            "Strecke zwischen dem Auge und einem Objekt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "182dcc66-6538-4af0-ab56-68f79de3dd85",
                                "sense_id": "de473262-6e21-32c9-bdb0-fa95bebffc02",
                                "text": "„Zudem erfordert die Projektion eine freie Sichtlinie zwischen Projektor und Objekt, da Verschattungen auftreten, wenn die Sichtlinie durch das Werkstück oder den Benutzer verdeckt wird.“"
                            },
                            {
                                "example_id": "80046605-85d8-4663-ad93-83550033eb35",
                                "sense_id": "de473262-6e21-32c9-bdb0-fa95bebffc02",
                                "text": "„Zeichnen Sie mit diesem Verfahren noch Sichtlinien von drei weiteren Beobachterpunkten und entfernen Sie dann den Nagel. Wie können Sie mithilfe dieser Sichtlinien bestimmen, wo sich der Nagel befunden hat?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f73303f1-4977-3c22-a644-c124e6aa56e4",
                        "entry_id": "50628e68-0311-3631-8d48-c2cf7724b2e6",
                        "glosses": [
                            "Punkt, an dem man Einsicht in eine Straßenkreuzung hat"
                        ],
                        "tags": [
                            "Straßenverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "a0d57699-6cc3-442a-8590-2afdd735577a",
                                "sense_id": "f73303f1-4977-3c22-a644-c124e6aa56e4",
                                "text": "An der Stelle, wo die Straße eingesehen werden kann, in die eingefahren werden soll, an der Sichtlinie, ist erneut anzuhalten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
