                        "entry_id": "46f65245-676a-3a7a-9203-4356edf1a627",
                        "glosses": [
                            "Fluss im Osten der belgischen Ardennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d865f10b-e9c4-43ea-bf93-89c51b08a14e",
                                "sense_id": "be94fde0-f959-3f61-b850-0b0e005032e6",
                                "text": "„Drei Tage, bevor er den Präsidenten seines Heimatlandes erschießen musste, wurde Daniel gegen Tagesanbruch von Vogelgezwitscher geweckt, dort in dem kleinen Holzhäuschen des Campingplatzes Le Grillon in den belgischen Ardennen, am Ufer des schmalen Flusses Ourthe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
