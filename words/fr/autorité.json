                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prestige",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chercheuse jouit d'une grande <w>autorité</w> scientifique dans le milieu universitaire."
                        },
                        {
                            "text": "Le dernier livre de cet historien fait <w>autorité</w> auprès de tous les spécialistes."
