                        "entry_id": "f1d7ee80-1260-38e0-a3c5-2cdb55fe2197",
                        "glosses": [
                            "iemand die zich te voet door het verkeer verplaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08385e16-a030-46ff-adb3-e249d302f2c2",
                                "sense_id": "f38610c1-66fa-3c30-be1f-906a530e6934",
