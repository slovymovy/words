        "nl-extract.jsonl": [
            {
                "entry_id": "6d2addc6-bccc-3671-9813-5a2878671ddb",
                "word": "doortrapt",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eeedb152-e372-3dd8-b525-53cf6a9bf341",
                        "entry_id": "6d2addc6-bccc-3671-9813-5a2878671ddb",
                        "glosses": [
                            "slim maar slecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df6dc9d3-8fdf-4102-a8f9-0c43ae7b63f2",
                                "sense_id": "eeedb152-e372-3dd8-b525-53cf6a9bf341",
                                "text": "De doortrapte oplichter had een geloofwaardig verhaal verzonnen om mensen geld afhandig te maken."
                            },
                            {
                                "example_id": "b05b7fd0-fc8f-4f42-9dc0-067908000117",
                                "sense_id": "eeedb152-e372-3dd8-b525-53cf6a9bf341",
                                "text": "Of waren ze ergens in het Oosten opgeleid? Anderzijds sprak er een koelbloedigheid uit hun gedrag die zelfs die van de meest ervaren en doortrapte misdadigers verre oversteeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63acf30a-210e-4a85-a916-f00f67a09f2e",
                        "source_entry_id": "6d2addc6-bccc-3671-9813-5a2878671ddb",
                        "source_sense_id": "eeedb152-e372-3dd8-b525-53cf6a9bf341",
                        "target_lang_word": "malicieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malicieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21522ab0-0085-3aad-a236-80b577470d4e",
                                        "entry_id": "9008c2b7-337c-3d7a-b183-62acad737683",
                                        "glosses": [
                                            "Qui a de la malice, qui est porté à nuire, à mal faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8057a457-d809-4218-9282-9eaa12723530",
                                                "sense_id": "21522ab0-0085-3aad-a236-80b577470d4e",
                                                "text": "Il est malicieux comme un singe."
                                            },
                                            {
                                                "example_id": "b84d32b7-247b-4caf-8177-5066dcea81c8",
                                                "sense_id": "21522ab0-0085-3aad-a236-80b577470d4e",
                                                "text": "Intention malicieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc0d18c-c7f7-381a-a8c1-b40ee6be8564",
                                        "entry_id": "9008c2b7-337c-3d7a-b183-62acad737683",
                                        "glosses": [
                                            "Qui est porté à la plaisanterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81703c8c-c916-41a2-aea8-3f81703aa51c",
                                                "sense_id": "1bc0d18c-c7f7-381a-a8c1-b40ee6be8564",
                                                "text": "Un enfant malicieux."
                                            },
                                            {
                                                "example_id": "0d3d3e0e-c9fb-4c8a-8c98-c0ad107094df",
                                                "sense_id": "1bc0d18c-c7f7-381a-a8c1-b40ee6be8564",
                                                "text": "Son esprit malicieux égaie la conversation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38187d48-d43d-38cf-b484-d697b281e7c5",
                                        "entry_id": "9008c2b7-337c-3d7a-b183-62acad737683",
                                        "glosses": [
                                            "Qui dénote un esprit espiègle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea472dff-bee3-4ac2-be26-806fd36061d1",
                                                "sense_id": "38187d48-d43d-38cf-b484-d697b281e7c5",
                                                "text": "Il songe à tout, aux plus petites choses. Il crayonne de malicieux portraits, raconte avec enjouement des anecdotes spirituelles, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24234745-f05a-37a2-b7d8-e06fc5f95be5",
                                        "entry_id": "9008c2b7-337c-3d7a-b183-62acad737683",
                                        "glosses": [
                                            "Qualifie cheval qui rue de côté, qui semble user d’adresse contre celui qui le monte ou qui l’approche."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
