                        "glosses": [
                            "Hund, der dazu abgerichtet ist, bei der Jagd das angeschossene Wild aufzuspüren; aufpassen wie ein Schießhund"
                        ],
                        "tags": [
                            "Jägersprache veraltet",
                            "noch in der Redewendung"
                        ],
                        "examples": [
                            {
                                "example_id": "4a9a512a-f369-48ab-9e4c-84a8a7a7cedb",
                                "sense_id": "fb1cea7f-d062-3288-a104-16264d7227bf",
                                "text": "„Der eine Kaufmann hatte einen Schießhund, der lief in den Krug, worin Smiterlow war, und dieser band den Hund an, als wäre er sein, um ihn zu behalten.“"
                            }
                        ],
