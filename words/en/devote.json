{
    "word_family": [
        "devotion",
        "devotional",
        "devoted",
        "devotedly",
        "devotee"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08f655bb-27cf-38de-99e5-f4b48cb710ba",
                    "sense_definition": "To give one's time, focus, or efforts entirely to a specific person, activity, or cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commitment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>devote</w> her life to helping children in need.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>посвятить</w> свою жизнь помощи нуждающимся детям."
                            }
                        },
                        {
                            "text": "I will <w>devote</w> time to finish this project by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Я <w>уделю</w> время тому, чтобы закончить этот проект к концу недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "dedicate",
                        "commit",
                        "consecrate"
                    ],
                    "antonyms": [
                        "neglect",
                        "ignore"
                    ],
                    "common_phrases": [
                        "devote time",
                        "devote energy",
                        "devote resources",
                        "devote oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью отдавать свое время, внимание или усилия конкретному человеку, деятельности или делу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвящать",
                                "target_lang_sense_clarification": "время, жизнь или усилия чему-либо"
                            },
                            {
                                "target_lang_word": "уделять",
                                "target_lang_sense_clarification": "внимание или время"
                            },
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "себя целиком какому-то делу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7950b9d-c68a-3350-ae6e-561b16947450",
                    "sense_definition": "To give something over to a particular fate, often a negative or destructive one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient city was <w>devoted</w> to the flames after the long siege.",
                            "target_lang_translations": {
                                "ru": "После долгой осады древний город был <w>предан</w> огню."
                            }
                        },
                        {
                            "text": "The general was forced to <w>devote</w> his remaining troops to certain destruction.",
                            "target_lang_translations": {
                                "ru": "Генерал был вынужден <w>обречь</w> свои оставшиеся войска на верную гибель."
                            }
                        }
                    ],
                    "synonyms": [
                        "consign",
                        "doom",
                        "destine"
                    ],
                    "antonyms": [
                        "save",
                        "rescue"
                    ],
                    "common_phrases": [
                        "devote to destruction",
                        "devote to the flames"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in passive voice"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрекать что-либо на определенную, часто негативную или разрушительную участь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрекать",
                                "target_lang_sense_clarification": "на гибель или разрушение"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "огню или мечу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5b4432f-9194-311d-ae72-06b1964aa239",
                    "sense_definition": "To denounce or invoke a curse upon someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his anger, the wizard began to <w>devote</w> his enemies to the dark gods.",
                            "target_lang_translations": {
                                "ru": "В гневе волшебник начал <w>обрекать</w> своих врагов на милость темных богов."
                            }
                        },
                        {
                            "text": "The priest would <w>devote</w> any who broke the sacred laws to eternal misery.",
                            "target_lang_translations": {
                                "ru": "Священник <w>проклинал</w> на вечные муки любого, кто нарушал священные законы."
                            }
                        }
                    ],
                    "synonyms": [
                        "curse",
                        "execrate",
                        "damn"
                    ],
                    "antonyms": [
                        "bless"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проклинать или призывать кару на кого-либо или что-либо (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклинать",
                                "target_lang_sense_clarification": "предавать анафеме"
                            },
                            {
                                "target_lang_word": "обрекать",
                                "target_lang_sense_clarification": "на муки через проклятие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99246bdd-220e-3ad3-ad31-d3ee52156ee9",
                    "sense_definition": "Being deeply committed or loyal to a person, belief, or cause.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commitment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described a world <w>devote</w> to universal ruin and chaos.",
                            "target_lang_translations": {
                                "ru": "Поэт описал мир, <w>обреченный</w> на всеобщее разорение и хаос."
                            }
                        },
                        {
                            "text": "He remained a <w>devote</w> follower of the old traditions until his death.",
                            "target_lang_translations": {
                                "ru": "До самой смерти он оставался <w>преданным</w> последователем старых традиций."
                            }
                        }
                    ],
                    "synonyms": [
                        "devoted",
                        "devout",
                        "loyal"
                    ],
                    "antonyms": [
                        "disloyal",
                        "unfaithful"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English uses 'devoted' instead"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко преданный или верный человеку, убеждению или делу (архаичное использование прилагательного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "верный идеалам или людям"
                            },
                            {
                                "target_lang_word": "посвященный",
                                "target_lang_sense_clarification": "целиком отдавшийся чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}