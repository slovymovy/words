                                    {
                                        "sense_id": "2009d064-357c-3313-ae89-93a0722997b6",
                                        "entry_id": "acb93849-330a-3d2d-9a5c-5e7c27a57c2a",
                                        "glosses": [
                                            "kleines Tuch aus saugfähigem Material zum Abspülen von Geschirr und Reinigung von Oberflächen (in der Küche)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f074ad45-f645-44dd-9676-dc4d40d108bd",
                                                "sense_id": "2009d064-357c-3313-ae89-93a0722997b6",
                                                "text": "„Nicht nur viel schöner, sondern auch umweltfreundlicher im Gebrauch sind Abwaschlappen aus Baumwolle in der Küche. Sie haben gleich zwei Vorteile: Sie geben kein Mikroplastik ins Abwasser und sind waschbar und damit wiederverwertbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
