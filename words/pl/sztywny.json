{
    "word_family": [
        "sztywnieć",
        "sztywność",
        "sztywniak"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ec0bf24-dec8-3a4f-be98-4695b6260154",
                    "sense_definition": "niepoddający się wyginaniu, odporny na zginanie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczna_twardość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>sztywny</w> materiał jest idealny do produkcji mebli.",
                            "target_lang_translations": {
                                "ru": "Этот <w>жёсткий</w> материал идеально подходит для производства мебели."
                            }
                        },
                        {
                            "text": "Po nocy na mrozie kabel stał się bardzo <w>sztywny</w>.",
                            "target_lang_translations": {
                                "ru": "После ночи на морозе кабель стал очень <w>жёстким</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieelastyczny"
                    ],
                    "common_phrases": [
                        "sztywny materiał",
                        "sztywny kołnierzyk"
                    ],
                    "target_lang_definitions": {
                        "ru": "не поддающийся сгибанию, твёрдый, неэластичный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "твёрдый, плохо поддающийся деформации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b4b6c76-0701-3275-823b-6082186bcfb5",
                    "sense_definition": "nieumiejący się bawić lub wyluzować, zachowujący się nienaturalnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź taki <w>sztywny</w> i zacznij się wreszcie dobrze bawić.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>скованным</w> и начни наконец веселиться."
                            }
                        },
                        {
                            "text": "Jego <w>sztywny</w> sposób bycia sprawia, że ludzie czują się przy nim niekomfortowo.",
                            "target_lang_translations": {
                                "ru": "Его <w>скованная</w> манера поведения заставляет людей чувствовать себя некомфортно рядом с ним."
                            }
                        }
                    ],
                    "synonyms": [
                        "drętwy"
                    ],
                    "common_phrases": [
                        "sztywny sposób bycia"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w odniesieniu do zachowania"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "не умеющий расслабиться, ведущий себя неестественно, скованный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скованный",
                                "target_lang_sense_clarification": "о человеке, который не может расслабиться"
                            },
                            {
                                "target_lang_word": "зажатый",
                                "target_lang_sense_clarification": "разговорный вариант, описывающий неестественное поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4707f88d-b861-3845-8264-cab7603012e3",
                    "sense_definition": "nieżywy, zesztywniały po śmierci",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "śmierć",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znalazł w lesie <w>sztywny</w> korpus zwierzęcia.",
                            "target_lang_translations": {
                                "ru": "Он нашёл в лесу <w>окоченевший</w> труп животного."
                            }
                        },
                        {
                            "text": "Ciało było już zupełnie <w>sztywne</w> po kilku godzinach.",
                            "target_lang_translations": {
                                "ru": "Тело было уже совершенно <w>окоченевшим</w> спустя несколько часов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie stanu zwłok"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "окоченевший после смерти"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окоченевший",
                                "target_lang_sense_clarification": "ставший твёрдым после смерти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36758aeb-9a21-3a0a-92b7-ee43b670eccb",
                    "sense_definition": "trup, martwe ciało",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "śmierć",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W kryminale detektyw znalazł <w>sztywnego</w> w piwnicy.",
                            "target_lang_translations": {
                                "ru": "В детективе сыщик нашёл <w>труп</w> в подвале."
                            }
                        },
                        {
                            "text": "Znowu przywieźli jakiegoś <w>sztywnego</w> do kostnicy.",
                            "target_lang_translations": {
                                "ru": "Опять привезли какого-то <w>жмурика</w> в морг."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "bardzo potoczne, lekceważące określenie zwłok"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "труп, мёртвое тело (сленг)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труп",
                                "target_lang_sense_clarification": "нейтральное обозначение мертвого тела"
                            },
                            {
                                "target_lang_word": "жмурик",
                                "target_lang_sense_clarification": "грубое сленговое обозначение покойника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "766578f3-930c-39f7-9977-7dad1187ae5f",
                    "sense_definition": "człowiek kompletnie pijany",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pijaństwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po tej imprezie leżał pod płotem jak <w>sztywny</w>.",
                            "target_lang_translations": {
                                "ru": "После той вечеринки он лежал под забором <w>мертвецки пьяный</w>."
                            }
                        },
                        {
                            "text": "Wrócił do domu zupełnie <w>sztywny</w> po całonocnym piciu.",
                            "target_lang_translations": {
                                "ru": "Он вернулся домой <w>в стельку пьяный</w> после ночной попойки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "określenie osoby w stanie silnego upojenia alkoholowego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек в состоянии сильного алкогольного опьянения (сленг)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в стельку пьяный",
                                "target_lang_sense_clarification": "очень сильно пьяный человек"
                            },
                            {
                                "target_lang_word": "мертвецки пьяный",
                                "target_lang_sense_clarification": "состояние крайней степени опьянения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}