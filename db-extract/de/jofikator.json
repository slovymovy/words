                "senses": [
                    {
                        "sense_id": "beeace2a-6356-39d9-99c9-43d1342b3121",
                        "entry_id": "ed8c081e-003d-3139-954e-e26e072c7dc0",
                        "glosses": [
                            "Person, welche die Erhaltung des kyrillischen Buchstabens «ё» („jo“) im russischen Alphabet unterstützt und Jofizierung betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7581d5-44ae-4122-9def-ecf104418eee",
                                "sense_id": "beeace2a-6356-39d9-99c9-43d1342b3121",
                                "text": "„Seit Jahren kämpft der pensionierte Ingenieur an der Spitze der Jofikatoren.“"
                            },
                            {
                                "example_id": "d6dfe4e5-ef73-4c71-8663-c571e8de7ca5",
                                "sense_id": "beeace2a-6356-39d9-99c9-43d1342b3121",
                                "text": "„Ihre Gegner halten die Punkte für optional und halten die Jofikatoren für Amateure und Pedanten.“"
                            },
                            {
                                "example_id": "8337a5d8-955b-4c37-b4f4-797e7304adf5",
                                "sense_id": "beeace2a-6356-39d9-99c9-43d1342b3121",
                                "text": "„Im Ruhestand wurde er Mitglied der nationalen Sprachkommission und Russlands oberster Jofikator, wie er sich selbst nennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5407ac93-99fd-33df-a0e3-7e6af2e0bba2",
                        "entry_id": "ed8c081e-003d-3139-954e-e26e072c7dc0",
                        "glosses": [
