                "senses": [
                    {
                        "sense_id": "bbf6fdf3-51c3-3308-93eb-cdf4be4d8ed7",
                        "entry_id": "bf26387b-c790-31e9-8f4f-a6040e7ca3b2",
                        "glosses": [
                            "produkt spożywczy powstający w wyniku pieczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "797b4755-e0ee-473e-8bd0-dd060291d9c2",
                                "sense_id": "bbf6fdf3-51c3-3308-93eb-cdf4be4d8ed7",
                                "text": "Pączek to smaczny wypiek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bbd67f26-23b8-3350-b90d-1bdc2f843e2b",
                        "entry_id": "bf26387b-c790-31e9-8f4f-a6040e7ca3b2",
                        "glosses": [
                            "czynność wypiekania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c590ee3d-62c5-4a0e-9f7c-19a2ccfff5fd",
                                "sense_id": "bbd67f26-23b8-3350-b90d-1bdc2f843e2b",
                                "text": "Zakład ten zajmuje się wypiekiem ciast."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2492ce1e-740d-3d53-ba68-f66dbbc9c713",
                        "entry_id": "bf26387b-c790-31e9-8f4f-a6040e7ca3b2",
                        "glosses": [
                            "ilość produktów otrzymanych w czasie pieczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d908c5f-d931-489a-9fcb-cf3d2dbc573b",
                                "sense_id": "2492ce1e-740d-3d53-ba68-f66dbbc9c713",
                                "text": "Dzienny wypiek tej piekarni przekracza tysiąc sztuk."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "6542b3a0-a262-3ec3-b23e-cad5e1c67ddf",
                        "entry_id": "bf26387b-c790-31e9-8f4f-a6040e7ca3b2",
                        "glosses": [
                            "zaczerwienienie na twarzy, wywołane ekscytacją lub podnieceniem (najczęściej w liczbie mnogiej)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9160befd-6b39-4672-910a-c29f3e92d6a8",
                                "sense_id": "6542b3a0-a262-3ec3-b23e-cad5e1c67ddf",
                                "text": "Spojrzał na nią, a na jej twarzy pojawiły się wypieki."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
