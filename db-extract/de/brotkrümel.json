                    {
                        "sense_id": "9e4482cf-bbe6-3105-84b0-419640952eb0",
                        "entry_id": "05a00810-cd60-3c0e-b304-a6df68b704aa",
                        "glosses": [
                            "kleines, abgebröseltes Stück Brot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6064d13d-3bc6-4c5b-bd61-58971e946185",
                                "sense_id": "9e4482cf-bbe6-3105-84b0-419640952eb0",
                                "text": "„Ich warf ihnen Brotkrümel hin, sie schnappten sie auf und stolzierten weiter.“"
                            },
                            {
                                "example_id": "0d9d94e1-de1b-4157-abca-c0fcae330961",
                                "sense_id": "9e4482cf-bbe6-3105-84b0-419640952eb0",
                                "text": "„Gedankenverloren klaubte sie Brotkrümel von der Bettdecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08a1d5a7-9085-39e3-a49f-f4911969821a",
                        "entry_id": "05a00810-cd60-3c0e-b304-a6df68b704aa",
                        "glosses": [
                            "etwas ohne Bedeutung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c69188c2-70c9-46c5-b963-ff4e081bc324",
                                "sense_id": "08a1d5a7-9085-39e3-a49f-f4911969821a",
                                "text": "„Sie suchten sich scheinbar – auch ohne die Banker als gesellschaftliches Feindbild anzusehen – als Freibeuter im Netzuniversum ein lohnendes Ziel, statt sich darauf zu beschränken, wie die Masse im Hamsterrad zu funktionieren, um sich dort mit anderen um jeden kleinen Brotkrümel zu streiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
