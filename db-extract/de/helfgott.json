                ],
                "senses": [
                    {
                        "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                        "entry_id": "f150b76c-c975-35fc-b999-ac92fd360868",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295a9cea-b42d-43ce-9035-85f68f4c436a",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Frau Helfgott ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ace808ce-22b0-487b-92c1-79ba6ac6d382",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Herr Helfgott wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3faf168b-a3b9-4272-a48a-8b741c1cad9a",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Die Helfgotts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6d45e9f3-6d62-45fe-a43a-641b2f7aea40",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Der Helfgott trägt nie die Schals, die die Helfgott ihm strickt."
                            },
                            {
                                "example_id": "80557d00-32f0-45e4-8362-79d786d319f1",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Helfgott kommt, geht der Herr Helfgott.“"
                            },
                            {
                                "example_id": "4666b1a0-4207-4398-9bdc-7e065af2842a",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Helfgott kommt und geht."
                            },
                            {
                                "example_id": "9ce46b64-0091-4cbc-843a-95e624b49d73",
                                "sense_id": "60d50eff-77ca-3dba-b506-f2917f05215d",
                                "text": "Helfgotts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
