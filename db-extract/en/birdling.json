                                    },
                                    {
                                        "sense_id": "34662298-6c33-384a-91e7-cab074196724",
                                        "entry_id": "58b2e36e-126c-3a81-af9e-327b1906e97d",
                                        "glosses": [
                                            "Petit de l’oiseau, oiseau juvénile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3b768f-8a3d-44fe-9281-36c8f5c91328",
                                                "sense_id": "34662298-6c33-384a-91e7-cab074196724",
                                                "text": "En revanche, si l’oisillon est malade, il peut être volontairement abandonné pour ne pas mettre le reste de la progéniture en danger."
                                            },
                                            {
                                                "example_id": "e346c740-2321-4cb1-9bd2-58a06b25c4ce",
                                                "sense_id": "34662298-6c33-384a-91e7-cab074196724",
                                                "text": "[…] : beaucoup de ses oisillons, privés des soins maternels, périssaient ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1d2e6b-4e24-3f47-8d9f-3fcc9743b5b9",
                                        "entry_id": "58b2e36e-126c-3a81-af9e-327b1906e97d",
                                        "glosses": [
                                            "Embryon d’oiseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7407515f-1382-401e-9bcb-f15cbfa6b4fc",
                                                "sense_id": "4a1d2e6b-4e24-3f47-8d9f-3fcc9743b5b9",
                                                "text": "Lorsque les oisillons se préparent à éclore, ils stabilisent leur tête sous une aile, tout en perçant leur coquille avec leur bec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d80cb88-eb48-3926-9764-c5bb098a1649",
                                        "entry_id": "58b2e36e-126c-3a81-af9e-327b1906e97d",
                                        "glosses": [
                                            "Surnom donné à un rabot nommé guimbarde, par analogie de forme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
