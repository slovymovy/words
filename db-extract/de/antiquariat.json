                                "target_senses": [
                                    {
                                        "sense_id": "5b8c8d34-1d06-31eb-b9ba-6364ced75a2c",
                                        "entry_id": "e9cb9418-906c-3b47-badb-23b7a82e717b",
                                        "glosses": [
                                            "winkel of bedrijf dat oude en tweedehands boeken verhandelt en verkoopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6881ee94-f350-419a-84c3-3927864b81da",
                                                "sense_id": "5b8c8d34-1d06-31eb-b9ba-6364ced75a2c",
                                                "text": "In een antiquariaat vond ik een eerste uitgave van dat boek."
                                            },
                                            {
                                                "example_id": "61bc51d6-e973-46be-999c-ff38ea3377cc",
                                                "sense_id": "5b8c8d34-1d06-31eb-b9ba-6364ced75a2c",
                                                "text": "Na mijn verhuizing regelde Camila een baantje voor bij me bij een antiquair voor wie ze had gewerkt tijdens haar studie. Het antiquariaat in de rue de l'Abbaye, eigendom van een hoogbejaarde kunsthistoricus die Cortázar en Kiš en Pizarnik (van wie ik nog nooit had gehoord) als klant had gehad en die geen zorg meer kon dragen voor de winkel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
