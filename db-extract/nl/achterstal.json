                        "examples": [
                            {
                                "example_id": "1255d81f-ce6f-4910-a8ab-a15ddb053dd7",
                                "sense_id": "b8e0755a-ff3a-3060-afd2-a99906f4c4c2",
                                "text": "De ministerraad heeft donderdag op voorstel van minister van Economie Johan Vande Lanotte een aantal nieuwe regels rond het consumentenkrediet goedgekeurd. Momenteel hebben 319.042 landgenoten achterstal van betaling bij dergelijke kredieten en dat moet naar omlaag."
                            },
                            {
                                "example_id": "c6777ab4-0ef7-48a9-8c86-3d0dbe89986a",
                                "sense_id": "b8e0755a-ff3a-3060-afd2-a99906f4c4c2",
                                "text": "Aangezien dat akkoord deze week ongedaan is gemaakt, moet Oekraïne het achterstal van omgerekend 8,3 miljard euro ophoesten, zei Miller in een interview met Russische staatszenders."
                            },
                            {
                                "example_id": "f7c1a23c-c518-4f8a-af5c-5d9e5f06610d",
                                "sense_id": "b8e0755a-ff3a-3060-afd2-a99906f4c4c2",
                                "text": "Volgens de betrokken psychiater was er eind vorig jaar een achterstal van 162.000 euro in de betaling van zijn erelonen door de FOD Justitie. ‘Na verschillende tussenkomsten bij het kabinet van de minister werd beloofd dat er tegen eind november 74.000 euro betaald zou worden.’"
                            }
