                        {
                            "text": "De zeilers merkten dat de wind begon te <w>krimpen</w> van noord naar west.",
                            "target_lang_translations": {
                                "en": "The sailors noticed that the wind began to <w>back</w> from north to west."
                            }
                        }
                    ],
                    "antonyms": [
