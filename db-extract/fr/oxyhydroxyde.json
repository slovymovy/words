                        "examples": [
                            {
                                "example_id": "e075a284-87ab-48d4-a8e2-ae69ab69ed35",
                                "sense_id": "7ec2c039-7b3c-3ec4-9410-f06d24801f9a",
                                "text": "La goethite est l’oxyhydroxyde de fer (FeOOH) de couleur jaune, et l’hématite, l’oxyde ferrique (Fe₂O₃) de couleur rouge."
                            },
                            {
                                "example_id": "3c1276d3-ada6-47da-8cc3-c4fadf3faa00",
                                "sense_id": "7ec2c039-7b3c-3ec4-9410-f06d24801f9a",
                                "text": "Les oxyhydroxydes métalliques prennent alors le relais de la matière organique pour la rétention du Hg, qui s’accumule en profondeur en suivant l’abondance de ces oxyhydroxydes."
                            }
                        ]
