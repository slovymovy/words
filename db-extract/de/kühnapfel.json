                                "example_id": "5f438032-03fb-4cf5-bfce-88762203ba3b",
                                "sense_id": "b5a637fd-5ea9-36c1-af3b-9aaf3f0120e3",
                                "text": "Der Controlling-Professor Jörg Kühnapfel rät Paaren, ihre Situation bewusst einer Kosten-Nutzen-Analyse zu unterziehen."
                            },
