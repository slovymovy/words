                                        "glosses": [
                                            "een plaats geven"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f73bbe-3e1c-4ea8-abbb-0d674c8f09b6",
                                                "sense_id": "79cff4c0-ddbe-3ff8-a955-e25c934cc2c9",
                                                "text": "Piet was in een tehuis opgenomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5738f8ec-426f-3ddd-ae85-981be66982be",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "van de rekening afhalen en omzetten in contact geld"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91602b03-7c98-4cd6-be47-d7eb3bb170d6",
                                                "sense_id": "5738f8ec-426f-3ddd-ae85-981be66982be",
                                                "text": "Hij wilde het geld opnemen via de pinautomaat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b585cd8-2e60-347e-a3ea-377608ca3c35",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "opgespaarde vrije dagen gebruiken voor het vieren van een vakantie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca97b0e-9763-4b8e-a0df-12d91578df51",
                                                "sense_id": "2b585cd8-2e60-347e-a3ea-377608ca3c35",
                                                "text": "In een ander paper las ik over IJslandse vaders die na de geboorte van hun eerste kind vaderschapsverlof opnemen - sinds zøøø kent IJsland een ruimhartige verlofregeling voor vaders, met ten minste drie maanden betaald verlof, en de onderzoekers wilden weten in hoeverre dit van invloed was op de beslissing om geen, één, of meer kinderen te krijgen."
                                            },
                                            {
                                                "example_id": "2b7ca46d-6c3b-4f9c-9d41-0bcd4364b05c",
                                                "sense_id": "2b585cd8-2e60-347e-a3ea-377608ca3c35",
                                                "text": "Maar wees gewaarschuwd, het is zeer verslavend en voor je het weet heb je verlof opgenomen om in zes maanden van Mexico naar Canada te lopen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9e6eb06-1204-3151-af9a-d6e4e0c1d9b1",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "beginnen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca690f2-c12a-485d-a37e-964ea036b65f",
                                                "sense_id": "c9e6eb06-1204-3151-af9a-d6e4e0c1d9b1",
                                                "text": "Contact met iemand opnemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a84bd497-232f-3781-8e31-f923b6423d9d",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "bekijken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7825ab44-0b16-4077-8fc2-d47fc6213cef",
                                                "sense_id": "a84bd497-232f-3781-8e31-f923b6423d9d",
                                                "text": "Hij nam de tekst goed in hem op."
                                            },
                                            {
                                                "example_id": "1b1da9df-cafe-446b-892f-b5030499abc0",
                                                "sense_id": "a84bd497-232f-3781-8e31-f923b6423d9d",
                                                "text": "Het zo bewust mogelijk in me opnemen en de omgeving toetsen aan mijn herinnering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "401880a4-fcac-3f8a-b032-790bd166fe58",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "registreren, vastleggen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754c26e2-2026-44e5-a9ae-8e7f48ab22a5",
                                                "sense_id": "401880a4-fcac-3f8a-b032-790bd166fe58",
                                                "text": "Hij wilde het liedje opnemen."
                                            },
                                            {
                                                "example_id": "6169d852-e2c8-40aa-9ac9-defc054943d3",
                                                "sense_id": "401880a4-fcac-3f8a-b032-790bd166fe58",
                                                "text": "Dat vereenvoudigde het opnemen van onze gegevens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "449c03cb-01e4-36d5-8184-3f790b232970",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
                                            "opvatten."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7dea366-fb69-4383-9de1-ec01e26e78e8",
                                                "sense_id": "449c03cb-01e4-36d5-8184-3f790b232970",
                                                "text": "Gelukkig nam hij die rotopmerking goed op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "323faba3-45b7-3070-94c8-2df594f8ba06",
                                        "entry_id": "86c60fdd-7904-3099-9556-40c1bee9c9f0",
                                        "glosses": [
