                "senses": [
                    {
                        "sense_id": "98d19608-f615-3ae4-a927-485b49697352",
                        "entry_id": "8f0d901d-26a5-3c6f-bd65-1270475c07f4",
                        "glosses": [
                            "derbes, grobes Verhalten, das gegen die guten Sitten verstößt"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9a6183-8737-4d04-b42f-53373e9cce90",
                                "sense_id": "98d19608-f615-3ae4-a927-485b49697352",
                                "text": "„Montaigne ist der aufrichtigste und ehrlichste aller Schriftsteller. Seine französische Freimütigkeit streift an Unflätigkeit, aber er nimmt allen Tadel durch die Fülle seiner eigenen Geständnisse vorweg.“"
                            },
                            {
                                "example_id": "2d22cba4-a8d7-4ab2-913c-b9a7aa3c82d9",
                                "sense_id": "98d19608-f615-3ae4-a927-485b49697352",
                                "text": "„Die Mädchen liebkosen das hübsche Kind, die Buben stoßen ihn durch ihre Unflätigkeit ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6441be5-645d-3655-9f13-a4eab90df5da",
                        "entry_id": "8f0d901d-26a5-3c6f-bd65-1270475c07f4",
                        "glosses": [
                            "Äußerung, Handlung, Darstellung, die gegen die guten Sitten verstößt, das Schamgefühl verletzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f563fc7-1409-4d47-906d-382e71f38bbe",
                                "sense_id": "d6441be5-645d-3655-9f13-a4eab90df5da",
                                "text": "„Hatte er kein Geld, um Tabak oder Schnaps zu kaufen, war er bei einer Frau abgefahren, ärgerte er sich über irgendwas, dann konnte er mörderisch schimpfen; ich habe keinen anderen Menschen getroffen, dem in der Wut eine solche Sturzflut haarsträubendster Unflätigkeiten zur Verfügung stand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7d1a937-0529-4ff2-8d82-9837260ea574",
                        "source_entry_id": "8f0d901d-26a5-3c6f-bd65-1270475c07f4",
                        "source_sense_id": "98d19608-f615-3ae4-a927-485b49697352",
                        "source_sense_description": "kein Plural: derbes, grobes Verhalten, das gegen die guten Sitten verstößt",
                        "target_lang_word": "nastiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nastiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9950a249-45b3-3828-ab4e-ff7b2063fdc3",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Lack of cleanliness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dab62daa-862e-49de-ba78-5a783b440af0",
                                                "sense_id": "9950a249-45b3-3828-ab4e-ff7b2063fdc3",
                                                "text": "They neither comb their Head, nor wash their Face, / But think their virtuous Nastiness a grace."
                                            },
                                            {
                                                "example_id": "c4a0039c-942e-4edb-9159-937268670014",
                                                "sense_id": "9950a249-45b3-3828-ab4e-ff7b2063fdc3",
                                                "text": "Erasmus ascribes the frequent plagues in England to the nastiness and dirt and slovenly habits among the people. “The floors,” says he, “are commonly of clay, strewed with rushes, under which lies unmolested an ancient collection of beer, grease, fragments, bones, spittle, excrements of dogs and cats, and every thing that is nasty.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "846e45a0-573f-38cd-9333-a0f4386f8468",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Dirt, filth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b262b9ed-f383-4ccb-be2e-cd6663d7c738",
                                                "sense_id": "846e45a0-573f-38cd-9333-a0f4386f8468",
                                                "text": "[T]he helliſh Noiſe, the Roaring, Svvearing, and Clamour, the Stench and Naſtineſs, and all the dreadful croud of Afflicting things that I ſavv there; joyn'd together to make the Place ſeem an Emblem of Hell itſelf, and a kind of an Entrance into it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2aa237-e084-33b3-a34c-9f2c31d3758e",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Indecency; corruption; unkindness, meanness, spite, harshness, cruelty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231fdaec-6b93-43ec-85d6-ebd1bb54ddc8",
                                                "sense_id": "7c2aa237-e084-33b3-a34c-9f2c31d3758e",
                                                "text": "Among current novelists, Martin Amis lacks intellectual force but is well supplied with nastiness, which occasionally resembles humor."
                                            },
                                            {
                                                "example_id": "892690a1-5b56-4d75-9864-1f46eb69f26e",
                                                "sense_id": "7c2aa237-e084-33b3-a34c-9f2c31d3758e",
                                                "text": "Despite efforts to curb hate speech, eradicate bullying and extend tolerance, a culture of nastiness has metastasized in which meanness is routinely rewarded, and common decency and civility are brushed aside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3ddb7ae-3c0f-3bb2-b09c-c5cf6274441f",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "Unpleasantness, disagreeableness (to the senses)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c04fb53-7d0c-4ca0-a94d-f0b3bcc3b83a",
                                                "sense_id": "e3ddb7ae-3c0f-3bb2-b09c-c5cf6274441f",
                                                "text": "Some medical beast had revived Tar-water in those days as a fine medicine, and Mrs. Joe always kept a supply of it in the cupboard; having a belief in its virtues correspondent to its nastiness."
                                            },
                                            {
                                                "example_id": "d23f8e46-4a27-4996-a012-c3912152cb8f",
                                                "sense_id": "e3ddb7ae-3c0f-3bb2-b09c-c5cf6274441f",
                                                "text": "During the day, the surrounding blocks are no better, full of cheesy bars, tacky shops and brash, neon nastiness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                        "entry_id": "c25b906c-d2e9-3710-9301-108a18fd1215",
                                        "glosses": [
                                            "A nasty action, object, quality, etc. (all senses of nasty)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b624912-f7e0-4f51-9d3f-ea83c9c5c82f",
                                                "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                                "text": "If we, who are educated, habitually submit to have copper in our preserves, red-lead in our cayenne, alum in our bread, pigments in our tea, and ineffable nastinesses in our fish-sauce, what can we expect of the poor?"
                                            },
                                            {
                                                "example_id": "cb618bda-d3a0-4e3b-84ba-20bbb335d9a4",
                                                "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                                "text": "[…] imagine the delights of bathing when the Baths were open to public view, the said public delighting to throw dead cats, offal, and all manner of nastinesses among the bathers!"
                                            },
                                            {
                                                "example_id": "e773b3a3-4abc-4258-876d-962271e3516e",
                                                "sense_id": "e37fae69-08e3-3e6d-934a-eb4e255a4c8a",
                                                "text": "He’s too thoughtful to pretend he’s speaking for humankind on what passes for a Dan Bern protest song—“Tape” folds in a conversational outreach to a girl (“Baby did you get the tape I sent?”) along with a rundown of various societal nastinesses, including the prescient, “We might get to see World War III by Thanksgiving Day.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "158eb1cc-3b1b-48f2-9a63-88a31dfe418d",
                        "source_entry_id": "8f0d901d-26a5-3c6f-bd65-1270475c07f4",
                        "source_sense_id": "98d19608-f615-3ae4-a927-485b49697352",
                        "source_sense_description": "kein Plural: derbes, grobes Verhalten, das gegen die guten Sitten verstößt",
                        "target_lang_word": "obscénité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscénité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e993910-eebd-36c9-b0cc-50de142a0cfc",
                                        "entry_id": "945e189d-dea4-3c14-a181-531f2e5d1af6",
                                        "glosses": [
                                            "Caractère de ce qui est obscène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b37b674-0979-45d3-9608-80ae8e38c568",
                                                "sense_id": "7e993910-eebd-36c9-b0cc-50de142a0cfc",
                                                "text": "C'était dans une longue salle basse […] dont les murs blanchis à la chaux étaient couverts d’inscriptions et de dessins, la plupart d’une obscénité brutale, œuvre des clients."
                                            },
                                            {
                                                "example_id": "54fcac35-8ca5-4a25-998b-a18a1b57b6d8",
                                                "sense_id": "7e993910-eebd-36c9-b0cc-50de142a0cfc",
                                                "text": "Exactement. Avant d'être une industrie masturbatoire, la pornographie est l'art de montrer ce qui est obscène. […]. À force de représenter l’obscénité, on la banalise et on finit par l'admettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0196cd-9a5d-3ef6-bb0c-2c90844e73c6",
                                        "entry_id": "945e189d-dea4-3c14-a181-531f2e5d1af6",
                                        "glosses": [
                                            "Tout ce qui a un caractère obscène."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a036fd4-a37e-4dce-9d7f-9252138985e9",
                                                "sense_id": "af0196cd-9a5d-3ef6-bb0c-2c90844e73c6",
                                                "text": "Je ne suis pas collet-monté, tant s’en faut, mais j'avoue, à ma honte, que les obscénités me déplaisent."
                                            },
                                            {
                                                "example_id": "87788d2a-dfaa-4bc9-8727-7840378770ac",
                                                "sense_id": "af0196cd-9a5d-3ef6-bb0c-2c90844e73c6",
                                                "text": "J’allai chez Olympe, que je trouvai essayant des robes, et qui, lorsque nous fûmes seuls, me chanta des obscénités pour me distraire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
