                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hildegarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db033855-edee-3450-9e7b-c33e1c58e5d4",
                                        "entry_id": "463dee4a-c1f6-3394-bab1-dbc817fede87",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d884f3ef-5a8b-4e57-8c74-a24c926158df",
                                                "sense_id": "db033855-edee-3450-9e7b-c33e1c58e5d4",
                                                "text": "Hildegarde de Bingen, dont les écrits du XIIᵉ siècle influenceront Dante et Léonard de Vinci, est une autre grande figure de la mystique."
                                            },
                                            {
                                                "example_id": "84214408-0480-490b-8137-35e3cf8d4452",
                                                "sense_id": "db033855-edee-3450-9e7b-c33e1c58e5d4",
                                                "text": "Ainsi, la vision anticathare contenue dans le Liber visionum a pu très tôt être comprise comme un complément bienvenu à la vision II d’Hildegarde."
                                            },
                                            {
                                                "example_id": "e4fcc51d-ddbd-4b27-ad90-cd797e296cc3",
                                                "sense_id": "db033855-edee-3450-9e7b-c33e1c58e5d4",
                                                "text": "J’ai publié deux ouvrages historiques, je prépare un essai sur Marcel Proust et j’envisage d’écrire une pièce de théâtre qui mettra en scène Himiltrude, Désirée, Hildegarde, Fastrade et Liutgarde, les cinq femmes de Charlemagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
