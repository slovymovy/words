                        "entry_id": "5484c333-8a4f-37ae-9721-1de42a630d26",
                        "glosses": [
                            "een vuilstortplaats, als de hoeveelheid vuil toeneemt ontstaat er een heuvel, een belt van vuil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167f2014-2d85-4645-87d9-0aa9b327aae3",
                                "sense_id": "a726150a-8660-3d36-babb-9c57bf01bb61",
                                "text": "De meeuwen doen zich tegoed aan het vuil op de vuilnisbelt."
                            },
                            {
                                "example_id": "a8b2e1a3-e361-4074-be9e-133e299b850c",
                                "sense_id": "a726150a-8660-3d36-babb-9c57bf01bb61",
                                "text": "Door het toenemend gebruik van vuilverbrandingsinstallaties zijn er minder vuilnisbelten."
                            },
                            {
                                "example_id": "1b3f6150-1cd3-4012-86db-5de19af0e4f7",
                                "sense_id": "a726150a-8660-3d36-babb-9c57bf01bb61",
                                "text": "Oude vuilnisbelten worden bedekt met aarde omgebouwd tot een heuvelachtig park, ook wel een puinduin genoemd."
                            }
                        ]
                    }
