                    {
                        "sense_id": "55b65dfe-759c-39ec-8a73-fb4e6bc870e5",
                        "entry_id": "ae3e6c61-efb9-376b-bb97-34ca36a267b7",
                        "glosses": [
                            "Objet dual (de quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61205377-debe-41f1-862d-46078275c2fe",
                                "sense_id": "55b65dfe-759c-39ec-8a73-fb4e6bc870e5",
                                "text": "Le tétraèdre est son propre dual."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b76d7cd-1fb8-33b0-930e-53f56a029160",
                        "entry_id": "ae3e6c61-efb9-376b-bb97-34ca36a267b7",
                        "glosses": [
                            "Deuxième forme d’un problème d’optimisation avec contraintes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6362bc49-49ec-43e2-bdc2-b1afc7c71683",
                                "sense_id": "8b76d7cd-1fb8-33b0-930e-53f56a029160",
                                "text": "Confronté à un problème d'optimisation, il est parfois plus facile de résoudre son dual."
                            }
                        ]
                    },
                    {
                        "sense_id": "23c31add-5876-3579-a84f-19cb821bcfec",
                        "entry_id": "ae3e6c61-efb9-376b-bb97-34ca36a267b7",
                        "glosses": [
                            "Infraction à l’exactitude de la marche des blancs dans la solution à un problème d’échecs ou de dames."
                        ],
                        "tags": [
                            "Jeu de dames"
                        ],
                        "examples": [
                            {
                                "example_id": "f481db64-d5bd-4fe8-88e3-b3f00d821226",
                                "sense_id": "23c31add-5876-3579-a84f-19cb821bcfec",
                                "text": "Malheureusement dans ce problème il y a un dual inacceptable, le pion pouvant être promu en dame ou en tour dans une des deux solutions."
                            },
                            {
                                "example_id": "22cfc15c-a802-45b4-bee4-060fb41597d7",
                                "sense_id": "23c31add-5876-3579-a84f-19cb821bcfec",
                                "text": "Le dual est l’infraction à l’exactitude de la marche des blancs. Le dual ne doit pas mener à une autre fin de partie ou à une autre position finale que celles apparues dans la variante thématique donnée par l’auteur."
                            }
                        ]
                    }
                ],
