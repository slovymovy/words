                        ],
                        "form": "den Phantasien"
                    },
                    {
                        "form_id": "d1bd09af-1583-4ee1-aa70-eb323f5b1c39",
                        "entry_id": "e08cf043-6be5-3cfd-9c09-69de587a666c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Phantasie"
                    },
                    {
                        "form_id": "bcb91de2-1b52-4dd0-9330-ca18df763455",
                        "entry_id": "e08cf043-6be5-3cfd-9c09-69de587a666c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Phantasien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d43735a8-1696-39b3-86ff-99951d2e170b",
                        "entry_id": "e08cf043-6be5-3cfd-9c09-69de587a666c",
                        "glosses": [
                            "Vorstellungsvermögen oder Kreativität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "883b2cc7-21b4-4354-bd27-bf7eebe417bb",
                                "sense_id": "d43735a8-1696-39b3-86ff-99951d2e170b",
                                "text": "„Es kam noch häufiger vor, dass seine Phantasie stärker war als seine Beobachtung.“"
                            },
                            {
                                "example_id": "e1f242ec-8c0f-4939-9d35-960406e8035d",
                                "sense_id": "d43735a8-1696-39b3-86ff-99951d2e170b",
                                "text": "„Es ist ein wunderlicher Vorgang, wie die Phantasie gleich einem Fieber, dessen Keime von weither getrieben werden, von unserem Leben Besitz ergreift und immer tiefer und glühender sich in ihm einnistet.“"
                            },
                            {
                                "example_id": "cf70f5b4-62cd-4265-ad28-86188be3f938",
                                "sense_id": "d43735a8-1696-39b3-86ff-99951d2e170b",
                                "text": "„Zwar hatte in seiner Ästhetik immer die Phantasie das Primat.“"
                            },
                            {
                                "example_id": "bbca2da4-93ce-4266-a844-9d1bca2e7fe2",
                                "sense_id": "d43735a8-1696-39b3-86ff-99951d2e170b",
                                "text": "„Schwule, Lesben, Huren, Zuhälter – das unbürgerliche Gegenleben fesselte seine Phantasien (und wurde zum menschlichen Studienobjekt).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "04f52dd0-9b53-3ba5-a6cf-99bb64bc5dcd",
                        "entry_id": "e08cf043-6be5-3cfd-9c09-69de587a666c",
                        "glosses": [
                            "vorgestellte Ereignisse und Zustände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83206726-9919-4b40-8f3f-4bd07ba06136",
                                "sense_id": "04f52dd0-9b53-3ba5-a6cf-99bb64bc5dcd",
                                "text": "„Seine trübe Phantasie hatte ihn aufgejagt von seinem Lager und in den Wald getrieben, wo er umhergeschweift war, bis die naßkalte Nachtluft und das gedehnte gellende Gelächter der Eulen ihn wieder zurückjagte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
