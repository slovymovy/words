                    },
                    {
                        "translation_id": "7bbf36ea-9064-49dc-94ba-7751d04b15c2",
                        "source_entry_id": "85fc78c3-14ed-3a7d-9f4e-792fb795b639",
                        "source_sense_id": "ad39acb5-b7b4-3402-8857-fed9ed3aba7f",
                        "target_lang_word": "pétrolier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétrolier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "840f37fc-989d-350f-9d4e-b0494bd6e756",
                                        "entry_id": "19062c9e-10dd-3dd9-a9aa-6e748abacfd5",
                                        "glosses": [
                                            "Navire-citerne conçu pour le transport en vrac de pétrole et des produits pétroliers."
                                        ],
                                        "tags": [
                                            "Navigation",
                                            "Industrie pétrolière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9acbba-9fbe-4d5a-8e17-4a9f8f534c3b",
                                                "sense_id": "840f37fc-989d-350f-9d4e-b0494bd6e756",
                                                "text": "Le pétrolier transporte de l’essence, le gazier est rempli de gaz, et le chimiquier voyage avec des produits chimiques dans ses réservoirs."
                                            },
                                            {
                                                "example_id": "0dc83edb-72c3-4029-aaf8-7be2eefe5848",
                                                "sense_id": "840f37fc-989d-350f-9d4e-b0494bd6e756",
                                                "text": "Si les pétroliers transportaient de l’eau de mer, on s’en foutrait qu’ils fassent naufrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e5ee6d-f59e-3f3e-95b4-a171e276b902",
                                        "entry_id": "19062c9e-10dd-3dd9-a9aa-6e748abacfd5",
                                        "glosses": [
                                            "Industriel ou financier des sociétés pétrolières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a11713-0b9a-42bf-8917-6e2466863595",
                                                "sense_id": "f0e5ee6d-f59e-3f3e-95b4-a171e276b902",
                                                "text": "Ce pétrolier a fait fortune en peu de temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétrolier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01b4e979-b82e-35ee-8f43-fcecaad8c9a7",
                                        "entry_id": "540b1762-8600-39f6-a421-8e595264d61f",
                                        "glosses": [
                                            "Relatif au pétrole, à son commerce et à son industrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "522de6fb-fd47-4e83-ae55-41b6078055c4",
                                                "sense_id": "01b4e979-b82e-35ee-8f43-fcecaad8c9a7",
                                                "text": "À la tête d’Eacop, on trouve TotalEnergies, mais aussi la Cnooc, compagnie pétrolière chinoise, et les compagnies nationales ougandaise et tanzanienne."
                                            },
                                            {
                                                "example_id": "3fde25bc-2eef-4917-bed9-1bb8b9476e22",
                                                "sense_id": "01b4e979-b82e-35ee-8f43-fcecaad8c9a7",
                                                "text": "Avec la crise pétrolière des années 1970, la SNCF relance l’étude de l’électrification de son réseau."
                                            },
                                            {
                                                "example_id": "8166097a-e2d3-4fc4-8afe-c498a00b9458",
                                                "sense_id": "01b4e979-b82e-35ee-8f43-fcecaad8c9a7",
                                                "text": "On recommencera tout à zéro, dans un monde enfin débarrassé de la finance, des religions, de Monsanto, d'Aréva, d'Universal, de Mac Donald, des sept frangines pétrolières, du coaching pour tout et portnawak, de la téléréalité, des exodes aoûtiens et du curling discipline olympique !"
                                            },
                                            {
                                                "example_id": "3e7f189e-88c7-41e0-92ba-b145d58e789b",
                                                "sense_id": "01b4e979-b82e-35ee-8f43-fcecaad8c9a7",
                                                "text": "On parle alors de faciès sapropélique, terme provenant du grec sapros voulant dire « pourriture ». Même si la biomasse initiale a été fortement retravaillée par les bactéries, cette matière organique présente un bon potentiel pétrolier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7751ff1d-eaec-48cb-9528-8135b938c95e",
                        "source_entry_id": "85fc78c3-14ed-3a7d-9f4e-792fb795b639",
                        "source_sense_id": "ad39acb5-b7b4-3402-8857-fed9ed3aba7f",
