{
    "word_family": [
        "frighten",
        "frightful",
        "frightening"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa1c803c-f91c-3789-b93f-6535abeed209",
                    "sense_definition": "A sudden feeling of intense fear or alarm caused by danger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She jumped in <w>fright</w> when the door suddenly slammed shut.",
                            "target_lang_translations": {
                                "ru": "Она вздрогнула от <w>испуга</w>, когда дверь внезапно захлопнулась."
                            }
                        },
                        {
                            "text": "He stood frozen with <w>fright</w> as the large dog barked at him.",
                            "target_lang_translations": {
                                "ru": "Он застыл от <w>страха</w>, когда большая собака залаяла на него."
                            }
                        }
                    ],
                    "synonyms": [
                        "alarm",
                        "terror",
                        "panic"
                    ],
                    "antonyms": [
                        "calm",
                        "composure"
                    ],
                    "common_phrases": [
                        "jump in fright",
                        "paralyzed with fright"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное чувство сильного страха или тревоги, вызванное опасностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуг",
                                "target_lang_sense_clarification": "внезапное чувство страха"
                            },
                            {
                                "target_lang_word": "страх",
                                "target_lang_sense_clarification": "состояние тревоги или ужаса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73fb4912-def0-387b-adde-d059d2522868",
                    "sense_definition": "A person or thing that is very ugly, strange, or shocking in appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked a total <w>fright</w> in that ridiculous, oversized hat.",
                            "target_lang_translations": {
                                "ru": "Она выглядела как полное <w>пугало</w> в этой нелепой, огромной шляпе."
                            }
                        },
                        {
                            "text": "The old house was a complete <w>fright</w> with its broken windows and peeling paint.",
                            "target_lang_translations": {
                                "ru": "Старый дом был настоящим <w>страшилищем</w> с разбитыми окнами и облупившейся краской."
                            }
                        }
                    ],
                    "synonyms": [
                        "eyesore",
                        "monstrosity"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe someone's appearance in a critical way."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который выглядит очень некрасиво, странно или шокирующе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугало",
                                "target_lang_sense_clarification": "разг. о человеке, который нелепо или безобразно одет"
                            },
                            {
                                "target_lang_word": "страшилище",
                                "target_lang_sense_clarification": "очень некрасивый человек или пугающий вид"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                    "sense_definition": "To cause someone to feel sudden fear or alarm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud thunder <w>frights</w> the small children during the night.",
                            "target_lang_translations": {
                                "ru": "Громкий гром <w>пугает</w> маленьких детей по ночам."
                            }
                        },
                        {
                            "text": "Do not try to <w>fright</w> the birds away from the garden.",
                            "target_lang_translations": {
                                "ru": "Не пытайся <w>испугать</w> птиц, чтобы они улетели из сада."
                            }
                        }
                    ],
                    "synonyms": [
                        "scare",
                        "startle",
                        "terrify"
                    ],
                    "antonyms": [
                        "reassure",
                        "comfort"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Less common than the verb frighten in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо внезапное чувство страха или тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугать",
                                "target_lang_sense_clarification": "вселять страх, заставлять бояться"
                            },
                            {
                                "target_lang_word": "испугать",
                                "target_lang_sense_clarification": "заставить кого-либо испытать внезапный страх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                    "sense_definition": "Feeling afraid or scared.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>fright</w> as he walked through the dark forest alone.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>испуганным</w>, когда один шел через темный лес."
                            }
                        },
                        {
                            "text": "The <w>fright</w> animal ran quickly into the deep woods.",
                            "target_lang_translations": {
                                "ru": "<w>Испуганное</w> животное быстро убежало в чащу леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "afraid",
                        "frightened"
                    ],
                    "antonyms": [
                        "brave",
                        "fearless"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий страх или испуг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуганный",
                                "target_lang_sense_clarification": "тот, кто испытывает страх"
                            },
                            {
                                "target_lang_word": "напуганный",
                                "target_lang_sense_clarification": "тот, кого заставили бояться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}