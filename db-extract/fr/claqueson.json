                        "glosses": [
                            "Avertisseur sonore de voiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493eedc4-960d-4a9d-a2c1-3ed389bb0e47",
                                "sense_id": "204a92bc-3a1a-33ab-893d-ff6a08af8342",
                                "text": "« Il sait appeler tous les oiseaux. Il imite une bouteille de cidre qu’on débouche, le claqueson des autos, le bêlement des chèvres et le bourdonnement des burgaux (frelons). »"
                            },
                            {
                                "example_id": "b1bc94f6-c49c-4bf0-9a44-6e2c9c6fc596",
                                "sense_id": "204a92bc-3a1a-33ab-893d-ff6a08af8342",
                                "text": "Les claquesons hurlaient de plus en plus fort, un vrai orage."
                            },
                            {
                                "example_id": "e1666dc3-bd9e-4d6e-a8f6-fc78a0f87d09",
                                "sense_id": "204a92bc-3a1a-33ab-893d-ff6a08af8342",
                                "text": "Il donna quelques coups de claqueson."
                            }
                        ]
                    }
