        "ru-extract.jsonl": [
            {
                "entry_id": "32533659-4b3e-3d8b-a1ea-cf66c0da7350",
                "word": "наряду",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "3ac98a54-ccc1-4f17-b0e2-fc8484253556",
                        "entry_id": "32533659-4b3e-3d8b-a1ea-cf66c0da7350",
                        "tags": [
                            "stressed"
                        ],
                        "form": "наряду́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5918d25d-e3bf-3e2c-828e-9c3b64c5af69",
                        "entry_id": "32533659-4b3e-3d8b-a1ea-cf66c0da7350",
                        "glosses": [
                            "одинаково, на одинаковых правах, условиях; одновременно, наравне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a5143a3-4b56-46b3-b550-9b07d596c85e",
                                "sense_id": "5918d25d-e3bf-3e2c-828e-9c3b64c5af69",
                                "text": "Же́нщины рабо́тали наряду́ с мужчи́нами."
                            }
                        ]
                    },
                    {
                        "sense_id": "395540d1-3078-39bb-a050-67b8c3172bad",
                        "entry_id": "32533659-4b3e-3d8b-a1ea-cf66c0da7350",
                        "glosses": [
                            "книжн. вместе с кем-либо, наравне, одновременно с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ab3d16-41d0-4396-bd75-68c4bec6f484",
                                "sense_id": "395540d1-3078-39bb-a050-67b8c3172bad",
                                "text": "Наряду́ с трамва́ем мы по́льзуемся авто́бусом."
                            },
                            {
                                "example_id": "5f8beb38-f714-418b-8e0e-8c8cbf612868",
                                "sense_id": "395540d1-3078-39bb-a050-67b8c3172bad",
                                "text": "Созна́лся во всём, но наряду́ с э́тим про́бовал умали́ть свою́ вину́."
                            },
                            {
                                "example_id": "f4e5ac4a-2f57-498c-8d56-39341168a922",
                                "sense_id": "395540d1-3078-39bb-a050-67b8c3172bad",
                                "text": "Безве́стной умере́ть со все́ми наряду́!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d819856b-b767-412d-81cc-acb046d9fac0",
                        "source_entry_id": "32533659-4b3e-3d8b-a1ea-cf66c0da7350",
                        "target_lang_word": "along",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "along",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "effb8be2-c594-398d-af4a-4e376556f0c5",
                                        "entry_id": "7155f67b-7a4f-3e23-baf4-098c1eacea88",
                                        "glosses": [
                                            "By the length of; in a line with the length of; lengthwise next to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ce5cda-e24e-4da0-aadb-ec91bad016ba",
                                                "sense_id": "effb8be2-c594-398d-af4a-4e376556f0c5",
                                                "text": "They were waiting for me in the drawing-room, which is a very large room, stretching along the entire front of the house, with three long windows reaching down to the floor"
                                            },
                                            {
                                                "example_id": "2353378e-34af-410c-8366-496e4a9768bc",
                                                "sense_id": "effb8be2-c594-398d-af4a-4e376556f0c5",
                                                "text": "My hopes wa'n't disappointed. I never saw clams thicker than they was along them inshore flats. I filled my dreener in no time, and then it come to me that 'twouldn't be a bad idee to get a lot more, take 'em with me to Wellmouth, and peddle 'em out. Clams was fairly scarce over that side of the bay and ought to fetch a fair price."
                                            },
                                            {
                                                "example_id": "0e0c1435-6360-4f02-88c6-45b8d19a4f8c",
                                                "sense_id": "effb8be2-c594-398d-af4a-4e376556f0c5",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b72d12e3-e462-3704-8f9d-92bd73b94864",
                                        "entry_id": "7155f67b-7a4f-3e23-baf4-098c1eacea88",
                                        "glosses": [
                                            "In a line with, with a progressive motion on; onward on; forward on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad65643-bb85-459c-8437-11a0328ce9f2",
                                                "sense_id": "b72d12e3-e462-3704-8f9d-92bd73b94864",
                                                "text": "The kine[…]went along the highway."
                                            },
                                            {
                                                "example_id": "6816484b-0efb-400c-b8db-9e2a0740c2f0",
                                                "sense_id": "b72d12e3-e462-3704-8f9d-92bd73b94864",
                                                "text": "In the lightness of my heart I sang catches of songs as my horse gayly bore me along the well-remembered road."
                                            },
                                            {
                                                "example_id": "53e908e0-dc8e-4178-8d94-bf5620f5bf1b",
                                                "sense_id": "b72d12e3-e462-3704-8f9d-92bd73b94864",
                                                "text": "Swiftly and silently he made his way along the track which ran through the meadows."
                                            },
                                            {
                                                "example_id": "1e52227f-9bae-4d62-9987-ba7331cbdaf5",
                                                "sense_id": "b72d12e3-e462-3704-8f9d-92bd73b94864",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "along",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a491116d-f7eb-388d-a38f-e69c7d39dc02",
                                        "entry_id": "27b839c2-bf5a-3007-be4b-5b8683275acc",
                                        "glosses": [
                                            "In company; together."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "721a583f-e4f4-470f-b01b-7bb066963650",
                                                "sense_id": "a491116d-f7eb-388d-a38f-e69c7d39dc02",
                                                "text": "John played the piano and everyone sang along."
                                            },
                                            {
                                                "example_id": "f2d8b697-9e6b-46a6-bb15-d8fa94a6c358",
                                                "sense_id": "a491116d-f7eb-388d-a38f-e69c7d39dc02",
                                                "text": "From The Best of You to The Pretender, their own material invariably came equipped with huge choruses designed to be bellowed along to; they covered Another One Bites the Dust and Under Pressure; they gave every impression of being willing to play all night were it not for the curfew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe585b1-1b63-3f8c-9876-a0807e303597",
                                        "entry_id": "27b839c2-bf5a-3007-be4b-5b8683275acc",
                                        "glosses": [
                                            "Onward, forward, with progressive action."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9f3529-638a-416e-8107-d3ed6dea9a28",
                                                "sense_id": "efe585b1-1b63-3f8c-9876-a0807e303597",
                                                "text": "Don't stop here. Just move along."
                                            },
                                            {
                                                "example_id": "654b94d2-60c1-4ad7-978f-9cb18d371cd0",
                                                "sense_id": "efe585b1-1b63-3f8c-9876-a0807e303597",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c552ede-51b2-4021-a178-59dc185271ab",
                        "source_entry_id": "32533659-4b3e-3d8b-a1ea-cf66c0da7350",
                        "target_lang_word": "equally with",
                        "target_lang_code": "en",
