                        ],
                        "examples": [
                            {
                                "example_id": "a5d69af4-96c9-4357-b580-3c5591c500f8",
                                "sense_id": "faa2a86f-0d26-3fe2-949e-5abda44bc40d",
                                "text": "„Ösung und Trageweise geben einen Hinweis auf die Funktion von Brakteaten als Amulette.“"
                            },
                            {
                                "example_id": "d35cc36d-f0f9-4beb-864a-28b49bb34117",
                                "sense_id": "faa2a86f-0d26-3fe2-949e-5abda44bc40d",
                                "text": "„Gelegentlich wurden mehrere Brakteaten vom gleichen Stempel und durch eine goldene Stange verbunden zusammengefügt:…“"
                            },
                            {
                                "example_id": "deba5ad2-9865-4e1e-b6e0-e118bc886dd7",
                                "sense_id": "faa2a86f-0d26-3fe2-949e-5abda44bc40d",
                                "text": "„Unter den Schmucksachen kehren, neben den stark vertretenen Braktaten, Spangen am häufigsten wieder…“"
                            },
                            {
                                "example_id": "e21b4368-57d5-4e40-9430-95eb7980382c",
                                "sense_id": "faa2a86f-0d26-3fe2-949e-5abda44bc40d",
                                "text": "„So trägt ein schwedischer Brakteat von Vadstena aus der Zeit um 550 die gesamte Runenreihe in Umschrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
