                    {
                        "sense_id": "77bd70f8-90dc-31dc-b453-041c50c1bd59",
                        "entry_id": "f370bd75-f822-391e-b4db-23c1d4e088f4",
                        "glosses": [
                            "Not liturgic; without a liturgy."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bfe375dc-c34b-4678-8fd5-5783b964a816",
                                "sense_id": "77bd70f8-90dc-31dc-b453-041c50c1bd59",
                                "text": "Better indeed would it be to return to the old Jewish sacrifices, than to embrace the aliturgic weakness of Protestantism."
                            },
                            {
                                "example_id": "5f31de95-0057-49b1-ba6e-7beaa0ac7a4b",
                                "sense_id": "77bd70f8-90dc-31dc-b453-041c50c1bd59",
                                "text": "It is probable that the custom of reserving for the aliturgic days, and permitting the people to communicate of the presanctified, i.e. the previously consecrated, gifts, in order to satisfy this desire, arose in the Greek Church not later than the earlier part of the seventh century."
                            },
                            {
                                "example_id": "40792ae8-f4c2-4ecb-8051-54d173f1398e",
                                "sense_id": "77bd70f8-90dc-31dc-b453-041c50c1bd59",
                                "text": "Saturday in Holy Week marked the rest of Christ in the tomb and was a totally aliturgic day with a total fast. The Eucharist was not celebrated."
                            },
                            {
                                "example_id": "0df15888-7df4-4769-872f-e884433ad250",
                                "sense_id": "77bd70f8-90dc-31dc-b453-041c50c1bd59",
                                "text": "This is done on Maundy Thursday, and the particles so treated serve for the aliturgic days of Lent, and for the sick."
                            }
                        ]
                    }
