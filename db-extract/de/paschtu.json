                "senses": [
                    {
                        "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                        "entry_id": "6407a1d6-24a2-3210-ab2e-acf5e4651ee1",
                        "glosses": [
                            "eine der Amtssprachen Afghanistans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77090595-2035-4ad3-b36e-9a90984afebd",
                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                "text": "Paschtu wird in arabischer Schrift geschrieben und besitzt ein eigenes Alphabet."
                            },
                            {
                                "example_id": "a02fdb3e-bcb9-4943-b774-7f38efc46bab",
                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                "text": "„Zudem wird bemängelt, dass er nur auf Paschtu - neben Dari eine der beiden offiziellen Sprachen des Landes - verfasst ist.“"
                            },
                            {
                                "example_id": "71861765-2319-4aed-be2a-9cfdf660c16c",
                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                "text": "„Die wichtigsten und am weitesten verbreiteten Sprachen sind zum einen die lingua franca Dari, die afghanische Variante des Persischen, zum anderen Paschtu, die Sprache der Paschtunen.“"
                            },
                            {
                                "example_id": "ac7e2f86-6e30-4109-b599-365198f90ded",
                                "sense_id": "2b76dd8b-1fbc-3786-a24a-4f8ba005e250",
                                "text": "„Er sprach natürlich Paschtu, die Sprache der Afghanen, und konnte mir unterwegs Unterricht erteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
