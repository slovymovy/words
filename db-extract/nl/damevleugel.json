                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d4f976-d2cb-459d-b8f9-764ea16efb40",
                                "sense_id": "a3d20006-d933-393d-a65e-5f21419abf9f",
                                "text": "De met wit spelende uitdager Anand viel aan over de damevleugel en Carlsen werd vooral door de oprukkende pionnen in het nauw gedreven. Na Anands zeventiende zet (Pg5) had Carlsen ruim een half uur nodig voor een antwoord."
                            },
                            {
                                "example_id": "98ec357b-e06c-42ed-a9a6-737285a00184",
                                "sense_id": "a3d20006-d933-393d-a65e-5f21419abf9f",
                                "text": "Carlsen voerde echter de druk op door zijn pionnen op de damevleugel op te offeren om de f-pion vrije doorgang te geven. In de cruciale fase koos Anand voor het vertragende 60. Ta4 waar 60. b4 beter was en die keuze werd hem fataal."
                            }
                        ]
                    }
