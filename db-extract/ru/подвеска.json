                "senses": [
                    {
                        "sense_id": "93e80c4a-8788-39e4-8954-918c3c04ba65",
                        "entry_id": "270c8dd8-8ed3-3a2f-beb2-222c7fa286ef",
                        "glosses": [
                            "Suspension, action de suspendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c81f57c-a025-4583-9a5f-1ea9a7165407",
                                "sense_id": "93e80c4a-8788-39e4-8954-918c3c04ba65",
                                "text": "Крюки для подвески мяса.",
                                "translation": "Crochets pour suspendre la viande."
                            },
                            {
                                "example_id": "a117f703-cdd9-40ff-99bd-f33dc7550296",
                                "sense_id": "93e80c4a-8788-39e4-8954-918c3c04ba65",
                                "text": "Подвеска предназначена для снижения динамических нагрузок и обеспечения равномерного распределения их на опорные элементы при движении, также служит для повышения тяговых качеств машины.",
                                "translation": "La suspension est conçue pour réduire les charges dynamiques et assurer leur répartition uniforme sur les éléments de support lors du déplacement, et sert également à améliorer les qualités de traction de la machine."
                            }
                        ]
                    },
                    {
                        "sense_id": "536dfb48-ddb4-334d-9c93-12cf66ed6374",
