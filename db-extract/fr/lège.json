                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9678375c-30a1-44ac-b0ca-f08e30110f07",
                                "sense_id": "8632735b-ec1a-3198-ad3b-0b27f53eecd3",
                                "text": "Le 5.20 n'est pas lège"
                            }
                        ]
                    }
