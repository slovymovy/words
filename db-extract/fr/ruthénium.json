        "fr-extract.jsonl": [
            {
                "entry_id": "0c163c62-b488-3aff-b09a-f03f051a99fb",
                "word": "ruthénium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3628ef6-84f9-3b93-ba8d-6b2dc8f2b8c8",
                        "entry_id": "0c163c62-b488-3aff-b09a-f03f051a99fb",
                        "glosses": [
                            "Élément chimique de numéro atomique 44 et de symbole Ru, qui fait partie de la série des métaux de transition."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1fcc2450-8c99-4daf-8dc6-3dead4bf0a27",
                                "sense_id": "c3628ef6-84f9-3b93-ba8d-6b2dc8f2b8c8",
                                "text": "Cette situation est relativement courante en chimie, par exemple pour les processus de rupture de liaisons ou lorsque la molécule contient des métaux de transition (fer, chrome, ruthénium, etc.) à cause de leurs couches électroniques incomplètes."
                            },
                            {
                                "example_id": "b7f161d9-68f7-4e80-a15a-b514b45d915a",
                                "sense_id": "c3628ef6-84f9-3b93-ba8d-6b2dc8f2b8c8",
                                "text": "Les éléments traceurs généralement recherchés dans l'or sont outre le cuivre et l’étain, les métaux du groupe du platine (Platine. Ruthénium. Rhodium. Palladium, Iridium. Osmium...)."
                            },
                            {
                                "example_id": "7ea26404-a8f5-45a2-894e-445e0ae30fb5",
                                "sense_id": "c3628ef6-84f9-3b93-ba8d-6b2dc8f2b8c8",
                                "text": "Chez les plus petits organismes marins (phytoplancton et zooplancton), les éléments les plus concentrés sont le ruthénium, le cérium, le zirconium et le fer.."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c932880-6de4-359a-ba44-7a1903c10564",
                        "entry_id": "0c163c62-b488-3aff-b09a-f03f051a99fb",
                        "glosses": [
                            "Corps pur métallique de cet élément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace2da9a-3ec3-4b13-ac48-42dbcf237641",
                                "sense_id": "4c932880-6de4-359a-ba44-7a1903c10564",
                                "text": "Les métaux platinoïdes, iridium, osmium, palladium, rhodium et ruthénium se dissolvent dans l’électrolyte, un procédé chimique permet de les récupérer ensuite."
                            },
                            {
                                "example_id": "b7433405-6670-441a-8a8e-918e34979b2c",
                                "sense_id": "4c932880-6de4-359a-ba44-7a1903c10564",
                                "text": "Les composants internes et autres métaux précieux sont récupérés et parfois recyclés, à l’instar de l’or, de l’argent, du cuivre, du platine, du palladium, du ruthénium, du rhodium, de l’iridium ou de l’osmium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9683c5b6-53fc-4cc4-8c83-03dd5523e875",
                        "source_entry_id": "0c163c62-b488-3aff-b09a-f03f051a99fb",
                        "target_lang_word": "Ruthenium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruthenium",
