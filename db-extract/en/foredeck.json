                                "example_id": "0ddea007-f7a4-48b3-8fc8-61329d3bd605",
                                "sense_id": "40f2d8dd-1738-3b47-9e0a-161c230739e8",
                                "text": "Holonyms: watercraft, vessel, vessel"
