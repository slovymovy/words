                                        "entry_id": "20270be5-f83a-3b4e-a19a-4fa8c91c9c78",
                                        "glosses": [
                                            "A woman."
                                        ],
                                        "tags": [
                                            "diminutive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f41492c-ea97-4e20-9caa-4fe67392ea52",
                                                "sense_id": "2e0064c1-2ba7-382b-946f-7849191b49bb",
                                                "text": "Fetch in the li’l chickie and we’ll see if I can’t make better time with her than you did."
                                            },
                                            {
                                                "example_id": "90eaf612-5877-4338-bab1-6b4eb578a551",
                                                "sense_id": "2e0064c1-2ba7-382b-946f-7849191b49bb",
                                                "text": "You think Kip Knoll wouldn't break your heart? Listen, chickie, my problem is that I am constantly being taken home by boys who do look exactly like Kip Knoll, and who […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8393f470-5299-3a9f-823d-38a8f8a1191d",
                                        "entry_id": "20270be5-f83a-3b4e-a19a-4fa8c91c9c78",
                                        "glosses": [
                                            "A chick, a baby chicken"
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f6f44c2-afc3-4231-bb80-93e26f877d91",
                                                "sense_id": "8393f470-5299-3a9f-823d-38a8f8a1191d",
                                                "text": "\"It's hatching!\" an o-bake said excitedly. \"A chickie! A chickie!\" \"I'm gonna name him Yoshi!\" said another."
                                            }
                                        ]
                                    }
