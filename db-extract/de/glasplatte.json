                "senses": [
                    {
                        "sense_id": "666901a1-cd46-3ccd-a064-df92d6b2418b",
                        "entry_id": "d9d9e3a7-a9c3-3dfb-bb87-b01f2c27205e",
                        "glosses": [
                            "Platte, hergestellt aus Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a093b9-86a9-4375-be1a-26b49d4f1fe4",
                                "sense_id": "666901a1-cd46-3ccd-a064-df92d6b2418b",
                                "text": "„Auf dem kleinen Tisch, dem mit der Glasplatte und dem Häkeldeckchen, liegen vier Smartphones.“"
                            },
                            {
                                "example_id": "c35aab34-6fab-4e60-9bfc-d6af5f8b8865",
                                "sense_id": "666901a1-cd46-3ccd-a064-df92d6b2418b",
                                "text": "„Er kippte endlich um und schlug die Glasplatte auf meinem Nachttisch in Stücke.“"
                            },
                            {
                                "example_id": "110a277a-56f4-48b5-819f-31fd4d022c92",
                                "sense_id": "666901a1-cd46-3ccd-a064-df92d6b2418b",
                                "text": "„Als Couchtisch diente eine Glasplatte auf einem gebogenen Betonfuß und darüber hing ein großer, altmodischer Lüster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
