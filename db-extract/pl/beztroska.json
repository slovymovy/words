                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b72c4b-8a46-4573-9ab7-54d048495ebc",
                                "sense_id": "7adf97a3-c14d-354d-8976-4c6c19882443",
                                "text": "Był tydzień Bożego Narodzenia; nikt z nas nie rozpoczął specjalnej pracy, lecz spędziliśmy czas w radości i domowej beztrosce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "64bdf047-06b5-389e-9e33-a1454c4e5e9d",
                        "entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
                        "glosses": [
                            "nieprzejmowanie się niczym, brak dbałości o coś"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0be4298d-27e9-47c5-8e0d-4f3ead9f5c01",
                        "source_entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
                        "source_sense_id": "7adf97a3-c14d-354d-8976-4c6c19882443",
                        "target_lang_word": "unconcern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unconcern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c98f5d9-8314-3430-8c2f-f4882a575d40",
                                        "entry_id": "478d5d80-cfb8-3573-9c42-b786e7ac873b",
                                        "glosses": [
                                            "Lack of interest or care; indifference or apathy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de2d25d7-6d26-4072-9566-8b8698c2f93e",
                                                "sense_id": "8c98f5d9-8314-3430-8c2f-f4882a575d40",
                                                "text": "Elizabeth took up some needlework, and was sufficiently amused in attending to what passed between Darcy and his companion. The perpetual commendations of the lady, either on his handwriting, or on the evenness of his lines, or on the length of his letter, with the perfect unconcern with which her praises were received, formed a curious dialogue, and was exactly in union with her opinion of each."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c6fec57-31bd-3bf2-b247-3a6a09294545",
                                        "entry_id": "478d5d80-cfb8-3573-9c42-b786e7ac873b",
                                        "glosses": [
                                            "Freedom from worry or apprehensiveness; insouciance or nonchalance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7822cef5-2163-4be7-80f6-86c5973f1b8b",
                                                "sense_id": "0c6fec57-31bd-3bf2-b247-3a6a09294545",
                                                "text": "[Albert, about Bear asleep:] A soft smile of lovin' unconcern on his friendly face as he dozes on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30f4623e-8fb5-4c9b-aad2-4a83f17f1667",
                        "source_entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
                        "source_sense_id": "7adf97a3-c14d-354d-8976-4c6c19882443",
                        "target_lang_word": "беззаботность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беззаботность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf72935-866a-3e30-b396-c231b0ee8d59",
                                        "entry_id": "07c2882a-f6cd-3222-82a3-2eb906ce82f1",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного беззаботный"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb58af08-7cad-4b2e-9fc1-88a918805ebc",
                        "source_entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
                        "source_sense_id": "7adf97a3-c14d-354d-8976-4c6c19882443",
                        "target_lang_word": "беспечность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беспечность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5025853a-5aaf-3c10-b70b-636a068b0a9c",
                                        "entry_id": "c464edf4-c446-3d88-a752-2c6f64bf00b9",
                                        "glosses": [
                                            "свойство по значению прилагательного беспечный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cad7a19-0372-49f6-859c-26764695c185",
                                                "sense_id": "5025853a-5aaf-3c10-b70b-636a068b0a9c",
                                                "text": "Это разогнало его страх и заставило обратиться к прежней беспечности."
                                            },
                                            {
                                                "example_id": "0a58a55f-cad6-4ec6-991d-4604029087c4",
                                                "sense_id": "5025853a-5aaf-3c10-b70b-636a068b0a9c",
                                                "text": "И мало-помалу беспечность Ордынова стала невольно упадать; действительность уже подавляла его, вселяла в него какой-то невольный страх уважения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baff4142-2f1d-427e-8769-ba6379e57439",
                        "source_entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
                        "source_sense_id": "64bdf047-06b5-389e-9e33-a1454c4e5e9d",
                        "target_lang_word": "levity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99aa7f6b-8295-3bfb-9f26-c1ba260fa64b",
                                        "entry_id": "09344450-dc9c-3257-839f-381acee5267e",
                                        "glosses": [
                                            "A lightness of manner or speech, frivolity; flippancy; a lack of appropriate seriousness; an inclination to make a joke of serious matters."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b6ecfaa-26b9-38cb-86af-5a5f65329ef5",
                                        "entry_id": "09344450-dc9c-3257-839f-381acee5267e",
                                        "glosses": [
                                            "A lack of steadiness."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c1edb5d-2156-304d-a013-2c36d905484f",
                                        "entry_id": "09344450-dc9c-3257-839f-381acee5267e",
                                        "glosses": [
                                            "The state or quality of being light, buoyancy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4889c206-268a-4014-996e-f61cb88a0746",
                                                "sense_id": "9c1edb5d-2156-304d-a013-2c36d905484f",
                                                "text": "Most of the confidences were unsought - frequently I have feigned sleep, preoccupation or a hostile levity […]"
                                            },
                                            {
                                                "example_id": "c5852dfa-530a-4406-8bd0-5d88876b918e",
                                                "sense_id": "9c1edb5d-2156-304d-a013-2c36d905484f",
                                                "text": "[…]it would really seem as if there was something nomadic in our natures, a principle of levity and restlessness […]"
                                            },
                                            {
                                                "example_id": "3c3fcf2a-d902-4a59-8a6c-cacc99a1e35d",
                                                "sense_id": "9c1edb5d-2156-304d-a013-2c36d905484f",
                                                "text": "Hydrogen […] rises in the air on account of its levity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed5fb4fe-99db-3629-a937-eaf6817ab4e7",
                                        "entry_id": "09344450-dc9c-3257-839f-381acee5267e",
                                        "glosses": [
                                            "A lighthearted or frivolous act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07275b50-cd94-421b-b5a9-27639cf751a3",
                                                "sense_id": "ed5fb4fe-99db-3629-a937-eaf6817ab4e7",
                                                "text": "For though it be something wonderful to tell that any should have hearts so hardened, in the midst of such a calamity, as to rob and steal, yet certain it is that all sorts of villainies, and even levities and debaucheries, were then practiced in the town as openly as ever: I will not say quite as frequently, because the number of people were many ways lessened."
                                            },
                                            {
                                                "example_id": "f0e78c4e-fd6c-4169-8edd-0a01b310108b",
                                                "sense_id": "ed5fb4fe-99db-3629-a937-eaf6817ab4e7",
                                                "text": "[…] or do the people joy less than common in their levities?\""
                                            },
                                            {
                                                "example_id": "cde8586e-39f1-49bd-bf83-579adc964a3b",
                                                "sense_id": "ed5fb4fe-99db-3629-a937-eaf6817ab4e7",
                                                "text": "His incorrigible levities had probably lost him the countenance of most of his more serious acquaintances[…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45dc8543-368f-4c40-b1d8-cc2f098f5df3",
                        "source_entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
                        "source_sense_id": "64bdf047-06b5-389e-9e33-a1454c4e5e9d",
                        "target_lang_word": "légèreté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légèreté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7772c6-3502-3233-862e-59dd6754bdc9",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Qualité de ce qui est léger, peu pesant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85821e0-affc-465f-be68-9a7ce01c6d89",
                                                "sense_id": "7a7772c6-3502-3233-862e-59dd6754bdc9",
                                                "text": "La légèreté de l’air."
                                            },
                                            {
                                                "example_id": "e397ca10-f0f4-4baa-ba61-2e2589fd0a0c",
                                                "sense_id": "7a7772c6-3502-3233-862e-59dd6754bdc9",
                                                "text": "La légèreté des vapeurs, du papier, de l’aluminium, du liège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Agilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0990618-9f16-4d1d-b67f-f3c20d3bd16b",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "Les syndicats peuvent être fort utilement employés à faire de la propagande électorale ; il faut, pour les utiliser avec fruit, une certaine adresse, mais les politi­ciens ne manquent pas de légèreté de main."
                                            },
                                            {
                                                "example_id": "345a1f7e-3110-45fe-a6db-8f4b474fecd9",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "Marcher, courir avec légèreté."
                                            },
                                            {
                                                "example_id": "177b7ecd-8ca5-4173-a15f-001805b63e31",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "La légèreté des oiseaux, d’un cerf, d’un danseur."
                                            },
                                            {
                                                "example_id": "fb86ce88-b824-4e7d-a350-1e2cbb8b200a",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "La légèreté de sa marche, de sa danse, de sa course."
                                            },
                                            {
                                                "example_id": "0733da17-f3ad-4097-aef3-4a294707714f",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "Il a une grande légèreté de main, se dit, au propre, d’un Cavalier, d’un ouvrier, d’un joueur d’instruments."
                                            },
                                            {
                                                "example_id": "14a151e5-c7e8-4d91-b600-e1c08a77c6a0",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "Il se dit encore, au figuré, d’un écrivain qui s’exprime avec aisance et délicatesse."
                                            },
                                            {
                                                "example_id": "eecc11c5-3ee5-4605-91ed-398f41c34876",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "Il a une grande légèreté de pinceau, se dit d’un Peintre dont la touche est légère."
                                            },
                                            {
                                                "example_id": "3a91142b-7c6a-4c13-9fce-127b83de9de4",
                                                "sense_id": "4c199cdc-166c-301c-8a35-df40b7383086",
                                                "text": "Il, elle a beaucoup de légèreté dans la voix, se dit d’un Chanteur, d’une Chanteuse qui fait aisément les modulations, les traits ou les vocalises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b7e73c-b264-3e7f-87b7-e0cda88cd27e",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Agrément, facilité de l’esprit ou du style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d8f227-d45c-40f6-80dd-b1c596288909",
                                                "sense_id": "d8b7e73c-b264-3e7f-87b7-e0cda88cd27e",
                                                "text": "Par sa floribondité, l'éclat de ses fleurs et sa légèreté, cette plante est très en honneur dans les jardins […]."
                                            },
                                            {
                                                "example_id": "8bf7214b-4121-4c2c-bab3-433cce3f7c78",
                                                "sense_id": "d8b7e73c-b264-3e7f-87b7-e0cda88cd27e",
                                                "text": "Les colonnes qui supportent les voûtes de la chapelle de la Vierge sont d'une légèreté telle que pour un peu on crierait au miracle."
                                            },
                                            {
                                                "example_id": "6c133d65-fbdf-415d-be50-6dfaff561b2a",
                                                "sense_id": "d8b7e73c-b264-3e7f-87b7-e0cda88cd27e",
                                                "text": "Il a de la légèreté dans la manière d’écrire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db5ec708-a324-36bd-9bf5-716acd7597ba",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Inconstance ; instabilité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429da540-31fb-423c-bdaa-5fedf2946af8",
                                                "sense_id": "db5ec708-a324-36bd-9bf5-716acd7597ba",
                                                "text": "C’est encore à l’intranspiration des chiens qu'il faut a attribuer la légèreté du sommeil, qui les rend si aptes à nous servir de sentinelles."
                                            },
                                            {
                                                "example_id": "caa866ba-1ffd-4516-b8a8-1d16c2d4df1a",
                                                "sense_id": "db5ec708-a324-36bd-9bf5-716acd7597ba",
                                                "text": "[…] ; elle lui pardonna une légèreté d’esprit, dont, après tout, elle n’avait jamais souffert : quand les défauts des autres ne nous nuisent pas, il est rare qu’ils nous choquent beaucoup."
                                            },
                                            {
                                                "example_id": "714f862c-5d4d-49d4-b8eb-6b5b8e7fe823",
                                                "sense_id": "db5ec708-a324-36bd-9bf5-716acd7597ba",
                                                "text": "Elle se dit qu’il fallait montrer aujourd’hui tout son courage, être comme ces femmes de la ville, ces grandes dames qui savent mépriser les hommes peu fidèles et regarder avec hauteur leur légèreté oublieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ff1228-7cdb-34f9-9a00-682bf4acf1e3",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Irréflexion ; imprudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5dc356-2817-4079-bc91-bc2bc72e40c3",
                                                "sense_id": "f5ff1228-7cdb-34f9-9a00-682bf4acf1e3",
                                                "text": "Dans la légèreté et même la superficialité de ce garçon, il y avait quelque chose qui plaisait à Violaine. Après tout, elle aussi vivait au jour le jour, avec son fardeau sur le cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccb491b-0555-33cb-a5f9-e0a878d93d24",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Faute commise par étourderie, d’un tort peu grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62cd146-7fc7-45eb-89dd-c85d8a7aa903",
                                                "sense_id": "7ccb491b-0555-33cb-a5f9-e0a878d93d24",
                                                "text": "Ce ne sont que des légèretés qui tiennent à son âge."
                                            },
                                            {
                                                "example_id": "84572bb4-1d61-45e3-b082-c23b83b9946f",
                                                "sense_id": "7ccb491b-0555-33cb-a5f9-e0a878d93d24",
                                                "text": "Cette légèreté ne méritait pas une si grande punition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f17244-a6fc-3228-9cb9-5288210f24fc",
                                        "entry_id": "43f2d7f2-aed5-3c52-9720-2f9bb55c31a7",
                                        "glosses": [
                                            "Liberté excessive, d’un souci insuffisant de la décence dans le langage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a51ee3-7b4a-4077-9962-22a56c9bcd58",
                                                "sense_id": "39f17244-a6fc-3228-9cb9-5288210f24fc",
                                                "text": "Il tient des propos d’une trop grande légèreté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "627bb10f-c724-4fa2-a45b-7ce26fe3d1be",
                        "source_entry_id": "3daeaae9-0748-3588-adad-af139ea5e5f3",
