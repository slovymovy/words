                                "target_lang_word": "persuade",
                                "target_lang_sense_clarification": "to convince to do something"
                            },
                            {
                                "target_lang_word": "induce",
                                "target_lang_sense_clarification": "to prompt an action"
                            },
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to sway someone mentally"
                            }
                        ]
