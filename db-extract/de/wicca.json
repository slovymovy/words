                    {
                        "form_id": "d7a8914a-8d5b-483a-8411-d714ded3ec42",
                        "entry_id": "28fb263c-b22d-3b50-b0f3-3fcacd41eb2e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Wicca"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                        "entry_id": "28fb263c-b22d-3b50-b0f3-3fcacd41eb2e",
                        "glosses": [
                            "große Religion innerhalb des Neopaganismus, die die Arbeit mit einem gehörnten Gott und einer großen Göttin, sowie die Feier von Sabbat und Esbat beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "342b2cc6-66b1-4159-80f1-27a2ce7ed884",
                                "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                "text": "„Seien wir uns mal ehrlich: Wicca ist keine uralte Tradition, Wicca ist ein 50 Jahre alter Mix aus allem Möglichen. Aber eines steht fest: Wicca und überhaupt Magie an sich, ist wie Sprengstoff. Es funktioniert.“"
                            },
                            {
                                "example_id": "531ab102-417e-43ea-8ec3-6679475206f2",
                                "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                "text": "„Wicca ist eine neureligiöse Bewegung, die sich an den alten, vor–römischen Religionen Nord-, Mittel- und Südeuropas orientiert: dem Kelten- und Germanentum.“"
                            },
                            {
                                "example_id": "c40a2744-32f1-4c5f-a584-74d83a58c1e2",
                                "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                "text": "„Während Hexerei im Europa des 21. Jahrhunderts, insbesondere unter der Selbstbezeichnung Wicca, als „Religion“ beurteilt wird, besteht in der ethnologischen Forschung große Uneinigkeit, ob Hexerei in Afrika als Religion einzuordnen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c4898dc-d05e-4c42-95e3-aa592a20da40",
                        "source_entry_id": "28fb263c-b22d-3b50-b0f3-3fcacd41eb2e",
                        "source_sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
