                "senses": [
                    {
                        "sense_id": "396b995a-a94d-3cb0-9ff5-02828bbbf9ea",
                        "entry_id": "19058cd1-46b4-3dde-b1a2-814f92019dde",
                        "glosses": [
                            "In a veritable manner; in a way that truly and accurately describes something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc560e50-d9b1-4b84-baa5-50fed2826423",
                                "sense_id": "396b995a-a94d-3cb0-9ff5-02828bbbf9ea",
                                "text": "My comfort was, that it happened a long time ago, and that he had doubtless been transported a long way off, and that he was dead to me, and might be veritably dead into the bargain."
                            },
                            {
                                "example_id": "3a9f2fb5-fa65-4d0a-9e79-be5ad7c8f947",
                                "sense_id": "396b995a-a94d-3cb0-9ff5-02828bbbf9ea",
                                "text": "A book with veritably no shading or subtlety"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a0f92c4-a8d6-46bd-96a7-ac4578cf663c",
                        "source_entry_id": "19058cd1-46b4-3dde-b1a2-814f92019dde",
                        "source_sense_id": "396b995a-a94d-3cb0-9ff5-02828bbbf9ea",
                        "source_sense_description": "in a veritable manner",
                        "target_lang_word": "véritablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "véritablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3c13de-672b-3ade-9261-5737c2a4b555",
                                        "entry_id": "a68045ed-83ab-3fa0-ac4a-b987907ae385",
                                        "glosses": [
                                            "Conformément à la vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846bb7d3-a031-4259-abdf-860e65d351a0",
                                                "sense_id": "8f3c13de-672b-3ade-9261-5737c2a4b555",
                                                "text": "Parlez-moi véritablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                        "entry_id": "a68045ed-83ab-3fa0-ac4a-b987907ae385",
                                        "glosses": [
                                            "Réellement, de fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0893e8c-eb02-4718-9a73-78af18f6afc4",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Ce fut Babar, petit-fils de Tamerlan, qui forma véritablement l’empire mogol,"
                                            },
                                            {
                                                "example_id": "593f953b-5c35-434c-8cb2-7faec8df3002",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Ils [les rois] sont, comme nous sommes, Véritablement hommes, Et meurent comme nous,"
                                            },
                                            {
                                                "example_id": "6718326e-058e-4930-ba25-0d802eca6aa5",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Le joueur sauve véritablement son équipe."
                                            },
                                            {
                                                "example_id": "d6bc13ee-d862-4727-9237-ddfb62f0c050",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Le Vicaire savoyard, le seul véritablement bon ouvrage qu’ait fait. J. J. Rousseau, — (Voltaire, Philos. Instructions)"
                                            },
                                            {
                                                "example_id": "639f401d-15b2-47b8-b9d7-c9e77f0ead8f",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Mais de fut le comte de Chardonnet, […], qui fut véritablement le père de ce nouveau produit industriel."
                                            },
                                            {
                                                "example_id": "fb6b2f50-8779-4a8d-a520-27022a96898a",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Elle parlait pour ne pas faire l'impolie, sans que la chose l'intéressât véritablement."
                                            },
                                            {
                                                "example_id": "81039448-6eba-4a8b-8250-ce1ff904c689",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "— Dites-leur que nous regrettons très véritablement ce retard, souffla Koromindé du fond de la pièce.\nOn devinait à ce « très véritablement » que le français n’était pas sa langue maternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dc3d5de-e6bf-3897-9845-b9e89eeaddc5",
                                        "entry_id": "a68045ed-83ab-3fa0-ac4a-b987907ae385",
                                        "glosses": [
                                            "À la vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3451c2fa-8e07-4be2-a82c-207366f0e65d",
                                                "sense_id": "2dc3d5de-e6bf-3897-9845-b9e89eeaddc5",
                                                "text": "Si nous promettons ces avantages, ce n'est point à quelques réflexions qui s'offrent à l’esprit véritablement, mais qui ne font aucune impression sur le cœur et qui n'ont aucune influence sur la vie,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
