{
    "word_family": [
        "legitimate",
        "legitimacy",
        "legitimize",
        "legitimization"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26dd2cec-c054-32e9-8a2c-866674dc5a5f",
                    "sense_definition": "<w>Legitimate</w>; legal, valid, or allowed by the rules.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_valid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was worried the website was a scam, but it turned out to be <w>legit</w>.",
                            "target_lang_translations": {
                                "ru": "Я боялся, что этот сайт — мошенничество, но он оказался <w>настоящим</w>.",
                                "zh": "我本来担心那个网站是诈骗，但结果发现它是<w>合法</w>的。"
                            }
                        },
                        {
                            "text": "The referee reviewed the play and confirmed that the goal was <w>legit</w>.",
                            "target_lang_translations": {
                                "ru": "Судья пересмотрел момент и подтвердил, что гол был <w>правильным</w>.",
                                "zh": "裁判回看了比赛录像，确认那个进球是<w>有效</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legal",
                        "valid",
                        "lawful",
                        "authorized"
                    ],
                    "antonyms": [
                        "illegal",
                        "invalid",
                        "fraudulent"
                    ],
                    "common_phrases": [
                        "seems legit",
                        "looks legit",
                        "totally legit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of legitimate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законный, действительный или соответствующий правилам.",
                        "zh": "合法的、有效的或符合规则的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "законный",
                                "target_lang_sense_clarification": "соответствующий закону"
                            },
                            {
                                "target_lang_word": "легальный",
                                "target_lang_sense_clarification": "разрешенный, официальный"
                            },
                            {
                                "target_lang_word": "правильный",
                                "target_lang_sense_clarification": "верный, соответствующий правилам (например, о голе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合法",
                                "target_lang_sense_clarification": "符合法律规定"
                            },
                            {
                                "target_lang_word": "正当",
                                "target_lang_sense_clarification": "符合规则或道理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cb6d8ea-7a12-3cbd-aa12-d9609386c933",
                    "sense_definition": "Genuine, actual, or honest; not fake.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "genuine_honest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I promise you that this offer is <w>legit</w> and there are no hidden fees.",
                            "target_lang_translations": {
                                "ru": "Я обещаю тебе, что это предложение <w>честное</w>, и там нет скрытых комиссий.",
                                "zh": "我向你保证这个提议是<w>真实</w>的，没有任何隐藏费用。"
                            }
                        },
                        {
                            "text": "His concern for the safety of the passengers seemed <w>legit</w>.",
                            "target_lang_translations": {
                                "ru": "Его беспокойство о безопасности пассажиров казалось <w>искренним</w>.",
                                "zh": "他对乘客安全的担忧看起来很<w>诚恳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "genuine",
                        "real",
                        "authentic",
                        "sincere"
                    ],
                    "antonyms": [
                        "fake",
                        "phony",
                        "false"
                    ],
                    "common_phrases": [
                        "legit business",
                        "legit reason"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of legitimate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлинный, настоящий или честный; не подделка.",
                        "zh": "真实的、实际的或诚实的；非伪造的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "подлинный, не поддельный"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "без обмана"
                            },
                            {
                                "target_lang_word": "реальный",
                                "target_lang_sense_clarification": "существующий на самом деле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真实",
                                "target_lang_sense_clarification": "非虚假"
                            },
                            {
                                "target_lang_word": "诚恳",
                                "target_lang_sense_clarification": "态度真诚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "454170b9-2e98-3b30-ab91-4b2576110eaa",
                    "sense_definition": "Genuinely good, skilled, or impressive; the real deal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "good_skilled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I checked out her design portfolio and she is definitely <w>legit</w>.",
                            "target_lang_translations": {
                                "ru": "Я посмотрел её портфолио дизайнера, и она определенно <w>профи</w>.",
                                "zh": "我看了她的设计作品集，她确实非常<w>厉害</w>。"
                            }
                        },
                        {
                            "text": "That new restaurant downtown is <w>legit</w>, especially their pizza.",
                            "target_lang_translations": {
                                "ru": "Тот новый ресторан в центре — <w>крутой</w>, особенно их пицца.",
                                "zh": "市中心那家新餐厅很<w>靠谱</w>，尤其是他们的披萨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impressive",
                        "excellent",
                        "cool",
                        "skilled"
                    ],
                    "antonyms": [
                        "lame",
                        "bad"
                    ],
                    "common_phrases": [
                        "pretty legit",
                        "is legit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действительно хороший, качественный или впечатляющий (сленг).",
                        "zh": "真正优秀的、有技术的或令人印象深刻的（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "классный, впечатляющий"
                            },
                            {
                                "target_lang_word": "стоящий",
                                "target_lang_sense_clarification": "заслуживающий внимания"
                            },
                            {
                                "target_lang_word": "профи",
                                "target_lang_sense_clarification": "профессионал, мастер своего дела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厉害",
                                "target_lang_sense_clarification": "非常出色"
                            },
                            {
                                "target_lang_word": "靠谱",
                                "target_lang_sense_clarification": "值得信赖且质量高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0592d7f9-2d02-3d95-b966-009d6fa61312",
                    "sense_definition": "Honestly, truly, or seriously; used to emphasize that something is true.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>legit</w> thought I had lost my keys until I found them in my pocket.",
                            "target_lang_translations": {
                                "ru": "Я <w>реально</w> думал, что потерял ключи, пока не нашел их в кармане.",
                                "zh": "我<w>真的</w>以为我把钥匙弄丢了，直到我在口袋里找到了它们。"
                            }
                        },
                        {
                            "text": "He <w>legit</w> believes he can finish the entire project in one day.",
                            "target_lang_translations": {
                                "ru": "Он <w>на полном серьезе</w> верит, что может закончить весь проект за один день.",
                                "zh": "他<w>确实</w>相信自己能一天内完成整个项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "honestly",
                        "truly",
                        "literally",
                        "seriously"
                    ],
                    "common_phrases": [
                        "legit forgot",
                        "legit scared",
                        "legit thought"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Честно, правда или серьезно; используется для усиления утверждения.",
                        "zh": "诚实地、真正地或严肃地；用于强调某事属实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реально",
                                "target_lang_sense_clarification": "действительно, на самом деле"
                            },
                            {
                                "target_lang_word": "серьезно",
                                "target_lang_sense_clarification": "без шуток"
                            },
                            {
                                "target_lang_word": "в натуре",
                                "target_lang_sense_clarification": "грубый сленг: действительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真的",
                                "target_lang_sense_clarification": "确实如此"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "表示强调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e3f14ea-3bea-3898-837d-fd6f61fcc19a",
                    "sense_definition": "<w>Legitimately</w>; in a way that is legal or within the law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They want to ensure the business is operating <w>legit</w> before investing.",
                            "target_lang_translations": {
                                "ru": "Они хотят убедиться, что бизнес работает <w>легально</w>, прежде чем инвестировать.",
                                "zh": "在投资之前，他们想确保这家企业是<w>合法</w>经营的。"
                            }
                        },
                        {
                            "text": "You need to earn your money <w>legit</w> if you want to stay out of trouble.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно зарабатывать деньги <w>законно</w>, если хочешь избежать неприятностей.",
                                "zh": "如果你想远离麻烦，就得<w>合法</w>地赚钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legitimately",
                        "legally",
                        "lawfully"
                    ],
                    "antonyms": [
                        "illegally"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законно; таким образом, который не нарушает закон.",
                        "zh": "合法地；以不违反法律的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легально",
                                "target_lang_sense_clarification": "официально"
                            },
                            {
                                "target_lang_word": "законно",
                                "target_lang_sense_clarification": "в соответствии с законом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合法",
                                "target_lang_sense_clarification": "符合法律"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06b08c31-8964-36cc-bbbd-cfaa26be29fd",
                    "sense_definition": "A <w>legitimate</w> actor or performer, typically in theater.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "actor_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old vaudeville performer struggled to be taken seriously as a <w>legit</w>.",
                            "target_lang_translations": {
                                "ru": "Старый артист водевиля изо всех сил пытался, чтобы его воспринимали всерьез как <w>драматического актера</w>.",
                                "zh": "这位老杂耍艺人努力想让人们把他当作一名<w>正剧演员</w>来看待。"
                            }
                        },
                        {
                            "text": "In those days, there was a strict divide between the <w>legits</w> and the variety acts.",
                            "target_lang_translations": {
                                "ru": "В те дни существовало строгое разделение между <w>серьезными актерами</w> и эстрадными номерами.",
                                "zh": "在那个年代，<w>正剧演员</w>和杂耍艺人之间有着严格的界限。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": "theatrical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезный актер или исполнитель, обычно в театре (устаревшее/сленг).",
                        "zh": "严肃的演员或表演者，通常指戏剧界（旧时俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драматический актер",
                                "target_lang_sense_clarification": "актер серьезного жанра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正剧演员",
                                "target_lang_sense_clarification": "从事严肃戏剧表演的演员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
