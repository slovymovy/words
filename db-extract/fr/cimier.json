                                        "sense_id": "25d76508-04a6-3c86-9cf2-12a218dfbe75",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The summit of a hill or mountain ridge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "131204cd-1c21-3a7f-900a-e1fddf80ccb3",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "A tuft, or other natural ornament, growing on an animal's head, for example the comb of a cockerel, the swelling on the head of a snake, the lengthened feathers of the crown or nape of bird, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c4ced54-38c7-32f1-bda9-f60fe5e1a3e9",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The plume of feathers, or other decoration, worn on or displayed on a helmet; the distinctive ornament of a helmet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98ff4af2-7805-3bc9-9eda-5a1f8351c35d",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "A bearing worn, not upon the shield, but usually on a helmet above it, sometimes (as for clerics) separately above the shield or separately as a mark for plate, in letterheads, and the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87f1790-fad0-4f50-9000-60a3b645c91e",
                                                "sense_id": "98ff4af2-7805-3bc9-9eda-5a1f8351c35d",
                                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2396eb13-c29d-3322-9c83-891923825ee0",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The upper curve of a horse's neck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d262e9f0-de14-3fd1-850d-eb09039162a3",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The ridge or top of a wave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97321485-69bb-3974-a550-3617f2f1dfb1",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The helm or head, as typical of a high spirit; pride; courage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb7240f0-bae8-36d6-8be3-e2a814c4915f",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The ornamental finishing which surmounts the ridge of a roof, canopy, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ce97fda-4efc-39e4-90e2-022fe0046436",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "The top line of a slope or embankment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b76c8553-abba-3e17-a661-483135d3d793",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "A ridge along the surface of a bone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd4801b6-7d08-3ea6-99e8-a24817f656a4",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "A design or logo, especially one of an institution, sports club, association or high-class family."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb94162-c14a-4827-8d5a-3d30e4074376",
                                                "sense_id": "fd4801b6-7d08-3ea6-99e8-a24817f656a4",
                                                "text": "Hungry for fame and the approval of rare-animal collector Queen Victoria (Imelda Staunton), Darwin deceives the Captain and his crew into believing they can get enough booty to win the pirate competition by entering Polly in a science fair. So the pirates journey to London in cheerful, blinkered defiance of the Queen, a hotheaded schemer whose royal crest reads simply “I hate pirates.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "422007de-58d3-3804-b886-3a40b669856d",
                                        "entry_id": "764c1ef4-5dbb-3e19-bc25-110433176b35",
                                        "glosses": [
                                            "Any of several birds in the family Regulidae, including the goldcrests and firecrests."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6ac4800-590e-3ddf-97e1-13aaba18adbd",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "Particularly with reference to waves, to reach a peak."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56f9551a-ea09-3c22-ae4e-a839778fbd53",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "To reach the crest of (e.g. a hill or mountain)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a413c39-dcac-4562-946f-d39dc318999f",
                                                "sense_id": "56f9551a-ea09-3c22-ae4e-a839778fbd53",
                                                "text": "the land rolls gently, so that, upon cresting a low rise or passing a copse of wind turbines, you suddenly spot a lot full of lorries or a complex of gigantic sheds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a729ea-ec0c-3943-a993-a2d1c1422019",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "To furnish with, or surmount as, a crest; to serve as a crest for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374bdd56-52a7-45a5-97b3-552ba097348f",
                                                "sense_id": "f0a729ea-ec0c-3943-a993-a2d1c1422019",
                                                "text": "His legs bestrid the ocean, his reared arm / Crested the world."
                                            },
                                            {
                                                "example_id": "4204afaf-325d-4de1-a148-6404b573f0fe",
                                                "sense_id": "f0a729ea-ec0c-3943-a993-a2d1c1422019",
                                                "text": "groves of clouds that crest the mountain's brow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04f5af1-8fdb-3afd-8dd0-461a92799b66",
                                        "entry_id": "90fe18e3-7e33-3fa4-b071-772fdd64204f",
                                        "glosses": [
                                            "To mark with lines or streaks like waving plumes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072467ed-bd7a-4eb1-9158-9950bf90a202",
                                                "sense_id": "d04f5af1-8fdb-3afd-8dd0-461a92799b66",
                                                "text": "Like as the shining skie in summers night, / What time the dayes with scorching heat abound, / Is creasted all with lines of firie light"
                                            }
                                        ]
                                    }
                                ]
                            }
