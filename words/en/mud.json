    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3fd51c6-994e-3095-8167-e0e9a0afffae",
                    "sense_definition": "A soft, wet mixture of water and soil or fine grained sediment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "earth_materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children spent the whole afternoon playing in the <w>mud</w> after the rain.",
                            "target_lang_translations": {
                                "ru": "Дети провели весь вечер, играя в <w>грязи</w> после дождя."
                            }
                        },
                        {
                            "text": "Be careful not to get thick <w>mud</w> on your new white shoes while walking.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не запачкай новые белые туфли густой <w>грязью</w> во время прогулки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "thick mud",
                        "covered in mud",
                        "caked in mud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая влажная смесь воды и почвы или мелкозернистых отложений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "размокшая почва"
                            },
                            {
                                "target_lang_word": "слякоть",
                                "target_lang_sense_clarification": "жидкая грязь от дождя или снега"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5588c45f-4650-3742-b0c0-77a89751074e",
                    "sense_definition": "Willfully abusive or slanderous remarks or claims, especially between political opponents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insults",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The election campaign was full of <w>mud</w> as both candidates attacked each other's character.",
                            "target_lang_translations": {
                                "ru": "Избирательная кампания была полна <w>грязи</w>, так как оба кандидата нападали на личности друг друга."
                            }
                        },
                        {
                            "text": "Politicians often sling <w>mud</w> at their rivals instead of discussing actual policy issues.",
                            "target_lang_translations": {
                                "ru": "Политики часто поливают <w>грязью</w> своих соперников вместо того, чтобы обсуждать реальные политические вопросы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sling mud",
                        "drag through mud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умышленно оскорбительные или клеветнические замечания или утверждения, особенно между политическими оппонентами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "клевета и оскорбления"
                            },
                            {
                                "target_lang_word": "чернуха",
                                "target_lang_sense_clarification": "политический черный пиар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b88bdac-2e30-3a53-82ca-0e2e5e3d18a8",
                    "sense_definition": "A plaster-like mixture used to texture or smooth drywall in construction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor applied a thin layer of drywall <w>mud</w> to hide the seams between the panels.",
                            "target_lang_translations": {
                                "ru": "Подрядчик нанес тонкий слой <w>шпаклевки</w> для гипсокартона, чтобы скрыть швы между панелями."
                            }
                        },
                        {
                            "text": "You need to let the <w>mud</w> dry completely before you start sanding the walls.",
                            "target_lang_translations": {
                                "ru": "Нужно дать <w>раствору</w> полностью высохнуть, прежде чем начинать шлифовать стены."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drywall mud",
                        "joint mud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шпаклевочная смесь, используемая для текстурирования или выравнивания гипсокартона в строительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпаклевка",
                                "target_lang_sense_clarification": "строительная смесь для стен"
                            },
                            {
                                "target_lang_word": "раствор",
                                "target_lang_sense_clarification": "строительная смесь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45453694-b45a-3cc3-9376-1a18acb5a96b",
                    "sense_definition": "Wet concrete as it is being mixed, delivered, and poured.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers hurried to level the <w>mud</w> before the concrete started to set.",
                            "target_lang_translations": {
                                "ru": "Рабочие спешили разровнять <w>бетон</w>, пока он не начал схватываться."
                            }
                        },
                        {
                            "text": "A fresh batch of wet <w>mud</w> arrived at the construction site just in time.",
                            "target_lang_translations": {
                                "ru": "Свежая партия жидкого <w>раствора</w> прибыла на стройплощадку как раз вовремя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wet mud"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used by construction workers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Влажный бетон в процессе его смешивания, доставки и заливки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бетонная смесь",
                                "target_lang_sense_clarification": "жидкий бетон"
                            },
                            {
                                "target_lang_word": "раствор",
                                "target_lang_sense_clarification": "жидкий строительный материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "252fb867-afeb-3432-a7d8-f8dfc1aa2c3c",
                    "sense_definition": "A fluid used in drilling operations to lubricate the bit and carry away rock cuttings.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers monitored the density of the drilling <w>mud</w> to ensure the well remained stable.",
                            "target_lang_translations": {
                                "ru": "Инженеры следили за плотностью <w>бурового раствора</w>, чтобы обеспечить устойчивость скважины."
                            }
                        },
                        {
                            "text": "Specialized <w>mud</w> is pumped down the hole to cool the drill bit during deep excavation.",
                            "target_lang_translations": {
                                "ru": "Специальный <w>раствор</w> закачивается в скважину для охлаждения бура во время глубоких раскопок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drilling mud"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical term in oil and gas industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкость, используемая при буровых работах для смазки долота и выноса обломков породы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буровой раствор",
                                "target_lang_sense_clarification": "техническая жидкость для бурения"
                            },
                            {
                                "target_lang_word": "промывочная жидкость",
                                "target_lang_sense_clarification": "состав для очистки скважины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45eb8fca-32a6-30be-b2fe-f5438544b463",
                    "sense_definition": "A slang term for coffee, usually implying it is strong or of poor quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a hot cup of <w>mud</w> to wake me up this morning.",
                            "target_lang_translations": {
                                "ru": "Мне нужна чашка горячей <w>бурды</w>, чтобы проснуться этим утром."
                            }
                        },
                        {
                            "text": "The diner served a bitter <w>mud</w> that tasted like it had been sitting for hours.",
                            "target_lang_translations": {
                                "ru": "В закусочной подали горькое <w>поило</w>, на вкус как будто оно стояло часами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup of mud"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage for coffee"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название кофе, обычно подразумевающее, что он крепкий или плохого качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурда",
                                "target_lang_sense_clarification": "невкусный напиток"
                            },
                            {
                                "target_lang_word": "поило",
                                "target_lang_sense_clarification": "некачественный напиток"
                            },
                            {
                                "target_lang_word": "деготь",
                                "target_lang_sense_clarification": "очень крепкий черный кофе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5a80421-a807-3e1d-b60c-52a40cb0e37f",
                    "sense_definition": "An acronym for multi-user dungeon, an interactive online environment for fantasy role-playing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before modern graphics, many gamers spent their nights playing a text-based <w>MUD</w>.",
                            "target_lang_translations": {
                                "ru": "До появления современной графики многие геймеры проводили ночи, играя в текстовые <w>MUD</w>."
                            }
                        },
                        {
                            "text": "He met his best friend while exploring a virtual world in an old <w>MUD</w>.",
                            "target_lang_translations": {
                                "ru": "Он встретил своего лучшего друга, исследуя виртуальный мир в старом <w>маде</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play a MUD"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от multi-user dungeon (многопользовательское подземелье), интерактивная онлайн-среда для ролевых игр в стиле фэнтези."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "MUD",
                                "target_lang_sense_clarification": "текстовая онлайн-игра"
                            },
                            {
                                "target_lang_word": "мады",
                                "target_lang_sense_clarification": "сленговое название жанра игр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c952b0c-5c78-3425-90ab-237fdcca2492",
                    "sense_definition": "A traditional Dutch unit of dry measure, roughly equivalent to three bushels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer sold several <w>muds</w> of grain at the local market.",
                            "target_lang_translations": {
                                "ru": "Фермер продал несколько <w>мюдов</w> зерна на местном рынке."
                            }
                        },
                        {
                            "text": "Historically, a <w>mud</w> was a common unit for measuring dry goods in the Netherlands.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>мюд</w> был распространенной единицей измерения сыпучих продуктов в Нидерландах."
                            }
                        }
                    ],
                    "synonyms": [
                        "Dutch bushel",
                        "bushel",
                        "muid"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical unit of measure"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Dutch context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная голландская единица измерения сыпучих тел, примерно равная трем бушелям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мюд",
                                "target_lang_sense_clarification": "голландская мера объема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad21829e-f10d-32da-bec3-92b56d6fad99",
                    "sense_definition": "An extremely offensive and racist term for a person of color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slurs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document contained hateful language and referred to minorities as <w>muds</w>.",
                            "target_lang_translations": {
                                "ru": "Документ содержал полные ненависти высказывания и называл меньшинства <w>грязью</w>."
                            }
                        },
                        {
                            "text": "He was banned from the forum for using the word <w>muds</w> in a racist rant.",
                            "target_lang_translations": {
                                "ru": "Его забанили на форуме за использование слова <w>грязные</w> в расистской тираде."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive and derogatory"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "used in white supremacist circles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне оскорбительный и расистский термин для обозначения цветного человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "расистское оскорбление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58ba448f-6355-3362-bf2a-93658179989d",
                    "sense_definition": "A slang term for opium or heroin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found a small stash of <w>mud</w> hidden in the suspect's apartment.",
                            "target_lang_translations": {
                                "ru": "Детектив нашел небольшую заначку <w>грязи</w>, спрятанную в квартире подозреваемого."
                            }
                        },
                        {
                            "text": "In the old underworld slang, <w>mud</w> was a common name for opium.",
                            "target_lang_translations": {
                                "ru": "На старом воровском жаргоне <w>черняшка</w> была обычным названием опиума."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название опиума или героина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "наркотический сленг"
                            },
                            {
                                "target_lang_word": "черняшка",
                                "target_lang_sense_clarification": "сленг для опиатов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "541ea149-7266-3748-8dcf-793da3c16422",
                    "sense_definition": "To make something dirty or cover it with mud.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dirtying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passing truck managed to <w>mud</w> my clean car as it drove through the puddle.",
                            "target_lang_translations": {
                                "ru": "Проезжавший мимо грузовик умудрился <w>заляпать</w> мою чистую машину, проехав по луже."
                            }
                        },
                        {
                            "text": "Don't <w>mud</w> the floor with your boots after you come inside from the garden.",
                            "target_lang_translations": {
                                "ru": "Не <w>пачкай</w> пол сапогами, когда заходишь из сада."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испачкать что-либо или покрыть грязью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "делать грязным"
                            },
                            {
                                "target_lang_word": "заляпать",
                                "target_lang_sense_clarification": "покрывать пятнами грязи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e9174c-bd83-3b84-bc57-0c35d4353407",
                    "sense_definition": "To participate in a MUD (multi-user dungeon) online game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent most of his college years <w>mudding</w> instead of studying for his exams.",
                            "target_lang_translations": {
                                "ru": "Большую часть студенческих лет он <w>мадил</w>, вместо того чтобы готовиться к экзаменам."
                            }
                        },
                        {
                            "text": "The community of people who <w>mud</w> is smaller now than it was in the nineties.",
                            "target_lang_translations": {
                                "ru": "Сообщество людей, которые <w>играют в MUD</w>, сейчас меньше, чем в девяностые."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в онлайн-игре типа MUD (многопользовательское подземелье)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мадить",
                                "target_lang_sense_clarification": "играть в MUD"
                            }
                        ]
                    }
                }
            ]
        },
        {
