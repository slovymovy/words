        "fr-extract.jsonl": [
            {
                "entry_id": "24a698a5-71c4-36eb-9c0a-bba107804c9a",
                "word": "psychosomatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "521aad1e-a7ae-4a6c-b12e-d854cc318360",
                        "entry_id": "24a698a5-71c4-36eb-9c0a-bba107804c9a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "psychosomatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                        "entry_id": "24a698a5-71c4-36eb-9c0a-bba107804c9a",
                        "glosses": [
                            "Relatif à l’influence de l’esprit sur le corps (maladies psychosomatiques)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eec3df2-55d6-4e52-b4b3-168e487e2a37",
                                "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                "text": "Les peurs et les angoisses, qui accompagnent ces tourments, se traduisent aussi par des symptômes psychosomatiques : se sentir moche, avoir mal à la tête, des vertiges, des nausées ou des crampes à l’estomac."
                            },
                            {
                                "example_id": "8c668921-3bb7-4c40-9a00-8d389971a7ad",
                                "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                "text": "Dans l’un et l’autre cas, le traumatisme induit est utilisé pour casser l’identité initiale et l’équilibre psychosomatique."
                            },
                            {
                                "example_id": "fb96fd7e-85e3-4785-ba48-58f656400a49",
                                "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                "text": "Le manque d’appétit dû au stress est un trouble psychosomatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d65279db-66f8-466f-95eb-7174562e14bd",
                        "source_entry_id": "24a698a5-71c4-36eb-9c0a-bba107804c9a",
                        "source_sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                        "target_lang_word": "psychosomatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychosomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18824b08-043e-3759-8339-772b9b50d7a0",
                                        "entry_id": "a3d2c32f-7831-3a44-b2af-f0c2e281542f",
                                        "glosses": [
                                            "Pertaining to both the mind and the body."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2257498f-788b-31c2-b360-c12cdfaa63e8",
                                        "entry_id": "a3d2c32f-7831-3a44-b2af-f0c2e281542f",
                                        "glosses": [
                                            "Pertaining to physical diseases, symptoms etc. which have mental causes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305bcf38-cad5-4341-a0fc-318ca50df473",
                                                "sense_id": "2257498f-788b-31c2-b360-c12cdfaa63e8",
                                                "text": "Even the “unconscious” frequently prefers physical problems to psychological ones as suggested by the prevalence of psychosomatic ailments: physical symptoms--for example, stomach aches--caused by an emotional problem. It has been estimated that more than 50% of a physicians’ practice involves the treatment of psychosomatic complaints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7943651-2846-4a8f-a4da-79e09edb63b9",
