                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d3e8d2-c85c-42ed-af2e-c1f118077328",
                                "sense_id": "7b448b8e-fc2a-3935-a8df-1839a3737d20",
                                "text": "Devenu inconsistant, inactuel et inoffensif, il lui dispensait en mémoire la dose de nostalgie dont elle avait besoin pour colorer son existence quotidienne."
                            },
                            {
                                "example_id": "50f639e0-edea-42af-90c6-96c0c5ae38f4",
                                "sense_id": "7b448b8e-fc2a-3935-a8df-1839a3737d20",
                                "text": "Le soir, on s’enfonçait dans Octave Feuillet et autres auteurs inactuels qui arrachaient à l’ambiance de l’époque."
                            }
                        ]
                    }
