                        "sense_id": "c0fc2914-ee62-3b56-9d34-61eb6e4d2aef",
                        "entry_id": "41732737-d9a5-365c-ba7b-6abce7e0255d",
                        "glosses": [
                            "innerhalb einer Etage zusätzlich eingefügtes, niedrigeres Geschoss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7994c416-878f-4c2d-b006-95614c35fa0e",
                                "sense_id": "c0fc2914-ee62-3b56-9d34-61eb6e4d2aef",
                                "text": "„In den Zwischengeschossen sind an den Wänden ebenfalls Bilder von Tieren und auf dem Boden sind Mosaike.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1af1deca-b680-4faa-b5d0-1d5c217b0af3",
                        "source_entry_id": "41732737-d9a5-365c-ba7b-6abce7e0255d",
                        "source_sense_id": "c0fc2914-ee62-3b56-9d34-61eb6e4d2aef",
                        "source_sense_description": "innerhalb einer Etage zusätzlich eingefügtes, niedrigeres Geschoss",
                        "target_lang_word": "mezzanine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "An intermediate floor or storey in between the main floors of a building; specifically, one that is directly above the ground floor which does not extend over the whole floorspace of the building, and so resembles a large balcony overlooking the ground floor; an entresol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79615205-c5ed-4910-8773-cf2b08b0a87d",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "On our way to the top floor, we stopped at the mezzanine."
                                            },
                                            {
                                                "example_id": "90d09dd4-277a-4f54-b191-518534d576c5",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "[W]ater closet on mezzanine provided with opaque singlepane oblong window, tipup seat, bracket lamp, brass tierod brace, armrests, footstool and artistic oleograph on inner face of door: […]"
                                            },
                                            {
                                                "example_id": "6da118b2-ba30-4612-9517-0f2458226cda",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "In these sheds, individual products rest on short racks, so they can be reached more easily by employees who pick and box orders. In order to fit more racks, companies put in several mezzanine levels. As a result, the sheds rise taller: 21 metres, compared to B2B’s 15 metres."
                                            },
                                            {
                                                "example_id": "5ddb63de-edcc-46d6-80a4-de83c98f0590",
                                                "sense_id": "d1efd731-7172-3033-be28-5c5084347050",
                                                "text": "On arrival at Birmingham New Street, I make my way upstairs to the mezzanine to get shots of an almost deserted concourse, polka-dotted with social distancing circles like some strange board-game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88da8686-d6c4-31d4-ab5f-25b0697dabb4",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "An apartment, room, etc., on such an intermediate floor."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e752e9fe-40e4-3bc5-8cac-5b3f898f3282",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "The lowest balcony in an auditorium, cinema, theatre, etc.; the dress circle."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72ae3fb8-548f-3dc5-a3b0-6d211faa2fa1",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "Additional flooring laid over a floor to bring it up to some height or level."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e15ca32a-fe4c-3f5d-910b-2a38ab334d4e",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "In full mezzanine window: a small window at the height of a mezzanine floor (sense 1.1) or an attic, used to light these floors."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bb3d6fc-7b7e-3ee4-bae0-86a6f2c35994",
                                        "entry_id": "d3941c5b-7430-3c54-ad2b-d694b27b9487",
                                        "glosses": [
                                            "A floor under the stage, from which contrivances such as traps are worked."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9064170-99f1-3eb5-a93d-9d201b11239b",
                                        "entry_id": "ba017224-16aa-3150-9670-1b51c5e9fe53",
                                        "glosses": [
                                            "Characteristic of or relating to high-interest loans which have no collateral, and are regarded as intermediate in nature, ranking above equity but below secured loans."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf99e356-d172-41fb-97a6-eb12a257f5e4",
                                                "sense_id": "f9064170-99f1-3eb5-a93d-9d201b11239b",
                                                "text": "This new vehicle funded the purchases of these tranches by issuing fixed-income interests to investors who were seeking high returns and who were willing to believe that by repackaging mezzanine tranches in MBS structures, some tranches could be designated as safe enough to obtain a AAA or AA rating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a001e9ab-bece-3020-ba51-64de7da47b02",
                                        "entry_id": "ba017224-16aa-3150-9670-1b51c5e9fe53",
                                        "glosses": [
                                            "Fulfilling an intermediate or secondary function."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680a7310-80b3-423c-a5da-b2b13a810eb0",
                                                "sense_id": "a001e9ab-bece-3020-ba51-64de7da47b02",
                                                "text": "To make interconnections easier, we added a mezzanine PCB."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52f661d4-984e-3996-ba32-8d56ba90ee64",
                                        "entry_id": "8a7f0e46-a290-3ab8-b3d4-4a3563bdf197",
                                        "glosses": [
                                            "To fit (a building or other place) with a mezzanine floor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6296af12-f466-4520-a2bf-ea13809fbe25",
                        "source_entry_id": "41732737-d9a5-365c-ba7b-6abce7e0255d",
                        "source_sense_id": "c0fc2914-ee62-3b56-9d34-61eb6e4d2aef",
                        "source_sense_description": "innerhalb einer Etage zusätzlich eingefügtes, niedrigeres Geschoss",
                        "target_lang_word": "mezzanine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31399c98-61c7-349d-811a-b19d0c210003",
                                        "entry_id": "4166037a-fa68-3cb3-bbaf-b83321e04340",
                                        "glosses": [
                                            "Plancher intermédiaire n’occupant pas toute la surface de la pièce qu’il surplombe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42b7111-5796-4a90-8dff-6f4fba0d684b",
                                                "sense_id": "31399c98-61c7-349d-811a-b19d0c210003",
                                                "text": "Il a pour ambition de créer une place publique végétalisée, au lieu de l’actuel rond-point, une halle avec mezzanine pour les puces et un immeuble-pont de bureaux et d’hôtellerie-restauration, au-dessus du périphérique."
                                            },
                                            {
                                                "example_id": "97a295bd-2862-43a8-a346-d6a7b5952e10",
                                                "sense_id": "31399c98-61c7-349d-811a-b19d0c210003",
                                                "text": "Il débouche sur une pièce à mezzanine, haute de plafond, doublement éclairée d’une verrière et d’une longue vitrine sur la rue."
                                            },
                                            {
                                                "example_id": "d763baea-3838-4c66-a2e9-5750a3c3f2a7",
                                                "sense_id": "31399c98-61c7-349d-811a-b19d0c210003",
                                                "text": "D’amples rideaux rouges encadrent une scène minuscule, mais astucieusement agencée en mezzanine, pour jouer sur plusieurs plans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d467fcf-464b-3497-80be-a8831b3e385a",
                                        "entry_id": "4166037a-fa68-3cb3-bbaf-b83321e04340",
                                        "glosses": [
                                            "Sorte d'étage intermédiaire situé entre le parterre et les balcons dans une salle de spectacle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b44c092b-5f27-3005-a5dc-9e8eb1c97c59",
                                        "entry_id": "4166037a-fa68-3cb3-bbaf-b83321e04340",
                                        "glosses": [
                                            "Une carte mezzanine est une carte électronique qui se monte en parallèle d’une carte mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf439c2c-7865-4f62-b335-43152b6afd43",
                                                "sense_id": "b44c092b-5f27-3005-a5dc-9e8eb1c97c59",
                                                "text": "Des essais menés sur des transistors de type LDMOS 1 kW valident la carte mezzanine qui est un verrou technique pour garantir les deux modes de fonctionnement (vieillissement et caractérisation)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9b595c-0ed8-361d-bdbf-8566ad678392",
                                        "entry_id": "4166037a-fa68-3cb3-bbaf-b83321e04340",
                                        "glosses": [
                                            "Dette qui, dans un rachat d’entreprise par endettement, se situe entre la dette principale et les capitaux propres."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a562b0b0-0179-4d40-b864-0104c2f45688",
                                                "sense_id": "2c9b595c-0ed8-361d-bdbf-8566ad678392",
                                                "text": "La dette senior de Materis s’élève à près d’1,6 MdE. Avec l’obtention de cet accord, 118 ME viendra à échéance sur 2013-2014, 546 ME à fin 2015 et 925 ME en 2016. La mezzanine, d’un montant de 422 ME, viendra à échéance en décembre 2016."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d187ff02-8b36-3080-bfeb-01f4a48b1954",
                                        "entry_id": "4166037a-fa68-3cb3-bbaf-b83321e04340",
                                        "glosses": [
                                            "Lit mezzanine."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba4827a-65d4-4cc5-b60f-33af881db0fd",
                                                "sense_id": "d187ff02-8b36-3080-bfeb-01f4a48b1954",
                                                "text": "Elle se spécialise dans la fabrication de lits et de mezzanines qui fut une période faste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mezzanine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c714d0db-7555-3360-8765-8c16ace5134e",
                                        "entry_id": "c4f63aa6-b4f6-35e1-b562-c6cb7c640216",
                                        "glosses": [
                                            "Qualifie un type de fenêtre plus longue que haute et servant à éclairer un attique ou un entresol."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cbd93ce-c276-4471-8dfc-1b87351ebc92",
                                                "sense_id": "c714d0db-7555-3360-8765-8c16ace5134e",
                                                "text": "… et d'un étage surmonté d'une fenêtre mezzanine et d'un toit mansardé."
                                            },
                                            {
                                                "example_id": "b0354d94-dfaa-45f0-aa99-264c78db50d2",
                                                "sense_id": "c714d0db-7555-3360-8765-8c16ace5134e",
                                                "text": "À droite enfin le pignon du séjour percé d'une fenêtre mezzanine"
                                            },
                                            {
                                                "example_id": "5333f2db-c8b9-4c05-bfb0-0b6f3f080f71",
                                                "sense_id": "c714d0db-7555-3360-8765-8c16ace5134e",
                                                "text": "La fenêtre mezzanine a plus de largeur que de hauteur ; on la pratique quelquefois dans la frise d'un grand ordre d'architecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
