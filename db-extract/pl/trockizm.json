                        "glosses": [
                            "lewicowy ruch polityczny bazujący na ideach Lwa Trockiego, wiążą się z nim hasła takie jak: permanentna rewolucja, niemożliwość zbudowania socjalizmu tylko w jednym kraju oraz antystalinizm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d74a65c-4eac-488e-a2e5-96e0e0c21631",
                                "sense_id": "9466cee2-f240-36a8-93d5-3bff0af8c91c",
                                "text": "Związek Radziecki i jego państwa satelickie oskarżały najczęściej Jugosławię o faszyzm i trockizm."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
