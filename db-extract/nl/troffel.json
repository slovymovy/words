                                "target_senses": [
                                    {
                                        "sense_id": "77114838-b21d-30c7-80d7-3d5bf558acb1",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A mason’s tool, used in spreading and dressing mortar, and breaking bricks to shape them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d01cbbbc-4b7c-3a0c-8c03-7cbf44cd8b5d",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A gardener’s tool, shaped like a scoop, used in taking up plants, stirring soil etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2711ab-f43f-4f12-b964-6e9fcbb1aa65",
                                                "sense_id": "d01cbbbc-4b7c-3a0c-8c03-7cbf44cd8b5d",
                                                "text": "I need to dig a hole for these begonias; would you pass me that trowel?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca02c51c-f0c1-3845-9004-0caaca7c6949",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A tool used for smoothing a mold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trowel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f26e04-3f1a-31e7-b602-0c62d7625f35",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To apply (a substance) with a trowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3404fbcb-4c1f-4b16-828d-b9df44b01197",
                                                "sense_id": "16f26e04-3f1a-31e7-b602-0c62d7625f35",
                                                "text": "He troweled the coarse mix with a twist, leaving a pattern of arcs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03113e37-ddf8-3a53-8a0e-447c3e23c578",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To pass over with a trowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93df204f-7222-4c33-afa3-5f8eb95d259c",
                                                "sense_id": "03113e37-ddf8-3a53-8a0e-447c3e23c578",
                                                "text": "Most finish coats are troweled smooth, but sometimes you will have to add cosmetic touches to make the patch match the surrounding plaster, texturing the surface randomly or uniformly with any of a variety of tools, ranging from sponges to special trowels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e9b673-6ab6-3365-85e1-f6d7340b9cb7",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To apply something heavily or unsubtly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7b964e-208c-4ad5-bf94-67a24409fda5",
                                                "sense_id": "e7e9b673-6ab6-3365-85e1-f6d7340b9cb7",
                                                "text": "The whole Planet of the Apes set-up has been ripe for metaphor – from slavery and Afro-American revolution to European conquest of the Americas, even the war on terror. But mercifully, there's no big subtext being troweled on here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fd38419-3967-4f7e-89ac-915d97e1d061",
                        "source_entry_id": "f72a46b7-2c75-3097-9ce2-506a6dacb4ae",
                        "source_sense_id": "56a36cfd-3bf5-35ce-b262-f4ccf9777be7",
                        "source_sense_description": "een driekantige platte schep met handvat voor het opbrengen van metselspecie",
                        "target_lang_word": "truelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de66b28b-e198-3f18-b1ab-f43fa5711184",
                                        "entry_id": "c910a2a0-a504-3319-9b11-f41485ba17c4",
                                        "glosses": [
                                            "Outil utilisé pour manipuler et travailler des matériaux pâteux (ciment, plâtre, peinture…), formé d’une lame de métal et d’un manche courbé muni d’une poignée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea04121-772f-498c-9dee-800f3e40f1df",
                                                "sense_id": "de66b28b-e198-3f18-b1ab-f43fa5711184",
                                                "text": "Le maçon Abraham Knupfer chante, la truelle à la main, dans les airs échafaudé."
                                            },
                                            {
                                                "example_id": "720f73d5-c2d0-4f1b-9c2e-73f1af4c7641",
                                                "sense_id": "de66b28b-e198-3f18-b1ab-f43fa5711184",
                                                "text": "C’était à se demander si les maçons, au lieu de truelle, n’employaient pas la baguette d’un enchanteur."
                                            },
                                            {
                                                "example_id": "edaac5d9-2b47-4627-be9f-2cdf8072d86d",
                                                "sense_id": "de66b28b-e198-3f18-b1ab-f43fa5711184",
                                                "text": "Des préparatifs énormes étaient faits depuis huit jours, on parlait d’une auge et d’une truelle en argent, dont la vieille dame devait se servir en personne, ayant tenu à figurer, à triompher, avec ses quatre-vingt-deux ans."
                                            },
                                            {
                                                "example_id": "21f73440-d7b0-44c2-a974-3ed15c2d11cd",
                                                "sense_id": "de66b28b-e198-3f18-b1ab-f43fa5711184",
                                                "text": "C’est ainsi que Jozef Muls écrit que Smits peignait avec de petites truelles, obtenant ainsi le rugueux qui lui est caractéristique. Or, il n’y avait dans l’atelier ni truelle ni couteau, mis à part un couteau à pain pour gratter la peinture. Car Smits ne cessait jamais de peindre. Il continuait à peindre sur la peinture de la veille et si c’était trop, il grattait. Jamais il ne travailla avec une truelle ou un couteau de peintre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e01d0ca-74a8-3ba2-b592-85ad506b113b",
                                        "entry_id": "c910a2a0-a504-3319-9b11-f41485ba17c4",
                                        "glosses": [
                                            "Symbole des travaux de construction immobilière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff73997-2514-42e6-88f2-6e00d2009970",
                                                "sense_id": "2e01d0ca-74a8-3ba2-b592-85ad506b113b",
                                                "text": "En ce moment, la Spéculation, qui tend à changer la face de ce coin de Paris et à bâtir l’espace en friche qui sépare la rue d’Amsterdam de la rue du Faubourg-du-Roule, en modifiera sans doute la population, car la truelle est, à Paris, plus civilisatrice qu’on ne le pense !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa46dade-8ad5-3cf6-ac58-ba1822aa1c65",
                                        "entry_id": "c910a2a0-a504-3319-9b11-f41485ba17c4",
                                        "glosses": [
                                            "Spatule tranchante avec laquelle on découpe et on sert le poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f8919a-e1f7-4d89-8fe1-064cc1482fb6",
                                                "sense_id": "fa46dade-8ad5-3cf6-ac58-ba1822aa1c65",
                                                "text": "Truelle à poisson en argent."
                                            },
                                            {
                                                "example_id": "fed668a9-39eb-48bc-9cea-88198c0fa211",
                                                "sense_id": "fa46dade-8ad5-3cf6-ac58-ba1822aa1c65",
                                                "text": "On regarderait deux ans qu’on n’aurait pas tout vu. C’est touffu comme un chou, fenestré comme une truelle à poisson ; c’est gigantesque comme une pyramide et délicat comme une boucle d’oreille de femme, et l’on ne peut comprendre qu’un semblable filigrane puisse se soutenir en l’air depuis des siècles !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "truelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de1d0a68-8089-39cc-b24f-4eb3b672a88e",
