                ],
                "senses": [
                    {
                        "sense_id": "d41267d9-2a7a-351b-92c1-cf858f439f98",
                        "entry_id": "fc51470f-6b4f-34db-ad63-b72b23de992a",
                        "glosses": [
                            "Kurs, der für Personen ohne oder mit sehr geringen Vorkenntnissen in einem bestimmten Fachgebiet oder einer bestimmten Tätigkeit konzipiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33ffd0e-821d-4617-b136-1995f2e9c1d5",
                                "sense_id": "d41267d9-2a7a-351b-92c1-cf858f439f98",
                                "text": "„Wer noch nie Golf probiert hat, kann auch wahlweise einen Schnupper- oder Anfängerkurs belegen.“"
                            },
                            {
                                "example_id": "d718942b-30f0-47d4-8731-605b301046f6",
                                "sense_id": "d41267d9-2a7a-351b-92c1-cf858f439f98",
                                "text": "„Der Anfängerkurs wendet sich an alle Neueinsteiger*innen [sic], es sind keine Vorkenntnisse erforderlich.“"
                            },
                            {
                                "example_id": "70510f25-ee1c-4272-87c3-ccb21dd7db23",
                                "sense_id": "d41267d9-2a7a-351b-92c1-cf858f439f98",
                                "text": "„Unsere neuen Anfängerkurse starten nach den Sommerferien in den verschiedenen Sportarten.“"
                            },
                            {
                                "example_id": "19865be0-1d99-4201-bda8-0afbf6698607",
                                "sense_id": "d41267d9-2a7a-351b-92c1-cf858f439f98",
                                "text": "„Die Teilnahme an einem Anfängerkurs wird für Anfänger empfohlen, ist jedoch keine Voraussetzung für eine Mitgliedschaft.“"
                            },
                            {
                                "example_id": "94cc3260-eac2-4662-ac54-5e76f426fa98",
                                "sense_id": "d41267d9-2a7a-351b-92c1-cf858f439f98",
                                "text": "„Für ungeübte Anfänger, oder die die aus der Übung gekommen sind, warten zwei professionelle Snowboardschulen und Skischulen mit Anfängerkursen und Kursen für Fortgeschrittene auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
