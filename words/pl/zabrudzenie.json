                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнение",
                                "target_lang_sense_clarification": "загрязняющее вещество, примесь"
                            },
                            {
                                "target_lang_word": "примесь",
                                "target_lang_sense_clarification": "постороннее загрязняющее вещество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "823e67dc-59df-3bd4-a2be-bc14597eeb0d",
                    "sense_definition": "rzeczownik odczasownikowy od: <w>zabrudzić</w>; czynność polegająca na uczynieniu czegoś brudnym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przypadkowe <w>zabrudzenie</w> nowej koszuli sosem bardzo popsuło mu nastrój.",
                            "target_lang_translations": {
                                "ru": "Случайное <w>загрязнение</w> новой рубашки соусом сильно испортило ему настроение."
                            }
                        },
                        {
                            "text": "Robotnicy zabezpieczyli podłogę folią, aby zapobiec jej <w>zabrudzeniu</w> farbą.",
                            "target_lang_translations": {
                                "ru": "Рабочие застелили пол плёнкой, чтобы предотвратить его <w>загрязнение</w> краской."
                            }
                        }
                    ],
                    "synonyms": [
