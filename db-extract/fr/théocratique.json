        "fr-extract.jsonl": [
            {
                "entry_id": "1357ce2b-dd12-3e2a-b932-03b02fca86ab",
                "word": "théocratique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3c54f81-fd9e-4465-ac52-a381665624ce",
                        "entry_id": "1357ce2b-dd12-3e2a-b932-03b02fca86ab",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "théocratiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4dbf6428-ec3e-35ec-98d7-89a3e94cf5d8",
                        "entry_id": "1357ce2b-dd12-3e2a-b932-03b02fca86ab",
                        "glosses": [
                            "Qui appartient à la théocratie, qui a le caractère de la théocratie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7efc4230-c1d4-4c95-b71a-b789b5d8c561",
                                "sense_id": "4dbf6428-ec3e-35ec-98d7-89a3e94cf5d8",
                                "text": "L’inflexion actuelle des populations noires gagnées à l’islamisme, les pousse à renverser leurs monarchies absolues et guerrières, pour y substituer des gouvernemens théocratiques sous forme d’oligarchies."
                            },
                            {
                                "example_id": "abb39b90-97a0-42f5-83b8-958c1fb3ffac",
                                "sense_id": "4dbf6428-ec3e-35ec-98d7-89a3e94cf5d8",
                                "text": "Moïse avait donné à ce don de prophétie ou d'inspiration une immense autorité, en faisant de son peuple, gouverné par Dieu même, une république théocratique dont la tribu de Lévi avait exclusivement le sacerdoce, organe alors de la souveraineté divine."
                            },
                            {
                                "example_id": "3f20fa62-004e-4302-8679-b5e5ed09c759",
                                "sense_id": "4dbf6428-ec3e-35ec-98d7-89a3e94cf5d8",
                                "text": "Et il termina lui aussi par une discrète allusion à l’influence grandissante du clergé, en disant qu’il n’admettait les compromissions d’aucune part, repoussant aussi bien la dictature d’État que le réveil de l’ancien esprit théocratique."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4fcd0b1-b132-3d78-b968-c625b807bcc1",
                        "entry_id": "1357ce2b-dd12-3e2a-b932-03b02fca86ab",
                        "glosses": [
                            "Qui soutient les doctrines théocratiques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff00eaab-7d04-4291-8638-f003711be165",
                        "source_entry_id": "1357ce2b-dd12-3e2a-b932-03b02fca86ab",
                        "target_lang_word": "theocratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theocratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ae3b3f-3b01-348c-b8d1-3bb3c6186172",
                                        "entry_id": "57e584ec-0824-3838-b5cc-ca7c8d1fe51d",
                                        "glosses": [
                                            "Pertaining to theocracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6eba2ab-249f-400b-a030-fb745e669e62",
                                                "sense_id": "a0ae3b3f-3b01-348c-b8d1-3bb3c6186172",
                                                "text": "“The notion that rights don’t come from laws and don’t come from the government, but come from the Creator — that’s what the Iranian government believes,” he said. “It’s a theocratic regime that bases its rule on Shia (sic) law and targets Sunnis, Bahá’ís, Jews, Christians, and other religious minorities. They do it because they believe that they understand what natural rights are from their Creator. So, the statement that our rights do not come from our laws or our governments is extremely troubling.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b60699c-1abb-34b7-82ac-4c57e76de864",
                                        "entry_id": "57e584ec-0824-3838-b5cc-ca7c8d1fe51d",
                                        "glosses": [
                                            "Conforming to God-rule, by Christian behavior."
                                        ],
                                        "tags": [
                                            "Jehovah's-Witnesses"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
