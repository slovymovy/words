                                    },
                                    {
                                        "sense_id": "0fe498a6-f74e-3f38-8c79-30743899a5b1",
                                        "entry_id": "5d080dd2-37ba-3450-ab17-35e795389703",
                                        "glosses": [
                                            "The position of a flag (on a mast) or of a sail on a ship when lifted up to its highest level."
                                        ],
                                        "tags": [],
