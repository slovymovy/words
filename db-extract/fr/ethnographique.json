                    }
                ],
                "senses": [
                    {
                        "sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                        "entry_id": "402eb500-9a8e-33bc-a845-13e9d3994d3f",
                        "glosses": [
                            "Relatif à l’ethnographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21bd472-2aca-4264-9b6f-ed57284cf603",
                                "sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                                "text": "De nos jours, on commet une erreur plus grave : on confond la race avec la nation, et l’on attribue à des groupes ethnographiques ou plutôt linguistiques une souveraineté analogue à celle des peuples réellement existants."
                            },
                            {
                                "example_id": "4c0409bb-cdd5-46f0-a854-03c10eb8a705",
                                "sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                                "text": "Par « Malayo-Polynésiens », je désigne l'ensemble des peuples indonésiens, mélanésiens et polynésiens, qui, du point de vue ethnographique et surtout anthropologique, ont chacun leur individualité; mais qui parlent des langues nettement apparentées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85690d24-198e-48f0-87b5-42d881b311fc",
                        "source_entry_id": "402eb500-9a8e-33bc-a845-13e9d3994d3f",
                        "source_sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                        "target_lang_word": "ethnographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                                        "entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                                        "glosses": [
                                            "Relating to ethnography."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beb720fa-25d9-427a-aab9-b205c4fca6f2",
                                                "sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                                                "text": "Among anthropologists old ethnographic descriptions and travelbooks have a bad reputation. With the exception of ethnohistorians, anthropologists make little use of these sources for ethnographic research because of their reputed lack of reliability."
                                            }
                                        ]
                                    }
                                ]
                            }
