                                "target_lang_word": "Чик",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇克",
                                "target_lang_sense_clarification": "英语姓氏的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6de236c-a817-3d48-bea7-ea38bcd45c6d",
                    "sense_definition": "A place name, such as a community in Oklahoma or Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Cheek</w> on their way south.",
                            "target_lang_translations": {
                                "ru": "Они проехали через небольшую общину <w>Чик</w> по пути на юг.",
                                "zh": "他们在南下途中开车经过了小社区<w>奇克</w>。"
                            }
