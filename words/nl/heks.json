    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa939f32-9ff9-32ef-9bd5-066136d751eb",
                    "sense_definition": "Een boosaardige vrouw met magische krachten in sprookjes en mythen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boze <w>heks</w> sloot Hans op in een kooi van het snoephuisje.",
                            "target_lang_translations": {
                                "en": "The wicked <w>witch</w> locked Hans in a cage of the gingerbread house.",
                                "ru": "Злая <w>ведьма</w> заперла Ганса в клетке пряничного домика."
                            }
                        },
                        {
                            "text": "In veel oude sprookjes vliegt de <w>heks</w> op een bezemsteel door de nacht.",
                            "target_lang_translations": {
                                "en": "In many old fairy tales, the <w>witch</w> flies through the night on a broomstick.",
                                "ru": "Во многих старых сказках <w>ведьма</w> летает по ночам на метле."
                            }
                        }
                    ],
                    "synonyms": [
                        "toverheks",
                        "toverkol"
                    ],
                    "common_phrases": [
                        "boze heks",
                        "vliegen op een bezemsteel"
                    ],
                    "target_lang_definitions": {
                        "en": "A malevolent woman with magical powers in fairy tales and myths.",
                        "ru": "Злая женщина с магическими способностями в сказках и мифах."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "witch",
                                "target_lang_sense_clarification": "a magical being in folklore"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ведьма",
                                "target_lang_sense_clarification": "сказочное существо"
                            },
                            {
                                "target_lang_word": "колдунья",
                                "target_lang_sense_clarification": "женщина, занимающаяся магией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c7bf53d-37e4-3028-8558-7284e4c72715",
                    "sense_definition": "Een persoon aan wie bovennatuurlijke krachten worden toegeschreven, vaak in een historische of occulte context.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de middeleeuwen geloofden veel mensen dat een <w>heks</w> ziektes kon veroorzaken.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, many people believed that a <w>witch</w> could cause diseases.",
                                "ru": "В Средние века многие люди верили, что <w>ведьма</w> может насылать болезни."
                            }
                        },
                        {
                            "text": "Tijdens de historische processen werd zij onterecht beschuldigd een <w>heks</w> te zijn.",
                            "target_lang_translations": {
                                "en": "During the historical trials, she was wrongly accused of being a <w>witch</w>.",
                                "ru": "Во время исторических процессов её несправедливо обвинили в том, что она <w>ведьма</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heksen vervolgen",
                        "geloven in heksen"
                    ],
                    "target_lang_definitions": {
                        "en": "A person to whom supernatural powers are attributed, often in a historical or occult context.",
                        "ru": "Человек, которому приписываются сверхъестественные способности, часто в историческом или оккультном контексте."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "witch",
                                "target_lang_sense_clarification": "a person using supernatural powers"
                            },
                            {
                                "target_lang_word": "Wiccan",
                                "target_lang_sense_clarification": "a follower of a modern pagan religion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ведьма",
                                "target_lang_sense_clarification": "в историческом контексте"
                            },
                            {
                                "target_lang_word": "колдунья",
                                "target_lang_sense_clarification": "человек с магическими силами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a389ffa1-2bc1-368c-b57c-6dff4cea3ac0",
                    "sense_definition": "Een onaangename, gemene of zeer lastige vrouw.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoonlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand wil met haar samenwerken omdat ze zich als een echte <w>heks</w> gedraagt.",
                            "target_lang_translations": {
                                "en": "No one wants to work with her because she behaves like a real <w>witch</w>.",
                                "ru": "Никто не хочет с ней работать, потому что она ведет себя как настоящая <w>ведьма</w>."
                            }
                        },
                        {
                            "text": "Wat is die gemene <w>heks</w> weer onvriendelijk tegen de nieuwe buren.",
                            "target_lang_translations": {
                                "en": "That mean <w>witch</w> is being unfriendly to the new neighbors again.",
                                "ru": "Какая же эта злая <w>ведьма</w> снова неприветливая с новыми соседями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oude heks",
                        "wat een heks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a term of abuse"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An unpleasant, mean, or very difficult woman.",
                        "ru": "Неприятная, злая или очень трудная в общении женщина."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "witch",
                                "target_lang_sense_clarification": "an unpleasant or mean woman"
                            },
                            {
                                "target_lang_word": "hag",
                                "target_lang_sense_clarification": "an ugly or unpleasant woman"
                            },
                            {
                                "target_lang_word": "bitch",
                                "target_lang_sense_clarification": "a derogatory term for a mean woman"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ведьма",
                                "target_lang_sense_clarification": "о злой женщине"
                            },
                            {
                                "target_lang_word": "мегера",
                                "target_lang_sense_clarification": "сварливая, злая женщина"
                            },
                            {
                                "target_lang_word": "стерва",
                                "target_lang_sense_clarification": "грубое обозначение неприятной женщины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e97c26f0-1bc9-34d3-b039-8149f51dfcc5",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>heksen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>heks</w> de hele dag om alles op tijd af te krijgen.",
                            "target_lang_translations": {
                                "en": "I <w>scramble</w> all day to get everything finished on time.",
                                "ru": "Я весь день <w>суечусь</w>, чтобы успеть всё закончить вовремя."
                            }
                        },
                        {
                            "text": "Als ik zo snel mogelijk werk, dan <w>heks</w> ik het wel in elkaar.",
                            "target_lang_translations": {
                                "en": "If I work as fast as possible, I'll <w>throw</w> it together.",
                                "ru": "Если я буду работать максимально быстро, я как-нибудь это <w>состряпаю</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'heksen' (to work frantically or perform magic).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола 'heksen' (суетиться, лихорадочно работать или колдовать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "to work frantically"
                            },
                            {
                                "target_lang_word": "scramble",
                                "target_lang_sense_clarification": "to move or work hurriedly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "суечусь",
                                "target_lang_sense_clarification": "лихорадочно работать"
                            },
                            {
                                "target_lang_word": "спешу",
                                "target_lang_sense_clarification": "торопиться сделать что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22ecfb28-d054-30c3-9039-bdb412db45e4",
                    "sense_definition": "De gebiedende wijs van <w>heksen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Heks</w> niet zo en doe gewoon rustig je werk.",
                            "target_lang_translations": {
                                "en": "Don't <w>rush</w> so much and just do your work calmly.",
                                "ru": "Не <w>суетись</w> так и просто спокойно делай свою работу."
                            }
                        },
                        {
                            "text": "Kom op, <w>heks</w> een beetje sneller zodat we naar huis kunnen.",
                            "target_lang_translations": {
                                "en": "Come on, <w>hurry up</w> a bit so we can go home.",
                                "ru": "Давай, <w>поторапливайся</w>, чтобы мы могли пойти домой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'heksen' (to work frantically or perform magic).",
                        "ru": "Повелительное наклонение глагола 'heksen' (суетиться, лихорадочно работать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurry up",
                                "target_lang_sense_clarification": "to move or work faster"
                            },
                            {
                                "target_lang_word": "get a move on",
                                "target_lang_sense_clarification": "to hurry"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "суетись",
                                "target_lang_sense_clarification": "в значении спешки"
                            },
                            {
                                "target_lang_word": "поторапливайся",
                                "target_lang_sense_clarification": "призыв делать быстрее"
                            }
                        ]
                    }
                }
            ]
        }
    ]
