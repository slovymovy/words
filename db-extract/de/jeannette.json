                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c06e92-195f-4a4b-9270-faaefcfb1937",
                                                "sense_id": "a238a414-8fd6-32f1-a56c-5c3aa91cca0b",
                                                "text": "\"Is Janette Lisle Miss Lisle, Walter?\" \"Yes, Vinnie; the eldest Miss Lisle. Janette is her name. Very pretty name, don't you think?\""
                                            },
                                            {
                                                "example_id": "6263025d-944f-45f2-b016-cddc4f9ea2c8",
                                                "sense_id": "a238a414-8fd6-32f1-a56c-5c3aa91cca0b",
                                                "text": "\"Janette Marie de la Beauville,\" he said softly. \"It's a good name. Did you see it on the ad? It sounds much more important than Harry Winston.\""
                                            }
                                        ]
                                    }
