                "senses": [
                    {
                        "sense_id": "7c9e53fa-ac3e-336a-84a0-2409c34217fb",
                        "entry_id": "055d292c-25da-3686-b4bb-0e29c1799c07",
                        "glosses": [
                            "Emission charakteristischer sekundärer Röntgenstrahlen von einem Material, das mit hochenergetischer Strahlung angeregt wurde"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "1170771f-b733-454c-b1c2-7bc0cf571ff3",
                                "sense_id": "7c9e53fa-ac3e-336a-84a0-2409c34217fb",
                                "text": "«Die Röntgenfluoreszenz wird schon seit längerem genutzt, um die Zusammensetzung von Materialien zu bestimmen, etwa von Metallen oder Gesteinen. Eine Probe wird dabei mit Röntgenlicht bestrahlt. Hat das Licht eine genügend kurze Wellenlänge, beginnen die Atome in der Probe zu fluoreszieren.»"
                            }
                        ],
