                ],
                "senses": [
                    {
                        "sense_id": "2f077e6f-ad6b-372e-b251-83f2c35d89d0",
                        "entry_id": "7959200f-2029-3feb-88d4-d65b0f0ad1b1",
                        "glosses": [
                            "разг., сниж. пройти пешком какое-либо расстояние; пропереть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0f3e02-479c-442a-a248-80eba8896fad",
                                "sense_id": "2f077e6f-ad6b-372e-b251-83f2c35d89d0",
                                "text": "Пропёрся в дождь десять километров."
                            }
                        ]
                    },
                    {
                        "sense_id": "92c22ca4-9cec-32d8-8c36-680f61aedef6",
                        "entry_id": "7959200f-2029-3feb-88d4-d65b0f0ad1b1",
                        "glosses": [
                            "разг., сниж. с трудом пройти, протиснуться, пробраться куда-либо"
                        ],
                        "tags": [
                            "куда., во что., до какого места, предела."
                        ],
                        "examples": [
                            {
                                "example_id": "294c6d00-59a4-42ec-a91a-9296b87afc14",
                                "sense_id": "92c22ca4-9cec-32d8-8c36-680f61aedef6",
                                "text": "Пропереться в переполненный вагон."
                            },
                            {
                                "example_id": "042ae361-e41c-42e7-8793-37e47c7e199f",
                                "sense_id": "92c22ca4-9cec-32d8-8c36-680f61aedef6",
                                "text": "Еле пропёрся в дверь."
                            },
                            {
                                "example_id": "9d86ce49-6f78-402f-972b-53072b6725ea",
                                "sense_id": "92c22ca4-9cec-32d8-8c36-680f61aedef6",
                                "text": "Но это был всего лишь сосед-слесарь, вдребезину пьяный, который незнамо как успел пропереться уже до середины комнаты и теперь качался рядом, взирая в тупом удивлении на коленопреклонённого хозяина."
                            }
                        ]
                    },
                    {
                        "sense_id": "250ce90a-7244-3f39-b5d7-b8b2898dc0a2",
                        "entry_id": "7959200f-2029-3feb-88d4-d65b0f0ad1b1",
                        "glosses": [
                            "разг., сниж. грубо, бесцеремонно пройти, войти куда-либо; пропереть"
                        ],
                        "tags": [
                            "куда."
                        ],
                        "examples": [
                            {
                                "example_id": "7d5ea7ff-8e52-4562-b8dc-36fdd8a800aa",
                                "sense_id": "250ce90a-7244-3f39-b5d7-b8b2898dc0a2",
                                "text": "Генерал сразу пропёрся в комнату, забубнил там: бу-бу-бу."
                            }
                        ]
                    }
                ],
