                    {
                        "translation_id": "864c0160-1c8d-4d6e-97f7-50446b898917",
                        "source_entry_id": "561425cf-ae3f-353c-8860-22851b5fd1fb",
                        "source_sense_id": "e2c19d8c-4d32-3222-9664-f37a7c581dee",
                        "source_sense_description": "a person who practices exorcism",
                        "target_lang_word": "exorciste",
                        "target_lang_code": "fr",
