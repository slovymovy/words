                        "sense_id": "c24f2a8e-0335-3480-863d-486a1e525d37",
                        "entry_id": "5749c338-014c-3f69-b479-c609bd092e51",
                        "glosses": [
                            "het geheel van toetsen, pedalen, en andere bedieningsorganen van een muziekinstrument, vooral van een orgel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd45b65a-9c6e-49f5-b539-fe8aff092c82",
                                "sense_id": "c24f2a8e-0335-3480-863d-486a1e525d37",
                                "text": "De orgelbouwer zal ons vandaag uitleg geven over de mogelijkheden van een moderne speeltafel voor ons orgel."
                            }
                        ]
