                "senses": [
                    {
                        "sense_id": "df518523-63cc-372d-81ab-82a3807e7bcb",
                        "entry_id": "a3dd516e-84ed-3615-8004-49036d6ac858",
                        "glosses": [
                            "besonders schlechtes, unnötiges Spiel"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "74b6ea94-0cc7-4957-b109-ac4b58c5e77f",
                                "sense_id": "df518523-63cc-372d-81ab-82a3807e7bcb",
                                "text": "„›Eines dürfen Sie mir glauben, Shaw‹, rief Standish. ›Unsere Töchter werden sich nicht mit diesen Scheißspielen beschäftigen.‹“"
                            },
                            {
                                "example_id": "4f17ec4f-cb9a-414a-9d63-f0137054923e",
                                "sense_id": "df518523-63cc-372d-81ab-82a3807e7bcb",
                                "text": "„Verdammt, der Gray Man zu sein bedeutete keineswegs, immer alles unter Kontrolle zu haben. Manchmal bedeutete es auch, anderen komplett die Kontrolle zu überlassen, ihr Spiel mitzuspielen, auch wenn es ein Scheißspiel war, bei dem irgendein Arschloch dir auf dem Hinterkopf herumstand.“"
                            },
                            {
                                "example_id": "04ad23a5-7d13-46b2-ae95-b26a0edcf816",
                                "sense_id": "df518523-63cc-372d-81ab-82a3807e7bcb",
                                "text": "„Wissen Sie, Graves, das ist ein Scheißspiel.“"
                            },
                            {
                                "example_id": "bd3b49ec-dc85-47ee-aa01-6c9523a1fe83",
                                "sense_id": "df518523-63cc-372d-81ab-82a3807e7bcb",
                                "text": "„Und wenn er sagt, was, dann frag ich: Wieso haste mich denn bei dem Scheißspiel da unten mitmachen lassen?“"
                            },
                            {
                                "example_id": "0db97d40-03e3-45a6-a9c6-12612c0867b1",
                                "sense_id": "df518523-63cc-372d-81ab-82a3807e7bcb",
                                "text": "„›Das ist ein Scheißspiel, Lieutenant.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
