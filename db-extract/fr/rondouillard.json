                                                "sense_id": "93f4d460-f96e-3df6-aa75-6578d5ebc33a",
                                                "text": "Ewald und Heidi sind mollig und möchten ein wenig an Körpergewicht abnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "611a1075-b6ec-3e4b-b412-018d7443ac23",
                                        "entry_id": "e3c4d57f-ce12-3a34-94bb-22087fdf2f27",
                                        "glosses": [
                                            "angenehm warm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8de1b8-16ff-4c88-93f1-d343f6cd642e",
                                                "sense_id": "611a1075-b6ec-3e4b-b412-018d7443ac23",
                                                "text": "Das ist aber schön mollig bei dir!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a12e0a7-181f-4608-8366-8066949446c7",
