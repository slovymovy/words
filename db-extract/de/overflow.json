                    {
                        "translation_id": "33eef7e5-aaf6-46fe-a210-3e425106fdec",
                        "source_entry_id": "561327a8-13db-3a6e-b1d4-bf0c59297c8a",
                        "source_sense_id": "04299a1b-c262-3de0-a669-9ec286c895f3",
