                ],
                "senses": [
                    {
                        "sense_id": "35f54817-5123-3a3b-a6f7-f92dd7fa8da6",
                        "entry_id": "fa91cba2-57be-3bf7-95e9-543cf448a352",
                        "glosses": [
                            "Verletzung/Beeinträchtigung (Schaden), die durch die Einwirkung von Strahlung (am menschlichen Gewebe) entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd4a72f-ffa7-4412-95fe-eb415b9c2496",
                                "sense_id": "35f54817-5123-3a3b-a6f7-f92dd7fa8da6",
                                "text": "Wenn wir bei Strahlenschäden von Strahlung sprechen, meinen wir a-, ß-, y- und Röntgenstrahlen genauso wie Protonen, Neutronen und Pionen."
                            },
                            {
                                "example_id": "7af37341-274c-4d49-931d-06c7107189ee",
                                "sense_id": "35f54817-5123-3a3b-a6f7-f92dd7fa8da6",
                                "text": "Früher litten besonders Röntgenärzte unter Strahlenschäden."
                            },
                            {
                                "example_id": "05c5a4c2-3dab-45cf-bb05-7e7d90f4d515",
                                "sense_id": "35f54817-5123-3a3b-a6f7-f92dd7fa8da6",
                                "text": "„Protrahierung der Bestrahlung (niedrige Dosis pro Zeit) reduziert die biologische Wirksamkeit einer Bestrahlungsdosis und ist Ausdruck der Erholung vom subletalen Strahlenschaden.“"
                            },
                            {
                                "example_id": "4ab29886-cdb0-4025-a474-3e788f33aa7a",
                                "sense_id": "35f54817-5123-3a3b-a6f7-f92dd7fa8da6",
                                "text": "„Die Schadensarten bei einer Exposition des Menschen mit ionisierender Strahlung werden in die deterministischen und die stochastischen Strahlenschäden eingeteilt.“"
                            },
                            {
                                "example_id": "6495c3e8-49d3-4c98-ac3f-a2c9ebb1c710",
                                "sense_id": "35f54817-5123-3a3b-a6f7-f92dd7fa8da6",
                                "text": "„Wenn die Strahlendosis den Schwellenwert von 500 Millisievert (mSv) überschreitet, treten deterministische Strahlenschäden auf. Die Schäden entstehen durch den Zelltod.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
