                "senses": [
                    {
                        "sense_id": "8641bef3-0a96-3b92-926a-6d5beb71ffc4",
                        "entry_id": "b277050d-cab1-303f-b5e9-f46df60f4d94",
                        "glosses": [
                            "die Ziele und die Entscheidungen einer Regierung, die die Nutzung der Kernenergie betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414811f4-52ac-4b2b-b22e-f4e1a2b9c9ad",
                                "sense_id": "8641bef3-0a96-3b92-926a-6d5beb71ffc4",
                                "text": "„Am 17. März 2011 stand in den Nachrichtensendungen die Reaktorkatastrophe in Japan und die Kurskorrektur der Regierung in der Atompolitik im Mittelpunkt.“"
                            },
                            {
                                "example_id": "04129eab-f230-44af-a2ef-bcf9c54e3f32",
                                "sense_id": "8641bef3-0a96-3b92-926a-6d5beb71ffc4",
                                "text": "„Ich kann mir gut vorstellen, dass die Anti-Atomprotestler in den 80ern oft frustriert waren, dass ihre Demos keine unmittelbare Wende in der Atompolitik herbeiführten.“"
                            }
                        ],
