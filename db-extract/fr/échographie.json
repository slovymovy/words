                                ]
                            },
                            {
                                "target_word": "siêu âm",
                                "target_lang_code": "vi",
                                "target_senses": [
                                    {
                                        "sense_id": "4aaa0315-cd70-3f49-b258-33ab01e7a965",
                                        "entry_id": "33bbbb53-32d5-3cd4-b625-a0d65b146b46",
                                        "glosses": [
                                            "Chẩn đoán, thăm khám bằng phương pháp siêu âm y khoa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6087e393-c524-4749-8430-08053520e0e9",
                                                "sense_id": "4aaa0315-cd70-3f49-b258-33ab01e7a965",
                                                "text": "Khi phát hiện thai có dấu hiệu bất thường, các thai phụ sẽ được siêu âm hình thái chi tiết, siêu âm tim thai, hệ thần kinh trung ương bằng hệ thống thiết bị siêu âm tiên tiến nhất, cho phép quan sát rõ nét cấu trúc và mạch máu của thai, đặc biệt ở giai đoạn sớm."
                                            },
                                            {
                                                "example_id": "783e6452-36fa-4821-9877-59cb48262448",
                                                "sense_id": "4aaa0315-cd70-3f49-b258-33ab01e7a965",
                                                "text": "Lúc tôi có bầu được 4 tháng, siêu âm ra là một bé trai."
                                            },
                                            {
                                                "example_id": "954f5c21-5f57-4f5a-96e5-ed6ef496d72b",
                                                "sense_id": "4aaa0315-cd70-3f49-b258-33ab01e7a965",
                                                "text": "Hiện tại, bệnh viện đang khám, điều trị cho khoảng 200 bệnh nhân và mỗi ngày tiếp nhận khoảng chục ca khám, nhập viện nhưng hệ thống siêu âm, điện quang tăng sáng truyền hình, nội soi, đo độ loãng xương, xét nghiệm tế bào sinh hóa… phải đắp chiếu vì nguồn điện không đảm bảo để vận hành an toàn…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
