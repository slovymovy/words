                    {
                        "translation_id": "71f5bb7c-e32d-4dfd-ad0c-ecf4518fe560",
                        "source_entry_id": "4d2c0395-6793-3b32-8dd6-4a38f598104b",
                        "source_sense_id": "3290e73f-d921-3b6b-bb51-695e13a8ac65",
                        "target_lang_word": "chemo",
