                ],
                "senses": [
                    {
                        "sense_id": "afa73528-d0af-366b-b6bf-5ba869404e1e",
                        "entry_id": "340c67a3-0a6c-3ef5-af3a-864a525ad781",
                        "glosses": [
                            "тот, кто занимается экспедированием, экспедицией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a05cff1-527b-40fd-a173-3b0c9c4cb6f1",
                                "sense_id": "afa73528-d0af-366b-b6bf-5ba869404e1e",
                                "text": "Два года был я дорожным экспедитором: возил грузы на золотые прииски, кассетиритовые рудники."
                            }
                        ]
                    },
                    {
                        "sense_id": "1aa2e30f-6b4a-338f-af31-c45cea07a29c",
                        "entry_id": "340c67a3-0a6c-3ef5-af3a-864a525ad781",
                        "glosses": [
                            "истор. в некоторых правительственных учреждениях Российского государства до 1917 г. — чиновник, начальник отделения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12497c5e-8c32-4ca1-b013-5b60e12f5aff",
                                "sense_id": "1aa2e30f-6b4a-338f-af31-c45cea07a29c",
                                "text": "Следующий день я весь отдыхал, а затем явился в канцелярию для знакомства с главными начальниками её, или, как они назывались, экспедиторами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f44a8c7-be31-4a45-86bd-5ed195052a31",
                        "source_entry_id": "340c67a3-0a6c-3ef5-af3a-864a525ad781",
                        "source_sense_description": "тот, кто занимается экспедированием, экспедицией",
                        "target_lang_word": "forwarding agent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f337cd8b-fa4b-4bb9-9e88-8054da2f58f3",
                        "source_entry_id": "340c67a3-0a6c-3ef5-af3a-864a525ad781",
                        "source_sense_description": "тот, кто занимается экспедированием, экспедицией",
                        "target_lang_word": "forwarder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forwarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f23f8b-2892-3232-9ecc-a3404abe8720",
                                        "entry_id": "714a50bb-6f54-3f80-afdf-d2ddfa8e4513",
                                        "glosses": [
                                            "One who, or that which, forwards something to another destination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "forwarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                        "entry_id": "087c9b99-154c-39fa-8612-097e17555ab5",
                                        "glosses": [
                                            "Comparative form of forward: more forward."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "comparative",
                                            "dialectal",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95a468b-42e1-440d-bd05-204991b84a58",
                                                "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                                "text": "It is hard to draw evill men to good actions, especially for Church and State; therefore will I suspect that wherein they are more forwarder then honester men."
                                            },
                                            {
                                                "example_id": "609ac1b2-1b3f-45b9-8dce-6d40eb5b59a4",
                                                "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                                "text": "But whilst she is moving from her perigee to her apogee, her true place is observed to be forwarder than her mean place, and therefore, throughout that half of her orbit, the equation must be added to her mean place, in order to find her true place."
                                            },
                                            {
                                                "example_id": "18a87cd6-0bc5-4706-9a20-74188f312f48",
                                                "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                                "text": "He tried thinking his way through the problem, but that did not get him any forwarder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
