                    ]
                },
                {
                    "sense_id": "1e6bf5f7-f707-3921-a7b1-12c3fde6acc5",
                    "sense_definition": "für den Lebensunterhalt von Personen aufkommen und deren Existenz sichern",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "versorgung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit seinem geringen Lohn konnte der Arbeiter kaum eine Familie <w>nähren</w>."
                        },
                        {
                            "text": "Früher mussten viele Generationen gemeinsam das Land bewirtschaften, um alle Angehörigen zu <w>nähren</w>."
                        }
                    ],
                    "synonyms": [
                        "durchbringen",
                        "versorgen"
                    ],
                    "common_phrases": [
