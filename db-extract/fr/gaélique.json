            {
                "entry_id": "4261f0ee-8ea8-3fd3-aae4-43bea2a27dd9",
                "word": "gaélique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5456605-4d2f-3ebf-9f8d-b2ff543c48da",
                        "entry_id": "4261f0ee-8ea8-3fd3-aae4-43bea2a27dd9",
                        "glosses": [
                            "L’une des trois langues, gaélique irlandais, gaélique écossais ou mannois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3bab6c-736d-4923-b230-20bb8ddc0744",
                                "sense_id": "f5456605-4d2f-3ebf-9f8d-b2ff543c48da",
                                "text": "– Je parle assez couramment le gaélique, mon cher professeur, mais quant aux racines, à la syntaxe, à la littérature, pfft ! j’ai maudit ma malchance."
                            },
                            {
                                "example_id": "c3140ba3-65ad-47af-8941-a7b5e290abc0",
                                "sense_id": "f5456605-4d2f-3ebf-9f8d-b2ff543c48da",
                                "text": "Le gaélique est revendiqué en anglais et l’euskera en espagnol."
                            },
                            {
                                "example_id": "1910c03a-5921-452d-b3ca-bbf4410de0ae",
                                "sense_id": "f5456605-4d2f-3ebf-9f8d-b2ff543c48da",
                                "text": "De xénophobe, qui parodient le gaélique comme un sabir de demeurés en pleine séance de l’assemblée d’Irlande du Nord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3719cbc1-6057-4411-9a96-4bad10487b78",
                        "source_entry_id": "4261f0ee-8ea8-3fd3-aae4-43bea2a27dd9",
                        "source_sense_id": "f5456605-4d2f-3ebf-9f8d-b2ff543c48da",
                        "target_lang_word": "Gälisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gälisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6517e469-1912-3379-bcd5-ffa0350d604b",
                                        "entry_id": "cf2e9aed-d63a-3b04-8f1d-6d0fd8a3a765",
                                        "glosses": [
                                            "die Familie gälischer Sprachen Irisch, Manx und Schottisch-Gälisch"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "319d5d55-d5ad-4d2b-ad9c-1d1366197e6a",
                                                "sense_id": "6517e469-1912-3379-bcd5-ffa0350d604b",
                                                "text": "Gälisch beherrschen nicht mehr viele Sprecher.",
                                                "translation": "[*] „Eine Kakophonie von Stimmen und Rufen erfüllt den Platz, und das Bretonisch und Gälisch der Bauern, beides Sprachen, die ihren Ursprung auf den Britischen Inseln haben und auf dem Land um Vannes gebräuchlich sind, übertönt oft das Französisch der Städter.“"
                                            },
                                            {
                                                "example_id": "b649f803-3966-4de2-87c4-0c5c39b8846a",
                                                "sense_id": "6517e469-1912-3379-bcd5-ffa0350d604b",
                                                "text": "„Etwa ab dem 10. Jahrhundert ist der Unterschied zwischen irischem und schottischem Gälisch (bis in die jüngste Zeit oft Erse genannt) nachweisbar, und zweifellos begann auch das Gälische der Isle of Man (Manx) zu jener Zeit sprachlich abzuweichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f489e919-b66f-30f7-b4d5-3ba33f15bca9",
                                        "entry_id": "cf2e9aed-d63a-3b04-8f1d-6d0fd8a3a765",
                                        "glosses": [
                                            "die irische Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51047585-d98c-451e-82e8-f732994ef4dc",
                                                "sense_id": "f489e919-b66f-30f7-b4d5-3ba33f15bca9",
                                                "text": "Gälisch beherrschen nicht mehr viele Sprecher.",
                                                "translation": "[*] „Eine Kakophonie von Stimmen und Rufen erfüllt den Platz, und das Bretonisch und Gälisch der Bauern, beides Sprachen, die ihren Ursprung auf den Britischen Inseln haben und auf dem Land um Vannes gebräuchlich sind, übertönt oft das Französisch der Städter.“"
                                            },
                                            {
                                                "example_id": "1b8f1d4f-1a54-4532-a2f8-ea44cbad2d9d",
                                                "sense_id": "f489e919-b66f-30f7-b4d5-3ba33f15bca9",
                                                "text": "„Hinweise auf eine gemeinsame Abstammung fanden die Humanisten vor allem in den Sprachen, etwa den Ähnlichkeiten zwischen dem Walisischen und dem Gälischen, das in Irland gesprochen wurde.“"
                                            },
                                            {
                                                "example_id": "5fa00879-9da1-48b7-8b02-1aa0f6fe69ba",
                                                "sense_id": "f489e919-b66f-30f7-b4d5-3ba33f15bca9",
                                                "text": "„Jahrhundertelang war Gälisch die Sprache der Armen und oft auch Ungebildeten gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1e024cc7-7841-3487-90a5-e6346f1dd264",
                                        "entry_id": "cf2e9aed-d63a-3b04-8f1d-6d0fd8a3a765",
                                        "glosses": [
                                            "in Schottland gesprochene Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f9a83f-643a-41ae-b779-46de49180dd9",
                                                "sense_id": "1e024cc7-7841-3487-90a5-e6346f1dd264",
                                                "text": "„1513 starb mit Jakob IV. der letzte schottische König, der Gälisch beherrschte.“",
                                                "translation": "[*] „Bei den inselkeltischen Sprachen wiederum unterscheidet man die goidelische Sprachgruppe mit den Sprachen Irisch, Gälisch und Manx und die britannische Sprachgruppe mit den Sprachen Kymrisch, Kumbrisch, Kornisch und Bretonisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
