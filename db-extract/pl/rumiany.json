        "ru-extract.jsonl": [
            {
                "entry_id": "1a3465a3-0318-345e-b0da-dcde1aecfc6b",
                "word": "rumiany",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a82771a-1ecb-329a-a472-9dc4c71c2a45",
                        "entry_id": "1a3465a3-0318-345e-b0da-dcde1aecfc6b",
                        "glosses": [
                            "румяный (цитата из польской Викитеки Lalka (Prus)/Tom I/I)\\nЗвук примера:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7a5f17-ab90-4007-9d35-c13c17ed1277",
                                "sense_id": "4a82771a-1ecb-329a-a472-9dc4c71c2a45",
                                "text": "Jego rumiana twarz, otoczona pękami siwych włosów nad czołem, na brodzie i na policzkach, była w tej chwili podobna do krwawnika oprawionego w srebro.",
                                "translation": "Его румяная физиономия, окаймленная пучками седых волос, в эту минуту напоминала красный халцедон в серебряной оправе."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "nl-extract.jsonl": [],
        "pl-extract.jsonl": [
            {
                "entry_id": "7ef50d5f-874d-3dde-854f-9a3f07361e33",
                "word": "rumiany",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "624dc64a-3d8d-3af5-ba73-1695a308d2c0",
                        "entry_id": "7ef50d5f-874d-3dde-854f-9a3f07361e33",
                        "glosses": [
                            "mający czerwony lub różowy kolor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2353ac-2d2f-4e39-ae9d-2d4128601ea0",
                                "sense_id": "624dc64a-3d8d-3af5-ba73-1695a308d2c0",
                                "text": "Dziewczyna była rumiana i wyraźnie zmieszana."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8911df8a-f187-3189-a3d9-cb6e4f1b97d0",
                        "entry_id": "7ef50d5f-874d-3dde-854f-9a3f07361e33",
                        "glosses": [
                            "o pieczywie wypieczony na brązowy kolor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f944b5-e0dd-4d7e-9e15-cf96515c2a61",
                                "sense_id": "8911df8a-f187-3189-a3d9-cb6e4f1b97d0",
                                "text": "W tej piekarni mają najlepsze pieczywo: zawsze rumiane i chrupiące."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4ec3f3a-e8f7-4de4-9a9f-f857710f6952",
                        "source_entry_id": "7ef50d5f-874d-3dde-854f-9a3f07361e33",
                        "source_sense_id": "624dc64a-3d8d-3af5-ba73-1695a308d2c0",
                        "target_lang_word": "ruddy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bca5f38-c97e-327a-ac78-4f2cc1918b71",
                                        "entry_id": "9a0aa002-0170-364d-b063-1b4522d82ee3",
                                        "glosses": [
                                            "Reddish in color, especially of the face, fire, or sky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a0742c-0f83-489d-b762-6190894d74c2",
                                                "sense_id": "7bca5f38-c97e-327a-ac78-4f2cc1918b71",
                                                "text": "Drystone walls, farm buildings and stone cottages, roofed with ruddy tiles, line the way and blend gently into the surrounding countryside."
                                            },
                                            {
                                                "example_id": "19426c90-88a7-4c1f-8746-e4caeaae58d8",
                                                "sense_id": "7bca5f38-c97e-327a-ac78-4f2cc1918b71",
                                                "text": "Frank, who is narrow and ruddy, and who tended to wear a shirt and tie with a cherry-red beanie pulled low over one ear, swapped his white butcher’s coat for a puffer jacket, and led me outside"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0353b7df-488f-3936-bb4b-27d9031a5e77",
                                        "entry_id": "9a0aa002-0170-364d-b063-1b4522d82ee3",
                                        "glosses": [
                                            "Robust and vigorous, like a person with a red complexion (as compared to a pale one)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fd597c-3688-4dd4-b09c-56eef3f665fa",
                                                "sense_id": "0353b7df-488f-3936-bb4b-27d9031a5e77",
                                                "text": "in ruddy health"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a191ae51-8cd0-36ba-8e82-449ac09f38e3",
                                        "entry_id": "9a0aa002-0170-364d-b063-1b4522d82ee3",
                                        "glosses": [
                                            "A mild intensifier, expressing irritation."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6f8626c-1c77-407a-a51f-2e656f5681f2",
                                                "sense_id": "a191ae51-8cd0-36ba-8e82-449ac09f38e3",
                                                "text": "“Of all the damn silly fatheaded things!” she vociferated, if that's the word. “With a million ruddy names to choose from, these ruddy Creams call one ruddy son Wilbert and the other ruddy son Wilfred, and both these ruddy sons are known as Willie. Just going out of their way to mislead the innocent bystander. You'd think people would have more consideration.”"
                                            },
                                            {
                                                "example_id": "349fc04b-afed-485f-8057-bbfdf228430e",
                                                "sense_id": "a191ae51-8cd0-36ba-8e82-449ac09f38e3",
                                                "text": "Michael, you have been sitting on your butt for the last two hours! Why didn't you mow the ruddy lawn?!!"
                                            },
                                            {
                                                "example_id": "457d8dde-6550-4a47-89fd-c1bace8903cb",
                                                "sense_id": "a191ae51-8cd0-36ba-8e82-449ac09f38e3",
                                                "text": "I shall monitor your behaviour carefully during Marge’s visit. If, at the end of it, you’ve toed the line and kept to the story, I’ll sign your ruddy form."
                                            },
                                            {
                                                "example_id": "5cc985d6-1ea6-4601-9a11-b6459a1c8544",
                                                "sense_id": "a191ae51-8cd0-36ba-8e82-449ac09f38e3",
                                                "text": "If he moved a muscle, they would both be in DEEP TROUBLE.\n“It must have been a bird, Mr Big,” said Dad.\n“Ruddy big bird,” muttered the little man. “Now we have to get out of here before the fuzz start sniffing around. Fingers, get the Rolls resprayed and change the number plates in case they trace it.”\n“Yes, guv’nor.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f693e1a-bd1f-342b-bb8e-8f1cd0a18833",
                                        "entry_id": "f7dcd8f6-8d3f-32f1-bde4-0a25773898c7",
                                        "glosses": [
                                            "A mild intensifier, expressing irritation."
                                        ],
                                        "tags": [
                                            "British",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb37917-d101-4cee-b5c6-1b23a04c24b1",
                                                "sense_id": "6f693e1a-bd1f-342b-bb8e-8f1cd0a18833",
                                                "text": "“So, you made quite a splash on Question Time, my homeless pal,” he continued. “Ruddy hilarious. Ha ha ha!”"
                                            },
                                            {
                                                "example_id": "58392d40-6698-4173-bc6a-e1be8c2a602d",
                                                "sense_id": "6f693e1a-bd1f-342b-bb8e-8f1cd0a18833",
                                                "text": "'You're not ruddy going anywhere,' he said, slamming the door behind him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db006626-b374-3568-a9c7-2f6f0a3155ca",
                                        "entry_id": "05d2d85b-52e5-3fbf-8378-adb84d20cece",
                                        "glosses": [
                                            "A ruddy duck."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac75710-c571-4316-8aac-c35f414fbc89",
                                                "sense_id": "db006626-b374-3568-a9c7-2f6f0a3155ca",
                                                "text": "In winter, snow geese land at West Pond, a Robert Moses legacy that ought to be called Duck Soup: at this time of year look for ruddies, greater scaups, Northern pintails, American widgeons and gadwalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "197892e6-19ec-3b58-b430-8280685b2af4",
                                        "entry_id": "05d2d85b-52e5-3fbf-8378-adb84d20cece",
                                        "glosses": [
                                            "A ruddy ground dove."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e936ef4c-aab3-4169-912d-b53caede70d2",
                                                "sense_id": "197892e6-19ec-3b58-b430-8280685b2af4",
                                                "text": "Ground doves — two ruddies are shown here — are so called because they feed on the ground."
                                            },
                                            {
                                                "example_id": "c867b72b-3d55-4896-bee7-c07f65aaaf42",
                                                "sense_id": "197892e6-19ec-3b58-b430-8280685b2af4",
                                                "text": "Understandably, birders in the U.S. are advised to carefully distinguish Ruddies from the usually more-expected Common Ground-Doves [...]. (Brightly-colored, pinkish adult male Common Ground-Doves have been misidentified as male Ruddies on several occasions, however.) Unless the fortunate birder happens upon a Ruddy Ground-Dove amongst a flock of sparrows, it will often be necessary to sort through innumerable Inca Doves."
                                            },
                                            {
                                                "example_id": "5c44e6ce-06c2-46f4-96f0-301e7ff2a33a",
                                                "sense_id": "197892e6-19ec-3b58-b430-8280685b2af4",
                                                "text": "Common Ground-Dove — Fairly common permanent resident of better-watered valleys at lower elevations. Avoids town [...] Ironically, Ruddies often ignore the little flocks of closely related Commons, and choose to associate with Inca Doves."
                                            },
                                            {
                                                "example_id": "caa69cf2-a88b-4c04-9b0b-d09394a69c5e",
                                                "sense_id": "197892e6-19ec-3b58-b430-8280685b2af4",
                                                "text": "Out-of-state birders seeking Ruddy Ground Doves should be aware of two things. Ruddies associate much more frequently with Inca Doves than with Common Ground Doves. In fact, in eleven personal sightings of this species in Arizona, I have never seen a Ruddy with a Common nor has anyone else I know. [...] Perhaps this is a slow invasion, and forty years hence Ruddies will be so common ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "444c6edd-8492-3e10-9e07-808ba0d6a4d5",
                                        "entry_id": "7fcce5d4-5dcc-3078-9e15-c8f454571686",
                                        "glosses": [
                                            "To make reddish in colour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aad1f61-7efb-4dd6-a4ff-5fbd9d6e1896",
                                                "sense_id": "444c6edd-8492-3e10-9e07-808ba0d6a4d5",
                                                "text": "The sunset ruddied our faces."
                                            },
                                            {
                                                "example_id": "1b964d00-349f-4435-b1b3-88b876093fa6",
                                                "sense_id": "444c6edd-8492-3e10-9e07-808ba0d6a4d5",
                                                "text": "It ruddied all the copse-wood glen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a16e33c-2ae2-4ce3-a59b-576b7f38e07f",
                        "source_entry_id": "7ef50d5f-874d-3dde-854f-9a3f07361e33",
                        "source_sense_id": "624dc64a-3d8d-3af5-ba73-1695a308d2c0",
                        "target_lang_word": "rotwangig",
