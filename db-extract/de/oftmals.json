                                    {
                                        "sense_id": "ae12b04e-ede5-30d1-be34-c142e4a61c70",
                                        "entry_id": "436b69ac-6651-338b-8512-1a7aa4525fb1",
                                        "glosses": [
                                            "Fréquent. (Seulement au féminin pluriel dans l'expression, souventes fois)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0e9be1-49a5-4ef4-9958-86dbef82d447",
                                                "sense_id": "ae12b04e-ede5-30d1-be34-c142e4a61c70",
                                                "text": "Enjeu de batailles transnationales dans les domaines de la neurologie, de la psychiatrie, de la psychanalyse et différentes approches thérapeutiques, touchant tous les ressorts de la vie physique, psychique et sociale, l'autisme a souventes fois été un sujet de fiction.."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "souvent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd64f8e1-8306-3327-93c6-0c01a707077e",
                                        "entry_id": "c05f1b06-a3b1-3bf5-a2d1-aad6b70c175d",
                                        "glosses": [
                                            "Un grand nombre de fois, avec fréquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5561f7-44d2-46b1-9563-dfb3912901cc",
                                                "sense_id": "bd64f8e1-8306-3327-93c6-0c01a707077e",
                                                "text": "Quelquefois, lorsque j’arrive, je préviens qu’on envoie une voiture me chercher à la gare ; souvent je ne préviens pas."
                                            },
                                            {
                                                "example_id": "cd81d4a1-abd1-402e-abbe-7c96c83916f9",
                                                "sense_id": "bd64f8e1-8306-3327-93c6-0c01a707077e",
                                                "text": "Les pays en développement n’en produisant guère, en tous cas pas en suffisance, les produits pharmaceutiques doivent le plus souvent être importés."
                                            },
                                            {
                                                "example_id": "9a98a39c-8c08-4bf7-8d3c-8c036e9ee91f",
                                                "sense_id": "bd64f8e1-8306-3327-93c6-0c01a707077e",
                                                "text": "Il y alla tant et si souvent que…. — On se trompe souvent en jugeant sur les apparences."
                                            },
                                            {
                                                "example_id": "3fda718b-7580-4593-aa51-3fc6aa2a8e21",
                                                "sense_id": "bd64f8e1-8306-3327-93c6-0c01a707077e",
                                                "text": "Le plus souvent, la plupart du temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
