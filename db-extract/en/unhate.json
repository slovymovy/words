                        "glosses": [
                            "To leave off, cease, or desist from hating."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "98320680-cff4-4277-9b4c-939496dda51b",
                                "sense_id": "eefb094e-cdf5-3224-9bdc-3ffec9b55c76",
                                "text": "I hate you! And I'll never unhate you or nothing!"
                            },
                            {
                                "example_id": "441e3aef-28c2-4454-96a7-bfcaf52d84b7",
                                "sense_id": "eefb094e-cdf5-3224-9bdc-3ffec9b55c76",
                                "text": "Till when, All that was, is; and must forever be. Nor is it in me to unhate my hates, — [...]"
                            },
                            {
                                "example_id": "2230a393-b7a6-4036-ba3d-d8ca7c4c0cad",
                                "sense_id": "eefb094e-cdf5-3224-9bdc-3ffec9b55c76",
                                "text": "I learned how to unhate Bush the only way people ever really learn things—by doing."
                            }
                        ]
                    }
                ],
