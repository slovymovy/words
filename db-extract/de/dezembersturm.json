                ],
                "senses": [
                    {
                        "sense_id": "73ad3c64-bcfd-3b20-aec1-6b3926ecd1a6",
                        "entry_id": "0c28ac71-88c8-3a84-9b84-27689f5cd20d",
                        "glosses": [
                            "im Monat Dezember wehender, kräftiger Wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dee6528-abac-4a48-9ed2-608042e40045",
                                "sense_id": "73ad3c64-bcfd-3b20-aec1-6b3926ecd1a6",
                                "text": "„Dezemberstürme fegen die Straßen der Stadt, jagen wohlverschaalte Wanderer vor sich her und treiben ihr Spiel mit städtischen Wetterfahnen.“"
                            },
                            {
                                "example_id": "5e8b441d-ab59-492b-a590-a914465d6bb8",
                                "sense_id": "73ad3c64-bcfd-3b20-aec1-6b3926ecd1a6",
                                "text": "„Durch Kopenhagen heult Dezembersturm, und die Menschen haben sich fröstelnd in ihre Häuser zurückgezogen.“"
                            },
                            {
                                "example_id": "3fd89187-487f-4036-a3da-c3d46fd96ee2",
                                "sense_id": "73ad3c64-bcfd-3b20-aec1-6b3926ecd1a6",
                                "text": "„Draußen warf ein kräftiger Dezembersturm prasselnd Regentropfen gegen die Scheibe und übertönte für kurze Zeit die leise klassische Musik, die aus den unsichtbaren Lautsprechern drang.“"
                            },
                            {
                                "example_id": "0db43fc1-bbd8-4021-8ce0-fc1045f589a2",
                                "sense_id": "73ad3c64-bcfd-3b20-aec1-6b3926ecd1a6",
                                "text": "„Der Dezembersturm heulte im Schornstein, während auf dem Kamin, unter der Rebenranke des Bacchus, eine Schar nackter Kinder im rosigen Widerschein der Flamme mit den heiligsten Marterwerkzeugen Christi spielte und tanzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
