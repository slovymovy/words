                    {
                        "translation_id": "1d73b8dc-c3bf-4282-9861-104cb688d87f",
                        "source_entry_id": "555507bb-b5e2-351b-ae17-6a1de682fe86",
                        "source_sense_id": "2e0f22db-31fb-336e-953d-02852f3dd52b",
                        "target_lang_word": "Tigerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tigerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "577b55bc-068a-3f5b-a720-9325062b7319",
                                        "entry_id": "e9077549-927a-3816-ae4c-e814afea6ab5",
                                        "glosses": [
                                            "weiblicher Tiger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e37baa1-10c5-43bd-9bc6-74bb8c53044b",
                                                "sense_id": "577b55bc-068a-3f5b-a720-9325062b7319",
                                                "text": "„In Indien ist eine Tigerin, die zuvor vier Menschen getötet und gefressen haben soll, bei einem Unfall getötet worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a45bdf9-e2b1-404e-ba9b-c0ed58cd21c0",
                        "source_entry_id": "555507bb-b5e2-351b-ae17-6a1de682fe86",
                        "source_sense_id": "2e0f22db-31fb-336e-953d-02852f3dd52b",
                        "target_lang_word": "тигрица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тигрица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d13ae972-408c-3c7f-9511-cf6f12cf416f",
                                        "entry_id": "bc08c7eb-4714-31bc-aabe-4aeea205a89d",
                                        "glosses": [
                                            "самка тигра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300ccbe2-2d27-4298-8c9c-f98770b8147d",
                                                "sense_id": "d13ae972-408c-3c7f-9511-cf6f12cf416f",
                                                "text": "Тигрица выводит молодых в апреле или в мае и помещает их, как говорят, в глухих местах на солнцепеках, т. е. южных покатостях гор, для того чтобы весеннее солнце могло согревать её детенышей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cffd05e1-2a78-3901-9097-0e36cf2b06c1",
                                        "entry_id": "bc08c7eb-4714-31bc-aabe-4aeea205a89d",
                                        "glosses": [
                                            "перен., разг. о женщине, напоминающей повадками, чертами характера самку тигра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d5d0f7-6e29-48f1-900b-c8003d3cdc16",
                                                "sense_id": "cffd05e1-2a78-3901-9097-0e36cf2b06c1",
                                                "text": "Сандра с ее балетной гибкостью и свободной манерой держаться походила на голливудских «тигриц», ибо, по убеждению многих, в Голливуде девушек специально учат сексуальной привлекательности на погибель мужской половине человеческого рода."
                                            },
                                            {
                                                "example_id": "67bc60fd-d6ed-4db7-993e-a376d6f5fab1",
                                                "sense_id": "cffd05e1-2a78-3901-9097-0e36cf2b06c1",
                                                "text": "― Шантажистка, ― мрачно обронил отец, обреченно понимая, что никуда он не денется и придется ему как миленькому делать всё, что прикажет мать. Эта тигрица кому хочешь горло перегрызет за своего ублюдка."
                                            },
                                            {
                                                "example_id": "d103d555-5548-4b89-a326-6cbf363c1c31",
                                                "sense_id": "cffd05e1-2a78-3901-9097-0e36cf2b06c1",
                                                "text": "Нет, перед ним ― тигрица, великая возлюбленная, разочаровавшаяся в муже и, увы, в любовнике, оказавшемся всего-навсего карьеристом, который просто-напросто использовал её."
