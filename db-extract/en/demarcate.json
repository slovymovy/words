                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b847e17c-429e-4bac-a221-07a01dfeb044",
                        "source_entry_id": "eaf79de9-e4b9-3944-bdf5-24d48fe42421",
                        "source_sense_description": "mark the limits or boundaries of something",
                        "target_lang_word": "abgrenzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abgrenzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6e5385-3e8c-3164-8d01-1a4b041487be",
                                        "entry_id": "3043e8c7-bc47-30a2-9f5c-12f097f7f6f2",
                                        "glosses": [
                                            "einen Teil von einem anderen Teil abtrennen (auch übertragen)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4108d3c-8641-4862-bec7-fae84b8a3dc4",
                                                "sense_id": "fb6e5385-3e8c-3164-8d01-1a4b041487be",
                                                "text": "Der Schneeballstrauch liebt viel Feuchtigkeit, er wächst daher besonders an solchen Waldrändern, die feuchte Wiesen oder Gewässer abgrenzen."
                                            },
                                            {
                                                "example_id": "7125b946-38d1-4aaf-8ce7-28f3b5940e34",
                                                "sense_id": "fb6e5385-3e8c-3164-8d01-1a4b041487be",
                                                "text": "Indessen waren wir ihnen bedeutend näher gerückt und sahen nun bald auch zu unserer Rechten den grünen Boden vom gelben Sand sich scharf abgrenzen und dichte Wälder von Palmen erscheinen."
                                            },
                                            {
                                                "example_id": "a61bc6d7-e29e-4bae-92e4-96f150eb9664",
                                                "sense_id": "fb6e5385-3e8c-3164-8d01-1a4b041487be",
                                                "text": "Kinder mögen es, wenn sie ihre Beete schmücken können – zum Beispiel mit kleinen Windmühlen. Auch mit bemalten Steinen lassen sich einzelne Teile des Beets voneinander abgrenzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71ab4701-af6a-3dbd-9cb9-de4736d2512b",
                                        "entry_id": "3043e8c7-bc47-30a2-9f5c-12f097f7f6f2",
                                        "glosses": [
                                            "die Unterschiede von Dingen herausarbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db6ecce-125e-4d1b-ac80-81eb9cf12e57",
                                                "sense_id": "71ab4701-af6a-3dbd-9cb9-de4736d2512b",
                                                "text": "„Diese Dinge lassen sich also auf diese Weise voneinander abgrenzen.“"
                                            },
                                            {
                                                "example_id": "1edb7a36-ba0a-4604-a25d-7278368bf907",
                                                "sense_id": "71ab4701-af6a-3dbd-9cb9-de4736d2512b",
                                                "text": "„Verstehen, so weit es einem jeden möglich ist – d. h. eine Sache so bestimmt als möglich sich auf uns abgrenzen lassen, so daß unsere Form an der Grenze bestimmt und wir uns ganz genau bewußt werden, wie angenehm oder unangenehm uns bei dieser Bestimmung zu Muthe wird.“"
                                            },
                                            {
                                                "example_id": "d5032784-152d-4301-bed1-d9a487a87a91",
                                                "sense_id": "71ab4701-af6a-3dbd-9cb9-de4736d2512b",
                                                "text": "„Mit Sven Unterwaldt jr. ist es wie mit Sammy Davis jr.: Der \"Junior\" ist Überbleibsel der Zeit, als er sich vom namensgleichen Vater abgrenzen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4e842621-4ff6-3b07-8ae0-cdf3dc2e6cd3",
                                        "entry_id": "3043e8c7-bc47-30a2-9f5c-12f097f7f6f2",
                                        "glosses": [
                                            "sich von anderen Personen unterscheiden, sich von anderen Personen und Dingen distanzieren"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a3eb7f-7560-4f5a-9fa6-d5f2edef0982",
                                                "sense_id": "4e842621-4ff6-3b07-8ae0-cdf3dc2e6cd3",
                                                "text": "„Denn der rät meiner Freundin in regelmäßigen Abständen: \"Sie müssen sich besser abgrenzen\". Abgrenzen also. Früher hätte man dazu noch Egoismus gesagt.“"
                                            },
                                            {
                                                "example_id": "4e755bf4-fe7b-44cb-9f5e-4364ff1b570a",
                                                "sense_id": "4e842621-4ff6-3b07-8ae0-cdf3dc2e6cd3",
                                                "text": "„Einerseits wollen Jugendliche sich abgrenzen und ihre Identität nicht festlegen lassen, anderseits entsteht gerade durch Abgrenzung natürlich eine Festlegung auf eine Identität, etwa als Fan von Musikstilen oder -interpreten.“"
                                            },
                                            {
                                                "example_id": "34666a59-df6b-4209-be07-4dbeea115ae3",
                                                "sense_id": "4e842621-4ff6-3b07-8ae0-cdf3dc2e6cd3",
                                                "text": "„Jede Frau sollte sich überlegen, ob sie sich davon bewusst abgrenzen wolle, wenn sie sich verschleiere oder ein Kopftuch trage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
