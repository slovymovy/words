    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "09a07c10-8821-3590-a440-6ae02b8d410d",
                "word": "УГ",
                "pos": "abbrev",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4fd77302-cf01-34f8-a154-6eb7129497d3",
                        "entry_id": "09a07c10-8821-3590-a440-6ae02b8d410d",
                        "glosses": [
                            "интернет., груб., сокр. от унылое говно; о чём-либо скучном и бездарном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3f1a90-c182-4d6c-90ba-ff717add436f",
                                "sense_id": "4fd77302-cf01-34f8-a154-6eb7129497d3",
                                "text": "Я не знаю, что разработчики курили, когда делали 15 уровень… Куча багов с физикой! Это УГ. Записать прохождение офигеть сложно-невозможно."
                            },
                            {
                                "example_id": "a5e8a9bf-3277-4069-ba00-59ad7f3673e5",
                                "sense_id": "4fd77302-cf01-34f8-a154-6eb7129497d3",
                                "text": "Так да, ходить и ныть, показывая всем, что ты УГ ― это уже не готика ) изначально готы ― это олдскул панки )"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5323f1df-8baf-4cb0-ab28-04900e835737",
                        "source_entry_id": "09a07c10-8821-3590-a440-6ae02b8d410d",
                        "source_sense_id": "4fd77302-cf01-34f8-a154-6eb7129497d3",
                        "target_lang_word": "sad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2999b14d-8adc-3eb9-a2bc-a681e545f510",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Emotionally negative.",
                                            "Feeling sorrow; sorrowful, mournful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd184468-74b7-4406-b40d-1368006a58a8",
                                                "sense_id": "2999b14d-8adc-3eb9-a2bc-a681e545f510",
                                                "text": "She gets sad when he's away."
                                            },
                                            {
                                                "example_id": "5b4b2752-9819-43b9-a769-777e2dc095f1",
                                                "sense_id": "2999b14d-8adc-3eb9-a2bc-a681e545f510",
                                                "text": "Firſt were we ſad, fearing you would not come, / Now ſadder that you come ſo vnprouided:[…]"
                                            },
                                            {
                                                "example_id": "828c5aff-bac4-4eac-affc-4d878f678144",
                                                "sense_id": "2999b14d-8adc-3eb9-a2bc-a681e545f510",
                                                "text": "[…]Th’ Angelic Guards aſcended, mute and ſad[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ed76c9-859d-33ee-8be9-a42c1c08a0fc",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Emotionally negative.",
                                            "Appearing sorrowful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15d4b83-2fe0-4b86-a98b-3f6597703972",
                                                "sense_id": "76ed76c9-859d-33ee-8be9-a42c1c08a0fc",
                                                "text": "The puppy had a sad little face."
                                            },
                                            {
                                                "example_id": "a829ec73-9af8-4d58-8fa0-7db076e719b5",
                                                "sense_id": "76ed76c9-859d-33ee-8be9-a42c1c08a0fc",
                                                "text": "We need a sad man. Give us a sad man.” Tomo gave the look of a sad man, then followed with the body of a sad man. “That's it, more of that. can you manufacture a mole right here? Yes, a very ugly mole. Right here, on the chin.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac7b0f9-1e96-3e1c-bfa8-280634010c99",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Emotionally negative.",
                                            "Causing sorrow; lamentable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bcc2c10-347b-44f2-b780-68312e735b0e",
                                                "sense_id": "7ac7b0f9-1e96-3e1c-bfa8-280634010c99",
                                                "text": "It's a sad fact that most rapes go unreported."
                                            },
                                            {
                                                "example_id": "f90ed703-ad9b-4039-a8ea-b808b1d39c29",
                                                "sense_id": "7ac7b0f9-1e96-3e1c-bfa8-280634010c99",
                                                "text": "The Great Gaels of Ireland are the men that God made mad, / For all their wars are merry and all their songs are sad."
                                            },
                                            {
                                                "example_id": "90fa20de-122e-491c-95b1-c46fa592b4e2",
                                                "sense_id": "7ac7b0f9-1e96-3e1c-bfa8-280634010c99",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055e3eb3-d856-323e-9ec9-8872377a361c",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Emotionally negative.",
                                            "Poor in quality, bad; shameful, deplorable; later, regrettable, poor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f95bc96f-a8e8-49dc-8316-a18373bcf244",
                                                "sense_id": "055e3eb3-d856-323e-9ec9-8872377a361c",
                                                "text": "That's the saddest-looking pickup truck I've ever seen."
                                            },
                                            {
                                                "example_id": "38454765-ef82-463e-a9aa-c874d861b8de",
                                                "sense_id": "055e3eb3-d856-323e-9ec9-8872377a361c",
                                                "text": "Heaven knows what cash he got, or blood he spilt, / A sad old fellow was he, if you please[…]."
                                            },
                                            {
                                                "example_id": "786b46bb-f068-4e8e-8ba3-102f40e0cdfc",
                                                "sense_id": "055e3eb3-d856-323e-9ec9-8872377a361c",
                                                "text": "Musk is betting that lonely users will trade their cash (and last shreds of their connection to human life) for a bot that is explicitly designed to flirt with sad men, as the saddest man on Earth spearheaded it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a59591-175a-3381-8f51-d61a019ceebc",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Emotionally negative.",
                                            "Of colours: dark, deep; later, sombre, dull."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f248a58-034d-4fce-8a54-57fe3067f5e5",
                                                "sense_id": "52a59591-175a-3381-8f51-d61a019ceebc",
                                                "text": "[…]this is either uſed crude, and called ſulphur vive, and is of a ſadder colour; or after depuration, ſuch as we have in magdeleons or rols of a lighter yellow."
                                            },
                                            {
                                                "example_id": "d8d6f51a-02dd-4372-bada-b2dea3fd4d63",
                                                "sense_id": "52a59591-175a-3381-8f51-d61a019ceebc",
                                                "text": "sad-coloured clothes"
                                            },
                                            {
                                                "example_id": "0b2e50f6-acff-4bd7-913c-44970df4d590",
                                                "sense_id": "52a59591-175a-3381-8f51-d61a019ceebc",
                                                "text": "Woad, or wade, is used by the dyers to lay the foundation of many colours, especially all sad colours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ee5256-ff23-3607-ab27-05f2e77a3de7",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Sated, having had one's fill; satisfied, weary."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bab7c9b6-4fab-32ad-bdaf-18af386d7092",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Steadfast, valiant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbcb5fa3-696d-4f90-af14-2a7b4bef3514",
                                                "sense_id": "bab7c9b6-4fab-32ad-bdaf-18af386d7092",
                                                "text": "The fearefull newes that whilſt the flame doth but begin,\nSad pollicie may ſerue to quench the fire: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563ea6f6-b23e-3025-bd6b-efc08feeb96c",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Dignified, serious, grave."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c7d91f-ced7-4d91-880a-820f52bf18e1",
                                                "sense_id": "563ea6f6-b23e-3025-bd6b-efc08feeb96c",
                                                "text": "Therfore it nedeth that better prouysion.\nWere founde for youthe by sad and wyse counsayle"
                                            },
                                            {
                                                "example_id": "5f64cfa7-ea7a-4088-b949-de1a1ec10404",
                                                "sense_id": "563ea6f6-b23e-3025-bd6b-efc08feeb96c",
                                                "text": "Vproſe Sir Guyon, in bright armour clad, / And to his purpoſd iourney him prepar'd: / With him the Palmer eke in habit ſad, / Him ſelfe addreſt to that aduenture hard: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9f029d-eac9-372b-a081-5c924a1198dd",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Naughty; troublesome; wicked."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aa310c6-dee5-4cf9-9076-b3d02449ca63",
                                                "sense_id": "0d9f029d-eac9-372b-a081-5c924a1198dd",
                                                "text": "Mr. Santon laughed, and merely said,—\"Oh, you cruel beauty!\" returning to his paper again; but, seated in the bay-window was one, who could not thus lightly look upon the conduct of the coquettish Winnie, for it was evident she was a sad coquette."
                                            },
                                            {
                                                "example_id": "ccd73fac-2fc9-4f34-8691-87695eab6432",
                                                "sense_id": "0d9f029d-eac9-372b-a081-5c924a1198dd",
                                                "text": "In ſuch places, it would not be doubted, that a grim Daniel Scroggins, and an aproned Sam Smith, might be found—ſad tipſy fellows, both of them, to whoſe ingenuity this or that mechanical improvement had been due."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d1b248e-78bc-3f3c-b3ee-789696ac0e26",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Unfashionable; socially inadequate or undesirable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "193d09b8-def5-4893-9601-c9e695441ea0",
                                                "sense_id": "4d1b248e-78bc-3f3c-b3ee-789696ac0e26",
                                                "text": "I can't believe you use drugs; you're so sad!"
                                            },
                                            {
                                                "example_id": "09700caf-5be2-4e9f-8330-30b85a39ec89",
                                                "sense_id": "4d1b248e-78bc-3f3c-b3ee-789696ac0e26",
                                                "text": "You’d have to be really sad to wear a shirt like that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a78d835-f9a8-32ba-96b2-67e8db6464ed",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Soggy (to refer to pastries)."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4437fe6-7ded-3a0d-abc1-5edb316fff2f",
                                        "entry_id": "f147bae8-6394-3466-a7bd-8a442504cc3b",
                                        "glosses": [
                                            "Heavy; weighty; ponderous; close; hard."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47849783-5291-4b32-8ea7-c5bb1c261328",
                                                "sense_id": "a4437fe6-7ded-3a0d-abc1-5edb316fff2f",
                                                "text": "sad bread"
                                            },
                                            {
                                                "example_id": "c9487056-fd58-4774-8670-ef72b09f2e0c",
                                                "sense_id": "a4437fe6-7ded-3a0d-abc1-5edb316fff2f",
                                                "text": "[…]his hand, more ſad then lomp of lead,[…]"
                                            },
                                            {
                                                "example_id": "409bc4f8-2fb2-4264-9f46-1e75eb6ba55b",
                                                "sense_id": "a4437fe6-7ded-3a0d-abc1-5edb316fff2f",
                                                "text": "Chalky lands are naturally cold and sad."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6698f708-5624-3af8-898a-94172816f7d9",
                                        "entry_id": "5038c898-b579-323d-a9e4-8985f318784c",
                                        "glosses": [
                                            "To make melancholy; to sadden or grieve (someone)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc21c7fd-5a93-4213-ade0-756fd71a2c49",
                                                "sense_id": "6698f708-5624-3af8-898a-94172816f7d9",
                                                "text": "16??, John Webster, Appius and Virginia\nMy father's wondrous pensive, and withal / With a suppress'd rage left his house displeas'd, / And so in post is hurried to the camp: / It sads me much; to expel which melancholy, / I have sent for company."
                                            }
                                        ]
