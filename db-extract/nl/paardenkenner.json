                        ],
                        "examples": [
                            {
                                "example_id": "ce742e66-be7b-4709-a8ff-e715fac6f291",
                                "sense_id": "4bc9c3cc-607c-396f-9d7d-2e4e238df25e",
                                "text": "De landeigenaar waar Nikolaj naar toe ging was een oude vrijgezelle cavalerist, een paardenkenner, jager, bezitter van een tapijtweverij, van honderd jaar oude likeur, van oude Hongaarse wijn en van wondermooie paarden."
                            },
                            {
                                "example_id": "cbceb96d-4f19-47f8-b5a8-52bb01b3119e",
                                "sense_id": "4bc9c3cc-607c-396f-9d7d-2e4e238df25e",
                                "text": ",,Mocht er geen speenmoeder gevonden worden, wat voor het veulentjes zelf wel het beste zou zijn, dan laat ik het veulen bij haar. Ze is er nu al gek op. Ze kan het veulen dan in ieder geval paardengedrag aanleren. Maar beter zou zijn, als het veulen wordt opgevoed door een merrie die haar ook kan zogen,” aldus paardenkenner Simmelink."
                            }
                        ]
                    }
