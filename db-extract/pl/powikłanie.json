                        "entry_id": "7885f19c-1c9a-3d50-aedb-f36ebdd70424",
                        "glosses": [
                            "schorzenie stanowiące następstwo jakiejś innej choroby, operacji lub sytuacji wymagającej interwencji medycznej"
                        ],
