                "senses": [
                    {
                        "sense_id": "2291dd8d-b307-317c-b50a-87146402d53b",
                        "entry_id": "d9ff8c42-5960-31ee-b161-e579833174d9",
                        "glosses": [
                            "Qui écriture ; qui tient de l’écrit bureaucratique."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "83a221fa-45c8-4550-8e3e-51de8f59007b",
                                "sense_id": "2291dd8d-b307-317c-b50a-87146402d53b",
                                "text": "La basse robe qui avocasse ou grifonne dans ces tribunaux est immense, plus rapace que tous nos Normands et plus écriturière que n’étoient feu nos procureurs au parlement qui faisoient des ventres aux requêtes."
                            },
                            {
                                "example_id": "44870347-0668-454d-ad5f-d7b854dcc97d",
                                "sense_id": "2291dd8d-b307-317c-b50a-87146402d53b",
                                "text": "Dans cette nouvelle salle […] se rectifiera cet épouvantable amas de lois écriturières, qui sont tous les péchés politiques, et qui ne se concilieront jamais avec cette liberté que j’idolâtre et que je conçois."
                            }
                        ]
                    }
                ],
