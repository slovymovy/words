                        "target_lang_word": "Pfropfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e4c92152-a12d-4b78-ae7d-023a115e06b7",
                        "source_entry_id": "5b7372a6-8ad4-3ad1-b418-fbc5727cab8c",
                        "source_sense_description": "act, art, or process of inserting grafts",
                        "target_lang_word": "Pfropfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfropfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "026e42d2-1649-3777-bc6c-ca8dba1fb468",
                                        "entry_id": "b3249c21-8612-33ab-ba43-3e1349181fa0",
                                        "glosses": [
                                            "kleiner Gegenstand, der in den Flaschenhals eingeführt werden kann, um die Flasche zu verschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eef1176-fe49-4652-974b-a760f5b5b6a0",
                                                "sense_id": "026e42d2-1649-3777-bc6c-ca8dba1fb468",
                                                "text": "„Endlich war der höchsten und köstlichsten Stufe das Wort Champagner eingeräumt; er stieß es so überzeugend hervor, daß man den Knall des Pfropfens zu hören glaubte, und schleuderte dabei den Arm wie eine Rakete in die Luft.“"
                                            },
                                            {
                                                "example_id": "a5e1a46d-a97f-42c9-95c7-20554860db1e",
                                                "sense_id": "026e42d2-1649-3777-bc6c-ca8dba1fb468",
                                                "text": "„Aber die Glaspfropfen von den Essig- und Ölflaschen fehlen, und der gute Diener hat sie durch Pfropfen aus Zeitungspapier ersetzt.“"
                                            },
                                            {
                                                "example_id": "2b61dfeb-771b-4d0a-8c5a-1857469de013",
                                                "sense_id": "026e42d2-1649-3777-bc6c-ca8dba1fb468",
                                                "text": "„Der Pfropfen knallte wie ein Schuß; der Portier hatte die Flasche zu freudig geschüttelt.“"
                                            },
                                            {
                                                "example_id": "d82fd96f-8b6b-4081-aee8-61d4f234022a",
                                                "sense_id": "026e42d2-1649-3777-bc6c-ca8dba1fb468",
                                                "text": "„Fast im selben Moment wurde der Champagner entkorkt, und das Knallen der Pfropfen verdoppelte die Lustigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9657223-762a-3ca9-be4a-d53254a2c726",
                                        "entry_id": "b3249c21-8612-33ab-ba43-3e1349181fa0",
                                        "glosses": [
                                            "Verschluss einer Ader, Rohrleitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed068db-14a6-4bec-b11e-7e281f3c3968",
                                                "sense_id": "b9657223-762a-3ca9-be4a-d53254a2c726",
                                                "text": "Das Rohr wurde vorsorglich mit einem Pfropfen abgedichtet."
                                            },
                                            {
                                                "example_id": "4cef4740-39f6-4f04-8c9d-639775a01a30",
                                                "sense_id": "b9657223-762a-3ca9-be4a-d53254a2c726",
                                                "text": "„Sie steckte den Pfropfen in den Abfluss und ließ Wasser ein, doch es floss ab. Sie raffte ihre Ärmel, drückte den Pfropfen noch tiefer ins Becken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
