        "fr-extract.jsonl": [
            {
                "entry_id": "7c107399-39bb-39be-b04c-54602022ec27",
                "word": "dissensus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3aee1e5e-6db3-3106-8f33-11079da92f3f",
                        "entry_id": "7c107399-39bb-39be-b04c-54602022ec27",
                        "glosses": [
                            "Absence de consensus constatée à l’issue d’une négociation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40e14593-dac4-4ce7-a458-b76a9c7f679a",
                                "sense_id": "3aee1e5e-6db3-3106-8f33-11079da92f3f",
                                "text": "J’ai de toute façon toujours été, s’agissant d’Israël, bien plus sensible à ce que les Israéliens ont en commun qu’à ce qui les divise, au consensus plus qu’au dissensus."
                            },
                            {
                                "example_id": "f768b2e5-815b-42b8-be33-b512310187be",
                                "sense_id": "3aee1e5e-6db3-3106-8f33-11079da92f3f",
                                "text": "Le dissensus est la condition de toute reconnaissance sociale."
                            },
                            {
                                "example_id": "7865f2a0-1be9-467c-a59f-fbb865a7c0b4",
                                "sense_id": "3aee1e5e-6db3-3106-8f33-11079da92f3f",
                                "text": "Face au dissensus parental, la tentation peut être grande de recourir à l’entremise du juge."
                            },
                            {
                                "example_id": "0a2b0d34-9268-4f18-8acd-626e0b6115d9",
                                "sense_id": "3aee1e5e-6db3-3106-8f33-11079da92f3f",
                                "text": "Dans un débat, les idées différentes sont du non-soi pour les uns et les autres ; le dissensus derrière le consensus mou, c’est la maladie ; et la recherche de consensus dur fait les globules blancs qui immunisent."
                            }
                        ]
                    }
