                        "mesure de protection",
                        "demande de protection"
                    ]
                },
                {
                    "sense_id": "3508e568-65bf-3a74-96ea-32ebe78bbd4e",
                    "sense_definition": "Préservation ou défense organisée d'un domaine d'intérêt général, des droits ou de ressources.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>protection</w> de l'environnement est une priorité absolue pour les générations futures."
                        },
                        {
                            "text": "Cette directive européenne garantit une stricte <w>protection</w> des données privées des citoyens."
