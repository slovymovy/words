                        "sense_id": "9fc338a8-50a0-376a-86e7-a1e2146e3a7c",
                        "entry_id": "bfbf3978-8a95-3e06-8c4b-8c1212593101",
                        "glosses": [
                            "Type de champignon eucaryote microscopique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31b392b8-61ed-4b26-b0c5-b2db2f3bdf64",
                                "sense_id": "9fc338a8-50a0-376a-86e7-a1e2146e3a7c",
                                "text": "La capacité des micromycètes à s’adapter à l’environnement interne de l’hôte les aide à s’établir et à provoquer une infection."
                            },
                            {
                                "example_id": "451326d4-ed50-4da0-bf83-74e4a8a7d0f1",
                                "sense_id": "9fc338a8-50a0-376a-86e7-a1e2146e3a7c",
                                "text": "Les petits champignons ou micromycètes, sont source de principes actifs qui ont permis à travers les siècles de guérir de nombreuses populations. Leur découverte souvent fortuite, aboutit de nos jours à la création de médicaments importants vendus en pharmacie"
                            }
                        ]
                    }
