                "forms": [],
                "senses": [
                    {
                        "sense_id": "d1c295b8-8fe2-3987-8c37-06895209af9d",
                        "entry_id": "7874132a-b84f-31eb-8a36-1f830a00a263",
                        "glosses": [
                            "Polychlorierte Biphenyle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ec98a9-58c2-4d9a-81fd-2b0e07080303",
                                "sense_id": "d1c295b8-8fe2-3987-8c37-06895209af9d",
                                "text": "Verbotene Chemikalien gefährden das Überleben von Europas Meeressäugern: Polychlorierte Biphenyle, kurz PCB."
                            },
                            {
                                "example_id": "9ac2854f-43e2-4c3a-9284-6814e85b1e7a",
                                "sense_id": "d1c295b8-8fe2-3987-8c37-06895209af9d",
                                "text": "In Bonn, Gelsenkirchen und Münster wurde der krebserregende und weltweit verbotene Weichmacher PCB in der Raumluft nachgewiesen."
                            },
                            {
                                "example_id": "2c677f46-53fc-4133-a598-be93e87c1c83",
                                "sense_id": "d1c295b8-8fe2-3987-8c37-06895209af9d",
                                "text": "In den Fluss und damit in die Fische gelangten PCB vor allem deshalb, weil Industriebetriebe und Müllentsorgungsunternehmen in der Vergangenheit unachtsam oder kriminell mit PCB-haltigen Hydraulikölen, Lacken oder Kühlflüssigkeiten umgingen."
                            },
                            {
                                "example_id": "e566e7ee-74d3-4586-9968-86f83779d84b",
                                "sense_id": "d1c295b8-8fe2-3987-8c37-06895209af9d",
                                "text": "„Das Fleisch der Wale ist hoch mit giftigem Quecksilber, krebserregendem PCB (polychlorierte Biphenyle) und Pestiziden belastet – so stark, dass die Gesundheitsbehörde der Färöer 2008 die Empfehlung aussprach, kein Walfleisch und keinen Walspeck mehr zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
