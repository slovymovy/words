                        "entry_id": "53091730-ab5a-3ba6-a2b9-2ac6ea5bb8f9",
                        "glosses": [
                            "iemand die een patiënt behandelt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3a48553f-f5b0-4497-8986-8210279ef510",
                                "sense_id": "e5a3b74e-962e-3295-a9d5-2853e7dc31b4",
                                "text": "Ben je al naar de therapeut geweest?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ed08e7-4b85-46fc-ae62-13465755b652",
                        "source_entry_id": "53091730-ab5a-3ba6-a2b9-2ac6ea5bb8f9",
                        "source_sense_id": "e5a3b74e-962e-3295-a9d5-2853e7dc31b4",
                        "source_sense_description": "iemand die een patiënt behandelt",
                        "target_lang_word": "Therapeut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Therapeut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                        "entry_id": "22d100a9-c5e2-3a06-89f9-6ad02bb2029f",
                                        "glosses": [
                                            "Person, die dazu ausgebildet ist, Therapien (Behandlungen) einzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d242366e-07cb-41fd-87ca-4e7676a00445",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "Zwischen Therapeut und Patient entwickelte sich ein Vertrauensverhältnis."
                                            },
                                            {
                                                "example_id": "3ccbcadb-1a21-4356-b1d2-fb7e7444a5f7",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "Mein Therapeut hat gesagt, ich soll mich nicht immer so schnell aufregen."
                                            },
                                            {
                                                "example_id": "df4022c9-4642-4589-ac5d-caa8927a08fd",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Die Abgrenzung gegen andere unkonventionelle Heilmethoden orientiert sich daran, ob Hilfsmittel eingesetzt werden. Die bloße Intention des Therapeuten reicht manchmal aus, um Krankheitsverläufe günstig zu beeinflussen\", glaubt Wiesendanger. Doch die Heiler agieren oft am Rande der Legalität.“"
                                            },
                                            {
                                                "example_id": "acb42836-31b1-44af-a541-f5c04c4f7fb0",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Man hat es auch mit Nebendarstellern wie Sven Hannawald versucht, dem RTL ein verlässlicher Therapeut geworden ist in den Tagen der Springerei.“"
                                            },
                                            {
                                                "example_id": "36ac9f21-62a3-4436-97ce-8d9a308a99b4",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Der Therapeut beobachtet den Patienten, sich selbst und die Szene und entwickelt daraus seine Beteiligungsweise, er hört zu, kommentiert und stellt gelegentlich, aber eher selten, eine Frage.“"
                                            },
                                            {
                                                "example_id": "741d48ce-5add-4b5f-ad77-bea00b0e7f5e",
                                                "sense_id": "bcd50b02-d0ae-3d5e-a038-402ccb87bb5a",
                                                "text": "„Und Therapeuten wie Logopäden und andere kommen dann in die Kitas und arbeiten dort mit den Kindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e876a6e4-65ea-4f12-8e12-03c6104cbb63",
                        "source_entry_id": "53091730-ab5a-3ba6-a2b9-2ac6ea5bb8f9",
                        "source_sense_id": "e5a3b74e-962e-3295-a9d5-2853e7dc31b4",
                        "source_sense_description": "iemand die een patiënt behandelt",
                        "target_lang_word": "therapist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therapist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5371a70d-94b2-3567-a6f9-a52fca94fb6d",
                                        "entry_id": "ce4eafd2-1706-3c43-a835-7e4e4ff49d95",
                                        "glosses": [
                                            "Someone who provides therapy, usually professionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ae2f8b-30d7-4c88-b1ce-040f649ca09b",
                                                "sense_id": "5371a70d-94b2-3567-a6f9-a52fca94fb6d",
                                                "text": "Get the whole in-network provider list and then ask friends and family if they know any of the names, or check online ratings to see which therapists get high rankings. One note of warning: Friends may have their favorites, but experts say don’t assume their therapist is going to be a good fit for you as each person’s needs are different."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2854cde-edf3-3f56-b76d-60aeb15693b7",
                                        "entry_id": "ce4eafd2-1706-3c43-a835-7e4e4ff49d95",
                                        "glosses": [
                                            "A psychotherapist specifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3824b8-3ee2-4161-bb13-948cd3f66d13",
                                                "sense_id": "c2854cde-edf3-3f56-b76d-60aeb15693b7",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, and so we entered stage three – what therapists call \"bargaining\". A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            },
                                            {
                                                "example_id": "55d2e475-5278-4e20-815b-f665ff855a2b",
                                                "sense_id": "c2854cde-edf3-3f56-b76d-60aeb15693b7",
                                                "text": "We're Midwesterners. Our therapists are bartenders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2fdabb5-f616-4a06-bc13-7c53d1a3404f",
                        "source_entry_id": "53091730-ab5a-3ba6-a2b9-2ac6ea5bb8f9",
                        "source_sense_id": "e5a3b74e-962e-3295-a9d5-2853e7dc31b4",
                        "source_sense_description": "iemand die een patiënt behandelt",
                        "target_lang_word": "thérapeute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thérapeute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "334ad9ec-450f-38ec-8fae-fc35df2a4da4",
                                        "entry_id": "edcdbd9d-dbac-328e-991e-cf4170b6effc",
                                        "glosses": [
                                            "Ascète juif qui se livrait à la vie contemplative et mortifiée. Saint Jérôme les considère comme chrétiens. Ce sont les précurseurs du monachisme."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da7f513-037a-4986-8573-950baf8c7e6b",
                                                "sense_id": "334ad9ec-450f-38ec-8fae-fc35df2a4da4",
                                                "text": "Les thérapeutes ont été les modèles de la vie monastique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978b8aec-5de1-3f1e-9d64-46c3dd9a8da1",
                                        "entry_id": "edcdbd9d-dbac-328e-991e-cf4170b6effc",
                                        "glosses": [
                                            "Médecin ou guérisseur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c2fa8b3-5e6d-3c5a-8c4a-4c2223230fdb",
                                        "entry_id": "edcdbd9d-dbac-328e-991e-cf4170b6effc",
                                        "glosses": [
                                            "Psychothérapeute."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2f3d10-99b0-44e8-8674-38593919dff1",
                                                "sense_id": "0c2fa8b3-5e6d-3c5a-8c4a-4c2223230fdb",
                                                "text": "La jeune femme ajoute qu’elle a finalement contacté son thérapeute et écrit un blogue à propos de sa maladie afin de briser l’isolement, un des facteurs de risque des troubles alimentaires."
                                            }
                                        ]
                                    }
                                ]
