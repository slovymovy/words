                                        "entry_id": "2ab77f17-b70b-3211-a76c-2352bf60eddf",
                                        "glosses": [
                                            "een afvoeropening waardoor water vanaf het dek overboord kan stromen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21fb56b1-0e42-471e-bd59-905a6b436e8a",
                                                "sense_id": "d0b84233-6e91-34b3-af79-7cf1572b2fec",
                                                "text": "We moetsen flink hozen want de spuigaten konden het water niet snel genoeg lozen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "690402eb-35dd-49ed-bed4-103b9eff768e",
                        "source_entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                        "target_lang_word": "goot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f2494d8a-a045-32bd-a06f-be28ce5616b1",
                                        "entry_id": "278c2178-7768-3cbc-a12a-687f33bf59db",
                                        "glosses": [
                                            "een gleuf of greppel bedoeld voor het af laten vloeien van een vloeistof"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d5b004-359c-493f-b64c-e3db0068c6c3",
                                                "sense_id": "f2494d8a-a045-32bd-a06f-be28ce5616b1",
                                                "text": "Je moet die goot eens schoonmaken, anders kan het water niet goed weg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42857250-dbd3-34f7-b9bb-7cd166356983",
                                        "entry_id": "278c2178-7768-3cbc-a12a-687f33bf59db",
                                        "glosses": [
                                            "een langgerekte bakvormige of halfronde constructie, die het water van het dak opvangt en afvoert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c9dc41-dc8a-44dc-9cda-924e8527e614",
                                                "sense_id": "42857250-dbd3-34f7-b9bb-7cd166356983",
                                                "text": "De afvoer van de goot was verstopt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1015216-5da9-34b0-9e39-79a314079bc4",
                                        "entry_id": "278c2178-7768-3cbc-a12a-687f33bf59db",
                                        "glosses": [
                                            "overdrachtelijk: een onverkwikkelijke en te vermijden plaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d69436-93aa-454b-a6e2-014f6d158583",
                                                "sense_id": "a1015216-5da9-34b0-9e39-79a314079bc4",
                                                "text": "Als je niet zorgt dat je baan hebt, lig je zo in de goot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "goot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2067df26-6c98-3963-86b8-e6f88d015e0a",
                                        "entry_id": "8bdaae6a-5a44-37e8-a824-7ff56d7f491b",
                                        "glosses": [
                                            "enkelvoud verleden tijd van gieten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85bea2b8-2308-446f-be23-65c5068e5794",
                                                "sense_id": "2067df26-6c98-3963-86b8-e6f88d015e0a",
                                                "text": "Ik goot."
                                            },
                                            {
                                                "example_id": "59b76d4b-8045-435e-b224-e226cd74bba4",
                                                "sense_id": "2067df26-6c98-3963-86b8-e6f88d015e0a",
                                                "text": "Jij goot."
                                            },
                                            {
                                                "example_id": "b8546362-c0f3-4d3c-b9c2-3e4fcad70150",
                                                "sense_id": "2067df26-6c98-3963-86b8-e6f88d015e0a",
                                                "text": "Hij, zij, het goot."
                                            },
                                            {
                                                "example_id": "893329c8-ee25-4ca7-b39d-3628aebda8be",
                                                "sense_id": "2067df26-6c98-3963-86b8-e6f88d015e0a",
                                                "text": "Deze Terminus bestond uit een paar dikke palen die ik uitgeput omhelsde. Het voelde wel een beetje raar en leeg. Toch was ik ook opgelucht dat het voorbij was en trok een mini-whiskeyflesje open. Voordat ik dit in één teug naar binnen goot, sloeg ik een kruis en wees in de lucht naar een denkbeeldige maan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "goot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "18a1ac31-896a-3e0a-b852-da9fd843f63f",
                                        "entry_id": "7d81f2b1-6c54-3779-9bec-3f6f574aaf92",
                                        "glosses": [
                                            "onpersoonlijke verleden tijd van gieten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
