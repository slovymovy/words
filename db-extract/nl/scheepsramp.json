                        "examples": [
                            {
                                "example_id": "acbf40a4-be3e-4494-afc7-4deadec042d8",
                                "sense_id": "2fc73f85-ce2b-3894-8637-f3df9017d573",
                                "text": "Het dodental van de scheepsramp met een migrantenboot voor de kust van Syrië is opgelopen naar 77, heeft een Libanese minister bekendgemaakt. Het schip was vertrokken uit Libanon en had voornamelijk Libanezen aan boord."
                            },
                            {
                                "example_id": "402b67d8-d8f2-4762-8c41-09dc41e7f3f7",
                                "sense_id": "2fc73f85-ce2b-3894-8637-f3df9017d573",
                                "text": "Onderzoekers uit Zweden en Finland ronden vandaag nieuw onderzoek af naar het zinken van de veerboot MS Estonia in 1994, met 852 doden de grootste Europese scheepsramp sinds de Tweede Wereldoorlog. Het gaat om een voorstudie voor een groter onderzoek dat in 2022 klaar moet zijn."
                            }
                        ]
                    }
