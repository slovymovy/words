                            "singular"
                        ],
                        "form": "den Seitenschneider"
                    },
                    {
                        "form_id": "afe8b8c5-d0d1-4701-aafa-93ab90b1ccaa",
                        "entry_id": "5cc9baae-b038-3745-911b-e837520c1f88",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Seitenschneider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d91a125-4bfe-3b80-bf10-dea3ae795f3f",
                        "entry_id": "5cc9baae-b038-3745-911b-e837520c1f88",
                        "glosses": [
                            "Werkzeug mit keilförmigen Schneiden, das zum Durchtrennen von Drähten, Blechen und Ähnlichem verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d800c5b-2e14-4d09-b5e8-0d98311ed40e",
                                "sense_id": "0d91a125-4bfe-3b80-bf10-dea3ae795f3f",
                                "text": "„In jedem Werkzeugkasten eines Heimwerkers findet sich mindestens ein Seitenschneider.“"
                            },
                            {
                                "example_id": "0e808e66-dc75-483b-b0e1-dfe206ed1833",
                                "sense_id": "0d91a125-4bfe-3b80-bf10-dea3ae795f3f",
                                "text": "„Der Oberleutnant knipst gerade mit einem Seitenschneider die letzten Zündkabel und Sprengschnüre durch.“"
                            },
                            {
                                "example_id": "0ee1f629-704f-4a0c-9fef-d2f26302a46f",
                                "sense_id": "0d91a125-4bfe-3b80-bf10-dea3ae795f3f",
                                "text": "„Der mit einem Gewicht von 108 Kilogramm recht beleibte Hafenarbeiter wurde mit einem Seitenschneider aus seinem Kleinwagen herausgeschnitten.“"
                            },
                            {
                                "example_id": "c7a2b9a1-7915-4bab-ad1f-1d344dbf793c",
                                "sense_id": "0d91a125-4bfe-3b80-bf10-dea3ae795f3f",
                                "text": "„Die Polizei stellte im Kasten der beiden Jugendlichen einen sogenannten Seitenschneider sicher, mit dem sie das Gitter des Kästlis aufgebrochen hatten.“"
                            },
                            {
                                "example_id": "62c352bb-78cc-4672-a39b-557d86db6b5f",
                                "sense_id": "0d91a125-4bfe-3b80-bf10-dea3ae795f3f",
                                "text": "„In das Loch wird der passende Dübel eingeschoben und die überstehende Dübelstange mit einem Seitenschneider glatt an der Wand abgeschnitten […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                        "entry_id": "5cc9baae-b038-3745-911b-e837520c1f88",
                        "glosses": [
                            "aus keilförmigen Schneiden bestehender Teil einer Zange, mit dem Drähte, Bleche und Ähnliches durchtrennt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c062511-0071-4177-8885-900e80bddb59",
                                "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                                "text": "„Als geeignetes Werkzeug empfehlen sich dazu Drahtzangen mit Seitenschneider, welche also Flach- und Kneifzange in einem Instrument vereinigen.“"
                            },
                            {
                                "example_id": "aba59a4c-5b9f-4b0c-91c1-b61d5e767263",
                                "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                                "text": "„Außer diesen Zangen gibt es noch eine ganze Zahl Kombinationszangen (Flachzange mit Seitenschneider, Universal-Elektrikerzange usw.), die erwünscht, aber für unsere Zwecke nicht unbedingt notwendig sind.“"
                            },
                            {
                                "example_id": "46db8a2c-0806-4de9-ab0f-990d1cc354ea",
                                "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                                "text": "„Außerdem können sie wie die Telefonzangen mit einem Drahtabschneider hinter dem Maul oder wie die Modistinnenzangen mit einem Seitenschneider ausgestattet sein.“"
                            },
                            {
                                "example_id": "7f49b0d6-7df4-4ddc-99f4-68ee2f2dd4ac",
                                "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                                "text": "„Eine zum Tragen eingerichtete dauerhafte Lederhülle enthält folgende Werkzeuge: […] Kräftige stählerne Flachzange mit Seitenschneider für weiche Drähte […]“"
                            },
                            {
                                "example_id": "b6fef253-b9a2-46ca-947b-d6405c3accca",
                                "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                                "text": "„[Code:] 8203.20.20 [Beschreibung:] nachstehende Zangen mit einer Länge von mehr als 110 mm bis 300 mm: Kombinationszangen mit gezahnten Backen, auch ohne Rohrbackenöffnung, Flachrundzangen mit Seitenschneider und gezahnten Backen, Gasrohrzangen und verstellbare Gasrohrzangen (auch mit gebogenem Kopf)“"
                            },
                            {
                                "example_id": "eb93cde2-d041-43bd-ac48-c957b2601093",
                                "sense_id": "1d70e97f-68b0-3e01-af23-b0936dc56ed4",
                                "text": "„Die Plombenzange mit Seitenschneider hat einen Stempeldurchnesser von 8 mm und wir liefern sie mit und ohne Gravur.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1c4ef0c2-c659-3e9f-93de-83a8914c2381",
                        "entry_id": "5cc9baae-b038-3745-911b-e837520c1f88",
                        "glosses": [
                            "rechteckiger Stempel zum seitlichen Beschneiden eines Streifens"
                        ],
                        "tags": [
                            "Stanztechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "c4414874-a039-4ebb-98b1-51039fb32396",
                                "sense_id": "1c4ef0c2-c659-3e9f-93de-83a8914c2381",
                                "text": "„Der erste Seitenschneider schneidet den Streifen auf 13,5 mm breit, und diese Breite ist als Scheibengröße zu denken, von wo aus die Ziehgänge zu bestimmen sind.“"
                            },
                            {
                                "example_id": "59dd724d-4f82-4972-8b84-36e4d9429773",
                                "sense_id": "1c4ef0c2-c659-3e9f-93de-83a8914c2381",
                                "text": "„Der Seitenschneider S ist so anzuordnen, daß der Ausschneidestempel den Streifen nicht anknabbert, da dann der Stempel abgedrängt würde.“"
                            },
                            {
                                "example_id": "099e777d-427e-41df-8120-ab8e372e28eb",
                                "sense_id": "1c4ef0c2-c659-3e9f-93de-83a8914c2381",
                                "text": "„Der Seitenschneider ergibt die genaueste Vorschubbegrenzung. Er ist ein zusätzlicher Schneidstempel, der den Rand des Blechstreifens beschneidet.“"
                            },
                            {
                                "example_id": "b8f469db-f1aa-43d1-b256-696a10261d48",
                                "sense_id": "1c4ef0c2-c659-3e9f-93de-83a8914c2381",
                                "text": "„Wenn ein Seitenschneider lange im Einsatz bleibt, führt die zunehmende Kantenverrundung zu einem Grat am Blechstreifen […]“"
                            },
                            {
                                "example_id": "3f71abd1-6448-4651-897e-ccb6995df6d9",
                                "sense_id": "1c4ef0c2-c659-3e9f-93de-83a8914c2381",
                                "text": "„Seitenschneider sind so anzuordnen, dass Anschneidanschläge wegfallen und die Sicht auf die Lochstempel nicht behindert wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
