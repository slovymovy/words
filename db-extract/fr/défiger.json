                        "sense_id": "ccb8af58-0b5d-32be-b178-d70efb9a5a57",
                        "entry_id": "0bb8f389-2c01-31c6-aeed-6f58f5cf572e",
                        "glosses": [
                            "Rendre à nouveau liquide ce qui était figé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a02328b-6ce9-3f94-94fe-c41cb48be880",
                        "entry_id": "0bb8f389-2c01-31c6-aeed-6f58f5cf572e",
                        "glosses": [
                            "Perdre de sa raideur."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "187ce0b3-faa6-45e0-8fdc-dce69568fa3e",
                                "sense_id": "2a02328b-6ce9-3f94-94fe-c41cb48be880",
                                "text": "Le signal des applaudissements qui partait, quelquefois, de notre baignoire et par quoi nous saluions les beaux passages de l’œuvre, n’eut presque jamais d’échos et ne défigea pas souvent l’indifférence ensommeillée de la salle, une salle composée, eut-on dit, de vieillards seulement et de blasés revenus de tout, même de la beauté."
                            },
                            {
                                "example_id": "55226314-d34c-4959-aa4a-2d351d1fcea0",
                                "sense_id": "2a02328b-6ce9-3f94-94fe-c41cb48be880",
                                "text": "Elle n’a pas du tout l’habitude de boire. Elle s’est défigée, elle s’est animée."
                            }
                        ]
                    }
