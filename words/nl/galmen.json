{
    "word_family": [
        "galm",
        "weergalmen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19142418-90a5-3f5a-aaf1-aa6d87a6264c",
                    "sense_definition": "langdurig luid naklinken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het geluid van een alpenhoorn <w>galmde</w> door het dal.",
                            "target_lang_translations": {
                                "en": "The sound of an alphorn <w>reverberated</w> through the valley."
                            }
                        },
                        {
                            "text": "Zijn stem bleef nog lang <w>galmen</w> in de grote, lege kerk.",
                            "target_lang_translations": {
                                "en": "His voice continued to <w>echo</w> for a long time in the large, empty church."
                            }
                        }
                    ],
                    "synonyms": [
                        "weergalmen",
                        "echoën",
                        "resoneren"
                    ],
                    "common_phrases": [
                        "door de gangen galmen",
                        "luid galmen"
                    ],
                    "target_lang_definitions": {
                        "en": "to echo or resound loudly and for a long time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reverberate",
                                "target_lang_sense_clarification": "of a sound: to bounce off surfaces and continue to be heard"
                            },
                            {
                                "target_lang_word": "echo",
                                "target_lang_sense_clarification": "to be repeated or sent back from a surface"
                            },
                            {
                                "target_lang_word": "resound",
                                "target_lang_sense_clarification": "to fill a place with sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6576164-00c6-3cb5-8793-1f29e1d4579d",
                    "sense_definition": "op overdreven trage of plechtige wijze iets zingen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zingen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De behoudende gemeente <w>galmde</w> luidkeels een psalm in de oude berijming.",
                            "target_lang_translations": {
                                "en": "The conservative congregation loudly <w>chanted</w> a psalm in the old versification."
                            }
                        },
                        {
                            "text": "De koren <w>galmen</w> hun liederen traag door de gewelven van de kathedraal.",
                            "target_lang_translations": {
                                "en": "The choirs <w>intone</w> their songs slowly through the vaults of the cathedral."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een psalm galmen"
                    ],
                    "target_lang_definitions": {
                        "en": "to sing something in an exaggeratedly slow or solemn manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chant",
                                "target_lang_sense_clarification": "to sing or shout in a rhythmic, repetitive way"
                            },
                            {
                                "target_lang_word": "intone",
                                "target_lang_sense_clarification": "to say or sing with a particular tone, often solemnly"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b742b663-de95-3d08-80f2-aea7ec9d3712",
                    "sense_definition": "meervoud van <w>galm</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verschillende <w>galmen</w> in de grot maakten het lastig elkaar te verstaan.",
                            "target_lang_translations": {
                                "en": "The various <w>echoes</w> in the cave made it difficult to understand each other."
                            }
                        },
                        {
                            "text": "In de verte hoorden we de <w>galmen</w> van de kerkklokken.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard the <w>reverberations</w> of the church bells."
                            }
                        }
                    ],
                    "synonyms": [
                        "echo's"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of galm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'galm' (echo, reverberation)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "echoes",
                                "target_lang_sense_clarification": "plural of a sound caused by reflection"
                            },
                            {
                                "target_lang_word": "reverberations",
                                "target_lang_sense_clarification": "plural of a continuing sound or vibration"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}