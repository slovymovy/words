    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d5d9805-c8e7-381d-88cf-2782ed52d889",
                    "sense_definition": "Вызывающий скуку, неинтересный; такой, который не развлекает и не занимает.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "boring_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот фильм был такой <w>скучный</w>, что я уснул в самом начале.",
                            "target_lang_translations": {
                                "en": "That movie was so <w>boring</w> that I fell asleep right at the beginning."
                            }
                        },
                        {
                            "text": "У нас сегодня был очень <w>скучный</w> урок, и мы все ждали звонка.",
                            "target_lang_translations": {
                                "en": "We had a very <w>dull</w> lesson today, and we were all waiting for the bell."
                            }
                        }
                    ],
                    "synonyms": [
                        "неинтересный",
                        "нудный"
                    ],
                    "antonyms": [
                        "интересный",
                        "захватывающий"
                    ],
                    "common_phrases": [
                        "скучный фильм",
                        "скучный человек",
                        "скучная работа",
                        "скучный урок"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing boredom, uninteresting; not entertaining or engaging."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boring",
                                "target_lang_sense_clarification": "not interesting or exciting"
                            },
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "lacking interest, lively spirit, or excitement"
                            },
                            {
                                "target_lang_word": "tedious",
                                "target_lang_sense_clarification": "tiresomely long, slow, or monotonous"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "887c2147-7515-3f0b-a651-b8797372902a",
                    "sense_definition": "Грустный, печальный, невесёлый (о человеке, его виде или настроении).",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "sad_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Почему ты сегодня такой <w>скучный</w> и совсем не разговариваешь?",
                            "target_lang_translations": {
                                "en": "Why are you so <w>downcast</w> today and not talking at all?"
                            }
                        },
                        {
                            "text": "У него был <w>скучный</w> и усталый вид после долгой работы.",
                            "target_lang_translations": {
                                "en": "He had a <w>listless</w> and tired look after a long day of work."
                            }
                        }
                    ],
                    "synonyms": [
                        "грустный",
                        "печальный",
                        "невесёлый",
                        "смурной"
                    ],
                    "antonyms": [
                        "весёлый",
                        "радостный",
                        "оживлённый"
                    ],
                    "common_phrases": [
                        "скучный вид",
                        "скучный взгляд",
                        "скучный голос"
                    ],
                    "target_lang_definitions": {
                        "en": "Gloomy, sad, cheerless (describing a person, their expression, or mood)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "listless",
                                "target_lang_sense_clarification": "lacking energy, enthusiasm, or cheerfulness"
                            },
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "depressed, downcast, or dispirited"
                            },
                            {
                                "target_lang_word": "downcast",
                                "target_lang_sense_clarification": "sad, low-spirited, or dejected in appearance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}