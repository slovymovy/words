                    {
                        "sense_id": "284c54e1-c6fc-35c0-a7cd-91f0eec188ec",
                        "entry_id": "0a3f7982-224c-3eec-853c-0ded2deb7b4c",
                        "glosses": [
                            "Serving to support or sustain."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6bd1aef1-d957-41c3-b02c-75dd2138461f",
                                "sense_id": "284c54e1-c6fc-35c0-a7cd-91f0eec188ec",
                                "text": "A sustentacular tissue"
                            },
                            {
                                "example_id": "73d0b09c-545e-4648-9d92-90ec8a47b06e",
                                "sense_id": "284c54e1-c6fc-35c0-a7cd-91f0eec188ec",
                                "text": "1998 [Kluwer Academic], Julian Lombardi, Comparative Vertebrate Reproduction, 1998, Softcover reprint, Springer, page 122,\nDuring spermiogenesis, the highly specialized sustentacular cells provide support and protection during the transformative process."
                            },
                            {
                                "example_id": "538f92a1-dda3-4f0f-b982-190e6daff1fc",
                                "sense_id": "284c54e1-c6fc-35c0-a7cd-91f0eec188ec",
                                "text": "Normal paraganglionic tissue contains two types of cell: chief or type I cells, which are neuroendocrine cells, and sustentacular or type II cells, which are not neuroendocrine, but contain S-100 protein."
                            },
                            {
                                "example_id": "dc4fd5cc-8383-4231-a307-ab8e83202224",
                                "sense_id": "284c54e1-c6fc-35c0-a7cd-91f0eec188ec",
                                "text": "The sustentacular facet is anteroposteriorly elongate and, in some specimens, achieves very broad contact with the navicular facet, while in others only with the cuboid facet."
                            }
                        ]
                    }
                ],
