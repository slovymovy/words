                    {
                        "sense_id": "d92d0cd8-ff88-3d90-a533-8f91be7f38c9",
                        "entry_id": "098ee9ac-953a-35dc-9863-21476b589d6e",
                        "glosses": [
                            "długi, szeroki nóż podobny do tasaka, używany przeważnie do wyrąbywania ścieżek w gęstych zaroślach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce71935-3b8e-4870-9b7e-ca5fd932d0ec",
                                "sense_id": "d92d0cd8-ff88-3d90-a533-8f91be7f38c9",
                                "text": "Ścieżkę przez gąszcze utorowali mężczyźni z maczetami."
                            },
                            {
                                "example_id": "a6511f79-9630-4cd7-a5e3-2c0b2bc62f8b",
                                "sense_id": "d92d0cd8-ff88-3d90-a533-8f91be7f38c9",
                                "text": "Kilkanaście osób podejrzanych o rozprzestrzenianie cholery przy użyciu czarów padło ofiarą linczu. Ciała ofiar zostały rozsiekane maczetami, a następnie spalone."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
