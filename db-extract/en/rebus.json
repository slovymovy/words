                ],
                "senses": [
                    {
                        "sense_id": "3e8efb16-f625-3276-8842-137368c9103b",
                        "entry_id": "22aca788-2f21-376b-9562-4375b88b3045",
                        "glosses": [
                            "An arrangement of pictures, symbols, and/or words representing phrases or words, especially as a word puzzle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05895b6e-7837-47e5-8c1d-7729d480bd7e",
                                "sense_id": "3e8efb16-f625-3276-8842-137368c9103b",
                                "text": "I back him at a Rebus or a Charade against the best Rhymer in the Kingdom—has your Ladyship heard the Epigram he wrote last week on Lady Frizzle's Feather catching Fire—"
                            }
                        ]
                    },
                    {
                        "sense_id": "011aec77-afd8-3a38-ae42-ce59afb8f3b9",
                        "entry_id": "22aca788-2f21-376b-9562-4375b88b3045",
                        "glosses": [
                            "A pictographic component of a compound character (e.g. sinograph) used to hint at the pronunciation of the compound."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aaf78990-23f3-343e-a99c-87cd5268fddd",
                        "entry_id": "22aca788-2f21-376b-9562-4375b88b3045",
                        "glosses": [
                            "An arrangement of pictures on a coat of arms which suggests the name of the person to whom it belongs."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "a7f1c49a-4a08-4f21-af28-92b0f4802643",
                                "sense_id": "aaf78990-23f3-343e-a99c-87cd5268fddd",
                                "text": "The prior [Will Bolton] used to come out here to hunt in summer and recreate himself, and his rebus—a barrel or tun shot through with a crossbow bolt—is set into the garden walls."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbd407bf-fcd1-3a34-8b8f-e1a696cdfeaf",
                        "entry_id": "22aca788-2f21-376b-9562-4375b88b3045",
                        "glosses": [
                            "A type of crossword puzzle in which some squares contain entire words, or symbols representing words, instead of single letters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b3e0c7-90d7-4a04-bab8-aa2038af5b2a",
                                "sense_id": "fbd407bf-fcd1-3a34-8b8f-e1a696cdfeaf",
                                "text": "Instead of spelling out card suits, for example, perhaps the constructor inserted a \"rebus,\" or picture icon for clubs, hearts, spades, or diamonds in one answer box."
                            },
                            {
                                "example_id": "53916cf7-8bb7-45ea-8516-826762636bc6",
                                "sense_id": "fbd407bf-fcd1-3a34-8b8f-e1a696cdfeaf",
                                "text": "Rebuses are a vital part of cryptic crosswords and even themed standard crossword puzzles, as modernized under the leadership of Will Shortz at The New York Times, make use of rebuses."
                            },
                            {
                                "example_id": "ff3bc711-9c7b-4cf8-9915-4ddf7c5b7d83",
                                "sense_id": "fbd407bf-fcd1-3a34-8b8f-e1a696cdfeaf",
                                "text": "In the cruciverse, a rebus refers to a crossword that violates the basic \"one letter per box\" rule, requiring the entry of multiple letters - or even a number or symbol - into a single square"
                            }
                        ]
                    }
                ],
