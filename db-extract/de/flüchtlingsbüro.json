                "senses": [
                    {
                        "sense_id": "9d57f48f-1f16-369e-87f5-7a6660e28f87",
                        "entry_id": "16b45b72-62d5-37c6-81f3-dbca313cb404",
                        "glosses": [
                            "Büro, das administrative Arbeiten von und für Flüchtlinge erledigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13d1b4fe-5a4c-4cfe-93e0-8e9e3fd337a0",
                                "sense_id": "9d57f48f-1f16-369e-87f5-7a6660e28f87",
                                "text": "„Zwischen 1984 und 2002 arbeitete Chaponda als Rechtsanwalt für das Flüchtlingsbüro der Vereinten Nationen, […].“"
                            },
                            {
                                "example_id": "8f896973-6e27-4b22-b033-819ef8a13a64",
                                "sense_id": "9d57f48f-1f16-369e-87f5-7a6660e28f87",
                                "text": "„Pommerening schwärmt von Spenden, Integrationslotsen und Flüchtlingsbüro.“"
                            },
                            {
                                "example_id": "31800658-be29-4cc7-9065-0428de7a7445",
                                "sense_id": "9d57f48f-1f16-369e-87f5-7a6660e28f87",
                                "text": "„Trotz einem grossen Uno-Flüchtlingsbüro in Quetta, trotz einem pakistanischen Kommissär für Flüchtlingsfragen, dessen Büros nur zehn Autominuten von der Bilal Colony entfernt liegen, blieben Nazo und die 350 Familien aus Vilayat illegale Flüchtlinge.“"
                            },
                            {
                                "example_id": "c10184ab-6282-40e4-bb84-2d6a83575574",
                                "sense_id": "9d57f48f-1f16-369e-87f5-7a6660e28f87",
                                "text": "„Sie hatten vor dem Flüchtlingsbüro der Vereinten Nationen in Athen kampiert und erklärt, ihre Asylanträge seien neun Jahre lang nicht bearbeitet worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
