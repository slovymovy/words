                                "target_senses": [
                                    {
                                        "sense_id": "db5f5537-bd8b-35b4-b9ca-b60bda36e2a5",
                                        "entry_id": "92d68491-4022-3fe9-a0e9-38566042dbee",
                                        "glosses": [
                                            "A person who makes or repairs things with tin or similar alloys."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a14cd18-9468-4c53-9a8e-f7f160570c26",
                                                "sense_id": "db5f5537-bd8b-35b4-b9ca-b60bda36e2a5",
                                                "text": "\"Then bring them to me,\" she said. And when the tinsmiths came, bringing with them all their tools in baskets, she inquired, \"Can you straighten out those dents in the Tin Woodman, and bend him back into shape again, and solder him together where he is broken?\""
                                            },
                                            {
                                                "example_id": "eec83531-61fa-4a87-922c-4dafc58cf9af",
                                                "sense_id": "db5f5537-bd8b-35b4-b9ca-b60bda36e2a5",
                                                "text": "A little later this was replaced by a new-fangled naphtha lamp made by a local tinsmith which gave a better light but emitted an evil smell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f49eb796-c0c4-3a1d-bae9-d6a02b06a6b4",
                                        "entry_id": "92d68491-4022-3fe9-a0e9-38566042dbee",
                                        "glosses": [
                                            "A dealer in tin goods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3c2089c-3d56-4611-a49d-806e567d248f",
                        "source_entry_id": "3b813a79-c4fc-3209-afbb-dd124d5f6e05",
