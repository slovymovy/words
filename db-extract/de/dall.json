                ],
                "senses": [
                    {
                        "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                        "entry_id": "50efa2bb-771c-3e09-81f6-80b55fb31bd4",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96300c07-25c2-4469-9931-8ebf1b2efe5a",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Frau Dall ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e4929d26-6ff6-45a8-87bf-5339e87a95f5",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Herr Dall wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3504dbd2-fced-45f3-912d-ef8d6935c139",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Die Dalls kommen heute aus Koblenz."
                            },
                            {
                                "example_id": "4f86a99c-f3e0-4980-ac5a-bf5e9838df01",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Der Dall trägt nie die Schals, die die Dall ihm strickt."
                            },
                            {
                                "example_id": "5d5d2850-c18c-4b44-a26f-413805caea4c",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dall kommt, geht der Herr Dall.“"
                            },
                            {
                                "example_id": "6a9ab658-40cc-4a1b-b073-1db8727fce16",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Dall kommt und geht."
                            },
                            {
                                "example_id": "76363b7c-4b43-462c-b86f-142d0c6f167d",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "Dalls kamen, sahen und siegten."
                            },
                            {
                                "example_id": "df3db367-5491-49e2-96e0-139e26ff87b6",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "An verregneten Herbsttagen ist Familie Dalls liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "2e0808df-9f6c-4dc3-ad9a-95e9a53b0c17",
                                "sense_id": "d764dcdf-2e6c-34c1-8023-ae964d52a86b",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Dall das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
