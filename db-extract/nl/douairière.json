                ],
                "senses": [
                    {
                        "sense_id": "6e42c328-17df-31d2-89dc-12b91f5db3e0",
                        "entry_id": "c2348976-7c0b-3cfe-bf35-a7308fe75424",
                        "glosses": [
                            "weduwe van een edelman"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7853256e-0445-40a9-ac84-0f2a0f10ca47",
                                "sense_id": "6e42c328-17df-31d2-89dc-12b91f5db3e0",
                                "text": "De goede reisgezel en zijn wijze moeder veranderden zienderogen in een halfmallote douarière en een nauwelijks bewaakbare dégéneré."
                            }
                        ]
                    },
                    {
                        "sense_id": "dde038d0-4b59-32aa-8b8e-d7a67079b778",
                        "entry_id": "c2348976-7c0b-3cfe-bf35-a7308fe75424",
                        "glosses": [
                            "aanduiding voor de weduwe van een edelman"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "76607d33-22ca-4446-bd51-e8a48f720e85",
                                "sense_id": "dde038d0-4b59-32aa-8b8e-d7a67079b778",
                                "text": "De douarière Melchior-Jan van Susteren liet het herbouwen en deed voor dit werk een beroep op de beroemdste architekt van de tijd nl. Jan-Pieter van Baurscheit de Jonge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1333c73-bfcc-4bff-ad84-8a095c94ea83",
                        "source_entry_id": "c2348976-7c0b-3cfe-bf35-a7308fe75424",
                        "source_sense_id": "6e42c328-17df-31d2-89dc-12b91f5db3e0",
                        "source_sense_description": "weduwe van een edelman",
                        "target_lang_word": "dowager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dowager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c1c386-c923-3917-89de-2a01f7e639f2",
                                        "entry_id": "48382d42-a330-38ba-80d5-be686f23816d",
                                        "glosses": [
                                            "A widow holding property or title derived from her late husband."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe926e17-bc7e-47fc-9c25-2b33cead7b66",
                                                "sense_id": "e9c1c386-c923-3917-89de-2a01f7e639f2",
                                                "text": "A reclusive dowager owned the pastures across the river, and her farmhands ran beef cattle on them."
                                            },
                                            {
                                                "example_id": "121c7733-9b42-490f-b9ea-61c7ec9fae16",
                                                "sense_id": "e9c1c386-c923-3917-89de-2a01f7e639f2",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers, the worn-out, passionless men, the enervated matrons of the summer capital, the chlorotic squatters on huge yachts,[…]!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f311d14a-593a-38af-af61-3f72957753a2",
                                        "entry_id": "48382d42-a330-38ba-80d5-be686f23816d",
                                        "glosses": [
                                            "The widow of the holder of a title; used in combination with the title she held during her husband's lifetime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de46699-bd3e-4ddc-869f-ee4d67734b0c",
                                                "sense_id": "f311d14a-593a-38af-af61-3f72957753a2",
                                                "text": "the Earl and Countess of Whiteacre, and the Earl's mother, the dowager Countess of Whiteacre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff78e014-2120-38e6-82cf-63426e931577",
                                        "entry_id": "48382d42-a330-38ba-80d5-be686f23816d",
                                        "glosses": [
                                            "Any lady of dignified bearing, especially an older one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e61fb6-1a73-4a90-bbc8-a6a21121d2e4",
                                                "sense_id": "ff78e014-2120-38e6-82cf-63426e931577",
                                                "text": "A stately dowager entered the ballroom, and all eyes were upon her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16bb80ff-b49e-4f96-8f4e-0b8f248f67c0",
                        "source_entry_id": "c2348976-7c0b-3cfe-bf35-a7308fe75424",
                        "source_sense_id": "6e42c328-17df-31d2-89dc-12b91f5db3e0",
                        "source_sense_description": "weduwe van een edelman",
                        "target_lang_word": "douairière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "douairière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dba5f95-625e-3dd7-80cf-aeb07d3a6484",
                                        "entry_id": "63c8386a-1040-3581-9435-43b7a14faeb4",
                                        "glosses": [
                                            "Qui jouissait d’un douaire, étant veuve (en parlant de personnes d’un rang distingué)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8f70ee7-1032-479e-9392-1fe823f96200",
                                                "sense_id": "3dba5f95-625e-3dd7-80cf-aeb07d3a6484",
                                                "text": "La duchesse douairière."
                                            },
                                            {
                                                "example_id": "aab93144-8967-42a5-b80e-b60fd1f1a465",
                                                "sense_id": "3dba5f95-625e-3dd7-80cf-aeb07d3a6484",
                                                "text": "Mais, entêté que tu es, quand je te dis que M. de Buckingham a loué toutes les maisons qui entourent celle où doit descendre Sa Majesté la reine douairière d’Angleterre et la princesse sa fille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "douairière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "303e6179-4ab4-3001-b699-b3453a1989e7",
                                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                                        "glosses": [
                                            "Veuve qui jouissait d’un douaire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29fc7be8-d668-4389-a132-3e7627fd5fd1",
                                                "sense_id": "303e6179-4ab4-3001-b699-b3453a1989e7",
                                                "text": "La douairière de Ronsdorf, femme d’une haute vertu et d’une réputation intacte, était alors restée veuve avec sa fille unique âgée de cinq ans ; […]."
                                            },
                                            {
                                                "example_id": "d37ae4af-2e55-4541-a698-d78b6e7c5dc8",
                                                "sense_id": "303e6179-4ab4-3001-b699-b3453a1989e7",
                                                "text": "L’abbé va trop vite… On ne peut pas suivre, murmure la vieille douairière en agitant sa coiffe avec égarement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20724f1-a65e-374b-9511-5d23b948832f",
                                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                                        "glosses": [
                                            "Veuve d’une famille aristocratique ayant un fils devenu chef de famille."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                                        "glosses": [
                                            "Femme âgée, de rang distingué."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee5bce40-47b5-439b-abcb-a10349c04730",
                                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                                "text": "En ce moment la douairière tricotait."
                                            },
                                            {
                                                "example_id": "b640c923-1fc9-40bb-a281-07cf031038fb",
                                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                                "text": "Il est vrai que tous les jours nous faisons un pas vers la liberté, l’égalité, la fraternité, trois grands mots que la Révolution de 93, vous savez, l’autre, la douairière, a lancés au milieu de la société moderne, […]."
                                            },
                                            {
                                                "example_id": "02bacb77-26ef-4ba9-a592-3e7c81fed700",
                                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                                "text": "Frivole, nonchalante, d’une naïveté un peu hautaine, il ne semblait pas qu’aucun chagrin pût altérer la bienveillance dont elle regardait la vie ; et son plus grave caprice aujourd’hui était de jouer à la douairière, se coiffant de dentelle et réclamant des petits-enfants à tout prix."
                                            },
                                            {
                                                "example_id": "29bfcc21-792f-4f2e-b6b5-2c6c7e3e3925",
                                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                                "text": "Nous entrâmes dans un cirque.\n« Nous employons quinze personnes de la famille », me confia la patronne à tête de douairière andalouse, qui comptait ses mots comme des pesetas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
