            {
                "entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                "word": "cardigan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1baed216-444e-4ec6-a03e-47e576942181",
                        "entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "tags": [
                            "plural"
                        ],
                        "form": "cardigans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                        "entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "glosses": [
                            "A type of sweater or jumper that fastens up the front with buttons or a zipper, usually machine- or hand-knitted from wool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79c0890e-ea6a-4d92-a1c5-642a1a291b9d",
                                "sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                                "text": "[…] a coarsely knit white cardigan and a black turban whose broadened tails could be arranged around her neck scarfwise."
                            },
                            {
                                "example_id": "7e596213-42e0-4c68-8fef-09046b0499f5",
                                "sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                                "text": "“I love that loungewear has become a prevailing new category,” said Barbara Lippert, 65, a writer. “During the worst part of the pandemic even jeans seemed like an overreach, requiring that complex button and zipper action. And cardigans were too much work.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b89a39c0-ba12-41c7-9f8c-ebee826f9093",
                        "source_entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "source_sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                        "source_sense_description": "type of sweater",
                        "target_lang_word": "kardigan",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "daf50045-9880-400f-9853-e55a005e193c",
                        "source_entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "source_sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                        "source_sense_description": "type of sweater",
                        "target_lang_word": "cardigan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardigan",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "db0ebadd-05df-31ab-bac6-f3c5507edbf2",
                                        "entry_id": "ab49b33e-b1d3-3a78-9d35-efcd2c9a2d09",
                                        "glosses": [
                                            "vest met V-hals dat met knoopjes aan de voorkant wordt gesloten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb59bb3-567e-452f-bd1a-39472b6f1a36",
                                                "sense_id": "db0ebadd-05df-31ab-bac6-f3c5507edbf2",
                                                "text": "En trendanalist Christine Boland ziet de cardigan weer opduiken bij mannen, een vestje van katoen of wol met knoopjes."
                                            },
                                            {
                                                "example_id": "93d55850-e2ae-44be-9cb4-af0a90485665",
                                                "sense_id": "db0ebadd-05df-31ab-bac6-f3c5507edbf2",
                                                "text": "‘In de middelbare school hadden alle meisjes hetzelfde kapsel, dezelfde cardigans en ballerina’s. Vooral dat laatste begrijp ik nog altijd niet. Ballerina’s hebben zo’n onflatterende ronde vorm en stralen iets sufs uit. Nul persoonlijkheid, niemand van ons had een eigen mening.’"
                                            },
                                            {
                                                "example_id": "17d9f9a9-f3d6-4b00-af7c-01d3d43487dd",
                                                "sense_id": "db0ebadd-05df-31ab-bac6-f3c5507edbf2",
                                                "text": "Eén van mijn lievelingsstukken is een gestreepte broek van Altuzarra en een gezellige cardigan in kasjmier, die ik op het vliegtuig kan dragen maar die evengoed op een avondjurk past.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a0c1f7-d4b8-49d8-8411-e5140d08f5c7",
                        "source_entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "source_sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                        "source_sense_description": "type of sweater",
                        "target_lang_word": "cardigan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardigan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                        "entry_id": "f1ccd7be-4075-378e-aa08-1b924b169bd1",
                                        "glosses": [
                                            "Veste tricotée, boutonnée par devant, sans col."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608c24a6-5d5c-4226-b283-8c617a72ebbf",
                                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                                "text": "Elle portait une jupe de tweed et un cardigan en shetland."
                                            },
                                            {
                                                "example_id": "352b0344-9273-45f5-853c-545c4db2377f",
                                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                                "text": "Le cardigan : impeccablement réalisé dans une matière raffinée, [74% acétate et 26% polyamide], fraîche, chatoyante, de belle tenue et facile à entretenir."
                                            },
                                            {
                                                "example_id": "6aa710e7-2b2e-4b24-b57b-3c911c90db34",
                                                "sense_id": "99eafef8-99e4-36c9-8cf5-2c1299e633c2",
                                                "text": "Une jupe évasée, une crinoline si large que j'entrerai difficilement dans l'autobus et un petit cardigan tout mignon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83b306ad-4434-452a-86a4-b825090fb9de",
                        "source_entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "source_sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                        "source_sense_description": "type of sweater",
                        "target_lang_word": "veste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Sorte de vêtement court et sans basques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7ccd73-d6b6-430c-b09a-e42c32d2ef52",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "— Pourquoi le caches-tu ? avait demandé Hortense. — Il est en veste, avait répliqué la vieille fille en riant."
                                            },
                                            {
                                                "example_id": "8569472d-e39a-49a2-8090-f08f40321623",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Les femmes, très coquettes, revêtent en général le costume traditionnel ; la petite veste très serrée moulant le torse et les bras, passe dans la ceinture d’une culotte flottante."
                                            },
                                            {
                                                "example_id": "1e85cab7-38b9-4c2e-bcdf-d6e92094f0d2",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Elle revint habillée d’un tailleur noir, hyper-sexy, la veste bâillant sur une poitrine à damner un intégriste."
                                            },
                                            {
                                                "example_id": "92638c70-f285-40f9-a49e-bc38b136b84e",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                                            },
                                            {
                                                "example_id": "d54cd077-0827-4e04-b8bd-7177e3045fe4",
                                                "sense_id": "ff0d4735-9f4e-37a5-96ee-7ced6318b39f",
                                                "text": "Il avait l'air ridicule ainsi. […], avec un jean très serré à la taille, il faisait style de défiler sur un podium de mode avec une veste ridiculement trop petite pour lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b7e78f-03bc-32cf-b244-8f7db182d5da",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Chemise à manches longues (ou cardigan) et souvent à fermeture éclair habituellement portée l’hiver."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6324b91b-6a35-39ca-b1ca-7774be02d073",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Échec, déconvenue."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216213e9-c043-483b-9110-6e947ccd96e3",
                                                "sense_id": "6324b91b-6a35-39ca-b1ca-7774be02d073",
                                                "text": "Moi, j’assistais à tout cela en parfait spectateur, car la moindre entame de discussion avec une fille se terminait immanquablement et très rapidement par un snobage, un camouflet, une éconduite, en termes plus crus un vent, une veste ou un râteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f3dd42-4098-35d2-b7c2-411f8076d36a",
                                        "entry_id": "95aabae1-3c02-317d-ba29-05189bdbb6ea",
                                        "glosses": [
                                            "Une des trois ou quatre enveloppes successives du cocon du ver à soie."
                                        ],
                                        "tags": [
                                            "Soierie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323a6d12-b4b0-470e-adaf-e9be4b3830e6",
                                                "sense_id": "c5f3dd42-4098-35d2-b7c2-411f8076d36a",
                                                "text": "Le seul déchet consiste dans les « vestes » ou couches supérieures formées d’un fil de contexture irrégulière que l’on enlève au moment du dévidage."
                                            },
                                            {
                                                "example_id": "8ea7bf94-ecaa-408e-9c63-afeb732ef4f4",
                                                "sense_id": "c5f3dd42-4098-35d2-b7c2-411f8076d36a",
                                                "text": "Ces vestes ne sont ni uniformes, ni complètes, en général ; elles sont plus épaisses à la partie inférieure du cocon, tandis qu’elles sont plus minces et d’un tissu plus lâche à l’extrémité opposée, celle où se trouve le ruban d’attache et qui correspond à la tête de la chrysalide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42823df2-09aa-4b22-baff-b103ad0ff647",
                        "source_entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "source_sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
                        "source_sense_description": "type of sweater",
                        "target_lang_word": "Strickjacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strickjacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                        "entry_id": "32a0b633-078a-33aa-9047-753313dc8ebe",
                                        "glosses": [
                                            "gestrickte Jacke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299425a5-b7ab-4ac9-b1b1-d48adeeaa8a5",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "Weil mein Vater seine Strickjacke tagtäglich trägt, ist sie mittlerweile völlig ausgeleiert."
                                            },
                                            {
                                                "example_id": "7f78e095-ddb4-41fa-b374-c1610540144b",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Aber Dincklages Bursche hatte den Ofen in der Schreibstube geheizt, so daß sie die Strickjacke ausziehen konnte.“"
                                            },
                                            {
                                                "example_id": "6a9f7561-2da9-4a7b-8044-b1b41496d5dc",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Es ist schattig geworden und kühler, die Dame zieht die Ärmel der Strickjacke nach unten.“"
                                            },
                                            {
                                                "example_id": "79d6fcd5-cb80-4a0f-974c-45c5f90a99a0",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Ich roch die muffige Strickjacke und ein süßliches Putzmittel.“"
                                            },
                                            {
                                                "example_id": "814f3f03-5cde-4746-a394-0c81a5540569",
                                                "sense_id": "291c6273-1141-3299-8ce5-90e251622af7",
                                                "text": "„Ich lief in ihr Schlafzimmer und warf die Strickjacke aufs Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11680620-13cf-4a15-ab12-c447ab657555",
                        "source_entry_id": "9acd5873-d88c-3f37-b99d-813c09df8647",
                        "source_sense_id": "c1430bcc-b669-38e8-b639-a79d671f62ad",
