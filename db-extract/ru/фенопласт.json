                                                "example_id": "ef033d34-4ce1-4108-bccc-b2256c437666",
                                                "sense_id": "93239e1c-d3ce-3b97-82f6-09d9472d7bdc",
                                                "text": "Die Eigenschaften von Phenolharz sorgten seit ihrer Entdeckung für eine umfangreiche und weitverbreitete Anwendung."
                                            },
                                            {
                                                "example_id": "ce355a44-3ed9-4d89-9430-270b94e694aa",
                                                "sense_id": "93239e1c-d3ce-3b97-82f6-09d9472d7bdc",
                                                "text": "Phenolharz ist einer der ersten industriell genutzten Kunststoffe, entwickelt 1907, und wird bis heute in vielfältigen Anwendungen eingesetzt."
                                            },
                                            {
                                                "example_id": "91fa43be-2979-4092-a9e0-e3ea3ca569a4",
                                                "sense_id": "93239e1c-d3ce-3b97-82f6-09d9472d7bdc",
                                                "text": "Nur in grauer Vorzeit, in den Anfänger des Billardspieles, wurden Billardkugeln aus Elfenbein gefertigt. Das Material heutzutage ist Phenolharz."
                                            }
