                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0780fea0-207f-496d-ad74-fc248561f946",
                                                "sense_id": "30ff24cf-494c-3db3-b742-0822c342b019",
                                                "text": "Frau Pascal ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9e3b43f8-3e26-4dd2-9e66-b92b6004f6a0",
                                                "sense_id": "30ff24cf-494c-3db3-b742-0822c342b019",
                                                "text": "Herr Pascal wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "11e05817-71b0-4157-a425-60bd8e08d96d",
                                                "sense_id": "30ff24cf-494c-3db3-b742-0822c342b019",
                                                "text": "Die Pascals fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "1f523dc8-c1ad-45e2-b39d-fc38b71dcedc",
                                                "sense_id": "30ff24cf-494c-3db3-b742-0822c342b019",
                                                "text": "Der Pascal trägt nie die Pullover, die die Pascal ihm strickt."
                                            },
                                            {
                                                "example_id": "faba2856-808d-4680-a0de-e605264dfc7f",
                                                "sense_id": "30ff24cf-494c-3db3-b742-0822c342b019",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pascal kommt, geht der Herr Pascal.“"
