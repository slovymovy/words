                ],
                "senses": [
                    {
                        "sense_id": "cfa7a0de-000a-3875-bf8d-fb28e32b71f8",
                        "entry_id": "905afe43-d85a-3e8b-9083-195de5411eeb",
                        "glosses": [
                            "das Tilgen; der Anteil einer Annuitätszahlung, mit dem Kapital zurückgezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c2fdb5-f8e7-4172-95fd-669a4d1d2b92",
                                "sense_id": "cfa7a0de-000a-3875-bf8d-fb28e32b71f8",
                                "text": "Nimm ja keine Hypothek auf, bei der die erste Annuität nur 20 % oder weniger Tilgung enthält – du kommst dein Lebtag nicht ans Ende mit der Rückzahlung!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2e243cbc-000e-3cc2-982e-cb8b2d268433",
                        "entry_id": "905afe43-d85a-3e8b-9083-195de5411eeb",
                        "glosses": [
                            "das Getilgtwerden; Rückzahlen einer Schuld"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bb0945c1-1885-427c-8627-70cdd9cd3def",
                                "sense_id": "2e243cbc-000e-3cc2-982e-cb8b2d268433",
                                "text": "Die Zinsen könnte ich gut zahlen, aber die Tilgung der aufgenommen Schuld erwürgt mich."
                            },
                            {
                                "example_id": "f36bf87d-8e11-4245-9490-aadd0a847b01",
                                "sense_id": "2e243cbc-000e-3cc2-982e-cb8b2d268433",
                                "text": "„Sein Gehalt war nichts, worüber man in Jubel ausbrach, und die Mieteinnahmen seiner Wohnung in Reykjavík flossen größtenteils in die Tilgung des Kredits.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ec9b5539-9dcf-3df1-ba71-9a1bf3c37c09",
                        "entry_id": "905afe43-d85a-3e8b-9083-195de5411eeb",
                        "glosses": [
                            "Auslassung/Beseitigung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "141e59a2-4a6a-416c-8a91-b8ad04d0c5ae",
                                "sense_id": "ec9b5539-9dcf-3df1-ba71-9a1bf3c37c09",
                                "text": "„Die dritte Veränderung schließlich ist die Tilgung fast aller menschlichen Kontakte während der Reise.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
