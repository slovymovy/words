                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6982549-3aea-4cb1-a12b-bdbd7067e4ed",
                                "sense_id": "7ad800c4-77f6-3bf5-8e6a-b681c7b77f26",
                                "text": "Cyclothymiser la souffrance, la vivre à fond pour mieux apprécier l'inéluctable plaisir qui ne va pas manquer de suivre."
                            },
                            {
                                "example_id": "be28869f-5e60-4970-b0fb-eaf05aab6831",
                                "sense_id": "7ad800c4-77f6-3bf5-8e6a-b681c7b77f26",
                                "text": "Mon Dieu dans quelles affres devez vous être en ce moment pour nous cyclothymiser ainsi vos brèves…"
                            },
                            {
                                "example_id": "64ce6f18-beca-46e3-b545-1c4b2e865cc2",
                                "sense_id": "7ad800c4-77f6-3bf5-8e6a-b681c7b77f26",
                                "text": "ah tiens, maintenant il cyclothymise en un seul message."
