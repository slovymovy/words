                        "entry_id": "2993da92-103b-3654-b80c-2b80bb5ad032",
                        "glosses": [
                            "Salz oder Ester der Zyansäure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24f3b8c-2579-43d9-a176-ab74b7cc5cce",
                                "sense_id": "ebf936d1-d932-3c25-a42a-1af1b89a145a",
                                "text": "„Unschädlich bleibt auch eine Beimengung von Zyanat, ferner die Verunreinigung des Bades durch Chlorid.“"
                            },
                            {
                                "example_id": "a4552dbb-a532-42d2-a0a4-c79e441533b1",
                                "sense_id": "ebf936d1-d932-3c25-a42a-1af1b89a145a",
                                "text": "„Eine mögliche Nebenwirkung besteht bei sehr hohen Dosen oder bei der Anwendung über Tage in einer Zyanatvergiftung, da Zyanat beim Metabolismus frei wird und zu einer Blockade der Zytochromoxydase führt.“"
                            }
                        ],
