                                                "sense_id": "da78d14b-8bb7-33d8-9de5-69b8d10ed9e1",
                                                "text": "la vera liberalità si fonda sulla pura conoscenza"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e85efb91-be2f-3149-816c-01f33e77ef7f",
                                        "entry_id": "27388417-2bff-3ccc-9964-6c304200e2ca",
                                        "glosses": [
                                            "condotta comportamentale o valore di chi non è punitivo né presenta eccessi nel permettere qualcosa"
                                        ],
                                        "tags": [],
