                        ],
                        "form": "die Federkleider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                        "entry_id": "1fde6f64-b16e-318d-b608-239a9237ec5c",
                        "glosses": [
                            "die gesamten Federn, die die Haut eines Vogels bedecken"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "0efb66a4-3617-486b-9441-e03fec76b9be",
                                "sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                                "text": "Ihr dichtes Federkleid schützt Vögel vor Kälte."
                            },
                            {
                                "example_id": "a9eeafb0-1a19-4fbf-8b03-8f1a0e3d54c1",
                                "sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                                "text": "Zur Paarungszeit tragen viele männliche Vögel ein besonders prächtiges Federkleid."
                            },
                            {
                                "example_id": "4dc368ab-570b-480c-a6c6-a6d0c2d7cfbf",
                                "sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                                "text": "„Vögel können gut in der Höhe überleben, weil ihr Federkleid sie warm hält.“"
                            },
                            {
                                "example_id": "5334608e-ef36-4384-8583-7268866a3825",
                                "sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                                "text": "„Am Anfang sah sich das Huhn noch der großen Dunkelheit gegenüber, aber dann begann sich das aufsteigende Licht der jungen Sonne in seinem gelb-weißen Federkleid und im dunklen Asphalt zu spiegeln, und das Huhn untersuchte ihn prüfend mit seinen bernsteinfarbenen Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56bdd3ef-ffb1-4ab4-9606-807e20de92f5",
                        "source_entry_id": "1fde6f64-b16e-318d-b608-239a9237ec5c",
                        "source_sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                        "source_sense_description": "gehoben: die gesamten Federn, die die Haut eines Vogels bedecken",
                        "target_lang_word": "plumage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plumage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                                        "entry_id": "f26db4ef-ccf1-302d-be71-bc395f61298d",
                                        "glosses": [
                                            "Layer or collection of feathers covering a bird’s body; feathers used ornamentally; feathering."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "noun",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96fa68b-b3c9-41ae-983d-5f10b120d2ca",
                                                "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                                                "text": "Somewhat like a heron she was, but stouter, and shorter of leg, and her beak shorter and thicker than the heron’s; and so long and delicate was her pale gray plumage that hard it was to say whether it were hair or feathers."
                                            },
                                            {
                                                "example_id": "f8eae1ea-6cd5-4a7b-a4c3-ae5d83e8ade5",
                                                "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                                                "text": "[Owner]: No no he's not dead, he's, he's restin'! Remarkable bird, the Norwegian Blue, idn'it, ay? Beautiful plumage!\n[Mr. Praline]: The plumage don't enter into it. It's stone dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510b4cbc-d2b6-3147-bfc6-8aec7a4ec0f3",
                                        "entry_id": "f26db4ef-ccf1-302d-be71-bc395f61298d",
                                        "glosses": [
                                            "Finery or elaborate dress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e0e00b9-dc51-4e73-be2b-0494181db994",
                        "source_entry_id": "1fde6f64-b16e-318d-b608-239a9237ec5c",
                        "source_sense_id": "29c73ede-29ee-3535-9853-4c92dfd47ba2",
                        "source_sense_description": "gehoben: die gesamten Federn, die die Haut eines Vogels bedecken",
                        "target_lang_word": "plumage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plumage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4f8b0d-0dec-3641-b34c-0901e0b94354",
                                        "entry_id": "0a91de43-9f27-3407-86ed-a06ae9c73639",
                                        "glosses": [
                                            "Ensemble des plumes du corps d’un oiseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a620ec7d-5b60-49af-b535-df31c6601c2f",
                                                "sense_id": "5e4f8b0d-0dec-3641-b34c-0901e0b94354",
                                                "text": "Deux cents coqs spécialement élevés pour les qualités naturelles de leur plumage, servant à confectionner des mouches artificielles […] sont exposés et soumis à l’œil expert d'un jury."
                                            },
                                            {
                                                "example_id": "c7a70e04-ad53-4876-a1f6-849ea3ca69ce",
                                                "sense_id": "5e4f8b0d-0dec-3641-b34c-0901e0b94354",
                                                "text": "Un roitelet huppé au plumage similaire aux feuilles de l’arbre, saisi sur le vif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6c2418-6fd8-3aeb-94c3-eb621a1cb326",
                                        "entry_id": "0a91de43-9f27-3407-86ed-a06ae9c73639",
                                        "glosses": [
                                            "Ces plumes portées pour l’ornement des hommes et des femmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97c2a9db-fcb7-4a38-be3c-af5b3ce84399",
                                                "sense_id": "3d6c2418-6fd8-3aeb-94c3-eb621a1cb326",
                                                "text": "Mais que je te voie reprendre le costume de tes ancêtres anglais ; pas de manteau court, pas de bonnet pimpant, pas de plumage fantasque dans ma modeste maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2973ebe3-bdbb-3594-b4e8-93188669a95f",
                                        "entry_id": "0a91de43-9f27-3407-86ed-a06ae9c73639",
                                        "glosses": [
                                            "Récolte de certains végétaux à gousses par séparation d’avec les feuilles et de la tige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc6c7de4-ea5a-4a39-b2b1-4e615e09bc10",
                                                "sense_id": "2973ebe3-bdbb-3594-b4e8-93188669a95f",
                                                "text": "Le plumage des haricots coco se fait exclusivement à la main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
