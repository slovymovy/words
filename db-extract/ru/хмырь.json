                            },
                            {
                                "target_word": "jerk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88b689a6-bc72-3227-b96e-7b14c6eb7847",
                                        "entry_id": "842dc0be-2175-376f-bae8-b19ba2b93019",
                                        "glosses": [
                                            "A rich, spicy Jamaican marinade."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Jamaica",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631a2066-9ec8-4776-9cc0-353960997f6c",
                                                "sense_id": "88b689a6-bc72-3227-b96e-7b14c6eb7847",
                                                "text": "Sunshine ranks high in the island's greates burger debate, while the chicken egg rolls with mango chutney and jerk mayo and fabulous fish tacos elevate pub grub to an art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ffa4a1-10a6-3c8a-87f0-fbf19fc561e3",
                                        "entry_id": "842dc0be-2175-376f-bae8-b19ba2b93019",
                                        "glosses": [
                                            "Meat (or sometimes vegetables) cured by jerking, in which it is coated in spices and slow-cooked over a fire or grill traditionally composed of green pimento wood positioned over burning coals; charqui."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Jamaica",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b11d9fa-d5ce-446e-9cde-babde14cfd69",
                                                "sense_id": "55ffa4a1-10a6-3c8a-87f0-fbf19fc561e3",
                                                "text": "Jerk chicken is a local favorite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jerk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "493e39fd-1bf5-3338-9404-5d1ed741b453",
                                        "entry_id": "46514d97-e274-3023-9809-54db29513e60",
                                        "glosses": [
                                            "To cure (meat) by cutting it into strips and drying it, originally in the sun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9726fc9b-6643-47fa-b523-be023550f09b",
                                                "sense_id": "493e39fd-1bf5-3338-9404-5d1ed741b453",
                                                "text": "Snow stalled him in the timber; his food was all but gone when he managed to kill an antelope and jerk a supply of venison."
                                            },
                                            {
                                                "example_id": "801eb4e7-03f4-457e-95b0-dcaf28a9bf87",
                                                "sense_id": "493e39fd-1bf5-3338-9404-5d1ed741b453",
                                                "text": "The Lemakot in the north strangled widows and threw them into the cremation pyres of their dead husbands. If they defeated potential invaders the New Irish hanged the vanquished from banyan trees, flensed their windpipes, removed their heads, left their intestines to jerk in the sun."
                                            },
                                            {
                                                "example_id": "4875d745-a8d2-44d4-88ac-615fd2cbdb1a",
                                                "sense_id": "493e39fd-1bf5-3338-9404-5d1ed741b453",
                                                "text": "This longtime West End eatery prepares chicken the way locals like it: curried, fried, jerked, and baked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
