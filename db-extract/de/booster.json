                                "sense_id": "7d7afe3b-883a-3683-9d78-db9639b1bd44",
                                "text": "Es gibt schon einige Eigenschaften, die bei jedem Job und bei jedem Unternehmen als Booster der Karriere funktionieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98c97d5c-c595-349f-a4f2-b3d2e2dd9f77",
                        "entry_id": "101d00ad-2999-3aa2-a0e4-d054a7a9a7b0",
                        "glosses": [
                            "zweite oder weitere Impfung, die eine Erstimpfung in ihrer Wirksamkeit verstärkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e5e01c-09ed-4fce-8661-ed17e60cf137",
                                "sense_id": "98c97d5c-c595-349f-a4f2-b3d2e2dd9f77",
                                "text": "Die zweite Impfung nach der Initialimpfung, der Booster, sorgt für einen länger anhaltenden Schutz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
