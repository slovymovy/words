                        ]
                    },
                    {
                        "sense_id": "cca74958-d499-3738-b05c-5047c58879f6",
                        "entry_id": "81167367-e8df-3869-ba21-5d8658c80894",
                        "glosses": [
                            "The act of enacting, or the state of being enacted.",
                            "The act of making (a bill) into law."
