                "senses": [
                    {
                        "sense_id": "43da5bb9-4f67-3591-9712-e4e1596f98c1",
                        "entry_id": "035805f1-b198-3f79-81de-a87623c06d8e",
                        "glosses": [
                            "het belangrijkste onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab568c2-a5ed-4b01-b139-3ff6db1e940c",
                                "sense_id": "43da5bb9-4f67-3591-9712-e4e1596f98c1",
                                "text": "Malik Obama deed enkele jaren geleden nog mee aan de gouverneursverkiezingen in Kenia. Zijn hoofdthema was toen ,,verandering\", net zoals zijn broer had gepredikt tijdens zijn presidentiële campagne."
                            },
                            {
                                "example_id": "e98bba1d-0f70-4da1-92b6-08fb6df078ea",
                                "sense_id": "43da5bb9-4f67-3591-9712-e4e1596f98c1",
                                "text": "De Italiaanse gastheren hadden de bijeenkomst van de westerse economische grootmachten en Japan willen aangrijpen om extra aandacht te vestigen op een humanitair drama voor de deur: de migrantenstroom uit Afrika. Door de top te houden op Sicilië waar regelmatig slachtoffers van de mensenhandel aanspoelen en ook door een viertal Afrikaanse leiders uit te nodigen als gasten leek het hoofdthema onomstreden."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4be24fd-c260-3e84-8646-b9e59cb84e00",
                        "entry_id": "035805f1-b198-3f79-81de-a87623c06d8e",
                        "glosses": [
                            "belangrijkste melodie van een muziekstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64deb895-ddcd-46b9-baea-346bb749868c",
                                "sense_id": "c4be24fd-c260-3e84-8646-b9e59cb84e00",
                                "text": "Gebouw Odeon in Vriezenveen vormde vrijdag het toneel van de opnames van de leader, het muzikale hoofdthema voor de musical Het Verzet Kraakt. Het door Jan Tekstra geschreven en door Jos Pijnappel gearrangeerde muziekstuk werd gespeeld door de Vriezenveense Harmonie."
                            }
                        ]
                    }
