                ],
                "senses": [
                    {
                        "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                        "entry_id": "472f2721-5ace-34a3-b2da-ea9226da7da0",
                        "glosses": [
                            "historische Region im äußersten Westen der heutigen Ukraine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e08c07e6-2719-4cdd-8e8b-0d6d4deba57f",
                                "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                                "text": "„Er war Minister in einer Regierung der Karpatenukraine.“"
                            },
                            {
                                "example_id": "81513919-b391-4d30-8820-fbd4f90e6522",
                                "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                                "text": "„Nach der Auflösung der österreichisch-ungarischen Monarchie eröffneten sich auch der Karpatenukraine neue Aussichten.“"
                            },
                            {
                                "example_id": "c8661e39-7974-46c9-9224-494950938186",
                                "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                                "text": "„Darauf antwortete die Regierung der Karpatenukraine mit Proklamierung voller staatlicher Unabhängigkeit und rief die Bevölkerung zur Verteidigung des Landes auf.“"
                            },
                            {
                                "example_id": "e357327b-b93b-464e-92e3-efd6289c9057",
                                "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                                "text": "„Das viertstärkste nationale Bevölkerungselement waren die Ungarn oder Magyaren, die in der südlichen Slowakei und in der Karpatenukraine ihre Siedlungen hatten.“"
                            },
                            {
                                "example_id": "99a57133-e7fc-41b2-8cef-3b5d365f0385",
                                "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                                "text": "„Eine deutlich andere Situation herrschte in der Karpatenukraine, wo 14,5% der Schüler jüdischer Nationalität und 14,7% Kinder jüdischen Glaubens die Volksschule besuchten.“"
                            },
                            {
                                "example_id": "4b55cef0-a26e-4186-b3ac-18eb702e391e",
                                "sense_id": "6329aea8-2086-3d28-a4db-9480cdf589b4",
                                "text": "„Kulturell war die Karpatenukraine für Tschechen und Slowaken ein unbekanntes, exotisches Terrain, das es erst noch richtig zu erkunden galt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
