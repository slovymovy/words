                                "sense_id": "4bd52413-c991-37e7-a884-0e66f415c99e",
                                "text": "\"I's growing so big now, mamma,\" said she, coaxingly, \"don't you spect I must have some tea?\""
                            },
                            {
                                "example_id": "5aa5eafe-e203-4e36-937f-91e4f0ca4528",
                                "sense_id": "4bd52413-c991-37e7-a884-0e66f415c99e",
                                "text": "Looks like rain, Elder; I 'spect she'll have to go over with me arter all,\" said George Thayer, the handsomest, best-natured stage-driver in the whole State of New Hampshire."
                            },
                            {
                                "example_id": "6810a3b9-b7d7-4972-915c-18a8bd11a6ed",
                                "sense_id": "4bd52413-c991-37e7-a884-0e66f415c99e",
                                "text": "We didn' 'spect Marse Wes to bring home a wife whenas he lef', but that ain' no sign that it ain' a mighty fine thing.\""
                            },
                            {
                                "example_id": "8427887a-211c-46ea-87b6-5faed2ea84c3",
                                "sense_id": "4bd52413-c991-37e7-a884-0e66f415c99e",
                                "text": "I'm comin' home, I know I'm overdue\nSpect me any day now real soon"
                            },
                            {
                                "example_id": "844a3411-7b56-4b0f-885c-125d2aeb2866",
                                "sense_id": "4bd52413-c991-37e7-a884-0e66f415c99e",
                                "text": "With global warming, you may need sweat towels more than you currently 'spect."
                            }
                        ]
