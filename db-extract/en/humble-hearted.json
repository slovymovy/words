                        "glosses": [
                            "Meek; humble; unassuming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63063a7-7c37-4a97-a838-054c7822d996",
                                "sense_id": "2ddf7f8b-d058-30ef-9dbd-778b7bde1be4",
                                "text": "Old hags many of them were, dried and brown and wrinkled, kerchiefed and short-petticoated, with thick wool stockings on their bony shanks, stumping through the glittering thoroughfares, looking neither to the right nor the left, bent on duty, envying nothing, humble-hearted, remote;"
                            },
                            {
                                "example_id": "7115a304-42b8-4d21-a288-1cbffc4520aa",
                                "sense_id": "2ddf7f8b-d058-30ef-9dbd-778b7bde1be4",
                                "text": "Or perhaps 'I am overawed by your undistinguished, humble-spirited, humble-minded, humble-hearted, humble-looking humility, which humbly shines . . .'?\""
                            },
                            {
                                "example_id": "8e67c110-e9a6-4676-b446-21fdb2c81884",
                                "sense_id": "2ddf7f8b-d058-30ef-9dbd-778b7bde1be4",
                                "text": "Too slick for what Phil liked to call Andy's \"humble-hearted\" style. \"We'll make a suit-and-tie man out of you yet,\" the senator had said once, half in jest."
                            }
                        ]
                    }
