                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f26155a-0cef-4104-a240-e57ee0b173ef",
                                                "sense_id": "a314e490-8c1a-3986-97a0-b8e0ef65fee8",
                                                "text": "Das ZDF hat die fertige Produktion ins Ausland verkauft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d5a013e2-e7be-369d-a8e8-a8539fa437a0",
                                        "entry_id": "61f22f39-14a4-3e58-a055-3e4a8b91a586",
                                        "glosses": [
