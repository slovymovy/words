                        "glosses": [
                            "Politique de George Bush ou de George W. Bush."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e983699-cee7-42d2-910e-6f29fb32a036",
                                "sense_id": "cb08b6cc-9708-399e-a1f7-4e35d83693bb",
                                "text": "Le bushisme, radioscopie d'un désastre."
                            },
                            {
                                "example_id": "84a73734-04b1-4c7a-8092-63fc28504054",
                                "sense_id": "cb08b6cc-9708-399e-a1f7-4e35d83693bb",
                                "text": "Surtout, il a succombé à la séduction trouble du bushisme, accompagnant l’aventure irakienne, couvrant les mensonges et les abus de l’administration américaine, y compris la torture."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa332072-d8b1-37b7-9e6a-6b4062aa74c5",
                        "entry_id": "6749afe3-55d8-36df-89ef-54a16aa303f2",
                        "glosses": [
                            "Phrase sans sens ou grammaticalement incorrecte prononcée par le président américain George W. Bush."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59aecf72-c949-4bb4-bf3f-f25364ffae3d",
                                "sense_id": "aa332072-d8b1-37b7-9e6a-6b4062aa74c5",
                                "text": "Un exemple de bushisme : Nous sommes prêts pour tout événement imprévu qui pourrait ne pas se produire."
                            },
                            {
                                "example_id": "d44b6b7d-fc18-4730-ad38-59f2b6fdd9ca",
                                "sense_id": "aa332072-d8b1-37b7-9e6a-6b4062aa74c5",
                                "text": "Un nouveau dictionnaire des bushismes est paru cette année."
                            }
                        ]
                    }
