                "senses": [
                    {
                        "sense_id": "a3ef5aeb-3ba2-3058-b65a-aa9a1eafc5e5",
                        "entry_id": "c76d2d93-4afa-3bf2-aa98-24d8cfb363ee",
                        "glosses": [
                            "Copier pour réaliser une expédition (au sens juridique du terme)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b6d9ce-eccc-4a76-b7ec-e266c583b422",
                                "sense_id": "a3ef5aeb-3ba2-3058-b65a-aa9a1eafc5e5",
                                "text": "Nous avions pendant dix ans, expéditionné, collationné, rédactionné coude a coude, sans trop nous abrutir, il est vrai, à ce travail mécanique, qui laissait à nos facultés intellectuelles toute liberté de s’exercer parallèlement sur des sujets plus attrayants."
                            },
                            {
                                "example_id": "1e9685d1-9d13-48fe-8b31-073c4b87793b",
                                "sense_id": "a3ef5aeb-3ba2-3058-b65a-aa9a1eafc5e5",
                                "text": "Moi, qui ai tant de plaisir à juger, classer, rédiger, calculer, expéditionner !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e87282de-58f0-3cd3-8214-edd5add54f33",
                        "entry_id": "c76d2d93-4afa-3bf2-aa98-24d8cfb363ee",
                        "glosses": [
                            "Participer à une expédition militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b36c46-42b1-4d8e-8205-47bdd10fd52f",
                                "sense_id": "e87282de-58f0-3cd3-8214-edd5add54f33",
                                "text": "Parti du camp de Bayonne pour Valladolid le 10 août 1810, il fit partie du 9e corps chargé d’expéditionner sur les derrières de l’armée de Masséna, pour chasser les insurgés qui dévastaient la Biscaye, la Navarre et le Santander."
                            }
                        ]
                    }
