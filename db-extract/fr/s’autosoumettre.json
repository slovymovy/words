                "senses": [
                    {
                        "sense_id": "180af385-3f4c-36fb-9f47-d7d75c13307e",
                        "entry_id": "6e3272c8-18fa-391d-bf54-2933b0c29a46",
                        "glosses": [
                            "Se soumettre de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03c75b6-3447-494b-bb9d-712b1a9e724f",
                                "sense_id": "180af385-3f4c-36fb-9f47-d7d75c13307e",
                                "text": "Je vais m'autosoumettre (c'est un truc masochiste ça?) à un questionnaire inspiré des écrits de House."
                            },
                            {
                                "example_id": "38c0d44a-3c31-4242-8c87-e5f60eec99c3",
                                "sense_id": "180af385-3f4c-36fb-9f47-d7d75c13307e",
                                "text": "Mais aujourd'hui l'Homme préfère s'autosoumettre face à l'exploitation, l'ordre mondial et le capitalisme."
                            },
                            {
                                "example_id": "65c5f4f8-283b-4cba-8715-6af8de5c6672",
                                "sense_id": "180af385-3f4c-36fb-9f47-d7d75c13307e",
                                "text": "Vais donc me résoudre à ne pas aller à la super soirée Electro jazz prévue samedi soir, et m'autosoumettre à une discipline de fer."
                            }
                        ]
                    }
