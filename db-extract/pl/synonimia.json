                                    },
                                    {
                                        "sense_id": "45a9a365-6478-32bb-bd68-56a13b126117",
                                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                                        "glosses": [
                                            "The state of not being the name to be used, of being a synonym."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ffa303-2807-44d8-81a8-85964a6668ad",
                                                "sense_id": "45a9a365-6478-32bb-bd68-56a13b126117",
                                                "text": "sink into synonymy"
                                            },
                                            {
                                                "example_id": "1586328c-8e5f-4dee-9900-aa0818ee7dbe",
                                                "sense_id": "45a9a365-6478-32bb-bd68-56a13b126117",
                                                "text": "In 1924 this name was reduced to synonymy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75152be4-24dc-32c0-9bcc-ca0b05e755e4",
                                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                                        "glosses": [
                                            "A group or list of synonyms."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd1de42-1759-4cf7-9204-fd29f41e1bed",
                                                "sense_id": "75152be4-24dc-32c0-9bcc-ca0b05e755e4",
                                                "text": "The synonymy of Tachina is extensive."
                                            },
                                            {
                                                "example_id": "e6a7ff7e-58b2-4da4-9b3d-d07729b013f6",
                                                "sense_id": "75152be4-24dc-32c0-9bcc-ca0b05e755e4",
                                                "text": "Descriptions are followed by a synonymy of the names that have been applied in the literature ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7e9cc22-129c-4552-a546-a946c63cbc6e",
                        "source_entry_id": "d1005a15-73e5-369b-9671-fa2316ff7fde",
                        "source_sense_id": "26e2b7a8-6135-3380-b9d7-300b3344124c",
                        "target_lang_word": "synonymie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synonymie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c01f5a4-7378-3a72-a2bc-f03782f6bf19",
                                        "entry_id": "ceba953b-2992-3b37-b108-ea8447cf00cf",
                                        "glosses": [
                                            "Caractère de ce qui est synonyme. Relation entre deux ou plusieurs signifiants, telle que ces signifiants sont interchangeables, sans qu’il y ait variation concomitante du signifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaad7fbe-5230-43e1-986c-8878841be2a6",
                                                "sense_id": "5c01f5a4-7378-3a72-a2bc-f03782f6bf19",
                                                "text": "La synonymie des deux mots courroux et colère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68b9d18-23f9-3be0-9696-8965fef6f880",
                                        "entry_id": "ceba953b-2992-3b37-b108-ea8447cf00cf",
                                        "glosses": [
                                            "Figure de rhétorique qui exprime la même chose par des synonymes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85acc2e9-8eba-3b41-9338-c4b24d5aaee1",
                                        "entry_id": "ceba953b-2992-3b37-b108-ea8447cf00cf",
                                        "glosses": [
                                            "Rapprochement, concordance des divers noms qui ont été donnés à un même animal, à une même plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b35bc2fc-fa69-4a2f-aaef-128ca7a2468e",
                                                "sense_id": "85acc2e9-8eba-3b41-9338-c4b24d5aaee1",
                                                "text": "Le genre Dufourea Ach, a eu le défaut d’être homonyme d’un Dufourea Bory désignant des phanérogames, et, lichénologiquement, celui d’être mal défini ; en effet, sa synonymie nous donne les espèces suivantes : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7ab9789-0eb7-446b-9fd8-7bc9751c78c8",
                        "source_entry_id": "d1005a15-73e5-369b-9671-fa2316ff7fde",
                        "source_sense_id": "26e2b7a8-6135-3380-b9d7-300b3344124c",
                        "target_lang_word": "Synonymie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Synonymie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ded623eb-f9d6-3884-83e9-f0138a8f2be8",
                                        "entry_id": "c5df299b-d764-3ad2-a1bb-628b69b3a187",
                                        "glosses": [
                                            "semantische Beziehung zwischen Wörtern, welche die gleichen Bedeutungen aufweisen (Synonyme)"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7f3be4-f6f2-44b6-8acd-3c105f1c4657",
                                                "sense_id": "ded623eb-f9d6-3884-83e9-f0138a8f2be8",
                                                "text": "Synonymie besteht zwischen den Wörtern „Apfelsine“ und „Orange“: Sie bedeuten dasselbe."
                                            },
                                            {
                                                "example_id": "0027b5ce-eed8-4b47-94e5-193b6526b0f5",
                                                "sense_id": "ded623eb-f9d6-3884-83e9-f0138a8f2be8",
                                                "text": "„Totale Synonymie setzt per definitionem uneingeschränkte Austauschbarkeit der betreffenden Ausdrücke in allen Kontexten voraus und bezieht sich sowohl auf denotative (…) als auch konnotative (…) Bedeutungselemente.“"
                                            },
                                            {
                                                "example_id": "f9d6c420-50df-4dfe-aecd-ba7f663cc70b",
                                                "sense_id": "ded623eb-f9d6-3884-83e9-f0138a8f2be8",
                                                "text": "„Schließlich sind auch die semantischen Relationen im Wortschatz, wie Synonymie, Antonymie, Hierarchiebeziehungen unter soziolinguistischem Aspekt zu betrachten…“"
                                            },
                                            {
                                                "example_id": "34ab9768-20ee-4e1c-a462-f7dc6774f17a",
                                                "sense_id": "ded623eb-f9d6-3884-83e9-f0138a8f2be8",
                                                "text": "„Zu den paradigmatischen Angaben gehören unter anderen Synonymie, Antonymie, Hyponymie, Hyperonymie, Komplenymie und Meronymie.“"
                                            },
                                            {
                                                "example_id": "5cced2eb-4a2a-4b50-b069-203e5f680959",
                                                "sense_id": "ded623eb-f9d6-3884-83e9-f0138a8f2be8",
                                                "text": "„Über die Synonymie von Wort und Paraphrase entscheidet oft der Linguist in Individualintrospektion, die nur bei Annahme der Gleichheit der lexikalischen Kompetenz des Linguisten als eines muttersprachlichen Sprechers mit dem lexikalischen System der betreffenden Sprache einen Aussagewert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c181ca-867d-4760-abbe-d28420af41b5",
                        "source_entry_id": "d1005a15-73e5-369b-9671-fa2316ff7fde",
                        "source_sense_id": "26e2b7a8-6135-3380-b9d7-300b3344124c",
                        "target_lang_word": "синонимия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "синонимия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6f83b4-6ecd-3459-a123-1183d9a2b483",
                                        "entry_id": "46d6888e-34f5-351f-a7ab-bfc90f3e271c",
                                        "glosses": [
                                            "лингв. одинаковость или сходство значения различных слов или других однородных языковых единиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6b97f6-cb7f-4f34-bf93-26c2b059f447",
                                                "sense_id": "0f6f83b4-6ecd-3459-a123-1183d9a2b483",
                                                "text": "Упорядочить на единой основе большое число парадигматических лексико-семантических отношений между лексемами, таких, как синонимия, конверсия, антонимия, гиперонимия, регулярная деривация и т. п."
                                            },
                                            {
                                                "example_id": "4712978f-7868-44e0-b2ef-dc8df36a10e9",
                                                "sense_id": "0f6f83b4-6ecd-3459-a123-1183d9a2b483",
                                                "text": "Основными особенностями текстовой классификации являются высокая размерность признакового пространства, эллипсность (пропуски подразумеваемых слов), синонимия и многозначность терминов, а также субъективность при оценке результатов группирования текстов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22d85a98-8ebb-3cf2-81e8-df25660e8694",
                                        "entry_id": "46d6888e-34f5-351f-a7ab-bfc90f3e271c",
                                        "glosses": [
                                            "филол. приём ораторской речи, состоящий в употреблении синонимов рядом или близко один от другого"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
