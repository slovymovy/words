                "senses": [
                    {
                        "sense_id": "be3e2f3a-84a2-356c-9583-b5a644401417",
                        "entry_id": "f5f6b48c-8ed5-3e3c-8ca1-60ca14778bfa",
                        "glosses": [
                            "Bote, mit dessen Hilfe etwas an eine bestimmte Adresse gesandt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3904be6-7397-4663-afdc-a78fcd2a2a0e",
                                "sense_id": "be3e2f3a-84a2-356c-9583-b5a644401417",
                                "text": "„Da kam plötzlich ein berittener Sendbote in schwarzer Kleidung mit einem Paket unter dem Arme herangesprengt, das Antlitz schweißüberströmt vor Eile.“"
                            },
                            {
                                "example_id": "e56f47fa-cc29-4fb6-970d-482dd1ceff50",
                                "sense_id": "be3e2f3a-84a2-356c-9583-b5a644401417",
                                "text": "„Ich sagte, daß Adrian an den Ort, wohin ein frecher Sendbote ihn verschleppt, zurückkehrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
