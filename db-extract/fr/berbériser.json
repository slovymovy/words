                ],
                "senses": [
                    {
                        "sense_id": "b23ea972-a254-376c-a7f0-3dac15fc32ea",
                        "entry_id": "e7eb2aa1-945f-39f2-ba55-49f9d3f65999",
                        "glosses": [
                            "Donner un caractère berbère à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5cba127-866f-40f7-8412-5978b994d60d",
                                "sense_id": "b23ea972-a254-376c-a7f0-3dac15fc32ea",
                                "text": "Un fils du fils du Berbère en question, bégayeur de latin, vendeur de figues et d'olives sur le marché qui dit oui à l’Islam à condition qu'il se laisse berbériser ; z’étaient rustres les ancêtres, mais pas trop nigauds."
                            },
                            {
                                "example_id": "e275141e-4fd1-43f9-927e-50bac0074a22",
                                "sense_id": "b23ea972-a254-376c-a7f0-3dac15fc32ea",
                                "text": "L’existence de pratiques identiques chez les Berbères eux-mêmes facilitaient encore le processus (on vit même, exceptionnellement, des tribus d'origine arabe se berbériser !)."
                            },
                            {
                                "example_id": "1275097c-aba5-4f12-b0aa-38010c2962ba",
                                "sense_id": "b23ea972-a254-376c-a7f0-3dac15fc32ea",
                                "text": "Le Maghreb s’est « méditerranisé, sinon berbérisé » sur le plan anthropologique."
                            }
                        ]
                    }
                ],
