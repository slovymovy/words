    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                "word": "prettily",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e54efb22-0ed6-4627-9918-bfa9502b2104",
                        "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more prettily"
                    },
                    {
                        "form_id": "89add2c8-1a35-4349-aec6-65b526c2a08e",
                        "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most prettily"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                        "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                        "glosses": [
                            "In a pretty manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a28e4d5-0e85-4df1-9e20-a886c8738ee5",
                                "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                "text": "And thus they were all begging for pancakes, the one more prettily than the other, because they were so hungry, and such good little children."
                            },
                            {
                                "example_id": "c5fc51ee-2077-4a9d-a9fb-b6ce217ae9e4",
                                "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                "text": "St. Lawrence Station is very prettily situated, high cliffs on the left, and the lush vegetation of the Undercliff sloping down to the sea on the right."
                            },
                            {
                                "example_id": "f270896f-4da8-4433-8a46-f9bdd29b5bd6",
                                "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                "text": "The air was clear and scented, the breeze flitted lightly through the tall grass around his cave, the birds were chirruping at each other, the butterflies were flitting about prettily, and the whole of nature seemed to be conspiring to be as pleasant as it possibly could."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0100251-9871-37d2-a1c9-6407774446b8",
                        "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                        "glosses": [
                            "Very badly; terribly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b314fbe-d9c7-4482-acdc-d6b804ce7556",
                                "sense_id": "b0100251-9871-37d2-a1c9-6407774446b8",
                                "text": "“Indeed!” replied he. “Then, my dear Isabella, it is the most extraordinary sort of thing in the world, for in general every thing does give you cold. Walk home!—you are prettily shod for walking home, I dare say. It will be bad enough for the horses.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c13fca6d-c734-43e0-985c-12f7bf2082e9",
                        "source_entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                        "source_sense_description": "in a pretty manner",
                        "target_lang_word": "joliment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joliment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dcc181b-016c-3dba-be0a-c1dae6fb1141",
                                        "entry_id": "c8ff4b49-a9ff-3426-8da1-958aab7f70da",
                                        "glosses": [
                                            "D’une manière jolie ; bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f5864d-d651-4946-88ca-fb5a57bbea81",
                                                "sense_id": "7dcc181b-016c-3dba-be0a-c1dae6fb1141",
                                                "text": "Il fallait la voir regarder, de ses yeux bordés de rouge, les étalages des bas de soie brodés, et les chapeaux joliment chiffonnés, qui, chez les modistes, se dressent fièrement au haut des champignons de palissandre !"
                                            },
                                            {
                                                "example_id": "6a206d53-ca95-4526-a0b1-a425fa4bf966",
                                                "sense_id": "7dcc181b-016c-3dba-be0a-c1dae6fb1141",
                                                "text": "Il y a aussi un espace jouets pour adulte, où toutes sortes de sex-toys nouvelle génération et autres jeux coquins sont joliment présentés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                        "entry_id": "c8ff4b49-a9ff-3426-8da1-958aab7f70da",
                                        "glosses": [
                                            "Beaucoup ; extrêmement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "307eb816-fb14-4746-b9b8-2237fe6b1e3a",
                                                "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                                "text": "Elle l’a, vive Dieu ! sire, fort joliment dagué !"
                                            },
                                            {
                                                "example_id": "96752c97-7d61-401c-bb06-2e6725f31794",
                                                "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                                "text": "— Pourquoi qu’vous prenez pas vot’ fusil, Monsieur ? Il y a joliment des pinsons, dans le parc."
                                            },
                                            {
                                                "example_id": "b0811ef8-652b-44ab-819d-f78521dbe5ec",
                                                "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                                "text": "La veille du mariage, le dernier jour où Alcide dînait en célibataire, la cuisine de Césarine sentait joliment bon."
                                            },
                                            {
                                                "example_id": "5abd9469-ae01-435c-979d-1e2336432d75",
                                                "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                                "text": "« Est-ce que c’est un âne de notre pays ? Ça m’étonnerait joliment. »."
                                            },
                                            {
                                                "example_id": "d21166e7-dfc0-4c89-b751-dd5707265c41",
                                                "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                                "text": "— Ça va la besogne ?\n— Joliment ! répondit-il."
                                            },
                                            {
                                                "example_id": "f40f9c13-d006-4206-a894-4dd16adf2af7",
                                                "sense_id": "dfe83fd0-ddbe-3b03-a647-b97b255a436d",
                                                "text": "Il coupe tout de même joliment bien, mon canif !, a t-il dit, plein d’admiration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
