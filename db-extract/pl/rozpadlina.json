                                    {
                                        "sense_id": "2aec4a87-4cb6-3c92-b05f-69423d45902f",
                                        "entry_id": "20715412-a334-3888-a552-05117ee96489",
                                        "glosses": [
                                            "A long, narrow crack or opening made by breaking or splitting, especially in rock or earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb38ef1-48a0-4d45-ac5f-6365f9d91313",
                                                "sense_id": "2aec4a87-4cb6-3c92-b05f-69423d45902f",
                                                "text": "After Miller's Dale Junction, the main Derby-Manchester line crosses the Wye for the last time and turns north-west up Great Rocks Dale, a natural fissure several miles long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2895cedc-1aec-3be9-a33f-24080f24a72d",
                                        "entry_id": "20715412-a334-3888-a552-05117ee96489",
                                        "glosses": [
                                            "A groove, deep furrow, elongated cleft or tear between body parts or in the substance of an organ."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ab157ec-78fb-3cf4-b8d9-5388ae64a3c9",
                                        "entry_id": "20715412-a334-3888-a552-05117ee96489",
                                        "glosses": [
                                            "A break or slit in tissue usually at the junction of skin and mucous membrane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14fb899f-09de-38cd-a7bc-c7c20ce73457",
                                        "entry_id": "20715412-a334-3888-a552-05117ee96489",
                                        "glosses": [
                                            "A state of incompatibility or disagreement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
