                ],
                "senses": [
                    {
                        "sense_id": "2921d542-4a99-3e77-b5da-33e24079c0de",
                        "entry_id": "6e58c04a-17a9-3f57-a6a8-e33222edc743",
                        "glosses": [
                            "Penser plus ou moins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef124918-0195-450e-8ff8-2c5301190636",
                                "sense_id": "2921d542-4a99-3e77-b5da-33e24079c0de",
                                "text": "Je reste des heures durant à tricoter sur le balcon, à vivoter, à pensoter, le ménage terminé, les formulaires du jour remplis."
                            },
                            {
                                "example_id": "7bc0b240-c3b9-445a-a34d-68ce13ffdb8c",
                                "sense_id": "2921d542-4a99-3e77-b5da-33e24079c0de",
                                "text": "À l’aide de ces jalons, une certaine trajectoire de notre espèce s’est dessinée — et l’espoir est né de saisir d’un coup d’œil l’aventure cérébrale du seul être à pensoter dans l'univers."
                            }
                        ]
                    }
                ],
