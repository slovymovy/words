                "senses": [
                    {
                        "sense_id": "041f51ae-caff-3a48-907d-9d50e80b3914",
                        "entry_id": "3534b549-fc1d-39fc-91dd-f70c9d8f8a2e",
                        "glosses": [
                            "Korrespondent, der über Geschehnisse im Ausland berichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4310f9e9-1e2b-4127-957b-5bc0fa90d374",
                                "sense_id": "041f51ae-caff-3a48-907d-9d50e80b3914",
                                "text": "„»Die heutige Zeremonie«, schrieb ein Auslandskorrespondent, »bedeutet einen größeren Triumph als alle jemals zuvor gefeierten: Mehr nationale Vitalität, mehr Handel, mehr Urbarmachung von Land, mehr Unterdrückung von Bestialität, mehr Friede, mehr Freiheit. Dies ist nicht Überschwänglichkeit, es ist simple Statistik.«“"
                            },
                            {
                                "example_id": "22dde553-9f38-4821-b89d-134ac8065e94",
                                "sense_id": "041f51ae-caff-3a48-907d-9d50e80b3914",
                                "text": "„In manchen Ländern ging es Auslandskorrespondenten rasch an den Kragen, wenn sie den Rest der Welt über gewisse Gräueltaten informieren wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "824c204b-2cb5-46c5-a848-21eadbba79ba",
                        "source_entry_id": "3534b549-fc1d-39fc-91dd-f70c9d8f8a2e",
                        "source_sense_id": "041f51ae-caff-3a48-907d-9d50e80b3914",
                        "source_sense_description": "Korrespondent, der über Geschehnisse im Ausland berichtet",
                        "target_lang_word": "foreign correspondent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foreign correspondent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "057c3e08-e826-3716-a994-1c02fec367fe",
                                        "entry_id": "69218232-6b0b-3063-af17-dd92397f3f3d",
                                        "glosses": [
                                            "A reporter or freelance journalist who is based in a foreign country, and who provides news reports and/or commentary from that place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b941a0d3-f9af-4b69-8de1-f9584a4aa117",
                                                "sense_id": "057c3e08-e826-3716-a994-1c02fec367fe",
                                                "text": "Oscar Vincent spent several years abroad, after graduation, acting as foreign correspondent of his father's paper."
                                            },
                                            {
                                                "example_id": "e3aac9e3-63b2-4ce9-84a7-6b9c54c55030",
                                                "sense_id": "057c3e08-e826-3716-a994-1c02fec367fe",
                                                "text": "\"Couldn't you be foreign correspondent for your newspaper?\"\n\"We've good men in every European capital now. They've no use for more.\""
                                            },
                                            {
                                                "example_id": "ec572302-ed9d-48fc-bbde-d62593fbca6c",
                                                "sense_id": "057c3e08-e826-3716-a994-1c02fec367fe",
                                                "text": "Now that my spell as a foreign correspondent for The New York Times has ended and I’ve come back home—if a place counts as home when you’ve been away for so long—I’ve had some time to think about how Britain and America have changed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cce9fb8-3b3d-3487-87a6-db18dd020527",
                                        "entry_id": "69218232-6b0b-3063-af17-dd92397f3f3d",
                                        "glosses": [
                                            "A clerical employee responsible for communicating with an organization's stakeholders in other countries and for processing transactions involving them; a firm employed by an organization to assume such responsibilities."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631fa06d-6b2d-4486-9c56-20d3f931c212",
                                                "sense_id": "9cce9fb8-3b3d-3487-87a6-db18dd020527",
                                                "text": "When the government, or those who acted under them, contracted with a merchant for a remittance to some foreign country, he would naturally endeavour to pay his foreign correspondent, upon whom he granted a bill, by sending abroad rather commodities than gold and silver."
                                            },
                                            {
                                                "example_id": "cf47319a-eaab-4594-b553-a40d8074fbcf",
                                                "sense_id": "9cce9fb8-3b3d-3487-87a6-db18dd020527",
                                                "text": "The secrets of business—complicated and often dismal mysteries—were buried in his breast, and never came out of their sepulchre, save now and then to scare Joe Scott, or give a start to some foreign correspondent: […]"
                                            },
                                            {
                                                "example_id": "14d0bb2d-5b77-4e44-b883-1a410cb64245",
                                                "sense_id": "9cce9fb8-3b3d-3487-87a6-db18dd020527",
                                                "text": "[F]alling in with one of the partners of the umbrella firm in quest of French silk, he was engaged as foreign correspondent."
                                            },
                                            {
                                                "example_id": "ed1a066b-1f11-4301-b378-55bb946422d1",
                                                "sense_id": "9cce9fb8-3b3d-3487-87a6-db18dd020527",
                                                "text": "The German had resumed his situation as commercial clerk and foreign correspondent to Eckermann & Co."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
