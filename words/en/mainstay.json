{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "491e0b41-7a50-387e-805c-649d36a84eab",
                    "sense_definition": "A chief support or essential foundation upon which something relies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agriculture has always been the economic <w>mainstay</w> of the small island nation.",
                            "target_lang_translations": {
                                "de": "Die Landwirtschaft war schon immer das wirtschaftliche <w>Standbein</w> des kleinen Inselstaates."
                            }
                        },
                        {
                            "text": "For many decades, manufacturing was the primary <w>mainstay</w> of employment in the region.",
                            "target_lang_translations": {
                                "de": "Über viele Jahrzehnte hinweg war die verarbeitende Industrie der wichtigste <w>Stützpfeiler</w> der Beschäftigung in der Region."
                            }
                        }
                    ],
                    "synonyms": [
                        "backbone",
                        "pillar",
                        "bulwark"
                    ],
                    "common_phrases": [
                        "economic mainstay",
                        "mainstay of the economy"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Hauptstütze oder wesentliche Grundlage, auf die sich etwas stützt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "tragende Säule",
                                "target_lang_sense_clarification": "bildlich: unverzichtbare Stütze oder Grundlage"
                            },
                            {
                                "target_lang_word": "Stützpfeiler",
                                "target_lang_sense_clarification": "im übertragenen Sinn als Fundament oder Basis"
                            },
                            {
                                "target_lang_word": "Standbein",
                                "target_lang_sense_clarification": "besonders wirtschaftlich oder beruflich"
                            },
                            {
                                "target_lang_word": "Stütze",
                                "target_lang_sense_clarification": "zentraler Rückhalt oder Unterstützung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8223368-af35-3c69-8804-af382bc56289",
                    "sense_definition": "A person or thing that is a central, reliable, and regular part of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been a <w>mainstay</w> of the community theater company for more than twenty years.",
                            "target_lang_translations": {
                                "de": "Sie ist seit mehr als zwanzig Jahren eine <w>feste Größe</w> der örtlichen Theatergruppe."
                            }
                        },
                        {
                            "text": "Fresh vegetables are a regular <w>mainstay</w> in their daily diet.",
                            "target_lang_translations": {
                                "de": "Frisches Gemüse ist ein fester <w>Bestandteil</w> ihrer täglichen Ernährung."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixture",
                        "staple"
                    ],
                    "common_phrases": [
                        "regular mainstay",
                        "cultural mainstay"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Sache, die ein zentraler, verlässlicher und fester Bestandteil von etwas ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "feste Größe",
                                "target_lang_sense_clarification": "verlässlicher, unverzichtbarer Bestandteil"
                            },
                            {
                                "target_lang_word": "Stütze",
                                "target_lang_sense_clarification": "verlässliche Bezugsperson oder helfende Kraft"
                            },
                            {
                                "target_lang_word": "tragende Säule",
                                "target_lang_sense_clarification": "zentrale Persönlichkeit oder grundlegendes Element"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35a9cadf-baf9-3fd2-8e3f-e687ea6cb948",
                    "sense_definition": "A strong, stabilizing rope extending forward from the top of the mainmast to the base of the foremast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor climbed the rigging to inspect the worn <w>mainstay</w> before the storm hit.",
                            "target_lang_translations": {
                                "de": "Der Matrose kletterte in die Takelage, um das abgenutzte <w>Großstag</w> vor dem Aufziehen des Sturms zu überprüfen."
                            }
                        },
                        {
                            "text": "Heavy tension on the <w>mainstay</w> prevented the central mast from bending backward.",
                            "target_lang_translations": {
                                "de": "Die starke Spannung auf dem <w>Großstag</w> verhinderte, dass sich der Hauptmast nach hinten bog."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein starkes Tau oder Seil, das von der Spitze des Großmasts nach vorne verläuft, um ihn zu stabilisieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Großstag",
                                "target_lang_sense_clarification": "Seemannssprache: Abspannung des Großmasts"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}