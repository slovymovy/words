                        "glosses": [
                            "Densifier plus que la normale, ou de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae37a54a-fd0c-43c1-8c39-1c60505aa78e",
                                "sense_id": "388f4ab2-ca5b-36f1-beb6-5abc3948ac93",
                                "text": "C’est le but du plafond légal de densité, de la taxe départementale d’espaces verts et de la redevance pour création de locaux à usage de bureaux, qui visent à éviter l’édification de bâtiments risquant de surdensifier les centres urbains ou des zones à protéger."
                            },
                            {
                                "example_id": "7ba37e9e-73ab-434b-a64a-85ba0d6d24c8",
                                "sense_id": "388f4ab2-ca5b-36f1-beb6-5abc3948ac93",
                                "text": "Il s’agit de surdensifier le bas pour faire oublier le haut."
                            },
                            {
                                "example_id": "03b33fea-6560-4123-9be5-08f7df6b07bd",
                                "sense_id": "388f4ab2-ca5b-36f1-beb6-5abc3948ac93",
                                "text": "Trop souvent, et toujours pour rentabiliser l’opération, on aura tendance à surdensifier : d’où les tours qui prolifèrent dans ces quartiers."
                            }
                        ]
                    }
