                        "it": [
                            {
                                "target_lang_word": "davvero",
                                "target_lang_sense_clarification": "usato in negazioni rassicuranti (es. 'nee hoor')"
                            },
                            {
                                "target_lang_word": "tranquillo",
                                "target_lang_sense_clarification": "usato per rassicurare"
                            },
                            {
                                "target_lang_word": "certo",
                                "target_lang_sense_clarification": "usato in affermazioni amichevoli (es. 'ja hoor')"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d8483aa-e1d8-384b-8c6d-ab2a12dabc46",
                    "sense_definition": "Een modaal partikel dat nadruk legt op een mededeling, vaak om een tegenstelling, waarschuwing of eigen mening kracht bij te zetten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "modal_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is buiten toch wel erg koud <w>hoor</w>, trek maar een jas aan.",
                            "target_lang_translations": {
                                "en": "It is pretty cold outside <w>mind you</w>, put on a coat.",
                                "ru": "На улице всё-таки очень холодно, <w>имей в виду</w>, надень куртку.",
                                "it": "Fuori fa davvero molto freddo, <w>sai</w>, mettiti un cappotto."
                            }
                        },
                        {
                            "text": "Pas op <w>hoor</w>, die pan soep is gloeiend heet!",
                            "target_lang_translations": {
                                "en": "Watch out <w>though</w>, that pot of soup is piping hot!",
                                "ru": "<w>Смотри</w>, эта кастрюля с супом очень горячая!",
                                "it": "<w>Guarda</w>, quella pentola di zuppa scotta!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "echt wel hoor",
                        "pas op hoor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "typical for spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Modal particle used to emphasize a statement, warning, or opinion",
                        "ru": "Модальная частица, используемая для усиления утверждения, предупреждения или мнения",
                        "it": "Particella modale usata per enfatizzare un'affermazione, un avvertimento o un'opinione"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mind you",
                                "target_lang_sense_clarification": "emphasizing a fact or warning"
                            },
                            {
                                "target_lang_word": "you know",
                                "target_lang_sense_clarification": "emphasizing an opinion"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "имей в виду",
                                "target_lang_sense_clarification": "подчеркивание факта или предупреждения"
                            },
                            {
                                "target_lang_word": "смотри",
                                "target_lang_sense_clarification": "предупреждение"
                            }
                        ],
                        "it": [
                            {
