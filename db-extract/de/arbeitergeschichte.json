                "senses": [
                    {
                        "sense_id": "229194e1-96e9-35f7-8515-952ccf5427ba",
                        "entry_id": "4ea5ef1c-7a33-3f1d-bdcb-d77801fd2f4e",
                        "glosses": [
                            "die Geschichte der Arbeiterbewegung"
                        ],
                        "tags": [
                            "Geschichtswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d81e7deb-e458-4b22-8c0e-cd4b94e247fe",
                                "sense_id": "229194e1-96e9-35f7-8515-952ccf5427ba",
                                "text": "„Die bisherige Interpretation der Arbeitergeschichte auch durch linksstehende Historiker war sehr abstrakt und theoriegetränkt, teilweise auch reduziert auf die Geschichte der Arbeiterbewegung, ohne Interesse an der Kulturgeschichte der Arbeiter und ihrer Bewegung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79057f8f-11d0-3d22-97dd-a98b77943de2",
                        "entry_id": "4ea5ef1c-7a33-3f1d-bdcb-d77801fd2f4e",
                        "glosses": [
                            "eine Geschichte, die im Arbeitermilieu spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea1b21c-f956-4ef1-be93-1e0e78568bac",
                                "sense_id": "79057f8f-11d0-3d22-97dd-a98b77943de2",
                                "text": "„Der Vater ist gestorben, die Freundin weg, dem Werk droht die Schließung; Rodney steckt in üblen Schwierigkeiten. Und was als Arbeitergeschichte begonnen hat, mäandert hinüber in andere Genres: Drama, Drogenkrimi, Rachethriller.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
