        "nl-extract.jsonl": [
            {
                "entry_id": "0ed5577b-7274-34f9-82dd-bd8f38802b54",
                "word": "fiksen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac5dd852-0f47-3c6f-ac29-24a384503043",
                        "entry_id": "0ed5577b-7274-34f9-82dd-bd8f38802b54",
                        "glosses": [
                            "in orde maken / voor elkaar krijgen / oplossen van problemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a465e46-efee-46ec-b6f4-0496006696d4",
                                "sense_id": "ac5dd852-0f47-3c6f-ac29-24a384503043",
                                "text": "Zo gaf het radiostation veel terug, al kost het ook een hoop. „Tot nu toe hebben we alles kunnen fiksen, ook met behulp van de luisteraars als er weer eens ‘een blauwe’ lag [een claim van de fiscus in 2013, red.]” Voor een tientje per maand krijgen luisteraars toegang tot het digitale archief en exclusieve radiomixen. Maar er zijn ook luisteraars die via de website spontaan doneren."
                            }
                        ]
                    },
                    {
                        "sense_id": "845ed291-fcfe-309b-af44-f5b799cbe6cb",
                        "entry_id": "0ed5577b-7274-34f9-82dd-bd8f38802b54",
                        "glosses": [
                            "zorgen dat iets het weer doet als het kapot is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1198755-8a32-4be6-94c7-8b0bb6a96f1a",
                                "sense_id": "845ed291-fcfe-309b-af44-f5b799cbe6cb",
                                "text": "Het is een eenvoudig karretje met een terugtraprem, een bagagerekje en een blauw voorwiel. In dat laatste zit hem de kneep. Aan de blauwe band kun je zien dat het een fiets is van Swapfiets, een idee van een stel Delftse studenten (u begrijpt het blauw). Studenten en fietsen zijn een goede combinatie, weet elke inwoner van een studentenstad. En een slechte. Want ze rijden steevast op barrels: altijd is er wel een band lek, een lamp stuk, en als alles werkt, is hij al snel gestolen. Neem deze zorgen weg voor een vast bedrag per maand en je hebt misschien wel een aardig bedrijfsconcept, dachten de oprichters van Swapfiets. Ze kochten veertig fietsen op Marktplaats die ze verhuurden aan kennissen en vrienden. De belofte: als er iets mis is, breng je hem langs en fiksen wij hem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8defc1e9-c7fc-49c9-90dc-3108ccc522a0",
                        "source_entry_id": "0ed5577b-7274-34f9-82dd-bd8f38802b54",
                        "source_sense_id": "ac5dd852-0f47-3c6f-ac29-24a384503043",
                        "source_sense_description": "in orde maken / voor elkaar brengen",
                        "target_lang_word": "cope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f082dc5-69c9-33b2-8308-effa4e45df2a",
                                        "entry_id": "5c25bfca-c79b-3307-87e3-aa783bc8f310",
                                        "glosses": [
                                            "To deal effectively with something, especially if difficult."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bb5688f-439d-41ef-a0de-78070a124db5",
                                                "sense_id": "8f082dc5-69c9-33b2-8308-effa4e45df2a",
                                                "text": "Chelsea were coping comfortably as Liverpool left Luis Suarez too isolated. Steven Gerrard was also being forced to drop too deep to offer support to the beleaguered Jay Spearing and Jordan Henderson rather than add attacking potency alongside the Uruguayan."
                                            },
                                            {
                                                "example_id": "ffd149e2-0cdf-484a-a31a-00c828fc59af",
                                                "sense_id": "8f082dc5-69c9-33b2-8308-effa4e45df2a",
                                                "text": "Phyllida Barlow, the sculptor representing the UK at the Venice Biennale, has said that while it may have taken the art world decades to pay attention to her work, the timing of her recognition was perfect, adding: “20 years ago, I wouldn’t have coped.”"
                                            },
                                            {
                                                "example_id": "a9c57855-17ed-426e-bc6a-97e655b8c299",
                                                "sense_id": "8f082dc5-69c9-33b2-8308-effa4e45df2a",
                                                "text": "From transport to zoos: how UK services coped in the sweltering heat [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72bf662-7f4e-388a-86fc-e90b036f664e",
                                        "entry_id": "5c25bfca-c79b-3307-87e3-aa783bc8f310",
                                        "glosses": [
                                            "To cut and form a mitred joint in wood or metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03b5c413-1967-3660-a8ab-7d337cab2545",
                                        "entry_id": "5c25bfca-c79b-3307-87e3-aa783bc8f310",
                                        "glosses": [
                                            "To clip the beak or talons of a bird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f60a61f3-8fb2-457e-86a2-bc2b56c501a0",
                                                "sense_id": "03b5c413-1967-3660-a8ab-7d337cab2545",
                                                "text": "the beak and talons should be closely coped"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1750c583-b119-3f18-b03e-37710b336b1f",
                                        "entry_id": "4ddd9d72-5a42-3b42-b0af-016521bad496",
                                        "glosses": [
                                            "A coping mechanism or self-delusion one clings to in order to endure a hopeless situation."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac38f18-98ad-4cd7-aab0-5478d640fb03",
                                                "sense_id": "1750c583-b119-3f18-b03e-37710b336b1f",
                                                "text": "There was some public grousing about the number of white supremacists attempting to recruit, however; some incels argued that white supremacy was just another \"cope\"–just another self-deluding attempt to cover over the grim truth of the blackpill."
                                            },
                                            {
                                                "example_id": "70680b30-cff0-4364-88cd-579110a70a86",
                                                "sense_id": "1750c583-b119-3f18-b03e-37710b336b1f",
                                                "text": "My only 2 copes for the past 3 years have been food & the internet/surfing. Both of these copes have only hurt me further as I have addictions to both sugar and the internet now and have isolated myself further and further into the oblivion."
                                            },
                                            {
                                                "example_id": "d3131166-d779-4ee8-a3fb-5435cf07852b",
                                                "sense_id": "1750c583-b119-3f18-b03e-37710b336b1f",
                                                "text": "Just as it sounds, a Gymcel is an incel who goes to the gym a lot, which in their mind is a cope."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58bc10d8-3718-3b8f-b08e-6ce680c2c397",
                                        "entry_id": "4c468d8e-45a6-3bd0-a8f9-5279dd1d00d4",
                                        "glosses": [
                                            "An expression of spite towards someone who suffered a setback."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aad5e71-aa92-4e78-aee2-290edaf02602",
                                                "sense_id": "58bc10d8-3718-3b8f-b08e-6ce680c2c397",
                                                "text": "\"The other guy cheated, I had no chance!\" \"Cope.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "527fc53c-3240-390f-bdbb-845541f4a2ca",
                                        "entry_id": "4c468d8e-45a6-3bd0-a8f9-5279dd1d00d4",
                                        "glosses": [
                                            "A contemptuous dismissal, implying that someone should deal with some problem on their own and that the speaker will not engage any further."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60a36f3e-0828-3b6d-9958-f48d90be232d",
                                        "entry_id": "ad4a049e-c74e-3a3d-8484-71d8ed7da11c",
                                        "glosses": [
                                            "A long, loose cloak worn by a priest, deacon, or bishop when presiding over a ceremony other than the Mass."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8092c3-1e5c-4cc8-8619-b9e597f7c576",
                                                "sense_id": "60a36f3e-0828-3b6d-9958-f48d90be232d",
                                                "text": "[…] there went firſt 160 Prieſts, all in their Copes, eight Biſhops next, […]"
                                            },
                                            {
                                                "example_id": "fe2e24df-559b-40ae-ab1a-632c21ace8a9",
                                                "sense_id": "60a36f3e-0828-3b6d-9958-f48d90be232d",
                                                "text": "He possessed a gorgeous cope of crimson silk and gold-thread damask, figured with a repeating pattern of golden pomegranates set in six-petalled formal blossoms, beyond which on either side was the pine-apple device wrought in seed-pearls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8136a736-9fcd-3344-855b-205cccb0a028",
                                        "entry_id": "ad4a049e-c74e-3a3d-8484-71d8ed7da11c",
                                        "glosses": [
                                            "Any covering such as a canopy or a mantle."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44c673a3-f307-3d78-891a-15126951112e",
                                        "entry_id": "ad4a049e-c74e-3a3d-8484-71d8ed7da11c",
                                        "glosses": [
                                            "The vault or canopy of the skies, heavens etc."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824d93c5-1d1f-460c-b79b-9656f0e368aa",
                                                "sense_id": "44c673a3-f307-3d78-891a-15126951112e",
                                                "text": "the starry cope of heaven"
                                            },
                                            {
                                                "example_id": "4648fa87-9737-481b-ad45-a07b2666fd4a",
                                                "sense_id": "44c673a3-f307-3d78-891a-15126951112e",
                                                "text": "Who perceiveth and seeth himselfe placed here,[…]farthest from heavens coape, with those creatures, that are the worst of the three conditions; and yet dareth imaginarily place himselfe above the circle of the Moone, and reduce heaven under his feet."
                                            },
                                            {
                                                "example_id": "2f30d6ae-cd31-4db4-8ba6-680a0fa34cc8",
                                                "sense_id": "44c673a3-f307-3d78-891a-15126951112e",
                                                "text": "One summer night, in commune with the hope\nThus deeply fed, amid those ruins gray\nI watched, beneath the dark sky’s starry cope; […]"
                                            },
                                            {
                                                "example_id": "69686cc7-39fa-402e-a984-679289d06799",
                                                "sense_id": "44c673a3-f307-3d78-891a-15126951112e",
                                                "text": "It was, indeed, a majestic idea that the destiny of nations should be revealed, in these awful hieroglyphics, on the cope of heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fc2286-942f-3156-9c48-23b86f06756b",
                                        "entry_id": "ad4a049e-c74e-3a3d-8484-71d8ed7da11c",
                                        "glosses": [
                                            "A covering piece on top of a wall exposed to the weather, usually made of metal, masonry, or stone, and sloped to carry off water."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2cc504a-1a26-3add-9671-51ae1bb21e6a",
                                        "entry_id": "ad4a049e-c74e-3a3d-8484-71d8ed7da11c",
                                        "glosses": [
