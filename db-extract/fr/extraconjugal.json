                ],
                "senses": [
                    {
                        "sense_id": "f05f4488-868b-3a4c-9521-ea0afec95cb9",
                        "entry_id": "0d794afe-3ccf-3c0e-b414-e9ea92f87192",
                        "glosses": [
                            "Qui se fait en dehors des liens du mariage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf47b06-60f5-409d-b595-e834b9cddc07",
                                "sense_id": "f05f4488-868b-3a4c-9521-ea0afec95cb9",
                                "text": "Une aventure extraconjugale."
                            },
                            {
                                "example_id": "6477b24f-61a1-406b-81df-d2b9354aea40",
                                "sense_id": "f05f4488-868b-3a4c-9521-ea0afec95cb9",
                                "text": "C’est pourquoi le mariage et l’instauration de la coopération domestique précèdent la sexualité conjugale et que le désir extraconjugal s’exerce en dehors du contrôle social ou contre lui."
                            },
                            {
                                "example_id": "fb9fa9ad-3f3c-4bec-9ace-2a36f3fcbf7e",
                                "sense_id": "f05f4488-868b-3a4c-9521-ea0afec95cb9",
                                "text": "Pensez plus profondément, examinez bien la chose, et vous percevrez que votre amour du sexe est un amour extraconjugal, et que l’amour conjugal est absolument autre, celui-ci étant distinct de celui-là, comme le froment l’est de la paille, ou plutôt comme l’humain l’est du bestial."
                            }
                        ]
                    }
                ],
