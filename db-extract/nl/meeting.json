                                                "text": "What has the meeting decided."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb98bbb-b8c0-39f5-9f4e-cd7bc92a252a",
                                        "entry_id": "28e103a2-01e8-3361-8a99-758310aeaaa6",
                                        "glosses": [
                                            "An encounter between people, even accidental."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
