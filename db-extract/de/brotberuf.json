                "senses": [
                    {
                        "sense_id": "ece0e76f-3b48-30ff-b50f-c9467f426c43",
                        "entry_id": "a28b8951-5baa-3aa8-8038-dcced323602e",
                        "glosses": [
                            "Beruf, mit dem man seinen Lebensunterhalt bestreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3922289-c3a5-451c-914e-824233c86f00",
                                "sense_id": "ece0e76f-3b48-30ff-b50f-c9467f426c43",
                                "text": "„Dik war so erfolgreich, dass er die Schriftstellerei zu seinem Brotberuf machen konnte, als die Kronschule 1864 geschlossen wurde und er in Geldnöte geriet.“"
                            },
                            {
                                "example_id": "f9567f41-e1cd-4697-92af-34a70604bdd5",
                                "sense_id": "ece0e76f-3b48-30ff-b50f-c9467f426c43",
                                "text": "„Neben diesem Brotberuf, der ihn finanziell sicherte, aber in keiner Weise ausfüllte, verstärkte er noch seine übrigen Aktivitäten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
