                ],
                "senses": [
                    {
                        "sense_id": "5077b335-cf5b-37f8-b403-ef2f9f9d8cfc",
                        "entry_id": "ba1e2f64-757d-3419-9c4a-534f87036df4",
                        "glosses": [
                            "Tageszeit, in der in einer Schule Lehrbetrieb stattfindet, von Schulbeginn bis Schulschluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2774128-d847-4d47-9187-6cc3b4d9611e",
                                "sense_id": "5077b335-cf5b-37f8-b403-ef2f9f9d8cfc",
                                "text": "Während der Schulzeit gilt in dieser Straße Tempo 30."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4623b546-6a0f-3f8d-bc41-1f760f8a2195",
                        "entry_id": "ba1e2f64-757d-3419-9c4a-534f87036df4",
                        "glosses": [
                            "Lebensabschnitt, in dem eine Person zur Schule geht, von der Einschulung bis zum Schulabschluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8287e9db-a2dc-4241-af22-9de313ab81ad",
                                "sense_id": "4623b546-6a0f-3f8d-bc41-1f760f8a2195",
                                "text": "In meiner Schulzeit war ich sehr fleißig."
                            },
                            {
                                "example_id": "c74c6f14-e817-49f0-864d-0a308d507b8e",
                                "sense_id": "4623b546-6a0f-3f8d-bc41-1f760f8a2195",
                                "text": "„Während meiner Schulzeit fühlte ich mich oft wie ein Zaungast.“"
                            },
                            {
                                "example_id": "496fd891-7bfd-4dfb-8981-d436264eac4d",
                                "sense_id": "4623b546-6a0f-3f8d-bc41-1f760f8a2195",
                                "text": "„Nach Ansicht der Eltern und einiger befragter Nachbarn machte die Demonstrationsperson vor der Schulzeit den Eindruck eines bescheidenen, still-vergnügten und unauffälligen Kindes, das sich allgemeiner Sympathien erfreute.“"
                            },
                            {
                                "example_id": "bd59b832-0275-4f16-ba73-1a1fe9278dc0",
                                "sense_id": "4623b546-6a0f-3f8d-bc41-1f760f8a2195",
                                "text": "„Damals konnte ein Hauptschüler davon ausgehen, nach der Schulzeit eine Ausbildungsstelle oder einen Arbeitsplatz zu finden.“"
                            },
                            {
                                "example_id": "df502b14-8214-499a-ad8e-22ff8530c1ec",
                                "sense_id": "4623b546-6a0f-3f8d-bc41-1f760f8a2195",
                                "text": "„Während meiner Schulzeit gab es mehrere selbstgedichtete Fortsetzungen dieser Fabel, bei denen die Libelle im Winter nicht starb.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
