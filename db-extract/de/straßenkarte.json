                                        "examples": [
                                            {
                                                "example_id": "409418e3-0fdc-4fb7-8c68-9951a10b067c",
                                                "sense_id": "1b98b3a6-a97f-3515-abb6-90ac63c4c8db",
                                                "text": "Tracez la perpendiculaire au plan ABC."
