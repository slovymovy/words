    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "8ec947c3-2df1-3ecf-8005-f3c2280e8027",
                "word": "Гулька",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78b0b4a9-52d7-3871-a130-42b28312f4e1",
                        "entry_id": "8ec947c3-2df1-3ecf-8005-f3c2280e8027",
                        "glosses": [
                            "форма женского имени Гуля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d420b3-82e6-4c95-a8ca-5ca696a37a6a",
                                "sense_id": "78b0b4a9-52d7-3871-a130-42b28312f4e1",
                                "text": "Так стучит, скажем, Эдик Мехаморчик или даже Гулька Самшитова."
                            }
                        ]
                    },
                    {
                        "sense_id": "96d2c5f7-048e-334c-9e44-1fd0a320864e",
                        "entry_id": "8ec947c3-2df1-3ecf-8005-f3c2280e8027",
                        "glosses": [
                            "форма мужского имени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728b5555-8283-4871-950c-57f7384a1902",
                                "sense_id": "96d2c5f7-048e-334c-9e44-1fd0a320864e",
                                "text": "Купал он её сам, как когда-то Гульку, а теперь уже Гулька, деловито сопя, ему помогал."
                            }
                        ]
                    },
                    {
                        "sense_id": "48b1a689-3b50-386b-a71c-3ff8df945c33",
                        "entry_id": "8ec947c3-2df1-3ecf-8005-f3c2280e8027",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493c90f9-58a2-4fa2-934b-cb00383a94bf",
                                "sense_id": "48b1a689-3b50-386b-a71c-3ff8df945c33",
                                "text": "А случилось так, что пришли к попу партнёры и приятели его жизни — дьякон Веньямин и городской бывшего четырёхклассного мужского училища учитель Иван Михайлович Гулька."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
