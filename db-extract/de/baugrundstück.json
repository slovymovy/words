                ],
                "senses": [
                    {
                        "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                        "entry_id": "2a520880-51ac-374d-8a68-390a40211dfb",
                        "glosses": [
                            "Grundstück, für das eine behördliche Genehmigung vorliegt, ein Gebäude zu errichten (= zu bauen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6387f3-c636-420a-aa60-4cf044407cd6",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„'Letztes Baugrundstück in begehrter Lage von Berlin-Mitte für Wohnungsbau geeignet', steht in der Immobilienanzeige.“"
                            },
                            {
                                "example_id": "8ab2c6a5-593f-407d-bcba-07039f50bcf7",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Das Baugrundstück liegt in Kirchrode, ein grüner Stadtteil im Südosten Hannovers.“"
                            },
                            {
                                "example_id": "ec0641ed-e393-4a0f-98b1-3b393af08e51",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Das Baugrundstück liegt in einer beliebten Gegend, im Hamburger Stadtteil Sasel, an dem Flüsschen Berner Au.“"
                            },
                            {
                                "example_id": "e60ab255-ec22-4d53-94b0-5a5c8aaa4d7d",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Eine halbe Auto-Stunde weiter südlich in Salzhemmendorf haben sie schließlich ein Baugrundstück für ein Viertel des Preises gefunden.“"
                            },
                            {
                                "example_id": "5415b30c-e46c-4f2b-a3b1-a8a7031d36f9",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Doch bis Baugrundstücke genehmigt, Firmen beauftragt und Personal angeworben wurden, vergingen Jahre.“"
                            },
                            {
                                "example_id": "5b172b10-6c6d-4543-a82b-8bb96627f2d5",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Um den Bau zu ermöglichen, hatte Oberbürgermeister Krogmann dem Land ein Baugrundstück im Technologie Park Oldenburg zugesagt.“"
                            },
                            {
                                "example_id": "7047135e-3256-465b-ad59-30db8ce51d31",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Die Gemeinde Fließ verkauft seit Jahren Baugrundstücke billig an Einheimische, um die Abwanderung zu verhindern.“"
                            },
                            {
                                "example_id": "0343f96f-79d0-456b-84bf-428b19b46cb0",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Für rund 200 Einwohner werden in der Nachbargemeinde Schleife derzeit Baugrundstücke erschlossen.“"
                            },
                            {
                                "example_id": "23a08bd0-98d5-4db9-b06e-edd6505c3e3f",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„«Seit sieben Jahren bemühen wir uns um ein Baugrundstück und eine Baugenehmigung, und nun haben wir endlich alle Hürden überwunden und die Baugenehmigung in Händen», erzählt der Gemeindeälteste Sait Susin.“"
                            },
                            {
                                "example_id": "0395a2ca-80fa-459f-b72a-5180b8e96c7d",
                                "sense_id": "4200d71f-1a98-3c73-95fc-7f6a0d11f3c4",
                                "text": "„Bislang ist es so: Städtisches Land gehört in China dem Staat. Wer jedoch genug Geld hat, kann das Nutzungsrecht für das Land erwerben. Außerdem kann er damit handeln – es gibt einen Markt für Baugrundstücke, einen Wohnungs- und einen Mietmarkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
