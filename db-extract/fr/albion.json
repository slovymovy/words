                "entry_id": "835818ef-35ed-3951-a772-92a1ee1212c7",
                "word": "Albion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "011338b5-3805-333a-a989-f91c84589da2",
                        "entry_id": "835818ef-35ed-3951-a772-92a1ee1212c7",
                        "glosses": [
                            "England (a constituent country of the United Kingdom)"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "poetic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b748294-4e43-4855-8195-40f2798078f7",
                                "sense_id": "011338b5-3805-333a-a989-f91c84589da2",
                                "text": "« Attaquons dans ses eaux la perfide Albion. »",
                                "translation": "\"Let us attack perfidious Albion in her waters.\"",
                                "english": "\"Let us attack perfidious Albion in her waters.\""
                            },
                            {
                                "example_id": "ee65a845-883b-48b0-9bd8-2c55958959e8",
                                "sense_id": "011338b5-3805-333a-a989-f91c84589da2",
                                "text": "« Et la guerre ? Et les forfanteries de la perfide Albion tournant en eau de boudin ? Farce ! Farce ! »",
                                "translation": "\"What about war? And what about the conceitedness of the perfidious Albion petering out? What a joke! What a joke!",
                                "english": "\"What about war? And what about the conceitedness of the perfidious Albion petering out? What a joke! What a joke!"
                            },
                            {
                                "example_id": "4d38e10e-ef39-4e9f-a892-c3b256b9a429",
                                "sense_id": "011338b5-3805-333a-a989-f91c84589da2",
                                "text": "« Perfide Albion je te maudis / Depuis le jour où tu m'as séduit / Je pense à toi en plein Paris / C'est malgré moi j'ai le mal de ton pays",
                                "translation": "\"Damn you, Perfidious Albion / Since the day you seduced me / I think about you in the middle of Paris / It is in spite of myself that I am homesick for you\"",
                                "english": "\"Damn you, Perfidious Albion / Since the day you seduced me / I think about you in the middle of Paris / It is in spite of myself that I am homesick for you\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
