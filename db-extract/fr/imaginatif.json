                                        "glosses": [
                                            "Having a lively or creative imagination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc94e8d-1500-48a6-b596-9d35ba89bdd5",
                                                "sense_id": "c61ef885-2737-3a31-96ed-23fb4de92b57",
                                                "text": "an imaginative boy"
                                            },
                                            {
                                                "example_id": "a80b40a2-d048-43f7-b857-d6b095dbd0e2",
                                                "sense_id": "c61ef885-2737-3a31-96ed-23fb4de92b57",
                                                "text": "No doubt kibitzers are highly imaginative. How else could they see wins and brilliant combinations that do not exist?"
                                            }
                                        ]
                                    },
