                    }
                ],
                "senses": [
                    {
                        "sense_id": "cec8eb08-5859-3fb8-a76b-97be7b72c3c2",
                        "entry_id": "14570196-2721-3f0d-9820-572beba38f04",
                        "glosses": [
                            "sehr hohe Geschwindigkeit; sehr hohes Tempo"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "acd3c619-aed9-4250-aa1d-1f912231e7df",
                                "sense_id": "cec8eb08-5859-3fb8-a76b-97be7b72c3c2",
                                "text": "Sie bog mit einem Affenzahn um die Ecke und wäre um ein Haar ins Schleudern geraten."
                            },
                            {
                                "example_id": "ce351b5e-089e-4ee8-9656-f4cc84868536",
                                "sense_id": "cec8eb08-5859-3fb8-a76b-97be7b72c3c2",
                                "text": "Die Lehrerin ratterte in einem Affenzahn die Formeln herunter, sodass nicht einmal die gut vorbereiteten Schüler mitkamen."
                            },
                            {
                                "example_id": "cc2ca65a-7292-4858-a5c6-27abdecd328a",
                                "sense_id": "cec8eb08-5859-3fb8-a76b-97be7b72c3c2",
                                "text": "Er hatte schon so einen Affenzahn drauf, dass er nicht mehr rechtzeitig bremsen konnte."
                            },
                            {
                                "example_id": "4dcb9aea-c535-4147-bff1-92024e2a1ed6",
                                "sense_id": "cec8eb08-5859-3fb8-a76b-97be7b72c3c2",
                                "text": "„Um noch mehr Tempo zu kriegen, duckte er sich, obwohl er schon einen Affenzahn draufhatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
