                                "sense_id": "9ba7c5e8-3995-33d3-b42e-069844ca89a3",
                                "text": "Oui, tout ça doit vous paraître assez tocbombe."
                            },
                            {
                                "example_id": "04b1007e-7a2a-4770-acd8-de07fda7e5e5",
                                "sense_id": "9ba7c5e8-3995-33d3-b42e-069844ca89a3",
                                "text": "Me voilà barjo, branque, cinglé, défoncé, tocbombe et zinzin comme pas permis !"
                            }
                        ]
                    }
