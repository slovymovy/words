                    {
                        "translation_id": "57898256-c826-44b5-8682-768b635a6f4f",
                        "source_entry_id": "41edc45d-0755-317a-92f1-5e4ae715ed3f",
                        "source_sense_description": "word or idiom of the Semitic vocabulary",
                        "target_lang_word": "Semitismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
