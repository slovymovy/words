                        "source_sense_id": "f51e00c2-2c50-38f7-8fcf-2625d4f5cd1a",
                        "source_sense_description": "type of forest",
                        "target_lang_word": "Regenwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                        "entry_id": "6ea9491a-eb21-30e2-a726-68b1d6e62509",
                                        "glosses": [
                                            "naturbelassener Wald mit mehr als 2000 mm Niederschlag im Jahresmittel"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3976e9ef-0712-4604-93eb-56e03e667b79",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„Nahe dem Äquator gedeihen Bäume in strahlender Sonne, heftigem Regen und ganzjähriger Wärme. Das Ergebnis ist ein dichter tropischer Regenwald, eines der artenreichsten Gebiete der Erde.“"
                                            },
                                            {
                                                "example_id": "f8ed6d6c-13af-4746-958b-f9e8b9f1ac1a",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„Im Regenwald gibt es mehr Möglichkeiten, auf der Stelle tot umzufallen, als sich irgendwer vorstellen kann, der niemals dort lebte.“"
                                            },
                                            {
                                                "example_id": "0726d4ab-8c41-4db0-867f-f979b852e9be",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„In Asien und Afrika verschwinden die Regenwälder vielerorts, um Bäume für Palmöl anbauen zu können.“"
                                            },
                                            {
                                                "example_id": "6021e910-5763-4b16-9f8a-1bb5434a3be1",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                                            },
                                            {
                                                "example_id": "68df4677-a1c9-4143-93e5-a41a5bc4d221",
                                                "sense_id": "2b47c761-78aa-33b0-9933-39c8cddb9c12",
                                                "text": "„Der Schwund tropischer Regenwälder hielt 2021 nach Satellitenbild-Auswertungen unverändert an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
