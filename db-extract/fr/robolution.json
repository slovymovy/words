                        "glosses": [
                            "Révolution robotique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "3cdceb00-6bd3-44c6-af37-41a333d5e69d",
                                "sense_id": "be7092b0-fdab-3bbb-89a8-4f632c035abb",
                                "text": "Contrairement aux révolutions industrielles des XIXe et XXe siècles, celui qui perd son travail du fait de la robolution, par exemple, ne peut plus trouver un travail qui requiert des compétences équivalentes."
                            },
                            {
                                "example_id": "b40b04af-f596-4257-a1f5-acc4c95b42c7",
                                "sense_id": "be7092b0-fdab-3bbb-89a8-4f632c035abb",
                                "text": "Je ne peux pas refermer ce tour d’horizon sans mentionner les autres robolutions qui se préparent à des échelles micro et nanoscopiques."
                            }
                        ]
                    }
