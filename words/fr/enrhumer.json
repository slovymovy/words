                    "frequency": "Middle",
                    "semantic_group_id": "rhume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mets ton manteau et ton écharpe avant de sortir, sinon tu vas t'<w>enrhumer</w>."
