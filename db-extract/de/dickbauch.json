                ],
                "senses": [
                    {
                        "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                        "entry_id": "984fdd25-4c04-36f3-b46f-48b542950a84",
                        "glosses": [
                            "beleibte, dicke Person"
                        ],
                        "tags": [
                            "derogatory",
                            "outdated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fd30e283-30e2-48f9-9b43-941bd6c5f4ae",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "„Mit einem Satz war ich bei dem Dickbauch und riss ihm das Handy aus der Hand.“"
                            },
                            {
                                "example_id": "748c2223-ad10-4449-a121-9b0f93b7e51e",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "„»Das Schwein will Senge haben«, sagte der Dickbauch zu seinem Kollegen, worauf dieser gemein grinste.“"
                            },
                            {
                                "example_id": "0c76446b-8b64-4a8b-bbe0-b2e92fb964b1",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "[…] „Was habt ihr da unterm Mantel? fragte der Dickbauch“ […]."
                            },
                            {
                                "example_id": "fe8217f5-dc19-4c58-8e03-817827f4b96f",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "„Die befrackten Dickbäuche führten den Bildhauer in den Saal, obgleich er nur straßenmäßig gekleidet war;“ […]."
                            },
                            {
                                "example_id": "c8c92e68-9cd3-461a-8546-7164f4bafc15",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "„Und, immer im Laufen, versucht er sich vorzustellen, wie Gareis diese Aufgabe lösen würde: »Dieser Dickbauch, würde er so laufen? Dieses fette Schwein, da sitzt er in seiner Wohnung.“ […]«."
                            },
                            {
                                "example_id": "17437ccc-e232-40df-afd8-4c953ae9ead1",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "„Der Kreispolizeiaufseher war ein kleiner Dickbauch, mit kugelartigem, rotem Gesicht, das noch runder wurde wegen seiner Gewohnheit, Luft in die Backen einzuziehen und sie langsam hinauszulassen.“"
                            },
                            {
                                "example_id": "74b632fd-20f7-49cd-bb42-7727b4381082",
                                "sense_id": "014d2ffa-7966-36d9-9d2f-3efad9f85b9b",
                                "text": "„Der Gatte der Fürstin Bezzy, ein gutmütiger Dickbauch und leidenschaftlicher Sammler von Gravuren hatte soeben gehört, daß bei seiner Gattin Gäste seien und war daher, noch bevor er in den Klub ging, im Salon erschienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                        "entry_id": "984fdd25-4c04-36f3-b46f-48b542950a84",
                        "glosses": [
                            "aus [1] abgeleiteter charakterisierender Eigenname einer Person (beispielsweise in Kinderbüchern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e923a8b-fc26-47b3-ab48-dd3b7af53cee",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„Von Umpah-Pah wird er „Bruder Dickbauch“ genannt.“"
                            },
                            {
                                "example_id": "04159f8e-9860-47a9-9012-857cf1cb545f",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„«Das hier wäre Ihr Arbeitsplatz», sagt König Dickbauch.“"
                            },
                            {
                                "example_id": "be1c3d3c-4dfb-4361-932f-f35d29b4dfae",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„Grizzly Dickbauch wollte spazierengehen, aber seine Mutter meinte: Da werde ich naß, denn ich habe meinen Schirm schon wieder irgendwo stehen lassen.“"
                            },
                            {
                                "example_id": "5f17cfac-ba61-4b6c-9d15-5bf50e8efb7f",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„Zu seinen bekanntesten Kinderbüchern zählen: „Hamster Dickbauch“, „Der vergessene Teddybär“,“ […]."
                            },
                            {
                                "example_id": "9d423958-c490-47e9-9485-f73470d67c5d",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„Raleigh stieg die Treppe hinauf und traf oben den Wirt, den berühmten Meister Dickbauch, wie er in vertraulicher Weise von der Bande genannt wurde,“ […]."
                            },
                            {
                                "example_id": "f7ad687c-7e9c-431f-af46-c499c0df2608",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„Er war lange stellungslos gewesen, bevor er seinen Haupttreffer gemacht hatte, und erinnerte sich noch daran, wie Carlo Mariani (allgemein bekannt als Charley Dickbauch), der Malteser Gastwirt am schäbigen Ende der Denham Street, abends, als die Nachricht gekommen war, ehrerbietig vor ihm gekatzbuckelt hatte.“"
                            },
                            {
                                "example_id": "4b4da097-8d38-4454-b35b-acac31f65071",
                                "sense_id": "73221462-f48c-38e4-86d8-2348020d7e4c",
                                "text": "„›Dickbauch‹ hatte selbst drei Revolverkugeln im Leib.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
