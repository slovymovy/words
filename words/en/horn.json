    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c90fbb9-522c-310b-92b6-2665b9ed91f0",
                    "sense_definition": "A loud alarm or signaling device, especially one on a motor vehicle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver honked his <w>horn</w> to warn the pedestrians.",
                            "target_lang_translations": {
                                "ru": "Водитель посигналил в <w>клаксон</w>, чтобы предупредить пешеходов.",
                                "zh": "司机按响<w>喇叭</w>，提醒行人注意。"
                            }
                        },
                        {
                            "text": "I heard the blast of a car <w>horn</w> outside my window.",
                            "target_lang_translations": {
                                "ru": "Я услышал звук автомобильного <w>гудка</w> за окном.",
                                "zh": "我听到窗外传来一阵汽车<w>喇叭</w>声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hooter",
                        "klaxon"
                    ],
                    "common_phrases": [
                        "honk the horn",
                        "car horn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для подачи громких звуковых сигналов, особенно на автомобиле",
                        "zh": "发出很大声响的警报或信号装置，尤指机动车上的喇叭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клаксон",
                                "target_lang_sense_clarification": "устройство"
                            },
                            {
                                "target_lang_word": "гудок",
                                "target_lang_sense_clarification": "звук или устройство"
                            },
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "звуковой сигнал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喇叭",
                                "target_lang_sense_clarification": "车辆上的鸣响装置"
                            },
                            {
                                "target_lang_word": "汽车喇叭",
                                "target_lang_sense_clarification": "更明确指汽车上的喇叭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ad0126a-e8ec-3894-9c67-971bf2f34b05",
                    "sense_definition": "A hard, pointed growth, usually paired, that protrudes from the head of certain animals like cattle, goats, or rhinos.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bull lowered its head and pointed its sharp <w>horns</w> at the fence.",
                            "target_lang_translations": {
                                "ru": "Бык опустил голову и наставил свои острые <w>рога</w> на забор.",
                                "zh": "公牛低下头，把尖尖的<w>角</w>对准围栏。"
                            }
                        },
                        {
                            "text": "We saw a rhinoceros with a very large <w>horn</w> at the zoo.",
                            "target_lang_translations": {
                                "ru": "В зоопарке мы видели носорога с очень большим <w>рогом</w>.",
                                "zh": "我们在动物园看到一头长着很大<w>角</w>的犀牛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lock horns",
                        "take the bull by the horns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдый заострённый вырост на голове некоторых животных",
                        "zh": "某些动物头上长出的坚硬尖状物，通常成对出现，如牛、山羊或犀牛的角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рог",
                                "target_lang_sense_clarification": "часть тела животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "角",
                                "target_lang_sense_clarification": "动物头上的角"
                            },
                            {
                                "target_lang_word": "兽角",
                                "target_lang_sense_clarification": "强调兽类的角"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26f4faeb-edaa-39cd-b97f-81047fce2b0b",
                    "sense_definition": "A musical wind instrument, typically made of brass and curved or coiled in shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been learning to play the French <w>horn</w> for three years.",
                            "target_lang_translations": {
                                "ru": "Она учится играть на <w>валторне</w> уже три года.",
                                "zh": "她学吹<w>圆号</w>已经三年了。"
                            }
                        },
                        {
                            "text": "The jazz band featured a talented <w>horn</w> section.",
                            "target_lang_translations": {
                                "ru": "В джаз-банде была талантливая секция <w>духовых</w>.",
                                "zh": "这支爵士乐队的<w>铜管乐器</w>声部非常出色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "French horn",
                        "horn section",
                        "English horn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Духовой музыкальный инструмент, обычно медный и изогнутой формы",
                        "zh": "一种吹奏乐器，通常由铜制成，形状弯曲或盘绕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валторна",
                                "target_lang_sense_clarification": "French horn"
                            },
                            {
                                "target_lang_word": "рожок",
                                "target_lang_sense_clarification": "народный или английский рожок"
                            },
                            {
                                "target_lang_word": "духовой инструмент",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆号",
                                "target_lang_sense_clarification": "特指法国号"
                            },
                            {
                                "target_lang_word": "号角",
                                "target_lang_sense_clarification": "泛指号类吹奏乐器"
                            },
                            {
                                "target_lang_word": "铜管乐器",
                                "target_lang_sense_clarification": "泛指这类乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46260fb9-6063-3493-992a-ed583ebdb983",
                    "sense_definition": "The hard substance from which animals' horns are made, sometimes used to make objects like buttons or combs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The handle of the antique knife was carved from buffalo <w>horn</w>.",
                            "target_lang_translations": {
                                "ru": "Рукоятка старинного ножа была вырезана из буйволиного <w>рога</w>.",
                                "zh": "那把古董刀的刀柄是用水牛<w>角</w>雕成的。"
                            }
                        },
                        {
                            "text": "He wore a pair of thick <w>horn</w>-rimmed glasses.",
                            "target_lang_translations": {
                                "ru": "Он носил очки в толстой <w>роговой</w> оправе.",
                                "zh": "他戴着一副厚厚的<w>角</w>框眼镜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "keratin"
                    ],
                    "common_phrases": [
                        "horn-rimmed glasses",
                        "made of horn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдое вещество, из которого состоят рога животных",
                        "zh": "构成动物角的坚硬物质，有时可用来制作纽扣、梳子等物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рог",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "角",
                                "target_lang_sense_clarification": "作材料时指动物角制成的物质"
                            },
                            {
                                "target_lang_word": "角质",
                                "target_lang_sense_clarification": "强调角的硬质材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "056776c4-e2fa-37ff-b2e4-cc63b4317cbd",
                    "sense_definition": "A telephone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get him on the <w>horn</w> immediately so we can discuss the deal.",
                            "target_lang_translations": {
                                "ru": "Срочно свяжись с ним по <w>телефону</w>, чтобы мы могли обсудить сделку.",
                                "zh": "马上给他打<w>电话</w>，这样我们就能谈这笔交易了。"
                            }
                        },
                        {
                            "text": "I have been on the <w>horn</w> all morning trying to solve this problem.",
                            "target_lang_translations": {
                                "ru": "Я всё утро висел на <w>телефоне</w>, пытаясь решить эту проблему.",
                                "zh": "我整个上午都在打<w>电话</w>，想解决这个问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "phone",
                        "blower",
                        "dog and bone"
                    ],
                    "common_phrases": [
                        "on the horn"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Телефон (сленг)",
                        "zh": "电话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телефон",
                                "target_lang_sense_clarification": "аппарат"
                            },
                            {
                                "target_lang_word": "трубка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电话",
                                "target_lang_sense_clarification": "俚语，指电话"
                            },
                            {
                                "target_lang_word": "听筒",
                                "target_lang_sense_clarification": "较口语，指电话听筒或通话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d86f268-c095-3eed-9f59-b7cc7aace45d",
                    "sense_definition": "An erection of the penis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crude joke gave him the <w>horn</w>.",
                            "target_lang_translations": {
                                "ru": "От этой грубой шутки у него случился <w>стояк</w>.",
                                "zh": "那个下流笑话引起了他的<w>勃起</w>。"
                            }
                        },
                        {
                            "text": "He woke up with the <w>horn</w> and felt embarrassed.",
                            "target_lang_translations": {
                                "ru": "Он проснулся со <w>стояком</w> и почувствовал смущение.",
                                "zh": "他醒来时有了<w>勃起</w>，觉得很尴尬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boner",
                        "hard-on",
                        "stiffy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эрекция полового члена (вульгарный сленг)",
                        "zh": "阴茎勃起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стояк",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勃起",
                                "target_lang_sense_clarification": "较中性，指阴茎勃起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ebfad777-140c-351e-be58-76e1f6e1dad6",
                    "sense_definition": "A large peninsula in Northeast Africa (the Horn of Africa) or the southern tip of South America (Cape Horn).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Sailing around the <w>Horn</w> was historically very dangerous for ships.",
                            "target_lang_translations": {
                                "ru": "Огибать мыс <w>Горн</w> исторически было очень опасно для кораблей.",
                                "zh": "驶过<w>合恩角</w>在历史上对船只来说非常危险。"
                            }
                        },
                        {
                            "text": "The drought in the <w>Horn</w> has caused a severe humanitarian crisis.",
                            "target_lang_translations": {
                                "ru": "Засуха на Африканском <w>Роге</w> вызвала тяжелый гуманитарный кризис.",
                                "zh": "<w>非洲之角</w>的干旱造成了严重的人道主义危机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Horn of Africa"
                    ],
                    "common_phrases": [
                        "around the Horn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название (Африканский Рог или мыс Горн)",
                        "zh": "地名，指东北非的大半岛“非洲之角”，或南美洲南端的“合恩角”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рог",
                                "target_lang_sense_clarification": "Африканский Рог"
                            },
                            {
                                "target_lang_word": "Горн",
                                "target_lang_sense_clarification": "мыс Горн"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非洲之角",
                                "target_lang_sense_clarification": "指非洲之角"
                            },
                            {
                                "target_lang_word": "合恩角",
                                "target_lang_sense_clarification": "指合恩角"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d3a49b2-fb80-37f4-9acc-c7d4376add8c",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Horn</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хорн</w> примет вас в своем кабинете сейчас.",
                                "zh": "<w>霍恩</w>先生现在会在办公室见你。"
                            }
                        },
                        {
                            "text": "The <w>Horn</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Хорн</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>霍恩</w>一家在这个镇上已经住了好几代了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хорн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霍恩",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c8931f6-7c91-3a7d-bb53-e3d46a2522c1",
                    "sense_definition": "To make a loud sound with a vehicle's horn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The impatient driver <w>horned</w> at the car stopped at the green light.",
                            "target_lang_translations": {
                                "ru": "Нетерпеливый водитель <w>посигналил</w> машине, остановившейся на зеленый свет.",
                                "zh": "那个不耐烦的司机朝停在绿灯前的汽车<w>按喇叭</w>。"
                            }
                        },
                        {
                            "text": "He <w>horned</w> twice to let us know he had arrived.",
                            "target_lang_translations": {
                                "ru": "Он дважды <w>погудел</w>, чтобы дать нам знать, что приехал.",
                                "zh": "他<w>鸣笛</w>两声，让我们知道他到了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавать громкий звуковой сигнал автомобильным гудком",
                        "zh": "按车辆喇叭，发出很响的信号声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигналить",
                                "target_lang_sense_clarification": "подавать сигнал"
                            },
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "издавать гудок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按喇叭",
                                "target_lang_sense_clarification": "按车辆喇叭发出信号"
                            },
                            {
                                "target_lang_word": "鸣笛",
                                "target_lang_sense_clarification": "较书面，指发出喇叭声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7ca0b83-fc48-36ab-8c7d-da4b849d6d1b",
                    "sense_definition": "To hit, push, or pierce with the horns.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The matador was nearly <w>horned</w> by the angry bull.",
                            "target_lang_translations": {
                                "ru": "Матадор был почти <w>забодан</w> разъяренным быком.",
                                "zh": "愤怒的公牛差点用角把斗牛士<w>顶</w>了。"
                            }
                        },
                        {
                            "text": "Be careful in the field, or you might get <w>horned</w> by the cattle.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен в поле, иначе скот может тебя <w>забодать</w>.",
                                "zh": "你在田里要小心，不然可能会被牛群<w>顶</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять или толкать рогами",
                        "zh": "用角撞、顶或刺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодать",
                                "target_lang_sense_clarification": "ударять рогами"
                            },
                            {
                                "target_lang_word": "поддевать рогом",
                                "target_lang_sense_clarification": "цеплять рогом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶",
                                "target_lang_sense_clarification": "用角撞击"
                            },
                            {
                                "target_lang_word": "用角顶",
                                "target_lang_sense_clarification": "更明确地说用角刺或挑"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}