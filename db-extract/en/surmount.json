                                ]
                            },
                            {
                                "target_word": "overwinnen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36909a12-ee70-334b-aecc-a55c374ee5a9",
                                        "entry_id": "ef1e8a58-1aaf-3709-aa80-a5a62808fdd0",
                                        "glosses": [
                                            "gewin overhouden, sparen"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "078d678c-7563-45f7-a90e-99b2d83edb16",
                                                "sense_id": "36909a12-ee70-334b-aecc-a55c374ee5a9",
                                                "text": "Dog het is waar, dat wanneer een behoeftige Vreemdeling, in dit Land eenigen tyd gewoond, en eenigen rykdom overgewonnen hebbende, zig laat Naturaliseren, hy daardoor alsdan in staat raakt, om dat gewonnen geld met voordeel te besteeden in 't koopen van land, ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed61f5e2-ef3a-4176-8e1d-710eb9e35959",
                        "source_entry_id": "1e8b8c0d-38fb-3222-9b60-9c3ef19dcad8",
                        "source_sense_description": "to get over; to overcome",
                        "target_lang_word": "surmonter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surmonter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Monter au-dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea1591e-1041-4ce8-9fcb-2dac551d5319",
                                                "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                                                "text": "Il supprima de plus les cygnes de support et la couronne de comte surmontant l’écu ; mais il commit en même temps l’erreur d’armer et lampasser le lion d'argent au lieu d’azur."
                                            },
                                            {
                                                "example_id": "a118a173-a428-4c39-8828-210b0b7183cf",
                                                "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                                                "text": "Au déluge, l’eau surmonta de quinze coudées les plus hautes montagnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Se placer, s’élever, régner au sommet, au-dessus."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens on l’emploie surtout en termes d’architecture et de décoration",
                                        "examples": [
                                            {
                                                "example_id": "5b9d34a8-3914-4310-9cde-500303804f4f",
                                                "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                                "text": "Les grandes cornes qui surmontent la tète du bouc, et la longue barbe qui est suspendue à son menton, lui donnent un air bizarre et équivoque : […]."
                                            },
                                            {
                                                "example_id": "a2b479b7-fc27-4f36-ac60-cb0359698138",
                                                "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                                "text": "De là l'importance décorative donnée dans les églises baroques à la chaire, aux confessionnaux et à l'autel que surmonte un baldaquin."
                                            },
                                            {
                                                "example_id": "60909ed5-b13a-451a-8930-1a0fb56f74dc",
                                                "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                                                "text": "C'était une brasserie animée, refaite à neuf il y a longtemps, avec de grands miroirs muraux et un comptoir en pacfung, brillant et lustré, que surmontaient des étagères où étaient alignées toutes sortes de bouteilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Vaincre ; dompter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4bd30d-bf07-4f05-8f45-2f6516b1083f",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Dans le domaine de la Parémiologie contrastive, un des principaux obstacles à surmonter est d’obtenir une équivalence parémiologique en vue d’analyser les parémies dans différentes langues de travail."
                                            },
                                            {
                                                "example_id": "9ce89d8f-80b2-4169-8608-9a94e3d5a38f",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Surmonter sa colère, sa haine, son amour."
                                            },
                                            {
                                                "example_id": "baef9bc6-8a8e-4f2d-a69d-49b5b15dc28a",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Surmonter tous les obstacles, toutes les difficultés."
                                            },
                                            {
                                                "example_id": "48e2e912-43d2-4847-92a5-00f363d895cd",
                                                "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                                                "text": "Il faut se surmonter, Il faut se dominer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                                        "entry_id": "70c20632-d07e-31cd-9fe0-a7c9e78cb215",
                                        "glosses": [
                                            "Surpasser."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens il ne se dit que quand il y a une sorte de concurrence, d’émulation, de lutte",
                                        "examples": [
                                            {
                                                "example_id": "896d6b4e-fc55-4be6-934a-e0e4d40107db",
                                                "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                                                "text": "Il a surmonté tous ses concurrents."
                                            },
                                            {
                                                "example_id": "1faa6816-b326-44f1-9a5f-5101d92b0376",
                                                "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                                                "text": "Surmonter quelqu’un en générosité, en science, en éloquence, en valeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b03669d-06d6-4ade-b9d3-1be5075aeafa",
                        "source_entry_id": "1e8b8c0d-38fb-3222-9b60-9c3ef19dcad8",
                        "source_sense_description": "to get over; to overcome",
                        "target_lang_word": "überwinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überwinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4919bf61-25f3-3303-ab9d-a406b3f51b42",
                                        "entry_id": "983fbdbe-23a7-304e-b9d7-52edea74c532",
                                        "glosses": [
                                            "mit etwas Schwierigem fertig werden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "481e424e-c196-4918-8f0e-bbef3f487c19",
                                                "sense_id": "4919bf61-25f3-3303-ab9d-a406b3f51b42",
                                                "text": "„Bei mehreren Flügen in den Höhenwinden (Lee-Wellen) über den argentinischen Anden gelang es einer Gruppe von Segelfliegern, mit der Stemme S10VT mehrfach die magische 1 000-Kilometer-Marke zu überwinden.“"
                                            },
                                            {
                                                "example_id": "c30b49a3-fe56-4b01-9c0f-6f54c4867f7a",
                                                "sense_id": "4919bf61-25f3-3303-ab9d-a406b3f51b42",
                                                "text": "Er musste seinen Schmerz erst überwinden."
                                            },
                                            {
                                                "example_id": "ab700b5a-e478-49f5-8d6e-70ed591abd40",
                                                "sense_id": "4919bf61-25f3-3303-ab9d-a406b3f51b42",
                                                "text": "„Bergsteigen heißt nicht nur Klettern: Wenn sich Bergsteiger zum Gipfel aufmachen, müssen sie auch wegloses Gelände, Felswände, Schneefelder und Gletscher überwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "efb887a3-ba93-3036-817c-c63b848dd18d",
                                        "entry_id": "983fbdbe-23a7-304e-b9d7-52edea74c532",
                                        "glosses": [
                                            "ein Hindernis überqueren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c6eb811-0671-412e-9ee8-ad968b230623",
                                                "sense_id": "efb887a3-ba93-3036-817c-c63b848dd18d",
                                                "text": "Er muss eine große Entfernung zu Fuß überwinden."
                                            },
                                            {
                                                "example_id": "83e2069b-2ed9-40c8-9e7e-a43af4f6e795",
                                                "sense_id": "efb887a3-ba93-3036-817c-c63b848dd18d",
                                                "text": "„Wie jedes Jahr überwinden auch jetzt wieder Wollhandkrabben die Fischtreppe bei Geesthacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8df3379d-81a3-31e0-9108-f45de8a46036",
                                        "entry_id": "983fbdbe-23a7-304e-b9d7-52edea74c532",
                                        "glosses": [
                                            "sich dazu bringen, etwas zu tun oder zu sagen, das man eigentlich nicht tun oder sagen wollte"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c83e840e-95b9-4455-841c-78fd1169de04",
                                                "sense_id": "8df3379d-81a3-31e0-9108-f45de8a46036",
                                                "text": "Er überwand sich, ihr zu helfen, obwohl sie ihm sehr unsympathisch war."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
