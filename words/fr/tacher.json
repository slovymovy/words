{
    "word_family": [
        "tache",
        "détacher",
        "détachant",
        "entacher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf76e9e0-618a-3842-b768-f556a3869c52",
                    "sense_definition": "Faire une tache sur quelque chose, salir ou souiller.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "salissure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention avec la sauce tomate pour ne pas <w>tacher</w> ta chemise blanche.",
                            "target_lang_translations": {
                                "en": "Be careful with the tomato sauce so you don't <w>stain</w> your white shirt.",
                                "ru": "Будь осторожен с томатным соусом, чтобы не <w>испачкать</w> белую рубашку.",
                                "de": "Sei vorsichtig mit der Tomatensoße, damit du dein weißes Hemd nicht <w>befleckst</w>.",
                                "es": "Ten cuidado con la salsa de tomate para no <w>manchar</w> tu camisa blanca.",
                                "zh": "吃番茄酱时要小心，别把你的白衬衫<w>弄脏</w>。"
                            }
                        },
                        {
                            "text": "L'enfant a renversé son verre de jus et a <w>taché</w> toute la nappe propre.",
                            "target_lang_translations": {
                                "en": "The child knocked over their glass of juice and <w>stained</w> the whole clean tablecloth.",
                                "ru": "Ребёнок опрокинул стакан с соком и <w>запачкал</w> всю чистую скатерть.",
                                "de": "Das Kind hat sein Glas Saft umgeworfen und die ganze saubere Tischdecke <w>beschmutzt</w>.",
                                "es": "El niño volcó su vaso de zumo y <w>manchó</w> todo el mantel limpio.",
                                "zh": "孩子打翻了果汁杯，把整块干净的桌布都<w>弄脏</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "salir",
                        "souiller",
                        "maculer"
                    ],
                    "antonyms": [
                        "nettoyer",
                        "laver"
                    ],
                    "common_phrases": [
                        "tacher ses vêtements",
                        "tacher la nappe",
                        "se tacher facilement"
                    ],
                    "target_lang_definitions": {
                        "en": "To mark something with a spot or stain, making it dirty.",
                        "ru": "Испачкать что-либо пятном, сделать грязным.",
                        "de": "Etwas mit Flecken versehen und dadurch schmutzig machen.",
                        "es": "Hacer una mancha en algo y dejarlo sucio.",
                        "zh": "在某物上沾上斑点或污渍，使其变脏。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stain",
                                "target_lang_sense_clarification": "spots on clothing or fabric"
                            },
                            {
                                "target_lang_word": "soil",
                                "target_lang_sense_clarification": "making clothes or linen dirty"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "одежду и ткань"
                            },
                            {
                                "target_lang_word": "заляпать",
                                "target_lang_sense_clarification": "брызгами соуса или жира"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beschmutzen",
                                "target_lang_sense_clarification": "Kleidung und Wäsche verschmutzen"
                            },
                            {
                                "target_lang_word": "beflecken",
                                "target_lang_sense_clarification": "Flecken auf Stoff hinterlassen"
                            },
                            {
                                "target_lang_word": "bekleckern",
                                "target_lang_sense_clarification": "umgangssprachlich, Essen auf Kleidung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "manchar",
                                "target_lang_sense_clarification": "ropa, tela o superficies"
                            },
                            {
                                "target_lang_word": "ensuciar",
                                "target_lang_sense_clarification": "uso general, ropa o suelo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "衣物、桌布等表面"
                            },
                            {
                                "target_lang_word": "沾污",
                                "target_lang_sense_clarification": "沾上油渍或污迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38865df0-de8d-3cf3-8a20-01d3ebba6eb5",
                    "sense_definition": "Ternir moralement, porter atteinte à l'honneur ou à la réputation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grave scandale financier risque de <w>tacher</w> la réputation de toute l'entreprise.",
                            "target_lang_translations": {
                                "en": "This serious financial scandal risks <w>tarnishing</w> the reputation of the entire company.",
                                "ru": "Этот серьёзный финансовый скандал может <w>запятнать</w> репутацию всей компании.",
                                "de": "Dieser schwere Finanzskandal droht, den Ruf des gesamten Unternehmens zu <w>beflecken</w>.",
                                "es": "Este grave escándalo financiero corre el riesgo de <w>manchar</w> la reputación de toda la empresa.",
                                "zh": "这起严重的财务丑闻可能会<w>玷污</w>整个公司的声誉。"
                            }
                        },
                        {
                            "text": "Une seule mauvaise décision a <w>taché</w> son brillant parcours professionnel.",
                            "target_lang_translations": {
                                "en": "One single bad decision has <w>tarnished</w> their brilliant career.",
                                "ru": "Одно-единственное неверное решение <w>запятнало</w> его блестящую карьеру.",
                                "de": "Eine einzige schlechte Entscheidung hat seinen glänzenden beruflichen Werdegang <w>befleckt</w>.",
                                "es": "Una sola mala decisión ha <w>empañado</w> su brillante trayectoria profesional.",
                                "zh": "一个错误的决定就<w>玷污</w>了他原本出色的职业履历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entacher",
                        "ternir",
                        "flétrir"
                    ],
                    "common_phrases": [
                        "tacher sa réputation",
                        "tacher son honneur"
                    ],
                    "target_lang_definitions": {
                        "en": "To damage someone's moral reputation or honour.",
                        "ru": "Морально повредить чьей-либо чести или репутации.",
                        "de": "Den Ruf oder die Ehre einer Person schädigen.",
                        "es": "Dañar la reputación, el honor o la imagen moral de alguien.",
                        "zh": "损害他人的名誉或声望，使其蒙受道德上的污损。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tarnish",
                                "target_lang_sense_clarification": "damaging a reputation or record"
                            },
                            {
                                "target_lang_word": "sully",
                                "target_lang_sense_clarification": "damaging honour or moral purity"
                            },
                            {
                                "target_lang_word": "stain",
                                "target_lang_sense_clarification": "damaging someone's character or name"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "честь и репутацию"
                            },
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "доброе имя, репутацию"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beflecken",
                                "target_lang_sense_clarification": "Ruf und Ehre schädigen"
                            },
                            {
                                "target_lang_word": "entehren",
                                "target_lang_sense_clarification": "Ehre einer Person verletzen"
                            },
                            {
                                "target_lang_word": "besudeln",
                                "target_lang_sense_clarification": "Ruf und Andenken herabwürdigen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "manchar",
                                "target_lang_sense_clarification": "reputación, imagen o carrera"
                            },
                            {
                                "target_lang_word": "empañar",
                                "target_lang_sense_clarification": "reputación o trayectoria"
                            },
                            {
                                "target_lang_word": "mancillar",
                                "target_lang_sense_clarification": "honor o dignidad"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "名誉、声誉或清白"
                            },
                            {
                                "target_lang_word": "败坏",
                                "target_lang_sense_clarification": "名声、名誉受损"
                            }
                        ]
                    }
                }
            ]
        }
    ]
