                    {
                        "sense_id": "243339ed-e485-37b5-bf42-aab0f0e0b141",
                        "entry_id": "eb3d9717-bc02-312b-8f11-a7db3d5205b4",
                        "glosses": [
                            "Propre ou relatif à Jean-Paul Belmondo et à ses interprétations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceb8c7bb-8ebc-4e3e-b613-e9fb3720cfca",
                                "sense_id": "243339ed-e485-37b5-bf42-aab0f0e0b141",
                                "text": "Le Azad du \"Casse\" était un héros belmondien par excellence..."
                            },
                            {
                                "example_id": "9c1156bd-0714-4860-ae4e-026147e82740",
                                "sense_id": "243339ed-e485-37b5-bf42-aab0f0e0b141",
                                "text": "Et Livi dajouter : « Ça n’a pas été un tournage sinistre mais un tournage chaleureux, amical, amusant... bref un tournage \"belmondien\" ! »"
                            },
                            {
                                "example_id": "4fc9c15d-c316-41a9-b6ce-28865af3c903",
                                "sense_id": "243339ed-e485-37b5-bf42-aab0f0e0b141",
                                "text": "Une intrigue qui lorgne autant du côté du film de braquage que des heures gloire du divertissement hexagonal Belmondien, un casting réunissant le caméléon Yvan Attal et l'exigeante Bérénice Béjo, il n'en faut pas plus pour titiller le cinéphile en mal de cinéma populaire ambitieux."
                            },
                            {
                                "example_id": "913d328e-2f88-4ba6-a273-fa284d86a6e0",
                                "sense_id": "243339ed-e485-37b5-bf42-aab0f0e0b141",
                                "text": "Décontracté et sans scrupule, Jeff est déjà un personnage très « belmondien »."
                            }
                        ]
                    }
