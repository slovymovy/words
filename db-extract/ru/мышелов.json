                                    },
                                    {
                                        "sense_id": "054dd4c8-bf27-32bb-8ea4-67bb400cca2b",
                                        "entry_id": "3d903aae-17e4-3f49-b4ce-77cf792e6b95",
                                        "glosses": [
                                            "A moustache."
