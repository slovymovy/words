                        "cross_references": [
                            {
                                "target_word": "thésard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6925df5e-1f6c-3b9c-9b8c-63bb8866e4fa",
                                        "entry_id": "28e1e79e-70e2-3c61-a31a-fbf955bd628f",
                                        "glosses": [
                                            "Chercheur en début de carrière préparant une thèse de doctorat."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a9161ad-580d-46fe-b6f9-9c367ec95962",
                                                "sense_id": "6925df5e-1f6c-3b9c-9b8c-63bb8866e4fa",
                                                "text": "J’avais discuté avec un jeune thésard en patristique grecque et m’étais demandé comment tant de jeunesse pouvait se ruiner au service du néant."
                                            },
                                            {
                                                "example_id": "5c830e5b-0dc5-4754-82b9-64e1276d773d",
                                                "sense_id": "6925df5e-1f6c-3b9c-9b8c-63bb8866e4fa",
                                                "text": "Franck, le thésard, demeurait quant à lui dans son bureau. Il dévorait en quelques minutes un sandwich devant l'écran de son ordinateur, en homme soucieux de ne pas perdre une seconde de son temps - ce qui faisait dire aux membres éminents du département qu’il était un freluquet prétentieux."
                                            },
                                            {
                                                "example_id": "89b7a7bb-0739-41d9-bd1f-3ea08518ecba",
                                                "sense_id": "6925df5e-1f6c-3b9c-9b8c-63bb8866e4fa",
                                                "text": "J’allais lui dire que j’avais plus d’expérience que dix thésards réunis, lorsque le compresseur se déclencha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
