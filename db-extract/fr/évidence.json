                                "sense_id": "b46840b4-a6f1-3fa8-a63b-d15180311e5c",
                                "text": "Il faut se rendre à l'évidence.",
                                "translation": "We must face the facts.",
                                "english": "We must face the facts."
                            },
                            {
                                "example_id": "77f03525-1eeb-49b7-b630-a769fd3d20cd",
                                "sense_id": "b46840b4-a6f1-3fa8-a63b-d15180311e5c",
                                "text": "C'est l'évidence même.",
                                "translation": "It is completely obvious.",
                                "english": "It is completely obvious."
                            },
                            {
                                "example_id": "4abcabd0-c11a-4a73-8520-d9456e907c92",
                                "sense_id": "b46840b4-a6f1-3fa8-a63b-d15180311e5c",
                                "text": "Si vous êtes venu uniquement pour expliquer des évidences comme celles-là, vous feriez tout aussi bien de repartir.",
                                "translation": "If you came just to state the obvious like this, you would do just as well to go home.",
                                "english": "If you came just to state the obvious like this, you would do just as well to go home."
                            }
                        ]
