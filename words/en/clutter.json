{
    "word_family": [
        "cluttered",
        "cluttering",
        "uncluttered"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3992987-acbf-3a19-9237-101ea6c1ca2b",
                    "sense_definition": "to fill a space with a messy or disorganized collection of things",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>clutter</w> the hallway with your shoes and bags.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>загромождайте</w> коридор своей обувью и сумками.",
                                "zh": "请不要把你的鞋子和包<w>堆满</w>走廊。"
                            }
                        },
                        {
                            "text": "Old newspapers and magazines began to <w>clutter</w> up the small living room.",
                            "target_lang_translations": {
                                "ru": "Старые газеты и журналы начали <w>захламлять</w> маленькую гостиную.",
                                "zh": "旧报纸和杂志开始把小客厅<w>塞满</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "litter",
                        "mess up"
                    ],
                    "antonyms": [
                        "tidy",
                        "organize",
                        "clear"
                    ],
                    "common_phrases": [
                        "clutter up"
                    ],
                    "target_lang_definitions": {
                        "ru": "заполнять пространство беспорядочным или неорганизованным набором вещей",
                        "zh": "指用杂乱无章的物品填满空间"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захламлять",
                                "target_lang_sense_clarification": "заполнять ненужными вещами"
                            },
                            {
                                "target_lang_word": "загромождать",
                                "target_lang_sense_clarification": "занимать место крупными предметами"
                            },
                            {
                                "target_lang_word": "заваливать",
                                "target_lang_sense_clarification": "покрывать слоем вещей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堆满",
                                "target_lang_sense_clarification": "指物品杂乱地占据空间"
                            },
                            {
                                "target_lang_word": "塞满",
                                "target_lang_sense_clarification": "指空间被杂物填塞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da250494-66f9-3efa-ba30-51b69f74ca4e",
                    "sense_definition": "to speak very quickly and unclearly, often repeating or omitting syllables",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When he gets nervous, he tends to <w>clutter</w> his words together.",
                            "target_lang_translations": {
                                "ru": "Когда он нервничает, он склонен <w>тараторить</w> и путать слова.",
                                "zh": "他一紧张就容易<w>语速过快</w>，导致话都挤在一起。"
                            }
                        },
                        {
                            "text": "The therapist helped the child who would <w>clutter</w> during stressful conversations.",
                            "target_lang_translations": {
                                "ru": "Терапевт помогал ребенку, который начинал <w>говорить невнятно</w> во время стрессовых разговоров.",
                                "zh": "治疗师帮助了那个在压力对话中会<w>含糊不清</w>的孩子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jabber",
                        "gabble"
                    ],
                    "antonyms": [
                        "enunciate",
                        "articulate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in clinical contexts regarding speech disorders"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "говорить очень быстро и невнятно, часто повторяя или пропуская слоги",
                        "zh": "指说话非常快且不清晰，常伴有重复或漏掉音节的现象"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тараторить",
                                "target_lang_sense_clarification": "говорить быстро и неразборчиво"
                            },
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "говорить невнятно"
                            },
                            {
                                "target_lang_word": "захлёбываться словами",
                                "target_lang_sense_clarification": "говорить слишком быстро от волнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "语速过快",
                                "target_lang_sense_clarification": "指说话节奏混乱"
                            },
                            {
                                "target_lang_word": "含糊不清",
                                "target_lang_sense_clarification": "指说话表达不清晰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "857532e2-c227-3016-9c13-dd223931f3be",
                    "sense_definition": "a large number of things that are scattered in a messy or disorganized way",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the whole weekend trying to clear the <w>clutter</w> from her desk.",
                            "target_lang_translations": {
                                "ru": "Она провела все выходные, пытаясь разобрать <w>беспорядок</w> на своем столе.",
                                "zh": "她整个周末都在清理桌子上的<w>杂物</w>。"
                            }
                        },
                        {
                            "text": "The room was full of visual <w>clutter</w> that made it hard to focus.",
                            "target_lang_translations": {
                                "ru": "Комната была полна визуального <w>шума</w>, из-за которого было трудно сосредоточиться.",
                                "zh": "房间里到处都是视觉<w>混乱</w>，让人难以集中注意力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jumble",
                        "mess",
                        "muddle",
                        "junk"
                    ],
                    "antonyms": [
                        "order",
                        "neatness"
                    ],
                    "common_phrases": [
                        "visual clutter",
                        "clear the clutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "большое количество вещей, разбросанных в беспорядке",
                        "zh": "指杂乱无章地散落的大量物品"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядок",
                                "target_lang_sense_clarification": "отсутствие системы и чистоты"
                            },
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "ненужные старые вещи"
                            },
                            {
                                "target_lang_word": "кутерьма",
                                "target_lang_sense_clarification": "хаотичное скопление вещей или действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂物",
                                "target_lang_sense_clarification": "指零乱堆放的物品"
                            },
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "指物品摆放无序的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d74ad5e6-3fe7-3aa9-87da-9614bb6adf78",
                    "sense_definition": "unwanted echoes on a radar or sonar screen caused by objects like clouds or waves",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operator had difficulty identifying the ship because of the radar <w>clutter</w>.",
                            "target_lang_translations": {
                                "ru": "Оператору было трудно идентифицировать корабль из-за <w>помех</w> на радаре.",
                                "zh": "由于雷达<w>杂波</w>，操作员很难识别那艘船。"
                            }
                        },
                        {
                            "text": "Heavy rain can create significant <w>clutter</w> on the screen during a storm.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь может создавать значительные <w>искажения</w> на экране во время шторма.",
                                "zh": "暴雨期间，大雨会在屏幕上产生明显的<w>干扰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interference",
                        "noise"
                    ],
                    "common_phrases": [
                        "radar clutter",
                        "sea clutter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in aviation and maritime contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нежелательные эхо-сигналы на экране радара или сонара, вызванные такими объектами, как облака или волны",
                        "zh": "指雷达或声纳屏幕上由云、波浪等物体引起的非预期回波"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помехи",
                                "target_lang_sense_clarification": "искажения на экране радара"
                            },
                            {
                                "target_lang_word": "отражения",
                                "target_lang_sense_clarification": "ложные сигналы от посторонних объектов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂波",
                                "target_lang_sense_clarification": "雷达技术术语"
                            },
                            {
                                "target_lang_word": "干扰",
                                "target_lang_sense_clarification": "指屏幕上的无效信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "728f1b8d-6c4a-3087-8cda-95c1f7177e7d",
                    "sense_definition": "a collective noun for a group of cats; a variant of <w>clowder</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>clutter</w> of cats gathered near the back door waiting for food.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> кошек собралась у задней двери в ожидании еды.",
                                "zh": "<w>一群</w>猫聚集在后门附近等着吃东西。"
                            }
                        },
                        {
                            "text": "The old barn was home to a large <w>clutter</w> of stray kittens.",
                            "target_lang_translations": {
                                "ru": "Старый сарай стал домом для большого <w>семейства</w> бездомных котят.",
                                "zh": "旧谷仓里住着<w>一群</w>流浪小猫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clowder"
                    ],
                    "common_phrases": [
                        "clutter of cats"
                    ],
                    "target_lang_definitions": {
                        "ru": "собирательное существительное для группы кошек",
                        "zh": "指一群猫的集合名词"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа животных"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "группа кошек в одном месте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一群",
                                "target_lang_sense_clarification": "用于猫的量词短语"
                            }
                        ]
                    }
                }
            ]
        },
        {
