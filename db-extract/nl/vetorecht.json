                        "tags": [
                            "plural"
                        ],
                        "form": "vetorechten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c87a2c9-7a95-36f8-9113-ffc36a5dd58c",
                        "entry_id": "1a57e6ac-1fb6-3a03-a366-3f7b9fa63196",
                        "glosses": [
                            "zonder enige steun van de andere deelnemers in een groep een besluit kunnen tegenhouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f84a0ff-2123-450b-bd42-a9eabc0e0da9",
                                "sense_id": "4c87a2c9-7a95-36f8-9113-ffc36a5dd58c",
                                "text": "Elke deelnemer heeft vetorecht, omdat de besluiten bij eenstemmigheid moeten worden genomen."
                            },
                            {
                                "example_id": "97f4da3f-c4dc-45d7-9f02-c69dd71183f5",
                                "sense_id": "4c87a2c9-7a95-36f8-9113-ffc36a5dd58c",
                                "text": "Zolang de permanente leden (China, Frankrijk, Rusland, de Verenigde Staten en het Verenigd Koninkrijk) van de Veiligheidsraad van de Verenigde Naties nog een vetorecht hebben zal het met de wereldvrede droevig gesteld zijn"
                            },
                            {
                                "example_id": "2174cc02-929d-4975-9743-038c26323431",
                                "sense_id": "4c87a2c9-7a95-36f8-9113-ffc36a5dd58c",
                                "text": "In 2014 kwam er een voorstel van Frankrijk en Mexico tot het instellen van een vrijwillige gedragscode om bij grootschalige wreedheden af te zien van het vetorecht door de permanente leden van de VN-Veiligheidsraad. Nederland steunde het voorstel om tot zo'n gedragscode te komen, omdat de VN door het veto vleugellam raakte en het 'beschermen van burgers tegen wreedheden op grote schaal' door het vetorecht lang niet altijd lukte, met vergaande consequenties voor grote groepen mensen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a0938ed-fdcc-4a8f-bd23-db2bcdb341fb",
                        "source_entry_id": "1a57e6ac-1fb6-3a03-a366-3f7b9fa63196",
                        "source_sense_id": "4c87a2c9-7a95-36f8-9113-ffc36a5dd58c",
                        "source_sense_description": "zonder enige steun van de andere deelnemers in een groep een besluit kunnen tegenhouden",
                        "target_lang_word": "Vetorecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vetorecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                        "entry_id": "2ae09f3e-9175-3b21-ad40-8e2bbccf7554",
                                        "glosses": [
                                            "Recht, ein Veto einlegen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2525c81-185e-4ec4-9fbc-8c8f66917e8c",
                                                "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                                "text": "„Ohne nationales Vetorecht tauge der ganze Kompromiss nichts.“"
                                            },
                                            {
                                                "example_id": "b052353c-dabe-41e4-9261-82e95e5ba886",
                                                "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                                "text": "„Da China im Weltsicherheitsrat ein Vetorecht habe, müsse es das Vorhaben unterstützen oder zumindest tolerieren.“"
                                            },
                                            {
                                                "example_id": "fb427600-c4a9-40f3-9583-09ede91fd704",
                                                "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                                "text": "„In bestimmten Fragen hatten die Mitgliedstaaten das Vetorecht, und sie machten davon auch rege Gebrauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
