        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ab1b7bde-b4a9-3fcb-a062-5f8bb018b24e",
                    "sense_definition": "De persoon of zaak die identiek is aan de eerder genoemde; niet een ander (zelfstandig gebruikt)",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben weer voor <w>dezelfde</w> gekozen.",
                            "target_lang_translations": {
                                "ru": "Мы снова выбрали <w>того же</w>.",
                                "en": "We chose <w>the same one</w> again.",
                                "pl": "Znowu wybraliśmy <w>tego samego</w>.",
                                "de": "Wir haben uns wieder für <w>dieselbe</w> entschieden.",
                                "fr": "Nous avons à nouveau choisi le <w>même</w>.",
                                "it": "Abbiamo scelto di nuovo <w>lo stesso</w>.",
                                "cs": "Znovu jsme si vybrali <w>toho samého</w>.",
                                "tr": "Yine <w>aynısını</w> seçtik.",
                                "es": "Hemos elegido al <w>mismo</w> otra vez."
                            }
                        },
                        {
                            "text": "Als mijn schoenen versleten zijn, koop ik gewoon weer <w>dezelfde</w>.",
                            "target_lang_translations": {
                                "ru": "Когда мои туфли износятся, я просто куплю <w>те же самые</w>.",
                                "en": "When my shoes are worn out, I'll just buy <w>the same ones</w> again.",
                                "pl": "Kiedy moje buty się zużyją, po prostu kupię znowu <w>takie same</w>.",
                                "de": "Wenn meine Schuhe abgetragen sind, kaufe ich einfach wieder <w>dieselben</w>.",
                                "fr": "Quand mes chaussures seront usées, je m'achèterai simplement les <w>mêmes</w>.",
                                "it": "Quando le mie scarpe saranno consumate, comprerò semplicemente <w>le stesse</w>.",
                                "cs": "Až se mi boty obnosí, koupím si prostě zase <w>ty samé</w>.",
                                "tr": "Ayakkabılarım eskidiğinde yine <w>aynılarını</w> satın alırım.",
                                "es": "Cuando mis zapatos se gasten, simplemente compraré los <w>mismos</w> otra vez."
                            }
                        },
                        {
                            "text": "Dat zijn precies <w>dezelfde</w> als die we gisteren zagen.",
                            "target_lang_translations": {
                                "ru": "Это точно <w>те же самые</w>, что мы видели вчера.",
                                "en": "Those are exactly <w>the same ones</w> as we saw yesterday.",
                                "pl": "To są dokładnie <w>te same</w>, które widzieliśmy wczoraj.",
                                "de": "Das sind genau <w>dieselben</w>, die wir gestern gesehen haben.",
                                "fr": "Ce sont exactement les <w>mêmes</w> que ceux que nous avons vus hier.",
                                "it": "Quelle sono esattamente <w>le stesse</w> che abbiamo visto ieri.",
                                "cs": "To jsou přesně <w>ty samé</w>, co jsme viděli včera.",
                                "tr": "Bunlar dün gördüklerimizin tamamen <w>aynısı</w>.",
                                "es": "Esos son exactamente los <w>mismos</w> que vimos ayer."
                            }
                        }
                    ],
                    "synonyms": [
                        "diezelfde"
                    ],
                    "antonyms": [
                        "een andere"
                    ],
                    "common_phrases": [
                        "precies dezelfde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или предмет, идентичный ранее упомянутому; не другой (используется самостоятельно)",
                        "en": "The person or thing that is identical to the one previously mentioned; not another one",
                        "pl": "Osoba lub rzecz identyczna z wcześniej wspomnianą; nie inna (używane samodzielnie)",
                        "de": "Die Person oder Sache, die mit der zuvor genannten identisch ist; keine andere (selbstständig verwendet)",
                        "fr": "La personne ou la chose qui est identique à celle précédemment mentionnée ; pas une autre (employé de façon autonome).",
                        "it": "La persona o cosa che è identica a quella precedentemente menzionata; non un'altra (usato in modo indipendente)",
                        "cs": "Osoba nebo věc, která je totožná s dříve zmíněnou; nikoli jiná (používá se samostatně).",
                        "tr": "Daha önce bahsedilen kişi veya nesneyle tamamen aynı olan; başkası değil (tek başına zamir olarak kullanılır)",
                        "es": "La persona o cosa que es idéntica a la mencionada anteriormente; no otra (usado de forma independiente)."
                    },
