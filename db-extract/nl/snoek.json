                "translations": [
                    {
                        "translation_id": "0e70cedf-576d-480d-b5a0-a3475249746f",
                        "source_entry_id": "ae0e6b61-e683-3b64-9329-f3e35cc70d1e",
                        "source_sense_id": "ff805fe5-bf54-3b69-a3af-42c9f7b5c870",
                        "source_sense_description": "bepaald soort roofvis die in zoete wateren voorkomt, Esox lucius",
                        "target_lang_word": "Hecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b35f3e4d-835c-3b3b-a590-ed53988692dc",
                                        "entry_id": "6f9d0c38-69c1-37f5-9269-add1f686707e",
                                        "glosses": [
                                            "länglicher Raubfisch des Süßwassers, mit langem Kopf und starken Zähnen"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea6e4e8c-d6a2-4c9f-9f4a-f3b8e79c7ed8",
                                                "sense_id": "b35f3e4d-835c-3b3b-a590-ed53988692dc",
                                                "text": "Ein ausgewachsener Hecht kann bis zu 1,5 m lang werden."
                                            },
                                            {
                                                "example_id": "3d38ea3c-db08-46f0-bba5-7c16f06d7b56",
                                                "sense_id": "b35f3e4d-835c-3b3b-a590-ed53988692dc",
                                                "text": "„Barsche zuckten vor uns zur Seite; wir stöberten große Döbel auf, Karpfen, Schleie, hier und da einen Hecht oder sehr selten einen stattlichen Zander.“"
                                            },
                                            {
                                                "example_id": "51cb526f-a01a-4c99-9fbb-39e855263368",
                                                "sense_id": "b35f3e4d-835c-3b3b-a590-ed53988692dc",
                                                "text": "„Dann aber erzählte ich Papa noch von den Fischen in der Mosel, indem ich sie genau beschrieb, so, wie ich sie gesehen hatte, und am Ende hatten wir heraus bekommen, dass ich anscheinend einen Hecht, mehrere Aale und vielleicht sogar einen Wels gesehen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04a7f71b-92f7-36f5-9ee2-189109b7c702",
                                        "entry_id": "6f9d0c38-69c1-37f5-9269-add1f686707e",
                                        "glosses": [
                                            "ein außergewöhnlicher Mann"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3377e01b-1760-4a2a-a324-defbbc3e9218",
                                                "sense_id": "04a7f71b-92f7-36f5-9ee2-189109b7c702",
                                                "text": "Der ist echt ein toller Hecht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8875bef-2649-3eeb-9366-6b5c19057e63",
                                        "entry_id": "6f9d0c38-69c1-37f5-9269-add1f686707e",
                                        "glosses": [
                                            "Kurzform für Hechtsprung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f0696b-db2f-4e1e-9c1d-41f4a2183b2d",
                                                "sense_id": "e8875bef-2649-3eeb-9366-6b5c19057e63",
                                                "text": "Er sprang/machte einen Hecht vom Einmeterbrett."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c207a51-29c9-46bd-b1a4-e7e2aab8a4b1",
