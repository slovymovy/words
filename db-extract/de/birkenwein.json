                            {
                                "example_id": "c0c5eefb-a0ca-4aa4-a1a4-0c00d8315e12",
                                "sense_id": "172259e5-faa8-30b5-a110-af7fd93aa47b",
                                "text": "„Der Birkensaft wird nicht nur frisch genossen, sondern gibt auch durch Gährung den Birkenmeth und Birkenwein und dient als Arzneimittel.“"
                            },
