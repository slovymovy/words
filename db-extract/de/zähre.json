                ],
                "senses": [
                    {
                        "sense_id": "b4187266-9e3a-379a-982e-c59c7ddc319c",
                        "entry_id": "51419fb6-fb3a-3765-8407-8133138eb476",
                        "glosses": [
                            "Träne"
                        ],
                        "tags": [
                            "outdated",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "4d64a82b-4724-4b35-afeb-826dacd1521e",
                                "sense_id": "b4187266-9e3a-379a-982e-c59c7ddc319c",
                                "text": "Sie weinte bittere Zähren."
                            },
                            {
                                "example_id": "80e3e9c7-ace8-4080-b84c-cdbaea4da00d",
                                "sense_id": "b4187266-9e3a-379a-982e-c59c7ddc319c",
                                "text": "„Versieget nun ihr heissen Zähren!“"
                            },
                            {
                                "example_id": "42a3b80c-7b6a-49e5-b6a2-2be4ecfa7ec2",
                                "sense_id": "b4187266-9e3a-379a-982e-c59c7ddc319c",
                                "text": "„Nach einer halben Stunde streichelte er ihre Hand und nahm ihr sachte das Taschentuch aus den Fingern und trocknete ihr die Zähren von den Wangen.“"
                            },
                            {
                                "example_id": "27f50cf7-abf1-450a-8be5-0906e920a64b",
                                "sense_id": "b4187266-9e3a-379a-982e-c59c7ddc319c",
                                "text": "„Erbarme dich mein Gott, um meiner Zähren willen. Schaue hier, Herz und Auge weint vor dir bitterlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
