                                                "sense_id": "157fb23f-54c7-37a5-94c0-9724557f2521",
                                                "text": "In unserem Obstgarten stehen auch zwei Kornelkirschen."
                                            },
                                            {
                                                "example_id": "a7335afb-4f16-480b-9c9f-71038996d155",
                                                "sense_id": "157fb23f-54c7-37a5-94c0-9724557f2521",
                                                "text": "Die Kornelkirsche blüht überreich ab Mitte Februar bis März."
                                            }
