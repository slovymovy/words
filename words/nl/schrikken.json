                },
                {
                    "sense_id": "30b0363b-925c-3dd6-90ed-5310175cb158",
                    "sense_definition": "iemand een plotselinge schok of angst bezorgen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De harde knal heeft de baby uit zijn diepe slaap <w>geschrikt</w>.",
                            "target_lang_translations": {
                                "en": "The loud bang <w>startled</w> the baby out of his deep sleep.",
                                "ru": "Громкий хлопок <w>напугал</w> ребенка и вывел его из глубокого сна."
                            }
                        },
                        {
                            "text": "Hij probeerde zijn zusje te <w>schrikken</w> door achter de deur te staan.",
                            "target_lang_translations": {
                                "en": "He tried to <w>scare</w> his sister by standing behind the door.",
                                "ru": "Он пытался <w>напугать</w> свою сестренку, стоя за дверью."
                            }
                        }
