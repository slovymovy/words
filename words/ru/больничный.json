{
    "word_family": [
        "больница",
        "больной",
        "болеть"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77170fc8-8324-33c3-8b33-81baf51ad698",
                    "sense_definition": "Официальный документ, подтверждающий временную нетрудоспособность человека и дающий право на освобождение от работы.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач выписал мне <w>больничный</w> на неделю из-за сильной простуды.",
                            "target_lang_translations": {
                                "en": "The doctor gave me a <w>sick note</w> for a week because of a bad cold."
                            }
                        },
                        {
                            "text": "После операции пришлось взять <w>больничный</w> лист на целый месяц.",
                            "target_lang_translations": {
                                "en": "After the surgery, I had to take <w>sick leave</w> for a whole month."
                            }
                        }
                    ],
                    "synonyms": [
                        "больничный лист",
                        "бюллетень"
                    ],
                    "common_phrases": [
                        "взять больничный",
                        "оформить больничный"
                    ],
                    "target_lang_definitions": {
                        "en": "An official document certifying temporary disability and granting the right to be excused from work."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sick leave",
                                "target_lang_sense_clarification": "The period of time off work due to illness."
                            },
                            {
                                "target_lang_word": "medical certificate",
                                "target_lang_sense_clarification": "The formal document issued by a doctor."
                            },
                            {
                                "target_lang_word": "sick note",
                                "target_lang_sense_clarification": "Informal term for a doctor's note for an employer."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2dee151-1115-3af6-b59a-321ba2731f92",
                    "sense_definition": "Относящийся к больнице, связанный с её деятельностью или устройством.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hospital_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретились у входа в <w>больничный</w> корпус.",
                            "target_lang_translations": {
                                "en": "We met at the entrance to the <w>hospital</w> building."
                            }
                        },
                        {
                            "text": "Весь <w>больничный</w> персонал был очень внимателен к пациентам.",
                            "target_lang_translations": {
                                "en": "All the <w>hospital</w> staff were very attentive to the patients."
                            }
                        }
                    ],
                    "antonyms": [
                        "небольничный"
                    ],
                    "common_phrases": [
                        "больничный коридор",
                        "больничный режим"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to a hospital, connected with its activities or structure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hospital",
                                "target_lang_sense_clarification": "Used as an adjective to describe things belonging to or located in a hospital."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b61fe64b-ddc4-3761-af25-f618d61736d0",
                    "sense_definition": "Характерный для больничной обстановки, специфический (обычно о запахе или атмосфере).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hospital_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В комнате стоял резкий <w>больничный</w> запах лекарств.",
                            "target_lang_translations": {
                                "en": "There was a sharp <w>clinical</w> smell of medicine in the room."
                            }
                        },
                        {
                            "text": "Стены были выкрашены в скучный <w>больничный</w> цвет.",
                            "target_lang_translations": {
                                "en": "The walls were painted a dull <w>clinical</w> color."
                            }
                        }
                    ],
                    "common_phrases": [
                        "больничный запах"
                    ],
                    "target_lang_definitions": {
                        "en": "Characteristic of a hospital environment, specific (usually regarding smell or atmosphere)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clinical",
                                "target_lang_sense_clarification": "Describing an atmosphere that is cold, sterile, or impersonal."
                            },
                            {
                                "target_lang_word": "hospital-like",
                                "target_lang_sense_clarification": "Having the distinct qualities or smell of a hospital."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "060812a0-b0ba-3a34-acf8-be15d3959b96",
                    "sense_definition": "Предназначенный для использования в условиях больницы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hospital_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пациентам выдали чистую <w>больничную</w> одежду.",
                            "target_lang_translations": {
                                "en": "The patients were given clean <w>hospital</w> clothes."
                            }
                        },
                        {
                            "text": "В палате стояла стандартная <w>больничная</w> кровать.",
                            "target_lang_translations": {
                                "en": "There was a standard <w>hospital</w> bed in the ward."
                            }
                        }
                    ],
                    "common_phrases": [
                        "больничная койка",
                        "больничная одежда"
                    ],
                    "target_lang_definitions": {
                        "en": "Intended for use in a hospital setting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hospital",
                                "target_lang_sense_clarification": "Used to describe equipment or supplies designed for medical facilities."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}