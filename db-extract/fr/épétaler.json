                "senses": [
                    {
                        "sense_id": "f70f08bb-ce44-3591-bd62-5f2e15b49eb1",
                        "entry_id": "ba483734-f768-30a9-9963-960198c561e4",
                        "glosses": [
                            "Enlever les pétales d’une fleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef22e7a8-fdf3-40c2-b4c8-72825da7d1f1",
                                "sense_id": "f70f08bb-ce44-3591-bd62-5f2e15b49eb1",
                                "text": "Elle taillade ses rosiers, épétale ses roses, se pique les doigts aux branches."
                            },
                            {
                                "example_id": "f8a2c4f4-ce5b-4e11-9dc7-f6101b1ba688",
                                "sense_id": "f70f08bb-ce44-3591-bd62-5f2e15b49eb1",
                                "text": "J'ai beau épétaler toutes les marguerites du quartier, aucune ne sait me dire comment je suis aimé."
                            },
                            {
                                "example_id": "9996006c-8553-4167-878a-e9de6b4e85ea",
                                "sense_id": "f70f08bb-ce44-3591-bd62-5f2e15b49eb1",
                                "text": "Cueillir des paquerettes, les épétaler avec le refrain \"je t'aime un peu, beaucoup, passionnément\"."
                            },
                            {
                                "example_id": "a3bcfe9e-0ade-4d1b-8c81-c75f75070fa1",
                                "sense_id": "f70f08bb-ce44-3591-bd62-5f2e15b49eb1",
                                "text": "Bref, on ne peut pas épétaler une marguerite, on… l'efflore ?"
                            }
                        ]
                    }
                ],
