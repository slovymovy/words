            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2a1696e-5dee-355a-91ae-b079b5a6700c",
                    "sense_definition": "Osoba lub grupa osób darzona nienawiścią lub zagrażająca komuś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "osoba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy człowiek ma jakiegoś <w>wroga</w> w swoim życiu.",
                            "target_lang_translations": {
                                "de": "Jeder Mensch hat in seinem Leben irgendeinen <w>Feind</w>."
                            }
                        },
                        {
                            "text": "Nie traktuj go jak <w>wroga</w> tylko dlatego że macie inne zdanie.",
                            "target_lang_translations": {
                                "de": "Behandle ihn nicht wie einen <w>Feind</w>, nur weil ihr unterschiedlicher Meinung seid."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieprzyjaciel",
                        "przeciwnik"
                    ],
                    "antonyms": [
                        "przyjaciel",
                        "sojusznik",
                        "sprzymierzeniec"
                    ],
                    "common_phrases": [
                        "publiczny wróg",
                        "śmiertelny wróg"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Gruppe, der man mit Hass begegnet oder die eine Bedrohung darstellt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Feind",
                                "target_lang_sense_clarification": "Person oder Gruppe, zu der eine feindselige Beziehung besteht."
                            },
                            {
                                "target_lang_word": "Gegner",
                                "target_lang_sense_clarification": "Jemand, der in einem Wettstreit oder einer Auseinandersetzung gegen einen steht."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb815adf-16e8-3e8c-8bcc-6f5d17e0479a",
                    "sense_definition": "Państwo lub armia będąca w stanie wojny z innym państwem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wojsko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wojska <w>wroga</w> przekroczyły granicę w nocy.",
                            "target_lang_translations": {
                                "de": "Die Truppen des <w>Feindes</w> haben in der Nacht die Grenze überschritten."
                            }
                        },
                        {
                            "text": "Żołnierze musieli bronić pozycji przed atakiem <w>wroga</w>.",
                            "target_lang_translations": {
                                "de": "Die Soldaten mussten die Stellung gegen den Angriff des <w>Feindes</w> verteidigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieprzyjaciel"
                    ],
                    "antonyms": [
                        "sojusznik",
                        "sprzymierzeniec"
                    ],
                    "common_phrases": [
                        "atak wroga",
                        "obóz wroga"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Staat oder eine Armee, die sich mit einem anderen Staat im Kriegszustand befindet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Feind",
                                "target_lang_sense_clarification": "Militärischer Gegner im Krieg."
                            }
                        ]
                    }
                }
            ]
        }
    ]
