                                    {
                                        "sense_id": "91f67f3d-e437-3556-ba50-d08b47994b31",
                                        "entry_id": "628678e7-033a-35f3-bce5-7af50e5c2766",
                                        "glosses": [
                                            "Any mosquito, gnat, midge, or other small bug which consumes human blood."
                                        ],
