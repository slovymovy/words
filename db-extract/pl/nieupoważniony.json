                                    },
                                    {
                                        "sense_id": "cf372f08-db68-34df-aa9f-27b99bd3bc01",
                                        "entry_id": "23d4d4a2-2b6d-35aa-a924-3eafff58e863",
                                        "glosses": [
                                            "Without official authorization."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4006a6-1dd1-48aa-86fb-b7840414d3d8",
                                                "sense_id": "cf372f08-db68-34df-aa9f-27b99bd3bc01",
                                                "text": "The dangers of scofflawry vary wildly. The person who illegally spits on the sidewalk remains disgusting, but clearly poses less risk to others than the company that illegally buries hazardous chemical waste in an unauthorized location."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85eee50e-7ec7-4300-8f48-0b49fd097664",
                        "source_entry_id": "f9e3c756-5a57-302a-81f1-5a7ada13960e",
                        "source_sense_id": "d1e6bf1b-10d1-3e1f-b7a0-166a525cd9e5",
                        "target_lang_word": "unerlaubt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerlaubt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4b88a2-5a39-3848-a275-a501703074e3",
                                        "entry_id": "84dd0e12-59bb-3c67-8aa3-8c049feea328",
                                        "glosses": [
                                            "ohne Erlaubnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0832bb87-f9c5-40ba-a8b6-c84a1bedaf7e",
                                                "sense_id": "dc4b88a2-5a39-3848-a275-a501703074e3",
                                                "text": "Das unerlaubte Entfernen vom Schulgelände wird mit Nachsitzen bestraft."
                                            },
                                            {
                                                "example_id": "7eaea4f7-7b9e-440c-b8b2-1b61bc0ccde4",
                                                "sense_id": "dc4b88a2-5a39-3848-a275-a501703074e3",
                                                "text": "Kay hat sich unerlaubt das letzte Stück Kuchen genommen."
                                            },
                                            {
                                                "example_id": "cf7fd6e5-8d84-474f-a147-725d97d1cc9c",
                                                "sense_id": "dc4b88a2-5a39-3848-a275-a501703074e3",
                                                "text": "„Der Bund umfaßte eine Menge grimmiger, gegen die Nordstaaten erbitterter Feinde, deren Aufgabe es war, mit allen Mitteln, auch den unerlaubtesten und verbrecherischsten, gegen die nach der Beendigung des Bürgerkrieges eingetretene Ordnung anzukämpfen.“"
                                            },
                                            {
                                                "example_id": "27be83f8-6b44-42d0-84f8-b86826c7b903",
                                                "sense_id": "dc4b88a2-5a39-3848-a275-a501703074e3",
                                                "text": "„Die indische Polizei hat einen US-Bürger wegen des unerlaubten Betretens einer Andamaneninsel festgenommen, die von der isolierten Volksgruppe der Sentinelesen bewohnt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0940b093-b011-400d-9f0e-73c96798a6b9",
                        "source_entry_id": "f9e3c756-5a57-302a-81f1-5a7ada13960e",
                        "source_sense_id": "d1e6bf1b-10d1-3e1f-b7a0-166a525cd9e5",
                        "target_lang_word": "unbefugt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbefugt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f37ac98a-8a54-341e-bcbe-7bce2c9df151",
                                        "entry_id": "ae957cce-99ff-3381-ab4b-c977567f66f9",
                                        "glosses": [
                                            "keine Befugnis, kein Recht, keine Bevollmächtigung zu etwas besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f4fe51-9e65-4479-abfb-52bc45b44479",
                                                "sense_id": "f37ac98a-8a54-341e-bcbe-7bce2c9df151",
                                                "text": "In Paragraf 36 des Waffengesetzes heißt es nämlich: \"Wer Waffen oder Munition besitzt, hat die erforderliche Vorkehrungen zu treffen, um zu verhindern, dass diese Gegenstände abhanden kommen oder Dritte sie unbefugt an sich nehmen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5453018-22f6-4554-ba80-c5eab2f2102d",
                        "source_entry_id": "f9e3c756-5a57-302a-81f1-5a7ada13960e",
                        "source_sense_id": "d1e6bf1b-10d1-3e1f-b7a0-166a525cd9e5",
                        "target_lang_word": "unberechtigt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unberechtigt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "765091eb-ff4a-3081-bb60-f274472ffdf7",
                                        "entry_id": "c0c15392-883e-3673-a38a-d2ceb9b16fb9",
                                        "glosses": [
                                            "zu Unrecht bestehend, keinen guten Grund habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4706c611-7fd5-4a6e-99cf-d48958c00822",
                                                "sense_id": "765091eb-ff4a-3081-bb60-f274472ffdf7",
                                                "text": "Das sind doch völlig unberechtigte Vorwürfe! Wer sagt denn das? Wer stützt den solche Aussagen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ca00c07-1ca9-38ea-84ca-d26f61387dca",
                                        "entry_id": "c0c15392-883e-3673-a38a-d2ceb9b16fb9",
                                        "glosses": [
                                            "keine Erlaubnis/Genehmigung/Berechtigung für etwas besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ab30ca-94b8-4f70-8777-eb47e60f2187",
                                                "sense_id": "7ca00c07-1ca9-38ea-84ca-d26f61387dca",
                                                "text": "„Mit offensichtlich unberechtigten Patentansprüchen bei der Browsersicherheit hat eine britische Computerfirma für Verwirrung gesorgt.“"
                                            },
                                            {
                                                "example_id": "a01af866-5465-4021-b6cc-a258b1a6fbe1",
                                                "sense_id": "7ca00c07-1ca9-38ea-84ca-d26f61387dca",
                                                "text": "Unberechtigter Zutritt ist verboten! Das steht doch auf dem Schild da! Haben Sie einen Ausweis dabei?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
