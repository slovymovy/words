                "senses": [
                    {
                        "sense_id": "2dace519-1909-3356-8097-f9a48cbb2984",
                        "entry_id": "a20f9e1d-01f7-3da8-9f81-26f67d0510ef",
                        "glosses": [
                            "im südlichen Teil des nicht vom Westsaharakonflikt betroffenen Gebiets Marokkos (südwestlicher Hoher Atlas, Antiatlas, Sous) sowie angrenzendem algerischen Gebiet von ungefähr 8 Millionen, zumeist mehrsprachigen (Arabisch, Französisch) Menschen gesprochene/r Berberdialekt/Berbersprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e730bc00-4295-4007-b310-8b3e4f73deec",
                                "sense_id": "2dace519-1909-3356-8097-f9a48cbb2984",
                                "text": "„Die Berberjuden leben in den Bergen, namentlich im Atlasgebirge, und sprechen ‚Chleuh‘, den den Berbern des Atlasgebirges eigenen Dialekt.“"
                            },
                            {
                                "example_id": "0f240800-7df1-44e2-99f5-80575ced3d7e",
                                "sense_id": "2dace519-1909-3356-8097-f9a48cbb2984",
                                "text": "„Die meisten sesshaften Stämme des Hohen Atlas, des Antiatlas, der Sousebene und der Oasen im Südwesten sprechen Taschelhit oder Chleuh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
