                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9169de36-6b24-4178-b6fc-c2e9e4c6166a",
                                "sense_id": "a1a96199-391e-32ed-abd5-80f4a3505454",
                                "text": "It is called bachelor in the Ohio Valley, campbellite, croppie, and new-light in Illinois, Indiana, and Кentucky; tin-mouth or paper-mouth in northern Indiana and Illinois, and sac-à-lait, and chinduapin perch in the lower Mississippi and Texas."
                            },
                            {
                                "example_id": "6d2be32e-99ec-4d64-a61c-52e83924ac92",
                                "sense_id": "a1a96199-391e-32ed-abd5-80f4a3505454",
                                "text": "When Earhart and Jarvis found out that the Crappiethon Classic would be held at Lake Harris in Hot Springs, Arkansas, one year, they knew they had to develop new strategies for taking papermouths, because the lake was deep and clear -- unlike most of the lakes in their native state of Tennessee."
                            }
                        ]
