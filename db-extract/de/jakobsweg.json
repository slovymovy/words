                        "form": "die Jakobswege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26164e5a-b11b-3554-8b33-acfc52972731",
                        "entry_id": "5683d8cc-a545-3747-9dda-c6dbc71cd1d9",
                        "glosses": [
                            "der Pilgerweg zum Grab des Apostels Jakobus in Santiago de Compostela in Spanien; in erster Linie der sog. camino frances, jene hochmittelalterliche Hauptverkehrsachse Nordspaniens, die von den Pyrenäen zum Jakobsgrab reicht und dabei die Königsstädte Jaca, Pamplona, Estella, Burgos und León miteinander verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d3d64c-1dfc-4a5e-bf3d-79d7477a6ab0",
                                "sense_id": "26164e5a-b11b-3554-8b33-acfc52972731",
                                "text": "Der gesamte Jakobsweg ist mit dem Symbol der Jakobsmuschel gekennzeichnet."
                            },
                            {
                                "example_id": "872b7a2b-4819-4eb4-bdc8-981f7ecac741",
                                "sense_id": "26164e5a-b11b-3554-8b33-acfc52972731",
                                "text": "„Die spanische Hauptroute des Jakobswegs wurde im Jahr 1993 in das UNESCO-Welterbe aufgenommen.“"
                            },
                            {
                                "example_id": "f139bfe7-c964-4719-802f-2a3bbf627af0",
                                "sense_id": "26164e5a-b11b-3554-8b33-acfc52972731",
                                "text": "„Der Jakobsweg ist der bekannteste Pilgerweg der Welt.“"
                            },
                            {
                                "example_id": "7fd9d5bb-a982-4750-9249-96942df2d0dc",
                                "sense_id": "26164e5a-b11b-3554-8b33-acfc52972731",
                                "text": "\"Charakteristisch für diese am Jakobsweg gelegenen Städte war die Verleihung von Stadtrechten, die die Ansiedlung von Händlern und die Entwicklung von Märkten und Messen erleichterte.\""
                            },
                            {
                                "example_id": "d97e4cd9-75eb-4170-89a7-bd0bbfb0c9ba",
                                "sense_id": "26164e5a-b11b-3554-8b33-acfc52972731",
                                "text": "„Ausgangspunkte des Jakobsweges im Rheinland sind die Städte Köln und Bonn, südlich von Euskirchen treffen beide Wege aufeinander und führen weiter nach Trier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
