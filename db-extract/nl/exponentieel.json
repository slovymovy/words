                                "target_senses": [
                                    {
                                        "sense_id": "e9ad18d0-1aa9-37ef-97e6-2dbbb0fcb7a8",
                                        "entry_id": "0a0c46ff-7452-372b-b450-15b2c76f1e63",
                                        "glosses": [
                                            "Qualifie une fonction dont c’est l’exposant qui est variable."
                                        ],
                                        "tags": [
                                            "analytic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37352195-1ffc-4bdd-9333-3858e25074de",
                                                "sense_id": "e9ad18d0-1aa9-37ef-97e6-2dbbb0fcb7a8",
                                                "text": "La fonction exponentielle possède la propriété remarquable d’être égale à sa dérivée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d64154-dac3-387a-befb-405f7e5ff6d2",
                                        "entry_id": "0a0c46ff-7452-372b-b450-15b2c76f1e63",
                                        "glosses": [
                                            "Qualifie une croissance dont la courbe peut être représentée par une fonction exponentielle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cf61532-5ee8-47a5-96d7-5cdb7709ef53",
                                                "sense_id": "11d64154-dac3-387a-befb-405f7e5ff6d2",
                                                "text": "Plusieurs variants sont apparus dans d’autres pays : la Grande-Bretagne, l’Afrique du Sud et le Brésil.\n Ils sont soit plus contagieux, soit plus mortels. Leur arrivée au Québec serait « catastrophique » et M. Legault craint une « propagation exponentielle »."
                                            },
                                            {
                                                "example_id": "00a33350-61e9-462f-9cbf-b8efb6d4364f",
                                                "sense_id": "11d64154-dac3-387a-befb-405f7e5ff6d2",
                                                "text": "La production de plastique ayant augmenté de manière exponentielle depuis les années 1950, il a été récemment démontré que sans une stratégie de réduction de ces déchets, cette contamination triplera d’ici à 2040."
                                            },
                                            {
                                                "example_id": "898bdc7e-3bed-4d79-9fa9-c341ae847deb",
                                                "sense_id": "11d64154-dac3-387a-befb-405f7e5ff6d2",
                                                "text": "Nos gouvernements ont sous-estimé ce quʼest une croissance exponentielle, alors que cette fois-ci lʼon connaissait le virus…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3696d212-8405-3bcb-9d4b-bbd025a3d10d",
                                        "entry_id": "0a0c46ff-7452-372b-b450-15b2c76f1e63",
                                        "glosses": [
                                            "Qualifie une loi de probabilité dont la courbe est celle d’une fonction exponentielle."
                                        ],
                                        "tags": [
                                            "Probabilités"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
