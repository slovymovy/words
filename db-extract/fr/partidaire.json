                "senses": [
                    {
                        "sense_id": "7e00b0a4-459c-3e1b-be2f-81affa67196c",
                        "entry_id": "6cb037d0-c5da-3ca0-9aed-12be131c34b7",
                        "glosses": [
                            "Relatif à un parti politique, partisan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914d96c8-366a-495b-a9b5-22cac0521170",
                                "sense_id": "7e00b0a4-459c-3e1b-be2f-81affa67196c",
                                "text": "Je lui dis que comme beaucoup de militants français je n’ai pas (ou plus) d’appartenance partidaire : méfiance face aux organisations politiques…"
                            },
                            {
                                "example_id": "16ff8f4b-a580-47e0-a438-bbd4a858d6b1",
                                "sense_id": "7e00b0a4-459c-3e1b-be2f-81affa67196c",
                                "text": "Mais le « centralisme démocratique » n’est pas seulement un principe partidaire – du parti –, il est devenu un principe social."
                            },
                            {
                                "example_id": "a8bfb85f-a960-462f-855d-d323894cfcfc",
                                "sense_id": "7e00b0a4-459c-3e1b-be2f-81affa67196c",
                                "text": "C'est le ministre le plus présent à l’Assemblée nationale, plus qu'aucun autre. Et malgré ça, malgré des accords, des discussions en commission, le vote, c’est un vote partidaire. Ça le rend fou. Il dit : “Ça n’a pas de sens.”"
                            }
                        ]
                    }
