                    {
                        "sense_id": "3ffafac5-1aab-39fa-a030-6847f3fffd25",
                        "entry_id": "f9970dae-1923-3d8c-b6b1-1fccd46efede",
                        "glosses": [
                            "Maître d’école coranique."
                        ],
                        "tags": [
                            "Maroc",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "fc96acee-7275-4ec4-a625-d368ad71f6ec",
                                "sense_id": "3ffafac5-1aab-39fa-a030-6847f3fffd25",
                                "text": "La mise en accusation du fquih apparaît à travers des séquences qui remplissent une fonction de commentaire et dévoilent le pouvoir démesuré dont jouit le maître de l’école coranique."
                            },
                            {
                                "example_id": "422586c6-469d-49bf-96bd-2417f32f549f",
                                "sense_id": "3ffafac5-1aab-39fa-a030-6847f3fffd25",
                                "text": "Qu’un verset soit interrompu au milieu, et les cinquante petits bustes restent pétrifiés dans la pose où ils se trouvent. Quand le fquih redonne le signal du départ, les bustes repartent en même temps que les voix dans leur mouvement de pendule."
                            }
                        ]
                    },
