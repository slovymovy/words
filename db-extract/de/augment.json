                "senses": [
                    {
                        "sense_id": "5434bac2-4bad-3125-8f9a-310e8565ba89",
                        "entry_id": "49ebda8d-840b-383c-b0fb-3aed9ab7ed6c",
                        "glosses": [
                            "in manchen indogermanischen Sprachen ein Morphem zur Anzeige der Vergangenheit bei Verben"
                        ],
                        "tags": [
                            "Flexion"
                        ],
                        "examples": [
                            {
                                "example_id": "be74d6eb-faca-4b60-8e18-5aa59a8dde56",
                                "sense_id": "5434bac2-4bad-3125-8f9a-310e8565ba89",
                                "text": "„Das Augment ist das Zeichen des Indikativs der historischen Zeiten (Imperfekt, Aorist, Plusquamperfekt).“"
                            },
                            {
                                "example_id": "7eaea82c-3487-42d9-8ad6-99727c219cd6",
                                "sense_id": "5434bac2-4bad-3125-8f9a-310e8565ba89",
                                "text": "„Als Ausdruck der Vergangenheitsbedeutung verwendet eine Reihe von Sprachen (Altindisch, Iranisch, Griechisch, Phrygisch, Armenisch), aber nicht das Gesamt-Indogermanische das sogenannte Augment (indogermanisch *e-), ursprünglich wohl ein selbständiges Zeitadverb, an welches die Verbalformen sich enklitisch anlehnten (…) und dann mit ihm zusammenwuchsen.“"
                            },
                            {
                                "example_id": "0746b5aa-d040-49e8-8ea5-2a8849a5c45d",
                                "sense_id": "5434bac2-4bad-3125-8f9a-310e8565ba89",
                                "text": "„Die Verben nehmen in dem Partizip des Präteritums das Augment ge (§. 35) an z. B. ge-sprochen, ge-redet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
