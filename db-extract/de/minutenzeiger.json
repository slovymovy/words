                ],
                "senses": [
                    {
                        "sense_id": "bceec719-fa08-3b0a-9c39-ce1d71b3373c",
                        "entry_id": "97a20f9e-6326-3cc5-9db8-f9ce8189b1fb",
                        "glosses": [
                            "der längere bewegliche Stab an einer analogen Uhr, der in einer Stunde eine 360° Drehung (im Uhrzeigersinn) vollzieht und, je nach Position, eine bestimmte Minute anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "038368ec-421c-4a87-a063-0ad705dc1a63",
                                "sense_id": "bceec719-fa08-3b0a-9c39-ce1d71b3373c",
                                "text": "Der Minutenzeiger ist abgebrochen und somit kürzer als der Stundenzeiger, gehen jetzt die Minuten länger und die Stunden kürzer als vorher?"
                            },
                            {
                                "example_id": "9393b142-62e2-4db3-b788-5bc89800d1da",
                                "sense_id": "bceec719-fa08-3b0a-9c39-ce1d71b3373c",
                                "text": "Nachts, wenn die Menschen schlafen, drehen kleine Wichtel den Minutenzeiger schneller, damit die Menschen wieder schneller zur ihre Arbeitsstelle kommen."
                            },
                            {
                                "example_id": "585c78fe-8d23-48b8-98d2-490299e42236",
                                "sense_id": "bceec719-fa08-3b0a-9c39-ce1d71b3373c",
                                "text": "„Die Uhr scheint lediglich ein, zwei Minuten gestanden zu haben, es besteht kaum ein sichtbarer Abstand zwischen ihr und den anderen, alle Minutenzeiger in der gleichen Stellung, und doch zeigen sie nicht dieselbe Zeit an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cd59f23-6a92-44d7-85a8-a82ba505e314",
                        "source_entry_id": "97a20f9e-6326-3cc5-9db8-f9ce8189b1fb",
                        "source_sense_id": "bceec719-fa08-3b0a-9c39-ce1d71b3373c",
                        "source_sense_description": "Zeiger für Minuten",
