                            },
                            {
                                "target_word": "blockade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb43844-943a-3123-99ee-85848c5a134c",
                                        "entry_id": "f9fe828e-7edd-3445-b9d3-2a66b598e171",
                                        "glosses": [
                                            "To create a blockade against."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae63d363-96d2-4319-a4d4-abfa96e5f3b4",
                                                "sense_id": "9bb43844-943a-3123-99ee-85848c5a134c",
                                                "text": "On January 5 1969, residents blockaded the level crossing at Newcastleton, ahead of the final passenger train. It was only after the then-local MP David (now Lord) Steel had alighted from the St Pancras-bound Sleeper service and negotiated their dispersal (in return for the release without charge of one of the protest organisers, Reverend Brydon Maben) that the train was allowed on its way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
