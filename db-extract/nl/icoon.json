                                "target_word": "icône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e3da95-2202-33d3-8bec-d558a4a2c45b",
                                        "entry_id": "3fe8ac69-c6af-3778-a4ed-09e27a1ca698",
                                        "glosses": [
                                            "Image sainte, le plus souvent peinte sur bois, qui est vénérée dans l'Église d'Orient."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0725b05a-b727-497a-b8b3-c8c7ee7347a8",
                                                "sense_id": "c6e3da95-2202-33d3-8bec-d558a4a2c45b",
                                                "text": "Les saintes icônes."
                                            },
                                            {
                                                "example_id": "ec8e0bf5-9381-48d8-b4c9-b6d2e63aae34",
                                                "sense_id": "c6e3da95-2202-33d3-8bec-d558a4a2c45b",
                                                "text": "Andreï Roublev fut un célèbre peintre d'icônes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfb1d49-01c2-3c65-9efa-79197d6f9e25",
                                        "entry_id": "3fe8ac69-c6af-3778-a4ed-09e27a1ca698",
                                        "glosses": [
                                            "Archétype."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c78ef792-dada-408a-9648-dc92452abb5a",
                                                "sense_id": "cdfb1d49-01c2-3c65-9efa-79197d6f9e25",
                                                "text": "[Titre] Du rififi sur « Sesame Street » : Ernest et Bert sont-ils des icônes gays ?"
                                            },
                                            {
                                                "example_id": "eac2a2ee-50f8-4d04-b97d-c12fd653e889",
                                                "sense_id": "cdfb1d49-01c2-3c65-9efa-79197d6f9e25",
                                                "text": "La jeune femme, qui travaillait dans une épicerie, est la première victime confirmée de la répression des généraux birmans.\n Elle est déjà une icône pour les manifestants. Certains défilent avec sa photo et une banderole à son image a été déployée sur un pont."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "icône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a369258-71be-399a-be1d-40a89b080452",
                                        "entry_id": "4bb84d2c-70bc-3ba7-9114-8851b492055f",
                                        "glosses": [
                                            "Type de signe se caractérisant par le fait qu’il y a une similitude de fait avec l’objet qu’il dénote en vertu de ses caractères propres."
                                        ],
                                        "tags": [
                                            "Sémiotique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1acc38f-2f3a-4fd8-a2d4-3acde8c7cfec",
                                                "sense_id": "7a369258-71be-399a-be1d-40a89b080452",
                                                "text": "C’est la fonction de signe de l’icône qui doit être interrogée et non pas sa fonction d’image. Ce concept abstrait vise à mieux rendre compte du fonctionnement du signe et du signifiant."
                                            },
                                            {
                                                "example_id": "616a9ec0-cbe5-4492-b633-fc27809fa594",
                                                "sense_id": "7a369258-71be-399a-be1d-40a89b080452",
                                                "text": "Le plan d’une maison (représentant) est une icône de cette demeure (représenté) au sens de Peirce parce qu’il y a une similitude de fait entre le plan et la maison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "icône",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cf67cd-32f3-3a9c-b8b3-b097452511b0",
                                        "entry_id": "4c1eee31-6476-3cd1-8977-b47d1969b8b6",
                                        "glosses": [
                                            "Symbole graphique apparaissant sur un écran et représentant une fonction ou une application logicielle particulière que l’on peut sélectionner et activer, généralement via le curseur d’une souris."
                                        ],
                                        "tags": [
                                            "Interface graphique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a7498df-beca-4f49-9e80-1487bab9eac2",
                                                "sense_id": "c7cf67cd-32f3-3a9c-b8b3-b097452511b0",
                                                "text": "Lorsque vous branchez un disque externe, une icône apparaît automatiquement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
