                                "example_id": "79709afd-7f5c-4a0d-97b3-a1eb60331604",
                                "sense_id": "a6e1b10a-d5a4-331a-8748-4581ea4f3ac8",
                                "text": "Een uitverkocht Prismare (265 liefhebbers op bijgeplaatste stoelen) genoot gisteravond van bassende keelklanken, het doordringende, sonore geluid van klankbekkens en schallende grote hoorns."
                            },
                            {
                                "example_id": "d6be2520-3005-4acf-a0a9-9efb6c6420c7",
                                "sense_id": "a6e1b10a-d5a4-331a-8748-4581ea4f3ac8",
                                "text": "In een geluidsfragment in het Radio2-programma Gijs 2.0 was vanmiddag een onvervalst smakgeluid te horen en daarna de schallende lach van de Brabantse Sandra."
                            }
                        ]
                    }
