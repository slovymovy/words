    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7b30e9d-2711-343f-b27a-50422c97c714",
                    "sense_definition": "het natuurlijke gevoel of de fysieke behoefte om te eten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedselbehoefte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn buik rammelt van de <w>honger</w> omdat ik nog niet heb ontbeten.",
                            "target_lang_translations": {
                                "en": "My stomach is growling with <w>hunger</w> because I haven't had breakfast yet.",
                                "ru": "У меня в животе урчит от <w>голода</w>, потому что я еще не завтракал."
                            }
                        },
                        {
                            "text": "Hij had grote <w>honger</w> gekregen van al dat harde werken in de tuin.",
                            "target_lang_translations": {
                                "en": "He had developed a great <w>hunger</w> from all that hard work in the garden.",
                                "ru": "Он сильно <w>проголодался</w> после всей этой тяжелой работы в саду."
                            }
                        }
                    ],
                    "antonyms": [
                        "dorst",
                        "verzadiging"
                    ],
                    "common_phrases": [
                        "honger hebben",
                        "grote honger",
                        "rammelen van de honger"
                    ],
                    "target_lang_definitions": {
                        "en": "The natural feeling or physical need to eat.",
                        "ru": "Естественное чувство или физическая потребность в еде"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hunger",
                                "target_lang_sense_clarification": "the physical sensation of needing food"
                            },
                            {
                                "target_lang_word": "appetite",
                                "target_lang_sense_clarification": "the desire to eat"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "голод",
                                "target_lang_sense_clarification": "физическое ощущение потребности в пище"
                            },
                            {
                                "target_lang_word": "аппетит",
                                "target_lang_sense_clarification": "желание поесть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b92e9b-794c-3e7e-bf35-ce08cda9fd53",
                    "sense_definition": "een ernstig en vaak levensbedreigend tekort aan voedsel in een bepaalde regio of groep",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voedselbehoefte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>honger</w> die volgde op de misoogst was verschrikkelijk voor de hele bevolking.",
                            "target_lang_translations": {
                                "en": "The <w>famine</w> that followed the crop failure was terrible for the entire population.",
                                "ru": "<w>Голод</w>, последовавший за неурожаем, был ужасен для всего населения."
                            }
                        },
                        {
                            "text": "Veel mensen stierven door de extreme <w>honger</w> tijdens de koude wintermaanden.",
                            "target_lang_translations": {
                                "en": "Many people died from extreme <w>starvation</w> during the cold winter months.",
                                "ru": "Многие люди умерли от сильного <w>голода</w> в холодные зимние месяцы."
                            }
                        }
                    ],
                    "synonyms": [
                        "Hongaar"
                    ],
                    "antonyms": [
                        "overvloed"
                    ],
                    "common_phrases": [
                        "extreme honger",
                        "sterven van de honger"
                    ],
                    "target_lang_definitions": {
                        "en": "A severe and often life-threatening shortage of food in a specific region or group.",
                        "ru": "Серьезная и часто опасная для жизни нехватка продовольствия в определенном регионе или группе населения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hunger",
                                "target_lang_sense_clarification": "widespread lack of food"
                            },
                            {
                                "target_lang_word": "famine",
                                "target_lang_sense_clarification": "extreme scarcity of food in a region"
                            },
                            {
                                "target_lang_word": "starvation",
                                "target_lang_sense_clarification": "suffering or death caused by lack of food"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "голод",
                                "target_lang_sense_clarification": "массовое бедствие из-за нехватки еды"
                            },
                            {
                                "target_lang_word": "голодание",
                                "target_lang_sense_clarification": "состояние организма при отсутствии пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66145408-3389-3adc-9966-874e6731e992",
                    "sense_definition": "een verouderde benaming voor een <w>Hongaar</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "In die oude teksten werd een inwoner van Hongarije nog een <w>honger</w> genoemd.",
                            "target_lang_translations": {
                                "en": "In those old texts, an inhabitant of Hungary was still called a <w>Hungarian</w>.",
                                "ru": "В тех старых текстах жителя Венгрии еще называли <w>венгром</w>."
                            }
                        },
                        {
                            "text": "De term <w>honger</w> als synoniem voor Hongaar komt tegenwoordig bijna niet meer voor.",
                            "target_lang_translations": {
                                "en": "The term <w>Hungarian</w> as a synonym for a person from Hungary is almost non-existent nowadays.",
                                "ru": "Термин <w>венгр</w> в качестве синонима жителя Венгрии сегодня почти не встречается."
                            }
                        }
                    ],
                    "synonyms": [
                        "Hongaar"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde term voor een inwoner van Hongarije"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An archaic term for a Hungarian person.",
                        "ru": "Устаревшее название венгра"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Hungarian",
                                "target_lang_sense_clarification": "archaic term for a person from Hungary"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "венгр",
                                "target_lang_sense_clarification": "устаревшее обозначение жителя Венгрии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cde468a4-f9bc-3c8b-8037-374e7c5e7c7e",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>hongeren</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>honger</w> naar meer kennis over de geschiedenis van dit land.",
                            "target_lang_translations": {
                                "en": "I <w>hunger</w> for more knowledge about the history of this country.",
                                "ru": "Я <w>жажду</w> новых знаний об истории этой страны."
                            }
                        },
                        {
                            "text": "Hoewel ik vast, <w>honger</w> ik niet echt naar fysiek voedsel.",
                            "target_lang_translations": {
                                "en": "Although I am fasting, I don't really <w>crave</w> physical food.",
                                "ru": "Хотя я пощусь, я не особо <w>голодаю</w> по физической пище."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van hongeren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'to hunger' (to long for or crave).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола «hongeren» (жаждать, голодать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hunger",
                                "target_lang_sense_clarification": "to have a strong desire or need for something"
                            },
                            {
                                "target_lang_word": "crave",
                                "target_lang_sense_clarification": "to feel a powerful desire for"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "жажду",
                                "target_lang_sense_clarification": "сильно желать чего-либо"
                            },
                            {
                                "target_lang_word": "голодаю",
                                "target_lang_sense_clarification": "испытывать голод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b83967c-afe4-38f7-8394-2c9a8cfe7abc",
                    "sense_definition": "de gebiedende wijs van <w>hongeren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Honger</w> niet langer en kom eindelijk eens aan tafel zitten.",
                            "target_lang_translations": {
                                "en": "Do not <w>go hungry</w> any longer and finally come sit at the table.",
                                "ru": "Не <w>голодай</w> больше и садись, наконец, за стол."
                            }
                        },
                        {
                            "text": "Als je wilt afvallen, <w>honger</w> dan op een verantwoorde manier.",
                            "target_lang_translations": {
                                "en": "If you want to lose weight, <w>fast</w> in a responsible manner.",
                                "ru": "Если хочешь похудеть, <w>голодай</w> ответственно."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief van hongeren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'to hunger'.",
                        "ru": "Повелительное наклонение глагола «hongeren»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hunger",
                                "target_lang_sense_clarification": "command form: to long for or go hungry"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "голодай",
                                "target_lang_sense_clarification": "форма приказа или совета испытывать голод"
                            },
                            {
                                "target_lang_word": "жажди",
                                "target_lang_sense_clarification": "форма приказа стремиться к чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
