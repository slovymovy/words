                        "sense_id": "709c466d-458c-33ab-bf72-851f2f38617d",
                        "entry_id": "a0314557-03d3-3808-95c7-f3863c5c51b1",
                        "glosses": [
                            "Any location whose waters are supposed to have curative properties."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "f6b51665-c0fd-4f7f-8edd-1f855ee047d4",
                                "sense_id": "709c466d-458c-33ab-bf72-851f2f38617d",
                                "text": "...those who are afflicted with rheumatic, neuralgic, and splenetic diseases, go, and are cured by the thousands. These Bethesdas are scattered all up and down our country, blessed be God!"
                            },
                            {
                                "example_id": "3c402e72-d8f3-4b7c-ab4b-29195fd2f6cc",
                                "sense_id": "709c466d-458c-33ab-bf72-851f2f38617d",
                                "text": "Time was when this Bethesda too was curative, a sweet oasis in a parched and driven city. The day we went we found the fountain had been shut off."
                            }
                        ]
                    }
                ],
