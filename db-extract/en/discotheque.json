                                            {
                                                "example_id": "caf8a500-5ba6-4772-b23c-0bac20e67f32",
                                                "sense_id": "9da6faa3-90c7-3fd6-9ec9-85e016ea0f73",
                                                "text": "„Regelmäßig veranstalte ich auch eine Disko bei meinem Freund Norbert in seinem kleinen Club in Rheinland-Pfalz, weil der Mann mich mit seinen unglaublichen Geschichten fasziniert.“"
                                            },
                                            {
                                                "example_id": "c737fb8f-0b0f-42dc-92b9-8beddcb432bc",
                                                "sense_id": "9da6faa3-90c7-3fd6-9ec9-85e016ea0f73",
                                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
