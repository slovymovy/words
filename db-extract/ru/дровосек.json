                "senses": [
                    {
                        "sense_id": "9e161901-1e6d-36a7-8ede-ff00047f0346",
                        "entry_id": "f85bb214-abe4-3abf-acfd-a3a62b21203f",
                        "glosses": [
                            "лесоруб"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6accd8a-9612-4a2c-b372-fec5a5520b53",
                                "sense_id": "9e161901-1e6d-36a7-8ede-ff00047f0346",
                                "text": "Смиренный дровосек нёс на спине вязанку хвороста, чтобы продать топливо на торжище и купить хлеба."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a6e9bf7-4fbe-4d0c-b9f4-b2d32065d560",
                        "source_entry_id": "f85bb214-abe4-3abf-acfd-a3a62b21203f",
                        "source_sense_id": "9e161901-1e6d-36a7-8ede-ff00047f0346",
                        "target_lang_word": "lumberjack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lumberjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "932dba31-e52d-3267-af03-7f70987a732b",
                                        "entry_id": "7636220e-0e45-3d85-844f-86ee8c9da20c",
                                        "glosses": [
                                            "A person whose work is to fell trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e32b716-abc0-4176-9459-f8adb0f5f959",
                                                "sense_id": "932dba31-e52d-3267-af03-7f70987a732b",
                                                "text": "He's a lumberjack and he's OK / He sleeps all night and works all day / I cut down trees, I eat my lunch / I go to the lavatory"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1358956-9112-38b2-8f44-406dcab47286",
                                        "entry_id": "7636220e-0e45-3d85-844f-86ee8c9da20c",
                                        "glosses": [
                                            "A lumberjacket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumberjack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0ae5f8-f254-34bb-8a1a-600e4e3b9430",
                                        "entry_id": "5e7e12f3-b090-33a4-b9f5-73d6f5a1306d",
                                        "glosses": [
                                            "To work as a lumberjack, cutting down trees."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b826242f-0ee2-4ef6-b535-7441361372e4",
                                                "sense_id": "1d0ae5f8-f254-34bb-8a1a-600e4e3b9430",
                                                "text": "Many of the lumberjacking memories have faded to black and white, the brightest moments colored mostly by Jim McKay’s yellow blazer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "303c47a6-1c0f-4521-a4ac-d4498c132e1a",
                        "source_entry_id": "f85bb214-abe4-3abf-acfd-a3a62b21203f",
                        "source_sense_id": "9e161901-1e6d-36a7-8ede-ff00047f0346",
                        "target_lang_word": "Holzfäller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holzfäller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a768640-1689-3dd1-a34b-0acf1ced6c6f",
                                        "entry_id": "26ec6511-d008-3b69-843c-0c7ee97c0f83",
                                        "glosses": [
                                            "Person, deren Beruf das Fällen von Bäumen und die Vorbereitung zum Abtransport ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f69826-7eba-486d-ac39-a256932cb927",
                                                "sense_id": "5a768640-1689-3dd1-a34b-0acf1ced6c6f",
                                                "text": "Holzfäller tragen zumeist eine spezielle Schutzkleidung, um Verletzungen durch Kettensägen zu vermeiden."
                                            },
                                            {
                                                "example_id": "7edbd5c6-7faf-4af9-a8a1-a2c666434482",
                                                "sense_id": "5a768640-1689-3dd1-a34b-0acf1ced6c6f",
                                                "text": "„Auf dem legendären Cover: ein sinnlicher, lachender Adonis – schmale Hüften, breite Schultern, bloßer Oberkörper, mit deutlich in der Hose liegendem Geschlechtsteil, blond, mit Tolle, balanciert als Holzfäller und Flößer auf einem Baumstamm in der Flussmitte, an seiner Hüfte das typische Finnenmesser, in den Händen die Flößerstange.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c69d3177-96c8-44a8-bc47-12befae0eb8f",
                        "source_entry_id": "f85bb214-abe4-3abf-acfd-a3a62b21203f",
                        "source_sense_id": "9e161901-1e6d-36a7-8ede-ff00047f0346",
                        "target_lang_word": "abatteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abatteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72ff6dfc-b665-3f73-aad5-4f7e574657a1",
                                        "entry_id": "dcb737ad-0ddb-3799-a475-da6ec8ab1dcc",
                                        "glosses": [
                                            "Celui qui abat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8401a2c8-b034-44ee-89be-f92bc169c0ac",
                                                "sense_id": "72ff6dfc-b665-3f73-aad5-4f7e574657a1",
                                                "text": "Ce bûcheron est un grand abatteur de bois."
                                            },
                                            {
                                                "example_id": "6defec83-e621-4a2c-b03e-de137ac615a1",
                                                "sense_id": "72ff6dfc-b665-3f73-aad5-4f7e574657a1",
                                                "text": "C’est un grand abatteur de quilles, c’est un homme fort adroit au jeu de quilles."
                                            },
                                            {
                                                "example_id": "f7740dd6-876c-465e-a92b-72c0a322c298",
                                                "sense_id": "72ff6dfc-b665-3f73-aad5-4f7e574657a1",
                                                "text": "Vétérans chevronnés de la guerre des boutons, grands maraudeurs de pommes et abatteurs de noix, tous, garnements de dix à douze ans, nous avions ce printemps-là reformé notre association de bandits grimpeurs, pillards aériens et détrousseurs de nids."
                                            },
                                            {
                                                "example_id": "b048297d-eeef-4ee9-a1af-2df9adbf65f2",
                                                "sense_id": "72ff6dfc-b665-3f73-aad5-4f7e574657a1",
                                                "text": "Assis bas sur une chauffeuse bancale, les mains en avant, devant l'âtre qui fut celui de Bertine et où brûle encore ce noueux bois de culée qui appartient à l'abatteur et que Jobeau, ahanant, a dû passer des heures à fendre, je n'ai plus qu'à écouter Marthe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67bf3033-8068-3cb1-a53e-8789229f1d21",
                                        "entry_id": "dcb737ad-0ddb-3799-a475-da6ec8ab1dcc",
                                        "glosses": [
                                            "En Afrique équatoriale francophone, bûcheron spécialisé dans l’abattage des arbres de grandes dimensions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d1a0c76-2c0d-3154-aa4e-2e5b61c32157",
                                        "entry_id": "dcb737ad-0ddb-3799-a475-da6ec8ab1dcc",
                                        "glosses": [
                                            "Celui qui abat du travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630282f3-28ce-40ca-beb1-2b144ca86a7f",
                                                "sense_id": "4d1a0c76-2c0d-3154-aa4e-2e5b61c32157",
                                                "text": "Il avait un don unique entre tous, un don particulièrement précieux pour le travailleur, pour le producteur, pour un bourreau de travail comme lui, pour un gros abatteur de besogne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a1d7e9b-8e53-341b-ac6e-9c226d72a511",
                                        "entry_id": "dcb737ad-0ddb-3799-a475-da6ec8ab1dcc",
                                        "glosses": [
                                            "Ouvrier qui attaque la veine au pic, avec ou sans le secours d’explosifs, pour en faire tomber la houille en blocs et morceaux."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0b7872d-54cc-34d3-8971-40c51593cb0c",
                                        "entry_id": "dcb737ad-0ddb-3799-a475-da6ec8ab1dcc",
                                        "glosses": [
                                            "Homme qui se vante de prouesses qu’il n’a pas faites."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
