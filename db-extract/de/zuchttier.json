                                        "glosses": [
                                            "Animal qui est destiné à la reproduction."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be160ec2-2d45-488f-824e-64aaec24788b",
                                                "sense_id": "968b9f94-fd4c-37d9-84f3-65df9159dc65",
                                                "text": "Entre 1912 et 1945, le reproducteur est vendu une fois les saillies achevées."
                                            },
                                            {
                                                "example_id": "aa1dcf37-42b7-458f-a497-59099fbed0d0",
                                                "sense_id": "968b9f94-fd4c-37d9-84f3-65df9159dc65",
                                                "text": "Les reproducteurs ont absolument besoin d'eau avant et pendant la ponte ; sans quoi la fécondation n'a pas lieu (et tous les œufs sont clairs)."
