                        "entry_id": "99869b10-53bf-330d-afe0-459fbffe0cff",
                        "glosses": [
                            "Gesamtheit der Bewegung von Zahlungsmitteln (Geld, Checks, Wechsel, Überweisungen, Verrechnungen) innerhalb eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08d4e467-a21f-4fea-bebd-e90a53aaf8bf",
                                "sense_id": "cafdb2b8-1478-3346-a756-8480ec752b37",
                                "text": "„Im Zahlungsverkehr herrscht die bargeldlose Zahlungsweise vor.“"
                            },
                            {
                                "example_id": "b155543d-9790-43f1-90f1-0794b760e8d9",
                                "sense_id": "cafdb2b8-1478-3346-a756-8480ec752b37",
                                "text": "„Wegen eines Zahlendrehers in der Iban-Nummer, wie die Kontonummer mit 22 Stellen seit den neuen einheitlichen Richtlinien im europäischen Zahlungsverkehr heißt, kam das Geld jedoch nicht dort an, wo es hinsollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
