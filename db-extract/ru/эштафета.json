                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb877983-9305-4f73-809a-5e9c0c9fe893",
                                "sense_id": "00dc113c-3480-341e-9454-9409f8e4f60f",
                                "text": "Призвал было уже курьера, с тем чтобы отправить его с эштафетой, ― но любопытство такое одолело, какого ещё никогда не чувствовал."
                            },
                            {
                                "example_id": "64e06784-b0a0-4cd3-ac63-65933e23d59b",
                                "sense_id": "00dc113c-3480-341e-9454-9409f8e4f60f",
                                "text": "Сладкой водки французской графинчик предоставь на сей стол по эштафете!"
                            }
                        ]
                    }
