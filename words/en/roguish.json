{
    "word_family": [
        "rogue",
        "roguery"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd9cd941-2901-32c9-9965-3a0e8867b3be",
                    "sense_definition": "Mischievous and playful.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mischievous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at him with a <w>roguish</w> twinkle in her eyes.",
                            "target_lang_translations": {
                                "de": "Sie sah ihn mit einem <w>verschmitzten</w> Funkeln in den Augen an."
                            }
                        },
                        {
                            "text": "He gave a <w>roguish</w> grin before telling his funny story.",
                            "target_lang_translations": {
                                "de": "Er zeigte ein <w>schelmisches</w> Grinsen, bevor er seine lustige Geschichte erzählte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roguish grin",
                        "roguish smile"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf schelmische oder neckische Weise verspielt; voller Schalk."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schelmisch",
                                "target_lang_sense_clarification": "auf eine liebenswürdige Art spitzbübisch oder neckend"
                            },
                            {
                                "target_lang_word": "verschmitzt",
                                "target_lang_sense_clarification": "auf amüsante Weise schlau und verschlagen"
                            },
                            {
                                "target_lang_word": "spitzbübisch",
                                "target_lang_sense_clarification": "ausgelassen, schelmisch"
                            },
                            {
                                "target_lang_word": "schalkhaft",
                                "target_lang_sense_clarification": "voll harmloser Späße"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1395773f-4ac0-3c91-851d-130922ce2203",
                    "sense_definition": "Unprincipled or unscrupulous.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dishonest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>roguish</w> salesman tricked many people into buying broken goods.",
                            "target_lang_translations": {
                                "de": "Der <w>skrupellose</w> Verkäufer brachte viele Menschen mit Tricks dazu, kaputte Waren zu kaufen."
                            }
                        },
                        {
                            "text": "His <w>roguish</w> behavior eventually led to his dismissal from the company.",
                            "target_lang_translations": {
                                "de": "Sein <w>schurkisches</w> Verhalten führte schließlich zu seiner Entlassung aus dem Unternehmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "roguey"
                    ],
                    "target_lang_definitions": {
                        "de": "Ohne moralische Grundsätze oder Skrupel; betrügerisch und unredlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "skrupellos",
                                "target_lang_sense_clarification": "ohne moralische Hemmungen"
                            },
                            {
                                "target_lang_word": "schurkisch",
                                "target_lang_sense_clarification": "wie ein Schurke; bösartig und betrügerisch"
                            },
                            {
                                "target_lang_word": "gewissenlos",
                                "target_lang_sense_clarification": "ohne Rücksicht auf Recht und Unrecht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}