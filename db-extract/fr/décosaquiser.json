                "senses": [
                    {
                        "sense_id": "13b4fbbe-6061-3b29-9d72-aab9727cbc00",
                        "entry_id": "e05347ef-ca04-3050-ba61-5d07c433d661",
                        "glosses": [
                            "Faire perdre son caractère cosaque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fc877a-fb8d-443d-b90c-d1450fc5e6eb",
                                "sense_id": "13b4fbbe-6061-3b29-9d72-aab9727cbc00",
                                "text": "Mon père, Valeri, était un Cosaque (dûment décosaquisé en 1920, quand j’avais un an)."
                            }
                        ]
                    },
                    {
                        "sense_id": "95f7f574-b482-3a05-989f-ab37d80e6cfa",
                        "entry_id": "e05347ef-ca04-3050-ba61-5d07c433d661",
                        "glosses": [
                            "Éliminer les cosaques de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93768f4-1e97-45a2-aa03-71b7d938fe6f",
                                "sense_id": "95f7f574-b482-3a05-989f-ab37d80e6cfa",
                                "text": "le 24 janvier 1919, il donne l’ordre de « décosaquiser » : « […] terreur massive contre les riches cosaques qui devront être exterminés et physiquement liquidés jusqu’au dernier »."
                            },
                            {
                                "example_id": "36c44935-eadb-4572-93a1-3a00ba291921",
                                "sense_id": "95f7f574-b482-3a05-989f-ab37d80e6cfa",
                                "text": "J’en profite aussi pour rapatrier les 2 divisions blanches devant tsaritzyne, et \"décosaquiser\" les armées d’Ukraine."
                            }
                        ]
                    }
