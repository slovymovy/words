                        ],
                        "examples": [
                            {
                                "example_id": "ebc0d4ac-d8f7-473d-bd02-60559ce058d4",
                                "sense_id": "ff10529d-086f-3452-afe7-b1c667fd8bb4",
                                "text": "Ils sont fort éveillés, peu farouches, et semblent\nEstre freres bessons, tant bien ils se ressemblent."
                            },
                            {
                                "example_id": "78ec0a92-25b2-4265-8bb0-8b875c82f277",
                                "sense_id": "ff10529d-086f-3452-afe7-b1c667fd8bb4",
                                "text": "J’ay veu l’astre beçon des yeux de ma Deesse."
                            }
                        ]
                    }
