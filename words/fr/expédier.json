                            {
                                "target_lang_word": "dispatch",
                                "target_lang_sense_clarification": "business or tasks, quickly"
                            },
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "hasty work, done carelessly"
                            }
