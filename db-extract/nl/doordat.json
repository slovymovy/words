                                                "sense_id": "2615ad6a-1c15-3b50-84f1-2347baa7e1a2",
                                                "text": "My life is ruined because of you!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a142bf4a-ad84-3bff-937f-fba263c3fcfe",
                                        "entry_id": "836c1206-4f75-3fb4-bd7c-ba5c701a7d0b",
                                        "glosses": [
                                            "For the reason [with that]."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ec236a7-9c85-4158-9779-9c21e8d5475e",
                                                "sense_id": "a142bf4a-ad84-3bff-937f-fba263c3fcfe",
                                                "text": "And God blessed the seuenth day, and sanctified it: because that in it he had rested from all his worke, which God created and made."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "because",
                                "target_lang_code": "en",
                                "target_senses": [
