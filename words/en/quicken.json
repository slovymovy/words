                },
                {
                    "sense_id": "fcde3840-aec3-3a43-9b98-8e540b5c2aad",
                    "sense_definition": "To give life to something or to bring back to life; to animate or revive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm spring rain seemed to <w>quicken</w> the dormant seeds in the garden.",
                            "target_lang_translations": {
                                "ru": "Теплый весенний дождь, казалось, <w>оживил</w> спящие семена в саду."
                            }
                        },
                        {
                            "text": "In the old myth, the goddess had the power to <w>quicken</w> the dead with a single touch.",
                            "target_lang_translations": {
                                "ru": "В древнем мифе богиня обладала силой <w>оживлять</w> мертвых одним прикосновением."
                            }
                        }
                    ],
                    "synonyms": [
                        "animate",
                        "revive",
                        "vivify",
                        "vitalise"
                    ],
                    "antonyms": [
                        "kill"
                    ],
                    "traits": [
