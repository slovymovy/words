{
    "word_family": [
        "descendant",
        "descent",
        "descendible",
        "descender"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "339f4dc7-e832-37c2-938f-15d92166e593",
                    "sense_definition": "To move from a higher to a lower position by going down along something, such as stairs or a mountain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement-down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers began to <w>descend</w> the mountain as the sun started to set.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы начали <w>спускаться</w> с горы, когда солнце начало садиться."
                            }
                        },
                        {
                            "text": "Please <w>descend</w> the stairs carefully to avoid slipping on the wet floor.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>спускайтесь</w> по лестнице осторожно, чтобы не поскользнуться на мокром полу."
                            }
                        }
                    ],
                    "antonyms": [
                        "ascend",
                        "climb",
                        "go up",
                        "rise"
                    ],
                    "common_phrases": [
                        "descend the stairs",
                        "descend the mountain",
                        "descend the ladder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться из более высокого положения в более низкое, спускаясь по чему-либо, например, по лестнице или горе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускаться",
                                "target_lang_sense_clarification": "двигаться вниз"
                            },
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "идти вниз"
                            },
                            {
                                "target_lang_word": "спуститься",
                                "target_lang_sense_clarification": "завершить движение вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b234cf80-587b-3b42-ab4b-dba06bf50e3b",
                    "sense_definition": "To physically move or fall downwards through the air or water.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement-down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the heavy rain <w>descend</w> upon the dry fields after the long drought.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как сильный дождь <w>обрушился</w> на сухие поля после долгой засухи."
                            }
                        },
                        {
                            "text": "The divers began to <w>descend</w> into the deep blue water to explore the reef.",
                            "target_lang_translations": {
                                "ru": "Дайверы начали <w>погружаться</w> в глубокую синюю воду, чтобы исследовать риф."
                            }
                        }
                    ],
                    "antonyms": [
                        "ascend",
                        "rise"
                    ],
                    "common_phrases": [
                        "descend into the deep",
                        "rain began to descend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически перемещаться или падать вниз через воздух или воду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "плавно двигаться вниз"
                            },
                            {
                                "target_lang_word": "погружаться",
                                "target_lang_sense_clarification": "уходить под воду"
                            },
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "осадках или предметах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3adcd96b-130c-336c-ace9-a4ff800d9f3a",
                    "sense_definition": "To come from a particular ancestor or ancestral group; to have a specific lineage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lineage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people in this region <w>descend</w> from the original settlers who arrived centuries ago.",
                            "target_lang_translations": {
                                "ru": "Многие люди в этом регионе <w>происходят</w> от первых поселенцев, прибывших сюда много веков назад."
                            }
                        },
                        {
                            "text": "He was proud to <w>descend</w> from a long line of famous explorers and scientists.",
                            "target_lang_translations": {
                                "ru": "Он гордился тем, что <w>происходит</w> из длинного рода знаменитых исследователей и ученых."
                            }
                        }
                    ],
                    "common_phrases": [
                        "descend from an ancestor",
                        "descend from royalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить от конкретного предка или группы предков; иметь определенную родословную."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "вести род"
                            },
                            {
                                "target_lang_word": "быть потомком",
                                "target_lang_sense_clarification": "являться наследником рода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6278a351-e03a-3862-beb3-eb79054c875e",
                    "sense_definition": "To pass into a worse or less formal state; to deteriorate or decline.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peaceful protest began to <w>descend</w> into chaos after the police arrived.",
                            "target_lang_translations": {
                                "ru": "Мирный протест начал <w>скатываться</w> в хаос после прибытия полиции."
                            }
                        },
                        {
                            "text": "The conversation would often <w>descend</w> into an argument about politics.",
                            "target_lang_translations": {
                                "ru": "Разговор часто <w>переходил</w> в спор о политике."
                            }
                        }
                    ],
                    "synonyms": [
                        "degenerate"
                    ],
                    "common_phrases": [
                        "descend into chaos",
                        "descend into madness",
                        "descend into violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить в худшее или менее формальное состояние; ухудшаться или приходить в упадок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скатываться",
                                "target_lang_sense_clarification": "переходить к худшему"
                            },
                            {
                                "target_lang_word": "погружаться",
                                "target_lang_sense_clarification": "в хаос или уныние"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "до низкого уровня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33e5ba44-c6c8-3dc3-ba9b-ad2fb10ecdba",
                    "sense_definition": "Of property, titles, or rights: to pass from one person to another by inheritance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family estate will <w>descend</w> to the eldest daughter according to the will.",
                            "target_lang_translations": {
                                "ru": "Семейное поместье <w>перейдет</w> к старшей дочери согласно завещанию."
                            }
                        },
                        {
                            "text": "In some cultures, the crown <w>descends</w> to the heir of the previous monarch automatically.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах корона автоматически <w>переходит</w> к наследнику предыдущего монарха."
                            }
                        }
                    ],
                    "common_phrases": [
                        "descend to the heir"
                    ],
                    "target_lang_definitions": {
                        "ru": "О собственности, титулах или правах: переходить от одного человека к другому по наследству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "по наследству"
                            },
                            {
                                "target_lang_word": "наследоваться",
                                "target_lang_sense_clarification": "о правах или имуществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "690e7000-08dd-318e-9ec5-46144f6bc51d",
                    "sense_definition": "To lower oneself morally or socially; to stoop to a lower level of behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I refused to <w>descend</w> to their level by using insults during the debate.",
                            "target_lang_translations": {
                                "ru": "Я отказался <w>опускаться</w> до их уровня, используя оскорбления во время дебатов."
                            }
                        },
                        {
                            "text": "It is sad to see a great artist <w>descend</w> to such poor quality work.",
                            "target_lang_translations": {
                                "ru": "Печально видеть, как великий художник <w>опускается</w> до столь низкокачественных работ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "descend to their level",
                        "descend to such depths"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опускаться морально или социально; доходить до более низкого уровня поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "морально"
                            },
                            {
                                "target_lang_word": "унижаться",
                                "target_lang_sense_clarification": "до определенного уровня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba2e7daf-5884-3881-a2a3-9c5faf283510",
                    "sense_definition": "To arrive suddenly or unexpectedly, often causing disruption or inconvenience.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "arrival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A group of uninvited relatives decided to <w>descend</w> upon us for the entire weekend.",
                            "target_lang_translations": {
                                "ru": "Группа незваных родственников решила <w>нагрянуть</w> к нам на все выходные."
                            }
                        },
                        {
                            "text": "The reporters began to <w>descend</w> upon the small town as soon as the news broke.",
                            "target_lang_translations": {
                                "ru": "Репортеры начали <w>съезжаться</w> в маленький городок, как только появились новости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "descend upon someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used when guests arrive unannounced"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно или неожиданно прибывать, часто вызывая беспорядок или неудобства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагрянуть",
                                "target_lang_sense_clarification": "неожиданно прийти"
                            },
                            {
                                "target_lang_word": "обрушиться",
                                "target_lang_sense_clarification": "о толпе или группе"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "внезапно появиться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44c8abc7-ada1-3bc6-872b-e9ba98bded17",
                    "sense_definition": "An instance of moving downward; a slope or a way down. A synonym for <w>descent</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement-down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At the <w>descend</w> of the hill, you should walk your horse to be safe.",
                            "target_lang_translations": {
                                "ru": "На <w>спуске</w> с холма вам следует вести лошадь под уздцы в целях безопасности."
                            }
                        },
                        {
                            "text": "The path follows a sharp <w>descend</w> toward the valley floor.",
                            "target_lang_translations": {
                                "ru": "Тропа идет по крутому <w>спуску</w> к дну долины."
                            }
                        }
                    ],
                    "synonyms": [
                        "descent"
                    ],
                    "common_phrases": [
                        "descend of a hill"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The noun form is largely replaced by 'descent' in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай движения вниз; склон или путь вниз. Синоним слова 'descent'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "наклонная поверхность"
                            },
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "поверхность горы или холма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}