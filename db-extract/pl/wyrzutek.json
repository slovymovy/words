                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a72b948-c95c-3ca9-ab3d-d479c1336b6f",
                        "entry_id": "ac4bfdfb-d1e5-3910-9d59-621886177d0e",
                        "glosses": [
                            "osobnik represyjnie wykluczony z danej społeczności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c39df691-132d-4d35-b0a0-796d348ea6fb",
                                "sense_id": "2a72b948-c95c-3ca9-ab3d-d479c1336b6f",
                                "text": "Nie utrzymuj kontaktów z tym wyrzutkiem, przynajmniej nie publicznie!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0befb0d-409c-4af1-941b-fbfcdcf3671f",
                        "source_entry_id": "ac4bfdfb-d1e5-3910-9d59-621886177d0e",
                        "source_sense_id": "2a72b948-c95c-3ca9-ab3d-d479c1336b6f",
                        "target_lang_word": "outcast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                        "entry_id": "1922064f-fa7a-3145-b0ce-60ddefb41e6d",
                                        "glosses": [
                                            "To cast out; to banish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcdc0ce-0e24-4609-8e19-798cf0e13180",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "And her faire yellow locks behind her flew, / Looſely diſperſt with puff of euery blaſt: / All as a blazing ſtarre doth farre outcaſt / His hearie beames, and flaming lockes diſpredd, / At ſight whereof the people ſtand aghaſt: […]"
                                            },
                                            {
                                                "example_id": "f20995f4-f31f-4220-bb47-020e9b6f856c",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "It means equal ruin to me, as the world reckons it — outcasting, the loss of my appointment, the breaking off my life's work. I pay my price."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                        "entry_id": "3315f9dd-599f-36e7-a483-ae59f2e7d189",
                                        "glosses": [
                                            "That has been cast out; banished, ostracized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e33450-4b43-4f8e-8761-2b692b956bbc",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "O, horrible fate! Outcast, rejected, / As one with pestilence infected!"
                                            },
                                            {
                                                "example_id": "3757b719-0a4d-4a16-b9b2-2db71c31bf71",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "We were not a big huggie family so I was very, very encased in a little stay-away-from-me shell growing-up, and here I got to open up and feel safe and able to touch and hold and be able to be with another human being, which was really a big relief, a very positive part of my understanding of myself that I wasn't just this outcast evil outsider of everything."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "One that has been excluded from a society or system, a pariah, a leper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00859b53-870b-497c-9404-2dd23f9417d5",
                                                "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                                "text": "The other factions believe that those who are Factionless are nomads and outcasts. But they are actually a fully functioning community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "Synonym of outsider: someone who does not belong, a misfit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ad113e-870c-4173-b8f9-c0c527b8ef7d",
                                                "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                                "text": "Do you ever feel like an outcast?\nYou don't have to fit into the format\nOh, but it's okay to be different\n'Cause baby, so am I"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256ec6b3-1751-32c0-90e4-5bd8c8dd304e",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "A quarrel."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b3bac1-2eb5-3a37-9d89-565466b92a21",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "The amount of increase in the bulk of grain during malting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28922025-2041-4c9c-9101-e7947f2c203c",
                        "source_entry_id": "ac4bfdfb-d1e5-3910-9d59-621886177d0e",
                        "source_sense_id": "2a72b948-c95c-3ca9-ab3d-d479c1336b6f",
                        "target_lang_word": "Auswurf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auswurf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                                        "entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                                        "glosses": [
                                            "Aussonderung aus den Atemwegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99a9a22-7e77-4221-9619-259a5902757d",
                                                "sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                                                "text": "Tuberkulose geht meist mit blutigem Auswurf einher."
                                            },
                                            {
                                                "example_id": "9f3986bc-547a-40b6-a487-defe7e93801c",
                                                "sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                                                "text": "„Wenige Jahre zuvor hatte man bei ihr eine chronische Lungenerkrankung mit Husten, Auswurf und Atemnot diagnostiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f3e4b9e-d389-33ed-a743-1160eeeb3699",
                                        "entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                                        "glosses": [
                                            "Stelle an einem Gerät, an der etwas ausgeworfen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84533d7d-e2d0-441d-893d-8b9d1a0be965",
                                                "sense_id": "4f3e4b9e-d389-33ed-a743-1160eeeb3699",
                                                "text": "Der Auswurf funktioniert nicht!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c12fa039-b6e0-3efd-bbdf-f7563374ba81",
                                        "entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                                        "glosses": [
                                            "niedere, minderwertige Person(en)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f1c333e-60fe-45a1-bbc0-aa6d8cd6abbc",
                                                "sense_id": "c12fa039-b6e0-3efd-bbdf-f7563374ba81",
                                                "text": "Er gehört zum Auswurf der Menschheit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91f5b286-bd2d-4dea-8a9b-d02bc43b8b7e",
                        "source_entry_id": "ac4bfdfb-d1e5-3910-9d59-621886177d0e",
                        "source_sense_id": "2a72b948-c95c-3ca9-ab3d-d479c1336b6f",
                        "target_lang_word": "изгой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "изгой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "16f9a879-fb11-38a4-b59e-25a5e9d4e8a6",
                                        "entry_id": "4499d2d6-e13e-35f4-afb5-35cc29c9df4f",
                                        "glosses": [
                                            "истор. лицо, вышедшее или изгнанное из своей социальной категории, общины (в Древней Руси — выкупившийся на свободу холоп, разорившийся купец и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5773d6-c36f-487e-a124-8a6527868ee7",
                                                "sense_id": "16f9a879-fb11-38a4-b59e-25a5e9d4e8a6",
                                                "text": "― Пустой малый! Изгой, неудельный! Изгоем же, как известно, назывался безместный удельный князь."
                                            },
                                            {
                                                "example_id": "52eed989-d381-45d7-b08a-f3f0d5ea18b8",
                                                "sense_id": "16f9a879-fb11-38a4-b59e-25a5e9d4e8a6",
                                                "text": "Из сохранившихся цитат и фрагментов известно, что «Правда» распространяет княжескую защиту на весь дружинно-торговый класс вне зависимости от племенной принадлежности «аще изгой будеть, любо словенин»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f7868c-68e9-3999-ba3b-aea6b0f5eefb",
                                        "entry_id": "4499d2d6-e13e-35f4-afb5-35cc29c9df4f",
                                        "glosses": [
                                            "тот, кто отвергнут обществом, отделился от своей социальной среды или порвал с нею; отщепенец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc9615c-1292-4b04-ae7a-4b7f1cd2032a",
                                                "sense_id": "b2f7868c-68e9-3999-ba3b-aea6b0f5eefb",
                                                "text": "Упадыш был «изгой» ― существо без роду и племени. 〈…〉 «Изгой», одним словом, был отброском общества или, говоря современным языком, человек, которого само общество сделало «нелегальным»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9461206d-fc65-3694-bdea-820e0ee8f0ad",
