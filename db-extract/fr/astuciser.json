                "senses": [
                    {
                        "sense_id": "e7020371-afe9-37bb-aa6b-eff7f3c70c52",
                        "entry_id": "56df0085-2acb-333d-8441-dfacc4be89ab",
                        "glosses": [
                            "Donner un caractère astucieux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a9e9e91-1f29-4f8b-bd56-e583fae8087f",
                                "sense_id": "e7020371-afe9-37bb-aa6b-eff7f3c70c52",
                                "text": "CADEAU IDEAL: la forme astucisée de la lumière de nuit salée les classant comme des cadeaux pratiques et parfaits pour n'importe quelle occasion."
                            },
                            {
                                "example_id": "005dfb00-8df6-4123-9f1c-28864c982f3d",
                                "sense_id": "e7020371-afe9-37bb-aa6b-eff7f3c70c52",
                                "text": "Rare de faire une rencontre aussi intéressante, quand ailleurs tout à tendance à s'uniformiser, se « tendanciser » et s'« astuciser »."
                            }
                        ]
                    },
