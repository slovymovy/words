                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                                        "glosses": [
                                            "A frumpy person, somebody who is unattractive, drab or dowdy."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9beb760d-1275-4ba8-a573-4a5081c5318b",
                                                "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                                "text": "You look like such a frump today!"
                                            },
                                            {
                                                "example_id": "fe22a3a1-e32d-4430-9f11-a769459685ba",
                                                "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                                "text": "Using the ideal of French female beauty as a stick with which to beat Britain's supposedly sexless frumps is a stereotype centuries old."
                                            },
                                            {
                                                "example_id": "c69c12b0-2181-4c74-b927-170c5fe00d56",
                                                "sense_id": "84ab6951-7ef1-32fc-9de5-dc21e4caf399",
                                                "text": "If you flipped through certain magazines at this time you could be forgiven for thinking that there was no right way to be a woman, only wrong ones — bimbo or frump, slut or prude, shrew or doormat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb42247-5e29-39aa-8ff1-eb8ea083334f",
                                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                                        "glosses": [
                                            "Unattractive, dowdy clothes."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0862ade6-1381-4309-9558-23ad852e11d3",
                                                "sense_id": "dfb42247-5e29-39aa-8ff1-eb8ea083334f",
                                                "text": "Get that frump off – it's horrid!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92e5c0ca-78c8-3cd2-815d-a9b0d9eb8fda",
                                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                                        "glosses": [
                                            "A bad-tempered person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93904e96-1716-3300-86f8-adf2bc3df78a",
                                        "entry_id": "6a55958c-d4c0-3740-90fc-2cbb923da595",
                                        "glosses": [
                                            "A flout or snub."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "681df751-1d19-34c5-86ef-87cd2bea86f0",
                                        "entry_id": "641be52d-54e7-38f6-82bf-6ddfc5ae7fed",
                                        "glosses": [
                                            "To insult; to flout; to mock; to snub."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880db072-fed1-4f70-9056-64fbed2eb743",
                                                "sense_id": "681df751-1d19-34c5-86ef-87cd2bea86f0",
                                                "text": "Was ever gentlewoman So frump'd off with a fool!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ef7d9b0-f875-3661-8b79-636cb7833e1b",
                                        "entry_id": "641be52d-54e7-38f6-82bf-6ddfc5ae7fed",
                                        "glosses": [
                                            "To assume a countenance or demeanor indicating irritation, ill-humor, or disapproval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d41515-bc12-464f-84f3-3017161f8c6b",
                                                "sense_id": "9ef7d9b0-f875-3661-8b79-636cb7833e1b",
                                                "text": "1982, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nI told the guy \"Well, now all I can do is come up with excuses\" & told him I had to babysit. He frumped like, \"Oh, shame!\" and asked if I'd be there later."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a6697bc-d935-4752-bf0d-51548bdd464b",
                        "source_entry_id": "30cd738b-565a-3685-bfd1-8832740d23ce",
                        "source_sense_id": "70f04b20-acc2-32af-a90a-097ee6324a95",
                        "source_sense_description": "iemand die op grove wijze onordelijk is",
                        "target_lang_word": "slob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b48918ef-56dd-35ad-8bd6-9af0313a8fa3",
                                        "entry_id": "568478fe-bc55-3a9a-8d57-1748ac5023c9",
                                        "glosses": [
                                            "A lazy and slovenly or obese person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e2992f5-b2ec-4b52-9832-b17ba1f27729",
                                                "sense_id": "b48918ef-56dd-35ad-8bd6-9af0313a8fa3",
                                                "text": "What if God was one of us / Just a slob like one of us"
                                            },
                                            {
                                                "example_id": "26965b80-4bd1-4095-b336-e9a1dc756ac3",
                                                "sense_id": "b48918ef-56dd-35ad-8bd6-9af0313a8fa3",
                                                "text": "\"Ladies and gentlemen, we have just begun our gradual descent into the Indianapolis area, a descent similar in many ways to the gradual slide of the United States from a first-class world leader to an aggressive, third-rate debtor nation of overweight slobs, undereducated slob children and aimless elderly people who can't afford to buy medicine. The current conditions in Indianapolis: Temperature sixty-one degrees, partly cloudy skies, winds from the southwest and intense Midwestern boredom.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17fa324e-d38e-3ce2-b37c-0476d061bb2a",
                                        "entry_id": "0ac95413-0689-384f-ba26-ba23125c1ec3",
                                        "glosses": [
                                            "To move slowly or cumbersomely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93c78679-38dd-4c2e-b91d-8977cb828ba7",
                                                "sense_id": "17fa324e-d38e-3ce2-b37c-0476d061bb2a",
                                                "text": "[…] save the placid Jemima who slobbed along as slowly and comfortable as a well-fatted pig returning from feeding-trough to stye."
                                            },
                                            {
                                                "example_id": "2a5ad009-63c2-48e6-9425-7a1eeebde5c0",
                                                "sense_id": "17fa324e-d38e-3ce2-b37c-0476d061bb2a",
                                                "text": "Mitch slobbed down on to the sofa and plonked a foot on the table, his ankle right next to the offending device."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dcaf584-0492-3ee3-9088-08da8dddf9d8",
                                        "entry_id": "0ac95413-0689-384f-ba26-ba23125c1ec3",
                                        "glosses": [
                                            "To act like a slob, in a lazy or slovenly way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf32e780-45bc-4259-b3fe-0d565225aac1",
                                                "sense_id": "4dcaf584-0492-3ee3-9088-08da8dddf9d8",
                                                "text": "For I have always lived violently, drunk hugely, eaten too much or not at all, slept around the clock or missed two nights of sleeping, worked too hard and too long in glory, or slobbed for a time in utter laziness."
                                            },
                                            {
                                                "example_id": "ec77fbef-3173-4d02-91c2-3a36bb499308",
                                                "sense_id": "4dcaf584-0492-3ee3-9088-08da8dddf9d8",
                                                "text": "There’s nothin’ sweeter than slobbing in front of crap TV after a hard day’s work … There is nothing worse than slobbing in front of crap TV after a hard day’s nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe01e0c-d15f-301d-bc21-9eb74e729045",
                                        "entry_id": "0ac95413-0689-384f-ba26-ba23125c1ec3",
                                        "glosses": [
                                            "To slop or spatter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d7ddefc-2b42-4919-82b1-dabc8112e620",
                                                "sense_id": "cfe01e0c-d15f-301d-bc21-9eb74e729045",
                                                "text": "He had a pail of paint, and I didn't want to get slobbed up with paint, […]"
                                            },
                                            {
                                                "example_id": "2f4cdd87-929b-4e78-a382-7395c0a90410",
                                                "sense_id": "cfe01e0c-d15f-301d-bc21-9eb74e729045",
                                                "text": "You've been SLOBBED! Hit the showers and try again."
                                            },
                                            {
                                                "example_id": "fbfa22e7-c2e5-44c6-8e54-205a66cfb831",
                                                "sense_id": "cfe01e0c-d15f-301d-bc21-9eb74e729045",
                                                "text": "Just to be sure to achieve extreme flammability, he slobbed on another layer of rubber cement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc5c926c-cda8-328f-949a-c3d38f53f4a2",
                                        "entry_id": "0ac95413-0689-384f-ba26-ba23125c1ec3",
                                        "glosses": [
                                            "To drool or slobber; to talk while slobbering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c42b3e0-bb2e-4839-b4e0-56ac58ef9438",
                                                "sense_id": "bc5c926c-cda8-328f-949a-c3d38f53f4a2",
                                                "text": "I could not understand his intense feeling for his smelly hounds, with their horrible yelping and slobbing mouths."
                                            },
                                            {
                                                "example_id": "fa1da8f0-e44e-4e90-bb4c-928b91e1fd6a",
                                                "sense_id": "bc5c926c-cda8-328f-949a-c3d38f53f4a2",
                                                "text": "He called Carrington’s name with a mouth no longer capable of forming the syllables, passionately desiring the boy to be alive, and the result was a slobbing idiotic cry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf03e061-3789-333a-ba5e-0e21c01e73b2",
                                        "entry_id": "0ac95413-0689-384f-ba26-ba23125c1ec3",
                                        "glosses": [
                                            "To perform fellatio."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef242591-45e6-4dae-9e1a-d93c9839f683",
                                                "sense_id": "bf03e061-3789-333a-ba5e-0e21c01e73b2",
                                                "text": "A lot of these SUVs have a big enough middle compartment where you can barely reach over and slob his knob."
                                            },
                                            {
                                                "example_id": "a4911447-e687-4350-8036-0e62c9568baa",
                                                "sense_id": "bf03e061-3789-333a-ba5e-0e21c01e73b2",
                                                "text": "Only a lame could get his jimmy slobbed down by Lover Lips, who was one of the best gamers on planet-whore, and not learn a thing or two about manipulation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
