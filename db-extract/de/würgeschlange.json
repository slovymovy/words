                "senses": [
                    {
                        "sense_id": "cc6a25df-bc51-3687-a688-7fbea4d0a958",
                        "entry_id": "f0980622-ba9e-3743-b4d3-31832dbb8f4a",
                        "glosses": [
                            "Schlange, die ihre Beute durch Umschlingen mit ihrem Körper tötet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ade6656-411f-4f10-8b55-9ea5bd229775",
                                "sense_id": "cc6a25df-bc51-3687-a688-7fbea4d0a958",
                                "text": "„Als es begann, sie wie eine Würgeschlange einzuschnüren, spannte sich Hazels gesamter Körper an und wurde stocksteif.“"
                            },
                            {
                                "example_id": "0a0ff74e-690b-45f0-9f65-3defaea09867",
                                "sense_id": "cc6a25df-bc51-3687-a688-7fbea4d0a958",
                                "text": "„Ja, sogar die unregelmäßige Fleckung, die seine gesamte Haut zeichnete gleich dem Schuppenkleid einer riesigen Würgeschlange, wäre noch als eine reichlich ausgefallene Eigentümlichkeit in der Pigmentierung durchgegangen.“"
                            },
                            {
                                "example_id": "253bf03d-85d5-47ec-9590-6dcd9c1bf2ed",
                                "sense_id": "cc6a25df-bc51-3687-a688-7fbea4d0a958",
                                "text": "„Fast alle hatten ihre eigenen Schlangen zur Jagd mitgebracht. Überwiegend waren es Würgeschlangen, Mokassinschlangen und Wasserschlangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
