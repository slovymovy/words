                ],
                "senses": [
                    {
                        "sense_id": "e4cc2d8c-c6c7-3076-88c1-b856dbab0e14",
                        "entry_id": "cdbe6ca5-3d00-366f-94f2-72bb800b404f",
                        "glosses": [
                            "Mittel zum Verbinden, Verkleben und Verkitten von Pigmenten, Hilfs- Füllstoffen und Zuschlag in Beschichtungsstoffen und Mörtel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7cb85e9-7b8f-45fc-9453-a273c9c461b4",
                                "sense_id": "e4cc2d8c-c6c7-3076-88c1-b856dbab0e14",
                                "text": "Organische Bindemittel wie Natur- und Kunstharze, Polymerisate und trocknende Öle sind ein wesentlicher Inhaltsstoff von Beschichtungsstoff, Farben (Farbmittel, Malmittel), Fugenmasse, Dichtmasse, Dichtstoff, Kitt und Klebstoffen."
                            },
                            {
                                "example_id": "7e97cc06-4f27-4bc8-bd9f-8c87ff3bd9ac",
                                "sense_id": "e4cc2d8c-c6c7-3076-88c1-b856dbab0e14",
                                "text": "Mineralische Bindemittel wie Anhydrit, Gips, Kalk (Weißkalkhydrat, Löschkalk, Calciumhydroxid) und Zement sind ein wesentlicher Inhaltsstoff von Beton, Mörteln, Spachtelmasse und Putzen."
                            },
                            {
                                "example_id": "f944775d-886d-4722-a9c4-fc07500ff214",
                                "sense_id": "e4cc2d8c-c6c7-3076-88c1-b856dbab0e14",
                                "text": "Bindemittel wie Aminoplaste oder PMDI werden bei der Herstellung von Holzwerkstoffen, wie Spanplatten oder MDF-Platten eingesetzt, um die Holzpartikel wie Holzspäne und Holzfasern zu verkleben."
                            },
                            {
                                "example_id": "3890be6d-c9be-4511-b969-2132b7ab462f",
                                "sense_id": "e4cc2d8c-c6c7-3076-88c1-b856dbab0e14",
                                "text": "„In den Ölfarben sind Mal- und Bindemittel identisch; in den wässerigen Malfarben dagegen besteht das Malmittel aus einer Lösung oder aus einer Dispersion des eigentlichen Bindemittels im Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06c5c5b7-537c-36dc-81fd-5b76db0d08fb",
                        "entry_id": "cdbe6ca5-3d00-366f-94f2-72bb800b404f",
                        "glosses": [
                            "Mittel zum Andicken und Verdicken von Flüssigkeiten, wie Creme, Gel, Gelee, Paste, Soßen, Suppen."
                        ],
                        "tags": [
                            "Kochen"
                        ],
                        "examples": [
                            {
                                "example_id": "1dc42803-5744-4b42-9080-ccddaf94f6a0",
                                "sense_id": "06c5c5b7-537c-36dc-81fd-5b76db0d08fb",
                                "text": "In Lebensmitteln häufig verwendete Bindemittel sind Agar-Agar, Gelatine, Guar, Johannisbrotkernmehl, Pektin, Stärke und Tragant."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bd7bddc4-6d1f-3405-90df-83ba49ada258",
                        "entry_id": "cdbe6ca5-3d00-366f-94f2-72bb800b404f",
                        "glosses": [
                            "bei der Herstellung von Arzneimitteln eingesetzte Substanz, die verschiedene Funktionen erfüllen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "556486c6-db77-4eae-add7-98d8790ef3af",
                                "sense_id": "bd7bddc4-6d1f-3405-90df-83ba49ada258",
                                "text": "In der Arzneimittelherstellung werden Bindemittel wie arabisches Gummi, Carmellose-Natrium, Carrageen, Carbomer, Hydroxyethylcellulose, Hypromellose, Methylcellulose, Tragant, Xanthangummi und modifizierte Stärke eingesetzt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
