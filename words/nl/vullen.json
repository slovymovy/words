                    "sense_id": "441b8c26-d74b-3167-8440-d26aa4d8b416",
                    "sense_definition": "iets vol maken door er een inhoud in te doen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vol maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun jij de <w>vullen</w> met water?",
                            "target_lang_translations": {
                                "en": "Can you <w>fill</w> it with water?"
                            }
                        },
                        {
                            "text": "Greetje <w>vulde</w> de kast met boeken.",
                            "target_lang_translations": {
                                "en": "Greetje <w>filled</w> the cupboard with books."
                            }
                        },
                        {
                            "text": "Mijn rugzak was <w>gevuld</w> met eten voor negen dagen.",
                            "target_lang_translations": {
                                "en": "My backpack was <w>filled</w> with food for nine days."
                            }
                        }
                    ],
                    "synonyms": [
                        "volmaken",
                        "laten vollopen"
                    ],
                    "antonyms": [
                        "legen"
                    ],
                    "common_phrases": [
                        "een glas vullen",
                        "de tank vullen",
                        "een tas vullen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something full by putting contents into it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fill",
                                "target_lang_sense_clarification": "to make a container full"
                            },
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "to fill by packing or crowding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f68633b5-5066-311d-ba67-90f26a4623bb",
                    "sense_definition": "een bepaalde tijd of ruimte in beslag nemen of nuttig besteden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bezigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij kan je tijd hier wel <w>vullen</w> met lezen.",
                            "target_lang_translations": {
                                "en": "You can <w>fill</w> your time here with reading."
                            }
                        },
                        {
                            "text": "Zij <w>vult</w> haar avonden meestal met sporten.",
                            "target_lang_translations": {
                                "en": "She usually <w>fills</w> her evenings with sports."
                            }
                        }
                    ],
                    "synonyms": [
                        "vullend zijn"
                    ],
                    "common_phrases": [
                        "de tijd vullen",
                        "de avond vullen"
                    ],
                    "target_lang_definitions": {
                        "en": "to occupy or spend a certain amount of time or space usefully"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fill",
                                "target_lang_sense_clarification": "to occupy time or space"
                            },
                            {
                                "target_lang_word": "spend",
                                "target_lang_sense_clarification": "to pass time"
                            },
                            {
                                "target_lang_word": "occupy",
                                "target_lang_sense_clarification": "to keep busy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "812bdb8c-1e7b-3232-93f6-16e7691dc0f6",
                    "sense_definition": "een verzadigd gevoel geven na het eten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niet te veel eten, want deze slagroomtaart <w>vult</w> behoorlijk.",
                            "target_lang_translations": {
                                "en": "Don't eat too much, because this cream cake is quite <w>filling</w>."
                            }
                        },
                        {
                            "text": "Deze soep <w>vult</w> goed door de vele groenten.",
                            "target_lang_translations": {
                                "en": "This soup <w>fills</w> you up well because of the many vegetables."
                            }
                        }
                    ],
                    "synonyms": [
                        "vullend zijn"
                    ],
                    "common_phrases": [
                        "behoorlijk vullen",
                        "goed vullen"
                    ],
                    "target_lang_definitions": {
                        "en": "to give a feeling of being full or satisfied after eating"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fill up",
                                "target_lang_sense_clarification": "to satisfy hunger"
                            },
                            {
                                "target_lang_word": "be filling",
                                "target_lang_sense_clarification": "to be substantial food"
                            }
                        ]
                    }
                }
            ]
