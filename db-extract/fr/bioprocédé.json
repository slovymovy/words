                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8717fb6e-5a38-4bbd-b1ea-3f4698b39401",
                                "sense_id": "a7771e24-bfae-352b-90ca-50be7b06e59d",
                                "text": "Mon programme de recherche porte sur le développement de bioprocédés voués à l’élimination de polluants émergents (PE) tels que des produits pharmaceutiques et des plastifiants."
                            },
                            {
                                "example_id": "ad480e60-f98b-4b03-88dd-c9ed332f1e6e",
                                "sense_id": "a7771e24-bfae-352b-90ca-50be7b06e59d",
                                "text": "Les bioprocédés désignent, selon la définition la plus largement admise et partagée dans le domaine des biotechnologies, toutes les mises en œuvre de systèmes vivants, ou de leurs constituants, pour la production de savoir, biens ou services."
                            },
                            {
                                "example_id": "37f73ba5-be4d-44eb-8416-1822c197cf46",
                                "sense_id": "a7771e24-bfae-352b-90ca-50be7b06e59d",
                                "text": "L’orientation « Génie des Bio-Procédés Industriels » offre aux étudiants une formation généraliste pluridisciplinaire dans le domaine du génie des bioprocédés."
                            }
                        ]
