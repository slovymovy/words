                    {
                        "translation_id": "c535f51e-e1fa-4fbc-913f-e39ef28b2a20",
                        "source_entry_id": "06e5afa4-1c1d-3f54-8ec8-09a44dba4b2e",
                        "source_sense_id": "c0012a08-a63e-3571-a45f-bd88e3cbdf9b",
                        "source_sense_description": "een plotselinge aardbeving",
                        "target_lang_word": "earthquake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "earthquake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ba5f74-2334-39f1-aa81-d48b79c4c762",
                                        "entry_id": "8704c565-257b-3c61-ab5c-3ad29b29309e",
                                        "glosses": [
                                            "A shaking of the ground, caused by volcanic activity or movement around geologic faults."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d6c632-dd41-4b29-b70e-e397a7bc41e3",
                                                "sense_id": "b8ba5f74-2334-39f1-aa81-d48b79c4c762",
                                                "text": "Her alablaster brest she soft did kis, / Which all that while shee felt to pant and quake, / As it an Earth-quake were: at last she thus bespake."
                                            },
                                            {
                                                "example_id": "fd1cfc96-eb08-4858-9b73-110d92adea9a",
                                                "sense_id": "b8ba5f74-2334-39f1-aa81-d48b79c4c762",
                                                "text": "Last year's earthquake crushed his house, his livelihood and very nearly his leg, he said, pointing to a plastered limb that refuses to heal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "763bf1c5-9b56-3844-9806-6b4c9949611c",
                                        "entry_id": "8704c565-257b-3c61-ab5c-3ad29b29309e",
                                        "glosses": [
                                            "Such a quake specifically occurring on the planet Earth, as opposed to other celestial bodies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06d566ca-7ba4-4218-959b-ef2aa9d51120",
                                                "sense_id": "763bf1c5-9b56-3844-9806-6b4c9949611c",
                                                "text": "Since the response of some man-made structures to the ground motion near the epicenter is highly dependent on frequency, a significant difference in potential damage to the structures is expected between earthquakes and moonquakes."
                                            },
                                            {
                                                "example_id": "38e469b6-5c73-4a09-8085-e31ce8ead4e9",
                                                "sense_id": "763bf1c5-9b56-3844-9806-6b4c9949611c",
                                                "text": "The wave patterns, too, are strikingly different: The secondary (S) waves and surface waves on lunar seismograms are not generally as clearly defined and distinct as are those of earthquakes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e4de10-36e2-3974-8a0f-6227e8431bef",
                                        "entry_id": "8704c565-257b-3c61-ab5c-3ad29b29309e",
                                        "glosses": [
                                            "A sudden and intense upheaval; a severely disruptive event."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f110afc3-4ee0-4c8d-a142-13aec88ea95b",
                                                "sense_id": "42e4de10-36e2-3974-8a0f-6227e8431bef",
                                                "text": "As we have seen, economic earthquakes often result in political shockwaves. […] He highlights a correlation between those states with the highest robot density and those states that unexpectedly swung behind Donald Trump in the 2016 presidential election, namely Michigan, Pennsylvania and Wisconsin."
                                            },
                                            {
                                                "example_id": "02eef395-fae5-49c8-935d-2a07180d6e2f",
                                                "sense_id": "42e4de10-36e2-3974-8a0f-6227e8431bef",
                                                "text": "Leo Varadkar has announced he is standing down as Ireland’s prime minister and also giving up his role as leader of the Fine Gael party in the ruling coalition, in a surprise move described by pundits as a “political earthquake” for the country."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "earthquake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e3334b-a826-34ed-988d-c489ab8d059a",
                                        "entry_id": "72795659-8ff8-316b-a525-e3816f8d5e84",
                                        "glosses": [
                                            "To undergo an earthquake."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bca2847-c067-49f6-92ed-f1a709f325ae",
                                                "sense_id": "f4e3334b-a826-34ed-988d-c489ab8d059a",
                                                "text": "Watch the Philippines very closely for the next little while. There is rumbling and earthquaking deep within Pinatubo and increased earthquaking within Mayon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
