                "senses": [
                    {
                        "sense_id": "2ad30361-de15-3cfb-a785-419d3e407ae5",
                        "entry_id": "ed706d11-23a7-3278-8944-f7ae3103c554",
                        "glosses": [
                            "Gewerkschafterin, an die sich Arbeitnehmer mit Anliegen oder Beschwerden wenden können (ohne dass der Arbeitgeber die Quelle der Beschwerden erfährt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d22facc-f556-432e-a1e5-193a360fa19e",
                                "sense_id": "2ad30361-de15-3cfb-a785-419d3e407ae5",
                                "text": "„Obwohl sie jetzt Vertrauensfrau ist, bleibt ihr Verhältnis zur Gewerkschaft distanziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d65f8556-c59f-379e-a8f8-e77757d45fa5",
                        "entry_id": "ed706d11-23a7-3278-8944-f7ae3103c554",
                        "glosses": [
                            "Frau, die Interessen einer Gruppe gegenüber höheren Instanzen vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de7b69fe-ae00-4d8e-bc24-873a8740e2fb",
                                "sense_id": "d65f8556-c59f-379e-a8f8-e77757d45fa5",
                                "text": "„Auch Gemeinden mit weniger als 1 000 Flüchtlingen müssen einen Flüchtlingsvertrauensmann oder eine Vertrauensfrau haben. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ec13775a-abe6-3ee9-8143-6ac1b7a6edfc",
                        "entry_id": "ed706d11-23a7-3278-8944-f7ae3103c554",
                        "glosses": [
                            "Frau, die als besonders integer/vertrauenswürdig gilt, beispielsweise bei schwierigen/geheimen Geschäften/Verhandlungen/Vermittlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa98c52a-acb0-49dd-a653-6fcd301ab08d",
                                "sense_id": "ec13775a-abe6-3ee9-8143-6ac1b7a6edfc",
                                "text": "„Wenn die Vertrauensmänner zu allen Sitzungen geladen werden, warum sollen nicht auch die Vertrauensfrauen dazu geladen werden, es ist ja so oft schon ausgeführt worden, daß wir weibliche Vertrauenspersonen wählen müssen nicht nur aus Rücksicht auf unsere vereinsgesetzlichen Bestimmungen, sondern aus Rücksicht auf die eigenartige Agitation, die unter Frauen zu entfalten ist.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0a2bb084-b6f2-37a3-89ef-15affdc19588",
                        "entry_id": "ed706d11-23a7-3278-8944-f7ae3103c554",
                        "glosses": [
                            "Frau, die für einen Geheimdienst oder die Polizei Informationen über eine als gefährlich angesehenen Gruppe oder Person beschafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128f8ca1-6d69-46d3-9a49-1f04307d1ffa",
                                "sense_id": "0a2bb084-b6f2-37a3-89ef-15affdc19588",
                                "text": "„Petra S., eine Vertrauensfrau (V-Frau) des Landesamts für Verfassungsschutz (LfV) von Baden-Württemberg, hat die öffentliche Vernehmung ihres Verbindungsführers erzwungen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
