{
    "word_family": [
        "beneficial",
        "benefit",
        "benefactor",
        "benefactress",
        "beneficence",
        "beneficent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4150acf-ab19-3b99-849d-56968107553e",
                    "sense_definition": "A person or group that receives an advantage or profit from something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community was the primary <w>beneficiary</w> of the new park project.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество стало основным <w>выгодополучателем</w> от проекта нового парка."
                            }
                        },
                        {
                            "text": "You are the lucky <w>beneficiary</w> of this special offer which includes a free upgrade.",
                            "target_lang_translations": {
                                "ru": "Вы — счастливый <w>получатель</w> этого специального предложения, которое включает бесплатное обновление."
                            }
                        }
                    ],
                    "synonyms": [
                        "recipient",
                        "receiver"
                    ],
                    "antonyms": [
                        "maleficiary"
                    ],
                    "common_phrases": [
                        "primary beneficiary",
                        "intended beneficiary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или группа лиц, получающих выгоду или прибыль от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бенефициар",
                                "target_lang_sense_clarification": "лицо, извлекающее выгоду"
                            },
                            {
                                "target_lang_word": "выгодополучатель",
                                "target_lang_sense_clarification": "тот, кто получает пользу"
                            },
                            {
                                "target_lang_word": "получатель",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1cb1ec-4b75-3b5e-a89e-cadfcc423d7c",
                    "sense_definition": "A person designated to receive money or property from a trust, will, or legal estate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained that each <w>beneficiary</w> would receive an equal share of the estate.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил, что каждый <w>наследник</w> получит равную долю имущества."
                            }
                        },
                        {
                            "text": "He named his sister as the sole <w>beneficiary</w> of his will to ensure she was provided for.",
                            "target_lang_translations": {
                                "ru": "Он назначил свою сестру единственным <w>бенефициаром</w> в своем завещании, чтобы обеспечить её будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "heir",
                        "inheritor",
                        "legatee"
                    ],
                    "common_phrases": [
                        "sole beneficiary",
                        "named beneficiary"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, назначенное для получения денежных средств или имущества из траста, по завещанию или в рамках наследства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследник",
                                "target_lang_sense_clarification": "по завещанию"
                            },
                            {
                                "target_lang_word": "бенефициар",
                                "target_lang_sense_clarification": "в юридическом контексте"
                            },
                            {
                                "target_lang_word": "выгодоприобретатель",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf93c94-d6f5-3d16-be36-1d40e5f833b2",
                    "sense_definition": "A person entitled to receive the payout or death benefit from an insurance policy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to update your <w>beneficiary</w> information whenever your family situation changes.",
                            "target_lang_translations": {
                                "ru": "Важно обновлять информацию о <w>выгодоприобретателе</w> всякий раз, когда меняется ваше семейное положение."
                            }
                        },
                        {
                            "text": "The insurance company contacted the <w>beneficiary</w> shortly after the policyholder passed away.",
                            "target_lang_translations": {
                                "ru": "Страховая компания связалась с <w>бенефициаром</w> вскоре после смерти страхователя."
                            }
                        }
                    ],
                    "synonyms": [
                        "payee"
                    ],
                    "common_phrases": [
                        "insurance beneficiary",
                        "designated beneficiary"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "insurance context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, имеющее право на получение выплаты или страхового возмещения по страховому полису."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгодоприобретатель",
                                "target_lang_sense_clarification": "в страховании"
                            },
                            {
                                "target_lang_word": "бенефициар",
                                "target_lang_sense_clarification": "получатель страховой выплаты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da06c4ce-ec7b-3e35-bb9d-3396d2cb1c2e",
                    "sense_definition": "Holding a position, office, or land under a superior, often in a feudal system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beneficiary</w> lords were required to provide military service to the king.",
                            "target_lang_translations": {
                                "ru": "<w>Вассальные</w> лорды были обязаны нести военную службу королю."
                            }
                        },
                        {
                            "text": "Historical records describe the <w>beneficiary</w> king as being subordinate to the emperor.",
                            "target_lang_translations": {
                                "ru": "Исторические записи описывают <w>зависимого</w> короля как подчиненного императору."
                            }
                        }
                    ],
                    "synonyms": [
                        "feudatory",
                        "vassal"
                    ],
                    "common_phrases": [
                        "beneficiary king",
                        "beneficiary tenure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical feudal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимающий положение, должность или владеющий землей под началом сюзерена, часто в феодальной системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вассальный",
                                "target_lang_sense_clarification": "феодальная зависимость"
                            },
                            {
                                "target_lang_word": "бенефициарий",
                                "target_lang_sense_clarification": "держатель бенефиция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d71efea-a1e3-35c9-ab92-96ec97dd1a01",
                    "sense_definition": "Given or bestowed as a gift or gratuity rather than earned.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The institution relied heavily on <w>beneficiary</w> gifts from wealthy patrons.",
                            "target_lang_translations": {
                                "ru": "Учреждение сильно зависело от <w>благотворительных</w> пожертвований богатых покровителей."
                            }
                        },
                        {
                            "text": "These <w>beneficiary</w> payments were distributed to the poor during the festival.",
                            "target_lang_translations": {
                                "ru": "Эти <w>безвозмездные</w> выплаты распределялись среди бедных во время фестиваля."
                            }
                        }
                    ],
                    "synonyms": [
                        "gratuitous",
                        "charitable"
                    ],
                    "common_phrases": [
                        "beneficiary gifts"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставляемый или даруемый в качестве подарка или безвозмездной помощи, а не заработанный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дарственный",
                                "target_lang_sense_clarification": "в виде дара"
                            },
                            {
                                "target_lang_word": "благотворительный",
                                "target_lang_sense_clarification": "безвозмездный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
