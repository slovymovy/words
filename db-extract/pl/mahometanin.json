                        "examples": [
                            {
                                "example_id": "846de70a-9415-49ca-9084-e7a441fffcf7",
                                "sense_id": "6255b3c8-c81f-3d4c-8b03-99c24c0e86aa",
                                "text": "Mahometanie chodzą do meczetu w każdy piątek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "176c9894-86a3-4fac-9e3d-47bd1f059895",
                        "source_entry_id": "538a8d5e-01df-309e-8a14-9855395262af",
                        "source_sense_id": "6255b3c8-c81f-3d4c-8b03-99c24c0e86aa",
                        "target_lang_word": "Mohammedan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mohammedan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69506c11-ff05-308e-919a-f22a2f979f30",
                                        "entry_id": "f7edca1e-a0b2-3732-ba36-ccd0b4b7fc5a",
                                        "glosses": [
                                            "Muslim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e30e917-272d-4811-8d1f-2ab3e4c687f3",
                                                "sense_id": "69506c11-ff05-308e-919a-f22a2f979f30",
                                                "text": "MOSQUE (Fr. mosquée, from Sp. mezquita, from Ar. masjid, temple, from sajada, to prostrate one's self, to pray). A Mohammedan house of prayer and worship. Examples of these buildings are found wherever the Mohammedan faith has prevailed, from Spain to India and Turkestan."
                                            },
                                            {
                                                "example_id": "bc5b373a-de74-412c-bfad-6246b04369e2",
                                                "sense_id": "69506c11-ff05-308e-919a-f22a2f979f30",
                                                "text": "Mohammedan prisoners shall be allowed to observe the fast of Ramadan and during the fast shall be required to labour at such reduced task as the Medical Officer considers proper."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mohammedan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6713bce0-c540-3716-afa1-121c014ea94f",
                                        "entry_id": "5ef7c1de-08da-324c-b3b0-ff086beb9d39",
                                        "glosses": [
                                            "Muslim, Islamic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc9fd828-1c4a-45e9-9f0a-d5b0728edd90",
                                                "sense_id": "6713bce0-c540-3716-afa1-121c014ea94f",
                                                "text": "At the principal stations there are also separate Hindu and Mohemmedan refreshment rooms, and some mail trains have compartments reserved for Indian tea and sweetmeat vendors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a080c088-bbba-33ff-b1a2-95e399a9a826",
                                        "entry_id": "5ef7c1de-08da-324c-b3b0-ff086beb9d39",
                                        "glosses": [
                                            "Relating to Mohammed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e989278-4360-4c51-bbb8-7e7c281b615b",
                        "source_entry_id": "538a8d5e-01df-309e-8a14-9855395262af",
                        "source_sense_id": "6255b3c8-c81f-3d4c-8b03-99c24c0e86aa",
