                                "target_senses": [
                                    {
                                        "sense_id": "04fe5bd5-51bc-39d1-a166-d46bcd36acb6",
                                        "entry_id": "235e1240-f344-326b-b378-7d17da039a1c",
                                        "glosses": [
                                            "A greasy secretion with a powerful odour, produced in a glandular sac of the male musk deer and used in the manufacture of perfumes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d68c70-ee6e-4060-b964-e5d3c0819771",
                                                "sense_id": "04fe5bd5-51bc-39d1-a166-d46bcd36acb6",
                                                "text": "Your onely way to make a good pomander, is this. Take an ownce of the pureſt garden mould, clenſed and ſteeped ſeauen daies in change of motherleſſe roſe water, then take the beſt Labdanum, Benioine, both Storaxes, amber greece, and Ciuet, and muſke, incorporate them together, and work them into what form you pleaſe; this, if your breath bee not to valiant, will make you ſmell as ſweete as my Ladies dogge."
                                            },
                                            {
                                                "example_id": "90ed25fe-0ce4-4f65-9a54-a502302b20d0",
                                                "sense_id": "04fe5bd5-51bc-39d1-a166-d46bcd36acb6",
                                                "text": "An old medical record relates that by means of musk the genital power of a man in his eightieth year was resuscitated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4bc703e-9bfc-3681-9e80-8fb7b0ace629",
                                        "entry_id": "235e1240-f344-326b-b378-7d17da039a1c",
                                        "glosses": [
                                            "A similar secretion produced by the otter and the civet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0afc83c5-f7dd-303f-a942-52f49aac6c07",
                                        "entry_id": "235e1240-f344-326b-b378-7d17da039a1c",
                                        "glosses": [
                                            "A synthetic organic compound used as a substitute for the above."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c193a8-2e89-322d-afa5-197e37803db2",
