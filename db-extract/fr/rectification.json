                                    {
                                        "sense_id": "80c6b940-85a9-3c1d-bea9-d4a5dd2d4262",
                                        "entry_id": "8f31b084-4d77-36c6-a1d1-4a384e71bfdc",
                                        "glosses": [
                                            "die Handlung des Berichtigens; das Entfernen oder Ansprechen von gemachten Fehlern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36532459-54b0-4adb-92b3-634d1c6388ce",
                                                "sense_id": "80c6b940-85a9-3c1d-bea9-d4a5dd2d4262",
                                                "text": "Wegen der vielen Fehler hat die Berichtigung sehr lange gedauert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8530b0d-2bad-3154-a7c3-9a257df5f0a9",
                                        "entry_id": "8f31b084-4d77-36c6-a1d1-4a384e71bfdc",
                                        "glosses": [
                                            "nachträgliche Korrektur zu etwas oder korrigierte Version von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07432646-21fc-460a-9ebb-e9470e507eef",
                                                "sense_id": "b8530b0d-2bad-3154-a7c3-9a257df5f0a9",
                                                "text": "Die Schüler sollen zu ihren Übungen stets eine Berichtigung anfertigen."
                                            },
                                            {
                                                "example_id": "f138cca3-f92c-45f9-8a21-d0a76bf45518",
                                                "sense_id": "b8530b0d-2bad-3154-a7c3-9a257df5f0a9",
                                                "text": "Die Zeitung musste eine Berichtigung zu ihrem Artikel abdrucken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d921357-3ee4-47a7-9b45-54ccca045272",
                        "source_entry_id": "1c0d24da-1d3c-3490-a0e9-aec653feb932",
                        "target_lang_word": "Korrektur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korrektur",
