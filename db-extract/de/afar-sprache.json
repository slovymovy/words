                "senses": [
                    {
                        "sense_id": "7c651229-0e25-3718-bfcc-e76fb3e62ced",
                        "entry_id": "498f6172-734a-3a22-bc9d-15d26cc631cb",
                        "glosses": [
                            "kuschitische Sprache, die vorwiegend in Äthiopien, Eritrea und Dschibuti vom Volk der Afar gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4730df-1acf-4ff0-9d59-25a4a1e5887b",
                                "sense_id": "7c651229-0e25-3718-bfcc-e76fb3e62ced",
                                "text": "„Der Art-Name kadabba entstammt der Afar-Sprache und bezeichnet den Stammvater einer Familie.“"
                            },
                            {
                                "example_id": "ef4b5707-1c4f-42bd-9609-0198b5049a7a",
                                "sense_id": "7c651229-0e25-3718-bfcc-e76fb3e62ced",
                                "text": "„Die Afar-Sprache (früher auch Danakil genannt) gehört zu den wichtigsten Sprachen Nordostafrikas.“"
                            },
                            {
                                "example_id": "40cf233b-fdd1-4871-aa2d-d8f4d30ad2e5",
                                "sense_id": "7c651229-0e25-3718-bfcc-e76fb3e62ced",
                                "text": "„Der Name Ardipithecus bedeutet ‹Bodenaffe› in der lokalen Afar-Sprache, ramidus bedeutet Wurzel.“"
                            },
                            {
                                "example_id": "f106f49f-98a4-45e9-9802-065a79b10f26",
                                "sense_id": "7c651229-0e25-3718-bfcc-e76fb3e62ced",
                                "text": "„Gestirnsnamen tragen, nach Reinisch, ein fremdes Gepräge und lassen sich nicht aus der Afar-Sprache erklären.“"
                            },
                            {
                                "example_id": "2c0964d4-9507-41c0-bcc4-74fd3de09583",
                                "sense_id": "7c651229-0e25-3718-bfcc-e76fb3e62ced",
                                "text": "„Auch die benachbarten S a h o oder S c h o h o, deren Sprache nur ‚leichte dialektische Verschiedenheiten‘ von der Afar-Sprache aufweist […] haben eine ähnliche Zweiteilung des Stammes."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "275cc649-e65d-4e74-b262-e3bc6242309d",
