            {
                "entry_id": "37db128f-3ab3-368c-8ec5-338f33a4bd4c",
                "word": "cliquer-retirer",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d7b86ea-9dc4-3248-acac-de297ce15563",
                        "entry_id": "37db128f-3ab3-368c-8ec5-338f33a4bd4c",
                        "glosses": [
                            "Système consistant à commander par Internet, puis aller retirer ce qu’on a commandé au lieu où c’est mis à disposition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1964f1a4-6d0f-4643-9b9f-15c1ea2ece5d",
                                "sense_id": "7d7b86ea-9dc4-3248-acac-de297ce15563",
                                "text": "Parallèlement à ses circuits de distribution habituels, elle a aussi renforcé sa stratégie de vente à distance : en plus de la possibilité de commander sur son site Internet, l'entreprise a mis en place la vente par livraison à domicile et le « cliquer-retirer »."
                            },
                            {
                                "example_id": "2ccb118f-1754-4345-a8cd-415225354c3e",
                                "sense_id": "7d7b86ea-9dc4-3248-acac-de297ce15563",
                                "text": "Ils mettent ainsi en avant la commande en ligne et le « cliquer-retirer », véritables leviers de survie pour des activités touchées par la fermeture administrative."
                            },
                            {
                                "example_id": "ba5714b4-7da5-41c3-83b4-3f9ed5b76e57",
                                "sense_id": "7d7b86ea-9dc4-3248-acac-de297ce15563",
                                "text": "Devrions-nous recourir au \"cliquer-retirer\" ou nous faire livrer à domicile?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
