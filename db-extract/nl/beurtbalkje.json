                                                "example_id": "28b16518-ff2f-493c-8e57-ad02136d87a5",
                                                "sense_id": "c27266ff-c3f6-394f-ad29-542a96315f17",
                                                "text": "Menschen, die sich nicht über die bunt bedruckten sogenannten Warentrenner wundern, sondern sie dazu benutzen, sich selbst und anderen Beteiligten das Leben zu erleichtern."
                                            }
                                        ],
