                "senses": [
                    {
                        "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                        "entry_id": "e4dafe36-aa04-3530-8368-7a01348fe6ae",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b1ba5c-b17a-4ee7-b1d1-c9230ddc1859",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Frau Fingerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c88ef1f3-2626-425a-98a3-8d3badea441e",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Herr Fingerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5d67d3ea-480c-4976-b60f-28c7ce88d5e3",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Die Fingerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "19b1d2be-a20c-49a3-b6cb-03062a6dafe6",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Der Fingerle trägt nie die Pullover, die die Fingerle ihm strickt."
                            },
                            {
                                "example_id": "df3eb464-3424-46b7-9c93-6f1ac52c59d2",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fingerle kommt, geht der Herr Fingerle.“"
                            },
                            {
                                "example_id": "f96dc1c9-4147-43f3-968f-eb327efc8c5e",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Fingerle kommt und geht."
                            },
                            {
                                "example_id": "6974a5f9-7b4c-492a-96a3-4e3aef878d66",
                                "sense_id": "cac4b6a1-455b-3627-8d28-cf2cc8aad419",
                                "text": "Fingerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
