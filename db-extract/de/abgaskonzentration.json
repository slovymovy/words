                ],
                "senses": [
                    {
                        "sense_id": "f255f811-3693-3863-b621-67937aaadbc0",
                        "entry_id": "e93964eb-3e0d-366f-a1ee-5c6c5405f750",
                        "glosses": [
                            "Gehalt an Abgas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0545f0b-e35d-4dec-8c75-18cdae2c7ca0",
                                "sense_id": "f255f811-3693-3863-b621-67937aaadbc0",
                                "text": "„Der Autoverkehr sorgt in vielen Städten für eine schädliche Abgaskonzentration.“"
                            },
                            {
                                "example_id": "334fd5a4-e7d5-4735-8ccf-a7f1aba19888",
                                "sense_id": "f255f811-3693-3863-b621-67937aaadbc0",
                                "text": "„Allerdings kann es auch in Erdnähe zu einer erhöhten Ozonkonzentration kommen, wenn starke Sonneneinstrahlung auf hohe Abgaskonzentrationen trifft.“"
                            },
                            {
                                "example_id": "1934486b-0643-4b68-bfce-99a0bd5a07b8",
                                "sense_id": "f255f811-3693-3863-b621-67937aaadbc0",
                                "text": "„»Schlechtes« Ozon bildet sich vor allem im Sommer bei hohen Abgaskonzentrationen in Bodennähe.“"
                            },
                            {
                                "example_id": "e896a211-17ed-4683-9f44-9952621a237d",
                                "sense_id": "f255f811-3693-3863-b621-67937aaadbc0",
                                "text": "„Hohe Abgaskonzentrationen können bei bestimmter Wetterlage unter dem Einfluß von Licht, UV-Strahlung und Ozon in Ballungsgebieten zu gefährlichen Umweltbelastungen (Smog) führen.“"
                            },
                            {
                                "example_id": "fc0213ba-919a-439f-babb-dc0fee828b56",
                                "sense_id": "f255f811-3693-3863-b621-67937aaadbc0",
                                "text": "„Im städtischen Bereich treten bei austauscharmen Hochdruckwetterlagen im Sommer vermehrt Hitzestress und hohe Abgaskonzentrationen auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
