                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee30d03-48ac-48fa-8212-08d776d3c0de",
                                                "sense_id": "c7ce9873-aaac-37dc-8d28-1d05075ea2b0",
                                                "text": "Thẽ the heerdmẽ⸝ fleed and went there ways into the cite⸝ and tolde every thinge⸝ and what had fortuned vnto them that were poſſeſſed of the devyls."
                                            },
                                            {
                                                "example_id": "e41d9038-5b13-4369-9889-7f050ecf3897",
                                                "sense_id": "c7ce9873-aaac-37dc-8d28-1d05075ea2b0",
                                                "text": "It fortuned one night that the Sultan purposed setting out on a journey next morning, […]"
                                            }
                                        ]
