                    {
                        "translation_id": "7eff57d5-8fa8-4312-88dc-3a5a06cbec52",
                        "source_entry_id": "6b60e843-d6e7-350d-8a4b-9f793cf21633",
                        "source_sense_id": "ee2ea012-90a3-3c5f-9e0a-1b76cd8d8b27",
