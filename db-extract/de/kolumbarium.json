                                        ],
                                        "tags": [
                                            "zootechn."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca29b9b2-7de2-4c04-aa17-36d31a7c5042",
                                                "sense_id": "56b455f5-e435-3f43-82ec-e2ed976519c0",
                                                "text": "Wujek Jurek jest zapalonym gołębiarzem, a gołębnik to jego oczko w głowie."
                                            }
                                        ],
