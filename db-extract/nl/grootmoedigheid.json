                "senses": [
                    {
                        "sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                        "entry_id": "7114cb4c-b6e9-36f4-8862-de223092a6fe",
                        "glosses": [
                            "op een krachtige manier heel gul zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337c8963-f84f-4396-ac6d-5988a999071a",
                                "sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                                "text": "De vicomte zei dat de hertog van Enghien het slachtoffer van zijn eigen grootmoedigheid was geworden, en dat er speciale redenen waren voor Bonapartes woede."
                            },
                            {
                                "example_id": "a8d3dfa7-8d9a-4077-8d67-4a3cfa69455e",
                                "sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                                "text": "Van de ene op de andere dag besloot Merkel vluchtelingen uit Hongarije op te gaan halen en Syriërs kregen vrij toegang tot het land. Inmiddels zijn ruim een miljoen vluchtelingen Duitsland binnengekomen. Haar grootmoedigheid is anders dan velen van haar gewend zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "57c46cdc-9494-3690-9b19-5d97bb0eda1e",
                        "entry_id": "7114cb4c-b6e9-36f4-8862-de223092a6fe",
                        "glosses": [
                            "iets wat getuigt van grote gulheid"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "975e96de-afc0-4592-a080-7b02768a0030",
                        "source_entry_id": "7114cb4c-b6e9-36f4-8862-de223092a6fe",
                        "source_sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                        "source_sense_description": "op een krachtige manier heel gul zijn",
                        "target_lang_word": "magnanimity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnanimity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cab7ec7b-e4a4-3870-8e92-865a35dcc5be",
                                        "entry_id": "26869b7c-94e2-3bee-8f4e-534fe27ca8af",
                                        "glosses": [
                                            "The quality of being magnanimous; kindness of nature; generosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb390acf-b3a7-4e31-80fe-7c595ba944f3",
                                                "sense_id": "cab7ec7b-e4a4-3870-8e92-865a35dcc5be",
                                                "text": "...and thirdly, I have I behaved exceedingly ill to you, and, consequently, feel it quite magnanimous not to hate you, which is the established rule on such occasions.\"\n\"Pray, continue your magnanimity.\""
                                            },
                                            {
                                                "example_id": "e35016c3-12d8-4025-98de-45443569c71a",
                                                "sense_id": "cab7ec7b-e4a4-3870-8e92-865a35dcc5be",
                                                "text": "The duke had not taken advantage of this, but Bonaparte had later rewarded his magnanimity by having him put to death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "305a32fc-abd8-4abf-ac41-5a005c4cf8b7",
                        "source_entry_id": "7114cb4c-b6e9-36f4-8862-de223092a6fe",
                        "source_sense_id": "7434e0dd-71f3-387a-b70a-309e54eae824",
                        "source_sense_description": "op een krachtige manier heel gul zijn",
                        "target_lang_word": "generosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "The trait of being willing to donate money, resources, or time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124d1a34-6d02-42f6-8061-edfb97559151",
                                                "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                                "text": "We have mentioned generosity as an outstanding virtue required in Sioux life."
                                            },
                                            {
                                                "example_id": "af3b519b-1b30-40e4-86d2-9349caa59d6a",
                                                "sense_id": "f4b44aa2-35e8-3f15-a8db-a7d1ba8299fb",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "A generous act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff657602-ade2-48ac-ac63-7f6624dfa1ee",
                                                "sense_id": "f4c39d05-8817-3a5f-8502-01456a0da097",
                                                "text": "May the generosities of the founders of these halls, be rewarded by the fair and holy characters which shall be here formed[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6596a999-1ebb-3e79-8a1d-c8c2147ede36",
                                        "entry_id": "6b40829e-453d-3fda-beb6-046cfc046b18",
                                        "glosses": [
                                            "The trait of being abundant, more than adequate."
                                        ],
