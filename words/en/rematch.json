{
    "word_family": [
        "match"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa080d19-2a82-37d5-b83e-497194186bc9",
                    "sense_definition": "A second or subsequent contest between the same opponents or teams.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion requested a <w>rematch</w> after losing the title fight.",
                            "target_lang_translations": {
                                "ru": "Чемпион потребовал <w>матч-реванш</w> после поражения в бою за титул.",
                                "pl": "Mistrz zażądał <w>rewanżu</w> po przegranej walce o tytuł."
                            }
                        },
                        {
                            "text": "Fans are excited to see a <w>rematch</w> between the two rival teams.",
                            "target_lang_translations": {
                                "ru": "Болельщики с нетерпением ждут <w>переигровки</w> между двумя командами-соперницами.",
                                "pl": "Kibice są podekscytowani, mogąc zobaczyć <w>mecz rewanżowy</w> między dwiema rywalizującymi drużynami."
                            }
                        }
                    ],
                    "synonyms": [
                        "replay"
                    ],
                    "common_phrases": [
                        "demand a rematch",
                        "schedule a rematch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторное соревнование или игра между теми же соперниками или командами.",
                        "pl": "Kolejne spotkanie lub zawody między tymi samymi przeciwnikami lub drużynami."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матч-рева́нш",
                                "target_lang_sense_clarification": "состязание, в котором проигравший пытается взять реванш"
                            },
                            {
                                "target_lang_word": "переигро́вка",
                                "target_lang_sense_clarification": "повторная игра или соревнование"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rewanż",
                                "target_lang_sense_clarification": "powtórne spotkanie sportowe"
                            },
                            {
                                "target_lang_word": "mecz rewanżowy",
                                "target_lang_sense_clarification": "oficjalne określenie powtórnego meczu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93fd4f84-8dba-3ed6-a30e-468e2bd984c0",
                    "sense_definition": "To organize a new contest between the same opponents.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The league decided to <w>rematch</w> the finalists next month.",
                            "target_lang_translations": {
                                "ru": "Лига решила <w>назначить матч-реванш</w> для финалистов в следующем месяце.",
                                "pl": "Liga zdecydowała się <w>zarządzić rewanż</w> finalistów w przyszłym miesiącu."
                            }
                        },
                        {
                            "text": "They will <w>rematch</w> the players to settle the score.",
                            "target_lang_translations": {
                                "ru": "Они <w>организуют повторную встречу</w> игроков, чтобы свести счеты.",
                                "pl": "Zorganizują <w>rewanż</w> zawodników, aby rozstrzygnąć wynik."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовать новое соревнование между теми же соперниками.",
                        "pl": "Zorganizować ponowne zawody między tymi samymi przeciwnikami."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначить матч-рева́нш",
                                "target_lang_sense_clarification": "организовать повторную встречу"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zarządzić rewanż",
                                "target_lang_sense_clarification": "podjąć decyzję o powtórnym spotkaniu"
                            },
                            {
                                "target_lang_word": "zorganizować rewanż",
                                "target_lang_sense_clarification": "przygotować powtórne zawody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b76927d3-9583-35d5-bc1a-280579935182",
                    "sense_definition": "To pair or connect items again or in a new way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pairing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician had to <w>rematch</w> the remote control to the television.",
                            "target_lang_translations": {
                                "ru": "Технику пришлось <w>заново настроить</w> пульт дистанционного управления на телевизор.",
                                "pl": "Technik musiał <w>ponownie sparować</w> pilot z telewizorem."
                            }
                        },
                        {
                            "text": "It is necessary to <w>rematch</w> the components to ensure they work together.",
                            "target_lang_translations": {
                                "ru": "Необходимо <w>переподключить</w> компоненты, чтобы убедиться, что они работают вместе.",
                                "pl": "Konieczne jest <w>ponowne skonfigurowanie</w> komponentów, aby upewnić się, że współpracują."
                            }
                        }
                    ],
                    "synonyms": [
                        "reconnect",
                        "repair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова соединить или настроить устройства друг на друга.",
                        "pl": "Ponownie połączyć lub skonfigurować urządzenia, aby ze sobą współpracowały."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переподключи́ть",
                                "target_lang_sense_clarification": "установить соединение заново"
                            },
                            {
                                "target_lang_word": "заново настро́ить",
                                "target_lang_sense_clarification": "выполнить повторную настройку сопряжения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sparować ponownie",
                                "target_lang_sense_clarification": "odnowić połączenie bezprzewodowe"
                            },
                            {
                                "target_lang_word": "skonfigurować ponownie",
                                "target_lang_sense_clarification": "ustawić parametry połączenia od nowa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}