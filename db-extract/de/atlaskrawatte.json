                ],
                "senses": [
                    {
                        "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                        "entry_id": "64382b03-0ced-31f2-8822-4c72b49e0488",
                        "glosses": [
                            "Krawatte aus Atlasgewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9bbb632-b341-428c-92a0-7915c8e47e5b",
                                "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                                "text": "„Du trugest ein Halstuch, das der Mama Als Serviette gedienet hatte; Noch wiegte sich nicht dein Kinn so vornehm In einer gestickten Atlaskrawatte.“"
                            },
                            {
                                "example_id": "f3704a0d-4e3b-4287-bb8b-6dbaba7d9f31",
                                "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                                "text": "„Sein Gehrock war etwas zu kurz, und in der bauschigen, dunkeln Atlaskrawatte steckte eine Smaragdnadel.“"
                            },
                            {
                                "example_id": "37188121-68a7-4b3b-88c2-8d1484d39b92",
                                "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                                "text": "„Als gelernter »Kürschnermeister« ließ er sich in seinem Dorf mit Atlaskrawatte fotografieren.“"
                            },
                            {
                                "example_id": "bb74d0f3-7fd0-4983-a1d6-2a7e4b46c46c",
                                "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                                "text": "„»Wollen wir noch nicht gehen, Vater?« fragte ich, nahm allen meinen Mut zusammen, strich ihm das Haar glatt und zog die verschobene Atlaskrawatte unter seinem Kinn zurecht.“"
                            },
                            {
                                "example_id": "7fb4e6ef-e48e-4603-bf2f-de1b5e0a5d26",
                                "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                                "text": "„Auf der weißen Weste leuchtete die breite goldene Uhrkette, und in der blauen Atlaskrawatte steckte eine kostbare Busennadel in Form eines Hufeisens, ein Geschenk Metas, das sinnig an den früheren Beruf des Besitzers erinnerte . . .“"
                            },
                            {
                                "example_id": "0cf3f559-bd4a-4d8c-b2cb-b3f2179d9588",
                                "sense_id": "0df77f56-b91e-3d84-8130-e22213845ef6",
                                "text": "„Seine Vortragsreise in Amerika – er trug Escarpins und Atlaskrawatte – führte ihn auch zu den Goldgräbern, die ihn von Kneipe zu Kneipe schleppten, bis alle unterm Tisch lagen, er ausgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
