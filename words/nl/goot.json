                        "ru": "Представитель древнегерманского племени готов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Goth",
                                "target_lang_sense_clarification": "historical Germanic person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гот",
                                "target_lang_sense_clarification": "историческое племя"
                            }
