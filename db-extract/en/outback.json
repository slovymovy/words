    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a51f26f6-033b-32c4-b69a-2390c744c3fe",
                "word": "outback",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "51597b12-c47f-4d45-bb3e-a95ff63d16c1",
                        "entry_id": "a51f26f6-033b-32c4-b69a-2390c744c3fe",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more outback"
                    },
                    {
                        "form_id": "23e0237f-11d9-40cc-bca0-a6063d293e2a",
                        "entry_id": "a51f26f6-033b-32c4-b69a-2390c744c3fe",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most outback"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d399291c-d270-38bf-b828-0c17c4b91960",
                        "entry_id": "a51f26f6-033b-32c4-b69a-2390c744c3fe",
                        "glosses": [
                            "Characteristic of the most remote and desolate areas of Australia; very remote from urban areas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f0b5387-c9a9-41db-b337-c2d4ca3d24a3",
                                "sense_id": "d399291c-d270-38bf-b828-0c17c4b91960",
                                "text": "[…]the Civil Service Association is not particularly happy with the decision of the Government in regard to rents and the way they will be levied on its members in the more outback country areas."
                            },
                            {
                                "example_id": "02fa248b-8e02-470e-a170-264cd947cf90",
                                "sense_id": "d399291c-d270-38bf-b828-0c17c4b91960",
                                "text": "In the Northern Territory, arguably the most outback of Australian states, police are still not armed."
                            },
                            {
                                "example_id": "765254ec-9f57-483c-8834-642ceba03e68",
                                "sense_id": "d399291c-d270-38bf-b828-0c17c4b91960",
                                "text": "From Bathurst the Mitchell Highway heads northwest through Dubbo and Bourke Nyngan then continues for almost 200 km to the most outback of towns Bourke."
                            },
                            {
                                "example_id": "21e38000-923f-40ad-864d-4217f2705405",
                                "sense_id": "d399291c-d270-38bf-b828-0c17c4b91960",
                                "text": "2008, Mike Keenan, The Shadows of Horses, Easyread Large Edition, page 135,\nWe had a frosty meeting and he took me around to the AML&F Co′s staff officer, requesting a jackaroo position for me on the company′s most outback station in Queensland."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6df45f94-0b24-35cc-a385-c07c8ee94e8f",
                "word": "outback",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96407ed2-30a0-382e-9f29-069dd18164a9",
                        "entry_id": "6df45f94-0b24-35cc-a385-c07c8ee94e8f",
                        "glosses": [
                            "To or towards the most remote and desolate areas of Australia."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a9dc88f-70ba-4a0e-af45-f3cb1069f86a",
                                "sense_id": "96407ed2-30a0-382e-9f29-069dd18164a9",
                                "text": "If we want this country to develop, we have to depend on men who are prepared to go outback and try to discover new shows."
                            },
                            {
                                "example_id": "0a65d6c3-0f43-45fe-bcfc-27bbb897c4ac",
                                "sense_id": "96407ed2-30a0-382e-9f29-069dd18164a9",
                                "text": "This has allowed Australians really to go outback in some reasonable comfort to see the attractions of this country."
                            },
                            {
                                "example_id": "845fdf5b-89e0-4f48-a954-e1678a53bbf2",
                                "sense_id": "96407ed2-30a0-382e-9f29-069dd18164a9",
                                "text": "Like me, the son was inspired to go outback, and when things went wrong for him the desert seemed like the perfect place to perish and decay, to get blown around on the wind."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5f32433c-4823-3c55-a09e-90fcb8581d11",
                "word": "outback",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d505745a-6ca6-4552-8dd2-9382d302734a",
                        "entry_id": "5f32433c-4823-3c55-a09e-90fcb8581d11",
                        "tags": [
                            "plural"
                        ],
                        "form": "outbacks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                        "entry_id": "5f32433c-4823-3c55-a09e-90fcb8581d11",
                        "glosses": [
                            "The most remote and desolate areas of Australia; the desert and areas too arid for growing crops."
                        ],
                        "tags": [
                            "Australia",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0f816a-8a38-4230-bc87-8a85fc479160",
                                "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                                "text": "1951 June, W. J. Banks, Flying Doctors of the Outback, The Rotarian, page 23,\nCommunication like this is making a big change in the lives of Australia′s “outback” people."
                            },
                            {
                                "example_id": "164dea62-374e-4858-9611-b3b275b55702",
                                "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                                "text": "In the outback, many people live and work on sheep and cattle ranches."
                            },
                            {
                                "example_id": "27d35a34-3640-4383-b130-f55d677ef3e5",
                                "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                                "text": "The outback′s rich, red soil looked like blood because of all the iron in it, and the vast land was so still and barren that it seemed lifeless."
                            },
                            {
                                "example_id": "49a91a12-cb67-4c07-88a7-94c7a27827a5",
                                "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                                "text": "Barely a bird and definitely none of my target species greeted the morning so I cut my losses and headed north through the staggeringly vast emptiness of the Outback."
                            },
                            {
                                "example_id": "987c702a-3a9d-46c2-81ef-a673f2b876bd",
                                "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                                "text": "Astronomers consider the outback area around Alice Springs — with its low pollution, low humidity and few light sources — to be among the best star-gazing locations on earth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98d56c01-c357-4ea3-96ef-b8ef0f7036be",
                        "source_entry_id": "5f32433c-4823-3c55-a09e-90fcb8581d11",
