            {
                "entry_id": "b6f7a20e-1b78-3ae5-a295-3b79343d36de",
                "word": "métope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea809485-3faf-4983-9f5f-ca2f7f2ddc1e",
                        "entry_id": "b6f7a20e-1b78-3ae5-a295-3b79343d36de",
                        "tags": [
                            "plural"
                        ],
                        "form": "métopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6cf65ecc-57e6-32bd-b4ab-aabd500f8c3d",
                        "entry_id": "b6f7a20e-1b78-3ae5-a295-3b79343d36de",
                        "glosses": [
                            "Intervalle rectangulaire situé entre les triglyphes de la frise dorique et généralement orné de reliefs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6c7b7b-705e-4ee6-9e50-ea8ea400b350",
                                "sense_id": "6cf65ecc-57e6-32bd-b4ab-aabd500f8c3d",
                                "text": "Les métopes du Parthénon."
                            },
                            {
                                "example_id": "90bd1d71-76fa-482c-bda5-2f88394f176c",
                                "sense_id": "6cf65ecc-57e6-32bd-b4ab-aabd500f8c3d",
                                "text": "M. Fauvel a moulé deux cariatides du Pandroséum et quelques bas-reliefs du temple de Minerve ; une métope du même temple est entre les mains de M. de Choiseul."
                            },
                            {
                                "example_id": "8fe33dd6-4156-4a3b-b250-03c49b66af62",
                                "sense_id": "6cf65ecc-57e6-32bd-b4ab-aabd500f8c3d",
                                "text": "Par l’harmonie et la fermeté de leur conception comme par l’impeccable exécution de chaque vers, ses poèmes ne sont comparables qu’à ces frises qui se déroulaient majestueusement aux métopes des temples attiques, mais dont chaque détail était aussi finement sculpté que les ornements d’un vase ou les bas-reliefs d’un autel."
                            },
                            {
                                "example_id": "f0d7969f-ac4d-4be7-84ec-c558028dc929",
                                "sense_id": "6cf65ecc-57e6-32bd-b4ab-aabd500f8c3d",
                                "text": "L’identification des traits de Jupiter Amon sur la métope de la frise dorique, qui surmonte la porte d’entrée, nous a conduit à reconsidérer l’iconographie de l’ensemble des bas-reliefs qui la composent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bc7177e-4683-459b-8317-d7cedb0b2f4f",
                        "source_entry_id": "b6f7a20e-1b78-3ae5-a295-3b79343d36de",
                        "source_sense_id": "6cf65ecc-57e6-32bd-b4ab-aabd500f8c3d",
