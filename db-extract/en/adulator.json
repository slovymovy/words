                                        "glosses": [
                                            "Celui qui adule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19df7c8-80f9-4427-9bed-c70c751ac7ec",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "Lâche, vil adulateur."
                                            },
                                            {
                                                "example_id": "b3e950ad-f470-42e5-baa8-4bc4d2632498",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "Les adulateurs ont perdu ce prince."
                                            },
                                            {
                                                "example_id": "1a3acfaf-e572-422c-aea8-744dd8e4de9f",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "C’est un perpétuel adulateur."
                                            },
                                            {
                                                "example_id": "e929ae80-88ca-4d75-9b5e-ae57bb37bba0",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "C’est une grande adulatrice."
                                            },
                                            {
                                                "example_id": "46d75ffd-5f64-4f56-9d92-ae8098aaa452",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "Ses sentiments à l’endroit de l’empereur ne sont nullement ceux d’un adulateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                        "entry_id": "aa042a69-9b9e-3970-b28b-c42815c51cbd",
                                        "glosses": [
                                            "Qui adule."
                                        ],
                                        "tags": [
                                            "formal",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fcba0db-3705-4635-810e-6a835881b3a2",
                                                "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                                "text": "Langage adulateur."
                                            },
                                            {
                                                "example_id": "e9b28385-0ee6-42ad-80f1-b3e92b380b7c",
                                                "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                                "text": "Vers adulateurs."
                                            },
                                            {
                                                "example_id": "a4b4374a-5c2b-4df8-add8-1e6891d9f05d",
                                                "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                                "text": "Au reste, personne n'est assez adulateur pour excuser cette prostitution d'ennoblissements, de titres, de cordons, de places académiques, de grades militaires qui s'aggrave chaque jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36f9d614-1e08-4e92-9a74-37c8c83ab170",
                        "source_entry_id": "06b96f7e-4ad4-3b82-bd1b-0ac05fcc944a",
                        "source_sense_id": "ce6db1bd-6d01-3977-9518-9218ce0eb9aa",
