                                            {
                                                "example_id": "5a75607d-57f2-4188-b08c-091535aedc45",
                                                "sense_id": "69d82cca-11bf-3c97-82b9-a87a3a2305e5",
                                                "text": "De bombardementen in Libië zijn een reactie op de executie van 21 koptische christenen die al weken werden gegijzeld door IS-extremisten in Libië. Beelden van de executies verschenen gisteravond op internet."
                                            },
                                            {
                                                "example_id": "8c3fcf13-d264-4b1a-8f08-950a944ef3ac",
                                                "sense_id": "69d82cca-11bf-3c97-82b9-a87a3a2305e5",
                                                "text": "Volgens de autoriteiten is de bisschop vermoord. Zijn schedel was ingeslagen en hij zou verwondingen hebben gehad in zijn rug. De koptische christenen worden regelmatig bedreigd."
                                            }
