                "senses": [
                    {
                        "sense_id": "69edf4d1-b639-3f30-9232-28ecf812dca1",
                        "entry_id": "a8548072-705f-3649-a9d9-40222bcad90e",
                        "glosses": [
                            "Qui tient de l’apparition ou qui évoque l’apparition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b27f366-3077-438d-9517-29b2341e99e7",
                                "sense_id": "69edf4d1-b639-3f30-9232-28ecf812dca1",
                                "text": "Même si l’on ne savait pas que de grands drames sentimentaux et politiques se sont joués à Edimbourg, on aurait cette impression fantomale de glissement de formes fugitives ; de chuchotements le long du petit cimetière en contrebas, où l’on accède par un porche en ruine ; de reviviscence d’êtres transmués en songe."
                            },
                            {
                                "example_id": "f74ab9b5-66bd-49ba-8b57-16965b4c5e35",
                                "sense_id": "69edf4d1-b639-3f30-9232-28ecf812dca1",
                                "text": "Ces catégories fantomales ressemblaient fort à ce que les hermétistes prétendaient savoir de l’existence d’outre-tombe, comme si le monde de la mort eût continué pour l’âme le monde de la nuit."
                            }
                        ]
                    },
