                    {
                        "sense_id": "a46699a5-0173-3290-af02-6d6f80b20470",
                        "entry_id": "1c6254df-641e-3511-9e32-43dcb8b630e4",
                        "glosses": [
                            "Verkaufsfläche in einem Geschäft oder (Trink-)Lokal als Trennung zwischen Personal und Kundschaft"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "190b55be-170f-43e7-9fb1-26e1692ff674",
                                "sense_id": "a46699a5-0173-3290-af02-6d6f80b20470",
                                "text": "„Der Wirt drückt hinter der Budel hektisch herum.“"
                            },
                            {
                                "example_id": "7b7a3e88-573b-4014-bf60-aa14cdc73a5a",
                                "sense_id": "a46699a5-0173-3290-af02-6d6f80b20470",
                                "text": "„Klar und deutlich wird nach den Beschwerden gefragt, und wenn man schon stumm ein Rezept über die Budel schiebt, wird garantiert forsch Auskunft verlangt.“"
                            },
                            {
                                "example_id": "f15229cd-d693-40f4-9c13-b7dcfb032141",
                                "sense_id": "a46699a5-0173-3290-af02-6d6f80b20470",
                                "text": "„Die Budel ist aus ebenso rustikalem Holz gezimmert wie die Sessel, die Tische und die Garderobe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
