                ],
                "senses": [
                    {
                        "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                        "entry_id": "14b70c1e-69ea-3f49-bacf-d1d08cdf9a24",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname; Vorkommen in Deutschland und Österreich fast flächendeckend, größte Dichte in Sachsen, Franken und der Oberpfalz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcfd41bc-06e2-4845-a768-0eff622862e9",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Mehr Farbe, mehr Frauen: Nach dem Debakel von 2013 hat Parteichef Christian Lindner die FDP tatsächlich erneuert."
                            },
                            {
                                "example_id": "33cb2b04-5cd9-4b51-901f-47a24efad2ef",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Walter Lindner ist Ebola-Beauftragter der Bundesregierung."
                            },
                            {
                                "example_id": "f4413e93-32c4-40fc-8a46-e4099be2a4fa",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Für Monika Lindners Beziehung zum Werber Günter Lebisch interessiert sich nun auch ihr ehemaliges Unternehmen, der ORF."
                            },
                            {
                                "example_id": "1fbb9c53-abf4-471a-9759-16c16606cf3b",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Frau Lindner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "59977f43-5397-4a76-beba-1dc842cb0da4",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Herr Lindner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a6ea7d90-c314-4aef-8c04-ac4ad8dea66e",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Die Lindners kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "82d7098c-1a70-46b1-a58c-70916a2711c4",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Der Lindner trägt nie die Schals, die die Lindner ihm strickt."
                            },
                            {
                                "example_id": "f8093266-1a3d-4c30-9ee2-66c5d9343f6d",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lindner kommt, geht der Herr Lindner.“"
                            },
                            {
                                "example_id": "2867d08e-84e4-414b-9785-bccfd7a3736a",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Lindner kommt und geht."
                            },
                            {
                                "example_id": "76c8869f-7735-42ee-8db0-070b672abd03",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "Lindners kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ced56779-6315-42a8-a7fa-ab3e416340a9",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "An verregneten Herbsttagen ist Familie Lindners liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "11054d9f-2528-4890-a6d6-829acee5232e",
                                "sense_id": "bd13e970-213a-3d9a-b9a7-6860e0e2b89d",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Lindner das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
