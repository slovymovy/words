                    {
                        "translation_id": "4e7f1e35-82e5-4565-83db-62fd9c6030ff",
                        "source_entry_id": "69682eb6-b0d8-33dc-8846-6050d9eeb47d",
                        "source_sense_id": "7cad70d5-3835-3dbc-8cd1-6302344226f7",
                        "target_lang_word": "Ausbildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausbildung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2478a62e-f3f1-35f9-a727-1a7a17a113fb",
                                        "entry_id": "7c03debe-7837-37ab-82d5-980cffa4494f",
                                        "glosses": [
                                            "Erlernen eines Berufes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17070fe4-d482-463d-9524-453d9f8f6678",
                                                "sense_id": "2478a62e-f3f1-35f9-a727-1a7a17a113fb",
                                                "text": "Die Ausbildung schließt mit einer staatlichen Prüfung ab."
                                            },
                                            {
                                                "example_id": "71b6b721-9e61-4f39-bde8-850e39e1e018",
                                                "sense_id": "2478a62e-f3f1-35f9-a727-1a7a17a113fb",
                                                "text": "„Ihre Ausbildung nützt ihnen vielfach nichts, weil es die Jobs nicht gibt, für die sie ausgebildet sind.“"
                                            },
                                            {
                                                "example_id": "54a9ccd3-7942-4cf2-b4a8-76bd2b4233d3",
                                                "sense_id": "2478a62e-f3f1-35f9-a727-1a7a17a113fb",
                                                "text": "„Die Ausbildung war die reinste Verschwendung von Zeit, Geld und Einsatz gewesen.“"
                                            },
                                            {
                                                "example_id": "98780b98-f096-4b8b-a15e-5978c0bf8ef5",
                                                "sense_id": "2478a62e-f3f1-35f9-a727-1a7a17a113fb",
                                                "text": "„Risikosport zählt seit alters zur militärischen Ausbildung.“"
                                            },
                                            {
                                                "example_id": "5aedd194-7fd6-4ed7-8821-556d562b7208",
                                                "sense_id": "2478a62e-f3f1-35f9-a727-1a7a17a113fb",
                                                "text": "„Ihr Vater war Schreinermeister, und Fried hatte im letzten Teil der Ausbildung in seiner Werkstatt gearbeitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce6f68ca-b785-37df-9b46-b9cb6683b7a6",
                                        "entry_id": "7c03debe-7837-37ab-82d5-980cffa4494f",
                                        "glosses": [
                                            "Ausprägung/Entwicklung/Gestaltung einer Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f61cc801-00bb-4cf6-bd12-58c4f306b2ff",
                                                "sense_id": "ce6f68ca-b785-37df-9b46-b9cb6683b7a6",
                                                "text": "Für die gute Ausbildung der Muskeln muss viel Schweiß fließen."
                                            },
                                            {
                                                "example_id": "f09bef98-fb12-4b28-8880-f58b1a4e429e",
                                                "sense_id": "ce6f68ca-b785-37df-9b46-b9cb6683b7a6",
                                                "text": "„Ohne Zweifel gehören die Vaternamen oder Patronymika zu der ältesten Schicht der Familiennamen; wir können ihre Ausbildung an zahlreichen urkundlichen Belegen verfolgen.“"
                                            },
                                            {
                                                "example_id": "752951cd-8f1f-42ab-8e5d-0ada760638a4",
                                                "sense_id": "ce6f68ca-b785-37df-9b46-b9cb6683b7a6",
                                                "text": "„Clemenza, der Caporegime, nahm Sonnys Ausbildung in die Hand und lehrte ihn den Umgang mit Schußwaffen und mit der Garotte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
