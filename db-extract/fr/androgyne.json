        "fr-extract.jsonl": [
            {
                "entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
                "word": "androgyne",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "599bdd2b-495a-4ce8-be69-baa2a0d28fa3",
                        "entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "androgynes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce66f226-277b-3705-9aa7-c29b93fe5432",
                        "entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
                        "glosses": [
                            "Qui est à la fois femelle et mâle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "80cb1e63-1bc8-4897-b58b-ad6a87742dfe",
                                "sense_id": "ce66f226-277b-3705-9aa7-c29b93fe5432",
                                "text": "Les mots de bissexuel et d’unisexuel, d’hermaphrodite et d’androgyne, de monoïque et de dioïque, de polygame et de dichogame… etc., n'atteignent guère jusqu'à la subtilité des distinctions qui demanderaient à être faites."
                            }
                        ]
                    },
                    {
                        "sense_id": "c662d817-a55b-3ea5-8e1d-85fb9c0e85ec",
                        "entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
                        "glosses": [
                            "Qui a des fleurs femelles et des fleurs mâles sur le même pédoncule."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ffcdf48f-b890-3f38-802f-ef913a9d3134",
                        "entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
                        "glosses": [
                            "Expression de genre qui mobilise des caractéristiques féminines et masculines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3746ed2-7762-4747-ac51-288d474d3d53",
                                "sense_id": "ffcdf48f-b890-3f38-802f-ef913a9d3134",
                                "text": "Avec sa voix androgyne et son look à la Bowie, Oete, 23 ans, chante ses amours et des doutes dans son premier album, Armes et paillettes, sorti fin octobre."
                            },
                            {
                                "example_id": "19310f3d-81a6-4d3c-8ce4-5fe1e975f144",
                                "sense_id": "ffcdf48f-b890-3f38-802f-ef913a9d3134",
                                "text": "Une apparence androgyne; attitude, allure, comportement androgyne."
                            },
                            {
                                "example_id": "e4f05c99-7aa0-49d5-bef9-4647cb05a1b7",
                                "sense_id": "ffcdf48f-b890-3f38-802f-ef913a9d3134",
                                "text": "Les personnes androgynes peuvent l'être par effet de mode, par comportement altersexuel ou par rapport à leur identité de genre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e38c440-6d26-4efc-8445-30627ec93270",
                        "source_entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
                        "target_lang_word": "androgynous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "androgynous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77b56e28-ea54-341c-9f0a-f034056373a1",
                                        "entry_id": "bbe40f7d-8723-34bb-96b7-e499d419fe38",
                                        "glosses": [
                                            "Possessing the sex organs of both sexes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "323f62ed-5320-3c6d-b34a-7636e8cc1a27",
                                        "entry_id": "bbe40f7d-8723-34bb-96b7-e499d419fe38",
                                        "glosses": [
                                            "Pertaining to a feature or characteristic that is not definitively of either sex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d0a0a0a-57c1-404e-b988-1ee5d67e87c4",
                                                "sense_id": "323f62ed-5320-3c6d-b34a-7636e8cc1a27",
                                                "text": "Nicknames like Pat, Sam, and Chris are androgynous, used by both men and women."
                                            },
                                            {
                                                "example_id": "75ff07b5-56de-4a96-8dde-41da16e5fba4",
                                                "sense_id": "323f62ed-5320-3c6d-b34a-7636e8cc1a27",
                                                "text": "And I was taught that to be an actress, one should be fashionable, and to be fashionable is to be androgynous. And I am androgynous not less than David Bowie himself."
                                            },
                                            {
                                                "example_id": "468a02ab-0502-41a6-bb94-b5c14bc412e0",
                                                "sense_id": "323f62ed-5320-3c6d-b34a-7636e8cc1a27",
                                                "text": "My name is androgynous, in pronunciation at least – Lauren sounds like the more masculine Loren."
                                            },
                                            {
                                                "example_id": "bfeed2f7-9ecc-4b00-bad8-46a2773333a4",
                                                "sense_id": "323f62ed-5320-3c6d-b34a-7636e8cc1a27",
                                                "text": "All the men call me Kim. Suitably androgynous, I suppose. But all the sisters in Bugis St call me by my initials KC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adbe5ada-b5bf-3231-900a-4148b78b571f",
                                        "entry_id": "bbe40f7d-8723-34bb-96b7-e499d419fe38",
                                        "glosses": [
                                            "Possessing qualities of both sexes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e13eeb-14f0-46f0-999f-fa7caaacc779",
                                                "sense_id": "adbe5ada-b5bf-3231-900a-4148b78b571f",
                                                "text": "The truth is, a great mind must be androgynous."
                                            },
                                            {
                                                "example_id": "c00887da-474a-4216-aecb-118190f4e3b9",
                                                "sense_id": "adbe5ada-b5bf-3231-900a-4148b78b571f",
                                                "text": "The androgynous creative deity was best supplicated or propitiated by offerings concerned with the pleasures of the flesh. In such circumstances, to the worshipper as to the god, licentiousness was not a sin: on the contrary, it was a duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffdd6ad7-55ae-3a22-b8c6-1e92b66888dd",
                                        "entry_id": "bbe40f7d-8723-34bb-96b7-e499d419fe38",
                                        "glosses": [
                                            "Of a connector or docking port, able to connect to another connector or port of the same type, rather than being restricted to connecting to solely male or solely female connectors or ports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e529c66e-88a4-42fe-aa23-5d294b81dc7f",
                                                "sense_id": "ffdd6ad7-55ae-3a22-b8c6-1e92b66888dd",
                                                "text": "APAS is an androgynous docking system, so – in principle, at least – any APAS-equipped vehicle should be able to hook up with any other, without having to worry about matching male with female ports."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3599f54-b37b-4116-9353-f908a40f2f39",
                        "source_entry_id": "a8119f8e-ec4b-3cc6-87ce-ad1d427245f5",
