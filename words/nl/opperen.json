{
    "word_family": [
        "opperman",
        "opper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b493cc17-eb0b-3d75-a296-3920d7b09183",
                    "sense_definition": "een idee of plan naar voren brengen om te kijken wat anderen ervan vinden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voorstellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de vergadering wilde hij een nieuw <w>opperen</w> om de kosten te verlagen.",
                            "target_lang_translations": {
                                "en": "During the meeting, he wanted to <w>suggest</w> a new idea to reduce costs."
                            }
                        },
                        {
                            "text": "Er werden allerlei bezwaren <w>geopperd</w> tegen zijn nieuwe voorstel voor het project.",
                            "target_lang_translations": {
                                "en": "All sorts of objections were <w>raised</w> against his new proposal for the project."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorstellen",
                        "aanvoeren",
                        "suggereren",
                        "berde"
                    ],
                    "common_phrases": [
                        "een idee opperen",
                        "een plan opperen",
                        "bezwaren opperen"
                    ],
                    "target_lang_definitions": {
                        "en": "To put forward an idea or plan to see what others think of it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suggest",
                                "target_lang_sense_clarification": "to mention as a possibility"
                            },
                            {
                                "target_lang_word": "propose",
                                "target_lang_sense_clarification": "to put forward a plan or course of action"
                            },
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "to bring up a point or objection for discussion"
                            },
                            {
                                "target_lang_word": "moot",
                                "target_lang_sense_clarification": "to bring up a topic for debate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d426ed97-70a3-3458-b095-b0727fd0f007",
                    "sense_definition": "als opperman bouwmaterialen zoals stenen en mortel naar de metselaars brengen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge leerling moest de hele dag stenen <w>opperen</w> voor de ervaren metselaars.",
                            "target_lang_translations": {
                                "en": "The young apprentice had to <w>carry</w> bricks for the experienced masons all day."
                            }
                        },
                        {
                            "text": "Het zware werk van het <w>opperen</w> op de bouwplaats werd vroeger met de hand gedaan.",
                            "target_lang_translations": {
                                "en": "The heavy work of <w>hod-carrying</w> on the construction site used to be done by hand."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stenen opperen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vakkennis in de bouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To work as a hod carrier, bringing building materials like bricks and mortar to masons."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "to supply a mason with materials"
                            },
                            {
                                "target_lang_word": "carry the hod",
                                "target_lang_sense_clarification": "to transport bricks or mortar on a building site"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dd3e433-d3dc-3e66-8bd4-ef34a3823003",
                    "sense_definition": "hooi op hopen of opperen zetten om het te laten drogen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boeren waren druk bezig met het <w>opperen</w> van het hooi voordat de regen begon.",
                            "target_lang_translations": {
                                "en": "The farmers were busy <w>cocking</w> the hay before the rain started."
                            }
                        },
                        {
                            "text": "Na het maaien moet men het gras eerst goed <w>opperen</w> op het veld.",
                            "target_lang_translations": {
                                "en": "After mowing, the grass must first be properly <w>stacked</w> in the field."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hooi opperen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in agrarische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To put hay into heaps or cocks to allow it to dry."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cock",
                                "target_lang_sense_clarification": "to pile hay into small conical heaps"
                            },
                            {
                                "target_lang_word": "stack",
                                "target_lang_sense_clarification": "to pile hay for drying or storage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}