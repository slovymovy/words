                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "69aff844-2131-311a-82e2-f757e68be625",
                        "entry_id": "6ef5eb1b-d7d7-376c-99e4-af35f6ea172f",
                        "glosses": [
                            "Promptement, avec vitesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8a4e97-cd8b-4f9c-b645-76e062487688",
                                "sense_id": "69aff844-2131-311a-82e2-f757e68be625",
                                "text": "On se marie rondement, brutalement, comme on traite une affaire sur la place, soit par intermédiaire, soit pas correspondance, quelquefois par rencontre."
                            },
                            {
                                "example_id": "d148199d-f667-4fc2-8cdc-bb67fab9486c",
                                "sense_id": "69aff844-2131-311a-82e2-f757e68be625",
                                "text": "Leurs canons donnèrent rondement de la voix, arrosant l’espace par où s’engouffraient les assaillants."
                            },
                            {
                                "example_id": "5c76cd65-3a2f-402d-aaba-8a9d40cb04cc",
                                "sense_id": "69aff844-2131-311a-82e2-f757e68be625",
                                "text": "Ce chauffeur nous a menés rondement."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7905d0b-51c8-3e15-b10c-8c1912654b3d",
                        "entry_id": "6ef5eb1b-d7d7-376c-99e4-af35f6ea172f",
                        "glosses": [
                            "Sincèrement, franchement, sans artifice, sans façon."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4083b1c4-f300-42f6-9e31-e0738fed1496",
                                "sense_id": "f7905d0b-51c8-3e15-b10c-8c1912654b3d",
                                "text": "Il ne prend pas de détours pour parler, il y va rondement."
                            },
                            {
                                "example_id": "28451d03-8d8b-43ba-9dc6-e4b3596ea4b0",
                                "sense_id": "f7905d0b-51c8-3e15-b10c-8c1912654b3d",
                                "text": "Il va rondement en affaires."
                            },
                            {
                                "example_id": "17b4b516-bc3b-42ae-88d9-f795d34ea2fd",
                                "sense_id": "f7905d0b-51c8-3e15-b10c-8c1912654b3d",
                                "text": "Le vieux curé, l'abbé Chichambre, faisait rondement un prêche rustique."
                            },
                            {
                                "example_id": "9675c5a1-4640-41c9-960b-654d4be0db12",
                                "sense_id": "f7905d0b-51c8-3e15-b10c-8c1912654b3d",
                                "text": "Un couple précédent d'étant dérobé, il avait compris qu'il fallait cette fois y aller carrément.\n« Dites plutôt rondement, meunier, rondement. »"
                            }
                        ]
                    }
                ],
