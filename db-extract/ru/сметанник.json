                "senses": [
                    {
                        "sense_id": "456f0bb8-af2f-3b1b-9dc5-2a0cbfa7ff5c",
                        "entry_id": "0d7ee44d-5f1a-3252-8f2c-7ef8b47c8fec",
                        "glosses": [
                            "посуда для сметаны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802ff6e9-7490-466f-8170-07a1ff9b5cc0",
                                "sense_id": "456f0bb8-af2f-3b1b-9dc5-2a0cbfa7ff5c",
                                "text": "Там уже накрыт стол, на середине стоит полный сметаны сметанник, в соуснике — растопленное, прозрачно-жёлтое масло."
                            }
                        ]
                    },
                    {
                        "sense_id": "47362870-99be-3e95-85c0-52a8f7b05b8a",
                        "entry_id": "0d7ee44d-5f1a-3252-8f2c-7ef8b47c8fec",
                        "glosses": [
                            "разг. пирог со сметаной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206b6f62-a343-45f5-a8ad-f341c18ff55f",
                                "sense_id": "47362870-99be-3e95-85c0-52a8f7b05b8a",
                                "text": "Сметанник — это сметана, яйца, мука. Вот и сметанник пекут."
                            }
                        ]
                    }
                ],
