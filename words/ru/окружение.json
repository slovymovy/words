                                "target_lang_sense_clarification": "potoczne określenie zamkniętych w okrążeniu wojsk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90c04bde-83c2-3238-a77b-1ae817da2029",
                    "sense_definition": "Действие по глаголу «окружать»; процесс создания кольца вокруг кого-либо или чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генерал разработал детальный план полного <w>окружения</w> города.",
                            "target_lang_translations": {
                                "en": "The general developed a detailed plan for the complete <w>encirclement</w> of the city.",
                                "pl": "Generał opracował szczegółowy plan pełnego <w>okrążenia</w> miasta."
                            }
                        },
                        {
                            "text": "Военная операция по <w>окружению</w> противника прошла успешно и быстро.",
                            "target_lang_translations": {
                                "en": "The military operation on the <w>encirclement</w> of the enemy went successfully and quickly.",
                                "pl": "Operacja wojskowa mająca na celu <w>okrążenie</w> przeciwnika przebiegła pomyślnie i szybko."
                            }
                        }
                    ],
                    "common_phrases": [
                        "операция по окружению",
                        "план окружения",
                        "завершение окружения"
                    ],
                    "target_lang_definitions": {
                        "en": "The action of the verb 'to surround'; the process of creating a ring around someone or something.",
                        "pl": "Czynność polegająca na otaczaniu; proces tworzenia pierścienia wokół kogoś lub czegoś."
                    },
                    "translations": {
                        "en": [
