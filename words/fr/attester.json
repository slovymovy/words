{
    "word_family": [
        "attestation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6b446bd-f86f-371e-b702-4f5dbc328f5e",
                    "sense_definition": "Déclarer ou certifier formellement qu'un fait est vrai, par oral ou par écrit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin principal a <w>attesté</w> sous serment que l'accusé se trouvait ailleurs."
                        },
                        {
                            "text": "Je soussigné <w>atteste</w> sur l'honneur que ces renseignements sont parfaitement exacts."
                        }
                    ],
                    "synonyms": [
                        "certifier",
                        "garantir",
                        "confirmer"
                    ],
                    "antonyms": [
                        "contester",
                        "démentir",
                        "nier"
                    ],
                    "common_phrases": [
                        "attester sur l'honneur",
                        "attester sous serment"
                    ]
                },
                {
                    "sense_id": "0efee1f6-b148-39e7-b5fd-84978f22b6f4",
                    "sense_definition": "Constituer la marque visible ou la preuve manifeste de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preuve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ruines antiques <w>attestent</w> la grandeur passée de cette ancienne métropole."
                        },
                        {
                            "text": "Ses excellents résultats scolaires <w>attestent</w> de son travail régulier tout au long de l'année."
                        }
                    ],
                    "synonyms": [
                        "prouver",
                        "démontrer",
                        "témoigner"
                    ],
                    "antonyms": [
                        "infirmer"
                    ],
                    "common_phrases": [
                        "en attester"
                    ]
                },
                {
                    "sense_id": "8f76b3c8-b71f-3c03-8031-eb174a4ba17f",
                    "sense_definition": "Prendre quelqu'un ou une autorité supérieure à témoin pour garantir sa sincérité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temoignage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'ai jamais menti et j'<w>atteste</w> le ciel de ma bonne foi."
                        },
                        {
                            "text": "Il <w>attesta</w> tous ses camarades présents afin de prouver son innocence."
                        }
                    ],
                    "synonyms": [
                        "invoquer"
                    ],
                    "common_phrases": [
                        "attester le ciel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Surtout employé dans un style soutenu ou littéraire"
                        }
                    ]
                }
            ]
        }
    ]
}