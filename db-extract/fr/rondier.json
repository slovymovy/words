                "senses": [
                    {
                        "sense_id": "fa552d72-868d-3cbb-883f-0f07e4ad5ff2",
                        "entry_id": "85b7030c-0671-3e95-863e-f36b326c6262",
                        "glosses": [
                            "Danser en rond."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "7ecce555-8182-4c50-86bc-e3afa0030fb7",
                                "sense_id": "fa552d72-868d-3cbb-883f-0f07e4ad5ff2",
                                "text": "Combien de fois le passant attardé n’a-t-il pas surpris, mais en se gardant bien de faire mine de les voir, une douzaine ou deux de petits hommes rondiant au clair de lune, par quelque belle nuit d’été, sur les tas de fumier dressés aux abords des fermes !"
                            },
                            {
                                "example_id": "57c7e4c8-f5a5-424d-8927-6572456ebc1b",
                                "sense_id": "fa552d72-868d-3cbb-883f-0f07e4ad5ff2",
                                "text": "A Gerbamont, ils allaient rondier (danser) au clair de lune, sur les fumiers, proprement tressés, des maisons où se trouvaient des filles à marier."
                            }
                        ]
                    }
