    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4764141b-abd3-329f-9d28-b0f8b0e7e06e",
                    "sense_definition": "Parvenir à un lieu de destination au terme d'un déplacement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train doit <w>arriver</w> à la gare dans quelques minutes."
                        },
                        {
                            "text": "Nous sommes <w>arrivés</w> chez nos amis juste avant le dîner."
                        }
                    ],
                    "synonyms": [
                        "parvenir",
                        "atteindre"
                    ],
                    "common_phrases": [
                        "arriver à destination",
                        "arriver à l'heure",
                        "arriver en retard"
                    ]
                },
                {
                    "sense_id": "88d2d0c0-1b32-3215-be11-2e2a52ef47c0",
                    "sense_definition": "Se produire ou survenir de manière fortuite ou attendue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un incident imprévu est <w>arrivé</w> pendant notre voyage en Italie."
                        },
                        {
                            "text": "Il peut <w>arriver</w> que la poste soit fermée l'après-midi."
                        }
                    ],
                    "common_phrases": [
                        "arriver par hasard"
                    ]
                },
                {
                    "sense_id": "016f4cb3-6201-395e-8861-c94827b64c1c",
                    "sense_definition": "Réussir à accomplir une tâche ou une action avec un certain effort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reussite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'<w>arrive</w> pas à fermer cette vieille valise trop pleine."
                        },
                        {
                            "text": "Elle est finalement <w>arrivée</w> à terminer son devoir de mathématiques."
                        }
                    ],
                    "synonyms": [
                        "parvenir",
                        "réussir"
                    ]
                },
                {
                    "sense_id": "3003ef1c-d549-3fab-8562-4f04fd054d77",
                    "sense_definition": "Parvenir jusqu'à quelqu'un, en parlant d'un son, d'une lumière ou d'une odeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit de la circulation <w>arrive</w> clairement jusqu'au salon."
                        },
                        {
                            "text": "Une bonne odeur de gâteau chaud nous <w>arrivait</w> de la cuisine."
                        }
                    ],
                    "synonyms": [
                        "parvenir"
                    ]
                },
                {
                    "sense_id": "34c6d97e-e2e1-3440-8f04-7b6299287568",
                    "sense_definition": "Atteindre un stade donné ou un moment précis dans le temps ou dans une tâche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet adolescent <w>arrive</w> bientôt à l'âge adulte et cherche sa voie."
                        },
                        {
                            "text": "Nous <w>arrivons</w> maintenant au chapitre le plus intéressant de ce roman."
                        }
                    ],
                    "synonyms": [
                        "atteindre",
                        "parvenir"
                    ]
                },
                {
                    "sense_id": "8e802f24-db27-3d40-9038-c97958d37471",
                    "sense_definition": "Parvenir à une position sociale avantageuse, à la renommée ou à la richesse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reussite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artiste a persévéré des années avant d'<w>arriver</w> dans son domaine."
                        },
                        {
                            "text": "Beaucoup de jeunes cadres espèrent <w>arriver</w> rapidement au sommet de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "réussir"
                    ]
                }
            ]
        }
    ]
}