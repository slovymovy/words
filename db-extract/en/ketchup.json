                        "glosses": [
                            "To cover with ketchup."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6b71bc38-9160-4487-9dbe-5b54db996c50",
                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                "text": "It strikes me she's \"ketchupped\" the lot! I won't touch a morsel!"
                            },
                            {
                                "example_id": "9f649b96-fea7-4bca-b128-b9407389f58c",
                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                "text": "\"Well,\" said Chuck, ketchupping his hamburger, \"I'd rather do without King Lear than put up with the human agony it sprang out of. I'd rather not have the Eroica than have the big bloody conqueror it tries to immortalize.\""
                            },
                            {
                                "example_id": "7dcd7cff-3aff-47aa-a42f-a3fe24cfbe21",
                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                "text": "Their fellow diners, like their ketchupped grub, were appropriately dashed and splattered with paint and plaster, reading their Suns and Daily Mirror."
                            }
                        ]
                    }
