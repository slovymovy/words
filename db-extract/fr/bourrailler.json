                "senses": [
                    {
                        "sense_id": "19304831-97a6-36c6-8542-8399803c9568",
                        "entry_id": "bd2bac3f-0dc8-3169-a424-19c5e8dc128e",
                        "glosses": [
                            "S’agiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5906f1bf-a4de-46ed-8f84-07ad58e02767",
                                "sense_id": "19304831-97a6-36c6-8542-8399803c9568",
                                "text": "Et le feu « bourraillait » dans la base du saule, le chauffant comme une marmite."
                            },
                            {
                                "example_id": "353178d4-8296-451d-baf7-06ae4c4cddd3",
                                "sense_id": "19304831-97a6-36c6-8542-8399803c9568",
                                "text": "N’avez pas eu en folatrant et bourraillant avec vos camarades, de mauvaises inclinations de pecher du peché de la chair avec eux et sur eux ?"
                            },
                            {
                                "example_id": "e10600fd-8965-4fa5-83c2-eff149267112",
                                "sense_id": "19304831-97a6-36c6-8542-8399803c9568",
                                "text": "Dans le ciel, de gros nuages bas de plafond qui se bourraillent pour rattraper les oies sauvages parties vers le sud."
                            }
                        ]
                    }
