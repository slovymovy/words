                                        "glosses": [
                                            "Any fact or situation which is known or familiar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a377b4-d57f-41de-9bc6-74265af5441a",
                                                "sense_id": "76c204d5-159e-3d6b-8dc5-1fb67644dd90",
                                                "text": "You have to tell the knowns from the unknowns."
                                            },
                                            {
                                                "example_id": "c00bf6ce-ceca-4cc7-b4c7-e60c11b278d7",
                                                "sense_id": "76c204d5-159e-3d6b-8dc5-1fb67644dd90",
                                                "text": "The biological dereplication tool may identify major knowns in a mixture, but it may miss novel minor components."
                                            }
