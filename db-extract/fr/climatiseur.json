        "fr-extract.jsonl": [
            {
                "entry_id": "098073f8-8c79-3d2b-96dc-0cff76aa3d79",
                "word": "climatiseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4e1460e7-c7b3-4787-bb77-f9d4397b1f75",
                        "entry_id": "098073f8-8c79-3d2b-96dc-0cff76aa3d79",
                        "tags": [
                            "plural"
                        ],
                        "form": "climatiseurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                        "entry_id": "098073f8-8c79-3d2b-96dc-0cff76aa3d79",
                        "glosses": [
                            "Appareil servant à modifier les caractéristiques thermiques et hygrométriques de l’atmosphère d’un local, afin de le rendre plus agréable."
                        ],
                        "tags": [
                            "Génie climatique"
                        ],
                        "examples": [
                            {
                                "example_id": "c551a17a-add1-492f-9edc-21342148a7d1",
                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                "text": "Poursuivant notre flânage, nous voyons depuis la ruelle l’envers du décor: des dizaines de climatiseurs, fixés aux murs, soufflent la chaleur des restos vers l’extérieur."
                            },
                            {
                                "example_id": "3b8cf487-7db3-40a9-8642-128a742b339a",
                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                "text": "Tous ces courtisans, profiteurs et forniqueurs dans les bureaux où les climatiseurs ne s'arrêtaient jamais de ronronner, trouvèrent au Président Bagabaga Daba des qualités telles que ses ancêtres durent se retourner dans leur tombe."
                            },
                            {
                                "example_id": "2421b55c-8207-4274-b1ea-7c76a9f23013",
                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                "text": "Ce soir, je brancherai le climatiseur pour dormir convenablement."
                            },
                            {
                                "example_id": "34766cf5-f7df-4ce4-a492-b5724a507b58",
                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                "text": "Willis Carrier est l’homme que vous devez remercier si vous possédez un climatiseur pour faire face aux périodes de canicule. Cet ingénieur américain a inventé le prototype de l’appareil en 1902 (...)."
                            },
                            {
                                "example_id": "5dcf7499-c283-41be-a839-5bba8a6758d7",
                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                "text": "Si par contre d’ici à dix ans on n’installait que des climatiseurs individuels, l’augmentation de température monterait à 2°C."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14e24ee5-77b7-4ddc-b95b-8937142141b6",
                        "source_entry_id": "098073f8-8c79-3d2b-96dc-0cff76aa3d79",
                        "source_sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                        "target_lang_word": "Klimaanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klimaanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                        "entry_id": "ed1ecf0f-eca0-38c2-a0e6-9c9cbc84c329",
                                        "glosses": [
                                            "elektrisches Gerät, das die Lufteigenschaften wie Wärme, Luftfeuchtigkeit oder Ähnliches an die Bedürfnisse anpasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612afa20-225e-4694-9295-25b5355af709",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "Klimaanlagen verändern nicht nur das Raumklima, sondern tragen durch ihren Verbrauch an Energie zum Klimawandel bei."
                                            },
                                            {
                                                "example_id": "4ee8e12e-7883-4e8d-8eaf-04e1abe72a75",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Eine Klimaanlage ist eine Kombination aus sämtlichen Bauteilen, die zur Bereitstellung einer Form der Luftbehandlung erforderlich sind, bei der die Temperatur, eventuell in Kombination mit Lüftung, Luftfeuchte und Luftreinheit, geregelt wird.“"
                                            },
                                            {
                                                "example_id": "94eb48c0-d18b-4b19-88f0-3e54ec696d6a",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Ein fensterloser Raum im Keller des bischöflichen Palais. Es riecht nicht gut, und es gibt keine Klimaanlage.“"
                                            },
                                            {
                                                "example_id": "0d115f49-82b5-45a9-8853-f95be55ce680",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Sie saß einfach nur da und lauschte dem Brausen der Jetmotoren und der Klimaanlage.“"
                                            },
                                            {
                                                "example_id": "0528f859-bc1d-48fb-ab1f-a945691c8cc1",
                                                "sense_id": "9bd34238-2d94-3210-9a92-287aed20e2e7",
                                                "text": "„Eine Klimaanlage hielt die drückende Hitze von Lagos fern, und ihre Haut fühlte sich kühl an, als ob sie gerade eine Abenddusche genommen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1ed4689-73e6-4d78-bf6e-d79485f9b7c0",
                        "source_entry_id": "098073f8-8c79-3d2b-96dc-0cff76aa3d79",
