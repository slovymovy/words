                                            {
                                                "example_id": "224675f2-d3b6-4f8c-adde-c7b74afc55c4",
                                                "sense_id": "a60ef59b-d62a-30c5-85c0-a47ca4e7faf5",
                                                "text": "Les volailles et les autres animaux ainsi que l’homme peuvent être atteints de salmonellose. Il existe plusieurs types de microbes, qui provoquent des signes différents."
                                            },
                                            {
                                                "example_id": "c6bf063b-fd11-4b04-ab05-d4296f367f5d",
                                                "sense_id": "a60ef59b-d62a-30c5-85c0-a47ca4e7faf5",
                                                "text": "Les salmonelles sont des bactéries provoquant des infections intestinales appelées salmonelloses chez l'homme et sont transmises par la consommation d'aliments contaminés par des matières fécales d'animaux."
                                            },
                                            {
                                                "example_id": "9baa60ed-39e2-4087-93f5-e5cd52f6a862",
                                                "sense_id": "a60ef59b-d62a-30c5-85c0-a47ca4e7faf5",
                                                "text": "Selon les CDC, une poussée du nombre de cas de salmonellose est en partie liée à ce comportement: 163 cas ont été enregistrés depuis mi-février, dont 34 hospitalisations."
                                            }
                                        ]
