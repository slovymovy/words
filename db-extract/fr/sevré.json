                    {
                        "sense_id": "02cfb664-80f4-329f-b42e-2a61ceb5c696",
                        "entry_id": "8f1dc21d-525a-3377-9a32-44f89654dcb5",
                        "glosses": [
                            "Qui a terminé sa période de sevrage, qui ne boit plus le lait maternel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d95b1a-ccfe-48b6-9778-9c8cf1186063",
                                "sense_id": "02cfb664-80f4-329f-b42e-2a61ceb5c696",
                                "text": "On estime en outre que l’Ontario expédie environ 8000 porcs sevrés par semaine au Québec, pour la finition de ces animaux », détaille sa relationniste, Christa Roettele."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c6a08c1-d1ab-3b46-90ce-5abe06d02b06",
                        "entry_id": "8f1dc21d-525a-3377-9a32-44f89654dcb5",
                        "glosses": [
                            "Qui a terminé une période de sevrage à une substance addictive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add87ff0-8a53-4572-af68-61d560745d88",
                                "sense_id": "8c6a08c1-d1ab-3b46-90ce-5abe06d02b06",
                                "text": "— Elle m’a quitté parce qu’elle a compris que je ne pouvais pas sortir de la drogue.\n— Mais vous en sortez, en ce moment.\n— Vous savez bien que non.\n— Je constate que vous êtes tout à fait sevré.\n— Cela ne durera pas. Dès ce soir…"
                            }
                        ]
                    }
