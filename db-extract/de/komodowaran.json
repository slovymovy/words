                ],
                "senses": [
                    {
                        "sense_id": "2f9887f0-5412-3dd6-8889-ee715fdbe2e8",
                        "entry_id": "40277f56-c410-3c7d-9001-4e9bd385fc54",
                        "glosses": [
                            "nur noch im indonesischen Komodo National Park in freier Wildbahn vorkommende, größte Echse der Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d68aa64-dae3-4d41-8a16-abe4edebead5",
                                "sense_id": "2f9887f0-5412-3dd6-8889-ee715fdbe2e8",
                                "text": "„Zwar wusste man, dass auf Neuirland Warane leben – sie sind kaum halb so lang wie der bekannte Komodowaran, aber immer noch unübersehbar –, doch hielt man sie für Exemplare des weit verbreiteten Pazifikwarans.“"
                            },
                            {
                                "example_id": "b44b695d-db84-49ca-8a9e-2e6ff4d59e01",
                                "sense_id": "2f9887f0-5412-3dd6-8889-ee715fdbe2e8",
                                "text": "„Von dort stammt auch Naga, der Komodowaran. Er posiert im ozeanischen Ausstellungsbereich unter einer Wärmelampe.“"
                            },
                            {
                                "example_id": "8797ad7c-476f-40b2-a793-b4ce52f0cdce",
                                "sense_id": "2f9887f0-5412-3dd6-8889-ee715fdbe2e8",
                                "text": "„Auf Tauchkreuzfahrt in Indonesien gibt es unter Wasser viel zu sehen. Doch Höhepunkt der Reise ist stets der seltene Komodowaran - allzu nahe sollte man dem gefährlichen Tier dabei allerdings nicht kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
