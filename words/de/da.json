                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Schlüssel liegt drüben auf dem Tisch, genau <w>da</w> habe ich ihn gesehen."
                        },
                        {
                            "text": "Wir wollen in die Berge fahren, weil es <w>da</w> sehr ruhig ist."
                        }
                    ],
                    "synonyms": [
