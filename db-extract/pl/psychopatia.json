                                        "entry_id": "2e82b171-3e97-398c-9daa-08a0d8ec5f08",
                                        "glosses": [
                                            "A mental illness; insanity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
