                "senses": [
                    {
                        "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                        "entry_id": "877ad3e6-10ef-3fb0-bdcd-2c0b53f3a2ea",
                        "glosses": [
                            "grünes, kristallisiertes Eisensulfat mit der Summenformel FeSO₄"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079be76e-3449-447d-9bba-1fdc0aafec61",
                                "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                                "text": "Eisenvitriol hemmt Algenwachstum und ist als eine sehr haltbare Kalkfarbe angesehen."
                            },
                            {
                                "example_id": "dbf23593-5cd9-4a8e-85f1-8ac27fa0fce1",
                                "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                                "text": "In den späteren Jahren wurde Eisenvitriol, besonders in Schweden in reines Kalkwasser gemischt und ergab eine lasierende Oberflächenbehandlung."
                            },
                            {
                                "example_id": "1431ad86-21ce-485d-bba9-98db4dbae63a",
                                "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                                "text": "In Wasser ist Eisenvitriol löslich, in Alkohol und Äther ist FeSO₄ unlöslich."
                            },
                            {
                                "example_id": "829ed99b-4590-43bc-bf3e-e7485e820563",
                                "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                                "text": "Bei der Reaktion des in der Eisengallustinte enthaltenen Eisenvitriols mit in der Luft enthaltenem Wasser und Sauerstoff entsteht Schwefelsäure."
                            },
                            {
                                "example_id": "d6e27185-aa94-4b26-a008-84926540f0d1",
                                "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                                "text": "Eisenvitriol wird als Pigment und in der Wasseraufbereitung verwendet."
                            },
                            {
                                "example_id": "8251379b-2f59-4c30-8415-5ba70dc698a3",
                                "sense_id": "98014871-31bb-33e5-898d-13ea71e13842",
                                "text": "Eisenvitriol wirkt bei Kontakt akut reizend bis ätzend auf Haut und die Schleimhäute."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
