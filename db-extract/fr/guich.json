                        "glosses": [
                            "Sorte de cavalerie, formée de tribus réservistes, de l’armée chérifienne."
                        ],
                        "tags": [
                            "Maroc"
                        ],
                        "examples": [
                            {
                                "example_id": "c5676ee0-968d-4b8b-b18c-d5896ff19abf",
                                "sense_id": "f012e31f-ae43-3420-a5c8-fc9ffbae68a3",
                                "text": "Tout l’édifice du makhzen reposait sur quatre piliers représentés par les tribus du guich : Cheraga, Oudaya, Bouakher et Cherarda."
                            },
                            {
                                "example_id": "4d3da29f-e034-4403-9b62-3858556ef693",
                                "sense_id": "f012e31f-ae43-3420-a5c8-fc9ffbae68a3",
                                "text": "Cette élite va constituer l’armée ou Guich. L’auteur distingue le Guich proprement dit, des contingents des tribus de naiba (nouaib). Ces dernières, n’ont pas d’organisation militaire."
                            }
                        ]
                    }
