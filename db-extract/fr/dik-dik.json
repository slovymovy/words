                        "entry_id": "b33f0679-1773-3ebe-9a17-fda08892a595",
                        "glosses": [
                            "Une des espèces d'antilopes naines d’Afrique du genre Madoqua, au museau allongé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6055e8bc-296b-43be-a6bb-e5f8f1d24d3a",
                                "sense_id": "83aa48a0-432e-3a94-806e-1a217f12abec",
                                "text": "Le dik-dik se nourrit principalement de feuilles, mais aussi de jeunes pousses d’herbe."
                            },
                            {
                                "example_id": "3de9a2fd-acbb-4b4c-a7a6-b2be43d0e4f5",
                                "sense_id": "83aa48a0-432e-3a94-806e-1a217f12abec",
                                "text": "Dans l’ordre domestique, le chien est aussi opposé à la chèvre que l’hyène l’est aux herbivores, et en particulier au dik-dik, dans l’ordre sauvage."
                            }
                        ]
                    }
