                                "target_senses": [
                                    {
                                        "sense_id": "1d9e4661-a937-3608-82fd-0740c9d9d98a",
                                        "entry_id": "6ddfe0a9-dbc3-3399-8838-5a23ad53cb95",
                                        "glosses": [
                                            "Arranged like rays that radiate from, or converge to, a common centre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c1c5ac-fb86-4773-9dc0-d0b5a97248d2",
                                                "sense_id": "1d9e4661-a937-3608-82fd-0740c9d9d98a",
                                                "text": "The spokes on most modern bicycle wheels are tangential to the hub rather than radial."
                                            },
                                            {
                                                "example_id": "e2cdfada-3460-446b-967d-dfe5171aef66",
                                                "sense_id": "1d9e4661-a937-3608-82fd-0740c9d9d98a",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place. Applying a force tangential to the knob is essentially equivalent to applying one perpendicular to a radial line defining the lever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf13682-1af5-3678-95c0-5168e779cc1c",
                                        "entry_id": "6ddfe0a9-dbc3-3399-8838-5a23ad53cb95",
                                        "glosses": [
                                            "Of, or relating to a radius (line joining to a geometric centre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02ecf89-1922-471e-bc37-0f1fbe943e24",
                                                "sense_id": "4cf13682-1af5-3678-95c0-5168e779cc1c",
                                                "text": "What is the relationship between arc length and radial length?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c17e45-502b-32f3-b90b-657d25d7650a",
                                        "entry_id": "6ddfe0a9-dbc3-3399-8838-5a23ad53cb95",
                                        "glosses": [
                                            "Of, or relating to a radius (line joining to a geometric centre).",
                                            "Moving or acting along a radius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f8bb87-2c1b-4efc-9cb9-87841d09a937",
                                                "sense_id": "03c17e45-502b-32f3-b90b-657d25d7650a",
                                                "text": "radial velocity"
                                            }
                                        ]
                                    },
                                    {
