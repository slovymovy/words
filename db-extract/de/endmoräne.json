                "senses": [
                    {
                        "sense_id": "e3d2ab48-799d-3095-b940-7d2416555125",
                        "entry_id": "b22bae97-a577-3b94-aedf-3c7fde8afc60",
                        "glosses": [
                            "wallartige Gesteinsaufschüttung (Moräne) am unteren Rand eines Gletschers"
                        ],
                        "tags": [
                            "Geographie",
                            "Glaziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4cc07feb-4a5f-47bd-8304-cf308a06d8a7",
                                "sense_id": "e3d2ab48-799d-3095-b940-7d2416555125",
                                "text": "„Der Geestrücken ist hier von einer eiszeitlichen Endmoräne überlagert, was in kurzem Abstand ganz unterschiedliche Böden entstehen ließ: hier trocken, dort nass, hier humos, dann wieder lehmig und mal alkalisch und dann wieder sauer.“"
                            },
                            {
                                "example_id": "940f6839-06da-4eb5-8a2f-eb4db74e6ca9",
                                "sense_id": "e3d2ab48-799d-3095-b940-7d2416555125",
                                "text": "„Vor circa 15.000 Jahren schmolz das Eis und hinterließ eine Landschaft mit Grund- und Endmoränen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
