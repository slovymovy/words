                "senses": [
                    {
                        "sense_id": "ea6b6db6-3dee-3f3a-a5f4-2281ffd74673",
                        "entry_id": "9a975e04-7719-3f2d-8478-7ff8c1e1fc14",
                        "glosses": [
                            "Ingenieurwissenschaft, die sich mit der Aufnahme, Übertragung und Speicherung von Informationen beschäftigt, und deren Errungenschaft(en)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963c9252-9ada-4a94-9758-768d662846d1",
                                "sense_id": "ea6b6db6-3dee-3f3a-a5f4-2281ffd74673",
                                "text": "In der Vorlesung und Übung \"Signale und Systeme\" lernten wir die Grundlagen der Nachrichtentechnik."
                            },
                            {
                                "example_id": "6bb947aa-3828-4f95-90d2-2a20985ea61b",
                                "sense_id": "ea6b6db6-3dee-3f3a-a5f4-2281ffd74673",
                                "text": "„Durch die moderne Nachrichtentechnik weiß jeder im gleichen Zeitpunkt praktisch alles.“"
                            },
                            {
                                "example_id": "2a1f076d-d5c3-44e5-9c1f-cb7c2ef849fe",
                                "sense_id": "ea6b6db6-3dee-3f3a-a5f4-2281ffd74673",
                                "text": "„Als einer der Pioniere des Mobilfunks in Österreich begann der Absolvent der HTL für Nachrichtentechnik seine Karriere in der Grundsatz-Planung für D-Netz und GSM.“"
                            },
                            {
                                "example_id": "ca7a6529-98aa-497b-9974-d24ea5d77f39",
                                "sense_id": "ea6b6db6-3dee-3f3a-a5f4-2281ffd74673",
                                "text": "„Denn, wenn es so wäre, dass die jeweils herrschenden Nachrichtentechniken alles Verstehen fernsteuern, wie Kittler formuliert, dann könnten wir nicht nur nicht Medien verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
