                    {
                        "sense_id": "f58ba776-7f3f-3f85-9266-68f4ea681e13",
                        "entry_id": "c2e4f8d5-dc9b-32e3-b030-23d1a9ebfeee",
                        "glosses": [
                            "Araschnia levana een soort vlinder uit de Nymphalidae"
                        ],
                        "tags": [
                            "vlinders"
                        ],
                        "examples": [
                            {
                                "example_id": "15159487-9013-4639-97bd-ae7e759d9040",
                                "sense_id": "f58ba776-7f3f-3f85-9266-68f4ea681e13",
                                "text": "Het landkaartje was vroeger vrij zeldzaam, nu is het een algemene standvlinder in Vlaanderen. De naam, landkaartje, verwijst naar het landkaartpatroon op de onderkant van de vleugels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1eb9ded-237e-4bad-9a1a-434072de54d7",
                        "source_entry_id": "c2e4f8d5-dc9b-32e3-b030-23d1a9ebfeee",
                        "source_sense_id": "f58ba776-7f3f-3f85-9266-68f4ea681e13",
                        "source_sense_description": "soort vlinder, Araschnia levena",
                        "target_lang_word": "Landkärtchen",
