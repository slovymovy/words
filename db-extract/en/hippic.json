                                "target_senses": [
                                    {
                                        "sense_id": "108e44a0-52f2-38d8-92d5-5a78b30f704c",
                                        "entry_id": "682fa7d4-763d-3d5d-adc6-a66d0eab1c93",
                                        "glosses": [
                                            "betrekking hebbend op de paardensport"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a72778a-6e01-4e8b-a33e-832412a37770",
                                                "sense_id": "108e44a0-52f2-38d8-92d5-5a78b30f704c",
                                                "text": "Chris Stoffer (SGP) uit Elspeet, Edgar Mulder (PVV) uit Zwolle en Wim-Jan Renkema (GroenLinks) uit Meppel gaven geen geschenken op. Dalfsenaar Maurits van Martels (CDA) evenmin, maar hij gaf wel een rondleiding met lunch bij hippisch evenement CSI Ommen weg... aan Helma Lodders."
                                            },
                                            {
                                                "example_id": "f0d5886b-2d33-43ba-935c-0d9567f072d1",
                                                "sense_id": "108e44a0-52f2-38d8-92d5-5a78b30f704c",
                                                "text": "Met ruim 1.200 starts in de diverse rubrieken is de animo voor de Helderse Dressuurdagen in hippisch centrum ’t Oale Spoor aan de Pastoor Rientjesstraat opnieuw overweldigend."
                                            },
                                            {
                                                "example_id": "4d7a038b-7c69-4c3d-bec1-b3a9cb5d1673",
                                                "sense_id": "108e44a0-52f2-38d8-92d5-5a78b30f704c",
                                                "text": "Duizend deelnemers en vijfhonderd paarden lieten hun hippische kunsten zien, van de Noorse Koningsgarde en de Cavalerie van Oman tot ruiters uit Azerbeidzjan en de Canadese Mounties. Kleindochter Louise leidde een stoet met koetsen ter ere van de vorig jaar overleden prins Philip. De show werd live uitgezonden op tv."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18eeffec-2046-4319-8c57-23d07b8a81f5",
                        "source_entry_id": "02adb337-13c1-33d9-85fc-b3755d05c155",
                        "source_sense_description": "relating to horses or horse-riding — see also equine",
                        "target_lang_word": "hippique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hippique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1a9e1cb-437e-357d-b9ca-8cd2d0a79baa",
                                        "entry_id": "96f33e81-4e48-377c-8906-3d46f14154ec",
                                        "glosses": [
                                            "Relatif au cheval, à l’équitation ou à l’hippologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a99f1458-b673-4672-a63d-0c12442bb504",
                                                "sense_id": "b1a9e1cb-437e-357d-b9ca-8cd2d0a79baa",
                                                "text": "Tour à tour acheteurs, producteurs et vendeurs, ils ne sortent pas de leurs éléments ; possèdent la plupart le jargon hippique et connaissent sur le bout du doigt la généalogie de tous les produits de la circonscription ; […]"
                                            },
                                            {
                                                "example_id": "5308d17a-4703-4e67-9bcb-6537e0f30bbb",
                                                "sense_id": "b1a9e1cb-437e-357d-b9ca-8cd2d0a79baa",
                                                "text": "Si les chevaux pouvaient parler, ils en auraient long à dire sur les hommes, peut-on croire. Eh bien, justement, chez Tolstoï, dans Le cheval (1885), on rencontre un fier représentant de l’espèce hippique qui n’a pas la langue dans sa poche et que les circonstances forcent à philosopher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f14865b-d2ea-4dad-a250-1fb0f044e1da",
                        "source_entry_id": "02adb337-13c1-33d9-85fc-b3755d05c155",
                        "source_sense_description": "relating to horses or horse-riding — see also equine",
                        "target_lang_word": "équin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71283103-4049-37eb-9ccd-dfe702d05fc5",
                                        "entry_id": "a105b28b-8245-3824-a87b-36ec0b6c2125",
                                        "glosses": [
                                            "En rapport avec les équidés (cheval, âne, mulet…)."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3afd129-69b8-476f-9a68-15f78dc20f76",
                                                "sense_id": "71283103-4049-37eb-9ccd-dfe702d05fc5",
                                                "text": "Le sarcoïde est la tumeur cutanée équine la plus fréquente, régulièrement rencontrée dans les EEP des zèbres de Hartmann et des ânes de Somalie, mais peu décrite chez les zèbres de Grévy."
                                            },
                                            {
                                                "example_id": "c1d098c0-2352-48c0-8721-1b63f03c0ad7",
                                                "sense_id": "71283103-4049-37eb-9ccd-dfe702d05fc5",
                                                "text": "La profession de dentiste équin n’a pas d’existence légale, ni de diplôme."
                                            },
                                            {
                                                "example_id": "5ef39dde-d199-4f8d-8909-cb5e40f8739e",
                                                "sense_id": "71283103-4049-37eb-9ccd-dfe702d05fc5",
                                                "text": "La licorne médiévale, à l’allure équine dotée d’une corne frontale et d’attributs caprins (bouc et pattes), est symbole de puissance spirituelle, de pureté et de pouvoir magique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18865ba7-d4fc-3803-b583-e1c1542ccce5",
                                        "entry_id": "a105b28b-8245-3824-a87b-36ec0b6c2125",
                                        "glosses": [
                                            "Qui tient du cheval ou des autres équidés."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c1b6734-1e7a-41fa-aab4-32e1c5bf31cd",
                                                "sense_id": "18865ba7-d4fc-3803-b583-e1c1542ccce5",
                                                "text": "[…], et le bellâtre à tête plus ou moins simiesque, bovine, équine, porcine, corvidée ou batracienne, — toute la lyre esthétique ! — exulte devant son miroir, se tient pour la copie la plus parfaite de l’Antinoüs, et se fait a lui-même les yeux doux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "équin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "451e5bb4-27f6-3394-823a-925bf7698b86",
                                        "entry_id": "6c9980f1-008c-3b38-b717-0e813dd0924b",
                                        "glosses": [
                                            "Animal de la famille des équidés."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7448a162-7633-4940-b66e-8d59da4e7b8a",
                                                "sense_id": "451e5bb4-27f6-3394-823a-925bf7698b86",
                                                "text": "Car le cerf, avec ses cornes et ses sabots fendus, ressemble autant à un bœuf qu’à un équin, ce qui n’échappa pas au zèle taxinomique des Otomi confrontés à la « révolution » hispanique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
