                        "glosses": [
                            "Pflanze aus der Familie der Schmetterlingsblütler mit blauen Blütentrauben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb929e7-031b-474d-b016-03e14b0b05af",
                                "sense_id": "df3ebcf2-70e9-3aca-b3c7-c2f0f5172f23",
                                "text": "Blauregen ist eine beliebte, aber giftige Zierpflanze."
                            }
                        ],
