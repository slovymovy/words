                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca7f9112-ecf3-494f-b9f0-44279f07afab",
                        "source_entry_id": "594c414a-011b-3f76-9937-bfc526e71d10",
                        "source_sense_id": "7fd7081c-01ea-3e4e-82c7-02da2cfd4591",
                        "target_lang_word": "fury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7ddbd0a-6213-3114-b2b2-c0b67122b929",
                                        "entry_id": "603ceb3e-7b7c-31f2-a8a2-99aed44cc48f",
                                        "glosses": [
                                            "Extreme anger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54a517d-7d23-49c2-9a67-81b38d1224ae",
                                                "sense_id": "c7ddbd0a-6213-3114-b2b2-c0b67122b929",
                                                "text": "Heav'n has no Rage, like Love to Hatred turn'd, / Nor Hell a Fury, like a Woman ſcorn'd."
                                            },
                                            {
                                                "example_id": "9251a37c-d416-4dc8-ace7-30c72b5f5798",
                                                "sense_id": "c7ddbd0a-6213-3114-b2b2-c0b67122b929",
                                                "text": "The building of the railway in this notable beauty spot roused the great Victorian writer John Ruskin to fury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "198e9cb4-fb23-3425-ae28-ca8ea3e16c75",
                                        "entry_id": "603ceb3e-7b7c-31f2-a8a2-99aed44cc48f",
                                        "glosses": [
                                            "Strength or violence in action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71fe948d-791f-4392-ba42-86ee6050ed17",
                                                "sense_id": "198e9cb4-fb23-3425-ae28-ca8ea3e16c75",
                                                "text": "Small lightes are ſoone blown out, huge fires abide, / And with the winde in greater furie fret: / The petty ſtreames that paie a dailie det / To their ſalt ſoveraigne with their freſh fals haſt, / Adde to his flowe, but alter not his taſt."
                                            },
                                            {
                                                "example_id": "eb7fb02d-2056-420a-b471-73619e2b24f6",
                                                "sense_id": "198e9cb4-fb23-3425-ae28-ca8ea3e16c75",
                                                "text": "I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera,[…]the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosis,[…]!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f82645f-758e-3268-936a-e409f8e89204",
                                        "entry_id": "603ceb3e-7b7c-31f2-a8a2-99aed44cc48f",
                                        "glosses": [
                                            "An angry or malignant person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45f601f2-dfea-3e0a-86ef-228bfba307da",
                                        "entry_id": "e7749d17-72b9-338e-a13f-ef969b18c258",
                                        "glosses": [
                                            "A thief."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902a6b1c-fdde-4796-936c-26a5be20f970",
                                                "sense_id": "45f601f2-dfea-3e0a-86ef-228bfba307da",
                                                "text": "But have an eye to your plate , for there be Furies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
