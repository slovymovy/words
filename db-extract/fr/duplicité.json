        "fr-extract.jsonl": [
            {
                "entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                "word": "duplicité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abdf495f-b216-4c1a-a40d-414d522c35a1",
                        "entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "duplicités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b655747-7ebf-3b88-8a2a-1d4b9dfb682b",
                        "entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "glosses": [
                            "État de ce qui est double."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "51a4946c-9b40-4b92-b80d-eb4917b22d77",
                                "sense_id": "6b655747-7ebf-3b88-8a2a-1d4b9dfb682b",
                                "text": "Il y a duplicité d’action dans cette tragédie."
                            },
                            {
                                "example_id": "065da2d7-5b19-40e0-9e70-74c7aa255690",
                                "sense_id": "6b655747-7ebf-3b88-8a2a-1d4b9dfb682b",
                                "text": "– Comment expliquez-vous, monsieur le professeur, me dit-il brusquement vers la fin du dîner, comment expliquez-vous la dualité ou la duplicité de notre nature ?…\nEt, comme il s'aperçut que je ne le comprenais pas parfaitement, il reprit :\n– Ne vous êtes-vous jamais trouvé au haut d'une tour ou bien au bord d'un précipice, ayant à la fois la tentation de vous élancer dans le vide et un sentiment de terreur absolument contraire ?…"
                            }
                        ]
                    },
                    {
                        "sense_id": "250cfde4-7674-32b5-9c7a-49c0e4eb6933",
                        "entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "glosses": [
                            "Disposition mauvaise qui porte à manifester des sentiments, des intentions autres que celles qu’on a réellement, en vue de tromper les autres, tout comme si l’on était un double personnage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f65551-4f2e-4922-a200-132908bb86dc",
                                "sense_id": "250cfde4-7674-32b5-9c7a-49c0e4eb6933",
                                "text": "On reproche beaucoup de choses aux Chinois, entre autres leur ruse et leur duplicité. En sont-ils plus pourvus que le madré paysan d’Europe ? En y regardant de près, on pourrait pousser la comparaison assez loin, mais ce n’est pas le procès des Européens qu'il s’agit d’instruire ici."
                            },
                            {
                                "example_id": "2b8e2a0e-9e14-4148-889a-48ff0ad18b23",
                                "sense_id": "250cfde4-7674-32b5-9c7a-49c0e4eb6933",
                                "text": "Mon Dieu, en quelle martyre vous m'avez condamnée à vivre, enveloppée de duplicités, environnée d'embûches, cernée de chausses-trapes."
                            },
                            {
                                "example_id": "be2ddfe8-de98-4b2b-aba4-a0de6201db5e",
                                "sense_id": "250cfde4-7674-32b5-9c7a-49c0e4eb6933",
                                "text": "On pense à la duplicité de Mme Verdurin donnant le change sur sa fictive hilarité en posant une main sur sa bouche et en fermant les yeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d958b677-68ee-3c3e-b466-e8e2f13df43c",
                        "entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "glosses": [
                            "Duplication (d’un organe)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a940412-7e28-4273-8af8-47e6556f15a7",
                        "source_entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "source_sense_description": "état de ce qui est double",
                        "target_lang_word": "dubbeling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dubbeling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f37bfca-a697-3540-a375-8ec74406f81f",
                                        "entry_id": "c90ce86e-0845-32b8-a2b4-12fc3cf770ca",
                                        "glosses": [
                                            "het in tweevoud voorkomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cf476b-b4c3-46ea-8e55-24b281f0f9f3",
                                                "sense_id": "9f37bfca-a697-3540-a375-8ec74406f81f",
                                                "text": "De werkgroep moest op zoek naar een alternatieve speelperiode, omdat de temperaturen in de golfstaat te hoog zijn in de zomer. Sjeik Salman geeft ook aan dat het toernooi niet in januari en februari kan worden gehouden, omdat dubbeling met de Winterspelen moet worden voorkomen."
                                            },
                                            {
                                                "example_id": "16594040-c067-411a-a842-bd3297205414",
                                                "sense_id": "9f37bfca-a697-3540-a375-8ec74406f81f",
                                                "text": "Dubbeling: Locatus weet precies welke winkel waar zit in Nederland. Het onderzoeksbureau meldt dat in 109 gevallen een Bart Smit en Intertoys relatief dicht bij elkaar zitten (maximaal 2,5 kilometer afstand). Is er in die gevallen sprake van overlap, dus dat de ene winkel omzet afpakt van de ander?"
                                            },
                                            {
                                                "example_id": "781b1b4e-169d-4dc9-847f-b1a796d94b32",
                                                "sense_id": "9f37bfca-a697-3540-a375-8ec74406f81f",
                                                "text": "De inspectie controleert primair of een bedrijf beschikt over de benodigde REACH-registratie. ECHA controleert of die ingediende registratie volledig en juist is. De ILT controleert bijvoorbeeld niet de toxiciteitsgegevens uit het registratiedossier, omdat anders een dubbeling zou ontstaan met de taak die ECHA daarbij heeft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b16d56f-397f-3cda-a627-41c8703a0fcc",
                                        "entry_id": "c90ce86e-0845-32b8-a2b4-12fc3cf770ca",
                                        "glosses": [
                                            "een tweede buitenbeplating die wordt aangebracht over de bestaande huid van een schip van bijvoorbeeld hout of staal"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a28d1729-c179-4b21-b13a-d5cbf285740c",
                        "source_entry_id": "d8f84c95-2e1e-3f7a-94bc-6f9d563b50c5",
                        "source_sense_description": "état de ce qui est double",
                        "target_lang_word": "jogo duplo",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
