                        "examples": [
                            {
                                "example_id": "5cf3dd23-cddd-4247-a493-cd9ad2abea4f",
                                "sense_id": "d805aeb4-73c1-39a4-8ed3-b1008deb54dc",
                                "text": "Woher weiß ich, dass Sie echt sind? -- Sie könnten meinen Namen in eine Suchmaschine eintippen, Texte in anderen Medien über mich lesen oder sich meinen Ausweis zeigen lassen.",
                                "translation": "Comment puis-je savoir si vous êtes réel ? -- Vous pourriez taper mon nom dans un moteur de recherche, lire des textes sur moi dans d'autres médias ou demander à voir ma carte d'identité."
                            }
                        ]
                    }
