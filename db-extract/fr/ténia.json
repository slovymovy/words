                                        "entry_id": "7a99bcfa-f279-3813-85e6-9ab9a1449365",
                                        "glosses": [
                                            "κινηματογραφικό έργο με μεγάλη ή μικρή διάρκεια"
                                        ],
                                        "tags": [
