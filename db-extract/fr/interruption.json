                                "target_senses": [
                                    {
                                        "sense_id": "2cfb62ca-09c1-3152-a5f8-cbf5f2fa2355",
                                        "entry_id": "04b429b4-ad04-36de-a6a2-8d1209f341c1",
                                        "glosses": [
                                            "приостановка, временное прекращение какой-либо деятельности или процесса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ca266c-1f73-4224-8bd5-a6655e838866",
                                                "sense_id": "2cfb62ca-09c1-3152-a5f8-cbf5f2fa2355",
                                                "text": "Перерывы в подаче электричества в Южно-Сахалинске — частое явление."
                                            },
                                            {
                                                "example_id": "270eac9f-9ccd-43dc-a60d-653558a73568",
                                                "sense_id": "2cfb62ca-09c1-3152-a5f8-cbf5f2fa2355",
                                                "text": "В день подачи покупателем искового заявления в суд произошёл перерыв течения этого срока."
                                            },
                                            {
                                                "example_id": "6e2a69c9-34e6-4dbc-84c7-0d3a457f33eb",
                                                "sense_id": "2cfb62ca-09c1-3152-a5f8-cbf5f2fa2355",
                                                "text": "Компьютер как раз сохранял файл, когда произошёл перерыв в питании от сети."
                                            },
                                            {
                                                "example_id": "0d64c92a-da25-42ef-80e7-26f46a3480f0",
                                                "sense_id": "2cfb62ca-09c1-3152-a5f8-cbf5f2fa2355",
                                                "text": "Если сушат в духовке, которая должна быть приоткрытой, то изредка делают перерыв в сушке, чтобы зелень сохла равномерно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e1fc1f-9a1e-33e9-bfbe-543bcba8dd91",
                                        "entry_id": "04b429b4-ad04-36de-a6a2-8d1209f341c1",
                                        "glosses": [
                                            "промежуток времени с момента перерыва [1] до возобновления деятельности или процесса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e467a0d5-baa4-4a84-a0f6-4ea85fd7affd",
                                                "sense_id": "11e1fc1f-9a1e-33e9-bfbe-543bcba8dd91",
                                                "text": "Не могу вас сейчас принять — у меня перерыв."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
