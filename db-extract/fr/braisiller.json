                ],
                "senses": [
                    {
                        "sense_id": "c90123a8-ebed-3968-b041-4bf312d49e6c",
                        "entry_id": "07f559bd-61b6-397a-9c86-63cb9751f2e6",
                        "glosses": [
                            "Émettre des lueurs de braise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b9c232f-4d27-4d3f-b45a-a7ade8c53a73",
                                "sense_id": "c90123a8-ebed-3968-b041-4bf312d49e6c",
                                "text": "Les cafés, les marchands de vin, les restaurants braisillaient, étalaient, derrière les hautes glaces sans tain, leurs comptoirs de métal clair, leurs petites tables blanches, la tentation des beaux fruits et des paniers d’huîtres, à leurs portes."
                            },
                            {
                                "example_id": "6481e13b-8746-46d7-9b4c-01ad850e84f7",
                                "sense_id": "c90123a8-ebed-3968-b041-4bf312d49e6c",
                                "text": "Alors, les yeux d’Aimée braisillent de joie comme ceux d’une chatte en malice, et mademoiselle Sergent rit de la voir rire."
                            },
                            {
                                "example_id": "a65c7f90-2b3f-4529-a047-dfbe3ce15525",
                                "sense_id": "c90123a8-ebed-3968-b041-4bf312d49e6c",
                                "text": "Le pot de fer, où des charbons braisillent, est aussi un peu plus ébréché."
                            },
                            {
                                "example_id": "ce376a4e-d350-46f6-b80a-7ebccdd6f04e",
                                "sense_id": "c90123a8-ebed-3968-b041-4bf312d49e6c",
                                "text": "Combien d’étoiles noires ont-ils empêché de braisiller dans le ciel africain par des choix irresponsables ?"
                            },
                            {
                                "example_id": "24cc82e0-0774-4dc4-a788-baf84639fb43",
                                "sense_id": "c90123a8-ebed-3968-b041-4bf312d49e6c",
                                "text": "On voyait braisiller dans l’ombre des regards ennemis."
                            }
                        ]
                    }
                ],
