                        ],
                        "examples": [
                            {
                                "example_id": "598b7a9b-5de7-4674-9a8a-a7e19b23d5d3",
                                "sense_id": "ccbbf011-cbba-3abf-9808-656aa381afa7",
                                "text": "W naszym przedsiębiorstwie zatrudniamy chętnie etranżerów."
                            },
                            {
                                "example_id": "6e4a1cd5-4570-476d-8120-d06477b6d61e",
                                "sense_id": "ccbbf011-cbba-3abf-9808-656aa381afa7",
                                "text": "Ale co im powiedzieć? — Może pan powiedzieć, że musi pan przyjąć jakiegoś etranżera"
                            },
                            {
                                "example_id": "74761e4f-00dd-4ea2-b1e0-45d89d999d74",
                                "sense_id": "ccbbf011-cbba-3abf-9808-656aa381afa7",
                                "text": "Uspokojony dyrektor policji pożegnał się z podwładnymi, ponieważ jak wyjaśnił, ma ważnego etranżera, i przekazał prowadzenie dalszych obrad swemu zastępcy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
