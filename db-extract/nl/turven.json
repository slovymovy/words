                                        "entry_id": "4390f7b7-92ff-3757-ad70-c8fe8e5bc116",
                                        "glosses": [
                                            "In a tall way; stoutly; with spirit."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f88ef7f-3c26-4b54-b1ec-231330ddbe0a",
                                                "sense_id": "de0696fb-b82e-3283-9518-6d5e388052f2",
                                                "text": "And you, Lodovick, / That stand so tally on your reputation, / You shall be he shall speak it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1acaaff9-5cc9-36ce-a26a-acd3d117431a",
                                        "entry_id": "5a87cb6e-4689-3660-9bb7-818925e8790e",
                                        "glosses": [
                                            "Target sighted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3db4310-9e63-44c0-97a6-0ce35c4c3a51",
                                                "sense_id": "1acaaff9-5cc9-36ce-a26a-acd3d117431a",
                                                "text": "(Air Traffic Control): Speedbird 123, New York, traffic at two o’clock, seven miles, a Boeing 737, west-bound, at 4000 feet."
                                            },
                                            {
                                                "example_id": "7c66be5f-4063-43f0-aa89-04c379bad056",
                                                "sense_id": "1acaaff9-5cc9-36ce-a26a-acd3d117431a",
                                                "text": "(Pilot): New York, Speedbird 123, tally."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ece90bb-1887-3f5f-b045-eb58e049f386",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "Abbreviation of tally stick."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f811cca2-e005-31ee-96c6-127b06f2bbc2",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "One of two books, sheets of paper, etc., on which corresponding accounts were kept."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51e76a2d-df6a-34e2-b945-c171aa19d574",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "Any account or score kept by notches or marks, whether on wood or paper, or in a book, especially one kept in duplicate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097b6311-43ab-4e91-80fa-59693cf67db7",
                                                "sense_id": "51e76a2d-df6a-34e2-b945-c171aa19d574",
                                                "text": "Bulgaria, inevitably, raised the tempo in the opening moments of the second half and keeper Joe Hart was forced into his first meaningful action to block a deflected corner - but England were soon threatening to add to their goal tally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d323c3-515d-3aef-bba2-b5eaea025816",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "One thing made to suit another; a counterpart or match."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14e3982-d48c-4067-901b-476d0569ed1f",
                                                "sense_id": "23d323c3-515d-3aef-bba2-b5eaea025816",
                                                "text": "So paired, so suited in their minds and persons,\nThat they were framed the tallies for each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787b9fa8-3da8-3a8b-9007-940ae5b9660c",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "A notch, mark, or score made on or in a tally; as, to make or earn a score or tally in a game."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a546f4a7-8f9d-38b3-a018-bf8afc670f1d",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "A tally shop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3233f0d4-e9fc-34ce-a016-8cd5592523af",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "A ribbon on a sailor's cap bearing the name of the ship or the (part of) the navy to which they belong."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd0d1687-916c-3a53-a38b-18299ceccaed",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "A state of cohabitation, living with another individual in an intimate relationship outside of marriage."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eae24ea-5ebe-4bf9-b24b-84b57b7268cf",
                                                "sense_id": "fd0d1687-916c-3a53-a38b-18299ceccaed",
                                                "text": "But I’d advise thee t’ live tally for o that, if thou con mak it reet wi’ some owd damsel, ut does no’ care what folk say’n about owt o’th’sort."
                                            },
                                            {
                                                "example_id": "43848bbd-d3ed-4c3c-a3ed-45e934d36d8f",
                                                "sense_id": "fd0d1687-916c-3a53-a38b-18299ceccaed",
                                                "text": "It is used in Yorkshire, Lancashire, Cheshire, and, I dare say, various other counties. A tally-woman is the mistress of a married man, who is said to live tally with her."
                                            },
                                            {
                                                "example_id": "f888a1d7-6fbc-40ac-89e4-3a0f10eba12b",
                                                "sense_id": "fd0d1687-916c-3a53-a38b-18299ceccaed",
                                                "text": "Don, I don't care if we live tally, cos we don't need certificates except for proof of insanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6c4c26f-7f4e-37fe-8746-f25ecf1009f7",
                                        "entry_id": "11df21ef-bd1a-3197-b887-443e33f5eace",
                                        "glosses": [
                                            "Five dozen bunches of turnips."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9c5170-621f-43c1-8f01-532036c5eb82",
                                                "sense_id": "a6c4c26f-7f4e-37fe-8746-f25ecf1009f7",
                                                "text": "Then turnips isn't such good sale yet, but they may be soon, for winter's best for them. […] I buy turnips by the 'tally.' A tally's five dozen bunches."
                                            },
                                            {
                                                "example_id": "ef475650-27ef-419e-952c-f2c1e4502ae0",
                                                "sense_id": "a6c4c26f-7f4e-37fe-8746-f25ecf1009f7",
                                                "text": "A bunch of Turnips, 12 and upwards. A bunch of Leeks, 6 and upwards. Bunches of Greens and of herbs vary much, according to kind, size, and season. Roll of Celery = 6, 8, to 12 heads. A tally = five dozen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "175c74ca-7f00-398e-b559-68719680d917",
