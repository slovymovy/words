{
    "word_family": [
        "uitlopen",
        "loper",
        "uitloop"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1da2cd67-f4bc-3fad-9dba-c2dfece62e0f",
                    "sense_definition": "Een groeiende, vaak kruipende, loot of stengel aan een boom of plant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is tijd om die <w>uitlopers</w> wat in te korten, anders verwildert de hele struik.",
                            "target_lang_translations": {
                                "en": "It is time to shorten those <w>shoots</w> a bit, otherwise the whole bush will grow wild."
                            }
                        },
                        {
                            "text": "De aardbeienplant vormt snel nieuwe <w>uitlopers</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "The strawberry plant quickly forms new <w>runners</w> in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "loot",
                        "scheut",
                        "stengel"
                    ],
                    "common_phrases": [
                        "nieuwe uitlopers vormen",
                        "uitlopers van planten"
                    ],
                    "target_lang_definitions": {
                        "en": "A growing, often creeping, shoot or stem on a tree or plant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "runner",
                                "target_lang_sense_clarification": "of a plant"
                            },
                            {
                                "target_lang_word": "shoot",
                                "target_lang_sense_clarification": "new plant growth"
                            },
                            {
                                "target_lang_word": "stolon",
                                "target_lang_sense_clarification": "botanical term for a creeping stem"
                            },
                            {
                                "target_lang_word": "offshoot",
                                "target_lang_sense_clarification": "lateral branch or shoot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67ab4610-cefd-33d9-945a-f9ac61a2a8a7",
                    "sense_definition": "Een uitstekend of aflopend deel van een groter geheel, zoals een heuvelrug of gebergte.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We kampeerden op een van de <w>uitlopers</w> van de Ardennen.",
                            "target_lang_translations": {
                                "en": "We camped on one of the <w>spurs</w> of the Ardennes."
                            }
                        },
                        {
                            "text": "De bergen hebben hier brede <w>uitlopers</w> die tot aan de kust reiken.",
                            "target_lang_translations": {
                                "en": "The mountains here have wide <w>foothills</w> that reach all the way to the coast."
                            }
                        }
                    ],
                    "synonyms": [
                        "heuvelrug",
                        "uitloper"
                    ],
                    "common_phrases": [
                        "uitlopers van het gebergte"
                    ],
                    "target_lang_definitions": {
                        "en": "A projecting or sloping part of a larger whole, such as a ridge or mountain range."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spur",
                                "target_lang_sense_clarification": "of a mountain range"
                            },
                            {
                                "target_lang_word": "foothill",
                                "target_lang_sense_clarification": "lower hill at the base of a mountain"
                            },
                            {
                                "target_lang_word": "outlier",
                                "target_lang_sense_clarification": "geographical feature standing apart"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a33c613-da54-3d2a-9ac2-b0070e86eeb9",
                    "sense_definition": "Iets dat figuurlijk voortkomt uit of een uitloper is van een groter verschijnsel of gebied.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_extension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Afghanistan heeft een lange <w>uitloper</w> in de noordoostelijke bergen.",
                            "target_lang_translations": {
                                "en": "Afghanistan has a long <w>outpost</w> in the northeastern mountains."
                            }
                        },
                        {
                            "text": "Deze storm is slechts een laatste <w>uitloper</w> van het lagedrukgebied.",
                            "target_lang_translations": {
                                "en": "This storm is merely a final <w>aftereffect</w> of the low-pressure area."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitvloeisel",
                        "vervolg"
                    ],
                    "common_phrases": [
                        "een laatste uitloper"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that figuratively arises from or is an extension of a larger phenomenon or area."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outpost",
                                "target_lang_sense_clarification": "geographical extension or strip of land"
                            },
                            {
                                "target_lang_word": "offshoot",
                                "target_lang_sense_clarification": "figurative development or branch"
                            },
                            {
                                "target_lang_word": "aftereffect",
                                "target_lang_sense_clarification": "lingering consequence or tail end of an event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d1c3434-c947-37b7-a3b6-fcaa910e00a7",
                    "sense_definition": "Iemand die eropuit gestuurd wordt om een boodschap of taak te vervullen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning stuurde een <w>uitloper</w> om het nieuws te verspreiden.",
                            "target_lang_translations": {
                                "en": "The king sent a <w>messenger</w> to spread the news."
                            }
                        },
                        {
                            "text": "Als jonge <w>uitloper</w> moest hij dagelijks brieven bezorgen.",
                            "target_lang_translations": {
                                "en": "As a young <w>runner</w>, he had to deliver letters daily."
                            }
                        }
                    ],
                    "synonyms": [
                        "bode",
                        "koerier",
                        "boodschapper"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderde betekenis voor een bode of koerier."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who is sent out to deliver a message or perform a task."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "messenger",
                                "target_lang_sense_clarification": "person carrying a message"
                            },
                            {
                                "target_lang_word": "runner",
                                "target_lang_sense_clarification": "courier or errand-goer"
                            },
                            {
                                "target_lang_word": "courier",
                                "target_lang_sense_clarification": "person who delivers messages"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}