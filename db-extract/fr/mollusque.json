        "fr-extract.jsonl": [
            {
                "entry_id": "15cde4df-82d8-32fb-9953-c15ece2a21a5",
                "word": "mollusque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2473f961-0961-4a74-844b-113a56f26e29",
                        "entry_id": "15cde4df-82d8-32fb-9953-c15ece2a21a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "mollusques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52f65e7e-8249-31d7-bc80-08809908c316",
                        "entry_id": "15cde4df-82d8-32fb-9953-c15ece2a21a5",
                        "glosses": [
                            "Animal invertébré à corps mou, appartenant à l’embranchement des mollusques ou Mollusca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2cc8032-14d1-424f-9ef0-3be08bf8c1e9",
                                "sense_id": "52f65e7e-8249-31d7-bc80-08809908c316",
                                "text": "Le mollusque par excellence qui distille la perle, c’est l’huître perlière, la méléagrine margaritifera la précieuse pintadine."
                            },
                            {
                                "example_id": "79a1ce8b-5771-4d7a-b4a1-a0977ea27cf1",
                                "sense_id": "52f65e7e-8249-31d7-bc80-08809908c316",
                                "text": "À cette place, la grève était couverte de mollusques comestibles, qui furent recueillis et mangés crus ou cuits, suivant l’espèce."
                            },
                            {
                                "example_id": "604b16f4-d6cc-4f03-8179-f27db7227f1f",
                                "sense_id": "52f65e7e-8249-31d7-bc80-08809908c316",
                                "text": "La voûte des petites cavernes formées par l'entassement des rochers était revêtue d’une couche mamelonnée d’ascidies simples, espèces de mollusques qui vivent et meurent sans changer de place."
                            },
                            {
                                "example_id": "bebfb68e-d79e-42fe-a153-552ae6de08c1",
                                "sense_id": "52f65e7e-8249-31d7-bc80-08809908c316",
                                "text": "Parmi les mollusques, rappelons que l'un d'eux fournit l'onyx qui était utilisé comme parfum dans l'antiquité."
                            },
                            {
                                "example_id": "481a8a55-bc63-422c-acf0-cf1ff691fa71",
                                "sense_id": "52f65e7e-8249-31d7-bc80-08809908c316",
                                "text": "De l'œuf sort une larve nageante, le miracidium, qui pénètre dans un mollusque gastéropode d’eau douce."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1a9f348-c9fa-3472-a00e-53b16cb0f0aa",
                        "entry_id": "15cde4df-82d8-32fb-9953-c15ece2a21a5",
                        "glosses": [
                            "Personne molle."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9b4f77e5-9782-49a5-b0a9-5134c2f8eff1",
                                "sense_id": "c1a9f348-c9fa-3472-a00e-53b16cb0f0aa",
                                "text": "Tu oses me reprendre en défendant des gens que je méprise : moi, je te trouve mou, triste mollusque!"
                            },
                            {
                                "example_id": "0cc02d67-8580-4828-9e7d-cb2f5fa0b9c5",
                                "sense_id": "c1a9f348-c9fa-3472-a00e-53b16cb0f0aa",
                                "text": "Vous êtes plutôt des mollusques, des invertébrés, des protozoaires, des machins tout mous, sans squelette et sans coquilles, dégueulassement gluants et visqueux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4bd370b-f1af-457a-8a5e-23b27ccd2dfd",
                        "source_entry_id": "15cde4df-82d8-32fb-9953-c15ece2a21a5",
                        "source_sense_description": "Animal au corps mou",
                        "target_lang_word": "Weichtier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weichtier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1307efd-f005-3cc3-9073-e004135c1953",
                                        "entry_id": "2db2601a-d33d-3fe6-bd1c-ebb225333430",
                                        "glosses": [
                                            "ein zum Tierstamm Mollusca gehörendes, wirbelloses Tier ohne Knochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b0915f-38f8-4bae-8aef-c30f58d13899",
                                                "sense_id": "d1307efd-f005-3cc3-9073-e004135c1953",
                                                "text": "Der Kopf der Weichtiere trägt häufig hochentwickelte Augen."
                                            },
                                            {
                                                "example_id": "8f185b4b-2aa5-4cab-9474-d67a6968cdba",
                                                "sense_id": "d1307efd-f005-3cc3-9073-e004135c1953",
                                                "text": "Bei vielen Weichtieren umgibt eine schützende Schale den Weichkörper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22640ef2-356f-4e62-944e-dd543fdf4270",
                        "source_entry_id": "15cde4df-82d8-32fb-9953-c15ece2a21a5",
