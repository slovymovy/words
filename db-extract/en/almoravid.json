                        ],
                        "examples": [
                            {
                                "example_id": "de5a28f3-825d-41a7-8f7d-05e50b7be38c",
                                "sense_id": "d695c9e7-e527-33a7-b6bc-377f5d8d0843",
                                "text": "The Almoravid army was a strange rabble of Arabs, Berbers, blacks, wild tribes of the Sahara and Christian mercenaries. They conquered the Spanish forces, and Youssef left to his successors an empire extending from the Ebro to Senegal and from the Atlantic coast of Africa to the borders of Tunisia."
                            }
                        ]
