                        "glosses": [
                            "Of or relating to classical physics that does not take relativity into account."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10324cfb-0a66-3cf4-bbaf-3a11e274ebbf",
