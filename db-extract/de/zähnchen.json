                ],
                "senses": [
                    {
                        "sense_id": "62755313-0b49-3b30-b482-42ada3efbf48",
                        "entry_id": "c7393a5f-498a-3eb5-a47d-5640cd70fd1a",
                        "glosses": [
                            "Teil des Gebisses von Menschen und Wirbeltieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d315a51-1cdd-432e-b6b4-986173b2900e",
                                "sense_id": "62755313-0b49-3b30-b482-42ada3efbf48",
                                "text": "Sobald das erste Zähnchen durchgebrochen ist, sollte dies geputzt werden."
                            },
                            {
                                "example_id": "8bc3c97b-779b-4012-b1c2-88c84135da6f",
                                "sense_id": "62755313-0b49-3b30-b482-42ada3efbf48",
                                "text": "Für die ausgefallenen Zähnchen will das zur „Milchzahnfee“ ernannte Feenmädchen den Kindern ein Täschchen schenken, das sie unter ihr Kopfkissen legen. Anstelle des Zahns liegt dann am Morgen eine Überraschung bereit."
                            },
                            {
                                "example_id": "37fe4fa8-2d6a-4546-95ca-96c33e22f950",
                                "sense_id": "62755313-0b49-3b30-b482-42ada3efbf48",
                                "text": "Sowohl auf dem Rande des Zwischenkieferbeines als des Unterkiefers stehen zahlreiche gleichartige kegelförmige, etwas zurückgeneigte Zähnchen und auf dem äußerm Rande der beiden Vomer eine andere einfache Reihe von Zähnen (also der Länge nach wie die Zähne des Wassermolches), welche sich zwischen die des Zwischenkieferbeines hinziehen."
                            },
                            {
                                "example_id": "bfed83e5-6780-457d-a8bf-8cb6de012045",
                                "sense_id": "62755313-0b49-3b30-b482-42ada3efbf48",
                                "text": "„Mit Beginn des Ersten Weltkriegs endete die Unbeschwertheit im Hause Schmidt – jäh riss der heitere, um Babygewicht, erste Zähnchen und Schrittchen kreisende Ton im Tagebuch der Familie ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6bf1c332-41de-351f-a857-e8a3a7808a0e",
                        "entry_id": "c7393a5f-498a-3eb5-a47d-5640cd70fd1a",
                        "glosses": [
                            "Teil des zahnähnlichen Gebildes auf der Haifischhaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f79cde-edb9-4268-af88-2ea3cf455202",
                                "sense_id": "6bf1c332-41de-351f-a857-e8a3a7808a0e",
                                "text": "Im nahen Besucherzentrum des Naturschutzgebietes „Het Zwin“ können sich Interessierte übrigens aufklären lassen, zu welcher Haiart die Zähnchen gehören."
                            },
                            {
                                "example_id": "6ea9c70a-5f32-4766-9b91-14c83f1461af",
                                "sense_id": "6bf1c332-41de-351f-a857-e8a3a7808a0e",
                                "text": "Er kann eigentlich nicht beißen, da er nur ganz kleine Zähnchen, wiewohl an 4000, besitzt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e9357de0-8d36-3bc7-aa57-c6fa5959a082",
                        "entry_id": "c7393a5f-498a-3eb5-a47d-5640cd70fd1a",
                        "glosses": [
                            "Zacke einer am Rand von Papier, Blättern oder anderen Gegenständen befindlichen Zahnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4571d59-99fe-426d-9668-3c78b8b0be10",
                                "sense_id": "e9357de0-8d36-3bc7-aa57-c6fa5959a082",
                                "text": "Das Messer schneidet nur dann vollkommen gut, wenn alle diese Zähnchen genau in derselben Ebene liegen."
                            },
                            {
                                "example_id": "6b3dfdd4-17f6-4c12-b42f-3cd9bc2a906a",
                                "sense_id": "e9357de0-8d36-3bc7-aa57-c6fa5959a082",
                                "text": "Die kleinen feinen Zähnchen der Säge entscheiden über den Erfolg beim Sägen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
