                "senses": [
                    {
                        "sense_id": "2d8ac9a5-3fc2-30ec-ba5a-9762846f128e",
                        "entry_id": "3e13cf95-7d8f-37d7-8234-80b22c1a5313",
                        "glosses": [
                            "Celui qui se transforme d’un être humain en une hyène et vice versa, de façon complète ou partielle."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "b3eca190-f51d-499e-b08b-be3c567fc5e7",
                                "sense_id": "2d8ac9a5-3fc2-30ec-ba5a-9762846f128e",
                                "text": "Il s’agit donc de déterminer, parmi tout ce qu’évoquent les notions de hyène-garou et de léopard chrétien, quels sont les éléments susceptibles d’être homologués ou, au contraire, opposés."
                            },
                            {
                                "example_id": "41aaba4f-a887-4bc6-b8ef-8bf0d599c700",
                                "sense_id": "2d8ac9a5-3fc2-30ec-ba5a-9762846f128e",
                                "text": "Forcément il y en a. Peut-être des hyènes-garous, des chacals-garous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
