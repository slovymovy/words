                "senses": [
                    {
                        "sense_id": "8fbb7209-2483-3d5a-9713-a44cc2c15e07",
                        "entry_id": "acbed573-ea84-3986-9849-38b709dc8874",
                        "glosses": [
                            "Werk aus ineinandergreifenden Regeln zur Vermeidung von Ansteckung/Verunreinigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5e26d1-b926-4e4b-a1d4-be2be073871d",
                                "sense_id": "8fbb7209-2483-3d5a-9713-a44cc2c15e07",
                                "text": "„Somit soll dem größtmöglichen Schutz zur Verhinderung einer Weiterverbreitung von SARS-Cov-2 und COVID-19 Rechnung getragen werden. Auf dieser Grundlage und anderen Regelwerken ist ein eigenes schriftliches Hygienekonzept zu erstellen und umzusetzten [sic].“"
                            },
                            {
                                "example_id": "31f05025-f80a-4982-9aca-e29920069c17",
                                "sense_id": "8fbb7209-2483-3d5a-9713-a44cc2c15e07",
                                "text": "„Komplettiert wird ein ganzheitliches, gebäudespezifisches Hygienekonzept schließlich neben der anlagenspezifischen Beprobung und Absicherung von Einzelentnahmestellen durch eine intelligente Kombination von automatischen Spültechniken der Haupt- und Einzelzuleitungen in einer Trinkwasser-Installation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
