                "senses": [
                    {
                        "sense_id": "dca3729f-f0fe-3cb6-9d81-e0ce5fa98c24",
                        "entry_id": "eb670775-8c42-3782-83ce-1afe2e2b0f4f",
                        "glosses": [
                            "weibliche Person, die zivilrechtlich vor Gericht eine Klage führt"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "fdfefda7-3f05-4379-a141-6ef312508bf3",
                                "sense_id": "dca3729f-f0fe-3cb6-9d81-e0ce5fa98c24",
                                "text": "Gegen den Beschluss kann die Klägerin innerhalb von zwei Wochen Beschwerde einlegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a6b513d-527f-3f45-8ab4-d0a45c5021d6",
                        "entry_id": "eb670775-8c42-3782-83ce-1afe2e2b0f4f",
                        "glosses": [
                            "weibliche Person, die über irgendetwas klagt oder um jemanden/etwas trauert"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7614adca-e0a9-4c7e-a05b-a044c05592fb",
                                "sense_id": "6a6b513d-527f-3f45-8ab4-d0a45c5021d6",
                                "text": "Bei der Beerdigung des alten Ratsherren ging die Klägerin als erste hinter seinem Sarg."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
