                        "source_sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                        "source_sense_description": "die Art und Weise, zu reden/sprechen",
                        "target_lang_word": "manière de parler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manière de parler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "149a75e6-c366-393d-a1d6-0bae2074bb6e",
                                        "entry_id": "205c1c57-87c0-38ca-85c8-a399c9bbb80d",
                                        "glosses": [
                                            "Façon de parler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b94c663-acb1-4ea4-9340-762247baa0d7",
                                                "sense_id": "149a75e6-c366-393d-a1d6-0bae2074bb6e",
                                                "text": "Cette manière de parler est incorrecte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40707480-55ac-3d51-b10a-fd4db339a0ba",
                                        "entry_id": "205c1c57-87c0-38ca-85c8-a399c9bbb80d",
                                        "glosses": [
                                            "Expression, locution"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76422af-61ad-4ba2-88e3-e006e2e2e8c9",
                                                "sense_id": "40707480-55ac-3d51-b10a-fd4db339a0ba",
                                                "text": "Il a des manières de parler qui lui sont particulières, qui n’appartiennent qu’à lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad10ccdf-0a95-3cf6-b476-f882bef89cf7",
                                        "entry_id": "205c1c57-87c0-38ca-85c8-a399c9bbb80d",
                                        "glosses": [
                                            "Chose dite sans conséquence, ou avec une exagération sensible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18320ee4-6012-4540-ae16-209419a9de0b",
                                                "sense_id": "ad10ccdf-0a95-3cf6-b476-f882bef89cf7",
                                                "text": "– À quelle grossesse difficile faisais-tu allusion, ma chérie ?\n– À aucune en particulier, Louis, c'est manière de parler, tu vois ce que veux dire…"
                                            },
                                            {
                                                "example_id": "45d7d599-f2a6-4077-a226-cdbadf9c6281",
                                                "sense_id": "ad10ccdf-0a95-3cf6-b476-f882bef89cf7",
                                                "text": "Il m’a offert sa bourse, mais c’était une manière de parler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "094a3f0a-176d-418c-89b2-16fe0063b4a2",
                        "source_entry_id": "44e9d080-ce75-321b-b03a-cdfc4230bb52",
                        "source_sense_id": "f6a420d0-0ae7-3987-8ca2-de95d99de982",
                        "source_sense_description": "die Art und Weise, zu reden/sprechen",
                        "target_lang_word": "élocution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élocution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a91ca37b-01fd-36cc-b14d-7869129326ec",
                                        "entry_id": "ea3b3c7d-addc-380e-ab57-2c493edfcf0b",
                                        "glosses": [
                                            "Manière dont les sons sont exprimés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc728e9-2bb4-4610-93b4-7540358a361d",
                                                "sense_id": "a91ca37b-01fd-36cc-b14d-7869129326ec",
                                                "text": "Les mots se bousculaient dans sa bouche, il s'attardait sur une syllabe, en avalait une autre, laissait la suivante en suspens, et imitait si bien l'élocution saccadée de certains Anglo-Saxons qu'on finissait par se demander s'il parlait français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739f5ec7-721c-3b82-992c-01ea65a8f967",
                                        "entry_id": "ea3b3c7d-addc-380e-ab57-2c493edfcf0b",
                                        "glosses": [
                                            "Manière de choisir et d'arranger les mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43e02e1-0610-400e-9096-496c4011bfe8",
                                                "sense_id": "739f5ec7-721c-3b82-992c-01ea65a8f967",
                                                "text": "Élocution nette, facile, élégante. - Une élocution embarrassée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18184d70-a515-3efc-ad46-3ffe3376f08d",
                                        "entry_id": "ea3b3c7d-addc-380e-ab57-2c493edfcf0b",
                                        "glosses": [
                                            "Celle des trois parties de la rhétorique qui a pour objet le choix et l’arrangement des mots."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63fde0d1-fa5e-32a6-852b-1f9ec3c4860b",
                                        "entry_id": "ea3b3c7d-addc-380e-ab57-2c493edfcf0b",
                                        "glosses": [
                                            "certaines figures, dites microstructurales : répétition, paronomase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95ca6733-7741-36f4-8a53-1a02c7dd8865",
                                        "entry_id": "ea3b3c7d-addc-380e-ab57-2c493edfcf0b",
