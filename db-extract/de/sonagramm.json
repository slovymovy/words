                "senses": [
                    {
                        "sense_id": "893a940d-e7ed-3b77-9fc2-e86c8ff177ea",
                        "entry_id": "e284c92a-1ad9-3fd3-97f8-87d1cab540c6",
                        "glosses": [
                            "Spektrogramm, das die Zeit in Millisekunden (ms) auf der x-Achse, die Frequenz in Hertz (Hz) auf der y-Achse und die Amplitude durch Schwärzung darstellt"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "6b7f8855-6fb2-402c-ad11-9ca0e176ec4b",
                                "sense_id": "893a940d-e7ed-3b77-9fc2-e86c8ff177ea",
                                "text": "„Die Formanten werden in der Regel von einem Sonagramm abgelesen, das drei Variablen vertritt, nämlich Zeit, Frequenz und Amplitude.“"
                            },
                            {
                                "example_id": "9e4c95cb-a968-4455-8c05-92f04f893966",
                                "sense_id": "893a940d-e7ed-3b77-9fc2-e86c8ff177ea",
                                "text": "„Aus einem Sonagramm, das die akustischen Eigenschaften der Laute abbildet, kann man nun die physikalischen Merkmale der Laute entnehmen und die Laute nach diesen Merkmalen klassifizieren…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
