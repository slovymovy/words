                        "form": "headcounts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebac5d25-f2fc-36ac-b5a0-ed1a99d81e0c",
                        "entry_id": "a8c7726f-a224-3983-9a04-5b3568859fef",
                        "glosses": [
                            "The act of counting how many people are present in a group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1e9a6d-3065-408f-9cb1-96cf1ab46722",
                                "sense_id": "ebac5d25-f2fc-36ac-b5a0-ed1a99d81e0c",
                                "text": "Let's take a quick headcount, to make sure we're all here."
                            },
                            {
                                "example_id": "c1e9e9f1-1d97-4275-b54e-b3a2b552f740",
                                "sense_id": "ebac5d25-f2fc-36ac-b5a0-ed1a99d81e0c",
                                "text": "Population 39,693 (just north of 115,000 today), Cheltenham has been overtaken by Gloucester in terms of headcount."
                            }
                        ]
                    },
                    {
                        "sense_id": "39cd16a3-0e62-3bfd-a5f6-a68d0f89250b",
                        "entry_id": "a8c7726f-a224-3983-9a04-5b3568859fef",
                        "glosses": [
                            "The number of people present in a group or employed by a company."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "239bb9b0-660d-4fe2-bfa3-21065481fd97",
                                "sense_id": "39cd16a3-0e62-3bfd-a5f6-a68d0f89250b",
                                "text": "The last headcount data for BTP is from December 2022, when the number of BTP officers was 3,183, up from 3,175 in April 2022."
                            },
                            {
                                "example_id": "75f5a991-c26c-47dd-8c39-012329916a47",
                                "sense_id": "39cd16a3-0e62-3bfd-a5f6-a68d0f89250b",
                                "text": "The company's headcount on January 1 was 15,203."
                            }
                        ]
                    },
                    {
                        "sense_id": "35c2ebd0-ab2b-36db-8c6e-35a43a04aadf",
                        "entry_id": "a8c7726f-a224-3983-9a04-5b3568859fef",
                        "glosses": [
                            "More generally, a consideration of a company's appropriate staffing level based on some larger context. (Generally used adjectivally.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44252fe7-122c-4279-afc4-a33aab01cd59",
                                "sense_id": "35c2ebd0-ab2b-36db-8c6e-35a43a04aadf",
                                "text": "Due to economic difficulties, the company will be making headcount adjustments."
                            }
                        ]
                    },
                    {
                        "sense_id": "9154c368-a74c-3bea-bd27-0a2b04a61308",
                        "entry_id": "a8c7726f-a224-3983-9a04-5b3568859fef",
                        "glosses": [
                            "By extension, one slot in a workgroup, filled or to be filled by one person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0304943-b4a6-48d3-8df3-bb57312cd913",
                                "sense_id": "9154c368-a74c-3bea-bd27-0a2b04a61308",
                                "text": "I've convinced management to give us one more headcount, to take some work off the rest of us."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
