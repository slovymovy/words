                "senses": [
                    {
                        "sense_id": "7b8f8053-9caf-3dc3-8748-47ccc742b19a",
                        "entry_id": "f652c9ba-5ec7-3222-bb03-f60815842ad6",
                        "glosses": [
                            "Condescendre, daigner."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "30fb2dff-81ed-4840-a738-7fb16f68303e",
                                "sense_id": "7b8f8053-9caf-3dc3-8748-47ccc742b19a",
                                "text": "Я звал тебя, но ты не оглянулась. Я слезы лил, но ты не снизошла. : Je t’ai appelée, mais tu n’as pas regardé en arrière. J’ai versé des larmes, mais tu n’as pas daigné [y répondre]."
                            },
                            {
                                "example_id": "1c2c3f0f-3147-4b74-ac54-ff8672c677ec",
                                "sense_id": "7b8f8053-9caf-3dc3-8748-47ccc742b19a",
                                "text": "Снизойти к просьбе : Acquiescer (ou déférer) à une prière."
                            }
                        ]
                    }
                ],
