                            }
                        },
                        {
                            "text": "The doctor's perfunctory <w>prodding</w> and poking made the patient feel uncomfortable.",
                            "target_lang_translations": {
                                "de": "Das oberflächliche <w>Herumtasten</w> und Drücken des Arztes war dem Patienten unangenehm."
                            }
