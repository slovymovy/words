                                "example_id": "eca86ea8-93e8-4940-b6a1-84552d928200",
                                "sense_id": "055672bc-3eda-3b0b-92f2-073c493529e6",
                                "text": "Au cours de cette longue période, les pools géniques de ces deux groupes auraient divergé."
                            },
                            {
                                "example_id": "0c7b919d-eb9b-4d73-bdc7-4ca16dbe9f3b",
                                "sense_id": "055672bc-3eda-3b0b-92f2-073c493529e6",
                                "text": "On pourrait donc envisager le développement de thérapies géniques ou de médicaments qui empêcheraient les enzymes de s'attaquer aux sucres."
                            },
                            {
                                "example_id": "cbb0dd7c-d501-481f-ba3f-7cfc7e0208c1",
                                "sense_id": "055672bc-3eda-3b0b-92f2-073c493529e6",
                                "text": "Selon l'AFM-Téléthon, trois autres essais de thérapie génique dans la myopathie de Duchenne sont actuellement en cours au niveau national aux États-Unis."
                            }
                        ]
