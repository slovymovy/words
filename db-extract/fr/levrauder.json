                "senses": [
                    {
                        "sense_id": "565111ee-c5b3-350a-a352-aba055a82a17",
                        "entry_id": "43dfe14f-5c26-3099-acad-0faa79c779fe",
                        "glosses": [
                            "Poursuivre quelqu’un comme un lièvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed66498-b58b-4387-8245-881ff44ee61d",
                                "sense_id": "565111ee-c5b3-350a-a352-aba055a82a17",
                                "text": "Je crois qu’il vaut mieux bâtir un beau château, comme a fait M. de Voltaire, y jouer la comédie, y faire bonne chère, que d’être levraudé à Paris, comme Helvétius, par les gens tenant la cour du parlement."
                            },
                            {
                                "example_id": "d99f0ded-b008-4db9-b3f1-323bf221d332",
                                "sense_id": "565111ee-c5b3-350a-a352-aba055a82a17",
                                "text": "Il est un peu extraordinaire qu’on ait harcelé, honni, levraudé un philosophe de nos jours très estimable, l’innocent, le bon Helvétius, pour avoir dit que, si les hommes n’avaient pas des mains, ils n’auraient pu bâtir des maisons et travailler en tapisserie de haute lice."
                            }
                        ]
                    }
                ],
