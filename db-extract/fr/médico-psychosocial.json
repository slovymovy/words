                        "glosses": [
                            "Qui a des aspects médicaux, psychologiques et sociaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ee9b682-a9ae-4f8f-bec8-910a87be7abb",
                                "sense_id": "19ea8e75-783d-370a-aefd-0b524ce5f380",
                                "text": "L’équipe médico-psychosociale réalise un bilan visant à favoriser le maintien à domicile de l’adhérent et préserver sa qualité de vie."
                            },
                            {
                                "example_id": "b9416342-2c0b-49a2-9f4a-a2432dae8510",
                                "sense_id": "19ea8e75-783d-370a-aefd-0b524ce5f380",
                                "text": "Il est certainement plus aisé de réunir des énergies et de regrouper des moyens en vue d’intérêts industriels et économiques que de composer un collectif médico-psychosocial."
                            },
                            {
                                "example_id": "3a320bc0-956e-4f45-b04a-814602f1405c",
                                "sense_id": "19ea8e75-783d-370a-aefd-0b524ce5f380",
                                "text": "C’est là que les sciences que l’on peut dénommer « médico-psychosociales » vont trouver à s’employer en produisant des clés de compréhension du phénomène."
                            }
                        ]
