                                "target_senses": [
                                    {
                                        "sense_id": "cf279c0b-1bc6-364f-914d-9e23b510fce1",
                                        "entry_id": "fdde3887-b855-3d6d-ae36-78ed2178838d",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 49 et de symbole In, qui fait partie de la série des métaux pauvres."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77637b3a-e075-46c0-88f7-657e283c9d39",
                                                "sense_id": "cf279c0b-1bc6-364f-914d-9e23b510fce1",
                                                "text": "En effet, l’argent des mines de Potosi contient un élément trace caractéristique, l’Indium qui n’existe pas significativement dans l’argent européen, qui peut être tracé dans le monnayage européen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4c6510-6c8e-3a5e-b26e-701140ea2986",
                                        "entry_id": "fdde3887-b855-3d6d-ae36-78ed2178838d",
                                        "glosses": [
                                            "Corps simple; métal gris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e722e5-d378-47d6-864f-009d4e515a0e",
                                                "sense_id": "6a4c6510-6c8e-3a5e-b26e-701140ea2986",
                                                "text": "Découvert par Reich et Richter, l’indium est un métal argenté très mou."
                                            },
                                            {
                                                "example_id": "198b6ddd-f161-439c-a753-94cf3f703771",
                                                "sense_id": "6a4c6510-6c8e-3a5e-b26e-701140ea2986",
                                                "text": "Pour produire cette quantité, le secteur électrique et électronique consomme 12 % de la demande mondiale d’or, 30 % de l’argent, 30 % du cuivre, et jusqu’à 80 % de métaux rares comme le ruthénium ou l’indium, dont l’extraction et l’affinage provoquent d’importants dégâts environnementaux."
                                            },
                                            {
                                                "example_id": "844c44eb-1c8a-44ba-8e3b-70aec328638b",
                                                "sense_id": "6a4c6510-6c8e-3a5e-b26e-701140ea2986",
                                                "text": "L’indium est par exemple essentiellement extrait du minerai de zinc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
