                "senses": [
                    {
                        "sense_id": "3f2b2dd7-a0a4-3f0a-8450-adcb92ee5102",
                        "entry_id": "18c6b40c-2135-3928-b3ca-5a0a43594c41",
                        "glosses": [
                            "der Versuch, einen Mord zu begehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88beda97-a8b8-4e87-9c47-13c92b631a33",
                                "sense_id": "3f2b2dd7-a0a4-3f0a-8450-adcb92ee5102",
                                "text": "Der Sohn der alten Frau wurde wegen eines Mordversuchs an seiner Mutter angeklagt."
                            },
                            {
                                "example_id": "b8b24d59-111e-4369-bd0e-e1ab8f377aff",
                                "sense_id": "3f2b2dd7-a0a4-3f0a-8450-adcb92ee5102",
                                "text": "„Damals hatte ich auch noch die landläufige Auffassung von Geisteskrankheiten und stellte mir darunter dauernde Tobsuchtsanfälle, Mordversuche und lallende Idioten vor – um so überraschender hob sich Geneviève davon ab.“"
                            },
                            {
                                "example_id": "705fd5ef-19e5-4239-8500-233ca085b483",
                                "sense_id": "3f2b2dd7-a0a4-3f0a-8450-adcb92ee5102",
                                "text": "„Nur einen Monat zuvor war der als ZANU-Führer abgesetzte Sithole erneut verhaftet worden und wurde wegen Mordversuchen angeklagt, während das Attentat auf Chitepo gerade zwei Wochen zurücklag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
