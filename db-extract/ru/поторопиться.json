                "translations": [
                    {
                        "translation_id": "e605f14e-3cba-4cdf-be09-56ee15b7b24e",
                        "source_entry_id": "877a5d0e-c081-3162-8aef-d69e140e4d2a",
                        "target_lang_word": "hurry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c19ecf87-9af5-31e0-ba39-5c60d15cb50a",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "Rushed action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7eb7bb7-490a-4fd1-86f9-69391a4adb76",
                                                "sense_id": "c19ecf87-9af5-31e0-ba39-5c60d15cb50a",
                                                "text": "Why are you in such a big hurry?"
                                            },
                                            {
                                                "example_id": "e867b160-2b73-43a9-846e-d61fd56cab05",
                                                "sense_id": "c19ecf87-9af5-31e0-ba39-5c60d15cb50a",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d4a50e1-72e6-3ad5-9c8d-1e728d0270e6",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "Urgency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c207cb2-8d0e-47e5-bd17-9d95af513050",
                                                "sense_id": "9d4a50e1-72e6-3ad5-9c8d-1e728d0270e6",
                                                "text": "There is no hurry on that paperwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7602324-7f58-38aa-9472-75a08233e07e",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "an incidence of a defensive player forcing the quarterback to act faster than the quarterback was prepared to, resulting in a failed offensive play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed3e9c4-9a0d-4084-b370-580b57bf7550",
                                                "sense_id": "f7602324-7f58-38aa-9472-75a08233e07e",
                                                "text": "At Alabama, Jedrick Wills Jr. anchored the right side of the offensive line for two years, allowing only one sack and three-and-a-half quarterback hurries on 714 snaps last season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6157a40-732c-32b6-88e3-4bdbd13fac52",
                                        "entry_id": "3b2116f7-140c-33ec-805f-5e80b32aeb15",
                                        "glosses": [
                                            "A tremolando passage for violins, etc., accompanying an exciting situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hurry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To do things quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964d400e-286c-4a2e-9f54-c4d9f64e10e8",
                                                "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                                "text": "He's hurrying because he's late."
                                            },
                                            {
                                                "example_id": "35c0e637-bbc7-4edb-affb-7665276b753c",
                                                "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            },
                                            {
                                                "example_id": "e959a9ad-3c32-4e09-aa27-3beab34da439",
                                                "sense_id": "ab801892-b7cb-37f2-a8d0-3986c84437e8",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa4efa0f-ac9a-3a98-bd59-a9614c87352b",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "Often with up, to speed up the rate of doing something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f67713b-85a6-4811-9ce8-a9dc9b6d661f",
                                                "sense_id": "aa4efa0f-ac9a-3a98-bd59-a9614c87352b",
                                                "text": "If you don't hurry (up) you won't finish on time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e75bcf0-8511-3e56-b74a-51e79542798d",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To cause to be done quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e33ce65-6b74-3c2d-a4f0-f74f336b83b8",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To hasten; to impel to greater speed; to urge on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068434b1-5182-4c9e-acc1-8d6fa34025eb",
                                                "sense_id": "9e33ce65-6b74-3c2d-a4f0-f74f336b83b8",
                                                "text": "the rapid Stream presently draws him in , carries him away , and hurries him down violently."
                                            },
                                            {
                                                "example_id": "a6b6dcc2-c782-4ac0-a896-cd0c1e5546cb",
                                                "sense_id": "9e33ce65-6b74-3c2d-a4f0-f74f336b83b8",
                                                "text": "They hurried him aboard a bark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afad6877-8398-3a1f-bc10-010cf3155894",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To impel to precipitate or thoughtless action; to urge to confused or irregular activity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1c2c33-8542-48ec-852a-fee277d68166",
                                                "sense_id": "afad6877-8398-3a1f-bc10-010cf3155894",
                                                "text": "And wild amazement hurries up and down / The little number of your doubtful friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0844210-531b-3f98-97a2-13a15b9c4415",
                                        "entry_id": "65de08fc-48e1-3f45-84c2-c9673477afa5",
                                        "glosses": [
                                            "To put: to convey coal in the mine, e.g. from the working to the tramway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee2bf58-5b7a-4f07-9eb0-1eb3b7d314a3",
                                                "sense_id": "b0844210-531b-3f98-97a2-13a15b9c4415",
                                                "text": "Elizabeth Day, aged seventeen […] \"I have been nearly nine years in the pit. I trapped for two years when I first went, and have hurried ever since. I have hurried for my father until a year ago. I have to help to riddle and fill, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc7703b9-6cf0-4b45-bf4a-a113ed4e7e06",
                        "source_entry_id": "877a5d0e-c081-3162-8aef-d69e140e4d2a",
                        "target_lang_word": "hasten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hasten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2076f51a-9a18-322c-8a40-b26f315c9c57",
                                        "entry_id": "482201c9-aabf-34b7-b0b0-0da0cc11c89f",
                                        "glosses": [
                                            "To move or act in a quick fashion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c38879e4-9863-3dc0-9e35-61018108de1f",
                                        "entry_id": "482201c9-aabf-34b7-b0b0-0da0cc11c89f",
                                        "glosses": [
                                            "To make someone speed up or make something happen quicker."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441398f3-4f88-414c-917d-bcaa7642ca55",
                                                "sense_id": "c38879e4-9863-3dc0-9e35-61018108de1f",
                                                "text": "I would hasten my escape from the windy storm."
                                            },
                                            {
                                                "example_id": "7761e2bf-4a33-4d6f-8ab5-905907d36268",
                                                "sense_id": "c38879e4-9863-3dc0-9e35-61018108de1f",
                                                "text": "Hamlet:\nBid the players make haste.\nWill you two help to hasten them?"
                                            },
                                            {
                                                "example_id": "fb11cb65-16dd-4d59-a3d8-8267b9cf617b",
                                                "sense_id": "c38879e4-9863-3dc0-9e35-61018108de1f",
                                                "text": "A dearth of signalmen and the high cost of labour is hastening an elimination process that already was well under way before the second world war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30132e3c-9c3a-3c80-bc34-6cced42fc94b",
                                        "entry_id": "482201c9-aabf-34b7-b0b0-0da0cc11c89f",
                                        "glosses": [
                                            "To cause some scheduled event to happen earlier."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfdd501d-d68f-4c74-8896-30756fb9e184",
                                                "sense_id": "30132e3c-9c3a-3c80-bc34-6cced42fc94b",
                                                "text": "The decision to hasten completion of the electrification of London Midland Region main lines from Euston to the north and the subsequent diversion of some traffic to the Western Region in order to allow the engineers fuller track occupation, have focused attention on the two main routes between London, Birmingham and Wolverhampton."
                                            },
                                            {
                                                "example_id": "ff7153fb-c8fb-4708-9985-f404ec0d070b",
                                                "sense_id": "30132e3c-9c3a-3c80-bc34-6cced42fc94b",
                                                "text": "[…]and prescribed policies and packages of military, economic and technical assistance to hasten their inevitable march toward development and modernity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
