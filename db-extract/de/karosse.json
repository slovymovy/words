                    {
                        "sense_id": "8fc1b4b6-3261-35e4-a859-a220b774f4a3",
                        "entry_id": "0e3d3102-3b9f-3153-9352-2191d94cff1f",
                        "glosses": [
                            "Carrosse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4aec49a-57d7-43ce-b127-d3df518b4e90",
                                "sense_id": "8fc1b4b6-3261-35e4-a859-a220b774f4a3",
                                "text": "Die Karosse hatte den Status eines fahrenden Thrones. - Le carrosse avait le statut d’un trône ambulant."
                            }
                        ]
                    },
                    {
                        "sense_id": "7eefb46e-dacf-36a8-8e05-ea59a68ff5e8",
                        "entry_id": "0e3d3102-3b9f-3153-9352-2191d94cff1f",
                        "glosses": [
                            "Véhicule de luxe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1a662588-4e14-4769-9eb7-b46223b3e993",
                                "sense_id": "7eefb46e-dacf-36a8-8e05-ea59a68ff5e8",
                                "text": "Cadillac, DER Autotraum aus Amerika: gewaltige Karossen mit bullenstarken Motoren. (Bild, 07.03.2006) - Cadillac, LE rêve américain de la voiture : limousines impressionnantes, moteurs surpuissants."
                            },
                            {
                                "example_id": "70a445a6-5f38-47fd-8a19-0ab642cc50d1",
                                "sense_id": "7eefb46e-dacf-36a8-8e05-ea59a68ff5e8",
                                "text": "Die Gäste des Grand Hotels entstiegen ihren noblen Karossen. - Les clients du Grand Hôtel descendaient de leurs limousines de luxe."
                            }
                        ]
                    }
