                "senses": [
                    {
                        "sense_id": "e5001b39-2505-33e4-8807-dfc0982eba55",
                        "entry_id": "5ce3542b-884c-345e-b7f0-86393ae30b0a",
                        "glosses": [
                            "Unterkunft einer Studentin/eines Studenten außerhalb des Elternhauses am Studienort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee0f63d-f5c3-4884-a2c8-b7bd4ab13336",
                                "sense_id": "e5001b39-2505-33e4-8807-dfc0982eba55",
                                "text": "Zu Beginn eines jeden Semesters sind Studentenbuden sehr gefragt."
                            },
                            {
                                "example_id": "2997f464-c4dd-46bb-8a0f-3fcc47136639",
                                "sense_id": "e5001b39-2505-33e4-8807-dfc0982eba55",
                                "text": "„Jeder Gegenstand dieser durchschnittlichen Studentenbude, weder besonders unordentlich noch adrett, schlecht beheizt und schlecht gelüftet, schien mir bedeutsam.“"
                            },
                            {
                                "example_id": "d57b863e-0b5b-43cf-b46f-9777e8363e5b",
                                "sense_id": "e5001b39-2505-33e4-8807-dfc0982eba55",
                                "text": "„Aber leider hatte der Sohn sich nicht nur mit Wissenschaft die Zeit vertrieben, sondern darüber hinaus auch mit der Tochter des Ehepaares, in deren Wohnung er seine Studentenbude hatte, zärtliche Beziehungen angeknüpft – Beziehungen, die nicht ohne die bekannten Folgen zu bleiben drohten.“"
                            },
                            {
                                "example_id": "7238faa1-821c-4ead-81c3-aedac7db7fae",
                                "sense_id": "e5001b39-2505-33e4-8807-dfc0982eba55",
                                "text": "„Als ich studierte, hatten die Studentenbuden meist noch kein fließendes Wasser, und Wirtsleute nahmen nicht gerne Studentinnen, weil die, wie sie sagten, ihre Nylonwäsche ins Badezimmer hängen würden.“"
                            }
                        ],
