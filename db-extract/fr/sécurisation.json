                                        "sense_id": "ce11add4-c119-3b2b-9d81-6ca98494d46d",
                                        "entry_id": "7d5f61ce-b616-3b43-aecb-a1c3c3792789",
                                        "glosses": [
                                            "de genomen maatregelen die er zo goed mogelijk voor zorgen dat er niets verkeerds gebeurt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd92d6f-815c-4b06-8b54-7d84840cdc9a",
                                                "sense_id": "ce11add4-c119-3b2b-9d81-6ca98494d46d",
                                                "text": "De beveiliging van het bedrijfspand was door een gespecialiseerd bedrijf ingericht."
                                            },
                                            {
                                                "example_id": "bdff15a9-d4c8-4cfd-896d-984ba2805d6c",
                                                "sense_id": "ce11add4-c119-3b2b-9d81-6ca98494d46d",
                                                "text": "\"De bagageafhandelingsbedrijven en de luchtvaartmaatschappijen die zorg dragen voor deze processen hebben net als wij bij de beveiliging te maken met personeelstekorten\", zegt een woordvoerder van Schiphol desgevraagd. Daardoor zijn passagiers en de koffers niet meer op hetzelfde moment op dezelfde plek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
