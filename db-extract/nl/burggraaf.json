                                        "entry_id": "b4a98257-c707-3adf-a8fb-10a21095a30c",
                                        "glosses": [
                                            "Befehlshaber einer Burg aus dem niederen Adel mit administrativen und militärischen Rechten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd70d302-a353-407c-997c-2904421965d5",
                                                "sense_id": "8b1b7232-37c5-3c09-a12b-bc916bf62dfb",
                                                "text": "„Möglicherweise hat bereits König Konrad III. nach dem Tode des Wendenfürsten zur Wahrung der Rechte des Reiches einen Burggrafen eingesetzt.“"
                                            },
                                            {
                                                "example_id": "dcc6699b-2eb8-4feb-965b-dc959e8d5c51",
                                                "sense_id": "8b1b7232-37c5-3c09-a12b-bc916bf62dfb",
                                                "text": "„Er erhielt seinen Namen nach den Wildgehegen, die einer der Burggrafen vor Dürers Zeit im Stadtgraben unterhalten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
