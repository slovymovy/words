                "senses": [
                    {
                        "sense_id": "9516de1a-b413-3c07-93a8-a314c596471c",
                        "entry_id": "a0f3b09a-94b6-3993-830a-11e88c45bb02",
                        "glosses": [
                            "der Westerwälder"
                        ],
                        "tags": [
                            "koblenzisch"
                        ],
                        "examples": [
                            {
                                "example_id": "20b26639-5bef-4a27-9f03-2806abd6e6c9",
                                "sense_id": "9516de1a-b413-3c07-93a8-a314c596471c",
                                "text": "„Die Wäller hann de Kowelenzer am 20. April 1347 bei der sog. „Grenzhauer Fehd“ en ganz scheene Nidderlach beigebraacht.",
                                "translation": "Die Westerwälder haben den Koblenzern am 20. April 1347 bei der sogenannten „Grenzauer Fehde“ eine ganz schöne Niederlage beigebracht."
                            },
                            {
                                "example_id": "2a4e4b4d-4240-4b2b-af26-ba1d2d66ca64",
                                "sense_id": "9516de1a-b413-3c07-93a8-a314c596471c",
                                "text": "\"Die Geschichte geht den Wällern, den Leuten aus dem Westerwald, immer noch glatt ein, … Ist es vielleicht nichts, wenn man hört, dass da einmal ein >> Wäller Bou << (= Westerwälder Junge) war, der im zerschlissenen Wams die Kühe […] hütete und als >> Melander von Holzapfel, Generalfeldmarschall des Deutschen Kaiser << starb? Und soll man da nicht stolz werden, wenn […] sein Heimatbekenntnis wie ein Westerwälder Credo nachgesprochen wird: >> Ich bin ein Deutscher und dazu noch ein Westerwälder; das will soviel heißen wie zwei Deutsche! << \""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f0e36ede-9cd4-3750-8afa-1d869a443a14",
                        "entry_id": "a0f3b09a-94b6-3993-830a-11e88c45bb02",
                        "glosses": [
                            "eine Hunderasse, die um 1995 im Westerwald herausgezüchtet wurde"
                        ],
                        "tags": [
                            "abgeleitet von [1]"
                        ],
                        "examples": [
                            {
                                "example_id": "cdcedde9-4216-464b-8b25-c4c9dcfa6bed",
                                "sense_id": "f0e36ede-9cd4-3750-8afa-1d869a443a14",
                                "text": "\"Der Wäller besitzt die Eigenschaften eines Hütehundes, ist ein sensibler, ausdauernder, begeistert mit dem Menschen arbeitender, eifriger Sport- und Familienhund.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
