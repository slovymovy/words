                {
                    "sense_id": "27279db9-6755-3120-b30e-8d75eb0e087d",
                    "sense_definition": "Corresponding to something of lower dimension under a birational correspondence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician analyzed the properties of the <w>exceptional</w> curve.",
                            "target_lang_translations": {
                                "ru": "Математик проанализировал свойства <w>исключительной</w> кривой.",
                                "tr": "Matematikçi <w>istisnai</w> eğrinin özelliklerini analiz etti."
                            }
                        },
                        {
                            "text": "This advanced theory deals with <w>exceptional</w> divisors in geometry.",
                            "target_lang_translations": {
                                "ru": "Эта передовая теория имеет дело с <w>исключительными</w> дивизорами в геометрии.",
                                "tr": "Bu gelişmiş teori geometrideki <w>istisnai</w> bölenleri ele alır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (mathematics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий чему-либо меньшей размерности при бирациональном соответствии.",
                        "tr": "Bir birasyonel karşılık altında daha düşük boyutlu bir şeye karşılık gelen."
                    },
                    "translations": {
                        "ru": [
