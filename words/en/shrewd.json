                    "synonyms": [
                        "ominous",
                        "boding",
                        "ill-boding"
                    ],
                    "antonyms": [
                        "auspicious"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete meaning of boding ill"
