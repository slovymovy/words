                "senses": [
                    {
                        "sense_id": "f17e898d-8ea1-3f95-8909-4a6648c36f7d",
                        "entry_id": "aa5c7ac3-5b45-39a7-b599-1325083de7f2",
                        "glosses": [
                            "Zusatzzeile, die oberhalb der Hauptzeile angeordnet ist und ein kurzes Stichwort enthält, das die Meldung grob thematisch einordnet"
                        ],
                        "tags": [
                            "Journalismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9232e142-972d-49fd-b6c4-fe2f3f895c9d",
                                "sense_id": "f17e898d-8ea1-3f95-8909-4a6648c36f7d",
                                "text": "Die Überschrift kann neben der eigentlichen Überschrift (auch Schlagzeile oder Hauptzeile, meist fett gesetzt) eine Dachzeile und/oder eine Unterzeile beinhalten, die optisch weniger ins Auge fallen als die eigentliche Überschrift."
                            },
                            {
                                "example_id": "94af3080-e02e-40b0-ba11-4acc711aab90",
                                "sense_id": "f17e898d-8ea1-3f95-8909-4a6648c36f7d",
                                "text": "Ähnlich vage vermeldete die Nachrichtenagentur AFP am Montag \"Rocker Doherty stimmt bei Konzert erste Deutschlandlied-Strophe an\", liefert aber freundlicherweise in der Dachzeile einen Baukasten mit den Stichworten \"D/Musik/Leute/Nationalsozialismus\" — auf dass sich jede Redaktion ihren Skandal selber bastle."
                            }
                        ],
