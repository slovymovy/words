        "fr-extract.jsonl": [
            {
                "entry_id": "6f81e5f8-f27b-3aff-b319-0b601bbad046",
                "word": "fadeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d41b202e-3332-4ee3-a455-7c6619e16852",
                        "entry_id": "6f81e5f8-f27b-3aff-b319-0b601bbad046",
                        "tags": [
                            "plural"
                        ],
                        "form": "fadeurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5db400b0-d225-343a-97c5-698ae25981ef",
                        "entry_id": "6f81e5f8-f27b-3aff-b319-0b601bbad046",
                        "glosses": [
                            "Propriété de ce qui est fade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ecec24-644e-498e-9b03-87f9d5f79865",
                                "sense_id": "5db400b0-d225-343a-97c5-698ae25981ef",
                                "text": "Elle ne salait les mets qu'après la cuisson, bien qu'elle sût à quel point la fadeur lui en était désagréable."
                            },
                            {
                                "example_id": "cae85607-f9fe-466f-8234-16ced19df543",
                                "sense_id": "5db400b0-d225-343a-97c5-698ae25981ef",
                                "text": "Côté gourmandise – parce que détox ne rime pas avec « fadeur » –, vous découvrirez de nombreuses recettes de légumes et jus ultra-vitaminés ! *"
                            }
                        ]
                    },
                    {
                        "sense_id": "88753cf9-251f-3a7b-b52b-91dc1f7c143a",
                        "entry_id": "6f81e5f8-f27b-3aff-b319-0b601bbad046",
                        "glosses": [
                            "Insignifiance dans la mine, dans les manières, dans les propos de quelqu’un."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9b6e1dac-1f0e-45e9-a6e5-d5925c599028",
                                "sense_id": "88753cf9-251f-3a7b-b52b-91dc1f7c143a",
                                "text": "[…] ; son teint était d’une blancheur exquise ; mais le moule splendide dans lequel avait été jeté sa tête et ses traits bannissait jusqu’à l’idée même de cette fadeur qui, quelquefois, s’attache aux femmes blondes ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "b552d302-fece-3cd5-bede-2c9c73277220",
                        "entry_id": "6f81e5f8-f27b-3aff-b319-0b601bbad046",
                        "glosses": [
                            "Propos fades."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "27395eb9-0666-4334-973f-f29af1db7fc3",
                                "sense_id": "b552d302-fece-3cd5-bede-2c9c73277220",
                                "text": "[…]; il n'est de sottises que ces niais ne débitassent, de grossièretés enveloppées de fadeurs qu'ils n'osassent laisser tomber, et l'arrogance mielleuse de ces bas de plafond ne contribuait pas peu à entretenir ma bilieuse tristesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "b23569fe-53c6-3fcb-8547-eb34bcffa779",
                        "entry_id": "6f81e5f8-f27b-3aff-b319-0b601bbad046",
                        "glosses": [
                            "Louange fade."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "705c0270-f8de-4099-b8f6-b68118e93ccf",
                                "sense_id": "b23569fe-53c6-3fcb-8547-eb34bcffa779",
                                "text": "Dire des fadeurs à une femme."
                            },
                            {
                                "example_id": "d4a598b3-a60a-410d-9277-d6c56eb7479e",
                                "sense_id": "b23569fe-53c6-3fcb-8547-eb34bcffa779",
                                "text": "Leur entente sautait aux yeux : il caressait les bras de maman, la cajolait, lui disait de tendres fadeurs."
                            }
                        ]
                    }
                ],
