{
    "word_family": [
        "Greece",
        "Grecian"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb30a5d8-423e-337b-8daf-915f0831c8e5",
                    "sense_definition": "Of or relating to Greece, its people, its language, or its culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greece_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a delicious <w>Greek</w> salad with feta cheese and olives.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались вкусным <w>греческим</w> салатом с сыром фета и оливками.",
                                "zh": "我们吃了一份美味的<w>希腊</w>沙拉，里面有菲达奶酪和橄榄。"
                            }
                        },
                        {
                            "text": "The museum has a large collection of ancient <w>Greek</w> pottery.",
                            "target_lang_translations": {
                                "ru": "В музее есть большая коллекция древней <w>греческой</w> керамики.",
                                "zh": "这家博物馆收藏了大量古代<w>希腊</w>陶器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Hellenic",
                        "Grecian"
                    ],
                    "common_phrases": [
                        "Greek mythology",
                        "Greek yogurt",
                        "Greek salad",
                        "Ancient Greek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Греции, её народу, языку или культуре.",
                        "zh": "与希腊、希腊人、希腊语或希腊文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греческий",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "грецкий",
                                "target_lang_sense_clarification": "устаревшее или в устойчивых сочетаниях (напр. грецкий орех)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希腊的",
                                "target_lang_sense_clarification": "泛指与希腊、希腊人、希腊语或希腊文化有关"
                            },
                            {
                                "target_lang_word": "希腊",
                                "target_lang_sense_clarification": "用于食物、艺术、历史等固定搭配中，也常省略“的”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b1f174-927b-3759-8c0b-56d129e60bff",
                    "sense_definition": "Of or relating to collegiate fraternities and sororities.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fraternity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to join the <w>Greek</w> system during her first year of college.",
                            "target_lang_translations": {
                                "ru": "Она решила присоединиться к <w>греческой</w> системе (студенческих братств) на первом курсе колледжа.",
                                "zh": "她决定在大学一年级加入<w>希腊社团</w>体系。"
                            }
                        },
                        {
                            "text": "The university has a designated row for <w>Greek</w> housing.",
                            "target_lang_translations": {
                                "ru": "В университете выделена отдельная улица для домов <w>греческих</w> братств.",
                                "zh": "这所大学专门划出了一排街区作为<w>兄弟会和女生联谊会的</w>宿舍区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Greek life",
                        "Greek system",
                        "Greek row"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "university context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к студенческим братствам и сестринствам (в колледжах и университетах США).",
                        "zh": "与大学里的兄弟会和女生联谊会有关的，主要用于美国校园语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греческий",
                                "target_lang_sense_clarification": "в контексте системы студенческих братств"
                            },
                            {
                                "target_lang_word": "студенческий",
                                "target_lang_sense_clarification": "относящийся к братствам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希腊社团的",
                                "target_lang_sense_clarification": "指美国大学中的兄弟会和女生联谊会体系"
                            },
                            {
                                "target_lang_word": "兄弟会和女生联谊会的",
                                "target_lang_sense_clarification": "较解释性的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec9c980-940b-33e5-8d5c-a67c000043d5",
                    "sense_definition": "Incomprehensible or difficult to understand; often used in the phrase 'it is all Greek to me'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unintelligible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to read the technical manual, but it was all <w>Greek</w> to me.",
                            "target_lang_translations": {
                                "ru": "Я пытался прочитать техническое руководство, но для меня это была сплошная <w>китайская грамота</w>.",
                                "zh": "我试着读那本技术手册，但对我来说简直<w>像天书一样</w>。"
                            }
                        },
                        {
                            "text": "Without a translator, the legal jargon is just <w>Greek</w>.",
                            "target_lang_translations": {
                                "ru": "Без переводчика этот юридический жаргон — просто <w>тарабарщина</w>.",
                                "zh": "没有翻译的话，这些法律术语实在太<w>难懂</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incomprehensible"
                    ],
                    "common_phrases": [
                        "all Greek to me"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непонятный или трудный для понимания; часто используется в идиомах.",
                        "zh": "难以理解的；常见于“这对我来说简直像天书一样”这类说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "китайская грамота",
                                "target_lang_sense_clarification": "идиоматический эквивалент"
                            },
                            {
                                "target_lang_word": "тарабарщина",
                                "target_lang_sense_clarification": "бессмыслица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难懂的",
                                "target_lang_sense_clarification": "一般说法，指难以理解"
                            },
                            {
                                "target_lang_word": "像天书一样",
                                "target_lang_sense_clarification": "常用于“对我来说像天书一样”这类表达"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f7b199ab-b53d-3fbc-a006-4c92b38d53a4",
                    "sense_definition": "The language spoken by people of Greece, including Ancient Greek and Modern Greek.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "greece_general",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He is learning to speak <w>Greek</w> before his holiday in Athens.",
                            "target_lang_translations": {
                                "ru": "Он учится говорить <w>по-гречески</w> перед отпуском в Афинах.",
                                "zh": "他正在学说<w>希腊语</w>，准备去雅典度假。"
                            }
                        },
                        {
                            "text": "Many scientific terms are derived from <w>Greek</w>.",
                            "target_lang_translations": {
                                "ru": "Многие научные термины происходят из <w>греческого</w> языка.",
                                "zh": "许多科学术语都来源于<w>希腊语</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Greek",
                        "learn Greek",
                        "Modern Greek",
                        "Classical Greek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык, на котором говорят жители Греции, включая древнегреческий и новогреческий.",
                        "zh": "希腊人所说的语言，包括古希腊语和现代希腊语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греческий язык",
                                "target_lang_sense_clarification": "название языка"
                            },
                            {
                                "target_lang_word": "греческий",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希腊语",
                                "target_lang_sense_clarification": "现代希腊的语言名称"
                            },
                            {
                                "target_lang_word": "古希腊语",
                                "target_lang_sense_clarification": "在历史或语言学语境中可特指古代阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e560aae-b5f1-35e4-8408-d6bc177e866e",
                    "sense_definition": "A person from Greece or of Greek descent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greece_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Greeks</w> are known for their warm hospitality and rich history.",
                            "target_lang_translations": {
                                "ru": "<w>Греки</w> известны своим теплым гостеприимством и богатой историей.",
                                "zh": "<w>希腊人</w>以热情好客和悠久的历史而闻名。"
                            }
                        },
                        {
                            "text": "Many <w>Greeks</w> emigrated to other countries in the twentieth century.",
                            "target_lang_translations": {
                                "ru": "Многие <w>греки</w> эмигрировали в другие страны в двадцатом веке.",
                                "zh": "许多<w>希腊人</w>在二十世纪移民到了其他国家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Hellene"
                    ],
                    "common_phrases": [
                        "ancient Greeks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек из Греции или греческого происхождения.",
                        "zh": "来自希腊的人，或有希腊血统的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грек",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "гречанка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希腊人",
                                "target_lang_sense_clarification": "来自希腊的人；最常用说法"
                            },
                            {
                                "target_lang_word": "希腊裔",
                                "target_lang_sense_clarification": "强调血统或出身时可用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dafb4b36-b96b-3399-bb42-260c79f01aab",
                    "sense_definition": "A member of a collegiate fraternity or sorority.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fraternity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Greeks</w> on campus organized a charity fundraiser last weekend.",
                            "target_lang_translations": {
                                "ru": "<w>Члены братств</w> в кампусе организовали благотворительный сбор средств в прошлые выходные.",
                                "zh": "校园里的<w>希腊社团成员</w>上周末组织了一场慈善募捐活动。"
                            }
                        },
                        {
                            "text": "He made many lifelong friends as a <w>Greek</w> in college.",
                            "target_lang_translations": {
                                "ru": "Он приобрел много друзей на всю жизнь, будучи <w>членом братства</w> в колледже.",
                                "zh": "他在大学里作为一名<w>兄弟会成员</w>，结识了许多终生的朋友。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "university context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член студенческого братства или сестринства.",
                        "zh": "大学兄弟会或女生联谊会的成员，主要用于美国校园语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "член братства",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希腊社团成员",
                                "target_lang_sense_clarification": "校园语境中较自然的统称"
                            },
                            {
                                "target_lang_word": "兄弟会成员",
                                "target_lang_sense_clarification": "指男性 fraternity 成员时更具体"
                            },
                            {
                                "target_lang_word": "女生联谊会成员",
                                "target_lang_sense_clarification": "指女性 sorority 成员时更具体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9344489-4c6f-3fcd-b3f4-9446ad9f7e7b",
                    "sense_definition": "To display placeholder text or symbols (instead of real text) to optimize display speed or focus on layout design.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing_jargon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software automatically <w>greeks</w> the text when you zoom out to view the whole page.",
                            "target_lang_translations": {
                                "ru": "Программа автоматически <w>заменяет текст на плашки</w>, когда вы уменьшаете масштаб для просмотра всей страницы.",
                                "zh": "当你缩小页面查看整版时，软件会自动<w>用占位文字替代</w>正文。"
                            }
                        },
                        {
                            "text": "We <w>greeked</w> the paragraphs in the draft so the client would focus on the design structure.",
                            "target_lang_translations": {
                                "ru": "Мы <w>вставили «рыбу»</w> вместо абзацев в черновике, чтобы клиент сосредоточился на структуре дизайна.",
                                "zh": "我们在草稿里把那些段落<w>替换成占位文本</w>，这样客户就会把注意力放在版式结构上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отображать текст-заполнитель или символы (вместо реального текста) для оптимизации скорости отображения или фокусировки на дизайне макета.",
                        "zh": "把真实文字显示成占位文本或符号，以提高显示速度或突出版面设计。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать «рыбу»",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            },
                            {
                                "target_lang_word": "заменять условным текстом",
                                "target_lang_sense_clarification": "техническое описание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用占位文字替代",
                                "target_lang_sense_clarification": "指把正常正文改成占位文本或符号"
                            },
                            {
                                "target_lang_word": "替换成占位文本",
                                "target_lang_sense_clarification": "较技术性的说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}