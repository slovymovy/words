                    },
                    {
                        "translation_id": "a8581213-c9c0-445f-970b-210758db2e35",
                        "source_entry_id": "2447aa8e-2924-31ab-9916-47e560155754",
                        "target_lang_word": "屈折",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "屈折",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                        "entry_id": "4b1209fe-792c-387c-8e7c-6486d9e9a04a",
                                        "glosses": [
                                            "屈身；貶抑。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7b73e-cc4b-4c03-bd26-6157dc4dafd2",
                                                "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                                "text": "《莊子‧駢拇》：“屈折禮樂，呴俞仁義，以慰天下之心者，此失其常然也。”"
                                            },
                                            {
                                                "example_id": "0b49c74f-e564-48c0-bd1d-76a8c39e41e3",
                                                "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                                "text": "陸德明釋文：“謂屈折支體為禮樂也。”"
                                            },
                                            {
                                                "example_id": "0282dcb0-e079-416f-bfa5-ee7c67bd2656",
                                                "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                                "text": "漢·王充《論衡‧率性》：“猛氣消損，驕節屈折。”"
                                            },
                                            {
                                                "example_id": "c61a0f7d-d842-4411-a252-feb6f3c52afb",
                                                "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                                "text": "《新唐書‧楊再思傳》：“公位尊，何自屈折？”"
                                            },
                                            {
                                                "example_id": "f4ba2890-1361-4245-921f-c8c6cb8fcb5b",
                                                "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                                "text": "宋·葉適《鄭景元墓志銘》：“世常病景元負氣不屈折，故不用，殆豪士哉！”"
                                            },
                                            {
                                                "example_id": "50361b1d-d651-4df1-b83e-7d90f117ea99",
                                                "sense_id": "04cab274-4f68-3331-946e-76700e6430f8",
                                                "text": "清·黃宗羲《餘姚至省下路程沿革記》：“風雨之夕，屈折篷底，躑躅泥淖，故行者為甚難。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5dab97a-8022-3fa2-a630-51fc4b8948a9",
                                        "entry_id": "4b1209fe-792c-387c-8e7c-6486d9e9a04a",
                                        "glosses": [
                                            "扭曲；曲折。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c248466-4841-458c-967c-cd86f786e71d",
                                                "sense_id": "b5dab97a-8022-3fa2-a630-51fc4b8948a9",
                                                "text": "北周·庾信《擬連珠》之二三：“蓋聞性靈屈折，鬱抑不揚；乍感無情，或傷非類。”"
                                            },
                                            {
                                                "example_id": "de875359-6737-41ba-a3ef-2dd8ebb405cc",
                                                "sense_id": "b5dab97a-8022-3fa2-a630-51fc4b8948a9",
                                                "text": "唐·柳宗元《鈷鉧潭記》：“其始蓋冉水自南奔注，抵山石，屈折東流。”"
                                            },
                                            {
                                                "example_id": "20a12813-6cea-46f1-93cb-d8dc80002e50",
                                                "sense_id": "b5dab97a-8022-3fa2-a630-51fc4b8948a9",
                                                "text": "宋·洪邁《容齋隨筆‧桃源行》：“近時胡宏仁仲一詩，屈折有寄味。”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f9817f9-7e08-3e71-b0fe-4bca786f98e9",
                                        "entry_id": "4b1209fe-792c-387c-8e7c-6486d9e9a04a",
                                        "glosses": [
