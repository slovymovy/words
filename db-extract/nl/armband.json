                        ],
                        "examples": [
                            {
                                "example_id": "59e5861c-30d4-4225-be52-bda27fa1358f",
                                "sense_id": "bdc17f13-9d0f-3fe0-b878-a8c9bddf48d1",
                                "text": "Ze droeg een gouden armband op het feest.",
                                "translation": "She wore a gold bracelet to the party.",
                                "english": "She wore a gold bracelet to the party."
                            },
                            {
                                "example_id": "ad75b936-4c16-4e2a-9198-7c1dee28765e",
                                "sense_id": "bdc17f13-9d0f-3fe0-b878-a8c9bddf48d1",
                                "text": "Ik kreeg een armband als verjaardagscadeau.",
                                "translation": "I received a bracelet as a birthday gift.",
                                "english": "I received a bracelet as a birthday gift."
                            },
                            {
                                "example_id": "a5db2960-3c07-4d33-ba20-f714aa842b1e",
                                "sense_id": "bdc17f13-9d0f-3fe0-b878-a8c9bddf48d1",
                                "text": "Het armbandje was versierd met kleine parels.",
                                "translation": "The small bracelet was adorned with tiny pearls.",
                                "english": "The small bracelet was adorned with tiny pearls."
                            }
                        ]
                    }
                ],
