        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed488560-3083-3bbc-8ddf-80efdf12bb1d",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>venten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vent</w> elke zaterdag mijn zelfgemaakte producten langs de deuren.",
                            "target_lang_translations": {
                                "en": "I <w>peddle</w> my homemade products door-to-door every Saturday.",
                                "ru": "Каждую субботу я <w>торгую вразнос</w> своими домашними продуктами, обходя дома."
                            }
                        },
                        {
                            "text": "Als ik mijn waar <w>vent</w>, ontmoet ik veel verschillende mensen.",
                            "target_lang_translations": {
                                "en": "When I <w>hawk</w> my wares, I meet many different people.",
                                "ru": "Когда я <w>разношу</w> свой товар, я встречаю много разных людей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb conjugation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'venten' (to hawk or peddle)",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'venten' (торговать вразнос)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hawk",
                                "target_lang_sense_clarification": "to offer goods for sale by calling out in the street"
                            },
                            {
                                "target_lang_word": "peddle",
                                "target_lang_sense_clarification": "to sell small goods by traveling from place to place"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "торгую вразнос",
                                "target_lang_sense_clarification": "продавать товары, обходя дома или на улице"
                            },
                            {
                                "target_lang_word": "разношу",
                                "target_lang_sense_clarification": "доставлять и предлагать товар покупателям"
                            }
                        ]
