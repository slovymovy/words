                "senses": [
                    {
                        "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                        "entry_id": "556a498e-5807-3f55-8104-5351a3be79c2",
                        "glosses": [
                            "Erhöhung einer Menge, insbesondere einer Konzentration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad242c54-354f-4f1c-ad3a-95eb15e801cc",
                                "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                "text": "Der Chemiker veranlasst eine Anreicherung der Chemikalien."
                            },
                            {
                                "example_id": "836caad0-bafd-4b09-876f-c5ffcd9a93d8",
                                "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                "text": "„Für das Kreditgewerbe kann es in dieser Lage nur eine sinnvolle Entscheidung geben: Banken und Sparkassen müssen sich mit ganzer Kraft auf die billigste Form der Eigenkapitalbeschaffung konzentrieren, auf die Anreicherung der haftenden Eigenmittel aus selbstverdienten Erträgen.“"
                            },
                            {
                                "example_id": "35107728-cfbf-4c99-a85f-eff76b55420f",
                                "sense_id": "81093c16-4d79-3f49-8754-d6bda79debea",
                                "text": "„Ihre nahe gelegenen Mausoleen geben ein interessantes Beispiel für die Anreicherung persischer Baukunst mit Elementen der Hindu-Tempelarchitektur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
