                "senses": [
                    {
                        "sense_id": "469dc96a-31a2-39cf-ab21-33f1110c9622",
                        "entry_id": "ad6fef14-7cdd-366a-ba14-de4b5213dc1a",
                        "glosses": [
                            "Urbaniser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c83b99-38a8-414f-9a28-8d83a3338c1f",
                                "sense_id": "469dc96a-31a2-39cf-ab21-33f1110c9622",
                                "text": "Après avoir critiqué la ville industrielle qui « urbanifie » le citoyen, au détriment du contact avec la nature et du développement de la personnalité, il prône un individualisme forcené, qu'il qualifie de « démocratie, lié à une dépolitisation de la société au profit de la technique."
                            },
                            {
                                "example_id": "3c301417-b33f-44dc-8ba9-56d3c4a03751",
                                "sense_id": "469dc96a-31a2-39cf-ab21-33f1110c9622",
                                "text": "Ce ne sont point de telles exploitations, ni de telles migrations qui conviennent à notre vieux pays, profondément urbanifié et cultivé."
                            }
                        ]
                    }
                ],
