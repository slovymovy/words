                ],
                "senses": [
                    {
                        "sense_id": "9b127dfd-a511-3ba7-ac6b-38bdee690e45",
                        "entry_id": "f157a11d-4b1f-3f94-b3a3-d0353a00d727",
                        "glosses": [
                            "Vorrichtung an einer Tür, mit deren Hilfe man sie öffnen/schließen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb88b51-abb5-4111-938e-087a377f9f10",
                                "sense_id": "9b127dfd-a511-3ba7-ac6b-38bdee690e45",
                                "text": "„In dem Moment, als der Türgriff aufhörte zu rütteln, setzte das Klopfen wieder ein.“"
                            },
                            {
                                "example_id": "e36f2ccc-5635-4957-8bb5-bf9801d66d4e",
                                "sense_id": "9b127dfd-a511-3ba7-ac6b-38bdee690e45",
                                "text": "„Dabei klammerte er sich ganz fest an den Türgriff auf der Innenseite, Michalis war nämlich noch schneller unterwegs als Hans.“"
                            },
                            {
                                "example_id": "1781f7b5-91ed-41d8-89de-61ce245a9704",
                                "sense_id": "9b127dfd-a511-3ba7-ac6b-38bdee690e45",
                                "text": "„So fühlte es sich an, als ich mit der Hand auf dem Türgriff stehen blieb und dem erneuten Läuten des Big Ben lauschte, ohne die Tür zu öffnen.“"
                            },
                            {
                                "example_id": "11bdaeec-15d5-43ad-8690-1fd911d8f9e2",
                                "sense_id": "9b127dfd-a511-3ba7-ac6b-38bdee690e45",
                                "text": "„Er nahm ein Tuch und legte es auf den Türgriff, bevor er ihn anfasste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
