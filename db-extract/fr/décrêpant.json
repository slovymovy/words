                "senses": [
                    {
                        "sense_id": "0553c55e-8ef0-3692-a968-9f391fdca2a8",
                        "entry_id": "ed9ca495-10d1-3352-871f-7b2d1283542d",
                        "glosses": [
                            "Produit utiliser pour lisser les cheveux crépus, notamment chez les populations ulotriches d'Afrique."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "fd0b509e-57e9-44fb-b3f6-692759e744cb",
                                "sense_id": "0553c55e-8ef0-3692-a968-9f391fdca2a8",
                                "text": "Les décrêpants sont généralement des produits contenant de l'hydroxyde de potassium, de sodium ou de calcium qui transforme les liaisons disulfures de la kératine en liaisons lanthionines"
                            },
                            {
                                "example_id": "4c4948df-f2b6-47e5-84ef-0b52827a2858",
                                "sense_id": "0553c55e-8ef0-3692-a968-9f391fdca2a8",
                                "text": "Les produits des Industries des cosmétiques et de la parfumerie sont extrêmement variés : shampooings, laques, produits pour permanentes, décrêpants, crèmes, laits, dentifrices, talcs, poudres, fards, vernis à ongles, dépilatoires, …."
                            },
                            {
                                "example_id": "abdc9959-4872-4f30-ba5e-929170e9fa27",
                                "sense_id": "0553c55e-8ef0-3692-a968-9f391fdca2a8",
                                "text": "… en luttant contre les usages « décadents » de la mode occidentale tels que le port de la mini-jupe, le maquillage destiné à blanchir la peau, l'usage des décrêpants et perruques."
                            },
                            {
                                "example_id": "30eeb6ac-f662-4bd7-a9b4-79b866dd8179",
                                "sense_id": "0553c55e-8ef0-3692-a968-9f391fdca2a8",
                                "text": "Le décrêpant permet de dévisser plus facilement l’écrou"
                            },
                            {
                                "example_id": "338cd630-df6a-4422-b2f9-d203e4728403",
                                "sense_id": "0553c55e-8ef0-3692-a968-9f391fdca2a8",
                                "text": "Modelant, il rétablit l’ondulation naturelle du cheveu frisé à crépu en le désépaississant ou le décrêpant."
                            }
                        ]
                    }
                ],
