            "senses": [
                {
                    "sense_id": "56211f3d-b36a-30f0-a1e6-344920f6f54d",
                    "sense_definition": "Voltooid deelwoord van <w>uitverkiezen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had nooit verwacht dat hij tot winnaar zou worden <w>uitverkoren</w>.",
                            "target_lang_translations": {
                                "pl": "Nigdy się nie spodziewał, że zostanie <w>wybrany</w> na zwycięzcę."
