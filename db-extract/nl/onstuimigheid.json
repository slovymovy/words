                ],
                "senses": [
                    {
                        "sense_id": "1fa0c756-47d6-3154-9180-5b8cb5bd9ad6",
                        "entry_id": "5e21a37d-feb8-3a73-8062-10539d791890",
                        "glosses": [
                            "de mate waarin men op een wilde manier enthousiast is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5317b3e-1d8b-47b0-9960-a7de6a5db363",
                                "sense_id": "1fa0c756-47d6-3154-9180-5b8cb5bd9ad6",
                                "text": "Nikolaj was kleiner, met krullend haar en een open gezicht. Op zijn bovenlip vertoonden zich al donkere haartjes, en op zijn hele gezicht lag een uitdrukking van onstuimigheid en geestdrift."
                            },
                            {
                                "example_id": "c04c749f-b4ee-4760-a1f8-3c9234813ced",
                                "sense_id": "1fa0c756-47d6-3154-9180-5b8cb5bd9ad6",
                                "text": "Toen Cibulková haar onstuimigheid onder controle kreeg en wat minder geforceerd op jacht ging naar een winner, werd het spannend. De Slowaakse kwam terug tot 4-5 en zette de Australische met haar magnifieke forehands onder druk, maar Stosur wist de aanval af te slaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fc05de7-ef6a-30ec-b94c-0447ec9ac6e0",
                        "entry_id": "5e21a37d-feb8-3a73-8062-10539d791890",
                        "glosses": [
                            "iets wat getuigt van een wilde enthousiastheid"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbd7ab96-4799-4e69-8045-804846509ff6",
                        "source_entry_id": "5e21a37d-feb8-3a73-8062-10539d791890",
                        "source_sense_id": "1fa0c756-47d6-3154-9180-5b8cb5bd9ad6",
                        "source_sense_description": "de mate waarin men op een wilde manier enthousiast is",
                        "target_lang_word": "impetus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impetus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "Anything that impels; a stimulating factor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a1fdc5-ddf1-4702-9dee-18444cf1aa7c",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "The outbreak of World War II in 1939 gave a new impetus to receiver development."
                                            },
                                            {
                                                "example_id": "da287bbf-b77b-45a7-8316-9db557aaef4c",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "Once set a strong mind thinking, and you have done all that it needs for its education. It matters little what is the first impetus, so that it only be set to work."
                                            },
                                            {
                                                "example_id": "88d2cfef-6c8b-4f4a-8e9b-773579a192eb",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "In a single moment Montenegro and their supporters were given fresh impetus and encouragement. Beciraj tested Hart with a low shot before teenager Phil Jones, on his England debut, suffered an anxious moment when Stevan Jovetic went down under his challenge, leaving the youngster clearly relieved to see referee Stark wave away Montenegro's appeals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f36f56e-0594-36ac-b577-55cf78a1085a",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "A force, either internal or external, that impels; an impulse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bfb3d3e-0a98-332b-95e4-7cbab4d86917",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "The force or energy associated with a moving body; a stimulus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71f15156-8e74-37fc-a49d-51d2dc80cee2",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "A principle of motive force, held as equivalent to weight times velocity by John Buridan, in an auxiliary theory of Aristotelian dynamics introduced by John Philoponus, describing projectile motion against gravity as linear until it transitions to a vertical drop and the intellectual precursor to the concepts of inertia, momentum and acceleration in classical mechanics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
