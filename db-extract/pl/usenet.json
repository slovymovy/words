                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6fc5cd-4100-3d76-96cf-d3d5e75b1ef6",
                                        "entry_id": "528faa15-4f09-354a-a6d4-5d1e67c2a062",
                                        "glosses": [
                                            "Réseau de groupes de discussion utilisant le protocole NNTP."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ed891b-3900-457d-a9e8-2de4f04071ec",
                                                "sense_id": "dc6fc5cd-4100-3d76-96cf-d3d5e75b1ef6",
                                                "text": "La hiérarchie fr. de Usenet comporte un groupe fr.misc.engueulades, spécialement destiné à ce que n’importe qui puisse aller y insulter n’importe qui, et à éviter que les conversations trop violentes n’aillent polluer les autres groupes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1a4b7d8-276f-4626-a4a5-5dc637239a78",
                        "source_entry_id": "b6e31a6c-3c26-3c74-8cab-e025b525d1a7",
                        "source_sense_id": "c6a1baa6-d01e-3403-a397-f60abdb31aa0",
                        "target_lang_word": "Usenet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Usenet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e82223d7-32d6-39fb-aa34-cefe709add8c",
                                        "entry_id": "89b39bec-b1af-3ed4-844c-76ff88cc2faf",
                                        "glosses": [
                                            "weltweites, elektronisches Netzwerk, das Diskussionsforen (Newsgroups) aller Art bereitstellt und an dem grundsätzlich jeder teilnehmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7d3e4a-a3c2-467b-b6f3-67f09d9b1849",
                                                "sense_id": "e82223d7-32d6-39fb-aa34-cefe709add8c",
                                                "text": "Das Usenet ist ein Netzwerk, das aus Newsservern besteht, die sich ständig untereinander abgleichen."
                                            },
                                            {
                                                "example_id": "4c91bf60-2cd2-4b6b-90eb-d9cddee8fbb5",
                                                "sense_id": "e82223d7-32d6-39fb-aa34-cefe709add8c",
                                                "text": "Sie greift auf das Usenet mit ihrem Newsreader zu."
                                            },
                                            {
                                                "example_id": "cefe5169-882c-4649-8efd-9e04245b8b15",
                                                "sense_id": "e82223d7-32d6-39fb-aa34-cefe709add8c",
                                                "text": "Usenet, Mailinglisten und IRC werden zunehmend durch Webforen, Soziale Netzwerke und Instant Messaging ersetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
