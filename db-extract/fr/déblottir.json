                "senses": [
                    {
                        "sense_id": "516c0198-239c-3cd9-88d7-0dded423de28",
                        "entry_id": "07cf447a-8563-3534-a7b5-ab98853e8282",
                        "glosses": [
                            "Faire cesser d’être blotti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b0a6a39-75aa-45e6-88cb-cda889f11a2c",
                                "sense_id": "516c0198-239c-3cd9-88d7-0dded423de28",
                                "text": "Il faut en faire quelque chose de fort, à la fois pour les mots qui restent dans la gorge, et pour désensevelir la vérité, la déblottir, la travailler jusqu’à l’os, la désensorceler !"
                            },
                            {
                                "example_id": "622dc369-0c77-462f-a114-ad8b7a5b8e2b",
                                "sense_id": "516c0198-239c-3cd9-88d7-0dded423de28",
                                "text": "Tu vas rouvrir les yeux, raccrocher le téléphone, te déblottir du vieux divan transi d’humidité, oser rouvrir tes oreilles au vacarme du cyclone."
                            }
                        ]
                    }
                ],
