                ],
                "senses": [
                    {
                        "sense_id": "f882cd2f-e2d9-3a56-8a2d-c83ee40508ed",
                        "entry_id": "675a22e7-9989-3c21-81be-7de1c45e6f92",
                        "glosses": [
                            "A character or symbol (grapheme) that represents a sound, as opposed to logograms and determinatives."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "922ed01b-7475-32c7-8113-340a70e03fbb",
                        "entry_id": "675a22e7-9989-3c21-81be-7de1c45e6f92",
                        "glosses": [
                            "An audio recording, regardless of physical format."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fb009ff-6c5c-4360-8344-8e15f4dd02a3",
                        "source_entry_id": "675a22e7-9989-3c21-81be-7de1c45e6f92",
                        "source_sense_description": "(linguistics) character or symbol",
                        "target_lang_word": "phonogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phonogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa040a7-b5af-3a93-b80b-37e579ac2c28",
                                        "entry_id": "a797c405-4a0e-318e-97af-38b8949bc72a",
                                        "glosses": [
                                            "Enregistrement d’un texte sur un support à l’aide d’un phonographe."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "942e8451-82d4-4cf8-b23a-354bb3c4cc6a",
                                                "sense_id": "8aa040a7-b5af-3a93-b80b-37e579ac2c28",
                                                "text": "Quand le cylindre se met à exécuter son double mouvement de rotation et de translation, tous les reliefs et tous les creux de la cire influencent le levier et forcent la pointe de la branche supérieure à répéter les sinuosités du phonogramme sur une longue bande de papier portée par deux rouleaux de bois horizontaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "486e83e6-b49a-3902-8c1f-d2327bd7deea",
                                        "entry_id": "a797c405-4a0e-318e-97af-38b8949bc72a",
                                        "glosses": [
                                            "Fixation exclusivement sonore sur tout support d’une œuvre d’exécution ou de son ouvrant le droit d’auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f7a527-1aeb-49f7-97c8-5a11bc88cb4f",
                                                "sense_id": "486e83e6-b49a-3902-8c1f-d2327bd7deea",
                                                "text": "Les producteurs de phonogrammes jouissent du droit exclusif d’autoriser la reproduction directe ou indirecte de leurs phonogrammes, de quelque manière et sous quelques formes que se soient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1516c931-06cd-354b-bf83-db7e23aae355",
                                        "entry_id": "a797c405-4a0e-318e-97af-38b8949bc72a",
                                        "glosses": [
                                            "Transcription arbitraire d’un son sous forme écrite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "496e4e20-a6d4-484d-9444-0ba4987050f1",
                                                "sense_id": "1516c931-06cd-354b-bf83-db7e23aae355",
                                                "text": "Le dérivé aurifère de or contient le phonogramme au qui traduit le même phonème que la souche or."
                                            },
                                            {
                                                "example_id": "54132089-f8be-478e-8703-4fe28f89c075",
                                                "sense_id": "1516c931-06cd-354b-bf83-db7e23aae355",
                                                "text": "Naturellement, les idéogrammes et les phonogrammes ont cohabité – c’est le cas toujours au Japon – et il n’a pas été ordonné par une instance supérieure un beau jour, que l’idéogramme serait à jamais supprimé au profit du phonogramme. C'est l’un des aspects de l’évolution, cette évolution qui allait nous conduire à l’alphabet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5eb5be-a7ae-30b0-8cdc-185002974efb",
                                        "entry_id": "a797c405-4a0e-318e-97af-38b8949bc72a",
                                        "glosses": [
                                            "Représentation graphique de la voix."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8de1164-962f-400b-9f7a-1f82ebc6b27f",
                        "source_entry_id": "675a22e7-9989-3c21-81be-7de1c45e6f92",
                        "source_sense_description": "(linguistics) character or symbol",
                        "target_lang_word": "Phonogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phonogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb615c83-b788-3d6d-9495-5621e0a18adc",
                                        "entry_id": "bbec8a16-ab91-3602-8b26-8180b4bc19e0",
                                        "glosses": [
                                            "„Aufzeichnung von Schallwellen“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b021b2a-5cce-4c1e-92f5-76d10675ac40",
                                                "sense_id": "cb615c83-b788-3d6d-9495-5621e0a18adc",
                                                "text": "Eine Musiknote ist ein Phonogramm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fe27b95-e3bc-3765-ab84-033115f611a7",
                                        "entry_id": "bbec8a16-ab91-3602-8b26-8180b4bc19e0",
                                        "glosses": [
                                            "Schriftzeichen, das einen Sprachlaut repräsentiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3f39fc4-bf56-4502-aeab-60b84480f50c",
                                                "sense_id": "4fe27b95-e3bc-3765-ab84-033115f611a7",
                                                "text": "Die Darstellung des Wortes Phonogramm als [fonoˈɡʁam] ist ein Phonogramm."
                                            },
                                            {
                                                "example_id": "9a855963-cef6-4217-a934-5c9825c2649f",
                                                "sense_id": "4fe27b95-e3bc-3765-ab84-033115f611a7",
                                                "text": "„Phonogramme (= Lautzeichen) sind Zeichen, die ausschließlich auf die lautliche Ebene des Sprachsystems bezogen sind.“"
                                            },
                                            {
                                                "example_id": "b87f015c-dd24-4c7b-9b5d-d0241c19eec8",
                                                "sense_id": "4fe27b95-e3bc-3765-ab84-033115f611a7",
                                                "text": "„Buchstaben oder feste Buchstabengruppen sowie Syllabogramme werden auch als Phonogramme bezeichnet.“"
                                            },
                                            {
                                                "example_id": "50ef5fb7-b666-4c32-b9a5-274c2bcf92e9",
                                                "sense_id": "4fe27b95-e3bc-3765-ab84-033115f611a7",
                                                "text": "„Die Originalität und Vielfalt dieser Schrift rühren daher, daß sie aus drei Arten von Zeichen besteht: aus Piktogrammen, stilisierten Bildzeichen für Dinge und Lebewesen, die in bestimmten Zeichenkombinationen auch Gedanken ausdrücken können; aus Phonogrammen, oft denselben Zeichen, die jedoch Laute ausdrücken (die Ägypter benutzen ein ganz ähnliches Bilderrätselsystem wie die Sumerer); und schließlich aus Determinativen, also Zeichen, die verdeutlichen, um welche Art Ding oder Lebewesen es sich handelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0fc2f93-8f18-4609-839d-520b1642d56e",
                        "source_entry_id": "675a22e7-9989-3c21-81be-7de1c45e6f92",
                        "source_sense_description": "(linguistics) character or symbol",
                        "target_lang_word": "Lautzeichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lautzeichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc00de82-96e5-3747-b9df-c6b5839aeb67",
                                        "entry_id": "4a049110-afae-3501-8392-ff2055a10294",
                                        "glosses": [
                                            "Schriftzeichen, das der Wiedergabe eines Sprachlauts dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba471e8-9198-4b2f-8ba0-23b21666a546",
                                                "sense_id": "bc00de82-96e5-3747-b9df-c6b5839aeb67",
                                                "text": "„Und überall beginnen sich diese Bildzeichen zu immer abstrakteren Lautzeichen zu entwickeln und lösen sich mehr und mehr in Gestalt und Bedeutung von den ursprünglich dargestellten Gegenstand.“"
                                            },
                                            {
                                                "example_id": "9175d3c2-6157-4948-b8ed-b38e9247b647",
                                                "sense_id": "bc00de82-96e5-3747-b9df-c6b5839aeb67",
                                                "text": "„Aber das schmälert nicht den unleugbaren Fortschritt, der hier erzielt ist, und das Verdienst Youngs, der im Gegensatz zur damals herrschenden Meinung als erster erkannt hat, daß es in den Hieroglyphen neben Wortzeichen auch Lautzeichen gibt.“"
                                            },
                                            {
                                                "example_id": "ee4f2e26-9f7b-4a6d-bf11-f5c043c25c22",
                                                "sense_id": "bc00de82-96e5-3747-b9df-c6b5839aeb67",
                                                "text": "Lautschriften bestehen aus Lautzeichen."
                                            },
                                            {
                                                "example_id": "e7214150-b402-4445-9e8c-91b554c6752e",
                                                "sense_id": "bc00de82-96e5-3747-b9df-c6b5839aeb67",
                                                "text": "„Als drittes hat die Hieroglyphenschrift Zeichen, die weder etwas über die Aussprache verraten – so wie die Lautzeichen – noch über die Bedeutungsklasse – so wie die Sinnzeichen –, sondern die man nur zur Schreibung eines einzigen Wortes (mit seinen Ableitungen) verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6286b67-626f-4011-998f-9976e3a9c6cf",
                        "source_entry_id": "675a22e7-9989-3c21-81be-7de1c45e6f92",
