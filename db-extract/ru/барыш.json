                    }
                ],
                "senses": [
                    {
                        "sense_id": "57e443ee-4545-377c-be33-59a5eb1cf104",
                        "entry_id": "9784489e-43d9-303e-bc69-7ed9f0755526",
                        "glosses": [
                            "устар., разг. прибыль, материальная выгода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56eacd5b-d6e7-40a4-86ef-f33543617de5",
                                "sense_id": "57e443ee-4545-377c-be33-59a5eb1cf104",
                                "text": "А особый доход у него в царстве с игорного заведения — рулетки. Люди играют, проигрывают, выигрывают, а содержателю всегда барыш."
                            },
                            {
                                "example_id": "429ef500-00a3-4ede-99d9-b132a3400437",
                                "sense_id": "57e443ee-4545-377c-be33-59a5eb1cf104",
                                "text": "Грешен я, грешен, мамоне служу!//Если мильон барыша получу -//Право, Николе поставлю свечу\". Л.Н. Трефолев"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a916f5-92c4-41f0-8da3-3833742b1d84",
                        "source_entry_id": "9784489e-43d9-303e-bc69-7ed9f0755526",
                        "source_sense_id": "57e443ee-4545-377c-be33-59a5eb1cf104",
                        "target_lang_word": "winst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c8550c1e-1493-39d2-8631-b663ace1fc5f",
                                        "entry_id": "c964ffae-48b3-31f1-8bd4-d159fc9cb935",
                                        "glosses": [
                                            "het verschil tussen de verkoopsprijs en alle kosten die men heeft gemaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8979ff5-ffef-4826-95bf-2bac706ec49a",
                                                "sense_id": "c8550c1e-1493-39d2-8631-b663ace1fc5f",
                                                "text": "Mijn middelste dochter en ik shopten vaak in de stad en struinden kringloopwinkels af en ze begon vervolgens een klein handeltje door de daar gekochte merkkleding met winst door te verkopen."
                                            },
                                            {
                                                "example_id": "e8cf92c4-2011-4753-a5cf-604004d6a860",
                                                "sense_id": "c8550c1e-1493-39d2-8631-b663ace1fc5f",
                                                "text": "In Deventer is gisteravond een groot feest gevierd na de winst van Go Ahead Eagles in de bekerfinale. De ploeg van Paul Simonis won voor het eerst in de geschiedenis de KNVB-beker en plaatste zich daarmee voor de competitiefase van de Europa League."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
