                        "entry_id": "972eab91-e976-3cc1-82e6-2d8ee72ca35b",
                        "glosses": [
                            "in de Griekse en Romeinse mythologie in het hiernamaals de plaats voor de gelukzaligen die de gunst der goden genieten\\nBij Homerus is dit een groene vlakte in het westen, latere Grieken stelden het voor als eilanden in de oceaan en bij de Romeinen ging het om een plaats in de onderwereld."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416a117f-eb2b-4e34-8383-c1640c357eae",
                                "sense_id": "015ed3a1-b85c-32ce-977c-48582d68123b",
                                "text": "De weg voert naar het klassieke hiernamaals, het Elysium."
                            },
                            {
                                "example_id": "6d951061-fd6c-43ee-9293-f0ed5009c682",
                                "sense_id": "015ed3a1-b85c-32ce-977c-48582d68123b",
                                "text": "Nog meer dan tijdens de veelgeprezen witte nachten herinnert de subpolaire stad op zulke winterdagen aan het schimmenrijk Elysium, waar volgens de woorden van een Latijnse dichter ‘een andere zon schijnt’."
                            }
                        ]
                    }
