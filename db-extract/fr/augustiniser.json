                "senses": [
                    {
                        "sense_id": "6d943f4c-f1bb-3af5-a91d-89adaa00c834",
                        "entry_id": "50d15d5f-4e11-30f8-b469-9a986827a0a0",
                        "glosses": [
                            "Donner un caractère augustinien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04ed8c6-ed4b-4c79-a29e-896d105a6a6b",
                                "sense_id": "6d943f4c-f1bb-3af5-a91d-89adaa00c834",
                                "text": "Il était facile, dans ces conditions, d’augustiniser le philosophe arabe, en identifiant ses essences indifférentes au fait de l’existence avec les raisons idéales des créatures dans l’Intellect divin."
                            },
                            {
                                "example_id": "ac6dc4a5-c121-439a-815c-1b9ef8999c91",
                                "sense_id": "6d943f4c-f1bb-3af5-a91d-89adaa00c834",
                                "text": "Je ne dis pas qu’il faille aujourd’hui « augustiniser » la culture, au sens où Nietzsche voulait « méditerranéiser » la musique, ni même qu’il faille revenir aux dogmes judéo-chrétiens."
                            }
                        ]
                    }
