                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie pójdę dziś z wami nad jezioro, bo akurat się <w>piorę</w>.",
                            "target_lang_translations": {
                                "en": "I won't go to the lake with you today, because I'm <w>having my period</w>.",
                                "ru": "Я сегодня не пойду с вами на озеро, потому что я как раз <w>на месячных</w>.",
                                "nl": "Ik ga vandaag niet mee naar het meer, want ik <w>ben</w> net <w>ongesteld</w>.",
                                "de": "Ich komme heute nicht mit an den See, weil ich gerade <w>meine Tage habe</w>.",
                                "fr": "Je ne viens pas au lac avec vous aujourd'hui, parce que <w>j'ai mes règles</w>.",
                                "it": "Oggi non vengo al lago con voi, perché <w>ho il ciclo</w>.",
                                "cs": "Dneska s vámi k jezeru nepůjdu, protože zrovna <w>mám měsíčky</w>.",
                                "tr": "Bugün sizinle göle gelmeyeceğim, çünkü <w>adet görüyorum</w>.",
                                "es": "Hoy no voy con vosotros al lago, porque <w>tengo la regla</w>.",
                                "zh": "我今天不跟你们去湖边了，因为我正在<w>来例假</w>。"
                            }
                        },
                        {
                            "text": "Dziewczyna szepnęła matce, że od rana się <w>pierze</w> i boli ją brzuch.",
                            "target_lang_translations": {
                                "en": "The girl whispered to her mother that she had been <w>having her period</w> since the morning and her stomach hurt.",
                                "ru": "Девушка шепнула матери, что с утра <w>на месячных</w> и у неё болит живот.",
                                "nl": "Het meisje fluisterde haar moeder toe dat ze sinds vanochtend <w>ongesteld was</w> en buikpijn had.",
                                "de": "Das Mädchen flüsterte seiner Mutter zu, dass es seit dem Morgen <w>seine Tage habe</w> und ihm der Bauch wehtue.",
                                "fr": "La jeune fille a chuchoté à sa mère qu'elle <w>avait ses règles</w> depuis le matin et qu'elle avait mal au ventre.",
                                "it": "La ragazza ha sussurrato alla madre che dalla mattina <w>aveva il ciclo</w> e le faceva male la pancia.",
                                "cs": "Dívka pošeptala matce, že od rána <w>má měsíčky</w> a bolí ji břicho.",
                                "tr": "Kız, annesine sabahtan beri <w>adet gördüğünü</w> ve karnının ağrıdığını fısıldadı.",
                                "es": "La chica le susurró a su madre que <w>tenía la regla</w> desde la mañana y que le dolía la tripa.",
                                "zh": "女孩悄悄告诉妈妈，她从早上就<w>来例假</w>了，肚子很疼。"
                            }
                        }
