                "senses": [
                    {
                        "sense_id": "db003cc6-c4f6-3d3a-bf66-f5b8d0645561",
                        "entry_id": "348e9406-3ece-381b-9f4f-29075b61bb7e",
                        "glosses": [
                            "мед. предрасположенность организма к некоторым болезням или болезненным проявлениям вследствие врождённого нарушения обменных процессов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51abd4c2-fa48-427c-b885-c5d5435cb0ab",
                                "sense_id": "db003cc6-c4f6-3d3a-bf66-f5b8d0645561",
                                "text": "Нет настоящего молока, лишь сухое, от которого развивается диатез."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcade403-ea0d-3512-a4c2-77969332ff79",
                        "entry_id": "348e9406-3ece-381b-9f4f-29075b61bb7e",
                        "glosses": [
                            "разг. внешние проявления аллергии (сыпь, покраснение и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc89d25-8611-4d02-8386-f2093b652e17",
                                "sense_id": "dcade403-ea0d-3512-a4c2-77969332ff79",
                                "text": "На Ивантеевской фабрике матери протягивали мне грязных детей, покрытых коростой, пиодермией и диатезом."
                            },
                            {
                                "example_id": "79b08984-5b70-4e18-ba3c-c105bfc2740d",
                                "sense_id": "dcade403-ea0d-3512-a4c2-77969332ff79",
                                "text": "По три дня не ели ничего, потом наедались шоколада до диатеза, до красных пятен, до детских дурацких прыщей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8abc011e-aed5-4633-8808-f1ce40359e31",
                        "source_entry_id": "348e9406-3ece-381b-9f4f-29075b61bb7e",
                        "source_sense_description": "предрасположенность организма к некоторым болезням или болезненным проявлениям",
