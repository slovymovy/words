                ],
                "senses": [
                    {
                        "sense_id": "381f67d6-834b-3502-a584-60b75b5b6bb5",
                        "entry_id": "7443ee30-7262-3250-906a-c2e146393eb4",
                        "glosses": [
                            "Action d’endiguer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b42f99c7-0a6c-4994-bbf8-a8effc5e12b1",
                                "sense_id": "381f67d6-834b-3502-a584-60b75b5b6bb5",
                                "text": "Dans la première année, c’est-à-dire immédiatement après l’endiguement, on a l’habitude d’ensemencer le polder en orge. C’est l’ensemencement qui réussit le mieux dans la terre imparfaitement desséchée et dessalée."
                            },
                            {
                                "example_id": "c74dfb08-2be1-4939-9a62-3d3eeb658d30",
                                "sense_id": "381f67d6-834b-3502-a584-60b75b5b6bb5",
                                "text": "Cet incessant mouvement de flot et de jusant favorise la divagation des chenaux ; l’endiguement a été la seule solution pour les fixer."
                            },
                            {
                                "example_id": "b11a868f-6ecb-4951-aa6b-4c75e0cfb67b",
                                "sense_id": "381f67d6-834b-3502-a584-60b75b5b6bb5",
                                "text": "Tout au plus Biden y mettra la forme et il ajoutera probablement des stratégies d’endiguement économiques aux stratégies d’endiguement militaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff0586ed-415c-3984-a33b-90318ae41da5",
                        "entry_id": "7443ee30-7262-3250-906a-c2e146393eb4",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98fbdad2-2398-43f6-b26d-24e633582172",
                                "sense_id": "ff0586ed-415c-3984-a33b-90318ae41da5",
                                "text": "Actuellement se fait jour une réflexion plus approfondie, doublée d’une volonté de \"décorriger\" les endiguements réalisés par le passé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0586b8f3-4955-3d0c-b2c8-e71c88b92522",
                        "entry_id": "7443ee30-7262-3250-906a-c2e146393eb4",
                        "glosses": [
                            "Stratégie diplomatique qui vise à circonscrire l’influence d’un adversaire, notamment dans les domaines militaire, diplomatique et idéologique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
