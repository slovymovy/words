                    {
                        "sense_id": "aeae33ce-2e6f-302a-8e4b-57008ba4ef83",
                        "entry_id": "1b4ef982-ac17-38d6-8b8b-77b1592984fe",
                        "glosses": [
                            "Person, die im Austausch gegen Zahlungsmittel Speisen und Getränke zum Direktverzehr veräußert"
                        ],
                        "tags": [
                            "outdated",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "154e3f4c-0199-4e5f-b049-14d5136be194",
                                "sense_id": "aeae33ce-2e6f-302a-8e4b-57008ba4ef83",
                                "text": "„Unterließ der Leitgeb dieses, dann wurde er das erstemal in den Stock gelegt und im Wiederholungsfall an den Pranger gestellt. Zum Ausschank des Weines konnte er zwar einen Schankburschen (Weintrager) aufnehmen, mußte jedoch darauf achten, daß dieser weder aus einem vollen noch aus einem am Zapfen liegenden Fasse trinke und so den Weinherrn nicht schädige.“ (1898)"
                            }
                        ],
                        "sense_index_json": "\"1\""
