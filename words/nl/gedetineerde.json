            "pos": "noun",
            "senses": [
                {
                    "sense_id": "588824d9-7b4d-3079-bcf5-bbe8e78079e7",
                    "sense_definition": "iemand die door de staat van zijn vrijheid beroofd is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevangenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gedetineerde</w> wachtte in zijn cel op het bezoek van zijn advocaat.",
                            "target_lang_translations": {
                                "en": "The <w>prisoner</w> waited in his cell for his lawyer's visit."
                            }
                        },
                        {
                            "text": "De <w>gedetineerden</w> kwamen in opstand tegen de slechte behandeling in de gevangenis.",
                            "target_lang_translations": {
                                "en": "The <w>detainees</w> revolted against the poor treatment in the prison."
                            }
                        }
                    ],
                    "synonyms": [
                        "bajesklant",
                        "gevangene"
                    ],
                    "common_phrases": [
                        "vrijlating van gedetineerden",
                        "rechten van gedetineerden"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who has been deprived of their liberty by the state"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prisoner",
                                "target_lang_sense_clarification": "a person incarcerated in a prison"
                            },
                            {
                                "target_lang_word": "detainee",
                                "target_lang_sense_clarification": "someone held in custody, often for political or security reasons"
                            },
                            {
                                "target_lang_word": "inmate",
                                "target_lang_sense_clarification": "a person living in a prison or similar institution"
                            }
                        ]
                    }
                }
            ]
        },
