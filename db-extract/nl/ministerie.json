                                                "example_id": "9b87d427-c315-477b-80cf-6bf409e21864",
                                                "sense_id": "caaa5222-a53f-3a1e-b13e-6e587ff805ed",
                                                "text": "Il passa devant le ministère de la Guerre."
                                            }
