                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607e71c4-09a8-411e-b82e-296c749d5474",
                                "sense_id": "ba97e5ac-9b78-382b-9a29-e8984a13d6e4",
                                "text": "„Die Besanmasten waren längst verschwunden, die Großmasten in vierzig Fuß Höhe abgebrochen, die Fockmasten zwar mehr oder weniger intakt, aber ihrer Wanten beraubt.“"
                            },
                            {
                                "example_id": "cf2136f1-aa54-404f-b9e8-851bc0f2cf83",
                                "sense_id": "ba97e5ac-9b78-382b-9a29-e8984a13d6e4",
                                "text": "„Eines Tages sah Mr. Marchinton mich fast ganz oben am Flaggenknopf des Großmastes, und nachdem er mir befohlen hatte, herunterzukommen, erhielt ich für meine Geschicklichkeit und Unternehmungslust eine ordentliche Tracht Prügel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
