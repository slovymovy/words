                            {
                                "example_id": "1dca2a8e-ea1e-4565-affe-c90119ecbc05",
                                "sense_id": "9ecaa09f-b4de-3aa0-b699-f9792eb2c828",
                                "text": "In general, wood has great tensile strength in more than one direction, which means that when you dig your spade into the ground and pull back on the handle with all your weight, it’s not going to break.",
                                "translation": "En général, le bois a une grande résistance à la traction dans plus d'une direction, ce qui signifie que lorsque vous enfoncez votre bêche dans le sol et que vous tirez sur le manche de tout votre poids, il ne va pas se casser."
                            }
                        ]
                    }
