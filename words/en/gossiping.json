            "senses": [
                {
                    "sense_id": "b3ebea0f-9f35-3e2b-ba7c-95ee89d45804",
                    "sense_definition": "present participle of <w>gossip</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were sitting in the cafe and <w>gossiping</w> about their coworkers.",
                            "target_lang_translations": {
                                "ru": "Они сидели в кафе и <w>сплетничали</w> о своих коллегах."
                            }
                        },
                        {
                            "text": "Stop <w>gossiping</w> behind her back and focus on your own work.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>сплетничать</w> у неё за спиной и сосредоточься на своей работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "chatting",
                        "tattling"
                    ],
                    "common_phrases": [
                        "gossiping about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или форма глагола gossip: сплетничать, суесловить или судачить о ком-то."
                    },
                    "translations": {
