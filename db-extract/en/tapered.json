                    },
                    {
                        "translation_id": "cc70e99d-ab80-4b3b-813a-a0dfdf057487",
                        "source_entry_id": "86620fa4-5ae4-368d-ae5d-55a75d4cc4f2",
                        "source_sense_description": "narrowing to a point",
                        "target_lang_word": "konisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9da99e80-6ec2-3b3a-b97e-3f430b209707",
                                        "entry_id": "835a83e5-eca8-355a-b2e9-bb516a924c55",
                                        "glosses": [
                                            "wie ein Kegel geformt, spitz zusammenlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf10b7fc-cefa-4ad1-b8b1-1777233b4843",
                                                "sense_id": "9da99e80-6ec2-3b3a-b97e-3f430b209707",
                                                "text": "Das Mundstück des Horns ist konisch."
                                            },
                                            {
                                                "example_id": "f41356cc-aeca-4953-8e5c-039e502e8a7c",
                                                "sense_id": "9da99e80-6ec2-3b3a-b97e-3f430b209707",
                                                "text": "„Das Schleusentor war gebogen und vermutlich deswegen konisch, damit es den Raum luftdicht abschließend konnte.“"
                                            },
                                            {
                                                "example_id": "11f899ba-0207-4327-995c-80231424c110",
                                                "sense_id": "9da99e80-6ec2-3b3a-b97e-3f430b209707",
                                                "text": "„Darunter war die gerade, leicht konische Säule mit ihrer von Rot über Violett nach Blau changierenden Rinde.“"
                                            },
                                            {
                                                "example_id": "df788537-d18a-418e-a3e6-dbc9f216f296",
                                                "sense_id": "9da99e80-6ec2-3b3a-b97e-3f430b209707",
                                                "text": "„Durch das konische Dach aus Glas fiel ein ruhiges, milchiges Licht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
