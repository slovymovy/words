                                                "sense_id": "b41dea32-40c2-3226-bfe0-b4713e497379",
                                                "text": "벽에 못을 박다."
                                            },
                                            {
                                                "example_id": "1ba42bfc-bb85-40d2-93c9-707c3f82732e",
                                                "sense_id": "b41dea32-40c2-3226-bfe0-b4713e497379",
                                                "text": "못 박다 - 어떠한 것을 깊이 간직하다."
                                            },
