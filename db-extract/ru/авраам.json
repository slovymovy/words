                            },
                            {
                                "target_word": "Abraham",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fb73f25-043d-34c5-a02f-c2bcc0c74731",
                                        "entry_id": "fcdfc30f-c101-32e4-b096-b0aa2e8ef269",
