                "translations": [
                    {
                        "translation_id": "0d973c83-fc38-4c5d-be95-ee789e70761a",
                        "source_entry_id": "99d8ee16-67b8-37a3-bad6-2d3b31c179e2",
                        "source_sense_id": "4506fd6c-d9c5-3aec-89f3-5886c0abf6df",
                        "target_lang_word": "email",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "email",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "825c3653-1ad0-3ff5-ae25-2fce78bc0762",
                                        "entry_id": "6fd27708-7591-3d1e-b0dd-8b7402cbee7d",
                                        "glosses": [
                                            "A system for sending messages and datas by means of computers connected together in a network."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da78ac01-040a-4935-a2d0-1804da5e7115",
                                                "sense_id": "825c3653-1ad0-3ff5-ae25-2fce78bc0762",
                                                "text": "He sent me his details via email."
                                            },
                                            {
                                                "example_id": "a4b1d081-8339-4472-9bc8-96044e0f2d91",
                                                "sense_id": "825c3653-1ad0-3ff5-ae25-2fce78bc0762",
                                                "text": "The advent of email has simultaneously brought our society closer together and farther apart."
                                            },
                                            {
                                                "example_id": "7860db59-b2dc-46c4-96df-a1b274b2cdd4",
                                                "sense_id": "825c3653-1ad0-3ff5-ae25-2fce78bc0762",
                                                "text": "Please stop sending me “constructive criticisms” via email, or telling me that “ I feel you are being defensive”, especially just after I have told you “you’re loved”. “Rewards” like that are horrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1dc6b1a-77d1-3dde-9594-ecff632996ad",
                                        "entry_id": "6fd27708-7591-3d1e-b0dd-8b7402cbee7d",
                                        "glosses": [
                                            "The quantity of messages sent through an email system."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bf61d2f-7bf3-469a-b168-ce6a86e37f82",
                                                "sense_id": "f1dc6b1a-77d1-3dde-9594-ecff632996ad",
                                                "text": "I am searching through my old email."
                                            },
                                            {
                                                "example_id": "243268d5-92da-424f-9fe7-8b8503769ef3",
                                                "sense_id": "f1dc6b1a-77d1-3dde-9594-ecff632996ad",
                                                "text": "My inbox used to allow only 50 MB of email at a time until last year, when they upgraded it to 2 GBs!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9bc633-5e1e-36cf-8ae1-2570ba3d5315",
                                        "entry_id": "6fd27708-7591-3d1e-b0dd-8b7402cbee7d",
                                        "glosses": [
                                            "A message being sent through email."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c75be5-e0c7-4121-a1f2-161035ee116a",
                                                "sense_id": "7b9bc633-5e1e-36cf-8ae1-2570ba3d5315",
                                                "text": "He sent me an email last week to remind me about the meeting."
                                            },
                                            {
                                                "example_id": "cb998fdf-e770-4163-854b-d7f635dea21a",
                                                "sense_id": "7b9bc633-5e1e-36cf-8ae1-2570ba3d5315",
                                                "text": "I archive my old emails using a cloud-based service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7ee9a28-ac51-3664-bf37-7fc328ff70a3",
                                        "entry_id": "6fd27708-7591-3d1e-b0dd-8b7402cbee7d",
                                        "glosses": [
                                            "An email address."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50768d1-82b6-4d26-97c4-bbd94deafbfa",
                                                "sense_id": "b7ee9a28-ac51-3664-bf37-7fc328ff70a3",
                                                "text": "What’s your email?"
                                            },
                                            {
                                                "example_id": "49f3d34e-a25b-4d3d-9c45-62cbd3e0e792",
                                                "sense_id": "b7ee9a28-ac51-3664-bf37-7fc328ff70a3",
                                                "text": "In this system, your username is your email."
                                            },
                                            {
                                                "example_id": "a73ea54c-5164-491c-9396-6801f77cd4c1",
                                                "sense_id": "b7ee9a28-ac51-3664-bf37-7fc328ff70a3",
                                                "text": "Don’t send personal messages to my work email."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "email",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b261700-9fbc-3e09-aac2-bbec7f46d897",
                                        "entry_id": "764d3907-9233-334d-81fc-1ba924678846",
                                        "glosses": [
                                            "To send an email or emails to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d6410d-b1c9-489c-ab2a-91deb44fbe4e",
                                                "sense_id": "1b261700-9fbc-3e09-aac2-bbec7f46d897",
                                                "text": "She emailed me last week, asking about the status of the project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c476706-456c-3902-9ef3-7a1574fdd773",
                                        "entry_id": "764d3907-9233-334d-81fc-1ba924678846",
                                        "glosses": [
                                            "To send (data) through email."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35891916-b1a2-4d6a-af4b-e02e7590d4ab",
                                                "sense_id": "2c476706-456c-3902-9ef3-7a1574fdd773",
                                                "text": "I’ll email you the link."
                                            },
                                            {
                                                "example_id": "ff2c7c96-87b0-41c1-b28d-5747b6168f19",
                                                "sense_id": "2c476706-456c-3902-9ef3-7a1574fdd773",
                                                "text": "He emailed the file out to everyone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab1d0d1-f51b-342a-87ea-493ae28912d1",
                                        "entry_id": "764d3907-9233-334d-81fc-1ba924678846",
                                        "glosses": [
                                            "To send, or compose and then send, one or more emails."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daf70886-07a3-46d8-994d-7c4b21e0e83b",
                                                "sense_id": "dab1d0d1-f51b-342a-87ea-493ae28912d1",
                                                "text": "Most teenagers seem to spend almost the whole day emailing and surfing the Web."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "email",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe54f409-db12-3a21-a398-9eb8151e4353",
                                        "entry_id": "18971b8d-9106-35cb-a067-3972199a23a0",
                                        "glosses": [
                                            "Enamel (“an opaque, glossy coating”)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eb36f15-1f62-4999-b6e2-6e157d49efac",
                                                "sense_id": "fe54f409-db12-3a21-a398-9eb8151e4353",
                                                "text": "Set Naples courser to an asse, / Fine emerawde vnto greene glasse: / Set rich rubye to redd emayle, / The raven's plume to peacocke's tayle: / [...] / There shall no less an oddes be seene, / In myne from everye other Queene!"
                                            },
                                            {
                                                "example_id": "2bd515e0-9b05-4e78-b06c-1ab17775152d",
                                                "sense_id": "fe54f409-db12-3a21-a398-9eb8151e4353",
                                                "text": "It is reported, that the Pope long ſince gaue them [the people of Iceland] a diſpenſation to receiue the Sacrament in ale, inſomuch as for their vnceſſant froſts there, no wine but was turned to red emayle, as ſoone as euer it came amongſt them."
                                            },
                                            {
                                                "example_id": "a9533550-1acb-4866-8ee0-408dc6effee7",
                                                "sense_id": "fe54f409-db12-3a21-a398-9eb8151e4353",
                                                "text": "Another part of this Earth being mixt with an equal part of its Salt, and put on the Fire to melt, in part pierc'd thro the Crucible, which was found on the outside, as it were, lin'd with a Brown Email, and the inside of the Crucible was cover'd with a Clear-Red Email."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a88d265-a6ae-429b-a059-67322eb80a41",
                        "source_entry_id": "99d8ee16-67b8-37a3-bad6-2d3b31c179e2",
                        "source_sense_id": "4506fd6c-d9c5-3aec-89f3-5886c0abf6df",
                        "target_lang_word": "e-mail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e-mail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bffa3ea-59e1-37f4-a3ca-e7cbbd0c254d",
                                        "entry_id": "f367a02c-2eb2-30c6-9f37-58c0a3ababa5",
                                        "glosses": [
                                            "Alternative form of email."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e12fd72d-5506-403c-902d-eb9b5ab420ce",
                                                "sense_id": "0bffa3ea-59e1-37f4-a3ca-e7cbbd0c254d",
                                                "text": "I finally figured out what e-mail is for. it's for communicating with people you'd rather not talk to."
                                            },
                                            {
                                                "example_id": "eec00ca0-f209-478a-baea-50c84b32f3a6",
                                                "sense_id": "0bffa3ea-59e1-37f4-a3ca-e7cbbd0c254d",
                                                "text": "She had been crushed for two whole days by an e-mail from her betrothed, which had announced that he had married a British woman."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "e-mail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "611f7f75-4475-3e0a-9ee9-503ee9eba657",
                                        "entry_id": "e8456353-5a3f-32cb-b535-42a46076edc2",
                                        "glosses": [
                                            "Alternative form of email."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1544742-8652-447c-b384-edb9deb51a3e",
                                                "sense_id": "611f7f75-4475-3e0a-9ee9-503ee9eba657",
                                                "text": "In a poll released last week, the AAA Foundation for Traffic Safety found that 58 percent of drivers consider other motorists talking on a cellphone to be a very serious threat and that 87 percent consider motorists e-mailing or texting to be such a threat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
