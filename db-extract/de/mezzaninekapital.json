                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a00561f-c963-40d0-be75-81f7fffae8dd",
                                "sense_id": "708f92e9-1306-35f9-8ce0-bff78e9c452b",
                                "text": "„Im internen Ratingprozess der Banken, der durch BASEL II erheblich an Bedeutung gewinnt, wird Mezzaninekapital als wirtschaftliches Eigenkapital gesehen. “"
                            },
                            {
                                "example_id": "48ff993b-46db-4810-ac02-2fc101734693",
                                "sense_id": "708f92e9-1306-35f9-8ce0-bff78e9c452b",
                                "text": "„Bei den heutigen Herausforderungen der Kapitalbeschaffung von Unternehmen bietet Mezzaninekapital eine mittelstandsorientierte Lösung.“"
                            },
                            {
                                "example_id": "1d53b775-8a40-4159-aa7b-43e28f9260f4",
                                "sense_id": "708f92e9-1306-35f9-8ce0-bff78e9c452b",
                                "text": "„Mezzaninekapital wird aus dem künftigen Cash-flow zurückgezahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
