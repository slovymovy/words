                "senses": [
                    {
                        "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                        "entry_id": "be897d81-6b95-3f03-80e2-6cb5000f0ce6",
                        "glosses": [
                            "The quantity contained in a wallet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fa55d50-4a40-4a29-8a9d-0a8d645f1d08",
                                "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                                "text": "1653, John Davies (translator), The Extravagant Shepherd by Charles Sorel, London: Thomas Heath, Book 10, p. 244,\nI would have thee bring away with thee a Wallet-full of the Good thou shalt find, that thou mayst never more complain of being unhappy."
                            },
                            {
                                "example_id": "14108dec-08c8-46df-81a6-a32a60910d9a",
                                "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                                "text": "Ah, troubled human people, sweeping past, glad of the momentary level of the road, and with no leisure to linger, or to see how nature smiles out of her superior happiness at you and your walletful of cares!"
                            },
                            {
                                "example_id": "a5ddb4b8-981a-4d5b-b144-cb9ea93963a8",
                                "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                                "text": "And when the seven among the four thousand, how many walletsful of fragments ye took up?"
                            },
                            {
                                "example_id": "ee5ea658-5b0a-47f2-bbb5-88861e8a8180",
                                "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                                "text": "[…] when he won he did not go off with a walletful of his friends’ money."
                            },
                            {
                                "example_id": "4dd4bffa-2af8-4021-94f7-09f785a7e0c6",
                                "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                                "text": "The elderly couple seated beside me […] have told me in an hour’s flight time all about their children and grandchildren in Cincinnati (with, of course, a walletful of visual aids) […]"
                            },
                            {
                                "example_id": "d0637c20-595a-46a1-8cfd-cc71064afaa9",
                                "sense_id": "98e77469-6959-36ae-8361-5ae17d41de9e",
                                "text": "By mid morning I was in Madison, Wis. With $37 and a walletful of easily traced and therefore unusable credit and ATM cards."
                            }
                        ]
                    }
                ],
