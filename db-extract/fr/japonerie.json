                        "examples": [
                            {
                                "example_id": "a6c5feb4-3dcb-4e02-93d5-9069a64ece96",
                                "sense_id": "cda9a0b9-0b8a-3ca4-bd75-a4a351ec2d54",
                                "text": "Pierre Loti a publié en 1889 un ouvrage intitulé Japoneries d'automne."
                            },
                            {
                                "example_id": "cf53ef3c-f8ef-4296-927d-abbb818ec361",
                                "sense_id": "cda9a0b9-0b8a-3ca4-bd75-a4a351ec2d54",
                                "text": "« Un maître fourbe », affirmait Goncourt, qui l’avait beaucoup fréquenté. Le fait est que, de sa voix onctueuse et caressante, ce collectionneur de japoneries et de calomnies débinait férocement tous ses contemporains."
                            },
                            {
                                "example_id": "09c33d45-84ed-40dc-8733-550f206e5bbc",
                                "sense_id": "cda9a0b9-0b8a-3ca4-bd75-a4a351ec2d54",
                                "text": "Louise, reconvertie à la japonerie, zen d’allure, de nourriture et de mobilier, vit un conte de fées exotique."
                            }
                        ]
                    }
