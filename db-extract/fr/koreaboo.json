                                        "glosses": [
                                            "A non-Korean person who is obsessed with Korean culture (especially K-pop or K-dramas)."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2891b9fe-4ce6-4d2a-af9b-0c744cf803c4",
                                                "sense_id": "d78e1e7d-2e4f-38f7-b0d1-b3085d7ec96d",
                                                "text": "These “koreaboos” idealize my culture and cast me as a player in their K-drama fantasies, expecting me to look and act as such."
                                            },
                                            {
                                                "example_id": "ace4dedd-d880-4745-9db1-91701607f614",
                                                "sense_id": "d78e1e7d-2e4f-38f7-b0d1-b3085d7ec96d",
                                                "text": "I wanted to feel superior to the Kpop-obsessed koreaboos at camp who held up double Victory signs in all their pictures."
                                            },
                                            {
                                                "example_id": "a76b12ba-aded-4bfb-98f4-f5abbeadcaaa",
                                                "sense_id": "d78e1e7d-2e4f-38f7-b0d1-b3085d7ec96d",
                                                "text": "South Korean actor Ji Soo makes his way to capture the hearts of Filipino koreaboos as the newest member of Team Penshoppe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
