                "senses": [
                    {
                        "sense_id": "65c64e15-123c-3b39-9877-e805f093351d",
                        "entry_id": "523dda92-ec71-3538-997c-740d18a15d67",
                        "glosses": [
                            "Algue unicellulaire du genre Symbiodinium, généralement de couleur brune, que l’on trouve en particulier dans les récifs de coraux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a19aaa5-1d2f-4258-a34a-d856cc77e029",
                                "sense_id": "65c64e15-123c-3b39-9877-e805f093351d",
                                "text": "Pour vivre, chaque polype loge dans ses tissus des algues microscopiques unicellulaires, les zooxanthelles qui, par photosynthèse, lui apportent la nourriture et l’oxygène nécessaires à son développement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "622136dc-87b1-44da-9d8f-d4573ae4f997",
                        "source_entry_id": "523dda92-ec71-3538-997c-740d18a15d67",
                        "source_sense_id": "65c64e15-123c-3b39-9877-e805f093351d",
                        "target_lang_word": "Zooxanthelle",
                        "target_lang_code": "de",
