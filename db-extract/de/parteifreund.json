                ],
                "senses": [
                    {
                        "sense_id": "2309fa90-399a-36d4-bb9c-3e929053e6db",
                        "entry_id": "7eae07d3-ed93-3f2a-9af2-edca1a471770",
                        "glosses": [
                            "Person, die in derselben Partei wie eine andere ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba51aac-d0ff-4525-9eac-62fe766f6089",
                                "sense_id": "2309fa90-399a-36d4-bb9c-3e929053e6db",
                                "text": "Sein Parteifreund erklärte ihm die Geschäftsordnung für die Sitzung."
                            },
                            {
                                "example_id": "57c02450-38e6-4ed0-aaeb-088cc640f3bd",
                                "sense_id": "2309fa90-399a-36d4-bb9c-3e929053e6db",
                                "text": "„Was ist die Steigerung von Feind?“, fragt der eine Clown den anderen. „Feind, Erzfeind, Parteifreund!“."
                            },
                            {
                                "example_id": "5cf154b4-81a3-49f4-bf6c-1a319e75fbca",
                                "sense_id": "2309fa90-399a-36d4-bb9c-3e929053e6db",
                                "text": "„Als am Sonntagabend die ersten Prognosen zur Landtagswahl in Nordrhein-Westfalen auf dem Fernsehmonitor auftauchen, steht Schulz neben seinen Parteifreunden im Kölner Rathaus und schweigt.“"
                            },
                            {
                                "example_id": "581972ef-c7d5-47d2-9c87-47b7d1b93fbe",
                                "sense_id": "2309fa90-399a-36d4-bb9c-3e929053e6db",
                                "text": "„Die in Tanganyika verweilenden ZAPU-Politiker wollten Nkomo nun loswerden und ließen ihre Parteifreunde in der Heimat wissen, sie würden Nkomo nicht mehr unterstützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
