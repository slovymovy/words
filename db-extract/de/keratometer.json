                "senses": [
                    {
                        "sense_id": "438c6890-865f-35f2-a7d0-f24607fc533f",
                        "entry_id": "0fdb2ab0-f555-3343-aaa7-f5aa0b182804",
                        "glosses": [
                            "Instrument zur Messung der Oberflächenkrümmung der Hornhaut"
                        ],
                        "tags": [
                            "Augenheilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "d2fad217-22ac-4f8e-a5c1-54790547832c",
                                "sense_id": "438c6890-865f-35f2-a7d0-f24607fc533f",
                                "text": "„Die Hornhautkrümmung wird mit dem Keratometer gemessen und in Radius (mm) oder Brechungsstärke (dpt) angegeben.“"
                            },
                            {
                                "example_id": "e205cd6c-e516-4766-8406-4adc1640a04f",
                                "sense_id": "438c6890-865f-35f2-a7d0-f24607fc533f",
                                "text": "„Die Linsenstärke wurde nach Keratometrie mit dem Keratometer nach Zeiss und sonographischer Achsenlängenmessung auf eine Refraktion von –0.75 dpt berechnet.“"
                            },
                            {
                                "example_id": "b863912c-5075-4590-84c2-5d93b75cb093",
                                "sense_id": "438c6890-865f-35f2-a7d0-f24607fc533f",
                                "text": "„Die Pupillenablesungen erfolgten mit dem Keratometer von WESSELY im verdunkelten Raum bei künstlicher Beleuchtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
