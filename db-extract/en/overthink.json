                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b81c0fb-b246-4074-b5d7-1504d5d74fb5",
                                                "sense_id": "2f2f103e-63d4-3454-bf1b-8541584b1e8b",
                                                "text": "Es wehte eine steife Brise, die die Santa Maria weit nach Backbord überlegen ließ."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überlegen",
