{
    "word_family": [
        "counterfeiter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f72ae19-9750-38b7-8e56-7e2218f02cc5",
                    "sense_definition": "Made in imitation of something genuine with the intent to deceive or defraud.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopkeeper refused to accept the cash because it was a <w>counterfeit</w> bill.",
                            "target_lang_translations": {
                                "ru": "Продавец отказался принять наличные, так как банкнота была <w>фальшивой</w>."
                            }
                        },
                        {
                            "text": "Authorities confiscated thousands of <w>counterfeit</w> watches at the airport.",
                            "target_lang_translations": {
                                "ru": "Власти конфисковали в аэропорту тысячи <w>поддельных</w> часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "forged",
                        "fraudulent",
                        "spurious"
                    ],
                    "antonyms": [
                        "authentic",
                        "genuine",
                        "real"
                    ],
                    "common_phrases": [
                        "counterfeit money",
                        "counterfeit goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный в качестве имитации подлинного с целью обмана или мошенничества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддельный",
                                "target_lang_sense_clarification": "сфальсифицированный, неоригинальный"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "о деньгах, документах или товарах"
                            },
                            {
                                "target_lang_word": "контрафактный",
                                "target_lang_sense_clarification": "о нелегально воспроизведённой продукции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41305980-d1c3-3611-b32a-167c52b31ecc",
                    "sense_definition": "Insincere, feigned, or hypocritical.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adj_fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered an apology, but her <w>counterfeit</w> sorrow failed to convince anyone.",
                            "target_lang_translations": {
                                "ru": "Она извинилась, но её <w>притворная</w> скорбь никого не убедила."
                            }
                        },
                        {
                            "text": "His <w>counterfeit</w> enthusiasm for the project quickly vanished when real work began.",
                            "target_lang_translations": {
                                "ru": "Его <w>наигранный</w> энтузиазм по поводу проекта быстро испарился, когда началась настоящая работа."
                            }
                        }
                    ],
                    "synonyms": [
                        "feigned",
                        "insincere",
                        "pretended"
                    ],
                    "antonyms": [
                        "sincere",
                        "heartfelt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неискренний, притворный или лицемерный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворный",
                                "target_lang_sense_clarification": "напускной, разыгранный"
                            },
                            {
                                "target_lang_word": "наигранный",
                                "target_lang_sense_clarification": "неестественный, неискренний"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "о чувствах или эмоциях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1cc490c-eaf8-3496-8ca1-7a2dabede5ad",
                    "sense_definition": "Assuming the false appearance of something; deceitful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adj_fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved to be a <w>counterfeit</w> friend who only sought personal gain.",
                            "target_lang_translations": {
                                "ru": "Он оказался <w>фальшивым</w> другом, искавшим лишь личную выгоду."
                            }
                        },
                        {
                            "text": "The kingdom was brought to ruin by a <w>counterfeit</w> nobleman plotting treason.",
                            "target_lang_translations": {
                                "ru": "Королевство было разорено <w>мнимым</w> дворянином, замышлявшим измену."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceitful",
                        "hypocritical"
                    ],
                    "antonyms": [
                        "honest",
                        "trustworthy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts to describe deceitful persons"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимающий ложный облик; двуличный, лживый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "ненастоящий, мнимый"
                            },
                            {
                                "target_lang_word": "мнимый",
                                "target_lang_sense_clarification": "кажущийся, самозваный"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "двуличный, лицемерный (о человеке)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5083b22-07dd-307e-9696-6a04fdcba60f",
                    "sense_definition": "An imitation intended to be passed off fraudulently as genuine; a forgery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experts quickly determined that the antique painting was merely a clever <w>counterfeit</w>.",
                            "target_lang_translations": {
                                "ru": "Эксперты быстро установили, что старинная картина была всего лишь искусной <w>подделкой</w>."
                            }
                        },
                        {
                            "text": "Never mistake an obvious <w>counterfeit</w> for the genuine article.",
                            "target_lang_translations": {
                                "ru": "Никогда не принимайте очевидную <w>фальшивку</w> за оригинал."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "forgery",
                        "imitation"
                    ],
                    "antonyms": [
                        "original"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имитация, выдаваемая обманным путём за оригинал; фальшивка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подделка",
                                "target_lang_sense_clarification": "имитация подлинной вещи"
                            },
                            {
                                "target_lang_word": "фальшивка",
                                "target_lang_sense_clarification": "поддельный предмет или документ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4a62fba-43a2-30f9-8807-d6578678b0e8",
                    "sense_definition": "An impostor, pretender, or cheat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man claiming to be the long-lost prince was exposed as a <w>counterfeit</w>.",
                            "target_lang_translations": {
                                "ru": "Мужчина, выдававший себя за давно потерянного принца, был разоблачён как <w>самозванец</w>."
                            }
                        },
                        {
                            "text": "He played the hero well, but in truth he was nothing more than a cowardly <w>counterfeit</w>.",
                            "target_lang_translations": {
                                "ru": "Он хорошо играл роль героя, но на самом деле был всего лишь трусливым <w>притворщиком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "impostor",
                        "charlatan",
                        "fraud"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Now rarely used to refer to a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самозванец, притворщик или обманщик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самозванец",
                                "target_lang_sense_clarification": "человек, выдающий себя за другого"
                            },
                            {
                                "target_lang_word": "притворщик",
                                "target_lang_sense_clarification": "лицемер, обманщик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b057628-867b-3b3e-92db-aa7b3094db09",
                    "sense_definition": "One who counterfeits; a counterfeiter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The notorious <w>counterfeit</w> managed to evade law enforcement for more than a decade.",
                            "target_lang_translations": {
                                "ru": "Печально известному <w>фальшивомонетчику</w> удавалось скрываться от правоохранительных органов более десяти лет."
                            }
                        },
                        {
                            "text": "Detectives raided the workshop where the skilled <w>counterfeit</w> operated his illicit press.",
                            "target_lang_translations": {
                                "ru": "Детективы устроили облаву на мастерскую, где умелый <w>поддельщик</w> использовал нелегальный печатный станок."
                            }
                        }
                    ],
                    "synonyms": [
                        "counterfeiter",
                        "forger"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Largely superseded by counterfeiter"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто занимается изготовлением подделок; фальшивомонетчик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальшивомонетчик",
                                "target_lang_sense_clarification": "изготовитель поддельных денег"
                            },
                            {
                                "target_lang_word": "поддельщик",
                                "target_lang_sense_clarification": "тот, кто подделывает документы или вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8060c63-8fa3-3ff7-b7f0-f7b6e8a07838",
                    "sense_definition": "That which resembles another thing; a portrait, likeness, or counterpart.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter produced a striking <w>counterfeit</w> of the royal visage.",
                            "target_lang_translations": {
                                "ru": "Художник создал поразительно точный <w>портрет</w> королевской особы."
                            }
                        },
                        {
                            "text": "She looked upon the miniature <w>counterfeit</w> of her beloved with quiet melancholy.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на миниатюрное <w>изображение</w> своего возлюбленного с тихой меланхолией."
                            }
                        }
                    ],
                    "synonyms": [
                        "likeness",
                        "portrait",
                        "counterpart"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in early modern English for a portrait or likeness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точное подобие, портрет или отображение чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобие",
                                "target_lang_sense_clarification": "сходство, воспроизведение облика"
                            },
                            {
                                "target_lang_word": "портрет",
                                "target_lang_sense_clarification": "изображение, образ лица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b66542b-dd31-315f-a08f-d71564de64ae",
                    "sense_definition": "To falsely produce or forge a copy of something with the intent to deceive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_imitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal syndicate attempted to <w>counterfeit</w> foreign currency using modern printers.",
                            "target_lang_translations": {
                                "ru": "Преступный синдикат попытался <w>подделать</w> иностранную валюту с помощью современных принтеров."
                            }
                        },
                        {
                            "text": "It is a serious crime to <w>counterfeit</w> government documents or signatures.",
                            "target_lang_translations": {
                                "ru": "<w>Подделывать</w> государственные документы или подписи — тяжкое преступление."
                            }
                        }
                    ],
                    "synonyms": [
                        "forge",
                        "fake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготовлять фальшивую копию чего-либо с целью обмана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подделывать",
                                "target_lang_sense_clarification": "фальсифицировать вещи, деньги, подписи (несов. вид)"
                            },
                            {
                                "target_lang_word": "подделать",
                                "target_lang_sense_clarification": "сделать фальшивую копию (сов. вид)"
                            },
                            {
                                "target_lang_word": "фальсифицировать",
                                "target_lang_sense_clarification": "изготавливать подделки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "061491ed-b510-302c-9e42-1c81a6983bf8",
                    "sense_definition": "To simulate, feign, or mimic an emotion, action, or voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_imitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>counterfeit</w> sleep until the intruders left the bedroom.",
                            "target_lang_translations": {
                                "ru": "Ему удавалось <w>притворяться</w> спящим, пока незваные гости не покинули спальню."
                            }
                        },
                        {
                            "text": "She tried to <w>counterfeit</w> amusement at his crude jokes, but her smile was strained.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>сымитировать</w> веселье в ответ на его грубые шутки, но её улыбка была натянутой."
                            }
                        }
                    ],
                    "synonyms": [
                        "feign",
                        "simulate",
                        "mimic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имитировать, симулировать или изображать чувство, действие или голос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симулировать",
                                "target_lang_sense_clarification": "притворно изображать состояние или действие"
                            },
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "разыгрывать что-либо"
                            },
                            {
                                "target_lang_word": "подделывать",
                                "target_lang_sense_clarification": "имитировать голос или интонацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68e0808b-8d52-358c-be24-34819d326fc3",
                    "sense_definition": "To produce a faithful or exact copy of an original object or image.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_imitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The illustrator strove to <w>counterfeit</w> the natural beauty of the rare flowers.",
                            "target_lang_translations": {
                                "ru": "Иллюстратор стремился в точности <w>воспроизвести</w> природную красоту редких цветов."
                            }
                        },
                        {
                            "text": "Ancient scholars sought to faithfully <w>counterfeit</w> earlier manuscripts before they decayed.",
                            "target_lang_translations": {
                                "ru": "Древние учёные стремились достоверно <w>скопировать</w> ранние манускрипты до того, как они истлеют."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduce",
                        "copy",
                        "portray"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used without negative connotation for copying or portraying"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать точную или верную копию оригинала или изображения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспроизводить",
                                "target_lang_sense_clarification": "точно копировать, воссоздавать"
                            },
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "в точности перерисовывать или переписывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b8c49b9-4c35-3ca0-a77a-f5b7ea0b608b",
                    "sense_definition": "In poker, to invalidate or devalue a player's hand by putting a card on the board that creates an equal or better combination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paired board on the river was able to <w>counterfeit</w> his two small pairs.",
                            "target_lang_translations": {
                                "ru": "Спарка на ривере смогла <w>обесценить</w> его две младшие пары."
                            }
                        },
                        {
                            "text": "A second king appeared on the turn, which threatened to <w>counterfeit</w> her holding.",
                            "target_lang_translations": {
                                "ru": "На терне появился второй король, что грозило <w>обесценить</w> её комбинацию."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В покере: обесценивать комбинацию игрока появлением на столе карты, создающей лучшую или равную общую комбинацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обесценивать",
                                "target_lang_sense_clarification": "в покере: делать руку менее значимой"
                            },
                            {
                                "target_lang_word": "обесценить",
                                "target_lang_sense_clarification": "в покере: ухудшить силу руки картой борда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}