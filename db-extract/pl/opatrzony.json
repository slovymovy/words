                ],
                "senses": [
                    {
                        "sense_id": "6703a1e4-677e-3fea-8a7f-2d97f5df5b4e",
                        "entry_id": "7c5dfacf-a087-3687-bf7a-a93498a56e32",
                        "glosses": [
                            "zaopatrzony w co"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05fdb9f8-2d8b-4694-8a8b-5274b2e80f2c",
                                "sense_id": "6703a1e4-677e-3fea-8a7f-2d97f5df5b4e",
                                "text": "Polerowane, twarde nasionka, opatrzone puszystym latawcem"
                            },
                            {
                                "example_id": "b67fd122-1a25-46be-bb4d-d1705168540b",
                                "sense_id": "6703a1e4-677e-3fea-8a7f-2d97f5df5b4e",
                                "text": "Układ krwionośny jest tu zamknięty, ścianki naczyń kurczliwe, a same naczynia najczęściej opatrzone zastawkami, tak że obieg krwi odbywa się w sposób prawidłowy"
                            },
                            {
                                "example_id": "a77f7616-472c-4d61-a401-6ab0e8d954f3",
                                "sense_id": "6703a1e4-677e-3fea-8a7f-2d97f5df5b4e",
                                "text": "”, szyderską jest i wzgardliwą"
                            },
                            {
                                "example_id": "576067b6-f4c3-4b02-bdb4-43239373fa6a",
                                "sense_id": "6703a1e4-677e-3fea-8a7f-2d97f5df5b4e",
                                "text": "Nie jest nędzny, kto jest opatrzony w siły do pracy zdolne, kto za pomocą rozumu równych sobie istot[,] rękom własnym ulżyć potrafi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
