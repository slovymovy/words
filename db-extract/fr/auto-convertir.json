                "senses": [
                    {
                        "sense_id": "6ae9d5b5-147c-33e9-8f4f-d27f7c2d49a6",
                        "entry_id": "2c70e543-6101-32b8-9a95-52e400c24cb8",
                        "glosses": [
                            "Convertir automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd4ba14-a94c-4682-a13f-7a3bc09b5ad0",
                                "sense_id": "6ae9d5b5-147c-33e9-8f4f-d27f7c2d49a6",
                                "text": "Le menu utilise les propriétés 3D du CSS et vient comme un plugin jQuery qui auto-convertit tous les éléments de la liste."
                            },
                            {
                                "example_id": "f605335a-bc4d-4da8-bda8-216720240500",
                                "sense_id": "6ae9d5b5-147c-33e9-8f4f-d27f7c2d49a6",
                                "text": ".La conversion analogique-numérique dans ce module utilise un échantillonnage 10 bits à 162MSPS max., l'expansion du niveau de noir / blanc, l'amélioration de la transition des couleurs, l'expansion de la gamme dynamique, le blue stretch, auto-détecte et auto-convertit le signal composite en sortie 1080p (60Hz)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac1eee8e-565d-35be-9e3f-41e60eec0c24",
                        "entry_id": "2c70e543-6101-32b8-9a95-52e400c24cb8",
                        "glosses": [
                            "Se convertir soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2001be83-6547-4574-a828-861ba0a8ff2a",
                                "sense_id": "ac1eee8e-565d-35be-9e3f-41e60eec0c24",
                                "text": "Et si on s'auto-convertit qu'est-ce qu'on gagne, un bon d'achat à échanger contre un paquet de chupas ?"
                            }
                        ]
