                    {
                        "translation_id": "d73718b2-4bab-442e-b640-4a493a63d0d6",
                        "source_entry_id": "3e5f3d9e-6836-3423-a821-5e7ae4c17ece",
                        "source_sense_description": "able to be thought or imagined; conceivable",
                        "target_lang_word": "denkbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denkbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5054728e-de1c-39c2-ae7d-cbe182339197",
                                        "entry_id": "fa804c94-54aa-38f6-918b-f6364a91295a",
                                        "glosses": [
                                            "wat mogelijk is maar nog niet bewezen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8dadafb-72c8-4684-bc03-b0756f83eb8e",
                                                "sense_id": "5054728e-de1c-39c2-ae7d-cbe182339197",
                                                "text": "Het is eigenlijk niet denkbaar dat een mens 5000 km kan hardlopen in minder dan 50 dagen en toch gebeurt dat ieder jaar in New-York."
                                            },
                                            {
                                                "example_id": "b81e2826-2dff-4256-9605-0a13ccf746df",
                                                "sense_id": "5054728e-de1c-39c2-ae7d-cbe182339197",
                                                "text": "Volgens de wetenschappers is het denkbaar dat het om een brokstuk gaat van de planetoïde die in botsing is gekomen met het moederlichaam van de L-chondrieten. Ze suggereren dat er al lang niets meer van deze planetoïde over is"
                                            },
                                            {
                                                "example_id": "ff670a60-d19a-4106-b644-828447daaf5d",
                                                "sense_id": "5054728e-de1c-39c2-ae7d-cbe182339197",
                                                "text": "Toch had zowel de Luftwaffe als het Duitse leger de overwonnen Engelsen bij Duinkerken op de mildst denkbare manier behandeld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fbc9728-eaa5-4125-a3a4-17e83e5a4a00",
                        "source_entry_id": "3e5f3d9e-6836-3423-a821-5e7ae4c17ece",
                        "source_sense_description": "able to be thought or imagined; conceivable",
                        "target_lang_word": "pensable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pensable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d40f18f-761c-3735-85a2-df3447f6eb94",
                                        "entry_id": "164adb46-47e9-3337-ab0d-ac21a6081b2a",
                                        "glosses": [
                                            "Ce qui peut être pensé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7665e5-3500-425f-b6f8-ac746ba89077",
                                                "sense_id": "4d40f18f-761c-3735-85a2-df3447f6eb94",
                                                "text": "Et si une certaine « sécularisation du pensable » définit irréversiblement notre situation herméneutique, cela n'empêche pas Certeau d'examiner comment, dans cette donne nouvelle, le christianisme demeure pensable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pensable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66861e3a-5f34-3d13-b3ca-d4e5c6ec771b",
                                        "entry_id": "0923812a-0e3f-3cf7-9ef8-66d8c24cfae7",
                                        "glosses": [
                                            "Qui peut être imaginé, envisagé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "518d38fa-ccfd-4f0e-8e0e-a91da69cc934",
                                                "sense_id": "66861e3a-5f34-3d13-b3ca-d4e5c6ec771b",
                                                "text": "Une spiritualité sans Dieu est-elle pensable ?"
                                            },
                                            {
                                                "example_id": "effa3842-dfe7-4573-99bd-1deb69243eea",
                                                "sense_id": "66861e3a-5f34-3d13-b3ca-d4e5c6ec771b",
                                                "text": "En renforçant les grandes collectivités, la décentralisation rend pensable la construction d’un statut commun à ces différents personnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3131339-b2d4-370e-9536-efd4c5232bd9",
                                        "entry_id": "0923812a-0e3f-3cf7-9ef8-66d8c24cfae7",
                                        "glosses": [
                                            "(Généralement sous forme négative) Admissible."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49cbf4ac-d791-4583-8511-fcc031d6d413",
                                                "sense_id": "f3131339-b2d4-370e-9536-efd4c5232bd9",
                                                "text": "Il n’est pas pensable qu’on homme puisse supporter qu’on lui ouvre le ventre, qu’on l’ampute d’un bras, qu’on le trépane sans chloroforme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33344178-1378-4b5f-9c05-2653a716c7de",
                        "source_entry_id": "3e5f3d9e-6836-3423-a821-5e7ae4c17ece",
                        "source_sense_description": "able to be thought or imagined; conceivable",
                        "target_lang_word": "denkbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denkbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ff6c4b-e2c7-3822-aef0-da51c9447230",
                                        "entry_id": "3ee3d28b-6f46-347e-bc35-73efb2cb845b",
                                        "glosses": [
                                            "vorstellbar, in Gedanken möglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac923a5-6c82-46a2-bf8d-2a73a2e208a8",
                                                "sense_id": "d3ff6c4b-e2c7-3822-aef0-da51c9447230",
                                                "text": "Eine denkbare Variante werde ich morgen ausprobieren."
                                            },
                                            {
                                                "example_id": "0c30e460-1739-4ee5-b428-a67877f0dd1b",
                                                "sense_id": "d3ff6c4b-e2c7-3822-aef0-da51c9447230",
                                                "text": "Ich weiß nicht, wie es passieren konnte, aber es ist das Negativste eingetroffen, was am denkbarsten war."
                                            },
                                            {
                                                "example_id": "c196372d-4cf4-4b9b-a32d-2a4005ec5977",
                                                "sense_id": "d3ff6c4b-e2c7-3822-aef0-da51c9447230",
                                                "text": "„Deshalb startete er diesen Feldzug, der dann mit dem fehlgeschlagenen Opfer der beiden Löwen unter denkbar unglücklichen Vorzeichen begann.“"
                                            },
                                            {
                                                "example_id": "a406f385-5217-4e77-8345-23dc013947ea",
                                                "sense_id": "d3ff6c4b-e2c7-3822-aef0-da51c9447230",
                                                "text": "[Coronapandemie:] „das britische Gesundheitssystem, der staatliche National Health Service (NHS), ist denkbar schlecht vorbereitet auf diese Pandemie.“"
                                            },
                                            {
                                                "example_id": "e0806be7-70eb-4903-a9c2-bfd43f8762a0",
                                                "sense_id": "d3ff6c4b-e2c7-3822-aef0-da51c9447230",
                                                "text": "„Die Sahara im Norden von Mali ist denkbar schlecht für den Einsatz von Elektronik. Extreme Temperaturen, viel Staub und wenig Elektrizität setzen herkömmlichen Computern deutliche Grenzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
