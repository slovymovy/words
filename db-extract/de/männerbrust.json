                "senses": [
                    {
                        "sense_id": "c2e6b19f-7d06-34c2-acec-3ff4621f7eb2",
                        "entry_id": "1df4068a-9f4d-3049-a4ac-0c76fba013f0",
                        "glosses": [
                            "Vorderseite des männlichen Oberkörpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29394b78-ff59-4578-aedb-cca897319377",
                                "sense_id": "c2e6b19f-7d06-34c2-acec-3ff4621f7eb2",
                                "text": "„Ich stürzte auf den Gang und landete an einer harten wohlriechenden Männerbrust.“"
                            },
                            {
                                "example_id": "3f16e265-9760-46b1-a246-34cf46df7030",
                                "sense_id": "c2e6b19f-7d06-34c2-acec-3ff4621f7eb2",
                                "text": "„Eine Männerbrust wie eine weiträumige, geschwungene Landschaft mit Hügeln und Tälern in sanftem Braun. Es ist eine schöne Männerbrust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8479a8e-fa59-34e5-a3e0-d3db6254f170",
                        "entry_id": "1df4068a-9f4d-3049-a4ac-0c76fba013f0",
                        "glosses": [
                            "sekundäres Geschlechtsmerkmal beim Mann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33a2791-8711-4ffa-9d15-0af8ef1fcd39",
                                "sense_id": "f8479a8e-fa59-34e5-a3e0-d3db6254f170",
                                "text": "„Denn ein Gynäkologie – und nicht etwa ein Urologe – ist auch für die Männerbrust zuständig. Aber auch dem Mammazentrum in der Paracelsus-Klinik kann ein Besuch abgestattet werden. Dort gibt es regelmäßige Brustsprechstunden.“"
                            },
                            {
                                "example_id": "f6db6a09-a315-4885-8bb8-636da994d100",
                                "sense_id": "f8479a8e-fa59-34e5-a3e0-d3db6254f170",
                                "text": "„Das Bild einer weiblichen Brust gehört zensiert, findet Facebook. \"Wir beschränken Bilder mit weiblichen Brüsten, wenn darauf Brustwarzen zu sehen sind\", heißt es in den Richtlinien. Eine Männerbrust dagegen ist nicht anstößig, Nippel hin oder her.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
