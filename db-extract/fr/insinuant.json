                "senses": [
                    {
                        "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                        "entry_id": "f08c8248-fe4f-38c3-91f3-58feb1d50e22",
                        "glosses": [
                            "Qui a l’adresse et le talent de s’insinuer, d’insinuer quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e894e62-8497-4250-945d-f6f6baa67182",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "C’est un homme fort insinuant."
                            },
                            {
                                "example_id": "a605a919-c258-4cf1-a24f-7008bfc95247",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Femme insinuante."
                            },
                            {
                                "example_id": "3ddaa558-c56c-442f-8cad-d50449e7ee1b",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Manières insinuantes."
                            },
                            {
                                "example_id": "d5e1f2c9-ed14-4e68-baa5-d97de82b32c8",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Air insinuant."
                            },
                            {
                                "example_id": "690d2635-f481-4884-9cd7-08cf512b4f21",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Langage insinuant."
                            },
                            {
                                "example_id": "3a9da6cd-6c14-4d15-b57b-7e5f06bb5d5c",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Exorde insinuant."
                            },
                            {
                                "example_id": "d78aa406-d846-457d-9175-4b852cb40dfd",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Un riche propriétaire, M. Roudier, au visage grassouillet et insinuant, y discourait des heures entières, avec la passion d’un orléaniste que la chute de Louis-Philippe avait dérangé dans ses calculs."
                            },
                            {
                                "example_id": "732471e0-56e7-40ca-981b-22c3f315f2ec",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "S’assoupissant à la longue, elle glissait dans la chute molle et insinuante du premier sommeil, quand un bruit la réveilla en sursaut."
                            },
                            {
                                "example_id": "d9333517-c420-47ad-80a9-f17a184484de",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Le vétérinaire ne relut sa lettre qu’une fois. Charmé par le bonheur de ses transitions, la fermeté insinuante de ses arguments, il la mit sous enveloppe sans plus hésiter, prit son chapeau melon et gagna la porte."
                            },
                            {
                                "example_id": "448c4365-42fd-4694-b39f-181bdcb742f7",
                                "sense_id": "724ece26-26db-3777-94c0-7a4dd38862e7",
                                "text": "Avant le jour, elle fut réveillée par l’intrusion d’un corps fluet, qui geignait tout bas, se glissait sur le grand canapé rompu avec une adresse de bête insinuante."
                            }
                        ]
                    }
