                        "entry_id": "e2206c9a-5298-3eea-a7f6-d13c0d20663d",
                        "glosses": [
                            "Modèle de voiture automobile de la gamme Vedette, commercialisée et fabriquée de 1957 à 1961 par le constructeur français Simca."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "dcbb7dd6-a228-457a-afd6-c0e421437780",
                                "sense_id": "883b875f-f8fd-3eca-9088-160963c9d6ff",
                                "text": "J’éprouvais, lorsque nous quittions la maison pour quelques jours dans la Simca Beaulieu bleue et blanche de mon père, la griserie des départs sans idée de retour."
                            }
                        ]
                    }
