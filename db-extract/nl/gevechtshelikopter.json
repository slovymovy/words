                                                "example_id": "52df6130-07ab-4b73-891d-ea9dcccb9a79",
                                                "sense_id": "8de04fc6-2f30-3872-82e9-f7efc23034f0",
                                                "text": "„Armeetruppen griffen die Millionenstadt Regimegegnern zufolge mit Kampfhubschraubern an.“"
                                            },
                                            {
                                                "example_id": "55d4df9b-4739-435a-a547-35b64a7cba49",
                                                "sense_id": "8de04fc6-2f30-3872-82e9-f7efc23034f0",
                                                "text": "„Bei einem Überfall wurden etwa 200 Menschen aus Kampfhubschraubern erschossen, ihre Leichen wurden mit Baufahrzeugen in Massengräbern verscharrt.“"
                                            }
                                        ],
