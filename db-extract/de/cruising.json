                                        "sense_id": "48f8b5ec-5258-32e8-a4b0-1f9c2f81a555",
                                        "entry_id": "a6452670-0deb-3c69-8959-4ab7d91b5292",
                                        "glosses": [
                                            "Sailing about without an exact destination, especially for pleasure."
