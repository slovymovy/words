                "senses": [
                    {
                        "sense_id": "24d45b47-c091-3d3b-8164-183a360d7835",
                        "entry_id": "00b8077d-9592-3ebf-a01e-204142f399f8",
                        "glosses": [
                            "bałamut, uwodziciel"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e49a2c15-7e13-4951-ac0b-2cfd8fa81ddf",
                                "sense_id": "24d45b47-c091-3d3b-8164-183a360d7835",
                                "text": "Donżuany jedne, przez całą noc pod oknami po pijaku wyśpiewywali."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e699ea8-a390-4d4a-b567-73b956811bef",
                        "source_entry_id": "00b8077d-9592-3ebf-a01e-204142f399f8",
                        "source_sense_id": "24d45b47-c091-3d3b-8164-183a360d7835",
                        "target_lang_word": "donjuán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donjuán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c6da990b-31ce-3823-a7dc-3ecdca85509e",
                                        "entry_id": "e2d12bb3-d6cd-39a9-8dfe-c66b2b7944f1",
                                        "glosses": [
                                            "Hombre que gusta de seducir a muchas mujeres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713b8523-7f44-42e8-8e35-7fac7cb3d94f",
                                                "sense_id": "c6da990b-31ce-3823-a7dc-3ecdca85509e",
                                                "text": "Son estos viajantes-viajeros unos donjuanes en potencia, siempre dispuestos al encuentro amoroso fortuito o incluso a casarse si el dinero de por medio lo merece, aunque es más frecuente lo primero."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec436587-b5a9-4d9b-9b0a-5cb343acbe6f",
                        "source_entry_id": "00b8077d-9592-3ebf-a01e-204142f399f8",
                        "source_sense_id": "24d45b47-c091-3d3b-8164-183a360d7835",
                        "target_lang_word": "донжуан",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "донжуан",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "25d5f66b-eef0-32af-aec4-f06271e0bd37",
                                        "entry_id": "26cc71aa-9e32-3945-a3d1-f2fed2d25542",
                                        "glosses": [
                                            "разг. искатель любовных приключений, любитель женщин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ef6c42-e20a-4d84-939d-a717412d7c26",
                                                "sense_id": "25d5f66b-eef0-32af-aec4-f06271e0bd37",
                                                "text": "Члены клуба обязываются следить на площадях, улицах и публичных местах за тем, чтобы уличные донжуаны не приставали к дамам и защищать последних от нахальных приставаний."
                                            },
                                            {
                                                "example_id": "ef09412e-f862-4b92-979a-73c321bdcf5f",
                                                "sense_id": "25d5f66b-eef0-32af-aec4-f06271e0bd37",
                                                "text": "Он, этот любимый человек, этот блестящий Дима Вагаев, волокита и донжуан, впервые в жизни действительно полюбивший, уйдёт на войну…"
                                            },
                                            {
                                                "example_id": "db10ac3c-ced7-41d4-90f7-bced0df38111",
                                                "sense_id": "25d5f66b-eef0-32af-aec4-f06271e0bd37",
                                                "text": "Славный был парень, способный карикатурист, много читал, знал историю, и не донжуан вовсе, как представлялся, просто нравилось ему делать вид, будто он не может пропустить ни одной юбки, почему нравилось ― неизвестно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ff5dea4-683d-4d0b-a5fb-e126a822dfdd",
                        "source_entry_id": "00b8077d-9592-3ebf-a01e-204142f399f8",
