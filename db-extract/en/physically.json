                        ],
                        "form": "most physically"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "glosses": [
                            "In a physical manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fd566d-348f-4b2c-b7c9-620339711621",
                                "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                "text": "“And whatʼs more,” the voice went on triumphantly, “the patient is both physically and neurally whole.”"
                            },
                            {
                                "example_id": "70a945e1-37ea-4ed1-81d6-035402150832",
                                "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                "text": "Oh, yeah? Well, that's not physically possible for me to do! So there!"
                            },
                            {
                                "example_id": "20d8b52c-456b-484e-9c94-8805328dbb45",
                                "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                "text": "In good times and bad, in sickness and health, the benefits of friendships between women are physically and psychologically undeniable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d96b41c-94eb-368d-a77c-8980465e597b",
                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "glosses": [
                            "According to the laws of physics."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ba5aae98-359e-3461-9983-3d5ee5a498d2",
                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "glosses": [
                            "Using physical force."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eafa62c4-9ead-3404-8526-f7364f15d16a",
                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "glosses": [
                            "Directly, rather than automatically or similar."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1b13e187-0502-4846-a2f2-9aa12731b653",
                                "sense_id": "eafa62c4-9ead-3404-8526-f7364f15d16a",
                                "text": "After the software updated, I had to go in and physically change all the settings back to the way I wanted them."
                            }
                        ]
                    },
                    {
                        "sense_id": "000c0039-6f41-30f4-bd65-d10f914238c6",
                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "glosses": [
                            "According to the rules of medicine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0fded0e-65ac-42c5-baff-f97e3ea3e438",
                        "source_entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "source_sense_description": "in a physical manner",
                        "target_lang_word": "lichamelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lichamelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1df6d7b0-761b-3dec-ab5b-61d40c2e9b23",
                                        "entry_id": "43954cb8-c76f-3251-800e-83971a3686bb",
                                        "glosses": [
                                            "met betrekking tot het lichaam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d22e33b-33d9-4399-b49d-aba9895cddad",
                                                "sense_id": "1df6d7b0-761b-3dec-ab5b-61d40c2e9b23",
                                                "text": "Het OM had zes jaar cel geëist voor de arts wegens het opzettelijk toebrengen van zwaar lichamelijk en psychisch letsel."
                                            },
                                            {
                                                "example_id": "0f450d4b-cfd5-4950-a7ab-71c131a93f1c",
                                                "sense_id": "1df6d7b0-761b-3dec-ab5b-61d40c2e9b23",
                                                "text": "Ik had gehoord dat de trail geestelijk veel zwaarder zou zijn dan lichamelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "561cc008-4f2b-4030-ad2c-beaa0e5cbe65",
                        "source_entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "source_sense_description": "in a physical manner",
                        "target_lang_word": "physiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                        "entry_id": "bf15661f-a1e9-3cf0-adb1-f0ea97b94452",
                                        "glosses": [
                                            "D’une manière réelle et physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177bcf1f-1832-409c-977d-4cef82ae6289",
                                                "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                                "text": "Il n'est pas physiquement impossible que…"
                                            },
                                            {
                                                "example_id": "eb2e29aa-0cce-478c-bec6-8d75634e39d4",
                                                "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                                "text": "C’est un homme qui est très bien physiquement."
                                            },
                                            {
                                                "example_id": "e2d39892-de84-45a7-a96f-2afccbe29bea",
                                                "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                                "text": "Quelques heures plus tard, vers 17 heures, les deux hommes se retrouvent, physiquement cette fois, dans la salle de la commission des Lois de l’Assemblée, peu avant le début de la réunion sur la Nouvelle-Calédonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e6c9117-b74e-4b6f-9739-d2584fcecaba",
                        "source_entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                        "source_sense_description": "in a physical manner",
                        "target_lang_word": "physisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8d65a9-e6fe-32a5-913c-1bdca46e2675",
                                        "entry_id": "feffd6f7-a1c7-3a62-bd9c-cd223a67d61d",
                                        "glosses": [
                                            "die Physis/das Körperliche betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda5753a-7df2-469a-8758-75f8ccac01fb",
                                                "sense_id": "cb8d65a9-e6fe-32a5-913c-1bdca46e2675",
                                                "text": "Er arbeitete bis zur physischen Erschöpfung."
                                            },
                                            {
                                                "example_id": "17eac545-441b-4923-8db6-82469b868c86",
                                                "sense_id": "cb8d65a9-e6fe-32a5-913c-1bdca46e2675",
                                                "text": "Physische Belastungen sind ein Teil des menschlichen Daseins und zum Erhalt der Gesundheit zwingend erforderlich."
                                            },
                                            {
                                                "example_id": "7cb85d31-3a35-4fde-8da3-e900a46446a0",
                                                "sense_id": "cb8d65a9-e6fe-32a5-913c-1bdca46e2675",
                                                "text": "Es gibt physische und virtuelle (oder meinetwegen auch virtualisierte) Server, aber keine physikalischen."
                                            },
                                            {
                                                "example_id": "1188b9cd-3c5e-4785-ba75-a253b7edf29a",
                                                "sense_id": "cb8d65a9-e6fe-32a5-913c-1bdca46e2675",
                                                "text": "Die Leute, die mit physischen Tonträgern aufgewachsen sind, kommen langsam in die Jahre und die Jugendlichen sind längst mit dem Download groß geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1af19ecd-ba98-33a4-9dee-66f9a23b0d1e",
                                        "entry_id": "feffd6f7-a1c7-3a62-bd9c-cd223a67d61d",
                                        "glosses": [
                                            "durch die Natur begründet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e75cd7-b9a5-4cc9-ad8d-f355a1df65b9",
                                                "sense_id": "1af19ecd-ba98-33a4-9dee-66f9a23b0d1e",
                                                "text": "So ist eine Annahme logisch möglich, wenn sie nicht sich selbst widerspricht, d. h. widerspruchsvoll ist; sie ist physisch möglich, wenn sie nicht den Naturgesetzen widerspricht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
