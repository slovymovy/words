                "senses": [
                    {
                        "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                        "entry_id": "60767cc1-38bf-32c0-990d-9a0552b087b3",
                        "glosses": [
                            "Verlobung"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "5e669716-9dfd-4320-981c-a9b6693ca9cb",
                                "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                "text": "Das Verlöbnis von Hans und Anne fand am 1. August statt."
                            },
                            {
                                "example_id": "eb36ee14-5fd9-4429-8125-8c81c5bd37f9",
                                "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                "text": "„Aber in der geheimsten Tiefe ihrer Seele quälte sie doch die Frage, ob ihr Verlöbnis mit Boris ein Scherz oder ein ernstzunehmendes und bindendes Versprechen gewesen war.“"
                            },
                            {
                                "example_id": "d39c9b6a-e827-49d2-a146-94a838a2a417",
                                "sense_id": "d188667e-d244-3acb-8aeb-d688b2a63814",
                                "text": "„Einen Abend und eine Maiennacht lang währte das Verlöbnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
