                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceaaa108-68ed-4e0f-ad09-45dc62a562ae",
                                "sense_id": "3c1b3bd7-92a1-345b-b753-83c8994c33aa",
                                "text": "Il existe des travaux en amont-pendage de la recette, et d’autres très-développés sur l’aval-pendage."
                            },
                            {
                                "example_id": "e8c23806-4303-4962-891a-a67e909b1ce8",
                                "sense_id": "3c1b3bd7-92a1-345b-b753-83c8994c33aa",
                                "text": "La force motrice ainsi créée pourra servir, non-seulement à l’extraction des travaux situés en amont-pendage, mais encore à l’épuisement et à l’extraction d’un aval-pendage qui pourra être d’autant plus important que la force motrice créée sera plus considérable."
                            },
                            {
                                "example_id": "4b4cf08a-1d61-4a7d-a563-1eb4372a5037",
                                "sense_id": "3c1b3bd7-92a1-345b-b753-83c8994c33aa",
                                "text": "Le forage en amont-pendage est plus prédominant dans les formations laminaires, telles que marnes et grès, que dans les formations homogènes, telles que les calcaires."
                            }
                        ]
                    }
