    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6b80cbde-d807-3242-8ced-7c6cf1353671",
                "word": "outfangthief",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f97cd66c-cd3d-39d5-938f-a0c0e31cd4b5",
                        "entry_id": "6b80cbde-d807-3242-8ced-7c6cf1353671",
                        "glosses": [
                            "A privilege of some feudal lords permitting them to execute summary judgment upon thieves (particularly their own tenants) captured outside their estates and to keep any chattels forfeited upon conviction."
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2f583777-628e-4b04-95de-13bd49cf7e7d",
                                "sense_id": "f97cd66c-cd3d-39d5-938f-a0c0e31cd4b5",
                                "text": "A grant of outfangthief imports the trial of those of his fee taken for felony in another precinct."
                            },
                            {
                                "example_id": "38d3df53-9722-4825-94c7-6d4f08bb76a1",
                                "sense_id": "f97cd66c-cd3d-39d5-938f-a0c0e31cd4b5",
                                "text": "The addition of outfangandthef is much less usual [than infangthief]; it seems to have meant the right to try a man of the barony taken stealing outside the barony, if necessary repledging him to the barony court."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c43b4aa-f14c-31bf-895f-32bddcd12b4e",
                        "entry_id": "6b80cbde-d807-3242-8ced-7c6cf1353671",
                        "glosses": [
                            "A privilege of some feudal lords permitting them to execute summary judgment upon all thieves captured within their estates, regardless of their origin."
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "726a2e1e-5f22-4be9-9199-bd82d3866582",
                                "sense_id": "2c43b4aa-f14c-31bf-895f-32bddcd12b4e",
                                "text": "But feudalism also contained another principle, and that was, that within his own territory each lord was absolute; his suzerain could not interfere with his jurisdiction; infangthief and outfangthief implied a very perfect and intelligible power of hanging and imprisoning as he pleased."
                            }
                        ]
                    },
                    {
                        "sense_id": "7774a23b-34a3-39f2-ba25-dad4deec1c17",
                        "entry_id": "6b80cbde-d807-3242-8ced-7c6cf1353671",
                        "glosses": [
                            "A thief so captured and tried."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "rare"
                        ],
                        "examples": []
                    }
