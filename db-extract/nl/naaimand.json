                    {
                        "sense_id": "9dfcaa88-6b99-3afe-a316-fd52656697be",
                        "entry_id": "80e7de26-f201-34d9-9074-bd7db252e9d9",
                        "glosses": [
                            "schaal of mand waarin men handwerkbenodigdheden kan bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49548b8-1fbd-40c5-9cb6-787ed84abca0",
                                "sense_id": "9dfcaa88-6b99-3afe-a316-fd52656697be",
                                "text": "De dag dat de eindelijk tot advocaat beëdigde Jacob Willem het \"vadermonster\" voorgoed uit zijn leven zet en in een wankele stemming troost zoekt bij zijn stroeve moeder, vindt hij haar spaarbankboekje in de naaimand."
                            },
                            {
                                "example_id": "474354fb-061f-4ef6-a0f6-73eb4e74e147",
                                "sense_id": "9dfcaa88-6b99-3afe-a316-fd52656697be",
                                "text": "\"Even mijn handen wasschen\", mompelde Eduard, en daalde af naar de wijnkelder. Hij zocht tusschen stoffige flesschen, oude kranten en automobiel-onderdelen van oom Bastiaan, die graag knutselde; terwijl Erica niet heur haren uitkamde, maar de logeerkamer, en de linnenkasten, en de naaimand die nog van oma is geweest. Niets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab76c511-e65f-412a-8d51-7443079e6ab4",
                        "source_entry_id": "80e7de26-f201-34d9-9074-bd7db252e9d9",
                        "source_sense_id": "9dfcaa88-6b99-3afe-a316-fd52656697be",
                        "target_lang_word": "workbasket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
