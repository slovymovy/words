                        "sense_id": "51532904-6889-3b5a-b342-51a9c9581306",
                        "entry_id": "af06a4dd-7795-3579-a8ce-89b55a257a66",
                        "glosses": [
                            "forma stosunków kredytowych między wierzycielem a dłużnikiem, polegająca na pobieraniu wygórowanych procentów za pożyczone pieniądze"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "31ce24a7-1907-400a-88f6-9fa8d541d8d7",
                                "sense_id": "51532904-6889-3b5a-b342-51a9c9581306",
                                "text": "Lichwa jest zabroniona przez prawo muzułmańskie, przez wieki była też potępiana przez Kościół katolicki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
