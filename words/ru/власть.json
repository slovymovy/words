{
    "word_family": [
        "властный",
        "властвовать",
        "властелин",
        "безвластие",
        "всевластие",
        "народовластие"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7af849ea-b250-3183-87bd-4589f6275cb2",
                    "sense_definition": "Право и возможность распоряжаться кем-либо или чем-либо, подчинять своей воле.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Родители имеют большую <власть> над своими маленькими детьми.",
                            "target_lang_translations": {
                                "en": "Parents have great <authority> over their young children.",
                                "zh": "父母对年幼的孩子有很大的<w>权力</w>。"
                            }
                        },
                        {
                            "text": "У него есть законная <власть> принимать такие важные решения.",
                            "target_lang_translations": {
                                "en": "He has the legal <authority> to make such important decisions.",
                                "zh": "他有做出这些重要决定的合法<w>权力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сила",
                        "полномочие",
                        "господство"
                    ],
                    "antonyms": [
                        "безвластие"
                    ],
                    "common_phrases": [
                        "жажда власти",
                        "иметь власть",
                        "родительская власть",
                        "власть над людьми"
                    ],
                    "target_lang_definitions": {
                        "en": "The right and ability to control someone or something, or to subject them to one's will.",
                        "zh": "支配某人或某事物的权利和能力，或使其服从于自己的意志。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "authority",
                                "target_lang_sense_clarification": "right to command"
                            },
                            {
                                "target_lang_word": "power",
                                "target_lang_sense_clarification": "ability to control"
                            },
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "dominance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权力",
                                "target_lang_sense_clarification": "指支配他人的能力或职权"
                            },
                            {
                                "target_lang_word": "权威",
                                "target_lang_sense_clarification": "指在某种关系中拥有的指挥权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe1de167-48a6-36b8-af33-63df553687c3",
                    "sense_definition": "Государственное управление, политическое господство.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новая партия хочет прийти к <власти> мирным путём.",
                            "target_lang_translations": {
                                "en": "The new party wants to come to <power> peacefully.",
                                "zh": "新党派希望通过和平方式获得<w>政权</w>。"
                            }
                        },
                        {
                            "text": "Смена <власти> в стране прошла спокойно и без конфликтов.",
                            "target_lang_translations": {
                                "en": "The change of <power> in the country went smoothly and without conflict.",
                                "zh": "该国的<w>政权</w>更迭进行得平稳且没有冲突。"
                            }
                        }
                    ],
                    "synonyms": [
                        "господство"
                    ],
                    "antonyms": [
                        "безвластие"
                    ],
                    "common_phrases": [
                        "прийти к власти",
                        "захват власти",
                        "верховная власть",
                        "советская власть"
                    ],
                    "target_lang_definitions": {
                        "en": "State administration or political domination.",
                        "zh": "国家行政管理或政治统治。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "power",
                                "target_lang_sense_clarification": "political control"
                            },
                            {
                                "target_lang_word": "rule",
                                "target_lang_sense_clarification": "government"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政权",
                                "target_lang_sense_clarification": "指政治统治权"
                            },
                            {
                                "target_lang_word": "统治",
                                "target_lang_sense_clarification": "指对国家的管理和控制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27085d14-fcf0-31a1-8df5-d1eab86ebb55",
                    "sense_definition": "Органы государственного управления, чиновники, правительство (часто во множественном числе).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "concrete_authorities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Местные <власти> обещали отремонтировать эту старую дорогу.",
                            "target_lang_translations": {
                                "en": "The local <authorities> promised to repair this old road.",
                                "zh": "地方<w>当局</w>承诺修复这条旧路。"
                            }
                        },
                        {
                            "text": "Мы решили обратиться к <властям> за помощью в решении проблемы.",
                            "target_lang_translations": {
                                "en": "We decided to turn to the <authorities> for help in solving the problem.",
                                "zh": "我们决定向<w>政府</w>寻求帮助以解决这个问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "местные власти",
                        "городские власти",
                        "представители власти",
                        "конфликт с властями"
                    ],
                    "target_lang_definitions": {
                        "en": "Government bodies, officials, or the administration (often used in plural).",
                        "zh": "政府机构、官员或行政部门（常用于复数）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "authorities",
                                "target_lang_sense_clarification": "officials/government"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当局",
                                "target_lang_sense_clarification": "指政府或行政管理部门"
                            },
                            {
                                "target_lang_word": "政府",
                                "target_lang_sense_clarification": "指国家或地方的行政机关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b68fcb7-cb60-3c98-aedc-6036275a8d76",
                    "sense_definition": "Сильное воздействие чего-либо (чувств, стихии), которому трудно противостоять.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Путник оказался во <власти> сильной снежной бури.",
                            "target_lang_translations": {
                                "en": "The traveler found himself in the <power> of a strong snowstorm.",
                                "zh": "旅行者发现自己处于强暴风雪的<w>支配</w>之下。"
                            }
                        },
                        {
                            "text": "Музыка имеет огромную <власть> над нашими чувствами и настроением.",
                            "target_lang_translations": {
                                "en": "Music has enormous <power> over our feelings and mood.",
                                "zh": "音乐对我们的情感和情绪有着巨大的<w>支配</w>力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сила"
                    ],
                    "common_phrases": [
                        "во власти сна",
                        "магическая власть",
                        "власть привычки",
                        "власть тьмы"
                    ],
                    "target_lang_definitions": {
                        "en": "A strong influence of something (like feelings or elements) that is difficult to resist.",
                        "zh": "某种事物（如情感或自然力量）难以抗拒的强烈影响。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "power",
                                "target_lang_sense_clarification": "strong influence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支配",
                                "target_lang_sense_clarification": "指被某种力量所控制"
                            },
                            {
                                "target_lang_word": "力量",
                                "target_lang_sense_clarification": "指事物对人的影响作用"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}