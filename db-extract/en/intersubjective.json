                "senses": [
                    {
                        "sense_id": "55ff571d-a9c5-3c81-b01c-1b1d98fec35e",
                        "entry_id": "0104528a-fa8a-3fe7-87cc-2da2b1dc87a0",
                        "glosses": [
                            "Involving or occurring between separate conscious minds."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "982868be-3e3d-4422-b359-466bdcb228c2",
                                "sense_id": "55ff571d-a9c5-3c81-b01c-1b1d98fec35e",
                                "text": "The search for certainty about the exact nature of colonial social arrangements — fascinating and important though it may be — is in many ways beyond the scope of my project, which is more concerned with the intersubjective processes of boundary making and marking than it is with objectifying social relations in a sociohistorical manner."
                            }
                        ]
                    },
                    {
                        "sense_id": "6721811c-e760-3c62-ae3c-ab587ce78ef4",
                        "entry_id": "0104528a-fa8a-3fe7-87cc-2da2b1dc87a0",
                        "glosses": [
                            "Accessible to or capable of being established for two or more subjects."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fe0ce19-ed29-4cea-8a1c-e66ac73787d3",
                        "source_entry_id": "0104528a-fa8a-3fe7-87cc-2da2b1dc87a0",
                        "source_sense_description": "inter-subjective",
                        "target_lang_word": "intersubjectif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intersubjectif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f29f1a94-cbc7-3924-a8db-2a1fb15d2b4a",
                                        "entry_id": "612baa0e-da24-3426-816c-e6c584a35045",
                                        "glosses": [
                                            "Relatif aux subjectivités distinctes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e938e041-053f-43af-95f2-515a578583bf",
                                                "sense_id": "f29f1a94-cbc7-3924-a8db-2a1fb15d2b4a",
                                                "text": "L'explication la plus simple de cet accord intersubjectif est que les deux personnes voient les mêmes choses parce qu'il y a réellement deux arbres, un massif de fleurs et de l’herbe dans le jardin qu’ils observent."
                                            },
                                            {
                                                "example_id": "7df32714-f623-4586-8080-53c5159e9dec",
                                                "sense_id": "f29f1a94-cbc7-3924-a8db-2a1fb15d2b4a",
                                                "text": "Nous envisageons l’être humain comme un être de relation par essence, et l’expérience traumatique, comme une situation critique qui menace ou détruit l’activité de liaison tant au niveau individuel – sous forme de déliaison psychique – qu’au niveau intersubjectif – sous forme de menace de rupture des liens sociaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b38201aa-9865-4459-9d59-4b560ce0806e",
                        "source_entry_id": "0104528a-fa8a-3fe7-87cc-2da2b1dc87a0",
                        "source_sense_description": "inter-subjective",
                        "target_lang_word": "intersubjektiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intersubjektiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17f28ea3-fe68-34a5-b4fe-5daedbef0927",
                                        "entry_id": "171885dc-c4d0-35b2-8963-432f841e6b2b",
                                        "glosses": [
                                            "nicht nur auf eine einzelne Person bezogen; nicht nur von einer einzelnen Person abhängig; mehreren Personen gleichermaßen zugänglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f11c9c-0b26-4d6c-a77d-949232b4d593",
                                                "sense_id": "17f28ea3-fe68-34a5-b4fe-5daedbef0927",
                                                "text": "Wissenschaft muss intersubjektiv nachvollziehbar sein."
                                            },
                                            {
                                                "example_id": "31e279d3-2eb8-49fe-973c-ebb8eaef58ff",
                                                "sense_id": "17f28ea3-fe68-34a5-b4fe-5daedbef0927",
                                                "text": "Erkenntnis soll möglichst objektiv sein; wenn das nicht möglich ist, soll sie wenigstens intersubjektiv nachvollziehbar und überprüfbar sein."
                                            },
                                            {
                                                "example_id": "2e58755a-9e91-429d-9989-31ef4422f21a",
                                                "sense_id": "17f28ea3-fe68-34a5-b4fe-5daedbef0927",
                                                "text": "„Gerade diese Polarität zwischen intersubjektivem Wissen und subjektiver Gewißheit will Frisch in seiner Komödie aufzeigen, er demonstriert diese Polarität an der Geometrie einerseits und der Liebe andererseits.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
