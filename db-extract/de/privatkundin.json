                "senses": [
                    {
                        "sense_id": "4338b5dc-f614-3cbc-a836-0fb0834278e5",
                        "entry_id": "b06c0bb3-1780-3658-80eb-f2e7e7ed65f0",
                        "glosses": [
                            "einzelne weibliche Person(en) (Privatpersonen) - im Gegensatz zu Firmen oder Institutionen - als Kundin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddbce39e-5820-4b5e-85ed-a25a50dcd67f",
                                "sense_id": "4338b5dc-f614-3cbc-a836-0fb0834278e5",
                                "text": "„So, ich bin aber Privatkundin in diesem Laden!“ sagte Vera laut und unüberhörbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05e712d5-4687-4362-bb61-9de1b8038252",
                        "source_entry_id": "b06c0bb3-1780-3658-80eb-f2e7e7ed65f0",
                        "source_sense_id": "4338b5dc-f614-3cbc-a836-0fb0834278e5",
                        "source_sense_description": "einzelne weibliche Person(en) (Privatpersonen) - im Gegensatz zu Firmen oder Institutionen - als Kundin",
                        "target_lang_word": "particulière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "particulière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                        "entry_id": "641a1014-17ed-3a0a-aeb9-74a5cdf8c0ee",
                                        "glosses": [
                                            "Simple femme, par opposition à une personne morale ou publique, ou d’un rang élevé."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40bb76b5-8053-43c6-907f-73c3ddd20b10",
                                                "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                                "text": "— Eh ! Pierrot, une particulière qui veut cirer l’escalier à sa façon, cria le suisse à un groom microscopique passant dans le vestibule."
                                            },
                                            {
                                                "example_id": "1470867d-8099-4afc-a6d4-d7696cbe1299",
                                                "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                                "text": "V’là qu’un soir, je pousse une pointe et je m’emmanche dans la boutique, histoire d’aller en reconnaissance et de voir ma particulière."
                                            },
                                            {
                                                "example_id": "457bdb6e-ca37-4d33-9fb4-9154008cb173",
                                                "sense_id": "021da3aa-2cd5-3e6a-bff6-bd5863fb2edc",
                                                "text": "— Une particulière en gris. Pour ce qui serait de la reconnaître, non. Mais la couleur de la robe, oui… Et le chapeau aussi… un chapeau avec des fleurs violettes…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "particulière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e847d2da-3914-3c8c-af17-fbd23f7b4cd7",
                                        "entry_id": "59e5666e-eea1-3172-b235-c6fe34cb3c62",
                                        "glosses": [
                                            "Féminin singulier de particulier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30bcc8ab-a01f-48c5-832e-c98b99335a13",
                                                "sense_id": "e847d2da-3914-3c8c-af17-fbd23f7b4cd7",
                                                "text": "Cette émergence, notons-le, oblige simultanément à désargumenter le stylistique, dans la mesure où on sort une pratique particulière et constitutive du discours rhétorique hors de sa portée pragmatique essentielle, la persuasion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
