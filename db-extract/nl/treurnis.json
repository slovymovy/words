                "senses": [
                    {
                        "sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                        "entry_id": "c02e9e95-c9dc-3391-b3ad-281fc8b6fdad",
                        "glosses": [
                            "van iets dat het heel verdrietig en spijtig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef4cb14-86de-46d1-b585-0e8ca8327926",
                                "sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                                "text": "Vanaf 17 mei is Mark de Moor, de knappe zwemmer van weleer, terug in de serie. Vooral omdat Immers vereerd was met het verzoek, zegt hij terwijl hij om zich heen kijkt op de huidige set. De set die helemaal niks meer weg heeft van die uit de jaren 90, van de tijd waarin hij met zijn ontblote bovenlijf duizenden meisjesharten veroverde en zorgde voor treurnis toen hij de serie verliet met zijn grote soapliefde Marieke (het zusje van Jeanine)."
                            },
                            {
                                "example_id": "fb095fb5-8cc5-4e53-8a95-3b641ea121ec",
                                "sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                                "text": "Een door oppositiepartij DENK ingediende motie van treurnis - een waarschuwing aan het adres van Dekker - haalde het niet. Geen enkele andere partij steunde de motie."
                            },
                            {
                                "example_id": "4d26db67-1f81-43d3-b54f-654d2ce3876e",
                                "sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
                                "text": "Fotograaf Mark van Wonderen heeft één doel: alle Chinees-Indische restaurants van Nederland fotograferen. Vooral de 'troosteloze' restaurants spreken hem aan: ,,De treurnis die je tegenkomt, dat is toch geweldig!\" Mark heeft bijna alle restaurants in Nederland gehad en die worden gebundeld in een boek, dat komend voorjaar uitkomt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ff4f0a7-e87a-4328-a528-9421f76171d8",
                        "source_entry_id": "c02e9e95-c9dc-3391-b3ad-281fc8b6fdad",
                        "source_sense_id": "a1fbeb09-6da3-35cd-9afc-eac592594d05",
