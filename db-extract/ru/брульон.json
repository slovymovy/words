                                ]
                            },
                            {
                                "target_word": "outline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf8ffdf-c4a6-34b0-91b2-8ac29376567f",
                                        "entry_id": "71cb1e77-bb0a-3442-9b08-8dedb187dc2c",
                                        "glosses": [
                                            "To draw an outline of; to describe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ef5e07-85a0-4fea-9aa4-cfb13bb6c4de",
                                                "sense_id": "1bf8ffdf-c4a6-34b0-91b2-8ac29376567f",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7316cd-cae3-38fd-8d13-e06b3c4b3a0e",
                                        "entry_id": "71cb1e77-bb0a-3442-9b08-8dedb187dc2c",
                                        "glosses": [
                                            "To summarize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dae086a-680c-4b19-812f-8c69594fd2e8",
                                                "sense_id": "1f7316cd-cae3-38fd-8d13-e06b3c4b3a0e",
                                                "text": "Wikipedia items featuring books usually outline them after giving their background."
                                            },
                                            {
                                                "example_id": "d5885c7a-e952-4bc8-bb40-9e5ff7e1abc6",
                                                "sense_id": "1f7316cd-cae3-38fd-8d13-e06b3c4b3a0e",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "080670c1-8ca1-36fc-9e3d-c13114825bfd",
                                        "entry_id": "71cb1e77-bb0a-3442-9b08-8dedb187dc2c",
                                        "glosses": [
                                            "To optimize for size by replacing repeated code fragments with function calls."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8509a586-41c7-4310-9321-514c5b878040",
                        "source_entry_id": "40b677d8-974d-3c49-9187-90a806009554",
                        "target_lang_word": "brouillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brouillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da5b8ecb-e7af-3350-9a89-4c80931bf5d6",
                                        "entry_id": "b8f214cc-540c-3a0c-841f-f8574632ad06",
                                        "glosses": [
                                            "Premier jet de ce qu’on écrit d’abord sur le papier pour le mettre ensuite au net."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78308d2a-63f5-43a8-af18-643901fa93a4",
                                                "sense_id": "da5b8ecb-e7af-3350-9a89-4c80931bf5d6",
                                                "text": "En plus de sa machine arithmétique, la première contribution importante de Leibniz aurait été, aux yeux de Huygens, la quadrature arithmétique du cercle, dont Leibniz avait rédigé le premier brouillon en octobre 1674."
                                            },
                                            {
                                                "example_id": "0ffcc1ef-46e6-4cf2-9841-ec5e214d4ee6",
                                                "sense_id": "da5b8ecb-e7af-3350-9a89-4c80931bf5d6",
                                                "text": "Un cahier de brouillons."
                                            },
                                            {
                                                "example_id": "33414e5c-10e0-4ece-a5c8-7714242092ac",
                                                "sense_id": "da5b8ecb-e7af-3350-9a89-4c80931bf5d6",
                                                "text": "Au contraire on ne saurait assez louer plusieurs nobles esprits, qui se sont essayez à nettoyer la Géographie, de toutes erreurs, & rapporter l'ancienne à la Moderne: l'honneur desquels m'est tant recommandable, que pour faire honte aux Brouillons, je suis content mettre ici les meilleurs & les plus assurées cartes, qui se trouvent pour le jour d'huy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a87b6ed6-5b1d-3794-a412-5c9382a81183",
                                        "entry_id": "b8f214cc-540c-3a0c-841f-f8574632ad06",
                                        "glosses": [
                                            "Le papier même sur lequel on a écrit le brouillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f281af-58dc-48ca-a3ff-62fe96a74318",
                                                "sense_id": "a87b6ed6-5b1d-3794-a412-5c9382a81183",
                                                "text": "Les deux officiers avaient trouvé plusieurs clés USB, ainsi que trois disques durs externes et des brouillons de formules mathématiques, certainement le fruit des recherches du défunt chercheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fc9018c-4c7a-32e1-9bbe-a4e270c5a8bc",
                                        "entry_id": "b8f214cc-540c-3a0c-841f-f8574632ad06",
                                        "glosses": [
                                            "Brouillard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brouillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74750d22-d976-3e5f-96b3-53e560f47b32",
                                        "entry_id": "42d021e7-a96e-36a6-b3ab-2140fd840d4b",
                                        "glosses": [
                                            "Personnage qui manque d'ordre, de rigueur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55e7209-a961-4e70-aae6-44156cfd9317",
                                                "sense_id": "74750d22-d976-3e5f-96b3-53e560f47b32",
                                                "text": "Il s’en alla ; puis il rouvrit la porte, et dit encore d’une voix impérieuse :\n— Surtout, défiez-vous d’Aristide, c’est un brouillon qui gâterait tout. Je l’ai assez étudié pour être certain qu’il retombera toujours sur ses pieds. Ne vous apitoyez pas ; car, si nous faisons fortune, il saura nous voler sa part."
                                            },
                                            {
                                                "example_id": "255742d4-bdc0-492b-b47d-098bb10c0ae2",
                                                "sense_id": "74750d22-d976-3e5f-96b3-53e560f47b32",
                                                "text": "Après le plaisir d'être apprécié par les gens intelligents, il n'y en a pas de plus grand que celui de n'être pas compris par les brouillons qui ne savent exprimer qu'en charabia ce qui leur tient lieu de pensée ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732e4350-9670-3e97-8a7f-62613e3a6198",
                                        "entry_id": "42d021e7-a96e-36a6-b3ab-2140fd840d4b",
                                        "glosses": [
                                            "Personnage qui aime à brouiller les gens entre eux, à créer la discorde."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f55334-af89-4272-8304-7da76f0a9d67",
                                                "sense_id": "732e4350-9670-3e97-8a7f-62613e3a6198",
                                                "text": "— Oh ! sire, dit l’amiral, la reine Catherine…\n— Est une brouillonne. Avec elle il n’y a pas de paix possible. Ces catholiques italiens sont enragés et n’entendent rien qu’à exterminer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brouillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc0c5f5-dc1b-32ca-8a55-437eef2b317e",
                                        "entry_id": "0e77a31b-5ab0-3d39-b575-48085badfbc8",
                                        "glosses": [
                                            "Qui manque d’ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "383e8533-8d44-412d-b5e5-ac4b6c888fe8",
                                                "sense_id": "4fc0c5f5-dc1b-32ca-8a55-437eef2b317e",
                                                "text": "Cet avocat est très brouillon, il gâte les meilleures causes."
                                            },
                                            {
                                                "example_id": "55660a90-1c03-41f1-930a-b43d85d415d2",
                                                "sense_id": "4fc0c5f5-dc1b-32ca-8a55-437eef2b317e",
                                                "text": "C’était une jolie fille aux cheveux bouclés, au visage parsemé de taches de rousseur. Jasselin la trouvait un peu brouillonne, manquant de rigueur, on ne pouvait pas compter sur elle à 100 % pour une tâche demandant de la précision."
                                            },
                                            {
                                                "example_id": "bd6fa90d-1f8e-4852-afe3-9798b681bf38",
                                                "sense_id": "4fc0c5f5-dc1b-32ca-8a55-437eef2b317e",
                                                "text": "Bref, entre impératifs économiques et absolue nécessité de sécurité sanitaire, le problème est difficilement soluble sans intervention massive de l’État. Et le message brouillon de l’exécutif, qui craint de payer très cher son manque d’anticipation sur les équipements de protection, ne fait que renforcer le flou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0b01bac-e696-3f46-a095-9947978afd1e",
                                        "entry_id": "0e77a31b-5ab0-3d39-b575-48085badfbc8",
                                        "glosses": [
                                            "Qui manque de netteté dans les idées et qui s’embrouille dans ses discours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3fa9e4-57ff-41ad-83ab-e3c33a39eb98",
                                                "sense_id": "d0b01bac-e696-3f46-a095-9947978afd1e",
                                                "text": "Un esprit brouillon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
