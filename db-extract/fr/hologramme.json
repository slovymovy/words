                        "sense_id": "fb8f0f5c-3226-3f3b-bbf8-6588bd3f0b56",
                        "entry_id": "61702051-7e7a-3df5-bf9a-f05e5b2917a1",
                        "glosses": [
                            "Photographie en relief obtenue par holographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf10802-383d-4a4c-a1f7-b949fc7665a9",
                                "sense_id": "fb8f0f5c-3226-3f3b-bbf8-6588bd3f0b56",
                                "text": "Il existe deux sortes d’hologrammes, les hologrammes à réflexion et les hologrammes à transmission."
                            },
                            {
                                "example_id": "1747e95c-2413-4720-a134-37d284ea38e7",
                                "sense_id": "fb8f0f5c-3226-3f3b-bbf8-6588bd3f0b56",
                                "text": "L'hologramme du breuvage chaud tournoyait doucement devant lui et il était d'un réalisme confondant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bc34ce6-6dfb-440a-b53f-ea525e7ab3ef",
                        "source_entry_id": "61702051-7e7a-3df5-bf9a-f05e5b2917a1",
                        "source_sense_id": "fb8f0f5c-3226-3f3b-bbf8-6588bd3f0b56",
