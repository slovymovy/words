                                        "glosses": [
                                            "období trvající čtyři týdny (u pravoslavných šest týdnů) před Vánocemi, sloužící u křesťanů k duchovní přípravě na slavnost narození Ježíše Krista"
                                        ],
                                        "tags": [],
