                ],
                "senses": [
                    {
                        "sense_id": "17b0dd4e-ce99-3af5-b775-514c2ac8a951",
                        "entry_id": "131e4122-58dc-3ff8-9d7b-1a3717643f52",
                        "glosses": [
                            "Qui rend un son aigu, perçant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93aadabd-41f1-4a3f-9a91-c0fb67c98b84",
                                "sense_id": "17b0dd4e-ce99-3af5-b775-514c2ac8a951",
                                "text": "Les prairies étaient stridentes, il y avait toujours eu ces coassements, ces abois, ces rires."
                            },
                            {
                                "example_id": "36441c9b-8e09-402b-b067-44e4adc3c910",
                                "sense_id": "17b0dd4e-ce99-3af5-b775-514c2ac8a951",
                                "text": "Y'avait partout des cris stridents\nY'avait partout des mains coupables\nEt des bandits considérables\nQui me faisaient grincer des dents."
                            },
                            {
                                "example_id": "19114e68-3e17-424a-ae4c-0c2e079a53e7",
                                "sense_id": "17b0dd4e-ce99-3af5-b775-514c2ac8a951",
                                "text": "Secoué des pieds à la tête, il atchoumait jusqu'à épuisement. L’expuition catarrhale était d'autant plus stridente qu'elle était longtemps contenue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32962293-48e8-4a79-b6b5-7e73133a793a",
                        "source_entry_id": "131e4122-58dc-3ff8-9d7b-1a3717643f52",
                        "source_sense_id": "17b0dd4e-ce99-3af5-b775-514c2ac8a951",
                        "target_lang_word": "strident",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c193c46-b40f-3e30-be91-a8ec7b2f236d",
                                        "entry_id": "411578cd-23b2-31fa-bd24-2518a05dc80d",
                                        "glosses": [
                                            "Loud; shrill, piercing, high-pitched; rough-sounding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e130c3-ddf4-4c27-8174-c7d06ef604fc",
                                                "sense_id": "6c193c46-b40f-3e30-be91-a8ec7b2f236d",
                                                "text": "The trumpet sounded strident against the string orchestra."
                                            },
                                            {
                                                "example_id": "ed655edb-dbb6-4ba8-99ec-2f359c9b0121",
                                                "sense_id": "6c193c46-b40f-3e30-be91-a8ec7b2f236d",
                                                "text": "But as they were upon going forth, a trumpet was sounded without, three strident blasts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99269e10-7238-3d0b-b9d5-43806a8de2b1",
                                        "entry_id": "411578cd-23b2-31fa-bd24-2518a05dc80d",
                                        "glosses": [
                                            "Grating or obnoxious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915bb8a3-433a-4626-8a7b-7491485a5e06",
                                                "sense_id": "99269e10-7238-3d0b-b9d5-43806a8de2b1",
                                                "text": "The artist chose a strident mixture of colors."
                                            },
                                            {
                                                "example_id": "2555f1fb-a502-4d5b-9c3a-32d33059ebad",
                                                "sense_id": "99269e10-7238-3d0b-b9d5-43806a8de2b1",
                                                "text": "If Demandt's essay served as a strident example of the German desire for normalcy, a more subtle example was provided by a brief allohistorical depiction of a Nazi victory in World War II written by German historian Michael Salewski in 1999."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4aae1f-6c0d-3ce8-be50-cb3413178fb8",
                                        "entry_id": "411578cd-23b2-31fa-bd24-2518a05dc80d",
                                        "glosses": [
                                            "Forceful (typically in a negative way) or obtrusive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4165016-e1f2-4f99-b689-401983c5b771",
                                                "sense_id": "7d4aae1f-6c0d-3ce8-be50-cb3413178fb8",
                                                "text": "The impact of [Jimmy Carter's] anger [at the Soviet invasion of Afghanistan] on his attitude is confirmed by the moderation in his attitude that occurred. Once the president's anger began to subside, he became less strident in his pronouncements and more uncertain of Soviet motives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfda5a2c-ed67-30c4-a235-d911eab9dc4f",
                                        "entry_id": "411578cd-23b2-31fa-bd24-2518a05dc80d",
                                        "glosses": [
                                            "Vigorous; making strides; forceful in a positive way."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d81f6304-ddc0-4631-8112-e4d196fdcac6",
                                                "sense_id": "bfda5a2c-ed67-30c4-a235-d911eab9dc4f",
                                                "text": "Under David Taylor's stewardship, the SFA has made strident progress."
                                            }
                                        ]
                                    }
                                ]
                            },
