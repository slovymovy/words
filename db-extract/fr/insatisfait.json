                                "target_senses": [
                                    {
                                        "sense_id": "2b5794fd-ce0d-3fbb-bd0c-03f18dcedb9e",
                                        "entry_id": "eaac6e3c-f33b-3ea2-a2ee-3596e6b44618",
                                        "glosses": [
                                            "Not satisfied, especially with the quantity of something; dissatisfied; uncontented."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "055f529a-889f-3bde-b12e-ed0eee350293",
                                        "entry_id": "eaac6e3c-f33b-3ea2-a2ee-3596e6b44618",
                                        "glosses": [
                                            "Not gratified; not having been fulfilled or met."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d9fa44-e957-4437-8b70-f3ef6eb6b7bc",
                                                "sense_id": "055f529a-889f-3bde-b12e-ed0eee350293",
                                                "text": "I made no answer, for I could not - especially before Leo - tell her that since I had seen her face I knew that it would always be before my eyes, and that I had no wish to prolong an existence which must always be haunted and tortured by her memory, and by the last bitterness of unsatisfied love."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32d9765e-420f-4b06-a5a2-d5017658b95e",
                        "source_entry_id": "3c758968-f64b-3c23-82fd-227c29532e75",
