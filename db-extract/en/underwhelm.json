                                                "example_id": "202e407b-2199-42ca-9f67-3b1cdafc82d8",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Torben hat mich bitter enttäuscht, ich war so sicher, er würde mich verteidigen, wenn die anderen wieder loslegen und auf mich schimpfen."
                                            },
                                            {
                                                "example_id": "92d1f4d0-62cc-479a-aa54-5aeb80344fe6",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Was soll ich sagen, ich bin enttäuscht und am Boden zerstört."
                                            },
