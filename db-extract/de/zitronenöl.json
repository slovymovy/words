                        "examples": [
                            {
                                "example_id": "64d3fe98-e9f5-4bc8-b7d4-8488de31501f",
                                "sense_id": "126fdf44-203c-3c78-adf8-6628369ade55",
                                "text": "„Aus den Tüten kamen Schwämme, Geschirrhandtücher, Lappen, Insektenspray, Desinfektionsmittel, Zitronenöl, Papierhandtücher, Spülmittel, Comet-Scheuerpulver (›Das ist das Beste, lass dir von niemandem was anderes erzählen‹), Kloreiniger und eine Packung knallgelbe Gummihandschuhe zum Vorschein.“"
                            },
                            {
                                "example_id": "87c46a8a-cb96-4dcb-9365-cf1f7683efcf",
                                "sense_id": "126fdf44-203c-3c78-adf8-6628369ade55",
                                "text": "„Neben der Haustür steht Grace Wilmot, die nach Zitronenöl und Bohnerwachs riecht.“"
                            }
                        ],
