                    {
                        "sense_id": "a0a45d3f-4eac-3213-aafb-666519e56e0c",
                        "entry_id": "67e0e34f-5e82-3431-9524-a28952508fa9",
                        "glosses": [
                            "mit dem Kopf zuerst; mit dem Kopf voran"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "743a5236-2bd4-4496-9f86-656fc38ffc1a",
                                "sense_id": "a0a45d3f-4eac-3213-aafb-666519e56e0c",
                                "text": "„Da schwang er sie hoch und sie umpreßte mit ihren Beinen seine Brust und bog sich weit zurück, und so begann er zu laufen, keuchend, Hügel auf, Hügel ab, bis er häuptlings mit ihr in das blühende Heidekraut stürzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40b429dc-1514-37ca-9a0a-a3de741c4c31",
                        "entry_id": "67e0e34f-5e82-3431-9524-a28952508fa9",
                        "glosses": [
                            "in der Umgebung, auf der Seite des Kopfes"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "46a17c4d-e69f-44da-bcb0-4792463ea3db",
                                "sense_id": "40b429dc-1514-37ca-9a0a-a3de741c4c31",
                                "text": "Häuptlings im Bett waren etwa zwanzig Stofftiere sorgsam hindrapiert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
