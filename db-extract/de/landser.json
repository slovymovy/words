                "senses": [
                    {
                        "sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                        "entry_id": "6f3edf3d-9d77-335f-9d8e-95e40515656b",
                        "glosses": [
                            "einfacher Soldat"
                        ],
                        "tags": [
                            "colloquial",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "1c3e74c2-dadc-4fa0-b7eb-5b0df0d74c82",
                                "sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                                "text": "„Auch Trosse und rückwärtige Dienste hatten alle verfügbaren Landser abgestellt und zu Kampfgruppen zusammengeschlossen.“"
                            },
                            {
                                "example_id": "4ed606c7-949b-41ac-9657-ae9946588e61",
                                "sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                                "text": "„Neben ihm lag ein alter, ehrlicher Landser.“"
                            },
                            {
                                "example_id": "db32c14d-fd70-4838-a71b-a2400dafe81b",
                                "sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                                "text": "„Um sich in Stimmung zu bringen, tauscht er schon jetzt seine Erfahrungen mit ein paar Landsern aus.“"
                            },
                            {
                                "example_id": "170a5953-86b4-4852-9dad-901ee9ddff0c",
                                "sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                                "text": "„Zwei Landser stehen schwerfällig auf.“"
                            },
                            {
                                "example_id": "4637dcfa-7b4c-4402-9000-994cea1009cc",
                                "sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                                "text": "„Staubige deutsche Landser kamen neugierig näher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05321ad3-12a0-42e3-a601-5d8acc3522ad",
                        "source_entry_id": "6f3edf3d-9d77-335f-9d8e-95e40515656b",
                        "source_sense_id": "c67ba354-3279-382b-ab4d-793047721746",
                        "source_sense_description": "umgangssprachlich, veraltend: einfacher Soldat",
                        "target_lang_word": "squaddie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squaddie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0322f808-8819-3d3f-b622-cab7eb0a08fa",
                                        "entry_id": "187e9ac1-c1c3-3305-9cc7-13a52db07d18",
                                        "glosses": [
                                            "A private in the army."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87bb2d12-a253-4115-83a7-dfafb58111cf",
                                                "sense_id": "0322f808-8819-3d3f-b622-cab7eb0a08fa",
                                                "text": "He'll turn out to be a squaddie— a Muslim squaddie. Exactly the kind of victim they're looking for."
                                            },
                                            {
                                                "example_id": "dcd2ffe5-22c0-4139-a4fe-d1c062b0730f",
                                                "sense_id": "0322f808-8819-3d3f-b622-cab7eb0a08fa",
                                                "text": "Hard men from the high flats and off-dutie squaddies threw back their pints shoulder to shoulder in its spartan public bar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
