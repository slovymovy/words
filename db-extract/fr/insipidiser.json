                "senses": [
                    {
                        "sense_id": "d32e2416-8d25-3dc5-a3f0-75d04ab21218",
                        "entry_id": "5f41ffe3-458b-3b85-a960-7352aa117026",
                        "glosses": [
                            "Donner un caractère insipide à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b05f37-3599-41ab-a3e3-c8f7a0682176",
                                "sense_id": "d32e2416-8d25-3dc5-a3f0-75d04ab21218",
                                "text": "Les choses les plus exquises du Portugal, le filet de porc, le veau de Lafões, les légumes, les pâtisseries, les vins ont dégénéré, se sont insipidisées..."
                            },
                            {
                                "example_id": "f30ef74b-d945-40b8-a21d-e7dfa4b14289",
                                "sense_id": "d32e2416-8d25-3dc5-a3f0-75d04ab21218",
                                "text": "C'est frustrant, à force, cette ribambelle de pseudo rappeurs eunuques qui viennent insipidiser ce qui est, à la base, un excellent concept."
                            },
                            {
                                "example_id": "b86289ed-03cb-42c8-8b22-266ce44ed715",
                                "sense_id": "d32e2416-8d25-3dc5-a3f0-75d04ab21218",
                                "text": "Seulement, Anicet et son équipe ont une version du mot « geek » lessivée, aseptisée, insipidisée, grandpubliquisée, lisse, plate."
                            }
                        ]
                    }
