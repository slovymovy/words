                "senses": [
                    {
                        "sense_id": "51bbee70-2502-3edb-a3db-b7fa7df78221",
                        "entry_id": "3561dc31-d1e0-32a6-bcae-f16836a7b1f4",
                        "glosses": [
                            "книжн. придать кому-нибудь человеческий вид, характер, развить свойства человека в ком-чём-нибудь"
                        ],
