                        "glosses": [
                            "Someone who is not thrifty; a spendthrift, someone who is not careful with their money."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "efd0e896-7c1a-49c2-9998-b23eecc2cd3a",
                                "sense_id": "5f5ed4a4-bc32-3bcf-9652-6f6207d108ce",
                                "text": "My ſcoles are not for unthriftes untaught,\nFor frantick faitours half mad and half ſtraught;\nBut my learning is of another degree"
                            },
                            {
                                "example_id": "b830f0bc-d7be-40ed-9f6e-7adca574c3b1",
                                "sense_id": "5f5ed4a4-bc32-3bcf-9652-6f6207d108ce",
                                "text": "Look what an unthrift in the world doth spend ..."
                            },
                            {
                                "example_id": "27d75320-6980-4b58-aa86-066b003b3fcf",
                                "sense_id": "5f5ed4a4-bc32-3bcf-9652-6f6207d108ce",
                                "text": "But name not Winter-faces, whose skin's slacke;\nLanke, as an unthrifts purse ..."
                            }
                        ]
