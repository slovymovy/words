                {
                    "sense_id": "23b08900-be75-390b-9c77-b23db9e3e3d7",
                    "sense_definition": "Recueillir un liquide biologique, un tissu ou un organe à des fins d'analyse ou de greffe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière doit <w>prélever</w> du sang pour effectuer plusieurs analyses médicales importantes.",
                            "target_lang_translations": {
                                "en": "The nurse must <w>draw</w> blood to carry out several important medical tests.",
                                "ru": "Медсестра должна <w>взять</w> кровь для проведения нескольких важных медицинских анализов.",
                                "de": "Die Krankenschwester muss Blut <w>abnehmen</w>, um mehrere wichtige medizinische Analysen durchzuführen.",
                                "es": "La enfermera debe <w>extraer</w> sangre para realizar varios análisis médicos importantes.",
                                "zh": "护士必须<w>采集</w>血液，以便进行几项重要的医学化验。"
                            }
                        },
                        {
                            "text": "Les médecins ont réussi à <w>prélever</w> un échantillon de peau sans aucune douleur.",
                            "target_lang_translations": {
                                "en": "The doctors managed to <w>take</w> a skin sample without any pain.",
                                "ru": "Врачам удалось <w>взять</w> образец кожи без всякой боли.",
                                "de": "Die Ärzte haben es geschafft, eine Hautprobe ohne jegliche Schmerzen zu <w>entnehmen</w>.",
                                "es": "Los médicos lograron <w>tomar</w> una muestra de piel sin ningún dolor.",
                                "zh": "医生成功地<w>取样</w>了一小块皮肤，患者完全没有感到疼痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extraire",
                        "recueillir"
                    ],
                    "antonyms": [
                        "injecter",
                        "implanter"
                    ],
                    "common_phrases": [
                        "prélever du sang",
                        "prélever un échantillon",
                        "prélever un organe"
                    ],
                    "target_lang_definitions": {
                        "en": "To collect a biological fluid, tissue or organ for analysis or transplant.",
                        "ru": "Взять жидкость, ткань или орган из организма для анализа или трансплантации.",
                        "de": "Körperflüssigkeiten, Gewebe oder Organe für Analysen oder Transplantationen entnehmen.",
                        "es": "Extraer un líquido biológico, un tejido o un órgano con fines de análisis o trasplante.",
                        "zh": "为化验、检查或移植而采集体液、组织或器官。"
                    },
