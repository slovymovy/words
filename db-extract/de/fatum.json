                ],
                "senses": [
                    {
                        "sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                        "entry_id": "b93b974b-5926-3426-9bbc-eb094db8fba6",
                        "glosses": [
                            "höhere Macht, die die einzelnen Ereignisse, die einem Menschen widerfahren, anordnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07fed5fe-9011-4234-b116-0630ee8647f1",
                                "sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                                "text": "Im religiösen Denken der Römer und in der Literatur (besonders bei Vergil) spielte das Fatum eine wichtige Rolle als sinnvolle Ordnung der Weltgeschichte."
                            },
                            {
                                "example_id": "f3988abf-3ade-4325-b9f6-4f0b02459e3a",
                                "sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                                "text": "„Was Freud letzten Endes für den Sinn des Lebens hielt, war das Schicksal, das Fatum, die Ananke.“"
                            },
                            {
                                "example_id": "1c4610be-c169-468d-8212-e33e97a118a0",
                                "sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                                "text": "„Dass heute eine Katastrophe kommen werde, hatte ich, für den das Datum das Fatum bedeutet, gewusst.“"
                            },
                            {
                                "example_id": "d50713ce-eb84-4816-892c-72c5b8d2903a",
                                "sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                                "text": "„Da schaffte es die Besatzung am Ende doch, aus der Umzingelung zu entweichen – einfach schon deshalb, weil sie mich an Bord hatte: ICH bin unverwundbar, also mußte das Fatum dafür Sorge tragen, daß ich heil aus dem Schlamassel herauskam, und damit hatten die anderen auch ihre Chance.“"
                            },
                            {
                                "example_id": "3a22e3f8-60a5-44f1-865c-cc98b8738e54",
                                "sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
                                "text": "„Es hat manchmal den Anschein, als stellten Gott, der Teufel oder das Fatum dem Leben hier oben im Norden eine Falle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed8c7ab7-fba0-4f9c-9c54-f6db0c16b92f",
                        "source_entry_id": "b93b974b-5926-3426-9bbc-eb094db8fba6",
                        "source_sense_id": "c3f65bda-d257-341a-9a94-b0821c9de857",
