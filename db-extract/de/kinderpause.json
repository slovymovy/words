                "senses": [
                    {
                        "sense_id": "e556a9ba-706f-39ed-8a91-b69b895b5750",
                        "entry_id": "780e9b33-d637-3b0c-9c08-d71a7bb5c4f7",
                        "glosses": [
                            "rechtlich gewährte unbezahlte Freistellung eines Elternteils (meist der Mutter) mit Recht auf Rückkehr zu ihrem Arbeitsplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c83bd0-8dc7-4e99-9a86-edbc4b15c5e9",
                                "sense_id": "e556a9ba-706f-39ed-8a91-b69b895b5750",
                                "text": "„Und je länger sie aus dem Beruf aussteigen, desto geringer werden ihre Chancen, darin wieder Fuß zu fassen. Schon die dreijährige Kinderpause wirkt da kontraproduktiv. Gleichzeitig belegen viele Untersuchungen, dass eine hohe Frauenerwerbsquote das beste Mittel gegen Kinderarmut ist.“"
                            },
                            {
                                "example_id": "7cec8c11-bd10-444e-8857-64af92955885",
                                "sense_id": "e556a9ba-706f-39ed-8a91-b69b895b5750",
                                "text": "„Als sie vor vier Jahren nach der Kinderpause wieder in ihren Beruf als Softwareentwicklerin einstieg, bekam sie als Teilzeitkraft keine Projektleitung mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
