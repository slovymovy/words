                    },
                    {
                        "sense_id": "549ef6fa-9269-3522-a5b0-fcf9963a1578",
                        "entry_id": "a508c441-5bd3-3bb1-a767-9651a342cf3c",
                        "glosses": [
                            "Fait de passer un acte",
                            "Action de passer un contrat."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "6aa41229-36c3-4e2c-a755-5b8e1ee156c0",
                                "sense_id": "549ef6fa-9269-3522-a5b0-fcf9963a1578",
                                "text": "Un procès visant des marchés publics de construction pour plus de 35 millions d’euros hors taxes ainsi que la cession d’un terrain en 2016-2018 à Annecy, actes ayant selon l’accusation profité frauduleusement à Bouygues, est d’abord fait de débats techniques ennuyeux sur la loi régissant la passation de marchés et son application."
                            },
                            {
                                "example_id": "467584a8-14c6-4b2c-a904-d3f00f4b499b",
                                "sense_id": "549ef6fa-9269-3522-a5b0-fcf9963a1578",
                                "text": "Assister à la passation d’un contrat, d’un acte."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d28caf4-b23d-3f4d-a9ab-9df1be697da5",
                        "entry_id": "a508c441-5bd3-3bb1-a767-9651a342cf3c",
                        "glosses": [
                            "Fait de passer un acte",
                            "Action de passer ou de faire passer un test."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "820bccf2-466f-4c4c-b17a-3e37ccb800f0",
                                "sense_id": "2d28caf4-b23d-3f4d-a9ab-9df1be697da5",
                                "text": "Les passations des prétests se sont bien passées."
                            },
                            {
                                "example_id": "be948b53-240e-4bac-b686-329aaace82e3",
                                "sense_id": "2d28caf4-b23d-3f4d-a9ab-9df1be697da5",
                                "text": "Les enseignant(e)s seront dès lors invité(e)s, si ils/elles le souhaitent, à poursuivre la passation du prétest avec reste de la classe dans les jours qui précèdent la mise en place du premier atelier d’écriture."
                            }
                        ]
                    },
                    {
                        "sense_id": "4355d7dd-9332-3fe5-8251-8a89a18899dd",
                        "entry_id": "a508c441-5bd3-3bb1-a767-9651a342cf3c",
                        "glosses": [
                            "Transmission"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063c78f2-9f16-44f8-81e0-6717a9dee7ea",
                                "sense_id": "4355d7dd-9332-3fe5-8251-8a89a18899dd",
                                "text": "Le nouveau Premier ministre, Michel Barnier, a détaillé plusieurs axes de la politique de son futur gouvernement, lors de la passation de pouvoir avec Gabriel Attal à Matignon, jeudi 5 septembre."
                            }
                        ]
                    }
