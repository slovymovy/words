                                                "example_id": "844c66de-b472-4714-b881-673bcf423510",
                                                "sense_id": "7f877497-3bdb-3335-b47b-159d7660bf83",
                                                "text": "Dat is een behoorlijke klus."
                                            },
                                            {
                                                "example_id": "86941110-0533-4d67-af25-4ec6b65adf01",
                                                "sense_id": "7f877497-3bdb-3335-b47b-159d7660bf83",
