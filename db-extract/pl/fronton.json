                        ],
                        "examples": [
                            {
                                "example_id": "1f8092e5-85ae-4ca4-a804-a3747ab1e837",
                                "sense_id": "ed7207bc-f444-3257-968e-cf4a7146ef98",
                                "text": "Staliśmy na rynku, podziwiając fronton zabytkowego ratusza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6cdc4ea3-3a71-3766-aac7-e7e2fbfd0884",
                        "entry_id": "f77ac6fd-93a7-3f90-9842-d7daeb3adddd",
                        "glosses": [
                            "trójkątne zwieńczenie fasady lub ryzalitu budynku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a9c8da-a455-4fb4-a0b7-b33fcf438b1e",
                                "sense_id": "6cdc4ea3-3a71-3766-aac7-e7e2fbfd0884",
                                "text": "W architekturze nowożytnej spotkać można również frontony stanowiące segment kręgu, półowalne, przerywane lub gierowane."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e94604-df68-4fe2-af7c-957231818a98",
                        "source_entry_id": "f77ac6fd-93a7-3f90-9842-d7daeb3adddd",
                        "source_sense_id": "6cdc4ea3-3a71-3766-aac7-e7e2fbfd0884",
                        "target_lang_word": "pediment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pediment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "950780eb-1a54-33e6-aa2e-d82708014c84",
                                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                                        "glosses": [
                                            "A classical architectural element consisting of a triangular section or gable found above the horizontal superstructure (entablature) which lies immediately upon the columns; fronton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8f82f1-35b1-453c-8134-87e9598250e6",
                                                "sense_id": "950780eb-1a54-33e6-aa2e-d82708014c84",
                                                "text": "Passing the Congregation Shearith Israel on Central Park West (a white whale of a building with a triangular pediment supported by four count ’em four massive Corinthian columns), Professor Solanka scurrying through the downpour remembered the newly bat-mitzvahed thirteen-year-old girl he’d glimpsed through the side door, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f384aa1-eff4-3dce-bda5-fe6390e03fa5",
                                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                                        "glosses": [
                                            "A very gently sloping (0.5°-7°) inclined bedrock surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82d6ad7c-34a6-4d61-b4ef-35ac82e04c8d",
                        "source_entry_id": "f77ac6fd-93a7-3f90-9842-d7daeb3adddd",
                        "source_sense_id": "6cdc4ea3-3a71-3766-aac7-e7e2fbfd0884",
