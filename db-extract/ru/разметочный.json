                "senses": [
                    {
                        "sense_id": "d9f80776-893c-367f-8de4-ba55644463f6",
                        "entry_id": "515ea074-a35c-30ea-8444-7126314f9fab",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным разметка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612bfa04-8905-49da-8528-0f3e7f553c47",
                                "sense_id": "d9f80776-893c-367f-8de4-ba55644463f6",
                                "text": "В лапту можно сражаться и зимой: разметочные линии на утоптанном снегу наносятся краской."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbb42ca6-f67e-34c1-8b6e-edf4065e5adb",
                        "entry_id": "515ea074-a35c-30ea-8444-7126314f9fab",
                        "glosses": [
                            "предназначенный для разметки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae9abe13-6474-4cd6-b52f-036203fe191b",
                                "sense_id": "dbb42ca6-f67e-34c1-8b6e-edf4065e5adb",
                                "text": "Пробейте лунки по всей длине грядки; разметочный шнур должен располагаться посередине."
                            }
                        ]
                    }
