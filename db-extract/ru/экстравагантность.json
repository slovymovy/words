                                        "glosses": [
                                            "過分享受的"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f240e0-84d4-4269-9467-dfa3575a1307",
                                                "sense_id": "c2863d9a-9fe7-3336-92e0-8eeb900de3b1",
                                                "text": "閒居是一種奢侈。"
                                            },
                                            {
                                                "example_id": "b289eb82-179e-4a8a-98cb-5c57eb4a9d08",
                                                "sense_id": "c2863d9a-9fe7-3336-92e0-8eeb900de3b1",
                                                "text": "闲居是一种奢侈。"
                                            },
                                            {
                                                "example_id": "02e20f8d-a351-432d-b98e-1b3b5588d30e",
                                                "sense_id": "c2863d9a-9fe7-3336-92e0-8eeb900de3b1",
                                                "text": "夫以奢侈之君，御好淫僻之民，欲國無亂，不可得也。",
                                                "translation": "用那些生活豪華、肆意揮霍的國君，去統治放蕩邪惡的國民，想要這國家不發生動亂的，是不可能的。"
                                            },
                                            {
                                                "example_id": "6cb4ac55-79cd-4946-9a96-4f456377e691",
                                                "sense_id": "c2863d9a-9fe7-3336-92e0-8eeb900de3b1",
                                                "text": "夫以奢侈之君，御好淫僻之民，欲国无乱，不可得也。",
                                                "translation": "用那些生活豪華、肆意揮霍的國君，去統治放蕩邪惡的國民，想要這國家不發生動亂的，是不可能的。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
