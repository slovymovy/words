                                        "sense_id": "b83895fe-3622-3b11-a79e-8a4ebdeec629",
                                        "entry_id": "05845ea8-cddc-3b8a-9677-7eaae32e3816",
                                        "glosses": [
                                            "A musical instrument for experimenting with the mathematical relations of musical sounds, consisting of a single string stretched between two bridges, one or both of which can be moved, and which stand upon a graduated rule for the purpose of changing and measuring the length of the part of the string between them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03b0c8c9-2865-4db8-a6b4-689352701673",
                                                "sense_id": "b83895fe-3622-3b11-a79e-8a4ebdeec629",
                                                "text": "If a musician were going to give a lecture upon the mathematical part of his art, he would find a very elegant substitute for the monochord in the Chinese kin."
                                            }
                                        ]
                                    },
                                    {
