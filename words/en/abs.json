            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cb118e1-b114-3bb2-82fd-5a42efc87f5f",
                    "sense_definition": "The abdominal muscles.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "muscles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He does sit-ups every morning to get six-pack <w>abs</w>.",
                            "target_lang_translations": {
                                "ru": "Он делает упражнения на пресс каждое утро, чтобы накачать <w>пресс</w> кубиками.",
                                "zh": "他每天早上做仰卧起坐，为了练出六块<w>腹肌</w>。",
                                "es": "Hace abdominales cada mañana para conseguir una <w>tableta</w> de chocolate."
                            }
                        },
                        {
                            "text": "Her <w>abs</w> were sore for days after the intense workout.",
                            "target_lang_translations": {
                                "ru": "У нее несколько дней болел <w>пресс</w> после интенсивной тренировки.",
                                "zh": "高强度锻炼后，她的<w>腹肌</w>酸痛了好几天。",
                                "es": "Sus <w>abdominales</w> estuvieron doloridos durante días después del entrenamiento intenso."
                            }
                        }
                    ],
                    "synonyms": [
                        "abdominal muscles",
                        "abdominals",
                        "stomach muscles",
                        "core"
                    ],
                    "common_phrases": [
                        "six-pack abs",
                        "flat abs",
                        "washboard abs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of abdominals"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мышцы живота.",
                        "zh": "腹部肌肉。",
                        "es": "Los músculos abdominales."
                    },
                    "translations": {
