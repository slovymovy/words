                        ],
                        "form": "souriants"
                    },
                    {
                        "form_id": "217b15c9-0a3e-4d41-b7fe-c9f2e277f72d",
                        "entry_id": "60d64cfa-589b-3a38-9102-f43938861eff",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "souriante"
                    },
                    {
                        "form_id": "4eae3594-8124-44ed-a230-a2ae9a481ec2",
                        "entry_id": "60d64cfa-589b-3a38-9102-f43938861eff",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "souriantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                        "entry_id": "60d64cfa-589b-3a38-9102-f43938861eff",
                        "glosses": [
                            "Qui sourit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11e8a798-afe6-4952-9974-b3311daa874c",
                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                "text": "La porte était à peine fermée derrière le prince que le roi de Navarre, […], apparut souriant sur le seuil de la chambre."
                            },
                            {
                                "example_id": "929234f7-bef1-469c-8e13-c7d9cdeb197c",
                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                "text": "Lorsqu'au bout de quelques semaines Elhamy la remercia, avec une cordialité souriante, du bien qu'elle avait fait à son fils, une émotion sourde étreignit sa gorge."
                            },
                            {
                                "example_id": "b2024c62-ac34-4750-8e58-9b5a0095918b",
                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                "text": "Cela intéressait vivement notre maître d’hôtel pourtant, car le voici ceint de son blanc tablier, la mine souriante, la bouche en cœur, le visage jambonné par la chaleur des fourneaux et venant connaître notre opinion sur sa cuisine."
                            },
                            {
                                "example_id": "0bf4c678-304d-4f91-aa7a-8373acb1f09f",
                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                "text": "[…], la directrice du casino, souriante, vient nous saluer."
                            },
                            {
                                "example_id": "748b7137-6a87-45a3-a3b9-3827bf81bdc7",
                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                "text": "Le libraire avait les bras chargés de quatre lourds in-octavo qu'il déposa sur une tablette. Tout souriant, le client s'approcha, posa une série de questions, nota sur un carnet la date de l'édition, le prix des volumes […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33d9dcc1-071e-4177-822f-2cc24ed28fa6",
                        "source_entry_id": "60d64cfa-589b-3a38-9102-f43938861eff",
                        "source_sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                        "target_lang_word": "freundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                        "entry_id": "917428f3-f0fb-3206-8883-86c50a4e4b48",
                                        "glosses": [
                                            "in der Begegnung mit anderen Menschen, Dingen, Ereignissen positiv eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7127f632-47b7-44b4-b91d-8f5f46046f05",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "Der Verkäufer ist freundlich."
                                            },
                                            {
                                                "example_id": "53e971df-62f4-498f-aa63-e8553b2d9194",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Er ist ein sehr freundlicher und äußerst hilfsbereiter Mitbürger.“"
                                            },
                                            {
                                                "example_id": "498b9730-a1d1-4224-83db-5cef52b70464",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Kinder im Kindergarten, und nicht nur diese, brauchen und wünschen sich einen freundlichen und zugewandten Umgang.“"
                                            },
                                            {
                                                "example_id": "3ca951a0-35da-45bb-b067-d5a54f21ac39",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Die Empfangsdame war jüngeren Alters, machte einen freundlichen und intelligenten Eindruck auf mich. Ihre lebhaften Augen blickten mich durch eine feine Brille hindurch interessiert an.“"
                                            },
                                            {
                                                "example_id": "f87c2f36-17c2-4984-b89d-e60799b4d034",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Damals fast eine kleine Provokation dagegen das dritte Standbild: Lässig und freundlich schaut der alte Moltke zu uns herunter -- mit übergeschlagenen Beinen, ohne Heldenpose, ohne den Mantel der Geschichte.“"
                                            },
                                            {
                                                "example_id": "982de5e5-b368-4ed4-a796-2a8770abf624",
                                                "sense_id": "7251d5b0-e63d-370c-8e99-a80a1276a99b",
                                                "text": "„Unvorstellbar dass an einem so freundlichen Tag an einem so freundlichen Ort ein Unheil geschehen konnte. Doch es geschah - und nichts würde danach mehr so sein wie zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                        "entry_id": "917428f3-f0fb-3206-8883-86c50a4e4b48",
                                        "glosses": [
                                            "sonnig, angenehm warm"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "189ad66b-b74f-48d6-8b4f-2201b52b9335",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "„Unvorstellbar dass an einem so freundlichen Tag an einem so freundlichen Ort ein Unheil geschehen konnte. Doch es geschah - und nichts würde danach mehr so sein wie zuvor.“"
                                            },
                                            {
                                                "example_id": "c3174f2c-8307-4bf8-b7cd-2f558859130b",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "Der morgige Tag soll freundlich werden."
                                            },
                                            {
                                                "example_id": "fa6275cf-4487-453c-abef-9261addc6281",
                                                "sense_id": "bd7cfa88-44e1-3e7a-b71c-d9bea6ff7383",
                                                "text": "„Als er am Fuße Südamerikas vor Anker gegangen war und das Wetter freundlich blieb, entschloss sich FitzRoy zu einer mutigen Expedition mit dem Walboot zur Insel Hoorn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b2301a-4284-48fd-b0a5-96f7cb17b0d1",
                        "source_entry_id": "60d64cfa-589b-3a38-9102-f43938861eff",
                        "source_sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
