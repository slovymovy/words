                "senses": [
                    {
                        "sense_id": "786533f4-03be-325a-87df-12db1094ac1d",
                        "entry_id": "df75393b-a972-3f71-81fe-b91ea66264bb",
                        "glosses": [
                            "A woman or female animal during or after her first pregnancy."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fee41ba8-3e80-3cad-85ee-053e5aa7cd36",
                        "entry_id": "df75393b-a972-3f71-81fe-b91ea66264bb",
                        "glosses": [
                            "A woman or female animal that has carried a first pregnancy to a viable gestational age."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb667a8e-609c-4df1-91df-684a2c3d69dc",
                        "source_entry_id": "df75393b-a972-3f71-81fe-b91ea66264bb",
                        "source_sense_description": "woman or female animal during or after her first pregnancy — see also primigravida",
                        "target_lang_word": "primipare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "primipare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdaa6bed-00f3-3d88-839e-8dc7bf4ed6d4",
                                        "entry_id": "553bba7b-b191-3329-9a78-db77a6ab1811",
                                        "glosses": [
                                            "Qualifie une femme qui enfante pour la première fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52782db5-8b5b-4118-8fb4-cde90986ccaf",
                                                "sense_id": "fdaa6bed-00f3-3d88-839e-8dc7bf4ed6d4",
                                                "text": "Quoi? Est-ce qu’elle est primipare ou multipare? Euh!… Vivipare…"
                                            },
                                            {
                                                "example_id": "102e6db5-e388-43f7-9d38-70864308f617",
                                                "sense_id": "fdaa6bed-00f3-3d88-839e-8dc7bf4ed6d4",
                                                "text": "Elles sont toujours primipares, elles n'ont pas déjà deux gosses épuisants, des vaisseaux sanguins éclatés sur les jambes, de la cellulite, des pieds douloureux et des seins affaissés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e003b608-aa47-3325-98a0-4882ffbef76a",
                                        "entry_id": "553bba7b-b191-3329-9a78-db77a6ab1811",
                                        "glosses": [
                                            "Qualifie une femelle qui met bas pour la première fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58038e3-e0a3-42ad-9723-ee4f19fb087e",
                                                "sense_id": "e003b608-aa47-3325-98a0-4882ffbef76a",
                                                "text": "Et [il] commença autour de lui une ronde, comme autour du veau va une mère",
                                                "translation": "primipare, gémissante, qui ne sait rien de la naissance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "primipare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94e90081-7266-3312-ad63-18747548ff97",
                                        "entry_id": "a0dc08b0-a2be-3827-b6fb-ad9d6d6eb133",
                                        "glosses": [
                                            "Femme qui accouche pour la première fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430a0ef8-f745-45af-93e2-247fff075577",
                                                "sense_id": "94e90081-7266-3312-ad63-18747548ff97",
                                                "text": "La date de l’accouchement est difficile à prévoir pour une primipare."
                                            }
                                        ]
                                    }
                                ]
                            }
