                        ]
                    },
                    {
                        "translation_id": "d4a27cd8-ad11-43dd-8fa7-c8c0f9abfe54",
                        "source_entry_id": "003d1ef9-d9d5-3f33-864f-9509d346aab4",
                        "source_sense_id": "3d16011c-2f4d-3d29-9833-3b3e0bbad087",
                        "target_lang_word": "Xenophobie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xenophobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d4a277-4b75-3ad4-8ce7-8b4852246c6c",
                                        "entry_id": "2171ea64-c8bc-3d48-91d2-f205f223ec0b",
                                        "glosses": [
                                            "Angst vor oder Abneigung gegenüber Fremden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89fa6e66-2194-4a0e-a91c-f06f0680d281",
                                                "sense_id": "d9d4a277-4b75-3ad4-8ce7-8b4852246c6c",
                                                "text": "„Der Film Fritz Langs liefert das Paradigma der unter den Deutschen seit dem Ende des 19. Jahrhunderts um sich greifenden Xenophobie.“"
                                            },
                                            {
                                                "example_id": "388a4aaa-ffbb-4b37-a2e3-20295761bafc",
                                                "sense_id": "d9d4a277-4b75-3ad4-8ce7-8b4852246c6c",
                                                "text": "„In offene Xenophobie umgeschlagen ist die Stimmung in Italien, das erst in den vergangenen zehn Jahren zum Einwanderungsland wurde.“"
                                            },
                                            {
                                                "example_id": "d67b10a7-87d0-4eee-a6fa-ef2a7f83e4c6",
                                                "sense_id": "d9d4a277-4b75-3ad4-8ce7-8b4852246c6c",
                                                "text": "Dass es sich bei der Xenophobie um den Vorgang der Abwehr eines für unaushaltbar gehaltenen Gefühls handelt, zeigt sich an der Wirkungslosigkeit von Empathie, Aufklärung und guten Gründen."
                                            },
                                            {
                                                "example_id": "505893cf-7d4b-4909-8f97-17500ab275fb",
                                                "sense_id": "d9d4a277-4b75-3ad4-8ce7-8b4852246c6c",
                                                "text": "„Die tief verwurzelte Xenophobie der Tongaer war darüber hinaus ein Hindernis für den Tourismus, auf den Tonga seine wirtschaftliche Zukunft bauen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1489ef27-efa7-4e8b-9a97-5b3456523d52",
