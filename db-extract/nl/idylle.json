                    {
                        "translation_id": "1461dfdd-1603-46a8-baa7-3128e90bfaba",
                        "source_entry_id": "32ffff1c-58a1-3892-bcc0-f06f2d8ffd30",
                        "source_sense_id": "82b702fd-68b4-3289-b600-883b132fa7fb",
