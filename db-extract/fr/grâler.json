                    {
                        "sense_id": "6cc6568b-912d-3a7a-a163-ed812810c47c",
                        "entry_id": "e17b4a12-e470-3c43-8e87-2e31a641e25a",
                        "glosses": [
                            "Griller."
                        ],
                        "tags": [
                            "Charentes",
                            "Poitou",
                            "Anjou"
                        ],
                        "examples": [
                            {
                                "example_id": "7571d0b8-d096-44cc-859c-a58bd402a989",
                                "sense_id": "6cc6568b-912d-3a7a-a163-ed812810c47c",
                                "text": "Enfin, on appelait « diable » une poêle en terre cuite où l’on faisait « grâler » les marrons et les pommes de terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "17d29507-e7b0-355d-8cc7-988372db658f",
                        "entry_id": "e17b4a12-e470-3c43-8e87-2e31a641e25a",
                        "glosses": [
                            "Devenir trop cuit, devenir brûlé."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f525e97e-f927-4d85-96c8-b798102c7598",
                                "sense_id": "17d29507-e7b0-355d-8cc7-988372db658f",
                                "text": "Enfournez, boulitez au bout de 20 minutes, le gâteau ne doit pas grâler."
                            },
                            {
                                "example_id": "a1996932-b961-4a06-bdcd-b917ae8d1660",
                                "sense_id": "17d29507-e7b0-355d-8cc7-988372db658f",
                                "text": "— Excusez-moi, mon bon monsieur, mais j’ai mon rôti au four… Faut que j’y alle voir si je veux point qu’y grâle !"
                            }
                        ]
                    }
