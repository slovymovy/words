                "senses": [
                    {
                        "sense_id": "5e2e3c19-58b0-31a7-b393-0333ae273217",
                        "entry_id": "8985c697-d9be-37b5-8c7e-798502363548",
                        "glosses": [
                            "Genre der künstlerischen Fotografie; Umsetzung des künstlerischen Aktes (im Sinne von Darstellung eines nackten menschlichen Körpers) mit den technischen Mitteln der Fotografie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "196433d7-0dd5-4d58-82ba-51b9140f7222",
                                "sense_id": "5e2e3c19-58b0-31a7-b393-0333ae273217",
                                "text": "„Die Aktfotografie gilt, neben der Porträtfotografie, als hohe Schule der Fotografie[.]“"
                            },
                            {
                                "example_id": "b26f61ad-49bd-4ad7-8c8f-e9a80e062cb9",
                                "sense_id": "5e2e3c19-58b0-31a7-b393-0333ae273217",
                                "text": "„Die Grenzen zwischen Aktfotografie und erotischer Fotografie sind fließend, den subjektiven Moralvorstellungen des Einzelnen und den jeweiligen kulturellen Vorstellungen von ‚guten Sitten‘ unterworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
