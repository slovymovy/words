                                "sense_id": "ef439886-ff07-39cf-b89e-e64bed680e44",
                                "text": "In April, as an Air Canada Jazz flight was landing at Trudeau Airport, a drone came so close the pilot was able to identify it as a quadcopter."
                            },
                            {
                                "example_id": "6e8bd5a5-5650-4b4f-9d59-ec51ca39a454",
                                "sense_id": "ef439886-ff07-39cf-b89e-e64bed680e44",
                                "text": "he saw, sweeping back and forth over the treetops, a sleek-looking quadcopter drone."
                            }
                        ]
                    }
