                "senses": [
                    {
                        "sense_id": "70516160-17bd-3472-a20b-342f90fbf8b8",
                        "entry_id": "768891de-8648-3d86-8c1f-bb7116bb6568",
                        "glosses": [
                            "физиол., мед. первородный кал ребёнка; первые испражнения новорождённого"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e02cedb-8579-4363-8586-00dd85b42e74",
                                "sense_id": "70516160-17bd-3472-a20b-342f90fbf8b8",
                                "text": "Контрастное исследование толстой кишки гастрографином обнаруживает микрокишку с небогатыми остатками мекония в виде теней пятнистой формы. Сам меконий белого цвета, утолщен и твердый."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a03df708-b0e6-48a0-bd9a-dcb2c6261ca7",
                        "source_entry_id": "768891de-8648-3d86-8c1f-bb7116bb6568",
                        "source_sense_id": "70516160-17bd-3472-a20b-342f90fbf8b8",
                        "target_lang_word": "meconium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meconium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c84a98e9-cc54-374b-abaa-f5b9b3c71519",
                                        "entry_id": "4e3d954e-2aee-34f5-b7ac-df954c23ca8a",
                                        "glosses": [
                                            "A dark green mass, the contents of the fetal intestines during the later stages of mammalian gestation, that forms the first feces of the newborn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8e06b42-9788-48db-af9f-213657aa3cc0",
                                                "sense_id": "c84a98e9-cc54-374b-abaa-f5b9b3c71519",
                                                "text": "The meconium is dark brownish-green in color. The first meconium passed is semi-solid, having been partially dried out in the large intestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab5fe7c5-68bf-3d9a-84e5-41fa2886cf95",
                                        "entry_id": "4e3d954e-2aee-34f5-b7ac-df954c23ca8a",
                                        "glosses": [
                                            "Opium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c1f6ae8-8661-4e7e-8b1e-1477bb5c538e",
                        "source_entry_id": "768891de-8648-3d86-8c1f-bb7116bb6568",
                        "source_sense_id": "70516160-17bd-3472-a20b-342f90fbf8b8",
                        "target_lang_word": "Mekonium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mekonium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d212db8-5514-363c-84ca-30b8b0d8bde0",
                                        "entry_id": "c6a5249d-6bd4-3dee-bd55-d44c26ca555f",
                                        "glosses": [
                                            "erster Stuhl eines Neugeborenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5a8972-39a3-4987-bcb3-76975709b48b",
                                                "sense_id": "7d212db8-5514-363c-84ca-30b8b0d8bde0",
                                                "text": "Das Mekonium ist der erste Stuhl eines Neugeborenen, der während der intrauterinen Entwicklung gebildet und meist erst nach der Geburt ausgeschieden wird."
                                            },
                                            {
                                                "example_id": "b9ea3740-44a5-412a-9518-5ffa31c57f4b",
                                                "sense_id": "7d212db8-5514-363c-84ca-30b8b0d8bde0",
                                                "text": "Physiologisch erfolgt der Abgang des Mekoniums etwa innerhalb der ersten 24 bis 48 Lebensstunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02cb52f6-d86f-385a-8dcc-2f8b7bd17381",
                                        "entry_id": "c6a5249d-6bd4-3dee-bd55-d44c26ca555f",
                                        "glosses": [
                                            "Ausscheidung von Stoffwechselprodukten des aus der Puppe geschlüpften Insekts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714037fd-a0ff-4421-8daa-a2909778ecb4",
                                                "sense_id": "02cb52f6-d86f-385a-8dcc-2f8b7bd17381",
                                                "text": "Dieser frisch geschlüpfte Falter hat unter sich eine Art \"Blutstropfen\". Man nennt dies allgemein \"Mekonium\", bei Insekten Darmpech oder Puppenharn."
                                            },
                                            {
                                                "example_id": "b31ecb2d-166a-45b0-a0a0-b6a0eaf3d313",
                                                "sense_id": "02cb52f6-d86f-385a-8dcc-2f8b7bd17381",
                                                "text": "Wie bei allen Taillenwespen ist der Enddarm der Larve geschlossen. Kot wird von ihr nur einmal, unmittelbar vor der Verpuppung, als sogenanntes Mekonium abgegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fdcd3031-a09e-3494-9602-1f257d292a4d",
                                        "entry_id": "c6a5249d-6bd4-3dee-bd55-d44c26ca555f",
                                        "glosses": [
                                            "Opium"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac3b4d8-ee84-4204-8dbf-2f07e0c2d418",
                                                "sense_id": "fdcd3031-a09e-3494-9602-1f257d292a4d",
                                                "text": "Schon vorher kannte man einen Extrakt aus den Blättern der Mohnpflanze, der meist als Mekonium bezeichnet und später durch das stärker wirksame Opium verdrängt wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
