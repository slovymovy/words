                "senses": [
                    {
                        "sense_id": "38ebd2b8-93f2-3304-a39f-08853bed9e76",
                        "entry_id": "f40e02ff-606a-3b18-bbe6-87043f1ec2aa",
                        "glosses": [
                            "ehrenamtlicher studentischer Verein, der ein Programm zwischen Kneipe, Kulturangeboten, Disko und Partys bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2dd220-83d8-4e4f-9e13-eab7e7f78cc6",
                                "sense_id": "38ebd2b8-93f2-3304-a39f-08853bed9e76",
                                "text": "„Und die Nächte, die verbrachte er am liebsten in der »Tangente«, dem Studentenclub im »Haus Buhl« am Ende der Hauptstraße.“"
                            },
                            {
                                "example_id": "794ff631-daaf-4b18-9300-b5b8e7880060",
                                "sense_id": "38ebd2b8-93f2-3304-a39f-08853bed9e76",
                                "text": "„Staunt dort über bemerkenswerte Kunst im öffentlichen Raum, lässt die Sau raus in einem Studentenclub oder trinkt ein Craft Beer in einer Hipsterbar.“"
                            },
                            {
                                "example_id": "62c0d1e3-c072-4398-9b68-d24211f42c12",
                                "sense_id": "38ebd2b8-93f2-3304-a39f-08853bed9e76",
                                "text": "„Studenten – unter ihnen Angela Merkel – legten die Ruinen frei, und so entstand hier der seinerzeit größte Studentenclub Europas.“"
                            },
                            {
                                "example_id": "1c6b28f8-1797-465c-9669-0594f783c782",
                                "sense_id": "38ebd2b8-93f2-3304-a39f-08853bed9e76",
                                "text": "„Der Studentenclub befand sich in der mittelalterlichen Befestigungsanlage der Stadt.“"
                            },
                            {
                                "example_id": "7a4c9675-f3c0-4bee-8dd3-964a9c0e14cf",
                                "sense_id": "38ebd2b8-93f2-3304-a39f-08853bed9e76",
                                "text": "„Mein privates Baugeschäft stak noch in der Ideen- und Verhandlungsphase und meine Mitarbeit im Studentenclub hatte ich auf ein Minimum zurückgefahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
