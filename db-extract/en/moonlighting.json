                "entry_id": "33d01871-1219-33b4-a0dd-19d866ec144a",
                "word": "moonlighting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aeeb9353-9395-4b88-bd84-156041782af0",
                        "entry_id": "33d01871-1219-33b4-a0dd-19d866ec144a",
                        "tags": [
