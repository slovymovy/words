                        "tags": [],
                        "examples": [
                            {
                                "example_id": "952360ea-cd1c-4159-9642-3b3180f71a00",
                                "sense_id": "3c4d9849-d2d6-3278-8af8-e8d9a1aafb4d",
                                "text": "„Das Nord-Sotho ist mit dem Süd-Sotho nahezu identisch und eng verwandt mit dem Setswana.“"
                            },
                            {
                                "example_id": "74d8ff73-13ce-42ec-95d6-52e0d790a2bf",
                                "sense_id": "3c4d9849-d2d6-3278-8af8-e8d9a1aafb4d",
                                "text": "„Die Bevölkerung ist ethnisch und sprachlich sehr vielfältig, hier werden v. a. Nord-Sotho (Sepedi, über 50 %), Xitsonga und Tshivenda gesprochen.“"
                            }
                        ],
