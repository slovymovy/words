    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc45d9d0-f2e8-3c30-8bc9-6211f6cb0d6a",
                "word": "cyber",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bfa87fec-9871-385b-a423-888ade4cd9c9",
                        "entry_id": "fc45d9d0-f2e8-3c30-8bc9-6211f6cb0d6a",
                        "glosses": [
                            "Of, or having to do with, the Internet; alternative spelling of cyber-."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbe4130-98d5-4e5d-91a2-073d105e977f",
                                "sense_id": "bfa87fec-9871-385b-a423-888ade4cd9c9",
                                "text": "I pointed out to him we have significant cyber capability and he knows it. He doesn’t know exactly what it is, but it’s significant. And if in fact they violate these basic norms, we will respond cyberly. He knows. In a cyber way."
                            }
                        ]
                    },
                    {
                        "sense_id": "88575aec-74a3-3232-9875-bf7d068ab29d",
                        "entry_id": "fc45d9d0-f2e8-3c30-8bc9-6211f6cb0d6a",
                        "glosses": [
                            "Cybergoth."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bf5dd282-9439-46b1-aa26-c4f2a4092d7a",
                                "sense_id": "88575aec-74a3-3232-9875-bf7d068ab29d",
                                "text": "She is a high priestess of the Church of the SubGenius, a devotee of the music of Tom Waits and Robert Smith, and of goth and cyber subcultures."
                            },
                            {
                                "example_id": "fd3e6d77-2af5-4ad5-be3a-f80f5b0a7784",
                                "sense_id": "88575aec-74a3-3232-9875-bf7d068ab29d",
                                "text": "...a cross between metal, punk, goth, cyber, and rock."
                            },
                            {
                                "example_id": "240e422f-4c16-4784-b428-63944b8ce463",
                                "sense_id": "88575aec-74a3-3232-9875-bf7d068ab29d",
                                "text": "No CyberGoth is complete without gigantic \"stompy\" platform boots and the optional toy ray gun. Some are even more anachronistic in that they incorporate old Renaissance and Victorian styles into their much-loved cyber wear."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e5074874-a964-3b50-a88a-fee6b78a4bc2",
                "word": "cyber",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cb093ee-7640-3ae6-80e7-d59fb54dcd0e",
                        "entry_id": "e5074874-a964-3b50-a88a-fee6b78a4bc2",
                        "glosses": [
                            "Everything having to do with the Internet considered collectively."
                        ],
                        "tags": [
                            "singular",
                            "singular-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1af24876-aae4-4598-b363-c455c4a2ae96",
                                "sense_id": "1cb093ee-7640-3ae6-80e7-d59fb54dcd0e",
                                "text": "These prefigure the more complex aspects of virtual and real interactions which the cyber will deliver to us in these early years of the new millennium."
                            },
                            {
                                "example_id": "557b2bf9-8ca4-418c-a44e-45c7a0effd21",
                                "sense_id": "1cb093ee-7640-3ae6-80e7-d59fb54dcd0e",
                                "text": "2012, Sean Swan (Ed), On the Cyber\nThe pace and extent to which the cyber is transforming our world increases daily."
                            }
                        ]
                    },
                    {
                        "sense_id": "177c1eb9-74a1-378d-a28c-8427aa4fdc0c",
                        "entry_id": "e5074874-a964-3b50-a88a-fee6b78a4bc2",
                        "glosses": [
                            "Cybersecurity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fb6301-7563-4c81-83f5-3aa7dfcd34d0",
                                "sense_id": "177c1eb9-74a1-378d-a28c-8427aa4fdc0c",
                                "text": "Is there an escalatory ladder in cyber, the same as with weapons of mass destruction? Fleming doesn't like the comparison with nuclear deterrence but says that Russia is indeed conscious of escalation risk."
                            }
                        ]
                    }
                ],
