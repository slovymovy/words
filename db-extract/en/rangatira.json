                        "glosses": [
                            "A hereditary Māori leader of a kinship group; a chieftain or high-born Maori."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "e41612b0-ce66-4fd7-804d-946595b77305",
                                "sense_id": "16622b01-14bd-332d-89a8-f8a25e28a216",
                                "text": "Stout commoners on the left side, and real rangatira on the right distaff side. A New Zealander through and through."
                            },
                            {
                                "example_id": "2acf17a2-2ab3-43e9-879c-1ea96a0a6dac",
                                "sense_id": "16622b01-14bd-332d-89a8-f8a25e28a216",
                                "text": "Defeated and captured rangatira became slaves, but they could regain their former status if they succeeded in escaping from their captors or eventually obtaining an honourable release."
                            }
                        ]
