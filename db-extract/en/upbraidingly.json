                        "examples": [
                            {
                                "example_id": "966e0422-5428-479c-8253-9c5cb048fcc9",
                                "sense_id": "073201a7-65bb-33e0-8fcd-a1c20cda1373",
                                "text": "He hears the horses--they have broken their tethers--he can hear them whinnying, upbraidingly, far off."
                            },
                            {
                                "example_id": "064e0365-d12e-4b91-a3b9-c4dd96b90e59",
                                "sense_id": "073201a7-65bb-33e0-8fcd-a1c20cda1373",
                                "text": "And then--there lay the heart of the worry, proving him only too likely a graceless jealous middle-age curmudgeon, a senile sentimentalist, thus did he upbraidingly mock himself--were there not signs of Damaris developing into a rather thorough paced coquette?"
                            }
                        ]
                    }
