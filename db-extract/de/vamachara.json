                "translations": [
                    {
                        "translation_id": "4f6774aa-bf6b-425f-9338-f0c71d288efb",
                        "source_entry_id": "69843947-3484-35b0-976f-b8174d861ca3",
                        "source_sense_id": "7cb26618-9248-3937-8671-daa82a30cd4f",
                        "source_sense_description": "tantrischer Pfad",
                        "target_lang_word": "Vamachara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vamachara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab95f2a1-faa6-33ef-8cbb-87e83cfa8ec5",
                                        "entry_id": "1ef621ef-e64a-3edb-a482-4f7600fee2a6",
                                        "glosses": [
                                            "Alternative form of vamachara."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14409ae7-0e36-434d-aa0c-01f81995c2b6",
                                                "sense_id": "ab95f2a1-faa6-33ef-8cbb-87e83cfa8ec5",
                                                "text": "The Dravidians, mild inhabitants of India, worshipped Pitrus (forefathers) and other iconographic representations of deity, emphasizing the hierophantic side of worshipping idols, which included Vamacharas, left-hand practices of the Shakti cult, etc."
                                            },
                                            {
                                                "example_id": "0f31ed1f-59da-4e3b-84b9-7c842f088eb6",
                                                "sense_id": "ab95f2a1-faa6-33ef-8cbb-87e83cfa8ec5",
                                                "text": "\"The initiated Bhatta (Kashmiri Brahmin) bent upon taking liquor, being addicted to Vamachara by which the pride of his own clan has been set at naught, with a plate of fish in his hand, approaches the house of his teacher[…].\""
                                            },
                                            {
                                                "example_id": "1c0a75c1-d325-44c6-8e29-0b6e9ecc2771",
                                                "sense_id": "ab95f2a1-faa6-33ef-8cbb-87e83cfa8ec5",
                                                "text": "The Aryanised socio-religious culture had degenerated into Vamachara Tantric practices, the cult of sex and palate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5880ef6c-f4e6-3914-864a-93bc46b8c6c4",
                                        "entry_id": "1ef621ef-e64a-3edb-a482-4f7600fee2a6",
                                        "glosses": [
                                            "A follower of the vamachara path."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17942aad-49ec-4a93-8c57-6ae920fafbe4",
                                                "sense_id": "5880ef6c-f4e6-3914-864a-93bc46b8c6c4",
                                                "text": "The Dakshinacharas emphasised the male principle while the Vamacharas paid more attention to the female principle. But, both exalted sex to a religious principle."
                                            },
                                            {
                                                "example_id": "e4b2c547-77b3-424b-a8c5-2564d630368a",
                                                "sense_id": "5880ef6c-f4e6-3914-864a-93bc46b8c6c4",
                                                "text": "Above all, in the medley of Aryans, Mongols and aborigines, which it created, it unconsciously led the way to some of the hideous Vamacharas."
                                            },
                                            {
                                                "example_id": "c54e50b3-55d5-46e1-8095-54bd148b6d96",
                                                "sense_id": "5880ef6c-f4e6-3914-864a-93bc46b8c6c4",
                                                "text": "The Vamacharas follow texts like Kularnava, Kamika, and the Parasurama agamas among others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
