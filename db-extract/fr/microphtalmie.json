                        "glosses": [
                            "Réduction des dimensions du globe oculaire dans ses différents diamètres, due à une anomalie congénitale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cc5f1a-1d4d-4c31-a85a-2d8b758b2f31",
                                "sense_id": "a1b1dc29-2231-3ff3-8ad4-43b2f06357ad",
                                "text": "La microphtalmie syndromique type 5 est caractérisée par l’association d’un ensemble d’anomalies oculaires (anophtalmie, microphtalmie et anomalies rétiniennes) et de diverses malformations du système nerveux central avec retard de développement."
                            },
                            {
                                "example_id": "29b8b62a-0c99-4b1e-b995-c39ccfa5248d",
                                "sense_id": "a1b1dc29-2231-3ff3-8ad4-43b2f06357ad",
                                "text": "Cliniquement, on retrouve une hydrocéphalie associée à des pathologies ophtalmiques (dysplasie et décollement rétinien, microphtalmie, anomalie de la chambre antérieure, cataracte…)."
                            }
                        ]
