                "senses": [
                    {
                        "sense_id": "970088b0-4a1a-3ae9-8dec-86efc2b86dd7",
                        "entry_id": "716d45dd-517c-3f65-8542-03ac86050eba",
                        "glosses": [
                            "Donner à un homme une apparence féminine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28300a01-f5b0-4b91-9e70-b3e3e5814d1b",
                                "sense_id": "970088b0-4a1a-3ae9-8dec-86efc2b86dd7",
                                "text": "T’es juste en train de te faire sissifier et tout se déroule comme prévu."
                            },
                            {
                                "example_id": "058638de-1fa0-421d-9bbe-d9f161cf66c5",
                                "sense_id": "970088b0-4a1a-3ae9-8dec-86efc2b86dd7",
                                "text": "Les sissys sont sur le principe des garçons qui ont été \"sissifiés\", c’est à dire transformés en filles en apparence, soit."
                            },
                            {
                                "example_id": "cc036d5d-3eb4-41af-9a99-3c66b949629a",
                                "sense_id": "970088b0-4a1a-3ae9-8dec-86efc2b86dd7",
                                "text": "Lorsque les hommes soumis deviennent des femmes de chambre, on dit qu’ils sont «sissifiés»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50f3901-16e2-4487-9d99-625d6c96a3c3",
                        "source_entry_id": "716d45dd-517c-3f65-8542-03ac86050eba",
                        "source_sense_id": "970088b0-4a1a-3ae9-8dec-86efc2b86dd7",
                        "target_lang_word": "sissify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sissify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba7973e-e833-3076-b2de-374d37faf547",
                                        "entry_id": "f2553e7b-74ba-3006-8da6-005aeae1ea30",
                                        "glosses": [
                                            "To make sissy; to emasculate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c98b72-7455-43c2-88e0-69d6698d7e8a",
                                                "sense_id": "8ba7973e-e833-3076-b2de-374d37faf547",
                                                "text": "...there does seem, from this study, basis for a not uncommon charge that American schools tend to baby and sissify the boys."
                                            },
                                            {
                                                "example_id": "ef67e2c9-dc74-4c39-b2b3-c5fcf6060834",
                                                "sense_id": "8ba7973e-e833-3076-b2de-374d37faf547",
                                                "text": "The trick was to find means of positioning a male consumer which did not feminize, emasculate or sissify him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
