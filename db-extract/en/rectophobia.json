                    {
                        "sense_id": "32b55b82-16f4-3df2-bb71-69ac17cea9b6",
                        "entry_id": "7c118aec-d778-3cc4-873d-2644f30d615d",
                        "glosses": [
                            "The fear of rectal disease."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c445bac3-bed5-4e7b-9b00-015914a379b8",
                                "sense_id": "32b55b82-16f4-3df2-bb71-69ac17cea9b6",
                                "text": "Careful investigation will, I am sure, account for the nervous rectum of Goodell, the rectophobia of Kelsey, and the irritable rectum of Matthews."
                            },
                            {
                                "example_id": "62a54dcf-d6f3-4bab-bb7d-bcb49bfefaa7",
                                "sense_id": "32b55b82-16f4-3df2-bb71-69ac17cea9b6",
                                "text": "Some writers have used the term rectophobia to describe a condition of morbid foreboding, claimed to be peculiar to patients afflicted with rectal disease."
                            },
                            {
                                "example_id": "ab2ce75b-19bf-4afe-a453-1efa260fe771",
                                "sense_id": "32b55b82-16f4-3df2-bb71-69ac17cea9b6",
                                "text": "Cryptitis is the daddy of rectal neurasthenia, producing what we might term rectophobia, with the mental exhaustion, foreboding, fear and introspection which disturbed reflexes give to the victims of anal diseases."
                            }
                        ]
                    }
