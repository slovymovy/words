                        "cross_references": []
                    },
                    {
                        "translation_id": "8950925d-da36-4599-b2f6-c2ce977d3a5d",
                        "source_entry_id": "81804e50-acdd-31e8-87d1-7b595b0ae0f0",
                        "source_sense_id": "19c6719f-e428-356d-90cb-0a4a2a8b96c4",
                        "source_sense_description": "Chemie: molekularer Sauerstoff, Sauerstoff, Dioxygen",
                        "target_lang_word": "Sauerstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauerstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23f873c4-d374-3fa7-8d38-608471dfab07",
                                        "entry_id": "f5526ca2-a14e-34b1-aacf-fb097cd37efd",
                                        "glosses": [
                                            "Chalkogen mit stark oxidierender Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083d4faa-3ec2-4d5a-8ce0-dea1e2ffe88f",
                                                "sense_id": "23f873c4-d374-3fa7-8d38-608471dfab07",
                                                "text": "„Die meisten Weißen Zwerge, die nach Stand der Theorie den Endzustand von 97 % aller Sterne darstellen, bestehen neben Helium und Kohlenstoff zu einem großen Teil aus Sauerstoff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44f89403-8c74-3df5-8b23-8ca9dee4e4b0",
                                        "entry_id": "f5526ca2-a14e-34b1-aacf-fb097cd37efd",
                                        "glosses": [
                                            "farbloses, geruchloses, brandförderndes Gas; wichtiger Stoff im Stoffwechsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab694f70-892f-4c08-8a04-60ad5e985ba8",
                                                "sense_id": "44f89403-8c74-3df5-8b23-8ca9dee4e4b0",
                                                "text": "Der Mensch braucht Sauerstoff zum Atmen."
                                            },
                                            {
                                                "example_id": "dda57d0e-07d4-4cfd-8c58-e6a009e47388",
                                                "sense_id": "44f89403-8c74-3df5-8b23-8ca9dee4e4b0",
                                                "text": "„Ich atme, ohne über den Sauerstoff zu grübeln.“"
                                            },
                                            {
                                                "example_id": "0b4de814-a5e5-4753-8724-8353eade641a",
                                                "sense_id": "44f89403-8c74-3df5-8b23-8ca9dee4e4b0",
                                                "text": "„Der Sauerstoff wurde bereits knapp, der Kommandant ließ Atemgeräte mit Kalipatronen an die Besatzungsmitglieder verteilen, die nicht an den Reparaturen beteiligt waren.“"
                                            },
                                            {
                                                "example_id": "caaa4b19-d24b-4c9f-9aa3-4d37abfc9d31",
                                                "sense_id": "44f89403-8c74-3df5-8b23-8ca9dee4e4b0",
                                                "text": "„Im Krankenhaus wurde Roth mithilfe von Sauerstoff und einer Infusion stabilisiert.“"
                                            },
                                            {
                                                "example_id": "5b1fda80-8aed-4546-bb23-53228ccbaf21",
                                                "sense_id": "44f89403-8c74-3df5-8b23-8ca9dee4e4b0",
                                                "text": "„117 Kilogramm Sauerstoff kann ein großer Baum im Jahr produzieren. Im Gegenzug nimmt er in dieser Zeit 22 Kilogramm Kohlendioxyd auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
