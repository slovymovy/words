{
    "word_family": [
        "warm",
        "warmth",
        "warming"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "30c5b1e8-c480-3dc9-967a-8def5137afcb",
                    "sense_definition": "In a manner that maintains a high body temperature, typically by wearing sufficient clothing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be sure to dress <w>warmly</w> today because it is snowing outside.",
                            "target_lang_translations": {
                                "ru": "Обязательно оденьтесь <w>тепло</w> сегодня, потому что на улице идет снег."
                            }
                        },
                        {
                            "text": "The children were <w>warmly</w> dressed in their thick winter coats.",
                            "target_lang_translations": {
                                "ru": "Дети были <w>тепло</w> одеты в свои толстые зимние пальто."
                            }
                        }
                    ],
                    "antonyms": [
                        "coldly"
                    ],
                    "common_phrases": [
                        "dress warmly",
                        "warmly dressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, при котором сохраняется высокая температура тела, обычно за счет ношения достаточного количества одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тепло",
                                "target_lang_sense_clarification": "наречие, описывающее состояние сохранения тепла при одевании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881e9280-5863-357a-9776-8c68f943fd68",
                    "sense_definition": "In a friendly, affectionate, or enthusiastic manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests were <w>warmly</w> welcomed by the host at the door.",
                            "target_lang_translations": {
                                "ru": "Гостей <w>тепло</w> встретил хозяин у дверей."
                            }
                        },
                        {
                            "text": "She spoke <w>warmly</w> about her childhood memories during the interview.",
                            "target_lang_translations": {
                                "ru": "Во время интервью она <w>тепло</w> отзывалась о своих детских воспоминаниях."
                            }
                        }
                    ],
                    "synonyms": [
                        "affectionately",
                        "kindly",
                        "cordially"
                    ],
                    "antonyms": [
                        "coldly",
                        "unfriendly"
                    ],
                    "common_phrases": [
                        "warmly welcomed",
                        "greeted warmly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В дружелюбной, ласковой или восторженной манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тепло",
                                "target_lang_sense_clarification": "наречие, описывающее душевную доброту и приветливость"
                            },
                            {
                                "target_lang_word": "сердечно",
                                "target_lang_sense_clarification": "выражение искреннего дружелюбия и расположения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fd42796-4c66-3429-82a1-2c0d168d729e",
                    "sense_definition": "With strong emotion, intensity, or vehemence, often indicating disagreement or passion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>warmly</w> defended his position during the heated debate.",
                            "target_lang_translations": {
                                "ru": "Он <w>горячо</w> защищал свою позицию во время жарких дебатов."
                            }
                        },
                        {
                            "text": "She <w>warmly</w> opposed the new rules proposed by the committee.",
                            "target_lang_translations": {
                                "ru": "Она <w>горячо</w> выступила против новых правил, предложенных комитетом."
                            }
                        }
                    ],
                    "synonyms": [
                        "vehemently",
                        "passionately",
                        "intensely"
                    ],
                    "common_phrases": [
                        "warmly opposed",
                        "warmly defended"
                    ],
                    "target_lang_definitions": {
                        "ru": "С сильной эмоцией, интенсивностью или страстью, часто указывая на несогласие или пылкость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горячо",
                                "target_lang_sense_clarification": "наречие, подчеркивающее страстность, пылкость или интенсивность в споре"
                            },
                            {
                                "target_lang_word": "страстно",
                                "target_lang_sense_clarification": "выражение сильного эмоционального вовлечения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}