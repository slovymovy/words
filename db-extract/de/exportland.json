                    {
                        "sense_id": "2e4e548a-45a2-3dea-8c40-c3319a076e78",
                        "entry_id": "1fd79336-91f1-3599-9c27-2122c6570a00",
                        "glosses": [
                            "Staat, dessen Wirtschaft hauptsächlich auf Export ausgelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e259e1-b243-44be-ace3-4bf028f55d0d",
                                "sense_id": "2e4e548a-45a2-3dea-8c40-c3319a076e78",
                                "text": "Schweden ist ein Exportland mit Hauptziel Deutschland."
                            },
                            {
                                "example_id": "48b9a8a5-fd9b-4e40-a183-ca89989d9940",
                                "sense_id": "2e4e548a-45a2-3dea-8c40-c3319a076e78",
                                "text": "„Angola wurde im 17. Jahrhundert zum größten Exportland für Sklaven.“"
                            },
                            {
                                "example_id": "a383843d-f664-4ba2-bd69-56445eef2fac",
                                "sense_id": "2e4e548a-45a2-3dea-8c40-c3319a076e78",
                                "text": "„Einerseits profitiert Deutschland als Exportland am meisten von der wirtschaftlichen Vereinigung, denn die anderen EU-Mitgliedstaaten sind seine Kunden und der Zugang zu ihnen ist nicht mehr durch Zölle und nationale Währungen erschwert.“"
                            }
                        ],
