                    "frequency": "Low",
                    "semantic_group_id": "vague",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les surfeurs attendaient que la vague commence à <w>dérouler</w> parfaitement vers la droite."
                        },
                        {
                            "text": "Une houle puissante faisait <w>dérouler</w> les rouleaux écumeux sur toute la plage."
