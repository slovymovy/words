                                    {
                                        "sense_id": "455f3e39-5fd7-3445-954f-41b0382f12e2",
                                        "entry_id": "f7d478c1-5e6e-3a8f-853d-74a1dd017093",
                                        "glosses": [
                                            "Femme qui a peu de jugement."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8ca81b-1347-46db-8f7e-5bbf4c3abbbb",
                                                "sense_id": "455f3e39-5fd7-3445-954f-41b0382f12e2",
                                                "text": "En Vendée, ses parents la considéraient comme une brebis galeuse, une écervelée qui s’était sottement jetée dans les bras de la canaille jacobine."
                                            }
                                        ]
                                    }
                                ]
                            },
