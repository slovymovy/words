                "senses": [
                    {
                        "sense_id": "3dd94c1d-d537-36cb-9bc2-accc93c8c7f1",
                        "entry_id": "830f802b-52d4-316b-a629-9a3b7b1c566f",
                        "glosses": [
                            "Une des espèces de champignons de la famille des hygrophoracées, champignons à lames souvent espacées, au chapeau lubrifié ou visqueux, à spores blanches et au pied sans anneau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6975a9-8555-4d69-8d54-92c54f7412f9",
                                "sense_id": "3dd94c1d-d537-36cb-9bc2-accc93c8c7f1",
                                "text": "Les Hygrophores regroupent des champignons de taille, de forme et de coloration très variées, mais qui possèdent un caractère en commun : leurs lames sont cireuses au toucher."
                            },
                            {
                                "example_id": "8a34c269-779e-4082-84d5-fd4dc65ea02e",
                                "sense_id": "3dd94c1d-d537-36cb-9bc2-accc93c8c7f1",
                                "text": "Il apparaît assez tardivement , comme la plupart des hygrophores, préférant la fraîcheur des pluies automnales aux chaleurs de la fin de l'été."
                            }
                        ]
                    }
                ],
