                                        "sense_id": "5d50f094-f1f9-3ed0-8c93-1049b9036a9b",
                                        "entry_id": "760e054b-8517-3094-95f8-2700ca7929c2",
                                        "glosses": [
                                            "Qui reste en place à la saison de repos végétatif, à propos d'une feuille ou d'une pièce florale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7375bdde-d3c4-36da-870d-f279cfe7f1a7",
                                        "entry_id": "760e054b-8517-3094-95f8-2700ca7929c2",
                                        "glosses": [
                                            "Qualifie un organe (feuille, calice, corolle) qui à la saison de repos végétatif, se fane, se dessèche mais ne tombe pas."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bdb82a0-5a27-4bad-a25b-a70a0b9a750e",
                                                "sense_id": "7375bdde-d3c4-36da-870d-f279cfe7f1a7",
                                                "text": "Calice marcescent de Solanacée."
                                            },
                                            {
                                                "example_id": "b0fe0e9a-f95a-4bbc-99aa-64e58da7bea1",
                                                "sense_id": "7375bdde-d3c4-36da-870d-f279cfe7f1a7",
                                                "text": "Désir de vivre et d’être heureux, leurre et fallace,\net monstre indéfectible aux têtes renaissantes,\nmalgré l’automne et les couronnes marcescentes,\nde courir tes hasards mon âme n’est pas lasse.\nCar nous n’espérons point d’être jamais, hélas !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2525400-b931-3700-aad5-a80cb47e759e",
                                        "entry_id": "760e054b-8517-3094-95f8-2700ca7929c2",
                                        "glosses": [
                                            "Qualifie aussi la plante entière dont les feuilles mortes persistent tout l'hiver sous forme desséchée sur leur support. Seule la pousse des feuilles de l'année suivante détache les anciennes feuilles mortes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f09295c8-dab2-4877-8b82-039e5ad1a910",
                                                "sense_id": "c2525400-b931-3700-aad5-a80cb47e759e",
                                                "text": "Les chênes, les charmes et les hêtres… sont des arbres à feuillage marcescent, car ils conservent leurs feuilles sèches une bonne partie de l’hiver."
                                            }
                                        ]
                                    }
