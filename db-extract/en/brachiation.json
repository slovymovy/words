                                            {
                                                "example_id": "3457f6b9-f9ce-4f73-806d-92d8cd1a8b2c",
                                                "sense_id": "968388af-db73-3bf7-a388-e8a3ec2a87f1",
                                                "text": "Nos gibbons actuels se déplacent ainsi, par brachiation ; s’ils descendent au sol, leur corps est vertical et ils pratiquent la marche sur leurs membres postérieurs, comme vous et moi."
                                            },
                                            {
                                                "example_id": "6419af56-92c3-475d-a14d-86b7f1407b52",
                                                "sense_id": "968388af-db73-3bf7-a388-e8a3ec2a87f1",
                                                "text": "Mais les ossements dévoilent aussi une capacité à la flexion importante de la main, ce qui est cohérent avec la brachiation (déplacement en s’accrochant aux branches), un caractère archaïque."
                                            }
                                        ]
                                    }
                                ]
