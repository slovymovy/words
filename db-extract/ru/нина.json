                ],
                "senses": [
                    {
                        "sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                        "entry_id": "e097bc49-05ba-33bb-9642-06cbdf4d9c94",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb284903-7318-4ac1-83fd-1ed96b43c844",
                                "sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                                "text": "Меня зовут Нина."
                            },
                            {
                                "example_id": "c5a4e5a1-85c9-470c-a0af-6f8d23f1f645",
                                "sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                                "text": "И точно хороша // Была не в шутку маленькая Нина."
                            },
                            {
                                "example_id": "1bf153d7-fc4f-4567-9a59-f8442e9f3cb4",
                                "sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                                "text": "Нина поступила в политехнический институт, получает стипендию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38a61a97-8469-4a34-ba6c-4cf895591123",
                        "source_entry_id": "e097bc49-05ba-33bb-9642-06cbdf4d9c94",
                        "source_sense_id": "bf2bd40c-e7fb-375d-be0c-f51eceb3cb9d",
                        "target_lang_word": "Nina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ecefed2-aa1b-3e91-b75a-e4a7fe342565",
                                        "entry_id": "ae8ed9a9-13dd-35be-8e72-1f087fa49199",
                                        "glosses": [
                                            "A female given name in continuous use since the 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b50f5e-2b91-473a-ad97-02c2f260a4e4",
                                                "sense_id": "6ecefed2-aa1b-3e91-b75a-e4a7fe342565",
                                                "text": "The first three, Macklin, Lydia, and Randall, were the special ones. Even those names, we thought, showed greater imagination, greater involvement on our parents' part, than ours did: Nina, Mary, Sarah. Clearly by that time they had run out of gas.\n\"Nina. Such a pretty, old-fashioned name. I hope you don't mind my saying that.\" \"No; I'm glad you think so.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c2dc1f5-ad31-3c48-b4cb-b4de652ebeba",
                                        "entry_id": "ae8ed9a9-13dd-35be-8e72-1f087fa49199",
                                        "glosses": [
                                            "The Babylonian goddess of the watery deep, daughter of Ea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04b78a46-082a-3a00-8aa2-a05f4450167a",
                                        "entry_id": "ae8ed9a9-13dd-35be-8e72-1f087fa49199",
                                        "glosses": [
                                            "Ellipsis of Nina from Pasadena."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Nina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cbd0993-b326-321f-83b0-14833c005690",
                                        "entry_id": "b6560657-dcee-36a3-b950-f56c7849b360",
                                        "glosses": [
                                            "Alternative letter-case form of nina (“a hidden message revealed in the completed grid of a crossword”)."
