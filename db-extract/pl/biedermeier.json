                        "translation_id": "bde48efb-824c-47db-9a69-d57102acfebe",
                        "source_entry_id": "30a85610-f0a3-3413-8804-221537f2df0f",
                        "source_sense_id": "20055936-f0ab-3ff1-b6a4-4d173053447c",
