                ],
                "senses": [
                    {
                        "sense_id": "0dbf3e28-c27e-3bef-939b-7ce7baa3242b",
                        "entry_id": "f3b3c980-d8ec-3fa9-8b60-5e78b664e899",
                        "glosses": [
                            "samenlevend, samenwerkend waarbij zeker een van de partijen voordeel heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59636efc-09f8-4011-8998-53b9a7cec345",
                                "sense_id": "0dbf3e28-c27e-3bef-939b-7ce7baa3242b",
                                "text": "Een interessant voorbeeld van symbiotische kunst, waarbij door de mens gebruik wordt gemaakt van de eigenschappen van dieren, is het werk van Hubert Duprat. Hij gebruikte de larven van de kokerjuffer om stukjes goud en ander materiaal tot een cocon te laten rijgen. Het resultaat is verbluffend. Normaal gesproken gebruiken de vliegen kiezels in de rivierbedding om deze beschermende kokertjes te maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d5f534-f9cd-3f0d-892b-2a9a757fdb47",
                        "entry_id": "f3b3c980-d8ec-3fa9-8b60-5e78b664e899",
                        "glosses": [
                            "van twee of meer mensen dat ze een te grote onderlinge afhankelijkheid hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90761da-04ad-4945-8019-fcfb1a1aa989",
                                "sense_id": "f1d5f534-f9cd-3f0d-892b-2a9a757fdb47",
                                "text": "Hij praat ook na de scheiding van mijn ouders nog vaak over de allesverzengende verliefdheid die hij voor mijn moeder gevoeld heeft, meet zijn nieuwe liefdes daaraan af en draagt zo nog heel lang de verwondingen van het mislopen van hun huwelijk met zich mee. Destructieve passie, noemt hij het, een symbiotische relatie."
                            },
                            {
                                "example_id": "43f0860e-b4f8-46bc-afa1-7b0d48ff759e",
                                "sense_id": "f1d5f534-f9cd-3f0d-892b-2a9a757fdb47",
                                "text": "Justitie beschreef overvallers op een tankstation en een supermarkt in Enschede als tweelingen die 'symbiotisch'samen leven. De rechtbank heeft ze overeenkomstig precies gelijk gestraft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a4c1852-ab9b-489c-ae3c-1f7ce1518622",
                        "source_entry_id": "f3b3c980-d8ec-3fa9-8b60-5e78b664e899",
                        "source_sense_id": "0dbf3e28-c27e-3bef-939b-7ce7baa3242b",
                        "source_sense_description": "samenlevend en samenwerkend",
                        "target_lang_word": "symbiotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbiotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acef5d53-4e59-3f70-b44c-af48feed5c67",
                                        "entry_id": "6b608560-aedc-35a7-87fa-a21c25e41ba2",
                                        "glosses": [
                                            "Of, or relating to symbiosis; living together."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6905d59f-72cf-4071-a7ae-23182c0f811e",
                                                "sense_id": "acef5d53-4e59-3f70-b44c-af48feed5c67",
                                                "text": "A lichen is a fungus with symbiotic algae among its cells."
                                            },
                                            {
                                                "example_id": "5e86504d-9f7f-4af1-8cb4-80a22e60f23f",
                                                "sense_id": "acef5d53-4e59-3f70-b44c-af48feed5c67",
                                                "text": "Orchids rely on fungi to reproduce. Their tiny seeds don't have any on-board nutrients (like beans and apples) and will not germinate until they are infected by a symbiotic fungus which supplies them with food. Known as a protocorm, this tiny orchid-fungus ball grows, turns green and eventually starts to photosynthesise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "089a31c6-b6fe-3e2b-9afd-3c126249ef33",
                                        "entry_id": "6b608560-aedc-35a7-87fa-a21c25e41ba2",
                                        "glosses": [
                                            "Of a relationship with mutual benefit between two individuals, organisms, or groups."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73bebd6f-ddd6-41c2-b067-16cbe5d8c38b",
                                                "sense_id": "089a31c6-b6fe-3e2b-9afd-3c126249ef33",
                                                "text": "[Israeli Prime Minister Benjamin Netanyahu's] arguably symbiotic relationship with Hamas goes back to his election in 1996, when he upset left-wing incumbent Shimon Peres following a spate of Hamas bombings, which Mr. Netanyahu said proved the peace process could not be trusted."
                                            }
                                        ]
                                    }
                                ]
                            },
