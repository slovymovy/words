                                            {
                                                "example_id": "9a89c37d-6c3c-4a25-a63a-963ad8fa0cd2",
                                                "sense_id": "4df843ad-af60-3cbb-91a2-d9a47ec09d56",
                                                "text": "It was a randy aggressiveness he had enjoyed because he had not used or needed it before."
                                            }
