                        "examples": [
                            {
                                "example_id": "1ade8e92-0711-42b0-a969-988ee5119d1b",
                                "sense_id": "d81251b7-d967-34f6-a116-fb54acde50f4",
                                "text": "La crudité des fruits."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cbe57f5-deb9-3b1b-a340-9c5c3fe1b83b",
                        "entry_id": "68bfca8c-a603-39a1-ade4-ee91589164df",
                        "glosses": [
                            "Aliments crus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da45bd1-be3d-4138-aa22-061a4eee71a7",
                                "sense_id": "1cbe57f5-deb9-3b1b-a340-9c5c3fe1b83b",
                                "text": "Manger des crudités."
                            },
                            {
                                "example_id": "ee0150a5-5228-4e93-b47d-6bef0778e64a",
                                "sense_id": "1cbe57f5-deb9-3b1b-a340-9c5c3fe1b83b",
                                "text": "Les estomacs faibles ne peuvent pas supporter les crudités."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c562030-f4c5-374d-a9c9-ba05bf9856aa",
                        "entry_id": "68bfca8c-a603-39a1-ade4-ee91589164df",
                        "glosses": [
                            "Aigreurs qui proviennent d’aliments mal digérés."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f75a5af6-7714-4d70-8a24-3d6d83791490",
                                "sense_id": "7c562030-f4c5-374d-a9c9-ba05bf9856aa",
                                "text": "Ces viandes engendrent des crudités, causent des crudités."
                            },
                            {
                                "example_id": "db877a93-f965-45e0-85bc-36e0c67516d6",
                                "sense_id": "7c562030-f4c5-374d-a9c9-ba05bf9856aa",
                                "text": "Il a des crudités d’estomac."
                            }
                        ]
                    },
                    {
                        "sense_id": "d539d54f-31e8-3aff-b681-79ef65b1bbb1",
                        "entry_id": "68bfca8c-a603-39a1-ade4-ee91589164df",
                        "glosses": [
                            "Effet des tons crus, des couleurs crues."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "20728982-d9c9-3d33-aa43-31c314a45356",
                        "entry_id": "68bfca8c-a603-39a1-ade4-ee91589164df",
                        "glosses": [
                            "Mot déplacé, trait inconvenant dans un ouvrage d’esprit ou dans la conversation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8ab43640-2698-444c-8b5d-ca6d60cee984",
                                "sense_id": "20728982-d9c9-3d33-aa43-31c314a45356",
                                "text": "Dès sa première année de Conservatoire, la fille de théâtre se hausse à connaître par cœur toutes les crudités du langage français."
                            },
                            {
                                "example_id": "d8e711ee-cd6f-43a2-817c-2147dd3b9d30",
                                "sense_id": "20728982-d9c9-3d33-aa43-31c314a45356",
                                "text": "Parmi nos créateurs de fabliaux, si Jean Bodel donne volontiers dans la crudité licencieuse et scatologique, il le fait avec amabilité de bonne compagnie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f2bcae2-a835-4a1e-8748-22daee6cfdcd",
                        "source_entry_id": "68bfca8c-a603-39a1-ade4-ee91589164df",
