                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trachyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c66cd256-ad58-3bb3-a70b-34ec10909ec4",
                                        "entry_id": "9b3d0303-b086-3e64-a5dd-64993d1c9e28",
                                        "glosses": [
                                            "Roche éruptive, à structure microlithique se présentant en gros cristaux, dans une pâte grise et rugueuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e374b485-363b-44d0-8382-453ba604f02c",
                                                "sense_id": "c66cd256-ad58-3bb3-a70b-34ec10909ec4",
                                                "text": "[…], et les sources étaient de plus en plus rares dans ces terrains composés en grande partie de trachytes fendillés et d’amygdaloïdes poreuses."
                                            },
                                            {
                                                "example_id": "5c578496-5ded-4606-a570-5fb5fb27a186",
                                                "sense_id": "c66cd256-ad58-3bb3-a70b-34ec10909ec4",
                                                "text": "[…], c'est ainsi qu'il n'y a qu'une différence de 50 m entre le basalte de Reilhaguet, d’Onsac et le basalte du pliocène moyen entre la Vaissière et Jussac, qu'il n'y a qu'une petite masse de projections entre le trachyte de Giou-de-Mamou et le basalte du Coyan (Plioc. sup.), que le basalte porphyrique de Sézergues est à peine en contrebas du basalte des plateaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
