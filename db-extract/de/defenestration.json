                "senses": [
                    {
                        "sense_id": "32c58877-ed29-358d-8c33-dade498668b0",
                        "entry_id": "ca968cfa-dc5f-3b41-846c-ffe088851804",
                        "glosses": [
                            "das Hinauswerfen einer Person durch ein Fenster, meist als Hinrichtungsmethode"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f319c414-febd-4c1b-96ef-d58ad7e0c116",
                                "sense_id": "32c58877-ed29-358d-8c33-dade498668b0",
                                "text": "Mittelalterliche Defenestration wird häufig als Lynchjustiz betrachtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5cc918c-90b8-4e4f-baba-d20ad44b9bbc",
                        "source_entry_id": "ca968cfa-dc5f-3b41-846c-ffe088851804",
                        "source_sense_id": "32c58877-ed29-358d-8c33-dade498668b0",
                        "source_sense_description": "gehoben: das Hinauswerfen einer Person durch ein Fenster, meist als Hinrichtungsmethode",
                        "target_lang_word": "defenestration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defenestration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a15a5a4-3dd1-3736-83f1-909773aa62a4",
                                        "entry_id": "c2747567-8f28-3517-af26-e6cfd4c8888d",
                                        "glosses": [
                                            "The act of throwing something or especially someone out of a window, especially lethally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c4f729-4aca-4456-8f9b-de60f43c5f1e",
                                                "sense_id": "7a15a5a4-3dd1-3736-83f1-909773aa62a4",
                                                "text": "The \"Defenestration\" at Prague (A.D. 1618). [...] The imperial Austrian Councillors are thrown out of the window of the castle of Hradschin by the enraged Bohemian Deputies [...]"
                                            },
                                            {
                                                "example_id": "79d78e52-d9b3-4ca8-a9e5-9f3a391eb123",
                                                "sense_id": "7a15a5a4-3dd1-3736-83f1-909773aa62a4",
                                                "text": "The Third Defenestration of Prague occurred on 10 March 1948. During the closing stages of the communist takeover in Czechoslovakia, Jan Masaryk, the popular foreign minister and son of Tomáš Masaryk, fell – or more likely was pushed – out of a window."
                                            },
                                            {
                                                "example_id": "4fd1fcfa-86f2-413c-83f2-2b8b8374858b",
                                                "sense_id": "7a15a5a4-3dd1-3736-83f1-909773aa62a4",
                                                "text": "On September 11, 2001 when NYC's Twin Towers were impacted [...] some occupants trapped above the inferno facing certain death instead jumped from windows to their certain death (self defenestration)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae3d5ee-aa73-314b-818c-d42b0f399960",
                                        "entry_id": "c2747567-8f28-3517-af26-e6cfd4c8888d",
                                        "glosses": [
                                            "The high-profile removal of a person from an organization."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb81d30d-5d19-4e73-9fcf-2d7031650920",
                                                "sense_id": "2ae3d5ee-aa73-314b-818c-d42b0f399960",
                                                "text": "Be that as it may, his defenestration was coldly abrupt, and in his place, the Football Association resurrected a veteran manager and former England star in Joe Mercer for seven games."
                                            },
                                            {
                                                "example_id": "92064ac7-ee4d-4506-a95b-a5f6ddee71de",
                                                "sense_id": "2ae3d5ee-aa73-314b-818c-d42b0f399960",
                                                "text": "With Rishi Sunak and Sajid Javid gone from the cabinet, it could all be over for Boris Johnson – although quite how long it will take his enemies to finish him off is not at all clear and his defenestration does not look immediate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98692139-63cf-304e-9376-5a966b8bb903",
                                        "entry_id": "c2747567-8f28-3517-af26-e6cfd4c8888d",
                                        "glosses": [
                                            "The act of removing the Microsoft Windows operating system from a computer in order to install an alternative one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f06327-255e-480c-8c45-ea11832a433e",
                                                "sense_id": "98692139-63cf-304e-9376-5a966b8bb903",
                                                "text": "Defenestration might be an option too. May I recommend Linux?"
                                            },
                                            {
                                                "example_id": "7845e137-9a89-4cd0-b4de-c08db9a7fbe8",
                                                "sense_id": "98692139-63cf-304e-9376-5a966b8bb903",
                                                "text": "It's defenestration day in Redmond today. A clearly stunned Microsoft did what it could to pretend that Judge Jackson's findings of fact were \"just one step\", as [Bill] Gates put said in the prepared statement that he read at a press conference last night, but it was hopeless."
                                            },
                                            {
                                                "example_id": "df0f1af7-3aef-48bc-9b27-e972a6099428",
                                                "sense_id": "98692139-63cf-304e-9376-5a966b8bb903",
                                                "text": "No defenestration here. Ask questions about all aspects of Windows programming, get help on Microsoft technologies covered in Apress books, or provide feedback on any Apress Windows book."
                                            },
                                            {
                                                "example_id": "61195d44-3edc-459f-8b60-94e33d2e3d94",
                                                "sense_id": "98692139-63cf-304e-9376-5a966b8bb903",
                                                "text": "What's needed is defenestration – throwing out the Windows mindset along with Microsoft's licenses and software – but that's not as simple as changing a boot CD or even migrating a whole raft of servers. What's involved is fundamental change both in how IT operates and in what it does."
                                            },
                                            {
                                                "example_id": "5ecccfb1-5d3b-4295-90d9-6c26699881a7",
                                                "sense_id": "98692139-63cf-304e-9376-5a966b8bb903",
                                                "text": "Traditionally, the verb defenestrate means to throw out of a window. But as Australian companies take their first timid steps towards installing non-proprietary software on corporate desktops, defenestration is starting to be linked to the throwing out of Windows software."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65a04bc4-c5a6-4c17-9cc3-c646b8d6dd80",
                        "source_entry_id": "ca968cfa-dc5f-3b41-846c-ffe088851804",
                        "source_sense_id": "32c58877-ed29-358d-8c33-dade498668b0",
                        "source_sense_description": "gehoben: das Hinauswerfen einer Person durch ein Fenster, meist als Hinrichtungsmethode",
                        "target_lang_word": "défenestration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défenestration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8006af2-3ba3-333e-9ef9-272fa30f9f84",
                                        "entry_id": "8dd21eaf-e46f-3c75-bccb-bb04a1b227fa",
                                        "glosses": [
                                            "Action de jeter quelqu’un ou quelque chose par une fenêtre, de défenestrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579abde5-9aa6-4cb5-86b7-4d99adf3d63a",
                                                "sense_id": "d8006af2-3ba3-333e-9ef9-272fa30f9f84",
                                                "text": "La défenestration des trois soldats a attisé les haines du camp adverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cdab30-4414-3300-9ec4-7b66869a2f3d",
                                        "entry_id": "8dd21eaf-e46f-3c75-bccb-bb04a1b227fa",
                                        "glosses": [
                                            "Action pour une personne de se jeter par une fenêtre, de se défenestrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8490920a-c5f1-4185-aa2e-7e5124e3935e",
                                                "sense_id": "f5cdab30-4414-3300-9ec4-7b66869a2f3d",
                                                "text": "Il a tenté de se suicider par défenestration."
                                            },
                                            {
                                                "example_id": "a2ead296-de25-46df-9133-e4ac17505bef",
                                                "sense_id": "f5cdab30-4414-3300-9ec4-7b66869a2f3d",
                                                "text": "L’attirance du vide, bien connue chez Edgar Poe mais ignorée aux Érables où, de mémoire d’habitant, nul suicide par défenestration n’était venu précipiter la tour au rayon des faits divers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
