                "senses": [
                    {
                        "sense_id": "8547ceb3-97c5-3970-8db0-f4eb1e669e81",
                        "entry_id": "32f6941d-c73a-3b09-a732-a8119989333a",
                        "glosses": [
                            "Revêtir (le sol) de malons."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "d9108bcc-b2ba-4f83-b670-f7d8a493b3d7",
                                "sense_id": "8547ceb3-97c5-3970-8db0-f4eb1e669e81",
                                "text": "Un jour, c'est lui qui te filait un coup de main pour malonner la terrasse."
                            },
                            {
                                "example_id": "bf8ed474-a82a-408d-b0a8-577b34fbc6d5",
                                "sense_id": "8547ceb3-97c5-3970-8db0-f4eb1e669e81",
                                "text": "C’est en tout cas ce qui ressort de la promesse qu’il fait, en 1464, au juif Astruc Beniamini de Manosque de malonner l’espace qui sépare sa maison et celle d’un autre juif et de lui construire un conduit d’évacuation d’eau."
                            }
                        ]
                    }
