                    "sense_definition": "present participle and gerund of <w>vomit</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient has been <w>vomiting</w> continuously since eating the undercooked seafood.",
                            "target_lang_translations": {
                                "de": "Der Patient <w>übergibt sich</w> ununterbrochen, seit er die unzureichend gekochten Meeresfrüchte gegessen hat."
                            }
                        },
                        {
                            "text": "She had to pull the car over because she started <w>vomiting</w> uncontrollably.",
                            "target_lang_translations": {
                                "de": "Sie musste das Auto anhalten, weil sie anfing, sich unkontrolliert zu <w>übergeben</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop vomiting",
                        "vomiting blood"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von 'vomit'; sich übergeben, erbrechen."
                    },
                    "translations": {
