                "senses": [
                    {
                        "sense_id": "b1b02afe-9fb3-3543-b58a-0bd4795f98fd",
                        "entry_id": "215fb594-9107-33ad-b7e1-0e1745314e24",
                        "glosses": [
                            "Blut, das von einem Schwein stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de1d410-4b91-4c2a-9c57-440fe6be3330",
                                "sense_id": "b1b02afe-9fb3-3543-b58a-0bd4795f98fd",
                                "text": "„Die Analyse von Blutflecken spielt in der Forensik eine entscheidende Rolle. Für die Forschung dazu wird meist Schweineblut verwendet.“"
                            },
                            {
                                "example_id": "681b1fdb-9bcb-4890-bdf7-9a7ce153ab1b",
                                "sense_id": "b1b02afe-9fb3-3543-b58a-0bd4795f98fd",
                                "text": "„Manchmal geht Silke Brodbeck los und holt einen Eimer Schweineblut vom Schlachter.“"
                            },
                            {
                                "example_id": "efdb66a3-de8d-443c-954c-680afd94913a",
                                "sense_id": "b1b02afe-9fb3-3543-b58a-0bd4795f98fd",
                                "text": "„Blutwurst besteht unter anderem aus Schweineblut, Speck, Schwarte und Schweinefleisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
