                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chimiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72484773-f814-3442-a7b2-6c61d9b70661",
                                        "entry_id": "b3e31470-ecfa-31f4-96bd-d1b340ab8356",
                                        "glosses": [
                                            "Donner un caractère chimique à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "763e8d68-71f5-4c7f-88a6-c85c55ca64e7",
                                                "sense_id": "72484773-f814-3442-a7b2-6c61d9b70661",
                                                "text": "Mais cela n’est pas forcément mauvais signe : Nikita Khrouchtchev, puis Leonid Brejnev, pour répondre à la faible productivité paysanne provoquée par la collectivisation, voulaient « chimiser », industrialiser l’agriculture."
                                            },
                                            {
                                                "example_id": "94cc0854-2b4a-46d3-96fc-d349714055ca",
                                                "sense_id": "72484773-f814-3442-a7b2-6c61d9b70661",
                                                "text": "Les méthodes : presser les producteurs et « chimiser » la production pour répondre à la demande grandissante des consommateurs."
                                            },
                                            {
                                                "example_id": "95fc8507-b323-453f-bf53-044631d9b50a",
                                                "sense_id": "72484773-f814-3442-a7b2-6c61d9b70661",
                                                "text": "La cuisine, certes, c'est de la chimie. Mais chimiser la cuisine, c'est du détournement culinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
