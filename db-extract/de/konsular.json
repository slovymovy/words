                "senses": [
                    {
                        "sense_id": "268a37e7-9fc4-3016-b95f-99438ed78180",
                        "entry_id": "429a7cf8-1c68-3392-b506-2c1807292ceb",
                        "glosses": [
                            "den Konsul oder das Konsulat betreffend, durch das Konsulat, mithilfe des Konsulats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f317dbdc-b4e7-40f9-97ca-295b05b17cfd",
                                "sense_id": "268a37e7-9fc4-3016-b95f-99438ed78180",
                                "text": "„Wenn ein Staat ein neues Territorium erwirbt und zu einer Kolonie ausgestaltet, so fragt es sich, ob damit das gesamte heimische Recht in diesem Territorium Anwendung finden soll, oder ob der Grundsatz der Spezialgesetzgebung Platz greifen soll, d. h. daß eine scharfe Sonderung zwischen heimischem und kolonialem Recht stattfindet und nur die ausdrücklich eingeführten Normen des heimischen Rechts gelten, im übrigen aber ein spezielles koloniales (meist konsulares) Recht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
