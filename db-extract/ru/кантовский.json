                    },
                    {
                        "translation_id": "4bda74b4-1cca-48e6-835e-057b375536be",
                        "source_entry_id": "5921c203-0f15-36d1-8871-4ec8fd073ea5",
                        "source_sense_id": "404815e2-1cbf-359d-921f-6472d1f18f0f",
                        "target_lang_word": "Kantisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7336bc70-882b-4735-b767-0a3e92ba7919",
                        "source_entry_id": "5921c203-0f15-36d1-8871-4ec8fd073ea5",
                        "source_sense_id": "404815e2-1cbf-359d-921f-6472d1f18f0f",
                        "target_lang_word": "kantianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                        "entry_id": "8fb8ed4c-c22a-365a-bfbe-65144f2d2356",
                                        "glosses": [
                                            "die Schüler und Denker im Sinne Kants betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7621450-b1df-4026-bf60-a72b80f3d3bd",
                                                "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                                "text": "„Das politische Engagement von Karl Jaspers und von Werner Mathofer scheint mir kantianisch motiviert gewesen sein.“"
                                            },
                                            {
                                                "example_id": "14457349-1f04-4f77-8a33-05942d2b5050",
                                                "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                                "text": "„Vor diesem Hintergrund hat jüngst Michael Winkler […] nahe gelegt, das Projekt der Kritik in der Sozialen Arbeit als eine […] eher kantianisch angelegte Kritik an der Kritik weiter zu verfolgen […]“"
                                            },
                                            {
                                                "example_id": "5a536d03-9e10-47a1-88fc-f7feaf694418",
                                                "sense_id": "26df4563-40f0-3807-bfb8-9ff965f5098a",
                                                "text": "„Dabei drängt sich die Frage auf, wie es möglich sein kann, zugleich kantianisch zu leben […] und gleichzeitig zu solch schrecklichen Taten fähig zu sein […]?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb94548b-1ef0-40c2-af6f-ad54e4137f54",
                        "source_entry_id": "5921c203-0f15-36d1-8871-4ec8fd073ea5",
                        "source_sense_id": "404815e2-1cbf-359d-921f-6472d1f18f0f",
                        "target_lang_word": "kantowski",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantowski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "72ff415f-1505-30bc-8d2f-cbd4262234f9",
                                        "entry_id": "e5ac6d10-9fd6-3044-bc0d-fe6e9501edad",
                                        "glosses": [
                                            "wywodzący się z założeń, tez utworzonych przez Immanuela Kanta; związany z jego filozofią"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a14e8d0-f229-4f18-93c0-c05cfc8c247e",
                                                "sense_id": "72ff415f-1505-30bc-8d2f-cbd4262234f9",
                                                "text": "Innym przykładem całkowicie nowego sposobu myślenia jest kantowskie przekonanie o niepoznawalności świata rzeczy samych w sobie, z jednoczesnym uznawaniem przez niego poznawalności świata zjawisk"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44b5162d-44fb-48b3-b33b-95033cf5bcff",
                        "source_entry_id": "5921c203-0f15-36d1-8871-4ec8fd073ea5",
                        "source_sense_id": "404815e2-1cbf-359d-921f-6472d1f18f0f",
                        "target_lang_word": "kantien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                        "entry_id": "c243c60b-2595-39da-970b-f141d06ec48d",
                                        "glosses": [
                                            "Qui découle ou s’apparente à la pensée de Kant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6fcbc2-4891-4106-b466-15da842746c6",
                                                "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                                "text": "Hier, en France, il fallait être humanitaire, kantien, philosémite. Actuellement, la mode, chez nous, penche vers un christianisme édulcoré."
                                            },
                                            {
                                                "example_id": "b06fd91f-4c75-4abc-b12d-c6017c6a6918",
                                                "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                                "text": "Guillaume met en garde la fonctionnaire que je suis contre le respect absolu de la légalité et l'exigence kantienne d'universaliser son action quelles qu'en soient les circonstances."
                                            },
                                            {
                                                "example_id": "aa5d8a34-f62d-4fc7-a9a8-3a09c23b66a0",
                                                "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                                "text": "– Faut te faire une raison », dit Gabriel dont les propos se nuançaient parfois d’un thomisme légèrement kantien.\nEt, passant sur le plan de la cosubjectivité, il ajouta :\n « Et puis faut se grouiller : Charles attend. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kantien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e734f64-d1e3-340e-b5e5-9320437b0615",
                                        "entry_id": "7b15552b-b1dc-30f0-ba12-ddfc0119d721",
                                        "glosses": [
                                            "Adepte de la pensée de Kant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0456525b-0c0b-4322-b0cf-68d13da03cf6",
                                                "sense_id": "3e734f64-d1e3-340e-b5e5-9320437b0615",
                                                "text": "[…], le philosophe croise des civils allemands qui regardent les captifs comme “une quasi-humanité, une bande de singes”. Seul un chien aboie gaiement devant le cortège : Bobby. Pour lui, écrit Levinas, “nous fûmes des hommes”, des fins en soi ; c’est pourquoi le canidé lui apparaît comme “le dernier kantien de l’Allemagne nazie”."
                                            }
