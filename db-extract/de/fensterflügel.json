                ],
                "senses": [
                    {
                        "sense_id": "6fe64562-2010-34d2-adbb-721401506221",
                        "entry_id": "28b95c54-8fd3-31d4-82ff-91b432675f65",
                        "glosses": [
                            "Teil eines mindestens zweiteiligen Fensters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79333c92-f7aa-4646-98c3-6ec989f49b89",
                                "sense_id": "6fe64562-2010-34d2-adbb-721401506221",
                                "text": "„Nur in St. Arnauds Zimmer standen die Fensterflügel weit auf, und die Gardinen wehten im Winde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2d6f659-abe6-48a9-9a07-5f74f26d417d",
                        "source_entry_id": "28b95c54-8fd3-31d4-82ff-91b432675f65",
                        "source_sense_id": "6fe64562-2010-34d2-adbb-721401506221",
                        "source_sense_description": "Teil eines mindestens zweiteiligen Fensters",
                        "target_lang_word": "casement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e863773b-9985-3fd7-88ab-b463d0cf5ce7",
                                        "entry_id": "b305bd5e-07c0-383a-b619-b3a1bceeabd3",
                                        "glosses": [
                                            "A window sash that is hinged on the side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47cbad6c-8d60-488e-99ac-0b70eeeedf98",
                                                "sense_id": "e863773b-9985-3fd7-88ab-b463d0cf5ce7",
                                                "text": "For at the window of my house I looked through my casement, and beheld among the simple ones, I discerned among the youths, a young man void of understanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f551071-6980-3989-95ca-5372b6e202a9",
                                        "entry_id": "b305bd5e-07c0-383a-b619-b3a1bceeabd3",
                                        "glosses": [
                                            "A window having such sashes; a casement window.ᵂᵖ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e6fa17-7397-44b3-b31a-4b01d1360dbf",
                                                "sense_id": "8f551071-6980-3989-95ca-5372b6e202a9",
                                                "text": "Passing through Tokenhouse Yard, in Lothbury, of a sudden a casement violently opened just over my head, and a woman gave three frightful screeches, and then cried, ‘Oh! death, death, death!’ in a most inimitable tone, and which struck me with horror and a chillness in my very blood."
                                            },
                                            {
                                                "example_id": "8bd2ce5b-feb0-4cab-85bb-d6da427516db",
                                                "sense_id": "8f551071-6980-3989-95ca-5372b6e202a9",
                                                "text": "Some slight noise had awakened Francesca, and opening her casement, she looked through the thick and misty air, and saw him riding slowly over the heath."
                                            },
                                            {
                                                "example_id": "13fad778-41b6-46b0-bfba-280af2d1bacd",
                                                "sense_id": "8f551071-6980-3989-95ca-5372b6e202a9",
                                                "text": "The street-lamps always burn; but scarce a casement / In house or palace front from roof to basement / Doth glow or gleam athwart the mirk air cast."
                                            },
                                            {
                                                "example_id": "ffd5c8c1-c00a-4a90-a3a6-b941c3362e87",
                                                "sense_id": "8f551071-6980-3989-95ca-5372b6e202a9",
                                                "text": "The house was a big elaborate limestone affair, evidently new. Winter sunshine sparkled on lace-hung casement, on glass marquise, and the burnished bronze foliations of grille and door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7f00267-2be1-31dc-8ae6-f20ee41ef142",
                                        "entry_id": "b305bd5e-07c0-383a-b619-b3a1bceeabd3",
                                        "glosses": [
                                            "A casemate. Some writers and readers consider casement a catachresis when used in this sense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
