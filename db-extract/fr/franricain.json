            {
                "entry_id": "5dba4174-65e3-3382-9cb9-641fa41a5be5",
                "word": "franricain",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbf19287-dd20-4301-9958-a96dc55e9273",
