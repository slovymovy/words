                "senses": [
                    {
                        "sense_id": "54df2573-382a-3fbc-812f-02d1f948f104",
                        "entry_id": "206fa53e-271d-3d3c-9fb5-7102b48b05e8",
                        "glosses": [
                            "Entwicklung von etwas, die sich zumindest teilweise ihre ganz besonderen/andersartigen Wege sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23120c65-e337-4278-9c87-1b802462a186",
                                "sense_id": "54df2573-382a-3fbc-812f-02d1f948f104",
                                "text": "„Jedenfalls ist die Geschichte ein hübsches Beispiel für das Eigenleben, das so ein Satz entfalten kann, wenn er auf eine geeignete Zeitströmung trifft.“"
                            },
                            {
                                "example_id": "6953c7d9-4e21-46fe-b7a3-961e38adb3ba",
                                "sense_id": "54df2573-382a-3fbc-812f-02d1f948f104",
                                "text": "„Sie schienen ein Eigenleben zu haben, sich zu bewegen.“"
                            },
                            {
                                "example_id": "676f6e3f-fd8f-4043-b19a-c875573ad4aa",
                                "sense_id": "54df2573-382a-3fbc-812f-02d1f948f104",
                                "text": "„Ihre Begegnung beginnt ein Eigenleben anzunehmen, das keiner von ihnen definieren kann, das sie aber beide nährt und zu dem sie im einzigen selbstlosen Akt der Liebe beitragen.“"
                            },
                            {
                                "example_id": "6a71f6de-00d7-44a9-86e0-547eff7bf386",
                                "sense_id": "54df2573-382a-3fbc-812f-02d1f948f104",
                                "text": "„Sein Leben aber, wie er es ansah, hatte als Eigenleben keinen Sinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
