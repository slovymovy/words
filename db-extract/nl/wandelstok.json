                    {
                        "sense_id": "05113bde-4937-39f0-bb5a-59175a447b6f",
                        "entry_id": "51b1eceb-4771-3637-91b2-d157119ee038",
                        "glosses": [
                            "stok die dient als steun bij het wandelen en beschermt tegen vallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81156b74-7d5f-4d28-b808-714b99ac5429",
                                "sense_id": "05113bde-4937-39f0-bb5a-59175a447b6f",
                                "text": "De oude man leunt zwaar op zijn wandelstok."
                            },
                            {
                                "example_id": "430412e9-6aaa-471a-ae0d-271826be5521",
                                "sense_id": "05113bde-4937-39f0-bb5a-59175a447b6f",
                                "text": "Thuis had ik een systeem in elkaar geknutseld met klittenband die de paraplu aan mijn rugzak bevestigde, waardoor ik mijn handen vrijhield voor mijn wandelstokken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7eb6abc-5580-40bd-8549-125b32a9b420",
                        "source_entry_id": "51b1eceb-4771-3637-91b2-d157119ee038",
                        "source_sense_id": "05113bde-4937-39f0-bb5a-59175a447b6f",
                        "source_sense_description": "stok die dient als steun bij het wandelen en beschermt tegen vallen",
                        "target_lang_word": "Spazierstock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spazierstock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ed7fa13-8caf-3871-bb58-7a686dcd47ef",
                                        "entry_id": "654707af-22a5-3cfa-bbfb-3568ac202090",
                                        "glosses": [
                                            "Stock, den man beim Spazierengehen mit sich führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5483e204-9346-44fa-a163-89667c47584f",
                                                "sense_id": "7ed7fa13-8caf-3871-bb58-7a686dcd47ef",
                                                "text": "„Beim Anblick des Spazierstocks und der saloppen Aufmachung kam er sofort zu dem Schluß, daß ich ein Künstler oder so was sei.“"
                                            },
                                            {
                                                "example_id": "9ac3482e-dcfa-4a9d-b7e5-c278dbbe1acb",
                                                "sense_id": "7ed7fa13-8caf-3871-bb58-7a686dcd47ef",
                                                "text": "„Heute, in einer Zeit, in der Spazierstöcke allenfalls zum Gaudi bei Herrentagsausflügen mitgeführt werden, sind solche Verkaufszahlen die reine Utopie.“"
                                            },
                                            {
                                                "example_id": "579ae63d-c0f9-4209-820a-3dfe977561eb",
                                                "sense_id": "7ed7fa13-8caf-3871-bb58-7a686dcd47ef",
                                                "text": "„Fresenburg schüttelte den Kopf und klopfte mit seinem Spazierstock den Schnee von seinen Gamaschen.“"
                                            },
                                            {
                                                "example_id": "f3344a71-0e20-42e0-a710-5d6ee444c9d7",
                                                "sense_id": "7ed7fa13-8caf-3871-bb58-7a686dcd47ef",
                                                "text": "„Während sie in diesen Anblick vertieft waren, ging ein Mann mit graumeliertem Haar in einem schwarzen Paletot den Pfad entlang und fuhr dabei mit seinem Spazierstock rasselnd über sämtliche Gitterstäbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "902486da-6b08-4fa1-b485-76bb6e991c39",
                        "source_entry_id": "51b1eceb-4771-3637-91b2-d157119ee038",
                        "source_sense_id": "05113bde-4937-39f0-bb5a-59175a447b6f",
                        "source_sense_description": "stok die dient als steun bij het wandelen en beschermt tegen vallen",
                        "target_lang_word": "walking-stick",
