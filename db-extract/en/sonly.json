                        "glosses": [
                            "Of, pertaining to, or characteristic of a son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25b1d648-dd1a-4536-80da-c6e1c0df66cf",
                                "sense_id": "48d76067-396f-353d-b8a7-463bd5e3ed5e",
                                "text": "There's something sonly in each human being; but how well he hides it, and how unskillful we are at finding it! This \"something sonly\" is the vacuum of our hearts — a yearning emptiness that strains to be filled with Christ."
                            },
                            {
                                "example_id": "9ecd6ebb-184e-4f7d-950e-413d386d3e17",
                                "sense_id": "48d76067-396f-353d-b8a7-463bd5e3ed5e",
                                "text": "And also, if the Father were not the Father, then the Son would not have his sonly name."
                            }
                        ]
                    }
