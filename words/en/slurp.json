{
    "word_family": [
        "slurpy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ff72c3b-9f95-3b0c-bc56-fd19f8aacd23",
                    "sense_definition": "A loud sucking noise made while eating or drinking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a loud <w>slurp</w> while drinking his hot coffee.",
                            "target_lang_translations": {
                                "cs": "Při pití horké kávy hlasitě <w>srkl</w>."
                            }
                        },
                        {
                            "text": "The child finished his soup with a very noisy <w>slurp</w>.",
                            "target_lang_translations": {
                                "cs": "Dítě dojídalo polévku velmi hlučným <w>srknutím</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hlasitý zvuk sání při jídle nebo pití."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "srknutí",
                                "target_lang_sense_clarification": "podstatné jméno označující zvuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da61659e-e969-3d8e-b5b9-d4098c46f88c",
                    "sense_definition": "A mouthful of liquid consumed by sucking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a quick <w>slurp</w> of the cold water.",
                            "target_lang_translations": {
                                "cs": "Rychle se <w>srkla</w> studené vody."
                            }
                        },
                        {
                            "text": "He finished the last <w>slurp</w> of his milkshake.",
                            "target_lang_translations": {
                                "cs": "Dopil poslední <w>doušek</w> svého mléčného koktejlu."
                            }
                        }
                    ],
                    "synonyms": [
                        "sip"
                    ],
                    "target_lang_definitions": {
                        "cs": "Doušek tekutiny vypitý sáním."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "doušek",
                                "target_lang_sense_clarification": "množství tekutiny vypité najednou"
                            },
                            {
                                "target_lang_word": "srknutí",
                                "target_lang_sense_clarification": "množství tekutiny vypité sáním"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c3f730d-1301-3537-9e3e-94bd307eae6c",
                    "sense_definition": "To consume food or drink in a noisy manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is considered impolite to <w>slurp</w> your soup in many countries.",
                            "target_lang_translations": {
                                "cs": "V mnoha zemích se považuje za neslušné <w>srkat</w> polévku."
                            }
                        },
                        {
                            "text": "The hungry dog began to <w>slurp</w> the water from its bowl.",
                            "target_lang_translations": {
                                "cs": "Hladový pes začal <w>srkat</w> vodu z misky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Konzumovat jídlo nebo pití hlučným způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "srkat",
                                "target_lang_sense_clarification": "pít nebo jíst hlučně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea6563bb-27a7-3c9a-961c-91aaaec3842a",
                    "sense_definition": "To produce a loud sucking sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick mud began to <w>slurp</w> as we walked through the swamp.",
                            "target_lang_translations": {
                                "cs": "Když jsme procházeli bažinou, husté bláto začalo <w>čvachtat</w>."
                            }
                        },
                        {
                            "text": "The boots <w>slurped</w> loudly with every step in the wet ground.",
                            "target_lang_translations": {
                                "cs": "Boty při každém kroku ve vlhké zemi hlasitě <w>čvachtaly</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat hlasitý mlaskavý nebo sací zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čvachtat",
                                "target_lang_sense_clarification": "vydávat zvuk při pohybu v blátě nebo tekutině"
                            },
                            {
                                "target_lang_word": "mlaskat",
                                "target_lang_sense_clarification": "vydávat sací zvuk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}