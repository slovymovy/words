                    {
                        "translation_id": "5ee81cd2-ba77-4910-af5a-e5fd31aa3e9d",
                        "source_entry_id": "10f063d5-d960-3b43-8af5-0b73fb7f83f2",
                        "source_sense_id": "8b2db3fa-f7fd-38ee-aa17-138aba296783",
                        "target_lang_word": "Pessimist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pessimist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                        "entry_id": "d7ba3975-48cf-3a6a-a763-95ee51843303",
                                        "glosses": [
                                            "pessimistisch denkender Mensch; Mensch, der eine negative Einstellung zum Leben hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63fa2ed-4859-444b-87cd-06fbcc3db2c6",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "Du bist unverbesserlicher Pessimist. Lächle doch einmal!"
                                            },
                                            {
                                                "example_id": "9b3e902c-3d0a-4ee4-a3ec-058582225272",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "„George, mit dem ich in den letzten zwei Jahren schon viele tiefsinnige Gespräche über Leben und Tod, Gott und die Welt, Geld, Familie, Freundschaft und Gerechtigkeit geführt hatte, war ein eingefleischter Pessimist.“"
                                            },
                                            {
                                                "example_id": "ec87aa00-5a37-407c-b7f2-bbb1c88bc71a",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "„Ludda-Kristjan wusste nicht, was ein Pessimist ist, und Adelheid, die ihn gern ärgerte, sagte, ein Pessimist sei das Gegenteil eines Optimisten.“"
                                            },
                                            {
                                                "example_id": "6d5b77c1-9e79-459a-9558-f324a37c349d",
                                                "sense_id": "bfc8dc11-f7be-393a-b2da-5a0cb3c510aa",
                                                "text": "„Der Pessimist und Gestalter der melancholischen Trauer feiert sie immer wieder, sie ist die letzte Stütze seiner müden Verlierer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
