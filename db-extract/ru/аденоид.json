                                    }
                                ]
                            },
                            {
                                "target_word": "adenoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f51c9f23-c28f-39a8-8288-14e6b2d059d5",
                                        "entry_id": "6cee4bbb-a872-3fbb-8bf0-069cafbade9b",
                                        "glosses": [
                                            "an abnormally enlarged mass of lymphatic tissue at the back of the pharynx, often obstructing the nasal and ear passages and hindering speaking and breathing in young children."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb6f78b2-e18f-33f1-ad3b-bebe14892dfa",
                                        "entry_id": "6cee4bbb-a872-3fbb-8bf0-069cafbade9b",
                                        "glosses": [
                                            "Such a mass when not abnormally enlarged, covered by ciliated epithelium and located in the roof and posterior wall of the nasopharynx at the back of the throat behind the uvula."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
