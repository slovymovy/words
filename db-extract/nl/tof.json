                "senses": [
                    {
                        "sense_id": "52f1c758-a683-3202-9b3c-99aeb570b43b",
                        "entry_id": "8c7bdef5-fa05-38dd-a8ce-516619e95f32",
                        "glosses": [
                            "tough, difficult, harsh"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": [
                            {
                                "example_id": "c5435b41-1190-4275-aa75-b5f6c7cf7e50",
                                "sense_id": "52f1c758-a683-3202-9b3c-99aeb570b43b",
                                "text": "Ik woon in de stad en ik kom uit het bos / Toerisme gestudeerd en ik ben tevens kok / Mensen vinden me tof, grof, onbeschoft / en respect voor mijn buurvrouw want die noemt me os",
                                "translation": "I live in the city and I'm from the jungle / Studied tourism and I am also a cook / People think I am harsh, rude, uncouth / and respect for my neighbour because she calls me an ox",
                                "english": "I live in the city and I'm from the jungle / Studied tourism and I am also a cook / People think I am harsh, rude, uncouth / and respect for my neighbour because she calls me an ox"
                            },
                            {
                                "example_id": "7b7c27f0-da8b-4e65-a598-68bbfbbc0b85",
                                "sense_id": "52f1c758-a683-3202-9b3c-99aeb570b43b",
                                "text": "De Surinaamse Politiebond (SPB) gaat toffe tijden tegemoet. Daarom heeft secretaris Mielando Atompai alle leden opgeroepen om de algemene ledenvergaderingen (alv's) te bezoeken.",
                                "translation": "The Surinamese Police Union (SPB) is facing tough times. That is why secretary Mielando Atompai has called on all members to attend the members' general assemblies.",
                                "english": "The Surinamese Police Union (SPB) is facing tough times. That is why secretary Mielando Atompai has called on all members to attend the members' general assemblies."
                            }
                        ]
                    }
