                "senses": [
                    {
                        "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                        "entry_id": "39532ddf-b7d1-3773-9cc4-545916244e99",
                        "glosses": [
                            "Bier (vor allem Pilsener)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "783c21a0-6a2e-48fd-ad36-f956b4e9cbe6",
                                "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                                "text": "„Zuweilen, aus lauter Freude an den empörten Blicken der Menschen um mich herum, öffne ich meine erste Pilsette direkt hinter der Kasse, nehme ein Schlückchen, stoße einen Seufzer des Wohlwollens aus und marschiere los.“"
                            },
                            {
                                "example_id": "e7ae8f7c-513c-48c5-bdf1-ff72579c3c87",
                                "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                                "text": "„Der See, den Henner für die Nacht ausgesucht hatte, war nicht weit entfernt, so dass es kaum Diskussionen gab, als ich vorschlug, im benachbarten Biergarten ein paar Pilsetten einzuatmen, vielleicht ein verbranntes Nackensteak zu schlucken und erst anschließend den Ankerplatz aufzusuchen.“"
                            },
                            {
                                "example_id": "689b01ec-971e-4888-80af-61da860b42af",
                                "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                                "text": "„Mit an Bord natürlich Pilsetten, Sandeman-Sherry und Korn.“"
                            },
                            {
                                "example_id": "caa45d55-19a0-4412-9c5a-2b7d79796b97",
                                "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                                "text": "„Vor der Tür lauter Hamburger, die sich vielleicht auch fragten: Weihnachten hin? Oder lieber nicht? Erst mal ’ne Pilsette. Das macht das Sitzfleisch gefügig.“"
                            },
                            {
                                "example_id": "6f95e4d3-09f1-4623-b7d5-0941d389f3f8",
                                "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                                "text": "„Sechs Pilsetten später beschlossen wir, uns einen grandiosen Scherz zu erlauben.“"
                            },
                            {
                                "example_id": "e9d7a90a-f0f6-4454-abbb-2af437bfda4b",
                                "sense_id": "8580db61-c6c7-3d73-84de-21242fa4765a",
                                "text": "„‚Noch ne Pilsette, Herminchen!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
