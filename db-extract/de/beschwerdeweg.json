                ],
                "senses": [
                    {
                        "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                        "entry_id": "b52e8b33-1660-3e12-9963-3aec3f48da4f",
                        "glosses": [
                            "Prozess beim Eingang einer Beschwerde in einer Organisation, beispielsweise bei einer Kundenreklamation"
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "ae4f4c2b-2e6c-418b-81db-4c48ffa677bf",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Wir haben eine Arbeitsgruppe eingerichtet im letzten Sommersemester, die Richtlinien erarbeitet hat. Richtlinien, die formelle und informelle Beschwerdewege festlegen.“"
                            },
                            {
                                "example_id": "111c2a04-be60-48fb-a73f-a23b86100021",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Beim mündlichen Beschwerdeweg sind gut geschulte Mitarbeiter und ein beschwerdefreundliches Unternehmensklima sehr wichtig.“"
                            },
                            {
                                "example_id": "42fd51b6-a88a-4a70-8aac-55d6b35129cf",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Zum schriftlichen Beschwerdeweg gehören Brief und Telefax.“"
                            },
                            {
                                "example_id": "25e549b0-2015-4002-b7b8-ccda45f7ab8a",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Der telefonische Beschwerdeweg hat im Vergleich zum schriftlichen Weg Vorteile sowohl für Kunden als auch für das Unternehmen.“"
                            },
                            {
                                "example_id": "b8d3f584-c630-43f1-b363-7d649f97ed3e",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "[CIA: In seinem Buch] „beschreibt Sterlin, wie er vergeblich den internen Beschwerdeweg zu benutzen versuchte.“"
                            },
                            {
                                "example_id": "f61f5be2-2aad-406e-9ab4-23ff75b8ec28",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Zur Durchsetzung seiner Rechte bzw. gegen belastende Verwaltungsakte des Dienstherren steht dem Beamten zunächst der Antrags- und Beschwerdeweg offen.“"
                            },
                            {
                                "example_id": "8b2ea075-749d-46ea-8108-6f81fdd820d8",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Trotzdem wurde das Video gesperrt und war auch auf dem normalen Beschwerdeweg nicht wieder freischaltbar.“"
                            },
                            {
                                "example_id": "ccd0ddfc-8044-4f18-9d6f-b421615d7a39",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„So kritisierte das Bundesjustizministerium den \"komplizierten Beschwerdeweg\" bei Facebook.“"
                            },
                            {
                                "example_id": "63f93ed5-68b3-4d5e-88a9-d332390549fc",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Zudem spielt vermutlich auch eine Rolle, dass die Möglichkeit zur Beschwerde bei der Bonner Behörde immer bekannter wird und dass viele Bürger erst jetzt wütende Schreiben verfassen, weil sie vorher nichts von diesem Beschwerdeweg wussten.“"
                            },
                            {
                                "example_id": "810c8c2d-0281-43fe-bccc-59e70b47bc23",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„Symicron hat nun noch die Möglichkeit, die Zulassung der Revision beim Bundesgerichtshof auf dem Beschwerdeweg zu erreichen.“"
                            },
                            {
                                "example_id": "8db53b48-3a07-4d5e-9608-c6a104909bd6",
                                "sense_id": "805d0692-4a84-3c82-945a-5ec384844006",
                                "text": "„»Für eine erwachsene Frau gibt es andere Mittel, sich zu wehren, zum Beispiel, verbal zurückzuschießen. Erst wenn das alles nichts bringt, sollte man den Beschwerdeweg einschlagen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
