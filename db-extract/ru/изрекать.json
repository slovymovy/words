                ],
                "senses": [
                    {
                        "sense_id": "50f20f96-8930-3ea9-ba39-732a284b7a2a",
                        "entry_id": "5dc8b4fd-dfa3-341b-8c5e-81e1033333c3",
                        "glosses": [
                            "высок. произносить, говорить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829e6d56-6eab-4743-a476-905c75569f21",
                                "sense_id": "50f20f96-8930-3ea9-ba39-732a284b7a2a",
                                "text": "Все, что он писал и изрекал, казалось мне гениальным…"
                            },
                            {
                                "example_id": "d3d60f53-d3d7-4853-8322-f0b320b36cc3",
                                "sense_id": "50f20f96-8930-3ea9-ba39-732a284b7a2a",
                                "text": "Ты един неизглаголан, потому что произвёл всё, изрекаемое словом!"
                            },
                            {
                                "example_id": "f7a6bb45-a5c3-414b-a063-54fb05e525f6",
                                "sense_id": "50f20f96-8930-3ea9-ba39-732a284b7a2a",
                                "text": "Он шагал, слушал, внезапно останавливался, изрекал что-нибудь едкое по поводу выслушанного и, оттолкнувшись палкой от тротуара, продолжал шествие до следующей афористической передышки."
                            }
                        ]
                    }
                ],
