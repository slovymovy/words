                "senses": [
                    {
                        "sense_id": "539fe3f2-308e-3a7c-a322-a94a748ec33a",
                        "entry_id": "1a34d546-6004-3138-a4a7-60f93f10a40c",
                        "glosses": [
                            "Verlust an Gewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f657599-b84c-4d45-8903-c563d04675c5",
                                "sense_id": "539fe3f2-308e-3a7c-a322-a94a748ec33a",
                                "text": "Durch Räuchern entsteht ein Wasserverlust, was letzten Endes einen Gewichtsverlust verursacht."
                            },
                            {
                                "example_id": "79345e32-521b-404a-897c-e1aa9fe04b5c",
                                "sense_id": "539fe3f2-308e-3a7c-a322-a94a748ec33a",
                                "text": "Erhöhter Gewichtsverlust kann ein Krankheitssymptom sein, sowohl beim Tier als auch beim Menschen."
                            },
                            {
                                "example_id": "aa80113d-20fc-48eb-b9d4-1abded4ee1ba",
                                "sense_id": "539fe3f2-308e-3a7c-a322-a94a748ec33a",
                                "text": "Durch das Abladen von 30 Säcken Mehl entstand auf dem Laster ein Gewichtsverlust."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
