        "fr-extract.jsonl": [
            {
                "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                "word": "magma",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "17a6fbdc-2b2c-4454-8863-7d005526a4c9",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "tags": [
                            "plural"
                        ],
                        "form": "magmas"
                    },
                    {
                        "form_id": "7b8d0086-8c42-4f4b-a788-f717e0a08850",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "tags": [
                            "rare"
                        ],
                        "form": "magmat"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c397859-01a8-3ffc-9c69-0fc48277a260",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "glosses": [
                            "Résidu épais, lie restant après l’expression des parties fluides d’une substance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef01c63-6006-4358-8f35-e9a3fe9c6031",
                                "sense_id": "6c397859-01a8-3ffc-9c69-0fc48277a260",
                                "text": "Au bout d’une heure ou deux, on laisse reposer, on décante la liqueur, puis on reverse sur le magma une semblable quantité de nouvelle eau régale que l’on fait bouillir comme précédemment."
                            }
                        ]
                    },
                    {
                        "sense_id": "6561c485-13a5-30d2-bc6f-6a8b12ab54ad",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "glosses": [
                            "Bouillie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d552d832-d3a7-457c-aaba-11ca70ed8849",
                                "sense_id": "6561c485-13a5-30d2-bc6f-6a8b12ab54ad",
                                "text": "Le gardien apportait la nourriture : il passa entre les barreaux deux petits bols emplis d’un magma couleur de boue, à la vapeur aussi fétide que l’atmosphère."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf4f3919-bfb9-3531-aef4-9d3d6d26c87b",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "glosses": [
                            "Ensemble confus d’éléments ; mélange indistinct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36da050-c62a-4485-83b8-5fc0d5cefaa6",
                                "sense_id": "bf4f3919-bfb9-3531-aef4-9d3d6d26c87b",
                                "text": "Les plus mordus d’entre les voyageurs […] pourchassaient leur archiguide à travers le dédale lutécien et le magma des encombrements."
                            },
                            {
                                "example_id": "21a74627-279b-4899-a4b4-bce71446daec",
                                "sense_id": "bf4f3919-bfb9-3531-aef4-9d3d6d26c87b",
                                "text": "Ce qui prime tout est l’immense magma de peur et de veulerie des veilles de catastrophes."
                            },
                            {
                                "example_id": "0c586fff-5dd1-4e82-ae02-26f699c5086a",
                                "sense_id": "bf4f3919-bfb9-3531-aef4-9d3d6d26c87b",
                                "text": "Si je me laissais aller à une confession voilée, à une sorte de journal intime, je choirais dans un magma psychologique bien éloigné de mon propos."
                            },
                            {
                                "example_id": "685b59d1-4c37-4e5e-b240-4f31a0d0d077",
                                "sense_id": "bf4f3919-bfb9-3531-aef4-9d3d6d26c87b",
                                "text": "[…], Alexandre se permet de mêler plus clairement dans ce « magma » de raisons d’agir comme il dira plus loin – […] – une critique anti-musulmans totalement évacuée de la communication officielle des Hommen, mais largement présente en coulisse […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "59be0599-ff4c-3fe1-84b6-1048ccde53b4",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "glosses": [
                            "Mélange pâteux, plus ou moins fluide, de matières minérales (roches) en fusion, provenant des zones profondes de la terre, où les roches en fusion sont soumises à des conditions extrêmes de pression et de température."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41ae91c-f001-421f-83d0-6ceedff0055c",
                                "sense_id": "59be0599-ff4c-3fe1-84b6-1048ccde53b4",
                                "text": "La température d’un magma se situe entre 700 et 1 200 °C suivant sa composition chimique."
                            },
                            {
                                "example_id": "085a0c0a-0912-49fc-a3b6-fd34178f38fd",
                                "sense_id": "59be0599-ff4c-3fe1-84b6-1048ccde53b4",
                                "text": "... je me projetais vulcanologue célèbre, à genoux sur le magma tiède, sous un soleil qui rougissait immanquablement ma nuque voûtée."
                            },
                            {
                                "example_id": "c232ecb5-2ff4-4d89-a0e6-165f1084cfa9",
                                "sense_id": "59be0599-ff4c-3fe1-84b6-1048ccde53b4",
                                "text": "Le granite rose breton est une roche magmatique, issue de la cristallisation d’un magma à quelques kilomètres sous terre il y a environ 300 millions d’années."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6f8433b-8942-30ae-b3b2-020e0a8a1c08",
                        "entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "glosses": [
                            "Structure algébrique constituée d’un ensemble et d'une loi de composition interne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2851dd85-4060-4c67-9eff-681e65cc6f0a",
                                "sense_id": "f6f8433b-8942-30ae-b3b2-020e0a8a1c08",
                                "text": "L’ensemble des entiers naturels muni de l’addition est un magma."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ee5ec2e-ffd5-40e2-a3f4-ab814097c693",
                        "source_entry_id": "91a87e81-714c-3cf4-815e-8eb3c9cf7b60",
                        "source_sense_description": "roche en fusion",
                        "target_lang_word": "Magma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4022c084-c9b3-3d54-9f75-f7ab8d233f7a",
                                        "entry_id": "6eee7343-dbc4-335a-bf71-eee27e462a8a",
                                        "glosses": [
                                            "sehr heißes, zähflüssiges Gestein im Erdinneren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b05a7d8-d21f-48f0-8a07-88018fa2efee",
                                                "sense_id": "4022c084-c9b3-3d54-9f75-f7ab8d233f7a",
                                                "text": "„Aufsteigendes Magma bedeutet zwar noch lange nicht, dass der Vulkan ausbricht. Doch die teure Bohrung wäre verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e6fad39-d380-333f-a8e4-3f698caa8a3f",
                                        "entry_id": "6eee7343-dbc4-335a-bf71-eee27e462a8a",
                                        "glosses": [
                                            "teilweise auskristallisierter Sirup, der als Zwischenstufe bei der Zuckerproduktion entsteht"
                                        ],
                                        "tags": [
                                            "Lebensmittelherstellung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "383d4a76-afe3-41ba-9a35-eceb4284e30e",
                                                "sense_id": "4e6fad39-d380-333f-a8e4-3f698caa8a3f",
                                                "text": "„Die Ausbeute an Zucker beim Zentrifugieren des Magmas soll groß sein, damit die Wärmebilanz der Fabrik von unnötigen Rückläufen entlastet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fffdec47-9270-321a-8a9b-04c3b0726ee8",
                                        "entry_id": "6eee7343-dbc4-335a-bf71-eee27e462a8a",
                                        "glosses": [
                                            "algebraische Struktur aus einer Trägermenge und einer zweistelligen inneren Verknüpfung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00cba41-a42e-4773-8a19-05deb2dcee73",
                                                "sense_id": "fffdec47-9270-321a-8a9b-04c3b0726ee8",
                                                "text": "„Es wird das von einer Menge S frei erzeugte Magma F(S) konstruiert und durch universelle Abbildungseigenschaften charakterisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "14657b02-9cca-3bca-82af-ef97d2bdd23a",
                                        "entry_id": "6eee7343-dbc4-335a-bf71-eee27e462a8a",
                                        "glosses": [
                                            "weiche, knetbare Masse"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c140da72-4c48-43ac-9075-6879b121bcdf",
                                                "sense_id": "14657b02-9cca-3bca-82af-ef97d2bdd23a",
                                                "text": "„Debout machte seinerseits Versuche mit Leblanc und Denonvilliers und fand, dass das Gerinnsel in den Gefässen nicht geronnenes Blut sei, sondern ein Magma aus Eisenalbuminat und Sesquioxyd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
