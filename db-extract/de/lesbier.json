                "senses": [
                    {
                        "sense_id": "92e28416-da3e-3d29-b859-ee5fd6472319",
                        "entry_id": "92bbce83-ba5d-39a6-a387-18f5b488300e",
                        "glosses": [
                            "Lesbian, native or inhabitant of Lesbos"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c67540-d608-4d35-b5a9-7063b6a31dbf",
                                "sense_id": "92e28416-da3e-3d29-b859-ee5fd6472319",
                                "text": "Die lesbische Kitharodenschule erhielt sich in Achtung, nach Olympiade 60 siegte der Lesbier Perikleidos bei den Karneen."
                            },
                            {
                                "example_id": "3c53c927-2c20-4230-b2cd-36670bb355d3",
                                "sense_id": "92e28416-da3e-3d29-b859-ee5fd6472319",
                                "text": "Hieher gehört auch, was Phanias, der Lesbier (46), berichtet, daß man an einigen Orten auf Lesbos eine Erde finde, welche bei Augenkrankheiten heilsam sei, und […]"
                            },
                            {
                                "example_id": "07941800-23ce-4d48-8041-3a17f47593b6",
                                "sense_id": "92e28416-da3e-3d29-b859-ee5fd6472319",
                                "text": "In seinem Auftrage erschien 1515 der Lesbier Horut Barbarossa in Algier, bekämpfte die Spanier und begann den kleinen almohadischen Dynastien ein Ende zu machen."
                            }
                        ]
                    }
                ],
