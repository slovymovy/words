                        "entry_id": "665f4244-48df-30a2-995d-1d49ce5d3e9f",
                        "glosses": [
                            "eine Flöte, die beim Blasen quer gehalten wird"
                        ],
                        "tags": [
                            "Musik",
                            "Holzblasinstrumente"
                        ],
                        "examples": [
                            {
                                "example_id": "d31a3801-3b61-4e2f-b7d3-fe6352401928",
                                "sense_id": "cb4158ed-3ce4-3cf3-b9ea-9936c8046cfb",
                                "text": "Querflöten werden oft in Sinfonieorchestern eingesetzt."
                            },
                            {
                                "example_id": "f2ee8764-d4b1-47fa-9c24-505799d5e53e",
                                "sense_id": "cb4158ed-3ce4-3cf3-b9ea-9936c8046cfb",
                                "text": "Eine Querflöte wird beim Blasen quer gehalten."
                            },
                            {
                                "example_id": "79d57121-8880-4e63-8287-044057310436",
                                "sense_id": "cb4158ed-3ce4-3cf3-b9ea-9936c8046cfb",
                                "text": "„Es ging um den Preis einer kleinen Querflöte.“"
                            }
                        ],
