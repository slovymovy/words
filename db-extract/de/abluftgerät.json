                "senses": [
                    {
                        "sense_id": "4f687c38-7f0f-34cd-9446-2791437a8307",
                        "entry_id": "ae1033b1-77f1-3be5-bb68-c281902cece0",
                        "glosses": [
                            "technische Einrichtung die Luft aus einem Raum absaugt und behandelt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "77507e5a-b9fa-4957-8024-d2fa125eec05",
                                "sense_id": "4f687c38-7f0f-34cd-9446-2791437a8307",
                                "text": "Ein Abluftgerät besteht im wesentlichen aus einem Gehäuse, einem Abluftfilter und einem Abluftventilator."
                            },
                            {
                                "example_id": "462ba1e5-01e4-4a0f-a976-a1a5ca1c4832",
                                "sense_id": "4f687c38-7f0f-34cd-9446-2791437a8307",
                                "text": "„Zentraler Bestandteil ist das Abluftgerät Healthbox II mit raumweise zuzuordnenden Steuerungsmodulen.“"
                            },
                            {
                                "example_id": "2c210cc0-fdce-4d1a-a0cd-ebd2d29e509b",
                                "sense_id": "4f687c38-7f0f-34cd-9446-2791437a8307",
                                "text": "Das BRANDGAS-ABLUFTGERÄT in feuerfester Ausführung (Feuerwiderstandsklasse L90), bestehend aus einem tragenden Profilrahmen als Tragekonstruktion des feuerfesten Gehäuses."
                            },
                            {
                                "example_id": "6f125b30-d4eb-416d-9dfc-48da9ea9f34f",
                                "sense_id": "4f687c38-7f0f-34cd-9446-2791437a8307",
                                "text": "„Kombiniertes Zu- und Abluftgerät mit energieoptimierten Ventilatoren mit EC Antrieb. Standard Taschenfilter für Außenluft F 5 und Abluft G 4 (höhere Filterklasse möglich), Wärmerückgewinnung durch Aluminium-Plattenwärmeübertrager mit integriertem Bypass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
