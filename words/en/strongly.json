    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d6e9390f-1427-3046-8234-aeed605fb38d",
                    "sense_definition": "To a high degree or intensity; very much.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>strongly</w> recommend that you read the instructions before starting.",
                            "target_lang_translations": {
                                "ru": "Я <w>настоятельно</w> рекомендую вам прочитать инструкцию перед началом.",
                                "zh": "我<w>极力</w>建议你在开始之前先阅读说明书。"
                            }
                        },
                        {
                            "text": "The committee <w>strongly</w> opposes the new building plans for the park.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>решительно</w> выступает против новых планов застройки парка.",
                                "zh": "委员会<w>坚决</w>反对公园的新建筑规划。"
                            }
                        }
                    ],
                    "synonyms": [
                        "firmly",
                        "intensely",
                        "greatly",
                        "deeply",
                        "highly"
                    ],
                    "antonyms": [
                        "slightly",
                        "mildly"
                    ],
                    "common_phrases": [
                        "strongly agree",
                        "strongly recommend",
                        "strongly believe",
                        "strongly oppose",
                        "strongly suggest"
                    ],
                    "target_lang_definitions": {
                        "ru": "В высокой степени или очень интенсивно; очень.",
                        "zh": "在很大程度上或非常强烈地；极其。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоятельно",
                                "target_lang_sense_clarification": "о совете или рекомендации"
                            },
                            {
                                "target_lang_word": "решительно",
                                "target_lang_sense_clarification": "о мнении или позиции"
                            },
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "в значительной степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强烈",
                                "target_lang_sense_clarification": "用于表达观点、反对或建议"
                            },
                            {
                                "target_lang_word": "极力",
                                "target_lang_sense_clarification": "用于表达竭尽全力地推荐或主张"
                            },
                            {
                                "target_lang_word": "坚决",
                                "target_lang_sense_clarification": "用于表达立场坚定地反对或支持"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d3d14ac-af4b-37f5-a381-6c116db9f812",
                    "sense_definition": "In a powerful or forceful manner; with physical strength.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind was blowing <w>strongly</w> against the windows during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма ветер <w>сильно</w> дул в окна.",
                                "zh": "暴风雨期间，风<w>猛烈</w>地吹打着窗户。"
                            }
                        },
                        {
                            "text": "The runner finished <w>strongly</w> to win the race in the final seconds.",
                            "target_lang_translations": {
                                "ru": "Бегун <w>мощно</w> финишировал и выиграл гонку на последних секундах.",
                                "zh": "那位选手在最后几秒钟<w>有力</w>地冲刺，赢得了比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "powerfully",
                        "forcefully",
                        "vigorously",
                        "hard"
                    ],
                    "antonyms": [
                        "weakly",
                        "feebly"
                    ],
                    "common_phrases": [
                        "finish strongly",
                        "blow strongly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощно или с применением физической силы.",
                        "zh": "以有力或强劲的方式；具有物理强度地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "физически"
                            },
                            {
                                "target_lang_word": "мощно",
                                "target_lang_sense_clarification": "энергично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "用于描述风、雨等自然现象"
                            },
                            {
                                "target_lang_word": "有力",
                                "target_lang_sense_clarification": "用于描述动作或表现"
                            }
                        ]
                    }
                }
            ]
        }
    ]
