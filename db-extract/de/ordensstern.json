                "senses": [
                    {
                        "sense_id": "307f3d56-5af3-343a-82eb-6636338b8a09",
                        "entry_id": "2e41ece7-47f8-3bdc-bdb6-f5f4158c02b0",
                        "glosses": [
                            "sternförmiger Orden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a06a83-b5ea-403f-afff-a482839e8cb5",
                                "sense_id": "307f3d56-5af3-343a-82eb-6636338b8a09",
                                "text": "„Für die Ordenssterne schneidet man eine Grundform von Pappe und beklebt sie so schön als [sic!] möglich mit sternförmigen Scheiben von Gold- und farbigem Glanzpapier.“"
                            },
                            {
                                "example_id": "7f9f58db-3ab4-409c-b71d-8cf7e2dc7d3c",
                                "sense_id": "307f3d56-5af3-343a-82eb-6636338b8a09",
                                "text": "„Das blaue Tuch seines Uniformfracks verschwand unter den Epauletten, den Ordenssternen und dem breiten Band der Ehrenlegion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad35c67f-a341-35b4-801b-12de67532a44",
                        "entry_id": "2e41ece7-47f8-3bdc-bdb6-f5f4158c02b0",
                        "glosses": [
                            "Pflanze aus der Gattung der Stapelien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0685f0a-dd29-4f74-8ae9-16298033be0f",
                                "sense_id": "ad35c67f-a341-35b4-801b-12de67532a44",
                                "text": "Der Ordenstern ist eine hübschen Ampelpflanze."
                            }
                        ],
                        "sense_index_json": "\"2\""
