                ],
                "senses": [
                    {
                        "sense_id": "ad244f6d-f778-3157-9a88-be091283fc12",
                        "entry_id": "74d3db2f-a5b5-378f-96a2-0def430377fc",
                        "glosses": [
                            "Teilrepublik der Sowjetunion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4bdceae-7c93-4cb7-ae46-20d953513c34",
                                "sense_id": "ad244f6d-f778-3157-9a88-be091283fc12",
                                "text": "Einige ehemalige Sowjetrepubliken haben sich nach der Wende der Europäischen Union zugewandt."
                            },
                            {
                                "example_id": "7ae168b5-79d9-4a8e-8685-b541a9560dfa",
                                "sense_id": "ad244f6d-f778-3157-9a88-be091283fc12",
                                "text": "„Während die 15 Sowjetrepubliken unabhängig werden durften – für die EU-Abgeordnete eine der größten Fehlentscheidungen –, ist das den Autonomen Republiken verwehrte geblieben.“"
                            },
                            {
                                "example_id": "434f2909-d0f3-4a39-938a-e42bf84f49a7",
                                "sense_id": "ad244f6d-f778-3157-9a88-be091283fc12",
                                "text": "„Stalin wiederum ließ mehr als 900000 Deutsche, die auf russischem Gebiet lebten, in östliche Sowjetrepubliken deportieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
