            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0920a999-8d0f-37c5-b60a-4489a15bb21a",
                    "sense_definition": "het onderste deel van de romp van een schip dat zorgt voor stabiliteit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kiel</w> van het schip raakte de zanderige bodem van de ondiepe haven.",
                            "target_lang_translations": {
                                "en": "The <w>keel</w> of the ship touched the sandy bottom of the shallow harbor."
                            }
                        },
                        {
                            "text": "Bij de ceremonie plaatste men een munt bij de <w>kiel</w> voor veel geluk.",
                            "target_lang_translations": {
                                "en": "During the ceremony, a coin was placed near the <w>keel</w> for good luck."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kiel van een schip"
                    ],
                    "target_lang_definitions": {
                        "en": "the lowest part of a ship's hull that provides stability"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keel",
                                "target_lang_sense_clarification": "of a ship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd3b237-e55f-37a5-857d-7867923be8ff",
                    "sense_definition": "een ruim kledingstuk voor het bovenlichaam zonder voorsluiting",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer droeg een blauwe <w>kiel</w> terwijl hij op het land aan het werk was.",
                            "target_lang_translations": {
                                "en": "The farmer wore a blue <w>smock</w> while he was working on the land."
                            }
                        },
                        {
                            "text": "Tijdens carnaval dragen veel mensen in het zuiden een traditionele <w>kiel</w>.",
                            "target_lang_translations": {
                                "en": "During carnival, many people in the south wear a traditional <w>smock</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blauwe kiel"
                    ],
                    "target_lang_definitions": {
                        "en": "a loose upper garment without a front opening, often worn as workwear"
