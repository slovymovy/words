                                    {
                                        "sense_id": "007ba84d-730e-3d7f-afb2-6930334a5d8b",
                                        "entry_id": "93347bee-326c-3cc4-949c-3c8ed82eea63",
                                        "glosses": [
                                            "in der Art und Weise von Abschnitten"
                                        ],
                                        "tags": [
                                            "meist als Adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef44f695-23ff-4dc5-b35b-1cfe42387d22",
                                                "sense_id": "007ba84d-730e-3d7f-afb2-6930334a5d8b",
                                                "text": "Wir sollten nicht dieser Straße folgen, denn sie ist nur abschnittsweise asphaltiert."
                                            },
                                            {
                                                "example_id": "1aee3b57-d277-4d67-8de9-64834409c098",
                                                "sense_id": "007ba84d-730e-3d7f-afb2-6930334a5d8b",
                                                "text": "„Bei abschnittsweise definierten Interpolanten ist die Frage der Stetigkeit und Differenzierbarkeit an den Stützstellen von großer Bedeutung.“"
                                            },
                                            {
                                                "example_id": "bb5fc2bb-661d-44ad-b4a4-8a8a73a08cce",
                                                "sense_id": "007ba84d-730e-3d7f-afb2-6930334a5d8b",
                                                "text": "Die Bundesstraße 26 begleitet abschnittsweise den Fluss Main."
                                            },
                                            {
                                                "example_id": "6a51521b-aa4d-4c1e-9506-f370a5f22583",
                                                "sense_id": "007ba84d-730e-3d7f-afb2-6930334a5d8b",
                                                "text": "„Hingegen ist er [der Fluss Essequibo] in seinem Oberlauf, bedingt durch zahlreiche Wasserfälle und Stromschnellen nur bedingt und abschnittsweise schiffbar.“"
                                            },
                                            {
                                                "example_id": "516931c7-296d-4d4f-a84f-0201f8932609",
                                                "sense_id": "007ba84d-730e-3d7f-afb2-6930334a5d8b",
                                                "text": "„Dafür wird die Straße abschnittsweise halbseitig gesperrt, der Verkehr Richtung Oldenburg wird über die Gegenfahrbahn geführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3841b463-da2d-335a-8e3b-ae62e03de587",
                                        "entry_id": "93347bee-326c-3cc4-949c-3c8ed82eea63",
                                        "glosses": [
                                            "bezogen auf Abschnitte"
                                        ],
                                        "tags": [
                                            "attributiv mit Verbalsubstantiven"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83dd7254-35fe-4512-9568-0d51a379a8e4",
                                                "sense_id": "3841b463-da2d-335a-8e3b-ae62e03de587",
                                                "text": "Terme, die mittels einer Fallunterscheidung kombiniert werden, heißen abschnittsweise oder termdefinierte Funktionen."
                                            },
                                            {
                                                "example_id": "f0cbfa60-0777-4940-bf1f-23fa38770cc2",
                                                "sense_id": "3841b463-da2d-335a-8e3b-ae62e03de587",
                                                "text": "„Das wurde von dem Miteigentümer des Kreisels, der Unternehmensgruppe Becker & Kries, erstellt und sieht eine abschnittsweise Sanierung bei laufendem Betrieb vor.“"
                                            },
                                            {
                                                "example_id": "f0c67246-2543-446e-b9be-a6ce0330c834",
                                                "sense_id": "3841b463-da2d-335a-8e3b-ae62e03de587",
                                                "text": "„Ebenfalls abzugrenzen sind Linienverlegungen, also der abschnittsweise Neubau von Strecken, die bisherige Strecken ersetzen.“"
                                            },
                                            {
                                                "example_id": "9f4f15a0-98f9-4381-b607-7b009ea7dcbf",
                                                "sense_id": "3841b463-da2d-335a-8e3b-ae62e03de587",
                                                "text": "„Der Ausbau der Strecke [Bahnstrecke Mannheim–Forbach] für eine abschnittsweise Höchstgeschwindigkeit von 200 km/h wird als POS Nord bezeichnet […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
