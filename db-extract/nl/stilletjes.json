                                "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                "text": "Ze vestigden zich in Haarlem of Leiden of keerden later stilletjes terug."
                            },
                            {
                                "example_id": "28450481-30d9-49ed-ac5d-afc64eb2d778",
                                "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                "text": "Iedere avond sloop hij stilletjes naar de stal, rolde zich in een paardedeken en sliep lekker in het stro."
                            },
                            {
                                "example_id": "207737d0-1806-4ebf-b8f9-d2aae9e797e7",
                                "sense_id": "b7bbb66e-f8de-3181-ae6f-aa09cc38d947",
                                "text": "Ik herhaalde mijn nieuwe naam een aantal keer stilletjes, ik was ‘Van Go’ geworden."
                            }
                        ]
