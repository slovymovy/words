                                    {
                                        "sense_id": "4fe1d165-9b9d-3363-ae8c-96671b58c778",
                                        "entry_id": "f9e8d46c-5444-397c-ae7d-d240b37311cb",
                                        "glosses": [
                                            "υπάλληλος του ταχυδρομείου που παραδίδει την αλληλογραφία στους παραλήπτες στο σπίτι τους ή την έδρα τους"
                                        ],
