        "nl-extract.jsonl": [
            {
                "entry_id": "db809bb5-ce30-3500-b241-81a7f5c215cf",
                "word": "kafferen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91bb5a46-81f4-3d4b-8a98-71aaf5e840c0",
                        "entry_id": "db809bb5-ce30-3500-b241-81a7f5c215cf",
                        "glosses": [
                            "vloeken en tieren zonder dat het onderwerp waartegen men vloekt genoemd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e6b9d96-702e-4851-87f9-110173d6b351",
                                "sense_id": "91bb5a46-81f4-3d4b-8a98-71aaf5e840c0",
                                "text": "Deze onbeschofte jongeman was luid aan het schelden en kafferen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3d21e2e-b714-4743-9a72-70f664279375",
                        "source_entry_id": "db809bb5-ce30-3500-b241-81a7f5c215cf",
                        "source_sense_id": "91bb5a46-81f4-3d4b-8a98-71aaf5e840c0",
                        "target_lang_word": "let rip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "let rip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "841b6996-9a2b-3e16-b46c-33ced67f5560",
                                        "entry_id": "d84c11af-f0bd-3144-b314-85c56eb0fff8",
                                        "glosses": [
                                            "To unleash, let loose, uncork; to allow (something) to happen or proceed without restraint."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b930dbe-815b-46cd-9f96-2051b3328e6f",
                                                "sense_id": "841b6996-9a2b-3e16-b46c-33ced67f5560",
                                                "text": "When she heard the news, she let rip a tirade heard throughout the office."
                                            },
                                            {
                                                "example_id": "dee31f65-a5e3-4478-a5a3-001ac6368eaf",
                                                "sense_id": "841b6996-9a2b-3e16-b46c-33ced67f5560",
                                                "text": "Ok, it’s all clear. Let ’er rip."
                                            },
                                            {
                                                "example_id": "d7560911-aaec-4b03-a242-0c0d95638716",
                                                "sense_id": "841b6996-9a2b-3e16-b46c-33ced67f5560",
                                                "text": "He let rip a fart that emptied the elevator at the next floor."
                                            },
                                            {
                                                "example_id": "b7c54df1-d9bb-4041-bc92-1b12773901dc",
                                                "sense_id": "841b6996-9a2b-3e16-b46c-33ced67f5560",
                                                "text": "Now is the time for a bully trip,\nSo shake her up and let her rip!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d20465-f1a1-35d2-a822-72af109e1d2b",
                                        "entry_id": "d84c11af-f0bd-3144-b314-85c56eb0fff8",
                                        "glosses": [
                                            "To utter or release without restraint."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22095bf-616e-4b7a-9fc4-b543f83140b0",
                                                "sense_id": "d9d20465-f1a1-35d2-a822-72af109e1d2b",
                                                "text": "Near-synonym: let loose"
                                            },
                                            {
                                                "example_id": "47bde128-f0ed-40d7-835a-f3b72d4a85dc",
                                                "sense_id": "d9d20465-f1a1-35d2-a822-72af109e1d2b",
                                                "text": "She let rip with a tirade everyone heard."
                                            },
                                            {
                                                "example_id": "e7c9efa6-73d0-44ce-a745-9b3f0f9c1b13",
                                                "sense_id": "d9d20465-f1a1-35d2-a822-72af109e1d2b",
                                                "text": "She let rip about Mary’s flirting with Lizzie’s boyfriend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b92eb059-27f1-31f2-8efc-fb531ecb531c",
                                        "entry_id": "d84c11af-f0bd-3144-b314-85c56eb0fff8",
                                        "glosses": [
                                            "To fart."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "972ff927-a039-4df9-be61-53fcaf1208a3",
                                                "sense_id": "b92eb059-27f1-31f2-8efc-fb531ecb531c",
                                                "text": "I would also urge you never to let rip within 50 metres of your mother-in-law"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76fe1d99-5d0b-4b4b-9de6-ae96009ced69",
                        "source_entry_id": "db809bb5-ce30-3500-b241-81a7f5c215cf",
                        "source_sense_id": "91bb5a46-81f4-3d4b-8a98-71aaf5e840c0",
                        "target_lang_word": "let fly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "let fly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "186459a6-daec-3401-84e1-9f138932d8ac",
                                        "entry_id": "70ba38e5-f5ea-3e03-944e-5946f6b86385",
                                        "glosses": [
                                            "To strike or release a projectile with great force."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862b1af7-779a-4d1d-9313-fb051ddb8612",
                                                "sense_id": "186459a6-daec-3401-84e1-9f138932d8ac",
                                                "text": "One evening when it was barely even dusk a sentry let fly at me from a distance of twenty yards; but he missed me by a yard—goodness knows how many times the Spanish standard of marksmanship has saved my life."
                                            },
                                            {
                                                "example_id": "d811b781-accf-4442-9f36-8dc66e9b6db5",
                                                "sense_id": "186459a6-daec-3401-84e1-9f138932d8ac",
                                                "text": "Norwich were back on level terms through an equally stunning finish by Morison in the 53rd minute, the former Millwall player letting fly from the edge of the area after being teed-up by Leon Barnett."
                                            },
                                            {
                                                "example_id": "63522071-0be2-41e6-9055-b88cad44707a",
                                                "sense_id": "186459a6-daec-3401-84e1-9f138932d8ac",
                                                "text": "This time there was an English element as Ainsley Maitland-Niles let fly with cross-shot that fizzed to Nicolas Tagliafico at the far post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0a29e9-fb0f-3e0e-9022-b576fc2d1a69",
                                        "entry_id": "70ba38e5-f5ea-3e03-944e-5946f6b86385",
                                        "glosses": [
                                            "To unleash an angry outburst."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964bbf87-a035-49e3-ae99-bdf10f61bcc5",
                                                "sense_id": "0a0a29e9-fb0f-3e0e-9022-b576fc2d1a69",
                                                "text": "She was furious and let fly at him with a string of obscenities."
                                            },
                                            {
                                                "example_id": "db96a7d0-7b5c-4e37-84b1-68757d729d08",
                                                "sense_id": "0a0a29e9-fb0f-3e0e-9022-b576fc2d1a69",
                                                "text": "Rosemary peeled off Sloane Square, Hartnell, decorations-will-be-worn, fog primroses, crumpets by the fire, and let fly vulgarly at Vythilingam."
                                            },
                                            {
                                                "example_id": "55d1555b-bb87-4b91-a430-84f650201d28",
                                                "sense_id": "0a0a29e9-fb0f-3e0e-9022-b576fc2d1a69",
                                                "text": "Jammed onto a narrow, steep sidewalk, police barricades all around, we march with placards, drums, and angry spirit: \"The Moral Majority, cops and Klan. Work together hand in hand.\" — helmeted tac squad on horses, Hondas, facing us on Powell Street, itching to wield their billy clubs, waiting for any excuse to let fly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08327a13-29eb-4105-82ed-2c5fac5c01f0",
                        "source_entry_id": "db809bb5-ce30-3500-b241-81a7f5c215cf",
                        "source_sense_id": "91bb5a46-81f4-3d4b-8a98-71aaf5e840c0",
                        "target_lang_word": "cut up rough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut up rough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3adac812-e030-3b99-ad97-76f86dbe9d5e",
                                        "entry_id": "fcba10f2-49fd-3ffe-8262-82f215257235",
                                        "glosses": [
                                            "To become angry; to make a fuss."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fe2b19-ce9d-4fbb-bfc9-44ea61da522f",
                                                "sense_id": "3adac812-e030-3b99-ad97-76f86dbe9d5e",
                                                "text": "As anticipated, however, the Parlement cut up rough over a new stamp duty on public and printed documents […]"
                                            },
                                            {
                                                "example_id": "70bce94c-9f1b-4af3-8442-47193b4a3eea",
                                                "sense_id": "3adac812-e030-3b99-ad97-76f86dbe9d5e",
                                                "text": "Third, while there is no immediate risk of Greece being kicked out of the club, such a threat could materialise if German taxpayers were to cut up rough and exert real political pressure on Angela Merkel's government."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
