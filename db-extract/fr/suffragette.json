                                    {
                                        "sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                                        "entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                                        "glosses": [
                                            "działaczka walcząca o prawa wyborcze dla kobiet na przełomie XIX i XX wieku (głównie w krajach anglosaskich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe0b1e2-6f31-46a3-8ae8-b68ceaedce52",
                                                "sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                                                "text": "Po tym, jak angielska sufrażystka Emmeline Pankhurst poprowadziła marsz na parlament i wraz ze swoimi towarzyszkami stoczyła kilkugodzinną bitwę z policją, było wiadomo, że kobiety już nie ustąpią"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c982648-4911-415a-ba37-7b1696e5f31d",
                        "source_entry_id": "04efa7b5-4947-3aa2-baf5-e32b664b0da3",
                        "target_lang_word": "суфражистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "суфражистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "97343c57-9e3f-3ec9-8c32-432f9aac5368",
                                        "entry_id": "5b808534-1f33-3532-bf9e-3b72562f86a1",
                                        "glosses": [
                                            "истор. сторонница и участница суфражизма, то есть движения за предоставление женщинам избирательных прав, распространенное во второй половине XIX века"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f8f17f-cc60-44c1-ac18-e72fcf46411e",
                                                "sense_id": "97343c57-9e3f-3ec9-8c32-432f9aac5368",
                                                "text": "Арестовано 121 суфражистка, в том числе их вождь г-жа Пангаерст, которая заявила, что демонстрация произведена с целью «обратить внимание общества на беспомощное положение женщин»."
                                            },
                                            {
                                                "example_id": "52070017-e3e7-4a27-84e7-aaf1fa75bfd8",
                                                "sense_id": "97343c57-9e3f-3ec9-8c32-432f9aac5368",
                                                "text": "Такие слова под стать какой-нибудь суфражистке. А я-то полагал, что вы ветреная Коломбина, игрушка в руках злого Арлекина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ce3987-3c21-4895-a3b0-b0a06826c34f",
                        "source_entry_id": "04efa7b5-4947-3aa2-baf5-e32b664b0da3",
