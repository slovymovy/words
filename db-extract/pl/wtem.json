                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0c57e9f2-ede2-46c5-921e-da776fce9b3f",
                        "source_entry_id": "106e7ec8-3d6d-36af-a090-4147b63f33dc",
                        "source_sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
                        "source_sense_description": "plötzlich, auf einmal, unerwartet, überraschend",
