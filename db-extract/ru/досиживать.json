                ],
                "senses": [
                    {
                        "sense_id": "f5386868-5cd4-3abb-896a-3db93ba8732c",
                        "entry_id": "aa9730e8-65d6-337a-a6e6-f062312e168a",
                        "glosses": [
                            "пребывать где-либо до положенного срока, сидеть до окончания чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143291b4-0af7-4eec-b620-d16bdaaacea1",
                                "sense_id": "f5386868-5cd4-3abb-896a-3db93ba8732c",
                                "text": "Я знаю, что это стыдно; но в опере я сплю, а в Буффах досиживаю до последнего конца, и весело."
                            },
                            {
                                "example_id": "94f66036-9cfd-4ea7-9c57-01d96efa815c",
                                "sense_id": "f5386868-5cd4-3abb-896a-3db93ba8732c",
                                "text": "Часто досиживал до утра и со скукой шёл в совнархоз."
                            },
                            {
                                "example_id": "9ac85986-d758-458d-a9af-6dc5a6d6138f",
                                "sense_id": "f5386868-5cd4-3abb-896a-3db93ba8732c",
                                "text": "Тем не менее взяли Петра Антоновича Крылышкина и вытряхнули. ¶ А очень мне его жалко! Ну куда теперь денется старый специалист по иностранным языкам? Пущай бы досиживал!"
                            },
                            {
                                "example_id": "654bbca1-6cd6-4875-95c6-7b4dd900c841",
                                "sense_id": "f5386868-5cd4-3abb-896a-3db93ba8732c",
                                "text": "Здесь уже ничего не решают, а попросту досиживают последний рабочий день."
                            }
                        ]
                    }
                ],
