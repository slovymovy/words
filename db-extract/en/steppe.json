                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9527bb3-f1ab-300d-af00-62fe90994ab6",
                        "entry_id": "a02d937b-3686-3ddb-a7f9-42afafb5eeb2",
                        "glosses": [
                            "The grasslands of Eastern Europe and Asia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2aca866a-7128-491c-a001-1937c7cd5472",
                                "sense_id": "f9527bb3-f1ab-300d-af00-62fe90994ab6",
                                "text": "Nevertheless be it remarked, that even a Russian steppe has tumuli and gold ornaments […]"
                            },
                            {
                                "example_id": "cacd0d35-c2d8-4eda-b21e-785e3778e0f8",
                                "sense_id": "f9527bb3-f1ab-300d-af00-62fe90994ab6",
                                "text": "Enkidu was the hairy man of the wild steppes, and Gilgamesh was the hero of civilization; but now the contrast is between Gilgamesh, the king, the man of political power, the heroic man of action, the extrovert, and Utnapishtim, the man of religious authority, the introvert, the sage."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb074304-7a27-35dd-9afb-1a6be075938a",
                        "entry_id": "a02d937b-3686-3ddb-a7f9-42afafb5eeb2",
                        "glosses": [
                            "A vast, cold, dry, grassy plain."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e27da4a5-7060-40e5-bf26-dd9a89b1db66",
                                "sense_id": "bb074304-7a27-35dd-9afb-1a6be075938a",
                                "text": "Grasslands: The Steppe biome is a dry, cold, grassland that is found in all of the continents except Australia and Antarctica. It is mostly found in the USA, Mongolia, Siberia, Tibet and China. There isn't much humidity in the air because Steppe is located away from the ocean and close to mountain barriers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63329653-ce6a-4d2b-80b3-fa4f36d84ef9",
                        "source_entry_id": "a02d937b-3686-3ddb-a7f9-42afafb5eeb2",
                        "source_sense_description": "the grasslands of Eastern Europe and Asia",
                        "target_lang_word": "step",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "step",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "10a23bc8-9a67-3d9a-b0c8-6931d40ad00a",
                                        "entry_id": "2d143ffc-cd13-34a3-8a60-fcbb724dc155",
                                        "glosses": [
                                            "přírodní krajina porostlá trávou, bylinami a nízkými křovinami v polosuchých oblastech"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815ab80e-8b60-4a01-8bcd-e27600a6a6d7",
                                                "sense_id": "10a23bc8-9a67-3d9a-b0c8-6931d40ad00a",
                                                "text": "Ruští zemědělci rozorali velké plochy stepi, ale takto vzniklá pole se brzy vyčerpala a pak už plodila jen málo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "step",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e19c1bf6-a0a2-352c-b1c0-ead84d49db10",
                                        "entry_id": "574d00e2-b1b2-371d-9e46-58792f22452f",
                                        "glosses": [
                                            "tanec, při němž se rytmus vyklepává podrážkami bot o parket"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f6a52e3-944b-433a-8e4b-11e449b00a7b",
                        "source_entry_id": "a02d937b-3686-3ddb-a7f9-42afafb5eeb2",
                        "source_sense_description": "the grasslands of Eastern Europe and Asia",
                        "target_lang_word": "steppe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steppe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e063b424-2686-317a-a6fc-e798cab24eab",
                                        "entry_id": "12e42296-5f5b-33d3-b7f2-274a6964cb9b",
                                        "glosses": [
                                            "Vaste plaines couvertes de buissons, de pâturages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14c42cd-39ef-4a38-adcf-c6e783f02788",
                                                "sense_id": "e063b424-2686-317a-a6fc-e798cab24eab",
                                                "text": "J’avais à peine jeté les yeux sur ces beaux steppes sauvages où tu bondis, et je ne te parlerai point de quelques larmes essuyées en te lisant ; mais le regret n’est pas le remords, quoiqu’il en soit un peu germain."
                                            },
                                            {
                                                "example_id": "1a8d8630-f04b-4e73-bbab-9bf842632b54",
                                                "sense_id": "e063b424-2686-317a-a6fc-e798cab24eab",
                                                "text": "On pouvait alors déterminer la marche des races dites rouges. Parti des steppes mongoles, un courant humain déferlait en Sibérie, gagnait l’Alaska, envahissait peu à peu l’Amérique du Nord."
                                            },
                                            {
                                                "example_id": "04f8247c-f63f-41df-85bf-ba859c480bc7",
                                                "sense_id": "e063b424-2686-317a-a6fc-e798cab24eab",
                                                "text": "Entre les hauts-plateaux et les massifs montagneux de l’intérieur et le sahel côtier, où les steppes de palmiers nains alternaient avec de vastes maquis de lentisques, de jujubiers, de myrtes et de genêts, les plaines subatlantiques déployaient leur immense paillasson poussiéreux, […]."
                                            },
                                            {
                                                "example_id": "6dd1040d-ce17-4d1b-b235-87b7440247c6",
                                                "sense_id": "e063b424-2686-317a-a6fc-e798cab24eab",
                                                "text": "— Oui, telle est la steppe, mère du bouzkachi. Seule, de toutes les terres sous le soleil, elle a le ventre assez large pour porter et nourrir ses hommes et ses bêtes."
                                            },
                                            {
                                                "example_id": "2d342331-78c9-4c87-9201-fbde6260aeb3",
                                                "sense_id": "e063b424-2686-317a-a6fc-e798cab24eab",
                                                "text": "Le désert de Gobi et les zones de steppes sont des régions particulièrement piégeuses – en dehors des grands itinéraires, il n’y a parfois aucune route entre deux destinations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
