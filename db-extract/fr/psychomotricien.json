                    {
                        "sense_id": "ae26f55f-054c-3437-a176-e66459bbbd0f",
                        "entry_id": "3f524de6-e9e9-32ad-a860-04f5583cf965",
                        "glosses": [
                            "Professionnel qui soigne les troubles physiques d’origine psychologique de ses patients."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4838d630-3675-4239-96be-792b9ce4f17d",
                                "sense_id": "ae26f55f-054c-3437-a176-e66459bbbd0f",
                                "text": "Le psychomotricien vise à rééduquer le patient confronté à des difficultés psychologiques vécues et exprimées corporellement, en agissant sur ses fonctions psychomotrices, notamment au moyen de techniques de relaxation dynamique, d’éducation gestuelle, d’expression corporelle ou plastique et par des activités rythmiques, de jeu d’équilibration et de coordination."
                            }
                        ]
                    }
