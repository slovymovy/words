                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Er war von einer diffusen Angst befallen."
                                            },
                                            {
                                                "example_id": "8f077a84-410e-4f8c-9dfe-b254003c7891",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Er hat nur eine diffuse Vorstellung davon, was ein Kunststudium mit sich bringt."
                                            },
                                            {
                                                "example_id": "803a7880-5463-4da1-ac5c-a651f1f19ad8",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Die Patientin klagte über diffuse Schmerzen im Oberbauch."
                                            },
                                            {
                                                "example_id": "2b958d55-68d9-473e-b973-9781b5456a2d",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Die beiden wollen nach Afrika, haben aber zur Zeit erst recht diffuse Pläne, was sie da eigentlich genau sehen wollen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8310172d-9853-3291-880b-a4807fed1fd0",
                                        "entry_id": "6ceb018f-5082-3ffe-b25a-b44ca6884793",
                                        "glosses": [
                                            "zerstreut; unscharf, schwer abgrenzbar"
