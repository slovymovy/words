                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ed64d2-4795-4ceb-bc9b-86b9d0737e4a",
                                "sense_id": "212e2965-f1da-378d-ad20-0e8ac334a744",
                                "text": "Ростов, вернувшись домой, испытал приятное чувство после некоторого промежутка времени примеривания себя к старым условиям жизни."
                            },
                            {
                                "example_id": "92520d2c-7ed0-4610-b4df-94ba0103f3ad",
                                "sense_id": "212e2965-f1da-378d-ad20-0e8ac334a744",
                                "text": "Началось шитье и примеривание костюмов, повторение разных поз."
                            }
                        ]
                    }
