                        "entry_id": "c5531fa5-fc45-381d-bbaf-c620b5219dbc",
                        "glosses": [
                            "van iets dat je het (met moeite) kunt accepteren terwijl je er eigenlijk bezwaren tegen hebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "364136d6-922f-4216-ac10-a866eea6707d",
                                "sense_id": "3f1671c1-ce73-3b6f-a95c-eb28af6be51b",
                                "text": "Het doet zoo goed indien wij wat ons vroeger driftig maakte, nú, niet verdrááglijk, maar bepaald líef vinden."
                            },
                            {
                                "example_id": "03604b0d-aabe-4f9d-aef4-4e2071e0ecc9",
                                "sense_id": "3f1671c1-ce73-3b6f-a95c-eb28af6be51b",
                                "text": "De rook, dat zijn de handen die je naar hoogten dragen vanwaar bijna alles verdraaglijk is."
                            }
                        ]
                    }
                ],
