                "senses": [
                    {
                        "sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "glosses": [
                            "osoba współpracująca z nieakceptowaną przez daną społeczność władzą, zwłaszcza okupacyjną"
                        ],
                        "tags": [
                            "literary",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8bdcdf7e-0b8e-47bd-ba8e-83d17c41596b",
                                "sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                                "text": "16 stycznia oddział AK „Kurniawa” dowodzony przez Tadeusza Studzińskiego niemal oficjalnie przemaszerował przez Kościeliską i na Krzeptówkach powiesił otoczonego złą sławą góralskiego kolaboranta…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "254536f0-2ce0-4a5a-a772-1e4d57680644",
                        "source_entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "source_sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "target_lang_word": "collaborator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collaborator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f07f11a1-fd25-3307-b497-d7ef7fdf50e7",
                                        "entry_id": "eb0da43a-1ef7-3f1b-8d36-36ed9ef50f9f",
                                        "glosses": [
                                            "A person who works with others towards a common goal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dec236e4-0320-3cfe-830c-c5d9051fa18f",
                                        "entry_id": "eb0da43a-1ef7-3f1b-8d36-36ed9ef50f9f",
                                        "glosses": [
                                            "A person who cooperates traitorously with an enemy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fda1f941-c6f2-4cf1-b2a5-458ddec96322",
                        "source_entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "source_sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "target_lang_word": "quisling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quisling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0752f64-8097-3506-b242-56c875bc5b8b",
                                        "entry_id": "aed9f724-9512-3911-b77e-08c8c7ea2434",
                                        "glosses": [
                                            "A traitor who collaborates with the enemy."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5be1294f-a0d1-4730-a4cd-99334069cc65",
                                                "sense_id": "e0752f64-8097-3506-b242-56c875bc5b8b",
                                                "text": "In many countries, including some where the Jews were neither numerically strong nor in possession of important posts, these envoys of the German Secret Service have been able, solely by the use of anti-Jewish slogans, to create those \"national\" Fascist movements from which Quislings are bred."
                                            },
                                            {
                                                "example_id": "e11a6396-2cdd-4d7a-9815-ab7285e08c8c",
                                                "sense_id": "e0752f64-8097-3506-b242-56c875bc5b8b",
                                                "text": "If, in the nation about to be attacked, influential persons were discovered who could be bribed or corrupted, German agents made use of these quislings."
                                            },
                                            {
                                                "example_id": "a0cb2b67-f72b-443a-80b4-d5f2591f9e7e",
                                                "sense_id": "e0752f64-8097-3506-b242-56c875bc5b8b",
                                                "text": "It is time to clear out the quislings and paid flunkies of city hall and big business."
                                            },
                                            {
                                                "example_id": "2dfdab71-8600-459b-a827-1615656e5b14",
                                                "sense_id": "e0752f64-8097-3506-b242-56c875bc5b8b",
                                                "text": "The man she cherishes, the man she butterfly-kisses, the man she sleeps curved around like two spoons in a drawer. It is he who is evil, he who is sworn to destroy her, an emotional quisling of the first water."
                                            },
                                            {
                                                "example_id": "4846d99d-6e1e-4bc3-bcdf-2364306de7c3",
                                                "sense_id": "e0752f64-8097-3506-b242-56c875bc5b8b",
                                                "text": "He sees off an attack from humans, who have as servants certain quisling apes, former followers of Caesar’s traitorous ex-comrade Koba (a motion-capture performance from Toby Kebbell)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quisling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68f255ae-eb4e-3a99-beaa-3dd7f5c54491",
                                        "entry_id": "37ba29b1-cfae-32e0-af0e-35ead3b73bfc",
                                        "glosses": [
                                            "present participle and gerund of quisle"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b6602f7-d95a-4a3f-a0ec-dc16b64bed3e",
                        "source_entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "source_sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "target_lang_word": "collaborateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collaborateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5537288b-5abb-32ed-b277-98f5a9149f84",
                                        "entry_id": "4fb45269-a756-359f-90b9-d5b12886be47",
                                        "glosses": [
                                            "Celui qui travaille de concert avec un ou plusieurs autres à une œuvre commune."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff0d004e-3730-4c92-ab27-c705cfc69821",
                                                "sense_id": "5537288b-5abb-32ed-b277-98f5a9149f84",
                                                "text": "Mais tout de même, procréer à son âge lui paraissait louche et, bien qu’un tel résultat flattât sa vanité de vieux coq, la crainte d’avoir été aidé dans cette œuvre par des collaborateurs bénévoles autant qu’inconnus le retenait hésitant au bord du fossé conjugal."
                                            },
                                            {
                                                "example_id": "e2637b96-fdef-4d0b-8d28-108c241831bb",
                                                "sense_id": "5537288b-5abb-32ed-b277-98f5a9149f84",
                                                "text": "Le venin distillé par Drumont et ses collaborateurs fut recueilli par le quotidien royaliste, l’Action Française. Les dirigeants du mouvement néo-royaliste ne se contentèrent pas de rééditer, à leur compte, les mensonges et les faux de la Libre Parole."
                                            },
                                            {
                                                "example_id": "a481ce12-cf27-43de-8908-ab9f4b699a22",
                                                "sense_id": "5537288b-5abb-32ed-b277-98f5a9149f84",
                                                "text": "Marchand avait coutume de ne jamais donner d’instructions détaillées à ses collaborateurs, se bornant à leur préciser l’orientation qu’il souhaitait les voir adopter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9fe8b0-88c6-3961-b0e7-8441432be676",
                                        "entry_id": "4fb45269-a756-359f-90b9-d5b12886be47",
                                        "glosses": [
                                            "Employé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd91ca1-7293-4c90-8fe4-bc45594c26bc",
                                                "sense_id": "bd9fe8b0-88c6-3961-b0e7-8441432be676",
                                                "text": "Nous recrutons 2000 collaborateurs chaque année."
                                            },
                                            {
                                                "example_id": "f962a644-8c0e-47c8-bbbd-000bb48e55f8",
                                                "sense_id": "bd9fe8b0-88c6-3961-b0e7-8441432be676",
                                                "text": "Au bout d'un peu plus d'une heure, Alain Juppé, désormais Premier ministre, raccompagne Édouard Balladur, salué dans la cour de Matignon par ses collaborateurs rangés en une haie serrée."
                                            },
                                            {
                                                "example_id": "ff5f0545-5cc2-4d68-b066-345c925f7abc",
                                                "sense_id": "bd9fe8b0-88c6-3961-b0e7-8441432be676",
                                                "text": "… certaines entreprises réservent même des moments dédiés à l'écoute des émotions des « collaborateurs », terme galvaudé se substituant de plus en plus dans ces multinationales « progressistes » à celui d'« employés », probablement pour faire croire à une absence de hiérarchie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49ea61e1-1ade-34d4-925a-a1a5ccb730a9",
                                        "entry_id": "4fb45269-a756-359f-90b9-d5b12886be47",
                                        "glosses": [
                                            "Nom donné, pendant la Seconde Guerre mondiale, aux citoyens des pays occupés qui montraient de la complaisance envers l’occupant ou travaillaient en collaboration avec lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f379532-af14-43d6-83b9-583e9ede2f93",
                                                "sense_id": "49ea61e1-1ade-34d4-925a-a1a5ccb730a9",
                                                "text": "Je me rappelle maintenant qu’il n’était pas antisoviétique, non, d’ailleurs en général, ce n’est pas possible que ce couple soit collaborateur ; s’il l’était, il ne serait pas ici, mais à Paris, ou à Vichy."
                                            },
                                            {
                                                "example_id": "202eecab-aa3f-4d2f-8c55-3591bc35d45f",
                                                "sense_id": "49ea61e1-1ade-34d4-925a-a1a5ccb730a9",
                                                "text": "Venir chercher un collaborateur chez un résistant comme moi, vous avouerez."
                                            },
                                            {
                                                "example_id": "045d12fc-5571-4f73-8a0e-12c2c10b4fa3",
                                                "sense_id": "49ea61e1-1ade-34d4-925a-a1a5ccb730a9",
                                                "text": "En septembre de la même année, Ange avait intégré l’équipe spéciale interrégionale basée à Montpellier, une unité chargée — entre autres — d’éliminer officiers allemands et collaborateurs français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1ba3ef7-d5ca-343b-b6db-c1d5c6811887",
                                        "entry_id": "4fb45269-a756-359f-90b9-d5b12886be47",
                                        "glosses": [
                                            "Celui qui travaille avec un ennemi."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7df831b-908e-42cc-8980-f45473742034",
                                                "sense_id": "d1ba3ef7-d5ca-343b-b6db-c1d5c6811887",
                                                "text": "Nous ? On accueille les collabos à bras ouverts ? Va donc dire ça aux lecteurs du Figaro, ça les déridera un peu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3af6c53-dc9e-42cc-b34f-5a17cdf35b3e",
                        "source_entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "source_sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "target_lang_word": "Kollaborateur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kollaborateur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                        "entry_id": "f9b0457a-3589-3097-b486-74ed0618513d",
                                        "glosses": [
                                            "jemand, der mit dem Feind zusammenarbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96ad25d-f654-4598-8b05-d01fafa8e4e3",
                                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                                "text": "„Die Schwäche der Kollaborateure wurde offenkundig, als Arminius und Flavus im Jahre 16 bei einem Kriegszug an der Weser einander gegenüberstanden.“"
                                            },
                                            {
                                                "example_id": "4d3de332-3b22-448b-b21f-dcf4069e2ec9",
                                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                                "text": "„Aus diesem Grund fällt der Populismus in jener Region auf fruchtbaren Boden, und als in Deutschland Hitlers Regime aufkommt, rekrutieren sich unter den Bewohnern Hindenburgs zahlreiche Kollaborateure.“"
                                            },
                                            {
                                                "example_id": "a18fdb99-e774-41e8-a79e-8ebf9cbaf180",
                                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                                "text": "„Es gab zu viele weithin sichtbare Kollaborateure.“"
                                            },
                                            {
                                                "example_id": "6bfae024-0bdf-4c04-8146-97cf7df8badd",
                                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                                "text": "„Später, nach dem Einmarsch der Aliierten, nahmen die Verfolgten und auch viele normale Franzosen ihre Rache, es gab eine regelrechte Jagd auf Kollaborateure.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32cdca8c-6d68-434c-8f6d-62d6af515f0c",
                        "source_entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "source_sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "target_lang_word": "Quisling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quisling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e906e206-1422-3e29-ae10-5c554bd1b93d",
                                        "entry_id": "fb43ddca-6444-39d9-ac87-4ba821158766",
                                        "glosses": [
                                            "Person, die mit dem Feind kollaboriert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0eaa62-864a-499e-a6d9-1ca174c37213",
                                                "sense_id": "e906e206-1422-3e29-ae10-5c554bd1b93d",
                                                "text": "„In Norwegen fand sich Lassehn in eine feindselige Umgebung versetzt, es fielen zwar keine Schüsse, und es gab keinen Kampf, denn der unterirdische Widerstand der Norweger war Sache der Gestapo und ihrer Quislinge, aber Lassehn war, obwohl dem Heere des Siegers zugehörig, in Wahrheit der Gedemütigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcd66390-dd5c-4778-ab6b-006b693b09cc",
                        "source_entry_id": "70898e7f-3dee-38b8-80de-fa569e69d436",
                        "source_sense_id": "e29dc36a-b586-3730-ab30-7fdd856e69fc",
                        "target_lang_word": "коллаборационист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коллаборационист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8172b8-970f-3f14-898d-a5a66beb9cf2",
                                        "entry_id": "f786b9bf-1237-300f-a75e-ee7e3ec6eb08",
                                        "glosses": [
                                            "полит. тот, кто сотрудничает с оккупационными властями, идёт на службу к врагу на территории собственной страны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52087269-7d93-4456-8526-24208b0eb613",
                                                "sense_id": "8d8172b8-970f-3f14-898d-a5a66beb9cf2",
                                                "text": "Но если ваш прадедушка «враждебный» ― например, был коллаборационистом и помогал японцам, ― то вас даже в армию не возьмут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f0334d-e34c-3891-9e6c-d0d661605e1f",
                                        "entry_id": "f786b9bf-1237-300f-a75e-ee7e3ec6eb08",
                                        "glosses": [
                                            "перен., неодобр. изменник, предатель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca4daf5-b24c-46d3-929a-6604791582fd",
                                                "sense_id": "b8f0334d-e34c-3891-9e6c-d0d661605e1f",
                                                "text": "Меня, вдумчивого принца-аналитика, любовно перебиравшего души своих людей, меня ― снизу ― сочли штрейкбрехером и коллаборационистом, а сверху ― лоботрясом с неуравновешенной психикой."
                                            }
                                        ]
                                    }
                                ]
                            }
