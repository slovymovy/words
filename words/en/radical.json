                },
                {
                    "sense_id": "c7afef3a-bfd7-330a-b25b-aa1c3b83f7d7",
                    "sense_definition": "Relating to the mathematical root of a number or quantity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained how to simplify a <w>radical</w> expression in algebra class.",
                            "target_lang_translations": {
