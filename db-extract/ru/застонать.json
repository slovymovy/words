                                        "glosses": [
                                            "plötzlich, kurz, deutlich hörbar ein unartikuliertes (stöhnendes) Geräusch von sich geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8fe0cb-1bdf-423e-b544-fec987f71692",
                                                "sense_id": "67526f77-8016-37f9-b632-05b6cbe3a2fa",
                                                "text": "Als die Schwester den Verband entfernt, stöhnt sie leise auf."
                                            },
                                            {
                                                "example_id": "ba58adb6-1009-42c1-a419-bfe14bf5132b",
                                                "sense_id": "67526f77-8016-37f9-b632-05b6cbe3a2fa",
                                                "text": "Das Publikum stöhnte auf, als der Ball im Aus landete."
                                            },
                                            {
                                                "example_id": "731cef69-d549-4a39-8fba-101e0c5fd8e0",
                                                "sense_id": "67526f77-8016-37f9-b632-05b6cbe3a2fa",
                                                "text": "Bei den Garagen sehe ich sein Taschenlampenlicht leuchten und will schon erleichtert aufstöhnen, weil er in die andere Richtung läuft, als der Lichtkegel wieder zu mir herüberschwenkt."
                                            }
                                        ],
