                        "examples": [
                            {
                                "example_id": "4490d2c1-b914-410b-82a8-4c0f6f6f9fe5",
                                "sense_id": "c4d84249-d2f3-3743-9af6-622492dea525",
                                "text": "„Einen Dienerjungen schickte er aus, die Schauspielertruppe der mit dem Kaiserhause verwandten Familie Wang zu bestellen.“"
                            },
                            {
                                "example_id": "c378c1a1-700d-40b2-bca1-cedcfc1f3587",
                                "sense_id": "c4d84249-d2f3-3743-9af6-622492dea525",
                                "text": "„Sobald ich bekanntgegeben hatte, daß ich gekommen wäre, um eine Schauspielertruppe für Korfu zu besorgen, erschienen die Direktoren der beiden Truppen, die damals sich in Otranto befanden. “"
                            }
                        ],
