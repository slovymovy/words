            {
                "entry_id": "4adf461e-afc1-3a5b-9111-c40d82d2aff8",
                "word": "twill",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0a11e571-fa56-4662-97e6-582df7468783",
                        "entry_id": "4adf461e-afc1-3a5b-9111-c40d82d2aff8",
                        "tags": [
                            "plural"
                        ],
                        "form": "twills"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e419aec6-f1a8-3913-acbc-4428642b65df",
                        "entry_id": "4adf461e-afc1-3a5b-9111-c40d82d2aff8",
                        "glosses": [
                            "A pattern, characterised by diagonal ridges, created by the regular interlacing of threads of the warp and weft during weaving."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "085abc8d-36ff-4205-899a-1a825b3db17d",
                                "sense_id": "e419aec6-f1a8-3913-acbc-4428642b65df",
                                "text": "The twill weave is always given a direction; a right-hand twill is one in which the twill line runs from bottom left to top right and a left-hand twill is one in which the twill line runs from bottom right to top left. The angle of the twill is determined by the amount of shift in the points of interlacing."
                            },
                            {
                                "example_id": "6597502b-6b23-453c-9a80-2323f708328a",
                                "sense_id": "e419aec6-f1a8-3913-acbc-4428642b65df",
                                "text": "Industrial uses of twill fabrics are mainly restricted to simple twills and only simple twills are described here. Broken twills, waved twills, herringbone twills and elongated twills are extensively used for suiting and dress fabrics."
                            },
                            {
                                "example_id": "7ca2ca53-4725-45d8-87af-05c432b0e061",
                                "sense_id": "e419aec6-f1a8-3913-acbc-4428642b65df",
                                "text": "Herringbone fabrics are a twill variation having the twill line reversed at regular intervals."
                            }
                        ]
                    },
                    {
                        "sense_id": "0897d4a4-049a-38b7-8afd-ee74c2cb0e11",
                        "entry_id": "4adf461e-afc1-3a5b-9111-c40d82d2aff8",
                        "glosses": [
                            "A cloth or portion of cloth woven in such a pattern."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b76c60a9-fb00-4491-af78-40543170292f",
                                "sense_id": "0897d4a4-049a-38b7-8afd-ee74c2cb0e11",
                                "text": "Plain cotton twills, such as canvas, sailcloth, and denim, in mediumweight fabrics, can be a good choice for informal rooms that receive considerable wear and tear, such as rec rooms, dens, playrooms, or children's bedrooms."
                            }
                        ]
                    }
                ],
