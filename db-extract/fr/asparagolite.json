                        ],
                        "examples": [
                            {
                                "example_id": "d3667dd9-6033-4296-a227-1a73aa2559bf",
                                "sense_id": "caba99bf-24e7-3844-87ba-8bf23543fa71",
                                "text": "La variété bleue a été désignée sous le nom d’agustite ; la variété verte a été appelée pierre d’asperge, asparagolite ; enfin les variétés de diverses couleurs se présentant sous la forme guttulaire ont reçu le nom de moroxite."
                            },
                            {
                                "example_id": "9dc9f62e-d837-4660-9320-99327aa0e757",
                                "sense_id": "caba99bf-24e7-3844-87ba-8bf23543fa71",
                                "text": "Il consiste en un épanchement de trachytes contenant des petits cristaux d’asparagolite ou apatite."
                            }
                        ]
                    }
