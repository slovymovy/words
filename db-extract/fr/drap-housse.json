                    {
                        "sense_id": "354afef5-c4e2-395a-bbe9-5fea4940cd59",
                        "entry_id": "dfab212c-9884-3bbb-bcd6-7f8854761e60",
                        "glosses": [
                            "Drap dont les coins sont munis d’élastiques qui enveloppe un matelas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be48e2fe-cfd1-4d70-9a26-d92b936e5ce9",
                                "sense_id": "354afef5-c4e2-395a-bbe9-5fea4940cd59",
                                "text": "Les femmes se ménageaient des apartés sur des questions domestiques – le pliage des draps-housses, l’usure des jeans au genoux, le détachage du vin sur la nappe avec du sel – dans une conversation dont les hommes gardaient le monopole des sujets."
                            },
                            {
                                "example_id": "de872307-4b05-4ea9-9f7d-cd9f917498cf",
                                "sense_id": "354afef5-c4e2-395a-bbe9-5fea4940cd59",
                                "text": "J’atterris avec douceur, près de son visage, sur son drap-housse en soie."
                            }
                        ]
                    }
                ],
