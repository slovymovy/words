                    "sense_definition": "iets dat verloren was opnieuw vinden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herontdekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had gelukkig zijn trouwring <w>teruggevonden</w>.",
                            "target_lang_translations": {
                                "en": "Fortunately, he had <w>found</w> his wedding ring <w>again</w>.",
                                "ru": "К счастью, он <w>нашел</w> свое обручальное кольцо."
                            }
                        },
                        {
                            "text": "Ik hoop dat je jouw sleutels snel zult <w>terugvinden</w>.",
                            "target_lang_translations": {
                                "en": "I hope you will <w>find</w> your keys <w>back</w> soon.",
                                "ru": "Я надеюсь, что ты скоро <w>найдешь</w> свои ключи."
                            }
                        }
                    ],
                    "synonyms": [
