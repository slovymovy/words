                    {
                        "sense_id": "260d0a94-0d8f-39ce-90d2-97a3f9eed654",
                        "entry_id": "dc518498-f8bd-34f6-a399-7696c8d724f3",
                        "glosses": [
                            "członek jednego ze spokrewnionych etnicznie ludów zamieszkujących Azję południowo-zachodnią (Bliski Wschód) i północną Afrykę, tj. Arabów, Aramejczyków, Babilończyków, Kartagińczyków, Etiopczyków, Hebrajczyków i Fenicjan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ee1c62-05b6-4ef1-8709-1da55e0cedd7",
                                "sense_id": "260d0a94-0d8f-39ce-90d2-97a3f9eed654",
                                "text": "Zarówno Żydzi jak i Arabowie są Semitami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
