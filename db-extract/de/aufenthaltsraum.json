                                                "sense_id": "251d2fc9-2e97-3110-8fcf-1ebb4b247919",
                                                "text": "Holonyms: house, home, residence, dwelling"
                                            },
                                            {
                                                "example_id": "ea6f6307-dcc1-4930-8914-2e100f266927",
                                                "sense_id": "251d2fc9-2e97-3110-8fcf-1ebb4b247919",
                                                "text": "Near-synonyms: den, family room"
                                            },
                                            {
                                                "example_id": "1e7ad3d0-5730-4415-8a92-fa086094edde",
                                                "sense_id": "251d2fc9-2e97-3110-8fcf-1ebb4b247919",
                                                "text": "The recreation room. One of the broadcast receivers which are provided at all L.M.S.R. trainmen's hostels is seen in the background."
                                            }
