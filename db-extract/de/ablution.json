                                        "entry_id": "854b7abe-170f-3fd5-8a30-9689840150b7",
                                        "glosses": [
                                            "The act of washing something.",
                                            "Originally, the purifying of oils and other substances by emulsification with hot water; now more generally, a thorough cleansing of a precipitate or other non-dissolved substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd98f70d-82ce-3749-b1ca-ef7bf48053da",
                                        "entry_id": "854b7abe-170f-3fd5-8a30-9689840150b7",
                                        "glosses": [
                                            "The act of washing something.",
                                            "The act of washing or cleansing the body, or some part of it, as a religious rite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f799550-5240-4905-bda3-3b38437a5a67",
                                                "sense_id": "bd98f70d-82ce-3749-b1ca-ef7bf48053da",
                                                "text": "Let water be brought to perform my ablutions, and let the pious Fakreddin be called to offer up his prayers with mine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80dc127e-ed48-38d0-86f5-d8289ed5cfc1",
                                        "entry_id": "854b7abe-170f-3fd5-8a30-9689840150b7",
                                        "glosses": [
                                            "The act of washing something.",
                                            "Washing oneself; bathing, cleaning oneself up."
                                        ],
                                        "tags": [
                                            "countable",
                                            "humorous",
                                            "literary",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1420e710-3f8a-448d-b759-741cfdec63a7",
                                                "sense_id": "80dc127e-ed48-38d0-86f5-d8289ed5cfc1",
                                                "text": "He followed the steps of Bella, who soon conducted him to his chamber, and left him to those ablutions which a long ride along a sandy road had rendered particularly necessary."
                                            },
                                            {
                                                "example_id": "128140d7-c035-481a-b164-4e54d040eb14",
                                                "sense_id": "80dc127e-ed48-38d0-86f5-d8289ed5cfc1",
                                                "text": "She treats him not as a doddering old fool but as a man hampered in his movements by injury. Patiently, without baby-talk, she helps him through his ablutions."
                                            },
                                            {
                                                "example_id": "cfb10ef2-2840-42e2-a91c-c6da7d84b19d",
                                                "sense_id": "80dc127e-ed48-38d0-86f5-d8289ed5cfc1",
                                                "text": "There are now indications that it has caused some Americans to become more spartan when it comes to ablutions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ad3976c-7b5a-3ad6-978b-b49151482d35",
                                        "entry_id": "854b7abe-170f-3fd5-8a30-9689840150b7",
                                        "glosses": [
                                            "The act of washing something.",
                                            "The rinsing of the priest's hand and the sacred vessel following the Communion with, depending on rite, water or a mix of it and wine, which may then be drunk by the priest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4af6817-d13d-3e57-af7b-f7d2f1be3f7a",
                                        "entry_id": "854b7abe-170f-3fd5-8a30-9689840150b7",
                                        "glosses": [
                                            "The act of washing something.",
                                            "wudu, ritual washing of the limbs and head performed immediately before prayer or holding the Quran"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ede8815c-10cf-361a-9761-1698fe3e2789",
                                        "entry_id": "854b7abe-170f-3fd5-8a30-9689840150b7",
                                        "glosses": [
                                            "The liquid used in the cleansing or ablution."
                                        ],
                                        "tags": [
                                            "countable",
