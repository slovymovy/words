                ],
                "senses": [
                    {
                        "sense_id": "80b53336-583f-301c-a5a4-db61e8f022e6",
                        "entry_id": "30b9d4d7-8450-3e39-89e4-370c12cdf646",
                        "glosses": [
                            "stout, ondeugend en grappig op een leuke manier vooral van kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d52ed18-d499-40af-b83f-724f99dc1a1e",
                                "sense_id": "80b53336-583f-301c-a5a4-db61e8f022e6",
                                "text": "‘Het gaat dan hopelijk toch wel een beetje plezanter worden dan de miserie waarover u meestal schrijft?’, vroeg een kloeke dame op schalkse toon."
                            },
                            {
                                "example_id": "1c3a4649-6479-47b3-9058-494915a7eb90",
                                "sense_id": "80b53336-583f-301c-a5a4-db61e8f022e6",
                                "text": "Hij heeft een minuscuul gitaartje in zijn handen waarmee hij doet alsof hij de eerste akkoorden uit Love Me Tender speelt. 'That's really this guitar doing that', zegt hij met een schalks lachje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1a3182a-8f90-4638-b482-bd2b39578282",
                        "source_entry_id": "30b9d4d7-8450-3e39-89e4-370c12cdf646",
                        "source_sense_id": "80b53336-583f-301c-a5a4-db61e8f022e6",
                        "source_sense_description": "ondeugend",
                        "target_lang_word": "rascally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rascally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22630d21-e3e8-34bb-a43c-e5ae1e2a6185",
                                        "entry_id": "063d9e51-0bf1-3ec8-8660-46280fa9d63c",
                                        "glosses": [
                                            "Like a rascal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1265938a-8822-4663-8a78-e931eda5a993",
                                                "sense_id": "22630d21-e3e8-34bb-a43c-e5ae1e2a6185",
                                                "text": "He was speedily reassured, and with a large, white, rascally grin, and a glance at his charge, seemed to take me into partnership in his exalted trust."
                                            },
                                            {
                                                "example_id": "6e8ff5b0-d885-4c31-a9e4-4a66c6397c9d",
                                                "sense_id": "22630d21-e3e8-34bb-a43c-e5ae1e2a6185",
                                                "text": "My chief creditor is, unhappily, my most bitter enemy—a rascally fellow, Sam Brewer, whom I was once compelled to horse-whip on Newmarket Heath."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rascally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4f6ccb-ddd4-33e3-9595-ae95e4902061",
                                        "entry_id": "bcb540c0-0844-3feb-b1b5-8958d0622533",
                                        "glosses": [
                                            "In the manner of a rascal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80cfb114-efec-4252-8802-6e2a501cfa4d",
                                                "sense_id": "3e4f6ccb-ddd4-33e3-9595-ae95e4902061",
                                                "text": "“I hope,” said Jones, “you don’t intend to leave me in this condition.” “Indeed but I shall,” said the other. “Then,” said Jones, “you have used me rascally, and I will not pay you a farthing.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
