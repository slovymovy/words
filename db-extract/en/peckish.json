                                        "sense_id": "c282d2cb-3ab9-30e0-a6cf-8f7010421dfc",
                                        "entry_id": "de5f6141-12b9-3f30-b602-d47975890297",
                                        "glosses": [
                                            "ein Gefühl des Hungers verspürend, Hunger habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb53c08-eeec-4246-8741-50b8535431de",
                                                "sense_id": "c282d2cb-3ab9-30e0-a6cf-8f7010421dfc",
                                                "text": "Ich bin hungrig."
                                            },
                                            {
                                                "example_id": "666071af-b85c-4ad3-958d-e441a21dff1d",
                                                "sense_id": "c282d2cb-3ab9-30e0-a6cf-8f7010421dfc",
                                                "text": "„Denn ich war hungrig und ihr habt mir zu essen gegeben; …“"
                                            },
                                            {
                                                "example_id": "e2ec84c6-90a4-48b2-bc6b-2dbcebf77ba5",
                                                "sense_id": "c282d2cb-3ab9-30e0-a6cf-8f7010421dfc",
                                                "text": "„Dieses Phänomen ist im letzten Jahr entstanden: [Griechische] Kinder gehen hungrig in die Schule und wollen dann dem Unterricht beiwohnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98341abd-4e6f-3d24-ad91-b66bd5c3b6c5",
                                        "entry_id": "de5f6141-12b9-3f30-b602-d47975890297",
                                        "glosses": [
                                            "Lust auf ein bestimmtes Lebensmittel verspürend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c7ed12-1606-4f61-b393-00cf2908c53f",
                                                "sense_id": "98341abd-4e6f-3d24-ad91-b66bd5c3b6c5",
                                                "text": "„Auf dem Küchenherd des Lehrerhauses hatte ein Topf mit Honig gestanden, und sie, hungrig nach Süßigkeiten, hatte ihren Finger hineingesteckt und davon gekostet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0114f1b8-e0c2-3d26-b15d-30b0aef1995c",
                                        "entry_id": "de5f6141-12b9-3f30-b602-d47975890297",
                                        "glosses": [
                                            "ein (großes) Verlangen nach etwas habend"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b588c1e-3584-427f-bca2-8ada1316f75d",
                                                "sense_id": "0114f1b8-e0c2-3d26-b15d-30b0aef1995c",
                                                "text": "Sie sind hungrig auf alles Neue."
                                            },
                                            {
                                                "example_id": "b6562a2a-3135-4c32-aa55-91bf6f6d074b",
                                                "sense_id": "0114f1b8-e0c2-3d26-b15d-30b0aef1995c",
                                                "text": "„Immer hungrig nach Anerkennung und dem guten Gefühl, etwas weggeschafft zu haben – Workaholics sind besonders burnoutgefährdet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
