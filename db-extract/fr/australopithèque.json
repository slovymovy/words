                                        "sense_id": "cf62514c-7aa6-3d68-9290-56e52b59422d",
                                        "entry_id": "761ee10a-1d13-353c-a9bc-b737d2bd1c9a",
                                        "glosses": [
                                            "primate fossile bipede, appartenente ai primati, della famiglia degli ominidi, esistito nel pliocene tra 4 (o probabilmente 6) e 1 milione di anni fa in Africa orientale e meridionale; la sua classificazione scientifica è Australopithecus ( tassonomia)"
                                        ],
                                        "tags": [
                                            "primatologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7457bf4a-7c02-4201-9b8d-ac2a801b002e",
                                                "sense_id": "cf62514c-7aa6-3d68-9290-56e52b59422d",
                                                "text": "Lucy è una femmina di Australopitecus afarensis"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
