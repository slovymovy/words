                            {
                                "example_id": "31645ad5-d1c7-48ae-abab-f592731212d7",
                                "sense_id": "a499c1da-00c6-3833-9f50-adb7a4e14b45",
                                "text": "Na rust had De Jong meer aandeel in het aanvalsspel: zo gaf hij een subtiel passje op Ferrán Torres, wiens voorzet vervolgens door een Mallorca-verdediger tegen de eigen paal werd gegleden."
                            },
                            {
                                "example_id": "492234f5-2d52-4150-84a4-8a5cf02dd747",
                                "sense_id": "a499c1da-00c6-3833-9f50-adb7a4e14b45",
                                "text": "Maar Rybakina had dikwijls een antwoord op die offensieve tactiek. Rus slaagde er bovendien niet in haar aanvalsspel vast te houden (het aantal onnodige fouten nam toe) en kon niet op tegen de souplesse van de kwartfinaliste van 2021."
                            }
