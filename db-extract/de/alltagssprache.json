                        "form": "der Alltagssprache"
                    },
                    {
                        "form_id": "75ffa9f3-1417-49f5-a244-0a5d3b892aa6",
                        "entry_id": "5083d426-c942-396e-ad3a-093136dca371",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Alltagssprache"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                        "entry_id": "5083d426-c942-396e-ad3a-093136dca371",
                        "glosses": [
                            "zwischen Standard- und Umgangssprache stehende Sprachform, die für alltägliche Zwecke verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072f2b96-7567-49a6-b125-758941b5d106",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "Bei alltäglichen Verrichtungen wie Einkaufen, Small Talk oder Unterhaltung mit Bekannten verwendet man meist die Alltagssprache."
                            },
                            {
                                "example_id": "cb05cb75-bc4d-4d0e-9f2b-94b22c6def99",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "Die Alltagssprache ist weniger förmlich als zum Beispiel Fach-, Medien- oder Wissenschaftssprachen."
                            },
                            {
                                "example_id": "6b9132dd-7408-46a6-a936-7dfc0ab2fd86",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "„Wie bei Alltagssprache und Literatursprache stehen ‚Wissenschafts- und Fachsprachen‘ wiederum als Oberbegriffe für eine Reihe von Varietäten.“"
                            },
                            {
                                "example_id": "427e4489-03f8-4f8d-9319-6ab04785c626",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "„Das betrifft nicht allein den terminologischen Bereich und Benennungsstandards, sondern auch viele Wörter der Alltagssprache […]“"
                            },
                            {
                                "example_id": "2f87885d-97bb-4cad-80e6-601a1e81b575",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "„An diesen Formulierungen bemerken Sie bereits, daß hier der Prozeß des Verstehens, der Erkenntnis, der Meinungsbildung in der Alltagssprache mit dem Bilde des Sehens geschildert wurde.“"
                            },
                            {
                                "example_id": "9f1ce151-8fad-4c83-b447-136741daa929",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "„In den Duden schaffte es das Gesetz nie, weil es in der Alltagssprache nicht vorkommt.“"
                            },
                            {
                                "example_id": "678d9aac-6a37-47f3-9095-1a2ce0b4ab2d",
                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                "text": "„Wie kommt es also, dass den Menschen im Rheinland zwar der Mischcharakter ihrer Alltagssprache bewusst ist, die jiddische Komponente dabei aber ausgeklammert bleibt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
