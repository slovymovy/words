                "senses": [
                    {
                        "sense_id": "e46ab99d-dc76-3fdc-ae4f-47799a9d3504",
                        "entry_id": "4de5f6b3-c050-32d2-86d7-f938d31ca090",
                        "glosses": [
                            "drying, dry-curing, jerking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897a4d7f-be92-454a-9895-2edbe91b48be",
                                "sense_id": "e46ab99d-dc76-3fdc-ae4f-47799a9d3504",
                                "text": "Всё э́то отли́чно поняла́ вя́леная во́бла, и́ли, лу́чше сказа́ть, не сама́ она́ поняла́, а принёс ей э́то понима́ние тот проце́сс вя́ления, сквозь кото́рый она́ прошла́.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            },
                            {
                                "example_id": "aab9b99a-88bf-4bf2-a295-1264bb3ea708",
                                "sense_id": "e46ab99d-dc76-3fdc-ae4f-47799a9d3504",
                                "text": "Вя́ление мо́жно проводи́ть в специа́льных суши́льных шкафа́х, га́зовых и́ли электри́ческих пли́тах, ру́сской печи́ и други́х нагрева́тельных устано́вках."
                            }
                        ]
                    }
                ],
