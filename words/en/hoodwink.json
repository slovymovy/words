    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a2128d6-4eae-39f1-a264-08ca48341b77",
                    "sense_definition": "To deceive or trick someone, often by using a disguise or misleading information.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clever salesman tried to <w>hoodwink</w> the customers into buying broken electronics."
                        },
                        {
                            "text": "He was <w>hoodwinked</w> by his business partner and lost all his savings."
                        }
                    ],
                    "common_phrases": [
                        "attempt to hoodwink",
                        "easily hoodwinked"
                    ]
                },
                {
                    "sense_id": "e16ac37e-4a2f-3902-b25a-b0c197498566",
                    "sense_definition": "To cover someone's eyes with a cloth or hood to prevent them from seeing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captors decided to <w>hoodwink</w> the prisoner before moving him to a new location."
                        },
                        {
                            "text": "They <w>hoodwinked</w> the participants to ensure the surprise party remained a secret."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely historical or literary."
                        }
                    ]
                },
                {
                    "sense_id": "bbc233ce-d03d-3d42-ba60-f378d0c84fb1",
                    "sense_definition": "To hide or obscure something from view.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fog served to <w>hoodwink</w> the true location of the hidden base."
                        },
                        {
                            "text": "Dark clouds <w>hoodwinked</w> the moon, leaving the forest in total darkness."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or poetic context."
                        }
                    ]
                },
                {
