                    }
                ],
                "senses": [
                    {
                        "sense_id": "8efb5287-f830-3e86-ad86-5f90c5245bb3",
                        "entry_id": "ca08ecf6-2408-393a-91b8-53d574949e58",
                        "glosses": [
                            "Relatif aux autoroutes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af80ec26-5fbe-46a7-b02f-b880510c4dcf",
                                "sense_id": "8efb5287-f830-3e86-ad86-5f90c5245bb3",
                                "text": "Le système autoroutier français est en grande partie à péage."
                            },
                            {
                                "example_id": "caebb309-224d-47fe-9e50-2f0a46eefbd7",
                                "sense_id": "8efb5287-f830-3e86-ad86-5f90c5245bb3",
                                "text": "Heureusement, l'agent autoroutier était à l'extérieur au moment du choc. Il était en train de sécuriser un accident intervenu un peu plus tôt."
                            },
                            {
                                "example_id": "ad0446de-d3ed-4370-bfc1-35638c4793df",
                                "sense_id": "8efb5287-f830-3e86-ad86-5f90c5245bb3",
                                "text": "Québec pourrait aussi devoir donner son aval à un tel projet, puisqu’il gère le réseau autoroutier et la plupart des ponts […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "3017508c-9250-3ca4-8a4a-47da246472ab",
                        "entry_id": "ca08ecf6-2408-393a-91b8-53d574949e58",
                        "glosses": [
                            "De la nature d’une autoroute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f66e4b19-9490-41b1-821d-ad03f866941c",
                                "sense_id": "3017508c-9250-3ca4-8a4a-47da246472ab",
                                "text": "Le Montréal que nous connaissons aujourd'hui a été planifié et développé à cette époque, planification que nous continuons de mettre en œuvre avec la transformation prochaine de la rue Notre-Dame en grand boulevard autoroutier."
                            },
                            {
                                "example_id": "0caafacf-f246-467a-8f26-8d94862415f4",
                                "sense_id": "3017508c-9250-3ca4-8a4a-47da246472ab",
                                "text": "Un décret a été adopté en ce sens au conseil des ministres, la semaine dernière, pour rendre conforme la construction « d’un tronçon autoroutier de 7,2 kilomètres reliant Montréal à Laval […] »."
                            },
                            {
                                "example_id": "ca7851b3-fade-47f4-9d47-b85fe6c5ed77",
                                "sense_id": "3017508c-9250-3ca4-8a4a-47da246472ab",
                                "text": "En 2018, le gouvernement caquiste dirigé par François Legault était porté au pouvoir après avoir promis de construire un tunnel autoroutier entre les deux rives."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cf86791-5ded-4c33-9779-77fdb38266c1",
                        "source_entry_id": "ca08ecf6-2408-393a-91b8-53d574949e58",
                        "target_lang_word": "motorway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motorway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                        "entry_id": "c9f6b136-13f5-391a-9ed9-8b9fcd736ea1",
                                        "glosses": [
                                            "A highway with grade-separated crossings (rather than level crossings) and designed (and only permitted) for high-speed motor-traffic (in Europe motor vehicles with a higher speed limit than 40 km/h) running in two directions on one separate carriageway each."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "New-South-Wales",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b9991f-feeb-4963-904f-8a7475004e1d",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "Charging stations for electric vehicles must be placed along the main European motorways at least every 60 kilometres from 2026, the European Parliament decided on Tuesday."
                                            },
                                            {
                                                "example_id": "2b9c44f7-9440-438a-80f6-ff67f5620047",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "All the R. R.'s of America will have to be furnished with a biking way and a motor way on each side of the rails."
                                            },
                                            {
                                                "example_id": "7baa5a72-8e00-4721-843c-4baaac520b71",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "Work of constructing the Texas Motorway, a stone highway which when completed will extend from Fort Worth to Del Rio, Tex., a distance of 500 miles, has been commenced and a section between 18 and 20 miles long running out from Glenrose, the county seat of Somervell County, has been completed."
                                            },
                                            {
                                                "example_id": "4e1f689f-20c8-4587-a492-01b4c1b18127",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "It is presumed that in the working out of the program the motor trucks will automatically have the major use of the local low-speed highways paralleling the motorway."
                                            },
                                            {
                                                "example_id": "8ef52f34-58e7-41d9-ab2a-abaec6aefe26",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "In 1959, Ernest Marples became the new Minister of Transport. His business career had been as a road builder and he saw the future in a network of motorways, whereas he believed there was serious overcapacity in the railway network."
                                            },
                                            {
                                                "example_id": "26874ec4-cc39-427d-a282-8dac0a0091f4",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "One national agency is responsible for developing and maintaining the national motorway system, which typically is a small fraction of the entire roadway network. (page 8)"
                                            },
                                            {
                                                "example_id": "45d68adf-0f02-4e1a-9dc7-045559478c7a",
                                                "sense_id": "590fe997-1191-3c6b-8e1c-04bba7d97271",
                                                "text": "An alternative transit route that bypasses the metropolis’ traffic-filled streets, the 400-kilometer (248.5-mile) North Marmara Motorway starts on the western side of Istanbul and ends in the eastern Marmara province of Sakarya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdab6b1b-b94a-36ea-a53f-9e9b4c440122",
                                        "entry_id": "c9f6b136-13f5-391a-9ed9-8b9fcd736ea1",
                                        "glosses": [
                                            "A racetrack venue designated especially for the sport of auto racing."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c73cb6f-34ae-4217-801b-d6cf67aa53fc",
                                                "sense_id": "fdab6b1b-b94a-36ea-a53f-9e9b4c440122",
                                                "text": "In December, track operators replaced the crushed rock with brick, earning the motorway the nickname, Brickyard."
                                            },
                                            {
                                                "example_id": "683b0cf3-4f29-47fb-86d7-eccf8e096393",
                                                "sense_id": "fdab6b1b-b94a-36ea-a53f-9e9b4c440122",
                                                "text": "The 9-degree banking you see in the Speedway’s four turns is believed to be the first intentionally banked motorway in the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "251b167a-a0e5-494c-8f9a-2ff433c67bcb",
                        "source_entry_id": "ca08ecf6-2408-393a-91b8-53d574949e58",
                        "target_lang_word": "freeway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freeway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                        "entry_id": "82e91bf4-186f-3bc9-ad29-d7ec2b6d9664",
                                        "glosses": [
                                            "A highway with grade-separated crossings (rather than level crossings) and designed (and only permitted) for high-speed motor-traffic running in two directions on one separate carriageway each"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958753c8-4014-4605-915b-195bf4089d70",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "Contrary to what one might expect of an essay on freeways, this one is neither a diatribe nor a paean."
                                            },
                                            {
                                                "example_id": "3298e26b-d5c5-4f85-a7cd-4098191556a9",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "A 106-kilometer section of this 117-kilometer new freeway (between Hsinchu and Hsichih 汐止) was opened to traffic in 1997, and the entire line will be finished in December 1999."
                                            },
                                            {
                                                "example_id": "96716759-b177-4086-9891-e54d9c980a5c",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "In the late 1950s and 1960s most large cities started planning freeway systems, acknowledging the incredible growth in car ownership."
                                            },
                                            {
                                                "example_id": "49a028c9-6300-45ae-961c-5f7019688f1d",
                                                "sense_id": "78e9200f-c953-3d58-a299-cb38e0458d3e",
                                                "text": "The Australian freeway story of the late twentieth century, like many planning stories, can be told as one of high technical expectations dashed by political controversy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6672c08e-05cc-38b6-b8f2-468b2f5e03d2",
                                        "entry_id": "82e91bf4-186f-3bc9-ad29-d7ec2b6d9664",
                                        "glosses": [
                                            "A toll-free highway."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8784bcc7-3dcd-46be-a66b-565500cb6db3",
                        "source_entry_id": "ca08ecf6-2408-393a-91b8-53d574949e58",
                        "target_lang_word": "highway",
