        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                    "sense_definition": "A specific portion of time that something lasts or requires.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small children often have a very short attention <w>span</w>.",
                            "target_lang_translations": {
                                "ru": "У маленьких детей часто очень короткий <w>период</w> концентрации внимания.",
                                "zh": "小孩子的注意力<w>持续时间</w>往往很短。",
                                "nl": "Kleine kinderen hebben vaak een erg korte aandachts<w>boog</w>."
                            }
                        },
                        {
                            "text": "The project was completed within a <w>span</w> of three months.",
                            "target_lang_translations": {
                                "ru": "Проект был завершен за <w>промежуток</w> времени в три месяца.",
                                "zh": "这个项目在三个月的<w>时间跨度</w>内完成了。",
                                "nl": "Het project werd binnen een <w>spanne</w> van drie maanden voltooid."
                            }
                        }
                    ],
                    "synonyms": [
                        "duration",
                        "period",
                        "term"
                    ],
                    "common_phrases": [
                        "attention span",
                        "time span",
                        "life span",
                        "short span"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный отрезок времени, который что-либо длится или требуется для чего-либо.",
                        "zh": "某事持续或完成所需要的一段特定时间。",
                        "nl": "Een bepaalde periode of tijdsduur die iets duurt of in beslag neemt."
                    },
