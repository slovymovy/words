                                    {
                                        "sense_id": "d320f5c6-c8a6-3242-ae73-3c17f47bbd5d",
                                        "entry_id": "b14d7639-a2c2-3409-8b6b-a849389a620b",
                                        "glosses": [
                                            "The act of disqualifying, or the state of being disqualified"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794b6a7e-85ee-4f7d-adde-dc546c333dc3",
                                                "sense_id": "d320f5c6-c8a6-3242-ae73-3c17f47bbd5d",
                                                "text": "the disqualification of certain people for holding certain positions"
                                            },
                                            {
                                                "example_id": "ed22a0f7-53ea-48d4-8d0e-acfe213ff6f7",
                                                "sense_id": "d320f5c6-c8a6-3242-ae73-3c17f47bbd5d",
                                                "text": "Henry won the match due to the disqualification of his opponent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2e7a2f-4007-36c0-9e74-4450e22a7fdb",
                                        "entry_id": "b14d7639-a2c2-3409-8b6b-a849389a620b",
                                        "glosses": [
                                            "That which disqualifies; that which causes someone to be unfit for a certain purpose or role"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9ba9186-24a2-4992-83a7-c565a6536545",
                                                "sense_id": "ae2e7a2f-4007-36c0-9e74-4450e22a7fdb",
                                                "text": "Conviction of crime is a disqualification of a person for office."
                                            },
                                            {
                                                "example_id": "d2c0e8d9-84ea-481d-af66-8d52767762dc",
                                                "sense_id": "ae2e7a2f-4007-36c0-9e74-4450e22a7fdb",
                                                "text": "Sickness is a disqualification for labor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d17229-8711-3c41-98ac-b4572d87df00",
                                        "entry_id": "b14d7639-a2c2-3409-8b6b-a849389a620b",
                                        "glosses": [
                                            "The act of being forbidden from further play in a basketball game due to the accumulation of too many personal fouls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "762e0e08-faf7-4ca9-9526-ebe5b7a49452",
                        "source_entry_id": "bdcb7eea-1f46-3f08-b220-3971b7dcba90",
                        "source_sense_id": "4f1e8da5-c253-316f-bacd-51e3d16c752c",
                        "target_lang_word": "disqualification",
