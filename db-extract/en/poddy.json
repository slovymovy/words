                    {
                        "sense_id": "878a064d-43a3-3a34-b8d3-7856b35c5a08",
                        "entry_id": "344dfeaf-fdb9-38d3-9a55-ffeb44e06419",
                        "glosses": [
                            "Of or pertaining to a pod or pods."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f856ab6-f291-4001-a51a-4acfa60b485f",
                                "sense_id": "878a064d-43a3-3a34-b8d3-7856b35c5a08",
                                "text": "1944, New Mexico State University Agricultural Experiment Station, Bulletin of the Agricultural Experiment Station, New Mexico College of Agriculture and Mechanic Arts, Issues 318-329, page 88,\n[…] the second cutting each season was allowed to become poddy, i.e., to set seed pods."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ffb507b-30f3-3b73-ae9b-76637edb1588",
                        "entry_id": "344dfeaf-fdb9-38d3-9a55-ffeb44e06419",
                        "glosses": [
                            "Fat, corpulent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e6a050f8-a621-3f38-b2e9-328004c56390",
                        "entry_id": "344dfeaf-fdb9-38d3-9a55-ffeb44e06419",
                        "glosses": [
                            "Fed by hand."
                        ],
                        "tags": [
                            "Australia",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0759e65b-0403-4b6c-a559-d2721e4a133a",
                                "sense_id": "e6a050f8-a621-3f38-b2e9-328004c56390",
                                "text": "One of my half-starved poddy calves was very ill, and I went out to doctor it previous to bathing and tidying myself for my finishing household duties."
                            },
                            {
                                "example_id": "638fac58-4bf9-4992-8e93-6ece15660b3d",
                                "sense_id": "e6a050f8-a621-3f38-b2e9-328004c56390",
                                "text": "1964, New South Wales Department of Agriculture, The Agricultural Gazette of New South Wales, Volume 74, page 646,\nConstant handling will cause mis-mothering, leading to deaths and a number of poddy lambs. Poddy lambs are slow to grow and often fail to reach marketable weight under eight months of age."
                            },
                            {
                                "example_id": "0435ee10-281f-4b98-8907-924493c67d89",
                                "sense_id": "e6a050f8-a621-3f38-b2e9-328004c56390",
                                "text": "The first really positive change came about when Mum arrived home with a poddy lamb."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "610ab0cd-e2d6-3366-9dae-c0a3526a96a9",
