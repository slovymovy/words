                        "examples": [
                            {
                                "example_id": "47f82f79-b395-4ee2-928d-d7491343dd33",
                                "sense_id": "837bba26-538f-3681-b882-aa854bbcbb42",
                                "text": "Ввечеру государь, собрав воевод, изустно дал им все нужные повеления."
                            },
                            {
                                "example_id": "2d0d0078-df7c-45e0-ab1f-74d01ccfb613",
                                "sense_id": "837bba26-538f-3681-b882-aa854bbcbb42",
                                "text": "Начиная от Бородинского сражения, с которого начался его разлад с окружающими, он один говорил, что Бородинское сражение есть победа, и повторял это и изустно, и в рапортах, и донесениях до самой своей смерти."
                            },
                            {
                                "example_id": "7e7f5c89-976f-40ef-b26f-145ace28ccd5",
                                "sense_id": "837bba26-538f-3681-b882-aa854bbcbb42",
                                "text": "Всё это досказывалось распорядителями уже изустно, потому что торчавшее из кармана письмо нельзя же было прочесть."
                            }
                        ]
                    }
