                        "examples": [
                            {
                                "example_id": "94024823-9896-4792-8986-b785ba0fc169",
                                "sense_id": "4409ed72-6771-379d-848c-a8a4ebdce510",
                                "text": "Kodaira won net als vrijdag de kortste sprintafstand in een wereldrecord voor laaglandbanen. Ze was nu 0,01 seconde sneller: 37,07. Voor de schaatsster was het haar twaalfde wereldbekerzege op rij. Daarmee heeft ze het record van Catriona LeMay-Doan geëvenaard. De Japanse is al twintig maanden ongeslagen op de 500 meter. De laatste race die Kodaira verloor was op 12 maart 2016."
                            },
                            {
                                "example_id": "9ed746e3-f30c-4580-9841-8fe2001df27b",
                                "sense_id": "4409ed72-6771-379d-848c-a8a4ebdce510",
                                "text": "De Antilliaan klokte in Parijs de derde tijd op de 100 meter (10,01) en bleef een tiende boven zijn Nederlands record. Zo snel was Martina dit jaar nog niet geweest op de kortste sprintafstand."
                            }
                        ]
                    }
