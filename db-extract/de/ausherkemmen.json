                        ],
                        "examples": [
                            {
                                "example_id": "2ea6873f-ca1d-47c1-8266-38fd47f494cf",
                                "sense_id": "909777e1-6463-3be4-81ab-de96d5c5ea5a",
                                "text": "„»Dös kam nacha so außa, daß 'n i schwarz g'macht hätt.«“"
                            },
                            {
                                "example_id": "334508c4-d667-4314-9aec-2620862aa25b",
                                "sense_id": "909777e1-6463-3be4-81ab-de96d5c5ea5a",
                                "text": "„Und wos kimmt aussa dabei?“"
                            },
                            {
                                "example_id": "c4a73728-d041-420a-886a-b5645b48695f",
                                "sense_id": "909777e1-6463-3be4-81ab-de96d5c5ea5a",
                                "text": "„Vielleicht soit i no a bisserl bleeder dreischaun, damit die Leit vom Fernsehn endli aussakemma und sogn: Woar a grod a Gaudi, a Spassettl.“"
                            },
                            {
                                "example_id": "52034004-48b8-419d-a06b-2654b643453d",
                                "sense_id": "909777e1-6463-3be4-81ab-de96d5c5ea5a",
                                "text": "„Deandl kimm aussa, sonst steig i ein, laß mi dei herzliebster Jaga sein, laß mi dei herzliebster Jaga sein!“"
                            },
                            {
                                "example_id": "a14920e0-dc44-4ef4-8db0-4f048cf5066b",
                                "sense_id": "909777e1-6463-3be4-81ab-de96d5c5ea5a",
                                "text": "„Als abends alles gemütlich beisammen war, kommt die Kellnerin auf einmal eilends ins »Herrenzimmer« mit dem Rufe: »Herr Koprata, glei sollt's außakemma!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
