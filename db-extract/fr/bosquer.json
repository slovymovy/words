                "senses": [
                    {
                        "sense_id": "a71c1b8e-5cb5-3ebc-a7b3-4eaf4d1308f5",
                        "entry_id": "2b84f43e-b48f-34e8-8467-072a677ed57f",
                        "glosses": [
                            "Déplacer du sel vers l’avant de la cale, pour libérer l’arrière pour le stockage du poisson."
                        ],
                        "tags": [
                            "Grande pêche"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ea64fc-629c-468b-bbed-39731d4b3757",
                                "sense_id": "a71c1b8e-5cb5-3ebc-a7b3-4eaf4d1308f5",
                                "text": "On cargue, on bosque ; on vire la lâche, maille le palan."
                            },
                            {
                                "example_id": "5828abf2-6276-4231-9d7e-11cfe8f1b0d9",
                                "sense_id": "a71c1b8e-5cb5-3ebc-a7b3-4eaf4d1308f5",
                                "text": "On appelait cela bosquer le sel ou prendre un rin ; c’était énormément de travail."
                            }
                        ]
                    }
