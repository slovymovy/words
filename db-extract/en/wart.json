                    {
                        "translation_id": "d340bc0d-8543-4f57-a83e-e9033ae120f4",
                        "source_entry_id": "5303360e-6911-3312-8bb0-93115afcd221",
                        "source_sense_description": "type of growth occurring on the skin",
