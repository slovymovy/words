                            }
                        },
                        {
                            "text": "Мы гуляли по парку и видели <w>красивые</w> деревья.",
                            "target_lang_translations": {
                                "en": "We walked through the park and saw <w>beautiful</w> trees.",
                                "nl": "We wandelden door het park en zagen <w>mooie</w> bomen.",
                                "pl": "Spacerowaliśmy po parku i widzieliśmy <w>ładne</w> drzewa.",
                                "de": "Wir gingen durch den Park spazieren und sahen <w>schöne</w> Bäume.",
                                "fr": "Nous nous promenions dans le parc et avons vu de <w>beaux</w> arbres.",
                                "it": "Abbiamo camminato nel parco e abbiamo visto degli alberi <w>belli</w>.",
                                "cs": "Procházeli jsme se parkem a viděli jsme <w>krásné</w> stromy.",
                                "tr": "Parkta yürüdük ve <w>güzel</w> ağaçlar gördük.",
                                "es": "Paseábamos por el parque y vimos árboles <w>bonitos</w>."
