                "senses": [
                    {
                        "sense_id": "2f0f8c06-8e9e-38f6-ae0a-788adb9e1ebc",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Metallstück zur Verbindung von zueinander beweglichen Teilen (zum Beispiel bei Möbelteilen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d46525-56a3-4d6d-944a-b04b418f3bdd",
                                "sense_id": "2f0f8c06-8e9e-38f6-ae0a-788adb9e1ebc",
                                "text": "„Wer ganz sicher gehen will, bringt Gitter vor den Fenstern an, schraubt abschließbare Beschläge auf die Rahmen, montiert Bügel an die Türen und setzt Panzerriegel ein. Dann kann er sich zu Hause fühlen wie in Alcatraz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac31d180-21a6-3295-8373-6ecba1e93d0d",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Metallverzierung (zum Beispiel an Möbeln oder Uniformen) als Schmuck oder auch als Schutz (etwa für Buchecken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "703b6f4d-5af6-416c-968c-eb29933eb432",
                                "sense_id": "ac31d180-21a6-3295-8373-6ecba1e93d0d",
                                "text": "„Auf militärischen Kopfbedeckungen des 19. und frühen 20. Jahrhunderts (Raupenhelm, Tschako, Pickelhaube) waren Beschläge mehr zur Zierde als zum Schutz angebracht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f16fb375-8640-3162-8185-34e3adcc5286",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Hufbeschlag"
                        ],
                        "tags": [
                            "short-form",
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d327f32a-8393-4cb5-803a-3151e0657fe1",
                                "sense_id": "f16fb375-8640-3162-8185-34e3adcc5286",
                                "text": "„[…] doch: es gibt keinen festen Zeitraum, in dem der Beschlag gewechselt werden muss. Bei jedem Pferd ist das Hufwachstum anders und kann zu verschiedenen Jahreszeiten gewissen Schwankungen unterliegen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9f7e5c65-e16a-3aad-9543-5fddf0dc3bcb",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "feiner Niederschlag, Kondensat, Belag auf glatten Flächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f062bb-e1c2-4965-bd32-3cc1163487d9",
                                "sense_id": "9f7e5c65-e16a-3aad-9543-5fddf0dc3bcb",
                                "text": "„Wir hauchen in ein kaltes trockenes Glas hinein. Jedermann weiß, daß aus dem Hauch ein Beschlag von Wassertröpfchen sich an dem Glase bildet, der ebenso aussieht, wie der Beschlag von Wassertröpfchen, welcher dadurch entsteht, daß man eine Flamme einer Kerze oder eines ähnlichen Stoffes in das Glas hineinhält.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "e9db014f-99b4-375e-8425-bf1f87d68cfc",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Begattung beim Rotwild"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "91772d50-ff8d-44c6-a315-83ba0fe0c25a",
                                "sense_id": "e9db014f-99b4-375e-8425-bf1f87d68cfc",
                                "text": "„Viel mehr brave Böcke retten ihre Decke bis in die Brunftzeit hinein, viel weniger Jämmerlinge kommen infolgedessen zum Beschlag, viel gesünder gestaltet sich das Zahlenverhältnis zwischen Böcken und Ricken.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "6e9d2310-306b-372f-89b2-447d76cf1d56",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Zubehör, Zugehöriges zu Grundbesitz, Grundeigentum"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "8dd7c9c7-9f64-40fe-acc5-f3bfe9a335b8",
                                "sense_id": "6e9d2310-306b-372f-89b2-447d76cf1d56",
                                "text": "„Wenn man einen Quadratmeterpreis von 2,50 Mark für eine landwirtschaftlich genutzte Fläche billige, so bedeute das, daß ein Bauernhof von 40 Hektar ohne Beschlag und Gebäude eine Million Mark koste.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "7d553200-0ef0-3895-8246-abcf3ebfd9f7",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Wegnahme, Beschlagnahme einer Sache von Rechts wegen; intensive Beanspruchung; heute nur noch in verschiedenen Wendungen (siehe unter Redewendungen)"
                        ],
                        "tags": [
                            "archaic",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb662a5-0c76-42b4-9789-13cbc27d18b8",
                                "sense_id": "7d553200-0ef0-3895-8246-abcf3ebfd9f7",
                                "text": "„Hieraus folgt, daß der Executionsrichter eine von ihm bereits mit Beschlag belegte Sache auf Antrag eines andern Gläubigers nicht nochmals mit Beschlag belegen kann.“ (1867)"
                            }
                        ],
                        "sense_index_json": "\"7\""
                    },
                    {
                        "sense_id": "40a5b06d-a4b9-376c-8da5-9a7e98d83622",
                        "entry_id": "98f8557e-bff1-3781-befa-c8eaa27b5044",
                        "glosses": [
                            "Einrichtung an Bord eines Schiffes, die etwas (beispielsweise ein Seil, Stag, etc.) verbindet, befestigt oder sichert"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "634e4c4d-381d-47dd-8940-ee2f451a3741",
                                "sense_id": "40a5b06d-a4b9-376c-8da5-9a7e98d83622",
                                "text": "Ein Pütting … ist auf Segelschiffen ein Beschlag, an dem Wanten befestigt werden."
                            }
                        ],
                        "sense_index_json": "\"8\""
                    }
