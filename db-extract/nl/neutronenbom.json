                ],
                "senses": [
                    {
                        "sense_id": "3d42e07a-044e-331e-8f53-be096fecf5d1",
                        "entry_id": "16782182-f9d1-320a-bde9-d97f03fc4027",
                        "glosses": [
                            "een waterstofbom die zo is geconstrueerd dat een groot deel van de energie van de explosie vrijkomt in de vorm van neutronenstraling, terwijl de hoeveelheid radioactiviteit die vrijkomt klein blijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19431e57-6f62-4155-99c8-7cdba3a1c403",
                                "sense_id": "3d42e07a-044e-331e-8f53-be096fecf5d1",
                                "text": "Eind 1977 kreeg hij de hoogste post op Defensie in het kabinet-Van Agt. Hij bleef dit nog geen drie maanden omdat hij zich niet kon vinden in het kabinetsstandpunt over de neutronenbom. Hij vervolgde zijn carrière daarna bij de Wereldgezondheidsorganisatie. Hij zat nog wel van 1981 tot 1991 in de Eerste Kamer."
                            },
                            {
                                "example_id": "16159e4e-b71a-476e-abe2-40d200bdd696",
                                "sense_id": "3d42e07a-044e-331e-8f53-be096fecf5d1",
                                "text": "Een stemmer schrijft: \"Een neutronenbom op het land en niets doet het meer.\" Een ander: \"Hoe wil je sms'en, radio luisteren of televisie kijken als de stroomvoorziening en dus ook de communicatie vanwege een ramp niet meer werken?"
                            }
                        ]
                    }
                ],
