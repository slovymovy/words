    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "920f056a-ce72-37ca-a098-f35918e71b88",
                "word": "lustre",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b9d6f567-76b4-4e00-871a-0d112144950b",
                        "entry_id": "920f056a-ce72-37ca-a098-f35918e71b88",
                        "tags": [
                            "plural"
                        ],
                        "form": "lustres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dec22e7-95db-3a7b-bb95-2c2073e85db6",
                        "entry_id": "920f056a-ce72-37ca-a098-f35918e71b88",
                        "glosses": [
                            "British standard spelling of luster (shine, etc.)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f8b077f-f157-412f-a05b-4f8ceb880c99",
                                "sense_id": "2dec22e7-95db-3a7b-bb95-2c2073e85db6",
                                "text": "Various kinds of minerals differ in their lustre; iron pyrites are described as having a metallic lustre, glassy materials a vitreous lustre; others, such as opal, look resinous, and the lustres of yet others are described as being either pearly, or silky, or dull, like earth."
                            },
                            {
                                "example_id": "23ef3477-111b-4088-9d5f-fc4dd04cccc1",
                                "sense_id": "2dec22e7-95db-3a7b-bb95-2c2073e85db6",
                                "text": "In the centre is painted an eagle, from whose beak an elegant glass lustre chandelier is suspended. There are also ten smaller chandeliers in different parts of the room."
                            },
                            {
                                "example_id": "85b3b9dd-dc95-45b4-b578-8116126509a9",
                                "sense_id": "2dec22e7-95db-3a7b-bb95-2c2073e85db6",
                                "text": "On the ground floor, the library (a room in carved oak) is lighted by a lustre composed of twelve regenerative burners enclosed in tinted glasses."
                            },
                            {
                                "example_id": "030d35aa-47f8-4db9-87e5-db70545ca928",
                                "sense_id": "2dec22e7-95db-3a7b-bb95-2c2073e85db6",
                                "text": "...he went out through the unfamiliar hall, setting the chandelier clashing its dusty lustres with his hand, leaving a prismatic jangle behind him in the empty house."
                            },
                            {
                                "example_id": "953a5190-2557-4c86-a39b-2f7326bef82a",
                                "sense_id": "2dec22e7-95db-3a7b-bb95-2c2073e85db6",
                                "text": "As TransPennine Express 185130 departs with the 1654 to Manchester Piccadilly, while Northern 150273 waits with the 1712 to Sheffield, it is clear from this vantage point that the Grade 1 listed station has lost some of its lustre. But this is May 23 2023... before work to restore that lustre started."
                            }
                        ]
                    }
                ],
