                "senses": [
                    {
                        "sense_id": "5b4f2458-37f4-3bec-8ee5-cde5a4d7e33e",
                        "entry_id": "9fb68a53-3692-3d3d-bc02-012fd09fc3d3",
                        "glosses": [
                            "Anzug aus Tweed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab25db0-67b8-4903-825c-c7ba31767579",
                                "sense_id": "5b4f2458-37f4-3bec-8ee5-cde5a4d7e33e",
                                "text": "„»Moi, j'adore le ›Dry‹«, sagte gerade ein am Nebentisch sitzendes Mädchen mit strahlendem Gesicht zu seinem Begleiter, dessen der Jahreszeit gar nicht entsprechender Tweedanzug zu adrett war und der es mit seinen feuchten braunen Augen anstarrte.“"
                            },
                            {
                                "example_id": "861422ec-4eef-4932-92a2-bb375300e44e",
                                "sense_id": "5b4f2458-37f4-3bec-8ee5-cde5a4d7e33e",
                                "text": "„Er trug einen abgewetzten Tweedanzug.“"
                            },
                            {
                                "example_id": "efbb58c7-1306-4595-8913-b204d52bad71",
                                "sense_id": "5b4f2458-37f4-3bec-8ee5-cde5a4d7e33e",
                                "text": "„Er trug einen dicken Tweedanzug mit Fischgrätenmuster und hatte einen großen Lederranzen über die Schulter geworfen, in den die Initialen HJM eingebrannt waren.“"
                            },
                            {
                                "example_id": "b2579f63-5a3a-4d2f-bb75-979bc9e66d42",
                                "sense_id": "5b4f2458-37f4-3bec-8ee5-cde5a4d7e33e",
                                "text": "„Eine Sekretärin geleitete mich in das innere Heiligtum des Chief, und dort saßen in aufeinander abgestimmten Ledersesseln Lee Blanchard, mehr hohe Tiere, als ich je auf einem Haufen versammelt gesehen hatte, und ein spindeldürrer Mann in einem dreiteiligen Tweedanzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
