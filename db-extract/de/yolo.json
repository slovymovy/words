                "senses": [
                    {
                        "sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                        "entry_id": "0ab8dc01-74d7-3313-8666-59ed2766e49f",
                        "glosses": [
                            "lebensbejahende Aufforderung, die Chance zu nutzen"
                        ],
                        "tags": [
                            "jugendsprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "9aab6cc9-96f1-4235-8849-e10d570d7494",
                                "sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                                "text": "„Ihre Eltern legten sich noch eine Fußmatte mit dem Aufdruck \"Carpe Diem\" vor die Tür, \"Nutze den Tag\". Ihre Kinder können damit nichts anfangen. \"Yolo\" ist ihr Motto: \"You only live once\". Meint in etwa das Gleiche - und ist das Jugendwort des Jahres.“"
                            },
                            {
                                "example_id": "a2fa3dd0-6c8a-4aec-9f32-950697dd1258",
                                "sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                                "text": "„›Yolo‹ sei ein Akronym und stehe für ›You only live once‹ (Du lebst nur einmal) – eine Aufforderung, alle Chancen auf Erlebnisse zu nutzen.“"
                            },
                            {
                                "example_id": "81fc45df-f76f-4636-8058-bab60e260ce7",
                                "sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                                "text": "„Viele Erwachsene werden mit dem Begriff wenig anfangen können: \"Yolo\" ist das Jugendwort des Jahres.“"
                            },
                            {
                                "example_id": "975f7c03-d2ce-482c-80b8-88aec707bd33",
                                "sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                                "text": "„Wenn Jugendliche miteinander sprechen, kommt es schon einmal vor, dass Erwachsene über den Inhalt rätseln müssen. \"Yolo\" ist eine der beliebtesten Kreationen.“"
                            },
                            {
                                "example_id": "42872b99-5ae6-4574-87cd-89c94fb9eac4",
                                "sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                                "text": "Yolo hingegen wird fast ausschließlich als dankbare Ausrede für ungezügelten Genuss, Konsum oder Hedonismus verwendet. Das Smartphone für 500 Euro auf Pump kaufen? Yolo! Rauchen mit 15? Mathe Hausaufgaben vergessen? Yolo! Unter der Woche feiern gehen? Yolo! Sex ohne Kondom? Yolo!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec340ac1-8532-49c2-85c8-41bbb9c01fb3",
                        "source_entry_id": "0ab8dc01-74d7-3313-8666-59ed2766e49f",
                        "source_sense_id": "4acbfbe2-80fb-3e12-9840-a7673eba6679",
                        "source_sense_description": "jugendsprachlich: lebensbejahende Aufforderung, die Chance zu nutzen",
                        "target_lang_word": "YOLO",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "YOLO",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36cec084-068c-3ea5-a790-83f4d75bedba",
                                        "entry_id": "52090186-b3a7-3d38-a3fc-9f724158ed24",
                                        "glosses": [
                                            "Acronym of you only live once, i.e. expressing the view that one should make the most of the present moment."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955f3ea8-d1c8-4b84-9977-378b5d63d61b",
                                                "sense_id": "36cec084-068c-3ea5-a790-83f4d75bedba",
                                                "text": "Making this cake mix eleven years past the expiration date, because YOLO!"
                                            },
                                            {
                                                "example_id": "3f31dd6c-cd39-463d-833a-a4e765cb8cf0",
                                                "sense_id": "36cec084-068c-3ea5-a790-83f4d75bedba",
                                                "text": "“Well, it's too late to turn back now, Brandon,” Ana said. “And anyway… YOLO, right?” Brandon looked like he was about to explode, but finally he rubbed his eyes and nodded. “Yeah. YOLO.”"
                                            },
                                            {
                                                "example_id": "76402cf1-a621-41e3-ad7b-d3ef9cdc8cb3",
                                                "sense_id": "36cec084-068c-3ea5-a790-83f4d75bedba",
                                                "text": "“It made me come to this conclusion of, I don’t know, YOLO, let me just try this,” he said."
                                            },
                                            {
                                                "example_id": "fe37971d-b0d4-4d4f-a479-47d65e67ecce",
                                                "sense_id": "36cec084-068c-3ea5-a790-83f4d75bedba",
                                                "text": "Individual YOLO decisions can be chalked up to many factors: cabin fever, low interest rates, the emergence of new get-rich-quick schemes like NFTs and meme stocks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
