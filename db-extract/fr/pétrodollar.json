                    }
                ],
                "senses": [
                    {
                        "sense_id": "533fb0dd-9b22-332b-bead-f43cfb51e4dd",
                        "entry_id": "724ce618-2726-3a45-869c-5ee7148040dd",
                        "glosses": [
                            "Dollar provenant de la vente de pétrole brut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a6e1ed-ac00-4362-a95e-f68441e29cb4",
                                "sense_id": "533fb0dd-9b22-332b-bead-f43cfb51e4dd",
                                "text": "La naissance du pétrodollar fut discutée dès 1973 lors de la réunion qui se déroula sur l’île suédoise de Saltjobaden dans le complexe de la puissante dynastie bancaire des Wallenberg (dans l’orbite de la famille Rothschild)."
                            },
                            {
                                "example_id": "de422d1e-80d0-4a1b-b54a-7b90549855f7",
                                "sense_id": "533fb0dd-9b22-332b-bead-f43cfb51e4dd",
                                "text": "Après quatorze saisons avec les Merengue, l’ancien international tricolore de 35 ans a donc cédé au chant des pétrodollars saoudiens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5867cdd-9245-4247-8be4-aa634b103d62",
                        "source_entry_id": "724ce618-2726-3a45-869c-5ee7148040dd",
                        "source_sense_id": "533fb0dd-9b22-332b-bead-f43cfb51e4dd",
                        "target_lang_word": "Petrodollar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petrodollar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fddc85a3-c208-3311-9fbe-1a2f32c5e164",
                                        "entry_id": "b681cc3e-dea1-3a97-8fd7-4ad1203b76c2",
                                        "glosses": [
                                            "Bezeichnung für den US-Dollar, der im Erdölhandel verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0608774d-1149-477c-850f-408ce1112f2d",
                                                "sense_id": "fddc85a3-c208-3311-9fbe-1a2f32c5e164",
                                                "text": "„Seit dem Zweiten Weltkrieg wird der Handel mit Erdöl hauptsächlich in US-Dollar abgerechnet. Das hierfür verwendete Geld wird auch als Petrodollar bezeichnet.“"
                                            },
                                            {
                                                "example_id": "4a6bb41d-a7e9-4e9c-a460-fb53ff331b48",
                                                "sense_id": "fddc85a3-c208-3311-9fbe-1a2f32c5e164",
                                                "text": "„Die Petrodollars flossen nicht in architektonische Gigantomanie (Wolkenkratzer wie in den benachbarten Emiraten sucht man im Oman vergeblich), sondern eher in ein vorbildliches Bildungswesen, das ausdrücklich auch Mädchen und Frauen fördert.“"
                                            },
                                            {
                                                "example_id": "98f6062c-96b2-4c3a-9a53-b8cd9ed70943",
                                                "sense_id": "fddc85a3-c208-3311-9fbe-1a2f32c5e164",
                                                "text": "„Die Marine gehörte mit zur Show und war Teil des großen Vergnügungsparks, in den die reichlich sprudelnden Petrodollars das ganze Land verwandelt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08f0012c-4e8a-4bfc-aa94-528da6f777ec",
                        "source_entry_id": "724ce618-2726-3a45-869c-5ee7148040dd",
