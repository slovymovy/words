                                            },
                                            {
                                                "example_id": "9ea9a551-8e9f-42c0-bef4-d0a127f983ea",
                                                "sense_id": "8836b74f-b52e-358c-8283-46efcdd63f6e",
                                                "text": "„Clerfayt sah eine Vase mit weißem Flieder und einen langen Zweig flacher, weißer Orchideen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14232b53-bd99-4315-9205-51b8fe3295a0",
                        "source_entry_id": "dab14b7e-4d94-39b0-95d9-25d8b402c4d6",
                        "source_sense_id": "cafd4608-92fc-3da5-a83f-afc28104b5ec",
                        "target_lang_word": "Blumenvase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blumenvase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "849e9b38-a271-3fe7-bf95-25b3e7c0ff02",
                                        "entry_id": "c03969eb-e49a-3d1d-83d8-5cbe50d7c449",
                                        "glosses": [
                                            "Gefäß, meist mit Wasser gefüllt, zum Einfrischen von Blumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96adca95-3db0-4f9c-b693-3fd8ea7c2e77",
                                                "sense_id": "849e9b38-a271-3fe7-bf95-25b3e7c0ff02",
                                                "text": "Die Blumenvase ist zu weit, daher stehen die Blumen nicht aufrecht."
                                            },
                                            {
                                                "example_id": "095c7d08-3f0c-43c9-8c2f-6e5cf9653839",
                                                "sense_id": "849e9b38-a271-3fe7-bf95-25b3e7c0ff02",
                                                "text": "„Zwischen zwei weißen Schmalzblöcken hinten im Schaufenster des Metzgerladens, über ihrem Kopf, zwischen Blumenvasen und marmornen Etageren stand eine Pyramide von Fleischkonserven, auf deren Etiketten mit knalligem Rot gedruckt war: Corned beef.“"
                                            },
                                            {
                                                "example_id": "ebc2caff-05c1-41bf-93ff-fd3b076973d7",
                                                "sense_id": "849e9b38-a271-3fe7-bf95-25b3e7c0ff02",
                                                "text": "„Charlotte trägt eine Blumenvase vom kleinen runden Tisch auf den großen viereckigen Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88159466-b3c7-4ccd-8790-6ff6c1170758",
                        "source_entry_id": "dab14b7e-4d94-39b0-95d9-25d8b402c4d6",
                        "source_sense_id": "cafd4608-92fc-3da5-a83f-afc28104b5ec",
                        "target_lang_word": "ваза",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ваза",
