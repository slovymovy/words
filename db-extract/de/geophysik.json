                        "form": "der Geophysik"
                    },
                    {
                        "form_id": "9325b4aa-81b7-4dc9-b909-62db76daeb2d",
                        "entry_id": "c51446b3-a14f-3a17-b0cd-ee23a9afbeeb",
                        "tags": [
