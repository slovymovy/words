                "senses": [
                    {
                        "sense_id": "0df42ad5-e711-3cb5-9dd3-9b6d676c2df8",
                        "entry_id": "e6fdd80f-e98a-34b2-b0c0-02b33ff905ac",
                        "glosses": [
                            "altes, wackeliges, rumpelndes Ding/Gefährt"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "bb05fd84-09d6-4196-86dd-b630f23d5ffa",
                                "sense_id": "0df42ad5-e711-3cb5-9dd3-9b6d676c2df8",
                                "text": "„Wir waren unserer acht im Postwagen und saßen sehr unbequem; denn es war ein großer Rumpelkasten von ovaler Gestalt, so daß niemand einen Eckplatz hatte, denn den gab es nicht. “"
                            },
                            {
                                "example_id": "40553fba-c4ff-4fee-9e16-639c92b94b33",
                                "sense_id": "0df42ad5-e711-3cb5-9dd3-9b6d676c2df8",
                                "text": "„Die Postkutsche war ein uralter Rumpelkasten mit einem sogenannten Coupé, das aber nur ein einfacher Kutschersitz ist, auf dem höchstens zwei Personen Platz haben, doch werden drei hineingepreßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
