                        "glosses": [
                            "Of, pertaining to, advocating, or acting in accordance with scientism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "154b8173-d3ed-4161-befa-f50a4fae7b00",
                                "sense_id": "fa34652a-49fb-3274-85f6-2a72d6a0df2f",
                                "text": "Scientific models and scientistic myths are not seaworthy craft because they take as their premise that they are adequate for all circumstances; they assume that reality is knowable, quantifiable, and describable in their notation."
                            }
                        ]
                    }
