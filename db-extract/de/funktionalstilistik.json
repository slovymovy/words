                "senses": [
                    {
                        "sense_id": "78196cc0-3076-310e-a3bd-b546f6a549e5",
                        "entry_id": "ea5c8502-18e1-3d87-8e86-9b6b62603398",
                        "glosses": [
                            "spezielle Disziplin der Stilistik, deren Gegenstand die Funktionalstile sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a46bee8-5286-4fce-8034-44b48db1870d",
                                "sense_id": "78196cc0-3076-310e-a3bd-b546f6a549e5",
                                "text": "„In der Funktionalstilistik werden zwischen außersprachlichen Kommunikationsbereichen und Kommunikationssituationen und bestimmten sprachlichen Formulierungs- und Ausdrucksweisen als Stilen korrelative Zusammenhänge und in diesem Sinne Funktionalstile beziehungsweise Textsorten angenommen…“"
                            },
                            {
                                "example_id": "ff37bd5c-476b-4b15-bf3c-682e935ff654",
                                "sense_id": "78196cc0-3076-310e-a3bd-b546f6a549e5",
                                "text": "„Trotz dieser terminologischen Übereinstimmung unterscheiden sich die Funktionalstilistik der Prager Schule und der sowjetischen Forschung namentlich im theoretischen Ansatzpunkt, bis zu einem gewissen Grade aber auch in den Kategorien und Methoden.“"
                            },
                            {
                                "example_id": "07244dd9-381c-428f-b6fc-6ce9f4ba73b5",
                                "sense_id": "78196cc0-3076-310e-a3bd-b546f6a549e5",
                                "text": "„Erst mit der Ausweitung des Stilbegriffs auf alle sprachlichen Texte, wie sie vereinzelt schon im 19. Jahrhundert, allgemeiner dann in der Funktionalstilistik und in der linguistischen Stilistik des 20. Jahrhunderts erfolgte, erlangte der Begriff des Sprachstils seine volle Anerkennung, ohne in seiner Geltung einheitlich begriffen worden zu sein.“"
                            },
                            {
                                "example_id": "bf5553b9-ceec-4c28-a425-d5a80fa6242b",
                                "sense_id": "78196cc0-3076-310e-a3bd-b546f6a549e5",
                                "text": "„Von den selbst innerhalb der Funktionalstilistik kontroversen Ansichten seinen genannt die von B. Havránek…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
