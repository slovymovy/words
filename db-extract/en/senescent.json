                ],
                "senses": [
                    {
                        "sense_id": "8cd044fc-3740-3e7e-9ff4-c3eac51234df",
                        "entry_id": "bf9d8615-dd02-3863-b172-f3ee12cc9f8a",
                        "glosses": [
                            "Growing old; decaying with the lapse of time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40713fdd-abe1-4046-a302-27406b517902",
                                "sense_id": "8cd044fc-3740-3e7e-9ff4-c3eac51234df",
                                "text": "And now, as the night was senescent / ⁠And star-dials pointed to morn— / ⁠As the star-dials hinted of morn— / At the end of our path a liquescent / ⁠And nebulous lustre was born"
                            },
                            {
                                "example_id": "f3f15461-7006-4043-8a3c-33d45fed4d91",
                                "sense_id": "8cd044fc-3740-3e7e-9ff4-c3eac51234df",
                                "text": "The history of philosophic opinion itself in interpreted by Dr. Hall in terms of a similar development, in which immature adolescent systems, staid senescent and blasé philosophies have appeared and appealed to their public in direct relation to the status of the culture-periods in which they found origin and favor."
                            },
                            {
                                "example_id": "e03417fc-b868-4bb2-99ab-4a1f9daab2ea",
                                "sense_id": "8cd044fc-3740-3e7e-9ff4-c3eac51234df",
                                "text": "Put all of this together and one can envision a world two generations hence in which the richer parts of Europe and the Pacific Rim are senescent walled cities, instability and authoritarian decay predominate across much of Eurasia, and real dynamism is sustained mostly in the parts of America that are growing and building at the moment[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "27734f39-9158-3750-b9b8-0ddee4380ce6",
                        "entry_id": "bf9d8615-dd02-3863-b172-f3ee12cc9f8a",
                        "glosses": [
                            "Characteristic of old age."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "25d602ec-d600-36fe-b02a-af35a0dbcd1c",
                        "entry_id": "bf9d8615-dd02-3863-b172-f3ee12cc9f8a",
                        "glosses": [
                            "That ceases to divide."
                        ],
                        "tags": [
                            "of a cell"
                        ],
                        "examples": [
                            {
                                "example_id": "ba2d97af-e62d-4263-9122-013b7d057fa2",
                                "sense_id": "25d602ec-d600-36fe-b02a-af35a0dbcd1c",
                                "text": "When such lines and forms of organic development prevail, the individual, as the cell of the body, becomes soon senescent, drifting inevitably into age, decay, and death."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a6fba90-3792-4695-8ca2-f9b9d31b137e",
                        "source_entry_id": "bf9d8615-dd02-3863-b172-f3ee12cc9f8a",
                        "source_sense_description": "growing old",
                        "target_lang_word": "sénescent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sénescent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4acdd2fc-d3b4-3fec-b163-ccf161b68be9",
                                        "entry_id": "2e4ae6ff-705d-354a-b9c4-ac1260c5ac3d",
                                        "glosses": [
                                            "Atteint de sénescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fb4643-f5b1-4c22-b055-56cca521484a",
                                                "sense_id": "4acdd2fc-d3b4-3fec-b163-ccf161b68be9",
                                                "text": "Les vieux-bois (de 100 ans à 500 ans et plus selon les essences) que sont les arbres sénescents, comme les bois-morts encore debout ou couchés au sol ont un intérêt écologique majeur pour la biodiversité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3158af41-54ec-3634-8574-ba37e965b713",
                                        "entry_id": "2e4ae6ff-705d-354a-b9c4-ac1260c5ac3d",
                                        "glosses": [
                                            "Vieilli."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7c0e6d-4486-4cb0-afcf-d9650a9050b6",
                                                "sense_id": "3158af41-54ec-3634-8574-ba37e965b713",
                                                "text": "C’est ce dérèglement sénescent que l’Ampas s’est enfin décidée à liquider, entérinant non seulement le projet de doubler d’ici quatre ans la part des femmes et des minorités en son sein, mais aussi le retrait du droit de vote à ses membres inactifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
