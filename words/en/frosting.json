{
    "word_family": [
        "frost",
        "frosty",
        "defrost"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65ca6448-38bd-3838-b435-5c2fda440491",
                    "sense_definition": "A sweet, creamy, and thick covering for cakes and other baked goods.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spread the chocolate <w>frosting</w> evenly over the top of the birthday cake.",
                            "target_lang_translations": {
                                "zh": "她把巧克力<w>糖霜</w>均匀地涂在生日蛋糕的顶部。"
                            }
                        },
                        {
                            "text": "The vanilla <w>frosting</w> was too sweet for my taste.",
                            "target_lang_translations": {
                                "zh": "香草<w>糖霜</w>对我来说太甜了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "icing"
                    ],
                    "common_phrases": [
                        "cake frosting"
                    ],
                    "target_lang_definitions": {
                        "zh": "涂在蛋糕或其他烘焙食品表面的一种甜的、奶油状的厚涂层。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "糖霜",
                                "target_lang_sense_clarification": "指用于装饰蛋糕或饼干的甜味涂层。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c98154a-ac8f-38af-bb78-8d5259733898",
                    "sense_definition": "A thin layer of ice or frozen dew.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A light <w>frosting</w> of ice covered the windshield of the car this morning.",
                            "target_lang_translations": {
                                "zh": "今天早上汽车挡风玻璃上覆盖着一层<w>薄霜</w>。"
                            }
                        },
                        {
                            "text": "The grass in the garden had a white <w>frosting</w> after the cold night.",
                            "target_lang_translations": {
                                "zh": "寒冷的夜晚过后，花园里的草地上结了一层白色的<w>薄霜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frost"
                    ],
                    "target_lang_definitions": {
                        "zh": "一层薄薄的冰或冻露。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "薄霜",
                                "target_lang_sense_clarification": "指覆盖在物体表面的一层薄冰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28d2d9ec-3ad1-3d0c-a3c3-471db4ccf926",
                    "sense_definition": "The act of stealing a car that has been left running unattended, typically in cold weather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police warned drivers about the dangers of <w>frosting</w> during the winter months.",
                            "target_lang_translations": {
                                "zh": "警方提醒司机注意冬季<w>偷窃发动中的汽车</w>的危险。"
                            }
                        },
                        {
                            "text": "Leaving your car running to warm up makes it an easy target for <w>frosting</w>.",
                            "target_lang_translations": {
                                "zh": "让车发动着暖车，很容易成为<w>偷窃发动中的汽车</w>的目标。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in the context of vehicle theft."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在寒冷天气下，偷窃无人看管且处于发动状态的汽车的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "偷窃发动中的汽车",
                                "target_lang_sense_clarification": "一种针对在寒冷天气下未熄火车辆的犯罪行为。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb131569-da97-385a-a3ab-2f2ef4f32acd",
                    "sense_definition": "Present participle and gerund of <w>frost</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>frosting</w> the cupcakes for the school party.",
                            "target_lang_translations": {
                                "zh": "她正在为学校聚会给纸杯蛋糕<w>涂糖霜</w>。"
                            }
                        },
                        {
                            "text": "The cold air is <w>frosting</w> the window panes.",
                            "target_lang_translations": {
                                "zh": "冷空气正在使窗玻璃<w>结霜</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb frost."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 frost 的现在分词或动名词形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "涂糖霜",
                                "target_lang_sense_clarification": "指在糕点上涂抹糖霜。"
                            },
                            {
                                "target_lang_word": "结霜",
                                "target_lang_sense_clarification": "指物体表面形成霜。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}