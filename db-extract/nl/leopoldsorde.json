                        "glosses": [
                            "onderscheiding die door de koning van België wordt gegeven aan mensen die een uitzonderlijke prestatie hebben geleverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26636913-bfb7-41d0-9906-59e409b076f0",
                                "sense_id": "463654c2-3076-3361-8628-60610a8c6deb",
                                "text": "Het is de tweede koninklijke onderscheiding voor Daalmeijer in twee maanden tijd. In juli werd hij al geridderd tot officier in de Leopoldsorde voor zijn bijdrage aan de verbetering van de samenwerking tussen Nederland en België op het gebied van cultuur en media."
                            }
                        ]
