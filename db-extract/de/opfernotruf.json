                "senses": [
                    {
                        "sense_id": "3b7fa803-e3af-3a99-8989-f1dbf746a995",
                        "entry_id": "a6515d44-124c-3434-a03c-7366138fceeb",
                        "glosses": [
                            "Telefonnummer, die von Opfern einer Straftat angerufen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1584752d-8626-46df-892b-ea8eb73f0d4a",
                                "sense_id": "3b7fa803-e3af-3a99-8989-f1dbf746a995",
                                "text": "„Mit dem Erlös könnten wir Ehrenamtliche für den Opfernotruf schulen oder Rechtsanwälte bezahlen.“"
                            },
                            {
                                "example_id": "9186cd1b-0802-4290-877c-c3c70a72d73f",
                                "sense_id": "3b7fa803-e3af-3a99-8989-f1dbf746a995",
                                "text": "„Beim Opfernotruf des Weißen Rings gehen jährlich 70 bis 90 Anrufe zu Gewaltvorfällen in Haft ein.“"
                            },
                            {
                                "example_id": "52b2a3d6-e1e2-4ef1-a9ea-f633765ea63f",
                                "sense_id": "3b7fa803-e3af-3a99-8989-f1dbf746a995",
                                "text": "„In den letzten Jahren hat sich der Opfernotruf zu einer wichtigen Vervollständigung der Opferhilfelandschaft in Österreich entwickelt.“"
                            },
                            {
                                "example_id": "bcace7ac-d839-4ace-9657-2d744038c5c8",
                                "sense_id": "3b7fa803-e3af-3a99-8989-f1dbf746a995",
                                "text": "„Insgesamt gingen im vergangen Jahr über 13.000 Anrufe beim Opfernotruf ein, ein Rekordwert im Zehnjahresvergleich.“"
                            },
                            {
                                "example_id": "d6eceb06-d5ed-4f37-b189-c152d86b9ceb",
                                "sense_id": "3b7fa803-e3af-3a99-8989-f1dbf746a995",
                                "text": "„‚Der Opfernotruf ist eine wichtige Unterstützung für die Verbrechensopfer. Das unterstreicht die Bilanz mit 10.893 Anrufen im Jahr 2016 sehr klar‘, sagte Justizminister Wolfgang Brandstetter (ÖVP) zu den aktuellen Zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
