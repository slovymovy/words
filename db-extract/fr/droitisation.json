                        "examples": [
                            {
                                "example_id": "d8669e84-e080-4493-9de1-1e0e266008c1",
                                "sense_id": "b4eff193-057c-3c49-97e0-73345906cdee",
                                "text": "La droitisation de ensemble de la société se traduit du reste par les réticences une grande partie de opinion envers une solution qui offrirait aux FARC la possibilité de se reconvertir en force politique et par importance du soutien à Alvaro Uribe, opposant frontal à la négociation."
                            }
                        ]
