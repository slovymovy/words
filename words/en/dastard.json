{
    "word_family": [
        "dastardly",
        "dastardliness",
        "dastardize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "883a28fa-41c0-367d-87e0-478b22d0de17",
                    "sense_definition": "A person who is both malicious and cowardly, often acting in a dishonorable or sneaky way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cowardice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The anonymous <w>dastard</w> sent threatening letters but never dared to show his face in public.",
                            "target_lang_translations": {
                                "ru": "Анонимный <w>подлец</w> рассылал письма с угрозами, но так и не осмелился показаться на публике."
                            }
                        },
                        {
                            "text": "Only a true <w>dastard</w> would betray his closest friends to save his own skin during the crisis.",
                            "target_lang_translations": {
                                "ru": "Только истинный <w>трус</w> предаст своих ближайших друзей, чтобы спасти свою шкуру во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "poltroon",
                        "craven"
                    ],
                    "antonyms": [
                        "hero"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in older literature or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который одновременно злонамерен и труслив, часто действующий бесчестным или подлым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлец",
                                "target_lang_sense_clarification": "человек, совершающий низкие поступки"
                            },
                            {
                                "target_lang_word": "трус",
                                "target_lang_sense_clarification": "человек, лишенный мужества и действующий исподтишка"
                            },
                            {
                                "target_lang_word": "ничтожество",
                                "target_lang_sense_clarification": "презренный человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                    "sense_definition": "Characterized by mean-spirited cowardice or a dishonorable lack of courage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cowardice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dastard</w> attack on the defenseless village was condemned by every nation in the region.",
                            "target_lang_translations": {
                                "ru": "<w>Подлое</w> нападение на беззащитную деревню было осуждено всеми странами региона."
                            }
                        },
                        {
                            "text": "He lived a <w>dastard</w> life, always shrinking from danger and avoiding any form of responsibility.",
                            "target_lang_translations": {
                                "ru": "Он прожил <w>малодушную</w> жизнь, всегда пасуя перед опасностью и избегая любой ответственности."
                            }
                        }
                    ],
                    "synonyms": [
                        "craven"
                    ],
                    "antonyms": [
                        "valiant",
                        "heroic"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся подлой трусостью или бесчестным отсутствием мужества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "низкий и бесчестный"
                            },
                            {
                                "target_lang_word": "малодушный",
                                "target_lang_sense_clarification": "проявляющий слабость духа и трусость"
                            },
                            {
                                "target_lang_word": "трусливый",
                                "target_lang_sense_clarification": "склонный к трусости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d26e370e-06b7-3472-a376-ad95598cda0f",
                    "sense_definition": "To make someone cowardly or to <w>dastardize</w> them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cowardice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant threat of execution began to <w>dastard</w> even the most courageous soldiers in the unit.",
                            "target_lang_translations": {
                                "ru": "Постоянная угроза казни начала <w>лишать мужества</w> даже самых отважных солдат в подразделении."
                            }
                        },
                        {
                            "text": "He feared that a life of luxury would <w>dastard</w> his soul and rob him of his ambition.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что роскошная жизнь <w>сделает его душу трусливой</w> и лишит его амбиций."
                            }
                        }
                    ],
                    "antonyms": [
                        "embolden"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "extremely rare in contemporary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кого-либо трусливым или лишать мужества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устрашать",
                                "target_lang_sense_clarification": "делать трусливым через страх"
                            },
                            {
                                "target_lang_word": "лишать мужества",
                                "target_lang_sense_clarification": "делать человека малодушным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}