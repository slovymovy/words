                        "glosses": [
                            "геол. продукты выветривания горных пород, скапливающиеся у основания возвышенностей в результате перемещения вниз под влиянием силы тяжести, а также сноса дождевыми или талыми водами"
                        ],
                        "tags": [],
                        "examples": [
                            {
