                                    {
                                        "sense_id": "6d58b5ac-f6f3-3077-9a37-360a8a4c1792",
                                        "entry_id": "4c0e6445-ae08-3b56-b2a2-174365b46a75",
                                        "glosses": [
                                            "Uncontrolled or reactive and irresistible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294ab2f5-431b-4303-9709-756dc8e0c3a6",
                                                "sense_id": "6d58b5ac-f6f3-3077-9a37-360a8a4c1792",
                                                "text": "Jenny is a compulsive liar—don't believe a thing she says."
                                            },
                                            {
                                                "example_id": "1ec1f7f7-1db3-4e1e-9109-27927d151d6a",
                                                "sense_id": "6d58b5ac-f6f3-3077-9a37-360a8a4c1792",
                                                "text": "Under this Act, the term \"disability\" shall not include—...(2) compulsive gambling, kleptomania, or pyromania; or[…]"
                                            },
                                            {
                                                "example_id": "8522e3a4-a8d8-44fc-a16c-24640dfdf403",
                                                "sense_id": "6d58b5ac-f6f3-3077-9a37-360a8a4c1792",
                                                "text": "Call it impulsive, call it compulsive, call it insane / But when I'm surrounded I just can't stop"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5776c99-d887-36fa-8887-5fe3e4d2e0ad",
                                        "entry_id": "4c0e6445-ae08-3b56-b2a2-174365b46a75",
                                        "glosses": [
                                            "Having power to compel; exercising or applying compulsion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "228aeb2e-d624-4f66-b1cc-4cfead098150",
                                                "sense_id": "d5776c99-d887-36fa-8887-5fe3e4d2e0ad",
                                                "text": "Religion is […] inconsistent with all compulsive Motives."
                                            }
                                        ]
                                    }
                                ]
