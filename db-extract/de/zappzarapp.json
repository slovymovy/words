                "translations": [
                    {
                        "translation_id": "5bb70616-6b47-4054-8e77-0391f35c8284",
                        "source_entry_id": "e6b4e0b2-edc9-3042-9710-388123b01dba",
                        "source_sense_id": "09371592-be31-3d82-b407-7683cdb1e270",
                        "source_sense_description": "mit einer schnellen, meist unauffällige Bewegung (mit der etwas weggenommen, meist gestohlen wird)",
                        "target_lang_word": "yoink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53802f05-7705-3ad3-8a0e-4ee06beb3278",
                                        "entry_id": "56612757-9d9e-315e-bbae-5d33032f92a2",
                                        "glosses": [
                                            "To make an oinking sound."
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1412ede4-c368-429a-8388-941d9e8fea5a",
                                                "sense_id": "53802f05-7705-3ad3-8a0e-4ee06beb3278",
                                                "text": "Outside in the fog and the damp and cool air, common to County Cavan, he strode briskly along the road and when he arrived Cummings was already out and busy and the pigs—a big drove of them—were yoinking for their feed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c82cfd38-957f-30ac-9ec8-949a49eebc58",
                                        "entry_id": "56612757-9d9e-315e-bbae-5d33032f92a2",
                                        "glosses": [
                                            "To hop or bounce."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77b41560-d693-4219-b2cd-e44b8a5b2793",
                                                "sense_id": "c82cfd38-957f-30ac-9ec8-949a49eebc58",
                                                "text": "Carl Solomon yoinking around so frenziedly on a pogo stick that one night he put the end of it right through the floor into the restaurant below -- and all their girls, and their friends' girls, and their friends' friends, and even nameless others who may have just heard the hubbub and walkin in the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a71d9e93-d448-307f-82a1-d28a23a0e674",
                                        "entry_id": "56612757-9d9e-315e-bbae-5d33032f92a2",
                                        "glosses": [
                                            "nonce word for an action that impacts on something, especially if it is sudden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0740cac3-fc3b-4812-8fdb-562822584b0a",
                                                "sense_id": "a71d9e93-d448-307f-82a1-d28a23a0e674",
                                                "text": "...you're yoinked right back to the last spawn point."
                                            },
                                            {
                                                "example_id": "52fadb57-f464-48b7-b93c-71f1907bc761",
                                                "sense_id": "a71d9e93-d448-307f-82a1-d28a23a0e674",
                                                "text": "All of the clout is upstairs, yoinking around with meetings and that."
                                            },
                                            {
                                                "example_id": "f76dc22d-3d3b-410e-b971-c41ef857c92c",
                                                "sense_id": "a71d9e93-d448-307f-82a1-d28a23a0e674",
                                                "text": "Por supuesto, Ethan Suva yoinked the silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db90ed58-3340-3a84-840b-24bc30d48728",
                                        "entry_id": "56612757-9d9e-315e-bbae-5d33032f92a2",
                                        "glosses": [
                                            "To kill."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f164d8-630f-4465-a49a-94ebb0c0f3be",
                                                "sense_id": "db90ed58-3340-3a84-840b-24bc30d48728",
                                                "text": "I'll be going along, doing my starving-writer thing, free from the shackles of 'The Tube'; and, suddenly, my inspiration will die. Just gone, yoinked like a plug."
                                            },
                                            {
                                                "example_id": "ebc38044-2594-4e99-8d9f-4969619e49b2",
                                                "sense_id": "db90ed58-3340-3a84-840b-24bc30d48728",
                                                "text": "\"By all indications, the closet was just where the killah left her.\" He flipped through his notebook and then back, verifying his info. Good cop, Bubo thought. Thorough. \"Yup,\" he said, tapping the page. “By all indications, it looks like she got herself yoinked someplace else.”"
                                            },
                                            {
                                                "example_id": "4a02dc33-a832-48d5-9693-776bfa0c3712",
                                                "sense_id": "db90ed58-3340-3a84-840b-24bc30d48728",
                                                "text": "“DanU? You shittin me?” His eyes got big. He yoinked My Pal Roofie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "805e36ee-94e0-313e-aded-281d1a94f5ed",
                                        "entry_id": "a755243d-c4c5-3c1a-b25e-003982d4fade",
                                        "glosses": [
                                            "An ordinary person with nothing to recommend them."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "491df0ab-be63-4927-b3a2-c6e46398a5c5",
                                                "sense_id": "805e36ee-94e0-313e-aded-281d1a94f5ed",
                                                "text": "Yessir, we need you Yoinks. You're all we have, you are."
                                            },
                                            {
                                                "example_id": "dd84d562-fd01-44ad-bf0d-b57bf7865f5c",
                                                "sense_id": "805e36ee-94e0-313e-aded-281d1a94f5ed",
                                                "text": "You are all a bunch of yoinks who insult Budda!"
                                            },
                                            {
                                                "example_id": "9b2fec87-48ec-4814-a647-32a57f75f33e",
                                                "sense_id": "805e36ee-94e0-313e-aded-281d1a94f5ed",
                                                "text": "The fact that these mentating yoinks don't know what it it, or worse, refuse to even acknowledge its existence pegs their state of awareness."
                                            },
                                            {
                                                "example_id": "f73ef626-bc69-4d82-b89e-7539f4c1affd",
                                                "sense_id": "805e36ee-94e0-313e-aded-281d1a94f5ed",
                                                "text": "“What a bunch of yoinks we are, indeed,” Garvin said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8beb728b-6ede-3147-9fa5-0712b702e8fe",
                                        "entry_id": "ffad8e5c-95be-370e-a339-ac3d7bf749ec",
                                        "glosses": [
                                            "Used for emphasis or to express that one is impressed."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3ce0c0a-cbe1-46dc-92a7-1edf4d8c3426",
                                                "sense_id": "8beb728b-6ede-3147-9fa5-0712b702e8fe",
                                                "text": "Back in a pool game, Lindsey comes by between shots and leans over my shoulder and whispers, \"Don't look now, but that blonde girl is checking you out.\" YOINK!"
                                            },
                                            {
                                                "example_id": "abe8bdd8-d2ec-4032-b381-6357e9e0475b",
                                                "sense_id": "8beb728b-6ede-3147-9fa5-0712b702e8fe",
                                                "text": "yoink! The US will never close the border to Mexico. Politicians here don't have the political will to do such thing."
                                            },
                                            {
                                                "example_id": "f84dd1ec-1ba5-4ca5-ac3d-7a00556335cd",
                                                "sense_id": "8beb728b-6ede-3147-9fa5-0712b702e8fe",
                                                "text": "“What do you mean, don't kill me?” Major Healy said, sneering. “In case you didn't notice, I'm the one with the weapon.” “Oh, yeah,” Remo said. “Yoink.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d2c64d4-1ea4-3901-b095-74bc01525f91",
                                        "entry_id": "2eab523f-f89c-3edb-b3e5-a0f21e9c37c5",
                                        "glosses": [
                                            "Onomatopoeic, accompanying or describing a yank, swipe, or snatch."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81aef74f-02d7-4d16-900e-54ca2b623ced",
                                                "sense_id": "7d2c64d4-1ea4-3901-b095-74bc01525f91",
                                                "text": "Marge: But you look better, you don't sweat when you eat any more, and look – [holds up a wad of cash] You've saved more than a hundred dollars. I found it in your pants.\nHomer: [snatches money] Yoink!"
                                            },
                                            {
                                                "example_id": "7da047b9-1f19-49ee-85eb-09dadc72344d",
                                                "sense_id": "7d2c64d4-1ea4-3901-b095-74bc01525f91",
                                                "text": "Yoink! He snatched Granny Glee's frilly pink hat with his little feet."
                                            },
                                            {
                                                "example_id": "cf59125a-067a-4eba-a299-b7dd9618e383",
                                                "sense_id": "7d2c64d4-1ea4-3901-b095-74bc01525f91",
                                                "text": "The way I've always done this stunt is to grab my partner and jump us over together. It's absolute hell on my knees. I lean toward Brando and raise my eyebrows. “Yoink.” “Definite yoink,” he replies, equally inspired."
                                            },
                                            {
                                                "example_id": "4849f791-954c-47ae-84b1-5fe3840acf11",
                                                "sense_id": "7d2c64d4-1ea4-3901-b095-74bc01525f91",
                                                "text": "YOINK! Coach Pittman snatched the puck out of midair."
                                            },
                                            {
                                                "example_id": "413cc725-f480-4b42-a734-d7b0f412692e",
                                                "sense_id": "7d2c64d4-1ea4-3901-b095-74bc01525f91",
                                                "text": "2021 (November 13) \"Olivia & Yunan\" (Amphibia s3e7b) Yunan grabbing a crossbow\nOoh, ominous. After you, milady. Yoink!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aff6ee71-6000-34de-ab5f-e7faad33cb80",
                                        "entry_id": "7a46d8c7-321f-347b-adf7-e046ce760d04",
                                        "glosses": [
                                            "To yank or snatch."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a7d634-8a1b-48ec-976f-8a0b6cc1041a",
                                                "sense_id": "aff6ee71-6000-34de-ab5f-e7faad33cb80",
                                                "text": "I'm sure that there is pinching, punching, eye gouging, yoinking, hair pulling and who knows what else underneath where eyes can't follow, but he comes out and hands the referee the ball and hits the line again."
                                            },
                                            {
                                                "example_id": "282cdf1c-8987-4a90-b022-7ff590ae70a2",
                                                "sense_id": "aff6ee71-6000-34de-ab5f-e7faad33cb80",
                                                "text": "The first time he yoinked at my arm all three of us–me, doctor and bed –flew across the room."
                                            },
                                            {
                                                "example_id": "a70a9990-382a-486a-81b7-e06ebfa1dbf3",
                                                "sense_id": "aff6ee71-6000-34de-ab5f-e7faad33cb80",
                                                "text": "That was the stress that yoinked the whole support gantry down— like trying to stop a medium-sized car with one pull.”"
                                            },
                                            {
                                                "example_id": "176dc178-d02b-4490-9969-26974f6f825a",
                                                "sense_id": "aff6ee71-6000-34de-ab5f-e7faad33cb80",
                                                "text": "\"Hey!\" some AV kid said when I snuck up behind him and yoinked a microphone from his cart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2cf042-0fec-3b24-af7a-421befb6b10e",
                                        "entry_id": "7a46d8c7-321f-347b-adf7-e046ce760d04",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e633ac82-81dd-4d81-9f28-22ee5fd5860e",
                                                "sense_id": "9e2cf042-0fec-3b24-af7a-421befb6b10e",
                                                "text": "At the far end of the Shrine stands the Coronation Chair, built for Edward I; the shelf below the seat was made to house the Scottish Stone of Scone, which the sticky-fingered Edward yoinked in 1296 ..."
                                            },
                                            {
                                                "example_id": "73f17526-2bc5-4087-bdea-5ffdea6ba75c",
                                                "sense_id": "9e2cf042-0fec-3b24-af7a-421befb6b10e",
                                                "text": "I broke-and-entered the clinic last night and yoinked em.'"
                                            },
                                            {
                                                "example_id": "98af9a3b-41f0-4a20-ba67-9161b520144b",
                                                "sense_id": "9e2cf042-0fec-3b24-af7a-421befb6b10e",
                                                "text": "He had yoinked dozens off Gav over the years."
                                            },
                                            {
                                                "example_id": "b2210213-8116-42ed-81eb-536d0c2f61ed",
                                                "sense_id": "9e2cf042-0fec-3b24-af7a-421befb6b10e",
                                                "text": "Waiters were in on the ruse, and would frequently distract customers in order to facilitate the yoinking of oysters and caviar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09799240-b9c4-3694-abef-2f059b74b39e",
                                        "entry_id": "7a46d8c7-321f-347b-adf7-e046ce760d04",
                                        "glosses": [
                                            "To take or win (something that others want)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b461c7-650f-4195-9812-a1ae836fb779",
                                                "sense_id": "09799240-b9c4-3694-abef-2f059b74b39e",
                                                "text": "Jonas thinks he's such a free fucking spirit for sporting that Revolutionary War–esque overcoat he yoinked from that thrift shop in Philly."
                                            },
                                            {
                                                "example_id": "02910fb8-e6ed-40a8-8105-a3300a4b342c",
                                                "sense_id": "09799240-b9c4-3694-abef-2f059b74b39e",
                                                "text": "On my first four turns, I yoinked Australia. Playing Risk with these girls was so fun because in my whole life I've never seen two people happier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
