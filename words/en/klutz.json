    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "617da9da-fe4b-3deb-90b7-83698624bc3e",
                    "sense_definition": "A clumsy, awkward, or inept person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I dropped the tray and felt like such a <w>klutz</w> in front of everyone.",
                            "target_lang_translations": {
                                "es": "Se me cayó la bandeja y me sentí como un auténtico <w>torpe</w> delante de todos."
                            }
                        },
                        {
                            "text": "He is an absolute <w>klutz</w> on the dance floor, constantly stepping on people's toes.",
                            "target_lang_translations": {
                                "es": "Es un completo <w>patoso</w> en la pista de baile, pisándole los pies a la gente todo el tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "butterfingers"
                    ],
                    "common_phrases": [
                        "total klutz",
                        "clumsy klutz",
                        "complete klutz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Persona torpe, desmañada o poco hábil en sus movimientos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "torpe",
                                "target_lang_sense_clarification": "persona poco hábil o desmañada"
                            },
                            {
                                "target_lang_word": "patoso",
                                "target_lang_sense_clarification": "coloquial, especialmente en España"
                            },
                            {
                                "target_lang_word": "manazas",
                                "target_lang_sense_clarification": "coloquial, torpe con las manos"
                            }
                        ]
                    }
                }
            ]
        },
