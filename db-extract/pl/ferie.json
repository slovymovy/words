                                "target_senses": [
                                    {
                                        "sense_id": "91d33451-6807-3ef8-bafc-abccc416b7a8",
                                        "entry_id": "9c8d7f4c-8aa9-349e-abc4-ab48f88bd924",
                                        "glosses": [
                                            "schul- oder arbeits- oder semesterfreie Zeit einer staatlichen Institution, ausgenommen die Wochenenden und Feiertage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dec73bb-53b3-4074-883a-63131924b466",
                                                "sense_id": "91d33451-6807-3ef8-bafc-abccc416b7a8",
                                                "text": "Alle hatten Ferien, nur er musste weiterarbeiten."
                                            },
                                            {
                                                "example_id": "d8c0d7bf-087b-4394-8584-a5d989ab7d0c",
                                                "sense_id": "91d33451-6807-3ef8-bafc-abccc416b7a8",
                                                "text": "Ich gehe in die Ferien!"
                                            },
                                            {
                                                "example_id": "ff80990e-564b-49e3-a316-1fa9ef50e21c",
                                                "sense_id": "91d33451-6807-3ef8-bafc-abccc416b7a8",
                                                "text": "Ich habe ab Montag Ferien!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8348b796-3c45-364d-943b-e11a0d4b2c25",
                                        "entry_id": "9c8d7f4c-8aa9-349e-abc4-ab48f88bd924",
                                        "glosses": [
                                            "Urlaub^([2])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4746d012-bd2e-442e-a03a-05c8330318f1",
                                                "sense_id": "8348b796-3c45-364d-943b-e11a0d4b2c25",
                                                "text": "Alle hatten Ferien, nur er musste weiterarbeiten."
                                            },
                                            {
                                                "example_id": "eaeee562-4233-4882-953f-9498d742d10f",
                                                "sense_id": "8348b796-3c45-364d-943b-e11a0d4b2c25",
                                                "text": "Ich gehe in die Ferien!"
                                            },
                                            {
                                                "example_id": "cf417c2f-7de0-4466-888f-19d4893b1c25",
                                                "sense_id": "8348b796-3c45-364d-943b-e11a0d4b2c25",
                                                "text": "Ich habe ab Montag Ferien!"
                                            },
                                            {
                                                "example_id": "3a13930f-8015-491f-a6f5-55bc9b388a71",
                                                "sense_id": "8348b796-3c45-364d-943b-e11a0d4b2c25",
                                                "text": "„Ferien ist freie Zeit, Urlaub verplante Zeit. Angestellte, Beamte, Bauschlosser haben Urlaub, Kinder dagegen Ferien; ja, das geht so weit, dass Schüler in die Ferien fahren, ihre Lehrer aber in den Urlaub. Urlaub nimmt man sich und dann macht man ihn. Ferien hat man einfach. Urlaub ist abhängig vom Tarifvertrag und wird geplant, Ferien hängen von der Stimmung ab und beginnen ziellos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d45d0477-458f-4837-b09b-2d4876b29abb",
                        "source_entry_id": "b0b4a1d6-4384-3f28-863f-9533349cf6ab",
                        "source_sense_id": "df200432-6027-3511-8e53-a3bca6005471",
                        "source_sense_description": "Bildung: Ferien, Schulferien, meist im Winter und Frühjahr",
                        "target_lang_word": "Schulferien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulferien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "182fe704-1053-3175-b350-29261b233823",
                                        "entry_id": "c4ef9d87-35ea-339b-915a-403773e8a5f0",
                                        "glosses": [
                                            "zusammenhängende unterrichtsfreie Tage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c779af89-3ad1-4846-80de-49b32b86f181",
                                                "sense_id": "182fe704-1053-3175-b350-29261b233823",
                                                "text": "Isabella war die kompletten Schulferien krank."
                                            },
                                            {
                                                "example_id": "3a2ca316-637c-45c8-b7ab-9b1f0d4d2bc9",
                                                "sense_id": "182fe704-1053-3175-b350-29261b233823",
                                                "text": "„In den Schulferien sammelt er sie, liest die Stellen, über die er sich Notizen machte, noch einmal durch, ordnet die Zettel, auf die er sich meistens englische und französische Vokabeln, Satzkonstruktionen, Wendungen notiert hat und deren Bedeutung sich für ihn erst erklärt, wenn sie ihm zwei- oder dreimal begegnet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
