                        "sense_id": "a54db6c4-1417-3467-a448-5b39c82ee0a9",
                        "entry_id": "cc849b7b-059a-3155-adc9-effd5f48a3ec",
                        "glosses": [
                            "To find the best route between two points."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e989c3f1-4f03-4f46-8a0c-f811328b0ee7",
                                "sense_id": "a54db6c4-1417-3467-a448-5b39c82ee0a9",
                                "text": "If the warden has a targetable entity, is not investigating any disturbances, and is otherwise idle, it pathfinds toward the closest entity, prioritizing players over mobs."
                            },
                            {
                                "example_id": "0bd5775d-c195-444d-ac4a-973b1d0a1138",
                                "sense_id": "a54db6c4-1417-3467-a448-5b39c82ee0a9",
                                "text": "Has a sense of smell. It can detect and pathfind toward the general location of a player or mob through a \"smelling\" action."
                            },
                            {
                                "example_id": "8b0bd7af-b36c-4ac2-af2b-e48a8abfb738",
                                "sense_id": "a54db6c4-1417-3467-a448-5b39c82ee0a9",
                                "text": "If a villager cannot pathfind to its claimed site, both the site block and villager emit anger particles."
                            }
                        ]
                    }
