                ],
                "senses": [
                    {
                        "sense_id": "a2a44a78-19e3-3dfc-ba83-2cffa1ea1047",
                        "entry_id": "d71729d5-af9b-3c19-a757-78141ae08d7f",
                        "glosses": [
                            "Agir comme un geek ; passer son temps devant son ordinateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970a86ad-8c0a-45d6-9671-30f94b7b29a0",
                                "sense_id": "a2a44a78-19e3-3dfc-ba83-2cffa1ea1047",
                                "text": "Sacré Marc. La famille allait dormir. Les parents allaient dormir, en tout cas. […]. Marc, il geekait. […].Marc avait comme objectif de dormir dans la voiture, il restait donc en ligne sur son ordinateur."
                            },
                            {
                                "example_id": "769ddd76-f758-4631-83ac-fe4ffd5b3718",
                                "sense_id": "a2a44a78-19e3-3dfc-ba83-2cffa1ea1047",
                                "text": "Moi, je vous propose de faire marcher dix secondes vos neurones, mais non, vous, c'est « on geeke » toute la journée et on fait rien du dimanche."
                            },
                            {
                                "example_id": "23d89e45-0b7c-429b-828f-1f9a8ca9f7a5",
                                "sense_id": "a2a44a78-19e3-3dfc-ba83-2cffa1ea1047",
                                "text": "Sous-entendu, tu n'as pas mis la petite graine, donc j'ai le droit de geeker jusqu'à 2 heures du matin, même si j'ai contrôle de maths demain à 8 heures."
                            },
                            {
                                "example_id": "4668673d-565b-48bd-8668-8bcc153c209d",
                                "sense_id": "a2a44a78-19e3-3dfc-ba83-2cffa1ea1047",
                                "text": "Pourtant j’en ai passé, et j’en passe encore, des heures et des heures à geeker comme un ouf devant Street Fighter II."
                            }
                        ]
                    }
                ],
