                    },
                    {
                        "sense_id": "09647909-9d64-3b4e-8952-6b3ca3421bdf",
                        "entry_id": "c867869a-f22b-3e72-bacb-04ca5ea87eac",
                        "glosses": [
                            "Burin, grattoir nucléiforme : outil de pierre taillée qui n'est pas formé d’un éclat, mais du nucléus même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de41383f-e484-4a86-8b9f-515ece5b377d",
                                "sense_id": "09647909-9d64-3b4e-8952-6b3ca3421bdf",
                                "text": "Un total de 69 pièces a été isolé …, toutes issues de galets côtiers en silex. Les supports concernés sont soit nucléiformes, soit des éclats assez épais plus ou moins corticaux, et ils témoignent tous d’un débitage par percussion posée sur enclume."
                            }
                        ]
