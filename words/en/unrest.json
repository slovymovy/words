{
    "word_family": [
        "rest",
        "restless",
        "restlessness",
        "restful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "606bda6f-9528-3d58-a524-8e03a663d8b6",
                    "sense_definition": "A state of public disturbance, confusion, or turbulence, typically involving protests, riots, or political instability.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is struggling to control the growing civil <w>unrest</w> in the capital city.",
                            "target_lang_translations": {
                                "ru": "Правительство изо всех сил пытается контролировать растущие гражданские <w>беспорядки</w> в столице."
                            }
                        },
                        {
                            "text": "After the controversial election results were announced, the country experienced a period of intense political <w>unrest</w>.",
                            "target_lang_translations": {
                                "ru": "После объявления спорных результатов выборов страна пережила период острых политических <w>волнений</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "turmoil",
                        "disorder",
                        "agitation",
                        "strife"
                    ],
                    "antonyms": [
                        "peace",
                        "calm",
                        "stability"
                    ],
                    "common_phrases": [
                        "civil unrest",
                        "political unrest",
                        "social unrest",
                        "widespread unrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние общественных беспорядков, смятения или турбулентности, обычно включающее протесты, бунты или политическую нестабильность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядки",
                                "target_lang_sense_clarification": "массовые нарушения общественного порядка"
                            },
                            {
                                "target_lang_word": "волнения",
                                "target_lang_sense_clarification": "активные протесты или социальное недовольство"
                            },
                            {
                                "target_lang_word": "смута",
                                "target_lang_sense_clarification": "период мятежей и политической нестабильности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a623f2b9-10d6-3b0d-a313-5a6148d2914d",
                    "sense_definition": "A feeling of disturbance or lack of peace within a person; mental or emotional agitation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internal state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite her outward success, she suffered from a deep sense of inner <w>unrest</w> that she could not explain.",
                            "target_lang_translations": {
                                "ru": "Несмотря на внешний успех, она страдала от глубокого чувства внутреннего <w>беспокойства</w>, которое не могла объяснить."
                            }
                        },
                        {
                            "text": "The quiet of the countryside helped to soothe his mental <w>unrest</w> after a stressful year.",
                            "target_lang_translations": {
                                "ru": "Тишина сельской местности помогла унять его душевную <w>тревогу</w> после напряженного года."
                            }
                        }
                    ],
                    "synonyms": [
                        "unease",
                        "restlessness",
                        "anxiety",
                        "disquiet"
                    ],
                    "antonyms": [
                        "tranquility",
                        "serenity",
                        "contentment"
                    ],
                    "common_phrases": [
                        "inner unrest",
                        "mental unrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство тревоги или отсутствие покоя внутри человека; ментальное или эмоциональное возбуждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "отсутствие душевного покоя"
                            },
                            {
                                "target_lang_word": "тревога",
                                "target_lang_sense_clarification": "эмоциональное волнение и опасение"
                            },
                            {
                                "target_lang_word": "неупокоенность",
                                "target_lang_sense_clarification": "внутреннее состояние отсутствия мира с самим собой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}