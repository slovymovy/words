{
    "word_family": [
        "сближение",
        "сближаться",
        "близкий",
        "близость",
        "приближать",
        "сблизить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3552896-07bb-364b-ae9c-e0005ba24db2",
                    "sense_definition": "Делать кого-либо внутренне, духовно ближе, объединять общими интересами или чувствами.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отношения",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Совместная работа над сложным проектом всегда <w>сближает</w> людей.",
                            "target_lang_translations": {
                                "en": "Working together on a difficult project always <w>brings</w> people <w>closer</w>."
                            }
                        },
                        {
                            "text": "Общие трудности и переживания заметно <w>сближали</w> новых соседей.",
                            "target_lang_translations": {
                                "en": "Shared difficulties and experiences noticeably <w>drew</w> the new neighbors <w>together</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "роднить",
                        "объединять",
                        "сплачивать"
                    ],
                    "antonyms": [
                        "разобщать",
                        "отдалять"
                    ],
                    "common_phrases": [
                        "сближать людей"
                    ],
                    "target_lang_definitions": {
                        "en": "To make people emotionally or spiritually closer; to unite them through shared interests or experiences."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring closer",
                                "target_lang_sense_clarification": "emotionally or socially"
                            },
                            {
                                "target_lang_word": "unite",
                                "target_lang_sense_clarification": "by common bonds or goals"
                            },
                            {
                                "target_lang_word": "draw together",
                                "target_lang_sense_clarification": "fostering a closer relationship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e78a2f38-af86-3763-86ab-55cfd086cb67",
                    "sense_definition": "Уменьшать расстояние между кем-либо или чем-либо в пространстве.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "пространство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер осторожно <w>сближал</w> края детали, чтобы аккуратно их склеить.",
                            "target_lang_translations": {
                                "en": "The craftsman carefully <w>brought</w> the edges of the part <w>closer</w> to glue them neatly."
                            }
                        },
                        {
                            "text": "Новая скоростная трасса <w>сближает</w> два крупных города.",
                            "target_lang_translations": {
                                "en": "The new highway <w>brings</w> the two major cities <w>closer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "приближать",
                        "соединять"
                    ],
                    "antonyms": [
                        "удалять",
                        "разодвигать"
                    ],
                    "common_phrases": [
                        "сближать края"
                    ],
                    "target_lang_definitions": {
                        "en": "To reduce the physical distance between people or objects in space."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring closer",
                                "target_lang_sense_clarification": "in physical distance"
                            },
                            {
                                "target_lang_word": "bring together",
                                "target_lang_sense_clarification": "moving objects towards each other"
                            },
                            {
                                "target_lang_word": "appose",
                                "target_lang_sense_clarification": "to place next to or juxtapose (formal/technical)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}