                        "source_sense_id": "8afacf2d-b263-354d-abdf-87a98958ef81",
                        "target_lang_word": "razor blade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "razor blade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "321c18be-43ee-3372-b72e-26a980744e7e",
                                        "entry_id": "c39876ee-ca08-3344-93d5-628bcf349319",
                                        "glosses": [
                                            "A thin piece of steel with a sharp edge that can be fitted into a razor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a972b1c-7e5f-33e6-af51-830e6a04a48f",
                                        "entry_id": "c39876ee-ca08-3344-93d5-628bcf349319",
                                        "glosses": [
                                            "A replaceable cartridge in which razor blades are set, fitted into a razor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba9d6333-2e4c-3538-a85d-45c1d9e55ad1",
                                        "entry_id": "c39876ee-ca08-3344-93d5-628bcf349319",
                                        "glosses": [
                                            "A thin interchangeable blade for a utility knife (especially, that of a Stanley knife) that is similar to a razor blade stricto sensu (in size, thinness, and sharpness)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "razor blade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "587b4b4f-50bb-3262-8482-1cfad7d2c096",
                                        "entry_id": "14b35492-8371-3267-8d95-7bae9ab6389d",
                                        "glosses": [
                                            "Alternative form of razor-blade."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2360dc53-f738-4565-8164-8c7904ad94b3",
                                                "sense_id": "587b4b4f-50bb-3262-8482-1cfad7d2c096",
                                                "text": "In the razor blade tests DeVries conducted the person who was razor blading it before cure was exactly the same person that was doing it after cure."
                                            },
                                            {
                                                "example_id": "cad54b7e-23c5-4cd9-8cd0-c599f9197450",
                                                "sense_id": "587b4b4f-50bb-3262-8482-1cfad7d2c096",
                                                "text": "It's unlikely that anyone will razor blade your pack open inside a hotel, but light fingers may, occasionally, dip into unlocked luggage."
                                            },
                                            {
                                                "example_id": "30d86b16-d7f3-4a37-ad8c-a053a8ae9431",
                                                "sense_id": "587b4b4f-50bb-3262-8482-1cfad7d2c096",
                                                "text": "I was the last man aboard. The last to feel her as a living vessel before she became a steel hulk and was razor bladed."
                                            },
                                            {
                                                "example_id": "358b30f7-acf2-416c-b4e9-be9ca5abf72c",
                                                "sense_id": "587b4b4f-50bb-3262-8482-1cfad7d2c096",
                                                "text": "To those of us living in democracies today, the image of my father sitting at home and razor blading out a page to glue in the newly updated replacement might seem ridiculous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
