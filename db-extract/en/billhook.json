                    {
                        "translation_id": "e8dff1ab-3a48-4dd7-8e08-41578802818a",
                        "source_entry_id": "56142799-b81e-328e-abe4-ea62328a1bb8",
                        "source_sense_description": "agricultural implement",
                        "target_lang_word": "snoeimes",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snoeimes",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d27a587-9cc2-39d3-8d61-c5babb5d27cb",
                                        "entry_id": "8b8c0cf7-9c36-3c9c-a958-8656070a939e",
                                        "glosses": [
                                            "inklapbaar mes, met een gekromd lemmet, het is een tuingereedschap, bedoeld om takken van geringe dikte door te snijden (snoeien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ec80ef-9336-48b7-9e70-af94818822ab",
                                                "sense_id": "7d27a587-9cc2-39d3-8d61-c5babb5d27cb",
                                                "text": "Ieder jaar weer sta ik in het voorjaar te kijken naar wat er van de salie over is. Een onooglijke bos hout die verrassend snel al in blad komt. Laat je dat gaan dan wordt die plant megagroot en uiteindelijk heel lelijk. Ik ben streng en zet het snoeimes er in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2802015-7813-3a1f-8059-b6edda1c481a",
                                        "entry_id": "8b8c0cf7-9c36-3c9c-a958-8656070a939e",
                                        "glosses": [
                                            "bezuinigingsmaatregelen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "953308ed-7d8b-4c87-9a32-1f792043bcc7",
                                                "sense_id": "f2802015-7813-3a1f-8059-b6edda1c481a",
                                                "text": "Kostenbesparingen zijn daarom de enige uitweg. Niet voor niets stelde het postbedrijf dat €115 miljoen extra bespaard kan worden, vooral op ondersteunend personeel. De afgelopen jaren heeft PostNL al enorm bezuinigd, waarbij de vraag is hoeveel rek er nog in het bedrijf zit. Het snoeimes lijkt wat dat betreft ook haast bot te worden."
                                            },
                                            {
                                                "example_id": "5512d3ad-4ec9-4698-96a6-2e6f3331c5b6",
                                                "sense_id": "f2802015-7813-3a1f-8059-b6edda1c481a",
                                                "text": "Waar bij KLM het snoeimes volop wordt gehanteerd, lijkt er bij zustermaatschappij Air France geen vuiltje aan de lucht. Er zijn daar nog steeds geen concrete afspraken gemaakt met de vakbonden over bezuinigingen. Er wordt juist gebroed op uitbreidingsplannen, onder meer voor een prijsvechter op intercontinentale routes, zo werd gisteren bekend in de Franse media."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
