                                    {
                                        "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                        "entry_id": "2c6ab452-4a54-3976-82dc-16ca23026823",
                                        "glosses": [
                                            "Organisation, die eine Ware für jemanden besorgt oder herstellt und gegebenenfalls auch ausliefern lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbce2ba1-6e0b-47b7-b43a-bba1920033c2",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "China ist ein wichtiger Lieferant für seltene Erden."
                                            },
                                            {
                                                "example_id": "d30adf47-3cc0-40de-8577-6e6b70bfa435",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "Seit April haben die Lieferanten kein Geld mehr gesehen."
                                            },
                                            {
                                                "example_id": "01fff177-dae6-4adf-93cb-dbdb9b58bc7a",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "Die Zahl der potentiellen Lieferanten ist nicht so hoch, wie wir uns es erhofften."
                                            },
                                            {
                                                "example_id": "89ecee8a-d09d-47d5-8588-96c646671727",
                                                "sense_id": "2531bebf-5b71-3de4-be6d-6c7db3167d37",
                                                "text": "Die Ersatzteile bezieht unsere Firma überwiegend von ausländischen Lieferanten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                        "entry_id": "2c6ab452-4a54-3976-82dc-16ca23026823",
                                        "glosses": [
                                            "Person, welche Waren ausliefert beziehungsweise zustellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9179e7b-2983-473d-9613-dd7463657598",
                                                "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                                "text": "Lieferanten bitte durch den Nebeneingang!"
                                            },
                                            {
                                                "example_id": "73253618-5fcb-4fcc-a217-252acd40e538",
                                                "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                                "text": "Der Lieferant wartet draußen, er möchte gerne noch eine Unterschrift auf der Kopie."
                                            },
                                            {
                                                "example_id": "4f15c2f8-824f-4d9b-8f3e-ae66e4ab5190",
                                                "sense_id": "997aa000-6f1d-3896-b630-5fe6a64fd258",
                                                "text": "„Unten stand ein Schlitten neben dem Eingang für Lieferanten und Dienstboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56c71221-2d80-4449-8dce-aa7b7912c65f",
                        "source_entry_id": "b5d6b1fe-ba92-3e0f-9217-3098b8e09dc4",
                        "source_sense_id": "57b21db6-ccaa-3dbe-84d3-f87d518b1233",
                        "target_lang_word": "поставщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поставщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c8331b90-1012-3526-8f7a-988742c7c74c",
                                        "entry_id": "c0238b6a-b6ca-3b9c-b249-6bdede6df485",
                                        "glosses": [
                                            "лицо или учреждение, занимающееся поставками чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeedaa7a-d810-4704-bfbc-1763e6dc6ef6",
                                                "sense_id": "c8331b90-1012-3526-8f7a-988742c7c74c",
                                                "text": "«Но самое неприятное, что контакты с западными поставщиками автомобилей подписаны до конца года."
                                            },
                                            {
                                                "example_id": "eface7ad-655f-4368-9b92-1ce425c40c8b",
                                                "sense_id": "c8331b90-1012-3526-8f7a-988742c7c74c",
                                                "text": "А среди поставщиков спецтехники, например, для военных нужд, таких компаний очень много. Идея стратегии фокусирования заключается в концентрации на какой-то узкой полоске рынка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
