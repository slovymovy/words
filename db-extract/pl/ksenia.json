                                    {
                                        "sense_id": "031814ba-a45a-32ce-b596-637fcd93fd24",
                                        "entry_id": "6ad5fbe2-60aa-33ac-9c5b-718a4df2c787",
                                        "glosses": [
                                            "Prénom féminin slave (polonais, russe, slovaque)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e86c6a3-bfb9-4acb-8f37-778d4a1e0d1d",
                                                "sense_id": "031814ba-a45a-32ce-b596-637fcd93fd24",
                                                "text": "Et c’est là qu’on nous parle de Ksenia Solo, une actrice canadienne de 26 ans qui serait pressentie pour interpréter la fille de Han Solo et Leia !"
                                            },
                                            {
                                                "example_id": "4a0569f5-58ea-40b4-9327-f1f16aee8053",
                                                "sense_id": "031814ba-a45a-32ce-b596-637fcd93fd24",
                                                "text": "Marion Bartoli n’a pas traîné contre Ksenia Pervak pour son entrée en lice à Moscou."
                                            },
                                            {
                                                "example_id": "7fe076b2-5e40-4f06-81fd-d8d7bbd286a3",
                                                "sense_id": "031814ba-a45a-32ce-b596-637fcd93fd24",
                                                "text": "Ksenia Makarova a enlevé le titre national Dames de patinage artistique, à Saint-Pétersbourg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
