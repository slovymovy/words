                ],
                "senses": [
                    {
                        "sense_id": "14e4a947-6311-3ce8-aa29-87f2cb9df4d1",
                        "entry_id": "96d37f07-080e-3b18-89f9-aae29c4e187c",
                        "glosses": [
                            "A scientist who studies glaciers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "013312e4-0b71-48bd-ba2d-84ee0b78394a",
                                "sense_id": "14e4a947-6311-3ce8-aa29-87f2cb9df4d1",
                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                            },
                            {
                                "example_id": "65ad4146-61c7-4d47-9b72-c618e9bf0d28",
                                "sense_id": "14e4a947-6311-3ce8-aa29-87f2cb9df4d1",
                                "text": "The 10-inch increase forecast in the new study, which does not give a timeline, could be much higher if temperatures continue to rise, as they almost certainly will, said Jason Box, a glaciologist at the Geological Survey of Denmark and Greenland who was the paper’s lead author."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4a55c0a-0db4-4493-b160-3dac912fee8b",
