                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Käufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06aff9df-857f-3486-aa0c-927bb117ff7b",
                                        "entry_id": "b5490794-9850-3dff-80e7-6df61a049d87",
                                        "glosses": [
                                            "jemand, der gegen Bezahlung etwas in Besitz nimmt, etwas kauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bcdf771-769b-43c3-b328-0dcc865006ef",
                                                "sense_id": "06aff9df-857f-3486-aa0c-927bb117ff7b",
                                                "text": "Erst nach zehn Jahre dauernden Verkaufsversuchen hat sich ein Käufer für die Liegenschaft gefunden."
                                            },
                                            {
                                                "example_id": "5b6005b2-1a7f-41f5-8f6b-7a68562d4ca4",
                                                "sense_id": "06aff9df-857f-3486-aa0c-927bb117ff7b",
                                                "text": "„Erst später gingen über das Warenangebot der Geschäfte die überregionalen Bezeichnungen allmählich in den Sprachgebrauch der Käufer aller Schichten und Sprachlandschaften über.“"
                                            },
                                            {
                                                "example_id": "02170dfc-3f50-4941-a515-cecf23d832da",
                                                "sense_id": "06aff9df-857f-3486-aa0c-927bb117ff7b",
                                                "text": "„Die meisten seiner Käufer schätzten realistische Bilder, die Ähnlichkeit mit der Wirklichkeit faszinierte sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
