                "senses": [
                    {
                        "sense_id": "16390445-d9b6-3bcf-8f2b-12912edbcb7f",
                        "entry_id": "e86767e8-0a5c-38db-b218-60afb36d1748",
                        "glosses": [
                            "(abgezogenes) Fell einer Ziege"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acbba8ba-bd60-4351-9f26-88b587451fdb",
                                "sense_id": "16390445-d9b6-3bcf-8f2b-12912edbcb7f",
                                "text": "„Das maskenartige Gorgohaupt, das Gorgoneion, trug fortan Athene entweder als Schildzeichen oder an ihrem Brustpanzer, auf dem heiligen Ziegenfell, der Aigis, befestigt. Die Gorgo galt sogar selbst als Zicklein und ursprüngliche Trägerin jenes Ziegenfelles.“"
                            },
                            {
                                "example_id": "5faa0a9c-44fc-4753-9e78-b3dddc4a46f9",
                                "sense_id": "16390445-d9b6-3bcf-8f2b-12912edbcb7f",
                                "text": "„Felle stellen als das Ausgangsmaterial für die Lederherstellung einen nicht unerheblichen Wert dar. Ziegenfelle nehmen eine bevorzugte Stellung ein, da aus ihnen feines Leder hergestellt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
