{
    "word_family": [
        "requital",
        "unrequited"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26427a52-a5fb-35e1-a1c7-b0b61ef0e2f0",
                    "sense_definition": "To respond to or return feelings, especially love or affection.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "return_feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loved her deeply for many years, but she never <w>requited</w> his feelings."
                        },
                        {
                            "text": "It was painful to discover that his intense devotion was not <w>requited</w> in the same way."
                        }
                    ],
                    "common_phrases": [
                        "requite affection",
                        "requite love"
                    ]
                },
                {
                    "sense_id": "84372429-6b3d-3f0e-96b5-e7de167760a8",
                    "sense_definition": "To repay, recompense, or reward someone for a favour, service, or kindness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recompense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked for an opportunity to <w>requite</w> her host for his wonderful generosity."
                        },
                        {
                            "text": "The generous gift was meant to <w>requite</w> the doctor for saving his father's life."
                        }
                    ],
                    "common_phrases": [
                        "requite kindness"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often literary or formal"
                        }
                    ]
                },
                {
                    "sense_id": "f4baba71-6a6f-3bdc-b516-d7a85700cf0f",
                    "sense_definition": "To retaliate against or take revenge for an injury, wrong, or insult.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "revenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He vowed that he would someday <w>requite</w> the terrible injustice done to his family."
                        },
                        {
                            "text": "Instead of seeking to <w>requite</w> the insult, the leader urged his followers toward peace."
                        }
                    ],
                    "synonyms": [
                        "avenge",
                        "retaliate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or archaic contexts"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f44a8395-6783-3b77-a89c-1c688cab82ba",
                    "sense_definition": "Compensation, repayment, or recompense for damage, loss, or service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recompense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accepted the silver coin in <w>requite</w> for his hard labour."
                        },
                        {
                            "text": "She demanded some form of justice in <w>requite</w> of the great damage caused."
                        }
                    ],
                    "common_phrases": [
                        "in requite for"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Largely superseded by requital"
                        }
                    ]
                }
            ]
        }
    ]
}