{
    "word_family": [
        "discriminate",
        "discrimination",
        "indiscriminate",
        "indiscrimination"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                    "sense_definition": "In a random manner, without making careful distinctions or choices.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was accused of firing employees <w>indiscriminately</w> without reviewing their performance.",
                            "target_lang_translations": {
                                "zh": "这家公司被指控在没有评估员工表现的情况下<w>不加区分地</w>解雇员工。"
                            }
                        },
                        {
                            "text": "She tended to apply <w>indiscriminately</w> for every job she saw online, regardless of the qualifications.",
                            "target_lang_translations": {
                                "zh": "她倾向于<w>盲目地</w>申请她在网上看到的每一份工作，而不考虑自己的资历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "randomly",
                        "haphazardly",
                        "aimlessly",
                        "indifferently"
                    ],
                    "antonyms": [
                        "selectively",
                        "discriminatingly"
                    ],
                    "common_phrases": [
                        "apply indiscriminately",
                        "scattered indiscriminately",
                        "attacked indiscriminately"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不加区分、不加选择地，通常带有随意或盲目的意味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不加区分地",
                                "target_lang_sense_clarification": "强调在行动或判断时缺乏选择性或标准。"
                            },
                            {
                                "target_lang_word": "盲目地",
                                "target_lang_sense_clarification": "强调缺乏目的性或深思熟虑。"
                            },
                            {
                                "target_lang_word": "随意地",
                                "target_lang_sense_clarification": "强调行为的随机性和缺乏严谨性。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}