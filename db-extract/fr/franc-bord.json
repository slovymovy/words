                "senses": [
                    {
                        "sense_id": "43e37f87-e626-329f-9650-93d017b0483f",
                        "entry_id": "7069a1e4-3d14-3041-a8b3-2be0cc3c8900",
                        "glosses": [
                            "Terrain laissé libre sur le bord et le long d’une rivière, d’un canal, en particulier entre le cour d’eau et le chemin de halage ou le marchepied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6f49f31-4e69-4515-95b7-b413467c64ff",
                                "sense_id": "43e37f87-e626-329f-9650-93d017b0483f",
                                "text": "La contribution pour les maisons éclusières situées au bord des canaux appartenant à l’État et destinées au logement des gardiens chargés de la conservation des écluses, est, comme celles pour les bacs, canaux, et francs-bords à la charge de la Régie."
                            },
                            {
                                "example_id": "631b81c6-3162-4475-9e29-048a604bf82e",
                                "sense_id": "43e37f87-e626-329f-9650-93d017b0483f",
                                "text": "De fait, René se sentait apaisé plus que ne l'eût été aucun mortel en un lieu moins épouvantable qu'un franc-bord de canal au milieu de la nuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "93110a74-846d-33ae-9f2b-88afc5774ef3",
                        "entry_id": "7069a1e4-3d14-3041-a8b3-2be0cc3c8900",
                        "glosses": [
                            "Bordage qui couvre un vaisseau de la quille à la préceinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515df0e1-1dee-4c38-aaff-026a66e0d81f",
                                "sense_id": "93110a74-846d-33ae-9f2b-88afc5774ef3",
                                "text": "Le knörr n'avait pas le prestige du drakkar — un navire d'attaque à l'étrave surmontée d'une tête de dragon et aux boucliers accrochés sur toute la longueur du franc-bord — qui fut utilisé pour lancer les raids meurtriers sur les côtes de la Grande-Bretagne et de l'Europe continentale."
                            }
                        ]
                    }
