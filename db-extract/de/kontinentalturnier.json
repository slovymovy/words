                "senses": [
                    {
                        "sense_id": "bde48867-c112-3b30-ba48-1be60f88c6c8",
                        "entry_id": "65923cf3-6b9e-3180-8aa3-b9232ed29a3e",
                        "glosses": [
                            "sportlicher Wettkampf, an dem Personen aus einem bestimmten Kontinent teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19060991-243e-42f2-b8cd-db1bf2ce4274",
                                "sense_id": "bde48867-c112-3b30-ba48-1be60f88c6c8",
                                "text": "„Bei früheren Kontinental- und Weltturnieren wurden Änderungen meist noch nicht umgesetzt, sondern erst mit Start der nationalen Ligen.“"
                            },
                            {
                                "example_id": "9d1e5a2f-8c6e-4738-a05d-6b3ebaa9c23f",
                                "sense_id": "bde48867-c112-3b30-ba48-1be60f88c6c8",
                                "text": "„Am Samstag beginnt das Kontinentalturnier, das in dieser Form seit 1991 alle zwei Jahre ausgetragen wird, wie seither immer auch dieses Mal in den USA, in der Ausgabe 2021 ohne einen Co-Gastgeber.“"
                            }
                        ],
