{
    "word_family": [
        "beforehand",
        "afore",
        "aforementioned",
        "aforesaid"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "35461d09-f153-35e5-898c-2ce1f7e88974",
                    "sense_definition": "Earlier than in time.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I want this report finished <w>before</w> Monday morning.",
                            "target_lang_translations": {
                                "ru": "Я хочу, чтобы этот отчет был закончен <w>до</w> утра понедельника."
                            }
                        },
                        {
                            "text": "Please wash your hands <w>before</w> dinner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вымой руки <w>перед</w> ужином."
                            }
                        }
                    ],
                    "synonyms": [
                        "previous to",
                        "prior to",
                        "ere"
                    ],
                    "antonyms": [
                        "after",
                        "later than"
                    ],
                    "common_phrases": [
                        "before dinner",
                        "before Monday",
                        "the day before"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раньше по времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "до",
                                "target_lang_sense_clarification": "предлог времени"
                            },
                            {
                                "target_lang_word": "пе́ред",
                                "target_lang_sense_clarification": "непосредственно перед событием"
                            },
                            {
                                "target_lang_word": "пре́жде",
                                "target_lang_sense_clarification": "книжный вариант"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d00f7dd-f5c6-3cba-9e2a-14f1fa9413a7",
                    "sense_definition": "In front of in space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood <w>before</w> me in the queue.",
                            "target_lang_translations": {
                                "ru": "Он стоял <w>передо</w> мной в очереди."
                            }
                        },
                        {
                            "text": "We sat <w>before</w> the fire to warm ourselves during the cold night.",
                            "target_lang_translations": {
                                "ru": "Мы сидели <w>перед</w> огнем, чтобы согреться холодной ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead of",
                        "in front of"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "common_phrases": [
                        "before the fire",
                        "stand before"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впереди в пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́ред",
                                "target_lang_sense_clarification": "напротив или впереди чего-либо"
                            },
                            {
                                "target_lang_word": "пред",
                                "target_lang_sense_clarification": "книжный или поэтический вариант"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4bd09c-516f-3fc7-9906-a4594312bd5e",
                    "sense_definition": "In the presence of.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician performed <w>before</w> the troops in North Africa.",
                            "target_lang_translations": {
                                "ru": "Музыкант выступал <w>перед</w> войсками в Северной Африке."
                            }
                        },
                        {
                            "text": "The president spoke <w>before</w> a joint session of Congress.",
                            "target_lang_translations": {
                                "ru": "Президент выступил <w>перед</w> совместным заседанием Конгресса."
                            }
                        }
                    ],
                    "synonyms": [
                        "in front of"
                    ],
                    "common_phrases": [
                        "before the court",
                        "appear before"
                    ],
                    "target_lang_definitions": {
                        "ru": "В чьем-либо присутствии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́ред",
                                "target_lang_sense_clarification": "в присутствии кого-либо"
                            },
                            {
                                "target_lang_word": "пред",
                                "target_lang_sense_clarification": "торжественно, перед лицом кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42acbf01-0fc3-3572-9391-f53281de0442",
                    "sense_definition": "In front of, according to a formal system of ordering items.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In alphabetical order, cat comes <w>before</w> dog.",
                            "target_lang_translations": {
                                "ru": "В алфавитном порядке слово «cat» идет <w>перед</w> «dog»."
                            }
                        },
                        {
                            "text": "The number five comes <w>before</w> six in the sequence.",
                            "target_lang_translations": {
                                "ru": "Число пять идет <w>перед</w> шестеркой в последовательности."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead of"
                    ],
                    "antonyms": [
                        "after"
                    ],
                    "common_phrases": [
                        "comes before"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впереди согласно формальному порядку или последовательности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́ред",
                                "target_lang_sense_clarification": "в последовательности"
                            },
                            {
                                "target_lang_word": "до",
                                "target_lang_sense_clarification": "предшествуя чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "229458b9-8d46-3b1c-ae73-369130aafb39",
                    "sense_definition": "In store for, in the future of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are young and your whole life is <w>before</w> you.",
                            "target_lang_translations": {
                                "ru": "Ты молод, и вся твоя жизнь еще <w>впереди</w>."
                            }
                        },
                        {
                            "text": "Great challenges lie <w>before</w> us as we start this project.",
                            "target_lang_translations": {
                                "ru": "Большие трудности стоят <w>перед</w> нами в начале этого проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead of"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "common_phrases": [
                        "life before you",
                        "lie before"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in a literary or motivational context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В будущем, ожидает кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́ред",
                                "target_lang_sense_clarification": "ожидает впереди"
                            },
                            {
                                "target_lang_word": "впереди́",
                                "target_lang_sense_clarification": "в будущем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef60913-a2c6-3ee4-a1bd-ea42d8f19782",
                    "sense_definition": "Under consideration, judgment, or authority of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The case laid <w>before</w> the panel aroused nothing but ridicule.",
                            "target_lang_translations": {
                                "ru": "Дело, представленное <w>перед</w> комиссией, не вызвало ничего, кроме насмешек."
                            }
                        },
                        {
                            "text": "The proposal is currently <w>before</w> the committee for review.",
                            "target_lang_translations": {
                                "ru": "Предложение в настоящее время находится <w>на рассмотрении</w> комитета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "laid before",
                        "case before"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "На рассмотрении, суде или под властью кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пе́ред",
                                "target_lang_sense_clarification": "на рассмотрении органа или лица"
                            },
                            {
                                "target_lang_word": "на рассмотре́нии",
                                "target_lang_sense_clarification": "официальный контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b625ee07-cc32-3408-95d0-36156c1bf041",
                    "sense_definition": "At a higher or greater position than, in a ranking or priority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "priority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An entrepreneur often puts market share and profit <w>before</w> quality.",
                            "target_lang_translations": {
                                "ru": "Предприниматель часто ставит долю рынка и прибыль <w>выше</w> качества."
                            }
                        },
                        {
                            "text": "He always puts his family's needs <w>before</w> his own career.",
                            "target_lang_translations": {
                                "ru": "Он всегда ставит нужды семьи <w>превыше</w> собственной карьеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead of"
                    ],
                    "antonyms": [
                        "after"
                    ],
                    "common_phrases": [
                        "put before"
                    ],
                    "target_lang_definitions": {
                        "ru": "На более высокой позиции в рейтинге или приоритете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пре́жде",
                                "target_lang_sense_clarification": "важнее чем"
                            },
                            {
                                "target_lang_word": "вы́ше",
                                "target_lang_sense_clarification": "в приоритете"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ab50674b-313c-39fd-938f-8ff757eeb450",
                    "sense_definition": "At an earlier time.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never done this <w>before</w>.",
                            "target_lang_translations": {
                                "ru": "Я никогда не делал этого <w>раньше</w>."
                            }
                        },
                        {
                            "text": "I think we have met somewhere <w>before</w>.",
                            "target_lang_translations": {
                                "ru": "Думаю, мы уже где-то встречались <w>ранее</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "previously"
                    ],
                    "antonyms": [
                        "after"
                    ],
                    "common_phrases": [
                        "never before",
                        "ever before",
                        "long before"
                    ],
                    "target_lang_definitions": {
                        "ru": "В более раннее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ра́ньше",
                                "target_lang_sense_clarification": "в прошлом"
                            },
                            {
                                "target_lang_word": "ра́нее",
                                "target_lang_sense_clarification": "более формально"
                            },
                            {
                                "target_lang_word": "пре́жде",
                                "target_lang_sense_clarification": "в прежние времена"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2122281c-5f7b-3567-bbac-f374f0438ba4",
                    "sense_definition": "In advance in position or sequence; ahead.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked behind while they went <w>before</w>.",
                            "target_lang_translations": {
                                "ru": "Мы шли сзади, пока они шли <w>впереди</w>."
                            }
                        },
                        {
                            "text": "The scouts were sent <w>before</w> to check the path.",
                            "target_lang_translations": {
                                "ru": "Разведчики были посланы <w>вперёд</w>, чтобы проверить путь."
                            }
                        }
                    ],
                    "synonyms": [
                        "ahead",
                        "in front"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "common_phrases": [
                        "go before"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern speech than 'ahead'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Впереди по позиции или последовательности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впереди́",
                                "target_lang_sense_clarification": "впереди по пути"
                            },
                            {
                                "target_lang_word": "вперёд",
                                "target_lang_sense_clarification": "направляясь вперед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bb475a4-ab82-3335-a140-2800a694f438",
                    "sense_definition": "At the front end.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elephant has a little tail behind and a large trunk <w>before</w>.",
                            "target_lang_translations": {
                                "ru": "У слона маленький хвост сзади и большой хобот <w>спереди</w>."
                            }
                        },
                        {
                            "text": "The ship was damaged both behind and <w>before</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Корабль был поврежден и с кормы, и <w>с носа</w> во время шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "in front"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in old literature or poetry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "С передней стороны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спе́реди",
                                "target_lang_sense_clarification": "на передней части"
                            },
                            {
                                "target_lang_word": "спереди́",
                                "target_lang_sense_clarification": "в передней части"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "a33308ae-f56f-3cf1-b09e-87da25d37fe8",
                    "sense_definition": "In advance of the time when.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Brush your teeth <w>before</w> you go to bed.",
                            "target_lang_translations": {
                                "ru": "Почисти зубы, <w>прежде чем</w> ложиться спать."
                            }
                        },
                        {
                            "text": "Finish your homework <w>before</w> the teacher arrives.",
                            "target_lang_translations": {
                                "ru": "Закончи домашнее задание <w>до того, как</w> придет учитель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "before you go"
                    ],
                    "target_lang_definitions": {
                        "ru": "До того момента, как."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пре́жде чем",
                                "target_lang_sense_clarification": "союз времени"
                            },
                            {
                                "target_lang_word": "пе́ред тем как",
                                "target_lang_sense_clarification": "непосредственно перед действием"
                            },
                            {
                                "target_lang_word": "до того́, как",
                                "target_lang_sense_clarification": "предшествуя событию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71258eb2-5e76-3bf1-ab12-1d7677c02822",
                    "sense_definition": "Rather or sooner than.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will die <w>before</w> I tell you anything about it.",
                            "target_lang_translations": {
                                "ru": "Я скорее умру, <w>чем</w> расскажу тебе что-либо об этом."
                            }
                        },
                        {
                            "text": "He would quit his job <w>before</w> he would agree to those terms.",
                            "target_lang_translations": {
                                "ru": "Он скорее уволится, <w>чем</w> согласится на эти условия."
                            }
                        }
                    ],
                    "synonyms": [
                        "lest"
                    ],
                    "common_phrases": [
                        "die before"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорее или быстрее, чем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорее чем",
                                "target_lang_sense_clarification": "предпочтение"
                            },
                            {
                                "target_lang_word": "пре́жде чем",
                                "target_lang_sense_clarification": "в значении 'лучше сделать что-то другое'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93a3561c-d6c6-3129-a6c0-cfb8a3cf33da",
                    "sense_definition": "In before-and-after images, the one that shows the state prior to a treatment or change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On the left of the column are the <w>befores</w> showing the messy room.",
                            "target_lang_translations": {
                                "ru": "Слева в колонке фотографии «<w>до</w>», показывающие беспорядок в комнате."
                            }
                        },
                        {
                            "text": "I always think that the <w>befores</w> look better than the afters in these experiments.",
                            "target_lang_translations": {
                                "ru": "Мне всегда кажется, что снимки «<w>до</w>» в этих экспериментах выглядят лучше, чем «после»."
                            }
                        }
                    ],
                    "common_phrases": [
                        "before and after"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in marketing and media"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение «до» в сравнении «до и после»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "до",
                                "target_lang_sense_clarification": "состояние до изменений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "679c7ef4-3d7c-3680-9f91-07bc8c1dd42e",
                    "sense_definition": "That which occurred or existed previously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She came from <w>before</w> all the befores, from a place that is no place.",
                            "target_lang_translations": {
                                "ru": "Она пришла из времен <w>прежде</w> всех начал, из места, которого нет."
                            }
                        },
                        {
                            "text": "We talk about all the <w>befores</w> and the stupid things we did as children.",
                            "target_lang_translations": {
                                "ru": "Мы говорим о <w>прошлом</w> и о тех глупостях, что совершали в детстве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "all the befores"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in poetic or philosophical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что произошло или существовало ранее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про́шлое",
                                "target_lang_sense_clarification": "то, что было раньше"
                            },
                            {
                                "target_lang_word": "было́е",
                                "target_lang_sense_clarification": "поэтическое обозначение прошлого"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}