                        "glosses": [
                            "Umsatz, in der Höhe von mindestens einer Milliarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c025ab8c-8979-468d-8749-7b65ee6ccc30",
                                "sense_id": "25ddc973-1ab7-32e6-ac65-53f534cf9e4d",
                                "text": "„Tatsächlich fand das Virus in dem Konzern mit Milliardenumsatz den perfekten Nährboden: beengte Arbeitsverhältnisse; vorwiegend ausländische Billiglohnarbeiter, die sich laut Medienberichten zu siebt ein Zimmer teilen mussten und kaum ein Sprachrohr haben, um auf Missstände aufmerksam zu machen.“"
                            },
                            {
                                "example_id": "6a7e516d-27f6-4e24-8023-6ce51273f4ac",
                                "sense_id": "25ddc973-1ab7-32e6-ac65-53f534cf9e4d",
                                "text": "„Pfizer macht jetzt Milliardenumsätze mit nicht nur einem, sondern zwei Corona-Produkten.“"
                            }
                        ],
