    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8578507c-b368-35c4-99b9-8976aabc7ab6",
                    "sense_definition": "Воспаление червеобразного отростка слепой кишки.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "медицина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач диагностировал у пациента острый <w>аппендицит</w> и немедленно направил его в хирургическое отделение.",
                            "target_lang_translations": {
                                "en": "The doctor diagnosed the patient with acute <w>appendicitis</w> and immediately sent him to the surgical department."
                            }
                        },
                        {
                            "text": "Сильная боль в правой части живота может быть признаком того, что у человека начался <w>аппендицит</w>.",
                            "target_lang_translations": {
                                "en": "Severe pain in the right side of the abdomen can be a sign that a person has developed <w>appendicitis</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "острый аппендицит"
                    ],
                    "target_lang_definitions": {
                        "en": "Inflammation of the vermiform appendix."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appendicitis",
                                "target_lang_sense_clarification": "medical condition involving inflammation of the appendix"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1666e2eb-f887-3d0b-8745-5535b473d170",
                    "sense_definition": "Воспалившийся червеобразный отросток (разговорное употребление).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "медицина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хирург быстро провел операцию и успешно удалил воспаленный <w>аппендицит</w>.",
                            "target_lang_translations": {
                                "en": "The surgeon performed the operation quickly and successfully removed the inflamed <w>appendix</w>."
                            }
                        },
                        {
                            "text": "После того как врачи вырезали <w>аппендицит</w>, больному стало значительно легче.",
                            "target_lang_translations": {
                                "en": "After the doctors removed the <w>appendix</w>, the patient felt significantly better."
                            }
                        }
                    ],
                    "synonyms": [
                        "аппендикс"
                    ],
                    "common_phrases": [
                        "вырезать аппендицит"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The inflamed appendix itself (colloquial usage)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appendix",
                                "target_lang_sense_clarification": "the organ itself, often used colloquially when referring to its removal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
