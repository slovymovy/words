{
    "word_family": [
        "slapper",
        "slapstick",
        "slapdash",
        "slap-happy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a831d70-fc15-313f-aab9-ccbe5ac9bfbc",
                    "sense_definition": "To hit someone or something with the palm of one's hand or a flat object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>slapped</w> him across the face after he insulted her family.",
                            "target_lang_translations": {
                                "ru": "Она <w>дала</w> ему <w>пощёчину</w> после того, как он оскорбил её семью.",
                                "zh": "他侮辱了她的家人后，她就当场<w>扇了</w>他一巴掌。"
                            }
                        },
                        {
                            "text": "The angry player <w>slapped</w> the table in frustration during the game.",
                            "target_lang_translations": {
                                "ru": "Разозлённый игрок в расстройстве <w>шлёпнул</w> ладонью по столу во время игры.",
                                "zh": "那名愤怒的球员在比赛中懊恼地<w>拍</w>了一下桌子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slap someone face",
                        "slap the table"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо или что-либо ладонью или плоским предметом.",
                        "zh": "用手掌或扁平物体打某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпнуть",
                                "target_lang_sense_clarification": "ударить ладонью или плоским предметом"
                            },
                            {
                                "target_lang_word": "дать пощёчину",
                                "target_lang_sense_clarification": "ударить по лицу"
                            },
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "общее значение удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扇",
                                "target_lang_sense_clarification": "用手掌打；常指扇人一巴掌"
                            },
                            {
                                "target_lang_word": "拍",
                                "target_lang_sense_clarification": "用手掌或平面物体拍打"
                            },
                            {
                                "target_lang_word": "抽",
                                "target_lang_sense_clarification": "较重地打一下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc0034eb-5049-3de5-a92a-5f936a3d3089",
                    "sense_definition": "To hit against something with a splashing or percussive sound.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waves <w>slapped</w> against the side of the boat all night.",
                            "target_lang_translations": {
                                "ru": "Волны всю ночь <w>шлёпали</w> о борт лодки.",
                                "zh": "海浪整夜<w>拍打</w>着船身。"
                            }
                        },
                        {
                            "text": "Heavy rain <w>slapped</w> against the window as the storm grew stronger.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>бился</w> в окно, когда шторм усилился.",
                                "zh": "暴风雨越来越大时，大雨不断<w>拍打</w>着窗户。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slap against something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударяться обо что-либо с плеском или резким звуком.",
                        "zh": "带着拍击声或水声撞击到某物上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпать",
                                "target_lang_sense_clarification": "о звуке воды или дождя"
                            },
                            {
                                "target_lang_word": "плескаться",
                                "target_lang_sense_clarification": "о волнах"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "о волнах или дожде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍打",
                                "target_lang_sense_clarification": "水、雨等带着声响击打某物"
                            },
                            {
                                "target_lang_word": "拍击",
                                "target_lang_sense_clarification": "波浪、雨点等一下一下打在表面上"
                            },
                            {
                                "target_lang_word": "打在",
                                "target_lang_sense_clarification": "强调水花声或撞击感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96031b26-7251-301b-aa7e-30bddba0479e",
                    "sense_definition": "To put or apply something quickly, carelessly, or forcefully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>slapped</w> a coat of paint on the wall to hide the marks.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>ляпнул</w> слой краски на стену, чтобы скрыть следы.",
                                "zh": "他为了遮住那些痕迹，急急忙忙地在墙上<w>刷</w>了一层漆。"
                            }
                        },
                        {
                            "text": "Just <w>slap</w> some butter on the bread and let's go.",
                            "target_lang_translations": {
                                "ru": "Просто <w>намажь</w> немного масла на хлеб, и пошли.",
                                "zh": "就在面包上随便<w>抹</w>点黄油，我们走吧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slap on paint",
                        "slap some together"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for quick or messy application"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро, небрежно или с силой нанести или положить что-либо.",
                        "zh": "快速、随便地，或带点用力地把某物涂上、放上或弄上去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ляпнуть",
                                "target_lang_sense_clarification": "небрежно нанести слой чего-либо"
                            },
                            {
                                "target_lang_word": "намазать",
                                "target_lang_sense_clarification": "быстро нанести (например, масло)"
                            },
                            {
                                "target_lang_word": "шлёпнуть",
                                "target_lang_sense_clarification": "быстро положить что-то мягкое или влажное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刷",
                                "target_lang_sense_clarification": "迅速刷上一层，如油漆"
                            },
                            {
                                "target_lang_word": "抹",
                                "target_lang_sense_clarification": "把可涂抹的东西随手涂上去"
                            },
                            {
                                "target_lang_word": "往……上弄",
                                "target_lang_sense_clarification": "随手放上去、贴上去，语气较口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b83751c-a861-33eb-9aa6-80fb22ccb681",
                    "sense_definition": "To officially impose a penalty, fine, or restriction on someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The council <w>slapped</w> a fine on the company for illegal dumping.",
                            "target_lang_translations": {
                                "ru": "Совет <w>влепил</w> компании штраф за незаконный сброс отходов.",
                                "zh": "委员会因非法倾倒垃圾而对这家公司<w>处以</w>罚款。"
                            }
                        },
                        {
                            "text": "He was <w>slapped</w> with a lawsuit shortly after the accident.",
                            "target_lang_translations": {
                                "ru": "Вскоре после аварии ему <w>предъявили</w> иск.",
                                "zh": "事故发生后不久，他就被<w>告</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slapped with a fine",
                        "slap a ban"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used when penalties are applied suddenly or harshly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально наложить штраф, взыскание или ограничение.",
                        "zh": "正式对某人施加处罚、罚款或限制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влепить",
                                "target_lang_sense_clarification": "разг., о штрафе или иске"
                            },
                            {
                                "target_lang_word": "наложить",
                                "target_lang_sense_clarification": "официально применить санкцию"
                            },
                            {
                                "target_lang_word": "выкатить",
                                "target_lang_sense_clarification": "разг., предъявить обвинение или штраф"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处以",
                                "target_lang_sense_clarification": "正式施加罚款、处罚等"
                            },
                            {
                                "target_lang_word": "施加",
                                "target_lang_sense_clarification": "施加禁令、限制、制裁等"
                            },
                            {
                                "target_lang_word": "告",
                                "target_lang_sense_clarification": "口语，突然给人加上罚单、官司等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "025aea24-e769-3939-9447-cd8defcbb7ef",
                    "sense_definition": "To be exceptionally good, impressive, or high-quality, especially regarding music or food.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love this new track because the bass line really <w>slaps</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нравится этот новый трек, потому что басовая линия реально <w>качает</w>.",
                                "zh": "我喜欢这首新歌，因为它的贝斯线真的<w>很炸</w>。"
                            }
                        },
                        {
                            "text": "You have to try this burger; it absolutely <w>slaps</w>.",
                            "target_lang_translations": {
                                "ru": "Ты должен попробовать этот бургер, он просто <w>улётный</w>.",
                                "zh": "你一定得尝尝这个汉堡，味道真的<w>绝了</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "rock",
                        "excel",
                        "slay"
                    ],
                    "common_phrases": [
                        "really slaps",
                        "absolutely slaps"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "modern youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть исключительно хорошим, впечатляющим или качественным (о музыке или еде).",
                        "zh": "特别好、特别惊艳或品质很高，尤指音乐或食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качать",
                                "target_lang_sense_clarification": "о музыке с хорошим ритмом"
                            },
                            {
                                "target_lang_word": "вставлять",
                                "target_lang_sense_clarification": "о сильном впечатлении"
                            },
                            {
                                "target_lang_word": "быть чётким",
                                "target_lang_sense_clarification": "сленг, о высоком качестве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝了",
                                "target_lang_sense_clarification": "俚语，形容音乐、食物等特别棒"
                            },
                            {
                                "target_lang_word": "很炸",
                                "target_lang_sense_clarification": "俚语，形容音乐冲击力强、很带感"
                            },
                            {
                                "target_lang_word": "太顶了",
                                "target_lang_sense_clarification": "口语，特别好、特别过瘾"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e718f601-50e6-3548-8956-8968ae293e53",
                    "sense_definition": "A blow made with the open hand or a flat object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a sharp <w>slap</w> for his rude behavior.",
                            "target_lang_translations": {
                                "ru": "Он получил резкий <w>шлепок</w> за своё грубое поведение.",
                                "zh": "他因为举止粗鲁，挨了狠狠一<w>巴掌</w>。"
                            }
                        },
                        {
                            "text": "The coach gave him a friendly <w>slap</w> on the back.",
                            "target_lang_translations": {
                                "ru": "Тренер дружески <w>хлопнул</w> его по спине.",
                                "zh": "教练友好地在他背上拍了一<w>下</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slap on the back",
                        "slap in the face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар, нанесенный открытой ладонью или плоским предметом.",
                        "zh": "用张开的手掌或扁平物体打出的一下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "удар плашмя"
                            },
                            {
                                "target_lang_word": "пощёчина",
                                "target_lang_sense_clarification": "удар по щеке"
                            },
                            {
                                "target_lang_word": "оплеуха",
                                "target_lang_sense_clarification": "разг., удар по лицу или голове"
                            },
                            {
                                "target_lang_word": "затрещина",
                                "target_lang_sense_clarification": "сильный удар рукой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴掌",
                                "target_lang_sense_clarification": "用手掌打的一下"
                            },
                            {
                                "target_lang_word": "一拍",
                                "target_lang_sense_clarification": "较轻或带拍打感的一下"
                            },
                            {
                                "target_lang_word": "耳光",
                                "target_lang_sense_clarification": "打在脸上的一巴掌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b89d040-999c-3e96-b5e0-826bb5f56d81",
                    "sense_definition": "The sharp sound made by a flat object hitting a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could hear the <w>slap</w> of the waves against the dock.",
                            "target_lang_translations": {
                                "ru": "Я слышал <w>плеск</w> волн о причал.",
                                "zh": "我能听见海浪拍打码头的<w>啪啪声</w>。"
                            }
                        },
                        {
                            "text": "The <w>slap</w> of wet laundry hitting the floor woke me up.",
                            "target_lang_translations": {
                                "ru": "<w>Шлепок</w> мокрого белья об пол разбудил меня.",
                                "zh": "湿衣服啪地打在地上的那一<w>声</w>把我吵醒了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slap of waves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий звук, издаваемый плоским предметом при ударе о поверхность.",
                        "zh": "扁平物体打到某个表面时发出的清脆声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "звук удара плашмя"
                            },
                            {
                                "target_lang_word": "хлопок",
                                "target_lang_sense_clarification": "резкий звук"
                            },
                            {
                                "target_lang_word": "плеск",
                                "target_lang_sense_clarification": "звук воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "啪啪声",
                                "target_lang_sense_clarification": "平面物体拍击发出的声音，常用于水浪"
                            },
                            {
                                "target_lang_word": "拍击声",
                                "target_lang_sense_clarification": "较响亮的拍击声"
                            },
                            {
                                "target_lang_word": "拍打声",
                                "target_lang_sense_clarification": "水拍岸边或物体的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e370664d-88ca-3efa-af9a-bd6878bfca43",
                    "sense_definition": "Cosmetic makeup.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cosmetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She needs a few minutes to put her <w>slap</w> on before we leave.",
                            "target_lang_translations": {
                                "ru": "Ей нужно несколько минут, чтобы навести <w>штукатурку</w>, прежде чем мы уйдем.",
                                "zh": "我们出门前，她还得花几分钟上<w>妆</w>。"
                            }
                        },
                        {
                            "text": "He looked quite different without all that theatrical <w>slap</w>.",
                            "target_lang_translations": {
                                "ru": "Он выглядел совсем иначе без всего этого театрального <w>грима</w>.",
                                "zh": "没有那些舞台<w>妆</w>，他看起来很不一样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "put on some slap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Косметика, макияж.",
                        "zh": "化妆品；妆容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штукатурка",
                                "target_lang_sense_clarification": "пренебр., о толстом слое макияжа"
                            },
                            {
                                "target_lang_word": "раскраска",
                                "target_lang_sense_clarification": "разг., о ярком макияже"
                            },
                            {
                                "target_lang_word": "грим",
                                "target_lang_sense_clarification": "театральная косметика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妆",
                                "target_lang_sense_clarification": "一般说法，指化妆"
                            },
                            {
                                "target_lang_word": "妆容",
                                "target_lang_sense_clarification": "口语，指化的妆容或脸上的妆"
                            },
                            {
                                "target_lang_word": "舞台妆",
                                "target_lang_sense_clarification": "舞台或表演用化妆"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ede2a37c-7ab7-39a1-95a3-f9e0626b0b36",
                    "sense_definition": "Directly, squarely, or exactly in a particular place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house is situated <w>slap</w> in the middle of the forest.",
                            "target_lang_translations": {
                                "ru": "Дом расположен <w>аккурат</w> посреди леса.",
                                "zh": "那栋房子就坐落在森林<w>正</w>中央。"
                            }
                        },
                        {
                            "text": "He ran <w>slap</w> into the back of the parked car.",
                            "target_lang_translations": {
                                "ru": "Он врезался <w>прямо</w> в заднюю часть припаркованного автомобиля.",
                                "zh": "他一头<w>正</w>撞上了那辆停着的车尾。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exactly",
                        "right",
                        "just",
                        "smack dab"
                    ],
                    "common_phrases": [
                        "slap in the middle",
                        "slap bang"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'bang' or 'in the middle'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямо, непосредственно или точно в определенном месте.",
                        "zh": "正好、直接地或准确地在某个位置。"
                    },
                    "translations": {
                        "ru": [
