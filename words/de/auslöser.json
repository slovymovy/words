                {
                    "sense_id": "b41d3775-d53b-311c-a3ec-eb64efa3078f",
                    "sense_definition": "Ereignis, Umstand oder Faktor, der eine bestimmte Reaktion oder Entwicklung in Gang setzt",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ursache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der plötzliche Streit war der eigentliche <w>Auslöser</w> für eine lange Krise in der Familie."
                        },
                        {
                            "text": "Wissenschaftler untersuchen derzeit, was der genaue <w>Auslöser</w> für den Ausbruch der Krankheit war."
