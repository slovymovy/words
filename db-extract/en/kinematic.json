                        "sense_id": "42a58441-7ce7-3e8c-be32-96e318e21bf7",
                        "entry_id": "e058010a-364b-3348-8dda-c250464b90ac",
                        "glosses": [
                            "Of or relating to motion or to kinematics."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "30b8544d-01b6-43e0-9019-945f44b989b0",
                                "sense_id": "42a58441-7ce7-3e8c-be32-96e318e21bf7",
                                "text": "We have unfortunately no kinematic records, but it is not impossible or very difficult to imagine the various gestures and movements which might be considered appropriate to such a rite in different localities or among different peoples."
                            },
                            {
                                "example_id": "d7a3114f-ec7a-47e1-8b3b-29c8d540e323",
                                "sense_id": "42a58441-7ce7-3e8c-be32-96e318e21bf7",
                                "text": "The Cognitive function in Humans results from our extremely complex kinematic capabilities. Grasping for objects, bending down and up, or sitting down on objects are examples of kinematic capabilities[…]"
                            }
                        ]
                    }
                ],
