                    {
                        "translation_id": "3657b591-76b0-4343-bfbb-e428fcbb7d37",
                        "source_entry_id": "df1620c5-8938-31f9-9522-9ee4b49e7ae1",
                        "source_sense_id": "881390b5-370d-3b08-9c91-f5c9d4535342",
                        "source_sense_description": "member of the group of Quechuan peoples",
