                                    {
                                        "sense_id": "b369ba02-7cf8-39e2-ba2c-4d7f037cc937",
                                        "entry_id": "42699c05-8a18-384e-bb12-a62ec28b7247",
                                        "glosses": [
                                            "Fiction in which advanced technology or science is a key element."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "749dc7a2-e3c6-449f-a16f-fe2d253a08ed",
                                                "sense_id": "b369ba02-7cf8-39e2-ba2c-4d7f037cc937",
                                                "text": "Now this applies especially to Science-Fiction, in which the revealed truths of Science may be given, interwoven with a pleasing story which may itself be poetical and true—thus circulating a knowledge of the Poetry of Science, clothed in a garb of the Poetry of Life."
                                            },
                                            {
                                                "example_id": "0094bbf7-a19d-4506-aa77-f62ad930cab8",
                                                "sense_id": "b369ba02-7cf8-39e2-ba2c-4d7f037cc937",
                                                "text": "Science fiction can be defined as that branch of literature which deals with the reaction of human beings to changes in science and technology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8181403-e2f3-3147-9cec-db5a73db1447",
                                        "entry_id": "42699c05-8a18-384e-bb12-a62ec28b7247",
                                        "glosses": [
                                            "Technology that, while theoretically possible, is not yet practical."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62804d19-41f1-44a4-915b-e14f5afba469",
                                                "sense_id": "a8181403-e2f3-3147-9cec-db5a73db1447",
                                                "text": "Despite decades of research, mass-market personal aircraft are still science fiction."
                                            }
                                        ]
                                    }
                                ]
                            },
