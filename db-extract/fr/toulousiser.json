                ],
                "senses": [
                    {
                        "sense_id": "25d7a4fd-d464-34b0-972a-4d6423fe6b00",
                        "entry_id": "0f3144a7-e6f1-3117-9f73-cf7d66b31799",
                        "glosses": [
                            "Donner un caractère toulousain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4f79ae-be52-4299-a6c1-573dba8cceb1",
                                "sense_id": "25d7a4fd-d464-34b0-972a-4d6423fe6b00",
                                "text": "Si tu passes à Paris dans l'année fais-moi signe on ira boire un verre faudra toulousiser la capitale."
                            },
                            {
                                "example_id": "3f81e904-80a3-4593-a573-4f910d013846",
                                "sense_id": "25d7a4fd-d464-34b0-972a-4d6423fe6b00",
                                "text": "Nous sommes en train de nous \"Clermontiser\" ou \"Toulousiser\", et c'est tant mieux, un jour les internationaux français se battront pour venir chez nous."
                            },
                            {
                                "example_id": "d7430367-d065-4919-a167-12e129aae62c",
                                "sense_id": "25d7a4fd-d464-34b0-972a-4d6423fe6b00",
                                "text": "Pour cela, il faut des joueurs qui viennent aussi avec le coeur, qui ont envie de se laisser \"toulonniser\" comme d'autres se sont toulousisés."
                            }
                        ]
                    }
                ],
