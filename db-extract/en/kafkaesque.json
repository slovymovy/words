                                "target_senses": [
                                    {
                                        "sense_id": "b82d7ce9-78bb-3bd6-bd48-335210cc13df",
                                        "entry_id": "85d8a11f-dae3-3c99-a29b-d392f007e7c3",
                                        "glosses": [
                                            "im Stil von Franz Kafka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c35f608-efce-42df-8358-6fb2b8ea6d6e",
                                                "sense_id": "b82d7ce9-78bb-3bd6-bd48-335210cc13df",
                                                "text": "Nicht von ungefähr mutet im Roman manches kafkaesk an, von hintergründiger Komik, die mit abrupten Schnitten zwischen den Szenen gleich wieder aufgelöst wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2606a2d-960f-3366-9c15-b9f72116e8c7",
                                        "entry_id": "85d8a11f-dae3-3c99-a29b-d392f007e7c3",
                                        "glosses": [
                                            "gebraucht in Situationen, die absurd, rätselhaft und dabei bedrohlich empfunden werden; der Betroffene erlebt ein Gefühl der Unsicherheit, des Ausgeliefertseins; meist im Zusammenhang mit einer Administration mit undurchsichtigen Regeln, die keinen Sinn zu ergeben scheinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b444b2-efe9-4e13-a438-049e0ed91eb6",
                                                "sense_id": "b2606a2d-960f-3366-9c15-b9f72116e8c7",
                                                "text": "Im Kampf gegen das französische Sozialmodell legt sie sich regelmäßig mit der Regierung an, deren Gesetze sie „kafkaesk und unlesbar“ nennt."
                                            },
                                            {
                                                "example_id": "9365dc0a-e368-4a09-be62-9eb7f36d20bd",
                                                "sense_id": "b2606a2d-960f-3366-9c15-b9f72116e8c7",
                                                "text": "Es gibt auch den Begriff pythonesk, in Anlehnung an kafkaesk. Gibt es irgendeinen deutschen Comedian, Kabarettisten, Komiker, den Sie mit diesem Attribut pythonesk adeln würden?"
                                            },
                                            {
                                                "example_id": "afffd4a3-ad50-4d72-9d86-11aa0432b130",
                                                "sense_id": "b2606a2d-960f-3366-9c15-b9f72116e8c7",
                                                "text": "\"Kafkaesk\" nennt man diese Situation der Hilflosigkeit, die eine zentrale Erfahrung in modernen Massengesellschaften ist."
                                            },
                                            {
                                                "example_id": "9bf5e5b1-318b-4b0e-97be-100d248a33b5",
                                                "sense_id": "b2606a2d-960f-3366-9c15-b9f72116e8c7",
                                                "text": "ALG II ist eine kafkaesk durchbürokratisierte Armutsmaschine."
                                            },
                                            {
                                                "example_id": "1ca76d28-5a77-41dd-9395-14bc094de2bf",
                                                "sense_id": "b2606a2d-960f-3366-9c15-b9f72116e8c7",
                                                "text": "Zwei von Ahmets Anwälten und auch der Richter, der ihn im März 2012 freigelassen hatte, sitzen mittlerweile im selben Gefängnis wie Ahmet. Das ist kafkaesk."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
