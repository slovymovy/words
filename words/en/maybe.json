{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "20e18ae1-a6a4-3b27-8008-a4af05713a8a",
                    "sense_definition": "Perhaps; possibly.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possibility_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small extra effort now can <w>maybe</w> save you much work later.",
                            "target_lang_translations": {
                                "ru": "Небольшое дополнительное усилие сейчас, <w>возможно</w>, сэкономит вам много работы позже.",
                                "es": "Un pequeño esfuerzo extra ahora <w>tal vez</w> te ahorre mucho trabajo después."
                            }
                        },
                        {
                            "text": "<w>Maybe</w> we should wait for the rain to stop before we go out.",
                            "target_lang_translations": {
                                "ru": "<w>Может быть</w>, нам стоит подождать, пока дождь прекратится, прежде чем выходить.",
                                "es": "<w>Quizás</w> deberíamos esperar a que pare de llover antes de salir."
                            }
                        }
                    ],
                    "synonyms": [
                        "perhaps",
                        "possibly"
                    ],
                    "antonyms": [
                        "definitely",
                        "certainly"
                    ],
                    "common_phrases": [
                        "maybe later",
                        "maybe not",
                        "maybe so"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможно; может быть.",
                        "es": "Tal vez; posiblemente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "может быть",
                                "target_lang_sense_clarification": "вводное слово, выражает вероятность"
                            },
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "наречие, выражает допустимость"
                            },
                            {
                                "target_lang_word": "наверное",
                                "target_lang_sense_clarification": "вводное слово, часто используется в разговорной речи"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tal vez",
                                "target_lang_sense_clarification": "locución adverbial que denota posibilidad"
                            },
                            {
                                "target_lang_word": "quizás",
                                "target_lang_sense_clarification": "adverbio que expresa duda o posibilidad"
                            },
                            {
                                "target_lang_word": "quizá",
                                "target_lang_sense_clarification": "variante de quizás, denota posibilidad"
                            },
                            {
                                "target_lang_word": "puede que",
                                "target_lang_sense_clarification": "locución verbal que indica posibilidad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f619ce02-3add-3ced-a921-06b322f548c8",
                    "sense_definition": "Perhaps that is true; used to express no commitment to a decision or a neutral viewpoint.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possibility_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you coming to the party tonight? — <w>Maybe</w>, I haven't decided yet.",
                            "target_lang_translations": {
                                "ru": "Ты идешь сегодня на вечеринку? — <w>Может быть</w>, я еще не решил.",
                                "es": "¿Vienes a la fiesta esta noche? — <w>Tal vez</w>, aún no lo he decidido."
                            }
                        },
                        {
                            "text": "I thought you were angry with me. — <w>Maybe</w> I was, but I am fine now.",
                            "target_lang_translations": {
                                "ru": "Я думал, ты на меня злишься. — <w>Возможно</w>, и злился, но сейчас я в порядке.",
                                "es": "Pensé que estabas enojado conmigo. — <w>Puede ser</w> que lo estuviera, pero ahora estoy bien."
                            }
                        }
                    ],
                    "synonyms": [
                        "could be",
                        "possibly",
                        "perhaps"
                    ],
                    "common_phrases": [
                        "yes no maybe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможно, это так; используется для выражения отсутствия обязательств или нейтральной точки зрения.",
                        "es": "Tal vez sea cierto; se usa para expresar falta de compromiso con una decisión o un punto de vista neutral."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "может быть",
                                "target_lang_sense_clarification": "выражение неуверенного согласия"
                            },
                            {
                                "target_lang_word": "возможно",
                                "target_lang_sense_clarification": "допущение возможности"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tal vez",
                                "target_lang_sense_clarification": "expresión de duda o indecisión"
                            },
                            {
                                "target_lang_word": "quizás",
                                "target_lang_sense_clarification": "respuesta que denota falta de certeza"
                            },
                            {
                                "target_lang_word": "puede ser",
                                "target_lang_sense_clarification": "expresión para indicar que algo es posible pero no seguro"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72995e16-99e7-3214-9638-908a856dfb82",
                    "sense_definition": "An answer that shows neither agreement nor disagreement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The results of the poll were inconclusive; we got two yeses, three nos, and four <w>maybes</w>.",
                            "target_lang_translations": {
                                "ru": "Результаты опроса были неубедительными: мы получили два «да», три «нет» и четыре <w>«может быть»</w>.",
                                "es": "Los resultados de la encuesta no fueron concluyentes; obtuvimos dos síes, tres noes y cuatro <w>tal vez</w>."
                            }
                        },
                        {
                            "text": "I need a definite answer from you today, not just another <w>maybe</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужен от тебя определенный ответ сегодня, а не просто очередное <w>«может быть»</w>.",
                                "es": "Necesito una respuesta definitiva de tu parte hoy, no solo otro <w>quizás</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "definite maybe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответ, который не выражает ни согласия, ни несогласия.",
                        "es": "Una respuesta que no muestra ni acuerdo ni desacuerdo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«может быть»",
                                "target_lang_sense_clarification": "в значении уклончивого ответа"
                            },
                            {
                                "target_lang_word": "неопределённый ответ",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tal vez",
                                "target_lang_sense_clarification": "sustantivado, respuesta indecisa o ambigua"
                            },
                            {
                                "target_lang_word": "quizás",
                                "target_lang_sense_clarification": "sustantivado, respuesta que no define un sí o un no"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c517ffd-667f-3b80-9a62-61342bec200f",
                    "sense_definition": "A future event or situation that may or may not happen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uncertainty_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "About your raise: it is still a big <w>maybe</w> until the budget is approved.",
                            "target_lang_translations": {
                                "ru": "Насчет твоего повышения: это все еще под большим <w>вопросом</w>, пока не утвердят бюджет.",
                                "es": "Sobre tu aumento: todavía está <w>en el aire</w> hasta que se apruebe el presupuesto."
                            }
                        },
                        {
                            "text": "There are too many <w>maybes</w> in this plan for me to feel comfortable investing.",
                            "target_lang_translations": {
                                "ru": "В этом плане слишком много <w>неизвестных</w>, чтобы я мог спокойно инвестировать.",
                                "es": "Hay demasiadas <w>incertidumbres</w> en este plan como para que me sienta cómodo invirtiendo."
                            }
                        }
                    ],
                    "antonyms": [
                        "certainty"
                    ],
                    "common_phrases": [
                        "a big maybe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe uncertain plans"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Будущее событие или ситуация, которые могут и не произойти.",
                        "es": "Un evento o situación futura que puede o no suceder."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под вопросом",
                                "target_lang_sense_clarification": "о сомнительном событии"
                            },
                            {
                                "target_lang_word": "неизвестное",
                                "target_lang_sense_clarification": "существительное, отсутствие ясности"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "incertidumbre",
                                "target_lang_sense_clarification": "situación o evento que no es seguro"
                            },
                            {
                                "target_lang_word": "posibilidad",
                                "target_lang_sense_clarification": "suceso que podría ocurrir pero no es seguro"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}