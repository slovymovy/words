                "senses": [
                    {
                        "sense_id": "652dbcda-4de9-34b1-b3a0-12442d47d206",
                        "entry_id": "6ecd815c-ef59-363c-bc56-597b2337894d",
                        "glosses": [
                            "Devenir pire."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0bbb65fb-c254-4d93-b5d4-3ad2555374c4",
                                "sense_id": "652dbcda-4de9-34b1-b3a0-12442d47d206",
                                "text": "Louisette lui dit qu’il ”rempironne au lieu de s’emmieuter”."
                            },
                            {
                                "example_id": "598fb852-0f34-4d5d-9b7a-b9a21ddec250",
                                "sense_id": "652dbcda-4de9-34b1-b3a0-12442d47d206",
                                "text": "Et en plus, il faut le boire dans les jours qui suivent l'achat, sinon il rempironne."
                            },
                            {
                                "example_id": "5d1f6320-f85c-4399-9fcd-f50507bd37e8",
                                "sense_id": "652dbcda-4de9-34b1-b3a0-12442d47d206",
                                "text": "D'un gouvernement à l'autre, malgré toutes les promesses la situation rempironne!"
                            }
                        ]
                    }
