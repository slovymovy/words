                    {
                        "sense_id": "4a371b3a-e2c5-312f-be2f-7a7cd46caea6",
                        "entry_id": "baec6ba2-9994-39f3-bb37-9847c9c79468",
                        "glosses": [
                            "Unjustified, inappropriate or undeserved."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c74e8e-dd4e-43d8-8279-f6ad02062bfa",
                                "sense_id": "4a371b3a-e2c5-312f-be2f-7a7cd46caea6",
                                "text": "The attack was so unwarranted and delivered with such venom that his unpreparedness for it left him speechless."
                            },
                            {
                                "example_id": "2190384b-cec1-4de9-b583-5d4dfb430347",
                                "sense_id": "4a371b3a-e2c5-312f-be2f-7a7cd46caea6",
                                "text": "The dictionaries themselves cover this additional lexis in what can best be described as a piecemeal fashion, with an obvious but unwarranted bias towards colonial era lexis."
                            },
                            {
                                "example_id": "9fafa4ab-5b63-41bb-982e-6c7d57f130f4",
                                "sense_id": "4a371b3a-e2c5-312f-be2f-7a7cd46caea6",
                                "text": "This strike action by the RMT is completely unwarranted and unjustified."
                            }
                        ]
                    }
