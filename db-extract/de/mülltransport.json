                ],
                "senses": [
                    {
                        "sense_id": "a7fe2c70-77f0-3e85-ad0c-3a56491d228f",
                        "entry_id": "c8e12820-a994-353f-a972-5588b5fc5092",
                        "glosses": [
                            "der Transport von Müll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a74047-46ca-4f73-b228-9aa1453d7058",
                                "sense_id": "a7fe2c70-77f0-3e85-ad0c-3a56491d228f",
                                "text": "„Derzeit rumort es im Aufsichtsrat der Gesellschaft Abfallwirtschaft Breisgau GmbH (GAB). Grund ist ein geplantes Gutachten, das unter anderem prüfen soll, ob die Mülltransporte per Zug zur Thermischen Restabfallbehandlungs- und Energieerzeugungsanlage (Trea) wirtschaftlich sinnvoll sind.“"
                            },
                            {
                                "example_id": "07120d7f-668a-4205-9d5e-3b0aa05ffc37",
                                "sense_id": "a7fe2c70-77f0-3e85-ad0c-3a56491d228f",
                                "text": "„Mauel machte klar, dass der Kreis künftig gemeinsam mit dem DZV selbst den Mülltransport, die Aufgaben des Stoffstrommanagements und die Verwertung des Abfalls managen wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
