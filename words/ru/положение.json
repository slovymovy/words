                },
                {
                    "sense_id": "7a0d65ef-64e3-36a9-82a1-59d24c3f7d95",
                    "sense_definition": "Особый правовой режим государственной или общественной жизни.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_rules",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В связи с сильным наводнением в регионе было объявлено чрезвычайное <w>положение</w>.",
                            "target_lang_translations": {
                                "en": "Due to severe flooding, a <w>state</w> of emergency was declared in the region.",
                                "zh": "由于该地区发生严重洪水，已宣布进入紧急<w>状态</w>。"
                            }
                        },
                        {
                            "text": "Военное <w>положение</w> накладывает строгие ограничения на передвижение граждан в ночное время.",
                            "target_lang_translations": {
                                "en": "Martial <w>law</w> imposes strict restrictions on the movement of citizens at night.",
                                "zh": "实行<w>戒严</w>后，夜间公民的出行受到严格限制。"
                            }
                        }
                    ],
                    "synonyms": [
                        "режим"
                    ],
                    "common_phrases": [
                        "военное положение",
                        "чрезвычайное положение",
                        "объявить положение"
                    ],
                    "target_lang_definitions": {
