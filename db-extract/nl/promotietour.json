                        "examples": [
                            {
                                "example_id": "3e2639a4-3ef9-440b-a0ac-ae13aa8d112e",
                                "sense_id": "e13d76d9-0756-3697-a516-8c21aac40a2c",
                                "text": "Iedereen wist dat Daisy en Billy samen op promotietour voor uitverkochte zalen zouden zorgen en veel albums zouden verkopen."
                            },
                            {
                                "example_id": "f2532d14-5f33-44a3-8be3-e4ccd428bd87",
                                "sense_id": "e13d76d9-0756-3697-a516-8c21aac40a2c",
                                "text": "Het Tata Steel Chess Tournament hield dinsdag een promotietour. In een speciaal ingerichte coupé konden treinreizigers tussen Rotterdam en Venlo het opnemen tegen onder anderen Anish Giri, Nederlands beste schaker."
                            }
