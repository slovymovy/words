                        ],
                        "form": "das Ballungsgebiet"
                    },
                    {
                        "form_id": "68a1ba79-d45e-4dcf-b225-c1932c3a5758",
                        "entry_id": "87e6a06c-3471-3b42-8059-ff51185e852f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ballungsgebiete"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                        "entry_id": "87e6a06c-3471-3b42-8059-ff51185e852f",
                        "glosses": [
                            "große städtische Region mit hoher Bevölkerungsdichte und vielen Firmen/viel Industrie"
                        ],
                        "tags": [
                            "Urbanistik"
                        ],
                        "examples": [
                            {
                                "example_id": "b903300a-d894-446d-b5bb-08b3b6f63b2d",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Doch das Ballungsgebiet hat auch Nachteile: Bezahlbarer Wohnraum wird knapp.“"
                            },
                            {
                                "example_id": "babc6ac5-b158-4a7e-b339-0ddd265e3fca",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„New York ist 1850 ein überfülltes Ballungsgebiet mit stinkenden Latrinen.“"
                            },
                            {
                                "example_id": "e1b9e869-c961-422b-badd-11b3bf89a661",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Auch wenn in manchen Ballungsgebieten das Wohnraum-Angebot knapp ist - beim Immobilienkauf ist Hektik kein guter Ratgeber.“"
                            },
                            {
                                "example_id": "e886bbab-08ab-49d6-8e92-9001521bb285",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Das gesamte Ballungsgebiet Nürnberg-Fürth-Erlangen mit rund einer Million Einwohnern etwa wird nur durch die vergleichsweise kleinen Flüsse Rednitz und Pegnitz mit Wasser versorgt.“"
                            },
                            {
                                "example_id": "9bac04f5-71b1-46c7-b658-41c91cbfe3d5",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Seit dem 17. März 2017 wird das Ballungsgebiet Leipzig/Halle mit dem neuen terrestrischen Standard DVB-T2 durch den 2015 errichteten Funkturm an der Zwickauer Straße, das mit 192 Metern höchste innerstädtische Bauwerk Leipzigs, versorgt.“"
                            },
                            {
                                "example_id": "2f77b835-a49d-4341-aed4-37e1685e055a",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Ancaster liegt im westlichsten Teil des Ballungsgebietes Golden Horseshoe im Süden Ontarios, südwestlich von Hamilton.“"
                            },
                            {
                                "example_id": "4bbd9c78-ef72-4b60-a1b7-d759670212b6",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Seit Anfang Mai bildet Ruda Śląska neben anderen Städten im oberschlesischen Ballungsgebiet, in dem 4,5 Millionen Menschen leben, den größten Pandemie-Hotspot Polens.“"
                            },
                            {
                                "example_id": "085f5ea9-280a-4306-924e-e623d0a81d16",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "[Jakarta/Indonesien:] „Trotzdem ist trinkbares Wasser ein Luxusgut. Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                            },
                            {
                                "example_id": "7cf2a0d2-3667-4e7c-a9b6-efd5dbc4d8dc",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "[Mumbai/Indien:] „Die Stadt ist das Finanzzentrum Indiens- ein dichtes Ballungsgebiet mit über 20 Millionen Menschen.“"
                            },
                            {
                                "example_id": "ffd0a13e-787c-431a-b481-37bf68708d77",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Die Metropolregion São Paulo ist zudem auch das größte industrielle Ballungsgebiet Lateinamerikas und einer der wichtigsten Industriestandorte der Welt.“"
                            },
                            {
                                "example_id": "c2706b30-5605-4a87-94a3-700712ef8cca",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "[S-Bahn:] „Aber auch in der Hauptstadt wird das Netz ausgebaut. Dabei soll das Ballungsgebiet Zentrum mit dem Ballungsgebiet im Süden Luxemburgs verbunden werden, denn dort befindet sich die Universität und die Stahlindustrie.“"
                            },
                            {
                                "example_id": "1c266b39-0bfb-4268-b577-f453f0dddf3b",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Es fehlen ausreichend Studienplätze für Mediziner. Und die Studenten, die es gibt, spezialisieren sich lieber und übernehmen eine lukrative Facharztpraxis in einem Ballungsgebiet.“"
                            },
                            {
                                "example_id": "0193cfea-e6e8-4274-8d15-454d7a754539",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„So fordern die meisten Bauordnungen bei der Schaffung von neuen Wohnungen den Nachweis eines PKW-Stellplatzes pro Einheit, was in Ballungsgebieten, besonders bei Umnutzung oder Aufstockung, nahezu unmöglich ist.“"
                            },
                            {
                                "example_id": "434fe82e-6622-4c80-8085-b72792c5999a",
                                "sense_id": "a91dbefb-a9ca-3b45-9a1b-31317623bf90",
                                "text": "„Ballungsgebiete werden in zwei Typen gegliedert: a) Einkernballungen oder monozentrische Ballungsgebiete, die sich um eine dominierende Großstadt entwickelt haben und b) Mehrkernballung oder polyzentrisch strukturierte Ballungsgebiete mit zwei oder mehreren Kernstädten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
