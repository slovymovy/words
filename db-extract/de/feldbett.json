                ],
                "senses": [
                    {
                        "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                        "entry_id": "29a6e77b-36e8-3762-ad1a-f590195ea6a0",
                        "glosses": [
                            "einfaches, meist aus Eisen bestehendes, zusammenklappbares Bett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b90cd544-c936-4dcd-972c-3876a7309c0a",
                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                "text": "Er hatte Schmerzen im Nacken, weil er auf einem harten Feldbett geschlafen hatte."
                            },
                            {
                                "example_id": "bdf66e21-11f5-40de-a968-19d57869a6c9",
                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                "text": "„Hier brachte er mich in einem kahlen Zimmer unter, an dessen Wänden eine Reihe von Feldbetten aufgestellt war.“"
                            },
                            {
                                "example_id": "a548b6ac-490c-44f7-93ff-8f14231b4d69",
                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                "text": "„Das Feldbett ähnelte Wenzel Hainstocks Feldbett wie ein Ei den anderen.“"
                            },
                            {
                                "example_id": "a95ccd63-2c9c-4d18-aecc-738486dca0cf",
                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                "text": "„Danach mussten wir uns zum Mittagsschlaf auf Feldbetten niederlassen und schweigen.“"
                            },
                            {
                                "example_id": "25dae05c-5a3f-40f0-95ae-8a226d469a61",
                                "sense_id": "8ce148cc-24ba-32b6-be0a-62482a9db23e",
                                "text": "„Als er endlich auf dem Feldbett lag, da hielt er die Augen lange geschlossen und rührte sich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
