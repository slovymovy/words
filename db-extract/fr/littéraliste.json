                    {
                        "sense_id": "f34a4821-7fdc-3bee-9928-a6bd43bf5e7f",
                        "entry_id": "24012e7c-9536-37e3-9ef7-29bbce627e8b",
                        "glosses": [
                            "Partisan d’une traduction à la lettre ou la lecture littérale d'une œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "233f3f89-05ba-4c2c-9dbb-93c9eedd823e",
                                "sense_id": "f34a4821-7fdc-3bee-9928-a6bd43bf5e7f",
                                "text": "Alors que l’idéaliste s’efforce toujours d’élever l’homme au domaine des dieux, le littéraliste tirait les immortels de leurs hauteurs olympiennes et les dégradait avec la similitude de l’homme."
                            },
                            {
                                "example_id": "d239f549-24b5-4d8e-a602-59014a5c29ec",
                                "sense_id": "f34a4821-7fdc-3bee-9928-a6bd43bf5e7f",
                                "text": "Les partisans de Maïmonide répliquèrent à l'interdit prononcé par les « littéralistes » en lançant, à leur tour, l'excommunication contre les auteurs de l'interdit."
                            }
                        ]
                    }
