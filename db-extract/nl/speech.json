                                        "entry_id": "d6fe8ec0-d56b-3c5e-8a98-b0e56f3f3544",
                                        "glosses": [
                                            "Unidad formada por una o más palabras que tienen cohesión o unidad de sentido, generalmente, gracias a la presencia de un verbo conjugado, que actúa como núcleo."
                                        ],
                                        "tags": [
                                            "a menudo es distinguible por el contorno de la entonación",
                                            "de la puntuación"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619a6736-dfaf-4a47-9cf0-50b0a78d8052",
                                                "sense_id": "596b9de8-6649-370a-9c25-84ba6d49b211",
                                                "text": "la frase \"Los niños juegan en el campo\" es una oración cuyo núcleo es el verbo \"jugar\". Pero la frase \"los niños en el campo\" no se considera una oración porque carece de un núcleo verbal que le dé cohesión."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
