                        "examples": [
                            {
                                "example_id": "d9856e05-c815-4f32-858d-4c8859ecc796",
                                "sense_id": "2924a1d7-a032-3de6-a268-5dde86c2fd2d",
                                "text": "De vetten met de kankerverwekkende stof dioxine zijn verwerkt in veevoer. Zo'n 150.000 ton pluimveevoer en varkensvoer raakte daardoor besmet."
                            },
                            {
                                "example_id": "4eac3743-2179-4ed5-8d14-0d318df58ba5",
                                "sense_id": "2924a1d7-a032-3de6-a268-5dde86c2fd2d",
                                "text": "De markt voor varkensvlees staat onder druk. De prijs voor varkensvoer is fors gestegen en boeren krijgen relatief weinig voor het vlees. Verder kopen Duitsers minder varkensvlees door het dioxineschandaal."
                            },
                            {
                                "example_id": "39d36091-6652-48bd-89ee-1bee2679c0b1",
                                "sense_id": "2924a1d7-a032-3de6-a268-5dde86c2fd2d",
                                "text": "Varkens mogen blijven leven Goed nieuws voor 97 varkensboeren: hun dieren mogen blijven leven. De Voedsel- en Warenautoriteit blokkeerde de varkensbedrijven omdat er mogelijk verboden middelen in het varkensvoer zouden zitten. Maar bij onderzoek is er niks verkeerds gevonden. Eerder werden ruim 2400 kalveren van Gelderse bedrijven wel gedood, omdat die verkeerd voer hadden gegeten."
                            }
                        ]
