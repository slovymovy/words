                        "examples": [
                            {
                                "example_id": "edb2dc61-5dd5-43f8-8ff9-e999dd42ee64",
                                "sense_id": "3465543a-288d-30f2-a4a4-15e18980de7f",
                                "text": "„Warren behauptete, er habe einige Dokumente von Curwen hinter der Wandvertäfelung eines sehr alten Hauses in Olney Court auf dem Stampers Hill gefunden, von dem man wusste, dass er es einst bewohnt hatte.“"
                            },
                            {
                                "example_id": "d84a4314-7b6a-4c91-9626-67e7fe466dd7",
                                "sense_id": "3465543a-288d-30f2-a4a4-15e18980de7f",
                                "text": "„Wenn es einen Safe gibt, hinter einem Gemälde oder einer geheimen Wandvertäfelung, wird Walter ihn finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
