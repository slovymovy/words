                "senses": [
                    {
                        "sense_id": "8fcd5678-7e24-397e-9451-f26d1443e927",
                        "entry_id": "cf910f23-706b-3d52-8da5-55ca396a2c94",
                        "glosses": [
                            "Energieverlust, der bei der Umwandlung von (elektrischer) Energie, bei der Übertragung von (elektrischer) Energie, beim Betrieb von (elektrischen) Anlagen oder elektronischen Bauteilen in Form von Wärmeenergie vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ee8d5d9-9f40-47ae-8f7f-b487dc0a3d4f",
                                "sense_id": "8fcd5678-7e24-397e-9451-f26d1443e927",
                                "text": "„Diese intelligenten Funktionen erhöhen die Verlustleistung der Sensoren.“"
                            },
                            {
                                "example_id": "f72691e0-99d0-4332-81d8-572e3a952b2b",
                                "sense_id": "8fcd5678-7e24-397e-9451-f26d1443e927",
                                "text": "„Würde man heute für die Netzgleichrichtung (AC/DC) statt Gleichrichterdioden aktive Gleichrichtung (synchrone Gleichrichter) einsetzen, hätte man nur etwa 1/10 des Spannungsabfalls, was die Verlustleistung schon erheblich reduziert.“"
                            },
                            {
                                "example_id": "317f3b79-55a0-4c1b-a573-f533ffb7a0a2",
                                "sense_id": "8fcd5678-7e24-397e-9451-f26d1443e927",
                                "text": "„Hinzu kommen auch noch die Chips für Thin-and-Light-Laptops der \"Raptor Lake\"-U- und -P-Serien. Das \"P\" steht hier für Performance, es handelt sich also um Chips mit 28 Watt Verlustleistung, während die U-Varianten mit einer \"Base Power\" von 15 Watt angegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
