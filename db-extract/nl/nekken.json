                        "examples": [
                            {
                                "example_id": "62d3e988-e0ab-41b6-9951-f8cd45b5a5b6",
                                "sense_id": "df1b1849-e79e-32e6-9330-4a7ea120618d",
                                "text": "Ik moest gister even flink nekken, dat laatste biertje was te veel.",
                                "translation": "I had to throw up big time last night, that last beer was too much.",
                                "english": "I had to throw up big time last night, that last beer was too much."
                            }
