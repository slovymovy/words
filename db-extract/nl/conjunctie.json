                    {
                        "sense_id": "d4c1888e-e484-34b8-87ab-d8897a556c7e",
                        "entry_id": "bc9b298a-e630-3a7a-994d-5d7ef38475e2",
                        "glosses": [
                            "logische operator (symbool: scriptstyle ∧, &, EN of AND) die twee proposities met elkaar verbindt, zodanig dat de conjunctie van beide waar is als beide operanden waar zijn"
                        ],
                        "tags": [],
