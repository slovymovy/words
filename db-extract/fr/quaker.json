                "senses": [
                    {
                        "sense_id": "c87b9fe3-47a1-3773-aafd-61577207cf6f",
                        "entry_id": "88cd6345-4cbd-3552-a768-8e6e5f41156c",
                        "glosses": [
                            "Qui appartient au mouvement des quakers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9630f61c-b10c-4b4a-b970-0794a4758563",
                                "sense_id": "c87b9fe3-47a1-3773-aafd-61577207cf6f",
                                "text": "Le reste de son costume semblait aussi embelli que l’est de nos jours celui d’une beauté quakeresse qui, pendant qu’elle conserve la robe et le costume de sa secte, continue de donner à sa simplicité un certain air de coquetterie qui penche un peu trop vers la vanité du monde par le choix des étoffes et surtout par la manière de les tailler."
                            },
                            {
                                "example_id": "94de26bd-fc56-4887-8e5e-346b45ba5990",
                                "sense_id": "c87b9fe3-47a1-3773-aafd-61577207cf6f",
                                "text": "Aux États-Unis, Edward Saïd choisit d’incorporer l’Église épiscopalienne. Son épouse était quaker."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c2a76e9-53e5-39f3-b5cf-3e9a8301ce6a",
                        "entry_id": "88cd6345-4cbd-3552-a768-8e6e5f41156c",
                        "glosses": [
                            "Relatif au mouvement des quakers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9b3f70-67da-4c02-9eb2-cf8b4a6ab064",
                                "sense_id": "8c2a76e9-53e5-39f3-b5cf-3e9a8301ce6a",
                                "text": "Les paysages rappellent la Suisse, on y fabrique même du fromage. Une initiative de la communauté quaker qui vit là depuis 1951."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f851e6f8-5153-4a7b-a18f-0575cee901c0",
                        "source_entry_id": "88cd6345-4cbd-3552-a768-8e6e5f41156c",
                        "target_lang_word": "Quaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "506b5cee-9ba1-37eb-a9bb-53728824423e",
                                        "entry_id": "c7266a64-938e-31c0-85e0-b225eb5db21c",
                                        "glosses": [
                                            "A believer of the Quaker faith and a member of the Society of Friends, known for their pacifist views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b04ad0-f81e-4db2-83e7-0596c4a7cab8",
                                                "sense_id": "506b5cee-9ba1-37eb-a9bb-53728824423e",
                                                "text": "The demon of fanaticism was the shape which it took with us; and verily, what with religious republicans, harmonists, quakers, fifth-monarchy men, Presbyterians, and the reign of the saints upon earth, it needs the strong hand of a Cromwell to reduce the spiritual chaos to any sort of order."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Quaker",
                                "target_lang_code": "en",
                                "target_senses": [
