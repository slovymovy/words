                ],
                "senses": [
                    {
                        "sense_id": "fac3d787-7670-3a40-9fc5-7ff231353bfa",
                        "entry_id": "78344cb5-627a-3bf2-86e8-9691bf520d70",
                        "glosses": [
                            "großes hohes Möbelstück in einem Wohnzimmer zur verschlossenen Aufbewahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df5fd193-513a-4102-bf95-a466c1503418",
                                "sense_id": "fac3d787-7670-3a40-9fc5-7ff231353bfa",
                                "text": "„Danach ist es für lange Zeit im Wohnzimmerkasten verschwunden, im obersten Fach, und hat dort auf seinen großen Moment gewartet.“"
                            },
                            {
                                "example_id": "de6c0abb-d02e-4050-a75d-2a1670b30d85",
                                "sense_id": "fac3d787-7670-3a40-9fc5-7ff231353bfa",
                                "text": "„Würde ein Mitarbeiter allerdings jedes Jahr einen Wohnzimmerkasten kaufen, fiele das auf.“"
                            },
                            {
                                "example_id": "e78d6663-7c9b-4719-863c-a590b9406184",
                                "sense_id": "fac3d787-7670-3a40-9fc5-7ff231353bfa",
                                "text": "„Daß der Sendeverstärker handwarm war, bezeugen alle drei Beamten übereinstimmend; nach der objektiven Situation (nicht angeschlossenes Funkgerät) und dem subjektiven Verhalten des Bf. (Vorwand, das Meßgerät im Schlafzimmer suchen zu wollen, obwohl es im Wohnzimmerkasten war) sieht der Gerichtshof keinen Grund, an der Richtigkeit dieser ihrer Aussagen zu zweifeln.“"
                            },
                            {
                                "example_id": "ce6932b2-b478-4bef-8a00-557f3fdd3250",
                                "sense_id": "fac3d787-7670-3a40-9fc5-7ff231353bfa",
                                "text": "„Die einen rücken den großen Wohnzimmerkasten mühsam von einer Ecke in die andere – und stellen dann fest, dass er dort doch nicht richtig hinpasst.“"
                            },
                            {
                                "example_id": "be31a74e-fd62-4167-9f80-03a1c8beb15b",
                                "sense_id": "fac3d787-7670-3a40-9fc5-7ff231353bfa",
                                "text": "„Ausgerüstet mit Einweghandschuhen, Kopftüchern, Sturmhauben, einem Baseballschläger und einer Axt – mit der sie dann eine Scheibe und den Wohnzimmerkasten einschlugen – fuhren sie 100 Kilometer weit zum Tatort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
