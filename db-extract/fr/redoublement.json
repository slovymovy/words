        "fr-extract.jsonl": [
            {
                "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                "word": "redoublement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a268c426-7366-4f39-aebc-fe6ca5825c30",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "redoublements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cbd884ed-ca18-3282-9c9e-eb3a6372f1a8",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Accroissement, augmentation considérable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e14ab17-e677-4963-bc9e-ce8bb0ed3f57",
                                "sense_id": "cbd884ed-ca18-3282-9c9e-eb3a6372f1a8",
                                "text": "Ainsi protégés, ils marchèrent rapidement, car le vent, les prenant de dos, les poussa avec une extrême violence, et, par certains redoublements de la rafale, on peut dire qu’ils allaient plus vite qu’ils ne le voulaient."
                            },
                            {
                                "example_id": "fc544c32-0440-40f1-bb0d-e9b236568d15",
                                "sense_id": "cbd884ed-ca18-3282-9c9e-eb3a6372f1a8",
                                "text": "Chaque étranger qui arrivait et mettait pied à terre, excitait dans la foule un redoublement de curiosité […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f30bd58c-cebd-3023-bd39-8f1c299ad63a",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Augmentation périodique ou irrégulière dans l’intensité des symptômes d’une maladie, et particulièrement des fièvres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc5b3e1-0343-48a0-9390-fc33ec5b10f9",
                                "sense_id": "f30bd58c-cebd-3023-bd39-8f1c299ad63a",
                                "text": "Un redoublement de fièvre. Avoir une fièvre continue avec des redoublements."
                            },
                            {
                                "example_id": "7e84b911-e460-4a69-83e1-356ad876ed1a",
                                "sense_id": "f30bd58c-cebd-3023-bd39-8f1c299ad63a",
                                "text": "Fructus belli, fructus belli, s’écriait-il d’une voix peu harmonieuse, pendant les redoublements de cette crise arthritique."
                            }
                        ]
                    },
                    {
                        "sense_id": "e36d6e61-5c2c-3739-8474-496f72da86ce",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Dérivation par la répétition complète ou partielle d’un mot ou d’un de ses morphèmes, pour l’emphase, pour le pluriel, etc. Par exemple, foufou est créé par redoublement de fou. Réduplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1936c09-0e51-4d86-9021-3561306ffa8c",
                                "sense_id": "e36d6e61-5c2c-3739-8474-496f72da86ce",
                                "text": "Le pluriel par réduplication ou redoublement peut n’être pas seul à marquer la pluralité."
                            }
                        ]
                    },
                    {
                        "sense_id": "565e51ef-a06f-3971-888d-2a497bfd7579",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Dérivation par la répétition complète ou partielle d’un mot ou d’un de ses morphèmes, pour l’emphase, pour le pluriel, etc. Par exemple, foufou est créé par redoublement de fou. Réduplication.",
                            "Répétition de la consonne initiale du radical devant l’augment, au parfait des verbes."
                        ],
                        "tags": [
                            "Grammaire grecque"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f8cb3347-47e4-348a-b76a-3e98bec6b6f7",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Fait pour un élève de reprendre le même niveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ceb392-f379-42ba-8d10-491e1098e724",
                                "sense_id": "f8cb3347-47e4-348a-b76a-3e98bec6b6f7",
                                "text": "En juin dernier, lorsque le conseil de classe avait proposé un passage en 5ᵉ pour votre fils alors que vous souhaitiez un redoublement – « Il en fout pas une, ce ramier, ça lui f’ra la nique », aviez-vous argumenté –, nous n'avons pas réussi à vous joindre […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "23ae7d09-63e4-3de8-9fbf-afa87d578078",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Le fait de faire figurer plusieurs fois une note dans un accord, à des octaves différentes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a26762d9-8808-31ce-919a-66eaa4ca9aec",
                        "entry_id": "2be9431d-9bd1-31db-9f68-059a655ff3ea",
                        "glosses": [
                            "Le fait d’ajouter une ou plusieurs octaves à un intervalle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ccdd11-6676-4d82-aebf-f9537251ed05",
                                "sense_id": "a26762d9-8808-31ce-919a-66eaa4ca9aec",
                                "text": "La neuvième est le redoublement de la seconde (2 + 7 = 9). Le douzième est le redoublement de la quinte (5 + 7 = 12)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
