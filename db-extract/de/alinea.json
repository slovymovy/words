                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032f7836-bca1-4cb3-a249-ae526e60deaf",
                                "sense_id": "c234cd87-feed-36b6-9990-eed4ab5f076a",
                                "text": "Ursprünglich war das Zeichen Alinea eine Abkürzung für lateinisch „Capitulum” (Kapitel), also ein offenes C, das von zwei vertikalen Linien durchzogen war."
                            }
                        ],
                        "sense_index_json": "\"2\""
