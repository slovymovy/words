                "senses": [
                    {
                        "sense_id": "ce50d177-6582-3949-a165-c86651c1c319",
                        "entry_id": "a12d97f7-a084-3f22-8325-71a145a7a2d1",
                        "glosses": [
                            "Faire subir l’influence des laboratoires Pfizer à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce00247b-ba81-4511-934b-1fdb57dd5152",
                                "sense_id": "ce50d177-6582-3949-a165-c86651c1c319",
                                "text": "La démarche est si fréquente que, dans le milieu des associations antitabac, on dit de certains qu’ils se sont faits « pfizeriser »."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca713336-ab57-31d1-8f4b-a9c8c229a931",
                        "entry_id": "a12d97f7-a084-3f22-8325-71a145a7a2d1",
                        "glosses": [
                            "Vacciner en utilisant un vaccin produit par les laboratoires Pfizer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9590d77a-23d7-48f3-a084-cf9f2b0c8a3e",
                                "sense_id": "ca713336-ab57-31d1-8f4b-a9c8c229a931",
                                "text": "Monsieur, en charge du repas est en train de se faire pfizeriser en ce moment."
                            },
                            {
                                "example_id": "ce6a1342-2227-4438-b285-05e80e25c639",
                                "sense_id": "ca713336-ab57-31d1-8f4b-a9c8c229a931",
                                "text": "enfin !!! tu vas être pfizerisée"
                            },
                            {
                                "example_id": "1df8116f-f139-4a07-8ebf-dc2afe33d3c5",
                                "sense_id": "ca713336-ab57-31d1-8f4b-a9c8c229a931",
                                "text": "Ce matin, je me suis fait Pfizeriser !"
                            },
                            {
                                "example_id": "9d943431-ec8e-4c2e-8046-a82d067dec61",
                                "sense_id": "ca713336-ab57-31d1-8f4b-a9c8c229a931",
                                "text": "S’il y a seulement 40% des Israéliens qui finalement, ne se font pas Pfizeriser, ce sera une victoire de l’humain."
                            }
                        ]
                    }
                ],
