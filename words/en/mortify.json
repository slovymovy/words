    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc1697a0-3f3b-317b-9dcd-a03354ad2b39",
                    "sense_definition": "To cause someone to feel very embarrassed, ashamed, or humiliated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mother began to <w>mortify</w> him by showing his baby pictures to all of his friends."
                        },
                        {
                            "text": "She was deeply <w>mortified</w> when she realized that her microphone had been on the whole time."
                        }
                    ],
                    "synonyms": [
                        "humiliate",
                        "shame",
                        "demean"
                    ],
                    "antonyms": [
                        "dignify",
                        "honor"
                    ],
                    "common_phrases": [
                        "mortify someone",
                        "deeply mortified"
                    ]
                },
                {
                    "sense_id": "c2119c27-ca2c-3f17-8fd3-d7bd5275b44a",
                    "sense_definition": "To affect someone with vexation, annoyance, or chagrin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "humiliate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rude criticism served only to <w>mortify</w> the young writer after her first public reading."
                        },
                        {
                            "text": "He seemed to enjoy <w>mortifying</w> his colleagues by pointing out their small mistakes during meetings."
                        }
                    ],
                    "synonyms": [
                        "disconcert",
                        "discompose",
                        "perturb",
                        "vex"
                    ]
                },
                {
                    "sense_id": "701d6658-3424-32b4-a540-ff15f41c9254",
                    "sense_definition": "To discipline one's body or physical appetites through self-denial, fasting, or ascetic practices.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "asceticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk sought spiritual purity by choosing to <w>mortify</w> the flesh through strict fasting."
                        },
                        {
                            "text": "Medieval ascetics would often <w>mortify</w> their earthly desires with rigorous physical hardships."
                        }
                    ],
                    "synonyms": [
                        "macerate"
                    ],
                    "common_phrases": [
                        "mortify the flesh"
                    ],
                    "traits": [
