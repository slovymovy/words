        "nl-extract.jsonl": [
            {
                "entry_id": "a872eeeb-60d9-367c-9b82-a24206ea0a16",
                "word": "goedgeefsheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "61c6841e-30c5-3e6a-a3e2-71c5bf112216",
                        "entry_id": "a872eeeb-60d9-367c-9b82-a24206ea0a16",
                        "glosses": [
                            "de mate waarin iemand geneigd is anderen met gulle hand iets te schenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae6d765-7ba6-42f9-9b0d-94c362cb1afc",
                                "sense_id": "61c6841e-30c5-3e6a-a3e2-71c5bf112216",
                                "text": "Op een derde landgoed werd hij ontvangen door een geestelijke met een kruis, omringd door kinderen die hij dankzij de goedgeefsheid van de graaf kon onderrichten in lezen, schrijven en godsdienst."
                            },
                            {
                                "example_id": "2774f088-c8f8-4219-8ffb-0d5cdafd798d",
                                "sense_id": "61c6841e-30c5-3e6a-a3e2-71c5bf112216",
                                "text": "Minder rokers betekent dus minder opnames en minder onkosten. Ik heb geen enkele klik met financiën -mijn vrouw doet thuis de boekhouding en houdt zo al dertig jaar de deurwaarders op een afstand- maar impliceert dit niet dat de rekenmeesters van het MST betere tijden tegemoet gaan? Dat er wellicht geen bezuinigingen nodig zijn? En Herre Kingma geen beroep hoeft te doen op de goedgeefsheid van de bevolking van Enschede om een nieuw ziekenhuis te bouwen?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f17b20da-9f8b-48b1-b929-cf1bc6f8a384",
                        "source_entry_id": "a872eeeb-60d9-367c-9b82-a24206ea0a16",
                        "source_sense_id": "61c6841e-30c5-3e6a-a3e2-71c5bf112216",
                        "source_sense_description": "de mate waarin iemand geneigd is anderen met gulle hand iets te schenken",
                        "target_lang_word": "munificence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "munificence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                                        "entry_id": "83e3f4a7-f0c1-30f1-a82b-4df546bb2d80",
                                        "glosses": [
                                            "The quality of being munificent; generosity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "838436c1-95d8-4dae-9f00-7cdc1349766e",
                                                "sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                                                "text": "Now the happy king laid the forehead of thankſgiving upon the duſt of gratitude; he opened the doors of his wealth to the four winds, and enriched the world, at once, with his munificence."
                                            },
                                            {
                                                "example_id": "72f02305-ccf6-4a85-b0a7-58f291d85865",
                                                "sense_id": "8414f495-3b88-3a95-84de-e0fdd135c3b6",
                                                "text": "And surely, no form of munificence should entitle to a more grateful and lasting remembrance, than that which promotes the right education of youth;..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "munificence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e985a06-b1ae-3af0-88b6-95109cad95ee",
                                        "entry_id": "1d03dcdb-0924-31a7-8fdf-af981288ee0a",
                                        "glosses": [
                                            "Means of defence; fortification."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccb15649-c972-4e11-a838-fac5271d4794",
                                                "sense_id": "5e985a06-b1ae-3af0-88b6-95109cad95ee",
                                                "text": "Untill that Locrine for his Realmes defence,\nDid head against them make and strong munificence"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96bd96f-3bde-4120-9464-68dea2de57a7",
                        "source_entry_id": "a872eeeb-60d9-367c-9b82-a24206ea0a16",
                        "source_sense_id": "61c6841e-30c5-3e6a-a3e2-71c5bf112216",
