                                "target_senses": [
                                    {
                                        "sense_id": "94e4a8b5-943c-3cd3-a12c-ab1e652cd624",
                                        "entry_id": "cbe551a3-93cb-39ef-930f-78eb66b7c582",
                                        "glosses": [
                                            "osoba produkująca bimber lub handlująca nim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb6814ff-4d02-4ce8-9e30-369260410c06",
                                                "sense_id": "94e4a8b5-943c-3cd3-a12c-ab1e652cd624",
                                                "text": "Policjanci zatrzymali bimbrownika, który pokątnie wytwarzał alkohol i sprzedawał go nieletnim."
                                            }
