                ],
                "translations": [
                    {
                        "translation_id": "50dbfee9-22bf-40de-b591-bb02e4ed599b",
                        "source_entry_id": "1ec34fd1-dd74-3b5d-96e5-d02d28fdac8f",
                        "source_sense_id": "9b9a32fb-f65e-3929-a96c-ed3039742e35",
                        "target_lang_word": "exile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "The state of being banished from one's home or country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf95d16-de8e-4f3e-a7bd-003ca5fa4825",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "He lived in exile."
                                            },
                                            {
                                                "example_id": "eb50e641-0cac-4b7d-80ac-a494020503c7",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "They chose exile rather than assimilation."
                                            },
                                            {
                                                "example_id": "17cd259e-ddeb-4cb8-9022-ea5f3c2fe97c",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "Let them be recalled from their exile."
                                            },
                                            {
                                                "example_id": "3dbce57f-9ea8-4caf-b4fe-da514d06f81b",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "Someone who is banished from his home or country."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114ace20-b0e7-47f3-bfdf-5ef2eb2283db",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "She lived as an exile, and did her best to make the most out of such life."
                                            },
                                            {
                                                "example_id": "d3ffce3f-a27d-437b-a365-4cbb94bf6a54",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "Thou art an exile, and thou must not stay."
                                            },
                                            {
                                                "example_id": "48e6b175-21bc-4ffd-b95e-7481a745b37f",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                        "entry_id": "8b58734b-4757-3c88-96bc-30e33853883e",
                                        "glosses": [
                                            "To send (someone or something) into exile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cd5c73-0037-4b82-97a4-bd6c1a20c07e",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "Calling home our exiled friends abroad."
                                            },
                                            {
                                                "example_id": "e906013b-93c6-4eaa-9b2d-b4260c1034e8",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "She, mouldering with the dull earth's mouldering sod, / Inwrapt tenfold in slothful shame, / Lay there exiled from eternal God, / Lost to her place and name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6408dc0c-f990-4ca1-a23f-9f5f37241efe",
                        "source_entry_id": "1ec34fd1-dd74-3b5d-96e5-d02d28fdac8f",
                        "source_sense_id": "9b9a32fb-f65e-3929-a96c-ed3039742e35",
                        "target_lang_word": "outcast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                        "entry_id": "1922064f-fa7a-3145-b0ce-60ddefb41e6d",
                                        "glosses": [
                                            "To cast out; to banish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcdc0ce-0e24-4609-8e19-798cf0e13180",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "And her faire yellow locks behind her flew, / Looſely diſperſt with puff of euery blaſt: / All as a blazing ſtarre doth farre outcaſt / His hearie beames, and flaming lockes diſpredd, / At ſight whereof the people ſtand aghaſt: […]"
                                            },
                                            {
                                                "example_id": "f20995f4-f31f-4220-bb47-020e9b6f856c",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "It means equal ruin to me, as the world reckons it — outcasting, the loss of my appointment, the breaking off my life's work. I pay my price."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                        "entry_id": "3315f9dd-599f-36e7-a483-ae59f2e7d189",
                                        "glosses": [
                                            "That has been cast out; banished, ostracized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e33450-4b43-4f8e-8761-2b692b956bbc",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "O, horrible fate! Outcast, rejected, / As one with pestilence infected!"
                                            },
                                            {
                                                "example_id": "3757b719-0a4d-4a16-b9b2-2db71c31bf71",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "We were not a big huggie family so I was very, very encased in a little stay-away-from-me shell growing-up, and here I got to open up and feel safe and able to touch and hold and be able to be with another human being, which was really a big relief, a very positive part of my understanding of myself that I wasn't just this outcast evil outsider of everything."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "One that has been excluded from a society or system, a pariah, a leper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00859b53-870b-497c-9404-2dd23f9417d5",
                                                "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                                "text": "The other factions believe that those who are Factionless are nomads and outcasts. But they are actually a fully functioning community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "Synonym of outsider: someone who does not belong, a misfit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ad113e-870c-4173-b8f9-c0c527b8ef7d",
                                                "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                                "text": "Do you ever feel like an outcast?\nYou don't have to fit into the format\nOh, but it's okay to be different\n'Cause baby, so am I"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256ec6b3-1751-32c0-90e4-5bd8c8dd304e",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "A quarrel."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b3bac1-2eb5-3a37-9d89-565466b92a21",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "The amount of increase in the bulk of grain during malting."
                                        ],
