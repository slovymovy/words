                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d03e6cec-ceb4-4193-b636-25023c55c054",
                                "sense_id": "ec9316ec-11de-3037-8723-5dbaa981e137",
                                "text": "Het terugdringen van de uitgaven moet 1 miljard euro opleveren. Dat moet onder meer worden bereikt door meer zelfzorg van patienten. Ook moet meer zorg van de specialist worden verschoven naar de huisarts. Een andere besparingsmaatregel is het concentreren van specialistische hulp in een beperkt aantal ziekenhuizen."
                            }
