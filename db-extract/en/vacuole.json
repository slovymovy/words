                        "glosses": [
                            "A large membrane-bound vesicle in a cell's cytoplasm."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "106d0f2a-74d8-3d74-a961-d02209f3d066",
                        "entry_id": "64bd4bbc-605f-3d3d-92a3-5ac1e174fc8c",
                        "glosses": [
                            "A small empty or air-filled space or vacuity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1d4715-989c-4ce9-a60d-2364a66a2159",
                                "sense_id": "106d0f2a-74d8-3d74-a961-d02209f3d066",
                                "text": "This surface itself was not entirely homogeneous, but beneath it, seen as through ground glass, there were dim whitish patches or vacuoles, which varied constantly in shape and size."
                            }
                        ]
                    }
                ],
