                                        "sense_id": "8eb4c09c-b205-34cc-be56-7aa1faca8a5a",
                                        "entry_id": "5970ad6e-e771-3e59-8851-c5deeee63724",
                                        "glosses": [
                                            "A meal, sandwiches or anything packed and intended to be eaten away from home; especially, one packed at home as opposed to a portable packaged lunch from a vendor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c01ff28-6948-4afa-97ff-53d73b11f220",
                                                "sense_id": "8eb4c09c-b205-34cc-be56-7aa1faca8a5a",
                                                "text": "I forgot my packed lunch when I left for work this morning."
                                            }
                                        ]
