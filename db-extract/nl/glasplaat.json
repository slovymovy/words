                        "cross_references": [
                            {
                                "target_word": "sheet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc67238-59b6-39cb-a80d-6269566a0578",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A thin bed cloth used as a covering for a mattress or as a layer over the sleeper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f27f944-0530-4b56-a62a-6b9cc39572b9",
                                                "sense_id": "6dc67238-59b6-39cb-a80d-6269566a0578",
                                                "text": "Use the sheets in the hall closet to make the bed."
                                            },
                                            {
                                                "example_id": "74ddf325-b033-4f55-b1a6-b7f05f7ea4a4",
                                                "sense_id": "6dc67238-59b6-39cb-a80d-6269566a0578",
                                                "text": "He fell into a trance, and saw heaven opened, and a certain vessel descending unto him, as it had been a great sheet knit at the four corners."
                                            },
                                            {
                                                "example_id": "5a0af921-124b-42e5-88fa-1a6bc3eead22",
                                                "sense_id": "6dc67238-59b6-39cb-a80d-6269566a0578",
                                                "text": "If I do die before thee, prithee, shroud me / In one of those same sheets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6be804-482f-316f-a95a-ce5a814d652e",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A piece of paper, usually rectangular, that has been prepared for writing, artwork, drafting, wrapping, manufacture of packaging (boxes, envelopes, etc.), and for other uses. The word does not include scraps and irregular small pieces destined to be recycled, used for stuffing or cushioning or paper mache, etc. In modern books, each sheet of paper is typically folded in half, to produce two leaves and four pages. In the absence of folding, \\\"leaf\\\" and \\\"sheet\\\" are equivalent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b908323-bf96-4c52-82f0-136f4ee52ae0",
                                                "sense_id": "3f6be804-482f-316f-a95a-ce5a814d652e",
                                                "text": "A sheet of paper measuring eight and one-half inches wide by eleven inches high is a popular item in commerce."
                                            },
                                            {
                                                "example_id": "14d75278-583f-4fd2-9166-64120cdf98a2",
                                                "sense_id": "3f6be804-482f-316f-a95a-ce5a814d652e",
                                                "text": "Paper is designated “20 pound” if a stack (ream) of 500 sheets 22 inches by 17 inches weighs 20 pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25694a6c-de98-38f8-b5c1-0d5d3ef55581",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A flat metal pan, often without raised edge, used for baking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f3d3da-8642-40f6-9488-d0bd70e941f7",
                                                "sense_id": "25694a6c-de98-38f8-b5c1-0d5d3ef55581",
                                                "text": "Place the rolls on the cookie sheet, edges touching, and bake for 10-11 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d90fd40-5259-358c-aa80-5660ae0ff297",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A thin, flat piece or layer of solid material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "888f4b24-7791-4327-98ec-fe021a95be05",
                                                "sense_id": "6d90fd40-5259-358c-aa80-5660ae0ff297",
                                                "text": "The glazer cut several panes from a large sheet of glass."
                                            },
                                            {
                                                "example_id": "fe316671-c4bf-406a-9367-3164475158f8",
                                                "sense_id": "6d90fd40-5259-358c-aa80-5660ae0ff297",
                                                "text": "A sheet of that new silicon stuff is as good as a sheet of tinfoil to keep food from sticking in the baking pan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "176f8f30-fa48-3fc9-87b3-6ddbf2db6cce",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A broad, flat expanse or covering of a material on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438ef062-9f50-4ffe-8fcf-d560510c1577",
                                                "sense_id": "176f8f30-fa48-3fc9-87b3-6ddbf2db6cce",
                                                "text": "Mud froze on the road in a solid sheet, then more rain froze into a sheet of ice on top of the mud!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bee627a2-f0ed-3119-bb99-19d91a44de56",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "An expanse of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9898f5ba-9dc5-4ff2-9fb8-2973e0d1290e",
                                                "sense_id": "bee627a2-f0ed-3119-bb99-19d91a44de56",
                                                "text": "[…] heavy sheets of rain with heavy gusts at N.E.; […]"
                                            },
                                            {
                                                "example_id": "2efeca0e-429c-4cbe-9a34-c0fdc2c0e37b",
                                                "sense_id": "bee627a2-f0ed-3119-bb99-19d91a44de56",
                                                "text": "... sheets of fire could be seen. The air became intensely hot and they knew that the forest-fire was upon them."
                                            },
                                            {
                                                "example_id": "354bc0bb-3548-4b6e-a75e-b454afb139fb",
                                                "sense_id": "bee627a2-f0ed-3119-bb99-19d91a44de56",
                                                "text": "... sheets of light which appear to be formed by a source at one location for horizontal sheets and another location for vertical sheets . This is the direct result of the relative displacement of the two scanners along the optical axis[…]"
                                            },
                                            {
                                                "example_id": "20bcef71-0e15-4167-9b12-a3e526758b94",
                                                "sense_id": "bee627a2-f0ed-3119-bb99-19d91a44de56",
                                                "text": "Heavy sheets of rain dwindled to a slow, quiet drizzle as she pulled the car toward the front door of her store. By the time she stepped out of the car, the drizzle had turned into a scattering of flurries that wafted lazily in the air[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341ad425-9c92-3497-8bb9-13b5c2497275",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A line (rope) used to adjust the trim of a sail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdc57815-05b5-4210-9ac4-c27e3fd0261e",
                                                "sense_id": "341ad425-9c92-3497-8bb9-13b5c2497275",
                                                "text": "To be \"three sheets to the wind\" is to say that a four-cornered sail is tethered only by one sheet and thus the sail is useless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d43e075-b1ab-38cd-9bf0-55f8d17304c8",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "A sail."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2812ab-1614-4fc5-948d-ea55da7d75f7",
                                                "sense_id": "3d43e075-b1ab-38cd-9bf0-55f8d17304c8",
                                                "text": "Their folded Sheets dismiss the useless Air"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddfe1cd0-ca5c-3a6f-b46b-fb48b4462be9",
                                        "entry_id": "9c287ba2-ec27-3ce3-b74d-66534d21caae",
                                        "glosses": [
                                            "The area of ice on which the game of curling is played."
                                        ],
