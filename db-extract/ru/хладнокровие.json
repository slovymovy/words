                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b784de34-8cb9-4fec-8016-c2738fccb365",
                        "source_entry_id": "7d1a56fb-e786-3cbf-94db-d6336a071153",
                        "source_sense_id": "975bad5b-9cc5-3c99-8cb4-e2fe06c094fa",
                        "target_lang_word": "sangfroid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sangfroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                        "entry_id": "1b0524df-55f7-3ee2-82c0-cb27ad1e9570",
                                        "glosses": [
                                            "Composure, self-possession or imperturbability especially when in a dangerous situation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2a938e-a682-4193-918e-6f22531b4dc6",
                                                "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                                "text": "He handled the stressful situation with great sangfroid."
                                            },
                                            {
                                                "example_id": "ddb4a4b1-b23b-4af3-be59-cc45e4250670",
                                                "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                                "text": "The provincial people, intimidated by Gudrun’s perfect sang-froid and exclusive bareness of manner, said of her: “She is a smart woman.\""
                                            },
                                            {
                                                "example_id": "847242b7-bdde-4a7a-a9c6-2010c434e7f1",
                                                "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                                "text": "We can handle functions of a few variables with some aplomb and view sets of quantities totalling 10⁶ or 10⁷ with sangfroid."
                                            },
                                            {
                                                "example_id": "5a228ab7-f8cb-4317-92b5-092dfc81a3ea",
                                                "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                                "text": "Indeed, some of the little naked human figures seemed to display a near comical sangfroid, even as they were pecked by giant birds, hatched out of eggs, had huge flowers inserted in their bottoms, or, in the case of one of my favourites, sported a monstrous blueberry instead of a head."
                                            },
                                            {
                                                "example_id": "61520e70-c91c-4617-937a-8df75c197e50",
                                                "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            },
                                            {
                                                "example_id": "6879adca-3c9f-432f-8886-23621ec63f58",
                                                "sense_id": "e4fa64a5-a7d3-3521-a3d3-3a874690676b",
                                                "text": "If there’s one unspoken club rule, it’s that when we meet, we only discuss the play in question: no gossip; no politics; no families; and no football. As an association, we demonstrate near-Olympic sang-froid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79414e0f-2706-4abc-a5c3-e114ced96e93",
                        "source_entry_id": "7d1a56fb-e786-3cbf-94db-d6336a071153",
                        "source_sense_id": "975bad5b-9cc5-3c99-8cb4-e2fe06c094fa",
                        "target_lang_word": "Kaltblütigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaltblütigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a050a762-5cbe-3040-baa8-6e31a3727285",
                                        "entry_id": "f22fe5c9-08d3-30ae-9e1f-4fdd28d756be",
                                        "glosses": [
                                            "Eigenschaft/Haltung, bei etwas nicht gefühlsbestimmt, sondern vollkommen gefasst zu sein, zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4523cd84-9618-425a-97b5-29315cbf40d4",
                                                "sense_id": "a050a762-5cbe-3040-baa8-6e31a3727285",
                                                "text": "„Da ich erst zwölf Jahre alt war, hatte mein Geist noch nicht die Kaltblütigkeit erlangt, Pläne für eine heroische Rache zu schmieden, wie sie das eingebildete Ehrgefühl ausheckt.“"
                                            },
                                            {
                                                "example_id": "4f4997ed-0b3a-4844-acfe-72468c80dc12",
                                                "sense_id": "a050a762-5cbe-3040-baa8-6e31a3727285",
                                                "text": "„Der Seeräuber, denn dieser war es, wie unsre Leser entnommen haben werden, hatte, während der Wilde den Dolch zuckte, mit vieler Kaltblütigkeit sein Glas ausgetrunken.“"
                                            },
                                            {
                                                "example_id": "980038b8-ab50-451a-aa01-8509457f65a0",
                                                "sense_id": "a050a762-5cbe-3040-baa8-6e31a3727285",
                                                "text": "„Ich bewunderte die Kaltblütigkeit Reginalds.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da977063-1af1-355c-8f04-1c2d26e8f0b7",
                                        "entry_id": "f22fe5c9-08d3-30ae-9e1f-4fdd28d756be",
                                        "glosses": [
                                            "Eigenschaft, skrupellos und brutal zu handeln"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d715f8a5-4bb8-4f7c-b05c-448978787be2",
                                                "sense_id": "da977063-1af1-355c-8f04-1c2d26e8f0b7",
                                                "text": "Die Kaltblütigkeit, mit der er die Bank überfallen und ausgeraubt sowie bei seiner anschließenden Flucht zwei Polizeibeamte angeschossen hatte, machte die Ermittler sprachlos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d11ecdb-0c83-489f-8213-04fdbcac7101",
                        "source_entry_id": "7d1a56fb-e786-3cbf-94db-d6336a071153",
                        "source_sense_id": "975bad5b-9cc5-3c99-8cb4-e2fe06c094fa",
                        "target_lang_word": "koelbloedigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koelbloedigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                                        "entry_id": "39aa1a77-3544-391a-ba8b-2f4f75c4d252",
                                        "glosses": [
                                            "het vermogen onder zware druk of bij dreigend gevaar kalm te blijven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e959adac-79a3-4169-ba45-da557470551c",
                                                "sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                                                "text": "Haar koelbloedigheid redde haar uit de hachelijke onstandigheden."
                                            },
                                            {
                                                "example_id": "19334146-8011-4597-9773-3f407b6e38cb",
                                                "sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                                                "text": "Of waren ze ergens in het Oosten opgeleid? Anderzijds sprak er een koelbloedigheid uit hun gedrag die zelfs die van de meest ervaren en doortrapte misdadigers verre oversteeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
