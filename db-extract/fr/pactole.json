                    },
                    {
                        "translation_id": "ca34aa93-979c-4a93-ba06-a6316f517e91",
                        "source_entry_id": "d24b233d-1e16-3077-866b-2cd76d8f0c34",
                        "source_sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                        "target_lang_word": "gewinnbringende Idee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "92a47397-0669-4f82-9659-265ee6209cf7",
                        "source_entry_id": "d24b233d-1e16-3077-866b-2cd76d8f0c34",
                        "source_sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
                        "target_lang_word": "Goldgrube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Goldgrube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e39dfbaa-cf86-3d90-b847-75b6b66a637b",
                                        "entry_id": "eab621c0-406b-3eb5-abe5-845b93db75ff",
                                        "glosses": [
                                            "Mine, in der Gold abgebaut wird"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b68c00-90ac-4c5a-8a85-074beda525a8",
                                                "sense_id": "e39dfbaa-cf86-3d90-b847-75b6b66a637b",
                                                "text": "„[…] die Eltern sehr vieler unserer Mitschüler [arbeiteten] als nicht qualifizierte Arbeiter in Goldgruben.“"
                                            },
                                            {
                                                "example_id": "f14d5ccc-8909-461e-922d-2cf602969074",
                                                "sense_id": "e39dfbaa-cf86-3d90-b847-75b6b66a637b",
                                                "text": "[Suriname:] „Doch nicht nur Wald und Hütten sind auf dem Weg zu Waddy Siesas Heimatdorf zu sehen, sondern auch […] riesige Goldgruben. Gold ist der Exportschlager des Landes, gefolgt von Holz, Aluminium und Öl.“"
                                            },
                                            {
                                                "example_id": "e5173bef-1d64-4ee0-8f65-45933232d5fd",
                                                "sense_id": "e39dfbaa-cf86-3d90-b847-75b6b66a637b",
                                                "text": "[…] bei einem Angriff auf einen Konvoi mit Beschäftigten des kanadischen Goldproduzenten Semafo [waren] 38 Menschen getötet und mehr als 60 verletzt worden. Das in Montreal heimische Bergbauunternehmen Semafo teilte mit, der Konvoi aus fünf Bussen sei auf der Straße zwischen Fada und der Goldgrube Boungou im Osten des Landes unterwegs gewesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                        "entry_id": "eab621c0-406b-3eb5-abe5-845b93db75ff",
                                        "glosses": [
                                            "Geschäft/Unternehmen, das hohe Profite erwirtschaftet"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31a8d554-3795-48f8-aa58-b888a812e7db",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "Dieser Laden ist eine echte Goldgrube."
                                            },
                                            {
                                                "example_id": "1072d6e2-0e30-4836-9cbf-c21817506b04",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "Dieses Restaurant ist eine wahre Goldgrube, morgens, mittags, abends, es ist immer voll."
                                            },
                                            {
                                                "example_id": "89b6f4d3-672a-452b-aaac-d6cec5f0d61e",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "Für die Mafia ist der Handel mit Kokain eine Goldgrube."
                                            },
                                            {
                                                "example_id": "d707dc71-c3df-456b-8966-0bdbefa25205",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„[…] für die Zuhälter und alle, die an der Prostitution verdienen, ist es eine Goldgrube.“"
                                            },
                                            {
                                                "example_id": "97f29687-3ece-4dec-ace2-e38021f17cc8",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Für die großen Internetkonzerne und die sozialen Netzwerke sind die Daten ihrer Nutzer eine Goldgrube, zum Ärger der Datenschützer.“"
                                            },
                                            {
                                                "example_id": "d72b9c19-8766-4ee3-b482-84e8a532bb55",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Die Daten, die in Zukunft vermehrt von Thermostaten und allen möglichen anderen Geräten erhoben, gespeichert oder weitergeleitet werden, sind eine Goldgrube für die werbetreibende Industrie.“"
                                            },
                                            {
                                                "example_id": "7f248953-5320-4b56-a273-06e36d28f0cf",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Multiple Sklerose ist eine unheilbare Krankheit – laufend kommen neue Medikamente auf den Markt. MS-Medikamente sind eine Goldgrube für Pharmafirmen.“"
                                            },
                                            {
                                                "example_id": "7895d029-a90e-4981-a747-c34fff6fdf23",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Im Norden der Niederlande, in der Provinz Groningen, gibt es das größte Erdgasvorkommen Europas. […] Das Erdgasfeld war eine Goldgrube.“"
                                            },
                                            {
                                                "example_id": "95065bac-e6d8-4dee-bb10-2338369e8747",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Trotz aller Rückschläge ist Franz davon überzeugt, dass sein Hotel eine Goldgrube wird.“"
                                            },
                                            {
                                                "example_id": "1a8986a5-a1c9-4864-99c5-16933b24bf4d",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„[Die Schallplattenfirma] Capitol Records erwies sich schnell als Goldgrube.“"
                                            },
                                            {
                                                "example_id": "93fd2acb-8276-4c19-b0a0-fcf7321ffee0",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Der Suezkanal hatte sich als Goldgrube entpuppt […]“"
                                            },
                                            {
                                                "example_id": "f9ef7082-5b09-4eb2-8801-085cb8b44864",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Bis ins 19. Jahrhundert galt St. Peter-Ording als arm. Der Sand und die raue Nordsee machten den Einwohnern zu schaffen. Niemand ahnte, dass die Nähe zum Meer den Ort mal zur Goldgrube machen würde.“"
                                            },
                                            {
                                                "example_id": "f8dfde1f-5b81-4b42-92f2-9be92d0aa71a",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Gleich hinter der Brücke lag der „Fondaco dei Tedeschi“, seit dem 13. Jahrhundert die große Handelsniederlassung der deutschen Kaufleute, zu Zeiten Dürers eine wahre Goldgrube für die Signoria. Denn hier mussten alle Handel treibenden Deutschen wohnen, speisen und ihre Geschäfte tätigen […].“"
                                            },
                                            {
                                                "example_id": "6803f914-a467-4c80-8487-484589ac3596",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Memes sind mit das lustigste, das das Netz je hervorgebracht hat. Für Musiker*innen [sic] ist das eine Goldgrube: Denn es gibt keine bessere Werbung als ein Foto oder Video mit deinem Gesicht drauf, das viral geht.“"
                                            },
                                            {
                                                "example_id": "8666dac5-f8e1-4daa-8185-bdbec37d7d84",
                                                "sense_id": "cf434dbe-a70b-3979-b33e-3edd4f0c4e4b",
                                                "text": "„Wegen des Arbeitskräftemangels nach dem Zweiten Weltkrieg schloss die Bundesrepublik 1955 das erste Anwerbeabkommen mit Italien, dem weitere derartige Verträge mit anderen Ländern folgten. Für deutsche Firmen war das eine Goldgrube. Die zumeist ungelernten Ausländer mit wenig Schulbildung akzeptierten geringe Löhne als deutsche Arbeitnehmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbb05462-b223-4e05-875f-993821a964c4",
                        "source_entry_id": "d24b233d-1e16-3077-866b-2cd76d8f0c34",
                        "source_sense_id": "c7746895-0765-3d17-b2fc-2045c9fccd8f",
