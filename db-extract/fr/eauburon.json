                        "glosses": [
                            "Nom de plusieurs champignons de la famille des lactaires."
                        ],
                        "tags": [
                            "Vosges"
                        ],
                        "examples": [
                            {
                                "example_id": "322b46ed-fb8c-44da-9149-e246152accb2",
                                "sense_id": "b60b34cf-6b18-36ff-a32f-a2fa3a5d0344",
                                "text": "EAUBURON. L'Agaric poivré porte ce nom dans quelques lieux."
                            },
                            {
                                "example_id": "914d288f-429d-4fb2-92e1-3cf9b127786e",
                                "sense_id": "b60b34cf-6b18-36ff-a32f-a2fa3a5d0344",
                                "text": "Sous le nom d'Eauburon, on vend quelquefois sur le marché de Vesoul le lactaire à toison."
                            },
                            {
                                "example_id": "c9465a52-42f9-46cb-aa14-470d6d15b529",
                                "sense_id": "b60b34cf-6b18-36ff-a32f-a2fa3a5d0344",
                                "text": "L’auburon (ou eauburon), se trouve en quantité dans les bois pendant l'été et l'automne. Il est entièrement blanc, mais en vieillissant, ses feuillets prennent une couleur de paille."
                            }
                        ]
