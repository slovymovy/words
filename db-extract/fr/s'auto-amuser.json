                        "glosses": [
                            "S’amuser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790da231-33a1-4878-b7e1-3ea4a079d574",
                                "sense_id": "1fd80702-73b8-3260-91e1-c70e3dfad5b2",
                                "text": "Je crois que je pourrais ajouter à la liste de mes super pouvoirs qui servent à rien la faculté de m'auto-amuser."
                            },
                            {
                                "example_id": "3c954611-9a1d-40b4-9095-de36aa8c15cf",
                                "sense_id": "1fd80702-73b8-3260-91e1-c70e3dfad5b2",
                                "text": "Hier, Guy Carlier et certains ses confrères humoristiques se plaisaient à s'auto-amuser d'un PSG en panne de réussite."
                            },
                            {
                                "example_id": "43f293c2-ac75-4176-ac73-324e12317717",
                                "sense_id": "1fd80702-73b8-3260-91e1-c70e3dfad5b2",
                                "text": "(auto-blague...veuillez m'excuser...c'est pour m'auto-amuser si un jour je relis ceci)"
                            }
                        ]
                    }
