                ],
                "senses": [
                    {
                        "sense_id": "463063c5-7f19-36d0-a64b-aab63b61e9a5",
                        "entry_id": "e2ded274-5485-3596-aea4-f010c59d252f",
                        "glosses": [
                            "Grand oiseau de la famille des dromaiidés, originaire d’Australie, et qui ne sait pas voler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a5c838-2d3b-4000-8a98-73ca3d73dc9d",
                                "sense_id": "463063c5-7f19-36d0-a64b-aab63b61e9a5",
                                "text": "Emu, l’émeu émet un son ronflant qui porte à deux kilomètres, grâce à une sorte de sac à vent qui n’est pas sans rappeler celui des cornemuses, et qu’on appelle la poche gulaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2c575ec-6510-45b6-838d-b79e6be0d904",
                        "source_entry_id": "e2ded274-5485-3596-aea4-f010c59d252f",
                        "source_sense_id": "463063c5-7f19-36d0-a64b-aab63b61e9a5",
                        "target_lang_word": "Emu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "718c1007-730e-370b-a4bd-eb6164e2b009",
                                        "entry_id": "8a860ace-af78-308c-9705-ac20261f1bd2",
                                        "glosses": [
                                            "bis 1,70 m hoher, flügelloser aber schnellfüßiger Laufvogel Australiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7167022c-96e3-4d73-a156-1d99ef4a2a32",
                                                "sense_id": "718c1007-730e-370b-a4bd-eb6164e2b009",
                                                "text": "Das ist kein Nandu, sondern ein Emu!"
                                            },
                                            {
                                                "example_id": "63918805-d1ca-4b41-94c6-8c8d599e4fc9",
                                                "sense_id": "718c1007-730e-370b-a4bd-eb6164e2b009",
                                                "text": "„Wo sich der Rest vom Emu versteckt, konnte bislang aber nicht geklärt werden.“"
                                            },
                                            {
                                                "example_id": "3c198e95-4095-4248-8819-e5b13d0d0ca9",
                                                "sense_id": "718c1007-730e-370b-a4bd-eb6164e2b009",
                                                "text": "„Tiere, die sie bislang noch nicht gesehen hatten, liefen ihnen dabei über den Weg; einmal rannte Top sogar hinter einem Emu her, konnte ihn aber nicht einholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf85b078-725f-3a05-9381-d8b508af5fac",
                                        "entry_id": "8a860ace-af78-308c-9705-ac20261f1bd2",
                                        "glosses": [
                                            "der Emulator"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54eb8435-b767-486f-a676-60f17368f2a7",
                                                "sense_id": "bf85b078-725f-3a05-9381-d8b508af5fac",
                                                "text": "Ich hab' gelesen, es soll Emus für langsame 386er geben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Emu",
                                "target_lang_code": "de",
                                "target_senses": [
