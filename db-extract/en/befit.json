                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510d0e43-5381-44b2-bac7-c400cb0b0027",
                                                "sense_id": "8a584f19-df20-373a-ae82-c69a9639cd5d",
                                                "text": "Als Hauptproblem der Verhandlung standen die Wirren um die Finanzkrise an."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21dec2c7-0216-3706-968c-977f51231274",
                                        "entry_id": "b70f93dc-b936-36b5-b293-bb1760cf609e",
                                        "glosses": [
                                            "zu Gesicht stehen, einen bestimmten Eindruck machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182a2e97-a028-423c-8991-c5cb1bf21043",
                                                "sense_id": "21dec2c7-0216-3706-968c-977f51231274",
                                                "text": "Aufwendige Repräsentation steht einer Organisation schlecht an, die von Spenden und öffentlichen Mitteln lebt."
                                            },
                                            {
                                                "example_id": "25b8f5f7-6b15-4149-9e48-3acab998ed39",
                                                "sense_id": "21dec2c7-0216-3706-968c-977f51231274",
                                                "text": "„Es steht dem Kanzler der Bundesrepublik Deutschland nicht gut an, sich auf ein Stühlchen zu setzen und zu warten, bis ihm das Wort erteilt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1ce0a47b-944b-3ffe-b11a-56e125d462cd",
                                        "entry_id": "b70f93dc-b936-36b5-b293-bb1760cf609e",
                                        "glosses": [
                                            "festgelegt, angesetzt sein"
                                        ],
                                        "tags": [],
                                        "examples": [
