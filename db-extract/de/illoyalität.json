                "senses": [
                    {
                        "sense_id": "6aa3391a-e595-3d0d-8a7d-9085edce397e",
                        "entry_id": "f2d353c2-9a9f-3cae-850e-14369281689a",
                        "glosses": [
                            "Mangel an Loyalität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affb126e-bcfa-4aa4-8f36-3b74c9062566",
                                "sense_id": "6aa3391a-e595-3d0d-8a7d-9085edce397e",
                                "text": "„Solche Art von Illoyalität ist real, sie existiert in jeder Stadt, und sie schadet uns allen.“"
                            },
                            {
                                "example_id": "a1838de1-eaf4-4a39-9ce8-ec89ac91045d",
                                "sense_id": "6aa3391a-e595-3d0d-8a7d-9085edce397e",
                                "text": "„Premierminister Mugabe wies alle Vorwürfe, die ihm eine Delegation der katholischen Kirche mit klaren Beweisen vorlegte, zurück und beschuldigte die Bischöfe der Illoyalität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
