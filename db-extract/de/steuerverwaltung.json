                "senses": [
                    {
                        "sense_id": "80e41a27-292c-34fd-8cff-aef19cc31503",
                        "entry_id": "d5737e13-de1e-3fc3-9db6-eb06838af769",
                        "glosses": [
                            "Behörde beziehungsweise Gesamtheit der Behörden, die für die Festsetzung und Erhebung von Steuern zuständig ist/sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d408f7e6-89d8-41e7-a056-7e79ce857eb6",
                                "sense_id": "80e41a27-292c-34fd-8cff-aef19cc31503",
                                "text": "„Wegen des früheren Waffenhandels habe die Eidgenössische Steuerverwaltung gewünscht, die Gesellschaft zu liquidieren, führte er im Protokoll aus.“"
                            },
                            {
                                "example_id": "6f3c14ca-d1a9-40d4-9c67-7ba028b31fd8",
                                "sense_id": "80e41a27-292c-34fd-8cff-aef19cc31503",
                                "text": "„Dort hatte es die Krone bis 1806 nicht geschafft, Einfluß auf die landständische Steuerverwaltung zu gewinnen.“"
                            },
                            {
                                "example_id": "8a5e2592-3698-4a60-900b-adcc5f27ec72",
                                "sense_id": "80e41a27-292c-34fd-8cff-aef19cc31503",
                                "text": "„Wenn du dich beispielsweise für die Ausbildung an einem Finanzamt entscheidest, machst du eine ‚Ausbildung zum Finanzwirt in der Steuerverwaltung‘.“"
                            },
                            {
                                "example_id": "77e4239a-d112-450a-a3cd-9b42bd17934e",
                                "sense_id": "80e41a27-292c-34fd-8cff-aef19cc31503",
                                "text": "„Unabhängig von einem Antrag der steuerpflichtigen Person kann die separate Beurteilung auch durch die Steuerverwaltung angeordnet werden.“"
                            },
                            {
                                "example_id": "4b36e941-a036-4b5e-a993-533f1aeb8e51",
                                "sense_id": "80e41a27-292c-34fd-8cff-aef19cc31503",
                                "text": "„Die Bestrebungen der Steuerverwaltung, die externe Vernetzung zu optimieren, werden auch in den nächsten Jahren weiter konsequent fortgesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
