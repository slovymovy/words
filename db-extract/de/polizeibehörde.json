                ],
                "senses": [
                    {
                        "sense_id": "7a3d0a8d-2618-364b-8551-7e3a788abe1f",
                        "entry_id": "6c851d1b-a8c8-3153-b570-130e3c2ab4cf",
                        "glosses": [
                            "Behörde, die polizeiliche Aufgaben übernimmt; Behörde der Polizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f131493-b930-417c-958b-8b12bf48c10f",
                                "sense_id": "7a3d0a8d-2618-364b-8551-7e3a788abe1f",
                                "text": "„Jede Polizeiabteilung in England und Wales ist einer Polizeibehörde, die aus Stadträten, Richtern und unabhängigen Mitgliedern besteht, rechenschaftspflichtig.“"
                            },
                            {
                                "example_id": "ed0b490a-67a0-4be9-b470-d421ba7ff2b5",
                                "sense_id": "7a3d0a8d-2618-364b-8551-7e3a788abe1f",
                                "text": "„Nach dem neuen deutschen Reichsseuchengesetz müssen gefährliche Krankheiten unverzüglich der zuständigen Polizeibehörde mitgeteilt werden.“"
                            },
                            {
                                "example_id": "5d272a11-4f84-4ad8-a8a9-8d03cb683c54",
                                "sense_id": "7a3d0a8d-2618-364b-8551-7e3a788abe1f",
                                "text": "„Die Berliner Polizeibehörde verbietet Wahrsagerei.“"
                            },
                            {
                                "example_id": "84691ee7-220b-4be9-909e-c2c27661f777",
                                "sense_id": "7a3d0a8d-2618-364b-8551-7e3a788abe1f",
                                "text": "„Die niederländische Regierung in Den Haag weist die Polizeibehörden an, den Zustrom deutscher Emigranten einzudämmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
