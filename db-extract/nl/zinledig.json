                                "target_senses": [
                                    {
                                        "sense_id": "2beb6c04-e4bf-3536-a46f-831bde53f3d6",
                                        "entry_id": "691fc091-b4aa-3045-bcc4-978d60d4e21e",
                                        "glosses": [
                                            "Lacking meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22bfed05-0f6c-4d58-86d8-e372f4c8070a",
                                                "sense_id": "2beb6c04-e4bf-3536-a46f-831bde53f3d6",
                                                "text": "The word \"gugugu\" is meaningless in English."
                                            },
                                            {
                                                "example_id": "065c1cf1-77ca-49c5-9880-01febb8da0dc",
                                                "sense_id": "2beb6c04-e4bf-3536-a46f-831bde53f3d6",
                                                "text": "As the years go by, speech reverts to childhood levels of disfluency, with more pauses, more errors, more repeated words, but even the peak years are not great: up to 8 percent of the average person’s word output consists of meaningless fillers and placeholders like um, uh and er."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "871b4ead-4791-3917-8e74-736561b21d87",
                                        "entry_id": "691fc091-b4aa-3045-bcc4-978d60d4e21e",
                                        "glosses": [
                                            "Insignificant; not worthy of importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e22a572-a8b4-4c00-8af4-e2d0c8d13c5b",
                                                "sense_id": "871b4ead-4791-3917-8e74-736561b21d87",
                                                "text": "All our efforts were ultimately meaningless."
                                            },
                                            {
                                                "example_id": "4ce4a456-d2b0-4447-9827-4d7513e9d998",
                                                "sense_id": "871b4ead-4791-3917-8e74-736561b21d87",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c075ec59-aa7e-4372-9dbe-abaaa615d34a",
                        "source_entry_id": "f27d9b1e-840a-3e4c-9cc5-2ada935d751c",
                        "source_sense_id": "f67eff3f-b628-3585-b925-c109029491a8",
                        "target_lang_word": "senseless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "senseless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd34708-092c-32ab-b876-0ebe99eedaf1",
                                        "entry_id": "e487a7ae-0617-334f-9263-652b437870d1",
                                        "glosses": [
                                            "Without feeling or desire to work; deprived of sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181905ec-c7f9-4620-805e-5a4d0be0e096",
                                                "sense_id": "8bd34708-092c-32ab-b876-0ebe99eedaf1",
                                                "text": "The blow to his head rendered him senseless; he didn’t awaken until he was in the ambulance."
                                            },
                                            {
                                                "example_id": "92312db4-ca65-4631-a700-82726c5ec146",
                                                "sense_id": "8bd34708-092c-32ab-b876-0ebe99eedaf1",
                                                "text": "That hoary man had spent his livelong age / In converse with the dead, who leave the stamp / Of ever-burning thoughts on many a page, / When they are gone into the senseless damp / Of graves; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a2ce9b-67fa-3733-97bc-c34e325395fe",
                                        "entry_id": "e487a7ae-0617-334f-9263-652b437870d1",
                                        "glosses": [
                                            "Lacking meaning or purpose; without common sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19970159-76be-4120-97b0-b2761cae28a6",
                                                "sense_id": "c4a2ce9b-67fa-3733-97bc-c34e325395fe",
                                                "text": "What a senseless waste of money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8346d051-9c60-3c6e-8784-d9df68ec9578",
                                        "entry_id": "e487a7ae-0617-334f-9263-652b437870d1",
                                        "glosses": [
                                            "Without a discernible meaning or purpose, especially of a violent or evil act."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99343111-ab06-49f0-b9ab-0bc233b97cba",
                                                "sense_id": "8346d051-9c60-3c6e-8784-d9df68ec9578",
                                                "text": "The school shooting was a senseless act of violence."
                                            },
                                            {
                                                "example_id": "3508c205-c042-47b7-b76c-ba0cc3665239",
                                                "sense_id": "8346d051-9c60-3c6e-8784-d9df68ec9578",
                                                "text": "Addressing the nation on Thursday, Czech Prime Minister Petr Fiala called the shooting “a senseless attack” and said “this Christmas will be unimaginably sad.”"
                                            },
                                            {
                                                "example_id": "50d57038-884c-4852-bdb8-4283ef14a07c",
                                                "sense_id": "8346d051-9c60-3c6e-8784-d9df68ec9578",
                                                "text": "At the news conference, Crump called her killing “senseless on every level.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ffd769-78e7-3092-81de-6366febf2fd9",
                                        "entry_id": "e487a7ae-0617-334f-9263-652b437870d1",
                                        "glosses": [
                                            "Without consideration, awareness or sound judgement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ee8411-648f-4ab3-85c1-fe2138cdfacf",
                                                "sense_id": "10ffd769-78e7-3092-81de-6366febf2fd9",
                                                "text": "He took senseless risks, not even aware of the danger he was in."
                                            },
                                            {
                                                "example_id": "24660820-d67c-46d6-b962-addf1cf505cf",
                                                "sense_id": "10ffd769-78e7-3092-81de-6366febf2fd9",
                                                "text": "[T]he King vvas obliged to qualify his grant, by eſtabliſhing betvveen the contending parties a rotation of ſeniority, each to take place alternately for a year, the ſurvivor to precede for his life the heir of the other, and ſo in perpetuum. A ſenſeleſs jumble, ſoon liquidated by a more egregious act of folly, the King vvith his ovvn hand crovvning the young Duke of VVarvvick King of the Iſle of VVight— […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
