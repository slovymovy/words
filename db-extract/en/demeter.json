                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3555d17-ef9a-4619-b716-1ff848e5aefa",
                                                "sense_id": "24b0329d-2eb9-33a1-8f7d-18e183f6b9ab",
                                                "text": "Demeter opiekowała się wzrostem zbóż od siewu aż po żniwa"
                                            },
                                            {
                                                "example_id": "7f924a78-fcab-4db4-8da4-909047acd059",
                                                "sense_id": "24b0329d-2eb9-33a1-8f7d-18e183f6b9ab",
                                                "text": "Atrybutami Demeter były: kłosy zbóż, kwiaty maku, makówki, złotogłów (asfodel), narcyz, cyprys, pszczoła, świnia, żuraw, kogut, sierp i pochodnia."
                                            },
                                            {
                                                "example_id": "a3b12550-690d-456e-b63e-2b24dec08f64",
                                                "sense_id": "24b0329d-2eb9-33a1-8f7d-18e183f6b9ab",
                                                "text": "Makówki ofiarowywano Demeter na misteriach eleuzyńskich jako symbol ziemi, snu i zapomnienia"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f8e94b19-cf66-395e-93b9-f0938c9ebc73",
                                        "entry_id": "a8c71e66-965d-3ce6-80d0-21edc77604b1",
                                        "glosses": [
                                            "planetoida o numerze katalogowym 1108"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c4ed40c-1855-47aa-9e22-709ee00b7e63",
                                                "sense_id": "f8e94b19-cf66-395e-93b9-f0938c9ebc73",
                                                "text": "Demeter porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
