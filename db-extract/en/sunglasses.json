                        "entry_id": "870eab81-e05b-3fbf-bea0-98c67b40bfba",
                        "glosses": [
                            "Tinted glasses worn to protect the eyes from the sun or other bright light, and may also be worn as a fashion accessory."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "5937b042-07d6-46fb-af6c-58486e78d661",
                                "sense_id": "9894daf8-a770-389b-a824-6d80875a2ac9",
                                "text": "It is impossible to know accurately how you look in your sunglasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "d07825eb-30d6-352e-82a6-ed6aa2b39b5a",
                        "entry_id": "870eab81-e05b-3fbf-bea0-98c67b40bfba",
                        "glosses": [
                            "A person wearing sunglasses"
                        ],
                        "tags": [
                            "colloquial",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "258e2a61-c6d3-45e3-a84d-5f68787f0485",
                                "sense_id": "d07825eb-30d6-352e-82a6-ed6aa2b39b5a",
                                "text": "My seat’s been taken by some sunglasses asking 'bout a scar"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a602d9e0-60bc-4033-b7cb-68b14c3c5365",
