                {
                    "sense_id": "f0b2952e-d705-37ca-98e1-90ace96f727d",
                    "sense_definition": "Een voormalige echtgenoot, echtgenote of geliefde.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>ex</w> is gelukkig een goede vriendin van me gebleven.",
                            "target_lang_translations": {
                                "en": "Fortunately, my <w>ex</w> has remained a good friend of mine.",
                                "pl": "Na szczęście moja <w>była</w> pozostała moją dobrą przyjaciółką.",
                                "de": "Meine <w>Ex</w> ist glücklicherweise eine gute Freundin von mir geblieben.",
                                "fr": "Heureusement, mon <w>ex</w> est restée une bonne amie à moi.",
                                "it": "Fortunatamente la mia <w>ex</w> è rimasta una mia buona amica.",
                                "cs": "Moje <w>ex</w> naštěstí zůstala mou dobrou kamarádkou.",
                                "tr": "Neyse ki <w>eski sevgilim</w> iyi bir arkadaşım olarak kaldı.",
                                "es": "Afortunadamente, mi <w>ex</w> ha seguido siendo una buena amiga mía.",
                                "zh": "幸运的是，我的<w>前任</w>和我依然是好朋友。"
                            }
                        },
                        {
                            "text": "Hij praat nog steeds af en toe met zijn <w>ex</w>.",
                            "target_lang_translations": {
                                "en": "He still talks to his <w>ex</w> every now and then.",
                                "pl": "On wciąż od czasu do czasu rozmawia ze swoją <w>byłą</w>.",
                                "de": "Er redet immer noch ab und zu mit seiner <w>Ex</w>.",
                                "fr": "Il parle encore de temps en temps avec son <w>ex</w>.",
                                "it": "Lui parla ancora ogni tanto con la sua <w>ex</w>.",
                                "cs": "Stále si občas povídá se svou <w>ex</w>.",
                                "tr": "Hala ara sıra <w>eski sevgilisiyle</w> konuşuyor.",
                                "es": "Él todavía habla de vez en cuando con su <w>ex</w>.",
                                "zh": "他偶尔还会和他的<w>前任</w>聊天。"
                            }
                        }
                    ],
