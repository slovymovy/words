                    {
                        "translation_id": "76aa9e28-5edf-4603-948e-df62132659b4",
                        "source_entry_id": "02b95967-d63e-3b3e-8e45-2dc2dbd4cb0f",
                        "source_sense_description": "type of exercise",
                        "target_lang_word": "callisthénie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "callisthénie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "832459c1-f4d6-3001-a165-99e66ea728db",
                                        "entry_id": "25364c5b-2562-3376-af6f-856ab9bf1924",
                                        "glosses": [
                                            "Exercices de gymnastique ou de sport visant un développement harmonieux du corps particulièrement pour les jeunes."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1fda4e-e96e-4fef-9d5d-768ba324efa6",
                                                "sense_id": "832459c1-f4d6-3001-a165-99e66ea728db",
                                                "text": "Il arpentait les sentiers de corail en sandales ou même les pieds nus, afin d’en endurcir la corne et de les habituer au sol brûlant, un spectacle qui interloquait les Arabes ; qu’un étranger, officier de surcroît et conseiller intime de leur grand chef, se laisse aller à ce genre de callisthénie leur paraissait dégradant et un peu ridicule, alors qu’il avait toujours à sa disposition des montures d’élite."
                                            },
                                            {
                                                "example_id": "3e203265-29d0-4ec8-b58e-d7b86ab93e5e",
                                                "sense_id": "832459c1-f4d6-3001-a165-99e66ea728db",
                                                "text": "Le sport, j’ai tout pratiqué, y compris les nages de style, la callisthénie."
                                            },
                                            {
                                                "example_id": "0f2c042f-1066-46ec-a05e-378c3bf583d8",
                                                "sense_id": "832459c1-f4d6-3001-a165-99e66ea728db",
                                                "text": "Dans la réserve, il avait pratiqué la callisthénie que lui avait enseignée Samoel, son frère aîné, quand il était petit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75c49395-a0d2-36f6-9bca-1cc1464eff07",
                                        "entry_id": "25364c5b-2562-3376-af6f-856ab9bf1924",
                                        "glosses": [
                                            "Musculation pratiquée sur du mobilier urbain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48c3448c-2c9c-4b66-866a-cf8b00998638",
                        "source_entry_id": "02b95967-d63e-3b3e-8e45-2dc2dbd4cb0f",
                        "source_sense_description": "type of exercise",
                        "target_lang_word": "Calisthenics",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Calisthenics",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                        "entry_id": "ea45d89f-615c-311d-8ec1-f020c67769c1",
                                        "glosses": [
                                            "Form des körperlichen Trainings, bei dem hauptsächlich nur das eigene Körpergewicht als Widerstand genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131c58ce-90e4-4450-8871-bbb96d296d55",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Calisthenics, eine Form des Körpergewichtstrainings, hat sich zu einer beliebten und herausfordernden Art des Workouts entwickelt.“"
                                            },
                                            {
                                                "example_id": "1294a15c-ee81-46cd-96ee-51303e234438",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Calisthenics bietet eine Vielzahl von Bewegungsabläufen, die Geschicklichkeit, Balance und Körperkontrolle erfordern.“"
                                            },
                                            {
                                                "example_id": "321ecdc5-06d7-481c-8bff-ffb2f4be03b1",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Im Gegensatz zum klassischen Krafttraining müssen bei Calisthenics mehrere Muskelgruppen miteinander kooperieren.“"
                                            },
                                            {
                                                "example_id": "f7c992c3-cdc4-454e-9730-656b41c0746a",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Calisthenics hat sich in den letzten Jahren zu einem immer beliebteren Fitness-Trend entwickelt.“"
                                            },
                                            {
                                                "example_id": "d15a9c11-8204-4d5f-a953-4c2714fd8266",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Insbesondere in den letzten Jahren hat Calisthenics durch Plattformen wie YouTube und Instagram an Popularität gewonnen, da immer mehr Menschen die Ästhetik und die vielfältigen Möglichkeiten dieser Trainingsmethode entdeckt haben.“"
                                            },
                                            {
                                                "example_id": "4fc87eba-3146-4219-8926-5652f3ea2b7e",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Calisthenics bietet eine Reihe von Vorteilen im Vergleich zum klassischen Krafttraining im Fitnessstudio.“"
                                            },
                                            {
                                                "example_id": "0ce96832-4158-4a32-9d17-ad5f94ff0a97",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Einer der grössten Vorteile ist, dass für Calisthenics keine teuren Geräte oder Hanteln erforderlich sind.“"
                                            },
                                            {
                                                "example_id": "9904a28e-d8ab-4c0d-9dba-1534d2a04c5a",
                                                "sense_id": "2ff61194-d0db-3132-8f70-aefc71442239",
                                                "text": "„Calisthenics kann praktisch überall trainiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
