{
    "word_family": [
        "sane",
        "insane",
        "insanity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "218d5de4-3893-36dc-ab27-77692bdf3289",
                    "sense_definition": "The state of having a healthy and rational mind.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled to preserve his <w>sanity</w> during the long isolation.",
                            "target_lang_translations": {
                                "nl": "Hij deed moeite om zijn <w>geestelijke gezondheid</w> te behouden tijdens de lange isolatie."
                            }
                        },
                        {
                            "text": "The stress of the job caused her to lose her <w>sanity</w>.",
                            "target_lang_translations": {
                                "nl": "De stress van het werk zorgde ervoor dat ze haar <w>verstand</w> verloor."
                            }
                        }
                    ],
                    "synonyms": [
                        "mind",
                        "saneness"
                    ],
                    "antonyms": [
                        "insanity"
                    ],
                    "common_phrases": [
                        "preserve sanity",
                        "lose sanity"
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand van een gezonde en rationele geest hebben; geestelijke gezondheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geestelijke gezondheid",
                                "target_lang_sense_clarification": "toestand van psychische welzijn"
                            },
                            {
                                "target_lang_word": "gezond verstand",
                                "target_lang_sense_clarification": "mentale helderheid of toerekeningsvatbaarheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e503bbd-17f8-3298-b91e-3fe861d23352",
                    "sense_definition": "The quality of being reasonable and acting in a logical way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plan lacked any sense of <w>sanity</w> given the current budget.",
                            "target_lang_translations": {
                                "nl": "Het plan getuigde van geen enkel <w>gezond verstand</w> gezien het huidige budget."
                            }
                        },
                        {
                            "text": "We must question the <w>sanity</w> of such a dangerous decision.",
                            "target_lang_translations": {
                                "nl": "We moeten vraagtekens zetten bij de <w>redelijkheid</w> van zo'n gevaarlijke beslissing."
                            }
                        }
                    ],
                    "synonyms": [
                        "lucidity",
                        "lucidness"
                    ],
                    "antonyms": [
                        "insanity"
                    ],
                    "target_lang_definitions": {
                        "nl": "De eigenschap om redelijk te zijn en op een logische, doordachte manier te handelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "redelijkheid",
                                "target_lang_sense_clarification": "het redelijk of logisch zijn"
                            },
                            {
                                "target_lang_word": "gezond verstand",
                                "target_lang_sense_clarification": "logica en nuchter oordeelsvermogen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}