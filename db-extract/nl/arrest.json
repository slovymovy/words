                            {
                                "target_word": "arrest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b278e5d5-6c9d-3b51-ae25-a7c9ca17b37e",
                                        "entry_id": "d953563f-246f-3d47-bb92-013004ab8663",
                                        "glosses": [
                                            "To stop the motion of (a person, animal, or body part)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7bae917-e4dd-4e48-bb6d-e6660a566b61",
                                                "sense_id": "b278e5d5-6c9d-3b51-ae25-a7c9ca17b37e",
                                                "text": "An vncouth paine torments my grieued ſoule,\nAnd death arreſts the organe of my voyce."
                                            },
                                            {
                                                "example_id": "3b7ae7e3-51db-45fa-afc8-8540ee6da258",
                                                "sense_id": "b278e5d5-6c9d-3b51-ae25-a7c9ca17b37e",
                                                "text": "Nor could her virtues, nor repeated vows Of thousand lovers, the relentless hand Of Death arrest;"
                                            },
                                            {
                                                "example_id": "d2e73477-0073-4799-ac98-c1c63c3ca77d",
                                                "sense_id": "b278e5d5-6c9d-3b51-ae25-a7c9ca17b37e",
                                                "text": "Mr. Van Rensberg broke the spell by arresting Martha as she trailed past him on Billy's arm, by pointing his pipestem at her and saying, ‘Hey, Matty, come here a minute.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e66d76-67d6-395e-aae1-5a54a2d6a704",
                                        "entry_id": "d953563f-246f-3d47-bb92-013004ab8663",
                                        "glosses": [
                                            "To stay, remain."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44072b4e-82d9-4b32-b3bb-be21aa183b74",
                                                "sense_id": "43e66d76-67d6-395e-aae1-5a54a2d6a704",
                                                "text": "A white Starre[…]whiche to every mans sighte did lighte and arrest apon the Standard of Albry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a091504-a744-3cc3-ae57-bf5a103365e9",
                                        "entry_id": "d953563f-246f-3d47-bb92-013004ab8663",
                                        "glosses": [
                                            "To stop or slow (a process, course etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc60ec46-f83b-4d1f-8147-cbcc0196f122",
                                                "sense_id": "0a091504-a744-3cc3-ae57-bf5a103365e9",
                                                "text": "To try to arrest the spiral of violence, I contacted Chief Buthelezi to arrange a meeting."
                                            },
                                            {
                                                "example_id": "b2e0139d-2b8c-48be-a90d-e54d866d49ae",
                                                "sense_id": "0a091504-a744-3cc3-ae57-bf5a103365e9",
                                                "text": "1997: Chris Horrocks, Introducing Foucault, page 69 (Totem Books, Icon Books; →ISBN\nKnowledge replaced universal resemblance with finite differences. History was arrested and turned into tables …Western reason had entered the age of judgement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1015ba-613e-3ecf-8028-b60748cfc177",
                                        "entry_id": "d953563f-246f-3d47-bb92-013004ab8663",
                                        "glosses": [
                                            "To seize (someone) with the authority of the law; to take into legal custody."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "404cd091-2406-41ae-b7b0-5a1638668522",
                                                "sense_id": "fc1015ba-613e-3ecf-8028-b60748cfc177",
                                                "text": "The police have arrested a suspect in the murder inquiry."
                                            },
                                            {
                                                "example_id": "dc3c0119-b28f-49d5-8089-a1ab4149e295",
                                                "sense_id": "fc1015ba-613e-3ecf-8028-b60748cfc177",
                                                "text": "The suspect merchant ship has been arrested by customs officers."
                                            },
                                            {
                                                "example_id": "a8328f34-8055-4ba7-8225-ea0603a00f33",
                                                "sense_id": "fc1015ba-613e-3ecf-8028-b60748cfc177",
                                                "text": "I arrest thee of high treason."
                                            },
                                            {
                                                "example_id": "d6ef5dd7-c640-49c2-a9ae-14f870dbc794",
                                                "sense_id": "fc1015ba-613e-3ecf-8028-b60748cfc177",
                                                "text": "The policeman who arrests the \"Red\" does not understand the theories the \"Red\" is preaching; if he did, his own position as bodyguard of the monied class might seem less pleasant to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8dc3955-32bb-36ca-98e6-4811f50c7a76",
                                        "entry_id": "d953563f-246f-3d47-bb92-013004ab8663",
                                        "glosses": [
                                            "To catch the attention of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e24d0bd-0cb1-41dc-bfb9-de9630ac8727",
                                                "sense_id": "b8dc3955-32bb-36ca-98e6-4811f50c7a76",
                                                "text": "There is something about this picture—something bold and vigorous, which arrests the attention. I feel sure it would be highly popular."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357de623-142b-32ae-948f-222b1c7e6970",
                                        "entry_id": "d953563f-246f-3d47-bb92-013004ab8663",
                                        "glosses": [
                                            "To undergo cardiac arrest."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c03594a-f3b6-4f99-b418-a5a40dfe0c38",
                                                "sense_id": "357de623-142b-32ae-948f-222b1c7e6970",
                                                "text": "Realizing the mistake immediately from the outline of the RCA on the fluoroscope screen, he rapidly removed the catheter – just as his patient arrested."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
