        "fr-extract.jsonl": [
            {
                "entry_id": "27eebfec-0fe0-3258-9a44-1778501acb2f",
                "word": "intensément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7bcdaa8a-2a97-32be-a567-fbdcb4fd9273",
                        "entry_id": "27eebfec-0fe0-3258-9a44-1778501acb2f",
                        "glosses": [
                            "D’une manière intense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c24930-17f8-4c43-98fc-ce25bdd68dab",
                                "sense_id": "7bcdaa8a-2a97-32be-a567-fbdcb4fd9273",
                                "text": "Car Yette, le visage entouré de bandes blanches, la regardait intensément, essayait peut-être d'exprimer ainsi tout ce qu'elle avait à lui dire."
                            },
                            {
                                "example_id": "9a6f5a67-eca5-461d-8f32-023792662217",
                                "sense_id": "7bcdaa8a-2a97-32be-a567-fbdcb4fd9273",
                                "text": "Les cheveux de Jessica s’agitent furieusement, elle proteste, dévisage intensément l’interprète, qui ne traduit pas, et le proc reprend avec Cristina […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e676ea8-2389-4c52-9e73-7e950cc09c32",
                        "source_entry_id": "27eebfec-0fe0-3258-9a44-1778501acb2f",
                        "source_sense_id": "7bcdaa8a-2a97-32be-a567-fbdcb4fd9273",
                        "target_lang_word": "intensely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intensely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2927a96a-667d-3012-ad21-d3321212618d",
                                        "entry_id": "daa03669-d6ee-3cf7-b6c1-9366166bb425",
                                        "glosses": [
                                            "In an intense manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3802fda7-9bb8-4777-96d3-d925647ce9f5",
                                                "sense_id": "2927a96a-667d-3012-ad21-d3321212618d",
                                                "text": "He pursued his studies intensely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4baeb5d0-c3c6-3a0f-9448-5b230e4b8d98",
                                        "entry_id": "daa03669-d6ee-3cf7-b6c1-9366166bb425",
                                        "glosses": [
                                            "To an intense degree, extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f400e6-af58-4cf1-a684-5d2a63ba59d8",
                                                "sense_id": "4baeb5d0-c3c6-3a0f-9448-5b230e4b8d98",
                                                "text": "An intensely private man, he kept chit-chat to a minimum."
                                            },
                                            {
                                                "example_id": "b2db3e22-a45a-4158-80e9-7471934e9d57",
                                                "sense_id": "4baeb5d0-c3c6-3a0f-9448-5b230e4b8d98",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
