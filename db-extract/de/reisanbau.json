                        ],
                        "form": "den Reisanbau"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                        "entry_id": "74defb2e-0861-3e5e-afff-c0ec9802a51d",
                        "glosses": [
                            "geplantes Anpflanzen, Wässern und Ernten von Reispflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205bd29f-7bd6-4ce8-bce6-69bc5c202fee",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "„Für den Reisanbau wird viel Wasser benötigt – und das fehlt in Thailand in diesem Jahr.“"
                            },
                            {
                                "example_id": "2ac72c3f-873e-41f1-9e59-06c8b9d5afb8",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "„Die Region ist vor allem für ihren Reisanbau sowie die Produktion von Walnüssen und Mandeln bekannt.“"
                            },
                            {
                                "example_id": "3127e001-fb4c-44a3-92a6-47d2b469a379",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "„Die ländliche Bevölkerung betreibt Reisanbau, Kautschukgewinnung, Viehzucht, Färbereien; […].“"
                            },
                            {
                                "example_id": "5f48c8e9-b834-44f9-8507-a8a20da73a63",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "„Bekannt ist, dass es in der Çukurova bereits im 16. Jahrhundert Reisanbau gab.“"
                            },
                            {
                                "example_id": "cfcf17c4-6d8a-41bd-8c04-a5b232c91da2",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "[Mekong-Delta:] „Doch das Delta droht zu versalzen; der Reisanbau wird immer schwieriger.“"
                            },
                            {
                                "example_id": "ec3f77c3-ba1b-43ee-a43f-506837a90e03",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "[Klimakrise:] „Methan entsteht vor allem durch den Stoffwechsel von Wiederkäuern, insbesondere Rindern, und durch den Reisanbau.“"
                            },
                            {
                                "example_id": "b1954ce9-8286-4738-bccd-8289517af72b",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "„Beim Reisanbau entstehen Treibhausgase, weil der Reis auf bewässerten Feldern angebaut wird.“"
                            },
                            {
                                "example_id": "2fd314d4-32d6-4cc6-a216-c1df0e60a705",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "„Reisanbau verursacht ca. 60 Millionen Tonnen Methan jährlich“"
                            },
                            {
                                "example_id": "41bff07a-daf7-4ace-a1b9-61bc13d4bd0b",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "Rund die Hälfte des Methans in der Atmosphäre stammt aus menschlichen Aktivitäten. Davon entstehen 40 Prozent in der Landwirtschaft (32 Prozent Viehhaltung, 8 Prozent Reisanbau), […]."
                            },
                            {
                                "example_id": "2a0a3c7c-9696-431e-99d2-b28171b3bb88",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "[Philippinen:] „Hier bieten Führer ihre Dienste an, das lukrative Tourismusgeschäft hat den Reisanbau verdrängt.“"
                            },
                            {
                                "example_id": "9ea2f872-4340-4be5-ace1-2a1e26637977",
                                "sense_id": "82ad1f1c-c4bf-3935-90b8-fff344a18075",
                                "text": "[Schlagzeile:] „Der Reisanbau geht wegen des Klimawandels stark zurück“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
