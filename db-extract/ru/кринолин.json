                                        "entry_id": "953ad3eb-9265-3811-aafb-0e0f6229cbe1",
                                        "glosses": [
                                            "A skirt stiffened with hoops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dabad2af-eb5e-336b-8122-cd50c2697461",
                                        "entry_id": "953ad3eb-9265-3811-aafb-0e0f6229cbe1",
