                        "glosses": [
                            "Qui peut être recousu."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fe0b8b16-8cca-47fe-9564-b953ba8123a0",
                                "sense_id": "9ab4067e-4003-39b8-9239-9c9efa063ea7",
                                "text": "[…] nous avons besoin de dons financiers, de pommades dermaflon pour une chienne qui a eu les deux pattes avant écrasées, dont la droite est cassée a plusieurs endroits, les pattes sont totalement en charpie, non recousable, besoin de soins durant plusieurs semaines voire mois"
                            },
                            {
                                "example_id": "4ca16501-71ed-4dfd-9cc9-39e47a6d827f",
                                "sense_id": "9ab4067e-4003-39b8-9239-9c9efa063ea7",
                                "text": "Pour les auteurs, la mort c’est un cadavre et le mort un paquet de viande froide découpable et recousable à merci."
                            },
                            {
                                "example_id": "3401a252-4353-4734-8feb-f0303ecf89f3",
                                "sense_id": "9ab4067e-4003-39b8-9239-9c9efa063ea7",
                                "text": "[…] ; tu n’aurais plus rien trouvé de recousable dans mon corps ; il n’était tout entier qu’une plaie."
                            }
                        ]
                    }
                ],
