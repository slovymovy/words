                    }
                ],
                "senses": [
                    {
                        "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                        "entry_id": "913ff466-a166-34a4-a209-215dd7709451",
                        "glosses": [
                            "Person, die etwas Verwerfliches (eine Missetat) begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b91aa0d-65fa-4832-9c16-42538da1f219",
                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                "text": "„Diese Missetäter knieten nieder.“"
                            },
                            {
                                "example_id": "45a27da7-1bd8-47a6-a8ac-6d4b01112569",
                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                "text": "„Mögen Jahre darüber hingehen, mag dem Missetäter inzwischen ein langer Bart gewachsen sein, eines Tages kommt die Geschichte ans Licht, der Vorhang lüftet sich über seiner Tat, über der er längst Gras gewachsen glaubte.“"
                            },
                            {
                                "example_id": "a452c246-e936-4cd2-a9b6-bd036da61b91",
                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                "text": "„An den Galeeren hingegen wird die Republik Venedig niemals etwas ändern, nicht nur weil diese ihr auf einem begrenzten Meer gute Dienste leisten, das sie auch bei Windstille befahren muß, sondern auch, weil sie nicht wüßte, wohin sie die Missetäter, die sie zum Rudern verurteilt, stecken noch was sie mit ihnen tun sollte.“"
                            },
                            {
                                "example_id": "0a06ee30-ea49-4b56-8619-3506ad77c2ee",
                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                "text": "„Sie versucht, mit einer elektrischen Taschenlampe den Missetäter vom Fenster aus zu erkennen; aber das Licht ist zu schwach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e604b1-7b5d-4e1f-80bd-2e66b6323563",
                        "source_entry_id": "913ff466-a166-34a4-a209-215dd7709451",
                        "source_sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                        "source_sense_description": "Person, die etwas Verwerfliches (eine Missetat) begangen hat",
                        "target_lang_word": "evildoer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evildoer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99ec36a-3c15-36cd-b0e6-fb0329a79eaa",
                                        "entry_id": "fce87998-8f4b-316a-9f30-c5c371da17b9",
                                        "glosses": [
                                            "A person who performs evil acts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c6bda9-8894-4e04-acdf-8a47853b5918",
                                                "sense_id": "b99ec36a-3c15-36cd-b0e6-fb0329a79eaa",
                                                "text": "Fret not thy ſelfe becauſe of euill doers, neither bee thou enuious againſt the workers of iniquitie."
                                            },
                                            {
                                                "example_id": "fb3f7c79-a9d4-434f-871d-4ae50a29d3c9",
                                                "sense_id": "b99ec36a-3c15-36cd-b0e6-fb0329a79eaa",
                                                "text": "\"But gallantly they fought. Oh Hiya! they fought like very men, and slew many, and held their own, and then I came and saved them, and the evildoers have I sent on hither to Kôr to be judged of thy greatness, oh She! and here they are.\""
                                            },
                                            {
                                                "example_id": "98ffc4a0-d2b4-4ebf-ae16-a536ba096aa2",
                                                "sense_id": "b99ec36a-3c15-36cd-b0e6-fb0329a79eaa",
                                                "text": "\"Come out, Noongah, you evil doer! It is I, Gulunna the warrior, returned!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbee36a9-7c25-487d-9ef9-2eabe26dc05f",
                        "source_entry_id": "913ff466-a166-34a4-a209-215dd7709451",
                        "source_sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                        "source_sense_description": "Person, die etwas Verwerfliches (eine Missetat) begangen hat",
                        "target_lang_word": "wrongdoer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrongdoer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                                        "entry_id": "574cb1d8-2c6e-307a-8dd2-853955eb559d",
                                        "glosses": [
                                            "Someone who does wrong, whether morally, ethically, or in contravention of a law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b870896-f8c6-48aa-be30-bb9361c0f338",
                                                "sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                                                "text": "Get and keep wrongdoers out of your thorp (village)."
                                            },
                                            {
                                                "example_id": "8d7766d6-62ca-466d-8fb7-5984da33d81f",
                                                "sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                                                "text": "Where the owner of the property and several insurers have rights of action for different portions of the value, all arising out of the same wrongful act, they may join in a single action against the wrongdoër."
                                            },
                                            {
                                                "example_id": "32d8bf17-0482-454e-a0ba-2dec1c789482",
                                                "sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                                                "text": "With all due respect to Aaron, every era seems to have had its legion of wrongdoers and shortcutters who used whatever science was available to get an edge."
                                            },
                                            {
                                                "example_id": "0fbe2730-ba82-42b0-9cbf-f036fb4a4707",
                                                "sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                                                "text": "Usually it takes him too long going down the stairs from the roof to catch any misdeeder or wrongdoer, but tonight will be different."
                                            },
                                            {
                                                "example_id": "16c4bc22-9d8b-457f-838c-0ed3de2b5c03",
                                                "sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                                                "text": "From Tadros’s perspective — the perspective of classical utilitarianism — there is nothing objectionable about this moral lobotomy whereby a wrongdoer pops a moral anesthetic pill immediately after committing whatever atrocity one could imagine in order to avoid suffering — provided, that is, that she would “understand” the wrongness of her actions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15638cf1-1d2c-42f1-b334-f89aa3385f9c",
                        "source_entry_id": "913ff466-a166-34a4-a209-215dd7709451",
                        "source_sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                        "source_sense_description": "Person, die etwas Verwerfliches (eine Missetat) begangen hat",
                        "target_lang_word": "malefactor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malefactor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76639cb2-67bd-30f9-ae14-b90b154e3de5",
                                        "entry_id": "21c858ee-6e7f-3182-a747-62c77b25d7ba",
                                        "glosses": [
                                            "A criminal or felon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a5fa5ad-e832-3302-9906-b58e0e528252",
                                        "entry_id": "21c858ee-6e7f-3182-a747-62c77b25d7ba",
                                        "glosses": [
                                            "An evildoer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d05a23-7d52-4ecb-b891-05240ad8dff2",
                                                "sense_id": "8a5fa5ad-e832-3302-9906-b58e0e528252",
                                                "text": "\"Pull yourself together, Bradshaw,” said the lawyer. “This suspense, I know, is telling upon all of you; but it is now our intention to make an end of it. Poole, here, and I are going to force our way into the cabinet. If all is well, my shoulders are broad enough to bear the blame. Meanwhile, lest anything should really be amiss, or any malefactor seek to escape by the back, you and the boy must go round the corner with a pair of good sticks and take your post at the laboratory door."
                                            },
                                            {
                                                "example_id": "4c7b74b4-a7ec-4127-919a-4ee7cc52241e",
                                                "sense_id": "8a5fa5ad-e832-3302-9906-b58e0e528252",
                                                "text": "Though your unseen malefactor’s actions may give the impression of confidence… Vaermina suspects he is terrified his plan will go astray."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f555eb1d-055e-4187-9b31-876a62c8b18d",
                        "source_entry_id": "913ff466-a166-34a4-a209-215dd7709451",
                        "source_sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                        "source_sense_description": "Person, die etwas Verwerfliches (eine Missetat) begangen hat",
                        "target_lang_word": "culprit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culprit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                        "entry_id": "b7471197-5d67-36b0-9ddd-99d120bb3093",
                                        "glosses": [
                                            "The person or thing at fault for a problem or crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "311e6cd6-26ab-4912-843c-257ba4fed09a",
                                                "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                                "text": "I have tightened the loose bolt that was the culprit; it should work now."
                                            },
                                            {
                                                "example_id": "a5e571ed-cef3-479d-b229-10bffdc7a5f9",
                                                "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                                "text": "Another sits beneath the purple canopy—a lady, but alone. The diadem is on her cold and haughty brow; there is no pity in her stern aspect, and the smile on her lip bodes death. Before her stands the lovely culprit, whose fatal beauty, and still more fatal love, are about to be dearly requited."
                                            },
                                            {
                                                "example_id": "e7c2e780-a289-4aa9-be74-226ca593fed3",
                                                "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                                "text": "But the Dutch dominated only to waste numerous efforts, with Arjen Robben and Robin van Persie the main culprits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38891665-25b2-345f-aef3-e08e1191b0c8",
                                        "entry_id": "b7471197-5d67-36b0-9ddd-99d120bb3093",
                                        "glosses": [
                                            "A prisoner accused but not yet tried."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
