                                        ],
                                        "examples": [
                                            {
                                                "example_id": "530edc67-0d10-49cc-b354-67e3f8a38825",
                                                "sense_id": "7100a881-c645-3f6d-9d8b-bee7e16da9a7",
                                                "text": "Within El Alberto, belonging is premised on the completion of between one and three years of unpaid community service, which all Hñähñu men and unmarried Hñähñu women are required to contribute every eight years. To default on this service is to lose citizenship within the pueblo. This means no longer being able to cultivate the land, build a home there, participate in the decision-making processes that affect the community, or receive the protections it provides."
                                            }
