                                        "sense_id": "fdedd788-24bd-3e7d-9450-44336dd9ddc1",
                                        "entry_id": "5903a716-cfe0-3c71-ad4e-6f2c3f140d07",
                                        "glosses": [
                                            "The sound or action of something, especially something moist, being squeezed or crushed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a746e5e-8bad-4ca1-8afc-46688be89789",
                                                "sense_id": "fdedd788-24bd-3e7d-9450-44336dd9ddc1",
                                                "text": "Alex reached the bottom and Grant heard a squish as she landed in the mud on the bottom of the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e6211f-9e68-3738-b74e-fa8298b6aefe",
                                        "entry_id": "5903a716-cfe0-3c71-ad4e-6f2c3f140d07",
                                        "glosses": [
                                            "A political moderate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eb2b917-537f-4428-b689-6ac9da7a38be",
                                                "sense_id": "14e6211f-9e68-3738-b74e-fa8298b6aefe",
                                                "text": "Some conservatives think that in the long run, the party will be better off without squishes like Specter […]"
                                            },
                                            {
                                                "example_id": "a85d83dd-b087-4647-9c12-1829c2f8298a",
                                                "sense_id": "14e6211f-9e68-3738-b74e-fa8298b6aefe",
                                                "text": "“Josh Mandel: Another failed career politician squish,” a new ad from a super PAC supporting Mr. Vance blared on Ohio television sets on Friday, calling Mr. Mandel, who is mounting his third Senate run, a “two-time loser” and “a moderate for the moderates.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f9d2bef-00ac-3f6c-820e-6bc6abd8c860",
                                        "entry_id": "5903a716-cfe0-3c71-ad4e-6f2c3f140d07",
                                        "glosses": [
                                            "Marmalade."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f733e7c2-48b5-4e42-beef-c904a2f444e0",
                                                "sense_id": "7f9d2bef-00ac-3f6c-820e-6bc6abd8c860",
                                                "text": "Where they are loaves and joints melt as snow in the sunshine; bowls of cream are of no more account than acorn-cups filled with dew; and the 'squish'—as they call the mother's home-made marmalade—has to be renewed daily; […]"
                                            },
                                            {
                                                "example_id": "51d1dce4-b132-46c6-be6c-6b64389100c2",
                                                "sense_id": "7f9d2bef-00ac-3f6c-820e-6bc6abd8c860",
                                                "text": "There was a time when the “squish” manufactured by Mr. Frank Cooper at Oxford was not known very extensively outside the world of undergraduates. With the march of events though the fame of Cooper's Oxford marmalade has become world-wide, and the natural consequence is that a new factory has had to be built to cope with the increased business."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squish",
