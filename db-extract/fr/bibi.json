                "senses": [
                    {
                        "sense_id": "46a30601-07f3-3197-adfc-538013c967c0",
                        "entry_id": "7474205a-ae0a-32d7-b84d-52f723e07a1e",
                        "glosses": [
                            "ich/mir/mich"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d67b421a-7b4e-47df-b9f1-65643a016add",
                                "sense_id": "46a30601-07f3-3197-adfc-538013c967c0",
                                "text": "« C'est pas toi qui dérouilles à chaque fois, c'est bibi, et bibi en a marre. »",
                                "translation": "Du kriegst es ja nicht jedes Mal ab, sondern ich, und ich hab jetzt die Schnauze voll."
                            },
                            {
                                "example_id": "75411617-3bda-4886-9458-3d96f0a09d0b",
                                "sense_id": "46a30601-07f3-3197-adfc-538013c967c0",
                                "text": "« Pardon, Messieurs …, je ne m’ennuie pas …, mais bibi se carapatte …, on l’attend … »",
                                "translation": "Verzeihung, die Herrschaften, … nicht dass ich mich langweile … aber meine Wenigkeit verschwindet jetzt, … sie wird erwartet …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f99fcf4a-92fc-456f-88b0-2fb6e4d1248b",
                        "source_entry_id": "7474205a-ae0a-32d7-b84d-52f723e07a1e",
                        "source_sense_id": "46a30601-07f3-3197-adfc-538013c967c0",
                        "source_sense_description": "sdü",
                        "target_lang_word": "ich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                        "entry_id": "a43a6c50-097c-3d37-80fc-c670d1b80842",
                                        "glosses": [
                                            "bezeichnet die eigene Person; 1. Person Singular"
                                        ],
                                        "tags": [
                                            "grammatikalisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e1d0b6-24b9-4d9b-99dd-9fb0e48c1f1f",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "Ich lerne Deutsch."
                                            },
                                            {
                                                "example_id": "829f875c-1161-4461-bc09-eb8ef58eb287",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "Herr, erbarme dich meiner!"
                                            },
                                            {
                                                "example_id": "552c3d48-4bbd-466c-bede-60aa3e562c82",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "Sie bat ihn statt meiner."
                                            },
                                            {
                                                "example_id": "e4e8096f-04d3-4d8e-8917-d97e3e4faf0b",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "Kannst du mir bitte die Butter reichen."
                                            },
                                            {
                                                "example_id": "e6026ec4-c225-4a87-9e96-7b4387801a0e",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "Willst du mit mir ins Kino gehen?"
                                            },
                                            {
                                                "example_id": "24efd138-34f0-4f39-8dad-26b73b277233",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "Warum fragst du mich das?"
                                            },
                                            {
                                                "example_id": "2ca26285-9df9-499a-a147-6c26b54df419",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Denk ich an Deutſchland in der Nacht,",
                                                "translation": "Und meine heißen Thränen fließen.“"
                                            },
                                            {
                                                "example_id": "7bbde3bd-4ddb-4a41-9d97-606c398b48bb",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Aber hierbei bemerkte ich bald, dass, während ich Alles für falsch behaupten wollte, doch nothwendig ich selbst, der dies dachte, etwas sein müsse, und ich fand, dass die Wahrheit: ‚Ich denke, also bin ich‘, so fest und so gesichert sei, dass die übertriebensten Annahmen der Skeptiker sie nicht erschüttern können.“"
                                            },
                                            {
                                                "example_id": "120dc138-917d-47cc-a2fd-50c609a1279c",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Ich an deiner Stelle würde nicht warten, bis er auf mich zukommt.“"
                                            },
                                            {
                                                "example_id": "2bfffa08-4820-4167-bc33-c491aafe5a96",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Seine Hand griff so hart um meinen Hals[,] dass ich gleich hochkam; er hatte mich gar nicht ansehen wollen. So schrägköpfig allein neben mir abseits im Dunkeln: als ob er nur die Hand frei hatte[,] um sich meiner zu vergewissern.“"
                                            },
                                            {
                                                "example_id": "3f737bed-3238-4651-af6b-33106afa6e45",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Gut, Gottlieb, schön, meine Herren, soll auch keen Vorwurf sein, bloß ich für meine Person, für meine Wenigkeit habe zugehört, und es war sehr schön, wie er alles beleuchtete, mit Ruhe, aber kräftig, bei seiner schwachen Stimme, und der Mann ist ja schwach auf der Brust, und wie alles seine Ordnung hatte und wie dann die Resolution kam, jeder Punkt sauber, eine feine Sache, ein Kopf, und genau bis auf die Toiletten, die ihnen nicht gefallen haben.“"
                                            },
                                            {
                                                "example_id": "141db381-4880-4d95-88a9-acc633af3f4f",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„‚Die Nacht ist zu Ende!‘ erklärte sie, ‚ich für mein Teil, ich werde jetzt baden, ein Sonntagskleid anziehn.‘“"
                                            },
                                            {
                                                "example_id": "37faec49-5ef7-427e-9928-f67f6b0e3513",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Ich für meinen Teil geh jetzt schlafen, und, Märtke, du schon überhaupt!“"
                                            },
                                            {
                                                "example_id": "43574902-46ef-43f7-924d-9e75a17a7014",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Ich habe innerlich kalt und grossen Durst.“"
                                            },
                                            {
                                                "example_id": "912aaa41-0ba4-42a2-a676-b413a047215e",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Um mich herum schwieg die Große Dürre für einen kurzen Moment, dann begannen Grillen zu zirpen, Fledermäuse durch die Finsternis zu huschen, Gegos zu keckern und Schakale zu heulen, und in weiter Ferne kündigte ein heller Schein über dem Horizont die Geburt des Mondes an.“"
                                            },
                                            {
                                                "example_id": "b51c80ae-c57c-4b2c-b591-fa63b9855c77",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Mir ist es lieber, die Gläubiger dieser Kirche, denen sie allen das ewige Leben versprochen hat (aber nicht das ewigwährende Bankkonto) sind gebückt und beschäftigt, dann erfinden sie wenigstens keine dramatisierten Märchen über geschächtete Kinder (mei liabs Andele vom Rinn, am Judenstein in Tirol: der Bischof in der Gestalt eines Adlers hat dich leider aus deiner angestammten Jaucherinne gerissen und mitsamt dem ganzen Blut, das aber von seinen eigenen Händen gekommen ist, vom Seziertisch gespült! Nach welchen golden behämmerten Strahlen sollen wir denn jetzt, nach dem großen gemeinschaftlichen Verhuschen und Vertuschen, greifen, da wir doch alle so kleine Lichter sind?), deren Blut über uns gekommen ist und uns gewaschen aber nicht naßgemacht hat.“"
                                            },
                                            {
                                                "example_id": "22ee9b63-e019-4294-8385-c4ea2fb0b111",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Ich denke, also bin ich. Ich will, also lebe ich. Im Denken habe ich nur die Evidenz des toten Seins - daher seine Vorwürfe an Spinoza -, der Dinge, und mache mich selbst zu einem Ding. Im Wollen habe ich die Evidenz, dass ich lebend bin.“"
                                            },
                                            {
                                                "example_id": "7994aa46-7759-4ddc-bc4a-7543a91adb8d",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Mir zuckten nicht nur die Hände, auch das Schlucken im Hals. Ich wusste, wie man hungert und das Essen streckt oder verschlingt, wenn man es endlich hat. Wie lang man kaut und wann man schluckt, um manierlich zu essen, wusste ich nicht mehr. Der Vater saß mir gegenüber, und die Tischplatte schien mir so groß wie die halbe Welt. Er schaute mir mit halbgeschlossenen Augen zu und verbarg sein Mitleid.“"
                                            },
                                            {
                                                "example_id": "b847ab4f-1477-4806-be33-c277a1aa82ff",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Jetzt bin ich hellwach. Der Schlaf hat praktisch nie richtig Lust auf mich, er verlässt mich sehr schnell um Mitternacht, nachdem er mich den ganzen Abend bedrängt hat.“"
                                            },
                                            {
                                                "example_id": "a5b5df89-8f59-4634-8fda-f81221209f41",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Sie wollten mich zum Islam bekehren, um zu verhindern, dass meine Seele ewig in der Hölle schmort, ich wollte sie zu meiner säkularen Einstellung bekehren, um zu verhindern, dass sie ihr Leben für ein illusionäres Jenseits vergeuden. Ich musste mich, wie in Brasilien, mit Überzeugungen und Wertvorstellungen auseinandersetzen, die ich in einem bestimmten soziokulturellen Kontext unhinterfragt übernommen hatte – von meinem Atheismus bis zu meiner Vorstellung von einem gelungenen Leben.“"
                                            },
                                            {
                                                "example_id": "1b7fd4c8-2fd2-462d-977b-634f69e27402",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Jede bemalte Schuhleistenfigur ist darüber hinaus in wiederholenden Schriftzügen mit dem sufischen Sprichwort ana jalis dhakarani, wa man dhakarani, ana jalisuhu (dt. Ich bin der Gefährte dessen, der sich meiner erinnert, und der sich meiner erinnert, dessen Gefährte bin ich) versehen.“"
                                            },
                                            {
                                                "example_id": "67280bb8-5c16-492a-9a8f-42f565f7b5cc",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Ich habe meine Tochter nicht geboren. Sie war mit ihrer Mutter auf dem Schiff, aber ihre Mutter ist ertrunken. Ich habe Amina so lange gehalten, bis wir gerettet wurden, und dann wollte ich nicht, dass sie in einem Heim aufwächst. Ich wollte sie nicht klauen. Jetzt kann ich aber nicht mehr schlafen, ich habe Angst, dass es rauskommt. Ich weiß, dass ich kein Anrecht auf meine Tochter habe, und gleichzeitig ist es meine größte Angst, dass jemand sie mir wieder wegnimmt.“"
                                            },
                                            {
                                                "example_id": "6e3c91d5-a9e2-4d38-a691-1dfeebda797b",
                                                "sense_id": "e32e6146-009b-3250-9465-6713c6aeb3b7",
                                                "text": "„Manchmal saß ich die ganze Nacht draußen auf dem Balkon, badete in der abgekühlten Luft, sah auf die Lichtstraße, die der Mond auf das dunkle Wasser warf, und konnte mich nicht satthören an der Stille, in der nur noch ab und zu einer der unsichtbaren, im dunklen Schilf versteckten Wasservögel einen leisen, schlaftrunkenen Laut von sich gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
