                    "frequency": "High",
                    "semantic_group_id": "ressources_materielles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas <w>gaspiller</w> la nourriture en jetant les restes du dîner."
                        },
                        {
                            "text": "Il a <w>gaspillé</w> tout son argent dans des achats parfaitement inutiles."
                        }
                    ],
