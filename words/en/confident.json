{
    "word_family": [
        "confidence",
        "confidently",
        "confidant",
        "confidante",
        "confide"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "58434c4d-b0b4-36a4-bb16-fe939db04b90",
                    "sense_definition": "Feeling or showing self-assurance and belief in one's own abilities or qualities.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "self-assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>confident</w> speaker who never gets nervous in front of large crowds.",
                            "target_lang_translations": {
                                "ru": "Она — <w>уверенный в себе</w> оратор, который никогда не нервничает перед большой толпой.",
                                "pl": "Jest <w>pewną siebie</w> mówczynią, która nigdy nie denerwuje się przed dużym tłumem.",
                                "zh": "她是一位<w>自信的</w>演讲者，在人群面前从不紧张。"
                            }
                        },
                        {
                            "text": "To succeed in this job, you need to be <w>confident</w> in your skills.",
                            "target_lang_translations": {
                                "ru": "Чтобы преуспеть в этой работе, нужно быть <w>уверенным</w> в своих навыках.",
                                "pl": "Aby odnieść sukces w tej pracy, musisz być <w>pewny</w> swoich umiejętności.",
                                "zh": "想要在这份工作中取得成功，你需要对自己的技能<w>有信心</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "self-assured",
                        "self-reliant",
                        "sure"
                    ],
                    "antonyms": [
                        "insecure",
                        "shy"
                    ],
                    "common_phrases": [
                        "confident speaker",
                        "feel confident",
                        "confident young woman"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство или проявление уверенности в себе и веры в свои способности или качества.",
                        "pl": "Odczuwający lub okazujący pewność siebie oraz wiarę we własne możliwości lub zalety.",
                        "zh": "指对自己的能力或品质有信心，表现出从容不迫的态度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенный в себе",
                                "target_lang_sense_clarification": "обладающий верой в свои силы"
                            },
                            {
                                "target_lang_word": "самоуверенный",
                                "target_lang_sense_clarification": "иногда с оттенком излишней уверенности"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pewny siebie",
                                "target_lang_sense_clarification": "posiadający wiarę we własne siły i umiejętności"
                            },
                            {
                                "target_lang_word": "śmiały",
                                "target_lang_sense_clarification": "odważny i zdecydowany w zachowaniu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自信的",
                                "target_lang_sense_clarification": "相信自己能力和价值的"
                            },
                            {
                                "target_lang_word": "有把握的",
                                "target_lang_sense_clarification": "对某事有充分信心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a41f5237-2bb8-3b66-8da4-d639555c36fc",
                    "sense_definition": "Feeling very sure about the truth of something or certain that something will happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach is <w>confident</w> of success in the upcoming championship game.",
                            "target_lang_translations": {
                                "ru": "Тренер <w>уверен</w> в успехе в предстоящем матче чемпионата.",
                                "pl": "Trener jest <w>pewny</w> sukcesu w nadchodzącym meczu mistrzowskim.",
                                "zh": "教练对即将到来的冠军赛<w>确信</w>能够获胜。"
                            }
                        },
                        {
                            "text": "I am <w>confident</w> that we can find a solution to this problem together.",
                            "target_lang_translations": {
                                "ru": "Я <w>уверен</w>, что вместе мы сможем найти решение этой проблемы.",
                                "pl": "Jestem <w>przekonany</w>, że wspólnie znajdziemy rozwiązanie tego problemu.",
                                "zh": "我<w>确信</w>我们能一起找到解决这个问题的方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certain",
                        "sure",
                        "positive"
                    ],
                    "common_phrases": [
                        "confident of success",
                        "confident that",
                        "fairly confident"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство полной уверенности в истинности чего-либо или убежденность в том, что что-то произойдет.",
                        "pl": "Mający całkowitą pewność co do prawdziwości czegoś lub przekonanie, że coś się wydarzy.",
                        "zh": "对某事的真实性感到确定，或坚信某事一定会发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенный",
                                "target_lang_sense_clarification": "убежденный в чем-либо"
                            },
                            {
                                "target_lang_word": "убежденный",
                                "target_lang_sense_clarification": "твердо верящий в успех или результат"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pewny",
                                "target_lang_sense_clarification": "całkowicie przekonany o czymś"
                            },
                            {
                                "target_lang_word": "pewien",
                                "target_lang_sense_clarification": "przekonany o słuszności lub sukcesie"
                            },
                            {
                                "target_lang_word": "przeświadczony",
                                "target_lang_sense_clarification": "mający silne wewnętrzne przekonanie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确信的",
                                "target_lang_sense_clarification": "对事实或结果有把握"
                            },
                            {
                                "target_lang_word": "有信心的",
                                "target_lang_sense_clarification": "对未来结果持乐观态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31384d84-8eb3-3e19-952e-f76f6b7c4015",
                    "sense_definition": "Showing a lack of proper respect; being overly bold or impudent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boldness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>confident</w> ruffian dared to enter the private chambers without any permission.",
                            "target_lang_translations": {
                                "ru": "<w>Дерзкий</w> хулиган осмелился войти в личные покои без всякого разрешения.",
                                "pl": "<w>Zuchwały</w> rzezimieszek odważył się wejść do prywatnych komnat bez żadnego pozwolenia.",
                                "zh": "那个<w>狂妄的</w>流氓竟敢未经许可就闯入私人房间。"
                            }
                        },
                        {
                            "text": "His <w>confident</w> manner was often mistaken for simple arrogance by his peers.",
                            "target_lang_translations": {
                                "ru": "Его <w>самоуверенная</w> манера часто ошибочно принималась сверстниками за обычное высокомерие.",
                                "pl": "Jego <w>pewna siebie</w> postawa była często brana przez rówieśników za zwykłą arogancję.",
                                "zh": "他那<w>狂妄的</w>举止常被同僚误认为是单纯的傲慢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impudent",
                        "forward",
                        "bold"
                    ],
                    "common_phrases": [
                        "confident ruffian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление отсутствия должного уважения; чрезмерная дерзость или наглость.",
                        "pl": "Okazujący brak należytego szacunku; zbyt śmiały lub zuchwały.",
                        "zh": "表现出缺乏应有的尊重；过于大胆或厚颜无耻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самоуверенный",
                                "target_lang_sense_clarification": "дерзкий или наглый"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "проявляющий неуважительную смелость"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zuchwały",
                                "target_lang_sense_clarification": "wykazujący się nadmierną, wręcz bezczelną śmiałością"
                            },
                            {
                                "target_lang_word": "pewny siebie",
                                "target_lang_sense_clarification": "tutaj w negatywnym znaczeniu: zarozumiały lub arogancki"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂妄的",
                                "target_lang_sense_clarification": "过分自信且傲慢的"
                            },
                            {
                                "target_lang_word": "冒失的",
                                "target_lang_sense_clarification": "言行鲁莽、缺乏礼貌的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6234cdc0-6223-3dc4-880c-d7577a9e6bec",
                    "sense_definition": "An <w>obsolete</w> spelling of <w>confidant</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king admitted only a few of his <w>confidents</w> to the secret meeting.",
                            "target_lang_translations": {
                                "ru": "Король допустил на секретное совещание лишь нескольких своих <w>доверенных лиц</w>.",
                                "pl": "Król dopuścił na tajne spotkanie tylko kilku swoich <w>powierników</w>.",
                                "zh": "国王只允许他少数几位<w>心腹</w>参加秘密会议。"
                            }
                        },
                        {
                            "text": "He was known as a great <w>confident</w> of the rebel leaders during the war.",
                            "target_lang_translations": {
                                "ru": "Во время войны он был известен как близкое <w>доверенное лицо</w> лидеров повстанцев.",
                                "pl": "Podczas wojny był znany jako wielki <w>powiernik</w> przywódców rebeliantów.",
                                "zh": "战争期间，他以叛军领袖的得力<w>心腹</w>而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confidant"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical spelling of confidant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова «confidant» (доверенное лицо).",
                        "pl": "Przestarzała pisownia słowa „confidant” (powiernik).",
                        "zh": "confidant 的过时拼写，指可以倾诉秘密的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверенное лицо",
                                "target_lang_sense_clarification": "человек, которому поверяют тайны"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "powiernik",
                                "target_lang_sense_clarification": "osoba, której powierza się tajemnice"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心腹",
                                "target_lang_sense_clarification": "深得信任、可以托付秘密的人"
                            },
                            {
                                "target_lang_word": "知己",
                                "target_lang_sense_clarification": "彼此了解并信任的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}