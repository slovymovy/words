                        ]
                    },
                    {
                        "translation_id": "7b05b51a-cdde-440c-b05f-979c3d216ec5",
                        "source_entry_id": "8eba313d-749e-3381-8949-b3e039515ed4",
                        "source_sense_id": "f3250232-fbda-3877-a469-750e9edc278b",
