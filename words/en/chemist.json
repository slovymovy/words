{
    "word_family": [
        "chemistry",
        "chemical",
        "chemically",
        "alchemist",
        "alchemy",
        "biochemist",
        "biochemistry",
        "geochemist",
        "geochemistry",
        "photochemistry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67609533-8f4e-3186-8207-bb0051b72c88",
                    "sense_definition": "A person who specializes in the science of chemistry, especially at a professional level.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "science_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research <w>chemist</w> spent years developing a new type of biodegradable plastic.",
                            "target_lang_translations": {
                                "ru": "Исследователь-<w>химик</w> потратил годы на разработку нового типа биоразлагаемого пластика."
                            }
                        },
                        {
                            "text": "No sooner has a drug been blacklisted than <w>chemists</w> adjust their recipe and start churning out a subtly different one.",
                            "target_lang_translations": {
                                "ru": "Не успевает препарат попасть в черный список, как <w>химики</w> меняют рецептуру и начинают штамповать немного измененный вариант."
                            }
                        }
                    ],
                    "common_phrases": [
                        "research chemist",
                        "analytical chemist",
                        "industrial chemist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист в области химии, занимающийся научными исследованиями или работающий на химическом производстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "химик",
                                "target_lang_sense_clarification": "учёный или специалист в области химии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce694a57-d232-3148-83e1-30e7de467557",
                    "sense_definition": "A person qualified to prepare and dispense medicinal drugs; a <w>pharmacist</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chemist</w> explained the potential side effects of the new medication to the patient.",
                            "target_lang_translations": {
                                "ru": "<w>Аптекарь</w> объяснил пациенту возможные побочные эффекты нового лекарства."
                            }
                        },
                        {
                            "text": "You should ask the <w>chemist</w> for advice on which cough syrup is best for a dry cough.",
                            "target_lang_translations": {
                                "ru": "Вам стоит спросить совета у <w>фармацевта</w> о том, какой сироп от кашля лучше всего подходит при сухом кашле."
                            }
                        }
                    ],
                    "synonyms": [
                        "pharmacist"
                    ],
                    "common_phrases": [
                        "dispensing chemist",
                        "local chemist"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специалист с медицинским образованием, имеющий право готовить и продавать лекарства; фармацевт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аптекарь",
                                "target_lang_sense_clarification": "лицо, занимающееся изготовлением и продажей лекарств"
                            },
                            {
                                "target_lang_word": "фармацевт",
                                "target_lang_sense_clarification": "специалист в области лекарственных средств"
                            },
                            {
                                "target_lang_word": "провизор",
                                "target_lang_sense_clarification": "аптечный работник высшей квалификации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c91cb05e-926b-35e0-aa59-833f2d021422",
                    "sense_definition": "A shop where medicinal drugs are dispensed and toiletries are sold; a <w>pharmacy</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "retail_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to stop at the <w>chemist</w> to pick up some aspirin and toothpaste.",
                            "target_lang_translations": {
                                "ru": "Мне нужно зайти в <w>аптеку</w>, чтобы купить аспирин и зубную пасту."
                            }
                        },
                        {
                            "text": "Is there a <w>chemist</w> open late at night in this part of the city?",
                            "target_lang_translations": {
                                "ru": "Есть ли в этой части города <w>аптека</w>, работающая допоздна?"
                            }
                        }
                    ],
                    "synonyms": [
                        "pharmacy"
                    ],
                    "common_phrases": [
                        "at the chemist",
                        "all-night chemist",
                        "high street chemist"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Магазин, в котором продаются лекарства, а также средства гигиены и косметика; аптека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аптека",
                                "target_lang_sense_clarification": "магазин лекарств и сопутствующих товаров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65fbf97a-3c7c-3585-aa30-7d731e44dd46",
                    "sense_definition": "A person who practices alchemy; an alchemist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, the <w>chemist</w> sought to turn lead into gold through mystical processes.",
                            "target_lang_translations": {
                                "ru": "В средневековье <w>алхимик</w> стремился превратить свинец в золото с помощью мистических процессов."
                            }
                        },
                        {
                            "text": "The ancient <w>chemist</w> worked in a laboratory filled with strange herbs and bubbling cauldrons.",
                            "target_lang_translations": {
                                "ru": "Древний <w>алхимик</w> работал в лаборатории, наполненной странными травами и бурлящими котлами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, занимающийся алхимией; средневековый ученый-мистик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алхимик",
                                "target_lang_sense_clarification": "человек, занимающийся поисками философского камня"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}