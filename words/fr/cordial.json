                    "frequency": "Middle",
                    "semantic_group_id": "relations_chaleureuses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons reçu un accueil très <w>cordial</w> dès notre arrivée dans cette nouvelle ville."
                        },
                        {
                            "text": "Les deux délégations ont maintenu des échanges <w>cordiaux</w> tout au long des négociations."
                        }
                    ],
                    "synonyms": [
                        "chaleureux",
                        "aimable",
                        "sympathique"
                    ],
                    "antonyms": [
                        "froid",
                        "distant"
