                "senses": [
                    {
                        "sense_id": "1a938238-6ce3-36e5-8e93-1e37f7a54dc5",
                        "entry_id": "e0d86171-49ec-3c4c-b1be-0854d1e13a6f",
                        "glosses": [
                            "osoba zajmująca się zawodowo logiką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24aa2897-940b-451b-8ac1-252a48211623",
                                "sense_id": "1a938238-6ce3-36e5-8e93-1e37f7a54dc5",
                                "text": "Pierwszym logikiem, który nie w pełni zgadzał się z prawem wyłączonego środka, był Arystoteles."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eb4b09a-6816-445e-af1b-1939c0d1c715",
                        "source_entry_id": "e0d86171-49ec-3c4c-b1be-0854d1e13a6f",
                        "source_sense_id": "1a938238-6ce3-36e5-8e93-1e37f7a54dc5",
