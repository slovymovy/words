                "senses": [
                    {
                        "sense_id": "bcbbe550-e5fa-3a65-bef6-9e27d1008292",
                        "entry_id": "f290e281-8338-393c-b3a8-2642b074ede3",
                        "glosses": [
                            "to make further education"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f604f7e-330e-4d8c-ad42-97ef0bcb3136",
                                "sense_id": "bcbbe550-e5fa-3a65-bef6-9e27d1008292",
                                "text": "De digitale maatschapij vraagt om professionals die willen doorleren.",
                                "translation": "The digital society demands professionals who want to make further education.",
                                "english": "The digital society demands professionals who want to make further education."
                            }
                        ]
                    },
                    {
                        "sense_id": "f05da6a3-da63-3c29-9e6d-5f9fbeaae524",
                        "entry_id": "f290e281-8338-393c-b3a8-2642b074ede3",
                        "glosses": [
                            "to continue studying"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd7d02d-5763-4203-9ef9-00ccc33210a7",
                                "sense_id": "f05da6a3-da63-3c29-9e6d-5f9fbeaae524",
                                "text": "Het is avond, je hebt de hele dag gestudeerd. Nu komt het belangrijkste: slaap. Niet de hele nacht doorleren, slapen!",
                                "translation": "It's evening, you've studied all day. Now comes the most important thing: sleep. Don't keep studying all night, sleep!",
                                "english": "It's evening, you've studied all day. Now comes the most important thing: sleep. Don't keep studying all night, sleep!"
                            }
                        ]
                    }
