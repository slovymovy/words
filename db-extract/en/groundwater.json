                                "target_senses": [
                                    {
                                        "sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                                        "entry_id": "3ab710f1-21b3-3800-8136-735d35a725c1",
                                        "glosses": [
                                            "al het water dat zich in de aardbodem bevindt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34797cb7-33a2-405b-b5df-1400244717f4",
                                                "sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                                                "text": "De zorg voor het ondiepe grondwater in de openbare ruimte is een gemeentetaak."
                                            },
                                            {
                                                "example_id": "23820d58-c7b9-43b5-8d8f-51d3a1d5f8fa",
                                                "sense_id": "3402280c-4575-3fb5-a369-dea8838a0934",
                                                "text": "Het grondwater, geelachtig en roodbruin, verbreidt een strontstank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71595c87-773b-43fc-8758-0480edf1599c",
                        "source_entry_id": "969ef4cb-f80d-3a25-bf1a-fd677f169a82",
                        "source_sense_id": "70ba5b77-9237-3f04-955a-925603f69c25",
                        "source_sense_description": "Water existing beneath the earth's surface in underground streams and aquifers",
                        "target_lang_word": "eau souterraine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau souterraine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21e813fc-4daf-3cd0-a80d-766cc6a51919",
                                        "entry_id": "77f41289-bc62-373f-8af7-133c367b701c",
                                        "glosses": [
                                            "Eau contenue naturellement dans les pores des sols et des roches perméables du sous-sol, circulant dans les aquifères et constituant une ressource essentielle pour l’alimentation en eau potable, l’irrigation et l’industrie."
                                        ],
                                        "tags": [
                                            "Hydrogéologie"
                                        ],
