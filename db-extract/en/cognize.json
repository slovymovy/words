    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                "word": "cognize",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "69bdc09b-6d56-4631-a2e3-898bc818fafc",
                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "cognizes"
                    },
                    {
                        "form_id": "3ecb8f25-dcc4-4d41-8506-e064d1cb10aa",
                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "cognizing"
                    },
                    {
                        "form_id": "825db134-a6ce-45bc-a3d6-735f4b757b2c",
                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "cognized"
                    },
                    {
                        "form_id": "6dedea15-927b-4a17-8264-8e875ea84b6b",
                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "tags": [
                            "past"
                        ],
                        "form": "cognized"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b6d0660-abdd-33ee-95ce-c1f3e955facd",
                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "glosses": [
                            "To know, perceive, or become aware of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebef4007-bdd3-44f2-96f7-42bcd12cf013",
                                "sense_id": "4b6d0660-abdd-33ee-95ce-c1f3e955facd",
                                "text": "[T]hey must possess organs of sight—some method of cognizing their environment—akin to that of vision in man."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                        "entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "glosses": [
                            "To make into an object of cognition (the process of acquiring knowledge through thought); to cogitate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a57a8f-5870-4c63-b716-89fa64c7be31",
                                "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                "text": "Cognizing about mind is a ubiquitous human activity; we consistently construe each other as agents undertaking intentional action based on our underlying beliefs and desires (and not as \"bags of skin stuffed into pieces of cloth\")"
                            },
                            {
                                "example_id": "d22b6186-5d4a-4d4e-aa94-983343c8b125",
                                "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                "text": "“Thinking a lot” also involves other types of cognizing as well, such as cognizing about depressive themes such as being left by a wife for another man or being separated from relatives."
                            },
                            {
                                "example_id": "89277d5d-468b-4f37-a2b8-805329f0d270",
                                "sense_id": "c7edd26c-0e12-3980-8aa3-13e5950e9ad0",
                                "text": "The act of consciously knowing about consciousness is the act of the brain mirroring its own organizations, cognizing about its own cognizing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6660c5a0-abfb-458e-9984-0f7c7fe4e4aa",
                        "source_entry_id": "ddf7163f-059f-3e00-8366-d971fc94b110",
                        "source_sense_description": "to know or be aware of",
                        "target_lang_word": "connaître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connaître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Faire ou avoir fait l’expérience permettant une représentation mentale de quelque chose ou quelqu’un, avoir l’idée, la notion d’une personne ou d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34d6a78-29cf-41c6-8065-6e5a77c14dfe",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "Nous sommes si éloignés de connaître tous les agens de la nature, et leurs divers modes d’action ; qu’il ne serait pas philosophique de nier les phénomènes, uniquement parce qu’ils sont inexplicables dans l’état actuel de nos connaissances."
                                            },
                                            {
                                                "example_id": "31ac1393-007a-43ad-94d0-9d8150aabfaa",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "On entendait incessamment sur le parc de Neuilly grêler les balles à travers les branches avec ce bruit des orages d'été que nous connaissons si bien."
                                            },
                                            {
                                                "example_id": "30d81911-b440-474d-8d36-efb8959ab5af",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "Durtal le connaissait ce moment délicieux où l’on reprend haleine, encore abasourdi par ce brusque passage d’une bise cinglante à une caresse veloutée d’air."
                                            },
                                            {
                                                "example_id": "f646f7e0-8f15-4337-a1f8-d4cd991c9309",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "En Franche-Comté, les réfugiés trouvèrent une législation à peu près aussi tracassière que celle qu'ils avaient connu en France."
                                            },
                                            {
                                                "example_id": "8564c31c-c593-4a62-87ef-c3888a7d2f10",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "La ligne de défense que les Allemands avaient construite au sud des villages de Banogne, Recouvrance, Saint-Fergeux était connue sous le nom de Hundingstellung."
                                            },
                                            {
                                                "example_id": "49fd1d17-81e9-4644-a498-27bf6f4f694f",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "Par là vous pouvez connaître combien il est à redouter."
                                            },
                                            {
                                                "example_id": "274cee66-bec6-4879-9081-3fe8b39677ab",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "Ce chien connaît bien son maître."
                                            },
                                            {
                                                "example_id": "bc3500ec-5a75-4a87-96b9-67f9875a1c05",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "Ce cheval connaît le chemin."
                                            },
                                            {
                                                "example_id": "c2c706d1-2af7-4e6f-8d7d-a3078f99740a",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "La plupart des animaux connaissent les plantes qui peuvent leur être nuisibles."
                                            },
                                            {
                                                "example_id": "1e20a4b8-1f27-4c72-822d-b6adfe17f3b4",
                                                "sense_id": "865a9316-715f-3be6-92fa-d4dbf319d469",
                                                "text": "Au sommet Eddy sprinte pour passer en tête car il veut donner une leçon à Vandenbossche qui a signé chez Molteni. Chacun croit qu'il va se relever dans la descente mais c'est mal connaître Eddy qui fonce à toute allure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b43b183-a226-3ad8-b5b7-2d0777b3a684",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Prendre en considération ; faire acception."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "410e81ac-72e3-45f8-9724-20bceda2f20c",
                                                "sense_id": "5b43b183-a226-3ad8-b5b7-2d0777b3a684",
                                                "text": "La littérature érotique embrasse plus de réalités psychologiques que la morale bourgeoise ne voulait en connaître, et que le puritanisme n'en tolère."
                                            },
                                            {
                                                "example_id": "bb36b4bf-f5b3-46d2-8ad5-7d37a57bde07",
                                                "sense_id": "5b43b183-a226-3ad8-b5b7-2d0777b3a684",
                                                "text": "Alliant tradition et modernité, la phytothérapie n'est exclusive d'aucune autre thérapeutique. Elle connaît des précautions d'emploi, des contre-indications, des interactions et, nous l'avons vu, un professionnel de la santé est le mieux placé pour la conseiller à chacun, selon ses besoins."
                                            },
                                            {
                                                "example_id": "03359138-c249-43c1-8218-dc81b2b553a0",
                                                "sense_id": "5b43b183-a226-3ad8-b5b7-2d0777b3a684",
                                                "text": "Il veut que tous soient également soumis à la discipline et il ne connaît à cet égard ni parents ni amis."
                                            },
                                            {
                                                "example_id": "559280fc-74c3-42b3-8794-fabfa3845127",
                                                "sense_id": "5b43b183-a226-3ad8-b5b7-2d0777b3a684",
                                                "text": "Quand il s’agit de ses intérêts, il ne connaît personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e4500b0-4a7b-3e06-852d-3bd3db6cacfd",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Avoir une grande pratique, un grand usage, des choses qu’on a étudiées et auxquelles on s’entend bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea52e747-fdf4-4a58-9464-35bbec170159",
                                                "sense_id": "4e4500b0-4a7b-3e06-852d-3bd3db6cacfd",
                                                "text": "Il voudrait tout connaître. — Connaître une langue, une science, un art."
                                            },
                                            {
                                                "example_id": "a727fd53-d15c-462c-8584-bb1293d23def",
                                                "sense_id": "4e4500b0-4a7b-3e06-852d-3bd3db6cacfd",
                                                "text": "Il affrontait tous les temps, bravait toutes les mers et prétendait que la mer et lui se connaissaient trop, depuis longtemps, « pour se faire des méchancetés »."
                                            },
                                            {
                                                "example_id": "6ae27c83-499f-462d-a033-c8edd4813c8e",
                                                "sense_id": "4e4500b0-4a7b-3e06-852d-3bd3db6cacfd",
                                                "text": "Il connaît les mathématiques, le grec, le latin."
                                            },
                                            {
                                                "example_id": "ec6f5825-2ef9-4d8c-9df3-374baab9c40b",
                                                "sense_id": "4e4500b0-4a7b-3e06-852d-3bd3db6cacfd",
                                                "text": "Connaître à fond une science, une affaire. — Connaître les livres, les pierreries, les tableaux, etc."
                                            },
                                            {
                                                "example_id": "2a718fe1-da28-478c-af31-9d81f3ddff45",
                                                "sense_id": "4e4500b0-4a7b-3e06-852d-3bd3db6cacfd",
                                                "text": "Je ne parle point de ce que je ne connais pas. — Il connaît les ruses du métier, ce que l’expérience nous apprend à connaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Avoir une bonne pratique d'une personne ou d'un groupe humain."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a10a18-55e2-4c8f-b147-6ae4c24160e8",
                                                "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                                "text": "— Comment sais-tu ?\nElle soupira, répondit par une phrase qui lui était familière.\n— Je te connais comme si je t’avais fait…"
                                            },
                                            {
                                                "example_id": "7406eedb-9edd-4804-9119-27adc44f4d3f",
                                                "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                                "text": "Je connais bien cet homme, et je peux compter sur lui."
                                            },
                                            {
                                                "example_id": "337635b4-f77e-4f19-9207-a5e428cd0702",
                                                "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                                "text": "Je le connais pour ce qu’il est. — Il a trompé bien du monde, on ne le connaissait pas."
                                            },
                                            {
                                                "example_id": "5b176bd3-335c-42de-aa6b-8091a34126e3",
                                                "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                                "text": "Cet homme gagne à être connu.— Je le connais incapable de mentir."
                                            },
                                            {
                                                "example_id": "ee9b40e4-be66-422c-bc68-b35a75235a24",
                                                "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                                "text": "Je connais votre cœur. — Vous me connaissez mal, si vous m’attribuez de telles intentions."
                                            },
                                            {
                                                "example_id": "64a35650-3022-4f2e-bbe8-2634d9ea7adf",
                                                "sense_id": "0cb6aa84-ec91-3484-bf53-647a6fbbbe77",
                                                "text": "Que vous connaissez peu les hommes ! — C’est un homme qui connaît bien le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce1349a-b0c2-39fc-98cd-3c979a8446c4",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Être en capacité d’apprécier, de juger, une ou des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7763b8a0-ce22-46d1-9259-7bf0177ac1a1",
                                                "sense_id": "bce1349a-b0c2-39fc-98cd-3c979a8446c4",
                                                "text": "Le siècle qui posséda ce grand homme ne le connut pas."
                                            },
                                            {
                                                "example_id": "90c50b2b-b7ea-49bc-9fe0-a83285c4cd32",
                                                "sense_id": "bce1349a-b0c2-39fc-98cd-3c979a8446c4",
                                                "text": "On perdit cet écrivain lorsqu’on commençait enfin à le connaître."
                                            },
                                            {
                                                "example_id": "30091cea-69dc-4e22-8bde-48f5f00c2038",
                                                "sense_id": "bce1349a-b0c2-39fc-98cd-3c979a8446c4",
                                                "text": "C’est un homme connu. — Il est connu par son mérite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c56d90-d35a-330e-b1b9-4e0eb9b3677f",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Avoir des liaisons, des relations avec quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98cdbab-020c-41a4-9fea-f2a2b384ad07",
                                                "sense_id": "45c56d90-d35a-330e-b1b9-4e0eb9b3677f",
                                                "text": "On est venu nous offrir des bières par le toit ouvrant, alors que les gens qui nous les tendaient ne nous connaissaient pas."
                                            },
                                            {
                                                "example_id": "e70f89b8-03e8-4984-bbf9-f5f16c470436",
                                                "sense_id": "45c56d90-d35a-330e-b1b9-4e0eb9b3677f",
                                                "text": "Connaissez-vous quelqu’un de mes juges ? — Je n’en connais pas un."
                                            },
                                            {
                                                "example_id": "6d5efc81-7bae-471c-be16-2248e02092a5",
                                                "sense_id": "45c56d90-d35a-330e-b1b9-4e0eb9b3677f",
                                                "text": "Il connaît tout le monde. — Je vous le ferai connaître."
                                            },
                                            {
                                                "example_id": "a41ed12d-4f4c-41f6-b30a-af9dd87e5fe8",
                                                "sense_id": "45c56d90-d35a-330e-b1b9-4e0eb9b3677f",
                                                "text": "Je ne connais point cet homme-là, ni ne veux le connaître. — Nous vous connaissons depuis longtemps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "879ecb38-1072-336b-8623-ab139ef66aab",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Avoir des relations sexuelles avec une personne."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05ebd71f-0f3c-4e11-9018-de4306537dc2",
                                                "sense_id": "879ecb38-1072-336b-8623-ab139ef66aab",
                                                "text": "— Vous n’avez jamais connu, au sens biblique du mot, — une femme ?"
                                            },
                                            {
                                                "example_id": "84050838-fd02-40df-84bc-7c65e4878c53",
                                                "sense_id": "879ecb38-1072-336b-8623-ab139ef66aab",
                                                "text": "À son âge, en nos campagnes, quel garçon n'a pas connu la femme."
                                            },
                                            {
                                                "example_id": "3772934d-f270-46ec-a92c-d98b549e50aa",
                                                "sense_id": "879ecb38-1072-336b-8623-ab139ef66aab",
                                                "text": "Connaître, dans le sens charnel que lui prête la Bible, n’es pas du tout un vain mot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Sentir, éprouver, en parlant tant au sens physique qu’au sens moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "824bf451-a5dd-4e01-bd87-224ecef00ce0",
                                                "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                                "text": "C'est ainsi que la quasi-totalité des prix des grands produits industriels connaissent au XIXᵉ siècle un trend orienté à la baisse."
                                            },
                                            {
                                                "example_id": "9e469986-5522-4100-9b8e-2886f1016646",
                                                "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                                "text": "Il faut souligner que, si les aciers inoxydables ont connu l'extraordinaire développement que nous connaissons, cela est dû à la disponibilité à grande échelle des métaux entrant dans leur composition, […]."
                                            },
                                            {
                                                "example_id": "d9f5a4b4-f8e2-4464-b7f5-a9fbbd306e98",
                                                "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                                "text": "On ne connaît point l’hiver à la Martinique."
                                            },
                                            {
                                                "example_id": "beece0d8-1f0f-4dc2-b538-e2cb2847f09f",
                                                "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                                "text": "Vous êtes heureux de n’avoir jamais connu le mal de dents, le mal de tête."
                                            },
                                            {
                                                "example_id": "6e73ce73-6ec3-458d-966e-71ba54407bb5",
                                                "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                                "text": "Il n’a jamais connu la haine, la jalousie, etc. — Son cœur allait bientôt connaître l’amour."
                                            },
                                            {
                                                "example_id": "72b2aa94-1aea-4b89-a314-657eb98811d6",
                                                "sense_id": "13c7e2bf-93bd-3256-8f7f-e611c6d8cc9a",
                                                "text": "Il ne connaît point la crainte. — J’ai connu l’infortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Pratiquer une chose, l’admettre, s’y conformer, s’y soumettre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9181b022-e021-4ebe-826c-56a22494c0af",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "En Angleterre, on ne connaît point la loi salique."
                                            },
                                            {
                                                "example_id": "caf394fe-a444-44b0-a3f8-30e1d9ab7b0c",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "Cet usage n’est point connu dans tel pays."
                                            },
                                            {
                                                "example_id": "036cc5d6-3f17-475c-9a4c-31a91d2514b6",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "Ce peuple ne connaît point les raffinements du luxe."
                                            },
                                            {
                                                "example_id": "1b70df19-7601-41ba-8987-15d22c86c22b",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "Il ne connaît point ces vains ménagements."
                                            },
                                            {
                                                "example_id": "514776c5-acdc-4e20-bbe8-6694fe3824d2",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "Sa rage ne connut plus de frein."
                                            },
                                            {
                                                "example_id": "7fdb03d0-c59a-4ed5-85b2-912cfc6c07eb",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "Sa charité ne connaît point de bornes."
                                            },
                                            {
                                                "example_id": "d0af9b67-d223-4373-a798-e6771d26a4df",
                                                "sense_id": "0cc5d0fd-d114-3fd4-aa7f-7751c0b02756",
                                                "text": "Ce cheval connaît la bride, les éperons, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960cc3b1-b8d5-3842-9f5a-f84278187896",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Supporter, admettre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b6fca5-6155-402e-b766-a3d34fdbb6c6",
                                                "sense_id": "960cc3b1-b8d5-3842-9f5a-f84278187896",
                                                "text": "Ne point connaître de supérieur, de maître."
                                            },
                                            {
                                                "example_id": "f3a8e4d3-ab99-4ee7-9ce2-e5d6930a0c18",
                                                "sense_id": "960cc3b1-b8d5-3842-9f5a-f84278187896",
                                                "text": "Je ne connais de maître que vous, que lui, etc."
                                            },
                                            {
                                                "example_id": "a61a4233-8693-4b3e-b9e8-cd89f52d6d44",
                                                "sense_id": "960cc3b1-b8d5-3842-9f5a-f84278187896",
                                                "text": "Je ne connais ici d’autre maître que moi, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50dd7cdb-8a5a-3d99-a442-639b7084c9be",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Avoir autorité et compétence pour juger de certaines matières."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74c3ab0b-aeb1-4a0d-8478-7214030dee83",
                                                "sense_id": "50dd7cdb-8a5a-3d99-a442-639b7084c9be",
                                                "text": "Ce juge connaît des matières civiles et criminelles."
                                            },
                                            {
                                                "example_id": "ac31e00e-553d-4b4b-b9c8-60437cc6dcc8",
                                                "sense_id": "50dd7cdb-8a5a-3d99-a442-639b7084c9be",
                                                "text": "Il en connaît en première instance. — Il en connaît par appel."
                                            },
                                            {
                                                "example_id": "024c721a-c684-4186-90df-688919795b36",
                                                "sense_id": "50dd7cdb-8a5a-3d99-a442-639b7084c9be",
                                                "text": "Il ne peut pas connaître de cela."
                                            },
                                            {
                                                "example_id": "31c6ccfa-1111-4bcf-948d-c534c02d2781",
                                                "sense_id": "50dd7cdb-8a5a-3d99-a442-639b7084c9be",
                                                "text": "Elles admettent que les décisions gouvernementales les plus importantes sont prises pour des motifs qu’on ne peut pas leur exposer, en des formes dont elles n’ont pas à connaître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef5205d5-78aa-3585-ac30-6a87f67b6336",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Comprendre, réaliser, se rendre compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5271e349-1e44-4173-bd68-8c896349b818",
                                                "sense_id": "ef5205d5-78aa-3585-ac30-6a87f67b6336",
                                                "text": "Marie entra dans la maison comme la mort. Madame Bergeret connut à sa vue que les temps étaient révolus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Prendre une juste idée de soi-même, de ses forces, de sa dignité, etc."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5a88bf-bd62-4097-82bf-c66563ad93af",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "L'homme emporté et furieux ne connaît personne, il se connaît à peine lui-même. Il n'est capable de rien entendre; la colère lui fait prononcer une multitude de paroles vagues, dont il perd jusqu'au souvenir; […]."
                                            },
                                            {
                                                "example_id": "1199a8c6-10d3-47a0-921b-afd455e85aab",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "« Connais-toi toi-même » est une des plus belles maximes de la philosophie antique."
                                            },
                                            {
                                                "example_id": "69edbd69-5e8d-4564-b0ad-752319979a89",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Je me connais, à sa vue il me serait impossible de me contenir."
                                            },
                                            {
                                                "example_id": "ba703316-c507-43ec-921c-67cd884dc028",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Apprenez à mieux vous connaître."
                                            },
                                            {
                                                "example_id": "46e86d38-9b90-4967-8682-934206e48792",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Un homme sage et qui sait se connaître."
                                            },
                                            {
                                                "example_id": "1870cfc6-37b5-4dd1-8744-4f8942940563",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Il ne se connaît plus."
                                            },
                                            {
                                                "example_id": "e6aae465-33ff-4826-8609-60f86e91690a",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Se connaître à quelque chose, en quelque chose : Savoir en bien juger."
                                            },
                                            {
                                                "example_id": "6675daa7-331f-4588-9f2e-004c2888562b",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Il se connaît en mérite, en poésie."
                                            },
                                            {
                                                "example_id": "512ee92d-3eea-4be1-bde8-3de5100fc0d6",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Vous connaissez-vous à cela ?"
                                            },
                                            {
                                                "example_id": "68c1c507-c5d0-4636-ad60-448b2034c1df",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Je m’y connais mieux que vous."
                                            },
                                            {
                                                "example_id": "1da6c3c8-cc64-484b-8d6b-853b1d8534f8",
                                                "sense_id": "0264ca83-dcc6-3bfb-bb79-25ae9dd7a464",
                                                "text": "Il ne s’y connaît point du tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c6656f3-9694-33dd-8213-b0568c6e5abf",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Être réputé, être perçu d’une façon, en parlant des choses."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e2c8b9-39d9-4c78-bcf0-0980c11d2235",
                                                "sense_id": "8c6656f3-9694-33dd-8213-b0568c6e5abf",
                                                "text": "Ce verre de vin ne pouvait que nous faire du bien, c’est certain ; mais trois sous ça se connaît sur une journée de quinze à vingt sous !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c86d5d8-79c5-32fc-a4d2-3f5e670d928f",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Être visible, apparent."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a54e64f-8ee5-4251-85da-f40b099ff647",
                                                "sense_id": "8c86d5d8-79c5-32fc-a4d2-3f5e670d928f",
                                                "text": "Au matin, le ciel se découvrit, les étoiles se remirent à luire, le grand vent en avait éteint si peu que ça ne se connaissait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b603a911-1417-3630-9aee-b7b6ba2e18b6",
                                        "entry_id": "d3e5f20a-e08d-3f49-a4a9-5f28b2f243d9",
                                        "glosses": [
                                            "Savoir. Dans une phrase exclamative, marque la surprise ou l'admiration."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619572f7-2cf4-43af-9303-42840e8ef9d2",
                                                "sense_id": "b603a911-1417-3630-9aee-b7b6ba2e18b6",
                                                "text": "Tu connais faire du porc au sucre ?"
                                            },
                                            {
                                                "example_id": "ed88e969-fbce-4e7c-99e6-d842176421e7",
                                                "sense_id": "b603a911-1417-3630-9aee-b7b6ba2e18b6",
                                                "text": "Tu connais que c'est un costaud lui !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79758013-e254-4d3b-882b-9651d5994c4a",
