                    {
                        "sense_id": "90c0072b-c719-3bd2-82eb-a501a22a6886",
                        "entry_id": "07fd83dd-3660-3bfc-a7a5-505067959a8e",
                        "glosses": [
                            "Bericht, in dem die die Ereignisse einer Woche festgehalten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ff63f1-5522-4152-90ca-ef2ccedbc979",
                                "sense_id": "90c0072b-c719-3bd2-82eb-a501a22a6886",
                                "text": "„Im Wochenbericht vom 9. August 1946 an die US-Militärbehörde findet sich der Hinweis, dass \"die Bevölkerung durch das Bekanntwerden, dass nach Saalfelden Juden kommen sollen, noch mehr verärgert würde\".“"
                            },
                            {
                                "example_id": "51a36e98-01e4-40a3-81de-96fee4d7b1b6",
                                "sense_id": "90c0072b-c719-3bd2-82eb-a501a22a6886",
                                "text": "„In den Wochenberichten wird die hydrologische Situation der vergangenen Woche dokumentiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
