                                "sense_id": "bd6b8624-967b-3200-8121-b4b552829b30",
                                "text": "De moedige reddingswerkster hielp bij het redden van mensen uit het ingestorte gebouw.",
                                "translation": "The brave rescue worker assisted in rescuing people from the collapsed building.",
                                "english": "The brave rescue worker assisted in rescuing people from the collapsed building."
                            },
                            {
                                "example_id": "73b0ca8b-275d-4b1d-8a0b-fa9e9de6502a",
                                "sense_id": "bd6b8624-967b-3200-8121-b4b552829b30",
                                "text": "De reddingswerkers riskeren hun leven om anderen te helpen in noodsituaties.",
                                "translation": "The rescue workers risk their lives to help others in emergency situations.",
                                "english": "The rescue workers risk their lives to help others in emergency situations."
