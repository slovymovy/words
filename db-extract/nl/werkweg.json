                    {
                        "sense_id": "6776793b-c4b2-3d49-9860-0926d5cdb264",
                        "entry_id": "c524126a-ebef-3de1-b0f0-ae60ff7c4c5b",
                        "glosses": [
                            "weg speciaal voor werkverkeer"
