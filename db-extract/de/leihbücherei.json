                "senses": [
                    {
                        "sense_id": "fb1efdfe-ed5a-34a3-a622-8d9b4b6d03f4",
                        "entry_id": "a43bdf2c-637d-36ec-a997-b900ae8aa9a6",
                        "glosses": [
                            "meist öffentliche Sammlung von Büchern, die gegen eine Gebühr ausgeliehen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4358942-ded4-41b7-9889-b52d75524580",
                                "sense_id": "fb1efdfe-ed5a-34a3-a622-8d9b4b6d03f4",
                                "text": "Karl und Lisa besorgten sich das Kamasutra in der Leihbücherei."
                            },
                            {
                                "example_id": "48a606a0-ee26-42e6-9e6b-6ee2715d1586",
                                "sense_id": "fb1efdfe-ed5a-34a3-a622-8d9b4b6d03f4",
                                "text": "„Wenn ein Printbuch verkauft wird, wird es anschließend verliehen, gebraucht verkauft, weiter verliehen, landet in einer Leihbücherei.”"
                            },
                            {
                                "example_id": "a3299b42-ebd1-4bc0-a550-a531fc7e941e",
                                "sense_id": "fb1efdfe-ed5a-34a3-a622-8d9b4b6d03f4",
                                "text": "„Ein paar Vaterunser, und man war aller Sünden ledig und konnte Fußball spielen gehen oder in der Städtischen Leihbücherei versuchen, verbotene Bücher zu bekommen.“"
                            },
                            {
                                "example_id": "8c7b08de-465b-439b-9af6-fe9f3e79d8c6",
                                "sense_id": "fb1efdfe-ed5a-34a3-a622-8d9b4b6d03f4",
                                "text": "„Anschließend gab es einen Empfang in der Leihbücherei in der Osborne Terrace, wo Roth als Jugendlicher viel Zeit verbracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
