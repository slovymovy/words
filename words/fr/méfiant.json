        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "987874c6-d4f3-3538-aa16-7e4d6985852d",
                    "sense_definition": "Participe présent de <w>méfier</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En se <w>méfiant</w> de tout le monde, elle a fini par s'isoler complètement.",
                            "target_lang_translations": {
                                "en": "By <w>distrusting</w> everyone, she ended up isolating herself completely.",
                                "ru": "<w>Остерегаясь</w> всех, она в конце концов полностью замкнулась в себе.",
                                "de": "Indem sie allen <w>misstraute</w>, isolierte sie sich schließlich völlig.",
                                "es": "<w>Desconfiando</w> de todo el mundo, acabó aislándose por completo.",
                                "zh": "她对所有人都<w>不信任</w>，最终把自己彻底孤立了。"
                            }
                        },
                        {
                            "text": "Tout en se <w>méfiant</w> du chien agressif, le facteur a glissé le courrier dans la boîte.",
                            "target_lang_translations": {
                                "en": "While still <w>distrusting</w> the aggressive dog, the postman slipped the mail into the letterbox.",
                                "ru": "Всё ещё <w>остерегаясь</w> агрессивной собаки, почтальон опустил письма в почтовый ящик.",
                                "de": "Während er dem aggressiven Hund noch <w>misstraute</w>, steckte der Briefträger die Post in den Briefkasten.",
                                "es": "Mientras seguía <w>desconfiando</w> del perro agresivo, el cartero metió el correo en el buzón.",
                                "zh": "邮递员一边<w>提防</w>着那条凶猛的狗，一边把信件塞进了信箱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participe présent"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The present participle of the verb meaning to distrust or be wary of someone.",
                        "ru": "Причастие настоящего времени от глагола «méfier», означающего не доверять кому-либо или остерегаться.",
                        "de": "Partizip Präsens des Verbs „misstrauen“, das bedeutet, jemandem oder einer Sache nicht zu trauen.",
                        "es": "Forma del gerundio del verbo francés «méfier», que significa desconfiar de alguien o estar en guardia.",
                        "zh": "法语动词méfier的现在分词，表示不信任或提防。"
                    },
