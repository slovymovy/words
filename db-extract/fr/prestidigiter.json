                        "sense_id": "f94fd526-12f6-3457-9ce3-fecfbf94b666",
                        "entry_id": "fb2572ab-8fa7-34f6-9667-9c65b17134be",
                        "glosses": [
                            "Traiter à la manière d’un prestidigitateur."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8c4ca4c7-f3ec-4e56-b57c-888ddd15942a",
                                "sense_id": "f94fd526-12f6-3457-9ce3-fecfbf94b666",
                                "text": "D’abord les grands acteurs de la politique qui prestidigitent les grandes affaires générales, et que des nations entières regardent jouer ces rôles suprêmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "567e116f-fba7-30e0-9200-156e3ad24ced",
                        "entry_id": "fb2572ab-8fa7-34f6-9667-9c65b17134be",
                        "glosses": [
                            "Agir à la manière d’un prestidigitateur."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "11107736-374d-4e1c-8631-a8e43d392733",
                                "sense_id": "567e116f-fba7-30e0-9200-156e3ad24ced",
                                "text": "[…] il est pas martyr lui là-haut, navigateur-la-gondole !… il se démène, il prestidigite ! yop ! il soulage à la houle ! toute sa plate-forme se dresse au vent !… et il repart en rond !… tourbillonne !… il tangue !… il fonce… il va piquer… non ! voilà l’être que c’est ! l’artiste !"
                            }
                        ]
                    }
