        "fr-extract.jsonl": [
            {
                "entry_id": "3125949d-2e47-3e87-9dca-1cab6c95ad67",
                "word": "ignominieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                        "entry_id": "3125949d-2e47-3e87-9dca-1cab6c95ad67",
                        "glosses": [
                            "Avec ignominie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f1d58d-5338-425a-a449-36d6c1b71955",
                                "sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                                "text": "Ce faquin a osé me toucher. Il convient qu’il expie ignominieusement ce crime."
                            },
                            {
                                "example_id": "fefe1ce7-681c-46c7-929c-857aa10c881b",
                                "sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                                "text": "Il faudrait dire à l’armée par un ordre du jour, que l’homme qui se suicide manque de cœur, qu’il déserte lâchement son poste, qu’il renie son drapeau; que, déclaré traître à la patrie, son nom sera ignominieusement rayé des contrôles de l’armée, sa mémoire flétrie et son corps privé des honneurs de la sépulture militaire."
                            },
                            {
                                "example_id": "4c90b87e-60da-48c3-bb9d-d59acf4c5590",
                                "sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                                "text": "Entre parenthèses on assure que j’ai lâché ignominieusement ma femme pour aller vivre aux crochets d’une roulure."
                            },
                            {
                                "example_id": "a96ebe8f-aabe-464b-b5a6-0c3d0ed267e8",
                                "sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                                "text": "Malgré ces miracles les Bayeusains ne tardèrent pas à se dégoûter de leur évêque, et ils le chassèrent ignominieusement."
                            },
                            {
                                "example_id": "456a321a-b312-4092-b258-94206d2d7149",
                                "sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                                "text": "Bonnes gens\nÉcoutez la triste ritournelle\nDes amants errants\nEn proie à leurs tourments\nParce qu'ils ont aimé\nDes femmes infidèles\nQui les ont trompés\nIgnominieusement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ff46f9d-106e-4585-82ec-3b1877c891b5",
                        "source_entry_id": "3125949d-2e47-3e87-9dca-1cab6c95ad67",
                        "source_sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                        "target_lang_word": "schändlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schändlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5caec7e-1c1a-38a2-9fc4-716535c1d18f",
                                        "entry_id": "19035238-110a-3ab2-bcdb-fd8011fab278",
                                        "glosses": [
                                            "Schande bringend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad869bc-a53e-4aea-afad-f2270ba5dc77",
                                                "sense_id": "e5caec7e-1c1a-38a2-9fc4-716535c1d18f",
                                                "text": "Dieses schändliche Verhalten ist nicht tolerierbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbb20f2c-cbe6-326c-bd41-51680a150417",
                                        "entry_id": "19035238-110a-3ab2-bcdb-fd8011fab278",
                                        "glosses": [
                                            "in sehr negativer Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aca609f4-9f4a-4343-924d-8e65ed13b5fc",
                                                "sense_id": "dbb20f2c-cbe6-326c-bd41-51680a150417",
                                                "text": "Die Wohnung war schändlich zugerichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef173e8b-016d-4521-a266-bca713a710ad",
                        "source_entry_id": "3125949d-2e47-3e87-9dca-1cab6c95ad67",
                        "source_sense_id": "b8d6b00e-9c04-300a-920a-9f8860c2067d",
                        "target_lang_word": "ignominiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ignominiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04f4dab6-3d7e-357d-a67d-35bb1543c9a9",
                                        "entry_id": "9c16bf7f-b88f-32c6-84e6-9cf37332be72",
                                        "glosses": [
                                            "In an ignominious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208c3366-bd55-4ff9-8f4e-0a695d941877",
                                                "sense_id": "04f4dab6-3d7e-357d-a67d-35bb1543c9a9",
                                                "text": "A window opened above the shop, and a frowsty-looking man, yellow-pale, was quickly and nervously hauling in the national flag. There were shouts of derision and mockery—a great overtone of acrid derision—the flag and its owner ignominiously disappeared."
                                            },
                                            {
                                                "example_id": "b6e1b8c9-6cd6-41e4-8c01-470b348c4175",
                                                "sense_id": "04f4dab6-3d7e-357d-a67d-35bb1543c9a9",
                                                "text": "He laughed rather ruefully, as he described how he had discovered a very rare species of fern in an inaccessible place, and in his efforts to obtain it had lost his footing, and slipped ignominiously into a neighbouring pond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
