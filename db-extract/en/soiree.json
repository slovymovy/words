                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soiree",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "790e4f2b-9969-3100-b81b-24d7b1f9561d",
                                        "entry_id": "7b50d4bf-a715-3476-bdc1-301692c05e72",
                                        "glosses": [
                                            "festliche Veranstaltung, die abends stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a50708f-38a8-47b2-8cab-f2ef59f21020",
                                                "sense_id": "790e4f2b-9969-3100-b81b-24d7b1f9561d",
                                                "text": "Die Soiree wurde von vielen Prominenten besucht."
                                            },
                                            {
                                                "example_id": "0b46c742-be37-4d3e-ba01-febd7b6542d0",
                                                "sense_id": "790e4f2b-9969-3100-b81b-24d7b1f9561d",
                                                "text": "„Bei einer Soiree von Berta Zuckerkandl lernte etwa Alma Schindler ihren zukünftigen Ehemann, Gustav Mahler, kennen.“"
                                            },
                                            {
                                                "example_id": "f4d72fa7-960c-4b0e-bc64-e7aaef7fab46",
                                                "sense_id": "790e4f2b-9969-3100-b81b-24d7b1f9561d",
                                                "text": "„In diese Kategorie fällt auch die folgende Geschichte einer junonischen Gastgeberin, die eine Soiree gibt und ihre Gäste in großer Abendrobe mit einem prächtigen Papagei auf der linken Schulter empfängt.“"
                                            },
                                            {
                                                "example_id": "551a8674-47ed-4e18-9fac-b394b8e09550",
                                                "sense_id": "790e4f2b-9969-3100-b81b-24d7b1f9561d",
                                                "text": "„Die Soiree der Anna Pawlowna war in vollem Gange.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "932053b6-8be0-480c-b50c-3e85ddd90358",
                        "source_entry_id": "bc352488-e75e-31c4-a3aa-28f4ac121191",
                        "source_sense_id": "cbaa3ccf-8078-3aba-b1a4-05fab25d3e41",
                        "source_sense_description": "formal evening party",
                        "target_lang_word": "банке́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "банке́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1300c8e7-d6f6-325f-84da-22175724dc7b",
                                        "entry_id": "c615709f-29e2-3e4e-81e3-e587cfa0597f",
                                        "glosses": [
                                            "торжественный званый обед или ужин, устраиваемый по случаю какого-либо знаменательного события или в честь кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a27686aa-2f84-42f6-8663-696040e52cd3",
                                                "sense_id": "1300c8e7-d6f6-325f-84da-22175724dc7b",
                                                "text": "В самой Академии был устроен шикарный банкет с самыми дорогими деликатесами."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "банке́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "94b69b35-875e-3005-811c-e3a62c727a99",
                                        "entry_id": "69e1a416-c5d1-3c1e-936a-3dc3910b17e0",
                                        "glosses": [
                                            "спец. невысокий вал из грунта или щебня вдоль железнодорожного полотна или дороги, служащий для защиты от воды, предохраняющий от осыпания земли"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adbc34fb-31fa-3cd1-b87b-cdede17f2b1e",
                                        "entry_id": "69e1a416-c5d1-3c1e-936a-3dc3910b17e0",
                                        "glosses": [
                                            "спец. барьер, насыпь, перегораживающие русло реки для проведения каких-либо строительных работ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bad9b73-4bb5-4ade-91c2-50247830ae88",
                                                "sense_id": "adbc34fb-31fa-3cd1-b87b-cdede17f2b1e",
                                                "text": "На дне реки выросла большая, напоминающая по форме полумесяц каменная насыпь-банкет, протянувшаяся от берега почти на 300 м. К паводку отсыпка банкета была закончена."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc813051-35bd-344f-9874-b2bdbd0e2048",
                                        "entry_id": "69e1a416-c5d1-3c1e-936a-3dc3910b17e0",
                                        "glosses": [
                                            "искусственное препятствие, на которое должна вспрыгнуть лошадь, а затем соскочить с него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13302827-6131-4867-8c03-426c07dd4370",
                                                "sense_id": "dc813051-35bd-344f-9874-b2bdbd0e2048",
                                                "text": "Подобно тому, как прирожденный всадник связан неразрывно телом и духом со своей породистой лошадью, идущей на ирландский банкет, ― был связан капитан князь Тулубеев со своим эскадроном, своим полком и со всей славной русской кавалерией."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ced6d7af-d95c-3a33-9693-6f2d8ff9762d",
                                        "entry_id": "69e1a416-c5d1-3c1e-936a-3dc3910b17e0",
                                        "glosses": [
                                            "морск. возвышение или площадка на корабле, предназначенные для установки навигационных приборов или орудий, для укладки чего-либо (тросов, сетей и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d27daa-1228-4c7b-8485-da2e9c847f32",
                                                "sense_id": "ced6d7af-d95c-3a33-9693-6f2d8ff9762d",
                                                "text": "Ракетные АПЛ имеют, как пра­вило, надстройку (банкет) в районе выходов из прочного корпуса ракет­ных шахт, и ее размеры полностью определяются их числом и габарита­ми."
                                            },
                                            {
                                                "example_id": "2736b4d3-22db-4c6b-8d1f-5975df2dc703",
                                                "sense_id": "ced6d7af-d95c-3a33-9693-6f2d8ff9762d",
                                                "text": "На корабле пр. 701 верхние части ракетных шахт прикрывались специальным банкетом, располагавшимся за ограждением рубки. За банкетом находилась платформа с ВВАБТ «Параван» и ее лебедка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3c5eee-1142-303d-a404-4dce4bef3f02",
                                        "entry_id": "69e1a416-c5d1-3c1e-936a-3dc3910b17e0",
                                        "glosses": [
                                            "воен. деревянное или каменное возвышение на крепостном валу, бруствере, у окна крепости и т. п., где размещались стрелки"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "банке́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "063d522a-4458-3c1f-b69c-3fe7debaf7f6",
                                        "entry_id": "9962a860-13f2-3ce1-b58f-e79c34a67fd0",
                                        "glosses": [
                                            "геол. золотоносный конгломерат из кварца, скреплённого кремнезёмом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08696d6-0ba3-4b6c-b559-eb350d995f75",
                                                "sense_id": "063d522a-4458-3c1f-b69c-3fe7debaf7f6",
                                                "text": "Характерную особенность Витватерсранда составляет залегающий «рифами» в земле золотоносный кварцевый конгломерат, известный под названием «банкета» (от сходства с испещрённым миндалинами пряником, который по-голландски называется банкетом)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
