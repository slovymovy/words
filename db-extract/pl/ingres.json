                "translations": [
                    {
                        "translation_id": "9a710ddc-44b9-4a47-85d2-59c0f4e241e1",
                        "source_entry_id": "3e576237-9721-38b8-b81b-336fe28f3c9c",
                        "source_sense_id": "aea58328-9131-389e-9b50-f75bd5f7716f",
                        "target_lang_word": "ingress",
