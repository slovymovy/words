                            "Namibia"
                        ],
                        "examples": [
                            {
                                "example_id": "6be657d7-5f55-4690-affe-4ad17b428a48",
                                "sense_id": "cd5ef521-51e6-3c69-be15-d869c8654b82",
                                "text": "„Die für kommenden Donnerstag geplante Einschwörung des designierten simbabwischen Premierminister Morgan Tsvangirai ist in Gefahr.“"
                            },
                            {
                                "example_id": "c256a107-0fa8-4193-9372-db1ba7981786",
                                "sense_id": "cd5ef521-51e6-3c69-be15-d869c8654b82",
                                "text": "„Die Einschwörung der Ratsmitglieder hat verspätet stattgefunden, da ein Gerangel zwischen der Koalition (zuerst bestehend aus zwei RDP-Mitglieder sowie einem UDF-Delegierten) und den drei SWAPO-Mitgliedern um den NUDO-Kandidaten Kahua stattgefunden hatte.“"
                            },
                            {
                                "example_id": "086e6b51-8dec-4349-bbac-6890a04b955a",
                                "sense_id": "cd5ef521-51e6-3c69-be15-d869c8654b82",
                                "text": "„Namibias Staatspräsident Hage Geingob ist heute nach Ruanda geflogen, um dort am Freitag an der Einschwörung des neuen Staatsoberhaupts Paul Kagame ([…]) teilzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
