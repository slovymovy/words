        "fr-extract.jsonl": [
            {
                "entry_id": "72c5637a-1bd0-3dd4-8089-e11d9dc78ffc",
                "word": "subsidiaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e5625be4-983c-43e4-81e1-1207675b5705",
                        "entry_id": "72c5637a-1bd0-3dd4-8089-e11d9dc78ffc",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "subsidiaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c998896-b11c-378e-aaa3-7cf6277ef31c",
                        "entry_id": "72c5637a-1bd0-3dd4-8089-e11d9dc78ffc",
                        "glosses": [
                            "Qui sert à fortifier un moyen principal, qui vient à l’appui, destiné à suppléer ce qui viendrait à faire défaut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ddd829-9597-4d08-be81-b170d2e82402",
                                "sense_id": "9c998896-b11c-378e-aaa3-7cf6277ef31c",
                                "text": "La société Hydra LS demande au juge administratif d’annuler le marché public de service conclu par l’office public de l’habitat de Calais avec la société des Eaux de Calais ayant pour objet la maintenance des suppresseurs d’eaux et, à titre subsidiaire, de résilier le marché conclu par l’office public de l’habitat de Calais avec la société des Eaux de Calais, de condamner l’office public de l’habitat de Calais à l’indemniser du préjudice qu’elle a subi en raison de l’illégalité de la procédure de passation du marché litigieux."
                            },
                            {
                                "example_id": "be86f5d5-422b-405c-8f71-a606467bce18",
                                "sense_id": "9c998896-b11c-378e-aaa3-7cf6277ef31c",
                                "text": "Des moyens subsidiaires."
                            },
                            {
                                "example_id": "db16840b-ca60-498a-9ce5-7b0d04038000",
                                "sense_id": "9c998896-b11c-378e-aaa3-7cf6277ef31c",
                                "text": "Conclusions subsidiaires, conclusions conditionnelles, qu’on prend en second lieu, et pour le cas seulement où les conclusions principales ne seraient pas adjugées."
                            },
                            {
                                "example_id": "70684cce-159b-46c1-9e73-86092ae2715f",
                                "sense_id": "9c998896-b11c-378e-aaa3-7cf6277ef31c",
                                "text": "Hypothèque subsidiaire, seconde hypothèque qui sert à assurer davantage la première, et qui n’a d’effet qu’au défaut de l’autre."
                            },
                            {
                                "example_id": "33f6637c-f35d-49aa-9432-b2f76dca004c",
                                "sense_id": "9c998896-b11c-378e-aaa3-7cf6277ef31c",
                                "text": "On dit dans le même sens : caution subsidiaire, seconde caution utilisée à défaut de la première."
                            }
                        ]
                    },
                    {
                        "sense_id": "29fa5446-52a7-3bf3-879d-654022f82b7f",
                        "entry_id": "72c5637a-1bd0-3dd4-8089-e11d9dc78ffc",
                        "glosses": [
                            "Qui vient à l’appui d'une chose plus importante, qui constitue un élément accessoire, par surcroît."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6e886e-5346-4fbd-aa01-74ba2d729b41",
                                "sense_id": "29fa5446-52a7-3bf3-879d-654022f82b7f",
                                "text": "Raison subsidiaire."
                            },
                            {
                                "example_id": "4f616208-87ee-4e56-9372-ff2b46a1b748",
                                "sense_id": "29fa5446-52a7-3bf3-879d-654022f82b7f",
                                "text": "Motif subsidiaire."
                            },
                            {
                                "example_id": "8f22ab5c-8fba-45ba-a651-00f16192ceff",
                                "sense_id": "29fa5446-52a7-3bf3-879d-654022f82b7f",
                                "text": "Question subsidiaire, qui mérite débat à l’École de guerre : est-il bon d’humilier ses subordonnés ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
