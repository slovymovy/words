                "senses": [
                    {
                        "sense_id": "0290909e-1f57-38ba-a36f-1f8f57f187e3",
                        "entry_id": "42a6d1d1-083e-3ccd-98c8-07c24ec08c95",
                        "glosses": [
                            "Schauspiel in der Arena, bei dem sich ein oder mehrere Athleten auf ein gewagtes Spiel mit einem Stier einlassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee2deb6-3da7-4d9e-844e-55b3cfba1696",
                                "sense_id": "0290909e-1f57-38ba-a36f-1f8f57f187e3",
                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                            },
                            {
                                "example_id": "09a9d251-2efd-4810-8712-1ae2f652ddb4",
                                "sense_id": "0290909e-1f57-38ba-a36f-1f8f57f187e3",
                                "text": "„Schon im alten Kreta gab es Stierspiele, und spanische Kampfstiere wurden bereits im Kolosseum im späten Rom bevorzugt.“"
                            },
                            {
                                "example_id": "48792488-1089-487d-832d-ca7ee8a12059",
                                "sense_id": "0290909e-1f57-38ba-a36f-1f8f57f187e3",
                                "text": "„Die schon in der Antike bekannten, vor allem aus Kreta überlieferten Stierspiele […] hatten ursprünglich rituelle Bedeutung.“"
                            },
                            {
                                "example_id": "8a287ac0-be90-4b57-ace0-b46fabe1ab3c",
                                "sense_id": "0290909e-1f57-38ba-a36f-1f8f57f187e3",
                                "text": "„Sie begnügten sich mit den provenzalischen Stierspielen - da bleibt der Stier am Leben.“"
                            },
                            {
                                "example_id": "6bc24ed4-769f-4739-96c2-c76304bc0fc8",
                                "sense_id": "0290909e-1f57-38ba-a36f-1f8f57f187e3",
                                "text": "„Äußerlich anpassungsfähig und im Innern zählebig, haben die Stierspiele bisher alle Anfeindungen überlebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
