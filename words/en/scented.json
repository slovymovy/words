{
    "word_family": [
        "scent",
        "scentless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52c3fbd7-9c5d-333c-9fca-6fcff84da520",
                    "sense_definition": "Having a pleasant aroma or agreeable smell.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fragrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a <w>scented</w> candle to make her living room feel cozy. ",
                            "target_lang_translations": {
                                "zh": "她买了一支<w>香氛</w>蜡烛，让客厅感觉很温馨。"
                            }
                        },
                        {
                            "text": "The garden was full of <w>scented</w> flowers that bloomed in early spring.",
                            "target_lang_translations": {
                                "zh": "花园里开满了初春时节绽放的<w>芬芳</w>花朵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fragrant",
                        "perfumed",
                        "aromatic"
                    ],
                    "antonyms": [
                        "malodorous",
                        "odorous",
                        "stinky"
                    ],
                    "common_phrases": [
                        "scented candle",
                        "scented flower"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有令人愉悦的香气或气味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "香的",
                                "target_lang_sense_clarification": "形容具有天然或宜人的香气。"
                            },
                            {
                                "target_lang_word": "芬芳的",
                                "target_lang_sense_clarification": "形容气味浓郁且好闻，多用于花卉。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6b411da-4912-3e78-9599-8e42e64baba1",
                    "sense_definition": "Artificially infused or treated with perfume or fragrance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fragrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer to wash my hands using <w>scented</w> soap. ",
                            "target_lang_translations": {
                                "zh": "我更喜欢用<w>加香</w>肥皂洗手。"
                            }
                        },
                        {
                            "text": "She wrote a letter on heavily <w>scented</w> paper.",
                            "target_lang_translations": {
                                "zh": "她在一张<w>带有浓郁香气</w>的纸上写了一封信。"
                            }
                        }
                    ],
                    "synonyms": [
                        "perfumed"
                    ],
                    "antonyms": [
                        "unscented",
                        "fragrance-free"
                    ],
                    "common_phrases": [
                        "scented soap",
                        "scented oil",
                        "scented lotion"
                    ],
                    "target_lang_definitions": {
                        "zh": "人工添加了香料或经过香氛处理的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加香的",
                                "target_lang_sense_clarification": "指通过人工手段添加了香精或香料。"
                            },
                            {
                                "target_lang_word": "有香味的",
                                "target_lang_sense_clarification": "泛指带有某种特定香味的日用品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f750a42-0942-3333-a153-f14c23bed97f",
                    "sense_definition": "Having a smell or odor of a specified kind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden contained several unique plants with skunk-<w>scented</w> leaves. ",
                            "target_lang_translations": {
                                "zh": "花园里有几种独特的植物，叶子<w>带有</w>臭鼬般的<w>气味</w>。"
                            }
                        },
                        {
                            "text": "The room was filled with pine-<w>scented</w> air after they brought in the Christmas tree.",
                            "target_lang_translations": {
                                "zh": "他们搬进圣诞树后，房间里充满了<w>松木味</w>的空气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smelling"
                    ],
                    "common_phrases": [
                        "pine-scented",
                        "lemon-scented"
                    ],
                    "target_lang_definitions": {
                        "zh": "带有某种特定气味的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "带有……气味的",
                                "target_lang_sense_clarification": "用于描述具有某种特定气味特征的物体。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69590782-a4f4-32ed-b803-ee8563bb1682",
                    "sense_definition": "simple past and past participle of <w>scent</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>scented</w> a rabbit in the bushes and ran after it.",
                            "target_lang_translations": {
                                "zh": "那条狗<w>嗅出</w>灌木丛里有只兔子，便追了过去。"
                            }
                        },
                        {
                            "text": "She lightly <w>scented</w> her bathwater with lavender essential oil.",
                            "target_lang_translations": {
                                "zh": "她往洗澡水里滴了几滴薰衣草精油，<w>使</w>水<w>散发出</w>淡淡的香气。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 scent 的过去式和过去分词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嗅出",
                                "target_lang_sense_clarification": "指动物通过嗅觉发现某物。"
                            },
                            {
                                "target_lang_word": "使散发香气",
                                "target_lang_sense_clarification": "指在某物中加入香料使其变香。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}