                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5f7665-51b3-4f8f-ac97-b124980f5e05",
                                                "sense_id": "631234e4-35db-37ea-81db-f41abe044f8e",
                                                "text": "734.807 — 9 mars 1932 — Caudrellez C. L. E. — « Dispositif anti-vol pour automobile. » […] 735.077 — 11 juillet 1932 — Dombret, R. — Dispositif anti-vol pour roue de secours."
                                            },
                                            {
                                                "example_id": "db482ffe-0689-4662-a9aa-a6de51583c17",
                                                "sense_id": "631234e4-35db-37ea-81db-f41abe044f8e",
                                                "text": "Il empoigne la machine, ne peut la faire rouler à cause du cadenas anti-vol."
                                            },
                                            {
                                                "example_id": "9153f4be-d880-4986-b6ab-8e30a7bb7d1f",
                                                "sense_id": "631234e4-35db-37ea-81db-f41abe044f8e",
                                                "text": "Un nouveau système anti-vol pour voitures automobiles a été mis au point en Grande-Bretagne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anti-vol",
                                "target_lang_code": "fr",
                                "target_senses": [
