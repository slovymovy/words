                        "examples": [
                            {
                                "example_id": "ede632d3-9d39-45fc-9199-178f58d00a06",
                                "sense_id": "66046be0-eb02-3ff2-bd01-c3460bbc207e",
                                "text": "Een oproep van viroloog Ab Osterhaus aan grieppatiënten om hun huisarts om antivirale middelen te vragen, zorgt voor opschudding in artsenkringen. Osterhaus deed zijn oproep zaterdag onder meer in het NOS Journaal. De griepremmers zijn wetenschappelijk omstreden."
                            },
                            {
                                "example_id": "a2f0008e-c545-43d5-a98b-024f8e3f643f",
                                "sense_id": "66046be0-eb02-3ff2-bd01-c3460bbc207e",
                                "text": "De GGD IJsselland deelt griepremmers en antivirusmiddelen uit in het nu afgesloten gebied in Kamperveen. Volgens de GGD is van vogelgriep type H5N8 nog nooit iemand in de wereld ziek geworden. Maar in Nederland waart ook de gewone wintergriep rond. Uit besmetting met vogelgriep zou een gevaarlijk nieuw griepvirus kunnen ontstaan, aldus een woordvoerder."
                            }
                        ]
