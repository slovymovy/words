                    {
                        "sense_id": "4c951d65-9613-3fef-9f23-8de4c80fca71",
                        "entry_id": "e11951ff-46ec-3288-9474-e25b122fa37f",
                        "glosses": [
                            "A decoration; that which adorns."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "158424ec-c488-4e9d-9825-49de7c93d1fb",
                                "sense_id": "4c951d65-9613-3fef-9f23-8de4c80fca71",
                                "text": "The draperies did little to keep out the light; rather, they were mainly there as adornment for the windows."
                            }
                        ]
                    },
                    {
                        "sense_id": "b15b19d9-39e0-3638-8979-bccf26950a5b",
                        "entry_id": "e11951ff-46ec-3288-9474-e25b122fa37f",
