                "senses": [
                    {
                        "sense_id": "273a1764-871b-3f3a-a6b5-49f224c6a58f",
                        "entry_id": "f2081ab2-097f-34ff-8bfd-81a057cb1cbe",
                        "glosses": [
                            "Regarder quelque chose de loin, sans y prendre part, comme on regarde l’activité de la rue à partir de son balcon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b16b31-0c6b-4f69-af4b-e8dc6b987087",
                                "sense_id": "273a1764-871b-3f3a-a6b5-49f224c6a58f",
                                "text": "Ne balconez pas la vie, entrez en elle, comme l'a fait Jésus. Du pape François !"
                            }
                        ]
                    },
                    {
                        "sense_id": "552e8058-fa58-3f5b-96d7-6cbec88c6016",
                        "entry_id": "f2081ab2-097f-34ff-8bfd-81a057cb1cbe",
                        "glosses": [
                            "Jardiner, mais pour les plantes de son balcon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac47308-c72b-41ee-ab85-e2bf72fd5f4d",
                                "sense_id": "552e8058-fa58-3f5b-96d7-6cbec88c6016",
                                "text": "L'autre chose, c'est que tous, Papa, ma tante et moi, et peut-être aussi mon frère, jardiner et balconer, prendre soin de quelque chose qui vit, nous aide à nous remettre en train, en-vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b24550a-acd7-3ef1-a0b3-81c9954027ea",
                        "entry_id": "f2081ab2-097f-34ff-8bfd-81a057cb1cbe",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f242576-1cfc-453f-8e09-b003dba25f57",
                                "sense_id": "5b24550a-acd7-3ef1-a0b3-81c9954027ea",
                                "text": "il a fallu supporter des enthousiasmes de commande, organisés par l’entrepreneur et « balconer » devant une tourbe de claqueurs !"
                            }
                        ]
                    }
