                    {
                        "sense_id": "4d1763a5-4d9d-35a0-b859-cd2245a252e7",
                        "entry_id": "a69323dd-81af-3779-9625-482d9e9ff56b",
                        "glosses": [
                            "Viande de porc, vue sous l’angle de préceptes religieux de l’islam et du judaïsme en pays arabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414c38f0-e812-4e56-983b-64ce9d48d24c",
                                "sense_id": "4d1763a5-4d9d-35a0-b859-cd2245a252e7",
                                "text": "Surtout la précieuse charcuterie, ces choses qui n’étaient jamais sur notre table, parce que tarouf, c’était péché, parce que c’était halouf, du cochon."
                            },
                            {
                                "example_id": "13fa39f0-6a03-4b14-9405-fdc11e32abe9",
                                "sense_id": "4d1763a5-4d9d-35a0-b859-cd2245a252e7",
                                "text": "L’auteur va jusqu’à s’en amuser, mais on ne sait pas si c’est du lard ou du halouf"
                            }
                        ]
                    },
