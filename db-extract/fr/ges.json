                    {
                        "sense_id": "8d8b2196-578c-3c26-a5cb-e94368b0823e",
                        "entry_id": "08be027c-d8c8-367e-b340-b3314d74a8e0",
                        "glosses": [
                            "Gaz à effet de serre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c402fb41-56cc-4433-8323-8811d03e8bb1",
                                "sense_id": "8d8b2196-578c-3c26-a5cb-e94368b0823e",
                                "text": "Il s’agit d’un premier pas vers notre objectif de réduire de 50% les GES émis par habitant d’ici 2031."
                            },
                            {
                                "example_id": "9a066d3d-0ab2-49c9-ab3c-49aae1137a85",
                                "sense_id": "8d8b2196-578c-3c26-a5cb-e94368b0823e",
                                "text": "\"La lutte aux changements climatiques requiert une action collective à l’échelle nationale et internationale, et ce, en raison du fait que, de par leur nature même, les GES ne connaissent pas de frontières \", écrit-il [juge en chef de la Cour Suprême du Canada]."
                            },
                            {
                                "example_id": "38635dbf-c677-437a-a758-42eda9bbd280",
                                "sense_id": "8d8b2196-578c-3c26-a5cb-e94368b0823e",
                                "text": "Le fait que les GES sont, pour la plupart, impossibles à voir rend le débat effectivement difficile, d’autant plus que les pires effets se feront ressentir plus tard."
                            }
                        ]
                    }
