                "senses": [
                    {
                        "sense_id": "b33adc66-1aab-302a-bed0-8756e3cf6214",
                        "entry_id": "3965c6c9-af39-3133-98fe-da0d87e7566a",
                        "glosses": [
                            "Variante de idolâtrer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4e478c08-8080-4869-aef8-8c35f7859c35",
                                "sense_id": "b33adc66-1aab-302a-bed0-8756e3cf6214",
                                "text": "Par crainte d’idolâtriser la créature, on perd son fondement divin, son courage et son orientation vers l’inconditionné."
                            },
                            {
                                "example_id": "10b80722-44a9-4a5b-8c1c-c1e69d79d6bb",
                                "sense_id": "b33adc66-1aab-302a-bed0-8756e3cf6214",
                                "text": "Le mythomane est un narcissiste en ce sens qu’il se prend au sérieux plus que le monde, qu’il s’idolâtrise en quelque sorte, et qu’il essaye de surmonter l’opposition qu’il voit exister entre lui et l’« autre »."
                            }
                        ]
                    }
