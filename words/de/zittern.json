    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c99cd7c-12ba-3402-baa0-2b53011e4c20",
                    "sense_definition": "schnelle, unwillkürliche Hin- und Herbewegungen machen, meist ausgelöst durch Kälte, Angst, Erregung oder Schwäche",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "körperliche_reaktion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Draußen war es so kalt, dass das kleine Kind am ganzen Körper <w>zitterte</w>."
                        },
                        {
                            "text": "Vor großer Aufregung begannen seine Hände beim Halten des Glases zu <w>zittern</w>."
                        }
                    ],
                    "synonyms": [
                        "beben"
                    ],
                    "common_phrases": [
                        "am ganzen Körper zittern",
                        "vor Kälte zittern"
                    ]
                },
                {
                    "sense_id": "297c7923-f200-365f-b2a5-717131499047",
                    "sense_definition": "in großer Sorge sein oder angstvoll um jemanden oder etwas bangen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "angst_sorge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Fans mussten bis zur letzten Minute um den Sieg ihrer Mannschaft <w>zittern</w>."
                        },
                        {
                            "text": "Alle Bürger sollten nach dem Willen des grausamen Herrschers vor ihm <w>zittern</w>."
                        }
                    ],
                    "common_phrases": [
                        "um den Sieg zittern",
                        "vor Angst zittern",
                        "um jemanden zittern"
                    ],
                    "synonyms": [
                        "bangen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98678a5e-80c1-3f83-a5ee-d4bc704e09e4",
                    "sense_definition": "kleine, unkontrollierte und wiederholte Schüttel- oder Zitterbewegungen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "körperliche_reaktion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem anstrengenden Training bemerkte er ein leichtes <w>Zittern</w> in seinen Beinen."
                        },
                        {
                            "text": "Sie versuchte, das <w>Zittern</w> ihrer Stimme vor den vielen Zuhörern zu verbergen."
                        }
                    ],
                    "synonyms": [
                        "Gezitter"
                    ],
                    "common_phrases": [
                        "ein Zittern in den Händen"
                    ]
                }
            ]
        }
    ]
