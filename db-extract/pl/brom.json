                        "sense_id": "bcd33687-40c0-35ea-9595-29652d3a8471",
                        "entry_id": "a4eb5e9d-9c04-3fcd-9504-3be8a5d85ace",
                        "glosses": [
                            "pierwiastek chemiczny o symbolu Br i liczbie atomowej 35"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d0814df-4d87-4c0d-a4c4-e12c7e666b31",
                                "sense_id": "bcd33687-40c0-35ea-9595-29652d3a8471",
                                "text": "Jakie właściwości chemiczne ma brom?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "afe6cf64-185f-3bf4-8393-c495fe6b69d4",
                        "entry_id": "a4eb5e9d-9c04-3fcd-9504-3be8a5d85ace",
                        "glosses": [
                            "bromek potasu, środek uspokajający hamujący libido"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8b1dc877-8a7e-4c1e-b17e-5c13dd176e0a",
                                "sense_id": "afe6cf64-185f-3bf4-8393-c495fe6b69d4",
                                "text": "Mówi się o tym, że brom pod postacią bromku potasu wykorzystywany był w wojsku. Miał on za zadanie stłumić napięcie seksualne u żołnierzy"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
