                                "target_word": "assistant paroissial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f01f2012-4cbb-381e-a99d-4eaf2a913631",
                                        "entry_id": "65248301-e1dc-3b3a-9adc-76697fe86535",
                                        "glosses": [
                                            "Agent pastoral laïc dans une paroisse catholique romaine"
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Luxembourg"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdcffcd3-e167-487d-a4e0-2644be2bb06c",
                                                "sense_id": "f01f2012-4cbb-381e-a99d-4eaf2a913631",
                                                "text": "La nomenclature contenue à l’article 26 de la loi du 2 août 1974 relative aux traitements des titulaires de certaines fonctions publiques, des ministres des cultes et des délégués du Conseil central laïque sera complétée par « assistant paroissial »."
                                            },
                                            {
                                                "example_id": "7f3ee277-dab0-40e8-9781-cc1bba0a4b26",
                                                "sense_id": "f01f2012-4cbb-381e-a99d-4eaf2a913631",
                                                "text": "Sur le plan du droit civil, les assistants paroissiaux ont le statut de ministre du culte, conformément à la Constitution."
                                            },
                                            {
                                                "example_id": "1cc564fa-66c8-4f74-b96b-651845d48073",
                                                "sense_id": "f01f2012-4cbb-381e-a99d-4eaf2a913631",
                                                "text": "Une messe très spéciale aux si beaux sons de guitare de notre assistant paroissial Antonio et où chacun pouvait librement formuler ses voeux de prière."
                                            }
                                        ]
                                    }
                                ]
                            }
