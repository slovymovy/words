                                "target_senses": [
                                    {
                                        "sense_id": "69c0bde6-1151-38f2-a200-c426a9559e75",
                                        "entry_id": "75d733a7-67b3-3196-a013-5679f291c85c",
                                        "glosses": [
                                            "islamische Regierungsform, deren Oberhaupt ein Kalif ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144e47f9-5498-4be5-b722-db22614acf97",
                                                "sense_id": "69c0bde6-1151-38f2-a200-c426a9559e75",
                                                "text": "„Die Ereignisse der frühen Geschichte des Islam erinnern moderne Islamisten an eine Welt, in der das Kalifat das mächtigste und fortschrittlichste Gemeinwesen des gesamten eurasischen Raums war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2a626ca-6792-3c52-964b-11b42545e88b",
                                        "entry_id": "75d733a7-67b3-3196-a013-5679f291c85c",
                                        "glosses": [
                                            "ein islamisches Reich, dessen Oberhaupt ein Kalif ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdc2272-aa79-4a46-a758-317304e1b3d1",
                                                "sense_id": "a2a626ca-6792-3c52-964b-11b42545e88b",
                                                "text": "Ein bekanntes Kalifat war das der Umayyaden."
                                            },
                                            {
                                                "example_id": "fb0aaf7a-21e9-4bf9-9ffd-1a7fe1c901bd",
                                                "sense_id": "a2a626ca-6792-3c52-964b-11b42545e88b",
                                                "text": "„Selbst der oströmische Kaiser sowie der Herrscher des östlichen Kalifats schicken Gesandte an die Schlei, um sich mit Sklaven einzudecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "75a44e03-a2f1-3d2b-b6d4-bea4d8bbf860",
                                        "entry_id": "75d733a7-67b3-3196-a013-5679f291c85c",
                                        "glosses": [
                                            "Amt oder Amtszeit eines Kalifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7454ca8-f3c3-4a43-80e6-30873c15a4e0",
                                                "sense_id": "75a44e03-a2f1-3d2b-b6d4-bea4d8bbf860",
                                                "text": "(Über Yazid I., den zweiten Umayyaden-Kalifen:) Sein Kalifat war durch den Tod von Mohammeds Enkel Husain ibn Ali und den Beginn der Krise gekennzeichnet, die als zweite Fitna bekannt ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
