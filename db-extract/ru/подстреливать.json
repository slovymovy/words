                        "target_lang_word": "bring down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bring down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f97eda8-0bf2-3dd6-a74f-198e632c8981",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see bring, down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caf3fb0a-dd2e-4f02-b643-65edd203dc4b",
                                                "sense_id": "2f97eda8-0bf2-3dd6-a74f-198e632c8981",
                                                "text": "Dad has brought down a stack of old vinyl records from the attic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36c4f646-fb19-33fe-b95d-d850d54fe47c",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To make (a ruler or government) lose their position of power."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf0e102-d319-41d2-b11b-bbd7dc736f6f",
                                                "sense_id": "36c4f646-fb19-33fe-b95d-d850d54fe47c",
                                                "text": "The rebel forces are trying to bring down the president and his government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51ef76b0-5afd-333d-ba2d-8b7ac4f5629f",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To reduce."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07116d68-d3e1-4cab-b97b-7d1d387c3506",
                                                "sense_id": "51ef76b0-5afd-333d-ba2d-8b7ac4f5629f",
                                                "text": "The latest budget reforms are intended to bring down the level of inflation."
                                            },
                                            {
                                                "example_id": "b3b352ef-b78f-4fb6-bd2b-f8d6e826826f",
                                                "sense_id": "51ef76b0-5afd-333d-ba2d-8b7ac4f5629f",
                                                "text": "The causes of income stagnation are varied and lack the political simplicity of calls to bring down the deficit or avert another Wall Street meltdown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27388727-919b-3d06-9069-0dd3bb345d91",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To humble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0700a3a5-2731-32f8-bca1-1efcd13a11c8",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To make (something, especially something flying) fall to the ground, usually by firing a weapon of some kind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6606690-e4c0-48f3-8184-ec0a53723ac6",
                                                "sense_id": "0700a3a5-2731-32f8-bca1-1efcd13a11c8",
                                                "text": "He brought down a pheasant with his first shot of the day."
                                            },
                                            {
                                                "example_id": "8fc84931-4fce-486c-9e96-6b6d107405e5",
                                                "sense_id": "0700a3a5-2731-32f8-bca1-1efcd13a11c8",
                                                "text": "For survival off-the-grid, one should have a gun that can bring down most animals without damaging their meat."
                                            },
                                            {
                                                "example_id": "fd1c4b27-6cee-4b64-a1d7-ab62350d7ec0",
                                                "sense_id": "0700a3a5-2731-32f8-bca1-1efcd13a11c8",
                                                "text": "Quinn raised the gun again, wondering if there was anything she could shoot that would buy her more time. Bring down the electric lines overhead? No way could she make a shot like that. Place a call and toss her cellphone at the thing? Not enough time. She substituted the strobe light again, and the ghostlem swatted it out of her hand. She spun, catching herself on the asphalt with stinging fingers, and waited to be jellified from behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8706ccee-d43d-3c3c-a529-0b9807f1de06",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To cause (an opponent) to fall after a tackle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11dbd320-9879-4efe-93d8-1dbac6eb1fa7",
                                                "sense_id": "8706ccee-d43d-3c3c-a529-0b9807f1de06",
                                                "text": "Kalinic later saw red for a rash tackle on Paul Scharner before Gabriel Tamas was dismissed for bringing down Diouf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a33f9c59-0d8a-3731-9f14-2878733b41b5",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To make (someone) feel bad emotionally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "270457dd-6303-4302-8aca-0cc615db9a52",
                                                "sense_id": "a33f9c59-0d8a-3731-9f14-2878733b41b5",
                                                "text": "The news of his death brought her down."
                                            },
                                            {
                                                "example_id": "9e06b15f-03e7-4340-a23d-05d43ea8a387",
                                                "sense_id": "a33f9c59-0d8a-3731-9f14-2878733b41b5",
                                                "text": "I went to a shrink, to analyze my dreams / He said it's lack of sex that's bringing me down"
                                            },
                                            {
                                                "example_id": "fabffec9-6f19-4338-8311-bda17930e597",
                                                "sense_id": "a33f9c59-0d8a-3731-9f14-2878733b41b5",
                                                "text": "Nothing in this world could / Ever bring them down / Yeah, they're invincible / And she's just in the background"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e19147e-c838-350a-95fb-864ecc0753da",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To cause to fall down, e.g. in an accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "873d94d7-a641-462a-9098-35e790078ca7",
                                                "sense_id": "4e19147e-c838-350a-95fb-864ecc0753da",
                                                "text": "From the evidence of witnesses and of the recorded passing times, including the time at which the circuit breakers were tripped when the wires were brought down, the train was travelling at a speed of not less than 70 m.p.h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f52c35-fec3-3e26-a8a9-7465159c2018",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To take (someone) to prison."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fef283a-2042-3032-920f-e9d9d3a03675",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To receive a prison sentence."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79214406-b738-47cf-af96-958062e2a732",
                                                "sense_id": "5fef283a-2042-3032-920f-e9d9d3a03675",
                                                "text": "She brought down a five-year bid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0918343d-47aa-3c7b-90c8-2a59f6335700",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To incite excitement in (a place or crowd)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0daaa7a-0c23-4663-a017-e719eacafbed",
                                                "sense_id": "0918343d-47aa-3c7b-90c8-2a59f6335700",
                                                "text": "He brought down the club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5782f5b7-7e5c-3487-9981-81d8bcf7224c",
                                        "entry_id": "43553c8f-53d1-3404-8a26-4bd26458ecc3",
                                        "glosses": [
                                            "To calm down (someone)."
                                        ],
