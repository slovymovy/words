                "senses": [
                    {
                        "sense_id": "525b702c-1b5d-3d00-8504-e303073bf811",
                        "entry_id": "563c22e8-e9e1-3121-a85a-a336f7ef5863",
                        "glosses": [
                            "Qui est hostile, opposé aux Noirs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0671411-6859-402b-9b69-b6d915033a8a",
                                "sense_id": "525b702c-1b5d-3d00-8504-e303073bf811",
                                "text": "Racisme antijuif, racisme antinoir, racisme antiblanc, le racisme, qu’il soit individuel ou collectif, inavoué ou flagrant, est l’un des grands maux dont souffrent bien des êtres dans le monde d’aujourd'hui."
                            },
                            {
                                "example_id": "b4346a6b-54b4-465e-97f7-9c666976f111",
                                "sense_id": "525b702c-1b5d-3d00-8504-e303073bf811",
                                "text": "Quand certains affirment qu’elle pratique le racisme « antinoir » lorsqu’elle s’attaque aux armes à feu à Montréal, cela relève de la calomnie."
                            }
                        ]
                    }
                ],
