    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bbd44470-9dcf-3aac-a282-b8916d29b538",
                    "sense_definition": "Qualifie une voix devenue rauque, altérée ou usée par la fatigue, la maladie ou l'émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir crié pendant tout le concert, il avait la voix complètement <w>éraillée</w>."
                        },
                        {
                            "text": "Le vieil homme répondit d'un ton <w>éraillé</w> qui trahissait son immense fatigue."
                        }
                    ],
                    "synonyms": [
                        "cassé",
                        "enroué",
                        "rauque"
                    ],
                    "antonyms": [
                        "clair",
                        "limpide"
                    ],
                    "common_phrases": [
                        "voix éraillée",
                        "ton éraillé"
                    ]
                },
                {
                    "sense_id": "6db6ef01-01a5-3c3f-beec-030b6443935a",
                    "sense_definition": "Dont les fils sont détendus, séparés ou usés, en parlant d'une étoffe ou d'un tissu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "materiau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce rideau ancien est tellement <w>éraillé</w> qu'il risque de se déchirer au premier coup de vent."
                        },
                        {
                            "text": "Elle portait une robe en soie entièrement <w>éraillée</w> au niveau des coutures."
                        }
                    ],
                    "synonyms": [
                        "effiloché",
                        "élimé",
                        "usé"
                    ],
                    "antonyms": [
                        "intact",
                        "neuf"
                    ],
                    "common_phrases": [
                        "soie éraillée",
                        "tissu éraillé"
                    ]
                },
                {
                    "sense_id": "7dd7fa37-1512-3040-9f9e-5d49ce5c542a",
                    "sense_definition": "Qui est injecté de sang ou bordé de rougeur, en parlant du regard ou des paupières.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses yeux <w>éraillés</w> montraient qu'il venait de passer une longue nuit sans fermer l'œil."
                        },
                        {
                            "text": "Le vent glacial et la fumée lui ont laissé un œil particulièrement douloureux et <w>éraillé</w>."
                        }
                    ],
                    "synonyms": [
                        "injecté",
                        "rougi"
                    ],
                    "common_phrases": [
                        "yeux éraillés"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99b71d57-7a72-369b-a11a-cb4c782d73f2",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>érailler</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat a <w>éraillé</w> le tissu précieux du fauteuil avec ses griffes acérées."
                        },
                        {
                            "text": "Le froid persistant a <w>éraillé</w> les cordes vocales du comédien avant la générale."
                        }
                    ]
                }
            ]
