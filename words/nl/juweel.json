                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gem",
                                "target_lang_sense_clarification": "a highly valued person or thing"
                            },
                            {
                                "target_lang_word": "jewel",
                                "target_lang_sense_clarification": "the finest or most valuable part"
                            },
                            {
                                "target_lang_word": "treasure",
