                                        "entry_id": "862e8733-5a77-39bc-9a5e-00f22f27be7c",
                                        "glosses": [
                                            "The objective study of nature in the widest sense; science or the protoscience that led to it; (later especially) physics."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e1a676-a9c2-4f13-956c-0065c80e938d",
                                                "sense_id": "2b946ba3-720c-3ca5-87b6-ac01f5bdbf31",
                                                "text": "Those who have treated of natural philoſophy, may be nearly reduced to three claſſes."
                                            },
                                            {
                                                "example_id": "8d452e85-8edd-49ff-84a9-67b05b193e4e",
                                                "sense_id": "2b946ba3-720c-3ca5-87b6-ac01f5bdbf31",
                                                "text": "Next to Mathematics, the study of natural philosophy tends to have anti-aphrodisiac effects."
                                            },
                                            {
                                                "example_id": "1552438b-1236-4437-9098-a062a1ba103b",
                                                "sense_id": "2b946ba3-720c-3ca5-87b6-ac01f5bdbf31",
                                                "text": "The discipline which is the ancestor of modern specializations like astronomy, biology, physics and chemistry was then called natural philosophy."
                                            }
                                        ]
                                    }
                                ]
                            }
