                            {
                                "example_id": "ca3321f7-7d93-4da2-bdfa-abb2c23cbcf8",
                                "sense_id": "0f39909b-2661-3047-b15a-fd8e2693b56f",
                                "text": "De ozonlaag beschermt de aarde tegen schadelijke ultraviolette straling.",
                                "translation": "The ozone layer protects the earth from harmful ultraviolet radiation.",
                                "english": "The ozone layer protects the earth from harmful ultraviolet radiation."
                            },
                            {
                                "example_id": "ddf5a737-ca91-43fb-bb98-66631e81d103",
                                "sense_id": "0f39909b-2661-3047-b15a-fd8e2693b56f",
                                "text": "Er is een gat in de ozonlaag boven Antarctica.",
                                "translation": "There's a hole in the ozone layer above Antarctica.",
                                "english": "There's a hole in the ozone layer above Antarctica."
                            },
                            {
                                "example_id": "5efd5fc9-09b6-4d18-bc3d-4a10e92f40f9",
                                "sense_id": "0f39909b-2661-3047-b15a-fd8e2693b56f",
                                "text": "Het ozonlaagje herstelt zich langzaam door internationale overeenkomsten.",
                                "translation": "The thin ozone layer is slowly recovering due to international agreements.",
                                "english": "The thin ozone layer is slowly recovering due to international agreements."
                            }
                        ]
