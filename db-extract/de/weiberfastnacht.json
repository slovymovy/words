                        "entry_id": "6654d241-a69a-3b16-8678-8f8bb7671397",
                        "glosses": [
                            "rheinischer Ausdruck für den Donnerstag vor Rosenmontag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13226609-be1b-44f2-9292-3e6a7b51ff82",
                                "sense_id": "c5a3d13a-2fd9-379e-9b40-303a3d4dcbdf",
                                "text": "An Weiberfastnacht findet der Wiener Opernball statt."
                            },
                            {
                                "example_id": "fa717d92-e514-4a5a-b83f-00c884c14df1",
                                "sense_id": "c5a3d13a-2fd9-379e-9b40-303a3d4dcbdf",
                                "text": "„An Weiberfastnacht kam Papa schlechtgelaunt nachhause.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80d53fdf-9749-3357-9107-cbe567850a4b",
                        "entry_id": "6654d241-a69a-3b16-8678-8f8bb7671397",
                        "glosses": [
                            "die Bräuche an diesem Tag, bei denen die Frauen symbolisch die Macht im Rheinland für die Zeit des Straßenkarnevals übernehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0298ce2-4b16-468e-866b-c27ace5099b4",
                                "sense_id": "80d53fdf-9749-3357-9107-cbe567850a4b",
                                "text": "Heut ist Weiberfastnacht, da kann ich meinen alten Schlips entsorgen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
