                "senses": [
                    {
                        "sense_id": "0e0f2ebc-e786-3ffe-8011-d32923823bf9",
                        "entry_id": "ef1f0574-b2d6-3b74-ad64-39069f18730c",
                        "glosses": [
                            "afbeelding van een verzameling gegevens in een plaatje dat een indruk geeft van hoeveelheden of verschillen daarin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5223bd8-5edb-4778-bfed-a1e9df4b5670",
                                "sense_id": "0e0f2ebc-e786-3ffe-8011-d32923823bf9",
                                "text": "Kan je de gevonden meetwaarden even in een grafiek zetten?"
                            },
                            {
                                "example_id": "556c45ca-3e72-416b-b5cb-0736c6543a56",
                                "sense_id": "0e0f2ebc-e786-3ffe-8011-d32923823bf9",
                                "text": "Nergens ter wereld hebben leerlingen een grotere hekel aan lezen en schrijven dan in Nederland. (…) De curves wijzen bij elk onderzoek weer steil omlaag, nog even en ze raken de bodem van de grafiek. Je kunt erover blijven schrijven, dat van een gemiddelde basisschoolklas met vijfentwintig leerlingen er zes ondermaats lezen en schrijven, en dat een kwart van onze vijftienjarigen laaggeletterd is."
                            }
                        ]
                    },
                    {
                        "sense_id": "508b3749-e6a9-304b-91dc-8365d3a24d01",
                        "entry_id": "ef1f0574-b2d6-3b74-ad64-39069f18730c",
                        "glosses": [
                            "afbeeldingen die afzonderlijk met een drukpers worden vermenigvuldigd"
                        ],
                        "tags": [
                            "vervaardiging van"
                        ],
                        "examples": [
                            {
                                "example_id": "1e2a5821-9244-485c-9e16-edc38f31aca2",
                                "sense_id": "508b3749-e6a9-304b-91dc-8365d3a24d01",
                                "text": "Deze galerie specialiseert zich in grafiek."
                            },
                            {
                                "example_id": "b97a0ef7-0b47-4449-ac9d-f0858d5c714a",
                                "sense_id": "508b3749-e6a9-304b-91dc-8365d3a24d01",
                                "text": "Francisco Goya (1746-1828) adverteerde zijn albums met etsen in de krant, maar de \"Desastres della Guerra\" heeft hij alleen in kleine kring verspreid en verkocht. Omdat de markt voor grafiek niet ideaal was en wellicht ook omdat hij ze met hun heftige thematiek niet geschikt vond voor blootstelling aan het grote publiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28f41f6d-3425-4ab1-88c6-ed3e2d59ca26",
                        "source_entry_id": "ef1f0574-b2d6-3b74-ad64-39069f18730c",
