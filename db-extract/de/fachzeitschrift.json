                "senses": [
                    {
                        "sense_id": "5f0328b7-9c25-3369-a4ce-c49194f98213",
                        "entry_id": "9562e8c8-1aa9-3dc5-99fd-d41a538b6479",
                        "glosses": [
                            "Zeitschrift, in der Fachthemen behandelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94518720-572d-4ac8-a97d-80fc6a466fad",
                                "sense_id": "5f0328b7-9c25-3369-a4ce-c49194f98213",
                                "text": "Er zitierte in seiner Hausarbeit aus einer Fachzeitschrift."
                            },
                            {
                                "example_id": "bdec8858-752b-47b2-bebc-390cb5c6ffcf",
                                "sense_id": "5f0328b7-9c25-3369-a4ce-c49194f98213",
                                "text": "„Sein Aufsatz und Darwins »Abrisse« würden ganz gerecht Seite an Seite in der renommierten Fachzeitschrift abgedruckt werden.“"
                            },
                            {
                                "example_id": "81bb6f50-fb2c-424a-b9f9-d051fcb9a961",
                                "sense_id": "5f0328b7-9c25-3369-a4ce-c49194f98213",
                                "text": "„Das Rüstzeug holte er sich aus alten Fachzeitschriften seit den Anfängen der Philatelie, dazu der bisherigen Fachliteratur.“"
                            },
                            {
                                "example_id": "95db500b-592c-4eed-ae58-0d72236b3d72",
                                "sense_id": "5f0328b7-9c25-3369-a4ce-c49194f98213",
                                "text": "„Diese Ansicht vertrat in einer Fachzeitschrift die britische Ärztin Dr. Ann Mullins.“"
                            },
                            {
                                "example_id": "cd1b886d-1c1a-47e9-9a7c-7e4c4a07110d",
                                "sense_id": "5f0328b7-9c25-3369-a4ce-c49194f98213",
                                "text": "„Ich zitierte jetzt aus einem Artikel, den ich in einer französischen Fachzeitschrift über diese Krankheit gelesen hatte, während ich im amerikanischen Krankenhaus in Neuilly darauf wartete, dass man mir die Kehle kauterisierte, erzählte ich ihm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
