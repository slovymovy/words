                    {
                        "sense_id": "a44a4b48-dc7e-34f6-be16-e9272e8e111d",
                        "entry_id": "c474c46f-93d9-386e-9161-4cd92b1afcfa",
                        "glosses": [
                            "weapon of war, military weapon (weapon produced for warfare and military conflict)"
                        ],
                        "tags": [
                            "countable",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "85072dea-cb67-4923-ba4a-45b85f542430",
                                "sense_id": "a44a4b48-dc7e-34f6-be16-e9272e8e111d",
                                "text": "[Streumunition] gilt als besonders tückische Kriegswaffe und ist international geächtet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fa9b195-5f72-3d7a-9b30-dd0292281449",
                        "entry_id": "c474c46f-93d9-386e-9161-4cd92b1afcfa",
                        "glosses": [
                            "weapon of war (deliberate causation and use of emergencies in warfare)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "b6689751-52d9-4072-80f7-aa9cb807f989",
                                "sense_id": "2fa9b195-5f72-3d7a-9b30-dd0292281449",
                                "text": "Angesichts der schweren Vorwürfe gegen Israel, seinerseits Hunger im Gazastreifen als Kriegswaffe einzusetzen, sagte der Minister, sein Land lasse große Mengen humanitärer Hilfe für den Gazastreifen zu – und das unter schwierigen Bedingungen."
                            }
                        ]
                    }
