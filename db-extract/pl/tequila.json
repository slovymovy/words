                                "target_senses": [
                                    {
                                        "sense_id": "89d15811-4ec8-3212-80e4-69595765652f",
                                        "entry_id": "ffae017c-0791-30d5-ab26-3aac68984a26",
                                        "glosses": [
                                            "An alcoholic liquor distilled from the fermented juice of the Central American century plant Agave tequilana."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36ef02a9-2dd1-4fe0-8166-239754e0f80b",
                                                "sense_id": "89d15811-4ec8-3212-80e4-69595765652f",
                                                "text": "For a moment the bottle of tequila at the bottom of the garden gleamed on his soul, then the Consul stumbled into his bedroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14fe9e72-4f73-4d95-a44d-af941feb2e3e",
                        "source_entry_id": "f28ab1ef-c28e-37ac-ad6c-d9b8d72cba32",
                        "source_sense_id": "f8ec6b83-9642-3451-b836-28b3798693f2",
                        "target_lang_word": "tequila",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tequila",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                        "entry_id": "7f7a7f64-ef6e-3530-b54d-839976d3f137",
                                        "glosses": [
                                            "Eau-de-vie distillée à partir du jus produit par la plante agave bleu (Agave tequilana F.A.C.Weber var. azul). Spécialité mexicaine produite uniquement dans certaines régions déterminées par la réglementation du pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54938ce2-f5be-4160-b924-122b1dcce4f5",
                                                "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                                "text": "Le célèbre cocktail margarita est préparé avec de la tequila, du Cointreau, du jus de citron vert et du sel."
                                            },
                                            {
                                                "example_id": "2cd1182d-489d-41a5-bc34-2e597982f7e3",
                                                "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                                "text": "A une table près des fenêtres, sur la gauche, trois types, des Mexicains sans doute, font un brin de causette devant un tequila."
                                            },
                                            {
                                                "example_id": "abfa7cd1-b579-4951-a2cc-8fce3b600a60",
                                                "sense_id": "582e6bee-bc82-3362-8931-3f07ada43d92",
                                                "text": "En France, elle n’est considérée que depuis peu comme un alcool de qualité, ce qui est surement dû au fait que jusque dans les années 90, les seules tequilas importées étaient de mauvaise qualité et ne contenaient notamment pas d’agave bleu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae9250cd-61cf-40b9-9c85-eaa4be99defa",
                        "source_entry_id": "f28ab1ef-c28e-37ac-ad6c-d9b8d72cba32",
