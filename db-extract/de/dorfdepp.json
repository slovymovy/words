                                "target_senses": [
                                    {
                                        "sense_id": "2423cf70-2f0c-3199-8c09-8dac89be55ab",
                                        "entry_id": "12d05453-c8dc-3c0e-a0ed-ab5e237022ac",
                                        "glosses": [
                                            "een figuur die bekend staat als een raar persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19484e45-1ec5-4b24-9ee7-428b8fe8ed69",
                                                "sense_id": "2423cf70-2f0c-3199-8c09-8dac89be55ab",
                                                "text": "De kinderen moeten lachen om de dorpsgek, maar ze zijn er ook wel een beetje bang voor."
                                            },
                                            {
                                                "example_id": "e56a1170-bbc4-497f-805e-417980bda69f",
                                                "sense_id": "2423cf70-2f0c-3199-8c09-8dac89be55ab",
                                                "text": "Advocaat Gerard Spong: „Op het eerste gezicht denk je dat je met de dorpsgek te maken hebt, maar hij is allesbehalve dat. Ik heb grote bewondering voor zijn kennis van het recht.”"
                                            }
                                        ]
                                    }
                                ]
                            }
