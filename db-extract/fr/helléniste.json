        "fr-extract.jsonl": [
            {
                "entry_id": "bdc6f505-b22f-3886-b7e7-545a27c42726",
                "word": "helléniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8c15fe8-e9af-4598-a5fb-3995ad595e34",
                        "entry_id": "bdc6f505-b22f-3886-b7e7-545a27c42726",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "hellénistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63a37d35-66c4-3b49-86e3-77924e6cc139",
                        "entry_id": "bdc6f505-b22f-3886-b7e7-545a27c42726",
                        "glosses": [
                            "Personne versée dans la connaissance de la langue, de la littérature et de la culture grecques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d50a2a-5679-4e4e-9a78-f5b6851f6c1c",
                                "sense_id": "63a37d35-66c4-3b49-86e3-77924e6cc139",
                                "text": "Il y a beau temps que le terrain de la tragédie hellénique est revendiqué par les mythologues, les hellénistes et les psychanalystes surtout depuis que ceux-ci, Freud le premier à la fin du siècle dernier, ont essayé de désénigmatiser les mythes en construisant celui du « complexe d’Œdipe »."
                            },
                            {
                                "example_id": "a6a7d82c-8dba-407f-b34f-c7cda54d7620",
                                "sense_id": "63a37d35-66c4-3b49-86e3-77924e6cc139",
                                "text": "Si tous les hellénistes pensaient comme Bracke, et tous les physiciens comme Einstein ou Langevin, ce serait la plus grande révolution que l'on ait vue, et sans autre changement qu'un bon serment à soi sur un millier d'hommes."
                            },
                            {
                                "example_id": "2ccc764c-212b-470b-b621-4885994d80e6",
                                "sense_id": "63a37d35-66c4-3b49-86e3-77924e6cc139",
                                "text": "Il s’agit, pour Andrea Cozzo, de montrer que la « tribu » des antiquisants – lui qui est helléniste ne veut pas faire de distinction entre hellénistes et latinistes – obéit à des règles d’interprétation qui sont celles de notre socialisation disciplinaire […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "41605988-0961-318d-a121-fefb1105cc14",
                        "entry_id": "bdc6f505-b22f-3886-b7e7-545a27c42726",
                        "glosses": [
                            "Quelqu'un des juifs d’Alexandrie, des juifs qui parlaient la langue des Septante, des juifs qui s’accommodaient aux usages des Grecs, ou des Grecs qui embrassaient le judaïsme."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f49446c-ac80-41a1-9da4-519d6a14e1b3",
                        "source_entry_id": "bdc6f505-b22f-3886-b7e7-545a27c42726",
                        "target_lang_word": "Hellenist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hellenist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80674fd2-660c-3d0a-9d49-de5300fa7c2f",
                                        "entry_id": "1340c21b-07dc-39f2-96d2-6dd4cc7e0395",
                                        "glosses": [
                                            "A specialist in the study of Greek language, literature, culture, or history, or an admirer of the Greek culture and civilization."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97dec57b-eae2-3168-857e-08bd42c1c7e5",
                                        "entry_id": "1340c21b-07dc-39f2-96d2-6dd4cc7e0395",
                                        "glosses": [
                                            "A person who adopted the Greek customs, language and culture during the Hellenistic period, especially a Hellenized Jew."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fe3b5c7-37a5-35ad-9831-2600d3fa10b6",
                                        "entry_id": "1340c21b-07dc-39f2-96d2-6dd4cc7e0395",
                                        "glosses": [
                                            "A non-Greek follower and practitioner of Hellenic religion (aka Hellenism)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd2bb659-b341-4a65-a944-b4e01d50f10e",
                        "source_entry_id": "bdc6f505-b22f-3886-b7e7-545a27c42726",
                        "target_lang_word": "helenista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helenista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "770081cc-e215-3d9c-b197-237aee797e43",
                                        "entry_id": "e0f79db8-e60d-309c-90f3-150192ba88cd",
                                        "glosses": [
                                            "Que pertenece o concierne al helenismo (estudio y época clásica de la lengua y la cultura griegas) o a la cultura griega."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0337b42c-5957-40ba-a8c0-7c2ce4e47542",
                                                "sense_id": "770081cc-e215-3d9c-b197-237aee797e43",
                                                "text": "La civilización helenista estaba fundada en una concepción ideal del hombre."
                                            },
                                            {
                                                "example_id": "a31ccffc-4d53-4b58-b54a-1e9913657049",
                                                "sense_id": "770081cc-e215-3d9c-b197-237aee797e43",
                                                "text": "Al hablar de la época helenista pensamos en los siglos que transcurren después de las conquistas de Alejandro hasta el triunfo del cristianismo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "helenista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca33b82-16f5-328a-9202-5aac735af9c8",
                                        "entry_id": "bc72e3c4-a1c4-31cb-b253-a6632feee0f6",
                                        "glosses": [
                                            "Persona que se especializa en el estudio de la lengua y la cultura de la antigua Grecia."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31cf2e2a-ad92-4c60-8124-372345f1f2b6",
                                                "sense_id": "4ca33b82-16f5-328a-9202-5aac735af9c8",
                                                "text": "el gran helenista Enrique Estéfano, autor del insigne Thesaurus linguae graecae."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "814c6d6a-019e-309d-bcfc-cf039bbeb7f9",
                                        "entry_id": "bc72e3c4-a1c4-31cb-b253-a6632feee0f6",
                                        "glosses": [
                                            "Persona que, aunque no tuviera sangre griega, seguía y tomaba la cultura y la lengua griegas. Se aplicó especialmente a los judíos de la diáspora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1faf06d-2445-471b-ab05-e3fd1e32f830",
                                                "sense_id": "814c6d6a-019e-309d-bcfc-cf039bbeb7f9",
                                                "text": "Helenista; judío de Alejandría que hablaba el lenguage de los setenta o que se acomodaba a los usos y costumbres de los griegos."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
