    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d392c081-6fd2-3752-8d5c-6118889a8bff",
                    "sense_definition": "simple past and past participle of <w>feign</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>feigned</w> illness so that he would not have to attend the meeting.",
                            "target_lang_translations": {
                                "ru": "Он <w>симулировал</w> болезнь, чтобы не идти на собрание."
                            }
                        },
                        {
                            "text": "She <w>feigned</w> surprise when they presented the birthday cake, though she already knew.",
                            "target_lang_translations": {
                                "ru": "Она <w>изобразила</w> удивление, когда вынесли праздничный торт, хотя уже обо всём знала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feigned surprise",
                        "feigned ignorance",
                        "feigned indifference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола feign (симулировать, притворяться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворился",
                                "target_lang_sense_clarification": "сделал вид"
                            },
                            {
                                "target_lang_word": "симулировал",
                                "target_lang_sense_clarification": "изобразил болезнь или состояние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ff16877-b433-38e1-b4ff-6cb7bb86c149",
                    "sense_definition": "Pretended, insincere, or simulated rather than genuine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She listened to his excuses with <w>feigned</w> interest, wishing the conversation would end quickly.",
                            "target_lang_translations": {
                                "ru": "Она выслушивала его оправдания с <w>притворным</w> интересом, желая, чтобы этот разговор поскорее закончился."
                            }
                        },
                        {
                            "text": "He accepted the promotion with <w>feigned</w> reluctance to appear modest before his peers.",
                            "target_lang_translations": {
                                "ru": "Он принял повышение с <w>напускной</w> неохотой, чтобы казаться скромным перед коллегами."
                            }
                        }
                    ],
                    "synonyms": [
                        "insincere",
                        "pretended",
                        "simulated",
                        "fake"
                    ],
                    "antonyms": [
                        "genuine",
                        "sincere",
                        "unfeigned"
                    ],
                    "common_phrases": [
                        "feigned interest",
                        "feigned enthusiasm",
                        "feigned reluctance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворный, неискренний или симулированный, ненастоящий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворный",
                                "target_lang_sense_clarification": "фальшивый, разыгранный"
                            },
                            {
                                "target_lang_word": "напускной",
                                "target_lang_sense_clarification": "демонстративный, ненастоящий"
                            },
                            {
                                "target_lang_word": "поддельный",
                                "target_lang_sense_clarification": "неискренний"
                            }
                        ]
                    }
                }
            ]
        }
    ]
