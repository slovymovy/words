                                "example_id": "681cd12d-0789-43a9-914b-41194b5345c0",
                                "sense_id": "9168e38a-2a9c-3f32-9a85-1498833665e3",
                                "text": "Zu Weihnachten basteln wir immer ein Pfefferkuchenhaus."
                            },
                            {
                                "example_id": "b42af9a8-e479-4eaf-b071-4de4facd1da4",
                                "sense_id": "9168e38a-2a9c-3f32-9a85-1498833665e3",
                                "text": "Im Märchen „Hänsel und Gretel“ wohnt die böse Hexe in einem Pfefferkuchenhaus."
                            },
                            {
                                "example_id": "607f4164-0de2-420b-bac3-91253a98179f",
                                "sense_id": "9168e38a-2a9c-3f32-9a85-1498833665e3",
                                "text": "„Hu, hu, da schaut eine alte Hexe raus! Lockte die Kinder ins Pfefferkuchenhaus.“ (Kinderlied)"
                            }
                        ],
