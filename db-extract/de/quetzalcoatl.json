                ],
                "senses": [
                    {
                        "sense_id": "2d464fe4-e1dc-35e6-b644-987198da8345",
                        "entry_id": "0c8087dd-cafd-3657-bc79-d56b6c62b1f6",
                        "glosses": [
                            "mesoamerikanische Gottheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b17ef3f-6a7c-4552-af3d-bd3ea8a6e4c8",
                                "sense_id": "2d464fe4-e1dc-35e6-b644-987198da8345",
                                "text": "„Die Mexica glaubten nicht, ihr Gott Quetzalcoatl wandle unter ihnen, und sie waren auch nicht von einer Marien- oder anderen Heiligenerscheinungen beeindruckt.“"
                            },
                            {
                                "example_id": "0b02b5eb-ee73-4d97-a0c1-97d205b8a2a8",
                                "sense_id": "2d464fe4-e1dc-35e6-b644-987198da8345",
                                "text": "„Insbesondere der Mythos von Quetzalcoatl, dem letzten Priesterkönig der Tolteken, der um 1168 fliehen musste, beeinflusste die Glaubensvorstellungen der Mexica nachhaltig.“"
                            },
                            {
                                "example_id": "fb1226b0-7e48-45eb-935c-0d89950acda9",
                                "sense_id": "2d464fe4-e1dc-35e6-b644-987198da8345",
                                "text": "„Aus leicht deutbaren Hinweisen in Legenden und archäologischen Funden hatte ich geschlossen, dass der große Quetzalcoatl - der gütige Schlangengott der Mexikaner - einen weit älteren, eher unheimlichen Vorläufer gehabt haben musste.“"
                            },
                            {
                                "example_id": "d02680a9-dc20-42bd-b841-2b3955203fe5",
                                "sense_id": "2d464fe4-e1dc-35e6-b644-987198da8345",
                                "text": "„Dieser Kult hatte sich erkennbar auch in neuere Religionen hinübergerettet; man fand seine Spuren bei Quetzalcoatl und anderen Göttern der Mayas, Azteken und Inkas, bei den Idolen der Osterinsel, in den Zeremonialmasken der Polynesier und der Indianer der Nordwestküste, wo die Tentakel und die oktopoide Gestalt Cthulhus wiederkehrten.“"
                            },
                            {
                                "example_id": "2c6df410-7dee-4eaa-8775-39e2b75c9419",
                                "sense_id": "2d464fe4-e1dc-35e6-b644-987198da8345",
                                "text": "„Ab etwa 100 v. Chr. und während der folgenden 1500 Jahre verehrten verschiedene mittelamerikanische Kulturen, unter anderem die Azteken und Maya, eine fliegende Schlange namens Quetzalcoatl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
