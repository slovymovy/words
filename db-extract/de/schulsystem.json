                ],
                "senses": [
                    {
                        "sense_id": "4d1a82aa-5392-343d-a15d-d4d93b6da1c3",
                        "entry_id": "9862bc3d-ecdb-3ba6-99ed-4fe5c697c6cd",
                        "glosses": [
                            "Zuordnung verschiedener Schulen mit unterschiedlichen Schulabschlüssen zueinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf1236a4-1a5b-4e3c-903c-ee54792a3fe0",
                                "sense_id": "4d1a82aa-5392-343d-a15d-d4d93b6da1c3",
                                "text": "„Das deutsche Schulsystem wird seit der Pisastudie immer wieder kritisiert.“"
                            },
                            {
                                "example_id": "d133d656-aca4-408b-af5f-bcfadcbbe38a",
                                "sense_id": "4d1a82aa-5392-343d-a15d-d4d93b6da1c3",
                                "text": "„Erst das französische Schulsystem hat Camus den Weg aus der Enge der Armut in die Welt der Kultur eröffnet.“"
                            },
                            {
                                "example_id": "1fb905b8-ee03-4eba-aab8-24a8b87a59dc",
                                "sense_id": "4d1a82aa-5392-343d-a15d-d4d93b6da1c3",
                                "text": "„Das dreigliedrige Schulsystem, in dem auf die Grundschule entweder Hauptschule, Realschule oder Gymnasium folgt, wurde in Finnland Anfang der 1970er Jahre aufgegeben.“"
                            },
                            {
                                "example_id": "ae8bd09c-e909-4a6b-9bc2-c4d29c787134",
                                "sense_id": "4d1a82aa-5392-343d-a15d-d4d93b6da1c3",
                                "text": "Bedenkt man, dass jetzt schon allenthalben über marode Schulen, zu große Klassen und zu viel Unterrichtsausfall geklagt wird, kommen [bei drastisch steigenden Schülerzahlen] auf das deutsche Schulsystem riesige Aufgaben zu."
                            },
                            {
                                "example_id": "eef77917-dfdf-46c0-92f3-2344e2a235e8",
                                "sense_id": "4d1a82aa-5392-343d-a15d-d4d93b6da1c3",
                                "text": "Der Anteil der Jugendlichen, die das Schulsystem in Deutschland ohne Abschluss verlassen, ist zuletzt wieder gestiegen: von 5,9 (2016) auf 6,5 Prozent (2017)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
