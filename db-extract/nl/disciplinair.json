                                                "sense_id": "b4de79c7-748a-351b-be96-b7eb6f12b5e6",
                                                "text": "Mesure disciplinaire."
                                            },
                                            {
                                                "example_id": "de064064-826e-4e4c-bbee-b301ea381cd9",
                                                "sense_id": "b4de79c7-748a-351b-be96-b7eb6f12b5e6",
                                                "text": "S'ils se présentent comme des instruments libéraux, respectueux de l'autonomie des acteurs et de leurs initiatives, ces instruments font l'objet d’analyses critiques qui en soulignent les effets disciplinaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d39f12e7-8a57-3926-8a07-a95223327939",
                                        "entry_id": "424435a6-2f93-33bb-a93a-5e9881240982",
                                        "glosses": [
                                            "Qualifie une peine appliquée aux membres d’un corps pour une faute contre la discipline."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "disciplinaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3c3340-e95e-3597-a894-ddb0ef0a86bd",
                                        "entry_id": "b5a82c37-42b1-3eb2-bfb7-692fb6ac07d6",
                                        "glosses": [
                                            "Soldat qui fait partie des compagnies de discipline."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd5bfe8d-3596-4ad3-b1de-ad963b27a896",
                                                "sense_id": "5a3c3340-e95e-3597-a894-ddb0ef0a86bd",
                                                "text": "Une compagnie de disciplinaires."
                                            },
                                            {
                                                "example_id": "ffec72a8-e88a-48da-9e53-8505e2ca99ec",
                                                "sense_id": "5a3c3340-e95e-3597-a894-ddb0ef0a86bd",
                                                "text": "Ce meurtre paraissait avoir aggravé le silence, loin de le troubler, et le vieux disciplinaire ayant couché sa proie tiède le long du mur, aussi loin que possible de la porte, s’était replié rapidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b677869f-4867-35ae-9622-14f6ed9b538f",
                                        "entry_id": "b5a82c37-42b1-3eb2-bfb7-692fb6ac07d6",
                                        "glosses": [
                                            "Celui qui sait faire régner la discipline parmi ceux qu’il dirige."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dc185b5-33ed-414f-a3dd-711cfe2449ff",
                                                "sense_id": "b677869f-4867-35ae-9622-14f6ed9b538f",
                                                "text": "Ça sent le manque de respect à plein nez et les disciplinaires de la LNH ne semblent pas s’acclimater au nouveau hockey, celui qui donne préséance à la vitesse, à l’habileté, au talent."
                                            },
                                            {
                                                "example_id": "7d7f48db-235f-4d7c-9db0-5c29a71605bf",
                                                "sense_id": "b677869f-4867-35ae-9622-14f6ed9b538f",
                                                "text": "Ce contremaître est un excellent disciplinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68baaa67-e14b-3635-ab86-e20e7d97d376",
                                        "entry_id": "b5a82c37-42b1-3eb2-bfb7-692fb6ac07d6",
                                        "glosses": [
                                            "Écolier faisant l'objet d'une punition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4356bb45-02a3-471d-a658-e9b037dab5a3",
                                                "sense_id": "68baaa67-e14b-3635-ab86-e20e7d97d376",
                                                "text": "Il ne reste plus qu’un banc, à l’écart, où siègent mélangés une demi-douzaine de personnages d’âges différents, ce sont les disciplinaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
