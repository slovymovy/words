                                                "example_id": "d431b073-14e7-4499-89a5-d3c66c79a7f6",
                                                "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                                "text": "Cette école est le sésame vers la réussite."
                                            },
                                            {
                                                "example_id": "ecfb3eb8-dfec-4d6e-8bf1-3ce0e58cd6f0",
                                                "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                                "text": "Classes préparatoires : l’indispensable sésame pour les grandes écoles !"
                                            },
                                            {
                                                "example_id": "2cc6b9cb-fa85-4c8a-ac29-fc3fd35a5f03",
                                                "sense_id": "7c158a0c-27ea-3e55-b437-91717530525b",
                                                "text": "Avoir un animal reproducteur n’est pas suffisant. Seule la détention de la femelle peut donner le sésame."
                                            }
                                        ]
                                    }
                                ]
                            }
