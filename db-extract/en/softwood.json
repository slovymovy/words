                "senses": [
                    {
                        "sense_id": "fb9966a2-b63d-3aca-a917-35c94cbaa786",
                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                        "glosses": [
                            "The wood from any gymnosperm, without regard to how soft this wood is."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7d72bd7-262f-4c31-b123-0936f442e28b",
                                "sense_id": "fb9966a2-b63d-3aca-a917-35c94cbaa786",
                                "text": "The bodies are sheeted in softwood, a double layer of ⅝-in. boards on the quarters, with a single thickness lining inside the steel ends."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6948446-9c79-3e45-9890-151a4af6260e",
                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                        "glosses": [
                            "Wood of this kind, but limited to those that are commercial timbers."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                        "glosses": [
                            "The tree or tree species that yields this wood."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc8e719e-f8f4-41db-b2b7-2892a3eb3d83",
                                "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                                "text": "SYP is a softwood, but it is harder than many hardwoods."
                            },
                            {
                                "example_id": "1e233252-f040-437f-947c-cbed1fb59da3",
                                "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                                "text": "This softwood has been planted extensively throughout Scotland."
                            }
                        ]
                    },
                    {
                        "sense_id": "63007bc8-2544-339f-8883-47946abe3e1f",
                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                        "glosses": [
                            "Any commercial timber."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "37a9344b-d1ad-4eae-ac80-97baaf01dcb5",
                                "sense_id": "63007bc8-2544-339f-8883-47946abe3e1f",
                                "text": "You should have used softwood for the frame of this shed, instead of overbuilding it like this."
                            }
                        ]
                    }
