                    {
                        "translation_id": "41dbd62f-010c-4704-8360-e3421110d3c7",
                        "source_entry_id": "2cc9f341-f840-381e-8a42-e8f1ab88c29d",
                        "source_sense_id": "bb810409-a473-3815-bf46-965b6b73fd17",
