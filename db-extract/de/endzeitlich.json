                ],
                "senses": [
                    {
                        "sense_id": "20fea64d-c3b8-3218-8e31-641f523604bc",
                        "entry_id": "a7641090-e8f7-3676-8661-650bc9995eab",
                        "glosses": [
                            "sich in der Endzeit ereignend, in Bezug auf die Endzeit (das Ende eines Zeitraums, eines Zeitalters, der Herrschaft, der Existenz von etwas)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6343bd10-592e-43f5-9e05-d98d2cc43925",
                                "sense_id": "20fea64d-c3b8-3218-8e31-641f523604bc",
                                "text": "„Er nimmt damit auf die von den Propheten wie von Jesus verheißene endzeitliche Sammlung der Völker auf dem Sion und den dann heraufziehenden universalen Frieden (shalom) Bezug.“"
                            },
                            {
                                "example_id": "0ba6087b-b686-4fd8-8d37-7b69732d5304",
                                "sense_id": "20fea64d-c3b8-3218-8e31-641f523604bc",
                                "text": "„[…] Das endzeitliche Bewußtsein war nicht nur wegen Atomangst und Waldsterben ein Wesenszug der achtziger Jahre.“"
                            },
                            {
                                "example_id": "fb8f7026-d9c7-4335-b82e-d9b0fb759d86",
                                "sense_id": "20fea64d-c3b8-3218-8e31-641f523604bc",
                                "text": "„Snyder will vor der Wirkmächtigkeit endzeitlicher Untergangsvisionen in der Politik warnen und liefert selbst eine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
