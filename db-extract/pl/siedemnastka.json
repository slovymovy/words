                "senses": [
                    {
                        "sense_id": "502a6048-e61a-3365-8710-0b3b637747ac",
                        "entry_id": "4ab82719-ce51-3bbb-b4fb-7e1c5c689f09",
                        "glosses": [
                            "nazwa liczby 17"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e48fa4-b136-4ebb-a2fe-3f70c8867ba3",
                                "sense_id": "502a6048-e61a-3365-8710-0b3b637747ac",
                                "text": "Siedemnastka to moja szczęśliwa liczba."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "78fea353-6851-3953-a468-d3322808e3e3",
                        "entry_id": "4ab82719-ce51-3bbb-b4fb-7e1c5c689f09",
                        "glosses": [
                            "coś, co oznaczone jest liczbą 17"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c66c724-9024-4f5e-85a4-c5d9f1199656",
                                "sense_id": "78fea353-6851-3953-a468-d3322808e3e3",
                                "text": "Długo czekałem na tramwaj. W końcu przyjechała siedemnastka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "497c0f37-56dd-3394-8a89-cbb3108d5cdc",
                        "entry_id": "4ab82719-ce51-3bbb-b4fb-7e1c5c689f09",
                        "glosses": [
                            "całość składająca się z siedemastu części, elementów lub jednostek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e2a2d0-1707-4218-8f13-06d38bfced0a",
                                "sense_id": "497c0f37-56dd-3394-8a89-cbb3108d5cdc",
                                "text": "Ekipa liczyła siedemnastu ludzi. Cała siedemnastka wyruszyła w góry na wycieczkę."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "42ed0f41-3411-3b85-aa46-b7d5dedfeaa5",
                        "entry_id": "4ab82719-ce51-3bbb-b4fb-7e1c5c689f09",
                        "glosses": [
                            "dziewczyna w wieku 17 lat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "114c0d1c-979a-4466-bca3-3271d0cfef8e",
                                "sense_id": "42ed0f41-3411-3b85-aa46-b7d5dedfeaa5",
                                "text": "Marcin zawsze wolał dojrzalsze kobiety, ale wczoraj widziałem go z jakąś siedemnastką."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
