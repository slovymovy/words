        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "37b0edf4-43d1-3da8-8621-89918c229832",
                "word": "mizzle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91e5dad3-0d18-32ca-b578-300d87768f69",
                        "entry_id": "37b0edf4-43d1-3da8-8621-89918c229832",
                        "glosses": [
                            "Misty rain; drizzle."
                        ],
                        "tags": [
                            "British",
                            "dialectal",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "abb7157a-ee5f-383a-bb69-e748eb14eb0a",
                        "entry_id": "37b0edf4-43d1-3da8-8621-89918c229832",
                        "glosses": [
                            "A mist; a fine spray; a spattering."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d60a69c8-69f4-411b-b7f4-f12d3e29daf9",
                                "sense_id": "abb7157a-ee5f-383a-bb69-e748eb14eb0a",
                                "text": "But he knows he need never be in dread\nof your blade making a mizzle of his blood\nor of vengeance arriving ever from this quarter[.]"
                            },
                            {
                                "example_id": "b77965e4-3ee3-4bad-baea-155c287afd3c",
                                "sense_id": "abb7157a-ee5f-383a-bb69-e748eb14eb0a",
                                "text": "When a gawping Byzantine head bounced past his feet, and a mizzle of blood settled upon him, something changed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6873268a-e047-451f-8f77-9caa582c6189",
                        "source_entry_id": "37b0edf4-43d1-3da8-8621-89918c229832",
                        "source_sense_description": "misty rain",
                        "target_lang_word": "pioggerellina",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "58268fe0-8cbc-45ad-929d-b655c4cd79fa",
                        "source_entry_id": "37b0edf4-43d1-3da8-8621-89918c229832",
                        "source_sense_description": "misty rain",
                        "target_lang_word": "и́зморось",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "и́зморось",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e3689777-bb41-3437-ac45-a4915e7a0b98",
                                        "entry_id": "7badff5d-cc62-3aca-9dfe-eb7c56190390",
                                        "glosses": [
                                            "очень мелкий, моросящий дождь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3eaa45-5f25-436f-a743-efccf91a736e",
                                                "sense_id": "e3689777-bb41-3437-ac45-a4915e7a0b98",
                                                "text": "День был пасмурный, начиналась изморось…"
                                            },
                                            {
                                                "example_id": "01e1ec25-5d30-405e-9897-45a46f7711ea",
                                                "sense_id": "e3689777-bb41-3437-ac45-a4915e7a0b98",
                                                "text": "Конечно, наши сентябрьские вечера, особливо под конец месяца, не то чтоб пленяли особенною приятностью; конечно, и изморось грустная, мелкая и холодная дребезжит в окно; конечно, и город представляет неприятный вид с поднятыми шинелями пешеходов, с их зонтиками, калошами и прочим дрязгом…"
                                            },
                                            {
                                                "example_id": "14633018-03d3-41c3-93e3-3d47f14c6d10",
                                                "sense_id": "e3689777-bb41-3437-ac45-a4915e7a0b98",
                                                "text": "Конденсация пара была так велика, что влага непосредственно из воздуха оседала на землю мелкой изморосью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
