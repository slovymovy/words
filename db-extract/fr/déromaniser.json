                "senses": [
                    {
                        "sense_id": "0ca153c3-2e69-343a-9695-249788be2ed8",
                        "entry_id": "6edbe8c0-998a-3f84-a99e-7fb8a9a7904e",
                        "glosses": [
                            "Faire perdre son caractère roman à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b01b25d-e902-4759-850e-1ca16dc3f4bd",
                                "sense_id": "0ca153c3-2e69-343a-9695-249788be2ed8",
                                "text": "Puis, vous aviez écrit en 1843 et publié en 1846 un système à vous d'histoire naturelle des langues romanes à l'effet de les déromaniser."
                            }
                        ]
                    },
                    {
                        "sense_id": "595aef66-d87c-37a7-b744-5c8ad41b2c9d",
                        "entry_id": "6edbe8c0-998a-3f84-a99e-7fb8a9a7904e",
                        "glosses": [
                            "Faire perdre son caractère romain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e466465-20b2-457c-b3a1-3b542dff8cb8",
                                "sense_id": "595aef66-d87c-37a7-b744-5c8ad41b2c9d",
                                "text": "Le corpus dionysien vient donc étayer ici une démonstration qui vise à déromaniser la messe pour retrouver une messe primitive proche de la cène réformée."
                            },
                            {
                                "example_id": "637b1d24-bb41-40f8-a335-ebd31e360acb",
                                "sense_id": "595aef66-d87c-37a7-b744-5c8ad41b2c9d",
                                "text": "Les Vandales n'ont donc pas seulement travaillé à « déromaniser » l'Afrique qu' ils occupaient ; ils l'ont, de surcroît, prédisposée à l'islamisation."
                            }
                        ]
                    }
