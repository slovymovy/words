                                "target_senses": [
                                    {
                                        "sense_id": "3b1df36e-2c9f-3f17-93cf-2c28e32eaa24",
                                        "entry_id": "ece38920-3f9d-3af7-9bef-ce6ed5abc846",
                                        "glosses": [
                                            "ein großes Segelschiff, das zwischen dem 15. und 18. Jahrhundert sowohl als Kriegs- als auch als Handelsschiff eingesetzt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322abcdb-3599-4f62-96a7-3808703f7eb9",
                                                "sense_id": "3b1df36e-2c9f-3f17-93cf-2c28e32eaa24",
                                                "text": "„Mit einem ohrenbetäubenden Knall feuern die Piraten aus ihrer Kanone auf die Galeone. Beide Piratenschiffe sind längsseits der Galeone gefahren.“"
                                            },
                                            {
                                                "example_id": "ac157388-eab4-4ef0-8b8f-0c1ff54408de",
                                                "sense_id": "3b1df36e-2c9f-3f17-93cf-2c28e32eaa24",
                                                "text": "„Mein Exemplar ist von 1926 und zeigt eine spanische Galeone mit vollen Segeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
