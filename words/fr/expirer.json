    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9bc5938-5dd4-3684-9d26-bb79510a482f",
                    "sense_definition": "Arriver à son terme ou cesser d'être valide, en parlant d'un contrat, d'un délai ou d'un document.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fin_validite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon passeport va <w>expirer</w> dans un mois, je dois rapidement faire une demande de renouvellement."
                        },
                        {
                            "text": "Le contrat de location <w>expire</w> à la fin de l'année si aucun préavis n'est envoyé."
                        }
                    ],
                    "common_phrases": [
                        "laisser expirer",
                        "expirer à minuit"
                    ]
                },
                {
                    "sense_id": "13963ac3-9630-3d09-8b33-69e8ddf37b73",
                    "sense_definition": "Rejeter par le nez ou la bouche l'air contenu dans les poumons.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin demande au patient d'<w>expirer</w> lentement pendant qu'il écoute ses poumons."
                        },
                        {
                            "text": "Prenez une grande inspiration puis <w>expirez</w> tout l'air par la bouche."
                        }
                    ],
                    "antonyms": [
                        "aspirer",
                        "inspirer"
                    ],
                    "common_phrases": [
                        "inspirer et expirer",
                        "expirer profondément"
                    ]
                },
                {
                    "sense_id": "8f8d25e9-03cc-3db5-880e-75294801a7f3",
                    "sense_definition": "Rendre le dernier souffle, mourir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme était sur le point d'<w>expirer</w> entouré de toute sa famille."
                        },
                        {
                            "text": "Le blessé grave <w>expira</w> dans l'ambulance avant même d'arriver à l'hôpital."
                        }
                    ],
                    "synonyms": [
                        "rendre son dernier souffle"
                    ],
                    "common_phrases": [
                        "sur le point d'expirer",
                        "expirer paisiblement"
                    ]
                }
            ]
        }
    ]
