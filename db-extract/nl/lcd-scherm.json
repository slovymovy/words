                    {
                        "sense_id": "8009fe37-06ce-3a03-963d-66250b573609",
                        "entry_id": "a08cba44-38d8-39c7-aeb9-8bd64208962b",
                        "glosses": [
                            "een plat beeldscherm waarbij de pixels worden gemaakt d.m.v. vloeibare kristallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad28ea5-a068-4ae4-8aa9-d7ede67630b5",
                                "sense_id": "8009fe37-06ce-3a03-963d-66250b573609",
                                "text": "Lcd is een verkorting van het Engelse liquid-crystal display, waarmee eigenlijk het scherm zelf al wordt aangeduid. Het tweede lid scherm is dus eigenlijk overbodig."
                            },
                            {
                                "example_id": "d8db82c0-14da-41b9-9ae0-5695258856c3",
                                "sense_id": "8009fe37-06ce-3a03-963d-66250b573609",
                                "text": "De hond krijgt ook een, 30 centimeter metend, lcd-scherm om het baasje live te bekijken. Via een microfoontje kan de bestuurder ook tegen zijn hond praten als die nerveus zou zijn. Verder is de hondenruimte achterin bekleed met afneembaar leer voor de makkelijke verwijdering van vuil en haren. De x-Trail 4Dogs lijkt zo ook potentie te hebben voor de kinderen na een dagje ravotten in het bos."
                            }
                        ]
                    }
