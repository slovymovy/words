                "translations": [
                    {
                        "translation_id": "7da172a8-b035-4b50-9bdb-4a351139dd39",
                        "source_entry_id": "43924ff8-c6b8-37f2-939b-1f107f37e642",
                        "source_sense_id": "702e4d5c-840f-3f0e-be97-8ca5dbd56580",
                        "source_sense_description": "gerelateerd aan de middeleeuwen",
                        "target_lang_word": "mittelalterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mittelalterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d90bc24b-0857-3f02-b6f1-a50a73e50796",
                                        "entry_id": "48d4420d-fa3a-370d-bc9a-146d0dd6d881",
                                        "glosses": [
                                            "das Mittelalter betreffend; aus dem Mittelalter stammend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1afe4fc-df56-43e0-89ce-6b84de172c86",
                                                "sense_id": "d90bc24b-0857-3f02-b6f1-a50a73e50796",
                                                "text": "Auf diesem Bild sehen wir ein mittelalterliches Dorffest."
                                            },
                                            {
                                                "example_id": "3bf54bf7-ce7c-4ddf-8f84-99bd3204c6c2",
                                                "sense_id": "d90bc24b-0857-3f02-b6f1-a50a73e50796",
                                                "text": "„In der Stimme des Konservators schwingt echte Anerkennung für den mittelalterlichen Bischof Azelin mit.“"
                                            },
                                            {
                                                "example_id": "5230af2f-ca9d-466b-8951-ad65d96264ec",
                                                "sense_id": "d90bc24b-0857-3f02-b6f1-a50a73e50796",
                                                "text": "„Eine mittelalterliche Chronik berichtet, wie der Fürst in den Städten seines Reiches Gotteshäuser errichten und Gemeinden gründen lässt.“"
                                            },
                                            {
                                                "example_id": "58657740-df36-4d5b-999c-4a2bf2f4cfc2",
                                                "sense_id": "d90bc24b-0857-3f02-b6f1-a50a73e50796",
                                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95a308f5-a27b-3607-b85f-79142a8e0a45",
                                        "entry_id": "48d4420d-fa3a-370d-bc9a-146d0dd6d881",
                                        "glosses": [
                                            "rückständig, nicht zeitgemäß"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd9845e-4a20-47ec-98ed-b725d3d10296",
                                                "sense_id": "95a308f5-a27b-3607-b85f-79142a8e0a45",
                                                "text": "Er hat ein mittelalterliches Frauenbild."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3a702b8-ce1a-4b79-b66b-325a9d7c8697",
                        "source_entry_id": "43924ff8-c6b8-37f2-939b-1f107f37e642",
                        "source_sense_id": "702e4d5c-840f-3f0e-be97-8ca5dbd56580",
                        "source_sense_description": "gerelateerd aan de middeleeuwen",
                        "target_lang_word": "medieval",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medieval",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76832fc8-bd68-35fa-8915-dd92162dd1f6",
                                        "entry_id": "89c1d9b9-5264-34dc-9a97-1adf293d6cd3",
                                        "glosses": [
                                            "Of or relating to the Middle Ages, the period from approximately 500 to 1500 AD."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fcbfa9-1608-43f1-aced-3a03ab8227e0",
                                                "sense_id": "76832fc8-bd68-35fa-8915-dd92162dd1f6",
                                                "text": "The book significantly extends on Rosenstein’s monumental 1990 work, “The Unbroken Chain,” which focused on the genealogies of the major Ashkenazi rabbinic dynasties from medieval times to the present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27705430-3d56-3e16-9584-412d84051fc6",
                                        "entry_id": "89c1d9b9-5264-34dc-9a97-1adf293d6cd3",
                                        "glosses": [
                                            "Having characteristics associated with the Middle Ages in popular, modern cultural perception:",
                                            "Archaic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa458d55-6c6d-3f5c-9b21-4ab35ffaa4a7",
                                        "entry_id": "89c1d9b9-5264-34dc-9a97-1adf293d6cd3",
                                        "glosses": [
                                            "Having characteristics associated with the Middle Ages in popular, modern cultural perception:",
                                            "Brutal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2bb0f51-75ce-401f-83fb-6dcdcb1fd6fc",
                                                "sense_id": "aa458d55-6c6d-3f5c-9b21-4ab35ffaa4a7",
                                                "text": "Brute force can get you into any apartment if you want to get medieval about it."
                                            },
                                            {
                                                "example_id": "e133c21e-d544-44cd-9c62-2b816233a3e1",
                                                "sense_id": "aa458d55-6c6d-3f5c-9b21-4ab35ffaa4a7",
                                                "text": "\"Oh, what a nifty idea,\" Collins said dryly. \"Get a bunch of angry brothers with a blowtorch and some pliers and get medieval on his ass.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "medieval",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65060ff9-b58e-37ee-b59c-c0d81c6740d9",
                                        "entry_id": "8ba670f8-f271-3dcd-9cf8-f43c7590b9dd",
                                        "glosses": [
                                            "Someone living in the Middle Ages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e0c1bee-49da-331e-a5aa-982f5577b0fe",
                                        "entry_id": "8ba670f8-f271-3dcd-9cf8-f43c7590b9dd",
                                        "glosses": [
                                            "A medieval example (of something aforementioned or understood from context)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8475bf-cfcc-45fe-b8c0-e570ed408e14",
                                                "sense_id": "4e0c1bee-49da-331e-a5aa-982f5577b0fe",
                                                "text": "Thank God for modern remedies: the medievals were often useless or even harmful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f5d9e0e-106d-446a-83a9-19c07a34f3e5",
                        "source_entry_id": "43924ff8-c6b8-37f2-939b-1f107f37e642",
                        "source_sense_id": "702e4d5c-840f-3f0e-be97-8ca5dbd56580",
                        "source_sense_description": "gerelateerd aan de middeleeuwen",
                        "target_lang_word": "médiéval",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médiéval",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                        "entry_id": "65bccbd6-7317-3a55-a5c7-c73ff5683195",
                                        "glosses": [
                                            "Relatif au Moyen Âge."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34fd48af-0d78-4e01-bf0f-f6ab9aa6cdfc",
                                                "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                                "text": "On maintiendra également scrupuleusement la distinction entre « médiéval(e) » et « moyenâgeux(se) », le premier renvoyant à ce qui relève proprement du Moyen Âge et sur quoi travaillent les spécialistes du Moyen Âge (les médiévistes), tandis que le second correspond systématiquement à un jugement de valeur, soit positif (telle « rue moyenâgeuse » signalée par un Office du Tourisme – bref du pittoresque), soit le plus souvent négatif (synonyme de barbare, inculte, tyrannique, anarchique)."
                                            },
                                            {
                                                "example_id": "32ae3a55-5372-4ec2-9411-fdaff7302cdb",
                                                "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                                "text": "Aujourd'hui nous voyons des puissances considérables se coaliser pour essayer de réformer l'économie capitaliste dans le sens médiéval, au moyen de lois."
                                            },
                                            {
                                                "example_id": "46679924-2d80-401c-babc-e60692039919",
                                                "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                                "text": "Le monastère avait donc conservé son église médiévale, qui faisait également office de paroissiale."
                                            },
                                            {
                                                "example_id": "0958921e-3f29-44ec-86d7-af906c9be7e5",
                                                "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                                "text": "Cette interprétation n’empêche pas pour autant d’envisager que ce chemin soit datable aussi de l’époque romaine et qu’il ait été réutilisé à l’époque médiévale."
                                            },
                                            {
                                                "example_id": "5e639e8c-1c65-4407-81f5-bbde131a2e7a",
                                                "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                                "text": "La vie urbaine dépérit et, comme la civilisation islamique médiévale était elle-même essentiellement urbaine et que la richesse matérielle dépendait du commerce, la prospérité déclina."
                                            },
                                            {
                                                "example_id": "1ea531c1-c4c4-420b-a9ed-a1e1e517ddbf",
                                                "sense_id": "627bd8e1-fa14-3d13-b134-93ada4ebdebf",
                                                "text": "Parmi les causes, il convient de mentionner la Grande Peste (1348-1351), sorte de cataclysme hiroshimesque qui a ébranlé tout l’Occident médiéval."
