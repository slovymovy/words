                        "entry_id": "1b0c1721-6858-346f-bffb-3a5b76d70538",
                        "glosses": [
                            "Prime, récompense en nature accordée au capitaine du navire transportant des denrées par l’armateur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1052d136-47cc-42f9-998f-5c461faf420f",
                                "sense_id": "b3816ca9-0da5-38bf-87ef-4443ed6ce799",
                                "text": "Ne seront pas non plus sujets à contribution en avarie grosse : les gages de l'équipage, le primage sur le fret désigné sous le nom de chapeau du capitaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d021250-27a0-3259-b08a-3d758550cd7b",
                        "entry_id": "1b0c1721-6858-346f-bffb-3a5b76d70538",
                        "glosses": [
                            "Production accidentelle et perturbatrice de gouttelettes d’eau dans la vapeur produite par une chaudière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0916a2-9dfb-4e89-a40a-a2b949ff154c",
                                "sense_id": "3d021250-27a0-3259-b08a-3d758550cd7b",
                                "text": "Les quatre ennemis des systèmes de générateurs de vapeur sont les incrustations, la corrosion, l’érosion et le primage."
                            }
                        ]
                    }
                ],
