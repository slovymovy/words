                                    {
                                        "sense_id": "d0d93272-427e-3bbc-a24f-6557a9412e56",
                                        "entry_id": "d1a370c2-f2a1-3fca-ac5e-9f4e91efe246",
                                        "glosses": [
                                            "Qui a accompli sa centième année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175d4100-59da-45ef-b85d-4168c2b70de1",
                                                "sense_id": "d0d93272-427e-3bbc-a24f-6557a9412e56",
                                                "text": "Dans nos futaies les mieux évoluées où les arbres centenaires sont assez fréquents, la strate arbustive est fort réduite […]"
                                            },
                                            {
                                                "example_id": "6418c3ca-06c6-4b80-b0fe-38b2c1fd5716",
                                                "sense_id": "d0d93272-427e-3bbc-a24f-6557a9412e56",
                                                "text": "En vertu de cette loi centenaire, l'État de New York a accordé des permis de port d'armes à ces deux hommes, mais uniquement pour se rendre à des stands de tir ou à la chasse, et non à des fins d'autodéfense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9638182-9c76-36ee-8953-948ca1b741ec",
                                        "entry_id": "d1a370c2-f2a1-3fca-ac5e-9f4e91efe246",
                                        "glosses": [
                                            "Qui remonte à cent ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2f7a17-12d3-4d96-aec2-2f574dd9499a",
                                                "sense_id": "c9638182-9c76-36ee-8953-948ca1b741ec",
                                                "text": "Prescription, possession centenaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "centenaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b04c3fc-256b-3bcf-805d-5a67f5b0bcb6",
                                        "entry_id": "0cf07ef0-7c24-3323-bdc7-6b354a78a307",
                                        "glosses": [
                                            "Personne âgée de cent ans ou plus."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc07abe0-5f79-4b8c-8800-ca9607f0fe81",
                                                "sense_id": "5b04c3fc-256b-3bcf-805d-5a67f5b0bcb6",
                                                "text": "Après avoir quitté ses enfants encore valide, il revenait presque centenaire, cassé, voûté, la physionomie dégradée."
                                            },
                                            {
                                                "example_id": "6e81ac7a-4411-411f-8e77-af50f079e4f6",
                                                "sense_id": "5b04c3fc-256b-3bcf-805d-5a67f5b0bcb6",
                                                "text": "— Je crois que tu as cent quatre ans, Joséphine Balsamo, et rien n’est plus délicieux que le baiser d’une centenaire."
                                            },
                                            {
                                                "example_id": "2f0c25ef-8db1-4917-9e66-07e00afd68d8",
                                                "sense_id": "5b04c3fc-256b-3bcf-805d-5a67f5b0bcb6",
                                                "text": "Dimanche, en présence de personnalités communales et départementales, Saint-Claude-de-Diray, petite commune du Loir-et-Cher, a fêté son centenaire, M. Frédéric Coutin. né le 13 février 1853, à Coulommes-et-Marqueny (Ardennes)."
                                            },
                                            {
                                                "example_id": "cd6b653d-d2e3-4302-a122-1fcd00759516",
                                                "sense_id": "5b04c3fc-256b-3bcf-805d-5a67f5b0bcb6",
                                                "text": "Un centenaire a été tué à coups de hache jeudi dernier dans un quartier résidentiel de Los Angeles en Californie.\n Youseff Mahboublanfard, 102 ans, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "centenaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa03173c-d0b0-3045-ac65-6e86d6f3a175",
                                        "entry_id": "0a7ab6f5-6982-3f2f-b34a-1e497e0d530d",
                                        "glosses": [
                                            "Centième anniversaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7739003a-6f13-49ec-9839-58e3b310b475",
                                                "sense_id": "aa03173c-d0b0-3045-ac65-6e86d6f3a175",
                                                "text": "On a célébré le centenaire de la fondation de l’Institut."
                                            },
                                            {
                                                "example_id": "4cfd11c2-e2cd-433d-9c53-9544f8ac6426",
                                                "sense_id": "aa03173c-d0b0-3045-ac65-6e86d6f3a175",
                                                "text": "Les centenaires des grands hommes semblent faits uniquement pour permettre à leurs pires ennemis de prendre sur eux une suprême revanche, et de les enterrer définitivement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
