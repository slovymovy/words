                "senses": [
                    {
                        "sense_id": "41aa42ee-377f-3336-b68a-cd1de0f46bb7",
                        "entry_id": "c0f656d5-12d7-3a10-90f7-3f529b8b33a9",
                        "glosses": [
                            "Wörterbuch, das vor allem die Bedeutungen der aufgeführten Wörter erklärt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a33c9b1f-5cee-4e40-b15a-74ad0bec813f",
                                "sense_id": "41aa42ee-377f-3336-b68a-cd1de0f46bb7",
                                "text": "In einem deutschen Bedeutungswörterbuch kann man nachschlagen, welche Bedeutungen ein beliebiges Wort, zum Beispiel Pferd, alles haben kann. Andere Informationen wie Silbentrennung oder Wortartangaben können in einem Bedeutungswörterbuch dagegen fehlen."
                            },
                            {
                                "example_id": "4a135218-4cb5-488b-ad31-b1a65ffdadc2",
                                "sense_id": "41aa42ee-377f-3336-b68a-cd1de0f46bb7",
                                "text": "„Halten wir fest, dass sich die Tradition der deutschsprachigen Lexikografie seit dem 17. Jahrhundert auf den Typ des einsprachigen Bedeutungswörterbuchs zu konzentrieren beginnt.“"
                            },
                            {
                                "example_id": "e72dfaf6-9557-49c9-a0ce-6c2cc8d0430c",
                                "sense_id": "41aa42ee-377f-3336-b68a-cd1de0f46bb7",
                                "text": "„Besonders in den letzten Jahren ist die Frage nach der Spezifik von Auswahl- und Kodifikationskriterien in einsprachigen Bedeutungswörterbüchern viel diskutiert worden.“"
                            },
                            {
                                "example_id": "f52e24d1-d71d-4c8a-a500-6525d5eafcee",
                                "sense_id": "41aa42ee-377f-3336-b68a-cd1de0f46bb7",
                                "text": "„Der Rechtschreibduden ist kein Bedeutungswörterbuch; er enthält daher keine ausführlichen Bedeutungsangaben.“"
                            },
                            {
                                "example_id": "5638befb-1837-42c2-8528-c08cbbcf7e49",
                                "sense_id": "41aa42ee-377f-3336-b68a-cd1de0f46bb7",
                                "text": "„Als Resultat wird das Paronymwörterbuch inhaltlich und konzeptionell in wesentlichen Punkten vom traditionellen allgemeinen Bedeutungswörterbuch abweichen und insofern einen neuen Weg beschreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
