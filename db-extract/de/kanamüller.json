                "senses": [
                    {
                        "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                        "entry_id": "839a312a-d9f2-3ae4-b00d-544e9afe1e1a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0ee8b9-a64c-41a0-af6c-eab60125bf1f",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "„Gegenstand der Verhandlung bildet die Anklage gegen den verwittweten Inwohner Joseph Kanamüller von Waldkirchen, wegen Verbrechens der Körperverletzung.“"
                            },
                            {
                                "example_id": "9be3f137-ca70-42b2-a123-35796ea3132c",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Frau Kanamüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "43e98f21-2a4b-4887-b294-8cf66dd00b78",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Herr Kanamüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "21c5862d-ba4d-42a5-81d3-7f82b0b0a2b4",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Die Kanamüllers fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "6d6c3bd4-d41a-429c-908e-d8d64ecc5ea2",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Der Kanamüller trägt nie die Pullover, die die Kanamüller ihm strickt."
                            },
                            {
                                "example_id": "d468d75d-6b2f-455c-b777-9140a9c60b44",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kanamüller kommt, geht der Herr Kanamüller.“"
                            },
                            {
                                "example_id": "dc03b1a9-19d9-4523-b8d2-7ac63824eac0",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Kanamüller kommt und geht."
                            },
                            {
                                "example_id": "9ac6f9b1-7b12-40a1-8471-2a697cc0d6f5",
                                "sense_id": "27f97ea7-b6d1-39a6-a7b2-ee85adaac824",
                                "text": "Kanamüllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
