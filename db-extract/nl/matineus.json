                                "target_senses": [
                                    {
                                        "sense_id": "edfad638-86e3-386d-877a-640f0d0e9a83",
                                        "entry_id": "7e67f5a9-1b24-30f0-9ca5-3cd56e508397",
                                        "glosses": [
                                            "Relatif au matin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1e1138-a32d-4930-833d-07097ce586ce",
                                                "sense_id": "edfad638-86e3-386d-877a-640f0d0e9a83",
                                                "text": "Au réveil, dans les premières blancheurs de l’aube apparaît un fleuve qui tourne sous ses fumées matinales, […]."
                                            },
                                            {
                                                "example_id": "dd4516ec-8114-4203-af54-fd9cc9e3bf72",
                                                "sense_id": "edfad638-86e3-386d-877a-640f0d0e9a83",
                                                "text": "Les fleurs matinales sont les fleurs qui s’ouvrent le matin."
                                            },
                                            {
                                                "example_id": "9f6072bd-e2fc-4777-9ee7-6f7f91010063",
                                                "sense_id": "edfad638-86e3-386d-877a-640f0d0e9a83",
                                                "text": "L’opération de police s’était exécutée si rapidement que le champ de foire, d’ailleurs peu fréquenté à cette heure matinale, avait été à peine ému."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088ea413-f8fb-3bfe-ac90-ff4d7fbbdda8",
                                        "entry_id": "7e67f5a9-1b24-30f0-9ca5-3cd56e508397",
                                        "glosses": [
                                            "Qui s’est levé de bonne heure, ou qui a l’habitude de se lever de bonne heure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c14f581-6fc3-4fa8-aa44-bd5b591afdb3",
                                                "sense_id": "088ea413-f8fb-3bfe-ac90-ff4d7fbbdda8",
                                                "text": "Vous êtes bien matinal aujourd’hui."
                                            },
                                            {
                                                "example_id": "93d79d2f-dd6a-44cc-8624-3df47166c4d0",
                                                "sense_id": "088ea413-f8fb-3bfe-ac90-ff4d7fbbdda8",
                                                "text": "C’est un homme qui n’est guère matinal."
                                            },
                                            {
                                                "example_id": "3f1217e8-e0bf-4903-8ddd-590bf26d89c3",
                                                "sense_id": "088ea413-f8fb-3bfe-ac90-ff4d7fbbdda8",
                                                "text": "Elle n’a jamais été matinale, désormais elle se lève à l’aube pour enseigner trois heures à la fac, déjeuner d’un sandwich dans le train et enchaîner à la Lemmings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matinal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0fea623-89ab-3880-86b6-6df8047ca614",
                                        "entry_id": "2f1e5b5c-dd36-302d-9aca-c4c4557a1ee5",
                                        "glosses": [
                                            "Vent d’est soufflant le matin, l’été , plusieurs jours de suite dans la région du Morvan et du Massif Central."
                                        ],
                                        "tags": [
                                            "Météo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927785fe-a474-43e4-b030-6c16a2d0d3b7",
                                                "sense_id": "d0fea623-89ab-3880-86b6-6df8047ca614",
                                                "text": "[…] mais ce vent qu’on appelle à Lyon le matinal y souffle très rarement."
                                            },
                                            {
                                                "example_id": "1cd5f446-83be-46e0-90d0-29c839ca8731",
                                                "sense_id": "d0fea623-89ab-3880-86b6-6df8047ca614",
                                                "text": "Matinal: Vent d'est du matin qui souffle durant plusieurs jours, particulièrement en été et amène le beau temps dans les montagnes du Morvan et le centre du Massif central en France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
