                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4910db10-6606-38f9-a547-f240bd8b1eea",
                                        "entry_id": "570c0105-1048-3414-8761-339d88c791bb",
                                        "glosses": [
                                            "Relatif au mélodrame, qui ressemble au mélodrame, qui est exagéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddf6f11-635a-4ef2-86da-ca6f957d0b73",
                                                "sense_id": "4910db10-6606-38f9-a547-f240bd8b1eea",
                                                "text": "Scène mélodramatique."
                                            },
                                            {
                                                "example_id": "7b23fda1-4765-4f6a-b1ea-817b0c6ce0ab",
                                                "sense_id": "4910db10-6606-38f9-a547-f240bd8b1eea",
                                                "text": "Gestes mélodramatiques."
                                            },
                                            {
                                                "example_id": "cd2f7be6-223b-480b-a663-22f2b0ab5a7e",
                                                "sense_id": "4910db10-6606-38f9-a547-f240bd8b1eea",
                                                "text": "Voici un film d’une trame solidement mélodramatique."
                                            },
                                            {
                                                "example_id": "2647eab2-818e-40e7-a84b-fdfcbd88dc43",
                                                "sense_id": "4910db10-6606-38f9-a547-f240bd8b1eea",
                                                "text": "Après quoi, elle tourna vivement les talons, lui fouettant le visage de ses longues tresses, et remonta en voiture avec une emphase mélodramatique. — (Daniel Nayeri, Coco et Cloclo, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 297)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
