                        "translation_id": "664c59e8-3b92-474c-9faf-980fb6e93ac1",
                        "source_entry_id": "50f74088-41f7-3b05-9453-67186de0e40e",
                        "source_sense_id": "38717fa6-56b7-3873-8377-ee1c7f5af1a8",
                        "source_sense_description": "bird",
                        "target_lang_word": "ratite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd553792-60cb-3af2-aa86-e1d75ca0ddc9",
                                        "entry_id": "ee843206-35a9-3540-bcaf-8fba516aaecb",
                                        "glosses": [
                                            "Membre d’un groupe taxinomique maintenant désuet qui regroupait les autruches (struthioniformes), les casoars et émeus (casuariiformes), les nandous (rhéiformes) et les kiwis (aptérygiformes), soit tous les groupes d’oiseaux coureurs inaptes au vol (la nomenclature moderne a remplacé le groupe des ratites par celui des paléognathes, lequel réunit ces mêmes ordres tout en leur ajoutant celui des tinamous (tinamiformes), oiseaux coureurs primitifs aptes au vol)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2115295-3222-4809-88cc-2237cd95f628",
                                                "sense_id": "bd553792-60cb-3af2-aa86-e1d75ca0ddc9",
                                                "text": "Aucun ratite capturé dans la nature ne doit être gardé à des fins d’élevage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
