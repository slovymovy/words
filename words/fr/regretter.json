{
    "word_family": [
        "regret",
        "regrettable",
        "regrettablement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa165e8e-72c4-36be-8055-e95e0a4a0f78",
                    "sense_definition": "Éprouver du remords, un sentiment de repentir ou de contrariété à propos d'une action passée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repentir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>regrette</w> sincèrement de vous avoir parlé sur ce ton hier soir."
                        },
                        {
                            "text": "Tu as pris une décision imprudente que tu vas bientôt <w>regretter</w> amèrement."
                        }
                    ],
                    "synonyms": [
                        "déplorer"
                    ],
                    "common_phrases": [
                        "regretter son geste",
                        "regretter amèrement"
                    ]
                },
                {
                    "sense_id": "ad60cec3-0344-33c1-b23f-ee30d77c5c8c",
                    "sense_definition": "Ressentir de la tristesse, du chagrin ou un vide causé par l'absence ou la disparition d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_nostalgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son départ définitif, tous les membres de l'équipe le <w>regrettent</w> sincèrement."
                        },
                        {
                            "text": "Ce professeur dévoué a su se faire <w>regretter</w> par plusieurs générations d'étudiants."
                        }
                    ],
                    "common_phrases": [
                        "se faire regretter"
                    ]
                },
                {
                    "sense_id": "e7faecd8-1525-3576-b0e0-cb9567d6ae31",
                    "sense_definition": "Éprouver de la nostalgie ou du déplaisir face à la perte, au manque ou à la fin de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_nostalgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir déménagé en ville, elle a souvent continué à <w>regretter</w> sa vie à la campagne."
                        },
                        {
                            "text": "Il passe ses journées à <w>regretter</w> le passé au lieu de construire son avenir."
                        }
                    ],
                    "common_phrases": [
                        "regretter le passé",
                        "regretter le bon vieux temps"
                    ]
                }
            ]
        }
    ]
}