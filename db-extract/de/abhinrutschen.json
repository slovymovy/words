                "senses": [
                    {
                        "sense_id": "3f03b962-e861-3b9e-a378-4708f29b853b",
                        "entry_id": "0dfa59de-8225-3e32-8618-af88fc3e671b",
                        "glosses": [
                            "hinabrutschen"
                        ],
                        "tags": [
                            "Bavarian",
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "49d697d2-cba6-4f25-856f-913ce32d3111",
                                "sense_id": "3f03b962-e861-3b9e-a378-4708f29b853b",
                                "text": "„Des is erst s Ersti! denkt eahm der Ondri und rutscht owi ibern Roan.“"
                            },
                            {
                                "example_id": "5ecca13b-f510-407f-b388-0fa5d59f702c",
                                "sense_id": "3f03b962-e861-3b9e-a378-4708f29b853b",
                                "text": "„Dr Schorsch rutscht vom Baam owi und lacht: Awer Andrääs sigscht du a Vougelneschtli for an Immaschwarm ou!“"
                            },
                            {
                                "example_id": "701c8575-e6fa-4d15-abc7-4567a1018250",
                                "sense_id": "3f03b962-e861-3b9e-a378-4708f29b853b",
                                "text": "„Wenn eines Tags im Kopenhagener Hafen die Seejungfrau sogat: \"Komm, ich möcht mit dir schlafen!\" und von ihrm Föisn owirutschat, […]“"
                            },
                            {
                                "example_id": "622b3bb2-f1f3-43c7-b7b9-ed216a21dea0",
                                "sense_id": "3f03b962-e861-3b9e-a378-4708f29b853b",
                                "text": "„Sagt der Knecht zum Bauern: Guat, vo 11e bis 12e möchert i essn, aber um 10e kannst miir scho 9x an Buckl owirutschn!“"
                            },
                            {
                                "example_id": "4054418d-df97-466d-bf13-c685f81378ad",
                                "sense_id": "3f03b962-e861-3b9e-a378-4708f29b853b",
                                "text": "„Mi interessiert’s net, wos dea oide Drochn mocht. Soi ma weg’n meina in Bugl owerutschn!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
