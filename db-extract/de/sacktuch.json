                "senses": [
                    {
                        "sense_id": "fd9b6f99-b965-3dac-bc26-cbeac23dc6d9",
                        "entry_id": "ca4480e3-a773-3d5b-af9d-dad4b5c3a118",
                        "glosses": [
                            "Taschentuch"
                        ],
                        "tags": [
                            "Austrian German",
