                ],
                "senses": [
                    {
                        "sense_id": "36b499c3-1d61-3a4a-992a-f841f273f833",
                        "entry_id": "d51a6179-7e4d-3372-8119-f10207add17d",
                        "glosses": [
                            "Konzept für die Durchführung einer Überprüfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2869de65-9c69-48a0-9654-bb37a72c679e",
                                "sense_id": "36b499c3-1d61-3a4a-992a-f841f273f833",
                                "text": "„Zur Definition einer Teststrategie für Steuergeräte einen FMEA-basierten Ansatz zu verwenden, liegt nahe. Zur Analyse der Fehlerarten verwendet die FMEA einen funktionsorientierten Ansatz.“"
                            },
                            {
                                "example_id": "c1d0e5fd-97a6-4284-b43b-a57b564bab9e",
                                "sense_id": "36b499c3-1d61-3a4a-992a-f841f273f833",
                                "text": "„Die Überprüfung der High-Cost-/Low-Cost-These abweichenden Handelns mittels dieser zwei Teststrategien zeigt eine empirische Unterstützung der postulierten Interaktionsthese.“"
                            },
                            {
                                "example_id": "debf9e6b-dfd4-4c4b-8653-73e3072ad59c",
                                "sense_id": "36b499c3-1d61-3a4a-992a-f841f273f833",
                                "text": "„Im folgenden Aufsatz sollen einige Teststrategien und Testwerkzeuge vorgestellt werden, die den Test von ASICs ermöglichen und erleichtern […].“"
                            },
                            {
                                "example_id": "1a778df4-7ea1-46bb-b317-4c0644d64f96",
                                "sense_id": "36b499c3-1d61-3a4a-992a-f841f273f833",
                                "text": "„Grundlage für den Testplan bilden der QS-Plan, die Teststrategie, die Anforderungs- und Konzeptionsdokumente sowie der Projektplan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
