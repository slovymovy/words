    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                    "sense_definition": "Fait de ne pas être présent dans un lieu ; temps pendant lequel on est éloigné.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eloignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant une longue <w>absence</w>, il est recommandé de fermer l'eau de la maison."
                        },
                        {
                            "text": "Les voisins ont tout de suite remarqué son <w>absence</w> inhabituelle ce matin."
                        }
                    ],
                    "antonyms": [
                        "présence"
                    ],
                    "common_phrases": [
                        "absence prolongée",
                        "longue absence",
                        "remarquer une absence"
                    ]
                },
                {
                    "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                    "sense_definition": "Inexistence ou manque total de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En l'<w>absence</w> de réponse claire, nous devrons reporter la réunion de demain."
                        },
                        {
                            "text": "Le dossier a été rejeté en raison d'une <w>absence</w> totale de preuves vérifiables."
                        }
                    ],
                    "antonyms": [
                        "présence"
                    ],
                    "common_phrases": [
                        "en l'absence de",
                        "absence totale",
                        "absence de preuve"
                    ]
                },
                {
                    "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                    "sense_definition": "Fait de ne pas assister à une réunion, à un cours ou à un rendez-vous obligatoire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eloignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque employé doit justifier toute <w>absence</w> imprévue par un certificat médical."
                        },
                        {
                            "text": "Le directeur a constaté une <w>absence</w> injustifiée lors de l'appel du matin."
                        }
                    ],
                    "antonyms": [
                        "présence"
                    ],
                    "common_phrases": [
                        "justifier une absence",
                        "absence injustifiée",
                        "constater une absence"
                    ]
                },
                {
                    "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                    "sense_definition": "Court moment d'inattention ou de distraction de l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a eu un court moment d'<w>absence</w> qui a causé l'accident."
                        },
                        {
                            "text": "Pardonnez-moi, j'ai eu une <w>absence</w> d'esprit passagère pendant votre explication."
                        }
                    ],
                    "common_phrases": [
                        "avoir une absence",
                        "absence d'esprit",
                        "moment d'absence"
                    ]
                },
                {
                    "sense_id": "38e5640b-0fcf-3265-a8ef-f4edd73a8ca2",
                    "sense_definition": "Perte soudaine et brève de la conscience due à une forme d'épilepsie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet élève fait parfois une crise d'<w>absence</w> sans perdre l'équilibre."
                        },
                        {
                            "text": "Cette forme d'<w>absence</w> est une manifestation courante chez les enfants épileptiques."
                        }
                    ],
                    "synonyms": [
                        "petit mal",
                        "épilepsie absence"
                    ],
                    "common_phrases": [
                        "crise d'absence"
                    ]
                },
                {
                    "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                    "sense_definition": "Situation légale d'une personne disparue sans laisser de nouvelles dont on ignore l'existence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une déclaration d'<w>absence</w> a été déposée auprès du juge par la famille."
                        },
                        {
                            "text": "La présomption d'<w>absence</w> prend fin dès que la personne disparue réapparaît."
                        }
                    ],
                    "common_phrases": [
                        "déclaration d'absence",
                        "présomption d'absence"
                    ]
                }
            ]
        }
    ]
