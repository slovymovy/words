                                "target_senses": [
                                    {
                                        "sense_id": "51b38363-50e2-343f-92c7-068c52d24dad",
                                        "entry_id": "5989e33c-3a21-33f1-ad9d-9e1a14151739",
                                        "glosses": [
                                            "een strenge afkeuring van gedrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6f93d16-1f17-47fa-9dac-cee61490e0c4",
                                                "sense_id": "51b38363-50e2-343f-92c7-068c52d24dad",
                                                "text": "De arts kreeg een berisping van het tuchtcollege."
                                            },
                                            {
                                                "example_id": "e22cc492-aba8-4e4e-87d3-89d4264a22af",
                                                "sense_id": "51b38363-50e2-343f-92c7-068c52d24dad",
                                                "text": "Een mengelmoes van berispingen, ontkenningen en verwensingen die zowel fluisterend als luidkeels werden uitgesproken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08bebb89-30cb-45b5-988d-be8d447223c8",
                        "source_entry_id": "73b78d20-61d3-3667-8490-c5ae36021f80",
                        "target_lang_word": "waarschuwing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waarschuwing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                        "entry_id": "226d3bcf-89b9-3a20-8db3-fd61f88f9160",
                                        "glosses": [
                                            "een mededeling dat er onaangename of gevaarlijke gevolgen op til zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce4fc29-964e-4378-95de-4bb92014c0ab",
                                                "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                                "text": "Iemand heeft deze waarschuwing pas kortgeleden met geweld omvergeduwd, waardoor de poot knakte."
                                            },
                                            {
                                                "example_id": "217a0345-4ac5-4508-b68e-30e606c93b1b",
                                                "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                                "text": "Als dat wordt verkocht, moet er op de verpakking een waarschuwing staan voor mensen met een schaaldierenallergie."
                                            },
                                            {
                                                "example_id": "85444332-a188-4b7a-9a56-f13eceae3361",
                                                "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                                "text": "Ook werden er waarschuwingen bij specifieke stukken trail achtergelaten, zoals bijvoorbeeld op welke plek men het best een gevaarlijke rivier in de bergen kon oversteken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
