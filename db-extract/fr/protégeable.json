                        "glosses": [
                            "Qui peut être protégé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a6e0b9-9a44-4f9b-bd2b-7027c40c8309",
                                "sense_id": "fab59f2b-346f-3032-8d41-f3fca4ba251f",
                                "text": "Puis nous passâmes du bâtiment à roues au navire à moteur submergé et par suite bien plus facilement protégeable, et j’allai suivre en mer les premiers pas des créations nouvelles, …"
                            },
                            {
                                "example_id": "71d67603-00e2-4239-8687-f75271f203d5",
                                "sense_id": "fab59f2b-346f-3032-8d41-f3fca4ba251f",
                                "text": "Le doctorant reconnaît que l’établissement est propriétaire de tout autre résultat valorisable, protégeable ou non par un titre de propriété intellectuelle."
                            },
                            {
                                "example_id": "4237fb18-3195-4fde-9785-7824bbf2ae78",
                                "sense_id": "fab59f2b-346f-3032-8d41-f3fca4ba251f",
                                "text": "Cette énumération a été largement complétée par la jurisprudence, qui a déclaré protégeables nombre de créations non visées par la loi mais qui intéressent au premier chef les éditeurs."
                            }
                        ]
