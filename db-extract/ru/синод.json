                                    {
                                        "sense_id": "a7cf76c8-d5cb-3f54-836d-8e7ef6313fa6",
                                        "entry_id": "768d5b40-2f41-3355-9c17-3d96d6cc9eea",
                                        "glosses": [
                                            "An assembly of the clergy, by their representatives, to consult on ecclesiastical affairs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7037ac-44bf-4c3a-b057-7ca5d2191ee1",
                                                "sense_id": "a7cf76c8-d5cb-3f54-836d-8e7ef6313fa6",
                                                "text": "Convocation will sit in York too, so the northern church can have its say in how we worship God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73885d4-f116-39db-a292-aa9ea55f0267",
                                        "entry_id": "768d5b40-2f41-3355-9c17-3d96d6cc9eea",
                                        "glosses": [
                                            "An academic assembly, in which the business of a university is transacted."
                                        ],
                                        "tags": [
