                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af44055c-44a5-4a70-a2c1-4206ad624e0e",
                                "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                "text": "48 auto-agressions sont nettement déclenchées par la jalousie à l’égard des autres enfants dont l’éducatrice s'occupe."
                            },
                            {
                                "example_id": "6a3b2dd2-c241-4884-8921-baab6157c792",
                                "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                "text": "L’auto-agression serait inversement proportionnelle à l’agression dirigée vers autrui et vice versa."
                            },
                            {
                                "example_id": "e7d3cca4-fe87-4520-921a-5ff360542234",
                                "sense_id": "dddd8c1c-9fb9-389d-9dd2-91ed84b44d56",
                                "text": "De ce jour lointain, l’agression extérieure réprimée allait venir, de siècle en siècle, renforcer l’auto-agression acquise préhistoriquement sur le corps du père assassiné."
                            }
                        ]
