                                    {
                                        "sense_id": "6b158f78-ccc5-377d-97cf-40bc787f1b24",
                                        "entry_id": "22a3675f-1a54-3af9-bcae-12e528caec3d",
                                        "glosses": [
                                            "getal van 10 tot de macht googol, in theorie weer te geven als een 1 met 10 tot de macht 100 nullen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e71731aa-1792-4a57-bd2e-1f51f3e793ef",
                                                "sense_id": "6b158f78-ccc5-377d-97cf-40bc787f1b24",
                                                "text": "Rest ons nog een opmerking over de alinea in de inleiding die gewijd is aan de grootheid van de getallen. Daar wordt googolplex het grootste getal genoemd dat een naam heeft. Het „monster\" googolplex is - voor iemand die zich nog iets van machtsverheffen herinnert - 10 tot de macht 10 tot de macht 100. Ofwel: 1 met daarachter l0¹⁰⁰ nullen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75397c0c-8403-4e7a-95b0-a4d4128d22d3",
                        "source_entry_id": "71169fcd-434d-3ea6-b3e3-01b40dadf4a3",
                        "source_sense_description": "ten to the power of a googol",
                        "target_lang_word": "gogolplex",
                        "target_lang_code": "fr",
