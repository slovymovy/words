                    },
                    {
                        "sense_id": "5af51095-7d49-3dee-9de3-0655ad0fe296",
                        "entry_id": "6e47aa83-37c1-3727-a5be-de8f5d6fce25",
                        "glosses": [
                            "A change to an opposite direction."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b29a6fb6-6cf8-4bbe-8353-dc7de975e0fc",
                                "sense_id": "5af51095-7d49-3dee-9de3-0655ad0fe296",
                                "text": "Running via Aston would require a reversal at New Street and this will be taken into account during the planning and normal industry testing processes."
                            },
                            {
                                "example_id": "331d3372-bb18-4db6-af2b-261fb61cf591",
                                "sense_id": "5af51095-7d49-3dee-9de3-0655ad0fe296",
                                "text": "It's a 58-minute journey with seven intermediate stops, including a reversal at Cromer - another popular destination. The train starts to empty at North Walsham, and then there is an exodus at Cromer. The coach is almost empty for the final few miles into Sheringham."
                            }
                        ]
                    },
                    {
                        "sense_id": "6084fa30-82c3-30ba-8a4e-985844e7b41f",
                        "entry_id": "6e47aa83-37c1-3727-a5be-de8f5d6fce25",
                        "glosses": [
                            "A change in fortune; a change from being successful to having problems."
