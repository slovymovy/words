                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c09ba23-6dda-4d8e-939a-5be4a3625ba6",
                                "sense_id": "268d237a-baac-3d5d-aaa2-00655df1d3a2",
                                "text": "„Mir war, als schwebte ich über geradewegs einem Haschischtraum entsprungenen Szenarien – und zwar in einem Körper, der jenem des grauenvollen Wesens aus dem Konus ähnelte.“"
                            },
                            {
                                "example_id": "1ad68551-28c8-431e-bd25-f0d00a9e7644",
                                "sense_id": "268d237a-baac-3d5d-aaa2-00655df1d3a2",
                                "text": "„Vor mir, unter einer riesigen, krankhaft roten Sonne und vor einem schwarzen Himmel, erstreckte Yondo sich so endlos wie das Gefilde eines Haschischtraums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
