{
    "word_family": [
        "crank"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ced30b63-f307-365f-9f2b-1df131cf2e84",
                    "sense_definition": "Grouchy, grumpy, irritable; easily upset.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got home from a long day at work tired and <w>cranky</w>.",
                            "target_lang_translations": {
                                "ru": "Он вернулся домой после долгого рабочего дня уставшим и <w>раздражительным</w>."
                            }
                        },
                        {
                            "text": "The <w>cranky</w> toddler refused to eat his dinner because he was sleepy.",
                            "target_lang_translations": {
                                "ru": "<w>Капризный</w> малыш отказался ужинать, потому что хотел спать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cranky child",
                        "feeling cranky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражительный, ворчливый, легко выходящий из себя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "легко приходящий в раздражённое состояние"
                            },
                            {
                                "target_lang_word": "ворчливый",
                                "target_lang_sense_clarification": "склонный к постоянному выражению недовольства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a2b3a72-a5a1-347a-a783-d453cc62e782",
                    "sense_definition": "Not in good working condition; defective, faulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cranky</w> engine would not start despite several attempts to fix it.",
                            "target_lang_translations": {
                                "ru": "<w>Неисправный</w> двигатель не заводился, несмотря на несколько попыток его починить."
                            }
                        },
                        {
                            "text": "Margaret gave a speech despite the interruptions of a <w>cranky</w> sound system.",
                            "target_lang_translations": {
                                "ru": "Маргарет произнесла речь, несмотря на перебои в работе <w>барахлящей</w> звуковой системы."
                            }
                        }
                    ],
                    "synonyms": [
                        "shaky"
                    ],
                    "common_phrases": [
                        "cranky machine",
                        "cranky engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в плохом рабочем состоянии; неисправный, барахлящий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неисправный",
                                "target_lang_sense_clarification": "не работающий должным образом"
                            },
                            {
                                "target_lang_word": "барахлящий",
                                "target_lang_sense_clarification": "разговорный термин для техники, которая работает с перебоями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5defb07f-19e2-3cd6-b5e4-418b2a1705fd",
                    "sense_definition": "Weak, unwell.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient felt quite <w>cranky</w> after the long surgery.",
                            "target_lang_translations": {
                                "ru": "Пациент чувствовал себя довольно <w>слабым</w> после долгой операции."
                            }
                        },
                        {
                            "text": "She was too <w>cranky</w> to leave her bed today.",
                            "target_lang_translations": {
                                "ru": "Она была слишком <w>нездоровой</w>, чтобы встать сегодня с постели."
                            }
                        }
                    ],
                    "synonyms": [
                        "shaky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый, нездоровый, болезненный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нездоровый",
                                "target_lang_sense_clarification": "чувствующий недомогание"
                            },
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "выглядящий или чувствующий себя слабым из-за болезни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbea0014-ed79-3fb4-b561-d460e3e59aaa",
                    "sense_definition": "Not in perfect mental working order; eccentric, peculiar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uncle Esau is as <w>cranky</w> as hell, but he is a kind man.",
                            "target_lang_translations": {
                                "ru": "Дядюшка Исав ужасно <w>чудаковат</w>, но он добрый человек."
                            }
                        },
                        {
                            "text": "The <w>cranky</w> old man lived alone in the woods for many years.",
                            "target_lang_translations": {
                                "ru": "<w>Эксцентричный</w> старик много лет жил один в лесу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Странный, эксцентричный, со странностями в поведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудаковатый",
                                "target_lang_sense_clarification": "имеющий странности в поведении"
                            },
                            {
                                "target_lang_word": "эксцентричный",
                                "target_lang_sense_clarification": "выходящий за рамки обычного поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a97fe891-862a-3592-a888-0b26d502568d",
                    "sense_definition": "Of a ship: liable to capsize because of poorly stowed cargo or insufficient ballast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cranky</w> vessel struggled to stay upright in the rough sea.",
                            "target_lang_translations": {
                                "ru": "<w>Неостойчивое</w> судно с трудом удерживалось на плаву в бурном море."
                            }
                        },
                        {
                            "text": "Loading the cargo incorrectly made the ship <w>cranky</w> and dangerous.",
                            "target_lang_translations": {
                                "ru": "Неправильная погрузка сделала судно <w>неостойчивым</w> и опасным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cranky vessel"
                    ],
                    "target_lang_definitions": {
                        "ru": "О судне: неустойчивый, склонный к опрокидыванию из-за неправильной загрузки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неостойчивый",
                                "target_lang_sense_clarification": "морской термин для судна, склонного к потере равновесия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd70c229-2a9c-3412-898f-aac0f95a21a8",
                    "sense_definition": "Full of spirit; spirited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cranky</w> horse galloped across the field with great energy.",
                            "target_lang_translations": {
                                "ru": "<w>Бойкая</w> лошадь с огромной энергией скакала по полю."
                            }
                        },
                        {
                            "text": "He was in a <w>cranky</w> mood, ready to take on any challenge.",
                            "target_lang_translations": {
                                "ru": "Он был в <w>энергичном</w> настроении, готовый принять любой вызов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный энергии, живой, энергичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "полный сил и активности"
                            },
                            {
                                "target_lang_word": "бойкий",
                                "target_lang_sense_clarification": "живой, активный и смелый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}