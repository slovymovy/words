                ],
                "senses": [
                    {
                        "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                        "entry_id": "0b22ec05-3a7e-3ccb-b875-98c1821096b8",
                        "glosses": [
                            "bei einer Unterteilung der Erde in je zwei Hemisphären – eine nördliche und eine südliche beziehungsweise eine östliche und eine westliche – einer der beiden Teile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1948fc67-a0af-49c4-844c-889c759ac33a",
                                "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                                "text": "„Während am Äquator die ablenkende Kraft ausbleibt, erfolgt auf der nördlichen Erdhalbkugel eine Ablenkung im Uhrzeigersinn nach rechts und auf der südlichen Erdhalbkugel nach links.“"
                            },
                            {
                                "example_id": "e0a6186f-f002-47ab-b18d-ddeaa40e3e19",
                                "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                                "text": "„In der Mitte über der bereits zu erkennenden Erdhalbkugel malte sie eine kreisrunde, gelbe Sonne.“"
                            },
                            {
                                "example_id": "e5e8d8a2-9203-42eb-8f54-ab43c7c61be0",
                                "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                                "text": "„Es orientiert sich an dem gleichnamigen Sternbild, sichtbar am Himmel der südlichen Erdhalbkugel.“"
                            },
                            {
                                "example_id": "a0972309-c603-4f9b-90dc-0482a371c5fa",
                                "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                                "text": "„Auf der nördlichen Erdhalbkugel wird es das auch geben, aber womöglich mit etwas geringerer Ausprägung.“"
                            },
                            {
                                "example_id": "130bf8b7-70b8-41bb-b111-803da11d22ee",
                                "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                                "text": "„Gemeinsam mit Riesenfarnen bildeten sie die ersten Wälder auf der nördlichen Erdhalbkugel.“"
                            },
                            {
                                "example_id": "4e6cf52b-772e-431f-bc6e-ca85f6b04700",
                                "sense_id": "a217c6f1-e59c-30cb-81cb-42e5fe97b369",
                                "text": "„Wenn sich unsere nördliche Erdhalbkugel im Sommer der Sonne zuneigt, steht die Sonne hoch am Himmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
