                ],
                "senses": [
                    {
                        "sense_id": "d6eb1664-fd44-3c48-bc3f-06fee86ce0c5",
                        "entry_id": "deea6982-e841-3251-a4b3-9c2f318282e6",
                        "glosses": [
                            "Weg eines Schülers zur Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f304563-67ec-4baa-a246-bc0b3012115e",
                                "sense_id": "d6eb1664-fd44-3c48-bc3f-06fee86ce0c5",
                                "text": "Er traf auf dem Schulweg einen guten Freund."
                            },
                            {
                                "example_id": "324baa76-134b-433f-b9a4-4336e2e90f0d",
                                "sense_id": "d6eb1664-fd44-3c48-bc3f-06fee86ce0c5",
                                "text": "„Mein Schulweg führte über lange Treppen mit eisernen Geländern, großen Bäumen, Felsen und stillgelegten neubarocken Brunnen.“"
                            },
                            {
                                "example_id": "3c0a04d8-7d97-4099-8e4f-62d29ca36913",
                                "sense_id": "d6eb1664-fd44-3c48-bc3f-06fee86ce0c5",
                                "text": "„Es gab noch ein anderes Hindernis auf meinem Schulweg.“"
                            },
                            {
                                "example_id": "276e726e-7726-4fbd-9348-2299fcd84b70",
                                "sense_id": "d6eb1664-fd44-3c48-bc3f-06fee86ce0c5",
                                "text": "„Sein Schulweg ist nicht sehr lang, die Schule liegt in der Barlow Moor Road, einer langen Hauptverbindungsstraße, auf die die Burton Road mündet.“"
                            },
                            {
                                "example_id": "32d9b77c-95b1-4d8d-bbf1-6a400a455734",
                                "sense_id": "d6eb1664-fd44-3c48-bc3f-06fee86ce0c5",
                                "text": "„Mein Schulweg führte auf dem Gegenufer hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
