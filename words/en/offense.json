{
    "word_family": [
        "offend",
        "offensive",
        "offender",
        "offensiveness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91faf038-6a01-3b51-a0df-cd41274baf4f",
                    "sense_definition": "An illegal act or a crime.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driving without a valid license is a serious <w>offense</w> in most countries.",
                            "target_lang_translations": {
                                "ru": "Вождение без действительных прав является серьезным <w>правонарушением</w> в большинстве стран."
                            }
                        },
                        {
                            "text": "He was arrested for a minor <w>offense</w> but was released shortly after.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за незначительный <w>проступок</w>, но вскоре был отпущен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "minor offense",
                        "criminal offense",
                        "first offense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоправное деяние или преступление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правонарушение",
                                "target_lang_sense_clarification": "виновное противоправное деяние"
                            },
                            {
                                "target_lang_word": "преступление",
                                "target_lang_sense_clarification": "уголовно наказуемое деяние"
                            },
                            {
                                "target_lang_word": "проступок",
                                "target_lang_sense_clarification": "нарушение правил или норм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "340b762a-e431-328b-abe6-68df4d40e740",
                    "sense_definition": "The strategy or tactics used by a team or player to score points in a game.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team needs to improve their <w>offense</w> if they want to win the championship.",
                            "target_lang_translations": {
                                "ru": "Команде нужно улучшить игру в <w>нападении</w>, если они хотят выиграть чемпионат."
                            }
                        },
                        {
                            "text": "They played a very aggressive <w>offense</w> during the second half of the match.",
                            "target_lang_translations": {
                                "ru": "Во второй половине матча они играли в очень агрессивную <w>атаку</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "defense",
                        "defence"
                    ],
                    "common_phrases": [
                        "aggressive offense",
                        "play offense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стратегия или тактика, используемая командой или игроком для набора очков в игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "тактика игры"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "активные действия по набору очков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f434bc38-a9e0-383e-b744-522d484022bb",
                    "sense_definition": "The group of players on a team whose primary role is to score.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>offense</w> stayed on the field while the other players rested.",
                            "target_lang_translations": {
                                "ru": "Игроки <w>нападения</w> остались на поле, пока остальные отдыхали."
                            }
                        },
                        {
                            "text": "Our <w>offense</w> is much stronger this year thanks to the new players.",
                            "target_lang_translations": {
                                "ru": "Наша <w>атака</w> в этом году намного сильнее благодаря новым игрокам."
                            }
                        }
                    ],
                    "antonyms": [
                        "defense",
                        "defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа игроков в команде, чья основная роль заключается в наборе очков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "линия нападающих"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "состав игроков передней линии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a0b148b-0f9f-3731-a5e2-55be938ab5bf",
                    "sense_definition": "An action or remark that causes someone to feel hurt, angry, or upset; an insult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I meant no <w>offense</w> by my comment; I was just trying to be helpful.",
                            "target_lang_translations": {
                                "ru": "Я не хотел никого <w>обидеть</w> своим комментарием; я просто пытался быть полезным."
                            }
                        },
                        {
                            "text": "His rude behavior was a clear <w>offense</w> to everyone at the dinner table.",
                            "target_lang_translations": {
                                "ru": "Его грубое поведение было явным <w>оскорблением</w> для всех присутствующих за столом."
                            }
                        }
                    ],
                    "synonyms": [
                        "affront",
                        "insult",
                        "slight",
                        "slur"
                    ],
                    "common_phrases": [
                        "no offense",
                        "cause offense",
                        "take offense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или замечание, которое заставляет кого-то чувствовать себя обиженным или расстроенным; оскорбление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "унижение чести и достоинства"
                            },
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "причиненное огорчение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf916f88-249d-3f3d-8f40-c27e04cd1ed7",
                    "sense_definition": "The feeling of being annoyed or resentful as a result of a perceived insult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took great <w>offense</w> at the suggestion that she was lying.",
                            "target_lang_translations": {
                                "ru": "Она сильно <w>обиделась</w> на предположение о том, что она лжет."
                            }
                        },
                        {
                            "text": "He tried to hide his <w>offense</w> when they didn't invite him to the party.",
                            "target_lang_translations": {
                                "ru": "Он пытался скрыть свою <w>обиду</w>, когда его не пригласили на вечеринку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take offense",
                        "give offense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство раздражения или негодования в результате воспринятого оскорбления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "чувство огорчения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}