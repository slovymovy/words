            {
                "entry_id": "de8132ec-e890-32c7-843e-131d1b9da0bc",
                "word": "arroseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b79e12b-19a6-4482-bffb-a021e487608c",
                        "entry_id": "de8132ec-e890-32c7-843e-131d1b9da0bc",
                        "tags": [
