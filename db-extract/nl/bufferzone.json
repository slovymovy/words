                                        "examples": [
                                            {
                                                "example_id": "7eb62770-8ab2-48d4-8772-f165026e71da",
                                                "sense_id": "43de3fc0-6afb-3f77-b800-8117d1494bed",
                                                "text": "Does she wear glasses with fashionable frames, has she had her lids lifted, does she streak or tint? All of these things are possible: we’ve both reached that borderline age, that buffer zone in which it can still be believed such tricks will work if you avoid bright sunlight."
                                            }
