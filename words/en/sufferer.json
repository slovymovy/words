                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страда́лец",
                                "target_lang_sense_clarification": "человек, который испытывает страдания или боль (мужской род)"
                            },
                            {
                                "target_lang_word": "страда́лица",
                                "target_lang_sense_clarification": "женщина, которая испытывает страдания или боль"
                            },
                            {
                                "target_lang_word": "больно́й",
                                "target_lang_sense_clarification": "человек, страдающий от болезни или недуга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbdccdd9-de64-3ee1-aff7-9aa5e4e7d7c9",
