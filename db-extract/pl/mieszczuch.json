                        "cross_references": [
                            {
                                "target_word": "city slicker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5320b5-10de-3bf7-b31c-0275d758f545",
                                        "entry_id": "ce1a4b45-f638-3641-a2a6-49be6648da95",
                                        "glosses": [
                                            "One accustomed to a city or urban lifestyle or unsuited to life in the country."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0239a5-b1a8-4d7b-8cb3-41033c441897",
                                                "sense_id": "bd5320b5-10de-3bf7-b31c-0275d758f545",
                                                "text": "Look at the city slicker pulling up in his fancy German car."
                                            },
                                            {
                                                "example_id": "621313d7-1cf5-44f3-abde-a63e7cd35684",
                                                "sense_id": "bd5320b5-10de-3bf7-b31c-0275d758f545",
                                                "text": "See, I'm a city slicker, I, I ain't no townie / Right now, I wish I had another hash brownie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f15c34a-bef4-4c68-bc19-6f7ed717f6c9",
                        "source_entry_id": "766a50df-8136-37b1-9649-fca2fa8fd816",
                        "source_sense_id": "787a5393-1b96-31a1-8ce2-ae69088820e1",
                        "target_lang_word": "Städter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Städter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                        "entry_id": "9838ccf7-fcf3-3f19-b2c6-68a898bce732",
                                        "glosses": [
                                            "Person, die in einer Stadt lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4f59ad-0c26-46ad-a054-7c2d58237485",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "Mein Kollege hieß Stetter und war Städter."
                                            },
                                            {
                                                "example_id": "d83ba071-970e-4af0-ab37-5e41a820c0e1",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Die Städter ackerten und asteten, bis sie in der grimmigen Kälte völlig durchgeschwitzt waren.“"
                                            },
                                            {
                                                "example_id": "a6e2dcbc-f2a5-4dfe-94e7-7e106b492301",
                                                "sense_id": "cedceda8-319d-3b65-b0f4-77b5f13f0219",
                                                "text": "„Ich bin nicht auf Landarbeit versessen, ich bin durch und durch Städter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
