                    {
                        "form_id": "76b8302a-4e56-4834-9416-2ff14e28423b",
                        "entry_id": "03379b84-ce8e-3a36-ba1b-cd93eecfd404",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dickblattgewächse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                        "entry_id": "03379b84-ce8e-3a36-ba1b-cd93eecfd404",
                        "glosses": [
                            "Pflanze mit dicken, Wasser speichernden, oft sternförmig angeordneten Blättern sowie kleinen Blüten; Crassulaceae"
                        ],
                        "tags": [
                            "wissenschaftlicher Name"
                        ],
                        "examples": [
                            {
                                "example_id": "ec4bc07d-f6fe-4298-a8ca-240feef8be87",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Haben Sie das Dickblattgewächs einmal gepflanzt, wächst eine äußerst pflegeleichte, robuste und vor allem langlebige Pflanze in Ihrem Beet.“"
                            },
                            {
                                "example_id": "d809521d-3f69-4215-8e51-ac0a07c9cea2",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Das Dickblattgewächs ist nicht zimperlich, was die Vermehrung angeht, und eignet sich mit seinen wasserspeichernden Blättern perfekt für trockene Standorte.“"
                            },
                            {
                                "example_id": "fd883a31-0f60-4c7d-935c-a61e3e4093d2",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Das Dickblattgewächs hat in den vergangenen Jahren an Beliebtheit gewonnen, denn mit seinen Blattrosetten ist es nicht nur optisch ansehnlich, sondern außerdem absolut anspruchslos und verträgt Hitze, Kälte und Trockenheit.“"
                            },
                            {
                                "example_id": "7612ee09-98b0-459e-9441-0ce47990a5ba",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Der Rosenwurz, das ist ein Dickblattgewächs, das ideal gegen Stress, Erschöpfung und Vergesslichkeit wirkt.“"
                            },
                            {
                                "example_id": "953327fc-acb7-46fe-95bc-0c650e726e4a",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Das ist ein Dickblattgewächs, das sonnige Standorte liebt und auch längere Trockenzeiten problemlos übersteht.“"
                            },
                            {
                                "example_id": "ae6e1c4c-d465-42a4-ae0d-d6eae768c4c4",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Dazu gehören viele Eiskraut- oder Mittagsblumengewächse wie Lebende Steine (Lithops) und Tigerrachen (Faucaria trigrina) sowie Aloen, Agaven und Dickblattgewächse wie Crassula, Kalanchoë, Pfennigbaum (Crassula ovata), aber auch Wolfsmilchgewächse (Euphorbien) sowie Portulak.“"
                            },
                            {
                                "example_id": "28b2d8c5-50da-4d10-957d-f6b397c12b0a",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Sogenannte Dickblattgewächse haben eine tolle Eigenschaft: Sie haben einen Wasserspeicher und brauchen kaum Gießwasser.“"
                            },
                            {
                                "example_id": "97fa52d1-0ac0-423d-a742-d800bc1c0c40",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Für alle, die Pflanzen im Schlafzimmer vertragen und mögen und etwas fürs Raumklima tun wollen: Besonders luftreinigend wirken grüne Blattpflanzen wie Einblatt, Efeu, Efeutute, Grünlilie, Bergpalme und Bogenhanf, auch Dickblattgewächse (wie Fetthenne oder Pfennigbaum), Echte Aloe, Kakteen, Orchideen, Bromelien und weitere sogenannte CAM-Pflanzen, die (im Gegensatz zu anderen Pflanzen) auch nachts Sauerstoff produzieren und uns so mit frischer Luft versorgen.“"
                            },
                            {
                                "example_id": "6397aec4-3c8d-4fc7-bfd4-f930c8e04f66",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„In Sommer machen sich die Dickblattgewächse prima auf der Terrasse oder dem Balkon.“"
                            },
                            {
                                "example_id": "15d60a20-1ba6-4193-b68c-b8de3f875ace",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Diese Dickblattgewächse sind genügsam, verändern sich nur langsam und brauchen wenig Aufmerksamkeit.“"
                            },
                            {
                                "example_id": "7a03a959-674c-4599-8618-807c550d714f",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Die zur Familie der Dickblattgewächse gehörende Pflanze enthält zahlreiche Vitalstoffe.“"
                            },
                            {
                                "example_id": "82693ab1-3416-49af-aabc-fee8d0831b7f",
                                "sense_id": "ff4d5a7e-e29b-3d02-990b-5f68e03d896d",
                                "text": "„Sedum gehört mit annähernd 500 Arten zur Familie der Dickblattgewächse (Crassulaceae) und ist in Europa, Asien und Afrika verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
