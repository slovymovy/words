                "senses": [
                    {
                        "sense_id": "5c0d0689-7773-35da-ba38-71d06374b95c",
                        "entry_id": "84578337-76ac-3719-96ad-fdeec28b3367",
                        "glosses": [
                            "ein in der Erdumlaufbahn errichteter und bemannter Flugkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a2a2dee-af5d-48ff-81e8-c9cc3d863c3c",
                                "sense_id": "5c0d0689-7773-35da-ba38-71d06374b95c",
                                "text": "Die Raumstationen dienen vielen verschiedenen Zwecken."
                            },
                            {
                                "example_id": "007a4ede-2ec6-4899-8bd3-ce62fbb8f90d",
                                "sense_id": "5c0d0689-7773-35da-ba38-71d06374b95c",
                                "text": "„Zusammen mit dem französischen Raumfahrtkonzern Thales Alenia Space arbeitet OHB auch an einer Studie für die im Mondorbit geplante Raumstation Gateway.“"
                            },
                            {
                                "example_id": "ade904bb-dad8-41b5-82e6-1eca34b21864",
                                "sense_id": "5c0d0689-7773-35da-ba38-71d06374b95c",
                                "text": "„Wie die nationale Raumfahrtbehörde JAXA am Freitag mitteilte, will sich Japan an einer NASA-geführten Mission beteiligen, ab 2025 eine Raumstation in der Mondumlaufbahn zu bauen.“"
                            },
                            {
                                "example_id": "2d5ccc80-49b0-4e52-ac2c-49d906c8b757",
                                "sense_id": "5c0d0689-7773-35da-ba38-71d06374b95c",
                                "text": "„Nach sechs Monaten an Bord der der chinesischen Raumstation \"Tiangong\" sind drei Astronauten wieder sicher in der Wüste Gobi gelandet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
