{
    "word_family": [
        "dizziness",
        "dizzily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94734891-e8f5-3e19-8f98-2d55c3613996",
                    "sense_definition": "Feeling as if everything is spinning around you, often causing a loss of balance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stood up too fast and felt <w>dizzy</w>.",
                            "target_lang_translations": {
                                "ru": "Я встал слишком быстро, и у меня <w>закружилась голова</w>.",
                                "fr": "Je me suis levé trop vite et j'ai eu la <w>tête qui tourne</w>."
                            }
                        },
                        {
                            "text": "The heat in the crowded room made me feel a bit <w>dizzy</w>.",
                            "target_lang_translations": {
                                "ru": "От жары в переполненной комнате у меня немного <w>закружилась голова</w>.",
                                "fr": "La chaleur dans la pièce bondée m'a donné un peu le <w>vertige</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feel dizzy",
                        "get dizzy",
                        "dizzy spell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий, будто всё вокруг вращается, часто с потерей равновесия.",
                        "fr": "Sensation de vertige ou de perte d'équilibre, comme si tout tournait autour de soi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствующий головокружение",
                                "target_lang_sense_clarification": "физическое состояние"
                            },
                            {
                                "target_lang_word": "испытывающий головокружение",
                                "target_lang_sense_clarification": "формально"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir la tête qui tourne",
                                "target_lang_sense_clarification": "sensation physique courante"
                            },
                            {
                                "target_lang_word": "avoir le vertige",
                                "target_lang_sense_clarification": "sensation de déséquilibre"
                            },
                            {
                                "target_lang_word": "pris de vertige",
                                "target_lang_sense_clarification": "état soudain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "806f8d78-fc03-3783-ad07-68dbd6a41b9d",
                    "sense_definition": "Causing a feeling of giddiness or confusion, often due to great height or speed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We looked down from the <w>dizzy</w> heights of the mountain.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели вниз с <w>головокружительной</w> высоты горы.",
                                "fr": "Nous avons regardé en bas depuis les hauteurs <w>vertigineuses</w> de la montagne."
                            }
                        },
                        {
                            "text": "The technology is evolving at a <w>dizzy</w> speed.",
                            "target_lang_translations": {
                                "ru": "Технологии развиваются с <w>головокружительной</w> скоростью.",
                                "fr": "La technologie évolue à une vitesse <w>vertigineuse</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dizzying"
                    ],
                    "common_phrases": [
                        "dizzy heights",
                        "dizzy speed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий чувство головокружения или замешательства, часто из-за большой высоты или скорости.",
                        "fr": "Qui provoque une sensation de vertige ou de confusion, souvent en raison d'une grande hauteur ou d'une vitesse extrême."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "головокружительный",
                                "target_lang_sense_clarification": "о высоте, скорости или успехе"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "vertigineux",
                                "target_lang_sense_clarification": "se dit d'une hauteur, d'une vitesse ou d'un succès impressionnant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "135bc3e5-95a0-310c-ac3c-876d95c9c7cb",
                    "sense_definition": "Silly, forgetful, or not serious.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She can be a bit <w>dizzy</w> sometimes, but she is actually very smart.",
                            "target_lang_translations": {
                                "ru": "Иногда она бывает немного <w>легкомысленной</w>, но на самом деле она очень умна.",
                                "fr": "Elle peut être un peu <w>tête en l'air</w> parfois, mais elle est en réalité très intelligente."
                            }
                        },
                        {
                            "text": "He acts <w>dizzy</w> to make people laugh, but he knows exactly what he is doing.",
                            "target_lang_translations": {
                                "ru": "Он притворяется <w>рассеянным</w>, чтобы рассмешить людей, но точно знает, что делает.",
                                "fr": "Il joue l'<w>écervelé</w> pour faire rire les gens, mais il sait exactement ce qu'il fait."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глуповатый, забывчивый или несерьезный.",
                        "fr": "Qui manque de sérieux, qui est distrait ou étourdi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "рассеянный",
                                "target_lang_sense_clarification": "забывчивый"
                            },
                            {
                                "target_lang_word": "ветреный",
                                "target_lang_sense_clarification": "несерьезный"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tête en l'air",
                                "target_lang_sense_clarification": "se dit d'une personne distraite"
                            },
                            {
                                "target_lang_word": "écervelé",
                                "target_lang_sense_clarification": "se dit d'une personne manquant de jugement ou de sérieux"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8d66a7d-7891-386c-a3ba-540e55650ef8",
                    "sense_definition": "To make someone feel unsteady, confused, or bewildered.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex instructions completely <w>dizzied</w> the new students.",
                            "target_lang_translations": {
                                "ru": "Сложные инструкции совершенно <w>сбили с толку</w> новых студентов.",
                                "fr": "Les instructions complexes ont complètement <w>étourdi</w> les nouveaux étudiants."
                            }
                        },
                        {
                            "text": "He was <w>dizzied</w> by the sudden changes in the plan.",
                            "target_lang_translations": {
                                "ru": "Внезапные изменения в плане <w>сбили</w> его <w>с толку</w>.",
                                "fr": "Il a été <w>désorienté</w> par les changements soudains du plan."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-то чувство неустойчивости, замешательства или растерянности.",
                        "fr": "Rendre quelqu'un confus, désorienté ou incapable de réfléchir clairement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "запутывать"
                            },
                            {
                                "target_lang_word": "кружить голову",
                                "target_lang_sense_clarification": "одурманивать"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "étourdir",
                                "target_lang_sense_clarification": "rendre confus ou désorienté"
                            },
                            {
                                "target_lang_word": "faire tourner la tête",
                                "target_lang_sense_clarification": "désorienter quelqu'un"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03b0f8f8-0226-31b5-9d9d-e18a5208d558",
                    "sense_definition": "A distributor in an internal combustion engine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic said the <w>dizzy</w> needs to be replaced.",
                            "target_lang_translations": {
                                "ru": "Механик сказал, что нужно заменить <w>трамблёр</w>.",
                                "fr": "Le mécanicien a dit que la <w>tête de delco</w> doit être remplacée."
                            }
                        },
                        {
                            "text": "He bought a new cap for the <w>dizzy</w> on his classic car.",
                            "target_lang_translations": {
                                "ru": "Он купил новую крышку для <w>трамблёра</w> на свою классическую машину.",
                                "fr": "Il a acheté une nouvelle tête pour l'<w>allumeur</w> de sa voiture de collection."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "automotive context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределитель зажигания в двигателе внутреннего сгорания.",
                        "fr": "Dispositif de distribution de l'allumage dans un moteur à combustion interne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трамблёр",
                                "target_lang_sense_clarification": "автомобильный сленг"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tête de delco",
                                "target_lang_sense_clarification": "terme technique courant pour le distributeur d'allumage"
                            },
                            {
                                "target_lang_word": "allumeur",
                                "target_lang_sense_clarification": "terme mécanique précis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9cb9d33b-f5e8-3a10-8671-87f9255db612",
                    "sense_definition": "A nickname for Benjamin Disraeli (1804–1881), a British Prime Minister.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Historians sometimes refer to Disraeli simply as <w>Dizzy</w>.",
                            "target_lang_translations": {
                                "ru": "Историки иногда называют Дизраэли просто <w>Диззи</w>.",
                                "fr": "Les historiens appellent parfois Disraeli simplement <w>Dizzy</w>."
                            }
                        },
                        {
                            "text": "The political cartoons of the era often featured <w>Dizzy</w>.",
                            "target_lang_translations": {
                                "ru": "В политических карикатурах той эпохи часто изображали <w>Диззи</w>.",
                                "fr": "Les caricatures politiques de l'époque mettaient souvent en scène <w>Dizzy</w>."
                            }
                        }
                    ],
                    "traits": [
