                "senses": [
                    {
                        "sense_id": "407feda8-6753-397b-8e3d-be529823ac40",
                        "entry_id": "7364be7f-26d9-3c79-89b8-4c9c48633094",
                        "glosses": [
                            "Centrer sur la France, concevoir en pensant avant tout à la France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d68ea385-651a-4cc8-83d1-4db468f0aebf",
                                "sense_id": "407feda8-6753-397b-8e3d-be529823ac40",
                                "text": "Il ne faut pas \"francocentrer\" le jeu."
                            },
                            {
                                "example_id": "c3abf420-06ac-4386-9b17-72ab528cbd11",
                                "sense_id": "407feda8-6753-397b-8e3d-be529823ac40",
                                "text": "Et en évoquant, pour ne pas francocentrer le débat, les auras respectives de Sacramento et Los Angeles pour la Californie, ou d'Austin et Dallas pour le Texas, ou encore de Darmstadt et Francfort pour la Hesse."
                            },
                            {
                                "example_id": "b9ecbb07-29d0-4561-9aa2-755b6b107273",
                                "sense_id": "407feda8-6753-397b-8e3d-be529823ac40",
                                "text": "Peut-être y a-t-il eu aussi des études évaluatives et de résultats (à comparer à ceux d'autres pays pour ne pas trop francocentrer l'article)."
                            }
                        ]
                    }
