                    {
                        "sense_id": "a0c18809-d91a-39ed-b251-27be7a129734",
                        "entry_id": "72bae11e-8eda-3386-92c6-2d1ca32f6baf",
                        "glosses": [
                            "Solution de trioxyde de soufre dans de l’acide sulfurique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f369533e-4b79-40b3-bb74-b39745ee080e",
                                "sense_id": "a0c18809-d91a-39ed-b251-27be7a129734",
                                "text": "Pour l’oléum, qui a découvert le principe de la fabrication de l’acide sulfurique au moyen de l’acide sulfureux et de l’air par un procédé de contact ? C'est Kuhlmann."
                            },
                            {
                                "example_id": "137d6ef6-f27e-45b0-93b1-3fca36b1d84c",
                                "sense_id": "a0c18809-d91a-39ed-b251-27be7a129734",
                                "text": "L’oléum est ordinairement considéré, pour l’analyse, comme un mélange d’anhydride sulfurique (SO₃) et d’acide sulfurique (H₂SO₄). Cependant il contient toujours de petites quantités d’anhydride sulfureux (SO₂)."
                            }
                        ]
                    }
