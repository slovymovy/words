                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9edfb2e-a435-400d-9b3c-87a6eec8c221",
                                "sense_id": "1d0197e1-cc86-33d2-a2c0-016b5691c478",
                                "text": "Гаврилка… с придурью, — должно быть, отбили ему ещё маленькому затылок."
                            }
                        ]
                    },
                    {
                        "sense_id": "75724bc6-f884-30df-8a8c-0fcecc4aa294",
