{
    "word_family": [
        "deptanie",
        "podeptać",
        "rozdeptać",
        "zdeptać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "824deaf9-bce2-3b9e-8486-58e4cf0eb77c",
                    "sense_definition": "chodzić po czymś, przygniatać coś stopami",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "chodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wolno <w>deptać</w> trawników w parku.",
                            "target_lang_translations": {
                                "ru": "В парке нельзя <w>топтать</w> газоны."
                            }
                        },
                        {
                            "text": "Dzieci <w>depczą</w> kwiaty w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "Дети <w>топчут</w> цветы в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "tratować"
                    ],
                    "common_phrases": [
                        "deptać trawniki",
                        "deptać kwiaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "ходить по чему-либо, приминая или повреждая это ногами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "общее значение хождения по чему-либо ногами"
                            },
                            {
                                "target_lang_word": "вытаптывать",
                                "target_lang_sense_clarification": "повреждать что-либо (например, траву) хождением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fbd3635-8233-35f0-9239-7bcd445e23e6",
                    "sense_definition": "traktować kogoś w sposób poniżający, znieważać",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poniżanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie pozwól, aby inni <w>deptali</w> twoją godność.",
                            "target_lang_translations": {
                                "ru": "Не позволяй другим <w>растоптать</w> твое достоинство."
                            }
                        },
                        {
                            "text": "Władza <w>depcze</w> prawa obywateli.",
                            "target_lang_translations": {
                                "ru": "Власть <w>попирает</w> права граждан."
                            }
                        }
                    ],
                    "synonyms": [
                        "poniżać",
                        "znieważać"
                    ],
                    "common_phrases": [
                        "deptać godność",
                        "deptać prawa"
                    ],
                    "target_lang_definitions": {
                        "ru": "унижать кого-либо, пренебрегать чьими-либо правами или достоинством"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попирать",
                                "target_lang_sense_clarification": "грубо нарушать права или принципы"
                            },
                            {
                                "target_lang_word": "растоптать",
                                "target_lang_sense_clarification": "унизить, уничтожить чье-либо достоинство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87b410ca-df01-3160-b4da-18ff6a7c3507",
                    "sense_definition": "ugniatać owoce stopami w celu wyciśnięcia soku",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przetwórstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tradycyjnie w tym regionie <w>depcze</w> się winogrona w wielkich kadziach.",
                            "target_lang_translations": {
                                "ru": "Традиционно в этом регионе виноград <w>давят</w> ногами в больших чанах."
                            }
                        },
                        {
                            "text": "Winiarze <w>deptali</w> owoce, aby uzyskać świeży sok.",
                            "target_lang_translations": {
                                "ru": "Виноделы <w>давили</w> фрукты, чтобы получить свежий сок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deptać winogrona"
                    ],
                    "target_lang_definitions": {
                        "ru": "давить фрукты ногами для получения сока"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давить",
                                "target_lang_sense_clarification": "процесс выжимания сока из ягод или фруктов"
                            },
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "традиционный способ отжима винограда ногами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}