                "senses": [
                    {
                        "sense_id": "3c290497-c115-3198-b7cb-f6f4fcb734e4",
                        "entry_id": "689af37e-9976-3324-bd5f-04461173c5bc",
                        "glosses": [
                            "het uiteinde van de aardas op 90 graden zuiderbreedte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478b448a-ee72-412e-9239-62a69cee0c7b",
                                "sense_id": "3c290497-c115-3198-b7cb-f6f4fcb734e4",
                                "text": "Een kompasnaald wijst met z'n zuidpool naar de magnetische noordpool van de aarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6560e63-3f3b-36a2-93d5-a81d58922878",
                        "entry_id": "689af37e-9976-3324-bd5f-04461173c5bc",
                        "glosses": [
                            "het punt van een magneet waar de veldlijnen naar binnen gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52279733-242d-4791-b4fb-daeac61ffc85",
                                "sense_id": "f6560e63-3f3b-36a2-93d5-a81d58922878",
                                "text": "Iedere magneet heeft een noord en een zuidpool."
                            }
                        ]
                    },
                    {
                        "sense_id": "35b2d5d1-fb63-3df4-b0f2-0a4f65394f69",
                        "entry_id": "689af37e-9976-3324-bd5f-04461173c5bc",
                        "glosses": [
                            "het andere uiteinde van de as van een omwentelingslichaam, of van een elektrische geleider, dat door het hulpmiddel van de zg. “rechterhandregel” als noordpool wordt aangewezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44892e53-e9df-4e77-b67a-9c8ea7e62eb4",
                                "sense_id": "35b2d5d1-fb63-3df4-b0f2-0a4f65394f69",
                                "text": "De magnetische zuidpool van de aarde valt niet precies samen met de geografische."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1ae7a7c-cb3f-3a69-96cc-21a36d922757",
                        "entry_id": "689af37e-9976-3324-bd5f-04461173c5bc",
                        "glosses": [
                            "het uiteinde van de as van een hemellichaam dat op 90 graden zuiderbreedte ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91149901-f045-4f2a-ac0b-e07891f94440",
                                "sense_id": "d1ae7a7c-cb3f-3a69-96cc-21a36d922757",
                                "text": "Een onbemand Chinees ruimtevaartuig heeft beeldmateriaal verzameld van de planeet Mars. Er zijn onder meer voor het eerst beelden gemaakt van de 'zuidpool' op de rode planeet, meldt het China Lunar Exploration Project woensdag."
                            }
                        ]
                    }
                ],
