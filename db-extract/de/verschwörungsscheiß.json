                        "entry_id": "704e0cc9-ffb2-3a59-aa31-1ce52132ffe2",
                        "glosses": [
                            "unsinniger Versuch, ein Ereignis durch eine Verschwörung zu erklären"
                        ],
                        "tags": [
                            "derogatory",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "375c3e18-9d9c-45af-9270-a90fe18ca59f",
                                "sense_id": "0a3e9006-8bf1-3214-bcd0-d51b20fd6e57",
                                "text": "„Nein, da steckt nichts dahinter. Zu viel Verschwörungsscheiß.“"
                            },
                            {
                                "example_id": "751ca952-5106-4bb4-872d-2c15fffd0aa1",
                                "sense_id": "0a3e9006-8bf1-3214-bcd0-d51b20fd6e57",
                                "text": "„Wer in Deutschland mit virtuellen Kameras über die grünen Auen und Wälder fliegt, in den tiefen Süden, nach Voralberg, der findet keinen Verschwörungsscheiß.“"
                            },
                            {
                                "example_id": "d4946ee3-2943-4062-822e-617efd41fe20",
                                "sense_id": "0a3e9006-8bf1-3214-bcd0-d51b20fd6e57",
                                "text": "„Menschen, die solchen verqueren Verschwörungsscheiß ganz unverblümt formulieren, sitzen mittlerweile im Bundestag.“"
                            },
                            {
                                "example_id": "d99d1daf-bdbf-4d57-9d28-656736911c16",
                                "sense_id": "0a3e9006-8bf1-3214-bcd0-d51b20fd6e57",
                                "text": "„Sein Verschwörungsscheiß verkauft sich gut und früher war er mal ne nette Außenwerbung für Mannheim – hält man deswegen die Füße still?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
