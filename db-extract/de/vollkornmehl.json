                    },
                    {
                        "form_id": "dd2f658a-8549-4a86-b72f-98af5956a206",
                        "entry_id": "0ecdb359-b85a-3295-b6a7-d49a9c4c8f06",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vollkornmehle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                        "entry_id": "0ecdb359-b85a-3295-b6a7-d49a9c4c8f06",
                        "glosses": [
                            "aus den gesamten essbaren Bestandteilen des Getreidekorns – also Mehlkörper, Schale und Keimling – hergestelltes Mehl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "130cafce-7473-45bd-a335-77f8223e97a3",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "Claudia verwendet zum Brötchenbacken gern Vollkornmehl."
                            },
                            {
                                "example_id": "aa5e764d-e9c6-4afc-9a15-c6faa58ec247",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "Ratlos stand Igor vor dem Regal mit Vollkornmehlen aus diversen Getreidesorten und konnte sich nicht entscheiden, welches er nehmen sollte."
                            },
                            {
                                "example_id": "c78c3e78-3338-41ae-b6d4-3e4ce9e3cb61",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "Stefano achtet bei allen Vollkornmehlen, die er verarbeitet, auf gute Qualität."
                            },
                            {
                                "example_id": "8a9dc04b-f3b0-472e-8411-ed754163e0d3",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "„Für Vollkornmehl wird das ganze Korn verarbeitet, also der sogenannte Mehlkörper sowie der Keimling und die Schale.“"
                            },
                            {
                                "example_id": "3f2d1ce6-01bd-43e2-a09c-565b71970dfe",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "„Vollkornmehl gilt als besonders gesund - egal ob es aus Dinkel, Roggen oder Weizen hergestellt wurde.“"
                            },
                            {
                                "example_id": "2ab3ca4e-3810-4369-9d52-6c420db423f0",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "Vollkornmehl hat keine Typenzahl, weil die gesamten Bestandteile der gereinigten Körper enthalten sind."
                            },
                            {
                                "example_id": "fa8343a1-1062-453b-80cc-85930838e331",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "Vollkornmehl benötigt mehr Wasser und ergibt einen schweren Teig, der nicht so stark aufgeht."
                            },
                            {
                                "example_id": "b02028e7-29d5-4021-9466-5375049a75bd",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "„Wer Probleme mit dem Kauen hat, sollte Backwaren aus feinvermahlenem Vollkornmehl wählen - etwa Grahambrot oder Vollkorntoast.“"
                            },
                            {
                                "example_id": "7084fa2e-47c0-419f-849e-af67f10443b2",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "„Wer Knäckebrot selbst backt, etwa aus Vollkornmehl, Olivenöl, Saaten und Nüssen, hat eine gesunde, kalorienarme Alternative zu herkömmlichem Brot - reich an gesunden Fetten, pflanzlichem Eiweiß und Ballaststoffen.“"
                            },
                            {
                                "example_id": "a2b74ad7-e09f-47bd-8006-248de3ba487c",
                                "sense_id": "ff29f9d4-3fd2-36f9-98ce-9605037e3c73",
                                "text": "„Bis in das 17. Jahrhundert hinein fehlte die Technik, um Schalen und Mehlkörper zu trennen. Daher wurde ausschließlich Vollkornmehl verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
