                            {
                                "example_id": "cdfc50f8-b53a-44d8-8148-bdf918296164",
                                "sense_id": "f27fbad4-943d-3c12-a5a9-744949fbcdab",
                                "text": "Wyjątek stanowiła Francja, która udzielała Polakom dziesięciu stypendiów ośmiomiesięcznych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
