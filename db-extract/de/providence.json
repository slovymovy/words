                ],
                "senses": [
                    {
                        "sense_id": "e8d72dcb-248c-3bae-9543-b770aaacafb7",
                        "entry_id": "70dbdf2d-6700-3e32-b03e-0af569b6d7fa",
                        "glosses": [
                            "Hauptstadt des US-Bundesstaats Rhode Island"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b66da09-1dbf-4ca2-b8c7-4d11e35831c0",
                                "sense_id": "e8d72dcb-248c-3bae-9543-b770aaacafb7",
                                "text": "„Erinnere dich an das malerische Providence, das auf seinen sieben Hügeln über dem blauen Hafen liegt und dessen grüne Terrassen hinaufführen zu Kirchtürmen und Zitadellen lebendiger Vergangenheit, und an Newport, das wie eine Fantasie aus dem träumenden Wellenbrecher kriecht.“"
                            },
                            {
                                "example_id": "d32d1b4c-46de-4b87-8f6f-483ced83a0a1",
                                "sense_id": "e8d72dcb-248c-3bae-9543-b770aaacafb7",
                                "text": "„Einer dieser Amateurforscher - ein älterer Exzentriker aus Providence in Rhode Island, den eine langjährige, enge Brieffreundschaft mit Carter verband - vertrat eine noch schillerndere Theorie.“"
                            },
                            {
                                "example_id": "38c6ccad-f053-41fb-82b3-0a80767e0e21",
                                "sense_id": "e8d72dcb-248c-3bae-9543-b770aaacafb7",
                                "text": "„Wilmarth, ein hoch angesehener Professor an der Brown University in Providence, Rhode Island, wurde vor vier Nächten tot auf seinem Grundstück entdeckt.“"
                            },
                            {
                                "example_id": "31b27449-6b28-4c25-8093-a39053ecfbe6",
                                "sense_id": "e8d72dcb-248c-3bae-9543-b770aaacafb7",
                                "text": "„Leider sind inzwischen Zweifel an der Verwandtschaft zwischen diesem John Field und jenem John Field (gest. 1686) aufgekommen, der einer der ersten Siedler in Providence, Rhode Island, und ein direkter Vorfahre von Lovecrafts Mutter war.“"
                            },
                            {
                                "example_id": "f5a2fb7a-9b73-4fd1-a10c-86055fe6aa17",
                                "sense_id": "e8d72dcb-248c-3bae-9543-b770aaacafb7",
                                "text": "„›Ich weiß, wo Providence liegt. Aber ich fahr nicht hin.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
