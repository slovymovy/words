                "senses": [
                    {
                        "sense_id": "ed49d592-af53-3cf0-aa98-0e8453432971",
                        "entry_id": "e4b2c3e1-1397-3f63-9bad-c07084d7ebae",
                        "glosses": [
                            "Gerichtsverfahren, bei dem es um eine Ehescheidung geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8122ebb-df49-430f-a3b8-140be42ee19e",
                                "sense_id": "ed49d592-af53-3cf0-aa98-0e8453432971",
                                "text": "„Von einem Scheidungsprozess hatten seine Berater Georg IV. abgeraten. Georg hatte nicht nur zahlreiche Geliebte, was in einem öffentlichen Scheidungsprozess zur Sprache gekommen wäre.“"
                            },
                            {
                                "example_id": "21f20425-b95d-4548-9fec-439e952cc690",
                                "sense_id": "ed49d592-af53-3cf0-aa98-0e8453432971",
                                "text": "„Dem Freiherrn selber jedoch war die Popularität als Lügenbaron eher peinlich, zudem erwies sich sein zweifelhafter Ruf bei einem späteren Scheidungsprozess, der ihn finanziell ruinierte, als wenig vorteilhaft.“"
                            },
                            {
                                "example_id": "dc016a41-826f-41a1-a0ef-7dbb3684f1af",
                                "sense_id": "ed49d592-af53-3cf0-aa98-0e8453432971",
                                "text": "„Am liebsten wäre sie für immer geblieben, doch kehrte sie im Frühjahr 1839 ins Rheinland zurück, weil der beginnende Scheidungsprozess ihre Anwesenheit erzwang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
