                "senses": [
                    {
                        "sense_id": "f0997287-a845-3a9b-b2f2-55e54298a934",
                        "entry_id": "42a0181c-d171-3252-9fd8-079e064c62f1",
                        "glosses": [
                            "eine in Sachsen (Deutschland) geborene oder dort auf Dauer lebende weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6ca9b2-940a-4238-9be8-79f97037d038",
                                "sense_id": "f0997287-a845-3a9b-b2f2-55e54298a934",
                                "text": "Mein ostfriesischer Vater hat damals eine Sächsin geheiratet."
                            },
                            {
                                "example_id": "a405f6a0-126a-4967-97ca-2288980fe17f",
                                "sense_id": "f0997287-a845-3a9b-b2f2-55e54298a934",
                                "text": "Die gebürtige Bayerin ist nun eine Sächsin, da sie jetzt in Leipzig wohnt."
                            },
                            {
                                "example_id": "480a39da-a02f-4bf0-99f1-2335acc7e23e",
                                "sense_id": "f0997287-a845-3a9b-b2f2-55e54298a934",
                                "text": "Der chinesische Tourist traf in Dresden erstmals eine Sächsin."
                            },
                            {
                                "example_id": "796810e4-2667-4c25-bc7f-d059ae3536f8",
                                "sense_id": "f0997287-a845-3a9b-b2f2-55e54298a934",
                                "text": "„Bei diesen vielen Betrügern war noch die angebliche Frau des Chevalier Saby, eine recht hübsche Sächsin, die in sehr schlechtem Italienisch der Gräfin Piccolomini den Hof machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
