                "senses": [
                    {
                        "sense_id": "fe13309d-0f40-3033-9068-61b639adbe71",
                        "entry_id": "860bdf19-96b6-37fc-85d2-433ab59d52e6",
                        "glosses": [
                            "cecha tego, co produktywne; cecha tych, którzy są produktywni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19712df-65dd-4f9d-8360-5724de593d91",
                                "sense_id": "fe13309d-0f40-3033-9068-61b639adbe71",
                                "text": "Długotrwała praca przy biurku i nieprawidłowa pozycja podczas pracy mogą prowadzić do napięć i bólu karku i ramion, co może wpływać zarówno na produktywność, jak i jakość życia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b65b45ae-efce-3b42-923c-25dfb915c7af",
                        "entry_id": "860bdf19-96b6-37fc-85d2-433ab59d52e6",
                        "glosses": [
                            "wielkość efektu produkcyjnego uzyskanego z danych nakładów, wyrażona za pomocą wartości ułamka, w którym licznik zawiera wielkość produkcji, a mianownik – wielkość poniesionych na nią nakładów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08466888-7b60-40f8-b765-3d499775f1e3",
                        "source_entry_id": "860bdf19-96b6-37fc-85d2-433ab59d52e6",
                        "source_sense_id": "b65b45ae-efce-3b42-923c-25dfb915c7af",
                        "target_lang_word": "productivity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "productivity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55e9a54b-bfa1-36d3-8abe-0e79fc570c00",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The state of being productive, fertile, or efficient."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0174c964-c471-335a-a25f-8d5d2ecb9153",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The rate at which goods or services are produced by a standard population of workers; those workers' degree of efficiency."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1345adfc-8c1e-4133-8926-29271f23ced3",
                                                "sense_id": "0174c964-c471-335a-a25f-8d5d2ecb9153",
                                                "text": "You can see the computer age everywhere but in the productivity statistics."
                                            },
                                            {
                                                "example_id": "94b68de1-65de-43ae-be8c-2a72b90d6787",
                                                "sense_id": "0174c964-c471-335a-a25f-8d5d2ecb9153",
                                                "text": "Productivity growth has disappointed across the western world since the 2008 financial crisis. But the UK has notched a significantly worse performance than many of its peers on this metric of output for each hour of work – which is a vital driver of economic growth, wages and living standards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eddef40-ff0b-3f82-948f-d3e7657b2c95",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The rate at which crops are grown on a standard area of land."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0c15290-2463-3b52-8095-69ced3ecd9a3",
                                        "entry_id": "70c2a636-9f4a-39c2-bcbe-9531189f2ea4",
                                        "glosses": [
                                            "The ability to form new words using established patterns and discrete linguistic elements, such as the derivational affixes -ness and -ity; the degree to which such formation happens."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3be749de-6f1a-4501-939c-dffc03284e28",
                        "source_entry_id": "860bdf19-96b6-37fc-85d2-433ab59d52e6",
                        "source_sense_id": "b65b45ae-efce-3b42-923c-25dfb915c7af",
                        "target_lang_word": "Produktivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Produktivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                                        "entry_id": "083252e9-f10d-3100-b366-f80c9093e67d",
                                        "glosses": [
                                            "Leistungsfähigkeit einer Person, eines Betriebes, einer Organisation, unter Berücksichtigung des Aufwandes Dienstleistungen zu erbringen oder Produkte herzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "102e6d56-e3e0-402c-b8b1-659c0704a4f6",
                                                "sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                                                "text": "Der Betrieb hat eine zu geringe Produktivität."
                                            },
                                            {
                                                "example_id": "9ef7c324-ff36-4aba-9f86-7a6e7e221fec",
                                                "sense_id": "fb0a74b7-29a5-3fc2-b82c-47ca4b897d3f",
                                                "text": "Das Wachstum fällt in diesem Jahr um einen halben Prozentpunkt auf nur noch 1,5 Prozent.„Leider wird sich auch die Produktivität enttäuschend entwickeln und nicht ansteigen. […]“ [der britische Schatzkanzler Philip Hammond im Unterhaus]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a33ece1e-927a-34f2-9f96-4773486a7334",
                                        "entry_id": "083252e9-f10d-3100-b366-f80c9093e67d",
                                        "glosses": [
                                            "Häufigkeit, mit der ein Affix (Wortbildungsmorphem) verwendet wird, um neue Wörter zu bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea230c78-9d6a-4452-9989-a4091778c1af",
                                                "sense_id": "a33ece1e-927a-34f2-9f96-4773486a7334",
                                                "text": "Die Produktivität des Präfixes \"un-\" im Deutschen ist sehr groß, die von \"miss-\" dagegen ist längst verloren gegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcb91a2e-3963-4685-8fb7-66384944465f",
                        "source_entry_id": "860bdf19-96b6-37fc-85d2-433ab59d52e6",
