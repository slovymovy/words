                "senses": [
                    {
                        "sense_id": "b82d9b2d-72f1-3733-8335-18fdead0ad5c",
                        "entry_id": "5760c92f-b41a-315b-922d-8d9add7b3535",
                        "glosses": [
                            "Landung eines Flugzeugs auf dem Flugzeugrumpf — ohne Ausfahren des Fahrwerks"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "91f4de1e-8cb1-4aae-a3d1-8db8f62d5ce1",
                                "sense_id": "b82d9b2d-72f1-3733-8335-18fdead0ad5c",
                                "text": "Einem Segelflugzeug passiert bei einer Bauchlandung auf einer Graspiste meist nicht viel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "726184a8-049e-3ad0-b814-49ced7bcb2fe",
                        "entry_id": "5760c92f-b41a-315b-922d-8d9add7b3535",
                        "glosses": [
                            "Scheitern eines Vorhabens, Misslingen eines Plans"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "4e264cbf-a2a2-451a-95f4-8571b2d850d7",
                                "sense_id": "726184a8-049e-3ad0-b814-49ced7bcb2fe",
                                "text": "„Nach einem Platzverweis für Thomas Müller hat der FC Bayern München eine bittere Bauchlandung erlebt.“"
                            },
                            {
                                "example_id": "52c485e2-1165-4da3-b6f2-63845e299c43",
                                "sense_id": "726184a8-049e-3ad0-b814-49ced7bcb2fe",
                                "text": "Allen Phasen liberalisierter Kapitalflüsse folgte eine mehr oder weniger harte Bauchlandung [der Wirtschaft]."
                            },
                            {
                                "example_id": "131e8715-d462-4a90-8f44-70e13e1165e4",
                                "sense_id": "726184a8-049e-3ad0-b814-49ced7bcb2fe",
                                "text": "Zu Hause, in seiner Garage baute er aus alten Filtern für die Zementindustrie, neue, bessere. Doch mit dieser ersten Geschäftsidee machte er eine Bauchlandung: Denn die Zementwerke, die sich schnell an neue Umweltstandards anpassen mussten, bekamen für umgebaute Filter kein Geld vom Staat."
                            },
                            {
                                "example_id": "8065aa4f-f4b7-42ee-a2c3-a34fc605ac11",
                                "sense_id": "726184a8-049e-3ad0-b814-49ced7bcb2fe",
                                "text": "Im Juni der Brexit. Im November die Wahl Donald Trumps zum 45. Präsidenten der USA. Gleich zweimal haben Meinungsumfragen im Jahr 2016 eine krachende Bauchlandung erfahren, wo es darum ging, den politischen Willen der Bürger zu erfassen."
                            },
                            {
                                "example_id": "81782f0e-e6d0-40d5-aadd-ddcef0670652",
                                "sense_id": "726184a8-049e-3ad0-b814-49ced7bcb2fe",
                                "text": "„Okay, Herr Weber. Jetzt gibt es diesen längsten Streik in der Geschichte der Deutschen Bahn […] Sie ziehen wieder vor Gericht, riskieren wieder auch die Bauchlandung?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
