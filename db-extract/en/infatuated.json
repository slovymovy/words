                        "target_lang_word": "schwärmerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwärmerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a28b25f-c693-3d0e-8e9c-bddb9f85c99d",
                                        "entry_id": "31e46222-4b79-3555-b44e-a07258a1cb73",
                                        "glosses": [
                                            "geprägt vom starken positiven Gefühlen für etwas/jemanden, dabei etwas wirklichkeitsfern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37823035-2c60-48aa-be38-c09801dc65d8",
                                                "sense_id": "9a28b25f-c693-3d0e-8e9c-bddb9f85c99d",
                                                "text": "Werther gibt sich einer hoffnungslosen Liebe hin, die ihn in den Selbstmord treibt - schwärmerisch, radikal, an der Welt verzweifelnd. Und ungeheuer berührend."
                                            },
                                            {
                                                "example_id": "676ea715-f14c-474d-9d0d-dd177d357650",
                                                "sense_id": "9a28b25f-c693-3d0e-8e9c-bddb9f85c99d",
                                                "text": "Julius’ schwärmerische Reflexionen über Lucinde und das Wesen der Frauen berühren mich heute noch wie zu Zeiten meines geistesbewegten Studiums in Tübingen."
                                            },
                                            {
                                                "example_id": "bf0f6e90-a49e-4620-b46e-5a08348311d2",
                                                "sense_id": "9a28b25f-c693-3d0e-8e9c-bddb9f85c99d",
                                                "text": "Die Nachrufe auf Christine Kaufmann fallen geradezu schwärmerisch aus: Eine großartige Schauspielerin, eine Hollywoodheldin, eine Sexbombe."
                                            },
                                            {
                                                "example_id": "f3834fce-24f8-40ab-a3dd-df6bb8390d4b",
                                                "sense_id": "9a28b25f-c693-3d0e-8e9c-bddb9f85c99d",
                                                "text": "„In der schwärmerischen Sprache der Zeit wird zum Ausdruck gebracht, was die Bergwanderer und Kletterer bewegt: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
