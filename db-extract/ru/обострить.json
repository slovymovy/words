                    {
                        "sense_id": "8e9e6803-77bb-35f0-a36b-21faa9819222",
                        "entry_id": "a54ebe4d-7cc3-3874-b8e7-a2abe08e3955",
                        "glosses": [
                            "сделать более острым, сильным (какое-либо чувство, ощущение и т. п.)"
                        ],
                        "tags": [],
