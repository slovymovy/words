                ],
                "senses": [
                    {
                        "sense_id": "cab991c9-f2db-3291-afa1-159c327945a9",
                        "entry_id": "f563202a-13e6-365b-a5be-b6508edbff80",
                        "glosses": [
                            "beabsichtigte oder auch unbeabsichtigte Wirkung mit überraschender Auswirkung, die durch Ionisierung auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2dafcc0-3ddd-47c5-9961-4cb004a14d17",
                                "sense_id": "cab991c9-f2db-3291-afa1-159c327945a9",
                                "text": "„Wie weit die manchmal beobachtete günstige Wirkung einer Allgemeinbestrahlung mit niederer Dosis auf einen Ionisierungseffekt zurückzuführen ist, wäre zu untersuchen.“"
                            },
                            {
                                "example_id": "2a8f399d-57f5-4a4b-af12-0f48f09f5719",
                                "sense_id": "cab991c9-f2db-3291-afa1-159c327945a9",
                                "text": "„Die Förderung der Wolkenbildung durch den Ionisierungseffekt der kosmischen Strahlung, der günstige Bedingungen für die Kondensation von Wasserdampf in der Atmosphäre schafft.“"
                            },
                            {
                                "example_id": "2c164df1-190e-4d87-87bd-9e12ad646c6c",
                                "sense_id": "cab991c9-f2db-3291-afa1-159c327945a9",
                                "text": "„Es wurde erst ohne weitere Absorption, dann mit steigender Glimmerabsorption bis zum Verschwinden des Ionisierungseffekts gemessen.“"
                            },
                            {
                                "example_id": "32074603-1b33-4c70-aaa7-d5a39824f609",
                                "sense_id": "cab991c9-f2db-3291-afa1-159c327945a9",
                                "text": "„Außerdem verdampft hierbei ein wenig Material an den Materialoberflächen, was einen zusätzlichen Ionisierungseffekt bringt.“"
                            },
                            {
                                "example_id": "32bad319-a78a-4a16-bec6-793f7660f133",
                                "sense_id": "cab991c9-f2db-3291-afa1-159c327945a9",
                                "text": "„In diesem Fall führt die Aufspaltung der Wassertropfen dazu, dass das Haar zwar trocknet, einen Teil der Feuchtigkeit aber aufnimmt – nach dem Föhnen glänzt es und fühlt sich weicher an als nach der Behandlung mit einem Haartrockner ohne Ionisierungseffekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
