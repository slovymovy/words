        "fr-extract.jsonl": [
            {
                "entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
                "word": "persévérance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2410b99f-da14-4a48-b141-49ea177aa86d",
                        "entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
                        "tags": [
                            "plural"
                        ],
                        "form": "persévérances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                        "entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
                        "glosses": [
                            "Qualité ou action de celui qui persévère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d1c894-4225-4920-ab27-41d0bb25f445",
                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                "text": "Ce principe de la philosophie cartésienne « je pense, donc je suis », est ce que les adversaires du cartésianisme ont attaqué avec le plus de persévérance ; et cela se conçoit, car ce principe admis, l'autorité de la conscience et de la raison s'ensuit nécessairement."
                            },
                            {
                                "example_id": "7883f1a8-3d51-47a7-a145-e27957ea6ebd",
                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                "text": "Maintenant que son dessein était arrêté dans sa tête, il n'avait plus qu'à l'exécuter et il n'était pas homme à en changer. La persévérance est une vertu bretonne."
                            },
                            {
                                "example_id": "1505a80c-0b96-4d68-93f5-4e854c5c4230",
                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                "text": "Une telle persévérance, sans garantie de succès, forçait le respect."
                            },
                            {
                                "example_id": "18ab7f7d-e8f7-4a69-9985-be6df60991e7",
                                "sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                                "text": "Car ce que la persévérance nous aide à atteindre à la fin, ce qu'elle nous aide à atteindre toujours, c'est l'estime de soi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "121d5ec1-0785-4f98-9fc9-ebdf5705634f",
                        "source_entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
                        "source_sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                        "target_lang_word": "Ausdauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausdauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8f5637a-0acf-3331-832c-ddddb768ec3e",
                                        "entry_id": "b9cc189d-9415-3f65-9fbc-0e80ead0065f",
                                        "glosses": [
                                            "Fähigkeit, etwas über längere Zeit unnachgiebig, beständig durchzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf74004b-bb4d-4fb8-8b5d-0052e8b4d965",
                                                "sense_id": "c8f5637a-0acf-3331-832c-ddddb768ec3e",
                                                "text": "Mit großer Ausdauer redete er tagelang auf den Chef ein, bis dieser nachgab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c865e22-0009-3aa1-99c7-cd3fe95e3c89",
                                        "entry_id": "b9cc189d-9415-3f65-9fbc-0e80ead0065f",
                                        "glosses": [
                                            "„Widerstandsfähigkeit des Organismus gegen Ermüdung und die schnelle Regenerationsfähigkeit nach einer Belastung“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f883737f-b7ef-4513-b127-5853bb349206",
                                                "sense_id": "1c865e22-0009-3aa1-99c7-cd3fe95e3c89",
                                                "text": "Nach dem Trainingslager hat sich die Ausdauer der Spieler deutlich verbessert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "106bf5e4-ee30-40db-bc0f-938ff445fafd",
                        "source_entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
                        "source_sense_id": "6f083fb3-76ce-38ed-be89-095626037f40",
                        "target_lang_word": "Beharrlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beharrlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                        "entry_id": "f5294214-34d0-39d3-844a-b878fc8dd308",
                                        "glosses": [
                                            "Beharrlichsein; Eigenschaft, beharrlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea4c4ba-58e5-4086-9267-914c6c74dc02",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "Er hatte mit immenser Beharrlichkeit dafür gekämpft, dass die Krankenkasse die Behandlungskosten seiner Tochter übernahm."
                                            },
                                            {
                                                "example_id": "d4881214-0277-429c-8fb2-1263acbad922",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "„Lebensweltlichen Gewissheiten haftet eine Beharrlichkeit an, die sich als Wahrung des Humanen zu erweisen vermag.“"
                                            },
                                            {
                                                "example_id": "f4f1f936-74d1-4d52-9771-aa9ee240921c",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "„Er sah in ihm einen sehr scharf und klar denkenden Verstandesmenschen, der die Macht, zu der ihn seine Energie und seine Beharrlichkeit hatten gelangen lssen, lediglich zum Wohle Russlands benutzte.“"
                                            },
                                            {
                                                "example_id": "b9291546-2cf5-4ab1-be60-33d294175422",
                                                "sense_id": "97b52fa8-a3f5-3891-a659-8c9da870a40e",
                                                "text": "„Diese höchst beleidigende Beharrlichkeit erschien mir ungeheuerlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f56e0598-5a89-40ae-8590-9a0363622421",
                        "source_entry_id": "9ff2679c-5e9b-3c6d-80fc-536d42469e6e",
