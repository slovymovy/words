{
    "word_family": [
        "concentration",
        "concentrated",
        "concentrator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98513def-1d15-3d86-a1e6-39074e244bce",
                    "sense_definition": "To focus one's full thought or attention on a particular activity or subject.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is very hard to <w>concentrate</w> on my homework when the television is so loud.",
                            "target_lang_translations": {
                                "ru": "Очень трудно <w>сосредоточиться</w> на домашнем задании, когда телевизор работает так громко.",
                                "tr": "Televizyon bu kadar yüksek sesliyken ödevime <w>odaklanmak</w> çok zor."
                            }
                        },
                        {
                            "text": "Please try to <w>concentrate</w> hard during the exam so you do not make any mistakes.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, постарайся хорошенько <w>сконцентрироваться</w> во время экзамена, чтобы не допустить ошибок.",
                                "tr": "Hata yapmamak için lütfen sınav sırasında iyice <w>konsantre olmaya</w> çalış."
                            }
                        }
                    ],
                    "synonyms": [
                        "think"
                    ],
                    "common_phrases": [
                        "concentrate hard",
                        "concentrate on work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью сосредоточить свои мысли или внимание на определенной деятельности или предмете.",
                        "tr": "Tüm düşünce veya dikkatini belirli bir etkinliğe veya konuya odaklamak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосредоточиться",
                                "target_lang_sense_clarification": "направить внимание"
                            },
                            {
                                "target_lang_word": "сконцентрироваться",
                                "target_lang_sense_clarification": "собрать мысли"
                            },
                            {
                                "target_lang_word": "сосредоточиваться",
                                "target_lang_sense_clarification": "процесс концентрации внимания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "odaklanmak",
                                "target_lang_sense_clarification": "dikkatini bir noktaya toplamak"
                            },
                            {
                                "target_lang_word": "konsantre olmak",
                                "target_lang_sense_clarification": "kendini bir işe vermek"
                            },
                            {
                                "target_lang_word": "yoğunlaşmak",
                                "target_lang_sense_clarification": "bir konu üzerinde dikkatini toplamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecaafc8d-ea9e-3e02-8d10-939053a58089",
                    "sense_definition": "To bring together or direct toward a common center or objective.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general decided to <w>concentrate</w> his forces at the border to prepare for the defense.",
                            "target_lang_translations": {
                                "ru": "Генерал решил <w>сосредоточить</w> свои силы на границе, чтобы подготовиться к обороне.",
                                "tr": "General, savunmaya hazırlanmak için güçlerini sınırda <w>toplamaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "The lens is designed to <w>concentrate</w> light into a single bright point.",
                            "target_lang_translations": {
                                "ru": "Линза предназначена для того, чтобы <w>концентрировать</w> свет в одну яркую точку.",
                                "tr": "Mercek, ışığı tek bir parlak noktada <w>yoğunlaştırmak</w> için tasarlanmıştır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "concentrate forces",
                        "concentrate efforts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрать вместе или направить к общему центру или цели.",
                        "tr": "Ortak bir merkez veya hedefe doğru bir araya getirmek veya yönlendirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосредоточить",
                                "target_lang_sense_clarification": "собрать в одном месте"
                            },
                            {
                                "target_lang_word": "концентрировать",
                                "target_lang_sense_clarification": "направлять к центру"
                            },
                            {
                                "target_lang_word": "сконцентрировать",
                                "target_lang_sense_clarification": "объединить усилия или силы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "toplamak",
                                "target_lang_sense_clarification": "bir araya getirmek"
                            },
                            {
                                "target_lang_word": "yoğunlaştırmak",
                                "target_lang_sense_clarification": "bir noktada birleştirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "962951df-9de9-346c-8300-8643763e0657",
                    "sense_definition": "To gather or collect in one specific place or area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young people tend to <w>concentrate</w> in cities where there are more job opportunities.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди склонны <w>сосредоточиваться</w> в городах, где больше возможностей для работы.",
                                "tr": "Birçok genç, daha fazla iş imkanının olduğu şehirlerde <w>toplanma</w> eğilimindedir."
                            }
                        },
                        {
                            "text": "The pollution seems to <w>concentrate</w> in the valley because of the surrounding mountains.",
                            "target_lang_translations": {
                                "ru": "Загрязнение, по-видимому, <w>скапливается</w> в долине из-за окружающих гор.",
                                "tr": "Kirlilik, etrafındaki dağlar nedeniyle vadide <w>yoğunlaşıyor</w> gibi görünüyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "concentrate in cities",
                        "concentrate in areas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться или скапливаться в одном определенном месте или области.",
                        "tr": "Belirli bir yerde veya alanda toplanmak veya birikmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концентрироваться",
                                "target_lang_sense_clarification": "скапливаться"
                            },
                            {
                                "target_lang_word": "сосредоточиваться",
                                "target_lang_sense_clarification": "собираться в месте"
                            },
                            {
                                "target_lang_word": "сосредоточиться",
                                "target_lang_sense_clarification": "накопиться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yoğunlaşmak",
                                "target_lang_sense_clarification": "bir bölgede toplanmak"
                            },
                            {
                                "target_lang_word": "toplanmak",
                                "target_lang_sense_clarification": "bir alanda birikmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3741ad95-c692-3f4a-a09f-7d1ae11a9d1a",
                    "sense_definition": "To increase the strength of a substance by removing water or other diluting agents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist had to <w>concentrate</w> the solution by boiling off the excess water.",
                            "target_lang_translations": {
                                "ru": "Химику пришлось <w>концентрировать</w> раствор, выпаривая лишнюю воду.",
                                "tr": "Kimyager, fazla suyu buharlaştırarak çözeltiyi <w>yoğunlaştırmak</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "You can <w>concentrate</w> the juice to make it easier to transport and store.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>сгустить</w> сок, чтобы его было легче перевозить и хранить.",
                                "tr": "Taşımasını ve saklamasını kolaylaştırmak için meyve suyunu <w>koyulaştırabilirsiniz</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "dilute"
                    ],
                    "common_phrases": [
                        "concentrate the solution",
                        "concentrate by evaporation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличить крепость вещества путем удаления воды или других разбавляющих агентов.",
                        "tr": "Su veya diğer seyreltici maddeleri çıkararak bir maddenin yoğunluğunu artırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концентрировать",
                                "target_lang_sense_clarification": "делать раствор гуще"
                            },
                            {
                                "target_lang_word": "сгущать",
                                "target_lang_sense_clarification": "удалять лишнюю жидкость"
                            },
                            {
                                "target_lang_word": "выпаривать",
                                "target_lang_sense_clarification": "увеличивать концентрацию кипячением"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yoğunlaştırmak",
                                "target_lang_sense_clarification": "sıvıyı derişik hale getirmek"
                            },
                            {
                                "target_lang_word": "koyulaştırmak",
                                "target_lang_sense_clarification": "kıvamını artırmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29e8bfe2-42b9-3c82-a75a-b606c534f747",
                    "sense_definition": "A substance that has been made stronger or more pure by removing water or other liquids.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to mix this orange <w>concentrate</w> with three parts water before drinking it.",
                            "target_lang_translations": {
                                "ru": "Вам нужно смешать этот апельсиновый <w>концентрат</w> с тремя частями воды перед употреблением.",
                                "tr": "İçmeden önce bu portakal <w>konsantresini</w> üç ölçek suyla karıştırmanız gerekir."
                            }
                        },
                        {
                            "text": "The factory produces a liquid <w>concentrate</w> that is used to make various cleaning products.",
                            "target_lang_translations": {
                                "ru": "Завод производит жидкий <w>концентрат</w>, который используется для изготовления различных чистящих средств.",
                                "tr": "Fabrika, çeşitli temizlik ürünlerinin yapımında kullanılan sıvı bir <w>konsantre</w> üretiyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "orange concentrate",
                        "liquid concentrate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, ставшее более крепким или чистым после удаления воды или других жидкостей.",
                        "tr": "Su veya diğer sıvılar çıkarılarak daha güçlü veya saf hale getirilmiş madde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концентрат",
                                "target_lang_sense_clarification": "сгущенное вещество"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "konsantre",
                                "target_lang_sense_clarification": "yoğunlaştırılmış madde"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5ed8c898-072b-376e-9218-53ec6522e8fa",
                    "sense_definition": "Being in a <w>concentrated</w> or condensed form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a <w>concentrate</w> yellow pigment to achieve that specific vibrant shade.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>концентрированный</w> желтый пигмент, чтобы добиться этого специфического яркого оттенка.",
                                "tr": "Sanatçı, o özel canlı tonu elde etmek için <w>yoğun</w> bir sarı pigment kullandı."
                            }
                        },
                        {
                            "text": "The recipe calls for a <w>concentrate</w> fluid to be added to the mixture.",
                            "target_lang_translations": {
                                "ru": "Рецепт требует добавления в смесь <w>концентрированной</w> жидкости.",
                                "tr": "Tarif, karışıma <w>konsantre</w> bir sıvının eklenmesini gerektiriyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "concentrate fluid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в концентрированной или конденсированной форме.",
                        "tr": "Yoğunlaştırılmış veya sıkıştırılmış formda olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концентрированный",
                                "target_lang_sense_clarification": "насыщенный"
                            },
                            {
                                "target_lang_word": "сгущенный",
                                "target_lang_sense_clarification": "плотный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "konsantre",
                                "target_lang_sense_clarification": "yoğunlaştırılmış"
                            },
                            {
                                "target_lang_word": "yoğun",
                                "target_lang_sense_clarification": "derişik"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}