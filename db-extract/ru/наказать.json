                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd0ce595-70e5-3793-90d8-9563baa7d62a",
                        "entry_id": "696045d9-b548-3178-96f6-a8db12430fc8",
                        "glosses": [
                            "подвергнуть наказанию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97433ad4-63b8-4f54-bf84-6ec490eaf820",
                                "sense_id": "bd0ce595-70e5-3793-90d8-9563baa7d62a",
                                "text": "Вспомнил он всю жизнь свою и понял, что не за выдранный лист наказал его Господь, а за всю жизнь."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a0ce686-2705-3668-a6a6-a343690a2c68",
                        "entry_id": "696045d9-b548-3178-96f6-a8db12430fc8",
                        "glosses": [
                            "перен. шутл. ввести в излишние расходы, в убыток на какую-либо сумму"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088dc8f9-50fa-46f0-b6f3-bc17e24a7900",
                                "sense_id": "9a0ce686-2705-3668-a6a6-a343690a2c68",
                                "text": "Наказать непослушных автомобилистов рублём."
                            },
                            {
                                "example_id": "f43087a7-f3bf-46b7-8750-9d09c7a7c6e8",
                                "sense_id": "9a0ce686-2705-3668-a6a6-a343690a2c68",
                                "text": "Я не послушалась совета купить билеты заблаговременно и наказала себя на двадцать рублей."
                            }
                        ]
                    },
                    {
                        "sense_id": "889ed7c3-bce2-3eb1-b87a-f41a877946af",
                        "entry_id": "696045d9-b548-3178-96f6-a8db12430fc8",
                        "glosses": [
                            "устар. дать наказ, велеть, поручить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7106ca16-25ee-4829-b381-ceef5f3ce67a",
                                "sense_id": "889ed7c3-bce2-3eb1-b87a-f41a877946af",
                                "text": "Мать наказала дочери вымыть окна."
                            }
                        ]
                    },
                    {
                        "sense_id": "16ac453b-83fb-3d48-8347-18a2321f2491",
                        "entry_id": "696045d9-b548-3178-96f6-a8db12430fc8",
                        "glosses": [
                            "прост. каким-то образом ухудшить положение человека: финансовое, в игре и т.п., часто неожиданно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e892b8-2ab4-4da9-8591-f740bb9b76d8",
                                "sense_id": "16ac453b-83fb-3d48-8347-18a2321f2491",
                                "text": "Я его наказал в теннис."
                            },
                            {
                                "example_id": "5af4f944-4b02-4ac3-b67c-8ea6f9d5e680",
                                "sense_id": "16ac453b-83fb-3d48-8347-18a2321f2491",
                                "text": "За подобный проступок его тогда наказали на 1000 рублей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1bb62ef-609f-4c4e-8796-75b3011191b6",
