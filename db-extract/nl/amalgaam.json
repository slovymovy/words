        "nl-extract.jsonl": [
            {
                "entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
                "word": "amalgaam",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9a90d728-2b62-4946-a7dc-eed7d433e672",
                        "entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
                        "tags": [
                            "plural"
                        ],
                        "form": "amalgamen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b2bf533-5c0d-3d19-9b79-805a2ce15c76",
                        "entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
                        "glosses": [
                            "legering van kwikzilver en een ander metaal, bijvoorbeeld zilver, vroeger veel gebruikt voor vullingen van kiezen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c52914ad-cf1c-30d8-9fd3-3f0e65591510",
                        "entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
                        "glosses": [
                            "mengelmoes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bbf72e9-be69-4832-98b4-bb52c53779d4",
                                "sense_id": "c52914ad-cf1c-30d8-9fd3-3f0e65591510",
                                "text": "Malodetto's geschiedenis over quarantaine, een inrichting voor geesteszieken en ruïnes is een amalgaam van echte lagune-eilanden - sommige zijn de thuisbasis voor mensen, andere voor ruïnes, weer andere zijn lang geleden verloren gegaan."
                            },
                            {
                                "example_id": "5c37a42b-8993-4f85-8597-98bc54cadf86",
                                "sense_id": "c52914ad-cf1c-30d8-9fd3-3f0e65591510",
                                "text": "'Vanaf nu,' verklaarde hij, 'zijn zowel tijd als ruimte geen opzichzelfstaande fenomenen meer; alleen een soort amalgaam van beide heeft werkelijk bestaansrecht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2b1d13-36de-40fb-a3e0-f545b4b3ff5b",
                        "source_entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
                        "source_sense_id": "9b2bf533-5c0d-3d19-9b79-805a2ce15c76",
                        "source_sense_description": "kwiklegering",
                        "target_lang_word": "Amalgam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amalgam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58f60618-123a-3552-96ac-5b8f92cd954f",
                                        "entry_id": "0f8fe7fa-e513-370c-a4af-f1ed90f463d2",
                                        "glosses": [
                                            "eine Legierung auf Quecksilber-Basis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a5ce63-6c2b-4bf7-9f1e-1423c5752993",
                                                "sense_id": "58f60618-123a-3552-96ac-5b8f92cd954f",
                                                "text": "„Ob Amalgam, Gold oder Kunststoff – die Geschichte der Zahnmedizin kennt so einige Füllstoffe für schmerzende Kauleisten.“"
                                            },
                                            {
                                                "example_id": "92f74377-d520-4e2e-9b53-259cf4569fa2",
                                                "sense_id": "58f60618-123a-3552-96ac-5b8f92cd954f",
                                                "text": "„In anderen Bereichen, etwa bei der industriellen Produktion von Chlor, seien die Emissionen hingegen deutlich zurückgegangen. Noch bis vor einigen Jahren wurde Chlor vor allem mithilfe des Amalgam-Verfahrens erzeugt. Dabei dient Quecksilber dazu, Chlor aus einer Kochsalzlösung zu isolieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c38e2ef7-567a-3d96-960f-8b73185c9c75",
                                        "entry_id": "0f8fe7fa-e513-370c-a4af-f1ed90f463d2",
                                        "glosses": [
                                            "Vereinigung oder Verbindung mehrerer (kultureller, politischer, abstrakter, Kunst-)Elemente; Mischung; Gemisch"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "119548c5-aa94-466c-9ff9-7def44012437",
                                                "sense_id": "c38e2ef7-567a-3d96-960f-8b73185c9c75",
                                                "text": "„An dieser Stelle verbindet sich Agambens aufrichtige Liebe zu Kojève mit seiner eigenen, aus Heidegger (und ein wenig Marx) präparierten Zeitdiagnose. Sie lautet: Europa ist von einem Amalgam aus Politik, Medien und Ökonomie bedroht, und dieses Amalgam zerfrisst die kommunikative Substanz der Kultur (Die kommende Gemeinschaft, Merve Verlag).“"
                                            },
                                            {
                                                "example_id": "ed2d0427-db8a-4daa-9fa2-9473a163c82d",
                                                "sense_id": "c38e2ef7-567a-3d96-960f-8b73185c9c75",
                                                "text": "„\"Wenn du die Welt nicht verändern kannst, veränder' dich selbst/ Wenn du dich selbst nicht verändern kannst, dann änder' die Welt\", ein Amalgam aus Aristoteles, Schopenhauer und Gandhi.“"
                                            },
                                            {
                                                "example_id": "870f27ef-ad05-4ed1-958a-20965a476412",
                                                "sense_id": "c38e2ef7-567a-3d96-960f-8b73185c9c75",
                                                "text": "„Und auch als mit den Saken und den Yüe-Chi in den kommenden Jahrhunderten weitere Völker aus den zentralasiatischen Steppen in das Industal einfielen, blieb dieses kulturelle Amalgam bestehen.“"
                                            },
                                            {
                                                "example_id": "a7f3559d-d2c7-4b61-9b2e-18f783492d90",
                                                "sense_id": "c38e2ef7-567a-3d96-960f-8b73185c9c75",
                                                "text": "„Die Kompanie war ein in der neueren Geschichte bisweilen anzutreffendes Amalgam aus Aktiengesellschaft und krimineller Vereinigung, wobei sich beide Aspekte wechselseitig verstärkten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b1e60b5-d9d5-4900-b98a-cc2df0333551",
                        "source_entry_id": "a3cc1f4e-eaf5-3025-be62-db047a616f49",
