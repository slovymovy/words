                "senses": [
                    {
                        "sense_id": "7bc06ccf-61b7-3983-a63f-fef80c29d23a",
                        "entry_id": "88376b6a-b0e8-391e-800d-e96ea8884513",
                        "glosses": [
                            "Of or pertaining to James Joyce (1882–1941) or his writings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1eb306-eeb5-447b-8987-9505d8e9b9a6",
                                "sense_id": "7bc06ccf-61b7-3983-a63f-fef80c29d23a",
                                "text": "Even Muldoon's fans find some of the “difficulty” of this pyrotechnical erudition too playful, suspecting him of a Joycean desire to “keep the professors busy”."
                            },
                            {
                                "example_id": "40cbfd59-d2ac-40e3-aff8-c9a200af782f",
                                "sense_id": "7bc06ccf-61b7-3983-a63f-fef80c29d23a",
                                "text": "Around the world these days there are thousands of Joycean scholars who make their living parsing and reparsing the great man who, perhaps much to his chagrin if he were alive, has become a symbol of all things Irish to millions."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea5f7585-d7aa-347a-8201-1ab54f0d9c4a",
                        "entry_id": "88376b6a-b0e8-391e-800d-e96ea8884513",
                        "glosses": [
                            "In a verbally inventive style similar to that of James Joyce."
                        ],
                        "tags": [
                            "of writing"
                        ],
                        "examples": [
                            {
                                "example_id": "57ece040-18ed-4c6e-8e56-76d68ea844d8",
                                "sense_id": "ea5f7585-d7aa-347a-8201-1ab54f0d9c4a",
                                "text": "Jimson is a total nonconformist and his god is William Blake, whom he quotes endlessly in his somewhat Joycean interior monologues."
                            }
                        ]
                    }
                ],
