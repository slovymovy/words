                ],
                "senses": [
                    {
                        "sense_id": "82d7872b-bbf6-3b8a-bb56-4fcfbf2de99c",
                        "entry_id": "35d8ee2b-b743-3137-ba4e-989d0ec12b67",
                        "glosses": [
                            "Person, die – meist unschöpferisch – schriftstellerisch tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5016f54-8ec5-4550-901e-5f8f5fcffc24",
                                "sense_id": "82d7872b-bbf6-3b8a-bb56-4fcfbf2de99c",
                                "text": "„Insbesondere junge Literaten des Expressionismus machten ihrem Verdruß über die verknöcherte Gesellschaft durch Herbeirufen der Apokalypse Luft.“"
                            },
                            {
                                "example_id": "0076a2b0-3e81-45d8-9954-300055830036",
                                "sense_id": "82d7872b-bbf6-3b8a-bb56-4fcfbf2de99c",
                                "text": "„Es gebe nichts Gefährlicheres, als auf die Ratschläge dieser meist geschiedenen, akademisch gescheiterten Literaturwissenschaftler oder gar Literaten aus dem Ausland zu hören, hatte meine finnische Frau mich noch am Frühstückstisch gewarnt.“"
                            },
                            {
                                "example_id": "2b4af67e-2ebd-447e-8c12-32903b282613",
                                "sense_id": "82d7872b-bbf6-3b8a-bb56-4fcfbf2de99c",
                                "text": "„Ein englischer Literat hätte über die Schlägerei bestimmt anders, spannender geschrieben.“"
                            },
                            {
                                "example_id": "8238a689-f3ce-476a-8466-9c810cc0da58",
                                "sense_id": "82d7872b-bbf6-3b8a-bb56-4fcfbf2de99c",
                                "text": "„Armin T. Wegner war mehr unter Literatenzu sehen als auf der Universität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
