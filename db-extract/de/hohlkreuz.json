                "senses": [
                    {
                        "sense_id": "f2595540-9b3b-370a-a12b-c0a583ed8701",
                        "entry_id": "5bf86efd-51bb-3d39-8025-5d354d8e8f99",
                        "glosses": [
                            "nach vorn gerichtete, stark geprägte Verkrümmung der Wirbelsäule im Bereich der Lendenwirbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bc839bb-a004-4b81-9191-6fc7a3a0cd81",
                                "sense_id": "f2595540-9b3b-370a-a12b-c0a583ed8701",
                                "text": "Im fortgeschrittenen Stadium kann ein Hohlkreuz Rückenschmerzen verursachen."
                            },
                            {
                                "example_id": "e2d529cd-0363-4535-82cc-8f5c620a6e96",
                                "sense_id": "f2595540-9b3b-370a-a12b-c0a583ed8701",
                                "text": "„Neben dem Rundrücken ist das Hohlkreuz ein in der Bevölkerung häufig vorkommender Haltungstyp, der Männer und Frauen gleichermaßen betrifft. Etwa 80 % aller Menschen haben ein mehr oder weniger stark ausgeprägtes Hohlkreuz, das in vielen Fällen nicht behandlungsbedürftig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
