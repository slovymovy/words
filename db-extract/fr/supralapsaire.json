                        "glosses": [
                            "Ayant eu lieu avant la chute, tirant son origine d'avant la chute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "110e9bcc-40d1-4579-8557-511d74279fed",
                                "sense_id": "079cd0cd-62e4-3b22-8d39-ee9ba61161f2",
                                "text": "Si nous admettons une prédestination pour le bien supralapsaire, d'après ce même texte et parce que l'opposition est réelle, nous sommes obligés d'admettre une réprobation supralapsaire"
                            }
                        ]
                    },
                    {
                        "sense_id": "ed9d191c-b95e-356f-85c8-6403d6383487",
                        "entry_id": "24f6977e-a818-3a84-b1dc-43ce76455a14",
                        "glosses": [
                            "Relatif à la croyance que Dieu, avant la chute d’Adam, avait destiné à la damnation un certain nombre des hommes à venir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0750754a-3cdd-455d-96d0-f2affa2e3894",
                                "sense_id": "ed9d191c-b95e-356f-85c8-6403d6383487",
                                "text": "Au synode de Dordrecht (1618-1619), les arminiens ou remonstrants, contestant la prédestination calvinienne, furent condamnés et la thèse supralapsaire adoptée.,"
                            }
                        ]
                    }
