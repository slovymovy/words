                    {
                        "sense_id": "b4e6e2ca-b643-38cf-a150-ca4ca5c2cb2c",
                        "entry_id": "ab0ffbfa-3c09-3377-b158-f776ea18480b",
                        "glosses": [
                            "Entleerung der Harnblase"
