{
    "word_family": [
        "foot",
        "foothold",
        "footprint",
        "footstep",
        "underfoot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1bd1f573-e8b4-3cdc-91b3-a92893e67f66",
                    "sense_definition": "A secure grip or balance for the feet, especially when walking or climbing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_balance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lost his <w>footing</w> on the icy path and tumbled into the snow.",
                            "target_lang_translations": {
                                "de": "Er verlor auf dem vereisten Pfad den <w>Halt</w> und stürzte in den Schnee."
                            }
                        },
                        {
                            "text": "The steep trail made it difficult for the hikers to keep their <w>footing</w>.",
                            "target_lang_translations": {
                                "de": "Der steile Pfad machte es den Wanderern schwer, einen <w>festen Stand</w> zu behalten."
                            }
                        }
                    ],
                    "synonyms": [
                        "grip",
                        "purchase"
                    ],
                    "common_phrases": [
                        "lose footing",
                        "keep footing",
                        "firm footing",
                        "sure footing"
                    ],
                    "target_lang_definitions": {
                        "de": "Sicherer Stand, Halt oder Gleichgewicht der Füße, besonders beim Gehen oder Klettern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Halt",
                                "target_lang_sense_clarification": "physischer Halt der Füße"
                            },
                            {
                                "target_lang_word": "fester Stand",
                                "target_lang_sense_clarification": "stabiler Stand der Füße"
                            },
                            {
                                "target_lang_word": "Gleichgewicht",
                                "target_lang_sense_clarification": "Standfestigkeit beim Gehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81916897-1983-336b-be0b-d88db373f717",
                    "sense_definition": "An established position, status, or secure base within a group, market, or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "status_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young company struggled to gain a <w>footing</w> in the competitive technology market.",
                            "target_lang_translations": {
                                "de": "Das junge Unternehmen tat sich schwer damit, im wettbewerbsintensiven Technologiemarkt <w>Fuß zu fassen</w>."
                            }
                        },
                        {
                            "text": "After months of negotiations, the diplomat finally secured a solid <w>footing</w> in the talks.",
                            "target_lang_translations": {
                                "de": "Nach monatelangen Verhandlungen sicherte sich der Diplomat schließlich eine solide <w>Position</w> bei den Gesprächen."
                            }
                        }
                    ],
                    "synonyms": [
                        "foothold",
                        "standing"
                    ],
                    "common_phrases": [
                        "gain a footing",
                        "secure a footing"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine gefestigte Position, ein Status oder eine sichere Ausgangsbasis innerhalb einer Gruppe, eines Marktes oder einer Situation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Standbein",
                                "target_lang_sense_clarification": "übertragen, wirtschaftlich"
                            },
                            {
                                "target_lang_word": "Position",
                                "target_lang_sense_clarification": "gefestigte Stellung"
                            },
                            {
                                "target_lang_word": "feste Basis",
                                "target_lang_sense_clarification": "gesicherter Ausgangspunkt"
                            },
                            {
                                "target_lang_word": "Fuß",
                                "target_lang_sense_clarification": "in Fuß fassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6912418e-00bc-3c13-ac1e-dc3263baac44",
                    "sense_definition": "A relative condition, relationship, or basis on which individuals or groups interact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "status_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both sides wanted to place their business relationship on an equal <w>footing</w>.",
                            "target_lang_translations": {
                                "de": "Beide Seiten wollten ihre Geschäftsbeziehung auf <w>Augenhöhe</w> gestalten."
                            }
                        },
                        {
                            "text": "The peace treaty helped put the neighboring countries on a friendly <w>footing</w>.",
                            "target_lang_translations": {
                                "de": "Der Friedensvertrag trug dazu bei, das Verhältnis der Nachbarländer auf eine freundschaftliche <w>Basis</w> zu stellen."
                            }
                        }
                    ],
                    "synonyms": [
                        "standing",
                        "basis"
                    ],
                    "common_phrases": [
                        "equal footing",
                        "friendly footing"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Verhältnis, der Zustand oder die Grundlage, auf der Personen oder Gruppen miteinander interagieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Basis",
                                "target_lang_sense_clarification": "Verhältnis oder Ebene"
                            },
                            {
                                "target_lang_word": "Grundlage",
                                "target_lang_sense_clarification": "Ausgangsbasis für Beziehungen"
                            },
                            {
                                "target_lang_word": "Augenhöhe",
                                "target_lang_sense_clarification": "Gleichberechtigung, z.B. equal footing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfc7cf26-9b2f-342d-ac1f-cf87fe898281",
                    "sense_definition": "A physical surface or place where one can safely place their foot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_balance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain climber searched the cliff for a reliable <w>footing</w>.",
                            "target_lang_translations": {
                                "de": "Der Bergsteiger suchte die Felswand nach einem verlässlichen <w>Tritt</w> ab."
                            }
                        },
                        {
                            "text": "The narrow ledge provided just enough <w>footing</w> to rest for a moment.",
                            "target_lang_translations": {
                                "de": "Der schmale Felsvorsprung bot gerade genug <w>Standfläche</w>, um einen Moment auszuruhen."
                            }
                        }
                    ],
                    "synonyms": [
                        "foothold"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine physische Fläche oder Stelle, auf die man den Fuß sicher aufsetzen kann."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Tritt",
                                "target_lang_sense_clarification": "beim Klettern"
                            },
                            {
                                "target_lang_word": "Trittfläche",
                                "target_lang_sense_clarification": "Fläche zum Auftreten"
                            },
                            {
                                "target_lang_word": "Standfläche",
                                "target_lang_sense_clarification": "Fläche für sicheren Stand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4bd73d5-a0de-381e-aff8-6c7ecedb4c25",
                    "sense_definition": "The widened concrete or masonry base that supports a foundation wall or column.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew poured concrete into the trench to create a solid <w>footing</w>.",
                            "target_lang_translations": {
                                "de": "Die Bauarbeiter gossen Beton in den Graben, um ein solides <w>Fundament</w> zu schaffen."
                            }
                        },
                        {
                            "text": "Engineers discovered a crack running through the house's foundation <w>footing</w>.",
                            "target_lang_translations": {
                                "de": "Ingenieure entdeckten einen Riss, der durch den <w>Fundamentfuß</w> des Hauses verlief."
                            }
                        }
                    ],
                    "synonyms": [
                        "foundation"
                    ],
                    "common_phrases": [
                        "concrete footing"
                    ],
                    "target_lang_definitions": {
                        "de": "Der verbreiterte Sockel aus Beton oder Mauerwerk, der eine Fundamentwand oder Pfeiler stützt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fundamentfuß",
                                "target_lang_sense_clarification": "Bauwesen"
                            },
                            {
                                "target_lang_word": "Einzelfundament",
                                "target_lang_sense_clarification": "Bauwesen"
                            },
                            {
                                "target_lang_word": "Streifenfundament",
                                "target_lang_sense_clarification": "unter Wänden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f3f7270-1d64-3c68-af14-e1aa6f2f4a73",
                    "sense_definition": "The act of calculating the total of a column of numbers, or the sum total itself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auditor checked the final <w>footing</w> at the bottom of the ledger column.",
                            "target_lang_translations": {
                                "de": "Der Wirtschaftsprüfer überprüfte die abschließende <w>Spaltensumme</w> am Ende der Hauptbuchspalte."
                            }
                        },
                        {
                            "text": "An error was discovered during the regular <w>footing</w> of the sales records.",
                            "target_lang_translations": {
                                "de": "Beim regelmäßigen <w>Aufsummieren</w> der Verkaufsbelege wurde ein Fehler entdeckt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Addieren einer Zahlenspalte im Rechnungswesen oder die resultierende Gesamtsumme."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Spaltensumme",
                                "target_lang_sense_clarification": "Buchhaltung"
                            },
                            {
                                "target_lang_word": "Aufsummieren",
                                "target_lang_sense_clarification": "Buchhaltung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9dfe15-4b73-3274-95fc-bab6406e87cc",
                    "sense_definition": "The sound of a tread, step, or walking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She paused in the dark corridor, startled by the soft <w>footing</w> behind her.",
                            "target_lang_translations": {
                                "de": "Sie hielt im dunklen Flur inne, erschreckt durch die leisen <w>Schritte</w> hinter sich."
                            }
                        },
                        {
                            "text": "The measured <w>footing</w> of the night watchman echoed across the empty street.",
                            "target_lang_translations": {
                                "de": "Der gemessene <w>Schritt</w> des Nachtwächters hallte durch die leere Straße wider."
                            }
                        }
                    ],
                    "synonyms": [
                        "footstep",
                        "tread"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Geräusch von Schritten oder des Gehens."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schritt",
                                "target_lang_sense_clarification": "Schrittgeräusch"
                            },
                            {
                                "target_lang_word": "Tritt",
                                "target_lang_sense_clarification": "Trittschall"
                            },
                            {
                                "target_lang_word": "Gang",
                                "target_lang_sense_clarification": "Art des Auftretens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb14260-39d0-38be-93ea-a3429fb4334a",
                    "sense_definition": "A footprint or set of tracks left by someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters quietly tracked the animal by following its fresh <w>footing</w> in the mud.",
                            "target_lang_translations": {
                                "de": "Die Jäger folgten lautlos dem Tier anhand seiner frischen <w>Fährte</w> im Schlamm."
                            }
                        },
                        {
                            "text": "Heavy snow soon covered every faint <w>footing</w> left along the forest trail.",
                            "target_lang_translations": {
                                "de": "Dichter Schnee bedeckte bald jede schwache <w>Spur</w>, die entlang des Waldwegs hinterlassen worden war."
                            }
                        }
                    ],
                    "synonyms": [
                        "footprint",
                        "track"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Fußabdruck oder eine Fährte, die von Menschen oder Tieren hinterlassen wurde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fährte",
                                "target_lang_sense_clarification": "Spur von Tieren oder Menschen"
                            },
                            {
                                "target_lang_word": "Fußspur",
                                "target_lang_sense_clarification": "Abdruck im Boden"
                            },
                            {
                                "target_lang_word": "Spur",
                                "target_lang_sense_clarification": "hinterlassene Abdrücke"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ed98ef1-970b-3f14-a2e8-51a688dde211",
                    "sense_definition": "present participle and gerund of <w>foot</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university ended up <w>footing</w> the bill for the guest speaker's expenses.",
                            "target_lang_translations": {
                                "de": "Am Ende <w>beglich</w> die Universität die Rechnung für die Spesen des Gastredners."
                            }
                        },
                        {
                            "text": "He complained about <w>footing</w> all the maintenance costs by himself.",
                            "target_lang_translations": {
                                "de": "Er beschwerte sich darüber, alle Instandhaltungskosten alleine <w>tragen</w> zu müssen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "footing the bill"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von »foot« (die Rechnung begleichen oder übernehmen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "übernehmen",
                                "target_lang_sense_clarification": "die Kosten übernehmen"
                            },
                            {
                                "target_lang_word": "begleichen",
                                "target_lang_sense_clarification": "eine Rechnung begleichen"
                            },
                            {
                                "target_lang_word": "zahlen",
                                "target_lang_sense_clarification": "bezahlen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}