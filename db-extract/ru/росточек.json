                ],
                "senses": [
                    {
                        "sense_id": "e9118e1a-117e-3e54-bb4d-3ad857d80015",
                        "entry_id": "3dc66c7f-a444-3a68-b667-307d2ee1b91a",
                        "glosses": [
                            "разг. уменьш.-ласк. к росток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e3dd24-4272-45fb-9b5e-b934a6048a3c",
                                "sense_id": "e9118e1a-117e-3e54-bb4d-3ad857d80015",
                                "text": "[Пётр Степанович Латышев] дышал … на каждый росточек и колосочек, выводя какие-то сорта овощей, хлебушек сея."
                            },
                            {
                                "example_id": "eb302619-ad68-494a-a39c-7a1687af542f",
                                "sense_id": "e9118e1a-117e-3e54-bb4d-3ad857d80015",
                                "text": "— Из зёрнышка да росточек, из яичка да пташечка!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f1a3fc7-6e14-3ffc-8c23-5d130683e3c6",
                        "entry_id": "3dc66c7f-a444-3a68-b667-307d2ee1b91a",
                        "glosses": [
                            "разг. уменьш. к рост"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48fd2b29-085a-49ef-a6ed-808d72de8a8a",
                                "sense_id": "5f1a3fc7-6e14-3ffc-8c23-5d130683e3c6",
                                "text": "Задопятов усядется ― выше он всех: великан; встанет ― средний росточек: коротконожка какая-то…"
                            },
                            {
                                "example_id": "56f735ba-680f-4a5b-a1bf-3ca4f9c6a5ab",
                                "sense_id": "5f1a3fc7-6e14-3ffc-8c23-5d130683e3c6",
                                "text": "Карлик-чудовище (он ведь был малюсенького росточка!)…"
                            },
                            {
                                "example_id": "b52a7b80-2b48-409f-b90c-3dcdc9003ae7",
                                "sense_id": "5f1a3fc7-6e14-3ffc-8c23-5d130683e3c6",
                                "text": "Небольшого росточка скуластенькая девушка не спеша ходила вдоль своих машин."
                            }
                        ]
                    }
                ],
