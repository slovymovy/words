                "forms": [],
                "senses": [
                    {
                        "sense_id": "81b60218-467f-3d70-bb42-468626f29e1f",
                        "entry_id": "629d5347-c577-386d-b6b7-b0205e37fdc1",
                        "glosses": [
                            "terughoudendheid of voorzichtigheid in de omgang met mensen, vooral onbekenden, door innerlijke onzekerheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47670104-da5e-470a-af06-1a123e75ac49",
                                "sense_id": "81b60218-467f-3d70-bb42-468626f29e1f",
                                "text": "Buiten Haarlem zou hij niet durven gaan. Dat was zijn bloheid, zijn vrees voor alles wat hij niet kende."
                            },
                            {
                                "example_id": "7587760e-e071-4e19-ba75-91c2912cbcfb",
                                "sense_id": "81b60218-467f-3d70-bb42-468626f29e1f",
                                "text": "Verscheen voor de eerste maal Annet\nals dorpeling met hooggekleurde wangen\nop 't Cercle, en zat ze er stom - na weinig zuchten werd\nhaar keursje ruim genoeg, haar tong vrij. Op 't Concert\nde week daaraan... was bloheid reeds vervangen\ndoor spraakzaamheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf1b3a5-dfbd-33da-ba83-4a954f81ff96",
                        "entry_id": "629d5347-c577-386d-b6b7-b0205e37fdc1",
                        "glosses": [
                            "overdreven behoedzaamheid uit angst voor gevaar"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6b4c4ea0-dc01-4cf1-87ed-f960851a66bd",
                                "sense_id": "fcf1b3a5-dfbd-33da-ba83-4a954f81ff96",
                                "text": "Elke lauwheid tegenover die dreiging betekent angst en bloheid, Johan de Witt heeft eens gezegd, dat ‘de bloode ende vertsaechde herten geenen beteren deckmantel en hebben als het voorwensel van politycke voorsigchtigheydt’."
                            }
                        ]
                    }
