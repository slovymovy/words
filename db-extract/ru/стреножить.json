                ],
                "senses": [
                    {
                        "sense_id": "57f74ead-73b8-3bd0-88c3-45bb0c4def01",
                        "entry_id": "83477b6f-2fec-3838-ac78-e0dfa101e8e9",
                        "glosses": [
                            "связать путами (треногой) ноги лошади (обе передние с одной задней или только передние)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa287666-5a34-4922-976a-ee0dd3a8fa32",
                                "sense_id": "57f74ead-73b8-3bd0-88c3-45bb0c4def01",
                                "text": "Стреножили коней, отпустили на корм, собрали аргалу, развели огонек, сварили чай, закусили."
                            }
                        ]
                    },
                    {
                        "sense_id": "bda9b4bf-597e-3321-84c9-0dcdc8079821",
                        "entry_id": "83477b6f-2fec-3838-ac78-e0dfa101e8e9",
                        "glosses": [
                            "перен. ограничить в возможностях, лишить свободы действий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3f876c-5f7e-4a7b-b686-6de8fa3b989c",
                                "sense_id": "bda9b4bf-597e-3321-84c9-0dcdc8079821",
                                "text": "Да и мужиков немножко стреножат, дети все-таки, может, на какую бутылку меньше выпьют."
                            }
                        ]
                    }
                ],
