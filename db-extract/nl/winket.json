                "translations": [
                    {
                        "translation_id": "d5338e55-99a2-4dfd-b26d-5f0913227685",
                        "source_entry_id": "8cdbb1bc-a851-332b-94ec-bf1a52b1057d",
                        "source_sense_id": "d4cb826c-cc0a-33f2-aa98-4725c5b8abe8",
