                ],
                "senses": [
                    {
                        "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                        "entry_id": "5926f8a4-24a3-3607-944d-f51623105d10",
                        "glosses": [
                            "Teil des Verbalsystems, der die grammatische Kategorie Aspekt gestaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9ebfc0-d19a-48dd-aa35-31134182177a",
                                "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                                "text": "„Nicht zuletzt haben die verbalen Präfixe unter dem Einfluss des sogenannten slawischen Aspektsystems ihre Bedeutungen im Vergleich zum Deutschen stark erweitert, ohne dass jedoch das slawische System vollständig übernommen wurde.“"
                            },
                            {
                                "example_id": "5df94435-353f-479b-b819-258ff6cca089",
                                "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                                "text": "„Ein Beispiel aus der Grammatik wäre das Tempus-/Aspektsystem des Deutschen und Englischen.“"
                            },
                            {
                                "example_id": "95c856a2-30b4-4d7e-9f1d-4ea5421b5ee9",
                                "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                                "text": "„Die unterschiedlichen Konzeptualisierungsmuster scheinen abhängig vom grammatischen Aspektsystem einer Sprache zu sein.“"
                            },
                            {
                                "example_id": "9eb88bd6-fcbb-4950-88f9-a489bbffb00c",
                                "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                                "text": "„Dies wird wird von Isačenko auch gar nicht bestritten, jedoch geht in seiner Theorie die oft für das Russische und andere slawische Sprachen angenommene weitgehende Symmetrie des Aspektsystems verloren.“"
                            },
                            {
                                "example_id": "a8c35e57-b88e-4354-9326-4da9d7d70c91",
                                "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                                "text": "„Das Projekt setzt sich zum Ziel, Wandel und Stabilität von Aspektsystemen zu untersuchen.“"
                            },
                            {
                                "example_id": "0cfc0cec-a59e-4b5a-9b29-1094f57cd96a",
                                "sense_id": "b9d90dc9-15a0-3cf3-b54b-9395773c33cf",
                                "text": "„Das Jiddische bildet dieses so genannte slawische Aspektsystem mit den Mitteln der Deutschen Komponente jedoch nur in Ansätzen nach, nämlich durch den Gebrauch bestimmter Präfixe, durch eine Reihe von Hilfsverben und durch die oben erwähnte Stammkonstruktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
