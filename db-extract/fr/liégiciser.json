                        "glosses": [
                            "Pourrir par les magouilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee248f6-02ae-4c65-b86b-effcc74e077f",
                                "sense_id": "71651ee3-1d90-3b78-b1d5-66dde47d9b27",
                                "text": "Liégiciser (on dit tout aussi bien « bruxelliser ») une ville signifie la pourrir de magouilles financières, immobilières et politiques."
                            },
                            {
                                "example_id": "c921f95a-525f-4b38-9230-d07c4ae988a3",
                                "sense_id": "71651ee3-1d90-3b78-b1d5-66dde47d9b27",
                                "text": "Est-ce de là que vient la formule liégiciser (de Liège et de pourrir de l'intérieur par les affaires, les malversations, etc.)?"
                            }
                        ]
                    }
