                        ]
                    },
                    {
                        "translation_id": "8daa3ea8-9000-48ee-8d78-2afeca97efb6",
                        "source_entry_id": "c0899eba-2723-34b6-9364-b0280c69c082",
                        "source_sense_id": "9dbc6204-32ba-3659-a166-0a35429673f8",
                        "source_sense_description": "lichtdroevig gestemd",
                        "target_lang_word": "melancholic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melancholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8013f1e5-bc0c-3aa1-8c30-88d79551da16",
                                        "entry_id": "2b56e615-2522-30e0-91af-503d44d1496c",
                                        "glosses": [
                                            "Filled with or affected by melancholy—great sadness or depression, especially of a thoughtful or introspective nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "436d42eb-e923-4ec1-b81b-d44097625193",
                                                "sense_id": "8013f1e5-bc0c-3aa1-8c30-88d79551da16",
                                                "text": "Just as the melancholic eye / Sees fleets and armies in the sky."
                                            },
                                            {
                                                "example_id": "caf77d12-88bf-4e04-9ab6-bf0be2509762",
                                                "sense_id": "8013f1e5-bc0c-3aa1-8c30-88d79551da16",
                                                "text": "But he was also a natural chronicler: one senses that, even as his schemes collapsed, this aesthetic Arab Quixote knew the stories would make great material for his witty, sharp, melancholic writings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d709af4-216b-34ee-bf8c-e1c5a5dd386f",
                                        "entry_id": "2b56e615-2522-30e0-91af-503d44d1496c",
                                        "glosses": [
                                            "Pertaining to black bile (melancholy)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fdb0d28-0662-364b-8f1c-9da8f4fe384a",
                                        "entry_id": "2b56e615-2522-30e0-91af-503d44d1496c",
                                        "glosses": [
                                            "Pertaining to the melancholic temperament or its associated personality traits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "melancholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60b35bf9-41d2-3eea-ae34-b8249708e020",
                                        "entry_id": "4fe8e49e-39fc-34d8-8151-10fbfd428d20",
                                        "glosses": [
                                            "A person who is habitually melancholy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded7b1bf-00ea-4e1a-916e-2363a5f3dc5e",
                                                "sense_id": "60b35bf9-41d2-3eea-ae34-b8249708e020",
                                                "text": "Kafka, Hart Crane, Jackson Pollock, Tennessee Williams, Mark Rothko, melancholics all, so why shouldn’t we accept our own bleakness and take long walks in the winter woods and look at the gnarled limbs of trees and struggle with the inscrutable and accept the beauty of permanent turmoil?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a58878b-ea5c-4572-b559-be0000b9c33f",
                        "source_entry_id": "c0899eba-2723-34b6-9364-b0280c69c082",
                        "source_sense_id": "9dbc6204-32ba-3659-a166-0a35429673f8",
                        "source_sense_description": "lichtdroevig gestemd",
                        "target_lang_word": "wistful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wistful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e45a521-ee14-374f-a8c6-84e7801b5e63",
                                        "entry_id": "23e5262c-c0fd-3acd-987a-1e35ea39f298",
                                        "glosses": [
                                            "Full of longing or yearning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51bc290-13fb-4984-9656-f7afb7d4670b",
                                                "sense_id": "1e45a521-ee14-374f-a8c6-84e7801b5e63",
                                                "text": "His eyes grew wistful as he recalled his university days."
                                            },
                                            {
                                                "example_id": "c2e51cac-79a4-4e17-870a-d40682cfab70",
                                                "sense_id": "1e45a521-ee14-374f-a8c6-84e7801b5e63",
                                                "text": "Her grey eyes, looking out on the violet of the night sky, the trees, and the crowd of hilarious onlookers who had not been invited to Buckingham Palace, had a patient and wistful expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b3f9b9-576c-3842-ad92-515ff2029a47",
                                        "entry_id": "23e5262c-c0fd-3acd-987a-1e35ea39f298",
                                        "glosses": [
                                            "Sad and thoughtful."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a86a9fbb-ae05-4da6-b639-bc46c03205e0",
                        "source_entry_id": "c0899eba-2723-34b6-9364-b0280c69c082",
                        "source_sense_id": "9dbc6204-32ba-3659-a166-0a35429673f8",
                        "source_sense_description": "lichtdroevig gestemd",
                        "target_lang_word": "mélancolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mélancolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05506c49-0716-30ff-ab75-56b66c4ddd91",
                                        "entry_id": "12553d56-d0aa-3578-ba20-16c1e707c45e",
                                        "glosses": [
                                            "Qui se livre à la mélancolie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e904b56-d687-4a8c-8985-bf43445f52f8",
                                                "sense_id": "05506c49-0716-30ff-ab75-56b66c4ddd91",
                                                "text": "Ainsi, d’aurore radieuse en crépuscule mélancolique, la petite Yasmina avait vu s’écouler encore un printemps, très semblable aux autres, qui se confondaient dans sa mémoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a263a8-902f-320e-8696-a1eef34b03e2",
                                        "entry_id": "12553d56-d0aa-3578-ba20-16c1e707c45e",
                                        "glosses": [
                                            "Dépressif, triste, chagrin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b28470dd-be73-4ea3-b5d5-7f03ec4df116",
                                                "sense_id": "e5a263a8-902f-320e-8696-a1eef34b03e2",
                                                "text": "La nature, pimpante et piquante comme une brune au printemps, devient mélancolique et douce comme une blonde, les gazons se dorent, les fleurs d’automne poussent leurs pâles corolles, ce n’est plus les marguerites qui percent les pelouses de leurs yeux blancs, mais de rares calices violâtres."
                                            },
                                            {
                                                "example_id": "4826a8ed-b64c-400b-996b-7a8596c0a4e8",
                                                "sense_id": "e5a263a8-902f-320e-8696-a1eef34b03e2",
                                                "text": "Les raisonneurs les plus incrédules […] soutenaient que la lycanthropie n’était qu’une espèce de fatale maladie, une situation d’esprit mélancolique, auxquelles se joignaient des accès de folie, pendant lesquels le malade s’imaginait avoir commis les ravages dont il était accusé."
                                            },
                                            {
                                                "example_id": "89e0bf04-f05c-4316-bbb6-bb900f58db8e",
                                                "sense_id": "e5a263a8-902f-320e-8696-a1eef34b03e2",
                                                "text": "Hélène, avec la patience mélancolique des malades, s’amusait à entortiller autour de ses doigts une chaînette d’argent qui lui servait de bracelet."
                                            },
                                            {
                                                "example_id": "76fa2fa8-2dcc-4231-98ce-14845f32bb14",
                                                "sense_id": "e5a263a8-902f-320e-8696-a1eef34b03e2",
                                                "text": "Elle aurait pu être une héroïne durassienne déambulant, l’air mélancolique, dans la touffeur d’un penthouse tropical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a582eb3-4436-36f0-a7f0-5f42f8eb60dc",
                                        "entry_id": "12553d56-d0aa-3578-ba20-16c1e707c45e",
                                        "glosses": [
                                            "Teinté de tristesse, de nostalgie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e125b5f3-5ea2-4727-aca1-47d04ee4c14a",
                                                "sense_id": "7a582eb3-4436-36f0-a7f0-5f42f8eb60dc",
                                                "text": "Sous le mélancolique effacement du brouillard, toute la vie se dérobait et dans la voie déserte bordée d’arbres, j’ai entendu sur le sol, furtive et légère, une feuille morte qui me suivait."
                                            },
                                            {
                                                "example_id": "e8038d6c-e15b-40aa-9704-56fff6901e94",
                                                "sense_id": "7a582eb3-4436-36f0-a7f0-5f42f8eb60dc",
                                                "text": "Une chanson mélancolique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mélancolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2ffdcc-bcf7-3902-85af-c5f42b525ba9",
                                        "entry_id": "ee9ce85d-b654-3f76-9da4-23368a1368fd",
                                        "glosses": [
                                            "Personne atteinte de mélancolie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94526223-c354-4742-b07c-7781dc824628",
                                                "sense_id": "4a2ffdcc-bcf7-3902-85af-c5f42b525ba9",
                                                "text": "« J’ai fait l’impossible pour n’être point un mélancolique, car rien n’est plus ridicule à tout âge et surtout au mien ; mais il y a dans l’esprit de certains hommes je ne sais quelle brume élégiaque toujours prête à se répandre en pluie sur leurs idées. Tant pis pour ceux qui sont nés dans les brouillards d’octobre ! » ajoutait-il en souriant à la fois de sa métaphore prétentieuse et de cette infirmité de nature dont il était au fond très-humilié."
                                            },
                                            {
                                                "example_id": "e77b6d8a-2456-4fb6-90c8-7133ced842fe",
                                                "sense_id": "4a2ffdcc-bcf7-3902-85af-c5f42b525ba9",
                                                "text": "Le mélancolique, dit-on, est tourné vers le passé, absorbé par lui, sans ouverture à l’avenir. Incapable de protension, il est tout en rétention, indéfiniment retenu dans un passé non dépassé."
                                            },
                                            {
                                                "example_id": "e6075c72-2fa4-48d2-a452-96c0215e19ff",
                                                "sense_id": "4a2ffdcc-bcf7-3902-85af-c5f42b525ba9",
                                                "text": "Un tel mécanisme permet de mieux comprendre les autoreproches du mélancolique, et son sentiment de culpabilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
