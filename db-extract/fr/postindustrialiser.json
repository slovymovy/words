                "senses": [
                    {
                        "sense_id": "bff2cbe5-846d-3d47-8024-d9cfe29dc83c",
                        "entry_id": "e31c1ad0-5e9b-331a-822f-ee8306964173",
                        "glosses": [
                            "Donner un caractère postindustriel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968556a5-b3ac-466e-b891-6bc994be491c",
                                "sense_id": "bff2cbe5-846d-3d47-8024-d9cfe29dc83c",
                                "text": "Il faut, au contraire, utiliser le pouvoir de transformation des NTIC, les mettre à contribution pour renouveler l’école, pour « postindustrialiser » le système éducatif, en somme, pour réaliser les changements qui s’imposent en éducation."
                            },
                            {
                                "example_id": "c1c73428-e245-4e11-9b01-31b5c598eb7c",
                                "sense_id": "bff2cbe5-846d-3d47-8024-d9cfe29dc83c",
                                "text": "Conséquence des nouvelles dynamiques des sujets apprenants et des évolutions du monde qui se postindustrialise, l’autoformation appartient bien à la formation permanente."
                            }
                        ]
                    }
