                        ],
                        "examples": [
                            {
                                "example_id": "fab69796-0ad0-4b08-9143-f0779af75513",
                                "sense_id": "db4cca3a-4b60-3959-9e1c-afcde85bb251",
                                "text": "Ein Kammerchor besteht aus ausgewählten Sängern und Sängerinnen."
                            },
                            {
                                "example_id": "da0b55d0-45a0-49bc-a2a4-8ce15a687c30",
                                "sense_id": "db4cca3a-4b60-3959-9e1c-afcde85bb251",
                                "text": "„Der Kammerchor der Staatlichen Hochschule für Musik und Darstellende Kunst Stuttgart ist ein Ensemble von 32 Sängerinnen und Sängern unter der Leitung von Prof. Denis Rouger, dessen Schwerpunkt auf der Erarbeitung von a cappella-Programmen liegt.“"
                            }
                        ],
