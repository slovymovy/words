                        "examples": [
                            {
                                "example_id": "c203b76e-0324-4819-8991-ed92026d6b64",
                                "sense_id": "daa97577-1a4d-3d78-9841-249c6aa93a06",
                                "text": "Profesor poświęcił swoją rozprawę temu wybitnemu leksykografowi polskiemu."
