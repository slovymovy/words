                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "writing",
                                "target_lang_sense_clarification": "a piece of written work"
                            },
                            {
                                "target_lang_word": "document",
                                "target_lang_sense_clarification": "an official or formal piece of writing"
                            },
                            {
                                "target_lang_word": "scripture",
                                "target_lang_sense_clarification": "often used for religious or ancient texts"
                            },
                            {
                                "target_lang_word": "treatise",
                                "target_lang_sense_clarification": "a formal written work on a subject"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ab0932b-e562-3904-b516-938dd9cc0538",
                    "sense_definition": "De manier waarop iemand schrijft; het persoonlijke <w>handschrift</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "handschrift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>geschrift</w> is zo onduidelijk dat de leraar het bijna niet kan lezen.",
                            "target_lang_translations": {
                                "en": "His <w>handwriting</w> is so unclear that the teacher can hardly read it."
                            }
                        },
                        {
                            "text": "Aan het <w>geschrift</w> kon zij zien dat de brief door haar opa was geschreven.",
                            "target_lang_translations": {
                                "en": "From the <w>handwriting</w>, she could see that the letter had been written by her grandfather."
                            }
                        }
                    ],
                    "synonyms": [
                        "handschrift",
                        "schrift"
                    ],
                    "common_phrases": [
                        "onleesbaar geschrift",
                        "persoonlijk geschrift"
                    ],
                    "target_lang_definitions": {
                        "en": "The way in which someone writes; personal handwriting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "handwriting",
