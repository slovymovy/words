                            {
                                "example_id": "f2441e79-7b46-49a4-8c43-393bd196c849",
                                "sense_id": "a43e987e-ff4a-360a-bc4b-0c5f099ad033",
                                "text": "Der nördlichste Ortsteil von Treptow-Köpenick wird Alt-Treptow genannt nach der bis 1920 selbstständigen preußischen Landgemeinde Treptow."
                            },
                            {
                                "example_id": "fe527a65-0fd1-469b-a174-b29ffcb9dfb3",
                                "sense_id": "a43e987e-ff4a-360a-bc4b-0c5f099ad033",
                                "text": "Ich bin in Alt-Treptow geboren."
                            },
                            {
                                "example_id": "712f39e9-e24b-41c8-809e-755246b91219",
                                "sense_id": "a43e987e-ff4a-360a-bc4b-0c5f099ad033",
                                "text": "Ich habe in Alt-Treptow meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "e874ec26-8eb4-441a-9036-e546dc2dfbb9",
                                "sense_id": "a43e987e-ff4a-360a-bc4b-0c5f099ad033",
                                "text": "Nach Alt-Treptow führen viele Wege."
                            }
                        ],
