                "senses": [
                    {
                        "sense_id": "1844c941-08dc-325a-962d-f273c0ca1c39",
                        "entry_id": "0068b9b8-cd6e-33aa-b49a-c668d9a4976d",
                        "glosses": [
                            "zestaw ćwiczeń przed treningiem służąca przygotowaniu organizmu do wysiłku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc67746b-090b-478f-a609-d1c73f1a0488",
                                "sense_id": "1844c941-08dc-325a-962d-f273c0ca1c39",
                                "text": "W ramach rozgrzewki miałam zrobić pięćdziesiąt przysiadów, ale przy trzydziestym trzecim przysiadzie straciłam równowagę i złamałam nadgarstek, gdy instynktownie starałam się podeprzeć."
                            },
                            {
                                "example_id": "98109ed5-2747-4343-8ac4-1c448b5706be",
                                "sense_id": "1844c941-08dc-325a-962d-f273c0ca1c39",
                                "text": "Doświadczony muzyk stosuje gamy i pasaże bardziej jako wprawki, rozgrzewki na początek muzycznego treningu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cb2d0322-a91a-3b0c-93c8-d3c7f7e8d28d",
                        "entry_id": "0068b9b8-cd6e-33aa-b49a-c668d9a4976d",
                        "glosses": [
                            "coś zjedzone lub wypite, co rozgrzewa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97b0966-b910-4b61-b260-49b7f07af49c",
                                "sense_id": "cb2d0322-a91a-3b0c-93c8-d3c7f7e8d28d",
                                "text": "W tej dużej butelce jest wino dla ciebie, w mniejszej czyściocha dla mnie na rozgrzewkę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
