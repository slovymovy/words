                                            {
                                                "example_id": "af9a0114-da29-4985-94e1-60b2dfa783c8",
                                                "sense_id": "eb883514-de66-3773-9a3d-b076e5412d82",
                                                "text": "Elle adore faire durer les préliminaires."
                                            },
                                            {
                                                "example_id": "d27040e2-0582-4303-b57d-2d0b7b2188d1",
                                                "sense_id": "eb883514-de66-3773-9a3d-b076e5412d82",
                                                "text": "Ce n'était pas l'acte en soi qui donnait du plaisir à Sabine, mais ce qu'on appelait les préliminaires, elle n'osait pourtant pas le dire parce que dans les livres c'était toujours l'inverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c407c0-c599-38c7-8a7d-50e2c7db4d4f",
                                        "entry_id": "7f32c62c-e66f-3ed8-9565-e552e2e2c59d",
