                        "entry_id": "d6f01774-4b90-3a59-9881-a5a8d460132e",
                        "glosses": [
                            "A form of etching with acid on a plate partially covered with varnish that produces a print somewhat resembling a watercolour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697bf6e5-042e-4926-9eb2-6940f4d8a621",
                                "sense_id": "5bdc12f8-2a52-3069-ac6c-1c43c87c4a53",
                                "text": "Aquatint is a laborious process that involves acids and resistants and emphasizes tone over line."
                            }
                        ]
                    },
