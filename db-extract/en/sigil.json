                    },
                    {
                        "translation_id": "9b6811ae-20b2-4802-94f8-3c4e161785f6",
                        "source_entry_id": "f3c210a1-6578-3f33-a6e9-a87a94cfe226",
                        "source_sense_description": "seal, signature or signet",
                        "target_lang_word": "sceau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sceau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13fef416-f934-3bb9-a3cb-e1fcc6856c9e",
                                        "entry_id": "086a9d05-bab9-35aa-a11b-ca50318a33ac",
                                        "glosses": [
                                            "Cachet officiel où sont gravées en creux la figure, les armoiries, la devise d’un roi, d’un prince, d’un état, d’un corps, d’une communauté, d’un seigneur, etc. et dont on fait des empreintes avec de la cire ou autrement sur des lettres, des diplômes, des actes publics, etc., pour les rendre authentiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8648afb-b51c-4cce-b0f2-fd119b48b614",
                                                "sense_id": "13fef416-f934-3bb9-a3cb-e1fcc6856c9e",
                                                "text": "Le sceau du roi. - Les sceaux de l’État. - Le sceau d’un ministère. - Le sceau de l’Université, de l’Académie française, etc."
                                            },
                                            {
                                                "example_id": "f53d73e1-e78b-460b-aa06-74f34f461a95",
                                                "sense_id": "13fef416-f934-3bb9-a3cb-e1fcc6856c9e",
                                                "text": "Mettre son sceau. - Apposer le sceau. - Contrefaire un sceau."
                                            },
                                            {
                                                "example_id": "45b6ce39-82b2-46c1-9d87-d371b67e3449",
                                                "sense_id": "13fef416-f934-3bb9-a3cb-e1fcc6856c9e",
                                                "text": "La cassette des sceaux, la cassette où ils sont renfermés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4ff20d-4234-39e5-953e-f2f39dea996a",
                                        "entry_id": "086a9d05-bab9-35aa-a11b-ca50318a33ac",
                                        "glosses": [
                                            "Empreinte faite par le sceau."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35066db2-522e-441b-99e1-5d5a7cd2aa1e",
                                                "sense_id": "1c4ff20d-4234-39e5-953e-f2f39dea996a",
                                                "text": "Le prince examina attentivement la suscription, puis le sceau, qui était placé de manière à assurer le cordonnet de soie qui l’entourait, et qui portait l’empreinte de trois fleurs de lis ; […]."
                                            },
                                            {
                                                "example_id": "d534bb74-0488-4299-a902-70e0309ef0e0",
                                                "sense_id": "1c4ff20d-4234-39e5-953e-f2f39dea996a",
                                                "text": "La seconde œuvre importante de M. de Wailly aux Archives est relative aux sceaux du moyen âge. Il avait, nous l'avons dit, posé et développé dans ses Éléments de Paléographie les règles de critique à suivre pour leur étude."
                                            },
                                            {
                                                "example_id": "0fba9fbd-1e1e-4f43-98a3-2296116149f8",
                                                "sense_id": "1c4ff20d-4234-39e5-953e-f2f39dea996a",
                                                "text": "M. le représentant diplomatique de France en Chine a obtenu du taotaï la défense d'exporter de Chine des cartons de graines de vers à soie qui ne porteraient pas le sceau consulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beeab6ad-d26d-39f6-9b04-85ac24097aa9",
                                        "entry_id": "086a9d05-bab9-35aa-a11b-ca50318a33ac",
                                        "glosses": [
                                            "Action de sceller, ou temps et lieu où l’on scelle, où l’on appose les sceaux de l’état aux actes qui doivent en être revêtus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e59ee6b-b4bb-4bf4-966d-d02c601513c3",
                                                "sense_id": "beeab6ad-d26d-39f6-9b04-85ac24097aa9",
                                                "text": "Ces lettres de grâce ont passé au sceau."
                                            },
                                            {
                                                "example_id": "78be0407-8a2d-4334-bb3f-46105ab50e4a",
                                                "sense_id": "beeab6ad-d26d-39f6-9b04-85ac24097aa9",
                                                "text": "Ces lettres ont été refusées au sceau, on n’a pas voulu les sceller."
                                            },
                                            {
                                                "example_id": "74a77d20-ace2-4fe2-a745-35d914733254",
                                                "sense_id": "beeab6ad-d26d-39f6-9b04-85ac24097aa9",
                                                "text": "S’opposer au sceau, s’opposer à ce que de lettres soient scellées."
                                            },
                                            {
                                                "example_id": "1d68b8e2-ccbf-4298-b278-e6b912d04c31",
                                                "sense_id": "beeab6ad-d26d-39f6-9b04-85ac24097aa9",
                                                "text": "Il y a opposition au sceau, on a fait opposition au sceau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f966f6-f32f-4fe8-932d-568757eb33bf",
                        "source_entry_id": "f3c210a1-6578-3f33-a6e9-a87a94cfe226",
                        "source_sense_description": "seal, signature or signet",
                        "target_lang_word": "Siegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0eb142ee-5e10-36b9-a7a7-7b5994504d50",
                                        "entry_id": "f55f0867-9b1e-3d68-81f7-eef4cfc4e217",
                                        "glosses": [
                                            "Stempel zum Abdrucken eines Zeichens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed9e822c-fe12-4cc3-96f3-ccacdf86a71a",
                                                "sense_id": "0eb142ee-5e10-36b9-a7a7-7b5994504d50",
                                                "text": "Das Siegel wurde immer versperrt aufbewahrt."
                                            },
                                            {
                                                "example_id": "ec056640-a9f2-41bf-82cb-317149df916c",
                                                "sense_id": "0eb142ee-5e10-36b9-a7a7-7b5994504d50",
                                                "text": "„Der stellte seine Hellebarde beiseite und zeigte uns alte Siegel unter Glas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68c50c1e-cb51-39ef-a177-ef0a940e859c",
                                        "entry_id": "f55f0867-9b1e-3d68-81f7-eef4cfc4e217",
                                        "glosses": [
                                            "Abdruck eines Siegels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb32972-91a2-4ab3-aab9-5fd5fdfd2f49",
                                                "sense_id": "68c50c1e-cb51-39ef-a177-ef0a940e859c",
                                                "text": "Der Brief trägt unverkennbar sein Siegel."
                                            },
                                            {
                                                "example_id": "83f61ce1-19e2-4fac-87cd-870eaa3803c8",
                                                "sense_id": "68c50c1e-cb51-39ef-a177-ef0a940e859c",
                                                "text": "„Von Bewunderung erfüllt, faltete mein Vater einen Umschlag, schrieb mit seiner schönen Tinte eine Anschrift darauf und versiegelte ihn mit seinem neuen Lack; das Siegel prägte sich vorzüglich ab.“"
                                            },
                                            {
                                                "example_id": "cb4aad42-e618-447f-bd43-d3d8c969d7c0",
                                                "sense_id": "68c50c1e-cb51-39ef-a177-ef0a940e859c",
                                                "text": "„Am nächsten Morgen wurden die Siegel abgenommen, und ich kehrte nach Hause zurück.“"
                                            },
                                            {
                                                "example_id": "5f020c33-5df1-4371-9782-56610a6e685f",
                                                "sense_id": "68c50c1e-cb51-39ef-a177-ef0a940e859c",
                                                "text": "„Die Woche, die bis zur Verlobungsanzeige vergehen sollte, war noch nicht um, als ihm ein Brief mit voller Titelaufschrift und einem großen roten Siegel ins Haus geschickt wurde.“"
                                            },
                                            {
                                                "example_id": "ebb4af82-43e3-4ab5-9361-bb24fedc26f2",
                                                "sense_id": "68c50c1e-cb51-39ef-a177-ef0a940e859c",
                                                "text": "„Er stand immer noch da, als ein kleiner Junge auf ihn zutrat und ihm ein locker zusammengefaltetes, aber mit vielen Siegeln fest verklebtes Briefchen gab, das er las und zu sich steckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "08e9ffa2-8e38-33a9-a948-4edd711c546b",
                                        "entry_id": "f55f0867-9b1e-3d68-81f7-eef4cfc4e217",
                                        "glosses": [
                                            "Darstellung, die als Siegelbild verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d83b29-c976-415e-98ae-bc2b61afa0a1",
                                                "sense_id": "08e9ffa2-8e38-33a9-a948-4edd711c546b",
                                                "text": "Das Siegel des Grafen waren zwei gekreuzte Schwerter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
