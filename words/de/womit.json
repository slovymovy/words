                    "frequency": "High",
                    "semantic_group_id": "interrogativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Womit</w> kann ich Ihnen heute im Geschäft behilflich sein?"
                        },
                        {
                            "text": "Er wollte genau wissen, <w>womit</w> man diese schwere Holztür öffnen kann."
                        }
                    ],
