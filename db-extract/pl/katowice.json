                ],
                "senses": [
                    {
                        "sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                        "entry_id": "12e3816b-2bc3-34d7-b923-cd7fc03d86a5",
                        "glosses": [
                            "miasto w południowej Polsce, stolica województwa śląskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9cd9db-d088-439d-a5be-50d1d879d081",
                                "sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                                "text": "Katowice są największym miastem województwa śląskiego."
                            },
                            {
                                "example_id": "5442e330-1b81-4661-8e10-b72ea2d5b54b",
                                "sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                                "text": "Wiktor należy do loży w Katowicach."
                            },
                            {
                                "example_id": "baee5424-e61b-4e39-8140-a23cb77dc57b",
                                "sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                                "text": "W wykarczowanym środku lasu, osiem kilometrów od Katowic, postawiono parterowe dwurodzinne domki z cegły dla 600 górniczych rodzin."
                            },
                            {
                                "example_id": "b221beeb-d788-45fd-879d-880360f96d10",
                                "sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                                "text": "Również z Katowic jest Donata z przyjaciółką Ewą, (obie po 14 lat) i jedenastoletni brat Donaty – Jurand."
                            },
                            {
                                "example_id": "b8a2d8ea-b37d-461f-9f9f-b902b240c281",
                                "sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                                "text": "Zakład Karny z Raciborza bierze udział w programie ekologicznej fundacji Silesia z Katowic. — Pozyskaliśmy 1500 zł na sadzonki. Pieniędzy starczy na wstępny etap odnowy przywięziennego parku – informuje Aleksandra Szlachetko z Działu Kwatermistrzowskiego placówki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3812aebc-8a4a-43b9-b4e4-475e351e7bd3",
                        "source_entry_id": "12e3816b-2bc3-34d7-b923-cd7fc03d86a5",
                        "source_sense_id": "4250084c-8415-3962-92de-9376a19e5e79",
                        "target_lang_word": "Katowice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katowice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a21e6d0-0a78-3e8d-94e4-ca7cb6722e65",
                                        "entry_id": "5f95f07f-1501-3174-b38b-c85cc8692f63",
                                        "glosses": [
                                            "A city in southern Poland; the capital of Silesian Voivodeship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ddc015-9ce2-4ff8-9166-bebd5a7f55f3",
                                                "sense_id": "9a21e6d0-0a78-3e8d-94e4-ca7cb6722e65",
                                                "text": "Any English traveller approaching Katowice will be strongly reminded of Lancashire."
                                            },
                                            {
                                                "example_id": "53848c11-f223-4b5e-b623-008903692a36",
                                                "sense_id": "9a21e6d0-0a78-3e8d-94e4-ca7cb6722e65",
                                                "text": "Trains from Warsaw to Vienna now go by the shorter route from Warsaw to Katowice instead of via Cracow."
                                            },
                                            {
                                                "example_id": "66dc259b-cc7f-4b85-b2e5-b1b6f22526d1",
                                                "sense_id": "9a21e6d0-0a78-3e8d-94e4-ca7cb6722e65",
                                                "text": "On visiting Katowice in southwest Poland, Jeremy Melvin met up with Archistudio, the architects of a substantial new judicial precinct that is due for completion in 2008."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cde2c276-3bab-45a9-a473-d04a222ca169",
                        "source_entry_id": "12e3816b-2bc3-34d7-b923-cd7fc03d86a5",
