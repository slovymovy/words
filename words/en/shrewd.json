{
    "word_family": [
        "shrewdly",
        "shrewdness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34b8c1b6-9308-3f0d-8e4f-52766ddd3d2a",
                    "sense_definition": "Showing clever resourcefulness, sharp judgment, and practical intelligence in practical matters.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleverness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a <w>shrewd</w> business decision that saved the company millions of dollars.",
                            "target_lang_translations": {
                                "pl": "Podjęła <w>bystrą</w> decyzję biznesową, która uratowała firmie miliony dolarów."
                            }
                        },
                        {
                            "text": "He is a <w>shrewd</w> businessman who always knows when to invest.",
                            "target_lang_translations": {
                                "pl": "Jest <w>przebiegłym</w> biznesmenem, który zawsze wie, kiedy inwestować."
                            }
                        }
                    ],
                    "synonyms": [
                        "astute",
                        "clever",
                        "sharp",
                        "canny"
                    ],
                    "antonyms": [
                        "foolish",
                        "naive"
                    ],
                    "common_phrases": [
                        "shrewd businessman",
                        "shrewd move",
                        "shrewd investment"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykazujący się sprytem, trafnym osądem i praktyczną inteligencją w sprawach życiowych lub zawodowych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bystry",
                                "target_lang_sense_clarification": "o umyśle, decyzjach"
                            },
                            {
                                "target_lang_word": "przebiegły",
                                "target_lang_sense_clarification": "w interesach, inteligentny"
                            },
                            {
                                "target_lang_word": "sprytny",
                                "target_lang_sense_clarification": "zaradny i inteligentny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc2b550d-6183-3c99-8469-8237f3b1b506",
                    "sense_definition": "Knowledgeable, highly intelligent, and keen in observation or judgment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleverness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach is a <w>shrewd</w> observer of human behavior and knows how to motivate his players.",
                            "target_lang_translations": {
                                "pl": "Trener jest <w>wnikliwym</w> obserwatorem ludzkich zachowań i wie, jak motywować swoich zawodników."
                            }
                        },
                        {
                            "text": "It takes a <w>shrewd</w> judge of character to spot talent so early in a career.",
                            "target_lang_translations": {
                                "pl": "Trzeba być <w>bystrym</w> sędzią ludzkich charakterów, aby tak wcześnie dostrzec talent."
                            }
                        }
                    ],
                    "synonyms": [
                        "perceptive",
                        "discerning",
                        "intelligent"
                    ],
                    "antonyms": [
                        "unperceptive"
                    ],
                    "common_phrases": [
                        "shrewd observer",
                        "shrewd judge"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający dużą wiedzę, wysoce inteligentny i wnikliwy w obserwacji lub ocenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wnikliwy",
                                "target_lang_sense_clarification": "o obserwatorze, sędzi"
                            },
                            {
                                "target_lang_word": "bystry",
                                "target_lang_sense_clarification": "dobrze oceniający sytuację"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3297b54c-a15c-3d6a-ad34-621086510786",
                    "sense_definition": "Highly accurate or close to the truth, especially of a guess or estimation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>shrewd</w> guess about the outcome of the election turned out to be entirely correct.",
                            "target_lang_translations": {
                                "pl": "Jej <w>trafny</w> domysł dotyczący wyniku wyborów okazał się całkowicie słuszny."
                            }
                        },
                        {
                            "text": "He made a <w>shrewd</w> calculation of the costs before starting the project.",
                            "target_lang_translations": {
                                "pl": "Dokonał <w>dokładnego</w> obliczenia kosztów przed rozpoczęciem projektu."
                            }
                        }
                    ],
                    "synonyms": [
                        "accurate",
                        "correct",
                        "spot-on"
                    ],
                    "antonyms": [
                        "inaccurate"
                    ],
                    "common_phrases": [
                        "shrewd guess",
                        "shrewd calculation"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo dokładny lub bliski prawdy, szczególnie w odniesieniu do domysłów lub szacunków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trafny",
                                "target_lang_sense_clarification": "o domyśle, kalkulacji"
                            },
                            {
                                "target_lang_word": "błyskotliwy",
                                "target_lang_sense_clarification": "o trafnym spostrzeżeniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91f226ed-9926-3576-85d1-39a464b5a1a5",
                    "sense_definition": "Streetwise and street-smart; possessing practical knowledge of urban life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleverness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Growing up in the city made him a <w>shrewd</w> character who knew how to avoid trouble.",
                            "target_lang_translations": {
                                "pl": "Dorastanie w mieście uczyniło z niego <w>cwanego</w> człowieka, który wiedział, jak unikać kłopotów."
                            }
                        },
                        {
                            "text": "She is a <w>shrewd</w> negotiator who understands how the real world works.",
                            "target_lang_translations": {
                                "pl": "Jest <w>sprytną</w> negocjatorką, która rozumie, jak działa prawdziwy świat."
                            }
                        }
                    ],
                    "synonyms": [
                        "streetwise",
                        "street-smart"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe street-smart intelligence"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający życiowy spryt, znający realia życia w mieście lub trudnych warunkach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cwany",
                                "target_lang_sense_clarification": "sprytny życiowo"
                            },
                            {
                                "target_lang_word": "obrotny",
                                "target_lang_sense_clarification": "radzący sobie w życiu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec2c7299-5102-33d6-8c1d-fe37eb82a52f",
                    "sense_definition": "Artful, tricky, or cunning in a deceptive way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deviousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician used <w>shrewd</w> tactics to undermine his opponent's credibility.",
                            "target_lang_translations": {
                                "pl": "Polityk użył <w>chytrych</w> taktyk, aby podważyć wiarygodność swojego przeciwnika."
                            }
                        },
                        {
                            "text": "He is known for his <w>shrewd</w> and manipulative schemes.",
                            "target_lang_translations": {
                                "pl": "Znany jest ze swoich <w>przebiegłych</w> i manipulacyjnych intryg."
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "crafty",
                        "wily",
                        "sly"
                    ],
                    "antonyms": [
                        "honest",
                        "ingenuous"
                    ],
                    "common_phrases": [
                        "shrewd tactics"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przebiegły, podstępny lub chytry w zwodniczy sposób."
                    },
                    "translations": {
                        "pl": [
