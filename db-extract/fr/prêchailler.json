                "senses": [
                    {
                        "sense_id": "6c60e882-6d2a-38d0-88ac-0a98d48fa65d",
                        "entry_id": "4c91492d-10ef-3267-95a4-d116b2cdfd08",
                        "glosses": [
                            "Prêcher médiocrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b5af8f-913b-43ec-8b30-ea3d078c31db",
                                "sense_id": "6c60e882-6d2a-38d0-88ac-0a98d48fa65d",
                                "text": "Mais, quoi ! ne fallait-il pas suivre jusqu’au bout le cupide saltimbanque, organisateur et prédicateur de cette croisade pour le boursicaut, qui ne cesse de prêchailler « à la petite semaine » sur le petit nombre des élus du Coffre-fort Tout-Puissant ?"
                            },
                            {
                                "example_id": "9654887c-5374-463d-8a3e-4f80e9c79601",
                                "sense_id": "6c60e882-6d2a-38d0-88ac-0a98d48fa65d",
                                "text": "Il [l’abbé de Bonnevie] est gai, il prêchaille, et ne pense plus à ses malheurs."
                            }
                        ]
                    }
