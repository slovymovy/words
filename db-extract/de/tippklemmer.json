                "senses": [
                    {
                        "sense_id": "3116517e-971a-392b-b0d0-02f200afc5dd",
                        "entry_id": "7d2487ec-3944-3e96-bc0e-2b206faf8b02",
                        "glosses": [
                            "Vorrichtung in Aktenordnern zum Fixieren von Dokumenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0e9413-b911-4462-b67e-f1021fd7ba6e",
                                "sense_id": "3116517e-971a-392b-b0d0-02f200afc5dd",
                                "text": "„1963 erhielten die Leitz-Ordner einen neuen Tippklemmer.“"
                            },
                            {
                                "example_id": "5b926438-37cc-40de-8a64-64e90e34bea3",
                                "sense_id": "3116517e-971a-392b-b0d0-02f200afc5dd",
                                "text": "„Wenn täglich 170 Schriftstücke in 37 Ordnern abgelegt werden müssen, so dauert diese Arbeit mit der alten Arbeitsweise, bei der sogenannte Tippklemmer auf das Schriftgut zurückgeschoben werden, 33 Minuten.“"
                            },
                            {
                                "example_id": "17208a21-00c2-4731-b02a-234c0de24e00",
                                "sense_id": "3116517e-971a-392b-b0d0-02f200afc5dd",
                                "text": "„Schurmann zog den Ordner zu sich heran, schob den Tippklemmer, der sich nicht mehr richtig öffnen ließ, mit einiger Schwierigkeit auf die linke Seite der mit Papier schwer beladenen Klemmbügel, strich das Schreiben der Karl Grote AG glatt und hatte Mühe beim Öffnen der Halterung, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
