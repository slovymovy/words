                    "sense_id": "6d700f4c-bd4c-304c-88ad-c0a2f691ff87",
                    "sense_definition": "Vervuld van boosheid of toorn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning was <w>gram</w> op zijn onderdanen vanwege hun ongehoorzaamheid.",
                            "target_lang_translations": {
                                "en": "The king was <w>wrathful</w> toward his subjects because of their disobedience.",
                                "ru": "Король был <w>гневен</w> на своих подданных за их непослушание."
                            }
                        },
                        {
                            "text": "Met een <w>gram</w> gelaat verliet hij de vergaderzaal.",
                            "target_lang_translations": {
                                "en": "With an <w>angry</w> face, he left the meeting room.",
                                "ru": "С <w>гневным</w> лицом он покинул зал заседаний."
                            }
