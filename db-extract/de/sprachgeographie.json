                        ],
                        "form": "die Sprachgeographie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                        "entry_id": "507aaeee-9500-38fd-bf22-d60fc39d4758",
                        "glosses": [
                            "linguistische Disziplin, die sich mit der räumlichen Verbreitung sprachlicher Einheiten und Eigenschaften befasst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c03306af-d455-45a7-9c3a-efb1104a3eab",
                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                "text": "Die Sprachgeographie stellt die Grenzen von Dialekten fest."
                            },
                            {
                                "example_id": "b407253a-e465-496c-a696-35704068aac0",
                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                "text": "Die Sprachgeographie erarbeitet u.a. Sprachkarten bzw. Sprachatlanten, die die regionale Verbreitung bestimmter Laute oder Wörter oder anderer Einheiten oder Eigenschaften zeigen."
                            },
                            {
                                "example_id": "e8ade95d-f67a-4512-a467-d2601054f096",
                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                "text": "Sprachgeographie wird z.T. mit Areallinguistik gleichgesetzt, die aber nicht auf Dialekte beschränkt ist, z.B. wenn sie als Arealtypologie betrieben wird."
                            },
                            {
                                "example_id": "80413a3c-d569-40a8-9d63-843960eeabbe",
                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                "text": "„Die Sprachgeographie ist eine linguistische Methode, die Übereinstimmungen und Unterschiede zwischen Mundarten, deren Verbreitungsgebiete meistens aneinander grenzen, zu deuten versucht.“"
                            },
                            {
                                "example_id": "836c26f2-1ce6-498a-9511-2898eadb3f25",
                                "sense_id": "d592e5ea-cc97-3342-abfe-fe117bee603b",
                                "text": "„Mit Problemen der Ausbreitung von Neuerungen beschäftigte sich zuerst systematisch die Sprachgeographie, die sich in Opposition zu der Junggrammatischen Schule entwickelte…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
