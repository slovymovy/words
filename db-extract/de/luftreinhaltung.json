                ],
                "senses": [
                    {
                        "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                        "entry_id": "c8170f35-5657-3e12-b44b-c4fcc587e8fd",
                        "glosses": [
                            "Erhaltung guter Luft, Sicherstellung guter Luftqualität (beispielsweise durch Gesetze/Verordnungen), Verringerung schädlicher Immissionen"
                        ],
                        "tags": [
                            "Umweltschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "fad76708-e896-4564-a86f-3aa91f08309c",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "Katalysatoren in Autos dienen der Luftreinhaltung."
                            },
                            {
                                "example_id": "87416285-4bae-4f5b-ad60-5ce298f8c641",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "Fahrverbote und Tempolimits für Fahrzeuge mit Verbrennungsmotoren wären Maßnahmen zur Luftreinhaltung."
                            },
                            {
                                "example_id": "3ab63890-0c99-452e-8bf1-6e25de515f9c",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„In den meisten Industrieländern ist die lokale Luftverschmutzung aufgrund von gesetzlichen Vorgaben zur Luftreinhaltung in den letzten Jahrzehnten stark zurückgegangen.“"
                            },
                            {
                                "example_id": "2c319ef1-d700-4bfa-9ee4-c67d3d50e45d",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "[California Air Resources Board:] „Das seit 1967 bestehende Beratungsgremium ist international bekannt für seine besonders strengen Gesetzesvorschläge zur Luftreinhaltung.“"
                            },
                            {
                                "example_id": "6967e7a2-47e0-4ba5-a61d-eb850d63f68e",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„Der Beschluss ist umso erstaunlicher, da die Verkehrsministerkonferenz der Länder die Einführung einer blauen Plakette zur Luftreinhaltung in Innenstädten auf die lange Bank geschoben hat.“"
                            },
                            {
                                "example_id": "8fde3efd-2548-41e3-af67-869e9ec9ff92",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„Schärfere Vorschriften zur Luftreinhaltung und verbesserte Standards für Fahrzeugemissionen, Industrie und Energieerzeugung haben laut EEA seit 1990 bereits zu einer Verringerung von vorzeitigen Todesfällen um rund die Hälfte geführt.“"
                            },
                            {
                                "example_id": "a691f3fb-3197-45e7-89b8-c341a4c0b179",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„Weil die Bundesregierung zu wenig zum Schutz der Bürger und der Luftreinhaltung unternommen hat, verschickte die EU im Juni 2015 ein Mahnschreiben und leitete ein Vertragsverletzungsverfahren ein.“"
                            },
                            {
                                "example_id": "d981845f-b94b-4b6f-99ec-5dc337272ccf",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„In der Luftreinhaltung ist es schwer, das ⁠Verursacherprinzip⁠ anzuwenden.“"
                            },
                            {
                                "example_id": "3892e809-244a-45ac-aca5-27f77354962b",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„»Zum Erfolg der Luftreinhaltung haben all diejenigen entscheidend beigetragen, die auf Bus, Bahn und Fahrrad umgestiegen sind, genauso wie diejenigen, die zu Fuß gegangen sind und auf Fahrten mit dem Auto verzichtet haben.«“"
                            },
                            {
                                "example_id": "2096e2b2-a820-44a3-a7ba-8b7ec424ba4b",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„Ab 1979 warnten die Forstwissenschaftler Bernhard Ulrich und Peter Schütt vor einem bevorstehenden bzw. stattfindenden Waldsterben und forderten eine Verbesserung der Luftreinhaltung.“"
                            },
                            {
                                "example_id": "c1ff5d00-0ab5-4280-97d7-97a7890f3b69",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„Nach jahrelangem Rechtsstreit um die Luftreinhaltung in München haben sich die Deutsche Umwelthilfe, der Verkehrsklub VCD und die Landeshauptstadt nach eigenen Angaben auf einen Vergleich geeinigt.“"
                            },
                            {
                                "example_id": "1d834a21-4772-4fcb-9cf0-31ac363ce94d",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„In einigen Städten Chinas ist die Luftverschmutzung deutlich zurückgegangen. Die Umweltorganisation Greenpeace führt diesen ökologischen Erfolg auf die Einhaltung strengerer Regeln zur Luftreinhaltung zurück.“"
                            },
                            {
                                "example_id": "f1b31149-2c0b-4e8a-a28a-044cf9d7f5de",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "[Berlin 2023:] „Bestehende Drosselungen auf Tempo 30, etwa zur Luftreinhaltung, sollen „überprüft“ werden und könnten bald fallen.“"
                            },
                            {
                                "example_id": "42a41c25-be99-4cba-9468-fa6b04a72306",
                                "sense_id": "b8fdf38a-f1eb-32a2-ab54-1f1ab82979a8",
                                "text": "„Der gesundheitliche Gewinn durch eine verbesserte Luftqualität ist substantiell – und zahlt sich auch aus. Hochrechnungen zufolge sind die Kosten für die Luftreinhaltung vielfach geringer als die volksgesundheitlichen Kosten der Luftverschmutzung. Es spricht also auch wirtschaftlich alles dafür, dass die Luftreinhaltung durch die Politik verbindlich vorgegeben wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
