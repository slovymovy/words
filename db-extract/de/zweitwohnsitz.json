                "senses": [
                    {
                        "sense_id": "90473bfa-7e1b-3cb6-8aca-9f7cee896d21",
                        "entry_id": "c99e2fc2-7f21-3829-a9c8-462e7a349654",
                        "glosses": [
                            "Wohnsitz, an dem jemand nicht vorwiegend wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b173a5-359d-4fb8-895a-7cdb8187aad7",
                                "sense_id": "90473bfa-7e1b-3cb6-8aca-9f7cee896d21",
                                "text": "Er verlegte seinen Zweitwohnsitz von Berlin nach Potsdam."
                            },
                            {
                                "example_id": "9b5fd798-30f7-4d9d-834b-aefd052e2b3b",
                                "sense_id": "90473bfa-7e1b-3cb6-8aca-9f7cee896d21",
                                "text": "„Am 29. Dezember 1955 meldete er seinen Zweitwohnsitz in der Hohenzollernstraße 29 an.“"
                            },
                            {
                                "example_id": "62aec001-ffb5-4519-bbaf-d43ec3575f3f",
                                "sense_id": "90473bfa-7e1b-3cb6-8aca-9f7cee896d21",
                                "text": "„Außerdem habe er unrechtmäßig einen Zweitwohnsitz in Holland, was völlig aus der Luft gegriffen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
