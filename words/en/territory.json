{
    "word_family": [
        "territorial",
        "extraterritorial",
        "territoriality"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af486f70-9c4a-3277-be62-794b1daa6c5b",
                    "sense_definition": "A geographic area under the control of a government, state, or other political entity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geo_political",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army advanced deep into enemy <w>territory</w> during the night.",
                            "target_lang_translations": {
                                "ru": "Ночью армия продвинулась глубоко на вражескую <w>территорию</w>.",
                                "tr": "Ordu gece boyunca düşman <w>topraklarının</w> derinliklerine doğru ilerledi."
                            }
                        },
                        {
                            "text": "The island is a dependent <w>territory</w> governed by a larger country.",
                            "target_lang_translations": {
                                "ru": "Этот остров — зависимая <w>территория</w>, управляемая более крупной страной.",
                                "tr": "Ada, daha büyük bir ülke tarafından yönetilen bağımlı bir <w>topraktır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "region",
                        "domain",
                        "land",
                        "area"
                    ],
                    "common_phrases": [
                        "enemy territory",
                        "occupied territory",
                        "overseas territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическая область, находящаяся под контролем правительства, государства или иного политического образования.",
                        "tr": "Bir hükümetin, devletin veya diğer siyasi bir yapının kontrolü altındaki coğrafi alan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "административная или государственная единица"
                            },
                            {
                                "target_lang_word": "земля",
                                "target_lang_sense_clarification": "страна или государство (поэтич.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "toprak",
                                "target_lang_sense_clarification": "ülke veya devlet arazisi"
                            },
                            {
                                "target_lang_word": "bölge",
                                "target_lang_sense_clarification": "belirli idari veya siyasi alan"
                            },
                            {
                                "target_lang_word": "arazi",
                                "target_lang_sense_clarification": "coğrafi sınırları olan kara parçası"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4318434-b779-36b4-b957-846d0b16ab2d",
                    "sense_definition": "An area that an animal defends against others of the same species to protect food or mates.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wolves will fight fiercely to defend their <w>territory</w> from intruders.",
                            "target_lang_translations": {
                                "ru": "Волки будут яростно сражаться, защищая свою <w>территорию</w> от чужаков.",
                                "tr": "Kurtlar, <w>bölgelerini</w> davetsiz misafirlerden korumak için şiddetle savaşırlar."
                            }
                        },
                        {
                            "text": "The cat marked its <w>territory</w> by scratching the bark of the tree.",
                            "target_lang_translations": {
                                "ru": "Кот пометил свою <w>территорию</w>, поцарапав кору дерева.",
                                "tr": "Kedi, ağacın kabuğunu tırmalayarak kendi <w>bölgesini</w> işaretledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "turf",
                        "domain"
                    ],
                    "common_phrases": [
                        "mark territory",
                        "defend territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок, который животное защищает от других представителей своего вида для охраны пищи или партнеров.",
                        "tr": "Bir hayvanın yiyecek veya eşlerini korumak için kendi türünden olanlara karşı savunduğu alan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "жизненное пространство животного"
                            },
                            {
                                "target_lang_word": "владения",
                                "target_lang_sense_clarification": "ареал обитания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölge",
                                "target_lang_sense_clarification": "hayvanın yaşam ve avlanma alanı"
                            },
                            {
                                "target_lang_word": "alan",
                                "target_lang_sense_clarification": "sahiplenilen alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fda2adb5-44e9-3c3c-9b89-3aef81372212",
                    "sense_definition": "A specific area of knowledge, experience, or subject matter.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Discussing politics at the dinner table can be dangerous <w>territory</w>.",
                            "target_lang_translations": {
                                "ru": "Обсуждение политики за обеденным столом может быть опасной <w>территорией</w>.",
                                "tr": "Yemek masasında siyaset tartışmak tehlikeli bir <w>alan</w> olabilir."
                            }
                        },
                        {
                            "text": "This new scientific research takes us into uncharted <w>territory</w>.",
                            "target_lang_translations": {
                                "ru": "Это новое научное исследование уводит нас на неизведанную <w>территорию</w>.",
                                "tr": "Bu yeni bilimsel araştırma bizi bilinmeyen bir <w>alana</w> götürüyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "field",
                        "sphere",
                        "domain"
                    ],
                    "common_phrases": [
                        "uncharted territory",
                        "familiar territory",
                        "dangerous territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная область знаний, опыта или предмет обсуждения.",
                        "tr": "Özel bir bilgi, deneyim veya konu alanı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "область",
                                "target_lang_sense_clarification": "сфера знаний или деятельности"
                            },
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "перен. сфера деятельности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "alan",
                                "target_lang_sense_clarification": "uzmanlık veya ilgi alanı"
                            },
                            {
                                "target_lang_word": "saha",
                                "target_lang_sense_clarification": "çalışma veya bilgi alanı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad905ca3-7f79-3807-80c9-2c0618b30bf9",
                    "sense_definition": "A specific geographic area assigned to a salesperson or agent for business activities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new sales manager was assigned a large <w>territory</w> covering three states.",
                            "target_lang_translations": {
                                "ru": "Новому менеджеру по продажам назначили обширную <w>территорию</w>, охватывающую три штата.",
                                "tr": "Yeni satış müdürüne üç eyaleti kapsayan geniş bir <w>bölge</w> verildi."
                            }
                        },
                        {
                            "text": "She knows every potential client in her sales <w>territory</w> personally.",
                            "target_lang_translations": {
                                "ru": "Она знает каждого потенциального клиента на своей торговой <w>территории</w> лично.",
                                "tr": "Satış <w>bölgesindeki</w> her potansiyel müşteriyi kişisel olarak tanıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "district",
                        "zone"
                    ],
                    "common_phrases": [
                        "sales territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Географический район, закрепленный за торговым представителем или агентом для ведения бизнеса.",
                        "tr": "Bir satış temsilcisine veya acenteye iş faaliyetleri için tahsis edilmiş belirli bir coğrafi bölge."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "зона обслуживания"
                            },
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "участок работы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölge",
                                "target_lang_sense_clarification": "satış veya sorumluluk alanı"
                            },
                            {
                                "target_lang_word": "saha",
                                "target_lang_sense_clarification": "çalışma bölgesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5092fab4-442a-3f02-9964-381255eec3c7",
                    "sense_definition": "The part of a playing field that belongs to or is defended by a team.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team kept the ball in the opponent's <w>territory</w> for most of the match.",
                            "target_lang_translations": {
                                "ru": "Команда держала мяч на <w>территории</w> соперника большую часть матча.",
                                "tr": "Takım, maçın büyük bölümünde topu rakibin <w>yarı sahasında</w> tuttu."
                            }
                        },
                        {
                            "text": "We need to gain more <w>territory</w> to set up a scoring opportunity.",
                            "target_lang_translations": {
                                "ru": "Нам нужно захватить больше <w>территории</w>, чтобы создать возможность для гола.",
                                "tr": "Gol fırsatı yaratmak için daha fazla <w>alan</w> kazanmamız gerekiyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gain territory",
                        "concede territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть игрового поля, которая принадлежит команде или защищается ею.",
                        "tr": "Oyun alanının bir takıma ait olan veya o takım tarafından savunulan kısmı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "половина поля",
                                "target_lang_sense_clarification": "часть площадки в спорте"
                            },
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "зона на поле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yarı saha",
                                "target_lang_sense_clarification": "takımın savunduğu taraf"
                            },
                            {
                                "target_lang_word": "alan",
                                "target_lang_sense_clarification": "oyun alanındaki bölge"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}