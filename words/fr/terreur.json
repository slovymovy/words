                    "frequency": "Middle",
                    "semantic_group_id": "revolution_francaise",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "De nombreuses figures de l'opposition furent guillotinées à Paris pendant la <w>Terreur</w>."
                        },
                        {
                            "text": "La chute de Robespierre a marqué la fin brutale de la <w>Terreur</w> en France."
                        }
                    ],
                    "common_phrases": [
                        "pendant la Terreur"
                    ]
                },
                {
                    "sense_id": "118c0b73-fb9d-3edd-908a-011fac40f023",
                    "sense_definition": "Période de violences et de représailles menée par les royalistes contre les révolutionnaires ou les bonapartistes, notamment en 1795 et 1815.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "repression_royaliste",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "Les royalistes ont mené de violentes représailles dans le Midi lors de la première <w>Terreur</w> blanche."
