                                    {
                                        "sense_id": "b7102a9b-1e1b-3a46-8356-15f992d4b4b5",
                                        "entry_id": "7ba7c545-2301-3753-bb93-41da6cbaf8d6",
                                        "glosses": [
                                            "kindisches Wesen, Unreife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c30d13-4a45-466c-a965-9c425f1213eb",
                                                "sense_id": "b7102a9b-1e1b-3a46-8356-15f992d4b4b5",
                                                "text": "Seine Infantilität geht mir zunehmend auf die Nerven. Ich denke, er drückt sich damit vor Verantwortung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "551be1d1-714f-3e02-91bc-3fc5d9817dd8",
                                        "entry_id": "7ba7c545-2301-3753-bb93-41da6cbaf8d6",
                                        "glosses": [
                                            "kindliches Wesen, Kindlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a264aa-e8e0-4c16-a5ac-28ef9dea437a",
                                                "sense_id": "551be1d1-714f-3e02-91bc-3fc5d9817dd8",
                                                "text": "Wenn man zu lange in der kindlichen Infantilität verharrt, wenn man eigentlich aus ihr herauswachsen sollte, dann beginnen die Probleme."
                                            },
                                            {
                                                "example_id": "bcbb1acb-99c8-4b3f-bd47-dbe18c79f93c",
                                                "sense_id": "551be1d1-714f-3e02-91bc-3fc5d9817dd8",
                                                "text": "„Die Infantilität kann ein belebendes und ein lähmendes Gift sein; sie erhält jung, oder sie läßt nie reif werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
