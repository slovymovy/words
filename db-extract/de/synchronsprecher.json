                                "sense_id": "908bfedd-0c6c-3f2b-a470-aab6e2c78d8e",
                                "text": "„Der Synchronsprecher Rolf Schult ist bereits am Mittwoch mit 85 Jahren in München gestorben, bestätigte sein Sohn einen Medienbericht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
