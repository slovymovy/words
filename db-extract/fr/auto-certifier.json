                ],
                "senses": [
                    {
                        "sense_id": "bc90546d-6801-3f09-bf72-236429c48d9c",
                        "entry_id": "83610dd6-0c86-3d8e-84b4-ff005e37f139",
                        "glosses": [
                            "Certifier soi-même pour soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b906a066-4b94-4714-a04f-9cb9d917ea90",
                                "sense_id": "bc90546d-6801-3f09-bf72-236429c48d9c",
                                "text": "Exportateur enregistré sur le système REX et pouvant auto-certifier l’origine préférentielle d’une marchandise en recourant à la mention « Attestation d’origine » sur les documents commerciaux pour l’identification des marchandises."
                            },
                            {
                                "example_id": "6ad10dc7-f342-497f-a1a0-b8acced45773",
                                "sense_id": "bc90546d-6801-3f09-bf72-236429c48d9c",
                                "text": "Cette manie de s’auto-certifier tape sur les nerfs des défenseurs du droit à la vie privée et met un coup d’arrêt au transfert et au stockage des données de citoyens protégés par le RGPD sur le sol américain."
                            },
                            {
                                "example_id": "a58a436c-acbd-4a93-be50-7f14f007c9b0",
                                "sense_id": "bc90546d-6801-3f09-bf72-236429c48d9c",
                                "text": "Cette démarche consiste pour une entreprise à s’auto-certifier, c’est-à-dire à garantir le caractère halal de ses produits sans convoquer d’OCVH."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
