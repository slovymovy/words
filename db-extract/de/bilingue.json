                "senses": [
                    {
                        "sense_id": "dae6a4af-af02-3a3b-9684-89c8da65ee4f",
                        "entry_id": "10699a33-7245-3998-9498-5b6c381f81cb",
                        "glosses": [
                            "zwei Sprachen beherrschend, in zwei Sprachen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "7863f09d-7e08-473a-b339-091a5c292fe0",
                                "sense_id": "dae6a4af-af02-3a3b-9684-89c8da65ee4f",
                                "text": "An unserer Schule unterrichten seit mehreren Jahren nur Lehrkräfte, die bilingue sind."
                            },
                            {
                                "example_id": "758dc88e-d02d-4ecc-b39f-9549b266fe06",
                                "sense_id": "dae6a4af-af02-3a3b-9684-89c8da65ee4f",
                                "text": "„Schon die bilinguen mesopotamischen Kultlieder sprechen diese Freude der Opferteilnehmer aus, indem sie den Chor singen lassen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f68ec4f1-bcc3-4cc8-9310-495a1d3ecdf8",
                        "source_entry_id": "10699a33-7245-3998-9498-5b6c381f81cb",
                        "source_sense_id": "dae6a4af-af02-3a3b-9684-89c8da65ee4f",
                        "source_sense_description": "fachsprachlich: zwei Sprachen beherrschend, in zwei Sprachen",
                        "target_lang_word": "bilingual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bilingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "138c1447-b473-3336-bdf7-7fd3f3c84109",
                                        "entry_id": "6049b855-3c02-37b0-8867-b378c847b437",
                                        "glosses": [
                                            "Having the ability to speak two languages fluently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0911ae2a-9e85-4f70-b24b-abe3c5d010c7",
                                                "sense_id": "138c1447-b473-3336-bdf7-7fd3f3c84109",
                                                "text": "Since she is bilingual she has them written in both English and Spanish."
                                            },
                                            {
                                                "example_id": "7959e695-9ed0-452c-99ce-57928161d05c",
                                                "sense_id": "138c1447-b473-3336-bdf7-7fd3f3c84109",
                                                "text": "Instead of nonnative speakers, we should be called bilingual or multilingual speakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518103d8-9b09-37c9-9aa5-a0fa049d2210",
                                        "entry_id": "6049b855-3c02-37b0-8867-b378c847b437",
                                        "glosses": [
                                            "Spoken or written in two different languages."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc487b8-8c57-405e-9dd3-ab0a07898544",
                                                "sense_id": "518103d8-9b09-37c9-9aa5-a0fa049d2210",
                                                "text": "a bilingual dictionary"
                                            },
                                            {
                                                "example_id": "101733cc-09f6-46f0-bb10-713c3abed7b9",
                                                "sense_id": "518103d8-9b09-37c9-9aa5-a0fa049d2210",
                                                "text": "All signage in and around the station is bilingual in Welsh and English, while station announcements and passenger information screens provide real-time information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade3d43c-1779-3e17-9c1a-baa4933191ac",
                                        "entry_id": "6049b855-3c02-37b0-8867-b378c847b437",
                                        "glosses": [
                                            "Characterized by the use or presence of two languages."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0910bca8-84f9-4303-9969-4015f8b2c60b",
                                                "sense_id": "ade3d43c-1779-3e17-9c1a-baa4933191ac",
                                                "text": "bilingual education"
                                            },
                                            {
                                                "example_id": "ab6da681-ffb3-40a2-afea-b0aca5e60612",
                                                "sense_id": "ade3d43c-1779-3e17-9c1a-baa4933191ac",
                                                "text": "Ocasio-Cortez’s trolling went bilingual in November when a Fox News show, “The Story,” had a prime-time discussion about Ocasio-Cortez’s shoes, including an acknowledgment that the network spent a lot of time talking about a woman who had not even been sworn into Congress yet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bilingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a18c84-e5f2-30aa-a94b-e471a11e91bc",
                                        "entry_id": "b3ebea53-0a89-3126-8e99-53a1848e20d5",
                                        "glosses": [
                                            "A person who is able to use two languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f03d083-c8a0-44d2-8ffd-d5a24f0d2e82",
                                                "sense_id": "d3a18c84-e5f2-30aa-a94b-e471a11e91bc",
                                                "text": "Most striking, numerous studies have even shown that bilinguals undergo a later onset of dementia, perhaps of around four years, on average. But some of these studies have failed to replicate, leaving experts wondering whether the effect is real, and if so, what exactly it consists of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
