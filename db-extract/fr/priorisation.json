                "forms": [
                    {
                        "form_id": "a1137339-3a48-4d63-8e67-a04052fd68bf",
                        "entry_id": "e2c5a58c-ff7a-3415-a421-a69f506a9c09",
                        "tags": [
                            "plural"
                        ],
                        "form": "priorisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62ad9e9d-ea77-3b14-be4c-801b773cac47",
                        "entry_id": "e2c5a58c-ff7a-3415-a421-a69f506a9c09",
                        "glosses": [
                            "Action de prioriser, de donner une importance prioritaire à quelqu’un ou à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba211186-9157-441e-97e3-e346bb4d94f8",
                                "sense_id": "62ad9e9d-ea77-3b14-be4c-801b773cac47",
                                "text": "« Et malheureusement, on en a la preuve », a-t-il déclaré lors d’une conférence de presse destinée à présenter le plan de vaccination du gouvernement Legault, qui prévoit la priorisation des résidents en CHSLD."
                            },
                            {
                                "example_id": "a2aa53b6-0008-47c2-ac36-486fddfba22a",
                                "sense_id": "62ad9e9d-ea77-3b14-be4c-801b773cac47",
                                "text": "La priorisation des soins intensifs pourrait venir plus vite que prévu"
                            },
                            {
                                "example_id": "40c057fa-37b1-4291-8590-f088caba5c02",
                                "sense_id": "62ad9e9d-ea77-3b14-be4c-801b773cac47",
                                "text": "Un protocole de priorisation aux soins intensifs a été mis à jour en novembre par le ministère de la Santé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cb10a1a-861f-454d-90a4-655f9322deba",
                        "source_entry_id": "e2c5a58c-ff7a-3415-a421-a69f506a9c09",
                        "source_sense_id": "62ad9e9d-ea77-3b14-be4c-801b773cac47",
                        "target_lang_word": "Priorisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priorisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                        "entry_id": "bfce9f2d-8672-370e-a1ba-95c96feba01b",
                                        "glosses": [
                                            "Vorgang, etwas eine höhere Wichtigkeit zu geben, als etwas anderem; Vorgang, etwas den Vorrang vor etwas anderem zu geben; Festlegen einer Priorität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "330523de-650f-4050-a7d1-325c552b2b23",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "Wir werden in Europa immer im Durchschnitt fetter. Wir brauchen eine Priorisierung der täglichen Stunde Sport!"
                                            },
                                            {
                                                "example_id": "7fa225e2-4d79-4439-9bdd-29d60b08abb2",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "„Die Priorisierung erfolgt anhand transparenter Kriterien […]“"
                                            },
                                            {
                                                "example_id": "41d19d62-0bcf-4589-a40d-faaa1a6745b9",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "„Das Konzept enthält eine Tabelle, in der sämtliche Projekte […] mit zeitlicher Priorisierung aufgelistet sind.“"
                                            },
                                            {
                                                "example_id": "87528951-1562-4d6b-809a-90edfd925f86",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "Ist in Deutschland von der Bevölkerung wirklich eine Priorisierung des ÖPNV und Fahrradverkehrs gegenüber dem Auto gewünscht? Guckt man sich die Debatte um Dieselfahrverbote an: Nein!"
                                            },
                                            {
                                                "example_id": "e4b161ed-3041-4051-b4a4-ae52fa8d736b",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "Man ist spielsüchtig, wenn eine Priorisierung des Spielens zum Ersetzen von Vorgängen des täglichen Lebens führt, beispielsweise von Essen oder der täglichen Hygiene."
                                            },
                                            {
                                                "example_id": "cc9d5710-a837-432b-b2ee-560ed13801ba",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "„Aus ihrer Sicht [der in der Studie Befragten] wäre es die richtige Priorisierung, wenn erst mal die Probleme aus ihrem eigenen Lebensumfeld, aus ihrer eigenen Realität bearbeitet werden würden. Und dann die Probleme, die wir in der großen weiten Welt sehen.“"
                                            },
                                            {
                                                "example_id": "950b316b-0bf3-4bf0-872d-9598ee030c48",
                                                "sense_id": "bbb9c37e-b089-3959-939f-a41e94a1184d",
                                                "text": "„Ich glaube, wir brauchen [für die Bundeswehr] eine Debatte über Priorisierung. Wo wollen wir sein, was ist uns wichtig und wo gibt es Felder, die wir uns einfach nicht mehr leisten können?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
