{
    "word_family": [
        "antidotal",
        "antidotally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                    "sense_definition": "A substance that counteracts or neutralizes the effects of a poison, toxin, or venom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cure_remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She reached the hospital in time to receive the <w>antidote</w> for snake venom.",
                            "target_lang_translations": {
                                "nl": "Ze bereikte het ziekenhuis op tijd om het <w>tegengif</w> tegen slangengif te krijgen."
                            }
                        },
                        {
                            "text": "Scientists are trying to develop a universal <w>antidote</w> against toxic chemicals.",
                            "target_lang_translations": {
                                "nl": "Wetenschappers proberen een universeel <w>tegengif</w> tegen giftige chemicaliën te ontwikkelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "remedy"
                    ],
                    "common_phrases": [
                        "universal antidote",
                        "effective antidote",
                        "antidote for poison",
                        "administer an antidote"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een middel dat de werking van een gif of toxine neutraliseert of tegengaat."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tegengif",
                                "target_lang_sense_clarification": "middel tegen gif of toxines"
                            },
                            {
                                "target_lang_word": "antidotum",
                                "target_lang_sense_clarification": "medische term voor tegengif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                    "sense_definition": "Something that relieves, prevents, or counteracts a harmful or unpleasant situation or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cure_remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laughter can often be the best <w>antidote</w> to a stressful day at work.",
                            "target_lang_translations": {
                                "nl": "Lachen kan vaak het beste <w>tegengif</w> zijn voor een stressvolle werkdag."
                            }
                        },
                        {
                            "text": "Education is our most reliable <w>antidote</w> against widespread misinformation.",
                            "target_lang_translations": {
                                "nl": "Onderwijs is ons meest betrouwbare <w>tegengif</w> tegen wijdverbreide desinformatie."
                            }
                        }
                    ],
                    "synonyms": [
                        "remedy"
                    ],
                    "common_phrases": [
                        "perfect antidote",
                        "antidote to stress",
                        "antidote to boredom",
                        "welcome antidote"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets wat een schadelijke, vervelende situatie of een negatief gevoel verlicht of tegengaat."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "tegengif",
                                "target_lang_sense_clarification": "figuurlijk, tegen een negatieve situatie"
                            },
                            {
                                "target_lang_word": "remedie",
                                "target_lang_sense_clarification": "oplossing of middel ter verlichting"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                    "sense_definition": "To counteract or neutralize the effects of something harmful, especially poison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cure_remedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient avoided certain drinks to ensure nothing <w>antidoted</w> the medication.",
                            "target_lang_translations": {
                                "nl": "De patiënt vermeed bepaalde dranken om ervoor te zorgen dat niets de medicatie <w>neutraliseerde</w>."
                            }
                        },
                        {
                            "text": "Certain herbal compounds are believed to <w>antidote</w> the toxin naturally.",
                            "target_lang_translations": {
                                "nl": "Men vermoedt dat bepaalde kruidenverbindingen de toxine op natuurlijke wijze <w>ontgiften</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De werking van iets schadelijks, met name gif, tegengaan of neutraliseren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontgiften",
                                "target_lang_sense_clarification": "de werking van gif ongedaan maken"
                            },
                            {
                                "target_lang_word": "neutraliseren",
                                "target_lang_sense_clarification": "schadelijke effecten tenietdoen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}