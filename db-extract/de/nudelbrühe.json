                ],
                "senses": [
                    {
                        "sense_id": "06e2318c-615f-3001-be42-df85f5364042",
                        "entry_id": "377ac1db-03c6-3800-83e6-cfec60e1679a",
                        "glosses": [
                            "eine Suppe (Brühe) mit Nudeln"
                        ],
                        "tags": [
                            "mittel- und norddeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "e77b4064-27d8-44ea-9990-b6e04006cb90",
                                "sense_id": "06e2318c-615f-3001-be42-df85f5364042",
                                "text": "„Ungekrönter König unter den Eintopfgerichten ist die ‚fabada‘ (Schweinefleisch-Bohnen-Eintopf) aus Asturien, obwohl ‚cocido‘, ein Eintopf aus Nudelbrühe, Karotten, Kohl, Kichererbsen, Huhn, ‚morcilla‘ (Blutwurst), Rindfleisch und Speck das Lieblingsgericht in Madrid und León ist.“"
                            },
                            {
                                "example_id": "e6ed8c12-2a3c-48f3-8b76-8b7bd52ddfd1",
                                "sense_id": "06e2318c-615f-3001-be42-df85f5364042",
                                "text": "„Es brannte so grässlich, dass ihm kugelrunde Tränen in die Augen schossen und er das Gefühl hatte, statt der Nudelbrühe ein glühendes Stück Grillkohle verschluckt zu haben.“"
                            },
                            {
                                "example_id": "bae15d91-f137-4f23-af48-1d0f3c1924e6",
                                "sense_id": "06e2318c-615f-3001-be42-df85f5364042",
                                "text": "„Timo musste die Gans ausnehmen und von dem Gänseklein kochten sie einen Topf Nudelbrühe.“"
                            },
                            {
                                "example_id": "8230620d-4bd5-49a1-ba8a-4fb2eb814f6d",
                                "sense_id": "06e2318c-615f-3001-be42-df85f5364042",
                                "text": "„Modern sortiert vom Hamburger über Pizza, Salat und Nudelbrühen kann man bei zeitiger Vorbestellung auch chaletmäßig Raclette oder Fondue essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                        "entry_id": "377ac1db-03c6-3800-83e6-cfec60e1679a",
                        "glosses": [
                            "das Wasser, in dem die Nudeln gekocht wurden"
                        ],
                        "tags": [
                            "mittel- und norddeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "eed42962-9a5b-4bce-9de6-d7fb7827c301",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Schinken-Nudeln […] Aus der Nudelbrühe können angenehme Suppen bereitet werden.“"
                            },
                            {
                                "example_id": "96c7ee7a-5692-455a-add9-627b31405fba",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Milchsuppe von Nudelbrühe (Milk Soup of Liquid from Boiled Noodles) / Milchsuppe von Brühe, worin Gemüsennudeln gekocht sind (Milk Soup of Liquid from boiled Noodles)“"
                            },
                            {
                                "example_id": "acbdedda-12bc-4622-9957-82f5f30e4dfd",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Wenn Du die Krabben bekommst, prüfe am besten – Finger lecken o.ä. –, ob sie in Süßwasser geliefert werden oder Nudelbrühe. *g* Dann bitte nicht den Salzgehalt zu plötzlich ändern.“"
                            },
                            {
                                "example_id": "8579b908-5f8a-4272-bd5b-36a8a84a4318",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Nudeln in einem Sieb abgießen, dabei etwas Flüssigkeit auffangen. […] 5 EL der Nudelbrühe mit Zitronen- oder Limettensaft, Ketchup, Sojasauce und Sesamöl verrühren. Nudeln klein schneiden und mit Ananaswürfeln, Zuckerschoten und Krabben unter das Dressing heben.“"
                            },
                            {
                                "example_id": "c1fdabb1-41c8-49aa-82b1-2908ea84ae2c",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Die Tagliatelle „al dente“ garen. Ca. 50 ml Nudelbrühe mit Butter aufschlagen und mit Meersalz verfeinern. Die Tagliatelle und etwas gehobelte Trüffel dazu geben und kurz schwenken.“"
                            },
                            {
                                "example_id": "0127f33d-50f6-42ce-93a6-f2447dae010e",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Inzwischen die Nudeln in leicht gesalzenem Wasser al dente kochen. Etwas von der Nudelbrühe zur Schokoladenmasse hinzufügen, bis eine nicht zu flüssige Sauce entsteht.“"
                            },
                            {
                                "example_id": "343c9c8c-5ff7-44b1-a150-724ea7399eac",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Walnüsse klein hacken und zusammen mit den Pistazien in einer Pfanne erhitzen. Kürbiskernöl, 1 El. Öl von den Tomaten und geriebenen Pecorinokäse zufügen. 2 Schöpfkellen Nudelbrühe angießen und die Kräuter zufügen.“"
                            },
                            {
                                "example_id": "da6896d1-418b-4d9f-896f-5a96b0915e74",
                                "sense_id": "63c23758-66d1-3344-9ea8-1f6dd2ff07f5",
                                "text": "„Spaghettini nach Packungsanleitung in reichlich Salzwasser kochen, abgießen und abtropfen lassen. Dabei etwa 100 ml Nudelbrühe auffangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
