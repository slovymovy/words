                                            {
                                                "example_id": "2b635675-27f6-4c9d-a818-592db4f28a09",
                                                "sense_id": "90a779fc-2e9a-3d37-8eb1-aa4f4960ee71",
                                                "text": "„Zur Technik: Um beispielsweise ein Gebäude zu schützen, wird die Hand am Eingang vor einen Sensor gehalten, der das \"versteckte\" Venenmuster der Handfläche oder eines Fingers berührungslos erfasst.“"
                                            },
                                            {
                                                "example_id": "4e2d4200-45e5-4e47-a86c-34851295d2e8",
                                                "sense_id": "90a779fc-2e9a-3d37-8eb1-aa4f4960ee71",
                                                "text": "„Dieses Verfahren funktioniert berührungslos.“"
                                            },
                                            {
                                                "example_id": "c6206637-f5fb-4a79-9dd8-2cd0610b7e28",
                                                "sense_id": "90a779fc-2e9a-3d37-8eb1-aa4f4960ee71",
                                                "text": "„LumaSense stellt neue Spezial-Pyrometer vor, die zur berührungslosen Temperaturmessung bei der Herstellung von extrem dünnem Glas verwendet werden“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
