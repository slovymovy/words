                        "glosses": [
                            "A small falcon, Falco columbarius, that breeds in northern North America, Europe, and Asia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bead47b-2eb3-4192-9588-97d30bb8cfdf",
                                "sense_id": "85ad6905-92a8-33d5-b928-800d888cd451",
                                "text": "The gentle falcon, that with its feet distraineth / The kingës hand; the hardy sperhawke eke, / The quailës foe; the merlion that paineth / Himself full oft the larkë for to seek; [...]"
                            },
                            {
                                "example_id": "64715bcf-ac2e-4897-b080-b2e0ecd652ea",
                                "sense_id": "85ad6905-92a8-33d5-b928-800d888cd451",
                                "text": "Smaller and less powerful falcons included the merlon, the hobby, and the kesterel."
                            }
                        ]
                    }
