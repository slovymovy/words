                "senses": [
                    {
                        "sense_id": "6617e0c7-6912-362c-a813-3e6292792bc6",
                        "entry_id": "33c7bc40-77b8-3186-8675-4df2be798007",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df2c2c9-cd16-4b6c-a4c4-bcc4e8f45ec0",
                                "sense_id": "6617e0c7-6912-362c-a813-3e6292792bc6",
                                "text": "Charlie geht einkaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92d1f56f-e0b1-4575-8c75-ea58e6c95b49",
                        "source_entry_id": "33c7bc40-77b8-3186-8675-4df2be798007",
                        "source_sense_id": "6617e0c7-6912-362c-a813-3e6292792bc6",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Charlie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charlie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f262c402-7da3-376b-a293-0a81cf4f7586",
                                        "entry_id": "740d1fba-8f0a-3927-b88f-4e63f7942343",
                                        "glosses": [
                                            "A unisex given name.",
                                            "A diminutive of the male given name Charles; also used as a formal given name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0707477-da3a-4491-a3bb-7161b29d676a",
                                                "sense_id": "f262c402-7da3-376b-a293-0a81cf4f7586",
                                                "text": "Heaven only knows why a man with a strong biblical name like James wants to be a president named Jimmy. I'm certain that if he were called Charles, he wouldn't fool around that way. Charles is not so bad, but Charlie is a terrible burden to bear."
                                            },
                                            {
                                                "example_id": "1dfa4a64-1542-48c4-b3fb-1c4a94504812",
                                                "sense_id": "f262c402-7da3-376b-a293-0a81cf4f7586",
                                                "text": "People were seen exiting a building on Utah Valley University after Charlie Kirk, the CEO and co-founder of the conservative youth organization Turning Point USA, was shot Wednesday at an event on campus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36eeffe3-255a-3a5d-8d97-e5dc5d9974b7",
                                        "entry_id": "740d1fba-8f0a-3927-b88f-4e63f7942343",
                                        "glosses": [
                                            "A unisex given name.",
                                            "A diminutive of the female given name Charlotte or Charlene, also used as a formal given name, although less common than the male name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28aae048-fc4c-40c1-b90b-3463770c36b8",
                                                "sense_id": "36eeffe3-255a-3a5d-8d97-e5dc5d9974b7",
                                                "text": "'Can I call you Charlotte?'\n'No. I hate the name, makes me sound like a Victorian aunt. I'm Charlie, and no, you can't call me that either.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ad2213-7389-3243-95d7-6a8bc9d84cfb",
                                        "entry_id": "740d1fba-8f0a-3927-b88f-4e63f7942343",
                                        "glosses": [
                                            "A name for a fox in fables and folk literature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73430c2f-ecb8-45d8-9f90-12fe9397936b",
                                                "sense_id": "26ad2213-7389-3243-95d7-6a8bc9d84cfb",
                                                "text": "[I]t is a land of large, rich pastures bounded by ox-fences, and covered with fine hedgerow timber, with here and there a nice little gorse or spinney, where abideth poor Charley, having no other cover to which to betake himself for miles and miles, when pushed out some fine November morning by the old Berkshire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Charlie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d541a9a1-89d7-3a3d-a7b7-c2a762aaed82",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "radiotelephony clear-code word for the letter C."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e7d1e8a-8482-3c32-9b4d-e29db97d64ff",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "The Vietcong (Victor Charlie); (by extension, sometimes) any enemy."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0f1d64-37bc-4e72-84ea-b1b3d8ff9267",
                                                "sense_id": "1e7d1e8a-8482-3c32-9b4d-e29db97d64ff",
                                                "text": "I learned a thing or two from Charlie, don't you know? You better stay away from Copperhead Road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcffe7c2-4b80-3c54-9955-f0ee929e639c",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "Cocaine."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d91697e-814f-3e77-8294-263bb9b84b6a",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "A fool."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "often",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa67110-7d1d-472f-b6c4-1c4c7c09e97c",
                                                "sense_id": "3d91697e-814f-3e77-8294-263bb9b84b6a",
                                                "text": "You look a right Charlie in that clown outfit! — Yes, we make a right pair of Charlies."
                                            },
                                            {
                                                "example_id": "9e053757-6b9a-42f6-8028-b314f855f4f5",
                                                "sense_id": "3d91697e-814f-3e77-8294-263bb9b84b6a",
                                                "text": "He looked a right Charlie in those tails and striped trousers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0480cedf-c19f-32c8-b89f-5a336019a7cc",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "A woman's breast"
                                        ],
                                        "tags": [
                                            "plural-normally",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22987d10-5cdc-4136-8b2e-29641ad699e5",
                                                "sense_id": "0480cedf-c19f-32c8-b89f-5a336019a7cc",
                                                "text": "There's not a man she won't go with. She lets even the small boys feel her charlies."
                                            },
                                            {
                                                "example_id": "b41a5528-8efc-42a0-be90-91c3318f4979",
                                                "sense_id": "0480cedf-c19f-32c8-b89f-5a336019a7cc",
                                                "text": "[…]being turned on by a woman who was also a person and had stuff going for herself, and knowing that even if my Wurlitzer rotted and fell off, even if her Charlies sagged and turned to empty baggies, we'd still be buddies and craft companions"
                                            },
                                            {
                                                "example_id": "7665ea90-0c7f-4a1e-869c-8f95e4fa80c9",
                                                "sense_id": "0480cedf-c19f-32c8-b89f-5a336019a7cc",
                                                "text": "'Hullo, Jacob.' She grins at him over her counter as he eyes her charlies sticking through her sweater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f97136b-cd2f-3829-9a60-78dc8b21834d",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "A nightwatchman."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2b98bbf-10b8-3e53-9ff6-29832d6b604d",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "A short, pointed beard, like that of King Charles I."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f13ac958-482a-492f-9fc7-cf27669084b7",
                                                "sense_id": "e2b98bbf-10b8-3e53-9ff6-29832d6b604d",
                                                "text": "[…] the sons are adorned in the very height of the fashion, with white pantaloons, watch chains and Wellingtons, and a charley at their under lip […]"
                                            },
                                            {
                                                "example_id": "4070d971-f912-4302-8685-3bf29498250e",
                                                "sense_id": "e2b98bbf-10b8-3e53-9ff6-29832d6b604d",
                                                "text": "That square, short man... wearing a moustache and Charlie is William Laud [F&H]."
                                            },
                                            {
                                                "example_id": "b8078867-54f6-4650-95d2-587a6c1109f3",
                                                "sense_id": "e2b98bbf-10b8-3e53-9ff6-29832d6b604d",
                                                "text": "This Cholly guy wants to do a brodie off the rattler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341ed047-3887-3baf-b150-6f059246e73f",
                                        "entry_id": "12569f4b-223d-320a-82bc-21d70c0e4614",
                                        "glosses": [
                                            "The situation in some blackjack variants where a player wins automatically by showing a hand with the correct number of cards."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
