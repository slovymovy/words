                    {
                        "form_id": "4190d513-c47a-4b5b-84c6-08f0f3198a09",
                        "entry_id": "ec9c1211-4603-3d1e-b9da-ec21f6fe80e4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vertraulichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f7f73e4-3664-3050-82e6-d6fb33f4eaa0",
                        "entry_id": "ec9c1211-4603-3d1e-b9da-ec21f6fe80e4",
                        "glosses": [
                            "Eigenschaft, vertraulich, nur für einen begrenzten Kreis zugänglich zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "663fa31c-45f9-4c9a-80e1-f6a277499486",
                                "sense_id": "1f7f73e4-3664-3050-82e6-d6fb33f4eaa0",
                                "text": "„Dieser gab ganz besonders auf solche Vertraulichkeiten Obacht und machte Goldlotos Mitteilung, so wie er etwas hörte.“"
                            },
                            {
                                "example_id": "55e265fa-4d55-42ce-acc6-e63f73a52b6c",
                                "sense_id": "1f7f73e4-3664-3050-82e6-d6fb33f4eaa0",
                                "text": "„Als Willarski hörte, Besuchow sei in Orel, suchte er ihn auf, obwohl er nie sehr gut mit ihm bekannt gewesen war, und überschüttete ihn mit allen den freundschaftlichen Vertraulichkeiten, mit denen sich Menschen begrüssen, wenn sie einander in der Wüste begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbe1038a-e7ec-3dbd-a65a-62d477bdb2d6",
                        "entry_id": "ec9c1211-4603-3d1e-b9da-ec21f6fe80e4",
                        "glosses": [
                            "Eigenschaft, zu vertraulich (zudringlich) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7cfc77c-c021-406b-8791-1f6040201865",
                                "sense_id": "fbe1038a-e7ec-3dbd-a65a-62d477bdb2d6",
                                "text": "Die Vertraulichkeiten des Kollegen gehen ihm zu weit."
                            },
                            {
                                "example_id": "dcbd8e76-1e61-48da-aece-f9d2e9a4ceb7",
                                "sense_id": "fbe1038a-e7ec-3dbd-a65a-62d477bdb2d6",
                                "text": "„Aber unter dem Schutz so versuchsweise etablierter und geregelter Vertrautheit nimmt er sich allerhand Vertraulichkeiten heraus, es geht mit ihm geradezu durch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "093a576c-7dc0-46f4-a89d-4526a3fb3e0e",
                        "source_entry_id": "ec9c1211-4603-3d1e-b9da-ec21f6fe80e4",
                        "source_sense_id": "1f7f73e4-3664-3050-82e6-d6fb33f4eaa0",
                        "source_sense_description": "Eigenschaft, vertraulich, nur für einen begrenzten Kreis zugänglich zu sein",
                        "target_lang_word": "confidentialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidentialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f40b361a-060d-34b2-bf9e-3691a3c37472",
                                        "entry_id": "9f9257af-1186-3ffa-8f07-6f2e32960da5",
                                        "glosses": [
                                            "Fait de réserver des informations à un petit nombre de personnes déterminées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d8c8b9-3427-4004-b97c-ccc5e1208a48",
                                                "sense_id": "f40b361a-060d-34b2-bf9e-3691a3c37472",
                                                "text": "Les banques suisses de plus petite taille sont confiantes qu'elles pourront en affaiblir les effets et continueront à en profiter en trouvant des moyens nouveaux et plus élaborés pour protéger la confidentialité de leurs clients."
                                            },
                                            {
                                                "example_id": "2244622b-d12d-493c-bd9d-6c8bb0b05b9e",
                                                "sense_id": "f40b361a-060d-34b2-bf9e-3691a3c37472",
                                                "text": "Elle ressemblait à un coffret à cigares mais, en fait, c’était une boîte antihacking. Une sorte de cage de Faraday qui assurait une confidentialité presque inviolable des conversations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
