                        "sense_id": "91f1c26c-d6b5-3c44-91e9-6703102b5cb8",
                        "entry_id": "74e730c7-bd1a-323f-9b7a-e22951effbfb",
                        "glosses": [
                            "The edible root of the yam bean (Pachyrhizus erosus) used in salads in Central America and as a snack in Mexico."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9701cd9c-27fc-4f7f-8949-a5689fdbb737",
                        "source_entry_id": "74e730c7-bd1a-323f-9b7a-e22951effbfb",
                        "source_sense_id": "91f1c26c-d6b5-3c44-91e9-6703102b5cb8",
                        "source_sense_description": "the edible root of the yam bean",
                        "target_lang_word": "jícama",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jícama",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7671e064-08c4-38e2-a382-6131eda977e3",
                                        "entry_id": "20fe4226-4510-3ca8-8b94-3f999d6b29d7",
                                        "glosses": [
                                            "Nom vernaculaire de Pachyrhizus erosus , plante grimpante mexicaine, de la famille des Fabacées (Fabaceae), cultivée pour ses racines tubérisées comestibles qui se mangent crues, elle est cultivée au Mexique, en Amérique centrale et en Asie du Sud-Est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d73c78f3-ed63-4c7b-80ae-1e4b3d8fc4d3",
                                                "sense_id": "7671e064-08c4-38e2-a382-6131eda977e3",
                                                "text": "D’après le Dʳ Ed. Palmer, le Jicama est très cultivé au Mexique, où l’on a soin d’enlever les fleurs afin de conserver aux racines toute leur valeur alimentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca47038-92b4-3dbd-96b5-4fa5ebb29140",
                                        "entry_id": "20fe4226-4510-3ca8-8b94-3f999d6b29d7",
                                        "glosses": [
                                            "Nom vernaculaire de Pachyrhizus tuberosus , plante grimpante du nord ouest de l’Amérique du Sud, de la famille des Fabacées (Fabaceae), cultivée pour ses racines tubérisées comestibles qui se mangent crues."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99606e09-3524-3aa1-b160-71363277be53",
                                        "entry_id": "20fe4226-4510-3ca8-8b94-3f999d6b29d7",
                                        "glosses": [
                                            "Sa racine tubérisée généralement consommée crue."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2ce04c-1b02-4b0c-b6b9-71e9f2db1bae",
                                                "sense_id": "99606e09-3524-3aa1-b160-71363277be53",
                                                "text": "Même les vendeurs de mangues marinées, de goyaves au sel pimenté, de jicama rafraîchi avaient déjà quitté le trottoir devant l’école quand, éblouies par le soleil couchant, Mai et moi le voyions arriver au loin, cheveux au vent, arborant un sourire enflammé, incomparable."
                                            },
                                            {
                                                "example_id": "a7ab77a0-bcad-4f15-899a-b196ab558bd2",
                                                "sense_id": "99606e09-3524-3aa1-b160-71363277be53",
                                                "text": "En Europe, vous trouverez du jicama dans des épiceries latinoaméricaines ou asiatiques (qui offrent des produits exotiques d’origines diverses)."
                                            },
                                            {
                                                "example_id": "eb6ef090-d0ed-4165-a664-f8543090263f",
                                                "sense_id": "99606e09-3524-3aa1-b160-71363277be53",
                                                "text": "Le jicama est un légume croquant à la saveur douce, pomme de terre. Meilleur cru, c’est aussi une excellente source d’inuline, une fibre soluble qui agit comme un prébiotique, en venant nourrir les bonnes bactéries de l'intestin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
