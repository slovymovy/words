                        "glosses": [
                            "Très grand trimaran, très rapide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ce3759-07d3-4580-86f8-8b7a4d46f328",
                                "sense_id": "898cec98-5566-3834-973e-103398cb3426",
                                "text": "Je croise au restaurant « Les Délices du quai», Thomas Coville. Oui, le skipper de Sodebo, des maxi-trimarans Ultim’, le chasseur de records, recordman du tour du monde en solitaire en 2016."
                            },
                            {
                                "example_id": "29cd3ae0-7074-4d58-9e27-e3a33b971146",
                                "sense_id": "898cec98-5566-3834-973e-103398cb3426",
                                "text": "Le maxi-trimaran Spindrift 2, coskippé par le Français Yann Guichard et la Suissesse Dona Bertarelli, a remporté mardi soir la Transat (en équipage) Québec-Saint-Malo en temps réel, battant par la même occasion le record de l’épreuve."
                            },
                            {
                                "example_id": "13c8f65a-1cca-4a1f-9377-62d2f7d5ae75",
                                "sense_id": "898cec98-5566-3834-973e-103398cb3426",
                                "text": "Les maxi-trimarans sont d’ailleurs des homothéties de ces mêmes trimarans Orma."
                            }
                        ]
