                "senses": [
                    {
                        "sense_id": "2b94b4f5-b76f-3425-be38-2de8074c3c6b",
                        "entry_id": "bc5afa4c-d564-3647-a706-c8313109f320",
                        "glosses": [
                            "die dem Schutz der Allgemeinheit dienende Unterbringung eines Straftäters in einer Anstalt nach Verbüßen seiner Freiheitsstrafe, die bei andauernder Gefährlichkeit angeordnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222ff8c0-586b-4f05-a541-26c86bbd4b4e",
                                "sense_id": "2b94b4f5-b76f-3425-be38-2de8074c3c6b",
                                "text": "Das Urteil lautet auf Freiheitsstrafe von zehn Jahren mit anschließender Sicherungsverwahrung."
                            },
                            {
                                "example_id": "4008ee57-bfab-4c81-a4d6-cbd9dcc4353e",
                                "sense_id": "2b94b4f5-b76f-3425-be38-2de8074c3c6b",
                                "text": "„Die Internierten befanden sich in einer Sicherungsverwahrung, deren zeitliches Ende allein im Ermessen der Regierung lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
