                    ]
                },
                {
                    "sense_id": "645f90a1-104d-36e0-933c-1449ca84a734",
                    "sense_definition": "Qui est extraordinairement célèbre, au point de susciter l'admiration générale comme dans un mythe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "celebrité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce guitariste a acquis une renommée <w>légendaire</w> grâce à ses solos d'une virtuosité impressionnante."
                        },
                        {
                            "text": "Le festival accueillera ce soir un groupe <w>légendaire</w> des années soixante-dix."
