                                    },
                                    {
                                        "sense_id": "f78594b2-8f02-3987-a6ce-08a073e40eae",
                                        "entry_id": "9ee8a3b6-6c1f-3f4e-ae43-cc290412a1a5",
                                        "glosses": [
                                            "To stop (an activity) for a while."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902612be-3012-4d0f-94da-89b53cbf4897",
                                                "sense_id": "f78594b2-8f02-3987-a6ce-08a073e40eae",
                                                "text": "The general public could therefore have been forgiven for thinking that work on the new station had stopped. But pausing work on an active construction site of this size is not straightforward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                                        "entry_id": "9ee8a3b6-6c1f-3f4e-ae43-cc290412a1a5",
                                        "glosses": [
                                            "To interrupt an activity and wait."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14c17aa-27fe-438f-8fd1-41f7ef06b118",
                                                "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                                                "text": "When telling the scary story, he paused for effect."
                                            },
                                            {
                                                "example_id": "134ccadf-3f4b-4704-bc7d-cea14c433c64",
                                                "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                                                "text": "Tarry, pause a day or two."
                                            },
                                            {
                                                "example_id": "fb1dcde3-3c9d-4c79-868a-bd32a06c23bd",
                                                "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                                                "text": "pausing a while thus to herself she mused"
                                            },
                                            {
                                                "example_id": "a6d99a0b-ce9d-40c9-9609-a58155d25574",
                                                "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough![…]What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            },
                                            {
                                                "example_id": "fbbad73b-9574-4743-ada3-6b34c07da4d0",
                                                "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                                                "text": "Will this affect HS2 and other major projects?\n[...] Work at the majority of sites has paused, although some staff may be present to ensure the safety and security of these sites and to make safety assessments. [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f756344-38e1-32e1-9e22-b96dd2917499",
                                        "entry_id": "9ee8a3b6-6c1f-3f4e-ae43-cc290412a1a5",
                                        "glosses": [
                                            "To hesitate; to hold back; to delay."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07af83f2-d76b-48d3-8a65-b7170d523d5b",
                                                "sense_id": "7f756344-38e1-32e1-9e22-b96dd2917499",
                                                "text": "Why doth the Jew pause? Take thy forfeiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbce6c5c-d0ff-3f57-8e61-7e2ba873e502",
                                        "entry_id": "9ee8a3b6-6c1f-3f4e-ae43-cc290412a1a5",
                                        "glosses": [
                                            "To halt the play or playback of, temporarily, so that it can be resumed from the same point."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b0ee07-8b75-43ec-b12f-0f4c423889a3",
                                                "sense_id": "cbce6c5c-d0ff-3f57-8e61-7e2ba873e502",
                                                "text": "to pause a song, a video, or a computer game"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6bd2631-91da-3a14-aac6-031e33f86cd5",
                                        "entry_id": "9ee8a3b6-6c1f-3f4e-ae43-cc290412a1a5",
                                        "glosses": [
                                            "To consider; to reflect."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58785ba8-561c-40c0-83d2-380899da9311",
                                                "sense_id": "a6bd2631-91da-3a14-aac6-031e33f86cd5",
                                                "text": "Take time to pause."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48038ff7-fb23-38fc-98ab-aea92887b873",
                                        "entry_id": "3cd4a9fb-9659-3815-8a93-a27eed2b1527",
                                        "glosses": [
                                            "A temporary stop or rest; an intermission of action; interruption; suspension; cessation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72b11988-026c-4da2-aac7-3e0811a03752",
                                                "sense_id": "48038ff7-fb23-38fc-98ab-aea92887b873",
                                                "text": "If the afternoon was fine they strolled together in the park, very slowly, and with pauses to draw breath wherever the ground sloped upward. The slightest effort made the patient cough."
