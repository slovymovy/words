                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "11968ce3-8fb7-4cb6-b0de-db9ff6f993b4",
                        "entry_id": "9750e5fd-7db7-3f35-a6f6-ab9d773c8a0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiosondes"
