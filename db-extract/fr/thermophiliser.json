                "senses": [
                    {
                        "sense_id": "d8fde32d-e882-3664-bea0-23e65b1f1234",
                        "entry_id": "fdb4e858-5001-3772-99a9-a45be20afe60",
                        "glosses": [
                            "Mesurer la température avec un thermophile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651b2614-8751-4661-adbd-1e0e3baf7ad5",
                                "sense_id": "d8fde32d-e882-3664-bea0-23e65b1f1234",
                                "text": "Une fois thermophilisée, la peau est exposée aux rayons de chaleur."
                            },
                            {
                                "example_id": "3734d053-2102-483a-873c-fb857e98ca73",
                                "sense_id": "d8fde32d-e882-3664-bea0-23e65b1f1234",
                                "text": "Aux balcons, des créatures lunaires à croquer pour du vrai, une diseuse de bonne aventure thermophilisée."
                            },
                            {
                                "example_id": "f700d183-600d-4d7e-af60-a960bf0173ab",
                                "sense_id": "d8fde32d-e882-3664-bea0-23e65b1f1234",
                                "text": "Juste un petit bémol on ne sait pas que dans l'enveloppe il y a un sac zippé et qui lors de l'ouverture on le coupe facilement en voulant ouvrir l'enveloppe qui est thermophilisée."
                            }
                        ]
                    }
