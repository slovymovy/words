                                            {
                                                "example_id": "c5784bf9-3794-471c-adeb-1b2b61675b10",
                                                "sense_id": "4711524e-179e-3b36-bb05-2fe75530da4d",
                                                "text": "Die Meditation beruhigt Seele und Geist."
                                            },
                                            {
                                                "example_id": "e43d1d77-9254-476b-833c-c26c09e3a4d2",
                                                "sense_id": "4711524e-179e-3b36-bb05-2fe75530da4d",
                                                "text": "„In der Meditation beschäftigt man sich viel mit der Atmung.“"
                                            },
                                            {
                                                "example_id": "05e4f555-6d29-43c5-8b6b-7b3665aeaff4",
                                                "sense_id": "4711524e-179e-3b36-bb05-2fe75530da4d",
                                                "text": "„Der Klettersport ist für mich eine Art Meditation geworden.“"
                                            },
                                            {
                                                "example_id": "a090b5fd-d9f0-4d3f-bd7d-d70f465d25fe",
                                                "sense_id": "4711524e-179e-3b36-bb05-2fe75530da4d",
                                                "text": "„Sein erstes Semester war im wesentlichen durch theoretisches Studium und gelegentlich praktische Übungen in Meditation und anderen geistlichen Verrichtungen ausgefüllt.“"
                                            },
                                            {
                                                "example_id": "7dda04f7-70ac-4fec-a1d1-6c018efb5adc",
                                                "sense_id": "4711524e-179e-3b36-bb05-2fe75530da4d",
                                                "text": "„Die Fahnen draußen hängen noch immer so reglos, als wären sie in tiefe Meditation versunken oder gestorben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
