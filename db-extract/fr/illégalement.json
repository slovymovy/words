                                                "sense_id": "9aa13dac-471a-3b75-b5fc-6701dfdbbd46",
                                                "text": "He received a ticket for illegally parking next to a fire hydrant."
                                            },
                                            {
                                                "example_id": "9264ff39-9edc-4360-97bc-0a9c132bc2b3",
                                                "sense_id": "9aa13dac-471a-3b75-b5fc-6701dfdbbd46",
                                                "text": "The dangers of scofflawry vary wildly. The person who illegally spits on the sidewalk remains disgusting, but clearly poses less risk to others than the company that illegally buries hazardous chemical waste in an unauthorized location."
                                            }
