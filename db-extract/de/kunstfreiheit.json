        "de-extract.jsonl": [
            {
                "entry_id": "1ffa78d7-6b20-316b-87de-016d02f6197d",
                "word": "Kunstfreiheit",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "020d0ed4-7d1a-4a49-a73a-7c31f2571e4f",
                        "entry_id": "1ffa78d7-6b20-316b-87de-016d02f6197d",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Kunstfreiheit"
                    },
                    {
                        "form_id": "25f8e91c-e88f-4011-b3e6-f69ffce1bd8d",
                        "entry_id": "1ffa78d7-6b20-316b-87de-016d02f6197d",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Kunstfreiheit"
                    },
                    {
                        "form_id": "20458f6c-0f01-4d80-9c80-b31cbb9985d5",
                        "entry_id": "1ffa78d7-6b20-316b-87de-016d02f6197d",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Kunstfreiheit"
                    },
                    {
                        "form_id": "48a878a6-dd12-444f-ae87-08a8a9fa7947",
                        "entry_id": "1ffa78d7-6b20-316b-87de-016d02f6197d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Kunstfreiheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                        "entry_id": "1ffa78d7-6b20-316b-87de-016d02f6197d",
                        "glosses": [
                            "verfassungsrechtlich garantiertes Grundrecht jedes Menschen (Art. 5 Abs. 3 Satz 1 GG), künstlerische Werke herzustellen und zu verbreiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "247ea886-7183-4bb1-89af-575b992e69b2",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Kunstfreiheit und Urheberrecht – das sind zwei scheinbar unvereinbare Begriffe: Das Festival „100 Jahre Copyright“ lotet die gegenläufigen Interessen von Künstlern und Konsumenten aus.“"
                            },
                            {
                                "example_id": "eab45d4d-db6a-4d99-b05e-448f42b489a7",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Bei der Kollision der Kunstfreiheit mit anderen Grundrechten ist eine Abwägung der Rechtsgüter vorzunehmen (vgl. Praktische Konkordanz).“"
                            },
                            {
                                "example_id": "d17913b7-eb21-4b72-a8e9-489eac2a1121",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "[Urteil des Landgerichts Berlin:] „Die Entscheidung wurde dafür kritisiert, sich nicht ausreichend mit der Kunstfreiheit auseinandergesetzt und stattdessen einseitig auf das Persönlichkeitsrecht der abgebildeten Person abgestellt zu haben.“"
                            },
                            {
                                "example_id": "b37ef706-56b8-45ad-b457-3a0929f900e7",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Häufig geht es bei Konflikten, die die Kunstfreiheit betreffen, um die Frage, ob bestimmte Darstellungen, etwa von Personen oder Geschehnissen, erlaubt sind. So wird sich eine dargestellte Person möglicherweise dagegen wehren, wenn sie sich durch eine künstlerische Darstellung verunglimpft fühlt.“"
                            },
                            {
                                "example_id": "c72f0d9b-ae72-4b7c-9f96-f201ebdc0b02",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Die rechtspopulistische Partei AfD hat in Deutschland viel Zulauf und könnte nach den nächsten Wahlen die Kunstfreiheit einschränken, so die Sorge vieler Kulturschaffender. Deswegen haben sie eine Kampagne gestartet.“"
                            },
                            {
                                "example_id": "642d1acc-7289-4eda-8a5d-a48cbd7253fd",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Man kann sagen, dass die Kunstfreiheit zumindest in Frage gestellt wird durch Aktionen der AfD, durch bestimmte Anträge und Anfragen und prozessuales Vorgehen. Und das muss die Öffentlichkeit wissen.“"
                            },
                            {
                                "example_id": "a368f37d-9dac-470a-a0cf-4774a8e2de70",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„75 Jahre Grundgesetz – […] Kulturstaatsministerin Claudia Roth sieht die Kunstfreiheit in Deutschland von antidemokratischen Kräften bedroht.“"
                            },
                            {
                                "example_id": "787e3c01-439d-4817-bcd9-a13b1f0a25e2",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„documenta-Chefin Sabine Schormann hat ihr Vorgehen im Antisemitismus-Skandal bei der documenta verteidigt - unter anderem mit Verweis auf die Kunstfreiheit.“"
                            },
                            {
                                "example_id": "1043330d-7915-4b27-9c44-9c563c5bc803",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„»Man kann sich fragen: Was war der Sinn von Charlie Hebdo, den Mohammed-Karikaturen? Ich sehe es als Aufforderung an die muslimischen Bürger, dass sich die Kunstfreiheit nicht bestimmte Grenzen setzen darf.«“"
                            },
                            {
                                "example_id": "7ab5d3fd-2235-4521-b068-c8b6b645cbad",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„[…] das Verwaltungsgericht konnte nicht feststellen, dass die öffentlichen Belange des Bezirks einen höheren Rang hätten als die Kunstfreiheit.“"
                            },
                            {
                                "example_id": "842cad75-8b6a-495e-bf48-3f7e6d696d58",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Von Satire verschont zu bleiben – darauf hat in Deutschland nichts und niemand einen Anspruch. Auch nicht, wenn sie hart ist. Denn Satire ist durch die Presse- und Meinungsfreiheit sowie gegebenenfalls durch die Kunstfreiheit geschützt.“"
                            },
                            {
                                "example_id": "f14ef71f-48af-4ea2-95d4-efca1e4ce083",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Was ist wichtiger: Die Kunstfreiheit oder das Persönlichkeitsrecht?“"
                            },
                            {
                                "example_id": "5ca3e547-0722-4ee6-9bf5-27f61e0521ef",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "[Es muss] „Grenzen geben; Möglichkeiten, sich gegen bestimmte, herabwürdigende Darstellungen der eigenen Person zu wehren. So ist in jedem Einzelfall zu prüfen, wo die Grenzen zwischen Kunstfreiheit und Persönlichkeitsschutz jeweils verlaufen.“"
                            },
                            {
                                "example_id": "3a8c495b-d7c9-46a2-8487-5758620e025a",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Die Strafbarkeit [Anmerkung: der Verleumdung gemäß Paragraf 187 StGB] entfällt nur, wenn die Meinungs- oder Kunstfreiheit überwiegt.“"
                            },
                            {
                                "example_id": "21915a33-3e63-41b1-9098-77bfcd242d62",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Der Würzburger Rechtsanwalt Chan-jo Jun sieht den umstrittenen Partysong \"Layla\" von der Kunstfreiheit gedeckt. »Zunächst einmal genießt selbst der dümmste Song erst einmal das Grundrecht der Kunstfreiheit«, sagte er im Interview mit der radioWelt auf Bayern 2.“"
                            },
                            {
                                "example_id": "493aba0a-c67a-468b-ad93-e36d8679490d",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Am 31. Januar 2007 wurde der Bundesprüfstelle das Album Wundwasser vorgelegt. Grund für die Indizierung sind „jugendgefährdende und strafbare Inhalte“. Am 1. Februar 2007 wurde das Album indiziert. Die BPjM konnte keinen ausreichenden Kunstgehalt ausmachen, somit galt der Jugendschutz mehr als die Kunstfreiheit.“"
                            },
                            {
                                "example_id": "0a580258-33ed-4643-abd1-f1516df188e7",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "[Schlagzeile:] „Antisemitismus in den Deichtorhallen: Wie weit reicht Kunstfreiheit?“"
                            },
                            {
                                "example_id": "d368fa18-9260-40f8-891c-e0c6d1096824",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Der Grat zwischen Zensur und Kunstfreiheit ist ein schmaler.“"
                            },
                            {
                                "example_id": "f1ddb724-3089-40aa-8341-ba873d4b44f4",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„Mit dem Gebot einer umfassenden Abwägung der kollidierenden Rechtsgüter wird der Bedeutung der Kunstfreiheit in ganz besonderer Weise Rechnung getragen. Diese Rechtsprechung hat bis heute Gültigkeit.“"
                            },
                            {
                                "example_id": "614aabc7-322e-4887-9fb5-ec685807d28f",
                                "sense_id": "33cd724d-3eb8-398a-be6e-1ce5f0866921",
                                "text": "„[…] Art. 5 GG war vom Verfassungsgeber im Angesicht der nur wenige Jahre zurückliegenden Zeit des Nationalsozialismus und der dort herrschenden Vorstellung über Entartete Kunst bewusst so angelegt worden, dass die Kunstfreiheit (wie auch die Freiheit von Wissenschaft, Forschung und Lehre) im Absatz 3 steht und somit die Schranken des Absatzes 2, nämlich die allgemeinen Gesetze, die gesetzlichen Bestimmungen zum Schutze der Jugend und das Recht der persönlichen Ehre nicht anwendbar sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
