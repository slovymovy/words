                            "plural"
                        ],
                        "form": "abonnements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e53e659-905c-33b7-85e4-5d7d6e8c51db",
                        "entry_id": "02b501a8-ffb3-3d85-b47c-d6f9597ff9bc",
                        "glosses": [
                            "A subscription or season ticket in a French-speaking country or another country where abonnement is the local term."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7ac9650-5d8b-47e9-b639-b14e75184f4b",
                                "sense_id": "3e53e659-905c-33b7-85e4-5d7d6e8c51db",
                                "text": "Securities in respect of which no abonnement has been contracted will be described as \"not under abonnement,\" and those subject to such an agreement will be indicated as \"under abonnement.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16cdfe5c-7527-4544-8835-346f230afa8d",
                        "source_entry_id": "02b501a8-ffb3-3d85-b47c-d6f9597ff9bc",
                        "source_sense_id": "3e53e659-905c-33b7-85e4-5d7d6e8c51db",
                        "source_sense_description": "season ticket",
                        "target_lang_word": "abonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abonnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                        "entry_id": "8b1db749-e49f-3a1b-894b-95148af84b00",
                                        "glosses": [
                                            "Contrat de fourniture, convention ou marché de service forfaitaire qui se fait d’avance pour une période donnée, par lequel on paie à un prix déterminé ce qui se paie d’ordinaire successivement et par portion avec un échéancier de facturation convenu à la signature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ed3fb2-90b3-42ee-b435-fc03be5eb863",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "J’étais entré dans plusieurs théâtres… À l’Hippodrome, où elle allait, les jours d’abonnement, j’avais fait le tour des loges…"
                                            },
                                            {
                                                "example_id": "25a4fa7b-0e02-429a-bb21-b174e456c711",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Pouvait-elle, dans sa position, aller à l’Opéra un jour d’abonnement ? elle y rencontrerait le monde entier !"
                                            },
                                            {
                                                "example_id": "46bfde20-d4d6-4fc6-995c-84514cfe9ccc",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "On sait que les deux grands types de distribution de la presse écrite sont l’abonnement et la vente au numéro."
                                            },
                                            {
                                                "example_id": "33281e5c-32b3-48e1-b32c-9ce3d66ff1ef",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Et n'oublie pas de résilier l'abonnement du téléphone !"
                                            },
                                            {
                                                "example_id": "d22ca454-ebb9-47c7-8b34-cb43589e0972",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Certains impôts s’acquittent par abonnement."
                                            },
                                            {
                                                "example_id": "776156eb-6d13-48bd-95ce-3cf2d8ee1a13",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Faire un abonnement avec la régie."
                                            },
                                            {
                                                "example_id": "dc15ce0d-e0cf-4a26-a136-d537d4c07b96",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Payer par abonnement."
                                            },
                                            {
                                                "example_id": "5d5773ce-9d51-4bc7-9507-4b13f61fbca4",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Prendre un abonnement à un journal, à une revue, à un théâtre, etc."
                                            },
                                            {
                                                "example_id": "cd99b74a-1e84-44d7-9292-ed60e0c1c7cd",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Dans les représentations extraordinaires, les abonnements sont suspendus, Les abonnés sont obligés de payer leurs places."
                                            },
                                            {
                                                "example_id": "d2c953a5-571a-4ce2-868d-b64b30e4f08b",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "Les mardis et les jeudis sont les jours d’abonnement à la Comédie-française, Les jours où les abonnés sont admis au théâtre."
                                            },
                                            {
                                                "example_id": "21214d75-8215-428f-b74e-7a603a5f0020",
                                                "sense_id": "1cae828c-8fad-3cf8-805b-7b876f6761a4",
                                                "text": "L’étude a également révélé que les entreprises rendent souvent difficile l’annulation des abonnements, et que les influenceurs sur les réseaux sociaux se livrent parfois à des promotions trompeuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "878e4f67-c9ca-410f-a8dd-eac9dc105c4e",
                        "source_entry_id": "02b501a8-ffb3-3d85-b47c-d6f9597ff9bc",
                        "source_sense_id": "3e53e659-905c-33b7-85e4-5d7d6e8c51db",
