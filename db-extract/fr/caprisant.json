                        ],
                        "examples": [
                            {
                                "example_id": "f3e1271b-3abf-43f8-a27c-0c372dac1d47",
                                "sense_id": "f3182117-32fc-3b4e-9a7a-9f4aae9697bd",
                                "text": "Et même un peu caprisant."
                            }
                        ]
                    },
                    {
                        "sense_id": "27d012c3-15b4-31fd-ad92-fac0b631d0f6",
                        "entry_id": "63ac3d13-589a-3817-bdc5-40045669de73",
                        "glosses": [
                            "Fantasque, désordonné."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2f8aefe0-310f-4d13-aeae-75e7f3ed1501",
                                "sense_id": "27d012c3-15b4-31fd-ad92-fac0b631d0f6",
                                "text": "Son style caprisant et affecté a principalement donné prise à ses nombreux adversaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa4fab44-ac2a-4012-b782-edaf5ecb0a4d",
                        "source_entry_id": "63ac3d13-589a-3817-bdc5-40045669de73",
                        "source_sense_id": "f3182117-32fc-3b4e-9a7a-9f4aae9697bd",
                        "source_sense_description": "(Médecine) Inégal",
                        "target_lang_word": "caprizant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caprizant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31035ac2-acb4-3cf9-909c-951d67b6eecf",
                                        "entry_id": "50e1f1ac-6a97-3c4a-9a53-914315b7d18d",
                                        "glosses": [
                                            "Having irregular, leaping beats."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc7f309-24bb-45be-bfbc-576f6c269ef5",
                                                "sense_id": "31035ac2-acb4-3cf9-909c-951d67b6eecf",
                                                "text": "The caprizant Pulse is to be perceived in the upper or lower Part, but hardly at all in the Middle, from an Aneurism, Tumor, &c."
                                            },
                                            {
                                                "example_id": "e95e7bf0-01b6-47df-937c-438e77cb774e",
                                                "sense_id": "31035ac2-acb4-3cf9-909c-951d67b6eecf",
                                                "text": "T. Dia. Dico that the pulse of this gentleman is the pulse of a man who is not well. Mr. Dia. Good. T. Dia. That it is duriusculus, not to say durus. Mr. Dia. Very well. T. Dia. Irregular. Mr. Dia. Bene. T. Dia. And even a little caprizant."
                                            },
                                            {
                                                "example_id": "59727945-5f2f-4cb7-a58e-9824ed85231b",
                                                "sense_id": "31035ac2-acb4-3cf9-909c-951d67b6eecf",
                                                "text": "Nay, in Dicrot, Caprizant, and other inordinate pulses, diverse pulses strike in lesse space than the open mouth of an artery can open, shut, and open again, which acts are requisite to the beginning of a second pulse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
