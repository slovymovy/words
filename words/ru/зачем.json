{
    "word_family": [
        "незачем"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dab8c4d3-89e0-375e-b8ba-ca29809d90b5",
                    "sense_definition": "С какой целью, для чего; вопрос о намерении или желаемом результате действия.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Зачем</w> ты ей звонишь, если она занята?",
                            "target_lang_translations": {
                                "en": "<w>Why</w> are you calling her if she is busy?",
                                "zh": "她正忙着，你<w>为了什么</w>还要给她打电话？"
                            }
                        },
                        {
                            "text": "Малышам трудно объяснить, <w>зачем</w> нужно чистить зубы.",
                            "target_lang_translations": {
                                "en": "It is hard to explain to toddlers <w>why</w> they need to brush their teeth.",
                                "zh": "很难向小孩子解释<w>为了什么</w>要刷牙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "для чего",
                        "с какой целью"
                    ],
                    "common_phrases": [
                        "зачем тебе это",
                        "зачем нужно",
                        "вот зачем",
                        "зачем же"
                    ],
                    "target_lang_definitions": {
                        "en": "With what purpose, for what; asking about the intention or desired result of an action.",
                        "zh": "用于询问目的或意图，即为了什么而做某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what for",
                                "target_lang_sense_clarification": "asking about purpose"
                            },
                            {
                                "target_lang_word": "why",
                                "target_lang_sense_clarification": "asking about intention"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "为了什么",
                                "target_lang_sense_clarification": "询问行为的目的"
                            },
                            {
                                "target_lang_word": "干什么",
                                "target_lang_sense_clarification": "口语中询问意图"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7efe38d-627d-3a0e-8309-57de11dd0e35",
                    "sense_definition": "По какой причине, почему; вопрос об основании или причине поступка.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reason",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Зачем</w> я тогда ушла от него, если всё ещё люблю?",
                            "target_lang_translations": {
                                "en": "<w>Why</w> did I leave him then, if I still love him?",
                                "zh": "如果我还爱着他，当初<w>为什么</w>要离开他？"
                            }
                        },
                        {
                            "text": "Не понимаю, <w>зачем</w> вы меня обманули.",
                            "target_lang_translations": {
                                "en": "I don't understand <w>why</w> you deceived me.",
                                "zh": "我不明白你<w>为什么</w>要骗我。"
                            }
                        }
                    ],
                    "synonyms": [
                        "почему",
                        "отчего",
                        "для чего"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в этом значении часто заменяет слово «почему»"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "For what reason, why; asking about the basis or cause of an action.",
                        "zh": "用于询问原因或理由，即为什么发生某事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "why",
                                "target_lang_sense_clarification": "asking about reason or cause"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "为什么",
                                "target_lang_sense_clarification": "询问行为的原因"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}