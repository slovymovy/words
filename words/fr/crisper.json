                {
                    "sense_id": "f6d22f0f-62c3-32e3-b638-a7f72415c5ea",
                    "sense_definition": "Agacer fortement, énerver ou impatienter quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bruit continu des travaux finit par me <w>crisper</w> dès le matin."
                        },
                        {
                            "text": "Cette attente interminable dans le froid <w>crispe</w> les voyageurs mécontents."
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "énerver",
                        "irriter",
                        "exaspérer"
                    ],
                    "antonyms": [
