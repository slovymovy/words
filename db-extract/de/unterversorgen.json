                ],
                "senses": [
                    {
                        "sense_id": "99eb908f-6ea1-3e26-8415-fc0af20460cb",
                        "entry_id": "c9dd4b33-4cf9-31fd-acd1-5478e7418ca2",
                        "glosses": [
                            "mit weniger ausstatten, als jemand oder etwas benötigt"
                        ],
                        "tags": [
                            "meist als Partizip"
                        ],
                        "examples": [
                            {
                                "example_id": "55e2207b-29d8-4fb2-8ebc-90dd73ea8c84",
                                "sense_id": "99eb908f-6ea1-3e26-8415-fc0af20460cb",
                                "text": "„Kein Wunder –das Hirn ist aktuell mit Blut noch etwas unterversorgt.“"
                            },
                            {
                                "example_id": "692212fd-a9f2-431e-b8be-8e0a428756b3",
                                "sense_id": "99eb908f-6ea1-3e26-8415-fc0af20460cb",
                                "text": "„Dieses unterversorgende Verhalten kann dazu führen, dass elementare Bedürfnisse des Kindes nach emotionaler Zuwendung, (materieller) Versorgung und kognitiver Anregung nicht erfüllt werden.“"
                            },
                            {
                                "example_id": "b63336af-eb7a-46b8-a28c-6b14ed2218b9",
                                "sense_id": "99eb908f-6ea1-3e26-8415-fc0af20460cb",
                                "text": "„Satzverkürzungen oder - abbrüche sowie Einschübe und Nachträge sind Mittel, das Gespräch nicht versanden zu lassen, den Hörer weder informativ über- noch unterzuversorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
