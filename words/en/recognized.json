                    "sense_id": "4e248f25-d6e1-324e-9777-1356028072c1",
                    "sense_definition": "Simple past and past participle of <w>recognize</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She immediately <w>recognized</w> the voice on the phone.",
                            "target_lang_translations": {
                                "ru": "Она сразу <w>узнала</w> голос по телефону.",
                                "zh": "她立刻<w>认出</w>了电话里的声音。"
                            }
                        },
                        {
                            "text": "The security system <w>recognized</w> his fingerprint and unlocked the door.",
                            "target_lang_translations": {
                                "ru": "Система безопасности <w>распознала</w> его отпечаток пальца и открыла дверь.",
                                "zh": "安保系统<w>识别</w>出了他的指纹并打开了门。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
