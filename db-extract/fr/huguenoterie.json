                        "glosses": [
                            "Parti, faction des huguenots."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "71bbeacd-f6de-4c5d-b336-d2b7a4774ba2",
                                "sense_id": "47175046-a010-3fbb-9bf1-1362267d6646",
                                "text": "Pour moi, je crois avec beaucoup de gens d’esprit que la huguenoterie court fortune, par toute l’Europe, d’être voisine de sa fin ; toutes les apparences vont là."
                            },
                            {
                                "example_id": "ef26df2c-2041-4f6e-a729-e4398b9c6379",
                                "sense_id": "47175046-a010-3fbb-9bf1-1362267d6646",
                                "text": "Oh ! Dieu merci, non ; cela m’est bien égal. Je hais profondément la huguenoterie, mais je ne déteste pas les huguenots, et puis c’est la mode."
                            }
                        ]
                    }
