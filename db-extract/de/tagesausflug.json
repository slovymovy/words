                ],
                "senses": [
                    {
                        "sense_id": "b75580a8-1214-35ee-8494-278297c66caa",
                        "entry_id": "9684e56e-31e9-3ea7-ba1a-5d400e25c045",
                        "glosses": [
                            "Ausflug, der einen ganzen Tag andauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c269aa-3067-4659-8f59-cb3f00719daa",
                                "sense_id": "b75580a8-1214-35ee-8494-278297c66caa",
                                "text": "„Für mich ist dieser Tagesausflug wie ein Spaziergang, den man schon kennt, wie der traditionelle Sonntagsspaziergang, immer auf denselben Trödelmarkt.“"
                            },
                            {
                                "example_id": "7dcda35e-ecea-4657-b109-d0c00edc1291",
                                "sense_id": "b75580a8-1214-35ee-8494-278297c66caa",
                                "text": "„Dieses Mal nehmen wir am Hauptbahnhof den Bus Nr. 7215, der uns über Todtnau an das Ziel unseres Tagesausfluges bringt.“"
                            },
                            {
                                "example_id": "a2a15152-ffab-4795-829c-38a293ad66df",
                                "sense_id": "b75580a8-1214-35ee-8494-278297c66caa",
                                "text": "„Eugen kam, und sie fuhren hinaus, um einen Tagesausflug zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
