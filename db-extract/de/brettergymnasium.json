                "senses": [
                    {
                        "sense_id": "c8f53720-64fc-3090-9fc3-3a3008b82f32",
                        "entry_id": "f21e7c99-74f1-3a9b-8dd1-0b998f168e3f",
                        "glosses": [
                            "Schule für Kinder mit Lernschwierigkeiten; Schule, die mit der Berufsschulreife abschließt, dem untersten allgemeinbildenden Schulabschluss (oft ist das der Hauptschulabschluss)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5b7cbe-de7f-43e5-a46f-710e8c671eda",
                                "sense_id": "c8f53720-64fc-3090-9fc3-3a3008b82f32",
                                "text": "„Fast alle von uns gehen zum Brettergymnasium, das ist die Sonderschule zwei Ecken weiter.“"
                            },
                            {
                                "example_id": "2dc192bf-4cbd-4fad-b3fd-045f62adeaba",
                                "sense_id": "c8f53720-64fc-3090-9fc3-3a3008b82f32",
                                "text": "„Haus Nummer 13 existierte nicht, das heißt, es war kein Wohnhaus, sondern eine Schule, keine große, denn es war eine Hilfsschule, die allgemein nur 'Brettergymnasium' genannt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
