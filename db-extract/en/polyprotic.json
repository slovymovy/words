                    {
                        "sense_id": "dbe9975e-4493-3580-a070-942e3161ae6b",
                        "entry_id": "8d77af25-c273-370b-977f-92f874bc9eb1",
                        "glosses": [
                            "That can donate (or accept) more than one proton; polybasic."
                        ],
                        "tags": [
                            "of an acid or a base"
                        ],
                        "examples": [
                            {
                                "example_id": "7aa7f472-cab9-4283-8f31-93a3a8e52732",
                                "sense_id": "dbe9975e-4493-3580-a070-942e3161ae6b",
                                "text": "Many acids, however, are able to furnish more than one proton per molecule; these are known as polyprotic acids."
                            },
                            {
                                "example_id": "d02b86b8-a34e-443e-841e-0e0fafe546b5",
                                "sense_id": "dbe9975e-4493-3580-a070-942e3161ae6b",
                                "text": "Some important acids, such as sulfuric acid (H₂SO₄) and phosphoric acid (H₃PO₄) can furnish more than one proton and are called polyprotic acids."
                            },
                            {
                                "example_id": "221cede4-7ae5-42f6-ab6f-d1b427482d0b",
                                "sense_id": "dbe9975e-4493-3580-a070-942e3161ae6b",
                                "text": "Carbonic acid from CO₂ and amino acids from proteins are examples of polyprotic acids—those having more than one acidic proton."
                            }
                        ]
                    }
                ],
