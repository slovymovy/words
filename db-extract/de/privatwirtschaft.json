                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a513a700-8f41-376c-8c4a-148d8064f4cd",
                                        "entry_id": "d5f7296c-51ef-3ccd-94c8-50ef3827bc5c",
                                        "glosses": [
                                            "Domaine des entreprises qui ne dépendent pas directement de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "babe07f8-0382-4fad-b033-c16acf3628e4",
                                                "sense_id": "a513a700-8f41-376c-8c4a-148d8064f4cd",
                                                "text": "Pour favoriser ce transfert vers le secteur privé, la municipalité met en place des quotas par districts."
