                                "target_senses": [
                                    {
                                        "sense_id": "51e12cdb-da9d-3d6a-952a-16dcf780b502",
                                        "entry_id": "108fcfce-f4cd-3357-961e-7bf3c9c4c1f3",
                                        "glosses": [
                                            "seguace del fascismo"
                                        ],
