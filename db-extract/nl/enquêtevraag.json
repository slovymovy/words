                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9103379-b4be-47b3-b1a3-b02fdef23d48",
                                "sense_id": "dd239494-dd63-32f2-9506-67876105bf50",
                                "text": "Van alle 335 gemeenten reageerde 80 procent op de enquêtevragen. Het aantal tips dat wordt doorgegeven ligt zeer waarschijnlijk veel hoger dan negenduizend, want de helft van de gemeenten met een meldpunt bijstandsfraude zegt de score niet bij te houden. Een kwart registreert een toename van het aantal meldingen."
                            },
                            {
                                "example_id": "3e926a4f-693c-45c5-a79b-4afa02ce8439",
                                "sense_id": "dd239494-dd63-32f2-9506-67876105bf50",
                                "text": "Dat blijkt uit onderzoek van de Volkskrant. Van alle 335 ondervraagde gemeenten reageerde een op de vijf op enquêtevragen van de krant. Waarschijnlijk komen er jaarlijks nog veel meer tips binnen dan de getelde negenduizend. Ongeveer de helft van de gemeenten die reageerde, houdt namelijk niet een exacte score bij. Een op de vier gemeenten ziet een toename in het aangeven van onterechte bijstand, stiekem samenwonen of bijvoorbeeld zwartwerken naast een uitkering."
                            }
                        ]
                    }
