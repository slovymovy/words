                ],
                "senses": [
                    {
                        "sense_id": "e3125c60-91bb-33a7-8419-11d747923eac",
                        "entry_id": "6f446ced-e426-39e3-9c8f-0904008629ff",
                        "glosses": [
                            "weibliche Person, die in ihrer Heimat Gefahren wie Krieg, Gewalt, Verfolgung oder Naturkatastrophen erlebt und davor in einem anderen Land Schutz sucht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8c61497-cfd7-3001-b35b-b2b58425397a",
                        "entry_id": "6f446ced-e426-39e3-9c8f-0904008629ff",
                        "glosses": [
                            "weibliche Person, die sich vor Gewalt in Sicherheit bringen möchte (beispielsweise in einem Bunker, in einem Frauenhaus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1763f170-b67f-45e5-b05a-c266351172cf",
                                "sense_id": "c8c61497-cfd7-3001-b35b-b2b58425397a",
                                "text": "„Laut einer Statistik des vierten von sechs Hamburger Frauenhäusern verbrachten etwa zwei Drittel der Schutzsuchenden mehr als sechs Monate dort.“"
                            },
                            {
                                "example_id": "8e8f1490-7b1f-4579-acdc-f21c69ebbd10",
                                "sense_id": "c8c61497-cfd7-3001-b35b-b2b58425397a",
                                "text": "„Die Frauenhäuser in Sachsen-Anhalt haben im vergangenen Jahr mehr als 1.000 Schutzsuchende aufgenommen.“"
                            },
                            {
                                "example_id": "c944fe2d-ee99-4fec-bf9c-f438343fe4bb",
                                "sense_id": "c8c61497-cfd7-3001-b35b-b2b58425397a",
                                "text": "„Körperlich eingeschränkte Frauen und Kinder bleiben in der Mecklenburgischen Seenplatte häuslicher Gewalt ausgesetzt. Denn das Frauen- und Kinderschutzhaus in Neubrandenburg sieht sich immer wieder gezwungen, Schutzsuchende mit Behinderung wegzuschicken. Der Grund: Das Schutzhaus ist nicht barrierefrei.“"
                            },
                            {
                                "example_id": "b2bac08b-a38b-4f54-bf9f-c8c145d961ba",
                                "sense_id": "c8c61497-cfd7-3001-b35b-b2b58425397a",
                                "text": "„Hierbei geht es in erster Linie um den Schutz der Frauenhausbewohnerinnen vor den gewalttätigen Partnern. Zusätzlich fragen die Mitarbeiterinnen ab, welche Dinge die Schutzsuchende aktuell dringend benötigt, zum Beispiel Lebensmittel, Winterkleidung oder Schulsachen für die Kinder. Die Mitarbeiterinnen besorgen das Benötigte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
