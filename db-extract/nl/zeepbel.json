                        ],
                        "form": "zeepbelletjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f1e0c75-6823-3bc5-85ab-adaf87d299ec",
                        "entry_id": "ab66f684-686e-337c-9180-4cb3cb5bd4b5",
                        "glosses": [
                            "bolvormig vlies van water en zeep dat een hoeveelheid gas (meestal lucht) omringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ca87c5-d1c6-4fde-8dd7-384ecb7f2dad",
                                "sense_id": "0f1e0c75-6823-3bc5-85ab-adaf87d299ec",
                                "text": "Kinderen blazen graag zeepbellen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f0fe9a2-8ef6-38e6-bce9-7feec71a5eec",
                        "entry_id": "ab66f684-686e-337c-9180-4cb3cb5bd4b5",
                        "glosses": [
                            "iets dat heel aantrekkelijk lijkt, maar al snel niet echt blijkt te zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "be215533-1518-4771-9d34-36a1a4a809e6",
                                "sense_id": "6f0fe9a2-8ef6-38e6-bce9-7feec71a5eec",
                                "text": "In Fitzgeralds droombeeld was New York het toppunt geweest van jeugdige overmoed en zorgeloze expansie. Die zeepbel werd door de grote crisis doorgeprikt."
                            }
                        ]
                    },
                    {
                        "sense_id": "925d4b75-7fc8-3674-950c-07952710e6ae",
                        "entry_id": "ab66f684-686e-337c-9180-4cb3cb5bd4b5",
                        "glosses": [
                            "zichzelf versterkende ontwikkeling waarbij prijs van bepaalde goederen, activiteiten of bedrijven overdreven stijgt die doorgaans uitloopt op een grote plotselinge waardedaling"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8d0f7f66-a538-4c43-917c-57c59ad3a1e0",
                                "sense_id": "925d4b75-7fc8-3674-950c-07952710e6ae",
                                "text": "Eigenlijk bestond de beurscrisis van 1720 uit drie zeepbellen die achtereenvolgens uiteenspatten in Parijs, Londen en Amsterdam. De overspannen winstverwachtingen gingen in rook op en lieten een spoor van verwoesting achter. Een enkeling stapte tijdig uit en streek een mooie winst op, maar zoals bij elk piramidespel waren er aan het einde van de rit voornamelijk verliezers."
                            },
                            {
                                "example_id": "d09935ce-82e6-4375-b6bf-69f348fd30ad",
                                "sense_id": "925d4b75-7fc8-3674-950c-07952710e6ae",
                                "text": "In het begin van de 21ᵉ eeuw sprong de .com-economie als een zeepbel uit mekaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56ff593-07ae-4084-a75a-e1f319e36d84",
                        "source_entry_id": "ab66f684-686e-337c-9180-4cb3cb5bd4b5",
                        "source_sense_id": "0f1e0c75-6823-3bc5-85ab-adaf87d299ec",
                        "source_sense_description": "bolvormig vlies van water en zeep dat een hoeveelheid gas (meestal lucht) omringt",
                        "target_lang_word": "Seifenblase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seifenblase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                        "entry_id": "cd443243-6d50-3f6e-ac57-7e386952c573",
                                        "glosses": [
                                            "ein dünner Film Seifenwasser, der eine hohle Kugel mit schillernder Oberfläche formt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1968855f-d5d2-480b-9ff5-c28ccd26eb3f",
                                                "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                                "text": "Als Kinder haben wir mit einem Becher Seifenlösung und einem Strohhalm Seifenblasen gemacht."
                                            },
                                            {
                                                "example_id": "00ec271c-cb97-4809-9a8e-f79b3df404a8",
                                                "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                                "text": "„Aus dem Garten von Stracks kamen Seifenblasen über den Zaun geflogen.“"
                                            },
                                            {
                                                "example_id": "31c2a380-5f8a-4067-9a40-0a8b8e51db70",
                                                "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                                "text": "„Eine Menge Seifenblasen scheinen auf einmal in meinem Gehirn zu platzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                        "entry_id": "cd443243-6d50-3f6e-ac57-7e386952c573",
                                        "glosses": [
                                            "ein Synonym für etwas, das zwar anziehend, aber dennoch inhaltslos ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7744f96-560c-442d-863f-2569afa7e63e",
                                                "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                                "text": "Mein Traum von einer großen Gesangskarriere stellte sich als Seifenblase heraus."
                                            },
                                            {
                                                "example_id": "5fed5327-6aca-4d13-ae8b-60a1a1058fbc",
                                                "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                                "text": "„Sie wollte nichts lieber, als sich in der Seifenblase zu verkriechen und die Welt um sich herum zu vergessen.“"
                                            },
                                            {
                                                "example_id": "8404d904-2c75-49af-9ebc-1d956a80659e",
                                                "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                                "text": "„Jetzt, wo die Seifenblase des Reichtums langsam zerplatzte und Dubai zurück auf den Boden der Tatsachen kam, mochte Sophie das Land sogar noch mehr: die Hotels, die nicht mehr ausgebucht, und die Parkplätze, die mit verlassenen Mercedes-Limousinen übersät waren, deren Besitzer ihre Raten nicht mehr bezahlen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db0bee38-e111-4b3a-9771-a6bc602420f5",
                        "source_entry_id": "ab66f684-686e-337c-9180-4cb3cb5bd4b5",
