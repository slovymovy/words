                ],
                "senses": [
                    {
                        "sense_id": "01cf97d5-c11a-3410-bd62-642da6f921be",
                        "entry_id": "7d9480b9-ded1-3d21-856a-c7166b8ad577",
                        "glosses": [
                            "der bei fahrender Fortbewegung scheinbar auftretende Gegenwind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32b17c7-7302-418c-a2ab-952ddb9e46ac",
                                "sense_id": "01cf97d5-c11a-3410-bd62-642da6f921be",
                                "text": "„Wenn New York zum Backofen wird, ist frischer Fahrtwind genau das Richtige. Radeln wird cool in der Stadt mit acht Millionen Autos.“"
                            },
                            {
                                "example_id": "eb944305-4103-438c-9c61-b026018f21cd",
                                "sense_id": "01cf97d5-c11a-3410-bd62-642da6f921be",
                                "text": "„Man darf sogar das Fenster öffnen und den Fahrtwind spüren.“"
                            },
                            {
                                "example_id": "6e9d632b-d2af-48f0-9f5a-fabd22773f58",
                                "sense_id": "01cf97d5-c11a-3410-bd62-642da6f921be",
                                "text": "„Ohne den Fahrtwind spürte ich die Hitze sofort, ich war ihr nun direkt ausgesetzt, sie war unerträglich.“"
                            },
                            {
                                "example_id": "ee842fce-749e-4119-bf66-f950cc647ec5",
                                "sense_id": "01cf97d5-c11a-3410-bd62-642da6f921be",
                                "text": "„Es ist kühl, die Haare liegen im Fahrtwind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
