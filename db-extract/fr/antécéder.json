                "senses": [
                    {
                        "sense_id": "f9b2dabd-6f46-364a-a2c5-259530e30116",
                        "entry_id": "92c55800-4835-38cb-87de-9c8f4a9621c4",
                        "glosses": [
                            "Précéder."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b18e8ef6-cd33-4f35-831f-51cff8798f36",
                                "sense_id": "f9b2dabd-6f46-364a-a2c5-259530e30116",
                                "text": "L’idée de la mondialité globale et sphérique du monde terrestre antécédait donc sa découverte maritime au-delà du monde jusqu’alors reconnu […]"
                            },
                            {
                                "example_id": "f74f5a9f-1680-4233-a172-e00104e3a7fa",
                                "sense_id": "f9b2dabd-6f46-364a-a2c5-259530e30116",
                                "text": "Reconduit quelque chose du sacré qui antécédait la danse, s’est d’abord manifesté par elle avant que le tragique s’en délivre, et plus avant encore que le chant se délivre de ses fins extérieures."
                            }
                        ]
                    }
                ],
