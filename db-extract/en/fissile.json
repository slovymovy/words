                    {
                        "sense_id": "aeeeef52-69e6-3798-bb49-074966fefe8e",
                        "entry_id": "8e8e5089-d6e3-3531-9c81-543c6cc49238",
                        "glosses": [
                            "Capable of sustaining a nuclear fission chain reaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "460eec5b-27e1-47f6-9b6b-7f36ae8fb32a",
                                "sense_id": "aeeeef52-69e6-3798-bb49-074966fefe8e",
                                "text": "North Korea may soon have access to regular amounts of fissile material if it doesn’t already and could be preparing Punggye-ri for a number of nuclear tests if the above analysis is correct."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0ce1e03-5ea3-4116-b721-abc7dce8b50d",
