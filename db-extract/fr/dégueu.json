                    {
                        "sense_id": "d3e59a1c-a051-37b3-a229-f4da155c27f6",
                        "entry_id": "d6c4e4d2-3046-3b9c-89f2-499d3a7e199b",
                        "glosses": [
                            "Dégueulasse ; sale ; répugnant."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5460f917-b9ac-4ece-8570-37030209ff8d",
                                "sense_id": "d3e59a1c-a051-37b3-a229-f4da155c27f6",
                                "text": "Sous la rampe, à son départ, il y a un rabicoin, comme disent les berrichons. Mais il est ouvert et ça pullule de vieilles pièces dégueues laissées là à l'intention des archéologues du futur, […]."
                            },
                            {
                                "example_id": "8ea7680d-608e-48ac-83eb-46572f33d856",
                                "sense_id": "d3e59a1c-a051-37b3-a229-f4da155c27f6",
                                "text": "Ils s'approchaient de la bête en criant, \"Ah dégueu !\"."
                            }
                        ]
                    }
