                                    }
                                ]
                            },
                            {
                                "target_word": "stripe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78e26712-221b-3f6a-9222-47a240780e7f",
                                        "entry_id": "a13b34e5-675c-3170-8ddf-50724db8cdb4",
                                        "glosses": [
                                            "To mark with stripes."
                                        ],
