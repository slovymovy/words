                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e906c16-c683-4cec-8e3c-cad244ad7b2e",
                        "source_entry_id": "f275b896-166d-316e-bfaf-28e483df7739",
                        "source_sense_id": "d27f9ff0-ec8c-3a98-bfb3-694e26c947a2",
                        "target_lang_word": "Tierpräparator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tierpräparator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bde2d6e-3f44-3c49-9b52-4c93e3d6658a",
                                        "entry_id": "3f47ce14-3a3c-3ada-add1-1d23d75191d4",
                                        "glosses": [
                                            "Person, die tote Tiere ausstopft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61de4b50-b2ad-4cfb-957f-f7ef67e0a53c",
                                                "sense_id": "6bde2d6e-3f44-3c49-9b52-4c93e3d6658a",
                                                "text": "„›Was du behauptest, ist völlig unmöglich – ja, es steht in krassem Widerspruch zu allen Naturgesetzen. Ich selbst habe diese Schlange vor vier Jahren in El Dorado County getötet und von einem professionellen Tierpräparator ausstopfen lassen.‹“"
                                            },
                                            {
                                                "example_id": "c1e27c88-dfd4-4af8-b151-be40704a21bf",
                                                "sense_id": "6bde2d6e-3f44-3c49-9b52-4c93e3d6658a",
                                                "text": "„Ein beinloser Bettler auf einem Brett, wie das Schreckensprodukt eines Tierpräparators, war munter geworden und lachte ihn aus.“"
                                            },
                                            {
                                                "example_id": "0ffc15b4-97e4-406c-868a-dfdff016ce28",
                                                "sense_id": "6bde2d6e-3f44-3c49-9b52-4c93e3d6658a",
                                                "text": "„Habt ihr den Tierpräparator angefunkt?“"
                                            },
                                            {
                                                "example_id": "d8c097df-8f30-4c00-8a9c-729f5b0e5f08",
                                                "sense_id": "6bde2d6e-3f44-3c49-9b52-4c93e3d6658a",
                                                "text": "„Es gab insgesamt 349, plus 93 Werkstätten von Tierpräparatoren, wenn man die Möglichkeit berücksichtigte, dass der Täter ein Tier verwendet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
