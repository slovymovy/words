                        "entry_id": "0ce5cc7f-c2fc-320f-b8a8-069fb0f64e6e",
                        "glosses": [
                            "Variante orthographique de GAFA."
                        ],
                        "tags": [
                            "alt-of",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "b12f9790-3c71-4a22-a1b7-b1647debd9e6",
                                "sense_id": "fae0ae39-b650-3f92-94cd-b6b3aac22826",
                                "text": "L’hégémonie des Gafa, acronyme de Google, Apple, Facebook et Amazon, inquiète l’Europe"
                            },
                            {
                                "example_id": "ce1a386a-18de-493b-ba50-0174e25e9671",
                                "sense_id": "fae0ae39-b650-3f92-94cd-b6b3aac22826",
                                "text": "Les pays européens n’en finissent plus de discuter de la meilleur façon de taxer un peu sérieusement les bénéfices réalisés en Europe (et cachés) par les Gafa (Google, Apple, Facebook et Amazon)."
                            }
                        ]
                    }
