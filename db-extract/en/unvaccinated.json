                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeimpft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                        "entry_id": "e4c55308-783a-3db3-b014-e17e5f9db74c",
                                        "glosses": [
                                            "ohne ein Mittel / ein Vakzin, das einer Person oder einem Tier injiziert wird und somit diese Person/dieses Tier geschützt wäre gegen Krankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607d3f6c-30d7-405e-a087-d223bb9c1724",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "Es ist unverantwortlich, wenn Eltern ihre ungeimpften Kinder in die Schule schicken wollen."
                                            },
                                            {
                                                "example_id": "0e88d68f-94f5-4c00-80e6-0118e1245604",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[Masern:] „Bereits vor einigen Tagen hatten die New Yorker Behörden es Religionsschulen und Kindertagesstätten verboten, ungeimpfte Kinder aus dieser Gemeinde zu betreuen. Sonst droht den Einrichtungen die Schließung.“"
                                            },
                                            {
                                                "example_id": "587f609c-3eb0-44f7-8c52-af6d45bc90c5",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "„Im Kanton Uri gehen die Masern um. Ungeimpfte Kinder aus betroffenen Familien oder Schulklassen werden künftig präventiv bis zu drei Wochen von der Schule ausgeschlossen.“"
                                            },
                                            {
                                                "example_id": "6f80cfe7-970a-4dfb-b7de-057d101ffbee",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "„In den vergangenen Tagen sind in der Schweiz wieder vermehrt Fälle von Masern aufgetreten. Laut Recherchen von SRF sind auch ungeimpfte Erwachsene unter den Erkrankten, die beruflich mit Kindern arbeiten.“"
                                            },
                                            {
                                                "example_id": "fc20d056-8f39-4d02-94a6-6c4ff193b169",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[Pandemie-Sondergipfel der G7:] „Alle Staaten sollten gleichmäßig mit Impfstoffen versorgt werden, weil es keinen Sinn hat, nur einen Teil der Welt zu impfen. Das Virus könnte sich aus [den] ungeimpften Bevölkerungen erneut weltweit ausbreiten.“"
                                            },
                                            {
                                                "example_id": "639c27ba-6d07-480c-9ff0-22e280586376",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "„Trifft solch ein Virus dann auf ungeimpfte Personen, können die Auswirkungen verheerend sein.“"
                                            },
                                            {
                                                "example_id": "92ed3439-cbfc-4e78-b941-272b2617e234",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[COVID-19-Impfstoff:] „Die erhobenen Daten verglich die Krankenkasse mit 628.000 ungeimpften Versicherten, von denen sich im selben Zeitraum 18.425 Personen infizierten. Daraus errechnet Maccabi eine Wirksamkeit des Impfstoffs von 93 Prozent.“"
                                            },
                                            {
                                                "example_id": "6c55aedf-a912-4d3b-a658-d8aea5ef5792",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[COVID-19-Pandemie 2021:] „Wieder Freunde treffen, Restaurantbesuche, normales Arbeiten im Büro: Sollten Geimpfte früher Erleichterungen bekommen als der ungeimpfte Rest der Bevölkerung?“"
                                            },
                                            {
                                                "example_id": "067b0fee-106a-41ba-b10e-9c475eda21da",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[COVID-19-Pandemie 2021:] „die niedergelassenen Ärzte arbeiten nach der Prioritätenliste - und sind vielerorts noch damit beschäftigt, bisher ungeimpfte Patienten aus den Prioritätsgruppe 1 und 2 zu impfen […].“"
                                            },
                                            {
                                                "example_id": "b27a957c-2c9a-44f9-87c6-068bb9bbc48d",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[COVID-19-Pandemie 2021:] „Noch ist unbekannt, wie lange der Impfschutz anhält – und ob trotz Impfung das Virus noch an andere ungeimpfte Menschen weitergegeben wird.“"
                                            },
                                            {
                                                "example_id": "59a5fe18-804d-483a-bcc4-21f0a4cab672",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "[COVID-19-Pandemie 2021:] „Wir können uns aus Deutschland angucken, wie die Pandemie in anderen Ländern läuft, bei mittlerweile mehr oder weniger wieder geöffneten Schulen, aber ungeimpften Kindern.“"
                                            },
                                            {
                                                "example_id": "aef4f92a-0dfa-434f-9c82-7895c75d4f59",
                                                "sense_id": "a72e0797-977b-3b18-825f-3779eb4f3578",
                                                "text": "„Jeder Arzt [muss] wissen, dass er ungeimpft im Zweifel seine Patienten [gefährdet].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
