                "senses": [
                    {
                        "sense_id": "7d6b9370-85ad-3a94-889a-016c1fd78605",
                        "entry_id": "d867dbd2-d7a8-323b-9d82-04406416a403",
                        "glosses": [
                            "vom Fluss Ziller durchflossenes, südliches Seitental des Inntals in Tirol"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "e354744e-8e62-4d33-bd14-242fbffdfe89",
                                "sense_id": "7d6b9370-85ad-3a94-889a-016c1fd78605",
                                "text": "„Durch das laute Läuten der Glocken soll der Winter aus dem Zillertal vertrieben werden.“"
                            },
                            {
                                "example_id": "b8d9eff0-fd42-4d6e-91d9-b64584177dc1",
                                "sense_id": "7d6b9370-85ad-3a94-889a-016c1fd78605",
                                "text": "„Ein 86-Jähriger ist am Sonntag in Stumm im Tiroler Zillertal von Nachbarn und seinem Enkel aus seiner brennenden Küche gerettet worden.“"
                            },
                            {
                                "example_id": "3e38a8bf-8895-4840-af04-b9270bb18b77",
                                "sense_id": "7d6b9370-85ad-3a94-889a-016c1fd78605",
                                "text": "„Bergerlebnisse im Zillertal lassen sich auf vielfältige Weise zelebrieren. Beispielsweise beim Klettern, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
