                "senses": [
                    {
                        "sense_id": "2bb732e5-f039-3a42-a529-69cfa98574da",
                        "entry_id": "1547d5e5-ba84-3f79-9bde-8f36f1958475",
                        "glosses": [
                            "Dans la direction d’un axe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc0a71ed-81de-44d7-b3fe-26792432d7fc",
                                "sense_id": "2bb732e5-f039-3a42-a529-69cfa98574da",
                                "text": "Un pignon axialement libre par rapport à la roue se centre automatiquement de telle façon que la poussée axiale résultante soit nulle (fig. 5.90)."
                            },
                            {
                                "example_id": "b27c5972-a80f-4d85-beae-cd7d14d43e1c",
                                "sense_id": "2bb732e5-f039-3a42-a529-69cfa98574da",
                                "text": "Elles sont ventilées par une paire de turbines Axial-Tech de 90 mm. Celles-ci sont certifiées IP5X et conçues pour guider le flux d’air axialement."
                            }
                        ]
                    },
                    {
                        "sense_id": "11f065e1-2833-3879-90ad-ce43a0cdd6c9",
                        "entry_id": "1547d5e5-ba84-3f79-9bde-8f36f1958475",
                        "glosses": [
                            "Dans une direction verticale, par opposition à équatorialement."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "da9f26c4-3c97-44b2-bb76-93b2ef94c167",
                                "sense_id": "11f065e1-2833-3879-90ad-ce43a0cdd6c9",
                                "text": "Si le cristal est de la classe chez laquelle l’axe optique est repoussé, la ligne qui partage les angles aigus du rhombe se placera axialement; dans l’autre classe, elle se dirigera équatorialement."
                            }
                        ]
                    }
