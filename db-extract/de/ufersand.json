                        "examples": [
                            {
                                "example_id": "3cd3a33b-d0f0-4eac-8d06-b59bc0f9b0f9",
                                "sense_id": "529dd2ff-f36b-3168-b8b3-0bc2b45985bb",
                                "text": "„Rechter Hand gab es ein Fischrestaurant, eine Art offene Terrasse unter einem Holzdach; davor saßen Männer, die Kajaks und Boote vermieteten, im Ufersand neben ihren kleinen Wasserfahrzeugen und warteten hoffnungsvoll, zugleich aber frustriert über die geringe Anzahl der Fährpassagiere auf potenzielle Kunden.“"
                            }
                        ],
