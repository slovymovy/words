                ],
                "senses": [
                    {
                        "sense_id": "95693b95-6b22-3d39-83cb-0d316a9f1f4f",
                        "entry_id": "cff9e0a3-0a8f-3efc-a684-d9700c42dac7",
                        "glosses": [
                            "żaglowiec mający co najmniej dwa maszty; wszystkie maszty niosą ożaglowanie skośne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0648a99a-c417-4e21-aea9-0786c9b0ef5c",
                                "sense_id": "95693b95-6b22-3d39-83cb-0d316a9f1f4f",
                                "text": "Na zawietrznej powoli płynął szkuner."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1912a1a7-f65e-4a1a-a8ac-14d97c15d264",
                        "source_entry_id": "cff9e0a3-0a8f-3efc-a684-d9700c42dac7",
                        "source_sense_id": "95693b95-6b22-3d39-83cb-0d316a9f1f4f",
                        "target_lang_word": "schooner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schooner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A sailing ship with two or more masts, all with fore-and-aft sails; if two masted, having a foremast and a mainmast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12653cdf-868e-4b9a-804d-b720c217f2e2",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "The night was considerably clearer than anybody on board her desired when the schooner Ventura headed for the land."
                                            },
                                            {
                                                "example_id": "d551cd75-9fea-40f6-a7d7-ff93cc82dae0",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "Designed by Frank Payne's renowned Boston design office, and built in 1928 of longleaf yellow pine, this 82-footer has been a racing schooner — a staysail schooner — since the heyday of Class-A ocean racing in schooners during the late 1920s and early 1930s."
                                            },
                                            {
                                                "example_id": "a71b7409-3fbd-4a58-b1c3-143042f3d02d",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "In addition to the square-rigged sailing ships, the schooners were the second largest group of large sailing vessels."
                                            },
                                            {
                                                "example_id": "5c5e7494-6d80-42de-83e4-3d963f40c88e",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "Unfortunately, anyone looking for a schooner today has limited choices. In the used boat market there are always some wooden hulls available, and occasionally ones of steel or aluminum, but fiberglass-hulled schooners are harder to come by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd5df64-384c-3b58-9a4e-25b3dc7978af",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A glass for drinking a large measure of sherry."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4713d4f9-2b6a-4a84-a90d-9c7721cd72c3",
                                                "sense_id": "7bd5df64-384c-3b58-9a4e-25b3dc7978af",
                                                "text": "Boycott any pub that bans work clothes, allows customers to reserve tables or only sells beer in schooners. That is less a pub, more a private members’ club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A glass of beer, of a size which varies between states (Wikipedia)."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16705b3e-361a-49b9-9e2e-6168169dfafd",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "Foaming schooners of beer grew ever larger and more numerous as the crimson February suns went to their rest."
                                            },
                                            {
                                                "example_id": "01a7d115-b092-40c6-b681-8ad7b5e8ce7e",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "At first I refused, but ten schooners later I was ready to take on Jaws with a butterknife[.]"
                                            },
                                            {
                                                "example_id": "b34474f2-3624-455c-826b-e6ef4e451d17",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "And needless to say, the Western Australia row will eventually be filled in as well, though not before drinking a schooner of the amber nectar in Perth."
                                            },
                                            {
                                                "example_id": "4994d244-d7e3-45e1-94e1-1718dea4a9c3",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "For a true Adelaide experience, head for the bar and order a schooner of Coopers, the local brew, or a glass of SA′s impressive wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023187f7-55c4-3bb3-89d7-aa5c707c0bfa",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A large goblet or drinking glass, used for lager or ale (Wikipedia)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9de03c5-4413-36de-a605-f8701bc3193a",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A covered wagon used by emigrants."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e64c2f6-34de-45e4-94e9-d3afd0cb70c5",
                        "source_entry_id": "cff9e0a3-0a8f-3efc-a684-d9700c42dac7",
                        "source_sense_id": "95693b95-6b22-3d39-83cb-0d316a9f1f4f",
                        "target_lang_word": "goélette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goélette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26ea0422-b9de-3a34-bd54-14f82fbd4706",
                                        "entry_id": "c8872540-866c-3522-b9ad-ce00a74ac717",
                                        "glosses": [
                                            "Hirondelle de mer, sterne pierregarin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b5b75e-6dd4-46b1-b062-2069dcaf849a",
                                                "sense_id": "26ea0422-b9de-3a34-bd54-14f82fbd4706",
                                                "text": "Nous fûmes environnés d’une innombrable quantité de goëlettes, qui nous faisaient soupçonner que nous passions auprès de quelque île ou rocher. — (Voyages de La Pérouse, 1797)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f3a1b42-b3c3-3a4c-9184-e586438c375a",
                                        "entry_id": "c8872540-866c-3522-b9ad-ce00a74ac717",
                                        "glosses": [
                                            "Navire léger à deux mâts, à gréement aurique ou bermudien et jaugeant de cinquante à deux-cents tonneaux."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8df43e3-2b25-4ec3-a8fb-0bf83a5a42d9",
                                                "sense_id": "1f3a1b42-b3c3-3a4c-9184-e586438c375a",
                                                "text": "C’était une charmante petite goélette de vingt tonneaux que la Tankadère, bien pincée de l’avant, très-dégagée dans ses façons, très-allongée dans ses lignes d’eau."
                                            },
                                            {
                                                "example_id": "619010c4-ff9f-4a1a-b98c-2ee3b59e29c2",
                                                "sense_id": "1f3a1b42-b3c3-3a4c-9184-e586438c375a",
                                                "text": "Il m’apprend […] qu’une goélette de deux cents tonneaux a mis quinze jours pour venir des côtes américaines et a subi de fortes avaries."
                                            },
                                            {
                                                "example_id": "6b87c620-0ab3-4b98-86b5-59f6d05e670f",
                                                "sense_id": "1f3a1b42-b3c3-3a4c-9184-e586438c375a",
                                                "text": "Le Vieux-Port, où je me rappelle avoir vu naguère des rangées serrées de goélettes et de tartanes, le Vieux-Port n’est plus qu’un grand bassin des tuileries."
                                            },
                                            {
                                                "example_id": "3e3146ef-4163-4d48-8ed9-625044949f6c",
                                                "sense_id": "1f3a1b42-b3c3-3a4c-9184-e586438c375a",
                                                "text": "Le soir la vigie signale à quelques encablures de la côte une goélette immobile qui semble donner de la bande. […]. Comme le schooner peut avoir besoin de secours, nous approchons en sondant prudemment. C'est bien une goélette, d'une centaine de tonnes, qui s'est échouée sur les cailloux de Mingan."
                                            },
                                            {
                                                "example_id": "79441835-44c8-451d-b7e6-bc92285d7ef3",
                                                "sense_id": "1f3a1b42-b3c3-3a4c-9184-e586438c375a",
                                                "text": "Des voiliers, goélettes, « sloops » ou « tapouilles » assurent la plus grande partie des transports entre Cayenne et les communes qui, pour la plupart, ne sont pas reliées par voie routière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b043314-a027-3f13-8948-a66cacc1c6a4",
                                        "entry_id": "c8872540-866c-3522-b9ad-ce00a74ac717",
                                        "glosses": [
                                            "Camionnette aménagée pour le transport de personnes. (Par antonomase du nom d'un véhicule utilitaire fabriqué par Renault de 1959 à 1965.)"
                                        ],
                                        "tags": [
                                            "Burkina Faso",
                                            "Mali"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
