                        "entry_id": "d8a2e046-fd2d-3f9f-a7be-0bd2d33edc49",
                        "glosses": [
                            "Auswüchse, welche an Blättern bestimmter Eichenarten vorkommen, hervorgerufen durch abgelegte Eier der Eichengallwespe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d310cb48-22e4-47f6-bd73-3f2dffc996a9",
                                "sense_id": "f230bb55-e0b9-3175-a6ca-ff89a3e56b24",
                                "text": "An der Unterseite vom Eichenblatt hängt der Gallapfel."
                            },
                            {
                                "example_id": "8a8ffd00-0f7d-47b7-b892-62ec54247177",
                                "sense_id": "f230bb55-e0b9-3175-a6ca-ff89a3e56b24",
                                "text": "Im Gallapfel befindet sich eine Larve."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "509503b3-9b05-4800-8c0e-237e9851be4d",
                        "source_entry_id": "d8a2e046-fd2d-3f9f-a7be-0bd2d33edc49",
                        "source_sense_id": "f230bb55-e0b9-3175-a6ca-ff89a3e56b24",
                        "target_lang_word": "gallnut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallnut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d86dbb7-71e8-3c2a-aec3-26a3ccba3dc2",
                                        "entry_id": "7121a8c4-a97d-3afb-b678-5d4b895c2799",
                                        "glosses": [
                                            "A gall on a tree, caused by insects, that resembles a nut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2bb8540-7841-4c83-b2cd-f18fbbd0e708",
                                                "sense_id": "7d86dbb7-71e8-3c2a-aec3-26a3ccba3dc2",
                                                "text": "There was the smell of evening in the air, the smell of the fields in the country where they digged up turnips to peel them and eat them when they went out for a walk to Major Barton's, the smell there was in the little wood beyond the pavilion where the gallnuts were."
                                            },
                                            {
                                                "example_id": "c6b7bf1f-bae9-410a-95ba-cc4d68ecc596",
                                                "sense_id": "7d86dbb7-71e8-3c2a-aec3-26a3ccba3dc2",
                                                "text": "[Y]our hands are always covered with gallnut [translating galla], vitriol, and alum, just like the varnish on a Moor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a94266-9ab7-49d7-b375-f84cc822bda1",
                        "source_entry_id": "d8a2e046-fd2d-3f9f-a7be-0bd2d33edc49",
                        "source_sense_id": "f230bb55-e0b9-3175-a6ca-ff89a3e56b24",
                        "target_lang_word": "nutgall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutgall",
