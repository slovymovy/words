                "forms": [],
                "senses": [
                    {
                        "sense_id": "b74d1075-27de-311d-87d2-1af35c5cb050",
                        "entry_id": "c5cad905-3c66-3289-8205-cc3c83deb100",
                        "glosses": [
                            "Agriculture biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404c7877-dc58-4759-b4de-c37740091092",
                                "sense_id": "b74d1075-27de-311d-87d2-1af35c5cb050",
                                "text": "Les stratèges de cette bio industrielle étudient chaque faille de la réglementation afin de limiter au maximum les contraintes."
                            },
                            {
                                "example_id": "950cde5d-75b4-4e00-85bb-62fc9d882dde",
                                "sense_id": "b74d1075-27de-311d-87d2-1af35c5cb050",
                                "text": "C’est toute la structure de la filière qu’il faut revoir de fond en comble pour développer une agriculture moderne et cohérente sur le modèle de la bio, sans azote de synthèse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
