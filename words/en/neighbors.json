                    "sense_id": "46437953-7eb6-31c3-bced-e4339cce7320",
                    "sense_definition": "Plural of <w>neighbor</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>neighbors</w> are very quiet and friendly people.",
                            "target_lang_translations": {
                                "ru": "Мои <w>соседи</w> — очень тихие и дружелюбные люди.",
                                "es": "Mis <w>vecinos</w> son personas muy tranquilas y amables."
                            }
                        },
                        {
                            "text": "We invited all our <w>neighbors</w> to the summer block party.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили всех наших <w>соседей</w> на летнюю вечеринку квартала.",
                                "es": "Invitamos a todos nuestros <w>vecinos</w> a la fiesta de barrio de verano."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good neighbors",
                        "next-door neighbors",
                        "close neighbors"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, которые живут рядом с вами или в соседнем доме.",
                        "es": "Personas que viven cerca de otra o en una casa contigua."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соседи",
                                "target_lang_sense_clarification": "люди, живущие рядом"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vecinos",
                                "target_lang_sense_clarification": "personas que viven cerca"
                            },
                            {
                                "target_lang_word": "vecinas",
                                "target_lang_sense_clarification": "mujeres que viven cerca"
                            }
                        ]
                    }
                }
            ]
        },
        {
