                            }
                        },
                        {
                            "text": "Old book covers were often reinforced with layers of heavy <w>carton</w>.",
                            "target_lang_translations": {
                                "ru": "Старые книжные обложки часто укреплялись слоями толстого <w>картона</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий плотный прессованный картон или плотная бумага."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картон",
                                "target_lang_sense_clarification": "плотный листовой материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a65254b2-1aff-312b-bb4d-2fa98d12d5e3",
                    "sense_definition": "A small white disc positioned at the center of the bullseye on an archery or shooting target.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marksman aimed his rifle directly at the small <w>carton</w> in the bullseye.",
                            "target_lang_translations": {
                                "ru": "Стрелок прицелился из винтовки прямо в маленькое <w>яблочко</w> в центре мишени."
                            }
                        },
                        {
                            "text": "Hitting the central <w>carton</w> earned the shooter the maximum possible score.",
                            "target_lang_translations": {
                                "ru": "Попадание в самое <w>яблочко</w> принесло стрелку максимально возможное количество очков."
                            }
