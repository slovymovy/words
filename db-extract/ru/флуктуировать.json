                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5adec56-4707-46ea-aad7-b261264a379e",
                                                "sense_id": "c90d9c9c-aab4-3288-8849-35ac14ab2f39",
                                                "text": "One of them, at great Expence of Algebra, proves, that the Motes, which in Scotomias, we seem to have in our Eyes, are not real Bodies fluctuating in them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33fe13df-8c99-3804-8e8e-f8ea7c6630c2",
                                        "entry_id": "90636eb8-5b6e-3904-8464-4c5a24329688",
                                        "glosses": [
                                            "To be irresolute; to waver."
                                        ],
                                        "tags": [
