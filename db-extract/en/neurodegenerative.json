                "senses": [
                    {
                        "sense_id": "f0192d17-fe9c-382b-a286-99f0345fc6f1",
                        "entry_id": "5b21f0fa-f8d0-3c26-8f31-551f436dd653",
                        "glosses": [
                            "Of, pertaining to, or resulting in the progressive loss of nerve cells and of neurologic function."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a647c1b-e63f-46d4-b5b0-66e573730e61",
                                "sense_id": "f0192d17-fe9c-382b-a286-99f0345fc6f1",
                                "text": "neurodegenerative disease"
                            },
                            {
                                "example_id": "266e24d0-a1dd-4145-9e70-258d4c117f39",
                                "sense_id": "f0192d17-fe9c-382b-a286-99f0345fc6f1",
                                "text": "A very rare polymorphism in the prion protein gene recently has been identified that appears to protect against prion disease; this finding, in addition to providing greater understanding of the prionlike mechanisms of neurodegenerative disorders, might lead to potential treatments."
                            },
                            {
                                "example_id": "502a49bc-6b66-4515-8e42-9ef21f0a199c",
                                "sense_id": "f0192d17-fe9c-382b-a286-99f0345fc6f1",
                                "text": "It doesn’t help that symptoms of Alzheimer’s develop gradually and slowly and a diagnosis might only be made years after the brain has started to undergo neurodegenerative changes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d5d8552-b765-4e83-bc00-499101ff2f40",
                        "source_entry_id": "5b21f0fa-f8d0-3c26-8f31-551f436dd653",
                        "source_sense_id": "f0192d17-fe9c-382b-a286-99f0345fc6f1",
                        "source_sense_description": "pertaining to the progressive loss of nerve cells",
                        "target_lang_word": "neurodégénératif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurodégénératif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c43c44d-a6c7-3a38-aa5a-6b8bcd85db67",
                                        "entry_id": "72230987-5752-33ae-8559-6dce1fa57e45",
                                        "glosses": [
                                            "Qui entraîne la dégénérescence du tissu nerveux avec perte de neurones et de leurs fonctions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70789161-549c-46fe-bdb9-f1f5d6d29ef3",
                                                "sense_id": "2c43c44d-a6c7-3a38-aa5a-6b8bcd85db67",
                                                "text": "Le processus neurodégénératif."
                                            },
                                            {
                                                "example_id": "e0be6181-e0c7-4e97-959a-46ba7d5c8d1d",
                                                "sense_id": "2c43c44d-a6c7-3a38-aa5a-6b8bcd85db67",
                                                "text": "La maladie d'Alzheimer est une maladie neurodégénérative."
                                            },
                                            {
                                                "example_id": "ae93159b-8406-4c0f-a7d6-40d85672e237",
                                                "sense_id": "2c43c44d-a6c7-3a38-aa5a-6b8bcd85db67",
                                                "text": "Il existe par exemple un surprenant syndrome neurodégénératif, heureusement assez rare, qui provoque un tableau clinique de démence chez des adultes âgés de 50 à 70 ans. […] Ces patients perdent progressivement le « sens des choses ». — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 155)"
                                            },
                                            {
                                                "example_id": "9f81735d-d8e5-45d3-b50e-075c6cf39e1f",
                                                "sense_id": "2c43c44d-a6c7-3a38-aa5a-6b8bcd85db67",
                                                "text": "La manœuvre aurait été d’autant plus aisée que la lucidité d’Arlette Elkaïm-Sartre était, selon lui, diminuée par une maladie neurodégénérative."
                                            },
                                            {
                                                "example_id": "66352c20-3f1f-4960-944d-42448e6d3349",
                                                "sense_id": "2c43c44d-a6c7-3a38-aa5a-6b8bcd85db67",
                                                "text": "Les neurologues soupçonnent depuis quelques années déjà ce microbiote de jouer un rôle dans le développement de la maladie neurodégénérative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
