                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were playing football on the village <w>green</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли в футбол на деревенской <w>лужайке</w>."
                            }
                        },
                        {
                            "text": "The town <w>green</w> is a popular spot for summer concerts.",
                            "target_lang_translations": {
                                "ru": "Городская <w>площадь</w> — популярное место для летних концертов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "village green",
                        "town green"
                    ],
