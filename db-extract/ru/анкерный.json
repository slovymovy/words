                "senses": [
                    {
                        "sense_id": "e394e751-9bed-3142-9754-354d3b30aab6",
                        "entry_id": "d14bae57-8521-33e9-82dc-427cf57a9584",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным анкер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e69dd82-52a9-46ca-9947-aeb18408eac0",
                                "sense_id": "e394e751-9bed-3142-9754-354d3b30aab6",
                                "text": "― Анкерные-с… с парашютом… ― повторял он, показывая Нюрочке внутреннее устройство часов."
                            },
                            {
                                "example_id": "4119797d-895e-4553-a7fc-5423a39f6ba9",
                                "sense_id": "e394e751-9bed-3142-9754-354d3b30aab6",
                                "text": "Вместо телефонисток решили использовать электромеханические устройства, называемые шаговыми искателями. Шаговый искатель состоял из электромагнита и анкерного колеса, как в часовом механизме."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3b9a7ca-1769-4543-a42c-dfe0f4687a36",
                        "source_entry_id": "d14bae57-8521-33e9-82dc-427cf57a9584",
                        "source_sense_id": "e394e751-9bed-3142-9754-354d3b30aab6",
                        "target_lang_word": "anchor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anchor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7397f510-069b-3c8d-9c50-3384cdcffe1a",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A tool used to moor a vessel to the bottom of a sea or river to resist movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fc9f89-aac0-4761-a53c-0a0657f24372",
                                                "sense_id": "7397f510-069b-3c8d-9c50-3384cdcffe1a",
                                                "text": "Men that I knew around Wapatomac didn't wear high, shiny plug hats, nor yeller spring overcoats, nor carry canes with ivory heads as big as a catboat's anchor, as you might say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9213ca-00fb-327a-bfef-331cb75eebb5",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "An iron device so shaped as to grip the bottom and hold a vessel at her berth by the chain or rope attached. (FM 55-501)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8402ef6b-7c7b-3a4d-8c92-6177c8242c6c",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The combined anchoring gear (anchor, rode, bill/peak and fittings such as bitts, cat, and windlass.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ecb8027-45da-3636-8b15-c176f930d0d2",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "Representation of the nautical tool, used as a heraldic charge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "289f117c-b462-36ed-b2c3-a09b043cf3e6",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "Any instrument serving a purpose like that of a ship's anchor, such as an arrangement of timber to hold a dam fast; a device to hold the end of a bridge cable etc.; or a device used in metalworking to hold the core of a mould in place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7532cd6b-52cb-3b46-b3f8-7bfa0f3ec89b",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A marked point in a document that can be the target of a hyperlink."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98d9d557-3235-35a4-bc87-dc44af8af07e",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A line of code in a program which acts as a reference point for further code to be added immediately before or after, usually via copy and paste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a379f29c-f522-3f8e-8c81-fe9699938db3",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "An anchorman or anchorwoman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d797b02e-67fb-4dfa-8b36-665c66cbaafd",
                                                "sense_id": "a379f29c-f522-3f8e-8c81-fe9699938db3",
                                                "text": "Condoleezza Rice pops up on Fox to be told by the anchor: “When you invade a sovereign nation, that is a war crime.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40732e5e-0f5a-367f-922c-65be5c438d57",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The final runner in a relay race."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e43d127d-4dc8-3d1a-8453-608964260309",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A point that is touched by the draw hand or string when the bow is fully drawn and ready to shoot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A superstore or other facility that serves as a focus to bring customers into an area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdd829b-9fae-45db-aa3d-ba2465c8a660",
                                                "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                                                "text": "Supermarkets have also had to adjust. Tesco, Sainsbury's and Asda have put a much greater emphasis on developing smaller high street stores or becoming anchors for mixed-used regeneration schemes […]"
                                            },
                                            {
                                                "example_id": "db5fb40f-0c7d-43e4-976b-41fe968b3a00",
                                                "sense_id": "471150e1-f2fe-3f6b-bf6e-81404e28a203",
                                                "text": "However, mall developers offer huge discounts to department stores because these anchors create traffic […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23079f1-e5ac-313a-805d-bc806d1d3248",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "That which gives stability or security."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2271392c-f365-4bf1-b3a3-daf9adefbc57",
                                                "sense_id": "e23079f1-e5ac-313a-805d-bc806d1d3248",
                                                "text": "which hope we have as an anchor of the soul"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5712e804-8f9f-3391-93f9-653f08d0cbe4",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A metal tie holding adjoining parts of a building together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "709a567b-3ae1-37dc-a58f-01bebca1f05a",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A screw anchor."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "384258d1-9b78-316b-910a-f1500d45861c",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "Carved work, somewhat resembling an anchor or arrowhead; part of the ornaments of certain mouldings. It is seen in the echinus, or egg-and-anchor (called also egg-and-dart, egg-and-tongue) ornament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0b440c-8e2f-346e-8b5f-5ec539a0ecf2",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "One of the anchor-shaped spicules of certain sponges."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f484b3a-1164-344e-947d-0761285ed1e3",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "One of the calcareous spinules of certain holothurians, as in species of Synapta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb23ad1-cdbf-39da-8c77-b33da57dd65b",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The thirty-fifth Lenormand card."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "The brake of a vehicle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff71dd33-3b5c-4534-ae28-e1864fc40109",
                                                "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                                "text": "I saw Tim look back through the rear window of the cab and prayed he wouldn't do the first thing that came into his mind and step on the anchors."
                                            },
                                            {
                                                "example_id": "7c82e63a-542d-4599-a773-fe9052015a88",
                                                "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                                "text": "[Police:] ‘… when we blow the horn, you do an emergency stop.’ So the foaf did as he was bid and, hearing an almighty horn blast stepped on the anchors. There was a most tremendous crash as the Police car ran into the back of his Austin."
                                            },
                                            {
                                                "example_id": "e921b767-9c9b-4605-9da5-645c0ff5b272",
                                                "sense_id": "d4dad9c2-b592-3de3-bf7b-47051ca7dd5e",
                                                "text": "“Brake, brake, brake! You need to scrub off more speed before you enter the corner,” he explained, as I took his advice and jumped on the anchors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82bc1658-657d-3376-8d19-1f386bb651f8",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A defensive player, especially one who counters the opposition's best offensive player."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f56e9c0-add7-4bda-8564-075467b4b0e7",
                                                "sense_id": "82bc1658-657d-3376-8d19-1f386bb651f8",
                                                "text": "Phil Foden once again demonstrated his pedigree and will push for a start, while Leeds United's Kalvin Phillips will hope he has done enough to get a chance as a defensive midfield anchor if Liverpool captain Jordan Henderson fails to recover full fitness after groin surgery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97a60f30-e4f3-3a86-8f47-b7e5b4d9cc84",
                                        "entry_id": "024aaa9c-384d-3468-8113-8fd4df0a1c1a",
                                        "glosses": [
                                            "A batter who remains in for a long time."
