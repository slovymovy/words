                "senses": [
                    {
                        "sense_id": "faf2283f-4150-3715-8b17-2b182dcc324a",
                        "entry_id": "f5d93f9a-827a-3b81-b858-38d178cfd3b0",
                        "glosses": [
                            "Contre le tétanos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e71a5fb-43a8-424b-8217-53d8abb08a40",
                                "sense_id": "faf2283f-4150-3715-8b17-2b182dcc324a",
                                "text": "On nous a fait à tous deux des piqûres antitétaniques, qui nous donneront, paraît-il, de l’urticaire dans deux ou trois jours. Pierre, très abattu, est resté à la clinique."
                            },
                            {
                                "example_id": "ff73b04c-a321-4885-a650-6d41645625fb",
                                "sense_id": "faf2283f-4150-3715-8b17-2b182dcc324a",
                                "text": "Pour les enfants, la vaccination antitétanique est obligatoire. Elle est pratiquée dès l'âge de deux mois, associée avec le vaccin contre la diphtérie et la poliomyélite, avec des rappels jusqu'à l'âge de 18 ans."
                            }
                        ]
                    }
                ],
