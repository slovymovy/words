                "senses": [
                    {
                        "sense_id": "03e6b8b8-ba80-355d-9a24-48048ae52c68",
                        "entry_id": "ea1b59f2-cbb3-3f3e-bc26-96691a630616",
                        "glosses": [
                            "Stimuler de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd8bfd5-5451-4a15-b09d-9c7f828d54df",
                                "sense_id": "03e6b8b8-ba80-355d-9a24-48048ae52c68",
                                "text": "Avant de songer à savoir comment bien stimuler l'enfant prématuré, il faudra surtout veiller à ne pas le sur-stimuler, ni le dys-stimuler."
                            },
                            {
                                "example_id": "0e39c161-544c-4613-b283-606a88c7f2eb",
                                "sense_id": "03e6b8b8-ba80-355d-9a24-48048ae52c68",
                                "text": "Ce constat invite à toujours prêter attention à ne pas sur-stimuler ni sous-stimuler l'enfant avant la naissance."
                            }
                        ]
                    }
