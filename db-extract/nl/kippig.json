                ],
                "senses": [
                    {
                        "sense_id": "cda01320-5a42-321e-9a93-2bab90197d9e",
                        "entry_id": "871973a1-57ce-3da2-8869-48c779e4da2e",
                        "glosses": [
                            "iemand die kippig is, is bijziend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12cbee07-aeb4-4a72-8743-113752e8a7ea",
                                "sense_id": "cda01320-5a42-321e-9a93-2bab90197d9e",
                                "text": "Een kippig persoon kan kleine dingen op een kleine afstand heel goed en scherp zien en dat is voor een muggenzifter heel handig."
                            },
                            {
                                "example_id": "7efecb6a-83a8-4e4b-b278-f286f216ac2d",
                                "sense_id": "cda01320-5a42-321e-9a93-2bab90197d9e",
                                "text": "„maar dit is alleen voor de volwassen kijkers” - die een poesje bezaten dat het hield met een hond. „Ik voeg erbij dat ze een beetje kippig is, niet om de affaire zoölogisch nog ernstiger te verknopen, maar alleen omdat dit tekort haar misschien enigszins disculpeert.” Wie zo’n zin leest, moet wel tot de conclusie komen dat de tand des tijds ook aan het werk van de bewierookte Kronkel heeft geknaagd."
                            }
                        ]
                    }
                ],
