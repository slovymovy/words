                        "entry_id": "b9aca269-964a-3a8d-a396-507e8cb71b90",
                        "glosses": [
                            "peuple nilotique du Soudan du Sud, de la rive ouest du Nil blanc dans l’État du Nil supérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cdf2b76-1f05-4f60-9942-e08f625ce205",
                                "sense_id": "2ba82edb-c65b-31f5-b6fa-ccb62322a86f",
                                "text": "Les Nuer et les Shilluk figurent également parmi les principaux peuples du Soudan du Sud."
                            },
                            {
                                "example_id": "b52fe192-4789-44b5-8af7-e39ee72ce346",
                                "sense_id": "2ba82edb-c65b-31f5-b6fa-ccb62322a86f",
                                "text": "D’effroyables massacres de civils s’ensuivent pour chasser les Nuers et les Shilluks, groupes dont sont originaires les dissidents."
                            },
                            {
                                "example_id": "48413b96-8436-4f8c-8d41-a41899a2c607",
                                "sense_id": "2ba82edb-c65b-31f5-b6fa-ccb62322a86f",
                                "text": "Les quelques populations de cette région étudiées jusque-là sont les Nilotiques au sud, dont les Shilluks localisés le long du cours moyen du Nil blanc … sont géographiquement les plus proches."
                            }
                        ]
                    }
