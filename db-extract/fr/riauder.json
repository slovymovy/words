                        "glosses": [
                            "Rire bêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1c0442e-457d-4edb-929a-c1fad8f6726e",
                                "sense_id": "428f266e-02d5-330b-8647-5f814e31b54a",
                                "text": "Elle riauda et, à sa nervosité, Hugues comprit combien elle était inquiète."
                            },
                            {
                                "example_id": "2e128585-53d9-4437-8cfd-c50cae36c7c9",
                                "sense_id": "428f266e-02d5-330b-8647-5f814e31b54a",
                                "text": "et, comme il est encore faible et qu'il a bu un petit coup de porter, il s'épanche en doléances prolixes, tandis que les hommes, un peu saisis devant le maître, riaudent sottement pour dissimuler leur gêne."
                            }
                        ]
                    }
