                        "examples": [
                            {
                                "example_id": "5b582bea-2aac-40c9-a046-85be6088f09b",
                                "sense_id": "31f92411-35bb-3eb5-964f-73f1b8408931",
                                "text": "De nieuwe hoop op een stunt ebde echter snel weer weg bij de nummer vijf van de Keuken Kampioen Divisie. Utrecht kwam via een intikker van spits Bahebeck rap op 3-1."
                            },
                            {
                                "example_id": "b5cca831-28b7-4504-aaab-a03fc50461ea",
                                "sense_id": "31f92411-35bb-3eb5-964f-73f1b8408931",
                                "text": "Halverwege leidde de thuisclub met 2-0 door een intikker van Lukas Klostermann en een kopbal van Patrik Schick, die bij de 1-0 de assist verzorgde. Na rust schoot Nordi Mukiele raak na een bekeken pass van Konrad Laimer. Eerder dit seizoen had Leipzig in Bremen ook al met 3-0 gewonnen van de club van Davy Klaassen."
                            }
