                        "tags": [
                            "Bergmannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "0f79fdbb-d410-496e-a909-cf87d8134d49",
                                "sense_id": "3047160b-72e2-32de-89e8-fd3957aba7ba",
                                "text": "„Zuerst kamen wir an dem bekannten Bergfall von Goldau vorüber, welcher vor 41 Jahren 4 Dörfer und mehr als 400 Menschen begraben.“"
                            },
                            {
                                "example_id": "f55a7a67-20f4-4ba2-948b-0f8a34db86d6",
                                "sense_id": "3047160b-72e2-32de-89e8-fd3957aba7ba",
                                "text": "„Da stürzten plötzlich Bergleute herbei Angst und Entsetzen in den bleichen Gesichtern, und meldeten, wie eben ein fürchterlicher Bergfall die ganze Grube […] verschüttet.“"
                            }
                        ],
