                ],
                "senses": [
                    {
                        "sense_id": "a3c77caf-3a0e-3663-ac5b-a4500e69c6f6",
                        "entry_id": "7e038ff2-88ff-3213-9002-31782ccdbb34",
                        "glosses": [
                            "Second terme d’une fraction, écrit en dessous du trait de fraction ou après son trait oblique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f84cf6e8-448f-479f-8a3b-6a32154f7fe7",
                                "sense_id": "a3c77caf-3a0e-3663-ac5b-a4500e69c6f6",
                                "text": "4 est le dénominateur de la fraction ,{3/{4"
                            },
                            {
                                "example_id": "b97b5b4f-da38-4ff6-b34a-d6295c4ba8fb",
                                "sense_id": "a3c77caf-3a0e-3663-ac5b-a4500e69c6f6",
                                "text": "Réduire deux fractions au même dénominateur permet d’additionner leurs numérateurs, afin d’écrire leur somme sous forme d’une fraction."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd6687cd-d180-3084-b5af-386813917c02",
                        "entry_id": "7e038ff2-88ff-3213-9002-31782ccdbb34",
                        "glosses": [
                            "Ce qui est commun à plusieurs choses, voire plusieurs personnes."
                        ],
                        "tags": [
                            "ellipsis",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a13c0cec-4969-4bab-bcd6-0bb322281ec2",
                                "sense_id": "bd6687cd-d180-3084-b5af-386813917c02",
                                "text": "Il croyait à la vérité de cette pensée exprimée par Lyautey dans un de ses discours marocains : par-delà toutes les différences, il existe toujours entre les hommes un dénominateur commun."
                            },
                            {
                                "example_id": "16f9006f-d22e-4d97-afd3-0847ecc3cb08",
                                "sense_id": "bd6687cd-d180-3084-b5af-386813917c02",
                                "text": "On peut sans doute soutenir aujourd’hui que les dénominateurs de l’industrialisation, de la technologie et autres variables analogues ont la force de l’universalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ab8b3b5-2b72-4610-8ad5-e36a4f8d9c42",
                        "source_entry_id": "7e038ff2-88ff-3213-9002-31782ccdbb34",
                        "source_sense_description": "Diviseur d’une fraction (1)",
                        "target_lang_word": "Nenner",
                        "target_lang_code": "de",
