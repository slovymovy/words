{
    "word_family": [
        "billeting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed431639-e794-3f81-999d-101e70acda31",
                    "sense_definition": "A short informal letter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received a short <w>billet</w> from her friend explaining the change in plans.",
                            "target_lang_translations": {
                                "nl": "Ze ontving een kort <w>briefje</w> van haar vriendin waarin de wijziging in de plannen werd uitgelegd."
                            }
                        },
                        {
                            "text": "He left a quick <w>billet</w> on the table before heading out for the day.",
                            "target_lang_translations": {
                                "nl": "Hij liet een snel <w>briefje</w> op tafel achter voordat hij voor de dag vertrok."
                            }
                        }
                    ],
                    "synonyms": [
                        "note",
                        "letter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kort, informeel briefje."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "briefje",
                                "target_lang_sense_clarification": "Een kort, informeel geschreven bericht."
                            },
                            {
                                "target_lang_word": "notitie",
                                "target_lang_sense_clarification": "Een korte aantekening of bericht."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "136e345b-5285-3b95-a5f3-535949efcc82",
                    "sense_definition": "A place where a soldier is assigned to lodge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lodging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were happy to find a warm <w>billet</w> for the night.",
                            "target_lang_translations": {
                                "nl": "De soldaten waren blij dat ze een warm <w>kwartier</w> voor de nacht vonden."
                            }
                        },
                        {
                            "text": "The army commander inspected every <w>billet</w> to ensure the troops were comfortable.",
                            "target_lang_translations": {
                                "nl": "De legercommandant inspecteerde elk <w>kwartier</w> om er zeker van te zijn dat de troepen comfortabel zaten."
                            }
                        }
                    ],
                    "synonyms": [
                        "quarters",
                        "lodging"
                    ],
                    "common_phrases": [
                        "military billet"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een verblijfplaats waar een soldaat is ondergebracht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kwartier",
                                "target_lang_sense_clarification": "Een tijdelijke verblijfplaats voor militairen."
                            },
                            {
                                "target_lang_word": "legerplaats",
                                "target_lang_sense_clarification": "Een plek waar militairen zijn gehuisvest."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62fa1f06-dd61-3dfb-af53-51af9e357ff5",
                    "sense_definition": "A semi-finished length of metal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory produced thousands of steel <w>billets</w> every single day.",
                            "target_lang_translations": {
                                "nl": "De fabriek produceerde elke dag duizenden stalen <w>knuppels</w>."
                            }
                        },
                        {
                            "text": "The heavy <w>billet</w> was moved by a crane to the rolling mill.",
                            "target_lang_translations": {
                                "nl": "De zware <w>knuppel</w> werd door een kraan naar de walserij verplaatst."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingot"
                    ],
                    "common_phrases": [
                        "steel billet"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een halffabricaat van metaal, vaak in de vorm van een staaf of blok."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knuppel",
                                "target_lang_sense_clarification": "Een blok of staaf metaal die nog verder bewerkt moet worden."
                            },
                            {
                                "target_lang_word": "staaf",
                                "target_lang_sense_clarification": "Een langwerpig stuk metaal als halffabricaat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "937dcecd-eb3a-3d0d-b316-2598daa91ae6",
                    "sense_definition": "A short piece of wood, especially one used as firewood.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chopped the log into several small <w>billets</w> for the fireplace.",
                            "target_lang_translations": {
                                "nl": "Hij hakte de boomstam in verschillende kleine <w>houtblokken</w> voor de open haard."
                            }
                        },
                        {
                            "text": "The old stove was fed with a dry <w>billet</w> of oak.",
                            "target_lang_translations": {
                                "nl": "De oude kachel werd gevoed met een droog <w>blok eikenhout</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "log",
                        "stick"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kort stuk hout, vaak gebruikt als brandhout."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "blok hout",
                                "target_lang_sense_clarification": "Een stuk hout dat geschikt is voor de open haard."
                            },
                            {
                                "target_lang_word": "houtblok",
                                "target_lang_sense_clarification": "Een stuk gekapt hout."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76fa115a-ca27-31b5-9b4c-23e9e45a51ab",
                    "sense_definition": "To lodge soldiers, or guests, usually by order.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lodging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local government decided to <w>billet</w> the troops in the town hall.",
                            "target_lang_translations": {
                                "nl": "De lokale overheid besloot de troepen in het gemeentehuis te <w>inkwartieren</w>."
                            }
                        },
                        {
                            "text": "They were <w>billeted</w> in a large house during the winter months.",
                            "target_lang_translations": {
                                "nl": "Ze werden tijdens de wintermaanden in een groot huis <w>ingekwartierd</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "quarter",
                        "lodge"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het onderbrengen van soldaten of gasten, meestal in opdracht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "inkwartieren",
                                "target_lang_sense_clarification": "Het toewijzen van een tijdelijk verblijf aan soldaten in andermans woning."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}