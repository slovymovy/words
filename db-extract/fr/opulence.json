                                    {
                                        "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                        "entry_id": "91de9a6e-6fda-3449-a7c0-d17d16bc6758",
                                        "glosses": [
                                            "het voorhanden zijn van meer dan voldoende van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7136de4-062d-42e1-99be-94b85c3246e0",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Dat had de bodem gelegd voor de welstand, om niet te zeggen overvloed, van de voltallige familie voor de nabije toekomst."
                                            },
                                            {
                                                "example_id": "d876f1c7-8c33-4ead-867f-b69e0d307e44",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Er was een overvloed van aardbeien dat jaar."
                                            },
                                            {
                                                "example_id": "e4d7f0e0-375a-4480-bebf-e6866abf8120",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59efcc74-1da9-4f0d-821d-a15614963d72",
                        "source_entry_id": "a53342d8-f2c8-3414-b6fd-e06e968eeca5",
                        "target_lang_word": "uitbundigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitbundigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9e0be5f7-d31e-378a-8111-d8ec7e308bff",
                                        "entry_id": "386db8b3-0afa-317b-9ed6-550d0da4bab0",
                                        "glosses": [
                                            "het op een luidruchtige manier uiting geven aan een vrolijke stemming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b20c27-7fa5-4165-8cb6-60811c004343",
                                                "sense_id": "9e0be5f7-d31e-378a-8111-d8ec7e308bff",
                                                "text": ",,Onze gedachten en gebeden zijn bij de familie van Yordano, zei manager Dayton Moore van Kansas City Royals zondag. ,,Hij was jong en zo getalenteerd, vol jeugdige uitbundigheid. Hij bracht altijd bij iedereen een lach op het gezicht."
                                            },
                                            {
                                                "example_id": "d6fce922-5641-437d-8bd1-bac46225d51c",
                                                "sense_id": "9e0be5f7-d31e-378a-8111-d8ec7e308bff",
                                                "text": "Zaterdagavond vierde de presentator een groot verjaardagsfeest. Op een boot, met vrienden, gezang en uitbundigheid. Daar werd ook bekend dat de geboren Fries weer iets nieuws erbij gaat doen: chief executive officer (CEO), jawel, bij een Brabants familiebedrijf: de JHB group."
                                            },
                                            {
                                                "example_id": "e7876e62-b1d0-4f36-be53-76a71375f03e",
                                                "sense_id": "9e0be5f7-d31e-378a-8111-d8ec7e308bff",
                                                "text": "Nu de voetbaldames de finale hebben gehaald, lijkt Nederland wakker te worden. Horecaondernemers stoffen de tv-schermen en beamers af en pakken groots uit om er om 17.00 uur een feest van te maken. Maar de uitbundigheid is bij lange na niet te vergelijken met de Oranjekoorts die normaal heerst bij een EK."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaad42b9-971c-4756-88be-f57414a8d9a9",
