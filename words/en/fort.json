    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ecd4fce-354b-3882-978b-c8d5c3fd35b1",
                    "sense_definition": "A strong building or group of buildings used by soldiers for defending a place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "defensive_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers defended the <w>fort</w> against the enemy attack.",
                            "target_lang_translations": {
                                "ru": "Солдаты защищали <w>форт</w> от вражеской атаки.",
                                "zh": "士兵们守卫着<w>堡垒</w>以抵御敌人的进攻。"
                            }
                        },
                        {
                            "text": "We visited an old stone <w>fort</w> overlooking the harbor.",
                            "target_lang_translations": {
                                "ru": "Мы посетили старый каменный <w>форт</w> с видом на гавань.",
                                "zh": "我们参观了一座俯瞰港口的古老石制<w>要塞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fortress",
                        "stronghold",
                        "citadel",
                        "fortification",
                        "castle",
                        "bastion"
                    ],
                    "common_phrases": [
                        "hold the fort",
                        "stone fort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкое здание или группа зданий, используемых военными для обороны местности.",
                        "zh": "一种用于防御的坚固建筑物或建筑群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форт",
                                "target_lang_sense_clarification": "отдельное укрепление"
                            },
                            {
                                "target_lang_word": "крепость",
                                "target_lang_sense_clarification": "оборонительное сооружение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堡垒",
                                "target_lang_sense_clarification": "防御性建筑"
                            },
                            {
                                "target_lang_word": "要塞",
                                "target_lang_sense_clarification": "大型防御工事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7aadc06-c422-3cba-82d8-5180f09cfc96",
                    "sense_definition": "A temporary shelter made by children from furniture, blankets, or boxes for play.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "play_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children built a <w>fort</w> using the sofa cushions and some sheets.",
                            "target_lang_translations": {
                                "ru": "Дети построили <w>крепость</w> из диванных подушек и простыней.",
                                "zh": "孩子们用沙发垫和床单搭了一个<w>堡垒</w>。"
                            }
                        },
                        {
                            "text": "We hid inside our pillow <w>fort</w> for the whole afternoon.",
                            "target_lang_translations": {
                                "ru": "Мы прятались в нашей <w>крепости</w> из подушек весь день.",
                                "zh": "整个下午我们都躲在枕头搭成的<w>小窝</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "den",
                        "hideout"
                    ],
                    "common_phrases": [
                        "pillow fort",
                        "blanket fort",
                        "build a fort"
                    ],
                    "target_lang_definitions": {
