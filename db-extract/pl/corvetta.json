                                "example_id": "d428ee3e-575a-4d2a-8a50-bebc85ebb9ab",
                                "sense_id": "4b47c69d-1198-371a-9199-1b006e0d5baa",
                                "text": "W podkrakowskich Szczyglicach, przed okazałą willą, czerwieni się sportowa corvetta"
                            },
