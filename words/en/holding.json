                        "ru": "Имущество, которым владеют, например, финансовые активы, акции, облигации или земля.",
                        "tr": "Finansal varlıklar, hisse senetleri, tahviller veya arazi gibi sahip olunan mülk veya değerler."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владе́ние",
                                "target_lang_sense_clarification": "собственность"
                            },
                            {
                                "target_lang_word": "акти́вы",
                                "target_lang_sense_clarification": "финансовые"
                            },
                            {
                                "target_lang_word": "фо́нды",
