                "senses": [
                    {
                        "sense_id": "265ab6b5-33b6-3d26-b938-59c5604d8163",
                        "entry_id": "67f4fefb-b121-3838-9a38-84b33d2d560e",
                        "glosses": [
                            "inclined (having a tendency or preference)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45c9c90-00b8-43b3-9b94-17e2435a4fd3",
                                "sense_id": "265ab6b5-33b6-3d26-b938-59c5604d8163",
                                "text": "Maar zijn wij alzo verdorven, dat wij ganselijk onbekwaamzijn tot enig goed en geneigd tot alle kwaad?",
                                "translation": "But are we so depraved, that we are totally incapable of any good and inclined to all evil?",
                                "english": "But are we so depraved, that we are totally incapable of any good and inclined to all evil?"
                            },
                            {
                                "example_id": "f247cab8-f806-411e-85da-9f439a27f250",
                                "sense_id": "265ab6b5-33b6-3d26-b938-59c5604d8163",
                                "text": "Rousseau geloofde in de van nature tot het goede geneigde mens.",
                                "translation": "Rousseau believed in humankind as naturally inclined to that which is good.",
                                "english": "Rousseau believed in humankind as naturally inclined to that which is good."
                            }
                        ]
                    }
                ],
