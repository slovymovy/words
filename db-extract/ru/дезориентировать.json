                ],
                "senses": [
                    {
                        "sense_id": "d33190c6-1186-33b7-814a-ec6b29f087a6",
                        "entry_id": "28ef253d-a052-3400-838b-010cb6826fbd",
                        "glosses": [
                            "способствовать потере правильной ориентации в пространстве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d17ce4b3-f1d2-4cc6-8ff5-aa6030570360",
                                "sense_id": "d33190c6-1186-33b7-814a-ec6b29f087a6",
                                "text": "Около здания театра стояли зенитки, а чтобы дезориентировать немецких летчиков, рядом с театром построили макет церкви."
                            },
                            {
                                "example_id": "f3d195f3-a250-46a0-bb92-686d0803a7e3",
                                "sense_id": "d33190c6-1186-33b7-814a-ec6b29f087a6",
                                "text": "Например, при приближении хищника стая часто раздваивается ― расступается перед ним, причем образовавшиеся две стаи направляются навстречу хищнику (даже если он атаковал стаю с тыла) и, обойдя его, снова смыкаются. Этот защитный маневр, который может повторяться неоднократно, дезориентирует нападающую рыбу иногда настолько, что она даже прекращает охоту."
                            }
                        ]
                    },
                    {
                        "sense_id": "4da171cc-544d-359b-a55c-17f4b2846c8e",
                        "entry_id": "28ef253d-a052-3400-838b-010cb6826fbd",
                        "glosses": [
                            "лишать правильного представления о чем-либо; вводить в заблуждение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0925d8bf-1834-437e-ad6c-fb0199bd38d8",
                                "sense_id": "4da171cc-544d-359b-a55c-17f4b2846c8e",
                                "text": "Появились неясности, недомолвки, пробелы. Они иной раз искажали мой замысел и дезориентировали читателя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2a8fd47-e98c-4151-9fb0-a9c9b40753e3",
                        "source_entry_id": "28ef253d-a052-3400-838b-010cb6826fbd",
                        "target_lang_word": "désorienter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désorienter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec371458-b903-36b2-b67d-90feb60ec462",
                                        "entry_id": "fc3c3057-1926-3d29-8b9e-e33f7414dafb",
                                        "glosses": [
                                            "Priver de la connaissance du véritable côté du ciel où le soleil se lève, par rapport au pays où l’on est."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e251edb4-edeb-4f64-9d85-0f68d26d14c5",
                                                "sense_id": "ec371458-b903-36b2-b67d-90feb60ec462",
                                                "text": "Nous étions sans boussole, la brume acheva de nous désorienter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d18971-f950-32c5-89e5-bfcbd7b7fc50",
                                        "entry_id": "fc3c3057-1926-3d29-8b9e-e33f7414dafb",
                                        "glosses": [
                                            "Rendre incertain, hésitant sur le chemin qu’on doit prendre, sur ce qu’il faut faire, sur la manière dont on doit se comporter."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "190283f0-8944-49b0-a2c5-a909e6df494a",
                                                "sense_id": "39d18971-f950-32c5-89e5-bfcbd7b7fc50",
                                                "text": "L’analyse des boîtes noires de l’appareil, repêchées un mois plus tard, a confirmé que les pilotes, désorientés par le givrage des sondes de vitesse Pitot, n’ont pu rattraper le décrochage de l’appareil, qui a eu lieu en moins de cinq minutes."
                                            },
                                            {
                                                "example_id": "c38fe6cc-783d-4aab-ad8a-ab4376d5f41c",
                                                "sense_id": "39d18971-f950-32c5-89e5-bfcbd7b7fc50",
                                                "text": "Cette question imprévue l’a désorienté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
