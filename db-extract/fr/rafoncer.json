                "senses": [
                    {
                        "sense_id": "bcb4b1c9-1c61-343b-b936-2c60366994c6",
                        "entry_id": "eb25868d-f81d-33aa-91ea-2e0d84b483cc",
                        "glosses": [
                            "Compléter de liquide ce qui manque."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "ca71c069-31a1-41d4-81cf-324de3f5fd01",
                                "sense_id": "bcb4b1c9-1c61-343b-b936-2c60366994c6",
                                "text": "Il doit être rempli en un jour ou deux, pas rafoncé (complété) perpétuellement, pour que les fruits fermentent ensemble."
                            },
                            {
                                "example_id": "daf15048-ef96-4038-bc58-febc77b663e1",
                                "sense_id": "bcb4b1c9-1c61-343b-b936-2c60366994c6",
                                "text": "Le solide a été puissamment arrosé d'un breuvage qui n'était pas, je vous l'assure, un penadzet : il a fallu plusieurs fois rafoncer."
                            },
                            {
                                "example_id": "a1f1e558-28ef-4b83-84f7-7ecfaf412910",
                                "sense_id": "bcb4b1c9-1c61-343b-b936-2c60366994c6",
                                "text": "Au contraire, sa rondeur aérienne invite à rafoncer les godets de toute la tablée jusqu'à ce que chacun crève assez la dalle pour passer à plus sérieux."
                            }
                        ]
                    }
