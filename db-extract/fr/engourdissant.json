                        "glosses": [
                            "Qui provoque la paralysie ou une perte de sensibilité au corps ou à une de ses parties."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ebd6a196-0a51-3fa0-ae7c-8539cf58639c",
                        "entry_id": "90c5597f-9dfe-3780-aea5-cf767460f0c5",
                        "glosses": [
                            "Qui entraîne une diminution des facultés de l’esprit qui apaise."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d7e7a1da-8c36-454d-822d-dbd6a452d3e6",
                                "sense_id": "ebd6a196-0a51-3fa0-ae7c-8539cf58639c",
                                "text": "Les oiseaux ne chantaient plus, il n'y avait plus d'autre bruit que le fredon des insectes ailés, une vibration doucement musicale, toujours la même, engourdissante."
                            },
                            {
                                "example_id": "2e23e31d-6c1c-4601-b95b-e466b76ae505",
                                "sense_id": "ebd6a196-0a51-3fa0-ae7c-8539cf58639c",
                                "text": "La serveuse, tirée de l’engourdissante contemplation de la rue, s’empressa."
                            }
                        ]
                    }
