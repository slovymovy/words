                        ],
                        "form": "die Tobsucht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0693840-5dbf-30ea-bc81-9aebf6f565af",
                        "entry_id": "92aa4967-1e98-34aa-adbc-89a5b5dd5e22",
                        "glosses": [
                            "psychische Störung, die sich in übermäßigem Zorn äußert"
                        ],
                        "tags": [
                            "jargon",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f2ec07df-4698-4429-8f5e-ce60007c95e2",
                                "sense_id": "e0693840-5dbf-30ea-bc81-9aebf6f565af",
                                "text": "„Seine Wutanfälle, sein chronisches Vergeltungsbedürfnis, dessen erreichbares Opfer seine Frau war, artete nie in Tobsucht aus, soviel wir wissen.“"
                            },
                            {
                                "example_id": "6750b790-5b67-45c1-8e2b-6cdb5759fe46",
                                "sense_id": "e0693840-5dbf-30ea-bc81-9aebf6f565af",
                                "text": "„Ihr Mann hatte lange mit Dingen aus seiner Vergangenheit zu kämpfen und ein Alkoholproblem, und Tove fürchtete, er könne den Halt verlieren, wieder zu trinken beginnen, Anfälle von Tobsucht und Selbstmitleid bekommen, wenn sie ihn verließe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
