{
    "word_family": [
        "power",
        "powerfully",
        "powerlessness",
        "empower",
        "empowerment",
        "overpower",
        "powerless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15ea269d-3e62-31d4-8f26-0ab1e2742e6e",
                    "sense_definition": "Having great physical strength, force, or authority to control or influence people and events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strength_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>powerful</w> engine allowed the truck to climb the steep hill without any trouble.",
                            "target_lang_translations": {
                                "ru": "<w>Мощный</w> двигатель позволил грузовику без труда подняться на крутой холм.",
                                "zh": "这台<w>强劲</w>的发动机让卡车毫不费力地爬上了陡坡。"
                            }
                        },
                        {
                            "text": "She is a <w>powerful</w> politician who can change the laws of the country.",
                            "target_lang_translations": {
                                "ru": "Она — <w>влиятельный</w> политик, способный менять законы страны.",
                                "zh": "她是一位<w>有权势</w>的政治人物，能够改变国家的法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "mighty",
                        "forceful",
                        "potent",
                        "influential",
                        "dominant"
                    ],
                    "antonyms": [
                        "powerless",
                        "strengthless"
                    ],
                    "common_phrases": [
                        "powerful engine",
                        "powerful voice",
                        "powerful leader",
                        "powerful storm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий большой физической силой, энергией или властью для контроля и влияния на людей и события.",
                        "zh": "具有很强的体力、力量或权力，能够控制或影响他人及事件的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "о физической силе, механизмах или природных явлениях"
                            },
                            {
                                "target_lang_word": "могущественный",
                                "target_lang_sense_clarification": "о власти и большом влиянии"
                            },
                            {
                                "target_lang_word": "влиятельный",
                                "target_lang_sense_clarification": "об авторитете в обществе или политике"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "общая характеристика силы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强劲",
                                "target_lang_sense_clarification": "指力量、动力、机器或自然现象很强"
                            },
                            {
                                "target_lang_word": "有权势",
                                "target_lang_sense_clarification": "指掌握权力、能支配他人或局势"
                            },
                            {
                                "target_lang_word": "有影响力",
                                "target_lang_sense_clarification": "指在社会、政治等方面影响力很大"
                            },
                            {
                                "target_lang_word": "强大",
                                "target_lang_sense_clarification": "较通用，表示强而有力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05b05134-d9a3-3939-bb87-26698a5f026f",
                    "sense_definition": "Highly effective or convincing; capable of producing significant results or deductions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strength_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer presented a <w>powerful</w> argument that convinced the jury immediately.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил <w>сильный</w> аргумент, который немедленно убедил присяжных.",
                                "zh": "律师提出了一个<w>有力</w>的论点，立刻说服了陪审团。"
                            }
                        },
                        {
                            "text": "This software is a <w>powerful</w> tool for analyzing complex data.",
                            "target_lang_translations": {
                                "ru": "Это программное обеспечение — <w>мощный</w> инструмент для анализа сложных данных.",
                                "zh": "这款软件是分析复杂数据的<w>强大</w>工具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "potent",
                        "strong",
                        "forceful"
                    ],
                    "antonyms": [
                        "powerless"
                    ],
                    "common_phrases": [
                        "powerful argument",
                        "powerful tool",
                        "powerful effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокоэффективный или убедительный; способный приносить значительные результаты.",
                        "zh": "非常有效或很有说服力的；能够产生显著结果或推论的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "об аргументах, чувствах или воздействии"
                            },
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "об инструментах, средствах или ПО"
                            },
                            {
                                "target_lang_word": "убедительный",
                                "target_lang_sense_clarification": "об аргументах или доводах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有力",
                                "target_lang_sense_clarification": "指论点、证据、效果等强而有效"
                            },
                            {
                                "target_lang_word": "强大",
                                "target_lang_sense_clarification": "指工具、系统、软件等性能很强"
                            },
                            {
                                "target_lang_word": "有说服力",
                                "target_lang_sense_clarification": "指论证或说法很能让人信服"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9943d2f-68f3-38bb-ad92-7ad4b6455ab6",
                    "sense_definition": "Large and capacious; containing a large amount of material (specifically used regarding veins of ore).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners were excited to discover a <w>powerful</w> vein of gold deep inside the mountain.",
                            "target_lang_translations": {
                                "ru": "Шахтёры были в восторге, обнаружив <w>мощную</w> золотую жилу глубоко внутри горы.",
                                "zh": "矿工们在山体深处发现了一条<w>厚大</w>的金脉，兴奋不已。"
                            }
                        },
                        {
                            "text": "Geologists surveyed the area to see if the deposits were <w>powerful</w> enough to justify a new mine.",
                            "target_lang_translations": {
                                "ru": "Геологи обследовали местность, чтобы понять, достаточно ли <w>мощные</w> эти залежи для обоснования новой шахты.",
                                "zh": "地质学家勘查了这一地区，看看这些矿藏是否足够<w>厚大</w>，从而有理由新建一座矿井。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mining context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный, толстый (о слоях горных пород или залежах ископаемых).",
                        "zh": "大而厚的；含有大量物质的，特指矿脉或矿层等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "геологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厚大",
                                "target_lang_sense_clarification": "地质或采矿用语，指矿脉、矿层等厚而大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b70fa520-49b9-3fb8-887e-affdefdd2ac3",
                    "sense_definition": "Being a specific type of integer where for every prime number dividing it, the square of that prime also divides it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In number theory, the number 8 is considered <w>powerful</w> because it is divisible by 2 cubed.",
                            "target_lang_translations": {
                                "ru": "В теории чисел число 8 считается <w>полнократным</w>, так как оно делится на 2 в кубе.",
                                "zh": "在数论中，8被视为一个<w>强幂数</w>，因为它能被2的三次方整除。"
                            }
                        },
                        {
                            "text": "The student wrote a thesis on the properties and distribution of <w>powerful</w> numbers.",
                            "target_lang_translations": {
                                "ru": "Студент написал диссертацию о свойствах и распределении <w>полнократных</w> чисел.",
                                "zh": "这名学生写了一篇关于<w>强幂数</w>的性质和分布的论文。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "powerful number"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип целого числа, которое делится на квадрат каждого простого делителя этого числа.",
                        "zh": "指一种整数：凡是整除它的素数，它的平方也必定整除这个整数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полнократный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强幂数",
                                "target_lang_sense_clarification": "数论术语，指每个整除它的素数的平方也整除它的整数"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7b1c8e56-413a-3798-8d09-1d455dfdd7b9",
                    "sense_definition": "Very; extremely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>powerful</w> hot in the fields yesterday afternoon.",
                            "target_lang_translations": {
                                "ru": "Вчера днём в полях было <w>ужасно</w> жарко.",
                                "zh": "昨天下午地里<w>特别</w>热。"
                            }
                        },
                        {
                            "text": "I am <w>powerful</w> glad to see you back home safely.",
                            "target_lang_translations": {
                                "ru": "Я <w>страшно</w> рад видеть, что ты благополучно вернулся домой.",
                                "zh": "看到你平安回到家，我<w>特别</w>高兴。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "powerful hungry",
                        "powerful hot"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "chiefly Southern US or colloquial"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень; чрезвычайно (используется для усиления).",
                        "zh": "非常；极其。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "разговорное усиление"
                            },
                            {
                                "target_lang_word": "страшно",
                                "target_lang_sense_clarification": "разговорное усиление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特别",
                                "target_lang_sense_clarification": "口语里表示程度很高，相当于“非常”"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "较通用的程度副词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}