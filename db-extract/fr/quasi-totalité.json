                "senses": [
                    {
                        "sense_id": "f828c8da-7999-38f1-8ba6-31698b15f4fd",
                        "entry_id": "aef102c0-b2e6-3ba4-a509-50af449b8a9a",
                        "glosses": [
                            "Situation où la totalité est quasiment atteinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4084cd8-ff85-44bd-be25-ef1980c19c73",
                                "sense_id": "f828c8da-7999-38f1-8ba6-31698b15f4fd",
                                "text": "La compagnie aérienne avait averti dès samedi que la quasi-totalité de ses vols prévus dans dix aéroports serait annulée."
                            },
                            {
                                "example_id": "71c0add3-dacb-4828-9056-9f32ef30c2d7",
                                "sense_id": "f828c8da-7999-38f1-8ba6-31698b15f4fd",
                                "text": "Deux chantiers ont permis de renouveler la quasi-totalité des traverses de l’évitement du Jardin des Martels ; la présence des deux quais latéraux nécessitant le démontage/remontage complet des deux voies."
                            },
                            {
                                "example_id": "f68f50b4-643f-4849-949a-8aa2235bc36f",
                                "sense_id": "f828c8da-7999-38f1-8ba6-31698b15f4fd",
                                "text": "Précision : dans le port de Saint-Tropez, la quasi-totalité des yachts, qui appartiennent à des milliardaires français, battent, pour raison fiscale, pavillon de complaisance."
                            }
                        ]
                    }
                ],
