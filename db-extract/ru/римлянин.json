                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdbe2ba-157f-4e84-b28c-9050e9d66e42",
                                                "sense_id": "c09ffcc7-97a2-3af6-972c-99db33f5f9c2",
                                                "text": "Frau Römer ist nett."
                                            },
                                            {
                                                "example_id": "d4d72b7d-efee-4f29-9ad5-334891225b38",
                                                "sense_id": "c09ffcc7-97a2-3af6-972c-99db33f5f9c2",
                                                "text": "Wir sind heute Abend bei Römers eingeladen."
                                            },
                                            {
                                                "example_id": "5e84765f-110b-48bc-87d6-aa19e2b2ee97",
                                                "sense_id": "c09ffcc7-97a2-3af6-972c-99db33f5f9c2",
                                                "text": "Kennst du die Römers von nebenan?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
