                                                "sense_id": "de39d0c7-fdb7-39ee-acd5-436c8fd43257",
                                                "text": "It’s jolly hot in here, isn’t it?"
                                            },
                                            {
                                                "example_id": "c430712f-494e-4c99-8892-150e40080c42",
