                ],
                "senses": [
                    {
                        "sense_id": "02f4fe0f-513d-3306-be27-9fd8b90e76d8",
                        "entry_id": "669c2469-ee7b-3ee5-82c3-05e30b72e7e1",
                        "glosses": [
                            "onverbiddelijk, radicaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf8eae3-2bd3-4b8d-91d8-339a56c855e7",
                                "sense_id": "02f4fe0f-513d-3306-be27-9fd8b90e76d8",
                                "text": "Door het complotdenken worden deradicaliseringsexperts door veel moslims gewantrouwd. IS’ers schilderen hen af als verraders of verspreiden het gerucht dat ze voor de Staatsveiligheid werken. Door rigoureus de nadruk op inhoud te leggen, geraken de mannen er meestal door. ‘Al kan dat lang duren.’"
                            },
                            {
                                "example_id": "5827e85c-7f1d-495e-bf8a-e41da79b6216",
                                "sense_id": "02f4fe0f-513d-3306-be27-9fd8b90e76d8",
                                "text": "Hoewel de grote steden, waar veel burgers met een migratieachtergrond wonen, schoorvoetend overstag zijn gegaan, bestaat er in de meeste provincieplaatsen en dorpen helemaal geen behoefte om het uiterlijk van Zwarte Piet rigoureus te veranderen."
                            },
                            {
                                "example_id": "adf88c17-8b3c-4b78-8dbd-458396e792de",
                                "sense_id": "02f4fe0f-513d-3306-be27-9fd8b90e76d8",
                                "text": "De eerste en rigoureuste optie: uitkopen. Hierbij stoppen boeren met hun bedrijf en ontvangen zij daar geld voor. Hiervoor zijn twee regelingen opgezet: een landelijke en een provinciale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b9245d5-bb6a-4852-b8a3-feb77c8f97ca",
                        "source_entry_id": "669c2469-ee7b-3ee5-82c3-05e30b72e7e1",
                        "source_sense_id": "02f4fe0f-513d-3306-be27-9fd8b90e76d8",
                        "source_sense_description": "onverbiddelijk, radicaal",
                        "target_lang_word": "rigoureux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigoureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                                        "entry_id": "1b3f6ab3-58f1-3695-bd2d-b48b314743b9",
                                        "glosses": [
                                            "Qui fait preuve de rigueur, qui est d’une sévérité inflexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058956e6-ecd7-42ca-961c-7a23593063b3",
                                                "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                                                "text": "Un juge, un magistrat rigoureux."
                                            },
                                            {
                                                "example_id": "381af975-6535-4241-8000-bf5a4291f4ab",
                                                "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                                                "text": "C’est un homme rigoureux qui n'excuse rien, ne pardonne rien."
                                            },
                                            {
                                                "example_id": "77035c45-94c9-478a-b693-8680c93434b9",
                                                "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                                                "text": "Vous ne relâchez rien de vos droits, vous êtes trop rigoureux."
                                            },
                                            {
                                                "example_id": "f6ef6bf7-0681-4133-9122-5e9c76fa1007",
                                                "sense_id": "2bb80314-93f3-3659-9d55-6c3854321c02",
                                                "text": "C’est un créancier rigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4958169a-b647-3a69-8318-3ff3093da2ef",
                                        "entry_id": "1b3f6ab3-58f1-3695-bd2d-b48b314743b9",
                                        "glosses": [
                                            "Qui est sévère, dur, difficile à supporter, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b635ef-54ee-4ef9-89cc-688726174a95",
                                                "sense_id": "4958169a-b647-3a69-8318-3ff3093da2ef",
                                                "text": "Il est donc conseillé de pratiquer immédiatement un nettoyage rigoureux de la plaie avec un virucide puissant (eau de Javel diluée au 1/10^(ème) par exemple)."
                                            },
                                            {
                                                "example_id": "32c219ae-13ef-45ed-9487-e50547fe72f5",
                                                "sense_id": "4958169a-b647-3a69-8318-3ff3093da2ef",
                                                "text": "Un arrêt rigoureux. — Une sentence rigoureuse."
                                            },
                                            {
                                                "example_id": "4cc273f0-8695-43bb-af78-ec63d7c85586",
                                                "sense_id": "4958169a-b647-3a69-8318-3ff3093da2ef",
                                                "text": "Faire une rigoureuse pénitence. — Subir un châtiment rigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c519997-9d58-374f-9bf3-bca0b0e55464",
                                        "entry_id": "1b3f6ab3-58f1-3695-bd2d-b48b314743b9",
                                        "glosses": [
                                            "Qui est rude, âpre, dur à supporter, en parlant de la température."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c248de-bc02-4cde-8321-4f3aa01ef432",
                                                "sense_id": "3c519997-9d58-374f-9bf3-bca0b0e55464",
                                                "text": "L'hiver arrivait visiblement, mais il n'était ni prompt, ni rigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6393c622-cf0d-36b5-9ea9-473ce8e05d4f",
                                        "entry_id": "1b3f6ab3-58f1-3695-bd2d-b48b314743b9",
                                        "glosses": [
                                            "Qui est rigide, austère, qui demande ou qui dénote une exactitude inflexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cfbfd2d-06c1-4236-84bc-a62cd27fe7f1",
                                                "sense_id": "6393c622-cf0d-36b5-9ea9-473ce8e05d4f",
                                                "text": "Et celle-ci, soumise, obéissant aux files rigides et aux quinconces rigoureux, nourrit la proportion immuablement consacrée de 4400 ceps à l'hectare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "611c4812-ef9c-3fcd-8ee5-2ce1ff8ee1a0",
                                        "entry_id": "1b3f6ab3-58f1-3695-bd2d-b48b314743b9",
                                        "glosses": [
                                            "Incontestable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb737440-73cb-449c-aa0e-329575f1b4ab",
                                                "sense_id": "611c4812-ef9c-3fcd-8ee5-2ce1ff8ee1a0",
                                                "text": "Preuves rigoureuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b75cf84d-63ed-3f38-bbf0-21083d61f439",
                                        "entry_id": "1b3f6ab3-58f1-3695-bd2d-b48b314743b9",
