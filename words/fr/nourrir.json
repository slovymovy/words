            "senses": [
                {
                    "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                    "sense_definition": "Donner des aliments à une personne ou à un animal pour assurer sa subsistance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, elle se lève tôt pour <w>nourrir</w> son chat avant d'aller au travail."
                        },
                        {
                            "text": "Ce grand champ de blé permet de <w>nourrir</w> toute la population du village pendant l'hiver."
                        }
                    ],
                    "synonyms": [
                        "alimenter",
                        "sustenter"
                    ],
                    "antonyms": [
                        "affamer"
                    ],
                    "common_phrases": [
                        "nourrir au sein",
                        "nourrir au biberon"
                    ]
                },
                {
                    "sense_id": "03752073-4ebe-30ce-a251-688453b76106",
                    "sense_definition": "Fournir les ressources matérielles indispensables pour vivre ; subvenir aux besoins essentiels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "subsistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec son travail d'artisan, il parvient difficilement à <w>nourrir</w> sa famille nombreuse."
                        },
                        {
                            "text": "Il espère trouver un emploi stable qui puisse enfin le <w>nourrir</w> correctement."
                        }
                    ],
                    "synonyms": [
                        "entretenir"
                    ],
                    "common_phrases": [
                        "nourrir sa famille",
                        "nourrir son homme"
                    ]
                },
                {
                    "sense_id": "5f008e9d-8e49-3da2-8043-8d2352b9d073",
                    "sense_definition": "Entretenir durablement dans son esprit un sentiment, une pensée, un espoir ou une intention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son plus jeune âge, elle <w>nourrit</w> l'espoir secret d'entamer une carrière d'actrice."
                        },
                        {
                            "text": "Il ne faut pas <w>nourrir</w> de ressentiment après une dispute aussi banale."
                        }
                    ],
                    "synonyms": [
                        "entretenir",
                        "couver"
                    ],
                    "common_phrases": [
                        "nourrir l'espoir",
