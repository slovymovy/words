                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1748793-6dc1-428d-bf5f-d254c43afe49",
                                                "sense_id": "5db343be-8e43-3710-b639-9bb31440ad7c",
                                                "text": "It is now time for the jury to deliberate the guilt of the defendant."
                                            }
                                        ]
