                                        "entry_id": "464e06eb-c099-3b14-8057-4e2003fbe3c9",
                                        "glosses": [
                                            "Person, die Speisen oder Getränke vor einer anderen probiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71e777b-1ef7-4df9-a0d5-66e35b259b2d",
                                                "sense_id": "97d2f1ab-9120-3edc-99f9-26cd398b2130",
                                                "text": "Ein Vorkoster an einem adeligen Hof probierte vor dem Mahl die Speisen und riskierte dabei Vergiftungen, wurden dafür aber auch ohne andersweitig zu arbeiten verköstigt."
                                            }
                                        ],
