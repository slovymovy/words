                ],
                "senses": [
                    {
                        "sense_id": "0ca30a59-286d-3f86-9fff-b12cb37e55d6",
                        "entry_id": "0a5e259f-27db-3e44-9db0-1679211f7513",
                        "glosses": [
                            "1991 in den Ötztaler Alpen gefundene Gletschermumie, die etwa 5300 Jahre alt ist und somit aus der späten Jungsteinzeit stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc22b22-55a7-496e-8589-a611fa8db5db",
                                "sense_id": "0ca30a59-286d-3f86-9fff-b12cb37e55d6",
                                "text": "„Die Kleidungsstücke aus Leder und Bast, der Köcher und die Pfeile sind die ältesten Funde dieser Art in den Alpen, und damit rund 1000 Jahre älter als Ötzi.“"
                            },
                            {
                                "example_id": "862a655d-2def-4dc7-84fe-2d1d91e3276c",
                                "sense_id": "0ca30a59-286d-3f86-9fff-b12cb37e55d6",
                                "text": "„Schon der Gletschermann Ötzi schmückte sich vor 5.000 Jahren mit rätselhaften Tattoos in Form von Strichen und Kreuzen.“"
                            },
                            {
                                "example_id": "270769bc-dcaf-4cb0-8b66-35c878f08c71",
                                "sense_id": "0ca30a59-286d-3f86-9fff-b12cb37e55d6",
                                "text": "„Immer wieder wurde die Leiche untersucht, doch erst jetzt glauben Forscher anhand der Wunden belegen zu können, wie Ötzi starb: Er wurde gejagt – und schließlich durch einen Pfeil getötet.“"
                            },
                            {
                                "example_id": "bd3f94f0-2c19-4ee6-875f-c2a96d29ad52",
                                "sense_id": "0ca30a59-286d-3f86-9fff-b12cb37e55d6",
                                "text": "„Seine Stimme klingt, als hätte man Ötzi das Sprechen beigebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
