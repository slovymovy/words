                        "tags": [
                            "plural"
                        ],
                        "form": "orpailleurs"
                    },
                    {
                        "form_id": "38b92256-88f2-479d-8fd7-330fb649e9d5",
                        "entry_id": "daa87a65-5a03-3eb2-8a0a-f969860c2157",
                        "tags": [
                            "feminine"
                        ],
                        "form": "orpailleuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a48f56e-35bd-3317-9b0b-b5b6d9c62641",
                        "entry_id": "daa87a65-5a03-3eb2-8a0a-f969860c2157",
                        "glosses": [
                            "Celui qui recueille les paillettes d’or qui se trouvent dans le sable de certaines rivières, au moyen du lavage, et qui exerce le métier minier de la recherche de l’or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "407a65ff-323c-4e33-8b31-03b549348a1e",
                                "sense_id": "1a48f56e-35bd-3317-9b0b-b5b6d9c62641",
                                "text": "Ainsi, en même temps que la relation de dépendance s’imposait s’établissait une relation de confiance entre l’orpailleur et le commerçant."
                            },
                            {
                                "example_id": "802429a1-5c51-492e-8952-6fb1e5a25092",
                                "sense_id": "1a48f56e-35bd-3317-9b0b-b5b6d9c62641",
                                "text": "Les premiers mineurs faisaient le métier d’orpailleurs, tel qu’il est encore pratiqué dans quelques parties des Cévennes, en France."
                            },
                            {
                                "example_id": "f98f7b61-b243-414f-b79e-1974d0d1cb49",
                                "sense_id": "1a48f56e-35bd-3317-9b0b-b5b6d9c62641",
                                "text": "Des milliers d’orpailleurs clandestins pourrissent les eaux de Guyane depuis des décennies en balançant à tout va de charmants produits comme le mercure — idéal pour extraire l’or de son substrat rocheux — dans les rivières."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4137e75b-d0c1-4338-98ad-3d8570c8a307",
                        "source_entry_id": "daa87a65-5a03-3eb2-8a0a-f969860c2157",
                        "source_sense_id": "1a48f56e-35bd-3317-9b0b-b5b6d9c62641",
                        "source_sense_description": "Celui qui recueille les paillettes d’or",
