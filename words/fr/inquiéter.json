{
    "word_family": [
        "inquiet",
        "inquiétant",
        "inquiétude"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4154453c-b737-3587-96fd-ea3709a8700d",
                    "sense_definition": "Éprouver du souci ou de l'anxiété par rapport à une situation ou à une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment_anxiete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'<w>inquiète</w> pas pour moi, le train arrive dans quelques minutes."
                        },
                        {
                            "text": "Elle s'<w>inquiète</w> toujours quand ses enfants rentrent tard de l'école."
                        }
                    ],
                    "synonyms": [
                        "s'en faire"
                    ],
                    "antonyms": [
                        "se rassurer"
                    ],
                    "common_phrases": [
                        "ne t'inquiète pas",
                        "s'inquiéter pour"
                    ]
                },
                {
                    "sense_id": "1a315e5b-43d3-326e-a284-3d2a2b593ada",
                    "sense_definition": "Causer de l'anxiété ou du souci à quelqu'un ; troubler la tranquillité d'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment_anxiete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le silence prolongé de leur fille commence vraiment à les <w>inquiéter</w>."
                        },
                        {
                            "text": "Cette étrange nouvelle <w>inquiète</w> tous les membres de l'équipe médicale."
                        }
                    ],
                    "antonyms": [
                        "rassurer",
                        "apaiser"
                    ]
                },
                {
                    "sense_id": "a3bfb15b-ed6e-34c1-9184-17e2cc7c48c4",
                    "sense_definition": "Harceler ou troubler sans relâche, notamment en parlant de troupes ou d'éléments perturbateurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "troubler_paix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les troupes légères reçurent l'ordre d'<w>inquiéter</w> l'ennemi pendant toute sa retraite."
                        },
                        {
                            "text": "Les moustiques et la chaleur continuent d'<w>inquiéter</w> les soldats dans la forêt."
                        }
                    ],
                    "common_phrases": [
                        "inquiéter l'ennemi"
                    ]
                },
                {
                    "sense_id": "8d2ae514-1fb2-31d1-91bc-852fa6727331",
                    "sense_definition": "Troubler une personne dans sa possession ou dans la jouissance légitime d'un bien ou d'un droit.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "troubler_paix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau propriétaire craignait que d'anciens héritiers ne viennent l'<w>inquiéter</w> dans sa propriété."
                        },
                        {
                            "text": "Aucun créancier ne peut désormais l'<w>inquiéter</w> après la décision définitive du tribunal."
                        }
                    ]
                }
            ]
        }
    ]
}