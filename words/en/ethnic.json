{
    "word_family": [
        "ethnicity",
        "ethnically",
        "ethnocentrism",
        "ethnography",
        "ethnology"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90a0bb46-506d-3c1f-9536-b05cde339ed1",
                    "sense_definition": "Of or relating to a group of people having common racial, ancestral, national, religious, or cultural origins.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is known for its diverse <w>ethnic</w> communities.",
                            "target_lang_translations": {
                                "ru": "Город известен своими разнообразными <w>этническими</w> общинами.",
                                "zh": "这座城市以其多元的<w>民族</w>社区而闻名。"
                            }
                        },
                        {
                            "text": "She is proud of her <w>ethnic</w> background and family traditions.",
                            "target_lang_translations": {
                                "ru": "Она гордится своим <w>этническим</w> происхождением и семейными традициями.",
                                "zh": "她为自己的<w>民族</w>背景和家庭传统感到自豪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ethnic group",
                        "ethnic minority",
                        "ethnic background",
                        "ethnic origin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к группе людей, имеющих общее расовое, национальное, религиозное или культурное происхождение.",
                        "zh": "指属于具有共同种族、祖先、民族、宗教或文化渊源的群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этнический",
                                "target_lang_sense_clarification": "относящийся к этносу"
                            },
                            {
                                "target_lang_word": "национальный",
                                "target_lang_sense_clarification": "относящийся к нации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指与民族相关的"
                            },
                            {
                                "target_lang_word": "种族",
                                "target_lang_sense_clarification": "指与种族相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26055972-aa9a-395a-b925-65f358c5705a",
                    "sense_definition": "Characteristic of a foreign or a minority group's culture, often referring to food, clothing, or customs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cultural_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to try a new <w>ethnic</w> restaurant downtown.",
                            "target_lang_translations": {
                                "ru": "Мы решили попробовать новый ресторан <w>этнической</w> кухни в центре города.",
                                "zh": "我们决定去市中心尝试一家新的<w>异域</w>风味餐厅。"
                            }
                        },
                        {
                            "text": "The shop sells <w>ethnic</w> clothing from various countries.",
                            "target_lang_translations": {
                                "ru": "Магазин продает <w>этническую</w> одежду из разных стран.",
                                "zh": "这家店出售来自不同国家的<w>民族</w>服装。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exotic"
                    ],
                    "common_phrases": [
                        "ethnic food",
                        "ethnic cuisine",
                        "ethnic restaurant",
                        "ethnic wear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный для культуры иностранной группы или меньшинства, часто относится к еде, одежде или обычаям.",
                        "zh": "指具有外国或少数群体文化特征的，常用于描述食物、服装或习俗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этнический",
                                "target_lang_sense_clarification": "в народном стиле, экзотический"
                            },
                            {
                                "target_lang_word": "национальный",
                                "target_lang_sense_clarification": "традиционный для определенного народа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异域",
                                "target_lang_sense_clarification": "指具有外国文化特色的"
                            },
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指具有特定民族风格的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0cfd7ce-216f-39a3-99c9-bd2ae6188bbe",
                    "sense_definition": "Representative of a folk or traditional mode of expression.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cultural_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The festival features <w>ethnic</w> music from around the world.",
                            "target_lang_translations": {
                                "ru": "На фестивале представлена <w>этническая</w> музыка со всего мира.",
                                "zh": "这个节日汇集了来自世界各地的<w>民族</w>音乐。"
                            }
                        },
                        {
                            "text": "Her home is decorated with traditional <w>ethnic</w> art pieces.",
                            "target_lang_translations": {
                                "ru": "Её дом украшен традиционными предметами <w>этнического</w> искусства.",
                                "zh": "她的家装饰着传统的<w>民族</w>艺术品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ethnic music",
                        "ethnic art",
                        "ethnic style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий народный или традиционный способ самовыражения (в искусстве, музыке).",
                        "zh": "代表民间或传统的表达方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этнический",
                                "target_lang_sense_clarification": "фольклорный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指民间传统的"
                            },
                            {
                                "target_lang_word": "民间",
                                "target_lang_sense_clarification": "指民间的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8b0abb1-871f-3e45-8d4c-dcc22fdb3667",
                    "sense_definition": "Heathen; not Jewish, Christian, or Muslim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heathen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient texts describe various <w>ethnic</w> rituals practiced before the conversion.",
                            "target_lang_translations": {
                                "ru": "Древние тексты описывают различные <w>языческие</w> ритуалы, практиковавшиеся до обращения в веру.",
                                "zh": "古代文献描述了在改宗前实行的各种<w>异教</w>仪式。"
                            }
                        },
                        {
                            "text": "Early missionaries sought to change the beliefs of the <w>ethnic</w> populations.",
                            "target_lang_translations": {
                                "ru": "Ранние миссионеры стремились изменить верования <w>языческих</w> народов.",
                                "zh": "早期的传教士试图改变这些<w>异教</w>群体的信仰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pagan",
                        "gentile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Языческий; не иудейский, не христианский и не мусульманский.",
                        "zh": "异教的；非犹太教、基督教或伊斯兰教的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "языческий",
                                "target_lang_sense_clarification": "относящийся к язычеству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异教",
                                "target_lang_sense_clarification": "指非主流宗教的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f29a13a5-f1a0-3ce9-b45f-c8a53f944b2c",
                    "sense_definition": "An ethnic person, especially a foreigner or member of an immigrant community.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The census tracked the movement of <w>ethnics</w> into the city.",
                            "target_lang_translations": {
                                "ru": "Перепись отслеживала перемещение <w>представителей нацменьшинств</w> в город.",
                                "zh": "人口普查追踪了<w>少数民族</w>进入城市的情况。"
                            }
                        },
                        {
                            "text": "In the past, <w>ethnics</w> often lived in specific neighborhoods together.",
                            "target_lang_translations": {
                                "ru": "В прошлом <w>представители нацменьшинств</w> часто жили вместе в определенных районах.",
                                "zh": "过去，<w>少数民族</w>经常聚居在特定的街区。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often considered offensive in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, принадлежащий к этническому меньшинству или группе иммигрантов.",
                        "zh": "属于少数民族或移民群体的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представитель нацменьшинства",
                                "target_lang_sense_clarification": "человек другой национальности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "少数民族",
                                "target_lang_sense_clarification": "指少数民族成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b23c576c-c3cd-3242-b3be-5ac71b1d62c9",
                    "sense_definition": "A heathen or a pagan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heathen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sermon warned the congregation against the ways of the <w>ethnics</w>.",
                            "target_lang_translations": {
                                "ru": "Проповедь предостерегала прихожан от путей <w>язычников</w>.",
                                "zh": "布道告诫会众要警惕<w>异教徒</w>的生活方式。"
                            }
                        },
                        {
                            "text": "He lived among the <w>ethnics</w> for many years before returning home.",
                            "target_lang_translations": {
                                "ru": "Он прожил среди <w>язычников</w> много лет, прежде чем вернуться домой.",
                                "zh": "他在<w>异教徒</w>中生活了多年才回到家乡。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Язычник.",
                        "zh": "异教徒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язычник",
                                "target_lang_sense_clarification": "идолопоклонник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异教徒",
                                "target_lang_sense_clarification": "指信仰异教的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "319cc3ed-695e-3afc-acc6-68429bf95a66",
                    "sense_definition": "The demonym of an Ancient Greek city.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inscription shows the <w>ethnic</w> of the local tribe.",
                            "target_lang_translations": {
                                "ru": "Надпись указывает на <w>этникон</w> местного племени.",
                                "zh": "铭文显示了当地部落的<w>族名</w>。"
                            }
                        },
                        {
                            "text": "Numismatists identify the origin of the coin by its <w>ethnic</w>.",
                            "target_lang_translations": {
                                "ru": "Нумизматы определяют происхождение монеты по её <w>этникону</w>.",
                                "zh": "钱币学家通过硬币上的<w>族名</w>来确定其产地。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название жителей определенной местности (в древнегреческом контексте).",
                        "zh": "古希腊城市居民的称谓。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этникон",
                                "target_lang_sense_clarification": "название жителей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "族名",
                                "target_lang_sense_clarification": "指特定地区的居民称谓"
                            }
                        ]
                    }
                }
            ]
        }
    ]
