                                "target_senses": [
                                    {
                                        "sense_id": "99be65c3-2ac8-3e52-b0c5-972fc9d8d937",
                                        "entry_id": "6f6dfd3c-3ee5-347c-9b9a-c4e0f8a22512",
                                        "glosses": [
                                            "Quant des Lichts; masseloses Teilchen, das die elektromagnetische Wechselwirkung vermittelt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299c0fc1-69e3-4f24-a040-ed3396b805b9",
                                                "sense_id": "99be65c3-2ac8-3e52-b0c5-972fc9d8d937",
                                                "text": "Photonen können nur als Ganzes erzeugt oder vernichtet werden."
                                            },
                                            {
                                                "example_id": "ab59a6ee-8f8b-49e6-a154-e07e5f3f45f8",
                                                "sense_id": "99be65c3-2ac8-3e52-b0c5-972fc9d8d937",
                                                "text": "Photonen sind insofern ganz, als dass ihre Erzeugung immer eine Wirkungsänderung von h verlangt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5031c263-31c2-47b5-93dd-3b719a5e8d5b",
