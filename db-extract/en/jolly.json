                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "291d2f9d-c2e3-4eec-aed2-b7eb1e02fdd5",
                                "sense_id": "6548ad71-972a-376e-a619-127a15d2d114",
                                "text": "I do not believe in 'jollying' and 'soft soaping' a man when his work is really bad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7304317f-bc9f-4ee1-a0c5-68394c80338b",
                        "source_entry_id": "a14582c3-fd80-3b2e-b24f-e2d59d2c2f05",
                        "source_sense_description": "To amuse or divert",
                        "target_lang_word": "škádlit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "škádlit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "48ab9ddb-f905-31dd-b8fa-f50a7e026f32",
                                        "entry_id": "a4ff4fa5-9fa4-344e-b592-7d98e3cfb677",
                                        "glosses": [
                                            "verbálně někoho dráždit přátelským způsobem ( - a nikoliv eroticky)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951fbe67-c02a-443d-a039-3de1b160c861",
                                                "sense_id": "48ab9ddb-f905-31dd-b8fa-f50a7e026f32",
                                                "text": "Pane Giovanni, Vy mě ale jen tak škádlíte, že? Ve skutečnosti to nemyslíte vážně..."
                                            },
                                            {
                                                "example_id": "ce4d614b-ea5d-4974-8931-4b7351bf9783",
                                                "sense_id": "48ab9ddb-f905-31dd-b8fa-f50a7e026f32",
                                                "text": "Co se škádlívá, rádo se mívá."
                                            },
                                            {
                                                "example_id": "5405de80-6021-4f9c-b409-245d21ec9d95",
                                                "sense_id": "48ab9ddb-f905-31dd-b8fa-f50a7e026f32",
                                                "text": "Kristinka ale stála u okna a pranic se za slze nestyděla, až pan otec k ní přistoupna, pikslou na rameno jí klepl, šeptaje: „Viď, to ty si myslíš, až mně budou tak přát!“ — „Vy, pane otče, vždycky musíte člověka škádlit,“ povídalo děvče a oči utřelo."
                                            },
                                            {
                                                "example_id": "2a75c376-d3c3-4143-9edb-b75560b24941",
                                                "sense_id": "48ab9ddb-f905-31dd-b8fa-f50a7e026f32",
                                                "text": "Když tu pracoval den co den, počaly jej jeptišky škádlit a vyvádět mu všeliké kousky, jak to mnozí činívají němým, a říkaly mu nejdarebnější průpovídky, domnívajíce se, že jim nerozumí."
                                            },
                                            {
                                                "example_id": "e7ac4f84-ac66-4a5f-ade9-3ffbd5deedc2",
                                                "sense_id": "48ab9ddb-f905-31dd-b8fa-f50a7e026f32",
                                                "text": "„Emilko, moje zlatá duše!“ promluvil tonem prosebným, a znovu se vedle dívky posadiv, důvěrně se k ní naklonil. „Neškádli mne! Nedělej se jinak, než jak si tě přeji, abys byla, a jak vskutku býti můžeš, kdybys chtěla tu kůru setřásti, kterouž obyčejné vychování okolo srdce tvého položilo.“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
