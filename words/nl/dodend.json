                },
                {
                    "sense_id": "79e5a3a6-ac06-31c3-b9d2-4931ef6a80a6",
                    "sense_definition": "In staat om iets figuurlijk kapot te maken, te vernietigen of te dempen (zoals sfeer, hoop of een blik).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vernietigend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij die opmerking maakte, kreeg hij een <w>dodende</w> blik van zijn manager.",
                            "target_lang_translations": {
                                "en": "When he made that comment, he received a <w>withering</w> look from his manager."
                            }
                        },
                        {
                            "text": "De strenge regels hadden een <w>dodend</w> effect op de creativiteit van de studenten.",
                            "target_lang_translations": {
                                "en": "The strict rules had a <w>stifling</w> effect on the students' creativity."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een dodende blik",
                        "dodend effect"
                    ],
                    "target_lang_definitions": {
                        "en": "Capable of figuratively destroying, ruining, or dampening something (such as atmosphere, hope, or a look)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "killing",
                                "target_lang_sense_clarification": "figuratively destroying or dampening"
                            },
                            {
                                "target_lang_word": "withering",
                                "target_lang_sense_clarification": "of a look, devastating or humiliating"
                            },
                            {
                                "target_lang_word": "stifling",
                                "target_lang_sense_clarification": "suppressing or suffocating"
                            },
                            {
                                "target_lang_word": "deadly",
                                "target_lang_sense_clarification": "extremely boring or destructive to atmosphere"
                            }
                        ]
                    }
                }
            ]
        },
        {
