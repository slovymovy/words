                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c9f6d9-bb63-4f43-9e68-ea2631491910",
                                "sense_id": "c09dbc0c-db7e-3ce9-93ac-2d5b7da38246",
                                "text": "Le transfert de chaleur à l’intérieur des tubes d’un four pétrolier, pétrochimique ou carbochimique se fait en écoulement monophasique ou biphasique avec des produits liquides ou gazeux, purs ou complexes."
                            },
                            {
                                "example_id": "acad36da-be8a-4162-afa1-24059f65b17e",
                                "sense_id": "c09dbc0c-db7e-3ce9-93ac-2d5b7da38246",
                                "text": "La Cokerie de Carling a fait partie d’une plate-forme d’activité industrielle créée par les Houillères et qui comprenait, outre la production de coke, une Centrale thermique et une usine carbochimique."
                            }
                        ]
