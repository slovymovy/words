                "senses": [
                    {
                        "sense_id": "631dae49-4276-3af5-a634-5fda0659f1d6",
                        "entry_id": "ef7861cd-593a-37b7-88c6-1b6a20248fd0",
                        "glosses": [
                            "de mate waarin iets of iemand prettig, grappig, of aangenaam is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef33d6f6-3699-4732-91db-a0683358ee62",
                                "sense_id": "631dae49-4276-3af5-a634-5fda0659f1d6",
                                "text": "Echt, kinderverjaardagen bezoeken staat op mijn lijstje ‘dingen die je kunt doen in het leven, gerangschikt naar leukheid’ net boven ‘mijn haar knippen met de staafmixer terwijl ik luister naar Trijntje Oosterhuis die het hele repertoire van Gordon zingt’, maar nog onder ‘de bijkeuken dweilen als de kat gekotst heeft’."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea3f33d6-22e0-34c9-ad0d-eeadfd5eda7b",
                        "entry_id": "ef7861cd-593a-37b7-88c6-1b6a20248fd0",
                        "glosses": [
                            "iets dat prettig, grappig of aangenaam is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0d760d-44a2-41d9-aa85-60b728733698",
                                "sense_id": "ea3f33d6-22e0-34c9-ad0d-eeadfd5eda7b",
                                "text": "Het quizonderdeel wil ze graag uitbreiden. ,,Volgend seizoen wil ik daar een iets meer uitgeklede versie van, waarin de mensen meer aan bod komen, dat er meer ontstaat. De gasten die ik had waren zo leuk, dat is zonde van mensen hun leukheid\", aldus Wallis de Vries."
                            }
                        ]
                    }
                ],
