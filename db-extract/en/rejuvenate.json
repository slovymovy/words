                ],
                "senses": [
                    {
                        "sense_id": "a345a3ab-b237-38a2-b29c-412554fb90c4",
                        "entry_id": "1cced994-b2d8-3e4e-b955-ac7fcac5440a",
                        "glosses": [
                            "To render young again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e592a52-1145-4135-9431-b45c08f7a2e6",
                                "sense_id": "a345a3ab-b237-38a2-b29c-412554fb90c4",
                                "text": "Before coronavirus shuttered the world, a typical month for Connecticut native Zac Mathias was packed with appointments for microneedling (a collagen-stimulating process that involves repeated pin-pricks all over the face), regular resurfacing hydrafacials, rejuvenating laser treatments and the occasional red-light therapy session."
                            }
                        ]
                    },
                    {
                        "sense_id": "87ccb028-b937-37d5-9c35-ed1bb9b3c2e8",
                        "entry_id": "1cced994-b2d8-3e4e-b955-ac7fcac5440a",
                        "glosses": [
                            "To give new energy or vigour to; to revitalise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5a9d84-775b-46f7-af36-7e8d90412536",
                                "sense_id": "87ccb028-b937-37d5-9c35-ed1bb9b3c2e8",
                                "text": "The exercise involved in recrafting the past, past encounters and memories actually rejuvenates short-term and present memory — remarkably!"
                            },
                            {
                                "example_id": "4d49c3c1-9dce-4696-b617-208fc898ec60",
                                "sense_id": "87ccb028-b937-37d5-9c35-ed1bb9b3c2e8",
                                "text": "\"We have completely rejuvenated the project. Everyone is galvanised. We will get it open - and open means open. [...].\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6801b117-7e6c-435a-ab21-67f806ea6aac",
