                "senses": [
                    {
                        "sense_id": "4ad01f4f-a9dd-3584-8d08-61236800a866",
                        "entry_id": "5484332d-eeba-31ca-9326-846437f8da50",
                        "glosses": [
                            "schweres Leiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d017af0d-fcd7-41ca-a32d-8cb351c75934",
                                "sense_id": "4ad01f4f-a9dd-3584-8d08-61236800a866",
                                "text": "Der Rückweg aus der Wüste war ein einziges Martyrium."
                            },
                            {
                                "example_id": "533dab93-126e-4425-ac4e-3c61ba6dc6b5",
                                "sense_id": "4ad01f4f-a9dd-3584-8d08-61236800a866",
                                "text": "Ihre Ehe entpuppte sich bereits nach kurzer Zeit als wahres Martyrium."
                            },
                            {
                                "example_id": "3538d3e0-70f3-412d-936f-fc03f90297fb",
                                "sense_id": "4ad01f4f-a9dd-3584-8d08-61236800a866",
                                "text": "„Erst nach einem Selbstmordversuch und durch die Initiative einer russischen Ärztin fand das Martyrium ein Ende.“"
                            },
                            {
                                "example_id": "90304277-360d-443e-b978-eed01ba66f1d",
                                "sense_id": "4ad01f4f-a9dd-3584-8d08-61236800a866",
                                "text": "Kurz nach der Krebsdiagnose begann sein Martyrium, das er tapfer ertrug."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32a51bc8-eea3-345b-900a-c289899b9855",
                        "entry_id": "5484332d-eeba-31ca-9326-846437f8da50",
                        "glosses": [
                            "Opfertod"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74588a67-9a20-4ab3-bb25-ff7a253fffe3",
                                "sense_id": "32a51bc8-eea3-345b-900a-c289899b9855",
                                "text": "Das Buch beschreibt die Martyrien der ersten Christen in der Arena des Circus Maximus."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ba04db9-8a95-426f-8055-2fffbdd034b8",
                        "source_entry_id": "5484332d-eeba-31ca-9326-846437f8da50",
                        "source_sense_id": "4ad01f4f-a9dd-3584-8d08-61236800a866",
                        "source_sense_description": "schweres Leiden",
                        "target_lang_word": "martyre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "martyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Mort ou tourments endurés pour sa religion, sa foi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b29f1e-d9bb-4285-a282-f5edb7741496",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "L’ambition de gagner le martyre avait engagé le prêtre à se mettre de notre voyage."
                                            },
                                            {
                                                "example_id": "d8920a3b-5701-4e49-80d3-1bbc42eeb1da",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Il faut songer qu’à cette époque il y avait en Afrique un assez grand nombre de montanistes qui exaltaient beaucoup la gloire du martyre et n’admettaient point que l’on eût le droit de fuir la persécution."
                                            },
                                            {
                                                "example_id": "ad28fb27-a5bc-4db3-87d8-565b0fc9d9bf",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Si les misérables croient en la patrie, c’est parce qu’ils sont la dupe des mots, comme l’étaient les premiers chrétiens qui subissaient le martyre pour un Dieu qui n’existe pas."
                                            },
                                            {
                                                "example_id": "c2d01dba-2445-4422-b147-fd4ef1900066",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Quand Rabénou Tam fut informé du martyre des juifs de Blois, il ordonna un jeûne, qui fut longtemps observé au jour anniversaire (le 20 Siwan)."
                                            },
                                            {
                                                "example_id": "1aff0ba1-1b3e-4cec-92c1-e36610e4c70e",
                                                "sense_id": "6df9bbfe-5242-3298-9558-1a5a80d8cb0a",
                                                "text": "Dans la logique du martyre, la douleur apporte le salut : elle est souhaitée, désirée, voulue, aimée, chérie, car elle conduit directement à la rédemption."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10fae80-99c0-37a7-900e-48168f4be6d5",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Tortures endurées par les victimes de tortionnaires."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50d64203-4946-40fc-83d0-6e1012bbc68d",
                                                "sense_id": "c10fae80-99c0-37a7-900e-48168f4be6d5",
                                                "text": "Chacun ici connaît le martyre d’Annick Castel, violée par un parachutiste et qui, croyant être enceinte, ne songeait plus qu’à mourir."
                                            },
                                            {
                                                "example_id": "e3205318-e279-44a6-826b-dd4fcdfaa584",
                                                "sense_id": "c10fae80-99c0-37a7-900e-48168f4be6d5",
                                                "text": "Le procès de la belle-mère accusée du meurtre de la fillette martyre de Granby n'aura pas lieu avant septembre 2021, au palais de justice de Trois-Rivières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Toute sorte de peines ou de douleurs de corps et d’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da612cd8-7896-41e7-b98a-576f3d576d1e",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "C’est honteux à dire, cependant nous ne faisons pas ici de l’immoralité à plaisir, nous racontons un fait vrai, que nous ferions peut-être mieux de taire, si nous ne croyions qu’il faut de temps en temps révéler les martyres de ces êtres, que l’on condamne sans les entendre, que l’on méprise sans les juger; […]."
                                            },
                                            {
                                                "example_id": "c428d26d-f5ab-4c41-9a1f-016bb869ee1d",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "Oscar Wilde n’inspire plus de colère, même aux sectaires de la vertu. Tous n’ont plus, pour lui et pour son martyre, que de la pitié douloureuse."
                                            },
                                            {
                                                "example_id": "1cba1499-1a2a-4744-aee3-fe4f9660a94e",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "Oscar Wilde, le grand écrivain anglais échoué à Paris après le martyre que la dureté puritaine lui eût fait subir, désira rencontrer Esterhazy."
                                            },
                                            {
                                                "example_id": "3327c6b2-5809-4451-b692-8122bb3259f1",
                                                "sense_id": "63130984-82be-3a6c-a329-cfb2e3db69f5",
                                                "text": "Mon Dieu, en quel martyre vous m’avez condamnée à vivre, enveloppée de duplicités, environnée d’embûches, cernée de chausses-trapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6027c555-72c3-306e-a62a-84cd4ef235bd",
                                        "entry_id": "6dee1d9b-0a25-3284-9093-ad96653a2359",
                                        "glosses": [
                                            "Peine d’amour."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745aeaba-a19e-418f-b08a-348a09bb18f6",
                                                "sense_id": "6027c555-72c3-306e-a62a-84cd4ef235bd",
                                                "text": "La beauté qui cause mon martyre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "martyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a40e6e99-e3e8-315c-bee0-6ab20ba2ef27",
                                        "entry_id": "831ebcc0-013a-339e-acf6-bcf8f79d0593",
                                        "glosses": [
                                            "Femme martyr."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d41b7111-025e-4e0b-a0b8-8652d7e1f2c6",
                                                "sense_id": "a40e6e99-e3e8-315c-bee0-6ab20ba2ef27",
                                                "text": "Et si jamais tu oses,\nC’est avec joie que je serai une martyre de la cause. (Oh oh oh oh oh oh)\nAvec plaisir je serai une martyre de la cause. (Oh oh oh oh oh oh)\nAvec honneur je serai une martyre de la cause. (Oh oh oh oh oh oh)\nAvec fierté je serai une martyre de la cause."
                                            }
                                        ]
                                    }
                                ]
                            },
