                            {
                                "example_id": "25b45603-86f5-4c4c-b0f1-80047e73748c",
                                "sense_id": "1fcf37af-7820-3f0e-8a82-01652d6f9b66",
                                "text": "„Gut sechs Millionen Menschen pro Jahr müssen in der Europäischen Union laut einem Bericht wegen einer Sportverletzung in Kliniken behandelt werden.“"
                            },
                            {
                                "example_id": "8f477f7c-30dc-4a09-995a-86698d1bfe7b",
                                "sense_id": "1fcf37af-7820-3f0e-8a82-01652d6f9b66",
                                "text": "„Das 1903 gegründete Sanatorium liegt auf einer Halbinsel am Stadtrand von Lychen und ist seit 1933 auf die Heilung von Sportverletzungen und Gelenkerkrankungen spezialisiert.“"
                            }
                        ],
