                "senses": [
                    {
                        "sense_id": "f7df2738-5854-3e2f-88c3-0a5f082a3c51",
                        "entry_id": "bbd5da0e-f6ea-33c5-882e-fb4289dd01b6",
                        "glosses": [
                            "Assainir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7d608a1-3b81-4a18-9022-934ae2f04682",
                                "sense_id": "f7df2738-5854-3e2f-88c3-0a5f082a3c51",
                                "text": "Il faut aussi laver les murs, les planchers, ment celles de ces mesures à l'exécution desquelles il faut réassainir entièrement les lieux ;"
                            },
                            {
                                "example_id": "b7351e4e-de4a-4b63-9bb7-f362fb1fe926",
                                "sense_id": "f7df2738-5854-3e2f-88c3-0a5f082a3c51",
                                "text": "Il préférerait, avant d'accueillir leurs propositions, réassainir suffisamment certaines de nos positions économiques, par exemple réduire le déficit de la balance commerciale."
                            }
                        ]
                    }
