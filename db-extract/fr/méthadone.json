                                "target_senses": [
                                    {
                                        "sense_id": "e034e6f0-ccb1-36ef-89de-b6432849aa69",
                                        "entry_id": "3b5a620d-5d7f-3006-b713-6e6b3f5b3ded",
                                        "glosses": [
                                            "Opioid mit schmerzstillender Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce1abeb-774b-4a67-8f8a-71cbff2d4366",
                                                "sense_id": "e034e6f0-ccb1-36ef-89de-b6432849aa69",
                                                "text": "„Alle diese Leute, der Töpfer auf Methadon, der Glasbläser auf Percodan, der Silberschmied auf Vicodin – sie alle haben ihre Nische gefunden.“"
                                            },
                                            {
                                                "example_id": "7a622de1-a61a-413a-b5ce-44531e00a5f0",
                                                "sense_id": "e034e6f0-ccb1-36ef-89de-b6432849aa69",
                                                "text": "„Offenbar schämt er sich für seine Privilegien genug, um sich wie einer zu verkleiden, der dienstags um halb eins in einer Apotheke in der Shields Road - der abgewracktesten Hauptstraße Englands - Methadon abgreift, aber nicht so sehr, dass er vor Kollegen nicht mit der Schwanzgröße seines Onkels angeben würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f22b4148-f2e4-48eb-b647-4faa1e7a62a5",
                        "source_entry_id": "8b93de41-70f0-3003-880c-384e1c63f6f6",
                        "source_sense_id": "969d9fb3-2f60-333b-a75a-d0c390650c67",
                        "target_lang_word": "methadone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "methadone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "828bb34c-2f64-3ea6-b444-137cb6fb00a9",
                                        "entry_id": "b1e29341-90b3-3cf3-9634-99075b9318fd",
                                        "glosses": [
                                            "A powerful synthetic analgesic drug which is similar to morphine in its effects but less sedative and is used as a substitute drug in the treatment of morphine and heroin addiction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96fba593-f0d3-4b47-95ce-a79ed9e46dbd",
                                                "sense_id": "828bb34c-2f64-3ea6-b444-137cb6fb00a9",
                                                "text": "But methadone is a dangerous drug. If taken orally by a nonaddict, it can cause euphoria or even death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
