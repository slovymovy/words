{
    "word_family": [
        "dyniowaty",
        "dyniowy",
        "dyńka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2075e8a1-6e3d-3de5-bb07-c22d2904be31",
                    "sense_definition": "duży, jadalny owoc rośliny z rodziny dyniowatych, zwykle o pomarańczowej lub żółtej skórce",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wydrążyliśmy <w>dynię</w> i włożyliśmy w środek świeczkę na święto.",
                            "target_lang_translations": {
                                "ru": "Мы выскоблили <w>тыкву</w> и поставили внутрь свечку к празднику."
                            }
                        },
                        {
                            "text": "Jesienią często gotujemy pyszną zupę z dojrzałej <w>dyni</w>.",
                            "target_lang_translations": {
                                "ru": "Осенью мы часто варим вкусный суп из спелой <w>тыквы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bania"
                    ],
                    "common_phrases": [
                        "pestki dyni",
                        "zupa z dyni"
                    ],
                    "target_lang_definitions": {
                        "ru": "крупный съедобный плод растения семейства тыквенных, обычно с оранжевой или жёлтой кожурой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыква",
                                "target_lang_sense_clarification": "плод растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f138912-ddad-3bb7-864e-08f2f9439cf3",
                    "sense_definition": "roślina płożąca lub pnąca z rodziny dyniowatych, uprawiana jako warzywo",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym roku w naszym ogrodzie zasadzimy trochę <w>dyni</w>.",
                            "target_lang_translations": {
                                "ru": "В этом году мы посадим в нашем огороде немного <w>тыквы</w>."
                            }
                        },
                        {
                            "text": "Liście i pędy <w>dyni</w> szybko rozrosły się na całą grządkę.",
                            "target_lang_translations": {
                                "ru": "Листья и побеги <w>тыквы</w> быстро разрослись на всю грядку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uprawa dyni"
                    ],
                    "target_lang_definitions": {
                        "ru": "стелющееся или вьющееся растение семейства тыквенных, выращиваемое как овощная культура"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыква",
                                "target_lang_sense_clarification": "само растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3114423-bc3d-3148-87d8-ea1255d6b107",
                    "sense_definition": "głowa człowieka",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piłkarz uderzył piłkę prosto z <w>dyni</w> i strzelił gola.",
                            "target_lang_translations": {
                                "ru": "Футболист пробил прямо с <w>головы</w> и забил гол."
                            }
                        },
                        {
                            "text": "Od tego hałasu w biurze zaraz pęknie mi cała <w>dynia</w>.",
                            "target_lang_translations": {
                                "ru": "От этого шума в офисе у меня сейчас лопнет <w>башка</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "baśka",
                        "czapa",
                        "dyńka",
                        "głowa",
                        "łeb",
                        "łepetyna",
                        "makówka"
                    ],
                    "common_phrases": [
                        "uderzyć z dyni",
                        "strzelić z dyni"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "potoczne, slangowe określenie głowy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "голова человека (в разговорной или сленговой речи)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыква",
                                "target_lang_sense_clarification": "голова (разг.)"
                            },
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "голова (разг.)"
                            },
                            {
                                "target_lang_word": "кочан",
                                "target_lang_sense_clarification": "голова (сленг)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eba221d-e5db-33ea-b61e-1b3fc6fdb074",
                    "sense_definition": "ocena niedostateczna w szkole",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeszcze jedna <w>dynia</w> ze sprawdzianu i będę miał poważne kłopoty.",
                            "target_lang_translations": {
                                "ru": "Ещё один <w>кол</w> за контрольную, и у меня будут серьёзные неприятности."
                            }
                        },
                        {
                            "text": "Dostał wczoraj kolejną <w>dynię</w> z matematyki za brak zadania domowego.",
                            "target_lang_translations": {
                                "ru": "Он вчера получил очередную <w>двойку</w> по математике за несделанное домашнее задание."
                            }
                        }
                    ],
                    "synonyms": [
                        "bomba",
                        "jedynka",
                        "lacha",
                        "lufa",
                        "pała"
                    ],
                    "common_phrases": [
                        "dostać dynię"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slang uczniowski"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "неудовлетворительная оценка в школе; единица или двойка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кол",
                                "target_lang_sense_clarification": "школьная единица (жарг.)"
                            },
                            {
                                "target_lang_word": "двойка",
                                "target_lang_sense_clarification": "неудовлетворительная оценка"
                            },
                            {
                                "target_lang_word": "пара",
                                "target_lang_sense_clarification": "неудовлетворительная оценка (жарг.)"
                            },
                            {
                                "target_lang_word": "банан",
                                "target_lang_sense_clarification": "школьная двойка (жарг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cf91a21-617a-39ca-8d26-1798ff41f353",
                    "sense_definition": "człowiek otyły, o zaokrąglonej sylwetce",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten chłopak to prawdziwa <w>dynia</w>, powinien zacząć więcej biegać.",
                            "target_lang_translations": {
                                "ru": "Этот парень настоящий <w>толстяк</w>, ему стоит больше бегать."
                            }
                        },
                        {
                            "text": "Dzieci na podwórku złośliwie wołały na niego gruba <w>dynia</w>.",
                            "target_lang_translations": {
                                "ru": "Дети во дворе злобно дразнили его толстым <w>колобком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grubas"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne, obraźliwe określenie osoby otyłej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тучный, полный человек с округлой фигурой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толстяк",
                                "target_lang_sense_clarification": "полный человек"
                            },
                            {
                                "target_lang_word": "колобок",
                                "target_lang_sense_clarification": "о круглом, тучном человеке"
                            },
                            {
                                "target_lang_word": "пузан",
                                "target_lang_sense_clarification": "очень полный человек (разг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4757a03c-8d2e-3dea-9cc0-2ed2ef196d12",
                    "sense_definition": "dłoń zaciśnięta w pięść",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zacisnął mocno swoją <w>dynię</w> i groźnie spojrzał na przeciwnika.",
                            "target_lang_translations": {
                                "ru": "Он крепко сжал свой <w>кулак</w> и грозно посмотрел на противника."
                            }
                        },
                        {
                            "text": "Dostał cios ciężką <w>dynią</w> prosto w szczękę podczas awantury.",
                            "target_lang_translations": {
                                "ru": "Во время потасовки он получил тяжёлым <w>кулаком</w> прямо в челюсть."
                            }
                        }
                    ],
                    "synonyms": [
                        "pięść"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slangowe określenie pięści"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "кисть руки, сжатая в кулак"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулак",
                                "target_lang_sense_clarification": "сжатая кисть руки"
                            },
                            {
                                "target_lang_word": "кулачина",
                                "target_lang_sense_clarification": "большой, увесистый кулак"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "393f9994-8b2d-364d-bb8d-7f715632a6cc",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan Adam <w>Dynia</w> odebrał wczoraj nagrodę za wybitne osiągnięcia w pracy.",
                            "target_lang_translations": {
                                "ru": "Господин Адам <w>Дыня</w> получил вчера награду за выдающиеся достижения в работе."
                            }
                        },
                        {
                            "text": "Często rozmawiam z panem <w>Dynią</w> na temat naszych wspólnych projektów naukowych.",
                            "target_lang_translations": {
                                "ru": "Я часто беседую с господином <w>Дыней</w> о наших совместных научных проектах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дыня",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93945651-4b54-3cf0-8f04-abbba17f8bca",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani Anna <w>Dynia</w> prowadzi od lat bardzo popularną kancelarię adwokacką.",
                            "target_lang_translations": {
                                "ru": "Госпожа Анна <w>Дыня</w> уже много лет руководит очень популярной адвокатской конторой."
                            }
                        },
                        {
                            "text": "Rozmawiałem wczoraj z panią <w>Dynią</w> o nowych warunkach umowy najmu lokalu.",
                            "target_lang_translations": {
                                "ru": "Вчера я говорил с госпожой <w>Дыней</w> о новых условиях договора аренды помещения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дыня",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
