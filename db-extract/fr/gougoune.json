        "de-extract.jsonl": [
            {
                "entry_id": "3645ace4-8271-38d7-8af2-b6c7d63de83e",
                "word": "gougoune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac1c8bf1-a392-3968-8e90-dfc9c6fc436e",
                        "entry_id": "3645ace4-8271-38d7-8af2-b6c7d63de83e",
                        "glosses": [
                            "besonders leichte Sandale, die außer einer Sohle nur noch einen Zehensteg mit V-förmigen Riemen hat"
                        ],
                        "tags": [
                            "Canada",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b4f4e672-4bfe-4d93-a260-78c4b1b06364",
                                "sense_id": "ac1c8bf1-a392-3968-8e90-dfc9c6fc436e",
                                "text": "«- Qu’est-ce que tu cherches? m’a-t-il demandé. On n’a besoin de rien.",
                                "translation": "„‚Was suchst du?‘, fragte er mich. ‚Wir brauchen nichts.‘ ‚Ich will Badelatschen. Ich weiß nicht, ob du es weißt, aber in der Herberge gibt es nur Gemeinschaftsduschen.‘“"
                            },
                            {
                                "example_id": "a38c3f89-a557-4c7d-a6fa-474cf21090e9",
                                "sense_id": "ac1c8bf1-a392-3968-8e90-dfc9c6fc436e",
                                "text": "«À la fois, simple et attrayante, la sandale à orteils communément appelé ‹ gougoune › ou ‹ flip flop › est très présente.»",
                                "translation": "„Schlicht und anziehend zugleich liegt die gemeinhin ‚Flipflop‘ genannte Zehensandale ganz im Trend.“"
                            },
                            {
                                "example_id": "9dd0625a-b91f-4a74-b076-54b876c91140",
                                "sense_id": "ac1c8bf1-a392-3968-8e90-dfc9c6fc436e",
                                "text": "«Devant l’armada de touristes européens en gougounes et les hôtels bétonnés, nous choisissons de foncer vers l’arrière-pays.»",
                                "translation": "„Bevor [wir uns] das Heer europäischer Touristen in Flipflops und die Betonhotels [antun], entscheiden wir uns, uns ins Hinterland zu stürzen.“"
                            },
                            {
                                "example_id": "2f2e920d-d960-4f75-ac7d-86ce304294e9",
                                "sense_id": "ac1c8bf1-a392-3968-8e90-dfc9c6fc436e",
                                "text": "«À moins que ce ne soit le froid polaire qui ait gelé ces touristes venus de la Floride en bermudas et chemises à fleurs, gougounes aux pieds.»",
                                "translation": "„Sofern es nicht die Eiseskälte war, die diese Touristen aus Florida in Bermudashorts, Hawaiihemden und Flipflops an den Füßen hat frieren lassen.“"
                            },
                            {
                                "example_id": "2f5969f6-e83f-41a8-b1b1-f70c5378f627",
                                "sense_id": "ac1c8bf1-a392-3968-8e90-dfc9c6fc436e",
                                "text": "«— Va te changer dans les toilettes. Tiens, je t’ai acheté des gougounes aussi, excuse mais y en avait plus que des roses. […] »",
                                "translation": "„Geh dich auf der Toilette umziehen. Da, ich hab dir auch Flipflops gekauft, ’tschuldige, aber es gab nur noch rosafarbene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d71b09ae-fe67-4d14-b040-e3e16f9156a3",
