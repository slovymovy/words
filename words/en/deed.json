        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbba591b-5fed-3801-a5a7-6505dd1cdfb3",
                    "sense_definition": "To transfer the ownership of property or rights to someone by means of a legal deed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather <w>deeded</w> the farm to my father before he died.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка <w>передал</w> ферму отцу <w>по акту</w> перед смертью.",
                                "nl": "Mijn grootvader heeft de boerderij voor zijn overlijden per <w>akte</w> aan mijn vader overgedragen."
                            }
                        },
                        {
                            "text": "The wealthy philanthropist <w>deeded</w> the land to the city for a park.",
                            "target_lang_translations": {
                                "ru": "Богатый филантроп <w>передал</w> землю городу под парк.",
                                "nl": "De rijke filantroop heeft de grond per <w>akte</w> aan de stad overgedragen voor een park."
                            }
