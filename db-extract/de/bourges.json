                        "cross_references": [
                            {
                                "target_word": "Bourges",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f7741a-a90e-3e50-aecc-ebcaedf455c6",
                                        "entry_id": "c315a4ba-a65a-3da7-812b-2f9ba0cbfb55",
                                        "glosses": [
                                            "Commune et chef-lieu de département français, située dans le département du Cher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b47018-019b-47b3-8f02-5a33831651be",
                                                "sense_id": "f6f7741a-a90e-3e50-aecc-ebcaedf455c6",
                                                "text": "Bourges […] a ses magnifiques monuments, son austère physionomie historique, ses jardins déserts, ses beaux clairs de lune sur les pignons aigus de ses maisons du moyen âge, ses grandes rues où l’herbe ronge le pavé, et ses longues nuits silencieuses qui commencent presque au coucher du soleil. C’est bien l’antique métropole des Aquitaines, une ville de chanoines et de magistrats, la plus oubliée, la plus aristocratique des cités mortes de leur belle mort."
                                            },
                                            {
                                                "example_id": "0a203f0c-4dae-40d4-b4f7-f4afa30a845f",
                                                "sense_id": "f6f7741a-a90e-3e50-aecc-ebcaedf455c6",
                                                "text": "2 août 42 – Nous sommes installés au cœur de la France. C’est une impression artificielle sans doute, mais l’idée que Bourges est le centre géométrique de la France et que le Berry est également loin de tout mer, me fait trouver sa campagne plus campagne."
                                            },
                                            {
                                                "example_id": "c4b5656f-1229-4e58-976f-09b1bfa8d8c7",
                                                "sense_id": "f6f7741a-a90e-3e50-aecc-ebcaedf455c6",
                                                "text": "Jacques Cœur et Jean-Christophe Rufin sont tous deux berruyers. Le premier a grandi à l’ombre de la cathédrale de Bourges, le second à quelques encablures de son palais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bourges",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75d0e51a-2f7c-32b0-9b02-f1f34dc5d69a",
                                        "entry_id": "4b65380f-ee1f-38e7-ba48-942bab666e19",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a470da-08a4-47bf-a3b8-97a224281687",
                                                "sense_id": "75d0e51a-2f7c-32b0-9b02-f1f34dc5d69a",
                                                "text": "Laissons à Hervé Bourges —qui n’est pas le plus méchant envers l’institution, loin s’en faut— le soin de portraiturer les personnalités désignées pour y siéger."
                                            }
