                ],
                "senses": [
                    {
                        "sense_id": "ef5a9ccd-34a4-367e-9e83-a4618a2f58c6",
                        "entry_id": "2fd06b87-23fe-35ba-ae6d-3ba18f7632a2",
                        "glosses": [
                            "Action d’ameublir une terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a1a9cb-a668-4fa5-bb0e-55d83a9cc016",
                                "sense_id": "ef5a9ccd-34a4-367e-9e83-a4618a2f58c6",
                                "text": "L'ameublissement superficiel du sol fait disparaître cette cause de dessèchement. On l'obtient à l'aide des binages, des serfouissages et des sarclages, ces derniers plus particulièrement destinés à la destruction des plantes adventices."
                            }
                        ]
                    },
                    {
                        "sense_id": "48a6f141-0b3b-39c3-9da1-b2fc5d0931cf",
                        "entry_id": "2fd06b87-23fe-35ba-ae6d-3ba18f7632a2",
                        "glosses": [
                            "Action d'ameublir un bien immobilier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0e91b4-e883-42ed-b495-5e18a57280b0",
                                "sense_id": "48a6f141-0b3b-39c3-9da1-b2fc5d0931cf",
                                "text": "Le père, en mariant sa fille, n’a consenti à l’ameublissement que pour telle somme."
                            },
                            {
                                "example_id": "2af8c2e2-155d-4f9c-8b53-2eb611d84cf2",
                                "sense_id": "48a6f141-0b3b-39c3-9da1-b2fc5d0931cf",
                                "text": "Ameublissement général, particulier. Ameublissement déterminé, indéterminé. Clause d’ameublissement."
                            }
                        ]
                    }
                ],
