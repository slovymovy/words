                                        "entry_id": "d14c247c-7f88-3679-91a9-6964d236d1ee",
                                        "glosses": [
                                            "A square emblem, commonly used as a flag, representing the native peoples of the central Andes of Bolivia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8694ffc-8578-4bb8-aaae-0c08f811d489",
                                                "sense_id": "39cd367b-15ff-3199-9e36-cf09fccff9f1",
                                                "text": "Mr. Morales spoke before thousands of supporters in downtown La Paz on Saturday, some of whom were waving the wiphala, a multicolored flag representing indigenous people in Bolivia."
                                            }
                                        ]
                                    }
                                ]
