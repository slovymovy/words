                                        "sense_id": "18bfcb56-9723-3d47-9841-713f2602bf84",
                                        "entry_id": "c6c74765-897a-301f-881f-5876e607ca79",
                                        "glosses": [
                                            "Not organized; not structured or planned."
                                        ],
