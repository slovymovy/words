    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecd96a9f-d4c9-3512-a981-27bcbded30ca",
                    "sense_definition": "Simple past and past participle of <w>slam</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was angry, so she <w>slammed</w> the door shut behind her.",
                            "target_lang_translations": {
                                "ru": "Она разозлилась, поэтому <w>захлопнула</w> за собой дверь.",
                                "zh": "她很生气，于是在身后把门<w>砰地关上</w>了。"
                            }
                        },
                        {
                            "text": "The car <w>slammed</w> into the wall, but luckily the driver was safe.",
                            "target_lang_translations": {
                                "ru": "Машина <w>врезалась</w> в стену, но, к счастью, водитель не пострадал.",
                                "zh": "汽车<w>猛撞</w>在墙上，但幸运的是司机没有受伤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slammed the door",
                        "slammed shut",
                        "slammed into"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола \"slam\" (хлопать, швырять, врезаться).",
                        "zh": "动词 slam 的过去式和过去分词（砰地关上、猛击、猛撞）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопнул",
                                "target_lang_sense_clarification": "издал громкий звук (о двери)"
                            },
                            {
                                "target_lang_word": "захлопнул",
                                "target_lang_sense_clarification": "резко закрыл"
                            },
                            {
                                "target_lang_word": "врезался",
                                "target_lang_sense_clarification": "с силой ударился обо что-то"
                            },
                            {
                                "target_lang_word": "швырнул",
                                "target_lang_sense_clarification": "бросил с силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "砰地关上",
                                "target_lang_sense_clarification": "使劲关门或窗"
                            },
                            {
                                "target_lang_word": "猛撞",
                                "target_lang_sense_clarification": "带着强烈冲击力撞击"
                            },
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "用力击打或扔下"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "010eb1fe-fd64-3c83-91e6-9247fe038f18",
                    "sense_definition": "Extremely busy or overwhelmed with work and tasks.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "overwhelmed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot go to the movies tonight because I am totally <w>slammed</w> with homework.",
                            "target_lang_translations": {
                                "ru": "Я не могу пойти в кино сегодня вечером, потому что я полностью <w>завален</w> домашней работой.",
                                "zh": "我今晚不能去看电影，因为作业多得让我<w>忙不过来</w>。"
                            }
                        },
                        {
                            "text": "The team is <w>slammed</w> with work right now as the project deadline approaches.",
                            "target_lang_translations": {
                                "ru": "Команда сейчас <w>перегружена</w> работой, так как приближается срок сдачи проекта.",
                                "zh": "随着项目截止日期的临近，团队现在<w>忙得不可开交</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swamped",
                        "overloaded",
                        "snowed under",
                        "busy"
                    ],
                    "antonyms": [
                        "free",
                        "idle"
                    ],
                    "common_phrases": [
                        "slammed with work",
                        "absolutely slammed",
                        "totally slammed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно занятый или перегруженный работой и задачами.",
                        "zh": "忙得不可开交的，被工作或任务压得喘不过气的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завален",
                                "target_lang_sense_clarification": "работой или делами"
                            },
                            {
                                "target_lang_word": "перегружен",
                                "target_lang_sense_clarification": "имеющий слишком много задач"
                            },
                            {
                                "target_lang_word": "в запаре",
                                "target_lang_sense_clarification": "очень занят (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忙得不可开交",
                                "target_lang_sense_clarification": "事务极其繁多"
                            },
                            {
                                "target_lang_word": "应接不暇",
                                "target_lang_sense_clarification": "忙于应付各种事情"
                            },
                            {
                                "target_lang_word": "忙不过来",
                                "target_lang_sense_clarification": "工作量极大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bf1f1db-89f3-3c18-8d71-511c7d197662",
                    "sense_definition": "Full of people or customers; extremely crowded.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overwhelmed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant was absolutely <w>slammed</w> on Friday night, so we had to wait for a table.",
                            "target_lang_translations": {
                                "ru": "В пятницу вечером ресторан был <w>битком</w>, поэтому нам пришлось ждать столик.",
                                "zh": "周五晚上餐馆完全<w>爆满</w>，所以我们不得不等位。"
                            }
                        },
                        {
                            "text": "We tried to visit the museum, but it was so <w>slammed</w> that we could barely move.",
                            "target_lang_translations": {
                                "ru": "Мы пытались посетить музей, но он был настолько <w>забит</w>, что мы едва могли двигаться.",
                                "zh": "我们试图去参观博物馆，但那里简直<w>人满为患</w>，我们寸步难行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "packed",
                        "crowded",
                        "jammed",
                        "full"
                    ],
                    "antonyms": [
                        "empty",
                        "deserted"
                    ],
                    "common_phrases": [
                        "absolutely slammed",
                        "slammed with people"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переполненный людьми или посетителями; битком набитый.",
                        "zh": "（场所或店铺）挤满人的，人满为患的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "битком",
                                "target_lang_sense_clarification": "полный людей (разг.)"
                            },
                            {
                                "target_lang_word": "забит",
                                "target_lang_sense_clarification": "переполнен посетителями"
                            },
                            {
                                "target_lang_word": "переполнен",
                                "target_lang_sense_clarification": "о помещении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人满为患",
                                "target_lang_sense_clarification": "极度拥挤"
                            },
                            {
                                "target_lang_word": "挤得水泄不通",
                                "target_lang_sense_clarification": "顾客或人群极多"
                            },
                            {
                                "target_lang_word": "爆满",
                                "target_lang_sense_clarification": "座无虚席或挤满顾客"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52c76f92-30d5-33ea-afce-f66da6b1d7aa",
                    "sense_definition": "Extremely intoxicated from alcohol or drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drank too much at the party and got completely <w>slammed</w>.",
                            "target_lang_translations": {
                                "ru": "Он слишком много выпил на вечеринке и напился <w>в хлам</w>.",
                                "zh": "他在聚会上喝得太多，喝得<w>烂醉如泥</w>。"
                            }
                        },
                        {
                            "text": "They were too <w>slammed</w> to drive, so they called a taxi to get home.",
                            "target_lang_translations": {
                                "ru": "Они были слишком <w>пьяны</w>, чтобы вести машину, поэтому вызвали такси, чтобы добраться домой.",
                                "zh": "他们喝得太<w>大醉</w>没法开车，所以叫了出租车回家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wasted",
                        "hammered",
                        "drunk",
                        "intoxicated"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "get slammed",
                        "totally slammed"
                    ],
                    "traits": [
