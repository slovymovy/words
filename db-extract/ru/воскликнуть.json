                "senses": [
                    {
                        "sense_id": "e516377d-acb9-3cf1-a02b-02c26df7b3c2",
                        "entry_id": "9227012c-ff8f-3573-a8de-97dfd76d0ab8",
                        "glosses": [
                            "to exclaim, to cry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387726cb-500f-490c-812f-7fbd8b0a2896",
                                "sense_id": "e516377d-acb9-3cf1-a02b-02c26df7b3c2",
                                "text": "— Порфи́рий! — воскли́кнул то́лстый, уви́дев то́нкого. — Ты ли э́то? Голу́бчик мой! Ско́лько зим, ско́лько лет!",
                                "translation": "\"Porfiry,\" cried the fat man on seeing the thin man. \"Is it you? My dear fellow! How many summers, how many winters!\"",
                                "english": "\"Porfiry,\" cried the fat man on seeing the thin man. \"Is it you? My dear fellow! How many summers, how many winters!\""
                            }
                        ]
                    }
                ],
