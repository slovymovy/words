                "senses": [
                    {
                        "sense_id": "250774d2-8ce4-3128-925c-4265b0bb5aab",
                        "entry_id": "9075b3f8-90e6-36e4-89ae-7a86639504a5",
                        "glosses": [
                            "meningsverschil, botsing tussen partijen die onverzoenlijke doelstellingen nastreven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028ca910-a637-4871-90eb-5d1769a67194",
                                "sense_id": "250774d2-8ce4-3128-925c-4265b0bb5aab",
                                "text": "Zo’n 2 miljoen beroepsmilitairen, 9000 gevechtsvliegtuigen, 1800 marineschepen, 6700 tanks en 480.000 gepantserde voertuigen. Op papier klinkt het nog helemaal niet zo slecht wat de krijgsmachten in Europa zónder de Verenigde Staten op de been kunnen brengen, mocht het tot een gewapend conflict komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "18cd7b59-ce70-355f-8015-189f0bf30f99",
                        "entry_id": "9075b3f8-90e6-36e4-89ae-7a86639504a5",
                        "glosses": [
                            "onverenigbaarheid (vgl. bewerkingsconflict)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91c8e991-2ee8-4efe-9467-b4d0e0406f6b",
                        "source_entry_id": "9075b3f8-90e6-36e4-89ae-7a86639504a5",
                        "target_lang_word": "Konflikt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konflikt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                        "entry_id": "1d843196-1d9b-3be8-b2fe-bd01b2e1d5fb",
                                        "glosses": [
                                            "Gegensatz von Meinungen oder Interessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e54e68-8d5c-476d-af16-b20535d43ad4",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "Es kam zu einem Konflikt zwischen Mutter und Tochter."
                                            },
                                            {
                                                "example_id": "c1833723-8780-48fd-950f-be3be2b8d855",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„Vor dem geplanten Krisentreffen haben die USA von Russland konkrete Schritte zur Entschärfung des Konflikts angemahnt.“"
                                            },
                                            {
                                                "example_id": "f5d4f4d9-f7a2-45df-92be-4b54e3650231",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„In der Zeit des Konflikts mit den griechischen Obristen war George Student in Oxford, und sein angeborener Patriotismus kam zum Vorschein.“"
                                            },
                                            {
                                                "example_id": "2ccd0dcf-684c-4dcc-94c3-7347483d40bb",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„In dem Konflikt geht es um mehr als eine Reihe größtenteils unbewohnter Inseln und Riffe.“"
                                            },
                                            {
                                                "example_id": "dc66f3f3-a35a-4247-af4f-9cc47d0e784d",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„Um diese potentiell gefährlichen Konflikte zu entschärfen, lädt Bismarck für den November 1884 Vertreter von zwölf europäischen Staaten, des Osmanischen Reiches sowie der USA nach Berlin ein.“"
                                            },
                                            {
                                                "example_id": "9b091c06-042f-4b35-ac91-4e8a4eb87280",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "[Kaiser Wilhelm II. und Zar Nikolaj II.:] „Eines ist jedoch klar: Wilhelm hat keinen von Nikolajs Vorschlägen zur Lösung des österreichisch-serbischen Konflikts angenommen oder umgesetzt.“"
                                            },
                                            {
                                                "example_id": "3e45bf4b-8ed8-4212-bc97-0c0a1923427b",
                                                "sense_id": "296191ab-4490-33ba-ab34-84ceb32805f1",
                                                "text": "„Wohin sollen Patienten gehen, wenn sie Fragen zu einer Inhalationstherapie haben, zu einer langen Medikamenten-Liste oder zu ihrem Blutdruck? Sind sie mit ihren Fragen in einer Arztpraxis oder in einer Apotheke besser aufgehoben? Dieses Thema sorgt also für Konflikte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06db51b9-f843-4394-a6a7-be842bcbf87c",
                        "source_entry_id": "9075b3f8-90e6-36e4-89ae-7a86639504a5",
                        "target_lang_word": "conflict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conflict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05f40121-b302-3786-bd21-47fbb9a8784d",
                                        "entry_id": "7f7811ba-4c83-3ff1-94f7-32f60f90bcec",
                                        "glosses": [
                                            "A clash or disagreement, often violent, between two or more opposing groups or individuals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b5c197-fa6b-470d-8515-92acd36d6668",
                                                "sense_id": "05f40121-b302-3786-bd21-47fbb9a8784d",
                                                "text": "The conflict between the government and the rebels began three years ago."
                                            },
                                            {
                                                "example_id": "f28ef04d-d76d-4ef3-9691-4ab065434544",
                                                "sense_id": "05f40121-b302-3786-bd21-47fbb9a8784d",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c528d018-9ed5-32fa-8915-4c7f623c4d78",
                                        "entry_id": "7f7811ba-4c83-3ff1-94f7-32f60f90bcec",
                                        "glosses": [
                                            "An incompatibility, as of two things that cannot be simultaneously fulfilled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f554f17-ffd2-4d0c-9ad1-a80dd85a1568",
                                                "sense_id": "c528d018-9ed5-32fa-8915-4c7f623c4d78",
                                                "text": "I wanted to attend the meeting but there's a conflict in my schedule that day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conflict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2af6dccd-45ff-3668-8df7-be909b22479c",
                                        "entry_id": "6ca08eca-3d10-3182-9d35-7e457f844c31",
                                        "glosses": [
                                            "To be at odds (with); to disagree or be incompatible"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2212ce62-2801-43dd-9137-e80d570f1e89",
                                                "sense_id": "2af6dccd-45ff-3668-8df7-be909b22479c",
                                                "text": "[T. E.] Lawrence said that in the end he felt himself to be fighting not for the imperial British but for the rebellious Arabs. All too often he conflicted with British bureaucratic fustiness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb745ba1-e193-34f2-a7f8-e8aa48046a48",
                                        "entry_id": "6ca08eca-3d10-3182-9d35-7e457f844c31",
                                        "glosses": [
                                            "To overlap (with), as in a schedule."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1f0084-d536-4595-a00a-462d9a0ec36e",
                                                "sense_id": "cb745ba1-e193-34f2-a7f8-e8aa48046a48",
                                                "text": "Your conference call conflicts with my older one: please reschedule."
                                            },
                                            {
                                                "example_id": "c193d07f-8504-4943-a0ef-430e6d4edf00",
                                                "sense_id": "cb745ba1-e193-34f2-a7f8-e8aa48046a48",
                                                "text": "It appears that our schedules conflict."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec3ad744-a8cc-4657-8236-a9b94ca7f895",
                        "source_entry_id": "9075b3f8-90e6-36e4-89ae-7a86639504a5",
                        "target_lang_word": "conflit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conflit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d22cc46-8c49-3e21-aea2-fbce9f1686a1",
                                        "entry_id": "94b69c6f-6142-328d-86d7-98a778ccdbf1",
                                        "glosses": [
                                            "Lutte armée, combat entre deux ou plusieurs personnes ou puissances qui se disputent un droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f7b00f6-3b18-420a-b780-f52dd6564ced",
                                                "sense_id": "8d22cc46-8c49-3e21-aea2-fbce9f1686a1",
                                                "text": "La violence prolétarienne change l'aspect de tous les conflits au cours desquels on l'observe ; car elle nie la force organisée par la bourgeoisie, et prétend supprimer l’État qui en forme le noyau central."
                                            },
                                            {
                                                "example_id": "fc7eb71b-bcfc-4e80-8e1e-8bf5700f22ed",
                                                "sense_id": "8d22cc46-8c49-3e21-aea2-fbce9f1686a1",
                                                "text": "Si profond était le fossé entre la bourgeoisie manufacturière et les ouvriers du textile que les luttes révolutionnaires, dans Sedan, prirent comme nulle part ailleurs le caractère d'un conflit entre classes."
                                            },
                                            {
                                                "example_id": "f2c09427-6a6d-47cb-adb0-12d74291c3aa",
                                                "sense_id": "8d22cc46-8c49-3e21-aea2-fbce9f1686a1",
                                                "text": "Ancien commandant des forces américaines en Europe, le lieutenant-général à la retraite Ben Hodges estime « qu’un point de non-retour » a été franchi dans ce conflit."
                                            },
                                            {
                                                "example_id": "cec85fd9-f8e1-4573-b1e0-37f6e3bb69d7",
                                                "sense_id": "8d22cc46-8c49-3e21-aea2-fbce9f1686a1",
                                                "text": "Ce conflit dynastique dégénérerait en guerre européenne. C'est pourquoi Dubois se pose en apôtre de la paix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                        "entry_id": "94b69c6f-6142-328d-86d7-98a778ccdbf1",
                                        "glosses": [
                                            "Violente opposition de sentiments, d’opinions, d’intérêts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c089c135-71b8-4d8c-98b1-5e7d5a070a28",
                                                "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                                "text": "On peut admettre qu'entre les vérités philosophiques et les vérités théologiques, il ne peut avoir ni entr’aide ni conflit, parce qu'il n'y a aucun point de contact : […]."
                                            },
                                            {
                                                "example_id": "9c0ee38c-f12b-4ba8-aa9a-26823fb57e0d",
                                                "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                                "text": "Au vrai j'entrevoyais que le conflit politique était le même en tous pays, et qu'il n'était autre qu'une révolte des esclaves contre les maîtres, chose qu'il fallait attendre, après cette tuerie imbécile."
                                            },
                                            {
                                                "example_id": "3abad57e-2738-4ea4-8f20-623752a34b05",
                                                "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                                "text": "Les réformes de Henry II, en affaiblissant les nobles, les avaient rapprochés de leurs tenants. Entre le manoir et le village, les conflits devenaient plus rares."
                                            },
                                            {
                                                "example_id": "c636d34b-9924-48a1-a8bc-b4f32f58cd5d",
                                                "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                                "text": "L’intégrité journalistique repose largement sur l’absence de conflits de loyautés, et même sur l’absence d’apparence de tels conflits."
                                            },
                                            {
                                                "example_id": "d149cdc4-17fb-43fd-b8ac-b8ed9397938b",
                                                "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                                "text": "Une société politique – a fortiori une démocratie – est habitée par un conflit permanent qui fait sa dynamique et sa réinvention."
                                            },
                                            {
                                                "example_id": "d6afa306-d3b8-4959-9009-a36014d1f6bd",
                                                "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                                                "text": "Le conflit est le signe de la vie : les dictatures ne reconnaissent pas les conflits alors que la démocratie peut être considérée comme un régime de gestion pacifiée des conflits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e318780-30a1-3dec-904c-9e30e9f707c2",
                                        "entry_id": "94b69c6f-6142-328d-86d7-98a778ccdbf1",
                                        "glosses": [
                                            "Expression d’exigences internes inconciliables, telles que désirs et représentations opposés, et plus spécifiquement de forces pulsionnelles antagonistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da18d13f-77ba-4bb1-8982-5b259c6eb2cc",
                                                "sense_id": "0e318780-30a1-3dec-904c-9e30e9f707c2",
                                                "text": "Le conflit psychique peut être manifeste ou latent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "450b5be9-f194-350d-8fef-98db01900113",
                                        "entry_id": "94b69c6f-6142-328d-86d7-98a778ccdbf1",
                                        "glosses": [
                                            "opposition d’intérêts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8542ebc5-d5b4-4360-a934-d789acb1485c",
                                                "sense_id": "450b5be9-f194-350d-8fef-98db01900113",
                                                "text": "Aux yeux des experts de la sécurité routière, l'intersection apparaît comme un lieu privilégié de \"conflit\" entre des véhicules provenant de voies concourantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0f9249-219e-32a4-9b3a-38ee02b2488b",
                                        "entry_id": "94b69c6f-6142-328d-86d7-98a778ccdbf1",
                                        "glosses": [
                                            "Incompatibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691f34ae-f7c6-45af-b7a5-82d96351743f",
                                                "sense_id": "ea0f9249-219e-32a4-9b3a-38ee02b2488b",
                                                "text": "Lorsqu'une règle de la Constitution entre en conflit avec une règle législative, réglementaire ou de common law, un conflit voulant dire que le respect d'une règle entraîne la violation de l'autre, il faut alors conclure que la règle constitutionnelle a rendu inopérante cette autre règle dans la mesure de leur incompatibilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2b3acfb-f587-3572-aa73-92ab93e1bc02",
                                        "entry_id": "94b69c6f-6142-328d-86d7-98a778ccdbf1",
                                        "glosses": [
                                            "Tentative de modification simultanée par plusieurs utilisateurs, qui aboutit à un rejet par le logiciel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb4709a8-540f-44d0-9034-4c5f7db29820",
                                                "sense_id": "c2b3acfb-f587-3572-aa73-92ab93e1bc02",
                                                "text": "Évidemment, si le fichier a été édité par un autre utilisateur et que ce dernier a validé ses modifications sur le référentiel tandis qu'on l'éditait localement, il y a problème. cvs rapporte alors le conflit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75d2fb0c-19e3-49e9-bbc4-6b881d5a1c37",
                        "source_entry_id": "9075b3f8-90e6-36e4-89ae-7a86639504a5",
                        "target_lang_word": "conflitto",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conflitto",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "d503d264-99e5-354b-92b5-01dde0cb64dd",
                                        "entry_id": "6955e158-3463-3495-9c8d-c43eb1a3dbe5",
                                        "glosses": [
                                            "discordia, contrasto tra individui o entità, che può essere gestito pacificamente, con accordi o cappellandosi a regole razziali condivise (come è tipico in una democrazia); oppure con il tentativo di una parte di imporsi con la violenza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39841360-5fb0-4d15-a88d-7046d3394e62",
                                                "sense_id": "d503d264-99e5-354b-92b5-01dde0cb64dd",
                                                "text": "tra conflitto e conflitto esistono differenti posizioni così come numerose motivazioni"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d94835b-1a96-36a3-9553-20d10a96131e",
                                        "entry_id": "6955e158-3463-3495-9c8d-c43eb1a3dbe5",
                                        "glosses": [
                                            "proclami violenti con provocazioni belligeranti e disordini, senza dialogo tra le parti"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
