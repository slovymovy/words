                        "examples": [
                            {
                                "example_id": "c2f2d76a-9902-4a44-a8bc-11e8b81332de",
                                "sense_id": "4d705996-74da-387a-ae2d-62838da47306",
                                "text": "Spotkałem się z biografem Adama Mickiewicza, który napisał o nim wiele książek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1285910-3dd5-4460-8fd9-fc7fc80587a1",
                        "source_entry_id": "cd66882a-8072-3aea-a9d9-ef62c8a79ef4",
                        "source_sense_id": "4d705996-74da-387a-ae2d-62838da47306",
