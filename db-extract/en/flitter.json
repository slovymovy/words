                    {
                        "sense_id": "9359a57c-058a-3627-aaa5-e5002eddaf49",
                        "entry_id": "79e0107b-7145-3850-948c-ad6790bb4bf2",
                        "glosses": [
                            "To move about rapidly and nimbly."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a03663fa-bb7f-3a9a-844b-f9c3206e94a5",
                        "entry_id": "79e0107b-7145-3850-948c-ad6790bb4bf2",
                        "glosses": [
                            "To move quickly from one condition or location to another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85df2d05-e7e0-4a24-a4be-9229bc511070",
                                "sense_id": "a03663fa-bb7f-3a9a-844b-f9c3206e94a5",
                                "text": "How she remembered the gray-feathered titmouse flittering about as she stared unbelievingly at the grave of her sister and clung to Reese, then five years old."
                            },
                            {
                                "example_id": "04fe2e5c-3a3d-405d-8d63-e7d72f86f642",
                                "sense_id": "a03663fa-bb7f-3a9a-844b-f9c3206e94a5",
                                "text": "There were two bugs flittering on either side of her."
                            },
                            {
                                "example_id": "244d6f11-b84d-45ec-a095-b49568c24c1b",
                                "sense_id": "a03663fa-bb7f-3a9a-844b-f9c3206e94a5",
                                "text": "The back of the group flittered in and out of my view, pulling me forward with only dim hopes of success."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9f8bd9c-57d3-3472-bd4e-c4264043aaaf",
