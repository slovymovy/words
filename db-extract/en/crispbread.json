                        "cross_references": [
                            {
                                "target_word": "суха́рь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c833553a-ecce-3c9d-8569-5a34a458ee4f",
                                        "entry_id": "ff8f67eb-d749-3b56-9299-e65add8ee4b6",
                                        "glosses": [
                                            "засохший или высушенный кусок хлеба ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc334373-116c-4cd3-ae79-5c19575f4a87",
                                                "sense_id": "c833553a-ecce-3c9d-8569-5a34a458ee4f",
                                                "text": "Маменька любили потом эти хлебы на сухари резать и в посту в чай с медом обмакивать, а у тетеньки надо всем выше стояло их древнее благочестие."
                                            },
                                            {
                                                "example_id": "0c6902b0-fbd2-4c14-a50f-7323d2590cf3",
                                                "sense_id": "c833553a-ecce-3c9d-8569-5a34a458ee4f",
                                                "text": "Петряйка ставил меж тем третье кушанье: наклал он в чашки сухарей, развел квасом, положил в эту тюрю соленых груздей, рыжиков да вареной свеклы, лучку туда покрошил и маслица подлил."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7d14dd-9f9f-3b31-9881-70cefcfa12d7",
                                        "entry_id": "ff8f67eb-d749-3b56-9299-e65add8ee4b6",
                                        "glosses": [
                                            "перен., разг. очень худой человек"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a49119e-f422-3088-8b1d-5320c8efa8fe",
                                        "entry_id": "ff8f67eb-d749-3b56-9299-e65add8ee4b6",
                                        "glosses": [
                                            "перен., разг. бездушный, холодный, чёрствый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ba9c01-b23e-4edf-b1e8-37f35d352d19",
                                                "sense_id": "9a49119e-f422-3088-8b1d-5320c8efa8fe",
                                                "text": "Он [Мустафа Гусейн] не ведает страха, у него большое, горячее сердце, и перед ним ты со всеми твоими знаниями – деловитый сухарь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90053a81-e27a-3608-82e4-1207a4770b8c",
                                        "entry_id": "ff8f67eb-d749-3b56-9299-e65add8ee4b6",
                                        "glosses": [
                                            "проф., спорт. матч, в котором вратарь одной из команд не допустил ни одного гола"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f98de354-4d1c-381c-9f11-6642ee9eb901",
                                        "entry_id": "ff8f67eb-d749-3b56-9299-e65add8ee4b6",
                                        "glosses": [
                                            "сленг, спорт. ракетка для настольного тенниса без резиновой накладки"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
