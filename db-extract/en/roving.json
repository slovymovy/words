                                "target_senses": [
                                    {
                                        "sense_id": "40510b93-9740-3a97-a8e4-d02bdfe7b0ea",
                                        "entry_id": "5db7be60-8d3d-3d34-895c-b0f50deb7036",
                                        "glosses": [
                                            "takový, který nepatří žádnému pánovi"
                                        ],
                                        "tags": [
                                            "o domácích zvířatech"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9741c0c3-dfbb-4717-bbc2-b10c9ca71606",
                                                "sense_id": "40510b93-9740-3a97-a8e4-d02bdfe7b0ea",
                                                "text": "Ty budeš asi ten toulavý pes, salámu ti nalámu, pěkně to sněz."
                                            },
                                            {
                                                "example_id": "3d3894b7-e3b5-4d5e-a64f-f630bfe43b27",
                                                "sense_id": "40510b93-9740-3a97-a8e4-d02bdfe7b0ea",
                                                "text": "Než, aby se takovému toulavému psovi vyhýbala v autě žena s malými dětmi a havarovala, tak raději takovéhle řešení."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49db5830-f33c-3c9b-9ab8-a5e4e3f13c7b",
                                        "entry_id": "5db7be60-8d3d-3d34-895c-b0f50deb7036",
                                        "glosses": [
                                            "takový, který se (často, rád nebo kvůli své profesi) toulá"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc45665-4b48-4874-91af-9664554dbd71",
                                                "sense_id": "49db5830-f33c-3c9b-9ab8-a5e4e3f13c7b",
                                                "text": "Tu se smlouvá a prodává, volá a vadí, kleje a prosí — tu je smíšenina těch nejrozmanitějších postav: vykrmené drůbežnice a hubené selky, řemeslnice v klobouku a úřednice v prostém čepečku, mladí hospodští a staří hospodáři — potom chátra obojího pohlaví, toulaví prodavači a žebráci."
                                            },
                                            {
                                                "example_id": "8e3f535c-fcec-4897-a7e7-aa4f25688606",
                                                "sense_id": "49db5830-f33c-3c9b-9ab8-a5e4e3f13c7b",
                                                "text": "Každej měsíc je jiná štace, čekáš, kam tě uložej, je to fajn, vždyť přece zpívá, třeba smutně, toulavej."
                                            },
                                            {
                                                "example_id": "5e13c4d9-f389-4568-8e7e-ac008a8382fa",
                                                "sense_id": "49db5830-f33c-3c9b-9ab8-a5e4e3f13c7b",
                                                "text": "Hledal, hledal, až potkal toulavého zpěváka na hubeném koníku, v otřelých šatech, žlutě šedou bradu dávno nestříhanou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e386b189-fc0a-4ee5-8548-18290d9b7a15",
