                        "tags": [
                            "plural"
                        ],
                        "form": "fafetones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "540aeec9-72cf-3a47-ace9-ebb080918165",
                        "entry_id": "c620deb7-9d09-33d1-a407-7ef374274611",
                        "glosses": [
                            "Autre nom du pommier de Sodome ainsi que d'autres espèces de Calotropis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33cf1ce9-4697-4199-abb5-d9bcf590dacb",
                                "sense_id": "540aeec9-72cf-3a47-ace9-ebb080918165",
                                "text": "L’A. gigantea, de l’Afrique portugaise, appelée Bombardeira, est la même plante que le Calotropis gigantea du Sénégal, appelé Fafetone."
                            },
                            {
                                "example_id": "ce214d36-d1b9-4e57-8529-dc748eb169d2",
                                "sense_id": "540aeec9-72cf-3a47-ace9-ebb080918165",
                                "text": "Mais les deux arbustes les plus intéressants pour la production de soie végétale sont le Fafetone (Calotropis procera Ait) et le Mudar (C. gigantea R. Br.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "80fb38f6-4f4b-332a-a844-981037a968fa",
                        "entry_id": "c620deb7-9d09-33d1-a407-7ef374274611",
                        "glosses": [
                            "Tissu très léger produit à partir des aigrettes soyeuses surmontant les graines de cet arbuste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573af287-699f-4112-887c-3a68255b8622",
                                "sense_id": "80fb38f6-4f4b-332a-a844-981037a968fa",
                                "text": "Dans de nombreux endroits, cette fibre a donné naissance à des soies végétales. Ainsi au Sénégal la fameuse \"fafetone\" est tissée à partir de ces fibres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7367092-9576-4fb1-a2c3-1ce99c822b9b",
                        "source_entry_id": "c620deb7-9d09-33d1-a407-7ef374274611",
                        "target_lang_word": "Oscher",
