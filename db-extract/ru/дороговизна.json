                    {
                        "translation_id": "2bbbdc18-af59-469e-9485-1be024c1f52a",
                        "source_entry_id": "561fa866-5d32-3a12-ace9-f1f17e40b5c5",
                        "target_lang_word": "Teuerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teuerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e258c67-c88c-327f-91f9-7a682337a1f3",
                                        "entry_id": "31ec38a8-5f62-3437-9c46-5aa2f640c44d",
                                        "glosses": [
                                            "Ansteigen der Preise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2891cc-462b-4176-9e36-fe3c79df77c8",
                                                "sense_id": "6e258c67-c88c-327f-91f9-7a682337a1f3",
                                                "text": "Dieses Jahr haben wir bisher nur eine geringe Teuerung."
                                            },
                                            {
                                                "example_id": "41cd4884-623c-4a34-992b-f399415dc1db",
                                                "sense_id": "6e258c67-c88c-327f-91f9-7a682337a1f3",
                                                "text": "„Das Statistische Bundesamt erklärt die Teuerung beim Brot mit höheren Kosten für Energie und Rohstoffe, sowie für Personal.“"
                                            },
                                            {
                                                "example_id": "9ba0ae12-f90c-4e38-855f-f13d51e4d100",
                                                "sense_id": "6e258c67-c88c-327f-91f9-7a682337a1f3",
                                                "text": "„Und die hohlen Köpfe waren stets bereit, die Gettos zu stürmen und Juden totzuschlagen, wenn eine Teuerung den Beutel leerte und der Hunger den Magen knurren ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9a6d766-c00a-3322-872d-1184c7d18cd8",
                                        "entry_id": "31ec38a8-5f62-3437-9c46-5aa2f640c44d",
                                        "glosses": [
                                            "Not"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3578f791-3a45-4ee7-9dca-d17e89148c28",
                                                "sense_id": "c9a6d766-c00a-3322-872d-1184c7d18cd8",
                                                "text": "Die Teuerung als Hungersnot wird bereits in der Bibel genannt."
                                            },
                                            {
                                                "example_id": "54099bbd-05dd-41f1-9e03-a9e4d8b86a8e",
                                                "sense_id": "c9a6d766-c00a-3322-872d-1184c7d18cd8",
                                                "text": "„Bis zum November 1808 hatte ein französisches Husarenregiment in Brandenburg und Umgegend gehaust und die Futtervorräte so gänzlich aufgezehrt, daß eine arge Teuerung entstanden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
