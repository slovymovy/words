                                "target_senses": [
                                    {
                                        "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                                        "entry_id": "abae5bbb-b114-3337-9d3d-1945240c5d90",
                                        "glosses": [
                                            "Having or showing grace in movement, shape, or proportion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963ae05c-65c8-43df-abdc-c0ab7fc39abf",
                                                "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                                                "text": "She is a graceful dancer."
                                            },
                                            {
                                                "example_id": "81e27dfb-f8f9-489e-a011-5c0d51f8c609",
                                                "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da074836-c5f3-37c0-9933-ce50e91594ed",
                                        "entry_id": "abae5bbb-b114-3337-9d3d-1945240c5d90",
                                        "glosses": [
                                            "Magnanimous, lacking arrogance or complaint; gracious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d800f4d1-c283-436a-9b54-59dede20b837",
                                                "sense_id": "da074836-c5f3-37c0-9933-ce50e91594ed",
                                                "text": "The athlete's graceful acceptance of the controversial second-place finish won the admiration of the spectators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76fbaf14-6bf5-3592-af3f-57ec6ba32c06",
                                        "entry_id": "abae5bbb-b114-3337-9d3d-1945240c5d90",
                                        "glosses": [
                                            "Gradual and non-disruptive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2cb6c6-f573-46fe-aa1e-a439ec2b9fe7",
                                                "sense_id": "76fbaf14-6bf5-3592-af3f-57ec6ba32c06",
                                                "text": "Bringing a system down cleanly will preserve the operating system and some log files, but again will destroy the contents of the RAM (the volatile data). Windows and Linux are two operating systems that require a graceful shutdown."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
