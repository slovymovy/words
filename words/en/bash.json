                {
                    "sense_id": "c6020071-a3f3-34ce-9090-f25a4ba467ff",
                    "sense_definition": "To <w>abash</w> or make someone feel ashamed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His cruel words were intended to <w>bash</w> her spirit in front of everyone.",
                            "target_lang_translations": {
                                "cs": "Jeho krutá slova měla za cíl <w>ponížit</w> jejího ducha před všemi.",
                                "es": "Sus crueles palabras pretendían <w>humillar</w> su ánimo delante de todos."
                            }
