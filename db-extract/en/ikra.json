                                                "sense_id": "347f5cc9-89d1-3c36-ac6b-74346a63f5aa",
                                                "text": "Słyszałem, że ikra niektórych gatunków ryb jest niejadalna, a nawet trująca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "16271c7f-46f4-37aa-a9bc-dbe3ef00d897",
                                        "entry_id": "68c7b3fa-f3ac-3e95-8f01-284904cd45c9",
                                        "glosses": [
                                            "energia życiowa"
                                        ],
