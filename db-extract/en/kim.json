    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9b65c32d-a046-3ad5-b587-005c3780eabf",
                "word": "Kim",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "52b9c3fe-6244-45d6-8773-cfa729448a7d",
                        "entry_id": "9b65c32d-a046-3ad5-b587-005c3780eabf",
                        "tags": [
                            "plural"
                        ],
                        "form": "Kims"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eff4b446-5613-3d30-8ff1-682cbeba8256",
                        "entry_id": "9b65c32d-a046-3ad5-b587-005c3780eabf",
                        "glosses": [
                            "A unisex given name.",
                            "A male given name transferred from the surname."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c5b2b75-b06e-4ac4-8018-a142a8c4687a",
                                "sense_id": "eff4b446-5613-3d30-8ff1-682cbeba8256",
                                "text": "The half-caste woman who looked after him (she smoked opium, and pretended to keep a second-hand furniture shop by the square where the cheap cabs wait) told the missionaries that she was Kim’s mother’s sister; but his mother had been nursemaid in a colonel's family and had married Kimball O’Hara, a young color-sergeant of the Mavericks, an Irish regiment."
                            }
                        ]
                    },
                    {
                        "sense_id": "8537e622-38d5-311a-8261-c1aed892094f",
                        "entry_id": "9b65c32d-a046-3ad5-b587-005c3780eabf",
                        "glosses": [
                            "A unisex given name.",
                            "A female given name transferred from the surname, of 1940s and later usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae35deb-b785-492e-9e35-fe47851eebc4",
                                "sense_id": "8537e622-38d5-311a-8261-c1aed892094f",
                                "text": "Bizarre as was the name she bore, Kim Ravenal always said she was thankful it had been no worse. […] It is no secret that the absurd monosyllable which comprises her given name is made up of the first letters of three states — Kentucky, Illinois, and Missouri — in all of which she was, incredibly enough, born."
                            },
                            {
                                "example_id": "d214681c-8003-486a-837f-5b4ba4502d1c",
                                "sense_id": "8537e622-38d5-311a-8261-c1aed892094f",
                                "text": "It will take some getting used to, a husband named Kim. She has known girls named Kim since she was a squirt in a sunsuit. Quite a few really. Kimberleys and plain Kims."
                            },
                            {
                                "example_id": "611a6a23-be24-4615-8ed4-12bc4c7c8b78",
                                "sense_id": "8537e622-38d5-311a-8261-c1aed892094f",
                                "text": "The use of “Eye of the Tiger” at a rally for Kentucky clerk Kim Davis has Survivor’s Jim Peterik “risin’ up to the challenge” – and threatening action."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "841a246d-0133-483f-86a6-347e24668789",
                        "source_entry_id": "9b65c32d-a046-3ad5-b587-005c3780eabf",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Ким",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ким",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "843bda2b-f9c0-34ed-9b9b-0c96dc58eba4",
                                        "entry_id": "d6767d02-0ef2-30bd-8c2f-29d2cfe42fcc",
                                        "glosses": [
                                            "корейская фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f535be-7530-4421-9ed2-82589c1a70f2",
                                                "sense_id": "843bda2b-f9c0-34ed-9b9b-0c96dc58eba4",
                                                "text": "Согласно официальной версии, Ким Чен Ир родился 16 февраля 1942 года в бревенчатой хижине на самой высокой и почитаемой горе Северной Кореи."
                                            },
                                            {
                                                "example_id": "20a88a58-c509-4aab-83a6-c3ac26158447",
                                                "sense_id": "843bda2b-f9c0-34ed-9b9b-0c96dc58eba4",
                                                "text": "Одним из последних глав иностранных государств, посетившим еще в октябре 86-го усыпальницу Ленина, был отец нынешнего северокорейского лидера Ким Ир Сен."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ким",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "21158054-3a31-3e32-9c71-3dbd42fb9a27",
                                        "entry_id": "7ce5e8e8-f1fa-3de2-b4b5-c34d6605ad77",
                                        "glosses": [
                                            "распространённое в СССР мужское имя, сокращение от Коммунистический Интернационал Молодежи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e238da56-5a9e-4404-8259-43beea0630ac",
                                                "sense_id": "21158054-3a31-3e32-9c71-3dbd42fb9a27",
                                                "text": "Меня зовут Ким"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a9251f-eacf-35c1-bd9f-80972490ec4e",
                                        "entry_id": "7ce5e8e8-f1fa-3de2-b4b5-c34d6605ad77",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3863b3c-770b-44de-a3a1-e33686bba42a",
                                                "sense_id": "c6a9251f-eacf-35c1-bd9f-80972490ec4e",
                                                "text": "Из пяти лучших теннисисток планеты только Дженнифер Каприати не подтвердила своё высокое положение в рейтинге, а четыре оставшиеся― Винус и Серена Уильямс, Ким Клийстерс и Жюстин Энин-Арденн ― наверняка и поделят между собой призовые деньги."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
