                ],
                "senses": [
                    {
                        "sense_id": "bce580c6-b6d8-3eca-b90d-d9a30ada1b5a",
                        "entry_id": "3c980745-a074-35eb-a517-904d0c951cbd",
                        "glosses": [
                            "Sorte d’ornement de couleur jaune ou amarante que les professeurs portent à l’épaule sur leur robe dans les cérémonies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f2f0de-7835-4aad-bdaf-ecc9f459184c",
                                "sense_id": "bce580c6-b6d8-3eca-b90d-d9a30ada1b5a",
                                "text": "L'épitoge est rouge pour les recteurs et inspecteur, jaune pour les professeurs de lettres, rouge pour ceux de sciences et possède de une à trois bandes en hermine selon le grade."
                            },
                            {
                                "example_id": "efc161fe-028a-4078-be4f-211c44688d72",
                                "sense_id": "bce580c6-b6d8-3eca-b90d-d9a30ada1b5a",
                                "text": "Tout le tribunal d’honneur s’ébranla vers la salle des fêtes, dans un grand mouvement d’épitoges, de toques et de papiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "a21dfefa-412a-371e-99af-8e9fbfdcb1e1",
                        "entry_id": "3c980745-a074-35eb-a517-904d0c951cbd",
                        "glosses": [
                            "Espèce de chaperon ou de capuce que les présidents à mortier et le greffier en chef du parlement portaient sur la tête ou sur l’épaule dans les grandes cérémonies."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1b62eff4-9b73-31a1-9b1b-332bfb2fba11",
                        "entry_id": "3c980745-a074-35eb-a517-904d0c951cbd",
                        "glosses": [
                            "Pièce de tissu ornementale portée à l’épaule sur les robes de magistrats et d’avocats."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "96336b13-13d2-42ac-be7b-cdef26a142ea",
                                "sense_id": "1b62eff4-9b73-31a1-9b1b-332bfb2fba11",
                                "text": "Quand je sortais dans le jardin, le cours fini, je la trouvais assise à l’ombre, près de ce socle où il y a le buste d’un professeur de Droit, avec moustache à la Nietzsche, épitoge et pince-nez, le tout en bronze. Il assistait à nos rencontres, et doit s’en souvenir."
                            },
                            {
                                "example_id": "d118617d-0ada-44e1-ba15-faf0f6374430",
                                "sense_id": "1b62eff4-9b73-31a1-9b1b-332bfb2fba11",
                                "text": "Le magistrat du tribunal d'instance porte une robe noire avec une épitoge sur l'épaule gauche, sa robe étant doublée sur le devant de deux simarres en soie, qui descendent de chaque côté des boutons de la robe, tandis que la robe du greffier n'a ni épitoge ni simarre."
                            }
                        ]
                    }
                ],
