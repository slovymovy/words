            {
                "entry_id": "e5aaef88-2a8d-3530-9b58-e027c0d7a537",
                "word": "giller",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b5c4ec3-e46a-400b-be28-8bf6cf9802c3",
                        "entry_id": "e5aaef88-2a8d-3530-9b58-e027c0d7a537",
                        "tags": [
                            "plural"
                        ],
                        "form": "gillers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e7a44c3-4687-3a17-b5cd-04392d01bb18",
                        "entry_id": "e5aaef88-2a8d-3530-9b58-e027c0d7a537",
                        "glosses": [
                            "A person who gills fish."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc6bfd6-07bb-4da7-8693-8ac0b0d578c6",
                                "sense_id": "4e7a44c3-4687-3a17-b5cd-04392d01bb18",
                                "text": "It is one of the improvements of the times ; it enables the poor man, with hardly anything, to go to work on his own resources, and with his boat and net to follow the fish as they travel from place to place in search of food or to spawn. In this pursuit the giller comes in contact with the seinehauler, and certainly encroaches upon his rights."
                            },
                            {
                                "example_id": "34ca3c84-966e-4069-8599-84bf585d6b61",
                                "sense_id": "4e7a44c3-4687-3a17-b5cd-04392d01bb18",
                                "text": "It is then thrown to the giller, who removes the gills and entrails and cuts a gash along the side containing the backbone, in order that the salt may the more readily penetrate the flesh."
                            },
                            {
                                "example_id": "08731839-e87c-4319-8d24-c8329eeea3e3",
                                "sense_id": "4e7a44c3-4687-3a17-b5cd-04392d01bb18",
                                "text": "This was done by the giller. We would no: try it if we could get out of it. It was too risky."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
