    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                "word": "lycanthropy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f1d98538-1ff5-460c-b60e-f8e9a5148dde",
                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "lycanthropies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6c40354-2dc7-3918-a463-8706459a8ad2",
                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                        "glosses": [
                            "The state of being a lycanthrope (or werewolf), a person who can shapeshift between the form of a human being and a wolf, often said to happen involuntarily during a full moon; werewolfdom."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "239c21f2-49a6-347d-9c6f-b680c501a0b7",
                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                        "glosses": [
                            "The state of being a person who can shapeshift between the form of a human being and an animal, whether or not it is a wolf."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e05623e6-87a9-4487-9f1b-eaa04b95b319",
                                "sense_id": "239c21f2-49a6-347d-9c6f-b680c501a0b7",
                                "text": "On one hand, Jacques is quite glad that he doesn’t have classic lycanthropy. Turning into a squirrel tends to cause fewer problems than turning into a wolf."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca6a2e33-785d-34a3-8126-32ca073cc7c4",
                        "entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                        "glosses": [
                            "A delusion in which one believes oneself to be a wolf or other wild animal."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5a00eac-b7b0-4d9f-b002-9654e977c61b",
                        "source_entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
                        "source_sense_description": "act of shapeshifting",
                        "target_lang_word": "lycanthropie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lycanthropie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad612ae-e3a1-31ec-b345-8aeddbd6b506",
                                        "entry_id": "07d4296d-c96c-32a7-ac25-85396b20ca4d",
                                        "glosses": [
                                            "Caractère d’un être mi-humain, mi-loup ; capacité d’un loup ou d’une louve à se transformer en humain, ou d’un humain de se transformer en loup."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da61f172-c393-4eed-ad84-b45d3dcff515",
                                                "sense_id": "2ad612ae-e3a1-31ec-b345-8aeddbd6b506",
                                                "text": "Plus rare que la lycanthropie, l’arctanthropie est néanmoins au cœur de deux films des studios Disney-Pixar, Frère des ours, sorti en 2003, et Rebelle, sorti en 2012."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15aaee48-e060-336a-affa-e2c8801ebb01",
                                        "entry_id": "07d4296d-c96c-32a7-ac25-85396b20ca4d",
                                        "glosses": [
                                            "Maladie mentale de ceux qui autrefois se croyaient métamorphosés en loups."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03794aeb-5ee7-48de-890d-b84893707122",
                                                "sense_id": "15aaee48-e060-336a-affa-e2c8801ebb01",
                                                "text": "Les raisonneurs les plus incrédules ne voulaient pas admettre une véritable métamorphose, opérée à l’aide ou sans l’aide de la peau enchantée d’un loup, qui, dans certains cas, était supposée coopérer à la transformation, et soutenaient que la lycanthropie n’était qu’une espèce de fatale maladie, une situation d’esprit mélancolique, auxquelles se joignaient des accès de folie, pendant lesquels le malade s’imaginait avoir commis les ravages dont il était accusé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59fef311-c50d-3c2f-bd21-5218508f63e1",
                                        "entry_id": "07d4296d-c96c-32a7-ac25-85396b20ca4d",
                                        "glosses": [
                                            "Maladie mentale de ceux qui se croyaient métamorphosés en un autre animal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc8ccd12-3d07-3cc8-a160-f6e9a5292e93",
                                        "entry_id": "07d4296d-c96c-32a7-ac25-85396b20ca4d",
                                        "glosses": [
                                            "Maladie mentale dans laquelle on voyait au Moyen Âge une force maléfique ou diabolique."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ffac6ed-7f16-4e47-aa1a-c71d4733f07b",
                        "source_entry_id": "e75daca2-241d-3db0-a214-1c8638d0b9d1",
