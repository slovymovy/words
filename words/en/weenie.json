                },
                {
                    "sense_id": "fdfefd57-323b-3b44-8728-c99d3f153d9a",
                    "sense_definition": "In gaming, a small creature that has a low cost to put into play, often used in a swarm with other such creatures.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to play a fast-paced <w>weenie</w> deck to overwhelm his opponent early on.",
