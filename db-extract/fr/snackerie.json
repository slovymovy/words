                "word": "snackerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "512d03f7-48cb-4b52-905c-f48a15978345",
                        "entry_id": "eb05670b-27e2-3c75-bcdf-cc0f680045bd",
