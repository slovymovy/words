                "entry_id": "c8e08fc9-e501-3e68-8470-13ec67a48bbc",
                "word": "stillstand",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f05a4653-4531-4a94-bae0-1d40db397435",
                        "entry_id": "c8e08fc9-e501-3e68-8470-13ec67a48bbc",
                        "tags": [
                            "plural"
                        ],
