{
    "word_family": [
        "bruise",
        "bruiser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e0ff7a9-45fb-3294-a386-fac55d0f8097",
                    "sense_definition": "The presence of marks on the skin caused by an injury.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the <w>bruising</w> on her arm after the fall.",
                            "target_lang_translations": {
                                "zh": "医生检查了她摔倒后手臂上的<w>淤青</w>。"
                            }
                        },
                        {
                            "text": "He had some minor <w>bruising</w> on his leg from the soccer match.",
                            "target_lang_translations": {
                                "zh": "他在足球比赛后腿上有轻微的<w>挫伤</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contusion"
                    ],
                    "target_lang_definitions": {
                        "zh": "因受伤而在皮肤上留下的痕迹。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "淤青",
                                "target_lang_sense_clarification": "指皮肤受损后出现的青紫色斑块。"
                            },
                            {
                                "target_lang_word": "挫伤",
                                "target_lang_sense_clarification": "医学上指软组织受钝力打击后的损伤。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd030594-06ea-3f4d-bf39-89b9bb690ade",
                    "sense_definition": "A violent physical attack or fight.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer suffered a severe <w>bruising</w> during the championship fight.",
                            "target_lang_translations": {
                                "zh": "这位拳击手在冠军赛中遭受了严重的<w>殴打</w>。"
                            }
                        },
                        {
                            "text": "He walked away from the street fight with a nasty <w>bruising</w>.",
                            "target_lang_translations": {
                                "zh": "他在街头斗殴后带着一身严重的<w>伤痕</w>离开了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beating",
                        "thrashing"
                    ],
                    "target_lang_definitions": {
                        "zh": "激烈的身体攻击或打斗。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "殴打",
                                "target_lang_sense_clarification": "指对他人的暴力攻击行为。"
                            },
                            {
                                "target_lang_word": "痛打",
                                "target_lang_sense_clarification": "指程度严重的暴力打击。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d2a3815b-0afd-3bda-85f5-fd09de359269",
                    "sense_definition": "Extremely difficult, tiring, or emotionally draining.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team endured a <w>bruising</w> schedule of games this month.",
                            "target_lang_translations": {
                                "zh": "这个月球队忍受了<w>艰苦的</w>比赛日程。"
                            }
                        },
                        {
                            "text": "It was a <w>bruising</w> experience that left everyone feeling exhausted.",
                            "target_lang_translations": {
                                "zh": "那是一次<w>折磨人的</w>经历，让每个人都感到精疲力竭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arduous",
                        "grueling",
                        "taxing"
                    ],
                    "antonyms": [
                        "easy",
                        "effortless"
                    ],
                    "common_phrases": [
                        "bruising schedule",
                        "bruising experience"
                    ],
                    "target_lang_definitions": {
                        "zh": "极其困难、令人疲惫或在情感上让人精疲力竭的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "艰苦的",
                                "target_lang_sense_clarification": "形容过程非常吃力或困难。"
                            },
                            {
                                "target_lang_word": "折磨人的",
                                "target_lang_sense_clarification": "形容让人感到身心俱疲的经历。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee53d2dc-8910-30e0-a2e9-a31a002747c9",
                    "sense_definition": "Causing physical marks or damage to the skin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bruising</w> impact of the ball left a mark on his shoulder.",
                            "target_lang_translations": {
                                "zh": "球那<w>致伤的</w>撞击在他的肩膀上留下了一个印记。"
                            }
                        },
                        {
                            "text": "She avoided the <w>bruising</w> contact during the rough game.",
                            "target_lang_translations": {
                                "zh": "她在激烈的比赛中避免了<w>致伤的</w>身体接触。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "导致皮肤出现淤青或损伤的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "致伤的",
                                "target_lang_sense_clarification": "形容会造成身体损伤的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69ee6a99-259e-3f1c-8692-7b7557e81182",
                    "sense_definition": "Present participle and gerund of <w>bruise</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>bruising</w> his arm by hitting it against the door.",
                            "target_lang_translations": {
                                "zh": "他把手臂撞在门上，正在把手臂<w>弄伤</w>。"
                            }
                        },
                        {
                            "text": "The constant <w>bruising</w> of the fruit makes it look unappealing.",
                            "target_lang_translations": {
                                "zh": "水果不断地被<w>碰伤</w>，看起来很不诱人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使出现淤青或损伤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄伤",
                                "target_lang_sense_clarification": "指造成身体部位出现淤青。"
                            },
                            {
                                "target_lang_word": "碰伤",
                                "target_lang_sense_clarification": "指因碰撞而导致皮肤受损。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}