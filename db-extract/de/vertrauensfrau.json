                                    {
                                        "sense_id": "88bcd604-e571-35a9-973c-712c6ecc9b8f",
                                        "entry_id": "bd345007-54b5-33dd-9f53-6026653de318",
                                        "glosses": [
                                            "Personne qui renseigne la police."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a310b5ec-bd6c-4687-bd22-fe88c7e90cef",
                                                "sense_id": "88bcd604-e571-35a9-973c-712c6ecc9b8f",
                                                "text": "Oh ! il vend tout c’que vous voudrez, car, en plus de scieur de dés, c’est un indic."
                                            },
                                            {
                                                "example_id": "61273d65-3054-4738-8925-62aea06e2431",
                                                "sense_id": "88bcd604-e571-35a9-973c-712c6ecc9b8f",
                                                "text": "Ils n’étaient donc pas demeurés les bras croisés, et avaient dû glaner les mêmes renseignements que Fabio, finalement. Car eux aussi, ils avaient leurs indics, tout compte fait…"
                                            }
                                        ]
