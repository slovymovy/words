        "fr-extract.jsonl": [
            {
                "entry_id": "f7b33db2-af14-3962-a268-6225c1b478a1",
                "word": "malnutrition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6b222f8-7268-4a90-b164-101469112c68",
                        "entry_id": "f7b33db2-af14-3962-a268-6225c1b478a1",
                        "tags": [
