                "translations": [
                    {
                        "translation_id": "de408551-0091-4385-b499-260f785d974d",
                        "source_entry_id": "1330f913-9b0d-32e5-a189-1c38955db59c",
                        "source_sense_id": "8a5811a7-417f-3b9c-bd6b-e8af8c9a147b",
