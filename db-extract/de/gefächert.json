                                "example_id": "8bea5b2b-4bec-40c3-9e28-2a890b224e1f",
                                "sense_id": "3c2c9efa-195d-376f-8b90-f1e72e8d4cc9",
                                "text": "„Wir haben heute eine Wissenschaftslandschaft hier, die so breit gefächert ist, wie in keiner anderen deutschen Stadt.“"
                            }
