                    {
                        "sense_id": "e1c0f4b3-7db0-3774-8f90-a57d54f30761",
                        "entry_id": "332d306b-64e2-3ea0-b9ee-898ef792d6fa",
                        "glosses": [
                            "Person, die Ballett tanzt"
