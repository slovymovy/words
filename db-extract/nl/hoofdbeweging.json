                    {
                        "sense_id": "5d35814f-5197-3e2b-aa5e-309bead8e91f",
                        "entry_id": "6b4ac10b-8606-3497-a37d-5e2e14694183",
                        "glosses": [
                            "verplaatsing van het hoofd ten op zichte van de romp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc2b5d2-2b40-4e8c-8ec5-a41c623c1251",
                                "sense_id": "5d35814f-5197-3e2b-aa5e-309bead8e91f",
                                "text": "Carmen maakte een hoofdbeweging naar de zithoek tegenover ons en speelde met haar mobiel in haar handen."
                            },
                            {
                                "example_id": "de5abd36-3407-43bc-b28d-2ff14fe06c06",
                                "sense_id": "5d35814f-5197-3e2b-aa5e-309bead8e91f",
                                "text": "De hoofdbeweging was een reflex, zei hij, omdat zijn handboeien steeds strakker gingen zitten. Ook het tonen van zijn geslachtsdeel, ontkent hij. Het wildplassen gaf hij wel toe."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d08d282-491d-353d-a382-e9ac08c038d2",
                        "entry_id": "6b4ac10b-8606-3497-a37d-5e2e14694183",
                        "glosses": [
                            "het grootste deel van een massa mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d69b25-84e2-4662-9eb6-c4a5a19e996d",
                                "sense_id": "1d08d282-491d-353d-a382-e9ac08c038d2",
                                "text": "Intussen is het volksprotest diffuser geworden en zijn er groepen die verschillende eisen stellen. Sommige gele hesjes hebben zich van de 'hoofdbeweging' afgesplitst, omdat die te radicaal en te gepolitiseerd zou zijn geworden en zich ook tegen de media richt."
                            }
                        ]
