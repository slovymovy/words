                        "glosses": [
                            "Not cultivated or tame; wild."
                        ],
                        "tags": [
                            "not-comparable",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "60148de0-34fe-4392-888f-545d5a6ba653",
                                "sense_id": "e97a3e70-c49c-3d5d-878e-cfef69b28f03",
                                "text": "The wilding bee hums merrily by."
                            },
                            {
                                "example_id": "1ed2492f-6a54-41e9-a418-1f2802e7099b",
                                "sense_id": "e97a3e70-c49c-3d5d-878e-cfef69b28f03",
                                "text": "And here had fall'n a great part of a tower, / Whole, like a crag that tumbles from the cliff, / And like a crag was gay with wilding flowers: […]"
                            }
                        ]
                    }
                ],
