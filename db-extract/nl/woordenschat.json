                "translations": [
                    {
                        "translation_id": "5822efa6-bc65-47bf-9383-50319b4cc923",
                        "source_entry_id": "4bfd0178-d4b0-39f7-a695-c7011ddeeee2",
                        "source_sense_id": "3b237323-03ce-3a8a-83e0-0d426d606f4d",
                        "target_lang_word": "Wortschatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortschatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84d7a59d-b499-3d94-bb7a-900ab4a45066",
                                        "entry_id": "7cc4c18e-9e8c-3a99-9d9a-b5c95ea4ab73",
                                        "glosses": [
                                            "Menge der Wörter einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2e49a3-dbd0-406d-bfef-87fe7785c6f2",
                                                "sense_id": "84d7a59d-b499-3d94-bb7a-900ab4a45066",
                                                "text": "Der Duden fasst den Wortschatz der deutschen Sprache zusammen."
                                            },
                                            {
                                                "example_id": "f4bfa628-d155-43b8-9c79-f0708b6799b7",
                                                "sense_id": "84d7a59d-b499-3d94-bb7a-900ab4a45066",
                                                "text": "„Der Wortschatz ist um eine Reihe neuer Ausdrücke erweitert worden, in erster Linie um diesen: flipping.“"
                                            },
                                            {
                                                "example_id": "89a8ce2c-d34d-40d1-9e92-cba05aa8b03d",
                                                "sense_id": "84d7a59d-b499-3d94-bb7a-900ab4a45066",
                                                "text": "„Wir nennen sie Lehnwörter, aber sie sind gleichberechtigte Teile unseres Wortschatzes, denn nur die Sprachgelehrten können sie von den Erbwörtern unterscheiden.“"
                                            },
                                            {
                                                "example_id": "7a8d4e9a-f399-408f-aeaa-065b1b00cd1d",
                                                "sense_id": "84d7a59d-b499-3d94-bb7a-900ab4a45066",
                                                "text": "„Der Wortschatz der deutschen Sprache ist in mehrfacher Weise gegliedert.“"
                                            },
                                            {
                                                "example_id": "471301f8-c640-4094-aa4a-af614393b42e",
                                                "sense_id": "84d7a59d-b499-3d94-bb7a-900ab4a45066",
                                                "text": "„Der Wortschatz der deutschen Gegenwartssprache wird im Allgemeinen zwischen 300000 und 500000 Wörtern (Grundformen) angesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                        "entry_id": "7cc4c18e-9e8c-3a99-9d9a-b5c95ea4ab73",
                                        "glosses": [
                                            "Gesamtheit der Wörter, die eine Person kennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d42e50-549d-4a88-b118-80c7c3279f13",
                                                "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                                "text": "„Ab 1;9 erfolgt eine sprunghafte Ausweitung des Wortschatzes, die bis ca. 3;6 andauert.“"
                                            },
                                            {
                                                "example_id": "ad9ed30a-0548-48f2-b92d-e947a029e5b6",
                                                "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                                "text": "„Die verschiedenen Gesichtspunkte, unter denen das Kind die es umgebende Welt kategorisiert, treten sukzessiv auf und zeigen sich in der Differenzierung des Wortschatzes.“"
                                            },
                                            {
                                                "example_id": "829c0df9-e4dc-4f40-9b47-f91dd23d4b3e",
                                                "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                                "text": "„Muß der Benutzer seinen individuellen Wortschatz selbst neu eingeben?“"
                                            },
                                            {
                                                "example_id": "3dfce2f9-e2fa-4705-a99d-23d0983b8ac9",
                                                "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                                "text": "„Schon in dieser kurzen Zeit finden große Teile seines Wortschatzes zurück in sein Bewusstsein.“"
                                            },
                                            {
                                                "example_id": "be8c89a4-b866-44ba-b0c2-d5b66db0a0cc",
                                                "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                                "text": "„Er war immer fröhlich, sein Wortschatz waren etwa dreihundert Wörter gemischt aus polnischen Brocken, ein paar deutschen.“"
                                            },
                                            {
                                                "example_id": "2b480325-42be-492b-81be-a23f4e9bbe40",
                                                "sense_id": "2c762e92-bda3-39bd-9f7e-4ef9337c39de",
                                                "text": "„Im Alter von ein bis eineinhalb Jahren sprechen die meisten Kinder ihre ersten Worte. In den folgenden Monaten entwickelt sich der aktive Wortschatz rasant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "450769d1-0ef7-4a1e-b717-5ebf29b69d82",
