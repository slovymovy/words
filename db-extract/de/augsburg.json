                "senses": [
                    {
                        "sense_id": "f8457593-30ae-33dd-b51b-165173f3d6b1",
                        "entry_id": "b1a73f1d-6a68-31f6-9742-05b7e0f5a0d6",
                        "glosses": [
                            "Augsbourg, ville, commune et arrondissement d’Allemagne, située dans le Land de Bavière, chef-lieu du district de Souabe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16ba262-3639-41b8-b355-78c1f809bb69",
                                "sense_id": "f8457593-30ae-33dd-b51b-165173f3d6b1",
                                "text": "Augsburg ist nach Trier die zweitälteste Stadt Deutschlands.",
                                "translation": "Augsbourg est la deuxième plus ancienne ville d'Allemagne après Trèves."
                            },
                            {
                                "example_id": "97697ae2-1c5c-4034-949c-9297e801fe37",
                                "sense_id": "f8457593-30ae-33dd-b51b-165173f3d6b1",
                                "text": "Über Bayern ziehen am Montagabend heftige Unwetter hinweg. In Augsburg ist während des Gewitters am Montagabend in großen Teilen der Stadt kurzzeitig der Strom ausgefallen, berichtet die Augsburger Allgemeine Zeitung.",
                                "translation": "De violents orages s’abattent sur la Bavière lundi soir. A Augsbourg, l’électricité a été brièvement coupée dans une grande partie de la ville pendant l’orage de lundi soir, rapporte l'Augsburger Allgemeine Zeitung."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
