{
    "word_family": [
        "clamping",
        "clamped"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2ca5f61-cca0-34bf-ad9b-c492a8ccd13d",
                    "sense_definition": "A tool used to hold two or more objects together firmly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a <w>clamp</w> to hold the two pieces of wood while the glue dries.",
                            "target_lang_translations": {
                                "cs": "Použijte <w>svěrku</w> k přidržení dvou kusů dřeva, dokud lepidlo nezaschne."
                            }
                        },
                        {
                            "text": "The carpenter tightened the <w>clamp</w> to secure the frame.",
                            "target_lang_translations": {
                                "cs": "Truhlář utáhl <w>svěrku</w>, aby zajistil rám."
                            }
                        }
                    ],
                    "synonyms": [
                        "brace",
                        "clasp",
                        "vice"
                    ],
                    "common_phrases": [
                        "metal clamp",
                        "tighten clamp"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nástroj používaný k pevnému držení dvou nebo více předmětů u sebe."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "svěrka",
                                "target_lang_sense_clarification": "nástroj pro truhlářské nebo mechanické upevnění"
                            },
                            {
                                "target_lang_word": "svěrák",
                                "target_lang_sense_clarification": "pevně připevněný nástroj k držení obrobku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e9a5dd-c283-36de-a6fb-33920c05ffe9",
                    "sense_definition": "A device attached to a vehicle wheel to prevent it from being driven away.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fastening_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver returned to find a <w>clamp</w> on his front wheel.",
                            "target_lang_translations": {
                                "cs": "Řidič se vrátil a na předním kole našel <w>botičku</w>."
                            }
                        },
                        {
                            "text": "Parking illegally in this area will result in your car getting a <w>clamp</w>.",
                            "target_lang_translations": {
                                "cs": "Za nelegální parkování v této oblasti dostane vaše auto <w>botičku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wheel clamp"
                    ],
                    "common_phrases": [
                        "wheel clamp"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zařízení připevněné ke kolu vozidla, které brání jeho odjezdu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "botička",
                                "target_lang_sense_clarification": "zařízení na kolo auta proti neoprávněnému odjezdu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a58b01d3-5360-340f-aef6-16a11c049bb3",
                    "sense_definition": "A medical instrument used to temporarily stop blood flow in a vessel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fastening_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon applied a <w>clamp</w> to the artery to stop the bleeding.",
                            "target_lang_translations": {
                                "cs": "Chirurg přiložil na tepnu <w>svorku</w>, aby zastavil krvácení."
                            }
                        },
                        {
                            "text": "The nurse removed the <w>clamp</w> once the procedure was finished.",
                            "target_lang_translations": {
                                "cs": "Sestra odstranila <w>svorku</w>, jakmile byl zákrok dokončen."
                            }
                        }
                    ],
                    "synonyms": [
                        "hemostat"
                    ],
                    "target_lang_definitions": {
                        "cs": "Lékařský nástroj používaný k dočasnému zastavení průtoku krve v cévě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "svorka",
                                "target_lang_sense_clarification": "chirurgický nástroj k uzavření cévy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04f85cfe-eccb-3810-80a6-968b96ffeb62",
                    "sense_definition": "To fasten or hold something tightly in place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>clamp</w> the metal sheets together before welding them.",
                            "target_lang_translations": {
                                "cs": "Před svařováním musíte kovové plechy k sobě <w>pevně sevřít</w>."
                            }
                        },
                        {
                            "text": "He <w>clamped</w> his hands over his ears to block out the noise.",
                            "target_lang_translations": {
                                "cs": "<w>Sevřel</w> si ruce přes uši, aby odfiltroval hluk."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "grip",
                        "secure"
                    ],
                    "antonyms": [
                        "release",
                        "loosen"
                    ],
                    "common_phrases": [
                        "clamp together"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevně něco připevnit nebo držet na místě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "připevnit",
                                "target_lang_sense_clarification": "obecné upevnění něčeho"
                            },
                            {
                                "target_lang_word": "sevřít",
                                "target_lang_sense_clarification": "pevně uchopit nebo stisknout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c77025fa-bb26-33ec-a5a1-fa933f8de75f",
                    "sense_definition": "To immobilize a vehicle by attaching a device to its wheel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traffic warden <w>clamped</w> the car for illegal parking.",
                            "target_lang_translations": {
                                "cs": "Dopravní policista <w>nasadil autu botičku</w> za nelegální parkování."
                            }
                        },
                        {
                            "text": "My car was <w>clamped</w> because I forgot to pay the parking fee.",
                            "target_lang_translations": {
                                "cs": "Moje auto <w>dostalo botičku</w>, protože jsem zapomněl zaplatit parkovné."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Znehybnit vozidlo připevněním zařízení k jeho kolu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nasadit botičku",
                                "target_lang_sense_clarification": "opatřit auto botičkou za přestupek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3cd1496-5919-3309-9255-3d4dcaba2c36",
                    "sense_definition": "To restrict a numeric value to a specific range.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software will <w>clamp</w> the input values between zero and one hundred.",
                            "target_lang_translations": {
                                "cs": "Software <w>omezí</w> vstupní hodnoty na rozmezí nula až sto."
                            }
                        },
                        {
                            "text": "We <w>clamped</w> the volume level to prevent it from becoming too loud.",
                            "target_lang_translations": {
                                "cs": "<w>Omezili jsme</w> úroveň hlasitosti, aby nebyla příliš vysoká."
                            }
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "restrict"
                    ],
                    "target_lang_definitions": {
                        "cs": "Omezit číselnou hodnotu na určité rozmezí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "omezit",
                                "target_lang_sense_clarification": "nastavit limity hodnoty"
                            },
                            {
                                "target_lang_word": "zastropovat",
                                "target_lang_sense_clarification": "stanovit horní hranici hodnoty"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "88007884-f99f-3040-81b6-fc6ca5fd89c9",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research was conducted by Dr. <w>Clamp</w>.",
                            "target_lang_translations": {
                                "cs": "Výzkum vedl Dr. <w>Clamp</w>."
                            }
                        },
                        {
                            "text": "Mr. and Mrs. <w>Clamp</w> are our new neighbors.",
                            "target_lang_translations": {
                                "cs": "Manželé <w>Clampovi</w> jsou naši noví sousedé."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Clamp",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}