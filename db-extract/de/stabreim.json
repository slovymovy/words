                        "form": "den Stabreim"
                    },
                    {
                        "form_id": "f4cbec39-ac08-418a-9e36-56602e0b4f8b",
                        "entry_id": "7c5c8bcf-ea2e-3397-ab72-f3262a5f0c01",
                        "tags": [
                            "accusative",
