{
    "word_family": [
        "indépendant",
        "indépendamment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a7a3e7e-25ae-3539-bfce-552c9756fcb4",
                    "sense_definition": "Situation politique d'une nation ou d'un État qui ne dépend d'aucune puissance étrangère et s'administre lui-même.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souverainete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne colonie a finalement proclamé son <w>indépendance</w> politique après des années de négociations."
                        },
                        {
                            "text": "La population célèbre chaque année l'anniversaire de l'<w>indépendance</w> nationale par un immense défilé."
                        }
                    ],
                    "synonyms": [
                        "souveraineté"
                    ],
                    "antonyms": [
                        "dépendance"
                    ],
                    "common_phrases": [
                        "indépendance nationale",
                        "proclamer son indépendance",
                        "indépendance politique"
                    ]
                },
                {
                    "sense_id": "44aea60d-d523-3234-8aec-57d442d54654",
                    "sense_definition": "État d'une personne autonome qui ne dépend pas d'autrui sur le plan moral, matériel ou financier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autonomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'elle a trouvé son premier emploi, elle a pu acquérir une véritable <w>indépendance</w> financière."
                        },
                        {
                            "text": "Il tient beaucoup à son <w>indépendance</w> et préfère toujours voyager seul."
                        }
                    ],
                    "synonyms": [
                        "liberté"
                    ],
                    "antonyms": [
                        "dépendance"
                    ],
                    "common_phrases": [
                        "indépendance financière",
                        "garder son indépendance",
                        "indépendance personnelle"
                    ]
                },
                {
                    "sense_id": "1d7f87bc-7b51-36be-8e3c-7c32efae173f",
                    "sense_definition": "Absence de lien, de subordination ou d'influence réciproque entre plusieurs choses ou institutions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La constitution assure la stricte <w>indépendance</w> des pouvoirs législatif et judiciaire."
                        },
                        {
                            "text": "Le chercheur a démontré l'<w>indépendance</w> totale entre ces deux événements météorologiques récents."
                        }
                    ],
                    "antonyms": [
                        "dépendance"
                    ],
                    "common_phrases": [
                        "indépendance des pouvoirs"
                    ]
                },
                {
                    "sense_id": "2937e2ec-8344-35ad-8606-238831277a39",
                    "sense_definition": "Propriété d'événements ou de variables aléatoires dont la réalisation de l'un ne modifie pas la probabilité de l'autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le modèle statistique repose sur l'<w>indépendance</w> mutuelle de tous les tirages effectués."
                        },
                        {
                            "text": "En probabilités, l'<w>indépendance</w> de deux événements permet de multiplier simplement leurs probabilités."
                        }
                    ],
                    "antonyms": [
                        "dépendance"
                    ],
                    "common_phrases": [
                        "indépendance statistique",
                        "indépendance stochastique"
                    ]
                }
            ]
        }
    ]
}