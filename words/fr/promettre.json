{
    "word_family": [
        "promesse",
        "prometteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1a7e6b2-830c-368a-8129-584f1b830810",
                    "sense_definition": "S'engager, oralement ou par écrit, à faire ou à donner quelque chose à quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "engagement_de_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te <w>promets</w> que je te rendrai ton argent avant dimanche."
                        },
                        {
                            "text": "Il a <w>promis</w> à son père de ne rien dire à sa mère."
                        },
                        {
                            "text": "Le maire <w>promet</w> de revenir dans le quartier pour inaugurer la nouvelle école."
                        }
                    ],
                    "common_phrases": [
                        "promettre de revenir",
                        "promettre son soutien",
                        "promettre un cadeau"
                    ]
                },
                {
                    "sense_id": "8f5aa8cc-b8cb-3977-a4ff-841ed1307091",
                    "sense_definition": "Affirmer avec force qu'une chose sera vraie ou se produira.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "engagement_de_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te <w>promets</w> que tu vas adorer ce film."
                        },
                        {
                            "text": "Je vous <w>promets</w> qu'il s'en repentira tôt ou tard."
                        }
                    ],
                    "synonyms": [
                        "assurer"
                    ],
                    "common_phrases": [
                        "promettre que tout ira bien"
                    ]
                },
                {
                    "sense_id": "47281a31-6ba0-3a7a-8853-69038b6849c1",
                    "sense_definition": "Laisser espérer de bons résultats ou un bel avenir, en parlant d'une personne ou d'une chose ; se dit aussi ironiquement quand on s'attend à des difficultés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signe_d_avenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune athlète <w>promet</w> beaucoup pour les prochains Jeux olympiques."
                        },
                        {
                            "text": "Les vignes <w>promettent</w> beaucoup cette année, grâce au beau temps du printemps."
                        },
                        {
                            "text": "Il pleut déjà à huit heures du matin : ça <w>promet</w> pour la randonnée !"
                        }
                    ],
                    "common_phrases": [
                        "promettre beaucoup"
                    ]
                },
                {
                    "sense_id": "f500a663-a6d8-34a5-a403-69cc12934fc7",
                    "sense_definition": "Se promettre de faire quelque chose : prendre la ferme résolution de le faire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me suis <w>promis</w> de ne plus jamais arriver en retard."
                        },
                        {
                            "text": "Elle se <w>promet</w> de commencer le sport dès demain matin."
                        }
                    ],
                    "common_phrases": [
                        "se promettre de"
                    ]
                },
                {
                    "sense_id": "0f33817b-4b5b-3d0c-ac5d-6f7bc710932f",
                    "sense_definition": "Annoncer ou laisser prévoir quelque chose, en parlant d'une chose ou d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "signe_d_avenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce ciel noir <w>promet</w> de l'orage pour ce soir."
                        },
                        {
                            "text": "Cette campagne <w>promet</w> une belle récolte si le temps reste favorable."
                        }
                    ],
                    "common_phrases": [
                        "promettre de l'orage",
                        "promettre une belle récolte"
                    ]
                },
                {
                    "sense_id": "84aac0ae-660e-3f44-929b-8141837ebddc",
                    "sense_definition": "Se promettre quelque chose : l'espérer, s'y attendre avec confiance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attente_espoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'oserais pas me <w>promettre</w> un si grand succès."
                        },
                        {
                            "text": "Il s'était <w>promis</w> beaucoup de plaisir de ce voyage en Italie."
                        }
                    ],
                    "common_phrases": [
                        "se promettre du plaisir"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "emploi surtout littéraire ou soutenu"
                        }
                    ]
                },
                {
                    "sense_id": "833059f8-673c-3fec-af97-a6204f2ea316",
                    "sense_definition": "S'engager à s'unir à quelqu'un, notamment par le mariage.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engagement_de_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'était <w>promise</w> à lui avant son départ pour la guerre."
                        },
                        {
                            "text": "Ils se sont <w>promis</w> l'un à l'autre dans le plus grand secret."
                        }
                    ],
                    "common_phrases": [
                        "se promettre à quelqu'un"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "emploi vieilli ou littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "e8410be4-a4fb-3850-a86f-c03516ec59e8",
                    "sense_definition": "Destiner à un sort, à un usage ou à une fin (surtout au participe : être promis à).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune pianiste est <w>promis</w> à un brillant avenir."
                        },
                        {
                            "text": "Ces vieux bâtiments étaient <w>promis</w> à la démolition depuis des années."
                        }
                    ],
                    "common_phrases": [
                        "promis à la démolition"
                    ]
                }
            ]
        }
    ]
}