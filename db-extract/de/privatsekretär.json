                    {
                        "form_id": "468f4239-ba6e-49d8-b681-41cc071d6059",
                        "entry_id": "7b0ad1c3-b58d-3f85-a845-a9d1bf83b187",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Privatsekretäre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f31d6f3-649f-3ea1-84a8-4f1bfc8eb0a8",
                        "entry_id": "7b0ad1c3-b58d-3f85-a845-a9d1bf83b187",
                        "glosses": [
                            "persönlicher Sekretär einer Führungskraft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c11af6f6-a152-4f70-830d-9c9f1c5a3c23",
                                "sense_id": "6f31d6f3-649f-3ea1-84a8-4f1bfc8eb0a8",
                                "text": "„Im November 1940 schrieb John Martin, Churchills Privatsekretär, man solle lieber den Juden einen unabhängigen Staat geben, als auf dem Meer Jagd auf jüdische Flüchtlinge machen.“"
                            },
                            {
                                "example_id": "4ccac866-921b-4cc4-a7bb-11c20ff0c737",
                                "sense_id": "6f31d6f3-649f-3ea1-84a8-4f1bfc8eb0a8",
                                "text": "„‚Stundenlang bis spät in die Nacht konnten sie über Probleme nachdenken, debattieren und argumentieren, bis sie eine Lösung fanden. Eine bessere Zusammenarbeit als diejenige, die sich über Jahre hin zwischen diesen beiden Arbeitstieren einspielte, ist kaum denkbar,‘ erinnerte sich Verwoerds Privatsekretär.“"
                            },
                            {
                                "example_id": "8352fc16-3737-4f7e-b0b2-6e31e5cf0985",
                                "sense_id": "6f31d6f3-649f-3ea1-84a8-4f1bfc8eb0a8",
                                "text": "„An dem Tag, an dem Sarobi fiel, hatte Nadschibullah eine Nachricht an das UN-Hauptquartier in Islamabad geschickt, in der er Norbert Holl bat, ihn und seine drei Gefährten - seinen Bruder Schapur Achmadzai, seinen Privatsekretär und seinen Leibwächter - zu evakuieren.“"
                            },
                            {
                                "example_id": "45d1d8f7-f99e-4db5-a1eb-6867a39fee31",
                                "sense_id": "6f31d6f3-649f-3ea1-84a8-4f1bfc8eb0a8",
                                "text": "„Als Privatsekretär seines Erzbischofs, der damals gleichzeitig portugiesischer Vizekönig war, gingen alle möglichen Schriftstücke durch seine Hand.“"
                            },
                            {
                                "example_id": "95a93b22-4d65-4d40-954e-6db944c23b81",
                                "sense_id": "6f31d6f3-649f-3ea1-84a8-4f1bfc8eb0a8",
                                "text": "„Jamal ließ dem Privatsekretär des Alten Mannes eine Botschaft zukommen, in der er um eine dringende Audienz bat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
