                "senses": [
                    {
                        "sense_id": "047bc3eb-6800-3a7f-ab47-d821743a4c4e",
                        "entry_id": "f931f4cb-07ad-3b20-8fb2-42625cd5ca91",
                        "glosses": [
                            "Düsenflugzeug, das Eigentum einer Firma ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ae7ca1-c9f5-4ed9-8385-7562ff40e97f",
                                "sense_id": "047bc3eb-6800-3a7f-ab47-d821743a4c4e",
                                "text": "„Sie ist... sie weiß um ihre persönliche Lage, und sie hat Ihnen einen Firmenjet angeboten.“"
                            },
                            {
                                "example_id": "dc698f34-e512-4222-bea7-25da15265297",
                                "sense_id": "047bc3eb-6800-3a7f-ab47-d821743a4c4e",
                                "text": "„In den Jahren 1995 und 1996 verließ er seine Firma in Südamerika und verbrachte neun Monate damit, im Firmenjet von einem afghanischen Kriegsherrn zum andern sowie nach Islamabad, Aschchabad, Moskau und Washington zu reisen, um die Führungsspitzen davon zu überzeugen, dass seine Pipelines eine realistische Möglichkeit boten.“"
                            },
                            {
                                "example_id": "f8ac9402-25f1-4645-9fc1-a707090a6ecc",
                                "sense_id": "047bc3eb-6800-3a7f-ab47-d821743a4c4e",
                                "text": "„Wenn ich denen erkläre, worum es geht, sind einen halben Tag später zehn Firmenjets nach Europa unterwegs, und in jedem dieser Flieger werden die bösesten Buben mit den fettesten Kanonen sitzen.“"
                            },
                            {
                                "example_id": "de54eb09-49d7-4a41-9265-4b9f70421a4d",
                                "sense_id": "047bc3eb-6800-3a7f-ab47-d821743a4c4e",
                                "text": "„Mehrere Dutzend Firmenjets und Helikopter parken auf dem Vorfeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
