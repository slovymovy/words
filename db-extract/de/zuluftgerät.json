                ],
                "senses": [
                    {
                        "sense_id": "fde56c25-6caf-374b-aebb-9929aa18f25c",
                        "entry_id": "61ed676e-2ca8-3bbb-9c3a-a91559b08e06",
                        "glosses": [
                            "technische Einrichtung, die Luft reinigt, aufbereitet, bewegt und als Zuluft einbläst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d8ae80-3094-4c32-b6ec-ef640eb8e2cf",
                                "sense_id": "fde56c25-6caf-374b-aebb-9929aa18f25c",
                                "text": "„Es ermöglicht den Lüftungsbetrieb mit anteiliger Außenluft und Umluft (Raumluft) als Zuluftgerät, die Lufterwärmung über ein Heizregisterelement (PWW), die Kühlung der Luft über ein Kühlregisterelement sowie Luftreinigung“"
                            },
                            {
                                "example_id": "b0aa442b-3d67-4fa2-8966-56bf07ffb010",
                                "sense_id": "fde56c25-6caf-374b-aebb-9929aa18f25c",
                                "text": "„In der untenstehenden Übersicht für Zuluftgeräte kann eine Schnellauswahl anhand der benötigten luftseitigen Betriebspunkte und des vorhandenen elektrischen Stromnetzes getroffen werden.“"
                            },
                            {
                                "example_id": "71ba97bd-cc77-46d8-bf97-c82388eb87e7",
                                "sense_id": "fde56c25-6caf-374b-aebb-9929aa18f25c",
                                "text": "„Der Auftraggeber, die VITS Systems GmbH, Hersteller von Imprägnieranlagen, Systemen und Komponenten für die Papierindustrie und Systeme für Offset- Druckverfahren, orderte ein Zuluftgerät mit einer Luftfördermenge von 50000 m3/h.“"
                            },
                            {
                                "example_id": "954af070-84ed-46b5-81d8-c387982dc1eb",
                                "sense_id": "fde56c25-6caf-374b-aebb-9929aa18f25c",
                                "text": "„CFL Zuluftgeräte führen den Räumen gefilterte Außenluft in ausreichender, stufenlos regelbarer Menge zu.“"
                            },
                            {
                                "example_id": "d2b6d846-85b2-4697-96f0-c701468fc81c",
                                "sense_id": "fde56c25-6caf-374b-aebb-9929aa18f25c",
                                "text": "„Die Außenluft wird im Zuluftgerät in einem Sorptionsrad getrocknet und in einem regenerativen Wärmerückgewinner, WRG, vorgekühlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
