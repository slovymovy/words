                        "sense_id": "53769f39-83b4-3271-9af8-1ab31a7147ad",
                        "entry_id": "210a4fca-5811-3060-9d42-380b8fe3c339",
                        "glosses": [
                            "van geen belang voor de huidige zaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a83a355-fd2e-4dfd-a4ae-a3ac8112fee9",
                                "sense_id": "53769f39-83b4-3271-9af8-1ab31a7147ad",
                                "text": "Hij maakt soms de irrelevantste opmerkingen."
                            },
                            {
                                "example_id": "8bd67081-4cb8-4e5f-99bd-935f5d65cc03",
                                "sense_id": "53769f39-83b4-3271-9af8-1ab31a7147ad",
                                "text": "Al het andere was irrelevant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2df8af53-bd54-4011-943b-2e9b8fe6f1a0",
                        "source_entry_id": "210a4fca-5811-3060-9d42-380b8fe3c339",
                        "source_sense_id": "53769f39-83b4-3271-9af8-1ab31a7147ad",
                        "source_sense_description": "van geen belang voor de huidige zaak",
                        "target_lang_word": "irrelevant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrelevant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6515b9-4fc4-3f35-9ec6-f320f898508b",
                                        "entry_id": "8f37d701-a3f5-3ce6-91cb-1a8f7bb280c7",
                                        "glosses": [
                                            "Not relevant, as"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8061ba9-9634-46f2-a141-5f24cc48a25d",
                                                "sense_id": "8e6515b9-4fc4-3f35-9ec6-f320f898508b",
                                                "text": "His comments were completely irrelevant to the discussion."
                                            },
                                            {
                                                "example_id": "5a875a95-ee6f-42eb-a56d-0c36c9740297",
                                                "sense_id": "8e6515b9-4fc4-3f35-9ec6-f320f898508b",
                                                "text": "We need to focus on the main topic and ignore irrelevant details."
                                            },
                                            {
                                                "example_id": "35cd7029-9f5d-4088-94bb-adb4ad4920b2",
                                                "sense_id": "8e6515b9-4fc4-3f35-9ec6-f320f898508b",
                                                "text": "The fact that she is his sister is irrelevant to the case."
                                            },
                                            {
                                                "example_id": "585cb38b-daa4-402a-84ff-38c4290546da",
                                                "sense_id": "8e6515b9-4fc4-3f35-9ec6-f320f898508b",
                                                "text": "Andy Kirby said that, on her second day in his class, Velvet declared algebra irrelevant to her life and strolled out the door. \"Haven't seen her since,\" he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad1bba6-2b3d-3500-93db-83c0e7589a5d",
                                        "entry_id": "8f37d701-a3f5-3ce6-91cb-1a8f7bb280c7",
                                        "glosses": [
                                            "Not relevant, as:",
                                            "Not at all related: totally unrelated, wholly unconnected, completely inapplicable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c2d57c4-8c16-3db4-b484-210bd2b5a1f8",
                                        "entry_id": "8f37d701-a3f5-3ce6-91cb-1a8f7bb280c7",
                                        "glosses": [
                                            "Not relevant, as:",
                                            "Not usefully related: not associated in any way that is important or useful to the context being discussed: not materially applicable; having connections not applicable in the present situation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db6b1bb0-9a5d-3e4a-869f-50c9ae67f73b",
                                        "entry_id": "8f37d701-a3f5-3ce6-91cb-1a8f7bb280c7",
                                        "glosses": [
                                            "No longer famous or popular; washed up."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
