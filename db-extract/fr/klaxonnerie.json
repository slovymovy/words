                "senses": [
                    {
                        "sense_id": "ee6b2ad0-973a-38a9-be8e-3b561adec414",
                        "entry_id": "8ff1e9d9-613c-3a96-a6fc-29d4ea66c07f",
                        "glosses": [
                            "Ensemble d'avertisseurs sonores (klaxons), tel qu'on peut en entendre dans certains embouteillages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65691e9-f830-468f-9669-1a36b7252240",
                                "sense_id": "ee6b2ad0-973a-38a9-be8e-3b561adec414",
                                "text": "Si la nuit son sommeil léger avait été traversé par de petites klaxonneries d'un car de la Sainte Hermandad (c'est ainsi que, par quichottisme, il appelait les cars de Police-secours), qui avaient succédé aux cloches et aux tambours de celle d'autrefois, […], cela c'était toujours passé soit Faubourg Saint-Martin, soit […]."
                            },
                            {
                                "example_id": "528b0879-41aa-488f-a5e2-e8617259ae58",
                                "sense_id": "ee6b2ad0-973a-38a9-be8e-3b561adec414",
                                "text": "La prison de Champrond étant à soixante bornes de Paris, il a fallu se fader soixante kilomètres de klaxonnerie."
                            },
                            {
                                "example_id": "4f2380f5-9465-4724-99f8-b9fb478f2664",
                                "sense_id": "ee6b2ad0-973a-38a9-be8e-3b561adec414",
                                "text": "Mon équilibre est insuffisant pour la bicyclette en ville dans ces couloirs encombrés où la jeunesse acrobate à casque et la klaxonnerie urbaine vindicative se partagent hargneusement l'espace."
                            },
                            {
                                "example_id": "0a0dc30b-7558-40e2-8513-0ea1bdf5dc91",
                                "sense_id": "ee6b2ad0-973a-38a9-be8e-3b561adec414",
                                "text": "Elle approchait la cinquantaine, Maria Miloseva, une plantureuse Yougoslave naturalisée française qui avait rompu définitivement, il y avait maintenant trente ans, avec Paris et son concert de klaxonnerie."
                            }
                        ]
                    }
