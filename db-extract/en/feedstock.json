                    {
                        "translation_id": "d88faea1-bbd7-4f04-92a9-8e99bc580d1f",
                        "source_entry_id": "751a01b5-524d-37be-b9b8-b8b2103fbde9",
                        "source_sense_id": "27d51a2e-2860-3ba1-a84b-4f31a8e4e145",
                        "source_sense_description": "Ausgangsmaterial, Rohmaterial, Rohstoff",
                        "target_lang_word": "Ausgangsmaterial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgangsmaterial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                        "entry_id": "14250af9-8dfd-3aed-b8c6-d021a22977d7",
                                        "glosses": [
                                            "Material, Stoff, aus dem durch Verarbeitung etwas Höherwertiges, Komplexeres entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425d1a9f-e63e-4754-bc91-e0b9fc5eda0f",
                                                "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                                "text": "„Bei natürlichen Aromastoffen muss das Ausgangsmaterial pflanzlicher oder tierischer Herkunft sein.“"
                                            },
                                            {
                                                "example_id": "179a7f4d-5fc7-4b2d-8e89-2adf5a5c5b5f",
                                                "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                                "text": "„Auf seinen Platten sampelt er mit Vorliebe alte Soul- und Jazz-Stücke – wobei die Samples dann freilich derart fragmentiert und verfremdet werden, dass man das Ausgangsmaterial nicht mehr erkennt.“"
                                            },
                                            {
                                                "example_id": "f197239c-d7ad-453d-ba0d-b31d1e27b70d",
                                                "sense_id": "f3002cf1-8a05-3672-aaf9-4c55fd59adfa",
                                                "text": "„Das Ausgangsmaterial war fetter Ton, den der Ingenieur mit Kalk und Quarz zu echter Pfeifenerde vermengt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14046b8f-c888-4817-8e8a-ea903d5fbf32",
                        "source_entry_id": "751a01b5-524d-37be-b9b8-b8b2103fbde9",
                        "source_sense_id": "27d51a2e-2860-3ba1-a84b-4f31a8e4e145",
                        "source_sense_description": "Ausgangsmaterial, Rohmaterial, Rohstoff",
                        "target_lang_word": "Rohmaterial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rohmaterial",
