                        "examples": [
                            {
                                "example_id": "22e0ce1f-2712-4ada-bc62-0f447c7bb6d5",
                                "sense_id": "0fc6d223-5afa-3e4e-886d-66170259cea0",
                                "text": "Si certains se réjouissent de voir reculer les problèmes d’infertilité des couples, d’autres s’inquiètent de l’aveuglement qui conduit certains patients à un véritable acharnement procréatif."
                            },
                            {
                                "example_id": "d4758032-5607-4828-b072-065ba4b32475",
                                "sense_id": "0fc6d223-5afa-3e4e-886d-66170259cea0",
                                "text": "Dans son rapport 2011, l’Agence de la biomédecine note un phénomène « qui semble aller croissant » de « tourisme procréatif », malgré des coûts « très élevés »."
                            },
                            {
                                "example_id": "ffb95e3f-c93f-4281-b416-4b4b95c13d73",
                                "sense_id": "0fc6d223-5afa-3e4e-886d-66170259cea0",
                                "text": "« … Cela passera par une libération de la parole de ceux qui ont subi ces bricolages procréatifs. … »"
                            }
                        ]
