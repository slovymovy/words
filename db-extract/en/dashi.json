                        "entry_id": "d3e6bc45-fd8c-31b2-9e92-1e2d69ee491f",
                        "glosses": [
                            "A type of soup or cooking stock, often made from kelp."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "700160a4-7fb9-4f2f-8273-63940d870e87",
                                "sense_id": "e4855e46-c795-36ba-b78f-e6ca44c01b21",
                                "text": "Kombu (KOHM-boo): This Japanese seaweed is used to make dashi, an Asian soup stock, and to flavor rice and stews."
                            },
                            {
                                "example_id": "7bddf049-b853-4120-bed5-85e0943ebcd2",
                                "sense_id": "e4855e46-c795-36ba-b78f-e6ca44c01b21",
                                "text": "A great dashi (stock) is essential, as it is the crucial element in soups, dipping sauces, nimono (simmered dishes) and nabemono (hotpot dishes), and for cooking fish and vegetables."
                            },
                            {
                                "example_id": "aa32c7e9-d8fb-4a8a-ad19-e057f21ee756",
                                "sense_id": "e4855e46-c795-36ba-b78f-e6ca44c01b21",
                                "text": "Dashi is the basic soup stock for many Japanese dishes including noodle soups."
                            }
                        ]
                    }
