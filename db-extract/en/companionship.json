                                "target_senses": [
                                    {
                                        "sense_id": "9cb5020a-94bf-3dda-95a2-268be2a3f024",
                                        "entry_id": "bdf5d496-372b-31cc-8faa-acf58eae4ad1",
                                        "glosses": [
                                            "Familiarité, union qui existe entre camarades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eebc74b2-7cb8-45ae-94bd-afd21eb957ac",
                                                "sense_id": "9cb5020a-94bf-3dda-95a2-268be2a3f024",
                                                "text": "Cette camaraderie ne sera pas de longue durée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674d482e-fee2-3f5f-9168-9144d8d6f086",
                                        "entry_id": "bdf5d496-372b-31cc-8faa-acf58eae4ad1",
                                        "glosses": [
                                            "Sorte d’entente qui existe entre diverses personnes unies par des rapports d’âge, d’amitié, de profession ou d’intérêts pour se soutenir et se prôner mutuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f5760e-2964-41e7-8cb6-355b5818ffaf",
                                                "sense_id": "674d482e-fee2-3f5f-9168-9144d8d6f086",
                                                "text": "En effet, on ne l’avait jamais vu se fourvoyer dans ces camaraderies des débits de boisson, commencées par les tournées des petits verres et finissant par les rixes sanglantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ec93b18-4823-441f-8ddc-43b64924b652",
                        "source_entry_id": "7898b19b-ff08-346f-898f-37489abc27ed",
                        "source_sense_description": "state of having or being a companion",
                        "target_lang_word": "Kameradschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kameradschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71f89296-4aa0-3639-a4fe-1ee69712fb90",
                                        "entry_id": "2c51a192-e6f3-3e72-bbe6-bee5db780226",
                                        "glosses": [
                                            "früher hauptsächlich zwischen Männern, heute allgemein zwischen Menschen bestehende freundschaftliche Beziehung ohne sexuelle Ansprüche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c378c43-f9b6-4457-96fe-8cf3726237db",
                                                "sense_id": "71f89296-4aa0-3639-a4fe-1ee69712fb90",
                                                "text": "Unsere Kameradschaft war von einem unbedingten Vertrauen zueinander getragen."
                                            },
                                            {
                                                "example_id": "65ee8ade-3507-40d1-b763-af1c8437013d",
                                                "sense_id": "71f89296-4aa0-3639-a4fe-1ee69712fb90",
                                                "text": "Die Kameradschaft und die Hilfsbereitschaft waren wunderbar, eine für alle und alle für eine."
                                            },
                                            {
                                                "example_id": "827cfe44-270f-40bf-bb52-3788a6b225bb",
                                                "sense_id": "71f89296-4aa0-3639-a4fe-1ee69712fb90",
                                                "text": "„All das förderte die Kameradschaft und die Begeisterung für den Nationalsozialismus.“"
                                            },
                                            {
                                                "example_id": "caef58da-fbeb-4aa0-b4a2-9f7f2f6829ee",
                                                "sense_id": "71f89296-4aa0-3639-a4fe-1ee69712fb90",
                                                "text": "„Einstweilen hielt ich oberflächlich gute Kameradschaft mit Sophie, wie ein Mann sie mit einem Jungen hält, den er nicht liebt.“"
                                            },
                                            {
                                                "example_id": "7c775e51-5c11-424a-a7b2-e075b05b6ab4",
                                                "sense_id": "71f89296-4aa0-3639-a4fe-1ee69712fb90",
                                                "text": "„Da geraten einige seiner Geschichten doch arg an den Rand männerbündischer Apologien, selbst der Krieg verliert seine Schrecken, wenn der Autor die Kameradschaft beschwört, die zum großen Erlebnis seiner Figuren geworden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44fc41ae-d87e-3f01-8884-2983023303e3",
                                        "entry_id": "2c51a192-e6f3-3e72-bbe6-bee5db780226",
                                        "glosses": [
                                            "eine Gruppe von Menschen, die Kameraden sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918193f9-7973-4c3a-a779-bd0026e37253",
                                                "sense_id": "44fc41ae-d87e-3f01-8884-2983023303e3",
                                                "text": "Man erinnert sich gerne an die Zeit innerhalb einer Kameradschaft zurück."
                                            },
                                            {
                                                "example_id": "4fc970e0-b547-4d0b-84c1-d5801ead9f07",
                                                "sense_id": "44fc41ae-d87e-3f01-8884-2983023303e3",
                                                "text": "So gesehen waren die Kameradschaften die ersten Sozialvereine in Österreich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
