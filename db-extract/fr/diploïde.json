        "fr-extract.jsonl": [
            {
                "entry_id": "f12439a9-7de8-3a9b-940b-ba9a0c56cf03",
                "word": "diploïde",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "817926a2-4974-46cf-8afc-b0ca44f2fd73",
                        "entry_id": "f12439a9-7de8-3a9b-940b-ba9a0c56cf03",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "diploïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "683b69dc-b7fa-3ec6-bec1-52d136ad360a",
                        "entry_id": "f12439a9-7de8-3a9b-940b-ba9a0c56cf03",
                        "glosses": [
                            "Qui contient un nombre double ou pair (deux fois N) de chromosomes."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "41d513a9-4251-4465-b715-7ce986fa5bdf",
                                "sense_id": "683b69dc-b7fa-3ec6-bec1-52d136ad360a",
                                "text": "Dans un certain nombre de complexes polyploïdes, l'aire du taxon diploïde ancestral n'est pas limitée à une des deux chaînes, mais elle est pyrénéo-alpienne."
                            },
                            {
                                "example_id": "7d3e4b88-206d-4902-84a8-2512a28227f6",
                                "sense_id": "683b69dc-b7fa-3ec6-bec1-52d136ad360a",
                                "text": "Dans chacune des cellules d’un organisme vivant, à l’exception notable des gamètes, chaque chromosome existe en 2 exemplaires, appelés chromosomes homologues. Le nombre de chromosomes présents est alors dit diploïde."
                            },
                            {
                                "example_id": "b5be6ec3-2235-4061-9cd7-1ffe8636f87c",
                                "sense_id": "683b69dc-b7fa-3ec6-bec1-52d136ad360a",
                                "text": "Malgré cette diversité, les animaux ont tous un cycle sexué strictement diploïde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eb7007c-a06f-4554-9466-49d5c0636185",
                        "source_entry_id": "f12439a9-7de8-3a9b-940b-ba9a0c56cf03",
                        "source_sense_id": "683b69dc-b7fa-3ec6-bec1-52d136ad360a",
                        "target_lang_word": "diploid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diploid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00529423-dc4f-3544-b33d-4ae1e0dcbccc",
                                        "entry_id": "9a0a4d69-19ad-35f7-a8e4-20ec46716be3",
                                        "glosses": [
                                            "den Chromosomensatz doppelt enthaltend"
                                        ],
                                        "tags": [
                                            "von Zellen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78555bc2-b1d7-4849-9f9a-9824ff66c4ce",
                                                "sense_id": "00529423-dc4f-3544-b33d-4ae1e0dcbccc",
                                                "text": "So entstanden „Ur-Geschlechtszellen“ (primordiale Keimzellen, PGC): Zellen, aus denen Ei- oder Samenzellen werden können, die aber im Gegensatz zu diesen diploid sind, (noch) einen doppelten Chromosomensatz haben."
                                            },
                                            {
                                                "example_id": "b70f4f1b-c210-41b3-864c-4c7dde797b99",
                                                "sense_id": "00529423-dc4f-3544-b33d-4ae1e0dcbccc",
                                                "text": "Ameisen und Bienen sind haploid/diploid, bestimmen das Geschlecht der Jungen über die Chromosomen-Zahl, Männchen erhalten einen Satz, Weibchen zwei."
                                            },
                                            {
                                                "example_id": "de7d7703-92f2-4074-9421-04cf6e286c3b",
                                                "sense_id": "00529423-dc4f-3544-b33d-4ae1e0dcbccc",
                                                "text": "Dass auch bei Säugetieren Verdopplungen des gesamten Genoms vorkommen, zeigt die Wüstenratte Tympanoctomys barrerae: Sie hat in ihren Zellen einen vierfachen (tetraploiden) Satz statt eines doppelten (diploiden): 102 Chromosomen!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e34f19e-68a4-4f32-95cf-ada664f2174b",
                        "source_entry_id": "f12439a9-7de8-3a9b-940b-ba9a0c56cf03",
                        "source_sense_id": "683b69dc-b7fa-3ec6-bec1-52d136ad360a",
                        "target_lang_word": "diploid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diploid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b93efc2d-fc42-3b0d-ac04-0778144349c2",
                                        "entry_id": "a5741761-d706-3155-8041-8b9f3084af80",
                                        "glosses": [
                                            "Of a cell, having a pair of each type of chromosome, one of the pair being derived from the ovum and the other from the spermatozoon. Most somatic cells of higher organisms are diploid."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "807b2db5-0685-4eaa-a258-69a0c97d8de2",
                                                "sense_id": "b93efc2d-fc42-3b0d-ac04-0778144349c2",
                                                "text": "It has been shown, however, that triploid forms producing diploid gametes in one sex and haploid ones in the other sex can act as a stepping stone towards tetraploidization (triploid bridge; [ 93 – 95 ])."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7936372-23d1-317c-a2b9-2d8f96bac16f",
                                        "entry_id": "a5741761-d706-3155-8041-8b9f3084af80",
                                        "glosses": [
                                            "Of an organism, having diploid cells."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
