                "senses": [
                    {
                        "sense_id": "39328e5f-9f0d-385d-8000-ebc2441faa46",
                        "entry_id": "45524cdf-85ad-38b2-bb9e-1d6a8cdc1936",
                        "glosses": [
                            "Manager eines Hotels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad26cad4-d420-4997-80c8-f94b180b4fe5",
                                "sense_id": "39328e5f-9f0d-385d-8000-ebc2441faa46",
                                "text": "„Das erste, was der Hotelmanager sagte, war, dass ich drei Minuten hätte.“"
                            },
                            {
                                "example_id": "ec9169f3-044a-4b36-a70f-a51bd5e27371",
                                "sense_id": "39328e5f-9f0d-385d-8000-ebc2441faa46",
                                "text": "„Nach dem Frühstück sagte ich dem Hotelmanager, dass ich die Rechnung begleichen wolle.“"
                            },
                            {
                                "example_id": "7ba066af-8923-4782-81d9-9e719da8986b",
                                "sense_id": "39328e5f-9f0d-385d-8000-ebc2441faa46",
                                "text": "„Trotz der Kleidung ließ sich nicht übersehen, dass es sich bei dem Mann um den Hotelmanager des Central handelte.“"
                            },
                            {
                                "example_id": "c9107fa2-4c47-42fc-a3af-3e6289033199",
                                "sense_id": "39328e5f-9f0d-385d-8000-ebc2441faa46",
                                "text": "„So sagte sie dem Mann auf Arabisch, er solle lieber darauf achten, wo er hinfuhr, andernfalls werde sie sich beim Hotelmanager beschweren.“"
                            },
                            {
                                "example_id": "63cd3058-61eb-46ae-813e-e243e7d66143",
                                "sense_id": "39328e5f-9f0d-385d-8000-ebc2441faa46",
                                "text": "„Der Hotelmanager wackelt entschuldigend mit dem Kopf, dann wendet er sich Chika zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
