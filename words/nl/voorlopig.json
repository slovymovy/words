            "senses": [
                {
                    "sense_id": "5a9495e2-001f-37c2-a6fe-44f5fb169990",
                    "sense_definition": "Bedoeld voor een beperkte tijd totdat er iets definitiefs of beters beschikbaar is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is slechts een <w>voorlopige</w> oplossing voor het probleem.",
                            "target_lang_translations": {
                                "ru": "Это лишь <w>временное</w> решение проблемы.",
                                "en": "This is only a <w>temporary</w> solution to the problem.",
                                "pl": "To tylko <w>tymczasowe</w> rozwiązanie problemu.",
                                "de": "Dies ist nur eine <w>vorläufige</w> Lösung für das Problem.",
                                "fr": "Ceci n'est qu'une solution <w>provisoire</w> au problème.",
                                "it": "Questa è solo una soluzione <w>provvisoria</w> al problema.",
                                "cs": "Toto je pouze <w>dočasné</w> řešení problému.",
                                "tr": "Bu, sorun için sadece <w>geçici</w> bir çözüm.",
                                "es": "Esta es solo una solución <w>provisional</w> para el problema.",
                                "zh": "这只是解决该问题的<w>临时</w>方案。"
                            }
                        },
                        {
                            "text": "De <w>voorlopige</w> resultaten van het onderzoek zien er goed uit.",
                            "target_lang_translations": {
                                "ru": "<w>Предварительные</w> результаты исследования выглядят хорошо.",
                                "en": "The <w>preliminary</w> results of the study look good.",
                                "pl": "<w>Wstępne</w> wyniki badań wyglądają dobrze.",
                                "de": "Die <w>vorläufigen</w> Ergebnisse der Untersuchung sehen gut aus.",
                                "fr": "Les résultats <w>préliminaires</w> de l'étude semblent bons.",
                                "it": "I risultati <w>preliminari</w> della ricerca sembrano buoni.",
                                "cs": "<w>Předběžné</w> výsledky výzkumu vypadají dobře.",
                                "tr": "Araştırmanın <w>ön</w> sonuçları iyi görünüyor.",
                                "es": "Los resultados <w>preliminares</w> de la investigación se ven bien.",
                                "zh": "这项研究的<w>初步</w>结果看起来不错。"
                            }
                        }
                    ],
                    "synonyms": [
                        "provisioneel",
                        "tijdelijk"
                    ],
                    "antonyms": [
                        "definitief",
                        "blijvend",
                        "vast"
