                ],
                "senses": [
                    {
                        "sense_id": "1be015fb-7633-38fa-a54a-7ac50d5c7cec",
                        "entry_id": "adf32b13-3a1a-3216-a198-d4f3aab96f6f",
                        "glosses": [
                            "kasteel, plaats versterkt met een gracht, aarden wal en/of zware stenen muren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cfc2c04-d974-4dd9-b017-a417d23dd32f",
                                "sense_id": "1be015fb-7633-38fa-a54a-7ac50d5c7cec",
                                "text": "De Beurs van Berlage is een beetje somber gebouw - meer een donkere burcht dan een modernistisch bouwwerk. De nieuwe, ondergrondse publieksruimte, het resultaat van een forse verbouwing, verandert dat beeld niet. De tentoonstellingsruimte heeft een laag plafond, geen daglicht en de akoestiek is problematisch."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc5708cb-d242-3b2b-9881-531cf2539bc1",
                        "entry_id": "adf32b13-3a1a-3216-a198-d4f3aab96f6f",
                        "glosses": [
                            "ondergronds dierenverblijf met meerdere ingangen van een das, vos, otter, konijn of bever (-> beverburcht, dassenburcht, vossenburcht etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd39a81-bf32-4b33-b4a2-75730fd97fca",
                                "sense_id": "dc5708cb-d242-3b2b-9881-531cf2539bc1",
                                "text": "Nationaal beschermde soorten mogen niet worden gedood of gevangen, stelt de nieuwe wet, en hun leefgebieden mogen niet worden vernietigd. Maar verstoren mag voortaan wel, ook als dat opzettelijk gebeurt. Zo mag een dassenburcht niet worden vernietigd, maar een boer mag bij wijze van spreken wel naast de ingang net zo lang vuurwerk afsteken tot de das zijn burcht verlaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5542502a-5c80-4f9e-bc47-10f87c70a6f7",
                        "source_entry_id": "adf32b13-3a1a-3216-a198-d4f3aab96f6f",
                        "source_sense_id": "1be015fb-7633-38fa-a54a-7ac50d5c7cec",
