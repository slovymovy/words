                ],
                "senses": [
                    {
                        "sense_id": "06f3116f-10a0-3ce0-9ab5-ba429af36d20",
                        "entry_id": "a867dca7-bc73-394e-aab6-1d76262d5146",
                        "glosses": [
                            "Latex; natural rubber."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f36b4271-d2f6-4ed4-88c8-78763fa80a3d",
                                "sense_id": "06f3116f-10a0-3ce0-9ab5-ba429af36d20",
                                "text": "Many a passer-by thought Miss Arundel was listening to some subject of most touching interest: his Lordship was only detailing the benefit he derived one wet day from his caoutchouc cloak."
                            },
                            {
                                "example_id": "e289d80c-2ace-47a0-83fa-ac4f02420dd2",
                                "sense_id": "06f3116f-10a0-3ce0-9ab5-ba429af36d20",
                                "text": "Resin, pitch, sealing-wax, caoutchouc, sulphur, gutta-percha, and generally all bodies commonly termed resinous, besides a great variety of others, will be found to acquire, after friction, the power of attracting light bodies, and hence will be said, according to a limitation of terms already accepted, to be in an electrized or electrified state ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2d3c041-b09b-431c-838d-d6de879cb9cf",
                        "source_entry_id": "a867dca7-bc73-394e-aab6-1d76262d5146",
                        "source_sense_id": "06f3116f-10a0-3ce0-9ab5-ba429af36d20",
