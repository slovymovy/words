{
    "word_family": [
        "overwhelm",
        "overwhelmingly",
        "overwhelmed"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "678bd0e6-1cff-30cd-811f-cd44a90f66e3",
                    "sense_definition": "Very great in amount, number, or intensity, often to the point of being difficult to deal with or resist.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate won the election with an <w>overwhelming</w> majority of the votes.",
                            "target_lang_translations": {
                                "ru": "Кандидат победил на выборах с <w>подавляющим</w> большинством голосов."
                            }
                        },
                        {
                            "text": "She felt an <w>overwhelming</w> sense of relief when she heard the good news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>непреодолимое</w> чувство облегчения, когда услышала хорошие новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweeping"
                    ],
                    "antonyms": [
                        "underwhelming"
                    ],
                    "common_phrases": [
                        "overwhelming majority",
                        "overwhelming evidence",
                        "overwhelming success",
                        "overwhelming response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой по количеству, числу или интенсивности, часто до такой степени, что с этим трудно справиться или сопротивляться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавляющий",
                                "target_lang_sense_clarification": "о большинстве или силе"
                            },
                            {
                                "target_lang_word": "ошеломляющий",
                                "target_lang_sense_clarification": "вызывающий сильное потрясение"
                            },
                            {
                                "target_lang_word": "непреодолимый",
                                "target_lang_sense_clarification": "о чувстве или желании"
                            },
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "о количестве или успехе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27d9538f-7c69-3ed8-b5ed-9533a6447f1a",
                    "sense_definition": "The present participle and gerund of <w>overwhelm</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer volume of work is <w>overwhelming</w> the new staff members.",
                            "target_lang_translations": {
                                "ru": "Огромный объем работы <w>перегружает</w> новых сотрудников."
                            }
                        },
                        {
                            "text": "By <w>overwhelming</w> the enemy defenses, the army secured a quick victory.",
                            "target_lang_translations": {
                                "ru": "<w>Сокрушив</w> оборону противника, армия обеспечила быструю победу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «overwhelm» (сокрушать, перегружать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокрушающий",
                                "target_lang_sense_clarification": "о силе или армии"
                            },
                            {
                                "target_lang_word": "перегружающий",
                                "target_lang_sense_clarification": "о работе или информации"
                            },
                            {
                                "target_lang_word": "подавляющий",
                                "target_lang_sense_clarification": "о сопротивлении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40da0768-b975-3efb-a830-929dbecf2d11",
                    "sense_definition": "An instance or situation of being completely overcome or overpowered.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book describes the various <w>overwhelmings</w> that have shaped human history, such as famine and war.",
                            "target_lang_translations": {
                                "ru": "В книге описываются различные <w>потрясения</w>, сформировавшие человеческую историю, такие как голод и война."
                            }
                        },
                        {
                            "text": "He struggled to cope with the emotional <w>overwhelming</w> caused by the sudden loss.",
                            "target_lang_translations": {
                                "ru": "Ему было трудно справиться с эмоциональным <w>потрясением</w>, вызванным внезапной потерей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или ситуация полного подавления или переполнения чувствами/событиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясение",
                                "target_lang_sense_clarification": "эмоциональное состояние"
                            },
                            {
                                "target_lang_word": "подавление",
                                "target_lang_sense_clarification": "процесс преодоления сопротивления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}