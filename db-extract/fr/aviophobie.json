                "senses": [
                    {
                        "sense_id": "965424b3-e802-3d86-b467-eff7e0ea6549",
                        "entry_id": "ed5196fb-4e4e-3b61-acad-b0eecd260521",
                        "glosses": [
                            "Peur irraisonnée de prendre l’avion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d34e1d4-a2a6-4ef1-904a-a603ab009e50",
                                "sense_id": "965424b3-e802-3d86-b467-eff7e0ea6549",
                                "text": "— Oh ! avoir peur de l'avion, c'est un phobie banale. Ça s'appelle aviophobie, aviatophobie, aérodromphobie ou ptéroméchanophobie.\nIl éclate de rire.\n— Et qu'est-on censé faire lorsqu'on souffre d’aviophobie, d’aviatophobie, d’aérodromphobie ou de ptéroméchanophobie ?\n— Ne te moque pas de mon savoir incommensurable sur les phobies, dis-je en lui donnant un coup de coude."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd31d22a-3aa0-489e-b199-17cc83fe0c75",
                        "source_entry_id": "ed5196fb-4e4e-3b61-acad-b0eecd260521",
                        "source_sense_id": "965424b3-e802-3d86-b467-eff7e0ea6549",
                        "target_lang_word": "Flugangst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugangst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7186a2f8-82c4-358a-8e9c-27c24c4b2878",
                                        "entry_id": "7f85cd77-18a6-3b8b-aea8-0050aae29355",
                                        "glosses": [
                                            "krankhafte Angst vor dem Fliegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51835d07-150c-4deb-89ac-b56b3b621df8",
                                                "sense_id": "7186a2f8-82c4-358a-8e9c-27c24c4b2878",
                                                "text": "„Flugangst ist eine erlernte Angst, die man wieder verlernen kann“, sagt die Flugbegleiterin und Psychologin Karin Bonner."
                                            },
                                            {
                                                "example_id": "41a9050c-5b5a-483e-b81b-6ac57a35a820",
                                                "sense_id": "7186a2f8-82c4-358a-8e9c-27c24c4b2878",
                                                "text": "Wer dennoch kurz vor dem Gate in Panik gerät, kann beim Flughafenarzt oder bei so genannten Flugangst-Ambulanzen eine Kurzfristberatung gegen Flugangst erhalten, so Trautmann."
                                            },
                                            {
                                                "example_id": "d1b18b20-8c9c-4049-be2b-16a8321d5932",
                                                "sense_id": "7186a2f8-82c4-358a-8e9c-27c24c4b2878",
                                                "text": "Eine einzige Ausnahme gibt es: sich zur Flugangst zu bekennen, ficht den Machisten in seinem virilen Mythos nicht an."
                                            },
                                            {
                                                "example_id": "932ad4b7-1876-4571-a155-d1518bd8d575",
                                                "sense_id": "7186a2f8-82c4-358a-8e9c-27c24c4b2878",
                                                "text": "Wer unter Flugangst leidet, schwört sich nach jedem spektakulären Unfall, nur noch Zug zu fahren."
                                            },
                                            {
                                                "example_id": "c09321d9-aec8-4199-b4d8-d7adb06712dd",
                                                "sense_id": "7186a2f8-82c4-358a-8e9c-27c24c4b2878",
                                                "text": "Begleitet wird die Geschichte von zwei Flugenten, von denen eine Flugangst hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
