    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e35047f2-a6e2-378c-b986-8f30214ad835",
                    "sense_definition": "Столкновение противоположных сторон, мнений или сил; серьёзное разногласие между людьми.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clash_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У них возник серьёзный <w>конфликт</w> из-за денег.",
                            "target_lang_translations": {
                                "en": "They had a serious <w>conflict</w> over money.",
                                "tr": "Para yüzünden aralarında ciddi bir <w>çatışma</w> çıktı."
                            }
                        },
                        {
                            "text": "Мы стараемся решать любой <w>конфликт</w> мирным путём.",
                            "target_lang_translations": {
                                "en": "We try to resolve any <w>conflict</w> peacefully.",
                                "tr": "Her türlü <w>anlaşmazlığı</w> barışçıl yollarla çözmeye çalışıyoruz."
                            }
                        }
                    ],
                    "synonyms": [
                        "ссора",
                        "распря"
                    ],
                    "antonyms": [
                        "согласие",
                        "примирение",
                        "гармония"
                    ],
                    "common_phrases": [
                        "вступить в конфликт",
                        "разрешение конфликта",
                        "избегать конфликтов",
                        "семейный конфликт"
                    ],
                    "target_lang_definitions": {
                        "en": "A clash of opposing sides, opinions, or forces; a serious disagreement between people.",
                        "tr": "Karşıt tarafların, fikirlerin veya güçlerin çatışması; insanlar arasında ciddi anlaşmazlık."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conflict",
                                "target_lang_sense_clarification": "disagreement or argument"
                            },
                            {
                                "target_lang_word": "clash",
                                "target_lang_sense_clarification": "confrontation"
                            },
                            {
                                "target_lang_word": "disagreement",
                                "target_lang_sense_clarification": "difference of opinion"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çatışma",
                                "target_lang_sense_clarification": "fikir veya çıkar ayrılığı"
                            },
                            {
                                "target_lang_word": "anlaşmazlık",
                                "target_lang_sense_clarification": "uyuşmazlık, fikir ayrılığı"
                            },
                            {
                                "target_lang_word": "ihtilaf",
                                "target_lang_sense_clarification": "anlaşmazlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae677f27-8a55-34b1-a9a1-9f85f55cb197",
                    "sense_definition": "Острое политическое или военное столкновение между государствами или социальными группами.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "clash_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вооружённый <w>конфликт</w> на границе длился несколько месяцев.",
                            "target_lang_translations": {
                                "en": "The armed <w>conflict</w> on the border lasted for several months.",
                                "tr": "Sınırdaki silahlı <w>çatışma</w> birkaç ay sürdü."
                            }
                        },
                        {
                            "text": "Дипломаты пытаются урегулировать этот затяжной <w>конфликт</w>.",
                            "target_lang_translations": {
                                "en": "Diplomats are trying to settle this protracted <w>conflict</w>.",
                                "tr": "Diplomatlar bu uzun süren <w>anlaşmazlığı</w> çözmeye çalışıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "противостояние",
                        "междоусобица"
                    ],
                    "common_phrases": [
                        "вооружённый конфликт",
                        "военный конфликт",
                        "межнациональный конфликт",
                        "локальный конфликт"
                    ],
                    "target_lang_definitions": {
                        "en": "An acute political or military clash between states or social groups.",
                        "tr": "Devletler veya toplumsal gruplar arasında şiddetli siyasi veya askeri çatışma."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conflict",
                                "target_lang_sense_clarification": "armed or political struggle"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çatışma",
                                "target_lang_sense_clarification": "askeri veya siyasi mücadele"
                            },
                            {
                                "target_lang_word": "anlaşmazlık",
                                "target_lang_sense_clarification": "siyasi uyuşmazlık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf0600d-353d-3d8d-8677-e3a5cc0fd567",
                    "sense_definition": "Противоречие или несоответствие между чем-либо (законами, интересами, внутренними убеждениями).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "clash_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой ситуации налицо явный <w>конфликт</w> интересов.",
                            "target_lang_translations": {
                                "en": "There is a clear <w>conflict</w> of interest in this situation.",
                                "tr": "Bu durumda açık bir çıkar <w>çatışması</w> var."
                            }
                        },
                        {
                            "text": "Новое правило создаёт <w>конфликт</w> с действующим законодательством.",
                            "target_lang_translations": {
                                "en": "The new rule creates a <w>conflict</w> with existing legislation.",
                                "tr": "Yeni kural, yürürlükteki mevzuatla <w>çelişki</w> yaratıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "противоречие"
                    ],
                    "antonyms": [
                        "единство",
                        "гармония"
                    ],
                    "common_phrases": [
                        "конфликт интересов",
                        "внутренний конфликт",
                        "конфликт с законом"
                    ],
                    "target_lang_definitions": {
                        "en": "A contradiction or inconsistency between things (such as laws, interests, or internal beliefs).",
                        "tr": "Unsurlar arasında (yasalar, çıkarlar, iç inançlar) çelişki veya uyumsuzluk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conflict",
                                "target_lang_sense_clarification": "incompatibility"
                            },
                            {
                                "target_lang_word": "clash",
                                "target_lang_sense_clarification": "mismatch or inconsistency"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çatışma",
                                "target_lang_sense_clarification": "çıkarların veya kuralların çakışması"
                            },
                            {
                                "target_lang_word": "uyuşmazlık",
                                "target_lang_sense_clarification": "uyumsuzluk, çelişki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff2d0ba1-2820-36b1-a850-933169c1ccb2",
                    "sense_definition": "Ситуация, в которой цели участников не совпадают (в математике, теории игр, психологии).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clash_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Теория игр изучает <w>конфликт</w> как математическую модель.",
                            "target_lang_translations": {
                                "en": "Game theory studies <w>conflict</w> as a mathematical model.",
                                "tr": "Oyun teorisi, <w>çatışmayı</w> matematiksel bir model olarak inceler."
                            }
                        },
                        {
                            "text": "В этой задаче рассматривается <w>конфликт</w> двух игроков с противоположными стратегиями.",
                            "target_lang_translations": {
                                "en": "This problem considers a <w>conflict</w> between two players with opposing strategies.",
                                "tr": "Bu problemde, zıt stratejilere sahip iki oyuncunun <w>çatışması</w> ele alınmaktadır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "теория конфликта"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A situation in which the goals of participants do not coincide (in mathematics, game theory, psychology).",
                        "tr": "Katılımcıların hedeflerinin örtüşmediği durum (matematik, oyun teorisi, psikolojide)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conflict",
                                "target_lang_sense_clarification": "theoretical model"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çatışma",
                                "target_lang_sense_clarification": "teorik veya matematiksel model"
                            }
                        ]
                    }
                }
            ]
        }
    ]
