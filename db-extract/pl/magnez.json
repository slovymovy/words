                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7fe803e-4497-3959-923c-87ff0d89bd50",
                                        "entry_id": "cecb32af-d49b-368d-95bc-c1558ca6902c",
                                        "glosses": [
                                            "The chemical element with an atomic number of 12. It is a light, easily flammable, silvery-white alkaline earth metal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95d0809e-8ca1-4c04-867d-95b1dc5bcdf5",
                                                "sense_id": "d7fe803e-4497-3959-923c-87ff0d89bd50",
                                                "text": "1999, Chapter 1 \"Barrens\" Cryptonomicon by Neal Stephenson\nThe building looked only like a wall glowing in the firelight, but sometimes a barrage of magnesium blue light made its windowframes jump out of the darkness."
                                            },
                                            {
                                                "example_id": "95576054-ee51-4bc7-b4dd-212695233f24",
                                                "sense_id": "d7fe803e-4497-3959-923c-87ff0d89bd50",
                                                "text": "A sample of carbon removed from the ocean in the solid form of calcium carbonate and magnesium hydroxide from UCLA's SeaChange program -- now known as Equatic -- in 2023."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e48b0f9-304c-4895-a52a-e4587e745acb",
                        "source_entry_id": "fe2fb67a-19ea-31f2-b213-8cdef3561a65",
                        "source_sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
