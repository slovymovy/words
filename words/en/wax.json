{
    "word_family": [
        "waxen",
        "waxy",
        "waxwork"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fede9b1a-c62e-3d1c-8f33-60277cdff2f9",
                    "sense_definition": "A solid, slightly shiny substance made by bees or produced from petroleum, used for making candles, polish, or models.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle dripped hot <w>wax</w> onto the wooden table during the dinner.",
                            "target_lang_translations": {
                                "ru": "Во время ужина свеча капала горячим <w>воском</w> на деревянный стол.",
                                "zh": "晚餐时，蜡烛滴下的热<w>蜡</w>落在了木桌上。"
                            }
                        },
                        {
                            "text": "Bees produce <w>wax</w> to build the honeycomb structures inside their hives.",
                            "target_lang_translations": {
                                "ru": "Пчелы вырабатывают <w>воск</w> для строительства сот внутри своих ульев.",
                                "zh": "蜜蜂分泌<w>蜡</w>来建造蜂巢内部的蜂窝结构。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beeswax",
                        "paraffin"
                    ],
                    "common_phrases": [
                        "candle wax",
                        "sealing wax",
                        "paraffin wax"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое, слегка блестящее вещество, вырабатываемое пчелами или получаемое из нефти, используемое для изготовления свечей, полироли или моделей.",
                        "zh": "一种由蜜蜂产生或从石油中提取的固体、略带光泽的物质，用于制作蜡烛、抛光剂或模型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воск",
                                "target_lang_sense_clarification": "вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜡",
                                "target_lang_sense_clarification": "物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "166638f0-76ec-3c6e-bffc-0434ea7182d5",
                    "sense_definition": "A substance containing wax used to polish and protect floors, cars, or furniture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "polish_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a tin of <w>wax</w> to make his old car shine like new.",
                            "target_lang_translations": {
                                "ru": "Он купил банку <w>воска</w>, чтобы его старая машина засияла как новая.",
                                "zh": "他买了一罐车<w>蜡</w>，让他的旧车看起来像新的一样闪亮。"
                            }
                        },
                        {
                            "text": "The janitor applied a coat of <w>wax</w> to the school hallway floors.",
                            "target_lang_translations": {
                                "ru": "Уборщик нанес слой <w>мастики</w> на полы в школьном коридоре.",
                                "zh": "清洁工给学校走廊的地板上了一层<w>地板蜡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polish"
                    ],
                    "common_phrases": [
                        "floor wax",
                        "car wax"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, содержащее воск, используемое для полировки и защиты полов, автомобилей или мебели.",
                        "zh": "含有蜡的物质，用于抛光和保护地板、汽车或家具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воск",
                                "target_lang_sense_clarification": "средство для полировки"
                            },
                            {
                                "target_lang_word": "мастика",
                                "target_lang_sense_clarification": "для полов"
                            },
                            {
                                "target_lang_word": "полироль",
                                "target_lang_sense_clarification": "жидкое средство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜡",
                                "target_lang_sense_clarification": "抛光剂"
                            },
                            {
                                "target_lang_word": "地板蜡",
                                "target_lang_sense_clarification": "用于地板"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e8eed93-044d-373d-8952-aacb3ad3ca98",
                    "sense_definition": "A yellow sticky substance produced naturally inside the ear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor used a small tool to remove the excess <w>wax</w> from the patient's ear.",
                            "target_lang_translations": {
                                "ru": "Врач использовал маленький инструмент, чтобы удалить излишки <w>серы</w> из уха пациента.",
                                "zh": "医生用一个小工具清除了病人耳朵里多余的<w>耳垢</w>。"
                            }
                        },
                        {
                            "text": "Using cotton swabs can sometimes push the <w>wax</w> deeper into the ear canal.",
                            "target_lang_translations": {
                                "ru": "Использование ватных палочек иногда может протолкнуть <w>серу</w> глубже в ушной канал.",
                                "zh": "使用棉签有时会把<w>耳垢</w>推向耳道深处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "earwax",
                        "cerumen"
                    ],
                    "common_phrases": [
                        "ear wax"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтое липкое вещество, естественным образом вырабатываемое внутри уха.",
                        "zh": "耳朵内自然产生的黄色粘性物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сера",
                                "target_lang_sense_clarification": "ушная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耳垢",
                                "target_lang_sense_clarification": "耳屎"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5d3e9dd-ee35-3cd9-b47a-a94c25d5ca90",
                    "sense_definition": "A phonograph record, typically made of vinyl.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ has a huge collection of classic hip-hop tracks on <w>wax</w>.",
                            "target_lang_translations": {
                                "ru": "У диджея есть огромная коллекция классических хип-хоп треков на <w>виниле</w>.",
                                "zh": "这位DJ收藏了海量的经典嘻哈<w>黑胶唱片</w>。"
                            }
                        },
                        {
                            "text": "Musicians in the fifties were eager to get their hit songs recorded on <w>wax</w>.",
                            "target_lang_translations": {
                                "ru": "Музыканты в пятидесятых жаждали записать свои хиты на <w>пластинки</w>.",
                                "zh": "五十年代的音乐家们都渴望将他们的热门歌曲录制成<w>唱片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vinyl",
                        "record"
                    ],
                    "common_phrases": [
                        "put on wax"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "music industry context"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "referring to vinyl records"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грампластинка, обычно сделанная из винила.",
                        "zh": "唱片，通常由黑胶制成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "винил",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "пластинка",
                                "target_lang_sense_clarification": "музыкальный носитель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑胶唱片",
                                "target_lang_sense_clarification": "音乐载体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecd6a47d-f13f-3635-b496-24a32bbefff8",
                    "sense_definition": "A concentrated form of cannabis, often having a sticky, wax-like consistency.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drug_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer found a small amount of <w>wax</w> in the suspect's pocket.",
                            "target_lang_translations": {
                                "ru": "Полицейский нашел небольшое количество <w>вакса</w> в кармане подозреваемого.",
                                "zh": "警察在嫌疑人的口袋里发现了一小块<w>大麻蜡</w>。"
                            }
                        },
                        {
                            "text": "He was arrested for possession of illegal drugs, including marijuana and <w>wax</w>.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за хранение запрещенных наркотиков, включая марихуану и <w>вакс</w>.",
                                "zh": "他因持有非法毒品被捕，其中包括大麻和<w>大麻蜡</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "drug culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Концентрированная форма каннабиса, часто имеющая липкую, воскообразную консистенцию.",
                        "zh": "一种浓缩形式的大麻，通常具有粘稠的蜡状质地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вакс",
                                "target_lang_sense_clarification": "наркотический сленг"
                            },
                            {
                                "target_lang_word": "концентрат",
                                "target_lang_sense_clarification": "марихуаны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大麻蜡",
                                "target_lang_sense_clarification": "毒品浓缩物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc0ada9-2787-3997-be18-0ba83e259c4a",
                    "sense_definition": "A fit of anger or rage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father was in a terrible <w>wax</w> when he found out I had dented his car.",
                            "target_lang_translations": {
                                "ru": "Мой отец был в жуткой <w>ярости</w>, когда узнал, что я помял его машину.",
                                "zh": "当我父亲发现我把他的车撞凹了时，他<w>大发雷霆</w>。"
                            }
                        },
                        {
                            "text": "Don't put him in a <w>wax</w> by asking too many annoying questions right now.",
                            "target_lang_translations": {
                                "ru": "Не приводи его в <w>бешенство</w>, задавая слишком много раздражающих вопросов прямо сейчас.",
                                "zh": "现在别问那么多烦人的问题，免得让他<w>发火</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a wax"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British English"
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приступ гнева или ярости.",
                        "zh": "一阵愤怒或狂怒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярость",
                                "target_lang_sense_clarification": "гнев"
                            },
                            {
                                "target_lang_word": "бешенство",
                                "target_lang_sense_clarification": "состояние гнева"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大发雷霆",
                                "target_lang_sense_clarification": "愤怒状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87d3995c-4470-314c-a12c-c2921c3f8aa2",
                    "sense_definition": "To apply a layer of wax to a surface to protect it or make it shiny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "polish_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole Saturday afternoon washing and <w>waxing</w> the family car.",
                            "target_lang_translations": {
                                "ru": "Мы провели всю субботу, моя и <w>натирая воском</w> семейный автомобиль.",
                                "zh": "我们整个周六下午都在洗车和给家里的车<w>打蜡</w>。"
                            }
                        },
                        {
                            "text": "You should <w>wax</w> the wooden floors once a year to keep them looking good.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>натирать воском</w> деревянные полы раз в год, чтобы они хорошо выглядели.",
                                "zh": "你应该每年给木地板<w>打蜡</w>一次，以保持它们的美观。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polish",
                        "shine",
                        "buff"
                    ],
                    "common_phrases": [
                        "wax the car",
                        "wax the floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить слой воска на поверхность, чтобы защитить ее или придать ей блеск.",
                        "zh": "在表面涂上一层蜡以保护它或使其发亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натирать воском",
                                "target_lang_sense_clarification": "полировать"
                            },
                            {
                                "target_lang_word": "вощить",
                                "target_lang_sense_clarification": "обрабатывать воском"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打蜡",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea11ab98-249f-3a04-bb56-e20652a5aed3",
                    "sense_definition": "To remove hair from the body by covering the skin with hot wax and pulling it off.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>wax</w> her legs before going on vacation to the beach.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>сделать эпиляцию воском</w> на ногах перед поездкой в отпуск на пляж.",
                                "zh": "她决定在去海滩度假前给腿部做<w>蜜蜡脱毛</w>。"
                            }
                        },
                        {
                            "text": "It can be quite painful to <w>wax</w> sensitive areas of the skin for the first time.",
                            "target_lang_translations": {
                                "ru": "Может быть довольно больно <w>удалять воском</w> волосы на чувствительных участках кожи в первый раз.",
                                "zh": "第一次给敏感部位的皮肤做<w>蜜蜡脱毛</w>可能会很疼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wax legs",
                        "wax eyebrows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять волосы с тела, покрывая кожу горячим воском и срывая его.",
                        "zh": "通过在皮肤上涂抹热蜡并将其撕掉来去除体毛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать эпиляцию воском",
                                "target_lang_sense_clarification": "процедура"
                            },
                            {
                                "target_lang_word": "удалять воском",
                                "target_lang_sense_clarification": "волосы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蜜蜡脱毛",
                                "target_lang_sense_clarification": "美容程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "338498f2-f709-3397-a92d-4abc75e94b7d",
                    "sense_definition": "To increase in size, strength, or brightness, especially referring to the moon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The moon will <w>wax</w> over the next two weeks until it becomes full.",
                            "target_lang_translations": {
                                "ru": "Луна будет <w>прибывать</w> в течение следующих двух недель, пока не станет полной.",
                                "zh": "在接下来的两周里，月亮会逐渐<w>盈</w>满，直到变成满月。"
                            }
                        },
                        {
                            "text": "Public interest in the political scandal seems to <w>wax</w> and wane with every new report.",
                            "target_lang_translations": {
                                "ru": "Общественный интерес к политическому скандалу, кажется, то <w>растет</w>, то убывает с каждым новым отчетом.",
                                "zh": "公众对这起政治丑闻的兴趣似乎随着每一份新报告的出现而时<w>涨</w>时落。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grow"
                    ],
                    "antonyms": [
                        "wane"
                    ],
                    "common_phrases": [
                        "wax and wane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться в размере, силе или яркости, особенно говоря о луне.",
                        "zh": "指尺寸、强度或亮度增加，尤指月亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибывать",
                                "target_lang_sense_clarification": "о луне"
                            },
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "увеличиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盈",
                                "target_lang_sense_clarification": "月亮变圆"
                            },
                            {
                                "target_lang_word": "增长",
                                "target_lang_sense_clarification": "变大或变强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cafaac1-2728-3b69-bd81-e9674589cb79",
                    "sense_definition": "To speak or write at length in a specific, often emotional or descriptive, manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "speech_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather likes to <w>wax</w> nostalgic about his adventures in the navy.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка любит <w>предаваться</w> ностальгии о своих приключениях на флоте.",
                                "zh": "我祖父喜欢<w>抒发</w>对他在海军服役时冒险经历的怀念之情。"
                            }
                        },
                        {
                            "text": "The food critic began to <w>wax</w> lyrical about the flavor of the soup.",
                            "target_lang_translations": {
                                "ru": "Критик еды начал <w>рассыпаться</w> в лирических восторгах о вкусе супа.",
                                "zh": "美食评论家开始对汤的味道<w>大加赞赏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "become"
                    ],
                    "common_phrases": [
                        "wax poetic",
                        "wax lyrical",
                        "wax nostalgic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать пространно в определенной, часто эмоциональной или описательной манере.",
                        "zh": "以特定的、通常是情感化或描述性的方式长篇大论地说话或写作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предаваться",
                                "target_lang_sense_clarification": "воспоминаниям, рассуждениям"
                            },
                            {
                                "target_lang_word": "рассыпаться",
                                "target_lang_sense_clarification": "в похвалах, лирике"
