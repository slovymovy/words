                        "examples": [
                            {
                                "example_id": "ad0461bb-8780-48fd-b01c-0eb3520548af",
                                "sense_id": "ba6dbfe6-d466-3dfd-8961-82daca47a67e",
                                "text": "„Der Torwart der Nigerianer kratzte überraschenderweise einige von Messis Schüssen aus dem angepeilten Kreuzeck.“"
                            },
                            {
                                "example_id": "ddcad318-bb36-4381-b366-366d1382bb14",
                                "sense_id": "ba6dbfe6-d466-3dfd-8961-82daca47a67e",
                                "text": "„Hätte nicht Philipp Lahm nach sechs Minuten gegen Costa Rica mit seinem herrlichen Schlenzer ins Kreuzeck den Optimismus des deutschen Publikums bestätigt und in Euphorie umgewandelt, wer weiß, was geschehen wäre?“"
                            },
                            {
                                "example_id": "7429775b-5295-463a-ac85-fdb40e0a8f29",
                                "sense_id": "ba6dbfe6-d466-3dfd-8961-82daca47a67e",
                                "text": "„Gut, der Ball ging über die Latte statt ins Kreuzeck. Aber beim Stand von eins zu null ist das nicht weiter dramatisch.“"
                            }
                        ],
