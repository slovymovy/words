                ],
                "senses": [
                    {
                        "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                        "entry_id": "c9b14d8f-5939-3314-9a6d-01b65a45bdf8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae1d8461-faab-4bf7-8673-fdddc75577c8",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Frau Stölzl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "39cfb8ac-3cf4-4b77-9fb9-2129d8d340aa",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Herr Stölzl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5360b198-fbcc-400c-8e93-c8653eca2374",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Die Stölzls fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "b742ab1a-4cc7-424b-be31-45cb1b212c16",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Der Stölzl trägt nie die Pullover, die die Stölzl ihm strickt."
                            },
                            {
                                "example_id": "4dcea99b-3857-4251-bcca-ff364929ded2",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stölzl kommt, geht der Herr Stölzl.“"
                            },
                            {
                                "example_id": "c9f743b0-6702-4d07-a5b6-ebc878c63500",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Stölzl kommt und geht."
                            },
                            {
                                "example_id": "fd90f5d1-2079-41f1-841a-de14cd56ee34",
                                "sense_id": "e5d7f44e-2fe3-3b5d-8c3b-59819432b0ce",
                                "text": "Stölzls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
