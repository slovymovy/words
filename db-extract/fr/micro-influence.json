                "senses": [
                    {
                        "sense_id": "2aa0c2d0-a67e-33ce-b914-7435b2d2b65e",
                        "entry_id": "f8f9cd20-8107-37ad-95f4-e46e9e77bcdf",
                        "glosses": [
                            "Influence d’une personne sur un réseau social, mais qui reste relativement modérée : personne suivie par 10000 personnes, par exemple (pour donner un ordre de grandeur)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01ad3d5-ff09-455d-a858-24b7d38d073a",
                                "sense_id": "2aa0c2d0-a67e-33ce-b914-7435b2d2b65e",
                                "text": "Pour bénéficier d’une vaste exposition à moindre prix, les enseignes s’appuient sur la « micro-influence » : des partenariats avec des personnes suivies sur les réseaux sociaux par un petit nombre d’abonnés, mais qui bénéficient d’une proximité et d’une confiance plus forte de leur communauté."
                            },
                            {
                                "example_id": "eb0afa68-a66d-4425-9244-e7bf776055b5",
                                "sense_id": "2aa0c2d0-a67e-33ce-b914-7435b2d2b65e",
                                "text": "Un autre aspect important de la micro-influence est que, le plus souvent, il ne s’agit pas d'un “influenceur professionnel” au sens propre du terme."
                            },
                            {
                                "example_id": "3ba6b4f9-d071-4bfd-b628-3f27448dfa45",
                                "sense_id": "2aa0c2d0-a67e-33ce-b914-7435b2d2b65e",
                                "text": "Les entreprises peuvent les contacter directement, normalement via les coordonnées indiquées sur le réseau social : s’ils sont déjà actifs dans la micro-influence, ils auront sûrement indiqué un moyen pour les joindre."
                            }
                        ]
                    }
                ],
