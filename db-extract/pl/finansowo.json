                                        "sense_id": "133055d6-f141-3ac1-9982-b0b9e3e36641",
                                        "entry_id": "57d3a8ae-b77d-32c2-85a3-1f1be40fc700",
                                        "glosses": [
                                            "met betrekking tot geld, geldelijk"
                                        ],
