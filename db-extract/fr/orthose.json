                    {
                        "sense_id": "ad9ab54c-ffb6-3096-bcf5-b668039dac23",
                        "entry_id": "8ff4596e-228a-31ad-8d2f-9a1d40264756",
                        "glosses": [
                            "Espèce du groupe des silicates, sous-groupe des tectosilicates, famille des feldspaths sous-famille des feldspaths potassiques, dont la composition chimique est KAlSi₃O₈."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2fe442-76ba-4670-aef9-73e9c92028a8",
                                "sense_id": "ad9ab54c-ffb6-3096-bcf5-b668039dac23",
                                "text": "L’orthose obtenu par ce sel est en cristaux toujours maclés; ils diffèrent en cela de ceux précédemment décrits. Ils sont tous hyalins comme l’adulaire , quoiqu’ils ressemblent peu aux cristaux de cette variété ."
                            },
                            {
                                "example_id": "ec1a6231-3a16-417c-8418-05390af55f59",
                                "sense_id": "ad9ab54c-ffb6-3096-bcf5-b668039dac23",
                                "text": "Les bandes feldspathiques sont composées d’une mosaïque de petits cristaux pseudo-rectangulaires d’orthose (oligoclase rare) avec peu de quartz."
                            }
                        ]
                    }
                ],
