                    ],
                    "synonyms": [
                        "menottes"
                    ],
                    "common_phrases": [
                        "passer les bracelets"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argotique ou familier"
                        }
                    ]
                },
                {
                    "sense_id": "dcce1bdd-b8f7-3e90-bda3-7231ab7652ba",
                    "sense_definition": "Bande protectrice en cuir portée autour du bras ou du poignet pour soutenir l'effort de certains ouvriers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan ajustait son <w>bracelet</w> en cuir épais avant de soulever les lourdes charges."
                        },
                        {
                            "text": "Le port d'un <w>bracelet</w> de force soulage l'articulation de l'ouvrier durant son travail."
                        }
                    ],
                    "common_phrases": [
                        "bracelet de force"
                    ]
                },
                {
                    "sense_id": "454e6035-c375-345a-90f0-1d24b98f0cae",
                    "sense_definition": "Collier ou bague plastique fixé sur un animal abattu pour contrôler le respect du plan de chasse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marquage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde-chasse a immédiatement apposé un <w>bracelet</w> sur le grand cerf abattu."
                        },
                        {
                            "text": "Chaque chasseur doit obligatoirement valider son <w>bracelet</w> de tir avant de transporter le gibier."
                        }
                    ],
                    "synonyms": [
                        "bague"
                    ],
                    "common_phrases": [
                        "bracelet de marquage"
                    ]
                },
                {
                    "sense_id": "a27072d0-6ec4-32f6-aa89-aa55a5f5fba7",
                    "sense_definition": "Cercle métallique placé à l'extrémité supérieure d'un fourreau pour le consolider.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>bracelet</w> en laiton de ce vieux sabre d'officier est finement ouvragé."
                        },
                        {
                            "text": "Le restaurateur d'armes anciennes a soigneusement poli le <w>bracelet</w> du fourreau."
                        }
                    ]
                },
                {
                    "sense_id": "10833ac7-7d11-3baf-b693-62ac16b08c00",
                    "sense_definition": "Plongeon acrobatique exécuté avec les poignets joints ou attachés.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune athlète a tenté un <w>bracelet</w> spectaculaire du haut du plongeoir de dix mètres."
                        },
                        {
                            "text": "Ce plongeur chevronné maîtrise parfaitement la technique difficile du <w>bracelet</w>."
                        }
                    ]
                }
            ]
        }
    ]
