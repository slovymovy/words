                        ],
                        "examples": [
                            {
                                "example_id": "d1e6dc0d-a0e3-4793-94a4-49eff0d6cb64",
                                "sense_id": "12218dc8-c954-3dd0-802b-0287ef974868",
                                "text": "the reciprocation of kindness"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2b46291-4af4-3685-ac92-14e2f3df9942",
                        "entry_id": "de2370fa-f48a-3dfd-ab90-a425ca43aebb",
                        "glosses": [
                            "Alternate recurrence or action; as, the reciprocation of the sea in the flow and ebb of tides; oscillation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "171a73fe-932f-4b13-8d96-8bd38721f2ab",
                                "sense_id": "e2b46291-4af4-3685-ac92-14e2f3df9942",
                                "text": "... the same pendulum alwayes maketh its reciprocations in equall times."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73badf02-fcb9-4724-a789-006c7675f523",
                        "source_entry_id": "de2370fa-f48a-3dfd-ab90-a425ca43aebb",
                        "source_sense_description": "Translations",
                        "target_lang_word": "réciprocité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réciprocité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                        "entry_id": "736f3581-809b-313c-9c97-436e37546154",
                                        "glosses": [
                                            "État, qualité, caractère de ce qui est réciproque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825413cc-929c-4f83-99af-17f5baa5ed5f",
                                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                                "text": "E.-H. Weber a fait remarquer que le nerf vague se trouve en réciprocité d'action avec le grand sympathique. Ce dernier est fort peu développé chez les serpents, […]."
                                            },
                                            {
                                                "example_id": "04f9e5a7-0dae-44e3-9e69-103b0e377f53",
                                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                                "text": "Le système de la réciprocité dans sa forme moderne est le fils ainé du protectionnisme ; s'il en adoucit légèrement les rigueurs, il est l'incarnation même de sa pensée."
                                            },
                                            {
                                                "example_id": "d5f4f573-b5d1-424b-94b4-25990b6ff865",
                                                "sense_id": "e09a7ea5-72e8-3cd5-a416-f62f925eb311",
                                                "text": "La destruction des systèmes de réciprocité africains par la colonisation et la généralisation de la domination du marché capitaliste conduisent à l’ethnocide, à l’« économicide » et au génocide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82a634dd-9a11-4071-8032-cef23adfa1ab",
                        "source_entry_id": "de2370fa-f48a-3dfd-ab90-a425ca43aebb",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Vergeltung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergeltung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2af45b41-0732-31f5-9fec-84420c67677c",
                                        "entry_id": "9e84d2f3-b5db-32bf-b544-586276faf366",
                                        "glosses": [
                                            "Strafe, Genugtuung für eine (meist negative) Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b88d5a-67b3-468f-955a-4e8f7bddfb55",
                                                "sense_id": "2af45b41-0732-31f5-9fec-84420c67677c",
                                                "text": "„Gutes wird mit Gutem vergolten, Böses mit Bösem. Nichts wird vergessen, die Zeit der Vergeltung wird kommen.“"
                                            },
                                            {
                                                "example_id": "2e946195-47d3-413b-baee-ec36e1912fbe",
                                                "sense_id": "2af45b41-0732-31f5-9fec-84420c67677c",
                                                "text": "„Zur Vergeltung erobern die Franzosen mehrere Städte des Emirs und brennen sie nieder.“"
                                            },
                                            {
                                                "example_id": "263b3988-0365-471b-ab5a-026687f0b520",
                                                "sense_id": "2af45b41-0732-31f5-9fec-84420c67677c",
                                                "text": "„Mit Sex übt man auch Vergeltung am Tod.“"
                                            },
                                            {
                                                "example_id": "1156b660-b534-4aa7-8306-0901bd0b81a3",
                                                "sense_id": "2af45b41-0732-31f5-9fec-84420c67677c",
                                                "text": "„Die Vergeltung traf Schuldige und Unschuldige in gleicher Weise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
