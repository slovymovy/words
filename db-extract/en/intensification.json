                        "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                        "entry_id": "9d6fde05-06b9-3e2b-88a0-4e8d0c310db1",
                        "glosses": [
                            "The act or process of intensifying, or of making more intense."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a3936244-1442-4812-845f-c8df42585f6e",
                                "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                "text": "With the intensification of air raids on London last September, these tube platforms began to be used as an air raid shelter, and shelterers travelled by train (specially stopped there) from other stations in order to gain access."
                            },
                            {
                                "example_id": "6d1fbc23-6541-4610-9ff0-488dcb463702",
                                "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                "text": "[...] moreover, the layout fortunately allows for the likely intensification of the suburban service."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac0e9ad0-6074-4d05-af83-283d5c4f87ad",
                        "source_entry_id": "9d6fde05-06b9-3e2b-88a0-4e8d0c310db1",
                        "source_sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                        "source_sense_description": "act or process of intensifying",
                        "target_lang_word": "verheviging",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verheviging",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a527da5-0c79-3a35-b68e-758f52f978fc",
                                        "entry_id": "541fb91e-2794-3a15-8689-64e9c6552691",
                                        "glosses": [
                                            "het erger worden van iets; het sterker worden van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56dc742f-a76e-4c4e-8180-060ca223690f",
                                                "sense_id": "5a527da5-0c79-3a35-b68e-758f52f978fc",
                                                "text": "Dit laatste scheen te worden bevestigd door haar hand die, gretig, steeds sneller ging, en door een versnelling en verheviging van haar adem, terwijl haar ogen, ofschoon niet meer dan half gesloten en wel degelijk op de man naast haar gericht, hem in hun glazigheid niet langer leken op te nemen."
                                            },
                                            {
                                                "example_id": "a60f3271-fdc1-4759-b322-3801d7c11682",
                                                "sense_id": "5a527da5-0c79-3a35-b68e-758f52f978fc",
                                                "text": "Wie met de jongste beschietingen is begonnen, valt nauwelijks vast te stellen. De partijen beschuldigen elkaar over en weer. De waarnemers van de enige onafhankelijke organisatie in het gebied, de OVSE, geven ook geen uitsluitsel. Zij meldden gisteren wel een verheviging van de gevechten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f04ba27c-a2f4-4fb0-92ac-1f117cf9be65",
                        "source_entry_id": "9d6fde05-06b9-3e2b-88a0-4e8d0c310db1",
                        "source_sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
