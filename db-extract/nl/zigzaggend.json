                    {
                        "sense_id": "366ff3c1-8410-31c2-acb5-8c7fe9bd3a29",
                        "entry_id": "7ecd945c-31c9-35ae-a8be-2cabb257fcec",
                        "glosses": [
                            "onvoltooid deelwoord van zigzaggen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "81dc64bd-1a09-4491-8aaa-18e3518486c9",
                                "sense_id": "366ff3c1-8410-31c2-acb5-8c7fe9bd3a29",
                                "text": "Ik zag een man langslopen. Eerst leek hij de straat over te steken, maar ineens liep hij een beetje zigzaggend onze kant weer op. Toen trok hij een wapen en haalde de trekker over. Het leek erop dat hij ons allebei wilde uitschakelen."
                            },
                            {
                                "example_id": "6e93b03f-ca89-413a-ad20-03fee52bf758",
                                "sense_id": "366ff3c1-8410-31c2-acb5-8c7fe9bd3a29",
                                "text": "Af en toe wierp hij een blik op Haralds slaapkamerraam, waarachter het licht de hele tijd brandde. Vanaf daar liepen de brandtrappen zigzaggend naar beneden."
                            }
                        ]
                    }
