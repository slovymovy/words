                        "glosses": [
                            "abgebrochene Partie, die zu einem festgelegten Zeitpunkt fortgesetzt wird"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "a705ee83-b042-48d7-aa6f-2fbd06ff2b9b",
                                "sense_id": "90024691-bf1c-3cb4-8eb0-3c2274385587",
                                "text": "Bei einem Partieabbruch gibt ein Spieler seinen nächsten Zug in einem verschlossenen Umschlag ab, erst bei Wiederaufnahme der Hängepartie wird der Umschlag geöffnet und der notierte Zug auf dem Brett ausgeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5de54d61-d2f4-3d8f-ba88-f83a70b07f5c",
                        "entry_id": "05f009e3-894b-38c9-a733-81df1dfb0f0e",
                        "glosses": [
                            "eine vertagte Entscheidung, eine ungewisse, ungeklärte Situation"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "eac16a00-c173-4a69-8f62-9fe8c25533a2",
                                "sense_id": "5de54d61-d2f4-3d8f-ba88-f83a70b07f5c",
                                "text": "Wenn es beim Parteitag nicht bald gelingt, in diesem entscheidenden Punkt Einvernehmen zu erzielen, droht eine Hängepartie."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
