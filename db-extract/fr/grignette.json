                            {
                                "example_id": "bf619d17-8f18-46a0-a917-e22a22482db5",
                                "sense_id": "77f51b5b-ba9b-3396-9a99-ff0bea0fa0a9",
                                "text": "Marion, était une petite fille, toute grignette, au visage frêle dont les yeux étaient de couleur noisette."
