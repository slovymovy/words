                            },
                            {
                                "target_lang_word": "donker",
                                "target_lang_sense_clarification": "somber en onheilspellend uiterlijk van de lucht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb5c1cb-c3f7-3e93-91ae-8a924324f12f",
                    "sense_definition": "Describing a facial expression that is frowning, sullen, or looking angry and menacing.",
