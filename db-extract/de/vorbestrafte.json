                ],
                "senses": [
                    {
                        "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                        "entry_id": "e83b3dac-052c-3188-b8de-5aae62aa5bc1",
                        "glosses": [
                            "weibliche Person, die wegen einer Straftat verurteilt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f56c5e-e28a-4b28-8e37-f5b8cd168d29",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Als Vorbestrafte wird Thekla es in ihrem weiteren Leben schwer haben."
                            },
                            {
                                "example_id": "fd4bb790-1798-49db-b1d8-b908dabe9a47",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Herr Meier ist mit einer Vorbestraften verlobt."
                            },
                            {
                                "example_id": "f69be876-f4d4-4533-bca6-d3f764a01ed7",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Einer Vorbestraften schlägt vielerorts Misstrauen entgegen."
                            },
                            {
                                "example_id": "d1e1d8ca-6e60-4383-ab75-722ab1e7fa19",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Unter anderem wird eine wegen Raubes Vorbestrafte verdächtigt, Mitglied in der Einbrecherbande zu sein."
                            },
                            {
                                "example_id": "78e01eec-7e7f-40f8-8df6-006cfcf97091",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Die Vorbestrafte, die man zunächst für die Täterin gehalten hatte, stellte sich am Ende als unschuldig heraus."
                            },
                            {
                                "example_id": "b0abb685-2232-4f9d-9dec-91f80adde93d",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Als Vorbestrafter glückte Sigrid der private und berufliche Neuanfang."
                            },
                            {
                                "example_id": "4fce20c0-c42f-4a1c-8c53-04d221a72518",
                                "sense_id": "4616b08e-c941-398c-b6d9-9037ae64100f",
                                "text": "Gernot hilft einer schwangeren Vorbestraften dabei, außerhalb des Gefängnisses wieder Fuß zu fassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
