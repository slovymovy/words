                                "target_senses": [
                                    {
                                        "sense_id": "17574db3-05d9-3b9b-8d6a-77ce852f9e21",
                                        "entry_id": "20d9ec35-0a91-3fce-84e1-0d4eb005a85e",
                                        "glosses": [
                                            "Sammelbezeichnung für ein hellgrünes, Nickel und Magnesium enthaltendes Hydrosilikat, aus dem Nickel gewonnen wird"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bb54389-f122-4ef9-90be-5e675a71a0b0",
                                                "sense_id": "17574db3-05d9-3b9b-8d6a-77ce852f9e21",
                                                "text": "Das dort vorkommende Erz, der Garnierit, enthält das Nickel in Form eines Magnesiumnickel-Hydro-Silikates."
                                            },
                                            {
                                                "example_id": "22362c33-eeff-4482-89c6-1b7b9708fb9c",
                                                "sense_id": "17574db3-05d9-3b9b-8d6a-77ce852f9e21",
                                                "text": "Im reinen Zustande hat der Garnierit entweder eine grüne oder eine schokoladenbraune Farbe."
                                            },
                                            {
                                                "example_id": "c2159276-fc58-4ae8-99fa-3aa597f4105b",
                                                "sense_id": "17574db3-05d9-3b9b-8d6a-77ce852f9e21",
                                                "text": "Der grüne Garnierit enthält 45 bis 48% Nickeloxydul, der braune 43 bis 46 % Nickeloxydul."
                                            },
                                            {
                                                "example_id": "5ab621d3-a9ca-4470-a896-60abe1d19d38",
                                                "sense_id": "17574db3-05d9-3b9b-8d6a-77ce852f9e21",
                                                "text": "Das einzige Nickelerz, welches nur auf Nickel verarbeitet wird, ist der Garnierit (Nickelsilikat), welcher in Neukaledonien gefunden wird."
                                            },
                                            {
                                                "example_id": "8eb7486c-f514-4717-9df9-757ec0843b1d",
                                                "sense_id": "17574db3-05d9-3b9b-8d6a-77ce852f9e21",
                                                "text": "Aus dem Garnierit läßt sich das Nickel durch reduzierendes Schmelzen mit Kohle im Schachtofen gewinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
