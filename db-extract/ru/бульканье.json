                    {
                        "translation_id": "911e03fd-418e-4b5d-afce-b730cecac6f6",
                        "source_entry_id": "b8bcb0bc-5d82-39aa-864b-0565a8b5f489",
                        "target_lang_word": "glouglou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glouglou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                        "entry_id": "e77f417a-0fdb-3b8a-a873-280f77589b41",
                                        "glosses": [
                                            "Bruit que fait un liquide qui se déverse ou qui est en train de bouillir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db431ab-b40a-4415-8437-af51f4decc85",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "Les gaz poussèrent des bulles dans le naphte, une sorte de glouglou régulier qui couvrait le bruit du moteur au ralenti."
                                            },
                                            {
                                                "example_id": "5735bcbd-9b32-4698-a5e8-3c56a37f8495",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "Rond en affaires, bon homme, rigoleur, vous eussiez reconnu en lui l’homme aimable de la grisette, qui […] imite à table le glouglou d’une bouteille en se donnant des chiquenaudes sur une joue tendue."
                                            },
                                            {
                                                "example_id": "2a339993-fa35-48ed-8d78-9630d9928882",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "C’étaient un cliquetis grandissant de fourchettes, des glouglous de bouteilles qu’on vidait."
                                            },
                                            {
                                                "example_id": "97d4bcf0-99b3-4bc2-be67-b03a68330eae",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "Les glouglous de la marmite s’accentuaient. Son couvercle se mit à se soulever, livrant passage à des bouffées d’écume jaune."
                                            },
                                            {
                                                "example_id": "4a933841-e6c8-47a9-84cf-08337233328d",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "[…]; par intervalles, un hibou ricanait et, continus, en sourdine, susurraient le glouglou des ruisselets, la chanterelle des pisselottes, le chuchotis des goutelles."
                                            },
                                            {
                                                "example_id": "8140e644-4023-4cf3-a9d1-6775c3863834",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "Lili coucha sous l’eau une bouteille vide : le glouglou roucoula comme un pigeon ramier."
                                            },
                                            {
                                                "example_id": "cacd83c1-b2ec-40f8-a228-b56245560301",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "Mes glouglous, les bulles d’air et de salive au coin de mes lèvres, tout ce négligé de l’enfance qui reparaît parfois dans la sénilité, avaient sans doute dégoûté l’arrogance de ses dix-neuf ans."
                                            },
                                            {
                                                "example_id": "6805bc20-570f-4066-86ca-7b010f1d1e55",
                                                "sense_id": "efbdc665-0c0c-3ad9-8051-9bb686e9db9f",
                                                "text": "Au cœur de Montpellier, un petit bassin à l’eau cristalline fait entendre un glouglou rafraîchissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26738e50-3e2b-3c3b-b6e4-fdc2f3ec1455",
                                        "entry_id": "e77f417a-0fdb-3b8a-a873-280f77589b41",
                                        "glosses": [
                                            "Autre nom du baguenaudier (Colutea arborescens ssp. gallica) ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
