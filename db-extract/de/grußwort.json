                    {
                        "sense_id": "07e6a3d5-0858-3ef8-98bf-7b506faca245",
                        "entry_id": "4e9bb288-4247-34c0-a2b9-85d84f252edc",
                        "glosses": [
                            "kurze formelle Rede, auch schriftlich, die grüßend eine Zielgruppe direkt anspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8efc4b90-b792-4efb-9b92-19a7a5005032",
                                "sense_id": "07e6a3d5-0858-3ef8-98bf-7b506faca245",
                                "text": "In seinem Grußwort hieß der Präsident die Besucher herzlich willkommen."
                            },
                            {
                                "example_id": "d0d5f274-7fdb-46a4-8df5-1bece0edb0c2",
                                "sense_id": "07e6a3d5-0858-3ef8-98bf-7b506faca245",
                                "text": "Der Staatssekretär richtete sein Grußwort an die Teilnehmer der Veranstaltung."
                            },
                            {
                                "example_id": "79c656be-c305-4ca1-9d17-39eee9de5588",
                                "sense_id": "07e6a3d5-0858-3ef8-98bf-7b506faca245",
                                "text": "„In seine letzten Schwingungen hinein sprach die Botschafterin Vietnams ein Grußwort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "78c6e356-e788-343d-88b1-4aeddac3daa4",
                        "entry_id": "4e9bb288-4247-34c0-a2b9-85d84f252edc",
                        "glosses": [
                            "Grüße"
                        ],
                        "tags": [],
                        "examples": [
                            {
