                    {
                        "sense_id": "d976004b-2f74-31b0-bab6-5c0de5984c5b",
                        "entry_id": "6d8b78fd-fecf-3774-b751-85c529a28133",
                        "glosses": [
                            "Ensemble des métabolites présents dans un organisme vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04eeb17-ef13-47ba-b6db-4384de74bdd7",
                                "sense_id": "d976004b-2f74-31b0-bab6-5c0de5984c5b",
                                "text": "L’analyse du métabolome complète les outils de génomique fonctionnelle dont disposent les biologistes pour la compréhension globale des systèmes biologiques."
                            },
                            {
                                "example_id": "37b7ebe2-b056-48cc-8cf8-dd2d530e0240",
                                "sense_id": "d976004b-2f74-31b0-bab6-5c0de5984c5b",
                                "text": "En intégrant les interactions entre l’hôte et son environnement (y compris ses microbiotes), on considère que le métabolome est le reflet le plus proche du phénotype."
                            }
                        ]
                    }
                ],
