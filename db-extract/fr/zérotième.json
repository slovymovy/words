                "senses": [
                    {
                        "sense_id": "e7c05f92-5850-3ba6-ac71-558596635313",
                        "entry_id": "19834fc8-1957-3620-8765-0c1fb62cf9fa",
                        "glosses": [
                            "Qui occupe le rang zéro, avant premier."
                        ],
                        "tags": [
                            "familiar",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "29343409-88cc-49d7-8af2-05b348721aa7",
                                "sense_id": "e7c05f92-5850-3ba6-ac71-558596635313",
                                "text": "La zérotième conférence Debian, organisée par l’Association Bordelaise des Utilisateurs de Linux (ABUL) a eu lieu du 5 au 9 juillet 2000 à Bordeaux, en France, en parallèle du Libre Software Meeting."
                            },
                            {
                                "example_id": "7df26a5c-273f-4f34-9c1e-dc834e2f3674",
                                "sense_id": "e7c05f92-5850-3ba6-ac71-558596635313",
                                "text": "Comme justement c’est la première fois — et même la zérotième fois —, nous n’avons pas encore reçu d’informations, ni de questions ni d’annonces."
                            },
                            {
                                "example_id": "4d6181ea-be90-4c94-bf2c-5d27d020b9f0",
                                "sense_id": "e7c05f92-5850-3ba6-ac71-558596635313",
                                "text": "Un égo-trip au zérotième degré, voilà qui vous résume mieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccf239ca-e79e-4f95-8714-8d359095e338",
                        "source_entry_id": "19834fc8-1957-3620-8765-0c1fb62cf9fa",
                        "source_sense_id": "e7c05f92-5850-3ba6-ac71-558596635313",
