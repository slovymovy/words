                    "frequency": "Middle",
                    "semantic_group_id": "vitesse_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je lui ai envoyé une carte pour lui souhaiter un <w>prompt</w> rétablissement après son opération."
                        },
                        {
                            "text": "La direction a exigé une <w>prompte</w> réponse de la part des responsables du projet."
                        }
                    ],
                    "synonyms": [
                        "rapide",
                        "vif"
                    ],
                    "antonyms": [
                        "lent"
                    ],
                    "common_phrases": [
