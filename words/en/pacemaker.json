{
    "word_family": [
        "pace"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bb166a2-19b1-3768-8ac2-dbd665110c24",
                    "sense_definition": "A person or animal that sets the speed for others in a race or activity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pacemaker</w> led the runners for the first half of the marathon.",
                            "target_lang_translations": {
                                "zh": "在马拉松比赛的前半程，由<w>领跑者</w>带领着选手们。"
                            }
                        },
                        {
                            "text": "A professional <w>pacemaker</w> helped the athlete achieve a new world record.",
                            "target_lang_translations": {
                                "zh": "一位专业的<w>领跑员</w>帮助这位运动员创下了新的世界纪录。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pacesetter"
                    ],
                    "common_phrases": [
                        "set the pace"
                    ],
                    "target_lang_definitions": {
                        "zh": "在比赛或活动中为他人设定速度的人或动物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "领跑者",
                                "target_lang_sense_clarification": "指在长跑等运动中带领大家保持节奏的人。"
                            },
                            {
                                "target_lang_word": "领跑员",
                                "target_lang_sense_clarification": "指职业的领跑人员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "643f4a60-7a3d-344b-86a0-777b4f2e92a7",
                    "sense_definition": "A small medical device implanted in the chest to help control an irregular heartbeat.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended a <w>pacemaker</w> to regulate his slow heart rate.",
                            "target_lang_translations": {
                                "zh": "医生建议植入一个<w>心脏起搏器</w>来调节他缓慢的心率。"
                            }
                        },
                        {
                            "text": "After the surgery, she felt much better with her new <w>pacemaker</w>.",
                            "target_lang_translations": {
                                "zh": "手术后，装上新的<w>心脏起搏器</w>让她感觉好多了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "implant a pacemaker"
                    ],
                    "target_lang_definitions": {
                        "zh": "植入胸部以帮助控制心律不齐的小型医疗设备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "心脏起搏器",
                                "target_lang_sense_clarification": "用于调节心跳频率的医疗植入物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ea1fcde-dae1-32fb-942f-660f788154fc",
                    "sense_definition": "A specialized group of cells in the heart that controls the rhythm of the heartbeat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sinoatrial node acts as the natural <w>pacemaker</w> of the human heart.",
                            "target_lang_translations": {
                                "zh": "窦房结是人类心脏天然的<w>起搏点</w>。"
                            }
                        },
                        {
                            "text": "Damage to the heart's internal <w>pacemaker</w> can lead to serious rhythm problems.",
                            "target_lang_translations": {
                                "zh": "心脏内部<w>起搏点</w>受损会导致严重的心律问题。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "心脏中控制心跳节律的一组特殊细胞。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "起搏点",
                                "target_lang_sense_clarification": "生物学上指心脏内产生节律的细胞群。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}