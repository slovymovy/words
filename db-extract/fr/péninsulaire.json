                                        "entry_id": "c2dc5ad5-4c7c-381c-b693-22cc41205cb5",
                                        "glosses": [
                                            "A person born on the Iberian Peninsula who emigrated to a (contemporary or former) Spanish colony."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb4c669-eea2-4866-9fb1-e69c48f46a1e",
                                                "sense_id": "c9ca9516-9a08-3db6-b44f-ca5aed0fc41b",
                                                "text": "Some of the great merchants in the Indies were creoles, but the majority were peninsulares. These latter acted as effective intermediaries between Spain and the colonies."
                                            }
                                        ]
