                                    {
                                        "sense_id": "abab50a5-8763-3904-9181-d9971b6ec452",
                                        "entry_id": "ff58e94c-60d3-32dd-a4fb-2c0aa76d3406",
                                        "glosses": [
                                            "Duodécimo."
                                        ],
                                        "tags": [],
