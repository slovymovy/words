                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6e9670-d5df-48b8-ba0b-807dcf321816",
                                "sense_id": "7cd13f93-59d1-3dc1-bd75-50985efc0d1a",
                                "text": "W pałacyku mieściła się, jak głoszono oficjalnie, szkoła oficerów SS, a właściwie było tu kierownictwo specjalnej jednostki SS, chroniącej pobliską kwaterę Hitlera w Gierłoży"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6ad0d51-fd57-43ad-a833-8c41d6e9fb07",
                        "source_entry_id": "7d93a5c4-9f35-35fb-a77b-c980e28260c2",
                        "source_sense_id": "7cd13f93-59d1-3dc1-bd75-50985efc0d1a",
                        "target_lang_word": "officially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "officially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06fda80d-e398-3392-85f9-00ec85b21618",
                                        "entry_id": "0f992a03-8223-3787-b2a2-11eda7ea12d8",
                                        "glosses": [
                                            "In an official manner; according to official rules or regulations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fcb1266-af36-4518-8dec-ecc9f9f3f069",
                                                "sense_id": "06fda80d-e398-3392-85f9-00ec85b21618",
                                                "text": "[T]here was nothing to drink except orange crush - officially."
                                            },
                                            {
                                                "example_id": "506ca26a-9cf5-4f98-b841-1da9e650766b",
                                                "sense_id": "06fda80d-e398-3392-85f9-00ec85b21618",
                                                "text": "Wearing his best suit and sunglasses, the sultan of Slowjamastan officially declared independence from the United States of America at 12:26 p.m. on December 1, 2021 as he broadcast the secession live from his open-air government “office” in Dublândia, the capital of the Republic of Slowjamastan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a443be1e-91cd-3ef1-9b87-3f59915b01c6",
                                        "entry_id": "0f992a03-8223-3787-b2a2-11eda7ea12d8",
                                        "glosses": [
                                            "Thoroughly, completely."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2212ae-a9f4-41ea-873b-b44b60247f5b",
                                                "sense_id": "a443be1e-91cd-3ef1-9b87-3f59915b01c6",
                                                "text": "That’s it! I’m officially outraged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3daa24b5-2e83-4abd-a1c0-f72ac7d875aa",
                        "source_entry_id": "7d93a5c4-9f35-35fb-a77b-c980e28260c2",
                        "source_sense_id": "7cd13f93-59d1-3dc1-bd75-50985efc0d1a",
                        "target_lang_word": "officiellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "officiellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b06b4ef-1ee4-33aa-a98b-bb684db2661d",
                                        "entry_id": "205f9b55-c190-3925-881b-1c401f44fc7e",
                                        "glosses": [
                                            "D’une manière officielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c42981-1e09-444a-8e54-3d3832fa6155",
                                                "sense_id": "1b06b4ef-1ee4-33aa-a98b-bb684db2661d",
                                                "text": "Au son de la cloche de la tour du palais, à Toulouse comme à Paris, le parlement se rendait en corps et en grand costume à la messe du Saint-Esprit, dite aussi la messe Rouge, pontificalement célébrée, avec orgue et musique, par un des évêques du ressort, officiellement invité par le premier président au nom du parlement."
                                            },
                                            {
                                                "example_id": "03d05fbd-097e-4099-b356-0266fafa5e35",
                                                "sense_id": "1b06b4ef-1ee4-33aa-a98b-bb684db2661d",
                                                "text": "Bien qu’il ait déjà été question dès 1208, dans les statuts synodaux édictés par Eudes de Sully, évêque de Paris, d’imposer aux juifs un signe en forme de roue, la rouelle ne fut officiellement imposée en France qu’en 1227 par le Concile de Narbonne."
                                            },
                                            {
                                                "example_id": "f3e73236-7412-4ddf-925b-3040eaeb59e8",
                                                "sense_id": "1b06b4ef-1ee4-33aa-a98b-bb684db2661d",
                                                "text": "Il s’est entendu chez les Soviets avec un fondé de pouvoir d’une fabrique de stupéfiants et lui en a commandé officiellement de la bigornette, sous prétexte de la fournir à d’autres maisons établies dans des pays où le système des certificats n’existe pas."
                                            },
                                            {
                                                "example_id": "68edacca-e790-4c98-ad4d-6ccf39aeb8f0",
                                                "sense_id": "1b06b4ef-1ee4-33aa-a98b-bb684db2661d",
                                                "text": "Outre les pays membres de l’Otan, la Finlande et la Suède, deux nations officiellement non-alignées mais où le débat sur une adhésion a été relancé par l’invasion russe en Ukraine, devraient envoyer un contingent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9f4e92d-17b0-463c-beec-e0c1c7674856",
                        "source_entry_id": "7d93a5c4-9f35-35fb-a77b-c980e28260c2",
