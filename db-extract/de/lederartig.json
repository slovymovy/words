                ],
                "senses": [
                    {
                        "sense_id": "63137fb8-0530-37e5-a6c1-92c9a43ccbdb",
                        "entry_id": "7c80b5e2-511e-3922-8cd1-caf59a996e08",
                        "glosses": [
                            "Leder ähnelnd, an Leder erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c8543b-4f8f-4ff7-97aa-f44b0dbbc5cd",
                                "sense_id": "63137fb8-0530-37e5-a6c1-92c9a43ccbdb",
                                "text": "„Sein lederartiges, altes Gesicht schien in der Beleuchtung der frühen Morgenstunde aus Millionen kleiner Stücke zusammengesetzt zu sein.“"
                            },
                            {
                                "example_id": "25ebfc63-6a7f-41de-a507-ce19f750a237",
                                "sense_id": "63137fb8-0530-37e5-a6c1-92c9a43ccbdb",
                                "text": "„Er erkannte, dass lederartige Riemen über seine Brust, seine Arme und Beine gespannt waren, die ihn fest mit einer beweglichen Oberfläche verbanden, die unter ihm zu stampfen und zu schnauben schien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
