                "senses": [
                    {
                        "sense_id": "5cf72a1c-ac73-3642-90ea-f45eeca0b00f",
                        "entry_id": "08b1975b-73e7-32fa-b98e-ebd40c5cfe0a",
                        "glosses": [
                            "bepaalde loofboomsoort Tilia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18cc6f63-0047-41b0-b122-9b73d997fdca",
                                "sense_id": "5cf72a1c-ac73-3642-90ea-f45eeca0b00f",
                                "text": "Er zaten mensen onder de linde te picknicken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b236bdf-a474-47e8-8cb1-3d6ebca868e9",
                        "source_entry_id": "08b1975b-73e7-32fa-b98e-ebd40c5cfe0a",
                        "source_sense_id": "5cf72a1c-ac73-3642-90ea-f45eeca0b00f",
                        "source_sense_description": "loofboom",
                        "target_lang_word": "Linde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Linde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                        "entry_id": "a8eddb52-cfae-3306-8884-9095188526e2",
                                        "glosses": [
                                            "Laubbaum der Gattung Tilia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9fc227-979a-4824-ad1f-f5daf9511b31",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "Auf dem Dorfplatz steht eine große Linde."
                                            },
                                            {
                                                "example_id": "c4f679bc-e1e6-4466-b63d-f1c50b075359",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„Einmal stand eine Gruppe von Menschen hinter der Gaststätte unter einer alten Linde im Kreis, alle hatten die Köpfe nach unten gerichtet und umarmten sich.“"
                                            },
                                            {
                                                "example_id": "77caeb76-8e0e-442d-9b68-870c73556a56",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„Während wir durch das Parktor rollen, unter dem dichten Schirm uralter Linden aufs Gutshaus zu, entfaltet sich, in einem Anhauch von Wind, hoch über dem Dach die alte Wappenfahne der Krockows.“"
                                            },
                                            {
                                                "example_id": "a104aba5-2a8a-4627-9244-27fa3dc9d448",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„Hinter den Linden begann der Vollmond aufzusteigen.“"
                                            },
                                            {
                                                "example_id": "8431e8f0-77da-41ed-8f5e-3025a15b14f4",
                                                "sense_id": "22df220b-4c09-3fbb-8505-d73db9ee73f9",
                                                "text": "„An dem Staket aber trockneten Netze, wähend eine Sichel an der alten Linde hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64720018-5787-343b-8c63-e0fc454f141a",
                                        "entry_id": "a8eddb52-cfae-3306-8884-9095188526e2",
                                        "glosses": [
                                            "Holzart von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf30d028-68d0-4eb6-b3c7-b94c08d49324",
                                                "sense_id": "64720018-5787-343b-8c63-e0fc454f141a",
                                                "text": "Heute benutzen wir Linde für den Ofen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "134f5149-a601-45e8-b865-7d5133cecebb",
