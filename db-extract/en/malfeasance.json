                    {
                        "translation_id": "d3efe574-ca64-4537-8bdb-059e54d42c30",
                        "source_entry_id": "eafd54ee-dd7a-366b-bf9e-d9f5a06af829",
                        "source_sense_description": "wrongdoing",
                        "target_lang_word": "Übeltat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übeltat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf5540d0-6056-3b73-b49b-ba6d754ec0bb",
                                        "entry_id": "60474b8a-4dfa-3d70-8553-1e97a6281b5f",
                                        "glosses": [
                                            "schreckliche, moralisch verwerfliche Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "179d8460-c649-4ca1-b8a4-81f0bb875711",
                                                "sense_id": "cf5540d0-6056-3b73-b49b-ba6d754ec0bb",
                                                "text": "Es ist eine Übeltat, sexuelle Handlungen an einer Person vorzunehmen, ohne dass diese damit einverstanden ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
