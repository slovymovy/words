{
    "word_family": [
        "loath",
        "loathsome",
        "loathing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f62f2345-76c5-35b1-8a72-0143199eb999",
                    "sense_definition": "To feel intense dislike or disgust for someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>loathe</w> having to clean the kitchen after a long day at work.",
                            "target_lang_translations": {
                                "ru": "Я <w>ненавижу</w> убираться на кухне после долгого рабочего дня.",
                                "es": "<w>Detesto</w> tener que limpiar la cocina después de un largo día de trabajo."
                            }
                        },
                        {
                            "text": "Many people <w>loathe</w> the cold weather during the winter months.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>не выносят</w> холодную погоду в зимние месяцы.",
                                "es": "Mucha gente <w>odia</w> el clima frío durante los meses de invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "abhor",
                        "despise",
                        "detest",
                        "hate"
                    ],
                    "antonyms": [
                        "love"
                    ],
                    "common_phrases": [
                        "utterly loathe",
                        "loathe doing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильную неприязнь, отвращение или ненависть к кому-либо или чему-либо.",
                        "es": "Sentir un rechazo intenso, odio o aversión profunda hacia alguien o algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненавидеть",
                                "target_lang_sense_clarification": "испытывать крайнюю степень неприязни"
                            },
                            {
                                "target_lang_word": "не выносить",
                                "target_lang_sense_clarification": "не терпеть, испытывать сильное раздражение"
                            },
                            {
                                "target_lang_word": "не любить",
                                "target_lang_sense_clarification": "испытывать стойкую неприязнь (более мягкий вариант)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "detestar",
                                "target_lang_sense_clarification": "sentir un rechazo o aversión muy fuerte"
                            },
                            {
                                "target_lang_word": "odiar",
                                "target_lang_sense_clarification": "sentir odio o profunda animadversión"
                            },
                            {
                                "target_lang_word": "aborrecer",
                                "target_lang_sense_clarification": "tener aversión o repugnancia a algo o alguien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bea9850-5f95-3cf1-bc24-034a7b303000",
                    "sense_definition": "To cause someone to feel a strong sense of disgust.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sight of the rotting food seemed to <w>loathe</w> everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Вид гниющей еды, казалось, <w>вызывал отвращение</w> у всех присутствующих в комнате.",
                                "es": "La vista de la comida podrida parecía <w>repugnar</w> a todos los presentes en la habitación."
                            }
                        },
                        {
                            "text": "His cruel behavior would <w>loathe</w> any decent person who witnessed it.",
                            "target_lang_translations": {
                                "ru": "Его жестокое поведение <w>вызвало бы отвращение</w> у любого порядочного человека, ставшего его свидетелем.",
                                "es": "Su comportamiento cruel le <w>daría asco</w> a cualquier persona decente que lo presenciara."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство сильного отвращения (устаревшее употребление).",
                        "es": "Provocar en alguien una intensa sensación de repugnancia o asco (uso arcaico)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать отвращение",
                                "target_lang_sense_clarification": "заставлять кого-то чувствовать брезгливость"
                            },
                            {
                                "target_lang_word": "противно",
                                "target_lang_sense_clarification": "вызывать чувство гадливости"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "repugnar",
                                "target_lang_sense_clarification": "causar asco o aversión"
                            },
                            {
                                "target_lang_word": "dar asco",
                                "target_lang_sense_clarification": "provocar repugnancia o desagrado intenso"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}