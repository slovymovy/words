                "senses": [
                    {
                        "sense_id": "3b79e2f1-e7e4-37f2-a72e-e3f54480d41c",
                        "entry_id": "c6157c93-ef89-313e-b578-7dcaf3f0d4e2",
                        "glosses": [
                            "техн. расположенный под краном; предназначенный для крана, для его опоры, передвижения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b074ff0-e66a-4512-983f-9f2dbff1734e",
                                "sense_id": "3b79e2f1-e7e4-37f2-a72e-e3f54480d41c",
                                "text": "Комплекс наблюдений за подкрановыми путями при их подработке должен предусматривать: нивелировку подкрановых рельсов; измерение ширины колеи; фиксацию нарушений условий нормальной эксплуатации крана (самопроизвольное качение, смещение подкрановых рельсов и подкрановых балок и др.)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e096187-de91-4565-a836-b8d5c3fbde06",
                        "source_entry_id": "c6157c93-ef89-313e-b578-7dcaf3f0d4e2",
                        "source_sense_id": "3b79e2f1-e7e4-37f2-a72e-e3f54480d41c",
                        "target_lang_word": "crane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c794ac5c-c751-32a0-8af9-57e603c83345",
                                        "entry_id": "78278493-79d0-392b-bd4f-ee29a1016277",
                                        "glosses": [
                                            "Any bird of the family Gruidae, large birds with long legs and a long neck which is extended during flight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f2f6c7d-eb39-4128-83e9-7d4c757e17e9",
                                                "sense_id": "c794ac5c-c751-32a0-8af9-57e603c83345",
                                                "text": "Aquatic birds of various kinds are very numerous, such as geese, darters (Flotus melanogaster), scissor-bills (Rhynchops nigra), adjutants (Leptoptilos argala), pelicans, cormorants, cranes (Grus antigone, in Burmese gyoja), whimbrels, plovers, and ibises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d5c4171-0fd1-3209-b3bb-4dbc227b2a29",
                                        "entry_id": "78278493-79d0-392b-bd4f-ee29a1016277",
                                        "glosses": [
                                            "Ardea herodias, the great blue heron."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5f55ee9-4bd4-3198-9c44-62b897b5698e",
                                        "entry_id": "78278493-79d0-392b-bd4f-ee29a1016277",
                                        "glosses": [
                                            "A mechanical lifting machine or device, often used for lifting heavy loads for industrial or construction purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b827bdb-6afc-4081-8922-0fa7773fb655",
                                                "sense_id": "c5f55ee9-4bd4-3198-9c44-62b897b5698e",
                                                "text": "Large cranes were virtually non-existent in the areas I worked with this truck, so we jacked everything on and off[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e818ae77-9a56-3a04-acf3-d47e7adda98d",
                                        "entry_id": "78278493-79d0-392b-bd4f-ee29a1016277",
                                        "glosses": [
                                            "An iron arm with horizontal motion, attached to the side or back of a fireplace for supporting kettles etc. over the fire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1654ecf-dd51-3d1a-9961-655d7171ce78",
                                        "entry_id": "78278493-79d0-392b-bd4f-ee29a1016277",
                                        "glosses": [
                                            "A siphon, or bent pipe, for drawing liquors out of a cask."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02554a09-97d3-311d-b97c-bf7f939c1e33",
                                        "entry_id": "78278493-79d0-392b-bd4f-ee29a1016277",
                                        "glosses": [
                                            "A forked post or projecting bracket to support spars, etc.; generally used in pairs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93612e1d-8eba-393d-a5c9-1e6142baacdd",
                                        "entry_id": "ad5bcb36-4873-3860-aa66-cede67f162dd",
                                        "glosses": [
                                            "To extend (one's neck)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841514dc-56b2-4de1-b44c-103a9f68c042",
                                                "sense_id": "93612e1d-8eba-393d-a5c9-1e6142baacdd",
                                                "text": "and my bachelor's hearth is imbedded where by much craning of head and neck I can catch sight of a sycamore in the Square garden,"
                                            },
                                            {
                                                "example_id": "e20a1fc6-b51e-4cd1-9278-ec43949b7ad7",
                                                "sense_id": "93612e1d-8eba-393d-a5c9-1e6142baacdd",
                                                "text": "Didcot had one definite pleasure. We knew that little boys would be going up and down the platform singing out, \"Banbury cakes! Banbury cakes!\" And mother would crane out and buy some, just to encourage the crew."
                                            },
                                            {
                                                "example_id": "7101cc79-75bf-4374-9ecf-e3b85f3fa0ca",
                                                "sense_id": "93612e1d-8eba-393d-a5c9-1e6142baacdd",
                                                "text": "I'm gonna be a star and people will crane necks\nTo get a glimpse of me and see if I am having sex"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a500a8c-a230-3af0-89ea-e12a8999a901",
                                        "entry_id": "ad5bcb36-4873-3860-aa66-cede67f162dd",
                                        "glosses": [
                                            "To raise or lower with, or as if with, a crane."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eae727f-ef4b-407a-9a64-bb9fa7fc776f",
                                                "sense_id": "9a500a8c-a230-3af0-89ea-e12a8999a901",
                                                "text": "What engines, what instruments are used in craning up a soul, sunk below the centre, to the highest heavens."
                                            },
                                            {
                                                "example_id": "5a725dca-d1e4-421b-86ea-69cdc752207e",
                                                "sense_id": "9a500a8c-a230-3af0-89ea-e12a8999a901",
                                                "text": "an upstart craned up to the height he has"
                                            },
                                            {
                                                "example_id": "f8ff2805-a827-4d86-adff-5b20683d3d4c",
                                                "sense_id": "9a500a8c-a230-3af0-89ea-e12a8999a901",
                                                "text": "Several overnight weekend possessions were required to crane in new bridges and various other parts of the buildings which were manufactured offsite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55aa1a2-bff8-3bff-80ec-1236119f7d7d",
                                        "entry_id": "ad5bcb36-4873-3860-aa66-cede67f162dd",
                                        "glosses": [
                                            "To pull up before a jump."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
