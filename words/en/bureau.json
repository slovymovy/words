{
    "word_family": [
        "bureaucracy",
        "bureaucrat",
        "bureaucratic",
        "bureaucratize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f52c0e3-e376-31bd-9289-da9044eec695",
                    "sense_definition": "A government department or an administrative unit responsible for a specific function.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The federal <w>bureau</w> is responsible for managing the country's natural resources and national parks.",
                            "target_lang_translations": {
                                "ru": "Федеральное <w>бюро</w> отвечает за управление природными ресурсами и национальными парками страны."
                            }
                        },
                        {
                            "text": "She works for the <w>bureau</w> of investigation, focusing on high-level financial crimes.",
                            "target_lang_translations": {
                                "ru": "Она работает в следственном <w>управлении</w>, специализируясь на финансовых преступлениях высокого уровня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "government bureau",
                        "federal bureau"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственный департамент или административное подразделение, отвечающее за определенную функцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюро",
                                "target_lang_sense_clarification": "государственное ведомство или отдел"
                            },
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "административный орган"
                            },
                            {
                                "target_lang_word": "комитет",
                                "target_lang_sense_clarification": "орган исполнительной власти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "877f4b10-fe25-30d7-ac3d-9f9e518c10b2",
                    "sense_definition": "An office or organization that provides specific services or information to the public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We visited the local travel <w>bureau</w> to get maps and advice for our hiking trip.",
                            "target_lang_translations": {
                                "ru": "Мы посетили местное туристическое <w>бюро</w>, чтобы взять карты и получить советы для нашего похода."
                            }
                        },
                        {
                            "text": "The news <w>bureau</w> in London reported on the latest political developments across Europe.",
                            "target_lang_translations": {
                                "ru": "Информационное <w>агентство</w> в Лондоне сообщило о последних политических событиях в Европе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel bureau",
                        "news bureau",
                        "employment bureau"
                    ],
                    "target_lang_definitions": {
                        "ru": "Офис или организация, предоставляющая населению определенные услуги или информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюро",
                                "target_lang_sense_clarification": "организация по оказанию услуг"
                            },
                            {
                                "target_lang_word": "агентство",
                                "target_lang_sense_clarification": "информационное или сервисное учреждение"
                            },
                            {
                                "target_lang_word": "контора",
                                "target_lang_sense_clarification": "административный отдел или контора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aeeeca9-2ae4-3eea-9e48-8440bc550d75",
                    "sense_definition": "A chest of drawers used for storing clothes, typically found in a bedroom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He neatly folded his shirts and placed them inside the top drawer of the <w>bureau</w>.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно сложил свои рубашки и положил их в верхний ящик <w>комода</w>."
                            }
                        },
                        {
                            "text": "The antique wooden <w>bureau</w> stood in the corner of the room, holding all her winter clothes.",
                            "target_lang_translations": {
                                "ru": "Старинный деревянный <w>комод</w> стоял в углу комнаты, вмещая всю её зимнюю одежду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bedroom bureau",
                        "wooden bureau"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комод с выдвижными ящиками для хранения одежды, обычно находящийся в спальне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комод",
                                "target_lang_sense_clarification": "шкаф с выдвижными ящиками для белья"
                            },
                            {
                                "target_lang_word": "шифоньер",
                                "target_lang_sense_clarification": "узкий шкаф с ящиками для одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01256fe3-e919-3f71-adc1-5d4223bb7d29",
                    "sense_definition": "A writing desk with drawers and often a top section with small compartments for papers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat at her <w>bureau</w> every evening to write letters to her family back home.",
                            "target_lang_translations": {
                                "ru": "Каждый вечер она сидела за своим <w>бюро</w>, чтобы писать письма семье домой."
                            }
                        },
                        {
                            "text": "The old <w>bureau</w> had a hidden compartment where he kept his most private documents.",
                            "target_lang_translations": {
                                "ru": "В старом <w>секретере</w> было потайное отделение, где он хранил свои самые личные документы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "writing bureau",
                        "antique bureau"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменный стол с ящиками и часто верхней секцией с небольшими отделениями для бумаг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюро",
                                "target_lang_sense_clarification": "письменный стол с надстройкой и ящиками"
                            },
                            {
                                "target_lang_word": "секретер",
                                "target_lang_sense_clarification": "шкаф с откидной доской для письма"
                            },
                            {
                                "target_lang_word": "конторка",
                                "target_lang_sense_clarification": "высокий письменный стол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "befe2408-21c2-352c-83f2-c66975c2cb00",
                    "sense_definition": "A room or office where professional or clerical duties are performed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon working quietly in his <w>bureau</w> to finish the report.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, спокойно работая в своем <w>кабинете</w>, чтобы закончить отчет."
                            }
                        },
                        {
                            "text": "The door to his <w>bureau</w> was locked, suggesting he did not want to be disturbed.",
                            "target_lang_translations": {
                                "ru": "Дверь в его <w>кабинет</w> была заперта, что говорило о том, что он не хочет, чтобы его беспокоили."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комната или кабинет, где выполняются профессиональные или канцелярские обязанности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинет",
                                "target_lang_sense_clarification": "комната для работы"
                            },
                            {
                                "target_lang_word": "офис",
                                "target_lang_sense_clarification": "рабочее помещение"
                            },
                            {
                                "target_lang_word": "контора",
                                "target_lang_sense_clarification": "помещение организации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
