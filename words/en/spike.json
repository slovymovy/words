                                "target_lang_word": "колос",
                                "target_lang_sense_clarification": "соцветие злаков"
                            },
                            {
                                "target_lang_word": "соцветие",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
