                                        "examples": [
                                            {
                                                "example_id": "51961def-31b6-4c71-9694-016bd2a6b33d",
                                                "sense_id": "3552485a-a0be-313b-8700-e6510dc7922e",
                                                "text": "Dans la culture de la chicorée witloof (Cichorium intybus L.) l’endive ou le chicon, qui est consommé, est en fait le rejet qui se développe au départ d’une racine dont on a coupé les feuilles."
                                            },
                                            {
                                                "example_id": "a907d6c3-8cf7-481a-b695-f29ea6e4369c",
                                                "sense_id": "3552485a-a0be-313b-8700-e6510dc7922e",
                                                "text": "Le coucou de Malines apprécie beaucoup la compagnie (aérienne) des chicons ou des asperges et se plaît tout particulièrement dans un bon waterzooi."
                                            }
                                        ]
                                    }
