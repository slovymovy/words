                        }
                    ],
                    "synonyms": [
                        "excaver"
                    ],
                    "common_phrases": [
                        "creuser un trou",
                        "creuser la terre"
                    ]
                },
                {
                    "sense_id": "8c6a7e15-7eec-3062-89c0-05711933a192",
                    "sense_definition": "Examiner ou étudier un sujet de manière plus détaillée et approfondie.",
