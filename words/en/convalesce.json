                                "nl": "De patiënt <w>herstelde</w> zes maanden lang na zijn beroerte."
                            }
                        },
                        {
                            "text": "She decided to <w>convalesce</w> at home following the major surgery.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>поправляться</w> дома после серьезной операции.",
                                "nl": "Ze besloot thuis te <w>aansterken</w> na de zware operatie."
                            }
                        }
                    ],
