                                    {
                                        "sense_id": "d59ffffc-a456-393f-8777-e11bd462c903",
                                        "entry_id": "22ff4381-b663-38c9-b7ba-b04965f3688d",
                                        "glosses": [
                                            "The sound of a hiss."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6940ab89-1a3c-4834-963e-3099d0b7fb42",
                                                "sense_id": "d59ffffc-a456-393f-8777-e11bd462c903",
                                                "text": "The hissings and screamings of the vulgar against him as he moved forward on his stedfast course he heeded less than those of geese on a common."
                                            }
                                        ]
                                    }
                                ]
                            }
