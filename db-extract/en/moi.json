                        "examples": [
                            {
                                "example_id": "60fb2358-3835-45b2-ba0e-cb3141395d69",
                                "sense_id": "27eebd1a-03b9-347e-b5cf-e6257328ab8e",
                                "text": "Don't you be so cheeky. — Cheeky? Moi?"
                            },
                            {
                                "example_id": "90362837-b14b-4825-aa19-deb307540dcb",
                                "sense_id": "27eebd1a-03b9-347e-b5cf-e6257328ab8e",
                                "text": "Who'd have thought that such a thing would happen to little old moi!"
                            },
                            {
                                "example_id": "15d19385-c15c-4992-bb4d-852adf8c8fb6",
                                "sense_id": "27eebd1a-03b9-347e-b5cf-e6257328ab8e",
                                "text": "Kid Rock: Yo, let's waste that biotch. / Homer: Biotch? Moi?"
                            },
                            {
                                "example_id": "527c0c25-fc60-4f09-883a-3b120838bb06",
                                "sense_id": "27eebd1a-03b9-347e-b5cf-e6257328ab8e",
                                "text": "There's only one Miss Piggy, and she is moi."
                            }
                        ]
