                        "cross_references": [
                            {
                                "target_word": "Aneurysma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f932163d-a894-3aab-a8a4-aa4d02cdf0ff",
                                        "entry_id": "96725573-ba44-3c9c-96a6-8af7b745aa60",
                                        "glosses": [
                                            "lokalisierte Erweiterung eines arteriellen Blutgefäßes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de17651e-3fbe-433f-b8ca-a850ad18ac9d",
                                                "sense_id": "f932163d-a894-3aab-a8a4-aa4d02cdf0ff",
                                                "text": "Ein Aneurysma entsteht, wenn die betroffene Arterie eine angeborene oder erworbene Schwäche der Gefäßwand hat."
                                            },
                                            {
                                                "example_id": "2f91512b-017a-4a74-81d6-b66b6a2018e7",
                                                "sense_id": "f932163d-a894-3aab-a8a4-aa4d02cdf0ff",
                                                "text": "„Er war elf, als seine Mutter in einem Restaurant mit einem Tablett voller dreckigem Geschirr zu taumeln begann, mit Getöse zusammenbrach und an einem Aneurysma starb.“"
                                            },
                                            {
                                                "example_id": "c5aea830-d3c4-425e-bc1f-55f9ba5c08c2",
                                                "sense_id": "f932163d-a894-3aab-a8a4-aa4d02cdf0ff",
                                                "text": "„Der Landeschirurg erklärte, sein Kollege und lieber Freund sei an einem Aneurysma gestorben, und es tröstete Henriette, dass sie wusste, worum es sich bei einem Aneurysma handelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ece06e0c-5a84-41eb-b87c-02f14666952e",
                        "source_entry_id": "93a462c5-6c45-32dc-80d7-f6a1a9137fdf",
                        "source_sense_id": "dec30b18-72b0-3df6-a89d-618614cc2e8f",
