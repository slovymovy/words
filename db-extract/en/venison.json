                                                "sense_id": "5867e273-4b7b-3ebc-900b-729d8fe94c8f",
                                                "text": "Er zielte mit seiner Flinte auf das Wildbret."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
