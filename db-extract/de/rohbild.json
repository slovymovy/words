                ],
                "senses": [
                    {
                        "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                        "entry_id": "90a4776d-eb58-300d-8583-425bcfcf471c",
                        "glosses": [
                            "Foto einer Digitalkamera, das im herstellereigenen (proprietären) Format meist ohne eine Bearbeitung/Aufbereitung gespeichert wird"
                        ],
                        "tags": [
                            "Photographie"
                        ],
                        "examples": [
                            {
                                "example_id": "9dc857f7-e1f0-4873-b9e3-7f1072fda20a",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "Dateinamenserweiterungen von Rohbildern lauten unter anderem .cr2 (Canon), .dng (Adobe) und .nef (Nikon)."
                            },
                            {
                                "example_id": "e894d6f8-7968-432d-8580-43bea9ecad32",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Dunkle Flecken im Rohbild rühren von Staub in der CCD-Kamera her.“"
                            },
                            {
                                "example_id": "64638224-47e9-42c1-a2bd-8e7b28a1b2f1",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Sie machen das Rohbild, die Kamera bearbeitet die Rohdaten zu dem JPG, das Sie sich ansehen können, […].“"
                            },
                            {
                                "example_id": "a165f4d4-0ff5-497c-863e-e60f37eb374a",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Glücklicherweise führt Darktable beim Import der Bilder eine erste einfache Schärfung der Rohbilder durch.“"
                            },
                            {
                                "example_id": "3c54e74b-ff8f-457e-9dd6-d3c54d7bf6e9",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„RawTherapee ist ein Bildentwickler. Der Schwerpunkt liegt hier beim Finishing eines Bildes ausgehend vom Rohbild, ohne lokal, zum Beispiel mit Masken, zu arbeiten.“"
                            },
                            {
                                "example_id": "d392a414-76ea-475b-9821-15fcd0b5320a",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Aktuelle professionelle Bildbearbeitungssoftware besitzt integrierte Raw-Konverter (s. u. bei Rohdatenverarbeitung) für das Einlesen von Rohbildern.“"
                            },
                            {
                                "example_id": "00602b78-25d4-4e62-93c4-f412f8fa8376",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Bildsensorkalibrierung ist ein oftmals zweistufiger Korrekturprozess des Rohbildes eines Bildsensors mit Hilfe eines Weißbildes und eines Dunkelbildes.“"
                            },
                            {
                                "example_id": "faf2febf-62cd-405c-8e8f-2689fbe1a106",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Die beigefügten Rohbilder können zu Testzwecken auch mit anderen Software-Produkten, die ähnliche Funktionen anbieten, bearbeitet werden.“"
                            },
                            {
                                "example_id": "de706abb-9894-47f7-b64c-8031a6bd4e9c",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "[Videoastronomie:] „Jedes Rohbild wird so lange angezeigt, bis ein neues aufgenommen ist. Mit einem normalen Videograbber kann man die Rohbilder in den Computer laden und dort addieren.“"
                            },
                            {
                                "example_id": "f4c2318d-c903-47e0-9c43-c0d17b2b83cb",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„»Vor drei Jahren hätte ich nicht gedacht, dass ein Algorithmus, dem man einfach ein Rohbild vorsetzt, eine Person so präzise herauspicken kann«, sagt Adam Bry.“"
                            },
                            {
                                "example_id": "8fc6688b-f03a-4b2f-86e4-9cfbb137ae32",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Sie können also Gasnebel, Planeten, die Mondoberfläche, in einer nie gekannten Schärfe aufnehmen und nachbearbeiten. Und da liegt auch der Trick, in der Nachbearbeitung der Rohbilder.“"
                            },
                            {
                                "example_id": "4680b62f-224a-4fda-9f44-6b507c0d6ad2",
                                "sense_id": "29e4db11-2979-38d7-b19c-f3cd81da8af8",
                                "text": "„Der Einsatz von GEGL in allen Teilen der Bildbearbeitung bietet noch einen weiteren entscheidenden Vorteil, die zerstörungsfreie Bildbearbeitung. Das Prinzip kennt man von RAW-Konvertern, die beim “Bearbeiten” von RAW-Bildern das Rohbild zunächst nur lesend öffnen, um es in eine Bitmap umzuwandeln. Das Originalbild bleibt dabei völlig unverändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
