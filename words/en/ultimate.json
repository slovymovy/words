                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окончательный",
                                "target_lang_sense_clarification": "не подлежащий изменению, итоговый"
                            },
                            {
                                "target_lang_word": "конечный",
                                "target_lang_sense_clarification": "относящийся к концу или результату"
                            }
