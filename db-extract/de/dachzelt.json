                        "glosses": [
                            "Zelt, das sich auf einem Autodach befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e2b14b-f8d1-47c2-8f20-1a10dab897c3",
                                "sense_id": "cd48e597-cb7d-3ecb-bc75-0629d0f3fa21",
                                "text": "„Für ein Dachzelt taugt natürlich auch so gut wie jedes andere Auto mit Gepäckträger, wenn die dynamische Dachlast für mindestens 64 Kilo reicht und die statische für zwei Leute, die sich im Schlaf hin und her wälzen.“"
                            }
                        ],
